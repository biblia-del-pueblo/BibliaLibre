\v 11 \w God|strong="H0430"\w* \w is|strong="H0430"\w* \w a|strong="H5921"\w* righteous judge, yes, \w a|strong="H5921"\w* \w God|strong="H0430"\w* \w who|strong="H0430"\w* \w has|strong="H0430"\w* indignation every day.\
\v 12 If \w a|strong="H3117"\w* \w man|strong="H6662"\w* doesn’t repent, \w he|strong="H3117"\w* \w will|strong="H0430"\w* sharpen \w his|strong="H3605"\w* sword; \w he|strong="H3117"\w* \w has|strong="H0430"\w* bent \w and|strong="H0430"\w* strung \w his|strong="H3605"\w* bow.\
