\v 5 \w They|strong="H3808"\w* don’\w t|strong="H3808"\w* \w know|strong="H3045"\w*, \w neither|strong="H3808"\w* \w do|strong="H3605"\w* \w they|strong="H3808"\w* \w understand|strong="H0995"\w*. \w They|strong="H3808"\w* \w walk|strong="H1980"\w* \w back|strong="H1980"\w* \w and|strong="H1980"\w* \w forth|strong="H3045"\w* \w in|strong="H1980"\w* \w darkness|strong="H2825"\w*. \w All|strong="H3605"\w* \w the|strong="H3605"\w* \w foundations|strong="H4144"\w* \w of|strong="H0776"\w* \w the|strong="H3605"\w* \w earth|strong="H0776"\w* \w are|strong="H0776"\w* \w shaken|strong="H4131"\w*.\
