\v 14 \w Yahweh|strong="H3068"\w*, why \w do|strong="H0589"\w* \w you|strong="H0413"\w* reject \w my|strong="H3068"\w* soul? Why \w do|strong="H0589"\w* \w you|strong="H0413"\w* hide \w your|strong="H3068"\w* face \w from|strong="H0413"\w* \w me|strong="H0413"\w*?\
\v 15 \w I|strong="H5315"\w* \w am|strong="H3068"\w* afflicted \w and|strong="H3068"\w* ready \w to|strong="H3068"\w* die \w from|strong="H4480"\w* \w my|strong="H3068"\w* youth \w up|strong="H4480"\w*. \w While|strong="H5315"\w* \w I|strong="H5315"\w* suffer \w your|strong="H3068"\w* terrors, \w I|strong="H5315"\w* \w am|strong="H3068"\w* distracted.\
\v 16 \w Your|strong="H5375"\w* fierce wrath has gone over \w me|strong="H0589"\w*. \w Your|strong="H5375"\w* \w terrors|strong="H0367"\w* \w have|strong="H0589"\w* cut \w me|strong="H0589"\w* \w off|strong="H5375"\w*.\
\v 17 \w They|strong="H5921"\w* came \w around|strong="H5921"\w* \w me|strong="H5921"\w* \w like|strong="H5921"\w* water all day long. \w They|strong="H5921"\w* completely \w engulfed|strong="H5921"\w* \w me|strong="H5921"\w*.\
\v 18 \w You|strong="H3605"\w* \w have|strong="H3605"\w* put lover \w and|strong="H3117"\w* friend \w far|strong="H5921"\w* \w from|strong="H5921"\w* \w me|strong="H5921"\w*, \w and|strong="H3117"\w* \w my|strong="H3605"\w* friends \w into|strong="H5921"\w* darkness.
