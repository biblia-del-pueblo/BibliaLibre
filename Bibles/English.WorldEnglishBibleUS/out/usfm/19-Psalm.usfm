\v 8 \w You|strong="H0834"\w* \w have|strong="H0834"\w* \w not|strong="H5315"\w* shut \w me|strong="H5315"\w* \w up|strong="H7200"\w* \w into|strong="H7200"\w* \w the|strong="H0853"\w* hand \w of|strong="H5315"\w* \w the|strong="H0853"\w* enemy. \w You|strong="H0834"\w* \w have|strong="H0834"\w* \w set|strong="H0834"\w* \w my|strong="H7200"\w* feet \w in|strong="H5315"\w* \w a|strong="H7200"\w* large place.\
\v 9 \w Have|strong="H3808"\w* mercy \w on|strong="H3027"\w* \w me|strong="H3808"\w*, Yahweh, \w for|strong="H3027"\w* \w I|strong="H3808"\w* am \w in|strong="H5975"\w* \w distress|strong="H3027"\w*. \w My|strong="H3027"\w* eye, \w my|strong="H3027"\w* soul, \w and|strong="H3027"\w* \w my|strong="H3027"\w* body waste away \w with|strong="H3027"\w* grief.\
\v 10 \w For|strong="H3588"\w* \w my|strong="H3068"\w* \w life|strong="H5315"\w* \w is|strong="H3068"\w* spent \w with|strong="H3068"\w* sorrow, \w my|strong="H3068"\w* years \w with|strong="H3068"\w* sighing. \w My|strong="H3068"\w* \w strength|strong="H5315"\w* fails \w because|strong="H3588"\w* \w of|strong="H3068"\w* \w my|strong="H3068"\w* iniquity. \w My|strong="H3068"\w* bones \w are|strong="H5869"\w* \w wasted|strong="H6244"\w* \w away|strong="H6244"\w*.\
