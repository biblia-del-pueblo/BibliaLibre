\v 5 \w For|strong="H3068"\w* \w his|strong="H3068"\w* anger \w is|strong="H3068"\w* \w but|strong="H3068"\w* \w for|strong="H3068"\w* \w a|strong="H3068"\w* moment. \w His|strong="H3068"\w* \w favor|strong="H3068"\w* \w is|strong="H3068"\w* \w for|strong="H3068"\w* \w a|strong="H3068"\w* lifetime. Weeping \w may|strong="H3068"\w* stay \w for|strong="H3068"\w* \w the|strong="H3068"\w* night, \w but|strong="H3068"\w* joy comes \w in|strong="H3068"\w* \w the|strong="H3068"\w* morning.\
\v 6 \w As|strong="H3588"\w* \w for|strong="H3588"\w* \w me|strong="H3588"\w*, \w I|strong="H3588"\w* said \w in|strong="H6153"\w* \w my|strong="H3588"\w* prosperity, “\w I|strong="H3588"\w* shall never \w be|strong="H3588"\w* moved.”\
\v 7 \w You|strong="H5769"\w*, Yahweh, \w when|strong="H0559"\w* \w you|strong="H5769"\w* favored \w me|strong="H0589"\w*, made \w my|strong="H0559"\w* mountain stand strong; \w but|strong="H0589"\w* \w when|strong="H0559"\w* \w you|strong="H5769"\w* hid \w your|strong="H0559"\w* face, \w I|strong="H0589"\w* \w was|strong="H0589"\w* troubled.\
\v 8 \w I|strong="H3068"\w* cried \w to|strong="H1961"\w* \w you|strong="H6440"\w*, \w Yahweh|strong="H3068"\w*. \w I|strong="H3068"\w* \w made|strong="H1961"\w* supplication \w to|strong="H1961"\w* \w the|strong="H6440"\w* \w Lord|strong="H3068"\w*:\
\v 9 “What profit \w is|strong="H3068"\w* \w there|strong="H3068"\w* \w in|strong="H0413"\w* \w my|strong="H3068"\w* destruction, \w if|strong="H2603"\w* \w I|strong="H3068"\w* go \w down|strong="H7121"\w* \w to|strong="H0413"\w* \w the|strong="H0413"\w* pit? \w Shall|strong="H3068"\w* \w the|strong="H0413"\w* dust praise \w you|strong="H0413"\w*? \w Shall|strong="H3068"\w* \w it|strong="H7121"\w* declare \w your|strong="H3068"\w* truth?\
\v 10 \w Hear|strong="H5046"\w*, Yahweh, \w and|strong="H1818"\w* \w have|strong="H0571"\w* mercy \w on|strong="H0413"\w* \w me|strong="H0413"\w*. Yahweh, be \w my|strong="H5046"\w* helper.”\
\v 11 \w You|strong="H8085"\w* \w have|strong="H1961"\w* \w turned|strong="H1961"\w* \w my|strong="H8085"\w* mourning \w into|strong="H1961"\w* dancing \w for|strong="H3068"\w* \w me|strong="H1961"\w*. \w You|strong="H8085"\w* \w have|strong="H1961"\w* removed \w my|strong="H8085"\w* sackcloth, \w and|strong="H3068"\w* clothed \w me|strong="H1961"\w* \w with|strong="H3068"\w* gladness,\
