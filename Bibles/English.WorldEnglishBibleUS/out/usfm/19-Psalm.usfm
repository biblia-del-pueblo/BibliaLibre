\v 3 \w Yes|strong="H1571"\w*, \w the|strong="H0413"\w* sparrow \w has|strong="H3068"\w* \w found|strong="H1571"\w* \w a|strong="H3068"\w* \w home|strong="H3068"\w*, \w and|strong="H3068"\w* \w the|strong="H0413"\w* swallow \w a|strong="H3068"\w* nest \w for|strong="H7442"\w* \w herself|strong="H5315"\w*, \w where|strong="H0413"\w* \w she|strong="H3820"\w* \w may|strong="H3068"\w* \w have|strong="H1571"\w* \w her|strong="H0413"\w* young, near \w your|strong="H3068"\w* altars, \w Yahweh|strong="H3068"\w* \w of|strong="H3068"\w* Armies, \w my|strong="H3068"\w* King, \w and|strong="H3068"\w* \w my|strong="H3068"\w* \w God|strong="H0410"\w*.\
\v 4 Blessed \w are|strong="H0834"\w* \w those|strong="H0834"\w* \w who|strong="H0834"\w* dwell \w in|strong="H0430"\w* \w your|strong="H3068"\w* \w house|strong="H1004"\w*. \w They|strong="H0834"\w* \w are|strong="H0834"\w* always praising \w you|strong="H0834"\w*. Selah.\
\v 5 \w Blessed|strong="H0835"\w* \w are|strong="H0835"\w* those whose strength \w is|strong="H1004"\w* \w in|strong="H3427"\w* \w you|strong="H3427"\w*, \w who|strong="H3427"\w* \w have|strong="H1004"\w* \w set|strong="H3427"\w* \w their|strong="H3427"\w* hearts \w on|strong="H3427"\w* \w a|strong="H5750"\w* pilgrimage.\
