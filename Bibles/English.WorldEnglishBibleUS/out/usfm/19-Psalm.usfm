\c 43
\p 
\v 1 \w Vindicate|strong="H8199"\w* \w me|strong="H3808"\w*, \w God|strong="H0430"\w*, \w and|strong="H0430"\w* \w plead|strong="H7378"\w* \w my|strong="H7378"\w* \w cause|strong="H7379"\w* \w against|strong="H0376"\w* \w an|strong="H0376"\w* ungodly \w nation|strong="H1471"\w*. Oh, \w deliver|strong="H6403"\w* \w me|strong="H3808"\w* \w from|strong="H0376"\w* \w deceitful|strong="H4820"\w* \w and|strong="H0430"\w* wicked \w men|strong="H0376"\w*.\
\v 2 \w For|strong="H3588"\w* \w you|strong="H0859"\w* \w are|strong="H4100"\w* \w the|strong="H3588"\w* \w God|strong="H0430"\w* \w of|strong="H0430"\w* \w my|strong="H3588"\w* \w strength|strong="H4581"\w*. \w Why|strong="H4100"\w* \w have|strong="H0859"\w* \w you|strong="H0859"\w* \w rejected|strong="H2186"\w* \w me|strong="H4100"\w*? \w Why|strong="H4100"\w* \w do|strong="H4100"\w* \w I|strong="H3588"\w* \w go|strong="H1980"\w* \w mourning|strong="H6937"\w* \w because|strong="H3588"\w* \w of|strong="H0430"\w* \w the|strong="H3588"\w* \w oppression|strong="H3906"\w* \w of|strong="H0430"\w* \w the|strong="H3588"\w* \w enemy|strong="H0341"\w*?\
\v 3 Oh, \w send|strong="H7971"\w* \w out|strong="H7971"\w* \w your|strong="H0935"\w* \w light|strong="H0216"\w* \w and|strong="H0935"\w* \w your|strong="H0935"\w* \w truth|strong="H0571"\w*. \w Let|strong="H7971"\w* \w them|strong="H0413"\w* \w lead|strong="H5148"\w* \w me|strong="H0413"\w*. \w Let|strong="H7971"\w* \w them|strong="H0413"\w* \w bring|strong="H0935"\w* \w me|strong="H0413"\w* \w to|strong="H0413"\w* \w your|strong="H0935"\w* \w holy|strong="H6944"\w* \w hill|strong="H2022"\w*, \w to|strong="H0413"\w* \w your|strong="H0935"\w* \w tents|strong="H4908"\w*.\
\v 4 \w Then|strong="H0935"\w* \w I|strong="H0935"\w* \w will|strong="H0430"\w* \w go|strong="H0935"\w* \w to|strong="H0413"\w* \w the|strong="H0413"\w* \w altar|strong="H4196"\w* \w of|strong="H0430"\w* \w God|strong="H0430"\w*, \w to|strong="H0413"\w* \w God|strong="H0430"\w*, \w my|strong="H0935"\w* \w exceeding|strong="H8057"\w* \w joy|strong="H8057"\w*. \w I|strong="H0935"\w* \w will|strong="H0430"\w* \w praise|strong="H3034"\w* \w you|strong="H0935"\w* \w on|strong="H0413"\w* \w the|strong="H0413"\w* \w harp|strong="H3658"\w*, \w God|strong="H0430"\w*, \w my|strong="H0935"\w* \w God|strong="H0430"\w*.\
\v 5 \w Why|strong="H4100"\w* \w are|strong="H4100"\w* \w you|strong="H3588"\w* \w in|strong="H5921"\w* \w despair|strong="H7817"\w*, \w my|strong="H5921"\w* \w soul|strong="H5315"\w*? \w Why|strong="H4100"\w* \w are|strong="H4100"\w* \w you|strong="H3588"\w* \w disturbed|strong="H1993"\w* \w within|strong="H5921"\w* \w me|strong="H5315"\w*? \w Hope|strong="H3176"\w* \w in|strong="H5921"\w* \w God|strong="H0430"\w*! \w For|strong="H3588"\w* \w I|strong="H3588"\w* \w shall|strong="H5315"\w* \w still|strong="H5750"\w* \w praise|strong="H3034"\w* \w him|strong="H5921"\w*: \w my|strong="H5921"\w* Savior, \w my|strong="H5921"\w* helper, \w and|strong="H0430"\w* \w my|strong="H5921"\w* \w God|strong="H0430"\w*. 
\c 44
\p \s1 Lament and cry for help from the law-abiding people, but defeated and mistreated by their enemies
\p## Lament and cry for help from the law-abiding people, but defeated and mistreated by their enemies
For the Chief Musician. By the sons of Korah. A contemplative psalm. 
\v 1 We \w have|strong="H1121"\w* heard \w with|strong="H5329"\w* our ears, God; our fathers \w have|strong="H1121"\w* told us what work you did \w in|strong="H1121"\w* their days, \w in|strong="H1121"\w* \w the|strong="H1121"\w* days \w of|strong="H1121"\w* \w old|strong="H1121"\w*.\
\v 2 \w You|strong="H3117"\w* drove \w out|strong="H6466"\w* \w the|strong="H8085"\w* nations \w with|strong="H3117"\w* \w your|strong="H8085"\w* hand, \w but|strong="H8085"\w* \w you|strong="H3117"\w* planted \w them|strong="H3117"\w*. \w You|strong="H3117"\w* afflicted \w the|strong="H8085"\w* peoples, \w but|strong="H8085"\w* \w you|strong="H3117"\w* spread \w them|strong="H3117"\w* abroad.\
\v 3 \w For|strong="H3027"\w* \w they|strong="H3027"\w* didn’t \w get|strong="H7971"\w* \w the|strong="H7971"\w* land \w in|strong="H1471"\w* \w possession|strong="H3423"\w* \w by|strong="H3027"\w* \w their|strong="H7971"\w* own sword, neither did \w their|strong="H7971"\w* own \w arm|strong="H3027"\w* save \w them|strong="H7971"\w*; \w but|strong="H0859"\w* \w your|strong="H7971"\w* right \w hand|strong="H3027"\w*, \w your|strong="H7971"\w* \w arm|strong="H3027"\w*, \w and|strong="H3027"\w* \w the|strong="H7971"\w* light \w of|strong="H3027"\w* \w your|strong="H7971"\w* face, \w because|strong="H3027"\w* \w you|strong="H0859"\w* \w were|strong="H3027"\w* favorable \w to|strong="H7971"\w* \w them|strong="H7971"\w*.\
\v 4 \w God|strong="H3808"\w*, \w you|strong="H3588"\w* \w are|strong="H0776"\w* \w my|strong="H3588"\w* King. Command victories \w for|strong="H3588"\w* Jacob!\
\v 5 Through \w you|strong="H0859"\w*, we \w will|strong="H0430"\w* push \w down|strong="H6680"\w* \w our|strong="H0430"\w* adversaries. Through \w your|strong="H6680"\w* name, we \w will|strong="H0430"\w* tread \w down|strong="H6680"\w* \w those|strong="H1931"\w* \w who|strong="H1931"\w* rise \w up|strong="H4428"\w* \w against|strong="H3290"\w* us.\
\v 6 \w For|strong="H6862"\w* \w I|strong="H6965"\w* \w will|strong="H8034"\w* not trust \w in|strong="H8034"\w* \w my|strong="H6965"\w* bow, neither \w will|strong="H8034"\w* \w my|strong="H6965"\w* sword save \w me|strong="H8034"\w*.\
\v 7 \w But|strong="H3588"\w* \w you|strong="H3588"\w* \w have|strong="H0982"\w* \w saved|strong="H3467"\w* \w us|strong="H3588"\w* \w from|strong="H3808"\w* \w our|strong="H3588"\w* adversaries, \w and|strong="H2719"\w* \w have|strong="H0982"\w* shamed \w those|strong="H3588"\w* \w who|strong="H3588"\w* hate \w us|strong="H3588"\w*.\
\v 8 \w In|strong="H3588"\w* God \w we|strong="H3588"\w* \w have|strong="H3588"\w* made \w our|strong="H3588"\w* boast \w all|strong="H0954"\w* day long. \w We|strong="H3588"\w* \w will|strong="H3467"\w* give thanks \w to|strong="H0954"\w* \w your|strong="H3588"\w* name forever. Selah.\
\v 9 \w But|strong="H3117"\w* \w now|strong="H3117"\w* \w you|strong="H3605"\w* rejected \w us|strong="H3117"\w*, \w and|strong="H0430"\w* brought \w us|strong="H3117"\w* \w to|strong="H3117"\w* dishonor, \w and|strong="H0430"\w* don’t go \w out|strong="H3605"\w* \w with|strong="H0430"\w* \w our|strong="H3605"\w* armies.\
\v 10 \w You|strong="H3808"\w* make us \w turn|strong="H0637"\w* \w back|strong="H3318"\w* \w from|strong="H3318"\w* \w the|strong="H3318"\w* adversary. Those \w who|strong="H6635"\w* hate us \w take|strong="H3318"\w* plunder \w for|strong="H6635"\w* themselves.\
\v 11 \w You|strong="H7725"\w* \w have|strong="H8130"\w* \w made|strong="H7725"\w* \w us|strong="H7725"\w* \w like|strong="H7725"\w* sheep \w for|strong="H4480"\w* food, \w and|strong="H7725"\w* \w have|strong="H8130"\w* scattered \w us|strong="H7725"\w* \w among|strong="H4480"\w* \w the|strong="H4480"\w* nations.\
\v 12 \w You|strong="H5414"\w* \w sell|strong="H5414"\w* \w your|strong="H5414"\w* \w people|strong="H1471"\w* \w for|strong="H5414"\w* nothing, \w and|strong="H6629"\w* \w have|strong="H1471"\w* gained nothing \w from|strong="H1471"\w* \w their|strong="H5414"\w* sale.\
\v 13 \w You|strong="H3808"\w* \w make|strong="H4376"\w* \w us|strong="H5971"\w* \w a|strong="H3808"\w* reproach \w to|strong="H3808"\w* \w our|strong="H5971"\w* neighbors, \w a|strong="H3808"\w* scoffing \w and|strong="H3808"\w* \w a|strong="H3808"\w* derision \w to|strong="H3808"\w* those \w who|strong="H4376"\w* \w are|strong="H3808"\w* around \w us|strong="H5971"\w*.\
\v 14 \w You|strong="H7760"\w* \w make|strong="H7760"\w* \w us|strong="H7760"\w* \w a|strong="H7760"\w* byword \w among|strong="H2781"\w* \w the|strong="H7760"\w* nations, \w a|strong="H7760"\w* shaking \w of|strong="H2781"\w* \w the|strong="H7760"\w* head \w among|strong="H2781"\w* \w the|strong="H7760"\w* peoples.\
\v 15 All day long \w my|strong="H7760"\w* dishonor \w is|strong="H7218"\w* before \w me|strong="H7760"\w*, \w and|strong="H7218"\w* shame \w covers|strong="H3816"\w* \w my|strong="H7760"\w* face,\
\v 16 \w at|strong="H3117"\w* \w the|strong="H3605"\w* taunt \w of|strong="H3117"\w* \w one|strong="H3605"\w* \w who|strong="H3605"\w* \w reproaches|strong="H3639"\w* \w and|strong="H3117"\w* verbally abuses, \w because|strong="H6440"\w* \w of|strong="H3117"\w* \w the|strong="H3605"\w* enemy \w and|strong="H3117"\w* \w the|strong="H3605"\w* avenger.\
\v 17 All this has come \w on|strong="H6440"\w* \w us|strong="H6440"\w*, yet we haven’t forgotten \w you|strong="H6440"\w*. We haven’t been false \w to|strong="H6440"\w* \w your|strong="H6440"\w* covenant.\
\v 18 \w Our|strong="H3605"\w* heart \w has|strong="H3605"\w* \w not|strong="H3808"\w* turned \w back|strong="H0935"\w*, \w neither|strong="H3808"\w* \w have|strong="H3605"\w* \w our|strong="H3605"\w* steps strayed \w from|strong="H0935"\w* \w your|strong="H3605"\w* path,\
\v 19 though \w you|strong="H3808"\w* \w have|strong="H3808"\w* crushed \w us|strong="H4480"\w* \w in|strong="H3808"\w* \w the|strong="H4480"\w* haunt \w of|strong="H4480"\w* jackals, \w and|strong="H3820"\w* covered \w us|strong="H4480"\w* \w with|strong="H3820"\w* \w the|strong="H4480"\w* shadow \w of|strong="H4480"\w* death.\
\v 20 \w If|strong="H3588"\w* \w we|strong="H3588"\w* \w have|strong="H3588"\w* forgotten \w the|strong="H5921"\w* name \w of|strong="H5921"\w* \w our|strong="H5921"\w* God, \w or|strong="H3588"\w* spread \w out|strong="H5921"\w* \w our|strong="H5921"\w* hands \w to|strong="H5921"\w* \w a|strong="H3588"\w* strange god,\
\v 21 won’t \w God|strong="H0430"\w* search \w this|strong="H0518"\w* \w out|strong="H6566"\w*? \w For|strong="H0518"\w* \w he|strong="H0518"\w* knows \w the|strong="H0518"\w* secrets \w of|strong="H0430"\w* \w the|strong="H0518"\w* heart.\
\v 22 \w Yes|strong="H3588"\w*, \w for|strong="H3588"\w* \w your|strong="H3045"\w* sake \w we|strong="H3588"\w* \w are|strong="H0430"\w* killed \w all|strong="H3045"\w* day long. \w We|strong="H3588"\w* \w are|strong="H0430"\w* regarded \w as|strong="H3588"\w* sheep \w for|strong="H3588"\w* \w the|strong="H3588"\w* slaughter.\
\v 23 Wake \w up|strong="H5921"\w*! \w Why|strong="H3588"\w* \w do|strong="H3605"\w* \w you|strong="H3588"\w* sleep, Lord?\f + \fr 44:23 \ft The word translated “Lord” is “Adonai.” \f* Arise! Don’t reject \w us|strong="H5921"\w* \w forever|strong="H3117"\w*.\
\v 24 \w Why|strong="H4100"\w* \w do|strong="H0408"\w* \w you|strong="H4100"\w* hide \w your|strong="H4100"\w* face, \w and|strong="H3462"\w* forget \w our|strong="H0136"\w* affliction \w and|strong="H3462"\w* \w our|strong="H0136"\w* oppression?\
\v 25 \w For|strong="H6440"\w* \w our|strong="H6440"\w* soul \w is|strong="H4100"\w* bowed \w down|strong="H6440"\w* \w to|strong="H6440"\w* \w the|strong="H6440"\w* dust. \w Our|strong="H6440"\w* body clings \w to|strong="H6440"\w* \w the|strong="H6440"\w* earth.\
\v 26 Rise up \w to|strong="H0776"\w* help \w us|strong="H3588"\w*. Redeem \w us|strong="H3588"\w* \w for|strong="H3588"\w* \w your|strong="H3588"\w* loving kindness’ sake.
\p
\c 45
\p 
For the Chief Musician. Set to “The Lilies.” A contemplation by the sons of Korah. A wedding song. 
\v 1 \w My|strong="H5921"\w* heart overflows \w with|strong="H5921"\w* \w a|strong="H5921"\w* noble theme. \w I|strong="H5921"\w* recite \w my|strong="H5921"\w* verses \w for|strong="H5921"\w* \w the|strong="H5921"\w* \w king|strong="H5921"\w*. \w My|strong="H5921"\w* tongue \w is|strong="H1121"\w* \w like|strong="H1121"\w* \w the|strong="H5921"\w* pen \w of|strong="H1121"\w* \w a|strong="H5921"\w* skillful writer.\
\v 2 \w You|strong="H3820"\w* \w are|strong="H1697"\w* \w the|strong="H0559"\w* \w most|strong="H4428"\w* excellent \w of|strong="H4428"\w* \w the|strong="H0559"\w* sons \w of|strong="H4428"\w* \w men|strong="H0559"\w*. Grace \w has|strong="H4428"\w* anointed \w your|strong="H0559"\w* lips, therefore \w God|strong="H0559"\w* \w has|strong="H4428"\w* blessed \w you|strong="H3820"\w* forever.\
\v 3 Strap \w your|strong="H5921"\w* sword \w on|strong="H5921"\w* \w your|strong="H5921"\w* thigh, \w O|strong="H0430"\w* \w mighty|strong="H0430"\w* \w one|strong="H0120"\w*, \w in|strong="H5921"\w* \w your|strong="H5921"\w* splendor \w and|strong="H1121"\w* \w your|strong="H5921"\w* majesty.\
\v 4 \w In|strong="H5921"\w* \w your|strong="H5921"\w* \w majesty|strong="H1926"\w* ride \w on|strong="H5921"\w* victoriously \w on|strong="H5921"\w* \w behalf|strong="H5921"\w* \w of|strong="H5921"\w* truth, humility, \w and|strong="H2719"\w* righteousness. Let \w your|strong="H5921"\w* right hand display awesome deeds.\
\v 5 \w Your|strong="H5921"\w* arrows \w are|strong="H1697"\w* sharp. \w The|strong="H5921"\w* nations fall \w under|strong="H5921"\w* \w you|strong="H5921"\w*, \w with|strong="H5921"\w* arrows \w in|strong="H5921"\w* \w the|strong="H5921"\w* heart \w of|strong="H1697"\w* \w the|strong="H5921"\w* king’s enemies.\
\v 6 \w Your|strong="H8478"\w* throne, God, \w is|strong="H3820"\w* forever \w and|strong="H4428"\w* ever. \w A|strong="H8478"\w* scepter \w of|strong="H4428"\w* equity \w is|strong="H3820"\w* \w the|strong="H8478"\w* scepter \w of|strong="H4428"\w* \w your|strong="H8478"\w* \w kingdom|strong="H4428"\w*.\
\v 7 \w You|strong="H5769"\w* \w have|strong="H0430"\w* loved righteousness, \w and|strong="H0430"\w* hated wickedness. Therefore \w God|strong="H0430"\w*, \w your|strong="H0430"\w* \w God|strong="H0430"\w*, \w has|strong="H0430"\w* anointed \w you|strong="H5769"\w* \w with|strong="H0430"\w* \w the|strong="H0430"\w* oil \w of|strong="H0430"\w* gladness above \w your|strong="H0430"\w* fellows.\
\v 8 All \w your|strong="H5921"\w* garments smell \w like|strong="H3651"\w* myrrh, aloes, \w and|strong="H0430"\w* cassia. \w Out|strong="H5921"\w* \w of|strong="H0430"\w* ivory palaces stringed instruments \w have|strong="H0157"\w* made \w you|strong="H5921"\w* glad.\
\v 9 Kings’ daughters \w are|strong="H8127"\w* \w among|strong="H4480"\w* \w your|strong="H3605"\w* honorable women. \w At|strong="H1964"\w* \w your|strong="H3605"\w* right hand \w the|strong="H3605"\w* queen stands \w in|strong="H8055"\w* gold \w of|strong="H4480"\w* Ophir.\
\v 10 Listen, \w daughter|strong="H1323"\w*, consider, \w and|strong="H4428"\w* turn \w your|strong="H4428"\w* ear. Forget \w your|strong="H4428"\w* own people, \w and|strong="H4428"\w* \w also|strong="H4428"\w* \w your|strong="H4428"\w* father’s house.\
\v 11 \w So|strong="H8085"\w* \w the|strong="H8085"\w* king \w will|strong="H1004"\w* desire \w your|strong="H7200"\w* beauty, honor \w him|strong="H7200"\w*, \w for|strong="H1004"\w* \w he|strong="H5186"\w* \w is|strong="H1004"\w* \w your|strong="H7200"\w* lord.\
\v 12 \w The|strong="H3588"\w* daughter \w of|strong="H4428"\w* Tyre comes \w with|strong="H4428"\w* \w a|strong="H3588"\w* gift. \w The|strong="H3588"\w* rich among \w the|strong="H3588"\w* \w people|strong="H1931"\w* entreat \w your|strong="H3588"\w* \w favor|strong="H4428"\w*.\
\v 13 \w The|strong="H6440"\w* princess \w inside|strong="H6440"\w* \w is|strong="H6440"\w* all glorious. \w Her|strong="H1323"\w* clothing \w is|strong="H6440"\w* interwoven \w with|strong="H6440"\w* gold.\
\v 14 She \w shall|strong="H4428"\w* \w be|strong="H4428"\w* led \w to|strong="H4428"\w* \w the|strong="H3605"\w* \w king|strong="H4428"\w* \w in|strong="H4428"\w* embroidered work. \w The|strong="H3605"\w* virgins, \w her|strong="H3605"\w* companions \w who|strong="H3605"\w* follow \w her|strong="H3605"\w*, \w shall|strong="H4428"\w* \w be|strong="H4428"\w* brought \w to|strong="H4428"\w* \w you|strong="H3605"\w*.\
\v 15 \w With|strong="H0935"\w* gladness \w and|strong="H0935"\w* rejoicing \w they|strong="H0935"\w* \w shall|strong="H4428"\w* \w be|strong="H4428"\w* \w led|strong="H2986"\w*. \w They|strong="H0935"\w* \w shall|strong="H4428"\w* \w enter|strong="H0935"\w* \w into|strong="H0935"\w* \w the|strong="H0935"\w* king’\w s|strong="H4428"\w* palace.\
\v 16 \w Your|strong="H0935"\w* sons \w will|strong="H4428"\w* \w take|strong="H0935"\w* \w the|strong="H0935"\w* \w place|strong="H0935"\w* \w of|strong="H4428"\w* \w your|strong="H0935"\w* fathers. \w You|strong="H0935"\w* \w shall|strong="H4428"\w* make \w them|strong="H0935"\w* princes \w in|strong="H0935"\w* all \w the|strong="H0935"\w* earth.\
\v 17 \w I|strong="H0776"\w* \w will|strong="H1961"\w* \w make|strong="H7896"\w* \w your|strong="H3605"\w* name \w to|strong="H1961"\w* \w be|strong="H1961"\w* remembered \w in|strong="H0776"\w* \w all|strong="H3605"\w* generations. \w Therefore|strong="H1961"\w* \w the|strong="H3605"\w* peoples \w shall|strong="H1121"\w* \w give|strong="H1961"\w* \w you|strong="H3605"\w* thanks forever \w and|strong="H1121"\w* ever. 
\c 46
\p \s1 A mighty fortress is our God
\p## A mighty fortress is our God
For the Chief Musician. By the sons of Korah. According to Alamoth.\f + \fr 46:0 \ft Alamoth is a musical term. \f* 
\v 1 God \w is|strong="H1121"\w* \w our|strong="H5921"\w* refuge \w and|strong="H1121"\w* strength, \w a|strong="H5921"\w* very present help \w in|strong="H5921"\w* trouble.\
\v 2 Therefore \w we|strong="H4672"\w* won’t \w be|strong="H0430"\w* afraid, though \w the|strong="H4672"\w* earth changes, though \w the|strong="H4672"\w* mountains \w are|strong="H0430"\w* shaken into \w the|strong="H4672"\w* heart \w of|strong="H0430"\w* \w the|strong="H4672"\w* seas;\
\v 3 though \w its|strong="H5921"\w* waters roar \w and|strong="H0776"\w* \w are|strong="H0776"\w* troubled, though \w the|strong="H5921"\w* \w mountains|strong="H2022"\w* tremble \w with|strong="H5921"\w* \w their|strong="H5921"\w* swelling. Selah.\
\v 4 \w There|strong="H2022"\w* \w is|strong="H4325"\w* \w a|strong="H2022"\w* river, \w the|strong="H7493"\w* streams \w of|strong="H2022"\w* \w which|strong="H4325"\w* \w make|strong="H1993"\w* \w the|strong="H7493"\w* city \w of|strong="H2022"\w* God glad, \w the|strong="H7493"\w* holy place \w of|strong="H2022"\w* \w the|strong="H7493"\w* tents \w of|strong="H2022"\w* \w the|strong="H7493"\w* Most High.\
\v 5 \w God|strong="H0430"\w* \w is|strong="H0430"\w* within her. She shall not \w be|strong="H0430"\w* moved. \w God|strong="H0430"\w* \w will|strong="H0430"\w* help her \w at|strong="H0430"\w* dawn.\
\v 6 \w The|strong="H6437"\w* nations raged. \w The|strong="H6437"\w* kingdoms \w were|strong="H0430"\w* \w moved|strong="H4131"\w*. \w He|strong="H0430"\w* lifted \w his|strong="H7130"\w* voice \w and|strong="H0430"\w* \w the|strong="H6437"\w* earth melted.\
\v 7 Yahweh \w of|strong="H0776"\w* Armies \w is|strong="H0776"\w* \w with|strong="H0776"\w* \w us|strong="H5414"\w*. \w The|strong="H5414"\w* \w God|strong="H5414"\w* \w of|strong="H0776"\w* Jacob \w is|strong="H0776"\w* \w our|strong="H5414"\w* refuge. Selah.\
\v 8 \w Come|strong="H6635"\w*, see Yahweh’\w s|strong="H3068"\w* works, what desolations \w he|strong="H0430"\w* \w has|strong="H3068"\w* made \w in|strong="H0430"\w* \w the|strong="H3068"\w* earth.\
\v 9 \w He|strong="H0834"\w* \w makes|strong="H7760"\w* wars cease \w to|strong="H3068"\w* \w the|strong="H0834"\w* end \w of|strong="H0776"\w* \w the|strong="H0834"\w* \w earth|strong="H0776"\w*. \w He|strong="H0834"\w* breaks \w the|strong="H0834"\w* bow, \w and|strong="H3068"\w* shatters \w the|strong="H0834"\w* spear. \w He|strong="H0834"\w* burns \w the|strong="H0834"\w* chariots \w in|strong="H3068"\w* \w the|strong="H0834"\w* fire.\
\v 10 “\w Be|strong="H0776"\w* \w still|strong="H5704"\w*, \w and|strong="H0776"\w* know \w that|strong="H0784"\w* \w I|strong="H5704"\w* am God. \w I|strong="H5704"\w* \w will|strong="H0776"\w* \w be|strong="H0776"\w* exalted \w among|strong="H0776"\w* \w the|strong="H5704"\w* \w nations|strong="H0776"\w*. \w I|strong="H5704"\w* \w will|strong="H0776"\w* \w be|strong="H0776"\w* exalted \w in|strong="H0776"\w* \w the|strong="H5704"\w* \w earth|strong="H0776"\w*.”\
\v 11 Yahweh \w of|strong="H0776"\w* Armies \w is|strong="H0776"\w* \w with|strong="H3045"\w* \w us|strong="H3045"\w*. \w The|strong="H3588"\w* \w God|strong="H0430"\w* \w of|strong="H0776"\w* Jacob \w is|strong="H0776"\w* \w our|strong="H0430"\w* refuge. Selah. 
\p
\c 47
\p \s1 The God of Israel as King of all peoples
\p## The God of Israel as King of all peoples
For the Chief Musician. A Psalm by the sons of Korah. 
\v 1 Oh clap \w your|strong="H1121"\w* hands, all you nations. Shout \w to|strong="H1121"\w* God \w with|strong="H5329"\w* \w the|strong="H1121"\w* voice \w of|strong="H1121"\w* triumph!\
\v 2 \w For|strong="H3605"\w* Yahweh Most High \w is|strong="H0430"\w* awesome. \w He|strong="H0430"\w* \w is|strong="H0430"\w* \w a|strong="H8628"\w* \w great|strong="H0430"\w* King \w over|strong="H3605"\w* \w all|strong="H3605"\w* \w the|strong="H3605"\w* earth.\
\v 3 \w He|strong="H3588"\w* subdues \w nations|strong="H0776"\w* \w under|strong="H5921"\w* \w us|strong="H5921"\w*, \w and|strong="H3068"\w* peoples \w under|strong="H5921"\w* \w our|strong="H3068"\w* feet.\
\v 4 \w He|strong="H1696"\w* chooses \w our|strong="H5971"\w* inheritance \w for|strong="H8478"\w* \w us|strong="H5971"\w*, \w the|strong="H8478"\w* glory \w of|strong="H8478"\w* Jacob whom \w he|strong="H1696"\w* loved. Selah.\
\v 5 God \w has|strong="H0834"\w* gone \w up|strong="H0853"\w* \w with|strong="H5159"\w* \w a|strong="H0834"\w* shout, Yahweh \w with|strong="H5159"\w* \w the|strong="H0853"\w* sound \w of|strong="H5159"\w* \w a|strong="H0834"\w* trumpet.\
\v 6 Sing \w praises|strong="H3068"\w* \w to|strong="H3068"\w* \w God|strong="H0430"\w*! Sing \w praises|strong="H3068"\w*! Sing \w praises|strong="H3068"\w* \w to|strong="H3068"\w* \w our|strong="H3068"\w* King! Sing \w praises|strong="H3068"\w*!\
\v 7 \w For|strong="H0430"\w* \w God|strong="H0430"\w* \w is|strong="H0430"\w* \w the|strong="H0430"\w* \w King|strong="H4428"\w* \w of|strong="H4428"\w* all \w the|strong="H0430"\w* earth. \w Sing|strong="H2167"\w* \w praises|strong="H2167"\w* \w with|strong="H0430"\w* understanding.\
\v 8 \w God|strong="H0430"\w* reigns \w over|strong="H4428"\w* \w the|strong="H3605"\w* \w nations|strong="H0776"\w*. \w God|strong="H0430"\w* sits \w on|strong="H0776"\w* \w his|strong="H3605"\w* holy throne.\
\v 9 \w The|strong="H5921"\w* princes \w of|strong="H0430"\w* \w the|strong="H5921"\w* peoples \w are|strong="H0430"\w* gathered \w together|strong="H5921"\w*, \w the|strong="H5921"\w* \w people|strong="H1471"\w* \w of|strong="H0430"\w* \w the|strong="H5921"\w* \w God|strong="H0430"\w* \w of|strong="H0430"\w* Abraham. \w For|strong="H5921"\w* \w the|strong="H5921"\w* shields \w of|strong="H0430"\w* \w the|strong="H5921"\w* earth \w belong|strong="H0430"\w* \w to|strong="H5921"\w* \w God|strong="H0430"\w*. \w He|strong="H0430"\w* \w is|strong="H0430"\w* greatly exalted! 
\c 48
\p \s1 The Pilgrims' Feast Praises Zion, God's Undefeated City
\p## The Pilgrims' Feast Praises Zion, God's Undefeated City
A Song. A Psalm by the sons of Korah. 
\v 1 Great \w is|strong="H1121"\w* Yahweh, \w and|strong="H1121"\w* greatly \w to|strong="H1121"\w* \w be|strong="H1121"\w* praised, \w in|strong="H1121"\w* \w the|strong="H1121"\w* city \w of|strong="H1121"\w* our God, \w in|strong="H1121"\w* \w his|strong="H1121"\w* holy mountain.\
\v 2 Beautiful \w in|strong="H0430"\w* elevation, \w the|strong="H3068"\w* joy \w of|strong="H0430"\w* \w the|strong="H3068"\w* whole earth, \w is|strong="H3068"\w* \w Mount|strong="H2022"\w* Zion, \w on|strong="H3068"\w* \w the|strong="H3068"\w* north sides, \w the|strong="H3068"\w* \w city|strong="H5892"\w* \w of|strong="H0430"\w* \w the|strong="H3068"\w* \w great|strong="H1419"\w* King.\
\v 3 God \w has|strong="H4428"\w* shown himself \w in|strong="H0776"\w* \w her|strong="H3605"\w* citadels \w as|strong="H3303"\w* \w a|strong="H0776"\w* refuge.\
\v 4 \w For|strong="H0430"\w*, behold, \w the|strong="H3045"\w* kings assembled themselves, \w they|strong="H0430"\w* passed \w by|strong="H0430"\w* together.\
\v 5 \w They|strong="H3588"\w* \w saw|strong="H2009"\w* \w it|strong="H3588"\w*, \w then|strong="H2009"\w* \w they|strong="H3588"\w* \w were|strong="H2009"\w* amazed. \w They|strong="H3588"\w* \w were|strong="H2009"\w* dismayed. \w They|strong="H3588"\w* hurried \w away|strong="H5674"\w*.\
\v 6 Trembling took hold \w of|strong="H7200"\w* \w them|strong="H1992"\w* \w there|strong="H1992"\w*, pain, \w as|strong="H3651"\w* \w of|strong="H7200"\w* \w a|strong="H7200"\w* woman \w in|strong="H7200"\w* travail.\
\v 7 \w With|strong="H8033"\w* \w the|strong="H3205"\w* east wind, \w you|strong="H3205"\w* break \w the|strong="H3205"\w* ships \w of|strong="H3205"\w* Tarshish.\
\v 8 As we have heard, so we have seen, \w in|strong="H7665"\w* \w the|strong="H7665"\w* city \w of|strong="H7307"\w* Yahweh \w of|strong="H7307"\w* Armies, \w in|strong="H7665"\w* \w the|strong="H7665"\w* city \w of|strong="H7307"\w* our God. God \w will|strong="H7307"\w* establish \w it|strong="H7665"\w* forever. Selah.\
\v 9 \w We|strong="H0834"\w* \w have|strong="H0834"\w* thought \w about|strong="H8085"\w* \w your|strong="H3068"\w* loving kindness, \w God|strong="H0430"\w*, \w in|strong="H0430"\w* \w the|strong="H0834"\w* middle \w of|strong="H0430"\w* \w your|strong="H3068"\w* temple.\
\v 10 \w As|strong="H0430"\w* \w is|strong="H0430"\w* \w your|strong="H7130"\w* name, \w God|strong="H0430"\w*, so \w is|strong="H0430"\w* \w your|strong="H7130"\w* praise \w to|strong="H0430"\w* \w the|strong="H7130"\w* ends \w of|strong="H0430"\w* \w the|strong="H7130"\w* earth. \w Your|strong="H7130"\w* right hand \w is|strong="H0430"\w* full \w of|strong="H0430"\w* righteousness.\
\v 11 \w Let|strong="H3651"\w* Mount Zion \w be|strong="H8034"\w* glad! \w Let|strong="H3651"\w* \w the|strong="H5921"\w* daughters \w of|strong="H0776"\w* Judah rejoice \w because|strong="H5921"\w* \w of|strong="H0776"\w* \w your|strong="H5921"\w* judgments.\
\v 12 Walk \w about|strong="H2022"\w* \w Zion|strong="H6726"\w*, \w and|strong="H3063"\w* go around \w her|strong="H1323"\w*. Number its towers.\
\v 13 Notice \w her|strong="H5608"\w* bulwarks. Consider \w her|strong="H5608"\w* palaces, that \w you|strong="H6726"\w* may \w tell|strong="H5608"\w* \w it|strong="H5437"\w* \w to|strong="H5437"\w* \w the|strong="H5437"\w* next generation.\
\v 14 \w For|strong="H4616"\w* \w this|strong="H4616"\w* God \w is|strong="H3820"\w* \w our|strong="H7896"\w* God \w forever|strong="H1755"\w* \w and|strong="H3820"\w* ever. \w He|strong="H3820"\w* \w will|strong="H3820"\w* \w be|strong="H3820"\w* \w our|strong="H7896"\w* guide even \w to|strong="H3820"\w* death. 
\c 49
\p \s1 Impermanence of the external happiness of the wicked
\p## Impermanence of the external happiness of the wicked
For the Chief Musician. A Psalm by the sons of Korah. 
\v 1 Hear this, all you peoples. Listen, all you inhabitants \w of|strong="H1121"\w* \w the|strong="H1121"\w* world,\
\v 2 \w both|strong="H3605"\w* low \w and|strong="H8085"\w* high, rich \w and|strong="H8085"\w* poor \w together|strong="H5971"\w*.\
\v 3 \w My|strong="H1571"\w* mouth \w will|strong="H0376"\w* speak words \w of|strong="H1121"\w* wisdom. \w My|strong="H1571"\w* heart \w will|strong="H0376"\w* utter understanding.\
\v 4 \w I|strong="H3820"\w* \w will|strong="H3820"\w* incline \w my|strong="H1696"\w* ear \w to|strong="H1696"\w* \w a|strong="H1696"\w* proverb. \w I|strong="H3820"\w* \w will|strong="H3820"\w* solve \w my|strong="H1696"\w* riddle \w on|strong="H6310"\w* \w the|strong="H1696"\w* harp.\
\v 5 Why should I fear \w in|strong="H5186"\w* \w the|strong="H5186"\w* days \w of|strong="H0241"\w* evil, when iniquity at \w my|strong="H5186"\w* heels surrounds me?\
\v 6 \w Those|strong="H5437"\w* \w who|strong="H4100"\w* trust \w in|strong="H3117"\w* \w their|strong="H3117"\w* wealth, \w and|strong="H3117"\w* boast \w in|strong="H3117"\w* \w the|strong="H3117"\w* multitude \w of|strong="H3117"\w* \w their|strong="H3117"\w* riches—\
\v 7 none \w of|strong="H5921"\w* \w them|strong="H5921"\w* can \w by|strong="H5921"\w* any means redeem \w his|strong="H5921"\w* brother, nor give God \w a|strong="H5921"\w* ransom \w for|strong="H5921"\w* \w him|strong="H5921"\w*.\
\v 8 \w For|strong="H0430"\w* \w the|strong="H5414"\w* \w redemption|strong="H6299"\w* \w of|strong="H0376"\w* \w their|strong="H5414"\w* life \w is|strong="H0430"\w* costly, \w no|strong="H3808"\w* payment \w is|strong="H0430"\w* ever enough,\
\v 9 \w that|strong="H5315"\w* he should live on \w forever|strong="H5769"\w*, \w that|strong="H5315"\w* he should \w not|strong="H2308"\w* see corruption.\
\v 10 \w For|strong="H3808"\w* \w he|strong="H3808"\w* \w sees|strong="H7200"\w* \w that|strong="H7200"\w* wise men die; likewise \w the|strong="H7200"\w* fool \w and|strong="H7200"\w* \w the|strong="H7200"\w* senseless perish, \w and|strong="H7200"\w* leave \w their|strong="H7200"\w* \w wealth|strong="H3808"\w* \w to|strong="H7200"\w* others.\
\v 11 \w Their|strong="H3588"\w* inward thought \w is|strong="H3684"\w* \w that|strong="H3588"\w* \w their|strong="H3588"\w* houses \w will|strong="H2450"\w* endure forever, \w and|strong="H7200"\w* \w their|strong="H3588"\w* dwelling places \w to|strong="H4191"\w* \w all|strong="H3162"\w* generations. \w They|strong="H3588"\w* name \w their|strong="H3588"\w* lands \w after|strong="H3588"\w* themselves.\
\v 12 \w But|strong="H5921"\w* man, \w despite|strong="H5921"\w* \w his|strong="H5921"\w* riches, doesn’t \w endure|strong="H5769"\w*. \w He|strong="H5921"\w* \w is|strong="H8034"\w* \w like|strong="H1004"\w* \w the|strong="H5921"\w* animals \w that|strong="H7121"\w* perish.\
\v 13 This \w is|strong="H0120"\w* the destiny \w of|strong="H0120"\w* \w those|strong="H0120"\w* \w who|strong="H0120"\w* \w are|strong="H0120"\w* foolish, \w and|strong="H0120"\w* \w of|strong="H0120"\w* \w those|strong="H0120"\w* \w who|strong="H0120"\w* approve their sayings. Selah.\
\v 14 \w They|strong="H0310"\w* \w are|strong="H1870"\w* appointed \w as|strong="H2088"\w* \w a|strong="H2088"\w* flock \w for|strong="H2088"\w* Sheol.\f + \fr 49:14 \ft Sheol is the place of the dead. \f* Death \w shall|strong="H2088"\w* \w be|strong="H1870"\w* \w their|strong="H0310"\w* shepherd. \w The|strong="H0310"\w* upright \w shall|strong="H2088"\w* \w have|strong="H2088"\w* dominion over \w them|strong="H0310"\w* \w in|strong="H1870"\w* \w the|strong="H0310"\w* \w morning|strong="H2088"\w*. \w Their|strong="H0310"\w* beauty \w shall|strong="H2088"\w* decay \w in|strong="H1870"\w* Sheol,\f + \fr 49:14 \ft Sheol is the place of the dead. \f* far \w from|strong="H0310"\w* \w their|strong="H0310"\w* mansion.\
\v 15 But God \w will|strong="H3477"\w* redeem \w my|strong="H7462"\w* soul \w from|strong="H7585"\w* \w the|strong="H1242"\w* power \w of|strong="H4194"\w* \w Sheol|strong="H7585"\w*,\f + \fr 49:15 \ft Sheol is the place of the dead. \f* \w for|strong="H6629"\w* \w he|strong="H1242"\w* \w will|strong="H3477"\w* receive me. Selah.\
\v 16 Don’t \w be|strong="H3027"\w* afraid \w when|strong="H3588"\w* \w a|strong="H3947"\w* \w man|strong="H5315"\w* \w is|strong="H0430"\w* \w made|strong="H3947"\w* rich, \w when|strong="H3588"\w* \w the|strong="H3588"\w* glory \w of|strong="H0430"\w* \w his|strong="H3947"\w* house \w is|strong="H0430"\w* increased;\
\v 17 \w for|strong="H3588"\w* \w when|strong="H3588"\w* \w he|strong="H3588"\w* dies \w he|strong="H3588"\w* \w will|strong="H0376"\w* carry \w nothing|strong="H0408"\w* away. \w His|strong="H0376"\w* \w glory|strong="H3519"\w* won’t descend \w after|strong="H3588"\w* \w him|strong="H3588"\w*.\
\v 18 \w Though|strong="H3588"\w* \w while|strong="H3588"\w* \w he|strong="H3588"\w* \w lived|strong="H0310"\w* \w he|strong="H3588"\w* blessed \w his|strong="H3605"\w* soul— \w and|strong="H3381"\w* \w men|strong="H3605"\w* \w praise|strong="H3588"\w* \w you|strong="H3588"\w* \w when|strong="H3588"\w* \w you|strong="H3588"\w* \w do|strong="H3605"\w* well \w for|strong="H3588"\w* yourself—\
\v 19 \w he|strong="H3588"\w* \w shall|strong="H5315"\w* \w go|strong="H3190"\w* \w to|strong="H5315"\w* \w the|strong="H3588"\w* generation \w of|strong="H5315"\w* \w his|strong="H3588"\w* fathers. \w They|strong="H3588"\w* \w shall|strong="H5315"\w* never see \w the|strong="H3588"\w* light.\
\v 20 \w A|strong="H7200"\w* \w man|strong="H7200"\w* \w who|strong="H0001"\w* \w has|strong="H0001"\w* riches \w without|strong="H3808"\w* understanding, \w is|strong="H0216"\w* \w like|strong="H3808"\w* \w the|strong="H0935"\w* animals \w that|strong="H7200"\w* perish.
\p
\c 50
\p \s1 Right Worship
