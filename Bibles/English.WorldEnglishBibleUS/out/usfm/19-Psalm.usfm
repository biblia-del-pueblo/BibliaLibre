\v 8 \w Arise|strong="H6965"\w*, \w God|strong="H0430"\w*, \w judge|strong="H8199"\w* \w the|strong="H3605"\w* \w earth|strong="H0776"\w*, \w for|strong="H3588"\w* \w you|strong="H0859"\w* \w inherit|strong="H5157"\w* \w all|strong="H3605"\w* \w of|strong="H0776"\w* \w the|strong="H3605"\w* \w nations|strong="H1471"\w*. 
