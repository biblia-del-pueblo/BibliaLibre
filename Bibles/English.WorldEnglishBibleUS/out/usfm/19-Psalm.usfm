\v 4 \w For|strong="H3117"\w* it \w is|strong="H3117"\w* \w a|strong="H8628"\w* statute \w for|strong="H3117"\w* Israel, \w an|strong="H8628"\w* ordinance \w of|strong="H3117"\w* \w the|strong="H3117"\w* God \w of|strong="H3117"\w* Jacob.\
\v 5 \w He|strong="H1931"\w* \w appointed|strong="H2706"\w* \w it|strong="H1931"\w* \w in|strong="H0430"\w* Joseph \w for|strong="H3588"\w* \w a|strong="H3588"\w* covenant, \w when|strong="H3588"\w* \w he|strong="H1931"\w* went out over \w the|strong="H3588"\w* land \w of|strong="H0430"\w* Egypt, \w I|strong="H3588"\w* \w heard|strong="H3588"\w* \w a|strong="H3588"\w* language \w that|strong="H3588"\w* \w I|strong="H3588"\w* didn’t know.\
