\v 32 [So they girded]{strong=“H2296” x-morph=“strongMorph: \sc Th\sc*8799”} \w sackcloth| strong="H8242" \w* \w on their loins| strong="H4975" \w*, and put \w ropes| strong="H2256" \w* \w on their heads| strong="H7218" \w*, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the king| strong="H4428" \w* \w of Israel| strong="H3478" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Thy servant| strong="H5650" \w* [Ben-hadad]{strong=“H1130”} [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [I pray thee, let me live]{strong=“H5315 H2421” x-morph=“strongMorph: \sc Th\sc*8799”}. [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Is \w he yet alive| strong="H2416" \w*? he is \w my brother| strong="H251" \w*. 
\v 33 \w Now the men| strong="H582" \w* [did diligently observe]{strong=“H5172” x-morph=“strongMorph: \sc Th\sc*8762”} whether any thing would come [from him, and did hastily]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8762”} [catch]{strong=“H2480” x-morph=“strongMorph: \sc Th\sc*8686”} it: [and they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Thy brother| strong="H251" \w* [Ben-hadad]{strong=“H1130”}. [Then he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} [ye, bring]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} [him. Then Ben-hadad]{strong=“H1130”} [came forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} [to him; and he caused him to come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w into the chariot| strong="H4818" \w*. 
\v 34 And Ben-hadad [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, The cities]{strong=“H5892”}, \w which my father| strong="H1" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w from thy father| strong="H1" \w*, [I will restore]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”}; [and thou shalt make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w streets| strong="H2351" \w* \w for thee in Damascus| strong="H1834" \w*, \w as my father| strong="H1" \w* [made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w in Samaria| strong="H8111" \w*. Then said Ahab, [I will send thee away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w with this covenant| strong="H1285" \w*. [So he made]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} \w a covenant| strong="H1285" \w* [with him, and sent him away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”}.\f + \fr 20:34 \ft streets: or, market places \f* 
\p
\v 35 \w And a certain| strong="H259" \w* \w man| strong="H376" \w* \w of the sons| strong="H1121" \w* \w of the prophets| strong="H5030" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto his neighbour| strong="H7453" \w* \w in the word| strong="H1697" \w* of the \sc Lord\sc*, [Smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8685”} [me, I pray thee. And the man]{strong=“H376”} [refused ]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8762”} [to smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8687”} him. 
\v 36 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [he unto him, Because thou hast not obeyed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the voice| strong="H6963" \w* of the \sc Lord\sc*, [behold, as soon as thou art departed]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} [from me, a lion]{strong=“H738”} [shall slay]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} [thee. And as soon as he was departed]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w from him| strong="H681" \w*, \w a lion| strong="H738" \w* [found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} [him, and slew]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} him. 
\v 37 [Then he found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w another| strong="H312" \w* \w man| strong="H376" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8685”} [me, I pray thee. And the man]{strong=“H376”} [smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} [him, so that in smiting]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8687”} [he wounded]{strong=“H6481” x-morph=“strongMorph: \sc Th\sc*8800”} him.\f + \fr 20:37 \ft so that…: Heb. smiting and wounding \f* 
\v 38 \w So the prophet| strong="H5030" \w* [departed]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [and waited]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w for the king| strong="H4428" \w* \w by the way| strong="H1870" \w*, [and disguised]{strong=“H2664” x-morph=“strongMorph: \sc Th\sc*8691”} \w himself with ashes| strong="H666" \w* \w upon his face| strong="H5869" \w*. 
