\p 
\v 1 \w And Elijah| strong="H452" \w* \w the Tishbite| strong="H8664" \w*, who was \w of the inhabitants| strong="H8453" \w* \w of Gilead| strong="H1568" \w*, [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Ahab| strong="H256" \w*, As the \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w* \w liveth| strong="H2416" \w*, \w before| strong="H6440" \w* [whom I stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”}, \w there shall not be dew| strong="H2919" \w* \w nor rain| strong="H4306" \w* \w these years| strong="H8141" \w*, \w but according| strong="H6310" \w* \w to my word| strong="H1697" \w*.\f + \fr 17:1 \ft Elijah: Heb. Elijahu: Gr. Elias \f* 
