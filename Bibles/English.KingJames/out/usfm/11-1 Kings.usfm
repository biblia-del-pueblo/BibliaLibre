\v 18 [And they arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of Midian| strong="H4080" \w*, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Paran| strong="H6290" \w*: [and they took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w men| strong="H582" \w* \w with them out of Paran| strong="H6290" \w*, [and they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Egypt| strong="H4714" \w*, \w unto Pharaoh| strong="H6547" \w* \w king| strong="H4428" \w* \w of Egypt| strong="H4714" \w*; [which gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w him an house| strong="H1004" \w*, [and appointed]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w him victuals| strong="H3899" \w*, [and gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w him land| strong="H776" \w*. 
\v 19 \w And Hadad| strong="H1908" \w* [found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w great| strong="H3966" \w* \w favour| strong="H2580" \w* \w in the sight| strong="H5869" \w* \w of Pharaoh| strong="H6547" \w*, [so that he gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w him to wife| strong="H802" \w* \w the sister| strong="H269" \w* \w of his own wife| strong="H802" \w*, \w the sister| strong="H269" \w* \w of Tahpenes| strong="H8472" \w* \w the queen| strong="H1377" \w*. 
\v 20 \w And the sister| strong="H269" \w* \w of Tahpenes| strong="H8472" \w* [bare]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8799”} \w him Genubath| strong="H1592" \w* \w his son| strong="H1121" \w*, \w whom Tahpenes| strong="H8472" \w* [weaned]{strong=“H1580” x-morph=“strongMorph: \sc Th\sc*8799”} \w in| strong="H8432" \w* [Pharaoh’s]{strong=“H6547”} \w house| strong="H1004" \w*: \w and Genubath| strong="H1592" \w* [was in Pharaoh’s]{strong=“H6547”} \w household| strong="H1004" \w* \w among| strong="H8432" \w* \w the sons| strong="H1121" \w* \w of Pharaoh| strong="H6547" \w*. 
\v 21 \w And when Hadad| strong="H1908" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w in Egypt| strong="H4714" \w* \w that David| strong="H1732" \w* [slept]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8804”} \w with his fathers| strong="H1" \w*, \w and that Joab| strong="H3097" \w* \w the captain| strong="H8269" \w* \w of the host| strong="H6635" \w* [was dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Hadad| strong="H1908" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Pharaoh| strong="H6547" \w*, [Let me depart]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8761”}, [that I may go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w to mine own country| strong="H776" \w*.\f + \fr 11:21 \ft Let…: Heb. Send me away \f* 
\v 22 \w Then Pharaoh| strong="H6547" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, But what hast thou lacked]{strong=“H2638”} [with me, that, behold, thou seekest]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} [to go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} \w to thine own country| strong="H776" \w*? [And he answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Nothing: howbeit let me go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} [in any wise]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8763”}.\f + \fr 11:22 \ft Nothing: Heb. Not \f* 
\p
