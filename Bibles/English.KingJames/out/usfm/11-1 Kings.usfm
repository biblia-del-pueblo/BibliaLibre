\c 5
\p 
\v 1 \w And Hiram| strong="H2438" \w* \w king| strong="H4428" \w* \w of Tyre| strong="H6865" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w his servants| strong="H5650" \w* \w unto Solomon| strong="H8010" \w*; [for he had heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [that they had anointed]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8804”} \w him king| strong="H4428" \w* \w in the room of his father| strong="H1" \w*: \w for Hiram| strong="H2438" \w* \w was ever| strong="H3117" \w* [a lover]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} \w of David| strong="H1732" \w*.\f + \fr 5:1 \ft Hiram: also called, Huram \f* 
\v 2 \w And Solomon| strong="H8010" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Hiram| strong="H2438" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 3 [Thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w how that David| strong="H1732" \w* \w my father| strong="H1" \w* [could]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8804”} [not build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8800”} \w an house| strong="H1004" \w* \w unto the name| strong="H8034" \w* of the \sc Lord\sc* \w his God| strong="H430" \w* \w for| strong="H6440" \w* \w the wars| strong="H4421" \w* [which were about him on every side]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8804”}, until the \sc Lord\sc* [put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w them under the soles| strong="H3709" \w* \w of his feet| strong="H7272" \w*. 
\v 4 But now the \sc Lord\sc* \w my God| strong="H430" \w* [hath given me rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8689”} \w on every side| strong="H5439" \w*, so that there is \w neither adversary| strong="H7854" \w* \w nor evil| strong="H7451" \w* \w occurrent| strong="H6294" \w*. 
\v 5 [And, behold, I purpose]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} [to build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8800”} \w an house| strong="H1004" \w* \w unto the name| strong="H8034" \w* of the \sc Lord\sc* \w my God| strong="H430" \w*, as the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto David| strong="H1732" \w* \w my father| strong="H1" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Thy son| strong="H1121" \w*, [whom I will set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon thy throne| strong="H3678" \w* [in thy room, he shall build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w an house| strong="H1004" \w* \w unto my name| strong="H8034" \w*.\f + \fr 5:5 \ft purpose: Heb. say \f* 
\v 6 [Now therefore command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8761”} [thou that they hew]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} \w me cedar trees| strong="H730" \w* \w out of Lebanon| strong="H3844" \w*; \w and my servants| strong="H5650" \w* \w shall be with thy servants| strong="H5650" \w*: [and unto thee will I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w hire| strong="H7939" \w* \w for thy servants| strong="H5650" \w* [according to all that thou shalt appoint]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}: [for thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that there is \w not among us any| strong="H376" \w* [that can skill]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} [to hew]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8800”} \w timber| strong="H6086" \w* \w like unto the Sidonians| strong="H6722" \w*.\f + \fr 5:6 \ft appoint: Heb. say \f* 
\p
\v 7 [And it came to pass, when Hiram]{strong=“H2438”} [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w the words| strong="H1697" \w* \w of Solomon| strong="H8010" \w*, [that he rejoiced]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} \w greatly| strong="H3966" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} be the \sc Lord\sc* \w this day| strong="H3117" \w*, [which hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto David| strong="H1732" \w* \w a wise| strong="H2450" \w* \w son| strong="H1121" \w* \w over this great| strong="H7227" \w* \w people| strong="H5971" \w*. 
\v 8 \w And Hiram| strong="H2438" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Solomon| strong="H8010" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [I have considered]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [the things which thou sentest]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} to me for: and [I will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w all thy desire| strong="H2656" \w* \w concerning timber| strong="H6086" \w* \w of cedar| strong="H730" \w*, \w and concerning timber| strong="H6086" \w* \w of fir| strong="H1265" \w*.\f + \fr 5:8 \ft considered: Heb. heard \f* 
\v 9 \w My servants| strong="H5650" \w* shall bring them [down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8686”} \w from Lebanon| strong="H3844" \w* \w unto the sea| strong="H3220" \w*: [and I will convey]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w them by sea| strong="H3220" \w* \w in floats| strong="H1702" \w* \w unto the place| strong="H4725" \w* [that thou shalt appoint]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} [me, and will cause them to be discharged]{strong=“H5310” x-morph=“strongMorph: \sc Th\sc*8765”} [there, and thou shalt receive]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} them: [and thou shalt accomplish]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w my desire| strong="H2656" \w*, [in giving]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w food| strong="H3899" \w* \w for my household| strong="H1004" \w*.\f + \fr 5:9 \ft appoint: Heb. send \f* 
\p
\v 10 \w So Hiram| strong="H2438" \w* [gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w Solomon| strong="H8010" \w* \w cedar| strong="H730" \w* \w trees| strong="H6086" \w* \w and fir| strong="H1265" \w* \w trees| strong="H6086" \w* according to \w all his desire| strong="H2656" \w*. 
\v 11 \w And Solomon| strong="H8010" \w* [gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w Hiram| strong="H2438" \w* \w twenty| strong="H6242" \w* \w thousand| strong="H505" \w* \w measures| strong="H3734" \w* \w of wheat| strong="H2406" \w* for \w food| strong="H4361" \w* \w to his household| strong="H1004" \w*, \w and twenty| strong="H6242" \w* \w measures| strong="H3734" \w* \w of pure| strong="H3795" \w* \w oil| strong="H8081" \w*: [thus gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w Solomon| strong="H8010" \w* \w to Hiram| strong="H2438" \w* \w year| strong="H8141" \w* \w by year| strong="H8141" \w*.\f + \fr 5:11 \ft measures: Heb. cors \f* 
\v 12 And the \sc Lord\sc* [gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w Solomon| strong="H8010" \w* \w wisdom| strong="H2451" \w*, [as he promised]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [him: and there was peace]{strong=“H7965”} \w between Hiram| strong="H2438" \w* \w and Solomon| strong="H8010" \w*; \w and they two| strong="H8147" \w* [made]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} \w a league| strong="H1285" \w* \w together| strong="H8147" \w*. 
\p
\v 13 \w And king| strong="H4428" \w* \w Solomon| strong="H8010" \w* [raised]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w a levy| strong="H4522" \w* \w out of all Israel| strong="H3478" \w*; \w and the levy| strong="H4522" \w* \w was thirty| strong="H7970" \w* \w thousand| strong="H505" \w* \w men| strong="H376" \w*.\f + \fr 5:13 \ft levy: Heb. tribute of men \f* 
\v 14 [And he sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w them to Lebanon| strong="H3844" \w*, \w ten| strong="H6235" \w* \w thousand| strong="H505" \w* \w a month| strong="H2320" \w* \w by courses| strong="H2487" \w*: \w a month| strong="H2320" \w* \w they were in Lebanon| strong="H3844" \w*, and \w two| strong="H8147" \w* \w months| strong="H2320" \w* \w at home| strong="H1004" \w*: \w and Adoniram| strong="H141" \w* was \w over the levy| strong="H4522" \w*. 
\v 15 \w And Solomon| strong="H8010" \w* \w had threescore and ten| strong="H7657" \w* \w thousand| strong="H505" \w* [that bare]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8802”} \w burdens| strong="H5449" \w*, \w and fourscore| strong="H8084" \w* \w thousand| strong="H505" \w* [hewers]{strong=“H2672” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the mountains| strong="H2022" \w*; 
