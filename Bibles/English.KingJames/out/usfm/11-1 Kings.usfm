\p 
\v 1 \w But king| strong="H4428" \w* \w Solomon| strong="H8010" \w* [loved]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} \w many| strong="H7227" \w* \w strange| strong="H5237" \w* \w women| strong="H802" \w*, \w together with the daughter| strong="H1323" \w* \w of Pharaoh| strong="H6547" \w*, \w women of the Moabites| strong="H4125" \w*, \w Ammonites| strong="H5984" \w*, \w Edomites| strong="H130" \w*, \w Zidonians| strong="H6722" \w*, and \w Hittites| strong="H2850" \w*;\f + \fr 11:1 \ft together…: or, beside \f* 
\v 2 \w Of the nations| strong="H1471" \w* concerning which the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [Ye shall not go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [to them, neither shall they come in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} unto you: for \w surely| strong="H403" \w* [they will turn away]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w your heart| strong="H3824" \w* \w after| strong="H310" \w* \w their gods| strong="H430" \w*: \w Solomon| strong="H8010" \w* [clave]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8804”} [unto these in love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 3 \w And he had seven| strong="H7651" \w* \w hundred| strong="H3967" \w* \w wives| strong="H802" \w*, \w princesses| strong="H8282" \w*, \w and three| strong="H7969" \w* \w hundred| strong="H3967" \w* \w concubines| strong="H6370" \w*: \w and his wives| strong="H802" \w* [turned away]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w his heart| strong="H3820" \w*. 
\v 4 [For it came to pass, when]{strong=“H6256”} \w Solomon| strong="H8010" \w* \w was old| strong="H2209" \w*, that \w his wives| strong="H802" \w* [turned away]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8689”} \w his heart| strong="H3824" \w* \w after| strong="H310" \w* \w other| strong="H312" \w* \w gods| strong="H430" \w*: \w and his heart| strong="H3824" \w* \w was not perfect| strong="H8003" \w* with the \sc Lord\sc* \w his God| strong="H430" \w*, as was \w the heart| strong="H3824" \w* \w of David| strong="H1732" \w* \w his father| strong="H1" \w*. 
\v 5 \w For Solomon| strong="H8010" \w* [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w Ashtoreth| strong="H6253" \w* \w the goddess| strong="H430" \w* \w of the Zidonians| strong="H6722" \w*, \w and after| strong="H310" \w* \w Milcom| strong="H4445" \w* \w the abomination| strong="H8251" \w* \w of the Ammonites| strong="H5984" \w*.\f + \fr 11:5 \ft Milcom: also called, Molech \f* 
\v 6 \w And Solomon| strong="H8010" \w* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w evil| strong="H7451" \w* \w in the sight| strong="H5869" \w* of the \sc Lord\sc*, [and went not fully]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8765”} \w after| strong="H310" \w* the \sc Lord\sc*, as did \w David| strong="H1732" \w* \w his father| strong="H1" \w*.\f + \fr 11:6 \ft went…: Heb. fulfilled not after \f* 
\v 7 \w Then did Solomon| strong="H8010" \w* [build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w an high place| strong="H1116" \w* \w for Chemosh| strong="H3645" \w*, \w the abomination| strong="H8251" \w* \w of Moab| strong="H4124" \w*, \w in the hill| strong="H2022" \w* that is \w before| strong="H6440" \w* \w Jerusalem| strong="H3389" \w*, \w and for Molech| strong="H4432" \w*, \w the abomination| strong="H8251" \w* \w of the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w*. 
\v 8 [And likewise did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w he for all his strange| strong="H5237" \w* \w wives| strong="H802" \w*, [which burnt incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8688”} [and sacrificed]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8764”} \w unto their gods| strong="H430" \w*. 
\p
\v 9 And the \sc Lord\sc* [was angry]{strong=“H599” x-morph=“strongMorph: \sc Th\sc*8691”} \w with Solomon| strong="H8010" \w*, \w because his heart| strong="H3824" \w* [was turned]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} from the \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w*, [which had appeared]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto him twice| strong="H6471" \w*, 
\v 10 [And had commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w him concerning this thing| strong="H1697" \w*, [that he should not go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} \w after| strong="H310" \w* \w other| strong="H312" \w* \w gods| strong="H430" \w*: [but he kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} not that which the \sc Lord\sc* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 11 Wherefore the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Solomon| strong="H8010" \w*, [Forasmuch as this is done of thee, and thou hast not kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w my covenant| strong="H1285" \w* \w and my statutes| strong="H2708" \w*, [which I have commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [thee, I will surely]{strong=“H7167” x-morph=“strongMorph: \sc Th\sc*8800”} [rend]{strong=“H7167” x-morph=“strongMorph: \sc Th\sc*8799”} \w the kingdom| strong="H4467" \w* [from thee, and will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w it to thy servant| strong="H5650" \w*.\f + \fr 11:11 \ft is done…: Heb. is with thee \f* 
\v 12 \w Notwithstanding in thy days| strong="H3117" \w* [I will not do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w it for David| strong="H1732" \w* [thy father’s]{strong=“H1”} sake: but [I will rend]{strong=“H7167” x-morph=“strongMorph: \sc Th\sc*8799”} \w it out of the hand| strong="H3027" \w* \w of thy son| strong="H1121" \w*. 
\v 13 \w Howbeit| strong="H7535" \w* [I will not rend away]{strong=“H7167” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the kingdom| strong="H4467" \w*; but [will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w one| strong="H259" \w* \w tribe| strong="H7626" \w* \w to thy son| strong="H1121" \w* \w for David| strong="H1732" \w* [my servant’s]{strong=“H5650”} [sake, and for Jerusalem’s]{strong=“H3389”} [sake which I have chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\p
\v 14 And the \sc Lord\sc* [stirred up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8686”} \w an adversary| strong="H7854" \w* \w unto Solomon| strong="H8010" \w*, \w Hadad| strong="H1908" \w* \w the Edomite| strong="H130" \w*: he was [of the king’s]{strong=“H4428”} \w seed| strong="H2233" \w* \w in Edom| strong="H123" \w*. 
\v 15 [For it came to pass, when David]{strong=“H1732”} \w was in Edom| strong="H123" \w*, \w and Joab| strong="H3097" \w* \w the captain| strong="H8269" \w* \w of the host| strong="H6635" \w* [was gone up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8800”} [to bury]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8763”} \w the slain| strong="H2491" \w*, [after he had smitten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w every male| strong="H2145" \w* \w in Edom| strong="H123" \w*; 
\v 16 (\w For six| strong="H8337" \w* \w months| strong="H2320" \w* \w did Joab| strong="H3097" \w* [remain]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w there with all Israel| strong="H3478" \w*, [until he had cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w every male| strong="H2145" \w* \w in Edom| strong="H123" \w*:) 
