\c 19
\p 
\v 1 \w And Ahab| strong="H256" \w* [told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w Jezebel| strong="H348" \w* \w all that Elijah| strong="H452" \w* [had done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [and withal how he had slain]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”} \w all the prophets| strong="H5030" \w* \w with the sword| strong="H2719" \w*. 
\v 2 \w Then Jezebel| strong="H348" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w a messenger| strong="H4397" \w* \w unto Elijah| strong="H452" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w So let the gods| strong="H430" \w* [do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} to me, [and more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [also, if I make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w not thy life| strong="H5315" \w* \w as the life| strong="H5315" \w* \w of one| strong="H259" \w* \w of them by to morrow| strong="H4279" \w* \w about this time| strong="H6256" \w*. 
\v 3 [And when he saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} that, [he arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w for his life| strong="H5315" \w*, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [to Beer-sheba]{strong=“H884”}, which belongeth \w to Judah| strong="H3063" \w*, [and left]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8686”} \w his servant| strong="H5288" \w* there. 
\p
\v 4 [But he himself went]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} [a day’s]{strong=“H3117”} \w journey| strong="H1870" \w* \w into the wilderness| strong="H4057" \w*, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and sat down]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w under a| strong="H259" \w* \w juniper tree| strong="H7574" \w*: [and he requested]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} \w for himself| strong="H5315" \w* [that he might die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”}; [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w It is enough| strong="H7227" \w*; now, O \sc Lord\sc*, [take away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w my life| strong="H5315" \w*; for I am \w not better| strong="H2896" \w* \w than my fathers| strong="H1" \w*.\f + \fr 19:4 \ft for himself: Heb. for his life \f* 
\v 5 [And as he lay]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} [and slept]{strong=“H3462” x-morph=“strongMorph: \sc Th\sc*8799”} \w under a| strong="H259" \w* \w juniper tree| strong="H7574" \w*, [behold, then an angel]{strong=“H4397”} [touched]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8802”} [him, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”} and [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8798”}. 
\v 6 [And he looked]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”}, and, behold, there was \w a cake| strong="H5692" \w* \w baken on the coals| strong="H7529" \w*, \w and a cruse| strong="H6835" \w* \w of water| strong="H4325" \w* \w at his head| strong="H4763" \w*. [And he did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [and drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”}, [and laid him down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} [again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 19:6 \ft head: Heb. bolster \f* 
\v 7 \w And the angel| strong="H4397" \w* of the \sc Lord\sc* [came again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w the second time| strong="H8145" \w*, [and touched]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8799”} [him, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”} and [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8798”}; \w because the journey| strong="H1870" \w* is \w too great| strong="H7227" \w* for thee. 
\v 8 [And he arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [and drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”}, [and went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the strength| strong="H3581" \w* \w of that meat| strong="H396" \w* \w forty| strong="H705" \w* \w days| strong="H3117" \w* \w and forty| strong="H705" \w* \w nights| strong="H3915" \w* \w unto Horeb| strong="H2722" \w* \w the mount| strong="H2022" \w* \w of God| strong="H430" \w*. 
\p
\v 9 [And he came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w thither unto a cave| strong="H4631" \w*, [and lodged]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} [there; and, behold, the word]{strong=“H1697”} of the \sc Lord\sc* came [to him, and he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, What doest thou here, Elijah]{strong=“H452”}? 
\v 10 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I have been very]{strong=“H7065” x-morph=“strongMorph: \sc Th\sc*8763”} [jealous]{strong=“H7065” x-morph=“strongMorph: \sc Th\sc*8765”} for the \sc Lord\sc* \w God| strong="H430" \w* \w of hosts| strong="H6635" \w*: \w for the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [have forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy covenant| strong="H1285" \w*, [thrown down]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8804”} \w thine altars| strong="H4196" \w*, [and slain]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy prophets| strong="H5030" \w* \w with the sword| strong="H2719" \w*; and I, even [I only, am left]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8735”}; [and they seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w my life| strong="H5315" \w*, [to take it away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 11 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8798”}, [and stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon the mount| strong="H2022" \w* \w before| strong="H6440" \w* the \sc Lord\sc*. And, behold, the \sc Lord\sc* [passed by]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and a great| strong="H1419" \w* \w and strong| strong="H2389" \w* \w wind| strong="H7307" \w* [rent]{strong=“H6561” x-morph=“strongMorph: \sc Th\sc*8764”} \w the mountains| strong="H2022" \w*, [and brake in pieces]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8764”} \w the rocks| strong="H5553" \w* \w before| strong="H6440" \w* the \sc Lord\sc*; but the \sc Lord\sc* was \w not in the wind| strong="H7307" \w*: \w and after| strong="H310" \w* \w the wind| strong="H7307" \w* \w an earthquake| strong="H7494" \w*; but the \sc Lord\sc* was \w not in the earthquake| strong="H7494" \w*: 
\v 12 \w And after| strong="H310" \w* \w the earthquake| strong="H7494" \w* \w a fire| strong="H784" \w*; but the \sc Lord\sc* was \w not in the fire| strong="H784" \w*: \w and after| strong="H310" \w* \w the fire| strong="H784" \w* \w a still| strong="H1827" \w* \w small| strong="H1851" \w* \w voice| strong="H6963" \w*. 
\v 13 And it was so, \w when Elijah| strong="H452" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} it, [that he wrapped]{strong=“H3874” x-morph=“strongMorph: \sc Th\sc*8686”} \w his face| strong="H6440" \w* \w in his mantle| strong="H155" \w*, [and went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”}, [and stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the entering in| strong="H6607" \w* \w of the cave| strong="H4631" \w*. And, behold, there came \w a voice| strong="H6963" \w* [unto him, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [What doest thou here, Elijah]{strong=“H452”}? 
\v 14 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I have been very]{strong=“H7065” x-morph=“strongMorph: \sc Th\sc*8763”} [jealous]{strong=“H7065” x-morph=“strongMorph: \sc Th\sc*8765”} for the \sc Lord\sc* \w God| strong="H430" \w* \w of hosts| strong="H6635" \w*: \w because the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [have forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy covenant| strong="H1285" \w*, [thrown down]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8804”} \w thine altars| strong="H4196" \w*, [and slain]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy prophets| strong="H5030" \w* \w with the sword| strong="H2719" \w*; and I, even [I only, am left]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8735”}; [and they seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w my life| strong="H5315" \w*, [to take it away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 15 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} \w on thy way| strong="H1870" \w* \w to the wilderness| strong="H4057" \w* \w of Damascus| strong="H1834" \w*: [and when thou comest]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, [anoint]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8804”} \w Hazael| strong="H2371" \w* to be \w king| strong="H4428" \w* \w over Syria| strong="H758" \w*: 
\v 16 \w And Jehu| strong="H3058" \w* \w the son| strong="H1121" \w* \w of Nimshi| strong="H5250" \w* [shalt thou anoint]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8799”} to be \w king| strong="H4428" \w* \w over Israel| strong="H3478" \w*: \w and Elisha| strong="H477" \w* \w the son| strong="H1121" \w* \w of Shaphat| strong="H8202" \w* [of Abel-meholah]{strong=“H65”} [shalt thou anoint]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8799”} to be \w prophet| strong="H5030" \w* in thy room.\f + \fr 19:16 \ft Elisha: Gr. Eliseus \f* 
\v 17 And it shall come to pass, that [him that escapeth]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8737”} \w the sword| strong="H2719" \w* \w of Hazael| strong="H2371" \w* \w shall Jehu| strong="H3058" \w* [slay]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8686”}: [and him that escapeth]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8737”} \w from the sword| strong="H2719" \w* \w of Jehu| strong="H3058" \w* \w shall Elisha| strong="H477" \w* [slay]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 18 [Yet I have left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8689”} me \w seven| strong="H7651" \w* \w thousand| strong="H505" \w* \w in Israel| strong="H3478" \w*, \w all the knees| strong="H1290" \w* [which have not bowed]{strong=“H3766” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto Baal| strong="H1168" \w*, \w and every mouth| strong="H6310" \w* [which hath not kissed]{strong=“H5401” x-morph=“strongMorph: \sc Th\sc*8804”} him.\f + \fr 19:18 \ft I have…: or, I will leave \f* 
\p
\v 19 [So he departed]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [thence, and found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w Elisha| strong="H477" \w* \w the son| strong="H1121" \w* \w of Shaphat| strong="H8202" \w*, who was [plowing]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8802”} with [twelve]{strong=“H6240 H8147”} \w yoke| strong="H6776" \w* of oxen \w before| strong="H6440" \w* [him, and he with the twelfth]{strong=“H6240 H8147”}: \w and Elijah| strong="H452" \w* [passed]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} [by him, and cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w his mantle| strong="H155" \w* upon him. 
\v 20 [And he left]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w the oxen| strong="H1241" \w*, [and ran]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w Elijah| strong="H452" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Let me, I pray thee, kiss]{strong=“H5401” x-morph=“strongMorph: \sc Th\sc*8799”} \w my father| strong="H1" \w* \w and my mother| strong="H517" \w*, and then [I will follow]{strong=“H310 H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [thee. And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Go back]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} [again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”}: [for what have I done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} to thee?\f + \fr 19:20 \ft Go…: Heb. Go return \f* 
\v 21 [And he returned back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w from him| strong="H310" \w*, [and took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a yoke| strong="H6776" \w* \w of oxen| strong="H1241" \w*, [and slew]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and boiled]{strong=“H1310” x-morph=“strongMorph: \sc Th\sc*8765”} \w their flesh| strong="H1320" \w* \w with the instruments| strong="H3627" \w* \w of the oxen| strong="H1241" \w*, [and gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the people| strong="H5971" \w*, [and they did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}. [Then he arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w Elijah| strong="H452" \w*, [and ministered]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8762”} unto him.
\c 20
\p 
\v 1 [And Ben-hadad]{strong=“H1130”} \w the king| strong="H4428" \w* \w of Syria| strong="H758" \w* \w gathered| strong="H6908" \w* \w all his host| strong="H2428" \w* [together]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8804”}: and there were \w thirty| strong="H7970" \w* \w and two| strong="H8147" \w* \w kings| strong="H4428" \w* [with him, and horses]{strong=“H5483”}, \w and chariots| strong="H7393" \w*: [and he went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} [and besieged]{strong=“H6696” x-morph=“strongMorph: \sc Th\sc*8799”} \w Samaria| strong="H8111" \w*, [and warred]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8735”} against it. 
\v 2 [And he sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w messengers| strong="H4397" \w* \w to Ahab| strong="H256" \w* \w king| strong="H4428" \w* \w of Israel| strong="H3478" \w* \w into the city| strong="H5892" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [Ben-hadad]{strong=“H1130”}, 
\v 3 \w Thy silver| strong="H3701" \w* \w and thy gold| strong="H2091" \w* is [mine; thy wives]{strong=“H802”} \w also and thy children| strong="H1121" \w*, even \w the goodliest| strong="H2896" \w*, are mine. 
\v 4 \w And the king| strong="H4428" \w* \w of Israel| strong="H3478" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w My lord| strong="H113" \w*, \w O king| strong="H4428" \w*, \w according to thy saying| strong="H1697" \w*, I am thine, and all that I have. 
\v 5 \w And the messengers| strong="H4397" \w* [came again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Thus speaketh]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [Ben-hadad]{strong=“H1130”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Although I have sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [unto thee, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Thou shalt deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w me thy silver| strong="H3701" \w*, \w and thy gold| strong="H2091" \w*, \w and thy wives| strong="H802" \w*, \w and thy children| strong="H1121" \w*; 
\v 6 [Yet I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w my servants| strong="H5650" \w* \w unto thee to morrow| strong="H4279" \w* \w about this time| strong="H6256" \w*, [and they shall search]{strong=“H2664” x-morph=“strongMorph: \sc Th\sc*8765”} \w thine house| strong="H1004" \w*, \w and the houses| strong="H1004" \w* \w of thy servants| strong="H5650" \w*; [and it shall be]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8804”}, that \w whatsoever is pleasant| strong="H4261" \w* \w in thine eyes| strong="H5869" \w*, [they shall put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} it \w in their hand| strong="H3027" \w*, and take it [away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 20:6 \ft pleasant: Heb. desirable \f* 
\v 7 \w Then the king| strong="H4428" \w* \w of Israel| strong="H3478" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the elders| strong="H2205" \w* \w of the land| strong="H776" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Mark]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”}, [I pray you, and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} how this man [seeketh]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w mischief| strong="H7451" \w*: [for he sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto me for my wives| strong="H802" \w*, \w and for my children| strong="H1121" \w*, \w and for my silver| strong="H3701" \w*, \w and for my gold| strong="H2091" \w*; [and I denied]{strong=“H4513” x-morph=“strongMorph: \sc Th\sc*8804”} him not.\f + \fr 20:7 \ft I denied…: Heb. I kept not back from him \f* 
\v 8 \w And all the elders| strong="H2205" \w* \w and all the people| strong="H5971" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} not unto him, [nor consent]{strong=“H14” x-morph=“strongMorph: \sc Th\sc*8799”}. 
