\v 17 \w And the king| strong="H4428" \w* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”}, [and they brought]{strong=“H5265” x-morph=“strongMorph: \sc Th\sc*8686”} \w great| strong="H1419" \w* \w stones| strong="H68" \w*, \w costly| strong="H3368" \w* \w stones| strong="H68" \w*, and \w hewed| strong="H1496" \w* \w stones| strong="H68" \w*, [to lay the foundation]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8763”} \w of the house| strong="H1004" \w*. 
\v 18 [And Solomon’s]{strong=“H8010”} [builders]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8802”} [and Hiram’s]{strong=“H2438”} [builders]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8802”} [did hew]{strong=“H6458” x-morph=“strongMorph: \sc Th\sc*8799”} them, \w and the stonesquarers| strong="H1382" \w*: [so they prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8686”} \w timber| strong="H6086" \w* \w and stones| strong="H68" \w* [to build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8800”} \w the house| strong="H1004" \w*.\f + \fr 5:18 \ft stonesquarers: or, Giblites \f*
\c 6
\p 
\v 1 \w And it came to pass in the four| strong="H702" \w* [hundred]{strong=“H8141 H3967”} \w and eightieth| strong="H8084" \w* \w year| strong="H8141" \w* \w after the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [were come out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”} \w of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, \w in the fourth| strong="H7243" \w* \w year| strong="H8141" \w* [of Solomon’s]{strong=“H8010”} [reign]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8800”} \w over Israel| strong="H3478" \w*, \w in the month| strong="H2320" \w* \w Zif| strong="H2099" \w*, which is \w the second| strong="H8145" \w* \w month| strong="H2320" \w*, [that he began to build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w the house| strong="H1004" \w* of the \sc Lord\sc*.\f + \fr 6:1 \ft began…: Heb. built \f* 
\v 2 \w And the house| strong="H1004" \w* \w which king| strong="H4428" \w* \w Solomon| strong="H8010" \w* [built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} for the \sc Lord\sc*, \w the length| strong="H753" \w* thereof was \w threescore| strong="H8346" \w* \w cubits| strong="H520" \w*, \w and the breadth| strong="H7341" \w* \w thereof twenty| strong="H6242" \w* cubits, \w and the height| strong="H6967" \w* \w thereof thirty| strong="H7970" \w* \w cubits| strong="H520" \w*. 
\v 3 \w And the porch| strong="H197" \w* \w before| strong="H6440" \w* \w the temple| strong="H1964" \w* \w of the house| strong="H1004" \w*, \w twenty| strong="H6242" \w* \w cubits| strong="H520" \w* was \w the length| strong="H753" \w* [thereof, according to the breadth]{strong=“H7341”} \w of the house| strong="H1004" \w*; and \w ten| strong="H6235" \w* \w cubits| strong="H520" \w* was \w the breadth| strong="H7341" \w* \w thereof before the house| strong="H1004" \w*. 
\v 4 \w And for the house| strong="H1004" \w* [he made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w windows| strong="H2474" \w* [of narrow]{strong=“H331” x-morph=“strongMorph: \sc Th\sc*8801”} \w lights| strong="H8261" \w*.\f + \fr 6:4 \ft of…: or, broad within, and narrow without: or, skewed and closed \f* 
\p
\v 5 \w And against the wall| strong="H7023" \w* \w of the house| strong="H1004" \w* [he built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} [chambers]{strong=“H3326 H3326” x-morph=“strongMorph: \sc Th\sc*8675”} \w round about| strong="H5439" \w*, against \w the walls| strong="H7023" \w* \w of the house| strong="H1004" \w* \w round about| strong="H5439" \w*, both \w of the temple| strong="H1964" \w* \w and of the oracle| strong="H1687" \w*: [and he made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w chambers| strong="H6763" \w* \w round about| strong="H5439" \w*:\f + \fr 6:5 \ft against the wall: or, upon, or, joining to the wall \f* \f + \fr 6:5 \ft built chambers: Heb. built floors \f* \f + \fr 6:5 \ft made chambers: Heb. made ribs \f* 
\v 6 \w The nethermost| strong="H8481" \w* [chamber ]{strong=“H3326 H3326” x-morph=“strongMorph: \sc Th\sc*8675”} was \w five| strong="H2568" \w* \w cubits| strong="H520" \w* \w broad| strong="H7341" \w*, \w and the middle| strong="H8484" \w* was \w six| strong="H8337" \w* \w cubits| strong="H520" \w* \w broad| strong="H7341" \w*, \w and the third| strong="H7992" \w* was \w seven| strong="H7651" \w* \w cubits| strong="H520" \w* \w broad| strong="H7341" \w*: for without in the wall \w of| strong="H2351" \w* \w the house| strong="H1004" \w* [he made]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w narrowed rests| strong="H4052" \w* \w round about| strong="H5439" \w*, that the beams [should not be fastened]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the walls| strong="H7023" \w* \w of the house| strong="H1004" \w*.\f + \fr 6:6 \ft narrowed…: Heb. narrowings, or, rebatements \f* 
\v 7 \w And the house| strong="H1004" \w*, [when it was in building]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8736”}, [was built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8738”} \w of stone| strong="H68" \w* \w made ready| strong="H8003" \w* \w before it was brought| strong="H4551" \w* [thither: so that there was neither hammer]{strong=“H4717”} \w nor axe| strong="H1631" \w* nor \w any tool| strong="H3627" \w* \w of iron| strong="H1270" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the house| strong="H1004" \w*, [while it was in building]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8736”}. 
\v 8 \w The door| strong="H6607" \w* \w for the middle| strong="H8484" \w* \w chamber| strong="H6763" \w* was \w in the right| strong="H3233" \w* \w side| strong="H3802" \w* \w of the house| strong="H1004" \w*: [and they went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w with winding stairs| strong="H3883" \w* \w into the middle| strong="H8484" \w* chamber, \w and out of the middle| strong="H8484" \w* \w into the third| strong="H7992" \w*.\f + \fr 6:8 \ft side: Heb. shoulder \f* 
\v 9 [So he built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w the house| strong="H1004" \w*, [and finished]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8762”} [it; and covered]{strong=“H5603” x-morph=“strongMorph: \sc Th\sc*8799”} \w the house| strong="H1004" \w* \w with beams| strong="H1356" \w* \w and boards| strong="H7713" \w* \w of cedar| strong="H730" \w*.\f + \fr 6:9 \ft with…: or, the vaultbeams and the panellings with cedar \f* 
\v 10 And then [he built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} [chambers]{strong=“H3326 H3326” x-morph=“strongMorph: \sc Th\sc*8675”} \w against all the house| strong="H1004" \w*, \w five| strong="H2568" \w* \w cubits| strong="H520" \w* \w high| strong="H6967" \w*: [and they rested]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8799”} \w on the house| strong="H1004" \w* with \w timber| strong="H6086" \w* \w of cedar| strong="H730" \w*. 
\p
\v 11 \w And the word| strong="H1697" \w* of the \sc Lord\sc* \w came to Solomon| strong="H8010" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 12 Concerning \w this house| strong="H1004" \w* [which thou art in building]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8802”}, [if thou wilt walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w in my statutes| strong="H2708" \w*, [and execute]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w my judgments| strong="H4941" \w*, [and keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w all my commandments| strong="H4687" \w* [to walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} [in them; then will I perform]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} \w my word| strong="H1697" \w* [with thee, which I spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto David| strong="H1732" \w* \w thy father| strong="H1" \w*: 
\v 13 [And I will dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8804”} \w among| strong="H8432" \w* \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [and will not forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w my people| strong="H5971" \w* \w Israel| strong="H3478" \w*. 
\v 14 \w So Solomon| strong="H8010" \w* [built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w the house| strong="H1004" \w*, [and finished]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8762”} it. 
