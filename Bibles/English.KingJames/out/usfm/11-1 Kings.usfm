\v 28 \w And the word| strong="H1697" \w* of the \sc Lord\sc* \w came to Elijah| strong="H452" \w* \w the Tishbite| strong="H8664" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 29 [Seest]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w thou how Ahab| strong="H256" \w* [humbleth]{strong=“H3665” x-morph=“strongMorph: \sc Th\sc*8738”} \w himself before| strong="H6440" \w* [me? because]{strong=“H3282”} [he humbleth]{strong=“H3665” x-morph=“strongMorph: \sc Th\sc*8738”} \w himself before| strong="H6440" \w* [me, I will not bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w the evil| strong="H7451" \w* \w in his days| strong="H3117" \w*: but [in his son’s]{strong=“H1121”} \w days| strong="H3117" \w* [will I bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w the evil| strong="H7451" \w* \w upon his house| strong="H1004" \w*.
\c 22
\p 
\v 1 [And they continued]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w three| strong="H7969" \w* \w years| strong="H8141" \w* \w without war| strong="H4421" \w* \w between Syria| strong="H758" \w* \w and Israel| strong="H3478" \w*. 
\v 2 \w And it came to pass in the third| strong="H7992" \w* \w year| strong="H8141" \w*, \w that Jehoshaphat| strong="H3092" \w* \w the king| strong="H4428" \w* \w of Judah| strong="H3063" \w* [came down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the king| strong="H4428" \w* \w of Israel| strong="H3478" \w*. 
\v 3 \w And the king| strong="H4428" \w* \w of Israel| strong="H3478" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his servants| strong="H5650" \w*, [Know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w ye that Ramoth| strong="H7433" \w* \w in Gilead| strong="H1568" \w* is ours, and we be [still]{strong=“H2814” x-morph=“strongMorph: \sc Th\sc*8688”}, and [take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} \w it not out of the hand| strong="H3027" \w* \w of the king| strong="H4428" \w* \w of Syria| strong="H758" \w*?\f + \fr 22:3 \ft still…: Heb. silent from taking it \f* 
\v 4 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Jehoshaphat| strong="H3092" \w*, [Wilt thou go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w with me to battle| strong="H4421" \w* [to Ramoth-gilead]{strong=“H1568 H7433”}? \w And Jehoshaphat| strong="H3092" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the king| strong="H4428" \w* \w of Israel| strong="H3478" \w*, I am \w as thou| strong="H3644" \w* art, \w my people| strong="H5971" \w* \w as thy people| strong="H5971" \w*, \w my horses| strong="H5483" \w* \w as thy horses| strong="H5483" \w*. 
\v 5 \w And Jehoshaphat| strong="H3092" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the king| strong="H4428" \w* \w of Israel| strong="H3478" \w*, [Enquire]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8798”}, [I pray thee, at the word]{strong=“H1697”} of the \sc Lord\sc* \w to day| strong="H3117" \w*. 
\v 6 \w Then the king| strong="H4428" \w* \w of Israel| strong="H3478" \w* \w gathered| strong="H6908" \w* \w the prophets| strong="H5030" \w* [together]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8799”}, \w about four| strong="H702" \w* \w hundred| strong="H3967" \w* \w men| strong="H376" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Shall I go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [against Ramoth-gilead]{strong=“H1568 H7433”} \w to battle| strong="H4421" \w*, [or shall I forbear]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8799”}? [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”}; \w for the Lord| strong="H136" \w* [shall deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} it \w into the hand| strong="H3027" \w* \w of the king| strong="H4428" \w*. 
\v 7 \w And Jehoshaphat| strong="H3092" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Is there \w not here a prophet| strong="H5030" \w* of the \sc Lord\sc* \w besides| strong="H5750" \w*, [that we might enquire]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”} of him? 
\v 8 \w And the king| strong="H4428" \w* \w of Israel| strong="H3478" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Jehoshaphat| strong="H3092" \w*, There is \w yet one| strong="H259" \w* \w man| strong="H376" \w*, \w Micaiah| strong="H4321" \w* \w the son| strong="H1121" \w* \w of Imlah| strong="H3229" \w*, [by whom we may enquire]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8800”} of the \sc Lord\sc*: [but I hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”} [him; for he doth not prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8691”} \w good| strong="H2896" \w* [concerning me, but evil]{strong=“H7451”}. \w And Jehoshaphat| strong="H3092" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Let not the king| strong="H4428" \w* [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} so. 
\v 9 \w Then the king| strong="H4428" \w* \w of Israel| strong="H3478" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w an| strong="H259" \w* \w officer| strong="H5631" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Hasten]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8761”} hither \w Micaiah| strong="H4321" \w* \w the son| strong="H1121" \w* \w of Imlah| strong="H3229" \w*.\f + \fr 22:9 \ft officer: or, eunuch \f* 
\v 10 \w And the king| strong="H4428" \w* \w of Israel| strong="H3478" \w* \w and Jehoshaphat| strong="H3092" \w* \w the king| strong="H4428" \w* \w of Judah| strong="H3063" \w* [sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w each| strong="H376" \w* \w on his throne| strong="H3678" \w*, [having put on]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8794”} \w their robes| strong="H899" \w*, \w in a void place| strong="H1637" \w* \w in the entrance| strong="H6607" \w* \w of the gate| strong="H8179" \w* \w of Samaria| strong="H8111" \w*; \w and all the prophets| strong="H5030" \w* [prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8693”} \w before| strong="H6440" \w* them.\f + \fr 22:10 \ft void…: Heb. floor \f* 
\v 11 \w And Zedekiah| strong="H6667" \w* \w the son| strong="H1121" \w* \w of Chenaanah| strong="H3668" \w* [made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w him horns| strong="H7161" \w* \w of iron| strong="H1270" \w*: [and he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [With these shalt thou push]{strong=“H5055” x-morph=“strongMorph: \sc Th\sc*8762”} \w the Syrians| strong="H758" \w*, [until thou have consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8763”} them. 
\v 12 \w And all the prophets| strong="H5030" \w* [prophesied ]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8737”} [so, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”} [to Ramoth-gilead]{strong=“H1568 H7433”}, [and prosper]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8685”}: for the \sc Lord\sc* [shall deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} it [into the king’s]{strong=“H4428”} \w hand| strong="H3027" \w*. 
\v 13 \w And the messenger| strong="H4397" \w* [that was gone]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} [to call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8800”} \w Micaiah| strong="H4321" \w* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [unto him, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Behold now, the words]{strong=“H1697”} \w of the prophets| strong="H5030" \w* declare \w good| strong="H2896" \w* \w unto the king| strong="H4428" \w* \w with one| strong="H259" \w* \w mouth| strong="H6310" \w*: \w let thy word| strong="H1697" \w*, [I pray thee, be like the word]{strong=“H1697”} \w of one| strong="H259" \w* [of them, and speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} that which is \w good| strong="H2896" \w*. 
\v 14 \w And Micaiah| strong="H4321" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, As the \sc Lord\sc* \w liveth| strong="H2416" \w*, what the \sc Lord\sc* [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, that will I speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\p
\v 15 [So he came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the king| strong="H4428" \w*. \w And the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Micaiah]{strong=“H4321”}, [shall we go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [against Ramoth-gilead]{strong=“H1568 H7433”} \w to battle| strong="H4421" \w*, [or shall we forbear]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8799”}? [And he answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [him, Go]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”}, [and prosper]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8685”}: for the \sc Lord\sc* [shall deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} it \w into the hand| strong="H3027" \w* \w of the king| strong="H4428" \w*. 
\v 16 \w And the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, How many times]{strong=“H6471”} [shall I adjure]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8688”} [thee that thou tell]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} me nothing but that which is \w true| strong="H571" \w* \w in the name| strong="H8034" \w* of the \sc Lord\sc*? 
\v 17 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w all Israel| strong="H3478" \w* [scattered]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8737”} \w upon the hills| strong="H2022" \w*, \w as sheep| strong="H6629" \w* [that have not a shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}: and the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w These have no master| strong="H113" \w*: [let them return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w every man| strong="H376" \w* \w to his house| strong="H1004" \w* \w in peace| strong="H7965" \w*. 
