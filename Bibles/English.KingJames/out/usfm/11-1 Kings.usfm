\p
\v 33 \w After| strong="H310" \w* \w this thing| strong="H1697" \w* \w Jeroboam| strong="H3379" \w* [returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w not from his evil| strong="H7451" \w* \w way| strong="H1870" \w*, [but made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the lowest| strong="H7098" \w* \w of the people| strong="H5971" \w* \w priests| strong="H3548" \w* \w of the high places| strong="H1116" \w*: \w whosoever would| strong="H2655" \w*, [he consecrated]{strong=“H3027 H4390” x-morph=“strongMorph: \sc Th\sc*8762”} him, and he became one \w of the priests| strong="H3548" \w* \w of the high places| strong="H1116" \w*.\f + \fr 13:33 \ft made…: Heb. returned and made \f* \f + \fr 13:33 \ft consecrated…: Heb. filled his hand \f* 
\v 34 \w And this thing| strong="H1697" \w* \w became sin| strong="H2403" \w* \w unto the house| strong="H1004" \w* \w of Jeroboam| strong="H3379" \w*, even to cut it [off]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8687”}, [and to destroy]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8687”} it \w from off the face| strong="H6440" \w* \w of the earth| strong="H127" \w*.
\c 14
\p 
\v 1 \w At that time| strong="H6256" \w* \w Abijah| strong="H29" \w* \w the son| strong="H1121" \w* \w of Jeroboam| strong="H3379" \w* [fell sick]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 2 \w And Jeroboam| strong="H3379" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to his wife| strong="H802" \w*, [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [I pray thee, and disguise]{strong=“H8138” x-morph=“strongMorph: \sc Th\sc*8690”} [thyself, that thou be not known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w to be the wife| strong="H802" \w* \w of Jeroboam| strong="H3379" \w*; [and get]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee to Shiloh| strong="H7887" \w*: behold, there is \w Ahijah| strong="H281" \w* \w the prophet| strong="H5030" \w*, [which told]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} me that I should be \w king| strong="H4428" \w* \w over this people| strong="H5971" \w*. 
\v 3 [And take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w with thee| strong="H3027" \w* \w ten| strong="H6235" \w* \w loaves| strong="H3899" \w*, \w and cracknels| strong="H5350" \w*, \w and a cruse| strong="H1228" \w* \w of honey| strong="H1706" \w*, [and go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to him: he shall tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee what shall become of the child| strong="H5288" \w*.\f + \fr 14:3 \ft with…: Heb. in thine hand \f* \f + \fr 14:3 \ft cracknels: or, cakes \f* \f + \fr 14:3 \ft cruse: or, bottle \f* 
\v 4 [And Jeroboam’s]{strong=“H3379”} \w wife| strong="H802" \w* [did so]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}, [and arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Shiloh| strong="H7887" \w*, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the house| strong="H1004" \w* \w of Ahijah| strong="H281" \w*. \w But Ahijah| strong="H281" \w* [could]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8804”} [not see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”}; \w for his eyes| strong="H5869" \w* [were set]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”} \w by reason of his age| strong="H7869" \w*.\f + \fr 14:4 \ft were…: Heb. stood for his hoariness \f* 
\p
\v 5 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto Ahijah| strong="H281" \w*, [Behold, the wife]{strong=“H802”} \w of Jeroboam| strong="H3379" \w* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [to ask]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8800”} \w a thing| strong="H1697" \w* \w of thee for her son| strong="H1121" \w*; for he is [sick]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8802”}: \w thus| strong="H2090" \w* [and thus shalt thou say]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [unto her: for it shall be, when she cometh in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}, that she shall feign herself to be [another]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8693”} woman. 
\v 6 And it was so, \w when Ahijah| strong="H281" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w the sound| strong="H6963" \w* \w of her feet| strong="H7272" \w*, [as she came in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w at the door| strong="H6607" \w*, [that he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Come in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”}, \w thou wife| strong="H802" \w* \w of Jeroboam| strong="H3379" \w*; why feignest thou thyself to be [another]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8693”}? for I am [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8803”} to thee with \w heavy| strong="H7186" \w* tidings.\f + \fr 14:6 \ft heavy: Heb. hard \f* 
\p
\v 7 [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [tell]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w Jeroboam| strong="H3379" \w*, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w*, \w Forasmuch as| strong="H3282" \w* [I exalted]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee from among| strong="H8432" \w* \w the people| strong="H5971" \w*, [and made]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee prince| strong="H5057" \w* \w over my people| strong="H5971" \w* \w Israel| strong="H3478" \w*, 
