\v 40 \w And as thy servant| strong="H5650" \w* [was busy]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} [here and there, he was gone]{strong=“H369”}. \w And the king| strong="H4428" \w* \w of Israel| strong="H3478" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, So shall \w thy judgment| strong="H4941" \w* be; [thyself hast decided]{strong=“H2782” x-morph=“strongMorph: \sc Th\sc*8804”} it.\f + \fr 20:40 \ft he was…: Heb. he was not \f* 
\v 41 [And he hasted]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8762”}, \w and took the ashes| strong="H666" \w* [away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8686”} \w from his face| strong="H5869" \w*; \w and the king| strong="H4428" \w* \w of Israel| strong="H3478" \w* [discerned]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8686”} him that he was \w of the prophets| strong="H5030" \w*. 
\v 42 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [Because thou hast let go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} out of thy \w hand| strong="H3027" \w* \w a man| strong="H376" \w* \w whom I appointed to utter destruction| strong="H2764" \w*, \w therefore thy life| strong="H5315" \w* \w shall go for his life| strong="H5315" \w*, \w and thy people| strong="H5971" \w* \w for his people| strong="H5971" \w*. 
\v 43 \w And the king| strong="H4428" \w* \w of Israel| strong="H3478" \w* [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w to his house| strong="H1004" \w* \w heavy| strong="H5620" \w* \w and displeased| strong="H2198" \w*, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Samaria| strong="H8111" \w*.
\c 21
\p 
\v 1 \w And it came to pass after| strong="H310" \w* \w these things| strong="H1697" \w*, that \w Naboth| strong="H5022" \w* \w the Jezreelite| strong="H3158" \w* \w had a vineyard| strong="H3754" \w*, which was \w in Jezreel| strong="H3157" \w*, \w hard by| strong="H681" \w* \w the palace| strong="H1964" \w* \w of Ahab| strong="H256" \w* \w king| strong="H4428" \w* \w of Samaria| strong="H8111" \w*. 
\v 2 \w And Ahab| strong="H256" \w* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Naboth| strong="H5022" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w me thy vineyard| strong="H3754" \w*, \w that I may have it for a garden| strong="H1588" \w* \w of herbs| strong="H3419" \w*, because it is \w near| strong="H7138" \w* \w unto| strong="H681" \w* \w my house| strong="H1004" \w*: [and I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee for it a better| strong="H2896" \w* \w vineyard| strong="H3754" \w* than it; or, \w if it seem good| strong="H2896" \w* \w to thee| strong="H5869" \w*, [I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee the worth| strong="H4242" \w* \w of it in money| strong="H3701" \w*.\f + \fr 21:2 \ft seem…: Heb. be good in thine eyes \f* 
\v 3 \w And Naboth| strong="H5022" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Ahab| strong="H256" \w*, The \sc Lord\sc* \w forbid| strong="H2486" \w* [it me, that I should give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w the inheritance| strong="H5159" \w* \w of my fathers| strong="H1" \w* unto thee. 
\v 4 \w And Ahab| strong="H256" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into his house| strong="H1004" \w* \w heavy| strong="H5620" \w* \w and displeased| strong="H2198" \w* \w because of the word| strong="H1697" \w* \w which Naboth| strong="H5022" \w* \w the Jezreelite| strong="H3158" \w* [had spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [to him: for he had said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will not give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee the inheritance| strong="H5159" \w* \w of my fathers| strong="H1" \w*. [And he laid him down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon his bed| strong="H4296" \w*, [and turned away]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8686”} \w his face| strong="H6440" \w*, [and would eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w no bread| strong="H3899" \w*. 
\p
\v 5 \w But Jezebel| strong="H348" \w* \w his wife| strong="H802" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [to him, and said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [unto him, Why is thy spirit]{strong=“H7307”} \w so sad| strong="H5620" \w*, [that thou eatest]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} \w no bread| strong="H3899" \w*? 
\v 6 [And he said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [unto her, Because I spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Naboth| strong="H5022" \w* \w the Jezreelite| strong="H3158" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w me thy vineyard| strong="H3754" \w* \w for money| strong="H3701" \w*; [or else, if it please]{strong=“H2655”} [thee, I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} thee another \w vineyard| strong="H3754" \w* [for it: and he answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will not give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee my vineyard| strong="H3754" \w*. 
\v 7 \w And Jezebel| strong="H348" \w* \w his wife| strong="H802" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Dost thou now govern]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w the kingdom| strong="H4410" \w* \w of Israel| strong="H3478" \w*? [arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, and [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8798”} \w bread| strong="H3899" \w*, \w and let thine heart| strong="H3820" \w* [be merry]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8799”}: [I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee the vineyard| strong="H3754" \w* \w of Naboth| strong="H5022" \w* \w the Jezreelite| strong="H3158" \w*. 
\v 8 [So she wrote]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8799”} \w letters| strong="H5612" \w* [in Ahab’s]{strong=“H256”} \w name| strong="H8034" \w*, [and sealed]{strong=“H2856” x-morph=“strongMorph: \sc Th\sc*8799”} them \w with his seal| strong="H2368" \w*, [and sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w the letters| strong="H5612" \w* \w unto the elders| strong="H2205" \w* \w and to the nobles| strong="H2715" \w* that were \w in his city| strong="H5892" \w*, [dwelling ]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w with Naboth| strong="H5022" \w*. 
\v 9 [And she wrote]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the letters| strong="H5612" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Proclaim]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} \w a fast| strong="H6685" \w*, [and set]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8685”} \w Naboth| strong="H5022" \w* \w on high| strong="H7218" \w* \w among the people| strong="H5971" \w*:\f + \fr 21:9 \ft on high…: Heb. in the top of the people \f* 
\v 10 [And set]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8685”} \w two| strong="H8147" \w* \w men| strong="H582" \w*, \w sons| strong="H1121" \w* \w of Belial| strong="H1100" \w*, [before him, to bear witness]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8686”} [against him, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Thou didst blaspheme]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} \w God| strong="H430" \w* \w and the king| strong="H4428" \w*. And then [carry him out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”}, [and stone]{strong=“H5619” x-morph=“strongMorph: \sc Th\sc*8798”} [him, that he may die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 11 \w And the men| strong="H582" \w* \w of his city| strong="H5892" \w*, even \w the elders| strong="H2205" \w* \w and the nobles| strong="H2715" \w* [who were the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in his city| strong="H5892" \w*, [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w as Jezebel| strong="H348" \w* [had sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} unto them, and as it was [written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8803”} \w in the letters| strong="H5612" \w* [which she had sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} unto them. 
\v 12 [They proclaimed]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w a fast| strong="H6685" \w*, [and set]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8689”} \w Naboth| strong="H5022" \w* \w on high| strong="H7218" \w* \w among the people| strong="H5971" \w*. 
\v 13 [And there came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w in two| strong="H8147" \w* \w men| strong="H582" \w*, \w children| strong="H1121" \w* \w of Belial| strong="H1100" \w*, [and sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} [before him: and the men]{strong=“H582”} \w of Belial| strong="H1100" \w* [witnessed]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8686”} against him, even \w against Naboth| strong="H5022" \w*, \w in the presence of the people| strong="H5971" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Naboth| strong="H5022" \w* [did blaspheme]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} \w God| strong="H430" \w* \w and the king| strong="H4428" \w*. [Then they carried him forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w out| strong="H2351" \w* \w of the city| strong="H5892" \w*, [and stoned]{strong=“H5619” x-morph=“strongMorph: \sc Th\sc*8799”} \w him with stones| strong="H68" \w*, [that he died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 14 [Then they sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Jezebel| strong="H348" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Naboth| strong="H5022" \w* [is stoned]{strong=“H5619” x-morph=“strongMorph: \sc Th\sc*8795”}, [and is dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 15 [And it came to pass, when Jezebel]{strong=“H348”} [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w that Naboth| strong="H5022" \w* [was stoned]{strong=“H5619” x-morph=“strongMorph: \sc Th\sc*8795”}, [and was dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, \w that Jezebel| strong="H348" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Ahab| strong="H256" \w*, [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [take possession]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8798”} \w of the vineyard| strong="H3754" \w* \w of Naboth| strong="H5022" \w* \w the Jezreelite| strong="H3158" \w*, [which he refused]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8765”} [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w thee for money| strong="H3701" \w*: \w for Naboth| strong="H5022" \w* \w is not alive| strong="H2416" \w*, [but dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 16 [And it came to pass, when Ahab]{strong=“H256”} [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w that Naboth| strong="H5022" \w* [was dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}, \w that Ahab| strong="H256" \w* [rose up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} [to go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8800”} \w to the vineyard| strong="H3754" \w* \w of Naboth| strong="H5022" \w* \w the Jezreelite| strong="H3158" \w*, [to take possession]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} of it. 
\p
\v 17 \w And the word| strong="H1697" \w* of the \sc Lord\sc* \w came to Elijah| strong="H452" \w* \w the Tishbite| strong="H8664" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 18 [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8798”} [to meet]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} \w Ahab| strong="H256" \w* \w king| strong="H4428" \w* \w of Israel| strong="H3478" \w*, which is \w in Samaria| strong="H8111" \w*: behold, he is \w in the vineyard| strong="H3754" \w* \w of Naboth| strong="H5022" \w*, [whither he is gone down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} [to possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} it. 
\v 19 [And thou shalt speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [unto him, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [Hast thou killed]{strong=“H7523” x-morph=“strongMorph: \sc Th\sc*8804”}, [and also taken possession]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8804”}? [And thou shalt speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [unto him, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w In the place| strong="H4725" \w* \w where dogs| strong="H3611" \w* [licked]{strong=“H3952” x-morph=“strongMorph: \sc Th\sc*8804”} \w the blood| strong="H1818" \w* \w of Naboth| strong="H5022" \w* \w shall dogs| strong="H3611" \w* [lick]{strong=“H3952” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy blood| strong="H1818" \w*, even thine. 
\v 20 \w And Ahab| strong="H256" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Elijah| strong="H452" \w*, [Hast thou found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} [me, O mine enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}? [And he answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I have found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} thee: [because thou hast sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8692”} [thyself to work]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w evil| strong="H7451" \w* \w in the sight| strong="H5869" \w* of the \sc Lord\sc*. 
\v 21 [Behold, I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w evil| strong="H7451" \w* [upon thee, and will take away]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy posterity| strong="H310" \w*, [and will cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w from Ahab| strong="H256" \w* [him that pisseth]{strong=“H8366” x-morph=“strongMorph: \sc Th\sc*8688”} \w against the wall| strong="H7023" \w*, [and him that is shut up]{strong=“H6113” x-morph=“strongMorph: \sc Th\sc*8803”} [and left]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8803”} \w in Israel| strong="H3478" \w*, 
\v 22 [And will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thine house| strong="H1004" \w* \w like the house| strong="H1004" \w* \w of Jeroboam| strong="H3379" \w* \w the son| strong="H1121" \w* \w of Nebat| strong="H5028" \w*, \w and like the house| strong="H1004" \w* \w of Baasha| strong="H1201" \w* \w the son| strong="H1121" \w* \w of Ahijah| strong="H281" \w*, \w for the provocation| strong="H3708" \w* wherewith thou hast provoked me [to anger]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8689”}, \w and made Israel| strong="H3478" \w* [to sin]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 23 \w And of Jezebel| strong="H348" \w* [also spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} the \sc Lord\sc*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w The dogs| strong="H3611" \w* [shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jezebel| strong="H348" \w* \w by the wall| strong="H2426" \w* \w of Jezreel| strong="H3157" \w*.\f + \fr 21:23 \ft wall: or, ditch \f* 
