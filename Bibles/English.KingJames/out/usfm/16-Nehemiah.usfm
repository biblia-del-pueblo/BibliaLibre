\c 1
\p 
\v 1 \w The words| strong="H1697" \w* \w of Nehemiah| strong="H5166" \w* \w the son| strong="H1121" \w* \w of Hachaliah| strong="H2446" \w*. \w And it came to pass in the month| strong="H2320" \w* \w Chisleu| strong="H3691" \w*, \w in the twentieth| strong="H6242" \w* \w year| strong="H8141" \w*, \w as I was in Shushan| strong="H7800" \w* \w the palace| strong="H1002" \w*, 
\v 2 \w That Hanani| strong="H2607" \w*, \w one| strong="H259" \w* \w of my brethren| strong="H251" \w*, [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, he and certain \w men| strong="H582" \w* \w of Judah| strong="H3063" \w*; [and I asked]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} \w them concerning the Jews| strong="H3064" \w* \w that had escaped| strong="H6413" \w*, [which were left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8738”} \w of the captivity| strong="H7628" \w*, \w and concerning Jerusalem| strong="H3389" \w*. 
\v 3 [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, The remnant]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”} [that are left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8738”} \w of the captivity| strong="H7628" \w* \w there in the province| strong="H4082" \w* are \w in great| strong="H1419" \w* \w affliction| strong="H7451" \w* \w and reproach| strong="H2781" \w*: \w the wall| strong="H2346" \w* \w of Jerusalem| strong="H3389" \w* also is [broken down]{strong=“H6555” x-morph=“strongMorph: \sc Th\sc*8794”}, \w and the gates| strong="H8179" \w* [thereof are burned]{strong=“H3341” x-morph=“strongMorph: \sc Th\sc*8738”} \w with fire| strong="H784" \w*. 
\p
\v 4 [And it came to pass, when I heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w these words| strong="H1697" \w*, [that I sat down]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} [and wept]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8799”}, [and mourned]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8691”} certain \w days| strong="H3117" \w*, [and fasted]{strong=“H6684” x-morph=“strongMorph: \sc Th\sc*8802”}, [and prayed]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8693”} \w before| strong="H6440" \w* \w the God| strong="H430" \w* \w of heaven| strong="H8064" \w*, 
\p
\v 5 [And said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w I beseech| strong="H577" \w* thee, O \sc Lord\sc* \w God| strong="H430" \w* \w of heaven| strong="H8064" \w*, \w the great| strong="H1419" \w* [and terrible]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”} \w God| strong="H410" \w*, [that keepeth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w covenant| strong="H1285" \w* \w and mercy| strong="H2617" \w* [for them that love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} [him and observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w his commandments| strong="H4687" \w*: 
\v 6 \w Let thine ear| strong="H241" \w* \w now be attentive| strong="H7183" \w*, \w and thine eyes| strong="H5869" \w* [open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8803”}, [that thou mayest hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w the prayer| strong="H8605" \w* \w of thy servant| strong="H5650" \w*, [which I pray]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8693”} \w before| strong="H6440" \w* \w thee now| strong="H3117" \w*, \w day| strong="H3119" \w* \w and night| strong="H3915" \w*, \w for the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* \w thy servants| strong="H5650" \w*, [and confess]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8693”} \w the sins| strong="H2403" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [which we have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} [against thee: both I and my father’s]{strong=“H1”} \w house| strong="H1004" \w* [have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 7 [We have dealt very]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8800”} [corruptly]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8804”} [against thee, and have not kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w the commandments| strong="H4687" \w*, \w nor the statutes| strong="H2706" \w*, \w nor the judgments| strong="H4941" \w*, [which thou commandedst]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy servant| strong="H5650" \w* \w Moses| strong="H4872" \w*. 
\v 8 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”}, [I beseech thee, the word]{strong=“H1697”} [that thou commandedst]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy servant| strong="H5650" \w* \w Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, If [ye transgress]{strong=“H4603” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will scatter you abroad]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8686”} \w among the nations| strong="H5971" \w*: 
\v 9 But if [ye turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me, and keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w my commandments| strong="H4687" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [them; though there were of you cast out]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8737”} \w unto the uttermost part| strong="H7097" \w* \w of the heaven| strong="H8064" \w*, yet [will I gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8762”} [them from thence, and will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w them unto the place| strong="H4725" \w* [that I have chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} [to set]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8763”} \w my name| strong="H8034" \w* there. 
\v 10 Now these are \w thy servants| strong="H5650" \w* \w and thy people| strong="H5971" \w*, [whom thou hast redeemed]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8804”} \w by thy great| strong="H1419" \w* \w power| strong="H3581" \w*, \w and by thy strong| strong="H2389" \w* \w hand| strong="H3027" \w*. 
\v 11 \w O Lord| strong="H136" \w*, \w I beseech| strong="H577" \w* [thee, let now thine ear]{strong=“H241”} \w be attentive| strong="H7183" \w* \w to the prayer| strong="H8605" \w* \w of thy servant| strong="H5650" \w*, \w and to the prayer| strong="H8605" \w* \w of thy servants| strong="H5650" \w*, \w who desire| strong="H2655" \w* [to fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy name| strong="H8034" \w*: [and prosper]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8685”}, [I pray thee, thy servant]{strong=“H5650”} \w this day| strong="H3117" \w*, [and grant]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w him mercy| strong="H7356" \w* \w in the sight| strong="H6440" \w* \w of this man| strong="H376" \w*. [For I was the king’s]{strong=“H4428”} [cupbearer]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\c 2
\p 
\v 1 \w And it came to pass in the month| strong="H2320" \w* \w Nisan| strong="H5212" \w*, \w in the twentieth| strong="H6242" \w* \w year| strong="H8141" \w* \w of Artaxerxes| strong="H783" \w* \w the king| strong="H4428" \w*, that \w wine| strong="H3196" \w* was \w before| strong="H6440" \w* [him: and I took up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w the wine| strong="H3196" \w*, [and gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} it \w unto the king| strong="H4428" \w*. Now I had not been beforetime \w sad| strong="H7451" \w* \w in his presence| strong="H6440" \w*. 
\v 2 \w Wherefore the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto me, Why is \w thy countenance| strong="H6440" \w* \w sad| strong="H7451" \w*, seeing thou art [not sick]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8802”}? this is nothing else \w but sorrow| strong="H7455" \w* \w of heart| strong="H3820" \w*. \w Then I was very| strong="H3966" \w* [sore]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8687”} [afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 3 [And said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the king| strong="H4428" \w*, \w Let the king| strong="H4428" \w* [live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”} \w for ever| strong="H5769" \w*: \w why should not my countenance| strong="H6440" \w* [be sad]{strong=“H3415” x-morph=“strongMorph: \sc Th\sc*8799”}, \w when the city| strong="H5892" \w*, \w the place| strong="H1004" \w* [of my fathers’]{strong=“H1”} \w sepulchres| strong="H6913" \w*, lieth \w waste| strong="H2720" \w*, \w and the gates| strong="H8179" \w* [thereof are consumed]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8795”} \w with fire| strong="H784" \w*? 
\v 4 \w Then the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, For what dost thou make request]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”}? [So I prayed]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8691”} \w to the God| strong="H430" \w* \w of heaven| strong="H8064" \w*. 
\v 5 [And I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the king| strong="H4428" \w*, [If it please]{strong=“H2895” x-morph=“strongMorph: \sc Th\sc*8804”} \w the king| strong="H4428" \w*, \w and if thy servant| strong="H5650" \w* [have found favour]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy sight| strong="H6440" \w*, [that thou wouldest send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w me unto Judah| strong="H3063" \w*, \w unto the city| strong="H5892" \w* [of my fathers’]{strong=“H1”} \w sepulchres| strong="H6913" \w*, [that I may build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\v 6 \w And the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, (the queen]{strong=“H7694”} [also sitting]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w by him| strong="H681" \w*,) \w For how long shall thy journey| strong="H4109" \w* [be? and when wilt thou return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}? [So it pleased]{strong=“H6440 H3190” x-morph=“strongMorph: \sc Th\sc*8799”} \w the king| strong="H4428" \w* [to send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} [me; and I set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w him a time| strong="H2165" \w*.\f + \fr 2:6 \ft queen: Heb. wife \f* 
\v 7 [Moreover I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the king| strong="H4428" \w*, [If it please]{strong=“H2895” x-morph=“strongMorph: \sc Th\sc*8804”} \w the king| strong="H4428" \w*, \w let letters| strong="H107" \w* [be given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w me to the governors| strong="H6346" \w* \w beyond| strong="H5676" \w* \w the river| strong="H5104" \w*, [that they may convey me over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8686”} [till I come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into Judah| strong="H3063" \w*; 
\v 8 \w And a letter| strong="H107" \w* \w unto Asaph| strong="H623" \w* [the keeper]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} [of the king’s]{strong=“H4428”} \w forest| strong="H6508" \w*, [that he may give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w me timber| strong="H6086" \w* [to make beams]{strong=“H7136” x-morph=“strongMorph: \sc Th\sc*8763”} \w for the gates| strong="H8179" \w* \w of the palace| strong="H1002" \w* which appertained \w to the house| strong="H1004" \w*, \w and for the wall| strong="H2346" \w* \w of the city| strong="H5892" \w*, \w and for the house| strong="H1004" \w* [that I shall enter into]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}. \w And the king| strong="H4428" \w* [granted ]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [me, according to the good]{strong=“H2896”} \w hand| strong="H3027" \w* \w of my God| strong="H430" \w* upon me. 
\p
\v 9 [Then I came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the governors| strong="H6346" \w* \w beyond| strong="H5676" \w* \w the river| strong="H5104" \w*, [and gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [them the king’s]{strong=“H4428”} \w letters| strong="H107" \w*. \w Now the king| strong="H4428" \w* [had sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w captains| strong="H8269" \w* \w of the army| strong="H2428" \w* \w and horsemen| strong="H6571" \w* with me. 
\v 10 \w When Sanballat| strong="H5571" \w* \w the Horonite| strong="H2772" \w*, \w and Tobiah| strong="H2900" \w* \w the servant| strong="H5650" \w*, \w the Ammonite| strong="H5984" \w*, [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} of it, [it grieved]{strong=“H3415” x-morph=“strongMorph: \sc Th\sc*8799”} [them exceedingly]{strong=“H1419 H7451”} [that there was come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w a man| strong="H120" \w* [to seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8763”} \w the welfare| strong="H2896" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*. 
\v 11 [So I came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Jerusalem| strong="H3389" \w*, \w and was there three| strong="H7969" \w* \w days| strong="H3117" \w*. 
\p
\v 12 [And I arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the night| strong="H3915" \w*, \w I and some| strong="H4592" \w* \w few| strong="H4592" \w* \w men| strong="H582" \w* [with me; neither told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} I any \w man| strong="H120" \w* \w what my God| strong="H430" \w* [had put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w in my heart| strong="H3820" \w* [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w at Jerusalem| strong="H3389" \w*: neither was there any \w beast| strong="H929" \w* [with me, save the beast]{strong=“H929”} [that I rode upon]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 13 [And I went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w by night| strong="H3915" \w* \w by the gate| strong="H8179" \w* \w of the valley| strong="H1516" \w*, \w even before| strong="H6440" \w* \w the dragon| strong="H8577" \w* [well]{strong=“H5886 H5869” x-morph=“strongMorph: \sc Th\sc*8677”}, \w and to the dung| strong="H830" \w* \w port| strong="H8179" \w*, [and viewed]{strong=“H7665 H7663” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8802”} \w the walls| strong="H2346" \w* \w of Jerusalem| strong="H3389" \w*, [which were broken down]{strong=“H6555” x-morph=“strongMorph: \sc Th\sc*8803”}, \w and the gates| strong="H8179" \w* [thereof were consumed]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8795”} \w with fire| strong="H784" \w*. 
\v 14 [Then I went on]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the gate| strong="H8179" \w* \w of the fountain| strong="H5869" \w*, [and to the king’s]{strong=“H4428”} \w pool| strong="H1295" \w*: but there was \w no place| strong="H4725" \w* \w for the beast| strong="H929" \w* that was [under me to pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 15 [Then went I up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the night| strong="H3915" \w* \w by the brook| strong="H5158" \w*, [and viewed]{strong=“H7665 H7663” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8802”} \w the wall| strong="H2346" \w*, [and turned back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [and entered]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the gate| strong="H8179" \w* \w of the valley| strong="H1516" \w*, and so [returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 16 \w And the rulers| strong="H5461" \w* [knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [not whither I went]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”}, [or what I did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”}; \w neither had I as yet| strong="H3651" \w* [told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} it \w to the Jews| strong="H3064" \w*, \w nor to the priests| strong="H3548" \w*, \w nor to the nobles| strong="H2715" \w*, \w nor to the rulers| strong="H5461" \w*, \w nor to the rest| strong="H3499" \w* [that did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w the work| strong="H4399" \w*. 
\p
