\v 18 \w Also day| strong="H3117" \w* \w by day| strong="H3117" \w*, \w from the first| strong="H7223" \w* \w day| strong="H3117" \w* \w unto the last| strong="H314" \w* \w day| strong="H3117" \w*, [he read]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the book| strong="H5612" \w* \w of the law| strong="H8451" \w* \w of God| strong="H430" \w*. [And they kept]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w the feast| strong="H2282" \w* \w seven| strong="H7651" \w* \w days| strong="H3117" \w*; \w and on the eighth| strong="H8066" \w* \w day| strong="H3117" \w* was \w a solemn assembly| strong="H6116" \w*, \w according unto the manner| strong="H4941" \w*.\f + \fr 8:18 \ft a solemn…: Heb. a restraint \f*
\c 9
\p 
\v 1 \w Now in the twenty| strong="H6242" \w* \w and fourth| strong="H702" \w* \w day| strong="H3117" \w* \w of this month| strong="H2320" \w* \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [were assembled]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8738”} \w with fasting| strong="H6685" \w*, \w and with sackclothes| strong="H8242" \w*, \w and earth| strong="H127" \w* upon them. 
\v 2 \w And the seed| strong="H2233" \w* \w of Israel| strong="H3478" \w* [separated]{strong=“H914” x-morph=“strongMorph: \sc Th\sc*8735”} [themselves from all strangers]{strong=“H5236 H1121”}, [and stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} [and confessed]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8691”} \w their sins| strong="H2403" \w*, \w and the iniquities| strong="H5771" \w* \w of their fathers| strong="H1" \w*.\f + \fr 9:2 \ft strangers: Heb. strange children \f* 
