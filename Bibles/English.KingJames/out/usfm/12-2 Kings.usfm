\v 29 \w And king| strong="H4428" \w* \w Joram| strong="H3141" \w* [went back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [to be healed]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8692”} \w in Jezreel| strong="H3157" \w* \w of the wounds| strong="H4347" \w* \w which the Syrians| strong="H761" \w* [had given]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w him at Ramah| strong="H7414" \w*, [when he fought]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8736”} \w against Hazael| strong="H2371" \w* \w king| strong="H4428" \w* \w of Syria| strong="H758" \w*. \w And Ahaziah| strong="H274" \w* \w the son| strong="H1121" \w* \w of Jehoram| strong="H3088" \w* \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w* [went down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} [to see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w Joram| strong="H3141" \w* \w the son| strong="H1121" \w* \w of Ahab| strong="H256" \w* \w in Jezreel| strong="H3157" \w*, [because he was sick]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 8:29 \ft which…: Heb. wherewith the Syrians had wounded \f* \f + \fr 8:29 \ft Ramah: called Ramoth \f* \f + \fr 8:29 \ft sick: Heb. wounded \f*
\c 9
\p 
\v 1 \w And Elisha| strong="H477" \w* \w the prophet| strong="H5030" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w one| strong="H259" \w* \w of the children| strong="H1121" \w* \w of the prophets| strong="H5030" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Gird up]{strong=“H2296” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy loins| strong="H4975" \w*, [and take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w this box| strong="H6378" \w* \w of oil| strong="H8081" \w* \w in thine hand| strong="H3027" \w*, [and go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} [to Ramoth-gilead]{strong=“H1568 H7433”}: 
\v 2 [And when thou comest]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [thither, look out]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w there Jehu| strong="H3058" \w* \w the son| strong="H1121" \w* \w of Jehoshaphat| strong="H3092" \w* \w the son| strong="H1121" \w* \w of Nimshi| strong="H5250" \w*, [and go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, [and make him arise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} \w from among| strong="H8432" \w* \w his brethren| strong="H251" \w*, [and carry]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w him to an inner| strong="H2315" \w* \w chamber| strong="H2315" \w*;\f + \fr 9:2 \ft inner…: Heb. chamber in a chamber \f* 
\v 3 [Then take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w the box| strong="H6378" \w* \w of oil| strong="H8081" \w*, [and pour]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8804”} it \w on his head| strong="H7218" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [I have anointed]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee king| strong="H4428" \w* \w over Israel| strong="H3478" \w*. [Then open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8804”} \w the door| strong="H1817" \w*, [and flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8804”}, [and tarry]{strong=“H2442” x-morph=“strongMorph: \sc Th\sc*8762”} not. 
\p
\v 4 \w So the young man| strong="H5288" \w*, even \w the young man| strong="H5288" \w* \w the prophet| strong="H5030" \w*, [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [to Ramoth-gilead]{strong=“H1568 H7433”}. 
\v 5 [And when he came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [behold, the captains]{strong=“H8269”} \w of the host| strong="H2428" \w* were [sitting]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”}; [and he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w I have an errand| strong="H1697" \w* [to thee, O captain]{strong=“H8269”}. \w And Jehu| strong="H3058" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Unto which of all us? And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [To thee, O captain]{strong=“H8269”}. 
\v 6 [And he arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and went]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the house| strong="H1004" \w*; [and he poured]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8799”} \w the oil| strong="H8081" \w* \w on his head| strong="H7218" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w*, [I have anointed]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee king| strong="H4428" \w* \w over the people| strong="H5971" \w* of the \sc Lord\sc*, even \w over Israel| strong="H3478" \w*. 
