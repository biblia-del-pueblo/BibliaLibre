\c 10
\p 
\v 1 \w And Ahab| strong="H256" \w* \w had seventy| strong="H7657" \w* \w sons| strong="H1121" \w* \w in Samaria| strong="H8111" \w*. \w And Jehu| strong="H3058" \w* [wrote]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8799”} \w letters| strong="H5612" \w*, [and sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Samaria| strong="H8111" \w*, \w unto the rulers| strong="H8269" \w* \w of Jezreel| strong="H3157" \w*, \w to the elders| strong="H2205" \w*, [and to them that brought up]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8802”} [Ahab’s]{strong=“H256”} children, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”},\f + \fr 10:1 \ft them…: Heb. nourishers \f* 
