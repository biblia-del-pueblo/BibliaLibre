\c 5
\p 
\v 1 \w Now Naaman| strong="H5283" \w*, \w captain| strong="H8269" \w* \w of the host| strong="H6635" \w* \w of the king| strong="H4428" \w* \w of Syria| strong="H758" \w*, \w was a great| strong="H1419" \w* \w man| strong="H376" \w* \w with| strong="H6440" \w* \w his master| strong="H113" \w*, [and honourable]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8803”}, because by him the \sc Lord\sc* [had given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w deliverance| strong="H8668" \w* \w unto Syria| strong="H758" \w*: \w he was also a mighty| strong="H1368" \w* \w man| strong="H376" \w* \w in valour| strong="H2428" \w*, but he was [a leper]{strong=“H6879” x-morph=“strongMorph: \sc Th\sc*8794”}.\f + \fr 5:1 \ft with: Heb. before \f* \f + \fr 5:1 \ft honourable: or, gracious: Heb. lifted up, or, accepted in countenance \f* \f + \fr 5:1 \ft deliverance: or, victory \f* 
\v 2 \w And the Syrians| strong="H758" \w* [had gone out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w by companies| strong="H1416" \w*, [and had brought away captive]{strong=“H7617” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of the land| strong="H776" \w* \w of Israel| strong="H3478" \w* \w a little| strong="H6996" \w* \w maid| strong="H5291" \w*; \w and she waited on| strong="H6440" \w* [Naaman’s]{strong=“H5283”} \w wife| strong="H802" \w*.\f + \fr 5:2 \ft waited…: Heb. was before \f* 
\v 3 [And she said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto her mistress| strong="H1404" \w*, \w Would| strong="H305" \w* \w God my lord| strong="H113" \w* were \w with| strong="H6440" \w* \w the prophet| strong="H5030" \w* that is \w in Samaria| strong="H8111" \w*! \w for| strong="H227" \w* [he would recover]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8799”} \w him of his leprosy| strong="H6883" \w*.\f + \fr 5:3 \ft with: Heb. before \f* \f + \fr 5:3 \ft recover: Heb. gather in \f* 
\v 4 And one [went in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [and told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w his lord| strong="H113" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Thus and thus said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w the maid| strong="H5291" \w* that is \w of the land| strong="H776" \w* \w of Israel| strong="H3478" \w*. 
\v 5 \w And the king| strong="H4428" \w* \w of Syria| strong="H758" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Go to]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”}, [and I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w a letter| strong="H5612" \w* \w unto the king| strong="H4428" \w* \w of Israel| strong="H3478" \w*. [And he departed]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [and took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w with him| strong="H3027" \w* \w ten| strong="H6235" \w* \w talents| strong="H3603" \w* \w of silver| strong="H3701" \w*, \w and six| strong="H8337" \w* \w thousand| strong="H505" \w* pieces \w of gold| strong="H2091" \w*, \w and ten| strong="H6235" \w* \w changes| strong="H2487" \w* \w of raiment| strong="H899" \w*.\f + \fr 5:5 \ft with…: Heb. in his hand \f* 
\v 6 [And he brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w the letter| strong="H5612" \w* \w to the king| strong="H4428" \w* \w of Israel| strong="H3478" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Now when this letter| strong="H5612" \w* [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} unto thee, behold, I have therewith [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w Naaman| strong="H5283" \w* \w my servant| strong="H5650" \w* [to thee, that thou mayest recover]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8804”} \w him of his leprosy| strong="H6883" \w*. 
\v 7 [And it came to pass, when the king]{strong=“H4428”} \w of Israel| strong="H3478" \w* [had read]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8800”} \w the letter| strong="H5612" \w*, [that he rent]{strong=“H7167” x-morph=“strongMorph: \sc Th\sc*8799”} \w his clothes| strong="H899" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Am \w I God| strong="H430" \w*, [to kill]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8687”} [and to make alive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8687”}, \w that this man| strong="H2088" \w* [doth send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8802”} [unto me to recover]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8800”} \w a man| strong="H376" \w* \w of his leprosy| strong="H6883" \w*? \w wherefore| strong="H389" \w* [consider]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”}, [I pray you, and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} [how he seeketh a quarrel]{strong=“H579” x-morph=“strongMorph: \sc Th\sc*8693”} against me. 
\p
\v 8 And it was so, \w when Elisha| strong="H477" \w* \w the man| strong="H376" \w* \w of God| strong="H430" \w* [had heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w that the king| strong="H4428" \w* \w of Israel| strong="H3478" \w* [had rent]{strong=“H7167” x-morph=“strongMorph: \sc Th\sc*8804”} \w his clothes| strong="H899" \w*, [that he sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the king| strong="H4428" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Wherefore hast thou rent]{strong=“H7167” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy clothes| strong="H899" \w*? [let him come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [now to me, and he shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w that there is| strong="H3426" \w* \w a prophet| strong="H5030" \w* \w in Israel| strong="H3478" \w*. 
\p
\v 9 \w So Naaman| strong="H5283" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w with his horses| strong="H5483" \w* \w and with his chariot| strong="H7393" \w*, [and stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w at the door| strong="H6607" \w* \w of the house| strong="H1004" \w* \w of Elisha| strong="H477" \w*. 
\v 10 \w And Elisha| strong="H477" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w a messenger| strong="H4397" \w* [unto him, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”} [and wash]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} \w in Jordan| strong="H3383" \w* \w seven| strong="H7651" \w* \w times| strong="H6471" \w*, \w and thy flesh| strong="H1320" \w* [shall come again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [to thee, and thou shalt be clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8798”}. 
\v 11 \w But Naaman| strong="H5283" \w* [was wroth]{strong=“H7107” x-morph=“strongMorph: \sc Th\sc*8799”}, [and went away]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Behold, I thought]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [He will surely]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”} [come out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} [to me, and stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”}, [and call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w on the name| strong="H8034" \w* of the \sc Lord\sc* \w his God| strong="H430" \w*, [and strike]{strong=“H5130” x-morph=“strongMorph: \sc Th\sc*8689”} \w his hand| strong="H3027" \w* \w over the place| strong="H4725" \w*, [and recover]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8804”} [the leper]{strong=“H6879” x-morph=“strongMorph: \sc Th\sc*8794”}.\f + \fr 5:11 \ft I thought: Heb. I said \f* \f + \fr 5:11 \ft I thought…: or, I said with myself, He will surely come out, etc: Heb. I said \f* \f + \fr 5:11 \ft strike: Heb. move up and down \f* 
\v 12 Are [not Abana]{strong=“H549 H71” x-morph=“strongMorph: \sc Th\sc*8676”} \w and Pharpar| strong="H6554" \w*, \w rivers| strong="H5104" \w* \w of Damascus| strong="H1834" \w*, \w better| strong="H2896" \w* \w than all the waters| strong="H4325" \w* \w of Israel| strong="H3478" \w*? [may I not wash]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8799”} [in them, and be clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8804”}? [So he turned]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8799”} [and went away]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w in a rage| strong="H2534" \w*.\f + \fr 5:12 \ft Abana: or, Amana \f* 
\v 13 \w And his servants| strong="H5650" \w* [came near]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8799”}, [and spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [unto him, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w My father| strong="H1" \w*, if \w the prophet| strong="H5030" \w* [had bid]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} thee do some \w great| strong="H1419" \w* \w thing| strong="H1697" \w*, [wouldest thou not have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} it? \w how much rather then| strong="H637" \w*, [when he saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [to thee, Wash]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8798”}, [and be clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8798”}? 
\v 14 [Then went he down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”}, [and dipped]{strong=“H2881” x-morph=“strongMorph: \sc Th\sc*8799”} \w himself seven| strong="H7651" \w* \w times| strong="H6471" \w* \w in Jordan| strong="H3383" \w*, \w according to the saying| strong="H1697" \w* \w of the man| strong="H376" \w* \w of God| strong="H430" \w*: \w and his flesh| strong="H1320" \w* [came again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w like unto the flesh| strong="H1320" \w* \w of a little| strong="H6996" \w* \w child| strong="H5288" \w*, [and he was clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 15 [And he returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the man| strong="H376" \w* \w of God| strong="H430" \w*, \w he and all his company| strong="H4264" \w*, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [and stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* [him: and he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Behold, now I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that there is \w no God| strong="H430" \w* \w in all the earth| strong="H776" \w*, \w but in Israel| strong="H3478" \w*: [now therefore, I pray thee, take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w a blessing| strong="H1293" \w* \w of thy servant| strong="H5650" \w*. 
\v 16 [But he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, As the \sc Lord\sc* \w liveth| strong="H2416" \w*, \w before| strong="H6440" \w* [whom I stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”}, [I will receive]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [none. And he urged]{strong=“H6484” x-morph=“strongMorph: \sc Th\sc*8799”} [him to take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} it; [but he refused]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 17 \w And Naaman| strong="H5283" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Shall there not then, I pray thee, be given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8714”} \w to thy servant| strong="H5650" \w* \w two| strong="H6776" \w* [mules’]{strong=“H6505”} \w burden| strong="H4853" \w* \w of earth| strong="H127" \w*? \w for thy servant| strong="H5650" \w* [will henceforth offer]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w neither burnt offering| strong="H5930" \w* \w nor sacrifice| strong="H2077" \w* \w unto other| strong="H312" \w* \w gods| strong="H430" \w*, but unto the \sc Lord\sc*. 
\v 18 \w In this thing| strong="H1697" \w* the \sc Lord\sc* [pardon]{strong=“H5545” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy servant| strong="H5650" \w*, that \w when my master| strong="H113" \w* [goeth]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w into the house| strong="H1004" \w* \w of Rimmon| strong="H7417" \w* [to worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8692”} [there, and he leaneth]{strong=“H8172” x-morph=“strongMorph: \sc Th\sc*8737”} \w on my hand| strong="H3027" \w*, [and I bow]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8694”} \w myself in the house| strong="H1004" \w* \w of Rimmon| strong="H7417" \w*: [when I bow down]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8692”} \w myself in the house| strong="H1004" \w* \w of Rimmon| strong="H7417" \w*, the \sc Lord\sc* [pardon]{strong=“H5545” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy servant| strong="H5650" \w* \w in this thing| strong="H1697" \w*. 
\v 19 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} \w in peace| strong="H7965" \w*. [So he departed]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w from him a little| strong="H3530" \w* \w way| strong="H776" \w*.\f + \fr 5:19 \ft a little…: Heb. a little piece of ground \f* 
\p
\v 20 \w But Gehazi| strong="H1522" \w*, \w the servant| strong="H5288" \w* \w of Elisha| strong="H477" \w* \w the man| strong="H376" \w* \w of God| strong="H430" \w*, [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Behold, my master]{strong=“H113”} [hath spared]{strong=“H2820” x-morph=“strongMorph: \sc Th\sc*8804”} \w Naaman| strong="H5283" \w* \w this Syrian| strong="H761" \w*, [in not receiving]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} \w at his hands| strong="H3027" \w* [that which he brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”}: but, as the \sc Lord\sc* \w liveth| strong="H2416" \w*, [I will run]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8804”} \w after| strong="H310" \w* [him, and take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w somewhat| strong="H3972" \w* of him. 
\v 21 \w So Gehazi| strong="H1522" \w* [followed]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w Naaman| strong="H5283" \w*. \w And when Naaman| strong="H5283" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} him [running]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8801”} \w after| strong="H310" \w* [him, he lighted down]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the chariot| strong="H4818" \w* [to meet]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} [him, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Is \w all well| strong="H7965" \w*?\f + \fr 5:21 \ft Is…: Heb. Is there peace? \f* 
\v 22 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, All is \w well| strong="H7965" \w*. \w My master| strong="H113" \w* [hath sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Behold, even now there be come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w to me from mount| strong="H2022" \w* \w Ephraim| strong="H669" \w* \w two| strong="H8147" \w* \w young men| strong="H5288" \w* \w of the sons| strong="H1121" \w* \w of the prophets| strong="H5030" \w*: [give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} [them, I pray thee, a talent]{strong=“H3603”} \w of silver| strong="H3701" \w*, \w and two| strong="H8147" \w* \w changes| strong="H2487" \w* \w of garments| strong="H899" \w*. 
\v 23 \w And Naaman| strong="H5283" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Be content]{strong=“H2974” x-morph=“strongMorph: \sc Th\sc*8685”}, [take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w two talents| strong="H3603" \w*. [And he urged]{strong=“H6555” x-morph=“strongMorph: \sc Th\sc*8799”} [him, and bound]{strong=“H6696” x-morph=“strongMorph: \sc Th\sc*8799”} \w two| strong="H8147" \w* \w talents| strong="H3603" \w* \w of silver| strong="H3701" \w* \w in two| strong="H8147" \w* \w bags| strong="H2754" \w*, \w with two| strong="H8147" \w* \w changes| strong="H2487" \w* \w of garments| strong="H899" \w*, [and laid]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} them \w upon two| strong="H8147" \w* \w of his servants| strong="H5288" \w*; [and they bare]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} them \w before| strong="H6440" \w* him. 
\v 24 [And when he came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the tower| strong="H6076" \w*, [he took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} them \w from their hand| strong="H3027" \w*, [and bestowed]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} them \w in the house| strong="H1004" \w*: \w and he let the men| strong="H582" \w* [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”}, [and they departed]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 5:24 \ft tower: or, secret place \f* 
\v 25 [But he went in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}, [and stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w before his master| strong="H113" \w*. \w And Elisha| strong="H477" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Whence]{strong=“H370”} comest thou, \w Gehazi| strong="H1522" \w*? [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Thy servant| strong="H5650" \w* [went]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w no whither| strong="H575" \w*.\f + \fr 5:25 \ft no whither: Heb. not hither or thither \f* 
