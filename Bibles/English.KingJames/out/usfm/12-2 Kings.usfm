\c 8
\p 
\v 1 [Then spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w Elisha| strong="H477" \w* \w unto the woman| strong="H802" \w*, \w whose son| strong="H1121" \w* [he had restored to life]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8689”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [and go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou and thine household| strong="H1004" \w*, [and sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8798”} \w wheresoever| strong="H834" \w* [thou canst sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”}: for the \sc Lord\sc* [hath called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w for a famine| strong="H7458" \w*; [and it shall also come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon the land| strong="H776" \w* \w seven| strong="H7651" \w* \w years| strong="H8141" \w*. 
\v 2 \w And the woman| strong="H802" \w* [arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w after the saying| strong="H1697" \w* \w of the man| strong="H376" \w* \w of God| strong="H430" \w*: [and she went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w with her household| strong="H1004" \w*, [and sojourned]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the land| strong="H776" \w* \w of the Philistines| strong="H6430" \w* \w seven| strong="H7651" \w* \w years| strong="H8141" \w*. 
\v 3 \w And it came to pass at the seven| strong="H7651" \w* [years’]{strong=“H8141”} \w end| strong="H7097" \w*, \w that the woman| strong="H802" \w* [returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of the land| strong="H776" \w* \w of the Philistines| strong="H6430" \w*: [and she went forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} [to cry]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto the king| strong="H4428" \w* \w for her house| strong="H1004" \w* \w and for her land| strong="H7704" \w*. 
\v 4 \w And the king| strong="H4428" \w* [talked]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8764”} \w with Gehazi| strong="H1522" \w* \w the servant| strong="H5288" \w* \w of the man| strong="H376" \w* \w of God| strong="H430" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Tell]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8761”} [me, I pray thee, all the great things]{strong=“H1419”} \w that Elisha| strong="H477" \w* [hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 5 [And it came to pass, as he was telling]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8764”} \w the king| strong="H4428" \w* \w how he had restored| strong="H2421" \w* [a dead body]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”} [to life]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8689”}, [that, behold, the woman]{strong=“H802”}, \w whose son| strong="H1121" \w* [he had restored to life]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8689”}, [cried]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the king| strong="H4428" \w* \w for her house| strong="H1004" \w* \w and for her land| strong="H7704" \w*. \w And Gehazi| strong="H1522" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w My lord| strong="H113" \w*, \w O king| strong="H4428" \w*, this is \w the woman| strong="H802" \w*, and this is \w her son| strong="H1121" \w*, \w whom Elisha| strong="H477" \w* [restored to life]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8689”}. 
