\v 9 [Then they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w one| strong="H376" \w* \w to another| strong="H7453" \w*, [We do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} [not well: this day]{strong=“H3117”} is \w a day| strong="H3117" \w* \w of good tidings| strong="H1309" \w*, [and we hold our peace]{strong=“H2814” x-morph=“strongMorph: \sc Th\sc*8688”}: [if we tarry]{strong=“H2442” x-morph=“strongMorph: \sc Th\sc*8765”} \w till the morning| strong="H1242" \w* \w light| strong="H216" \w*, \w some mischief| strong="H5771" \w* [will come]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} [upon us: now therefore come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [that we may go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} [the king’s]{strong=“H4428”} \w household| strong="H1004" \w*.\f + \fr 7:9 \ft some…: Heb. we shall find punishment \f* 
\v 10 [So they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the porter| strong="H7778" \w* \w of the city| strong="H5892" \w*: [and they told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} [them, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [We came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the camp| strong="H4264" \w* \w of the Syrians| strong="H758" \w*, and, behold, there was \w no man| strong="H376" \w* [there, neither voice]{strong=“H6963”} \w of man| strong="H120" \w*, \w but horses| strong="H5483" \w* [tied]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8803”}, \w and asses| strong="H2543" \w* [tied]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8803”}, \w and the tents| strong="H168" \w* as they were. 
\v 11 [And he called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w the porters| strong="H7778" \w*; [and they told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} it [to the king’s]{strong=“H4428”} \w house| strong="H1004" \w* \w within| strong="H6441" \w*. 
\p
\v 12 \w And the king| strong="H4428" \w* [arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the night| strong="H3915" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his servants| strong="H5650" \w*, [I will now shew]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w you what the Syrians| strong="H758" \w* [have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [to us. They know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that we be \w hungry| strong="H7457" \w*; [therefore are they gone out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the camp| strong="H4264" \w* [to hide]{strong=“H2247” x-morph=“strongMorph: \sc Th\sc*8736”} \w themselves in the field| strong="H7704" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [When they come out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the city| strong="H5892" \w*, [we shall catch]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8799”} \w them alive| strong="H2416" \w*, [and get]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the city| strong="H5892" \w*. 
\v 13 \w And one| strong="H259" \w* \w of his servants| strong="H5650" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Let some [take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”}, [I pray thee, five]{strong=“H2568”} \w of the horses| strong="H5483" \w* [that remain]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”}, [which are left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8738”} in the city, (behold, they are \w as all the multitude| strong="H1995" \w* \w of Israel| strong="H3478" \w* [that are left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8738”} in it: behold, I say, they are \w even as all the multitude| strong="H1995" \w* \w of the Israelites| strong="H3478" \w* [that are consumed]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8804”}:) [and let us send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 7:13 \ft in the city: Heb. in it \f* 
\v 14 [They took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w therefore two| strong="H8147" \w* \w chariot| strong="H7393" \w* \w horses| strong="H5483" \w*; \w and the king| strong="H4428" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w the host| strong="H4264" \w* \w of the Syrians| strong="H758" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}. 
\v 15 [And they went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w them unto Jordan| strong="H3383" \w*: [and, lo, all the way]{strong=“H1870”} was \w full| strong="H4392" \w* \w of garments| strong="H899" \w* \w and vessels| strong="H3627" \w*, \w which the Syrians| strong="H758" \w* [had cast away]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8689”} [in their haste]{strong=“H2648” x-morph=“strongMorph: \sc Th\sc*8800”}. \w And the messengers| strong="H4397" \w* [returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [and told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w the king| strong="H4428" \w*. 
