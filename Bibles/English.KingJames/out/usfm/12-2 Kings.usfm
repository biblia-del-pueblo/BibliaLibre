\v 26 \w Two| strong="H8147" \w* \w and twenty| strong="H6242" \w* \w years| strong="H8141" \w* \w old| strong="H1121" \w* was \w Ahaziah| strong="H274" \w* [when he began to reign]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8800”}; [and he reigned]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8804”} \w one| strong="H259" \w* \w year| strong="H8141" \w* \w in Jerusalem| strong="H3389" \w*. [And his mother’s]{strong=“H517”} \w name| strong="H8034" \w* was \w Athaliah| strong="H6271" \w*, \w the daughter| strong="H1323" \w* \w of Omri| strong="H6018" \w* \w king| strong="H4428" \w* \w of Israel| strong="H3478" \w*.\f + \fr 8:26 \ft daughter: or, granddaughter \f* 
\v 27 [And he walked]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the way| strong="H1870" \w* \w of the house| strong="H1004" \w* \w of Ahab| strong="H256" \w*, [and did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w evil| strong="H7451" \w* \w in the sight| strong="H5869" \w* of the \sc Lord\sc*, as did \w the house| strong="H1004" \w* \w of Ahab| strong="H256" \w*: for he was \w the son in law| strong="H2860" \w* \w of the house| strong="H1004" \w* \w of Ahab| strong="H256" \w*. 
\p
