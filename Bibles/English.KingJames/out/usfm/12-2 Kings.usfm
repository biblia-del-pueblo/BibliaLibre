\c 19
\p 
\v 1 [And it came to pass, when king]{strong=“H4428”} \w Hezekiah| strong="H2396" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} it, [that he rent]{strong=“H7167” x-morph=“strongMorph: \sc Th\sc*8799”} \w his clothes| strong="H899" \w*, [and covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8691”} \w himself with sackcloth| strong="H8242" \w*, [and went]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the house| strong="H1004" \w* of the \sc Lord\sc*. 
\v 2 [And he sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w Eliakim| strong="H471" \w*, which was \w over the household| strong="H1004" \w*, \w and Shebna| strong="H7644" \w* [the scribe]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and the elders| strong="H2205" \w* \w of the priests| strong="H3548" \w*, [covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8693”} \w with sackcloth| strong="H8242" \w*, \w to Isaiah| strong="H3470" \w* \w the prophet| strong="H5030" \w* \w the son| strong="H1121" \w* \w of Amoz| strong="H531" \w*. 
\v 3 [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w Hezekiah| strong="H2396" \w*, \w This day| strong="H3117" \w* is \w a day| strong="H3117" \w* \w of trouble| strong="H6869" \w*, \w and of rebuke| strong="H8433" \w*, \w and blasphemy| strong="H5007" \w*: \w for the children| strong="H1121" \w* [are come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the birth| strong="H4866" \w*, and there is \w not strength| strong="H3581" \w* [to bring forth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 19:3 \ft blasphemy: or, provocation \f* 
\v 4 \w It may be| strong="H194" \w* the \sc Lord\sc* \w thy God| strong="H430" \w* [will hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the words| strong="H1697" \w* [of Rab-shakeh]{strong=“H7262”}, \w whom the king| strong="H4428" \w* \w of Assyria| strong="H804" \w* \w his master| strong="H113" \w* [hath sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [to reproach]{strong=“H2778” x-morph=“strongMorph: \sc Th\sc*8763”} \w the living| strong="H2416" \w* \w God| strong="H430" \w*; [and will reprove]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8689”} \w the words| strong="H1697" \w* which the \sc Lord\sc* \w thy God| strong="H430" \w* [hath heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}: [wherefore lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} thy \w prayer| strong="H8605" \w* \w for the remnant| strong="H7611" \w* [that are left]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8737”}.\f + \fr 19:4 \ft left: Heb. found \f* 
\v 5 \w So the servants| strong="H5650" \w* \w of king| strong="H4428" \w* \w Hezekiah| strong="H2396" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Isaiah| strong="H3470" \w*. 
\p
\v 6 \w And Isaiah| strong="H3470" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Thus shall ye say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to your master| strong="H113" \w*, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [Be not afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w of| strong="H6440" \w* \w the words| strong="H1697" \w* [which thou hast heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}, \w with which the servants| strong="H5288" \w* \w of the king| strong="H4428" \w* \w of Assyria| strong="H804" \w* [have blasphemed]{strong=“H1442” x-morph=“strongMorph: \sc Th\sc*8765”} me. 
\v 7 [Behold, I will send]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w a blast| strong="H7307" \w* [upon him, and he shall hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w a rumour| strong="H8052" \w*, [and shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w to his own land| strong="H776" \w*; [and I will cause him to fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8689”} \w by the sword| strong="H2719" \w* \w in his own land| strong="H776" \w*. 
\p
