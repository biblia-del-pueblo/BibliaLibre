\c 4
\p 
\v 1 [Now there cried]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8804”} \w a certain| strong="H259" \w* \w woman| strong="H802" \w* \w of the wives| strong="H802" \w* \w of the sons| strong="H1121" \w* \w of the prophets| strong="H5030" \w* \w unto Elisha| strong="H477" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Thy servant| strong="H5650" \w* \w my husband| strong="H376" \w* [is dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}; [and thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w that thy servant| strong="H5650" \w* \w did fear| strong="H3373" \w* the \sc Lord\sc*: [and the creditor]{strong=“H5383” x-morph=“strongMorph: \sc Th\sc*8802”} [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto him my two| strong="H8147" \w* \w sons| strong="H3206" \w* \w to be bondmen| strong="H5650" \w*. 
\v 2 \w And Elisha| strong="H477" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto her, What shall I do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [for thee? tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”} [me, what hast]{strong=“H3426”} \w thou in the house| strong="H1004" \w*? [And she said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Thine handmaid| strong="H8198" \w* \w hath not any thing in the house| strong="H1004" \w*, \w save a pot| strong="H610" \w* \w of oil| strong="H8081" \w*. 
\v 3 [Then he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [borrow]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee vessels| strong="H3627" \w* \w abroad| strong="H2351" \w* \w of all thy neighbours| strong="H7934" \w*, even \w empty| strong="H7386" \w* \w vessels| strong="H3627" \w*; [borrow not a few]{strong=“H4591” x-morph=“strongMorph: \sc Th\sc*8686”}.\f + \fr 4:3 \ft borrow not…: or, scant not \f* 
\v 4 [And when thou art come in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, [thou shalt shut]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8804”} \w the door| strong="H1817" \w* \w upon thee and upon thy sons| strong="H1121" \w*, [and shalt pour out]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8804”} \w into all those vessels| strong="H3627" \w*, [and thou shalt set aside]{strong=“H5265” x-morph=“strongMorph: \sc Th\sc*8686”} \w that which is full| strong="H4392" \w*. 
\v 5 [So she went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [from him, and shut]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8799”} \w the door| strong="H1817" \w* \w upon her and upon| strong="H1157" \w* \w her sons| strong="H1121" \w*, \w who| strong="H1992" \w* [brought]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8688”} the vessels [to her; and she poured out]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8716”}. 
\v 6 [And it came to pass, when the vessels]{strong=“H3627”} [were full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8800”}, [that she said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto her son| strong="H1121" \w*, [Bring]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8685”} \w me yet a vessel| strong="H3627" \w*. [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto her, There is \w not a vessel| strong="H3627" \w* [more. And the oil]{strong=“H8081”} [stayed]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 7 [Then she came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w the man| strong="H376" \w* \w of God| strong="H430" \w*. [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [sell]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8798”} \w the oil| strong="H8081" \w*, [and pay]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8761”} \w thy debt| strong="H5386" \w*, [and live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”} \w thou and thy children| strong="H1121" \w* [of the rest]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8737”}.\f + \fr 4:7 \ft debt: or, creditor \f* 
\p
\v 8 \w And it fell on a day| strong="H3117" \w*, \w that Elisha| strong="H477" \w* [passed]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Shunem| strong="H7766" \w*, where was \w a great| strong="H1419" \w* \w woman| strong="H802" \w*; [and she constrained]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8686”} [him to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} \w bread| strong="H3899" \w*. And so it was, that \w as oft| strong="H1767" \w* [as he passed by]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8800”}, [he turned]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8799”} [in thither to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} \w bread| strong="H3899" \w*.\f + \fr 4:8 \ft it fell on a day: Heb. there was a day \f* \f + \fr 4:8 \ft constrained him: Heb. laid hold on him \f* 
\v 9 [And she said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto her husband| strong="H376" \w*, [Behold now, I perceive]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that this is \w an holy| strong="H6918" \w* \w man| strong="H376" \w* \w of God| strong="H430" \w*, [which passeth]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} \w by us continually| strong="H8548" \w*. 
\v 10 [Let us make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w a little| strong="H6996" \w* \w chamber| strong="H5944" \w*, [I pray thee, on the wall]{strong=“H7023”}; [and let us set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w for him there a bed| strong="H4296" \w*, \w and a table| strong="H7979" \w*, \w and a stool| strong="H3678" \w*, \w and a candlestick| strong="H4501" \w*: [and it shall be, when he cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [to us, that he shall turn]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8799”} in thither. 
\v 11 \w And it fell on a day| strong="H3117" \w*, [that he came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [thither, and he turned]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the chamber| strong="H5944" \w*, [and lay]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} there. 
\v 12 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Gehazi| strong="H1522" \w* \w his servant| strong="H5288" \w*, [Call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} \w this Shunammite| strong="H7767" \w*. [And when he had called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} [her, she stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* him. 
\v 13 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} [now unto her, Behold, thou hast been careful]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8804”} \w for us with all this care| strong="H2731" \w*; what is [to be done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [for thee? wouldest]{strong=“H3426”} [thou be spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w for to the king| strong="H4428" \w*, \w or to the captain| strong="H8269" \w* \w of the host| strong="H6635" \w*? [And she answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w among| strong="H8432" \w* \w mine own people| strong="H5971" \w*. 
