\v 29 [So we boiled]{strong=“H1310” x-morph=“strongMorph: \sc Th\sc*8762”} \w my son| strong="H1121" \w*, [and did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [him: and I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto her on the next| strong="H312" \w* \w day| strong="H3117" \w*, [Give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy son| strong="H1121" \w*, [that we may eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [him: and she hath hid]{strong=“H2244” x-morph=“strongMorph: \sc Th\sc*8686”} \w her son| strong="H1121" \w*.\f + \fr 6:29 \ft next: Heb. other \f* 
\p
\v 30 [And it came to pass, when the king]{strong=“H4428”} [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w the words| strong="H1697" \w* \w of the woman| strong="H802" \w*, [that he rent]{strong=“H7167” x-morph=“strongMorph: \sc Th\sc*8799”} \w his clothes| strong="H899" \w*; [and he passed by]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the wall| strong="H2346" \w*, \w and the people| strong="H5971" \w* [looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, and, behold, he had \w sackcloth| strong="H8242" \w* \w within| strong="H1004" \w* \w upon his flesh| strong="H1320" \w*. 
\v 31 [Then he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w God| strong="H430" \w* [do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [so and more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [also to me, if the head]{strong=“H7218”} \w of Elisha| strong="H477" \w* \w the son| strong="H1121" \w* \w of Shaphat| strong="H8202" \w* [shall stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w on him this day| strong="H3117" \w*. 
\v 32 \w But Elisha| strong="H477" \w* [sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in his house| strong="H1004" \w*, \w and the elders| strong="H2205" \w* [sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} with him; and the king [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w a man| strong="H376" \w* \w from before| strong="H6440" \w* [him: but ere the messenger]{strong=“H4397”} [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [to him, he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the elders| strong="H2205" \w*, [See]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w ye how this son| strong="H1121" \w* [of a murderer]{strong=“H7523” x-morph=“strongMorph: \sc Th\sc*8764”} [hath sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [to take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8687”} \w mine head| strong="H7218" \w*? [look]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}, \w when the messenger| strong="H4397" \w* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}, [shut]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8798”} \w the door| strong="H1817" \w*, [and hold him fast]{strong=“H3905” x-morph=“strongMorph: \sc Th\sc*8804”} \w at the door| strong="H1817" \w*: is \w not the sound| strong="H6963" \w* [of his master’s]{strong=“H113”} \w feet| strong="H7272" \w* \w behind| strong="H310" \w* him? 
\v 33 [And while he yet talked]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8764”} [with them, behold, the messenger]{strong=“H4397”} [came down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} [unto him: and he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Behold, this evil]{strong=“H7451”} is of the \sc Lord\sc*; [what should I wait]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8686”} for the \sc Lord\sc* any longer? 
\c 7
\p 
\v 1 \w Then Elisha| strong="H477" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye the word| strong="H1697" \w* of the \sc Lord\sc*; [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w To morrow| strong="H4279" \w* \w about this time| strong="H6256" \w* shall \w a measure| strong="H5429" \w* \w of fine flour| strong="H5560" \w* be sold \w for a shekel| strong="H8255" \w*, \w and two measures| strong="H5429" \w* \w of barley| strong="H8184" \w* \w for a shekel| strong="H8255" \w*, \w in the gate| strong="H8179" \w* \w of Samaria| strong="H8111" \w*. 
\v 2 \w Then a lord| strong="H7991" \w* \w on whose hand| strong="H3027" \w* \w the king| strong="H4428" \w* [leaned]{strong=“H8172” x-morph=“strongMorph: \sc Th\sc*8737”} [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w the man| strong="H376" \w* \w of God| strong="H430" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Behold, if the \sc Lord\sc* [would make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w windows| strong="H699" \w* \w in heaven| strong="H8064" \w*, \w might this thing| strong="H1697" \w* [be? And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Behold, thou shalt see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} it \w with thine eyes| strong="H5869" \w*, [but shalt not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} thereof.\f + \fr 7:2 \ft a lord…: Heb. a lord which belonged to the king leaning upon his hand \f* 
\p
\v 3 \w And there were four| strong="H702" \w* [leprous]{strong=“H6879” x-morph=“strongMorph: \sc Th\sc*8794”} \w men| strong="H582" \w* \w at the entering in| strong="H6607" \w* \w of the gate| strong="H8179" \w*: [and they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w one| strong="H376" \w* \w to another| strong="H7453" \w*, [Why sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} [we here until we die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}? 
\v 4 [If we say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [We will enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the city| strong="H5892" \w*, \w then the famine| strong="H7458" \w* is \w in the city| strong="H5892" \w*, [and we shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”} [there: and if we sit still]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} [here, we die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”} [also. Now therefore come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [and let us fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the host| strong="H4264" \w* \w of the Syrians| strong="H758" \w*: [if they save us alive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8762”}, [we shall live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}; [and if they kill]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8686”} [us, we shall but die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 5 [And they rose up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the twilight| strong="H5399" \w*, [to go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto the camp| strong="H4264" \w* \w of the Syrians| strong="H758" \w*: [and when they were come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the uttermost part| strong="H7097" \w* \w of the camp| strong="H4264" \w* \w of Syria| strong="H758" \w*, behold, there was \w no man| strong="H376" \w* there. 
\v 6 \w For the Lord| strong="H136" \w* \w had made the host| strong="H4264" \w* \w of the Syrians| strong="H758" \w* [to hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8689”} \w a noise| strong="H6963" \w* \w of chariots| strong="H7393" \w*, \w and a noise| strong="H6963" \w* \w of horses| strong="H5483" \w*, even \w the noise| strong="H6963" \w* \w of a great| strong="H1419" \w* \w host| strong="H2428" \w*: [and they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w one| strong="H376" \w* \w to another| strong="H251" \w*, [Lo, the king]{strong=“H4428”} \w of Israel| strong="H3478" \w* [hath hired]{strong=“H7936” x-morph=“strongMorph: \sc Th\sc*8804”} \w against us the kings| strong="H4428" \w* \w of the Hittites| strong="H2850" \w*, \w and the kings| strong="H4428" \w* \w of the Egyptians| strong="H4714" \w*, [to come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} upon us. 
\v 7 [Wherefore they arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} [and fled]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the twilight| strong="H5399" \w*, [and left]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w their tents| strong="H168" \w*, \w and their horses| strong="H5483" \w*, \w and their asses| strong="H2543" \w*, \w even the camp| strong="H4264" \w* as it was, [and fled]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”} \w for their life| strong="H5315" \w*. 
