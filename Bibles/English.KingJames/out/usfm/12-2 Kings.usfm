\p
\v 11 \w Then Jehu| strong="H3058" \w* [came forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the servants| strong="H5650" \w* \w of his lord| strong="H113" \w*: and one [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, Is \w all well| strong="H7965" \w*? [wherefore came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [this mad]{strong=“H7696” x-morph=“strongMorph: \sc Th\sc*8794”} fellow [to thee? And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Ye know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w the man| strong="H376" \w*, \w and his communication| strong="H7879" \w*. 
\v 12 [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, It is \w false| strong="H8267" \w*; [tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”} [us now. And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Thus and thus spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [he to me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [I have anointed]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee king| strong="H4428" \w* \w over Israel| strong="H3478" \w*. 
\v 13 [Then they hasted]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8762”}, [and took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w every man| strong="H376" \w* \w his garment| strong="H899" \w*, [and put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} it \w under him on the top| strong="H1634" \w* \w of the stairs| strong="H4609" \w*, [and blew]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8799”} \w with trumpets| strong="H7782" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Jehu| strong="H3058" \w* [is king]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 9:13 \ft is king: Heb. reigneth \f* 
\v 14 \w So Jehu| strong="H3058" \w* \w the son| strong="H1121" \w* \w of Jehoshaphat| strong="H3092" \w* \w the son| strong="H1121" \w* \w of Nimshi| strong="H5250" \w* [conspired]{strong=“H7194” x-morph=“strongMorph: \sc Th\sc*8691”} \w against Joram| strong="H3141" \w*. (\w Now Joram| strong="H3141" \w* [had kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} [Ramoth-gilead]{strong=“H1568 H7433”}, \w he and all Israel| strong="H3478" \w*, \w because| strong="H6440" \w* \w of Hazael| strong="H2371" \w* \w king| strong="H4428" \w* \w of Syria| strong="H758" \w*. 
\v 15 \w But king| strong="H4428" \w* \w Joram| strong="H3088" \w* [was returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [to be healed]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8692”} \w in Jezreel| strong="H3157" \w* \w of the wounds| strong="H4347" \w* \w which the Syrians| strong="H761" \w* [had given]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} [him, when he fought]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8736”} \w with Hazael| strong="H2371" \w* \w king| strong="H4428" \w* \w of Syria| strong="H758" \w*.) \w And Jehu| strong="H3058" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w If it be| strong="H3426" \w* \w your minds| strong="H5315" \w*, then \w let none| strong="H408" \w* [go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} nor \w escape| strong="H6412" \w* \w out of the city| strong="H5892" \w* [to go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} [to tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8687”} it \w in Jezreel| strong="H3157" \w*.\f + \fr 9:15 \ft Joram: Heb. Jehoram but not in verse sixteen \f* \f + \fr 9:15 \ft had given: Heb. smote \f* \f + \fr 9:15 \ft let none…: Heb. let no escaper go, etc \f* 
\p
\v 16 \w So Jehu| strong="H3058" \w* [rode in a chariot]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8799”}, [and went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Jezreel| strong="H3157" \w*; \w for Joram| strong="H3141" \w* [lay]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8802”} [there. And Ahaziah]{strong=“H274”} \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w* [was come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} [to see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w Joram| strong="H3141" \w*. 
\v 17 [And there stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} [a watchman]{strong=“H6822” x-morph=“strongMorph: \sc Th\sc*8802”} \w on the tower| strong="H4026" \w* \w in Jezreel| strong="H3157" \w*, [and he spied]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the company| strong="H8229" \w* \w of Jehu| strong="H3058" \w* [as he came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} \w a company| strong="H8229" \w*. \w And Joram| strong="H3088" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w an horseman| strong="H7395" \w*, [and send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8798”} [to meet]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} [them, and let him say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Is it \w peace| strong="H7965" \w*? 
\v 18 [So there went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [one on horseback]{strong=“H5483 H7392” x-morph=“strongMorph: \sc Th\sc*8802”} [to meet]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} [him, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the king| strong="H4428" \w*, Is it \w peace| strong="H7965" \w*? \w And Jehu| strong="H3058" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w What hast thou to do with peace| strong="H7965" \w*? [turn]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee behind| strong="H310" \w* [me. And the watchman]{strong=“H6822” x-morph=“strongMorph: \sc Th\sc*8802”} [told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w The messenger| strong="H4397" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to them, but he cometh not again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 19 [Then he sent out]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w a second| strong="H8145" \w* [on horseback]{strong=“H5483 H7392” x-morph=“strongMorph: \sc Th\sc*8802”}, [which came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [to them, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the king| strong="H4428" \w*, Is it \w peace| strong="H7965" \w*? \w And Jehu| strong="H3058" \w* [answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w What hast thou to do with peace| strong="H7965" \w*? [turn]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee behind| strong="H310" \w* me. 
