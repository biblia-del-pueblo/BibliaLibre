\c 1
\p 
\v 1 \w Then Moab| strong="H4124" \w* [rebelled]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8799”} \w against Israel| strong="H3478" \w* \w after| strong="H310" \w* \w the death| strong="H4194" \w* \w of Ahab| strong="H256" \w*. 
\v 2 \w And Ahaziah| strong="H274" \w* [fell down]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w through a lattice| strong="H7639" \w* \w in his upper chamber| strong="H5944" \w* that was \w in Samaria| strong="H8111" \w*, [and was sick]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8799”}: [and he sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w messengers| strong="H4397" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [enquire]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8798”} [of Baal-zebub]{strong=“H1176”} \w the god| strong="H430" \w* \w of Ekron| strong="H6138" \w* [whether I shall recover]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”} \w of this disease| strong="H2483" \w*. 
\v 3 \w But the angel| strong="H4397" \w* of the \sc Lord\sc* [said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w to Elijah| strong="H452" \w* \w the Tishbite| strong="H8664" \w*, [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”} [to meet]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} \w the messengers| strong="H4397" \w* \w of the king| strong="H4428" \w* \w of Samaria| strong="H8111" \w*, [and say]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} unto them, Is it not because there is \w not a God| strong="H430" \w* \w in Israel| strong="H3478" \w*, that [ye go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} [to enquire]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8800”} [of Baal-zebub]{strong=“H1176”} \w the god| strong="H430" \w* \w of Ekron| strong="H6138" \w*? 
\v 4 [Now therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [Thou shalt not come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w from that bed| strong="H4296" \w* [on which thou art gone up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”}, [but shalt surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. \w And Elijah| strong="H452" \w* [departed]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 1:4 \ft Thou shalt…: Heb. The bed whither thou art gone up, thou shalt not come down from it \f* 
\p
\v 5 \w And when the messengers| strong="H4397" \w* [turned back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Why are ye now]{strong=“H2088”} [turned back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”}? 
\v 6 [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, There came]{strong=“H5927”} \w a man| strong="H376" \w* [up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} [to meet]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} [us, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto us, Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [turn again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto the king| strong="H4428" \w* [that sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [you, and say]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [unto him, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, Is it not because there is \w not a God| strong="H430" \w* \w in Israel| strong="H3478" \w*, that [thou sendest]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8802”} [to enquire]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8800”} [of Baal-zebub]{strong=“H1176”} \w the god| strong="H430" \w* \w of Ekron| strong="H6138" \w*? [therefore thou shalt not come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w from that bed| strong="H4296" \w* [on which thou art gone up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”}, [but shalt surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 7 [And he said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [unto them, What manner]{strong=“H4941”} \w of man| strong="H376" \w* was he [which came up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} [to meet]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} [you, and told]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w you these words| strong="H1697" \w*?\f + \fr 1:7 \ft What…: Heb. What was the manner of the man \f* 
\v 8 [And they answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} him, He was \w an hairy| strong="H8181" \w* [man]{strong=“H376 H1167”}, [and girt]{strong=“H247” x-morph=“strongMorph: \sc Th\sc*8803”} \w with a girdle| strong="H232" \w* \w of leather| strong="H5785" \w* \w about his loins| strong="H4975" \w*. [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, It is \w Elijah| strong="H452" \w* \w the Tishbite| strong="H8664" \w*. 
\p
\v 9 \w Then the king| strong="H4428" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto him a captain| strong="H8269" \w* \w of fifty| strong="H2572" \w* \w with his fifty| strong="H2572" \w*. [And he went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} [to him: and, behold, he sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w on the top| strong="H7218" \w* \w of an hill| strong="H2022" \w*. [And he spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [unto him, Thou man]{strong=“H376”} \w of God| strong="H430" \w*, \w the king| strong="H4428" \w* [hath said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}, [Come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8798”}. 
\v 10 \w And Elijah| strong="H452" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w to the captain| strong="H8269" \w* \w of fifty| strong="H2572" \w*, If I be \w a man| strong="H376" \w* \w of God| strong="H430" \w*, \w then let fire| strong="H784" \w* [come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w from heaven| strong="H8064" \w*, [and consume]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee and thy fifty| strong="H2572" \w*. [And there came down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w fire| strong="H784" \w* \w from heaven| strong="H8064" \w*, [and consumed]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w him and his fifty| strong="H2572" \w*. 
\v 11 [Again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [also he sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto him another| strong="H312" \w* \w captain| strong="H8269" \w* \w of fifty| strong="H2572" \w* \w with his fifty| strong="H2572" \w*. [And he answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [unto him, O man]{strong=“H376”} \w of God| strong="H430" \w*, \w thus hath the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8798”} \w quickly| strong="H4120" \w*. 
\v 12 \w And Elijah| strong="H452" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} unto them, If I be \w a man| strong="H376" \w* \w of God| strong="H430" \w*, \w let fire| strong="H784" \w* [come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w from heaven| strong="H8064" \w*, [and consume]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee and thy fifty| strong="H2572" \w*. \w And the fire| strong="H784" \w* \w of God| strong="H430" \w* [came down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w from heaven| strong="H8064" \w*, [and consumed]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w him and his fifty| strong="H2572" \w*. 
\p
\v 13 [And he sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} [again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w a captain| strong="H8269" \w* \w of the third| strong="H7992" \w* \w fifty| strong="H2572" \w* \w with his fifty| strong="H2572" \w*. \w And the third| strong="H7992" \w* \w captain| strong="H8269" \w* \w of fifty| strong="H2572" \w* [went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”}, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and fell]{strong=“H3766” x-morph=“strongMorph: \sc Th\sc*8799”} \w on his knees| strong="H1290" \w* \w before| strong="H5048" \w* \w Elijah| strong="H452" \w*, [and besought]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8691”} [him, and said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [unto him, O man]{strong=“H376”} \w of God| strong="H430" \w*, [I pray thee, let my life]{strong=“H5315”}, \w and the life| strong="H5315" \w* \w of these fifty| strong="H2572" \w* \w thy servants| strong="H5650" \w*, [be precious]{strong=“H3365” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy sight| strong="H5869" \w*.\f + \fr 1:13 \ft fell: Heb. bowed \f* 
\v 14 [Behold, there came]{strong=“H3381”} \w fire| strong="H784" \w* [down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} \w from heaven| strong="H8064" \w*, [and burnt up]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the two| strong="H8147" \w* \w captains| strong="H8269" \w* \w of the former| strong="H7223" \w* \w fifties| strong="H2572" \w* \w with their fifties| strong="H2572" \w*: \w therefore let my life| strong="H5315" \w* [now be precious]{strong=“H3365” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy sight| strong="H5869" \w*. 
\v 15 \w And the angel| strong="H4397" \w* of the \sc Lord\sc* [said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Elijah| strong="H452" \w*, [Go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8798”} [with him: be not afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w of him| strong="H6440" \w*. [And he arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and went down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w with him unto the king| strong="H4428" \w*. 
\v 16 [And he said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [unto him, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [Forasmuch as thou hast sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w messengers| strong="H4397" \w* [to enquire]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8800”} [of Baal-zebub]{strong=“H1176”} \w the god| strong="H430" \w* \w of Ekron| strong="H6138" \w*, is it not because there is \w no God| strong="H430" \w* \w in Israel| strong="H3478" \w* [to enquire]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8800”} \w of his word| strong="H1697" \w*? [therefore thou shalt not come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w off that bed| strong="H4296" \w* [on which thou art gone up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”}, [but shalt surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 17 [So he died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w according to the word| strong="H1697" \w* of the \sc Lord\sc* \w which Elijah| strong="H452" \w* [had spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}. \w And Jehoram| strong="H3088" \w* [reigned ]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his stead in the second| strong="H8147" \w* \w year| strong="H8141" \w* \w of Jehoram| strong="H3088" \w* \w the son| strong="H1121" \w* \w of Jehoshaphat| strong="H3092" \w* \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w*; \w because he had no son| strong="H1121" \w*. 
\v 18 \w Now the rest| strong="H3499" \w* \w of the acts| strong="H1697" \w* \w of Ahaziah| strong="H274" \w* [which he did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, are [they not written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8803”} \w in the book| strong="H5612" \w* [of the chronicles]{strong=“H3117 H1697”} \w of the kings| strong="H4428" \w* \w of Israel| strong="H3478" \w*? 
\c 2
\p 
\v 1 And it came to pass, when the \sc Lord\sc* [would take up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8687”} \w Elijah| strong="H452" \w* \w into heaven| strong="H8064" \w* \w by a whirlwind| strong="H5591" \w*, \w that Elijah| strong="H452" \w* [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w with Elisha| strong="H477" \w* \w from Gilgal| strong="H1537" \w*. 
\v 2 \w And Elijah| strong="H452" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Elisha| strong="H477" \w*, [Tarry]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8798”} here, I pray thee; for the \sc Lord\sc* [hath sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [me to Beth-el]{strong=“H1008”}. \w And Elisha| strong="H477" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, As the \sc Lord\sc* \w liveth| strong="H2416" \w*, and as \w thy soul| strong="H5315" \w* \w liveth| strong="H2416" \w*, [I will not leave]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} [thee. So they went down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} [to Beth-el]{strong=“H1008”}. 
\v 3 \w And the sons| strong="H1121" \w* \w of the prophets| strong="H5030" \w* that were [at Beth-el]{strong=“H1008”} [came forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Elisha| strong="H477" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} thou that the \sc Lord\sc* [will take away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8802”} \w thy master| strong="H113" \w* \w from thy head| strong="H7218" \w* \w to day| strong="H3117" \w*? [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Yea, I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} it; [hold ye your peace]{strong=“H2814” x-morph=“strongMorph: \sc Th\sc*8685”}. 
\v 4 \w And Elijah| strong="H452" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Elisha]{strong=“H477”}, [tarry]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8798”} here, I pray thee; for the \sc Lord\sc* [hath sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w me to Jericho| strong="H3405" \w*. [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, As the \sc Lord\sc* \w liveth| strong="H2416" \w*, and as \w thy soul| strong="H5315" \w* \w liveth| strong="H2416" \w*, [I will not leave]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} [thee. So they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Jericho| strong="H3405" \w*. 
\v 5 \w And the sons| strong="H1121" \w* \w of the prophets| strong="H5030" \w* that were \w at Jericho| strong="H3405" \w* [came]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Elisha| strong="H477" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} thou that the \sc Lord\sc* [will take away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8802”} \w thy master| strong="H113" \w* \w from thy head| strong="H7218" \w* \w to day| strong="H3117" \w*? [And he answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Yea, I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} it; [hold ye your peace]{strong=“H2814” x-morph=“strongMorph: \sc Th\sc*8685”}. 
\v 6 \w And Elijah| strong="H452" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Tarry]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8798”}, I pray thee, here; for the \sc Lord\sc* [hath sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w me to Jordan| strong="H3383" \w*. [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, As the \sc Lord\sc* \w liveth| strong="H2416" \w*, and as \w thy soul| strong="H5315" \w* \w liveth| strong="H2416" \w*, [I will not leave]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} [thee. And they two]{strong=“H8147”} [went on]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 7 \w And fifty| strong="H2572" \w* \w men| strong="H376" \w* \w of the sons| strong="H1121" \w* \w of the prophets| strong="H5030" \w* [went]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”}, [and stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w to view| strong="H5048" \w* \w afar off| strong="H7350" \w*: \w and they two| strong="H8147" \w* [stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} \w by Jordan| strong="H3383" \w*.\f + \fr 2:7 \ft to view: Heb. in sight, or, over against \f* 
\v 8 \w And Elijah| strong="H452" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w his mantle| strong="H155" \w*, and wrapped it [together]{strong=“H1563” x-morph=“strongMorph: \sc Th\sc*8799”}, [and smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w the waters| strong="H4325" \w*, [and they were divided]{strong=“H2673” x-morph=“strongMorph: \sc Th\sc*8735”} [hither and thither, so that they two]{strong=“H8147”} [went over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w on dry| strong="H2724" \w* ground. 
\p
