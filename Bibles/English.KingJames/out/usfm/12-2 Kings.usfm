\p
\v 17 \w And the king| strong="H4428" \w* [appointed]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8689”} \w the lord| strong="H7991" \w* \w on whose hand| strong="H3027" \w* [he leaned]{strong=“H8172” x-morph=“strongMorph: \sc Th\sc*8737”} \w to have the charge of the gate| strong="H8179" \w*: \w and the people| strong="H5971" \w* [trode ]{strong=“H7429” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon him in the gate| strong="H8179" \w*, [and he died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, \w as the man| strong="H376" \w* \w of God| strong="H430" \w* [had said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}, [who spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w when the king| strong="H4428" \w* [came down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8800”} to him. 
