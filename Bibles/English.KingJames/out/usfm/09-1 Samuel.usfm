\v 19 \w And all the people| strong="H5971" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Samuel| strong="H8050" \w*, [Pray]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8690”} \w for thy servants| strong="H5650" \w* unto the \sc Lord\sc* \w thy God| strong="H430" \w*, [that we die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} [not: for we have added]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto all our sins| strong="H2403" \w* this \w evil| strong="H7451" \w*, [to ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8800”} \w us a king| strong="H4428" \w*. 
\p
\v 20 \w And Samuel| strong="H8050" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the people| strong="H5971" \w*, [Fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [not: ye have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w all this wickedness| strong="H7451" \w*: [yet turn not aside]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8799”} \w from following| strong="H310" \w* the \sc Lord\sc*, [but serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w with all your heart| strong="H3824" \w*; 
\v 21 [And turn ye not aside]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8799”}: for then should ye go \w after| strong="H310" \w* \w vain| strong="H8414" \w* things, [which cannot profit]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8686”} [nor deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”}; for they are \w vain| strong="H8414" \w*. 
\v 22 For the \sc Lord\sc* [will not forsake]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8799”} \w his people| strong="H5971" \w* \w for his great| strong="H1419" \w* [name’s]{strong=“H8034”} [sake: because it hath pleased]{strong=“H2974” x-morph=“strongMorph: \sc Th\sc*8689”} the \sc Lord\sc* [to make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w you his people| strong="H5971" \w*. 
\v 23 \w Moreover as for me| strong="H595" \w*, \w God forbid| strong="H2486" \w* [that I should sin]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8800”} against the \sc Lord\sc* [in ceasing]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8800”} [to pray]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8692”} [for you: but I will teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8689”} \w you the good| strong="H2896" \w* \w and the right| strong="H3477" \w* \w way| strong="H1870" \w*:\f + \fr 12:23 \ft in: Heb. from \f* 
\v 24 [Only fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8798”} the \sc Lord\sc*, [and serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} \w him in truth| strong="H571" \w* \w with all your heart| strong="H3824" \w*: [for consider]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} how great things [he hath done]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8689”} for you.\f + \fr 12:24 \ft how…: or, what a great thing \f* 
\v 25 [But if ye shall still]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8687”} [do wickedly]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8686”}, [ye shall be consumed]{strong=“H5595” x-morph=“strongMorph: \sc Th\sc*8735”}, \w both ye and your king| strong="H4428" \w*.
\c 13
\p 
\v 1 \w Saul| strong="H7586" \w* [reigned]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8800”} [one year]{strong=“H8141 H1121”}; [and when he had reigned]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8804”} \w two| strong="H8147" \w* \w years| strong="H8141" \w* \w over Israel| strong="H3478" \w*,\f + \fr 13:1 \ft reigned one…: Heb. the son of one year in his reigning \f* 
\v 2 \w Saul| strong="H7586" \w* [chose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} \w him three| strong="H7969" \w* \w thousand| strong="H505" \w* men \w of Israel| strong="H3478" \w*; whereof \w two thousand| strong="H505" \w* \w were with Saul| strong="H7586" \w* \w in Michmash| strong="H4363" \w* \w and in mount| strong="H2022" \w* [Beth-el]{strong=“H1008”}, \w and a thousand| strong="H505" \w* \w were with Jonathan| strong="H3129" \w* \w in Gibeah| strong="H1390" \w* \w of Benjamin| strong="H1144" \w*: \w and the rest| strong="H3499" \w* \w of the people| strong="H5971" \w* [he sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w every man| strong="H376" \w* \w to his tent| strong="H168" \w*. 
\v 3 \w And Jonathan| strong="H3129" \w* [smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w the garrison| strong="H5333" \w* \w of the Philistines| strong="H6430" \w* that was \w in Geba| strong="H1387" \w*, \w and the Philistines| strong="H6430" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} of it. \w And Saul| strong="H7586" \w* [blew]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8804”} \w the trumpet| strong="H7782" \w* \w throughout all the land| strong="H776" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Let the Hebrews| strong="H5680" \w* [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 13:3 \ft Geba: or, the hill \f* 
\v 4 \w And all Israel| strong="H3478" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} that \w Saul| strong="H7586" \w* [had smitten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w a garrison| strong="H5333" \w* \w of the Philistines| strong="H6430" \w*, and that \w Israel| strong="H3478" \w* [also was had in abomination]{strong=“H887” x-morph=“strongMorph: \sc Th\sc*8738”} \w with the Philistines| strong="H6430" \w*. \w And the people| strong="H5971" \w* [were called together]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8735”} \w after| strong="H310" \w* \w Saul| strong="H7586" \w* \w to Gilgal| strong="H1537" \w*.\f + \fr 13:4 \ft was…: Heb. did stink \f* 
\p
\v 5 \w And the Philistines| strong="H6430" \w* [gathered themselves together]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8738”} [to fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8736”} \w with Israel| strong="H3478" \w*, \w thirty| strong="H7970" \w* \w thousand| strong="H505" \w* \w chariots| strong="H7393" \w*, \w and six| strong="H8337" \w* \w thousand| strong="H505" \w* \w horsemen| strong="H6571" \w*, \w and people| strong="H5971" \w* \w as the sand| strong="H2344" \w* which is \w on the sea| strong="H3220" \w* \w shore| strong="H8193" \w* \w in multitude| strong="H7230" \w*: [and they came up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”}, [and pitched]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8799”} \w in Michmash| strong="H4363" \w*, \w eastward| strong="H6926" \w* [from Beth-aven]{strong=“H1007”}. 
\v 6 \w When the men| strong="H376" \w* \w of Israel| strong="H3478" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} [that they were in a strait]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8804”}, (\w for the people| strong="H5971" \w* [were distressed]{strong=“H5065” x-morph=“strongMorph: \sc Th\sc*8738”},) \w then the people| strong="H5971" \w* [did hide]{strong=“H2244” x-morph=“strongMorph: \sc Th\sc*8691”} \w themselves in caves| strong="H4631" \w*, \w and in thickets| strong="H2337" \w*, \w and in rocks| strong="H5553" \w*, \w and in high places| strong="H6877" \w*, \w and in pits| strong="H953" \w*. 
\v 7 And some of \w the Hebrews| strong="H5680" \w* [went over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w Jordan| strong="H3383" \w* \w to the land| strong="H776" \w* \w of Gad| strong="H1410" \w* \w and Gilead| strong="H1568" \w*. \w As for Saul| strong="H7586" \w*, he was \w yet in Gilgal| strong="H1537" \w*, \w and all the people| strong="H5971" \w* \w followed| strong="H310" \w* [him trembling]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 13:7 \ft followed…: Heb. trembled after him \f* 
\p
\v 8 [And he tarried]{strong=“H3176 H3176” x-morph=“strongMorph: \sc Th\sc*8735 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8686”} \w seven| strong="H7651" \w* \w days| strong="H3117" \w*, \w according to the set time| strong="H4150" \w* \w that Samuel| strong="H8050" \w* had appointed: \w but Samuel| strong="H8050" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w not to Gilgal| strong="H1537" \w*; \w and the people| strong="H5971" \w* [were scattered]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8686”} from him. 
\v 9 \w And Saul| strong="H7586" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Bring hither]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8685”} \w a burnt offering| strong="H5930" \w* [to me, and peace offerings]{strong=“H8002”}. [And he offered]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w the burnt offering| strong="H5930" \w*. 
\v 10 [And it came to pass, that as soon as he had made an end]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8763”} [of offering]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8687”} \w the burnt offering| strong="H5930" \w*, [behold, Samuel]{strong=“H8050”} [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}; \w and Saul| strong="H7586" \w* [went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} [to meet]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} [him, that he might salute]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8800”} him.\f + \fr 13:10 \ft salute: Heb. bless \f* 
\p
\v 11 \w And Samuel| strong="H8050" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [What hast thou done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}? \w And Saul| strong="H7586" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Because I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w that the people| strong="H5971" \w* [were scattered]{strong=“H5310” x-morph=“strongMorph: \sc Th\sc*8804”} from me, and that [thou camest]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w not within the days| strong="H3117" \w* \w appointed| strong="H4150" \w*, and that \w the Philistines| strong="H6430" \w* [gathered themselves together]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8737”} \w at Michmash| strong="H4363" \w*; 
\v 12 [Therefore said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [I, The Philistines]{strong=“H6430”} [will come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w now upon me to Gilgal| strong="H1537" \w*, [and I have not made supplication]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto| strong="H6440" \w* the \sc Lord\sc*: [I forced]{strong=“H662” x-morph=“strongMorph: \sc Th\sc*8691”} [myself therefore, and offered]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w a burnt offering| strong="H5930" \w*.\f + \fr 13:12 \ft made…: Heb. intreated the face \f* 
\v 13 \w And Samuel| strong="H8050" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Saul| strong="H7586" \w*, [Thou hast done foolishly]{strong=“H5528” x-morph=“strongMorph: \sc Th\sc*8738”}: [thou hast not kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w the commandment| strong="H4687" \w* of the \sc Lord\sc* \w thy God| strong="H430" \w*, [which he commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} thee: for now would the \sc Lord\sc* [have established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy kingdom| strong="H4467" \w* \w upon Israel| strong="H3478" \w* \w for| strong="H5704" \w* \w ever| strong="H5769" \w*. 
\v 14 \w But now thy kingdom| strong="H4467" \w* [shall not continue]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}: the \sc Lord\sc* [hath sought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8765”} \w him a man| strong="H376" \w* \w after his own heart| strong="H3824" \w*, and the \sc Lord\sc* [hath commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} him to be \w captain| strong="H5057" \w* \w over his people| strong="H5971" \w*, [because thou hast not kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} that which the \sc Lord\sc* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} thee. 
\p
\v 15 \w And Samuel| strong="H8050" \w* [arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and gat him up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w from Gilgal| strong="H1537" \w* \w unto Gibeah| strong="H1390" \w* \w of Benjamin| strong="H1144" \w*. \w And Saul| strong="H7586" \w* [numbered]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} \w the people| strong="H5971" \w* that were [present]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8737”} [with him, about six]{strong=“H8337”} \w hundred| strong="H3967" \w* \w men| strong="H376" \w*.\f + \fr 13:15 \ft present: Heb. found \f* 
\v 16 \w And Saul| strong="H7586" \w*, \w and Jonathan| strong="H3129" \w* \w his son| strong="H1121" \w*, \w and the people| strong="H5971" \w* that were [present]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8737”} [with them, abode]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in Gibeah| strong="H1387" \w* \w of Benjamin| strong="H1144" \w*: \w but the Philistines| strong="H6430" \w* [encamped]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8804”} \w in Michmash| strong="H4363" \w*.\f + \fr 13:16 \ft present: Heb. found \f* \f + \fr 13:16 \ft Gibeah: Heb. Geba \f* 
\p
\v 17 [And the spoilers]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8688”} [came out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the camp| strong="H4264" \w* \w of the Philistines| strong="H6430" \w* \w in three| strong="H7969" \w* \w companies| strong="H7218" \w*: \w one| strong="H259" \w* \w company| strong="H7218" \w* [turned]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the way| strong="H1870" \w* that leadeth to \w Ophrah| strong="H6084" \w*, \w unto the land| strong="H776" \w* \w of Shual| strong="H7777" \w*: 
\v 18 \w And another| strong="H259" \w* \w company| strong="H7218" \w* [turned]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8799”} \w the way| strong="H1870" \w* to [Beth-horon]{strong=“H1032”}: \w and another| strong="H259" \w* \w company| strong="H7218" \w* [turned]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8799”} to \w the way| strong="H1870" \w* \w of the border| strong="H1366" \w* [that looketh]{strong=“H8259” x-morph=“strongMorph: \sc Th\sc*8737”} \w to the valley| strong="H1516" \w* \w of Zeboim| strong="H6650" \w* \w toward the wilderness| strong="H4057" \w*. 
\p
\v 19 \w Now there was no smith| strong="H2796" \w* [found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”} \w throughout all the land| strong="H776" \w* \w of Israel| strong="H3478" \w*: \w for the Philistines| strong="H6430" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Lest the Hebrews| strong="H5680" \w* [make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} them \w swords| strong="H2719" \w* \w or spears| strong="H2595" \w*: 
\v 20 \w But all the Israelites| strong="H3478" \w* [went down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the Philistines| strong="H6430" \w*, [to sharpen]{strong=“H3913” x-morph=“strongMorph: \sc Th\sc*8800”} \w every man| strong="H376" \w* \w his share| strong="H4282" \w*, \w and his coulter| strong="H855" \w*, \w and his axe| strong="H7134" \w*, \w and his mattock| strong="H4281" \w*. 
\v 21 [Yet they had a file]{strong=“H6310 H6477”} \w for the mattocks| strong="H4281" \w*, \w and for the coulters| strong="H855" \w*, [and for the forks]{strong=“H7053 H7969”}, \w and for the axes| strong="H7134" \w*, [and to sharpen]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8687”} \w the goads| strong="H1861" \w*.\f + \fr 13:21 \ft a file: Heb. a file with mouths, or Heb. a pim, a third of a shekel \f* \f + \fr 13:21 \ft sharpen: Heb. set \f* 
\v 22 \w So it came to pass in the day| strong="H3117" \w* \w of battle| strong="H4421" \w*, \w that there was neither sword| strong="H2719" \w* \w nor spear| strong="H2595" \w* [found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the hand| strong="H3027" \w* \w of any of the people| strong="H5971" \w* that were \w with Saul| strong="H7586" \w* \w and Jonathan| strong="H3129" \w*: \w but with Saul| strong="H7586" \w* \w and with Jonathan| strong="H3129" \w* \w his son| strong="H1121" \w* [was there found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 23 \w And the garrison| strong="H4673" \w* \w of the Philistines| strong="H6430" \w* [went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the passage| strong="H4569" \w* \w of Michmash| strong="H4363" \w*.\f + \fr 13:23 \ft garrison: or, standing camp \f*
\c 14
\p 
\v 1 \w Now it came to pass upon a day| strong="H3117" \w*, \w that Jonathan| strong="H3129" \w* \w the son| strong="H1121" \w* \w of Saul| strong="H7586" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the young man| strong="H5288" \w* [that bare]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8802”} \w his armour| strong="H3627" \w*, [Come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [and let us go over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} [to the Philistines’]{strong=“H6430”} \w garrison| strong="H4673" \w*, that is [on the other side]{strong=“H1975 H5676”}. [But he told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} \w not his father| strong="H1" \w*.\f + \fr 14:1 \ft it came…: or, there was a day \f* 
\v 2 \w And Saul| strong="H7586" \w* [tarried]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the uttermost| strong="H7097" \w* \w part of Gibeah| strong="H1390" \w* \w under a pomegranate tree| strong="H7416" \w* which is \w in Migron| strong="H4051" \w*: \w and the people| strong="H5971" \w* that were with him were \w about six| strong="H8337" \w* \w hundred| strong="H3967" \w* \w men| strong="H376" \w*; 
