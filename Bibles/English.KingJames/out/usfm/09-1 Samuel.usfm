\p
\v 18 \w So David| strong="H1732" \w* [fled]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8804”}, [and escaped]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8735”}, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Samuel| strong="H8050" \w* \w to Ramah| strong="H7414" \w*, [and told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w him all that Saul| strong="H7586" \w* [had done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [to him. And he and Samuel]{strong=“H8050”} [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [and dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in Naioth| strong="H5121" \w*. 
\v 19 [And it was told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8714”} \w Saul| strong="H7586" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Behold, David]{strong=“H1732”} is \w at Naioth| strong="H5121" \w* \w in Ramah| strong="H7414" \w*. 
\v 20 \w And Saul| strong="H7586" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w messengers| strong="H4397" \w* [to take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} \w David| strong="H1732" \w*: [and when they saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the company| strong="H3862" \w* \w of the prophets| strong="H5030" \w* [prophesying]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8737”}, \w and Samuel| strong="H8050" \w* [standing]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} as [appointed]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8737”} [over them, the Spirit]{strong=“H7307”} \w of God| strong="H430" \w* \w was upon the messengers| strong="H4397" \w* \w of Saul| strong="H7586" \w*, [and they also prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8691”}. 
\v 21 [And when it was told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w Saul| strong="H7586" \w*, [he sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w other| strong="H312" \w* \w messengers| strong="H4397" \w*, [and they prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8691”} [likewise. And Saul]{strong=“H7586”} [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w messengers| strong="H4397" \w* [again]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w the third| strong="H7992" \w* [time, and they prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8691”} also. 
\v 22 [Then went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w he also to Ramah| strong="H7414" \w*, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to a great| strong="H1419" \w* \w well| strong="H953" \w* that is \w in Sechu| strong="H7906" \w*: [and he asked]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Where| strong="H375" \w* are \w Samuel| strong="H8050" \w* \w and David| strong="H1732" \w*? And one [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Behold, they be \w at Naioth| strong="H5121" \w* \w in Ramah| strong="H7414" \w*. 
\v 23 [And he went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w thither to Naioth| strong="H5121" \w* \w in Ramah| strong="H7414" \w*: \w and the Spirit| strong="H7307" \w* \w of God| strong="H430" \w* [was upon him also, and he went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [on]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”}, [and prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8691”}, [until he came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w to Naioth| strong="H5121" \w* \w in Ramah| strong="H7414" \w*. 
\v 24 [And he stripped off]{strong=“H6584” x-morph=“strongMorph: \sc Th\sc*8799”} \w his clothes| strong="H899" \w* \w also| strong="H1571" \w*, [and prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8691”} \w before| strong="H6440" \w* \w Samuel| strong="H8050" \w* [in like manner, and lay down]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w naked| strong="H6174" \w* \w all that day| strong="H3117" \w* \w and all that night| strong="H3915" \w*. [Wherefore they say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Is \w Saul| strong="H7586" \w* \w also among the prophets| strong="H5030" \w*?\f + \fr 19:24 \ft lay: Heb. fell \f*
\c 20
\p 
\v 1 \w And David| strong="H1732" \w* [fled]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8799”} \w from Naioth| strong="H5121" \w* \w in Ramah| strong="H7414" \w*, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* \w Jonathan| strong="H3083" \w*, [What have I done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}? what is \w mine iniquity| strong="H5771" \w*? and what is \w my sin| strong="H2403" \w* \w before| strong="H6440" \w* \w thy father| strong="H1" \w*, [that he seeketh]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w my life| strong="H5315" \w*? 
\v 2 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, God forbid]{strong=“H2486”}; [thou shalt not die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}: [behold, my father]{strong=“H1”} [will do]{strong=“H6213 H6213” x-morph=“strongMorph: \sc Th\sc*8804 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8799”} \w nothing| strong="H1697" \w* \w either great| strong="H1419" \w* \w or small| strong="H6996" \w*, [but that he will shew]{strong=“H241 H1540” x-morph=“strongMorph: \sc Th\sc*8799”} [it me: and why should my father]{strong=“H1”} [hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8686”} \w this thing| strong="H1697" \w* from me? it is not so.\f + \fr 20:2 \ft shew…: Heb. uncover mine ear \f* 
\v 3 \w And David| strong="H1732" \w* [sware]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8735”} [moreover, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Thy father| strong="H1" \w* [certainly]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} [knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [that I have found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w grace| strong="H2580" \w* \w in thine eyes| strong="H5869" \w*; [and he saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Let not Jonathan| strong="H3083" \w* [know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [this, lest he be grieved]{strong=“H6087” x-morph=“strongMorph: \sc Th\sc*8735”}: \w but truly| strong="H199" \w* as the \sc Lord\sc* \w liveth| strong="H2416" \w*, and as \w thy soul| strong="H5315" \w* \w liveth| strong="H2416" \w*, there is \w but a step| strong="H6587" \w* \w between me and death| strong="H4194" \w*. 
\v 4 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jonathan| strong="H3083" \w* \w unto David| strong="H1732" \w*, \w Whatsoever thy soul| strong="H5315" \w* [desireth]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will even do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} it for thee.\f + \fr 20:4 \ft Whatsoever…: or, Say what is thy mind and I will do, etc \f* \f + \fr 20:4 \ft desireth: Heb. speaketh, or, thinketh \f* 
\v 5 \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Jonathan| strong="H3083" \w*, [Behold, to morrow]{strong=“H4279”} is \w the new moon| strong="H2320" \w*, [and I should not fail]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} [to sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the king| strong="H4428" \w* [at meat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”}: [but let me go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”}, [that I may hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8738”} \w myself in the field| strong="H7704" \w* \w unto the third| strong="H7992" \w* day \w at even| strong="H6153" \w*. 
\v 6 \w If thy father| strong="H1" \w* [at all]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8800”} [miss]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} [me, then say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w David| strong="H1732" \w* [earnestly]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8736”} [asked]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8738”} leave [of me that he might run]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8800”} [to Beth-lehem]{strong=“H1035”} \w his city| strong="H5892" \w*: for there is \w a yearly| strong="H3117" \w* \w sacrifice| strong="H2077" \w* \w there for all the family| strong="H4940" \w*.\f + \fr 20:6 \ft sacrifice: or, feast \f* 
\v 7 [If he say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} thus, It is \w well| strong="H2896" \w*; \w thy servant| strong="H5650" \w* \w shall have peace| strong="H7965" \w*: [but if he be very]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8800”} [wroth]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8799”}, then [be sure]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”} \w that evil| strong="H7451" \w* [is determined]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”} by him. 
\v 8 [Therefore thou shalt deal]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w kindly| strong="H2617" \w* \w with thy servant| strong="H5650" \w*; [for thou hast brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy servant| strong="H5650" \w* \w into a covenant| strong="H1285" \w* of the \sc Lord\sc* [with thee: notwithstanding, if there be]{strong=“H3426”} \w in me iniquity| strong="H5771" \w*, [slay]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8685”} [me thyself; for why shouldest thou bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w me to thy father| strong="H1" \w*? 
\p
\v 9 \w And Jonathan| strong="H3083" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Far be it from thee| strong="H2486" \w*: [for if I knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [certainly]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} \w that evil| strong="H7451" \w* [were determined]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”} \w by my father| strong="H1" \w* [to come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [upon thee, then would not I tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} it thee? 
\v 10 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w David| strong="H1732" \w* \w to Jonathan| strong="H3083" \w*, [Who shall tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} me? or what if \w thy father| strong="H1" \w* [answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee roughly| strong="H7186" \w*? 
\p
\v 11 \w And Jonathan| strong="H3083" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto David| strong="H1732" \w*, [Come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [and let us go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the field| strong="H7704" \w*. [And they went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w both| strong="H8147" \w* \w of them into the field| strong="H7704" \w*. 
\v 12 \w And Jonathan| strong="H3083" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto David| strong="H1732" \w*, O \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w*, [when I have sounded]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8799”} \w my father| strong="H1" \w* \w about to morrow| strong="H4279" \w* \w any time| strong="H6256" \w*, or \w the third| strong="H7992" \w* day, and, behold, if there be [good]{strong=“H2895” x-morph=“strongMorph: \sc Th\sc*8804”} \w toward David| strong="H1732" \w*, [and I then send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} [not unto thee, and shew]{strong=“H241 H1540” x-morph=“strongMorph: \sc Th\sc*8804”} it thee;\f + \fr 20:12 \ft sounded: Heb. searched \f* \f + \fr 20:12 \ft shew…: Heb. uncover thine ear \f* 
\v 13 The \sc Lord\sc* [do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w so| strong="H3541" \w* [and much more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w to Jonathan| strong="H3083" \w*: [but if it please]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8686”} \w my father| strong="H1" \w* to do \w thee evil| strong="H7451" \w*, [then I will shew]{strong=“H241 H1540” x-morph=“strongMorph: \sc Th\sc*8804”} [it thee, and send thee away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”}, [that thou mayest go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w in peace| strong="H7965" \w*: and the \sc Lord\sc* [be with thee, as he hath been with my father]{strong=“H1”}.\f + \fr 20:13 \ft shew…: Heb. uncover thine ear \f* 
\v 14 \w And thou shalt not only while yet| strong="H518" \w* \w I live| strong="H2416" \w* [shew]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w me the kindness| strong="H2617" \w* of the \sc Lord\sc*, [that I die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} not: 
\v 15 But also [thou shalt not cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy kindness| strong="H2617" \w* \w from my house| strong="H1004" \w* \w for| strong="H5704" \w* \w ever| strong="H5769" \w*: no, not when the \sc Lord\sc* [hath cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8687”} [the enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w of David| strong="H1732" \w* \w every one| strong="H376" \w* \w from the face| strong="H6440" \w* \w of the earth| strong="H127" \w*. 
\v 16 \w So Jonathan| strong="H3083" \w* [made]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} a covenant \w with the house| strong="H1004" \w* \w of David| strong="H1732" \w*, saying, Let the \sc Lord\sc* [even require]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8765”} it \w at the hand| strong="H3027" \w* [of David’s]{strong=“H1732”} [enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 20:16 \ft made: Heb. cut \f* 
\v 17 \w And Jonathan| strong="H3083" \w* \w caused David| strong="H1732" \w* [to swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8687”} [again]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”}, \w because he loved| strong="H160" \w* [him: for he loved]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} \w him as he loved| strong="H160" \w* \w his own soul| strong="H5315" \w*.\f + \fr 20:17 \ft because…: or, by his love toward him \f* 
\v 18 \w Then Jonathan| strong="H3083" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to David| strong="H1732" \w*, \w To morrow| strong="H4279" \w* is \w the new moon| strong="H2320" \w*: [and thou shalt be missed]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8738”}, \w because thy seat| strong="H4186" \w* [will be empty]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 20:18 \ft empty: Heb. missed \f* 
\v 19 And when [thou hast stayed three days]{strong=“H8027” x-morph=“strongMorph: \sc Th\sc*8765”}, then [thou shalt go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w quickly| strong="H3966" \w*, [and come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the place| strong="H4725" \w* [where thou didst hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8738”} \w thyself when| strong="H3117" \w* \w the business| strong="H4639" \w* was in hand, [and shalt remain]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w by| strong="H681" \w* \w the stone| strong="H68" \w* \w Ezel| strong="H237" \w*.\f + \fr 20:19 \ft quickly: or, diligently: Heb. greatly \f* \f + \fr 20:19 \ft when the…: Heb. in the day of the business \f* \f + \fr 20:19 \ft Ezel: or, that sheweth the way \f* 
\v 20 [And I will shoot]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”} \w three| strong="H7969" \w* \w arrows| strong="H2671" \w* \w on the side| strong="H6654" \w* thereof, [as though I shot]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8763”} \w at a mark| strong="H4307" \w*. 
\v 21 [And, behold, I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w a lad| strong="H5288" \w*, saying, [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [find out]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8798”} \w the arrows| strong="H2671" \w*. [If I expressly]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the lad| strong="H5288" \w*, [Behold, the arrows]{strong=“H2671”} are [on this side of thee, take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} [them; then come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} thou: for there is \w peace| strong="H7965" \w* [to thee, and no hurt]{strong=“H1697”}; as the \sc Lord\sc* \w liveth| strong="H2416" \w*.\f + \fr 20:21 \ft no hurt: Heb. not any thing \f* 
\v 22 [But if I say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w thus unto the young man| strong="H5958" \w*, [Behold, the arrows]{strong=“H2671”} are \w beyond| strong="H1973" \w* [thee; go thy way]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}: for the \sc Lord\sc* [hath sent thee away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 23 And as touching \w the matter| strong="H1697" \w* [which thou and I have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} of, behold, the \sc Lord\sc* be \w between thee and me for| strong="H5704" \w* \w ever| strong="H5769" \w*. 
\p
\v 24 \w So David| strong="H1732" \w* [hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8735”} \w himself in the field| strong="H7704" \w*: \w and when the new moon| strong="H2320" \w* [was come, the king]{strong=“H4428”} [sat him down]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} [to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} \w meat| strong="H3899" \w*. 
\v 25 \w And the king| strong="H4428" \w* [sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon his seat| strong="H4186" \w*, \w as at other times| strong="H6471" \w*, even \w upon a seat| strong="H4186" \w* \w by the wall| strong="H7023" \w*: \w and Jonathan| strong="H3083" \w* [arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and Abner| strong="H74" \w* [sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} [by Saul’s]{strong=“H7586”} \w side| strong="H6654" \w*, [and David’s]{strong=“H1732”} \w place| strong="H4725" \w* [was empty]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 26 \w Nevertheless Saul| strong="H7586" \w* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w not any thing| strong="H3972" \w* \w that day| strong="H3117" \w*: [for he thought]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Something hath befallen| strong="H4745" \w* him, he is \w not| strong="H1115" \w* \w clean| strong="H2889" \w*; surely he is \w not clean| strong="H2889" \w*. 
\v 27 \w And it came to pass on the morrow| strong="H4283" \w*, which was \w the second| strong="H8145" \w* day \w of the month| strong="H2320" \w*, [that David’s]{strong=“H1732”} \w place| strong="H4725" \w* [was empty]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8735”}: \w and Saul| strong="H7586" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Jonathan| strong="H3083" \w* \w his son| strong="H1121" \w*, [Wherefore cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the son| strong="H1121" \w* \w of Jesse| strong="H3448" \w* \w to meat| strong="H3899" \w*, \w neither yesterday| strong="H8543" \w*, \w nor to day| strong="H3117" \w*? 
\v 28 \w And Jonathan| strong="H3083" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w Saul| strong="H7586" \w*, \w David| strong="H1732" \w* [earnestly]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8736”} [asked]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8738”} leave \w of me| strong="H5978" \w* to go [to Beth-lehem]{strong=“H1035”}: 
\v 29 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Let me go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8761”}, [I pray thee; for our family]{strong=“H4940”} \w hath a sacrifice| strong="H2077" \w* \w in the city| strong="H5892" \w*; \w and my brother| strong="H251" \w*, [he hath commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} me to be there: [and now, if I have found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w favour| strong="H2580" \w* \w in thine eyes| strong="H5869" \w*, [let me get away]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8735”}, [I pray thee, and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w my brethren| strong="H251" \w*. [Therefore he cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [not unto the king’s]{strong=“H4428”} \w table| strong="H7979" \w*. 
\v 30 [Then Saul’s]{strong=“H7586”} \w anger| strong="H639" \w* [was kindled]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8799”} \w against Jonathan| strong="H3083" \w*, [and he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Thou son]{strong=“H1121”} [of the perverse]{strong=“H5753” x-morph=“strongMorph: \sc Th\sc*8737”} \w rebellious| strong="H4780" \w* woman, [do not I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [that thou hast chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8802”} \w the son| strong="H1121" \w* \w of Jesse| strong="H3448" \w* \w to thine own confusion| strong="H1322" \w*, \w and unto the confusion| strong="H1322" \w* [of thy mother’s]{strong=“H517”} \w nakedness| strong="H6172" \w*?\f + \fr 20:30 \ft Thou…: or, Thou perverse rebel: Heb. Son of perverse rebellion \f* 
\v 31 \w For as long as| strong="H3117" \w* \w the son| strong="H1121" \w* \w of Jesse| strong="H3448" \w* [liveth]{strong=“H2425” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon the ground| strong="H127" \w*, [thou shalt not be established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8735”}, \w nor thy kingdom| strong="H4438" \w*. [Wherefore now send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8798”} [and fetch]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} [him unto me, for he shall surely die]{strong=“H4194 H1121”}.\f + \fr 20:31 \ft shall…: Heb. is the son of death \f* 
\v 32 \w And Jonathan| strong="H3083" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w Saul| strong="H7586" \w* \w his father| strong="H1" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Wherefore shall he be slain]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}? [what hath he done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}? 
\v 33 \w And Saul| strong="H7586" \w* [cast]{strong=“H2904” x-morph=“strongMorph: \sc Th\sc*8686”} \w a javelin| strong="H2595" \w* [at him to smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8687”} [him: whereby Jonathan]{strong=“H3083”} [knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w that it was determined| strong="H3617" \w* \w of his father| strong="H1" \w* [to slay]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8687”} \w David| strong="H1732" \w*. 
\v 34 \w So Jonathan| strong="H3083" \w* [arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the table| strong="H7979" \w* \w in fierce| strong="H2750" \w* \w anger| strong="H639" \w*, [and did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w no meat| strong="H3899" \w* \w the second| strong="H8145" \w* \w day| strong="H3117" \w* \w of the month| strong="H2320" \w*: [for he was grieved]{strong=“H6087” x-morph=“strongMorph: \sc Th\sc*8738”} \w for David| strong="H1732" \w*, \w because his father| strong="H1" \w* [had done him shame]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\p
\v 35 \w And it came to pass in the morning| strong="H1242" \w*, \w that Jonathan| strong="H3083" \w* [went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the field| strong="H7704" \w* \w at the time appointed| strong="H4150" \w* \w with David| strong="H1732" \w*, \w and a little| strong="H6996" \w* \w lad| strong="H5288" \w* with him. 
\v 36 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his lad| strong="H5288" \w*, [Run]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8798”}, [find out]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8798”} \w now the arrows| strong="H2671" \w* [which I shoot]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8688”}. And \w as the lad| strong="H5288" \w* [ran]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8801”}, [he shot]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8804”} \w an arrow| strong="H2678" \w* [beyond]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8687”} him.\f + \fr 20:36 \ft beyond…: Heb. to pass over him \f* 
\v 37 \w And when the lad| strong="H5288" \w* [was come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the place| strong="H4725" \w* \w of the arrow| strong="H2678" \w* \w which Jonathan| strong="H3083" \w* [had shot]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Jonathan| strong="H3083" \w* [cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w the lad| strong="H5288" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Is \w not the arrow| strong="H2678" \w* \w beyond| strong="H1973" \w* thee? 
\v 38 \w And Jonathan| strong="H3083" \w* [cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w the lad| strong="H5288" \w*, \w Make speed| strong="H4120" \w*, [haste]{strong=“H2363” x-morph=“strongMorph: \sc Th\sc*8798”}, [stay]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} [not. And Jonathan’s]{strong=“H3083”} \w lad| strong="H5288" \w* [gathered up]{strong=“H3950” x-morph=“strongMorph: \sc Th\sc*8762”} [the arrows]{strong=“H2678 H2671” x-morph=“strongMorph: \sc Th\sc*8675”}, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to his master| strong="H113" \w*. 
\v 39 \w But the lad| strong="H5288" \w* [knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w not any thing| strong="H3972" \w*: \w only Jonathan| strong="H3083" \w* \w and David| strong="H1732" \w* [knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w the matter| strong="H1697" \w*. 
\v 40 \w And Jonathan| strong="H3083" \w* [gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w his artillery| strong="H3627" \w* \w unto his lad| strong="H5288" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [carry]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8685”} them \w to the city| strong="H5892" \w*.\f + \fr 20:40 \ft artillery: Heb. instruments \f* \f + \fr 20:40 \ft his lad: Heb. the lad that was his \f* 
\p
\v 41 And \w as soon as the lad| strong="H5288" \w* [was gone]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}, \w David| strong="H1732" \w* [arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”} out of a place \w toward| strong="H681" \w* \w the south| strong="H5045" \w*, [and fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w on his face| strong="H639" \w* \w to the ground| strong="H776" \w*, [and bowed]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} \w himself three| strong="H7969" \w* \w times| strong="H6471" \w*: [and they kissed]{strong=“H5401” x-morph=“strongMorph: \sc Th\sc*8799”} \w one| strong="H376" \w* \w another| strong="H7453" \w*, [and wept]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8799”} \w one| strong="H376" \w* \w with another| strong="H7453" \w*, \w until David| strong="H1732" \w* [exceeded]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\v 42 \w And Jonathan| strong="H3083" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to David| strong="H1732" \w*, [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} \w in peace| strong="H7965" \w*, [forasmuch as we have sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w both| strong="H8147" \w* \w of us in the name| strong="H8034" \w* of the \sc Lord\sc*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, The \sc Lord\sc* [be between me and thee, and between my seed]{strong=“H2233”} \w and thy seed| strong="H2233" \w* \w for| strong="H5704" \w* \w ever| strong="H5769" \w*. [And he arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} [and departed]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}: \w and Jonathan| strong="H3083" \w* [went]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w into the city| strong="H5892" \w*.^\sc 20:42 forasmuch…: or, the [Lord\sc* be witness of that which etc]
\c 21
\p 
\v 1 [Then came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w David| strong="H1732" \w* \w to Nob| strong="H5011" \w* \w to Ahimelech| strong="H288" \w* \w the priest| strong="H3548" \w*: \w and Ahimelech| strong="H288" \w* [was afraid]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8799”} [at the meeting]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} \w of David| strong="H1732" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, Why art [thou alone, and no man]{strong=“H376”} with thee?\f + \fr 21:1 \ft Ahimelech: also called Ahiah \f* 
\v 2 \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Ahimelech| strong="H288" \w* \w the priest| strong="H3548" \w*, \w The king| strong="H4428" \w* [hath commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w me a business| strong="H1697" \w*, [and hath said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Let no man]{strong=“H376”} [know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w any thing| strong="H3972" \w* \w of the business| strong="H1697" \w* [whereabout I send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8802”} [thee, and what I have commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [thee: and I have appointed]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8776”} my \w servants| strong="H5288" \w* \w to such| strong="H6423" \w* \w and such| strong="H492" \w* \w a place| strong="H4725" \w*. 
\v 3 \w Now therefore what is| strong="H3426" \w* \w under thine hand| strong="H3027" \w*? [give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} me \w five| strong="H2568" \w* loaves of \w bread| strong="H3899" \w* \w in mine hand| strong="H3027" \w*, [or what there is present]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8737”}.\f + \fr 21:3 \ft present: Heb. found \f* 
\v 4 \w And the priest| strong="H3548" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w David| strong="H1732" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, There is \w no common| strong="H2455" \w* \w bread| strong="H3899" \w* \w under mine hand| strong="H3027" \w*, \w but there is| strong="H3426" \w* \w hallowed| strong="H6944" \w* \w bread| strong="H3899" \w*; \w if the young men| strong="H5288" \w* [have kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8738”} \w themselves at least| strong="H389" \w* \w from women| strong="H802" \w*. 
\v 5 \w And David| strong="H1732" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w the priest| strong="H3548" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Of a truth]{strong=“H518”} \w women| strong="H802" \w* have been [kept]{strong=“H6113” x-morph=“strongMorph: \sc Th\sc*8803”} \w from us about these three| strong="H8032" \w* \w days| strong="H8543" \w*, [since I came out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”}, \w and the vessels| strong="H3627" \w* \w of the young men| strong="H5288" \w* \w are holy| strong="H6944" \w*, and the bread is \w in a manner| strong="H1870" \w* \w common| strong="H2455" \w*, [yea, though it were sanctified]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8799”} \w this day| strong="H3117" \w* \w in the vessel| strong="H3627" \w*.\f + \fr 21:5 \ft yea…: or, especially when this day there is other sanctified in the vessel \f* 
\v 6 \w So the priest| strong="H3548" \w* [gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w him hallowed| strong="H6944" \w* bread: \w for there was no bread| strong="H3899" \w* [there but the shewbread]{strong=“H6440 H3899”}, [that was taken]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8716”} \w from before| strong="H6440" \w* the \sc Lord\sc*, [to put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w hot| strong="H2527" \w* \w bread| strong="H3899" \w* \w in the day| strong="H3117" \w* [when it was taken away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8736”}. 
\v 7 \w Now a certain man| strong="H376" \w* \w of the servants| strong="H5650" \w* \w of Saul| strong="H7586" \w* was \w there that day| strong="H3117" \w*, [detained]{strong=“H6113” x-morph=“strongMorph: \sc Th\sc*8737”} \w before| strong="H6440" \w* the \sc Lord\sc*; \w and his name| strong="H8034" \w* was \w Doeg| strong="H1673" \w*, \w an Edomite| strong="H130" \w*, \w the chiefest| strong="H47" \w* [of the herdmen]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} that belonged \w to Saul| strong="H7586" \w*. 
\p
\v 8 \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Ahimelech| strong="H288" \w*, \w And is there| strong="H3426" \w* \w not| strong="H371" \w* \w here under thine hand| strong="H3027" \w* \w spear| strong="H2595" \w* \w or sword| strong="H2719" \w*? [for I have neither brought]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w my sword| strong="H2719" \w* \w nor my weapons| strong="H3627" \w* \w with me| strong="H3027" \w*, [because the king’s]{strong=“H4428”} \w business| strong="H1697" \w* [required]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8804”} [haste]{strong=“H5169” x-morph=“strongMorph: \sc Th\sc*8803”}. 
\v 9 \w And the priest| strong="H3548" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w The sword| strong="H2719" \w* \w of Goliath| strong="H1555" \w* \w the Philistine| strong="H6430" \w*, [whom thou slewest]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w in the valley| strong="H6010" \w* \w of Elah| strong="H425" \w*, behold, it is here [wrapped]{strong=“H3874” x-morph=“strongMorph: \sc Th\sc*8803”} \w in a cloth| strong="H8071" \w* \w behind| strong="H310" \w* \w the ephod| strong="H646" \w*: [if thou wilt take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [that, take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} it: for there is \w no other| strong="H312" \w* \w save| strong="H2108" \w* \w that here| strong="H2088" \w*. \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, There is [none like that; give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} it me. 
\p
\v 10 \w And David| strong="H1732" \w* [arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and fled]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8799”} \w that day| strong="H3117" \w* \w for fear| strong="H6440" \w* \w of Saul| strong="H7586" \w*, [and went]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Achish| strong="H397" \w* \w the king| strong="H4428" \w* \w of Gath| strong="H1661" \w*. 
\v 11 \w And the servants| strong="H5650" \w* \w of Achish| strong="H397" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, Is \w not this David| strong="H1732" \w* \w the king| strong="H4428" \w* \w of the land| strong="H776" \w*? [did they not sing]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w one to another of him| strong="H2088" \w* \w in dances| strong="H4246" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Saul| strong="H7586" \w* [hath slain]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w his thousands| strong="H505" \w*, \w and David| strong="H1732" \w* \w his ten thousands| strong="H7233" \w*? 
\v 12 \w And David| strong="H1732" \w* [laid up]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w these words| strong="H1697" \w* \w in his heart| strong="H3824" \w*, \w and was sore| strong="H3966" \w* [afraid ]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w of| strong="H6440" \w* \w Achish| strong="H397" \w* \w the king| strong="H4428" \w* \w of Gath| strong="H1661" \w*. 
\v 13 [And he changed]{strong=“H8138” x-morph=“strongMorph: \sc Th\sc*8762”} \w his behaviour| strong="H2940" \w* \w before| strong="H5869" \w* [them, and feigned himself mad]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8704”} \w in their hands| strong="H3027" \w*, [and scrabbled]{strong=“H8427” x-morph=“strongMorph: \sc Th\sc*8762”} \w on the doors| strong="H1817" \w* \w of the gate| strong="H8179" \w*, \w and let his spittle| strong="H7388" \w* [fall down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8686”} \w upon his beard| strong="H2206" \w*.\f + \fr 21:13 \ft scrabbled: or, made marks \f* 
\v 14 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Achish| strong="H397" \w* \w unto his servants| strong="H5650" \w*, [Lo, ye see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the man| strong="H376" \w* [is mad]{strong=“H7696” x-morph=“strongMorph: \sc Th\sc*8693”}: wherefore then [have ye brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} him to me?\f + \fr 21:14 \ft is mad: or, playeth the mad man \f* 
\v 15 \w Have I need| strong="H2638" \w* [of mad men]{strong=“H7696” x-morph=“strongMorph: \sc Th\sc*8794”}, [that ye have brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} this fellow [to play the mad man]{strong=“H7696” x-morph=“strongMorph: \sc Th\sc*8692”} in my presence? shall this fellow [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into my house| strong="H1004" \w*?
\c 22
\p 
\v 1 \w David| strong="H1732" \w* [therefore departed]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [thence, and escaped]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8735”} \w to the cave| strong="H4631" \w* \w Adullam| strong="H5725" \w*: \w and when his brethren| strong="H251" \w* [and all his father’s]{strong=“H1”} \w house| strong="H1004" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} it, [they went down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} thither to him. 
\v 2 \w And every one| strong="H376" \w* that was \w in distress| strong="H4689" \w*, \w and every one| strong="H376" \w* that was [in debt]{strong=“H5378” x-morph=“strongMorph: \sc Th\sc*8801”}, \w and every one| strong="H376" \w* that was [discontented]{strong=“H5315 H4751”}, [gathered]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8691”} [themselves unto him; and he became a captain]{strong=“H8269”} [over them: and there were with him about four]{strong=“H702”} \w hundred| strong="H3967" \w* \w men| strong="H376" \w*.\f + \fr 22:2 \ft was in debt: Heb. had a creditor \f* \f + \fr 22:2 \ft discontented: Heb. bitter of soul \f* 
\p
\v 3 \w And David| strong="H1732" \w* [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w thence to Mizpeh| strong="H4708" \w* \w of Moab| strong="H4124" \w*: [and he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the king| strong="H4428" \w* \w of Moab| strong="H4124" \w*, \w Let my father| strong="H1" \w* \w and my mother| strong="H517" \w*, [I pray thee, come forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”}, and be [with you, till I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w what God| strong="H430" \w* [will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} for me. 
\v 4 [And he brought]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8686”} \w them before| strong="H6440" \w* \w the king| strong="H4428" \w* \w of Moab| strong="H4124" \w*: [and they dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w with him all the while| strong="H3117" \w* \w that David| strong="H1732" \w* \w was in the hold| strong="H4686" \w*. 
\p
\v 5 \w And the prophet| strong="H5030" \w* \w Gad| strong="H1410" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto David| strong="H1732" \w*, [Abide]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w not in the hold| strong="H4686" \w*; [depart]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [and get]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee into the land| strong="H776" \w* \w of Judah| strong="H3063" \w*. \w Then David| strong="H1732" \w* [departed]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the forest| strong="H3293" \w* \w of Hareth| strong="H2802" \w*. 
\p
\v 6 \w When Saul| strong="H7586" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w that David| strong="H1732" \w* [was discovered]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and the men| strong="H582" \w* that were [with him, (now Saul]{strong=“H7586”} [abode]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in Gibeah| strong="H1390" \w* \w under a tree| strong="H815" \w* \w in Ramah| strong="H7414" \w*, \w having his spear| strong="H2595" \w* \w in his hand| strong="H3027" \w*, \w and all his servants| strong="H5650" \w* were [standing]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8737”} about him;)\f + \fr 22:6 \ft tree…: or, grove in a high place \f* 
\v 7 \w Then Saul| strong="H7586" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his servants| strong="H5650" \w* [that stood]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8737”} [about him, Hear now]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, \w ye Benjamites| strong="H1145" \w*; \w will the son| strong="H1121" \w* \w of Jesse| strong="H3448" \w* [give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w every one of you fields| strong="H7704" \w* \w and vineyards| strong="H3754" \w*, and [make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w you all captains| strong="H8269" \w* \w of thousands| strong="H505" \w*, \w and captains| strong="H8269" \w* \w of hundreds| strong="H3967" \w*; 
\v 8 [That all of you have conspired]{strong=“H7194” x-morph=“strongMorph: \sc Th\sc*8804”} against me, and there is [none that sheweth]{strong=“H241 H1540” x-morph=“strongMorph: \sc Th\sc*8802”} \w me that my son| strong="H1121" \w* [hath made a league]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8800”} \w with the son| strong="H1121" \w* \w of Jesse| strong="H3448" \w*, and there is [none of you that is sorry]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8802”} [for me, or sheweth]{strong=“H241 H1540” x-morph=“strongMorph: \sc Th\sc*8802”} \w unto me that my son| strong="H1121" \w* [hath stirred up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} \w my servant| strong="H5650" \w* [against me, to lie in wait]{strong=“H693” x-morph=“strongMorph: \sc Th\sc*8802”}, \w as at this day| strong="H3117" \w*?\f + \fr 22:8 \ft sheweth…: Heb. uncovereth mine ear \f* 
\p
\v 9 [Then answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w Doeg| strong="H1673" \w* \w the Edomite| strong="H130" \w*, [which was set]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8737”} \w over the servants| strong="H5650" \w* \w of Saul| strong="H7586" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the son| strong="H1121" \w* \w of Jesse| strong="H3448" \w* [coming]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w to Nob| strong="H5011" \w*, \w to Ahimelech| strong="H288" \w* \w the son| strong="H1121" \w* \w of Ahitub| strong="H285" \w*. 
\v 10 [And he enquired]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} of the \sc Lord\sc* [for him, and gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w him victuals| strong="H6720" \w*, [and gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w him the sword| strong="H2719" \w* \w of Goliath| strong="H1555" \w* \w the Philistine| strong="H6430" \w*. 
\v 11 \w Then the king| strong="H4428" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} [to call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8800”} \w Ahimelech| strong="H288" \w* \w the priest| strong="H3548" \w*, \w the son| strong="H1121" \w* \w of Ahitub| strong="H285" \w*, [and all his father’s]{strong=“H1”} \w house| strong="H1004" \w*, \w the priests| strong="H3548" \w* that were \w in Nob| strong="H5011" \w*: [and they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w all of them to the king| strong="H4428" \w*. 
\v 12 \w And Saul| strong="H7586" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [now, thou son]{strong=“H1121”} \w of Ahitub| strong="H285" \w*. [And he answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Here I am, \w my lord| strong="H113" \w*.\f + \fr 22:12 \ft Here…: Heb. Behold me \f* 
\v 13 \w And Saul| strong="H7586" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Why have ye conspired]{strong=“H7194” x-morph=“strongMorph: \sc Th\sc*8804”} [against me, thou and the son]{strong=“H1121”} \w of Jesse| strong="H3448" \w*, [in that thou hast given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w him bread| strong="H3899" \w*, \w and a sword| strong="H2719" \w*, [and hast enquired]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8800”} \w of God| strong="H430" \w* [for him, that he should rise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8800”} [against me, to lie in wait]{strong=“H693” x-morph=“strongMorph: \sc Th\sc*8802”}, \w as at this day| strong="H3117" \w*? 
\v 14 \w Then Ahimelech| strong="H288" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w the king| strong="H4428" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, And who is so [faithful]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8737”} \w among all thy servants| strong="H5650" \w* \w as David| strong="H1732" \w*, [which is the king’s]{strong=“H4428”} \w son in law| strong="H2860" \w*, [and goeth]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8804”} \w at thy bidding| strong="H4928" \w*, [and is honourable]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8737”} \w in thine house| strong="H1004" \w*? 
\v 15 \w Did I then| strong="H3117" \w* [begin]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8689”} [to enquire]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8800”} \w of God| strong="H430" \w* [for him? be it far from me]{strong=“H2486”}: \w let not the king| strong="H4428" \w* [impute ]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} any \w thing| strong="H1697" \w* \w unto his servant| strong="H5650" \w*, nor \w to all the house| strong="H1004" \w* \w of my father| strong="H1" \w*: \w for thy servant| strong="H5650" \w* [knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w nothing| strong="H1697" \w* [of all this, less]{strong=“H6996”} \w or more| strong="H1419" \w*.\f + \fr 22:15 \ft less…: Heb. little or great \f* 
\v 16 \w And the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Thou shalt surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Ahimelech| strong="H288" \w*, [thou, and all thy father’s]{strong=“H1”} \w house| strong="H1004" \w*. 
\p
\v 17 \w And the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto the footmen]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8801”} [that stood]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8737”} [about him, Turn]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8798”}, [and slay]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8685”} \w the priests| strong="H3548" \w* of the \sc Lord\sc*; \w because their hand| strong="H3027" \w* also is \w with David| strong="H1732" \w*, [and because they knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [when he fled]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8802”}, [and did not shew]{strong=“H241 H1540” x-morph=“strongMorph: \sc Th\sc*8804”} [it to me. But the servants]{strong=“H5650”} \w of the king| strong="H4428" \w* [would]{strong=“H14” x-morph=“strongMorph: \sc Th\sc*8804”} [not put forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8800”} \w their hand| strong="H3027" \w* [to fall]{strong=“H6293” x-morph=“strongMorph: \sc Th\sc*8800”} \w upon the priests| strong="H3548" \w* of the \sc Lord\sc*.\f + \fr 22:17 \ft footmen: or, guard: Heb. runners \f* 
\v 18 \w And the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Doeg| strong="H1673" \w*, [Turn]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8798”} [thou, and fall]{strong=“H6293” x-morph=“strongMorph: \sc Th\sc*8798”} \w upon the priests| strong="H3548" \w*. \w And Doeg| strong="H1673" \w* \w the Edomite| strong="H130" \w* [turned]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8735”}, [and he fell]{strong=“H6293” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the priests| strong="H3548" \w*, [and slew]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8686”} \w on that day| strong="H3117" \w* \w fourscore| strong="H8084" \w* \w and five| strong="H2568" \w* \w persons| strong="H376" \w* [that did wear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8802”} \w a linen| strong="H906" \w* \w ephod| strong="H646" \w*. 
\v 19 \w And Nob| strong="H5011" \w*, \w the city| strong="H5892" \w* \w of the priests| strong="H3548" \w*, [smote ]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w he with the edge| strong="H6310" \w* \w of the sword| strong="H2719" \w*, \w both men| strong="H376" \w* \w and women| strong="H802" \w*, \w children| strong="H5768" \w* [and sucklings]{strong=“H3243” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and oxen| strong="H7794" \w*, \w and asses| strong="H2543" \w*, \w and sheep| strong="H7716" \w*, \w with the edge| strong="H6310" \w* \w of the sword| strong="H2719" \w*. 
\p
\v 20 \w And one| strong="H259" \w* \w of the sons| strong="H1121" \w* \w of Ahimelech| strong="H288" \w* \w the son| strong="H1121" \w* \w of Ahitub| strong="H285" \w*, \w named| strong="H8034" \w* \w Abiathar| strong="H54" \w*, [escaped]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8735”}, [and fled]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w David| strong="H1732" \w*. 
\v 21 \w And Abiathar| strong="H54" \w* [shewed]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w David| strong="H1732" \w* \w that Saul| strong="H7586" \w* [had slain]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*’S \w priests| strong="H3548" \w*. 
\v 22 \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Abiathar| strong="H54" \w*, [I knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} it \w that day| strong="H3117" \w*, \w when Doeg| strong="H1673" \w* \w the Edomite| strong="H130" \w* was [there, that he would surely]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8687”} [tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w Saul| strong="H7586" \w*: [I have occasioned]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8804”} the death \w of all the persons| strong="H5315" \w* [of thy father’s]{strong=“H1”} \w house| strong="H1004" \w*. 
\v 23 [Abide]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8798”} [thou with me, fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [not: for he that seeketh]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w my life| strong="H5315" \w* [seeketh]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy life| strong="H5315" \w*: but with me thou shalt be \w in safeguard| strong="H4931" \w*. 
\c 23
\p 
