\v 3 \w And David| strong="H1732" \w* [dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w with Achish| strong="H397" \w* \w at Gath| strong="H1661" \w*, \w he and his men| strong="H582" \w*, \w every man| strong="H376" \w* \w with his household| strong="H1004" \w*, even \w David| strong="H1732" \w* \w with his two| strong="H8147" \w* \w wives| strong="H802" \w*, \w Ahinoam| strong="H293" \w* \w the Jezreelitess| strong="H3159" \w*, \w and Abigail| strong="H26" \w* \w the Carmelitess| strong="H3762" \w*, [Nabal’s]{strong=“H5037”} \w wife| strong="H802" \w*. 
\v 4 [And it was told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8714”} \w Saul| strong="H7586" \w* \w that David| strong="H1732" \w* [was fled]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8804”} \w to Gath| strong="H1661" \w*: [and he sought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8763”} [no more again]{strong=“H3254 H3254” x-morph=“strongMorph: \sc Th\sc*8686 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8804”} for him. 
\p
\v 5 \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Achish| strong="H397" \w*, [If I have now found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w grace| strong="H2580" \w* \w in thine eyes| strong="H5869" \w*, [let them give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w me a place| strong="H4725" \w* \w in some| strong="H259" \w* \w town| strong="H5892" \w* \w in the country| strong="H7704" \w*, [that I may dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} [there: for why should thy servant]{strong=“H5650”} [dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the royal| strong="H4467" \w* \w city| strong="H5892" \w* with thee? 
\v 6 \w Then Achish| strong="H397" \w* [gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w him Ziklag| strong="H6860" \w* \w that day| strong="H3117" \w*: \w wherefore Ziklag| strong="H6860" \w* \w pertaineth unto the kings| strong="H4428" \w* \w of Judah| strong="H3063" \w* \w unto this day| strong="H3117" \w*. 
\v 7 [And the time]{strong=“H3117 H4557”} \w that David| strong="H1732" \w* [dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the country| strong="H7704" \w* \w of the Philistines| strong="H6430" \w* \w was a full year| strong="H3117" \w* \w and four| strong="H702" \w* \w months| strong="H2320" \w*.\f + \fr 27:7 \ft the time: Heb. the number of days \f* \f + \fr 27:7 \ft a full year: Heb. a year of days \f* 
\p
\v 8 \w And David| strong="H1732" \w* \w and his men| strong="H582" \w* [went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”}, [and invaded]{strong=“H6584” x-morph=“strongMorph: \sc Th\sc*8799”} \w the Geshurites| strong="H1651" \w*, \w and the Gezrites| strong="H1511" \w*, \w and the Amalekites| strong="H6003" \w*: \w for those| strong="H2007" \w* nations were \w of old| strong="H5769" \w* [the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the land| strong="H776" \w*, [as thou goest]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w to Shur| strong="H7793" \w*, \w even unto the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*.\f + \fr 27:8 \ft Gezrites: or, Gerzites \f* 
\v 9 \w And David| strong="H1732" \w* [smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w the land| strong="H776" \w*, \w and left neither man| strong="H376" \w* \w nor woman| strong="H802" \w* [alive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8762”}, [and took away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w the sheep| strong="H6629" \w*, \w and the oxen| strong="H1241" \w*, \w and the asses| strong="H2543" \w*, \w and the camels| strong="H1581" \w*, \w and the apparel| strong="H899" \w*, [and returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Achish| strong="H397" \w*. 
\v 10 \w And Achish| strong="H397" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Whither| strong="H408" \w* [have ye made a road]{strong=“H6584” x-morph=“strongMorph: \sc Th\sc*8804”} \w to day| strong="H3117" \w*? \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Against the south| strong="H5045" \w* \w of Judah| strong="H3063" \w*, \w and against the south| strong="H5045" \w* \w of the Jerahmeelites| strong="H3397" \w*, \w and against the south| strong="H5045" \w* \w of the Kenites| strong="H7017" \w*.\f + \fr 27:10 \ft Whither…: or, Did you not make a road, etc \f* 
\v 11 \w And David| strong="H1732" \w* [saved]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8762”} \w neither man| strong="H376" \w* \w nor woman| strong="H802" \w* [alive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8762”}, [to bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} tidings \w to Gath| strong="H1661" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Lest they should tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} [on us, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [So did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w David| strong="H1732" \w*, and so will be \w his manner| strong="H4941" \w* \w all the while| strong="H3117" \w* [he dwelleth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the country| strong="H7704" \w* \w of the Philistines| strong="H6430" \w*. 
\v 12 \w And Achish| strong="H397" \w* [believed]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”} \w David| strong="H1732" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w He hath made his people| strong="H5971" \w* \w Israel| strong="H3478" \w* [utterly]{strong=“H887” x-morph=“strongMorph: \sc Th\sc*8687”} [to abhor]{strong=“H887” x-morph=“strongMorph: \sc Th\sc*8689”} [him; therefore he shall be my servant]{strong=“H5650”} \w for ever| strong="H5769" \w*.\f + \fr 27:12 \ft utterly…: Heb. to stink \f*
\c 28
\p 
\v 1 \w And it came to pass in those days| strong="H3117" \w*, \w that the Philistines| strong="H6430" \w* \w gathered| strong="H6908" \w* \w their armies| strong="H4264" \w* [together]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8799”} \w for warfare| strong="H6635" \w*, [to fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8736”} \w with Israel| strong="H3478" \w*. \w And Achish| strong="H397" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto David| strong="H1732" \w*, [Know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [thou assuredly]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”}, [that thou shalt go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w with me to battle| strong="H4264" \w*, \w thou and thy men| strong="H582" \w*. 
\v 2 \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Achish| strong="H397" \w*, \w Surely| strong="H3651" \w* [thou shalt know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w what thy servant| strong="H5650" \w* [can do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}. \w And Achish| strong="H397" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to David| strong="H1732" \w*, [Therefore will I make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} [thee keeper]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w of mine head| strong="H7218" \w* \w for ever| strong="H3117" \w*. 
\p
\v 3 \w Now Samuel| strong="H8050" \w* [was dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and all Israel| strong="H3478" \w* [had lamented]{strong=“H5594” x-morph=“strongMorph: \sc Th\sc*8799”} [him, and buried]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8799”} \w him in Ramah| strong="H7414" \w*, \w even in his own city| strong="H5892" \w*. \w And Saul| strong="H7586" \w* [had put away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8689”} \w those that had familiar spirits| strong="H178" \w*, \w and the wizards| strong="H3049" \w*, \w out of the land| strong="H776" \w*. 
\v 4 \w And the Philistines| strong="H6430" \w* [gathered themselves together]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8735”}, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and pitched]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8799”} \w in Shunem| strong="H7766" \w*: \w and Saul| strong="H7586" \w* \w gathered| strong="H6908" \w* \w all Israel| strong="H3478" \w* [together]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8799”}, [and they pitched]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8799”} \w in Gilboa| strong="H1533" \w*. 
\v 5 \w And when Saul| strong="H7586" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the host| strong="H4264" \w* \w of the Philistines| strong="H6430" \w*, [he was afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and his heart| strong="H3820" \w* \w greatly| strong="H3966" \w* [trembled]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 6 \w And when Saul| strong="H7586" \w* [enquired]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} of the \sc Lord\sc*, the \sc Lord\sc* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”} [him not, neither by dreams]{strong=“H2472”}, \w nor by Urim| strong="H224" \w*, \w nor by prophets| strong="H5030" \w*. 
\p
\v 7 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Saul| strong="H7586" \w* \w unto his servants| strong="H5650" \w*, [Seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8761”} \w me a woman| strong="H802" \w* \w that hath| strong="H1172" \w* \w a familiar spirit| strong="H178" \w*, [that I may go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [to her, and enquire]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”} [of her. And his servants]{strong=“H5650”} [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} to him, Behold, there is \w a woman| strong="H802" \w* \w that hath| strong="H1172" \w* \w a familiar spirit| strong="H178" \w* \w at Endor| strong="H5874" \w*. 
\v 8 \w And Saul| strong="H7586" \w* [disguised]{strong=“H2664” x-morph=“strongMorph: \sc Th\sc*8691”} [himself, and put on]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w other| strong="H312" \w* \w raiment| strong="H899" \w*, [and he went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and two| strong="H8147" \w* \w men| strong="H582" \w* [with him, and they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the woman| strong="H802" \w* \w by night| strong="H3915" \w*: [and he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I pray thee, divine]{strong=“H7080” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto me by the familiar spirit| strong="H178" \w*, and bring me him [up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8685”}, [whom I shall name]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto thee. 
\v 9 \w And the woman| strong="H802" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Behold, thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w what Saul| strong="H7586" \w* [hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [how he hath cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w those that have familiar spirits| strong="H178" \w*, \w and the wizards| strong="H3049" \w*, \w out of the land| strong="H776" \w*: [wherefore then layest thou a snare]{strong=“H5367” x-morph=“strongMorph: \sc Th\sc*8693”} \w for my life| strong="H5315" \w*, [to cause me to die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8687”}? 
\v 10 \w And Saul| strong="H7586" \w* [sware]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8735”} to her by the \sc Lord\sc*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, As the \sc Lord\sc* \w liveth| strong="H2416" \w*, \w there shall| strong="H518" \w* \w no punishment| strong="H5771" \w* [happen ]{strong=“H7136” x-morph=“strongMorph: \sc Th\sc*8799”} \w to thee for this thing| strong="H1697" \w*. 
\v 11 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w the woman| strong="H802" \w*, [Whom shall I bring up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} [unto thee? And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Bring me up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8685”} \w Samuel| strong="H8050" \w*. 
\v 12 \w And when the woman| strong="H802" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w Samuel| strong="H8050" \w*, [she cried]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8799”} \w with a loud| strong="H1419" \w* \w voice| strong="H6963" \w*: \w and the woman| strong="H802" \w* [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Saul| strong="H7586" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Why hast thou deceived]{strong=“H7411” x-morph=“strongMorph: \sc Th\sc*8765”} me? for thou art \w Saul| strong="H7586" \w*. 
\v 13 \w And the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto her, Be not afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}: [for what sawest]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} [thou? And the woman]{strong=“H802”} [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Saul| strong="H7586" \w*, [I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w gods| strong="H430" \w* [ascending]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8802”} \w out of the earth| strong="H776" \w*. 
\v 14 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto her, What form]{strong=“H8389”} is [he of? And she said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w An old| strong="H2205" \w* \w man| strong="H376" \w* [cometh up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8802”}; and he is [covered]{strong=“H5844” x-morph=“strongMorph: \sc Th\sc*8802”} \w with a mantle| strong="H4598" \w*. \w And Saul| strong="H7586" \w* [perceived]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} that it was \w Samuel| strong="H8050" \w*, [and he stooped]{strong=“H6915” x-morph=“strongMorph: \sc Th\sc*8799”} with his \w face| strong="H639" \w* \w to the ground| strong="H776" \w*, [and bowed]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} himself.\f + \fr 28:14 \ft What…: Heb. What is his form? \f* 
\p
\v 15 \w And Samuel| strong="H8050" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Saul| strong="H7586" \w*, [Why hast thou disquieted]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8689”} [me, to bring me up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8687”}? \w And Saul| strong="H7586" \w* [answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w I am sore| strong="H3966" \w* [distressed]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8804”}; \w for the Philistines| strong="H6430" \w* [make war]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8737”} [against me, and God]{strong=“H430”} [is departed]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8804”} [from me, and answereth]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”} [me no more, neither by]{strong=“H3027”} \w prophets| strong="H5030" \w*, \w nor by dreams| strong="H2472" \w*: [therefore I have called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} [thee, that thou mayest make known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8687”} [unto me what I shall do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 28:15 \ft by prophets: Heb. by the hand of prophets \f* 
\v 16 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Samuel| strong="H8050" \w*, [Wherefore then dost thou ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} of me, seeing the \sc Lord\sc* [is departed]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8804”} [from thee, and is become thine enemy]{strong=“H6145”}? 
\v 17 And the \sc Lord\sc* [hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [to him, as he spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w by me| strong="H3027" \w*: for the \sc Lord\sc* [hath rent]{strong=“H7167” x-morph=“strongMorph: \sc Th\sc*8799”} \w the kingdom| strong="H4467" \w* \w out of thine hand| strong="H3027" \w*, [and given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w it to thy neighbour| strong="H7453" \w*, even \w to David| strong="H1732" \w*:\f + \fr 28:17 \ft to him: or, for himself \f* \f + \fr 28:17 \ft me: Heb. mine hand \f* 
\v 18 \w Because| strong="H834" \w* [thou obeyedst]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the voice| strong="H6963" \w* of the \sc Lord\sc*, [nor executedst]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w his fierce| strong="H2740" \w* \w wrath| strong="H639" \w* \w upon Amalek| strong="H6002" \w*, therefore hath the \sc Lord\sc* [done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w this thing| strong="H1697" \w* \w unto thee this day| strong="H3117" \w*. 
\v 19 Moreover the \sc Lord\sc* [will also deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w Israel| strong="H3478" \w* \w with thee into the hand| strong="H3027" \w* \w of the Philistines| strong="H6430" \w*: \w and to morrow| strong="H4279" \w* shalt \w thou and thy sons| strong="H1121" \w* be with me: the \sc Lord\sc* [also shall deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w the host| strong="H4264" \w* \w of Israel| strong="H3478" \w* \w into the hand| strong="H3027" \w* \w of the Philistines| strong="H6430" \w*. 
\p
\v 20 \w Then Saul| strong="H7586" \w* [fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} [straightway]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8762”} \w all| strong="H4393" \w* \w along| strong="H6967" \w* \w on the earth| strong="H776" \w*, \w and was sore| strong="H3966" \w* [afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}, \w because of the words| strong="H1697" \w* \w of Samuel| strong="H8050" \w*: \w and there was no strength| strong="H3581" \w* [in him; for he had eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w no bread| strong="H3899" \w* \w all the day| strong="H3117" \w*, \w nor all the night| strong="H3915" \w*.\f + \fr 28:20 \ft fell…: Heb. made haste, and fell with the fulness of his stature \f* 
\p
\v 21 \w And the woman| strong="H802" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Saul| strong="H7586" \w*, [and saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w that he was sore| strong="H3966" \w* [troubled]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8738”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Behold, thine handmaid]{strong=“H8198”} [hath obeyed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy voice| strong="H6963" \w*, [and I have put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w my life| strong="H5315" \w* \w in my hand| strong="H3709" \w*, [and have hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto thy words| strong="H1697" \w* [which thou spakest]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} unto me. 
\v 22 [Now therefore, I pray thee, hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou also unto the voice| strong="H6963" \w* \w of thine handmaid| strong="H8198" \w*, [and let me set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w a morsel| strong="H6595" \w* \w of bread| strong="H3899" \w* \w before| strong="H6440" \w* [thee; and eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8798”}, \w that thou mayest have strength| strong="H3581" \w*, [when thou goest]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w on thy way| strong="H1870" \w*. 
\v 23 [But he refused]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8762”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}. \w But his servants| strong="H5650" \w*, \w together with the woman| strong="H802" \w*, [compelled]{strong=“H6555” x-morph=“strongMorph: \sc Th\sc*8799”} [him; and he hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto their voice| strong="H6963" \w*. [So he arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the earth| strong="H776" \w*, [and sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the bed| strong="H4296" \w*. 
\v 24 \w And the woman| strong="H802" \w* \w had a fat| strong="H4770" \w* \w calf| strong="H5695" \w* \w in the house| strong="H1004" \w*; [and she hasted]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8762”}, [and killed]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} [it, and took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w flour| strong="H7058" \w*, [and kneaded]{strong=“H3888” x-morph=“strongMorph: \sc Th\sc*8799”} it, [and did bake]{strong=“H644” x-morph=“strongMorph: \sc Th\sc*8799”} \w unleavened bread| strong="H4682" \w* thereof: 
\v 25 [And she brought]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8686”} it \w before| strong="H6440" \w* \w Saul| strong="H7586" \w*, \w and before| strong="H6440" \w* \w his servants| strong="H5650" \w*; [and they did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}. [Then they rose up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and went away]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w that night| strong="H3915" \w*. 
\c 29
\p 
\v 1 \w Now the Philistines| strong="H6430" \w* [gathered together]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8799”} \w all their armies| strong="H4264" \w* \w to Aphek| strong="H663" \w*: \w and the Israelites| strong="H3478" \w* [pitched]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8802”} \w by a fountain| strong="H5869" \w* which is \w in Jezreel| strong="H3157" \w*. 
\v 2 \w And the lords| strong="H5633" \w* \w of the Philistines| strong="H6430" \w* [passed on]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} \w by hundreds| strong="H3967" \w*, \w and by thousands| strong="H505" \w*: \w but David| strong="H1732" \w* \w and his men| strong="H582" \w* [passed on]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the rereward| strong="H314" \w* \w with Achish| strong="H397" \w*. 
\v 3 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w the princes| strong="H8269" \w* \w of the Philistines| strong="H6430" \w*, What do \w these Hebrews| strong="H5680" \w* here? \w And Achish| strong="H397" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the princes| strong="H8269" \w* \w of the Philistines| strong="H6430" \w*, Is \w not this David| strong="H1732" \w*, \w the servant| strong="H5650" \w* \w of Saul| strong="H7586" \w* \w the king| strong="H4428" \w* \w of Israel| strong="H3478" \w*, \w which hath been with me these days| strong="H3117" \w*, \w or these years| strong="H8141" \w*, [and I have found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w no fault| strong="H3972" \w* \w in him since| strong="H3117" \w* [he fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8800”} unto me \w unto this day| strong="H3117" \w*? 
\v 4 \w And the princes| strong="H8269" \w* \w of the Philistines| strong="H6430" \w* [were wroth]{strong=“H7107” x-morph=“strongMorph: \sc Th\sc*8799”} [with him; and the princes]{strong=“H8269”} \w of the Philistines| strong="H6430" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Make]{strong=“H7725”} \w this fellow| strong="H376" \w* [return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”}, [that he may go again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w to his place| strong="H4725" \w* [which thou hast appointed]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8689”} [him, and let him not go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w with us to battle| strong="H4421" \w*, \w lest in the battle| strong="H4421" \w* \w he be an adversary| strong="H7854" \w* [to us: for wherewith should he reconcile]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8691”} \w himself unto his master| strong="H113" \w*? should it not be \w with the heads| strong="H7218" \w* \w of these men| strong="H582" \w*? 
\v 5 Is \w not this David| strong="H1732" \w*, [of whom they sang]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w one to another in dances| strong="H4246" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Saul| strong="H7586" \w* [slew]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w his thousands| strong="H505" \w*, \w and David| strong="H1732" \w* \w his ten thousands| strong="H7233" \w*? 
\p
\v 6 \w Then Achish| strong="H397" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w David| strong="H1732" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, Surely, as the \sc Lord\sc* \w liveth| strong="H2416" \w*, \w thou hast been upright| strong="H3477" \w*, [and thy going out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”} [and thy coming in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w with me in the host| strong="H4264" \w* is \w good| strong="H2896" \w* \w in my sight| strong="H5869" \w*: [for I have not found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w evil| strong="H7451" \w* \w in thee since the day| strong="H3117" \w* [of thy coming]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto me unto this day| strong="H3117" \w*: \w nevertheless the lords| strong="H5633" \w* \w favour| strong="H2896" \w* \w thee not| strong="H5869" \w*.\f + \fr 29:6 \ft the lords…: Heb. thou art not good in the eyes of the lords \f* 
\v 7 [Wherefore now return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”}, [and go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} \w in peace| strong="H7965" \w*, [that thou displease]{strong=“H5869 H7451 H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w not the lords| strong="H5633" \w* \w of the Philistines| strong="H6430" \w*.\f + \fr 29:7 \ft displease…: Heb. do not evil in the eyes of the lords \f* 
\p
\v 8 \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Achish| strong="H397" \w*, [But what have I done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}? [and what hast thou found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thy servant| strong="H5650" \w* \w so long as| strong="H3117" \w* \w I have been with thee| strong="H6440" \w* \w unto this day| strong="H3117" \w*, [that I may not go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8738”} [against the enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w of my lord| strong="H113" \w* \w the king| strong="H4428" \w*?\f + \fr 29:8 \ft with…: Heb. before thee \f* 
\v 9 \w And Achish| strong="H397" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to David| strong="H1732" \w*, [I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that thou art \w good| strong="H2896" \w* \w in my sight| strong="H5869" \w*, \w as an angel| strong="H4397" \w* \w of God| strong="H430" \w*: \w notwithstanding the princes| strong="H8269" \w* \w of the Philistines| strong="H6430" \w* [have said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [He shall not go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w with us to the battle| strong="H4421" \w*. 
\v 10 [Wherefore now rise up early]{strong=“H7925” x-morph=“strongMorph: \sc Th\sc*8685”} \w in the morning| strong="H1242" \w* [with thy master’s]{strong=“H113”} \w servants| strong="H5650" \w* [that are come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [with thee: and as soon as ye be up early]{strong=“H7925” x-morph=“strongMorph: \sc Th\sc*8689”} \w in the morning| strong="H1242" \w*, [and have light]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8804”}, [depart]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}. 
\v 11 \w So David| strong="H1732" \w* \w and his men| strong="H582" \w* [rose up early]{strong=“H7925” x-morph=“strongMorph: \sc Th\sc*8686”} [to depart]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the morning| strong="H1242" \w*, [to return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w into the land| strong="H776" \w* \w of the Philistines| strong="H6430" \w*. \w And the Philistines| strong="H6430" \w* [went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w to Jezreel| strong="H3157" \w*.
\c 30
\p 
\v 1 [And it came to pass, when David]{strong=“H1732”} \w and his men| strong="H582" \w* [were come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w to Ziklag| strong="H6860" \w* \w on the third| strong="H7992" \w* \w day| strong="H3117" \w*, \w that the Amalekites| strong="H6003" \w* [had invaded]{strong=“H6584” x-morph=“strongMorph: \sc Th\sc*8804”} \w the south| strong="H5045" \w*, \w and Ziklag| strong="H6860" \w*, [and smitten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w Ziklag| strong="H6860" \w*, [and burned]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8799”} \w it with fire| strong="H784" \w*; 
\v 2 \w And had taken the women| strong="H802" \w* [captives]{strong=“H7617” x-morph=“strongMorph: \sc Th\sc*8799”}, that were [therein: they slew]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8689”} \w not any| strong="H376" \w*, \w either great| strong="H1419" \w* \w or small| strong="H6996" \w*, but carried them [away]{strong=“H5090” x-morph=“strongMorph: \sc Th\sc*8799”}, [and went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w on their way| strong="H1870" \w*. 
\p
\v 3 \w So David| strong="H1732" \w* \w and his men| strong="H582" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the city| strong="H5892" \w*, and, behold, it was [burned]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8803”} \w with fire| strong="H784" \w*; \w and their wives| strong="H802" \w*, \w and their sons| strong="H1121" \w*, \w and their daughters| strong="H1323" \w*, [were taken captives]{strong=“H7617” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 4 \w Then David| strong="H1732" \w* \w and the people| strong="H5971" \w* that were [with him lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their voice| strong="H6963" \w* [and wept]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8799”}, \w until they had no more power| strong="H3581" \w* [to weep]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8800”}. 
