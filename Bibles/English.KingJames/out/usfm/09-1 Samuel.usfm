\p
\v 18 \w Then Saul| strong="H7586" \w* [drew near]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Samuel| strong="H8050" \w* \w in| strong="H8432" \w* \w the gate| strong="H8179" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”} [me, I pray thee, where]{strong=“H335”} [the seer’s]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} \w house| strong="H1004" \w* is. 
\v 19 \w And Samuel| strong="H8050" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w Saul| strong="H7586" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, I am [the seer]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”}: [go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”} \w before| strong="H6440" \w* \w me unto the high place| strong="H1116" \w*; [for ye shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w with me to day| strong="H3117" \w*, \w and to morrow| strong="H1242" \w* [I will let thee go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”}, [and will tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} thee all that is \w in thine heart| strong="H3824" \w*. 
\v 20 \w And as for thine asses| strong="H860" \w* [that were lost]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8802”} \w three| strong="H7969" \w* \w days| strong="H3117" \w* \w ago| strong="H3117" \w*, [set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w not thy mind| strong="H3820" \w* [on them; for they are found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8738”}. And on whom is \w all the desire| strong="H2532" \w* \w of Israel| strong="H3478" \w*? Is it [not on thee, and on all thy father’s]{strong=“H1”} \w house| strong="H1004" \w*?\f + \fr 9:20 \ft three…: Heb. to day three days \f* 
\v 21 \w And Saul| strong="H7586" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Am \w not I a Benjamite| strong="H1145" \w*, \w of the smallest| strong="H6996" \w* \w of the tribes| strong="H7626" \w* \w of Israel| strong="H3478" \w*? \w and my family| strong="H4940" \w* \w the least| strong="H6810" \w* \w of all the families| strong="H4940" \w* \w of the tribe| strong="H7626" \w* \w of Benjamin| strong="H1144" \w*? [wherefore then speakest]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w thou so| strong="H1697" \w* to me?\f + \fr 9:21 \ft so…: Heb. according to this word \f* 
\v 22 \w And Samuel| strong="H8050" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w Saul| strong="H7586" \w* \w and his servant| strong="H5288" \w*, [and brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w them into the parlour| strong="H3957" \w*, [and made them sit]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the chiefest| strong="H7218" \w* \w place| strong="H4725" \w* [among them that were bidden]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8803”}, which were \w about thirty| strong="H7970" \w* \w persons| strong="H376" \w*. 
\v 23 \w And Samuel| strong="H8050" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the cook| strong="H2876" \w*, [Bring]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w the portion| strong="H4490" \w* [which I gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, of which I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto thee, Set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} it by thee. 
\v 24 \w And the cook| strong="H2876" \w* [took up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} \w the shoulder| strong="H7785" \w*, and that which was [upon it, and set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} it \w before| strong="H6440" \w* \w Saul| strong="H7586" \w*. And Samuel [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Behold that which is left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”}! [set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} it \w before| strong="H6440" \w* thee, and [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8798”}: \w for unto this time| strong="H4150" \w* [hath it been kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8803”} [for thee since I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [I have invited]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w the people| strong="H5971" \w*. \w So Saul| strong="H7586" \w* [did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w with Samuel| strong="H8050" \w* \w that day| strong="H3117" \w*.\f + \fr 9:24 \ft left: or, reserved \f* 
\p
\v 25 [And when they were come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the high place| strong="H1116" \w* \w into the city| strong="H5892" \w*, Samuel [communed]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w with Saul| strong="H7586" \w* \w upon the top of the house| strong="H1406" \w*. 
\v 26 [And they arose early]{strong=“H7925” x-morph=“strongMorph: \sc Th\sc*8686”}: [and it came to pass about the spring]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8800”} \w of the day| strong="H7837" \w*, \w that Samuel| strong="H8050" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w Saul| strong="H7586" \w* \w to the top of the house| strong="H1406" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [that I may send thee away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”}. \w And Saul| strong="H7586" \w* [arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and they went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w both| strong="H8147" \w* [of them, he and Samuel]{strong=“H8050”}, \w abroad| strong="H2351" \w*. 
\v 27 And [as they were going down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the end| strong="H7097" \w* \w of the city| strong="H5892" \w*, \w Samuel| strong="H8050" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w to Saul| strong="H7586" \w*, [Bid]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w the servant| strong="H5288" \w* [pass on]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* [us, (and he passed on]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8798”},) [but stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou still a while| strong="H3117" \w*, [that I may shew]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee the word| strong="H1697" \w* \w of God| strong="H430" \w*.\f + \fr 9:27 \ft a while: Heb. to day \f*
\c 10
\p 
\v 1 \w Then Samuel| strong="H8050" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a vial| strong="H6378" \w* \w of oil| strong="H8081" \w*, [and poured]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8799”} it \w upon his head| strong="H7218" \w*, [and kissed]{strong=“H5401” x-morph=“strongMorph: \sc Th\sc*8799”} [him, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Is it not because the \sc Lord\sc* [hath anointed]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8804”} thee to be \w captain| strong="H5057" \w* \w over his inheritance| strong="H5159" \w*? 
