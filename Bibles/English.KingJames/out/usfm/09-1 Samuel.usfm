\c 16
\p 
\v 1 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Samuel| strong="H8050" \w*, [How long wilt thou mourn]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8693”} \w for Saul| strong="H7586" \w*, [seeing I have rejected]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} [him from reigning]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8800”} \w over Israel| strong="H3478" \w*? [fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8761”} \w thine horn| strong="H7161" \w* \w with oil| strong="H8081" \w*, [and go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee to Jesse| strong="H3448" \w* [the Beth-lehemite]{strong=“H1022”}: [for I have provided]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w me a king| strong="H4428" \w* \w among his sons| strong="H1121" \w*. 
\v 2 \w And Samuel| strong="H8050" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [How can I go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}? \w if Saul| strong="H7586" \w* [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} it, [he will kill]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”} me. And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [an heifer]{strong=“H5697 H1241”} \w with thee| strong="H3027" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [I am come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8800”} to the \sc Lord\sc*.\f + \fr 16:2 \ft with thee: Heb. in thine hand \f* 
\v 3 [And call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w Jesse| strong="H3448" \w* \w to the sacrifice| strong="H2077" \w*, [and I will shew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8686”} [thee what thou shalt do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}: [and thou shalt anoint]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8804”} unto me him [whom I name]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto thee. 
\v 4 \w And Samuel| strong="H8050" \w* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} that which the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [to Beth-lehem]{strong=“H1035”}. \w And the elders| strong="H2205" \w* \w of the town| strong="H5892" \w* [trembled ]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8799”} [at his coming]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Comest]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w thou peaceably| strong="H7965" \w*?\f + \fr 16:4 \ft coming: Heb. meeting \f* 
\v 5 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Peaceably| strong="H7965" \w*: [I am come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8800”} unto the \sc Lord\sc*: [sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8690”} [yourselves, and come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w with me to the sacrifice| strong="H2077" \w*. [And he sanctified]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8762”} \w Jesse| strong="H3448" \w* \w and his sons| strong="H1121" \w*, [and called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w them to the sacrifice| strong="H2077" \w*. 
\p
