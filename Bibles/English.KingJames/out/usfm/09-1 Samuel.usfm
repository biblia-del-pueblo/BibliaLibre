\v 21 \w Now David| strong="H1732" \w* [had said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Surely in vain| strong="H8267" \w* [have I kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w all that this| strong="H2088" \w* fellow \w hath in the wilderness| strong="H4057" \w*, \w so that nothing| strong="H3972" \w* [was missed]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8738”} of all that pertained [unto him: and he hath requited]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w me evil| strong="H7451" \w* \w for good| strong="H2896" \w*. 
\v 22 \w So| strong="H3541" \w* [and more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [also do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w God| strong="H430" \w* [unto the enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w of David| strong="H1732" \w*, [if I leave]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8686”} of all that pertain \w to him by| strong="H5704" \w* \w the morning| strong="H1242" \w* \w light| strong="H216" \w* [any that pisseth]{strong=“H8366” x-morph=“strongMorph: \sc Th\sc*8688”} \w against the wall| strong="H7023" \w*. 
\v 23 \w And when Abigail| strong="H26" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w David| strong="H1732" \w*, [she hasted]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8762”}, [and lighted off]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w the ass| strong="H2543" \w*, [and fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H639" \w* \w David| strong="H1732" \w* \w on her face| strong="H6440" \w*, [and bowed]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} \w herself to the ground| strong="H776" \w*, 
