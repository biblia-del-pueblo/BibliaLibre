\p
\v 9 \w And Samuel| strong="H8050" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a| strong="H259" \w* \w sucking| strong="H2461" \w* \w lamb| strong="H2924" \w*, [and offered]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} it for \w a burnt offering| strong="H5930" \w* \w wholly| strong="H3632" \w* unto the \sc Lord\sc*: \w and Samuel| strong="H8050" \w* [cried]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc* \w for Israel| strong="H3478" \w*; and the \sc Lord\sc* [heard]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} him.\f + \fr 7:9 \ft heard: or, answered \f* 
\v 10 \w And as Samuel| strong="H8050" \w* [was offering up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8688”} \w the burnt offering| strong="H5930" \w*, \w the Philistines| strong="H6430" \w* [drew near]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8738”} \w to battle| strong="H4421" \w* \w against Israel| strong="H3478" \w*: but the \sc Lord\sc* [thundered]{strong=“H7481” x-morph=“strongMorph: \sc Th\sc*8686”} \w with a great| strong="H1419" \w* \w thunder| strong="H6963" \w* \w on that day| strong="H3117" \w* \w upon the Philistines| strong="H6430" \w*, [and discomfited]{strong=“H2000” x-morph=“strongMorph: \sc Th\sc*8799”} [them; and they were smitten]{strong=“H5062” x-morph=“strongMorph: \sc Th\sc*8735”} \w before| strong="H6440" \w* \w Israel| strong="H3478" \w*. 
\v 11 \w And the men| strong="H582" \w* \w of Israel| strong="H3478" \w* [went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w of Mizpeh| strong="H4709" \w*, [and pursued]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} \w the Philistines| strong="H6430" \w*, [and smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} them, until they came [under Beth-car]{strong=“H1033”}. 
\v 12 \w Then Samuel| strong="H8050" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a| strong="H259" \w* \w stone| strong="H68" \w*, [and set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} it \w between Mizpeh| strong="H4709" \w* \w and Shen| strong="H8129" \w*, [and called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w the name| strong="H8034" \w* [of it Eben-ezer]{strong=“H72”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Hitherto hath the \sc Lord\sc* [helped]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8804”} us.\f + \fr 7:12 \ft Eben-ezer: that is, The stone of help \f* 
\p
\v 13 \w So the Philistines| strong="H6430" \w* [were subdued]{strong=“H3665” x-morph=“strongMorph: \sc Th\sc*8735”}, [and they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [no more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the coast| strong="H1366" \w* \w of Israel| strong="H3478" \w*: \w and the hand| strong="H3027" \w* of the \sc Lord\sc* \w was against the Philistines| strong="H6430" \w* \w all the days| strong="H3117" \w* \w of Samuel| strong="H8050" \w*. 
\v 14 \w And the cities| strong="H5892" \w* \w which the Philistines| strong="H6430" \w* [had taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w from Israel| strong="H3478" \w* [were restored]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Israel| strong="H3478" \w*, \w from Ekron| strong="H6138" \w* \w even unto Gath| strong="H1661" \w*; \w and the coasts| strong="H1366" \w* \w thereof did Israel| strong="H3478" \w* [deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w out of the hands| strong="H3027" \w* \w of the Philistines| strong="H6430" \w*. \w And there was peace| strong="H7965" \w* \w between Israel| strong="H3478" \w* \w and the Amorites| strong="H567" \w*. 
\v 15 \w And Samuel| strong="H8050" \w* [judged]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w Israel| strong="H3478" \w* \w all the days| strong="H3117" \w* \w of his life| strong="H2416" \w*. 
\v 16 [And he went]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w from| strong="H1767" \w* \w year| strong="H8141" \w* \w to year| strong="H8141" \w* [in circuit]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8804”} [to Beth-el]{strong=“H1008”}, \w and Gilgal| strong="H1537" \w*, \w and Mizpeh| strong="H4709" \w*, [and judged]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8804”} \w Israel| strong="H3478" \w* \w in all those places| strong="H4725" \w*.\f + \fr 7:16 \ft in circuit: Heb. and he circuited \f* 
\v 17 \w And his return| strong="H8666" \w* was \w to Ramah| strong="H7414" \w*; for there was \w his house| strong="H1004" \w*; [and there he judged]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8804”} \w Israel| strong="H3478" \w*; [and there he built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w an altar| strong="H4196" \w* unto the \sc Lord\sc*.
\c 8
\p 
\v 1 [And it came to pass, when Samuel]{strong=“H8050”} [was old]{strong=“H2204” x-morph=“strongMorph: \sc Th\sc*8804”}, [that he made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w his sons| strong="H1121" \w* [judges]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} \w over Israel| strong="H3478" \w*. 
\v 2 \w Now the name| strong="H8034" \w* [of his firstborn]{strong=“H1060 H1121”} \w was Joel| strong="H3100" \w*; \w and the name| strong="H8034" \w* \w of his second| strong="H4932" \w*, \w Abiah| strong="H29" \w*: they were [judges]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} [in Beer-sheba]{strong=“H884”}. 
\v 3 \w And his sons| strong="H1121" \w* [walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w not in his ways| strong="H1870" \w*, [but turned aside]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w lucre| strong="H1215" \w*, [and took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w bribes| strong="H7810" \w*, [and perverted]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w judgment| strong="H4941" \w*. 
\p
\v 4 \w Then all the elders| strong="H2205" \w* \w of Israel| strong="H3478" \w* [gathered themselves together]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8691”}, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Samuel| strong="H8050" \w* \w unto Ramah| strong="H7414" \w*, 
\v 5 [And said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Behold, thou art old]{strong=“H2204” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and thy sons| strong="H1121" \w* [walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w not in thy ways| strong="H1870" \w*: [now make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} \w us a king| strong="H4428" \w* [to judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8800”} \w us like all the nations| strong="H1471" \w*. 
\p
\v 6 \w But the thing| strong="H1697" \w* [displeased ]{strong=“H5869 H3415” x-morph=“strongMorph: \sc Th\sc*8799”} \w Samuel| strong="H8050" \w*, [when they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w us a king| strong="H4428" \w* [to judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8800”} [us. And Samuel]{strong=“H8050”} [prayed ]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8691”} unto the \sc Lord\sc*.\f + \fr 8:6 \ft displeased: Heb. was evil in the eyes of \f* 
\v 7 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Samuel| strong="H8050" \w*, [Hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto the voice| strong="H6963" \w* \w of the people| strong="H5971" \w* [in all that they say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee: for they have not rejected]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, but they have rejected]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} [me, that I should not reign]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8800”} over them. 
\v 8 \w According to all the works| strong="H4639" \w* [which they have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w since the day| strong="H3117" \w* [that I brought them up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8687”} \w out of Egypt| strong="H4714" \w* \w even unto this day| strong="H3117" \w*, [wherewith they have forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} [me, and served]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} \w other| strong="H312" \w* \w gods| strong="H430" \w*, [so do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} they also unto thee. 
\v 9 [Now therefore hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto their voice| strong="H6963" \w*: \w howbeit| strong="H389" \w* [yet protest]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8686”} [solemnly]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8687”} [unto them, and shew]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} \w them the manner| strong="H4941" \w* \w of the king| strong="H4428" \w* [that shall reign]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8799”} over them.\f + \fr 8:9 \ft hearken…: or, obey \f* \f + \fr 8:9 \ft howbeit…: or, notwithstanding when thou hast solemnly protested against them then thou shalt \f* 
\p
\v 10 \w And Samuel| strong="H8050" \w* [told]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the words| strong="H1697" \w* of the \sc Lord\sc* \w unto the people| strong="H5971" \w* [that asked]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8802”} \w of him a king| strong="H4428" \w*. 
\v 11 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w This will be the manner| strong="H4941" \w* \w of the king| strong="H4428" \w* [that shall reign]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8799”} [over you: He will take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w your sons| strong="H1121" \w*, [and appoint]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} them [for himself, for his chariots]{strong=“H4818”}, and to be \w his horsemen| strong="H6571" \w*; and some [shall run]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* \w his chariots| strong="H4818" \w*. 
\v 12 [And he will appoint]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w him captains| strong="H8269" \w* \w over thousands| strong="H505" \w*, \w and captains| strong="H8269" \w* \w over fifties| strong="H2572" \w*; and will set them [to ear]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8800”} \w his ground| strong="H2758" \w*, [and to reap]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8800”} \w his harvest| strong="H7105" \w*, [and to make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w his instruments| strong="H3627" \w* \w of war| strong="H4421" \w*, \w and instruments| strong="H3627" \w* \w of his chariots| strong="H7393" \w*. 
\v 13 [And he will take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w your daughters| strong="H1323" \w* to be \w confectionaries| strong="H7548" \w*, and to be \w cooks| strong="H2879" \w*, and to be [bakers]{strong=“H644” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 14 [And he will take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w your fields| strong="H7704" \w*, \w and your vineyards| strong="H3754" \w*, \w and your oliveyards| strong="H2132" \w*, even \w the best| strong="H2896" \w* of them, [and give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} them \w to his servants| strong="H5650" \w*. 
\v 15 [And he will take the tenth]{strong=“H6237” x-morph=“strongMorph: \sc Th\sc*8799”} \w of your seed| strong="H2233" \w*, \w and of your vineyards| strong="H3754" \w*, [and give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w to his officers| strong="H5631" \w*, \w and to his servants| strong="H5650" \w*.\f + \fr 8:15 \ft officers: Heb. eunuchs \f* 
\v 16 [And he will take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w your menservants| strong="H5650" \w*, \w and your maidservants| strong="H8198" \w*, \w and your goodliest| strong="H2896" \w* \w young men| strong="H970" \w*, \w and your asses| strong="H2543" \w*, [and put]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} them \w to his work| strong="H4399" \w*. 
\v 17 [He will take the tenth]{strong=“H6237” x-morph=“strongMorph: \sc Th\sc*8799”} \w of your sheep| strong="H6629" \w*: \w and ye shall be his servants| strong="H5650" \w*. 
\v 18 [And ye shall cry out]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8804”} \w in that day| strong="H3117" \w* \w because| strong="H6440" \w* \w of your king| strong="H4428" \w* [which ye shall have chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} you; and the \sc Lord\sc* [will not hear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w you in that day| strong="H3117" \w*. 
\p
\v 19 \w Nevertheless the people| strong="H5971" \w* [refused]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8762”} [to obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w the voice| strong="H6963" \w* \w of Samuel| strong="H8050" \w*; [and they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Nay; but we will have a king]{strong=“H4428”} over us; 
\v 20 \w That we also may be like all the nations| strong="H1471" \w*; \w and that our king| strong="H4428" \w* [may judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8804”} [us, and go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* [us, and fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8738”} \w our battles| strong="H4421" \w*. 
\v 21 \w And Samuel| strong="H8050" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the words| strong="H1697" \w* \w of the people| strong="H5971" \w*, [and he rehearsed]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w them in the ears| strong="H241" \w* of the \sc Lord\sc*. 
\v 22 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Samuel| strong="H8050" \w*, [Hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto their voice| strong="H6963" \w*, [and make]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8689”} \w them a king| strong="H4428" \w*. \w And Samuel| strong="H8050" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the men| strong="H582" \w* \w of Israel| strong="H3478" \w*, [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye every man| strong="H376" \w* \w unto his city| strong="H5892" \w*. 
\c 9
\p 
\v 1 \w Now there was a man| strong="H376" \w* \w of Benjamin| strong="H1144" \w*, \w whose name| strong="H8034" \w* was \w Kish| strong="H7027" \w*, \w the son| strong="H1121" \w* \w of Abiel| strong="H22" \w*, \w the son| strong="H1121" \w* \w of Zeror| strong="H6872" \w*, \w the son| strong="H1121" \w* \w of Bechorath| strong="H1064" \w*, \w the son| strong="H1121" \w* \w of Aphiah| strong="H647" \w*, \w a Benjamite| strong="H1145" \w*, \w a mighty| strong="H1368" \w* \w man| strong="H376" \w* \w of power| strong="H2428" \w*.\f + \fr 9:1 \ft a Benjamite: or, the son of a man of Jemini \f* \f + \fr 9:1 \ft power: or, substance \f* 
\v 2 \w And he had a son| strong="H1121" \w*, \w whose name| strong="H8034" \w* was \w Saul| strong="H7586" \w*, \w a choice young man| strong="H970" \w*, \w and a goodly| strong="H2896" \w*: and there was \w not among the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* \w a goodlier| strong="H2896" \w* \w person| strong="H376" \w* [than he: from his shoulders]{strong=“H7926”} \w and upward| strong="H4605" \w* he was \w higher| strong="H1364" \w* \w than any of the people| strong="H5971" \w*. 
\p
\v 3 \w And the asses| strong="H860" \w* \w of Kish| strong="H7027" \w* [Saul’s]{strong=“H7586”} \w father| strong="H1" \w* [were lost]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}. \w And Kish| strong="H7027" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Saul| strong="H7586" \w* \w his son| strong="H1121" \w*, [Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w now one| strong="H259" \w* \w of the servants| strong="H5288" \w* [with thee, and arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} [seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8761”} \w the asses| strong="H860" \w*. 
\v 4 [And he passed through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w mount| strong="H2022" \w* \w Ephraim| strong="H669" \w*, [and passed through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w the land| strong="H776" \w* \w of Shalisha| strong="H8031" \w*, [but they found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} them [not: then they passed through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w the land| strong="H776" \w* \w of Shalim| strong="H8171" \w*, and there they were [not: and he passed through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w the land| strong="H776" \w* \w of the Benjamites| strong="H1145" \w*, [but they found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} them not. 
\v 5 And [when they were come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the land| strong="H776" \w* \w of Zuph| strong="H6689" \w*, \w Saul| strong="H7586" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w to his servant| strong="H5288" \w* that was [with him, Come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [and let us return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}; \w lest my father| strong="H1" \w* [leave]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8799”} caring \w for the asses| strong="H860" \w*, [and take thought]{strong=“H1672” x-morph=“strongMorph: \sc Th\sc*8804”} for us. 
\v 6 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, Behold now, there is \w in this city| strong="H5892" \w* \w a man| strong="H376" \w* \w of God| strong="H430" \w*, and he is [an honourable]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8737”} \w man| strong="H376" \w*; [all that he saith]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [surely to pass]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}: [now let us go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [thither; peradventure he can shew]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w us our way| strong="H1870" \w* [that we should go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 7 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Saul| strong="H7586" \w* \w to his servant| strong="H5288" \w*, But, behold, if [we go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [what shall we bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w the man| strong="H376" \w*? \w for the bread| strong="H3899" \w* [is spent]{strong=“H235” x-morph=“strongMorph: \sc Th\sc*8804”} \w in our vessels| strong="H3627" \w*, and there is \w not a present| strong="H8670" \w* [to bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} \w to the man| strong="H376" \w* \w of God| strong="H430" \w*: what have we?\f + \fr 9:7 \ft is spent…: Heb. is gone out of, etc \f* \f + \fr 9:7 \ft have we: Heb. is with us? \f* 
\v 8 \w And the servant| strong="H5288" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8800”} \w Saul| strong="H7586" \w* [again]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Behold, I have]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8738”} \w here at hand| strong="H3027" \w* \w the fourth part| strong="H7253" \w* \w of a shekel| strong="H8255" \w* \w of silver| strong="H3701" \w*: that [will I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the man| strong="H376" \w* \w of God| strong="H430" \w*, [to tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} \w us our way| strong="H1870" \w*.\f + \fr 9:8 \ft I have…: Heb. there is found in my hand \f* 
\v 9 (\w Beforetime| strong="H6440" \w* \w in Israel| strong="H3478" \w*, \w when a man| strong="H376" \w* [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} [to enquire]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8800”} \w of God| strong="H430" \w*, [thus he spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [and let us go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [to the seer]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”}: for he that is \w now| strong="H3117" \w* called \w a Prophet| strong="H5030" \w* \w was beforetime| strong="H6440" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8735”} [a Seer]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”}.) 
\v 10 \w Then said| strong="H1697" \w* \w Saul| strong="H7586" \w* \w to his servant| strong="H5288" \w*, \w Well| strong="H2896" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}; [come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [let us go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}. [So they went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the city| strong="H5892" \w* \w where the man| strong="H376" \w* \w of God| strong="H430" \w* was.\f + \fr 9:10 \ft Well said: Heb. Thy word is good \f* 
\p
\v 11 And [as they went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8802”} \w the hill| strong="H4608" \w* \w to the city| strong="H5892" \w*, [they found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w young maidens| strong="H5291" \w* [going out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} [to draw]{strong=“H7579” x-morph=“strongMorph: \sc Th\sc*8800”} \w water| strong="H4325" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Is]{strong=“H3426”} [the seer]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} here?\f + \fr 9:11 \ft the hill…: Heb. in the ascent of the city \f* 
\v 12 [And they answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w He is| strong="H3426" \w*; behold, he is \w before| strong="H6440" \w* [you: make haste]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8761”} [now, for he came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w to day| strong="H3117" \w* \w to the city| strong="H5892" \w*; for there is \w a sacrifice| strong="H2077" \w* \w of the people| strong="H5971" \w* \w to day| strong="H3117" \w* \w in the high place| strong="H1116" \w*:\f + \fr 9:12 \ft sacrifice: or, feast \f* 
\v 13 [As soon as ye be come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w into the city| strong="H5892" \w*, \w ye shall straightway| strong="H3651" \w* [find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} [him, before he go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the high place| strong="H1116" \w* [to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”}: \w for the people| strong="H5971" \w* [will not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [until he come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}, [because he doth bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w the sacrifice| strong="H2077" \w*; and [afterwards]{strong=“H3651 H310”} [they eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [that be bidden]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8803”}. [Now therefore get you up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”}; \w for about this time| strong="H3117" \w* [ye shall find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} him.\f + \fr 9:13 \ft this time: Heb. to day \f* 
\v 14 [And they went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w into| strong="H8432" \w* \w the city| strong="H5892" \w*: and [when they were come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w into the city| strong="H5892" \w*, [behold, Samuel]{strong=“H8050”} [came out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} [against]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} [them, for to go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8800”} \w to the high place| strong="H1116" \w*. 
\p
\v 15 Now the \sc Lord\sc* [had told]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8804”} \w Samuel| strong="H8050" \w* \w in his ear| strong="H241" \w* \w a| strong="H259" \w* \w day| strong="H3117" \w* \w before| strong="H6440" \w* \w Saul| strong="H7586" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”},\f + \fr 9:15 \ft told…: Heb. revealed the ear of Samuel \f* 
