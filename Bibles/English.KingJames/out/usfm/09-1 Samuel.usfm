\c 2
\p 
\v 1 \w And Hannah| strong="H2584" \w* [prayed]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8691”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w My heart| strong="H3820" \w* [rejoiceth]{strong=“H5970” x-morph=“strongMorph: \sc Th\sc*8804”} in the \sc Lord\sc*, \w mine horn| strong="H7161" \w* [is exalted]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8804”} in the \sc Lord\sc*: \w my mouth| strong="H6310" \w* [is enlarged]{strong=“H7337” x-morph=“strongMorph: \sc Th\sc*8804”} [over mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}; [because I rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thy salvation| strong="H3444" \w*. 
\v 2 There is \w none holy| strong="H6918" \w* as the \sc Lord\sc*: for there is \w none beside| strong="H1115" \w* thee: neither is there \w any rock| strong="H6697" \w* \w like our God| strong="H430" \w*. 
\v 3 [Talk]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [no more]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} \w so exceeding| strong="H1364" \w* \w proudly| strong="H1364" \w*; let not \w arrogancy| strong="H6277" \w* [come]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of your mouth| strong="H6310" \w*: for the \sc Lord\sc* is \w a God| strong="H410" \w* \w of knowledge| strong="H1844" \w*, \w and by him actions| strong="H5949" \w* [are weighed]{strong=“H8505” x-morph=“strongMorph: \sc Th\sc*8738”}.\f + \fr 2:3 \ft arrogancy: Heb. hard \f* 
\v 4 \w The bows| strong="H7198" \w* \w of the mighty men| strong="H1368" \w* are \w broken| strong="H2844" \w*, [and they that stumbled]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8737”} [are girded]{strong=“H247” x-morph=“strongMorph: \sc Th\sc*8804”} \w with strength| strong="H2428" \w*. 
\v 5 They that were \w full| strong="H7649" \w* [have hired out]{strong=“H7936” x-morph=“strongMorph: \sc Th\sc*8738”} \w themselves for bread| strong="H3899" \w*; and they that were \w hungry| strong="H7457" \w* [ceased]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8804”}: \w so that the barren| strong="H6135" \w* [hath born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} \w seven| strong="H7651" \w*; \w and she that hath many| strong="H7227" \w* \w children| strong="H1121" \w* [is waxed feeble]{strong=“H535” x-morph=“strongMorph: \sc Th\sc*8797”}. 
