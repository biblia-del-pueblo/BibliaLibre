\c 3
\p 
\v 1 \w And the child| strong="H5288" \w* \w Samuel| strong="H8050" \w* [ministered]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8764”} unto the \sc Lord\sc* \w before| strong="H6440" \w* \w Eli| strong="H5941" \w*. \w And the word| strong="H1697" \w* of the \sc Lord\sc* \w was precious| strong="H3368" \w* \w in those days| strong="H3117" \w*; there was [no open]{strong=“H6555” x-morph=“strongMorph: \sc Th\sc*8737”} \w vision| strong="H2377" \w*. 
\v 2 \w And it came to pass at that time| strong="H3117" \w*, \w when Eli| strong="H5941" \w* was [laid down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8802”} \w in his place| strong="H4725" \w*, \w and his eyes| strong="H5869" \w* [began]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8689”} \w to wax dim| strong="H3544" \w*, that [he could]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [not see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”}; 
\v 3 \w And ere the lamp| strong="H5216" \w* \w of God| strong="H430" \w* [went out]{strong=“H3518” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the temple| strong="H1964" \w* of the \sc Lord\sc*, \w where the ark| strong="H727" \w* \w of God| strong="H430" \w* was, \w and Samuel| strong="H8050" \w* [was laid down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8802”} to sleep; 
\v 4 That the \sc Lord\sc* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w Samuel| strong="H8050" \w*: [and he answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Here am I. 
\v 5 [And he ran]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Eli| strong="H5941" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Here am \w I| strong="H2009" \w*; [for thou calledst]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [me. And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [not; lie down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8798”} [again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”}. [And he went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [and lay down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 6 And the \sc Lord\sc* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8800”} [yet again]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”}, \w Samuel| strong="H8050" \w*. \w And Samuel| strong="H8050" \w* [arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} [and went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Eli| strong="H5941" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Here am [I; for thou didst call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [me. And he answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [not, my son]{strong=“H1121”}; [lie down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8798”} [again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”}. 
\v 7 \w Now Samuel| strong="H8050" \w* \w did not yet| strong="H2962" \w* [know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w neither was the word| strong="H1697" \w* of the \sc Lord\sc* [yet revealed]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8735”} unto him.^\sc 3:7 Now…: or, Thus did Samuel before he knew the [Lord\sc*, and before the word of the \sc Lord\sc* was revealed unto him] 
\v 8 And the \sc Lord\sc* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8800”} \w Samuel| strong="H8050" \w* [again]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w the third time| strong="H7992" \w*. [And he arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} [and went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Eli| strong="H5941" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Here am [I; for thou didst call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [me. And Eli]{strong=“H5941”} [perceived]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} that the \sc Lord\sc* [had called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8802”} \w the child| strong="H5288" \w*. 
\v 9 \w Therefore Eli| strong="H5941" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Samuel| strong="H8050" \w*, [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [lie down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8798”}: [and it shall be, if he call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} [thee, that thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”}, \sc Lord\sc*; \w for thy servant| strong="H5650" \w* [heareth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”}. \w So Samuel| strong="H8050" \w* [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [and lay down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his place| strong="H4725" \w*. 
\v 10 And the \sc Lord\sc* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [and stood]{strong=“H3320” x-morph=“strongMorph: \sc Th\sc*8691”}, [and called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w as at other times| strong="H6471" \w*, \w Samuel| strong="H8050" \w*, \w Samuel| strong="H8050" \w*. \w Then Samuel| strong="H8050" \w* [answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”}; \w for thy servant| strong="H5650" \w* [heareth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\p
\v 11 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Samuel| strong="H8050" \w*, [Behold, I will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w a thing| strong="H1697" \w* \w in Israel| strong="H3478" \w*, \w at which both| strong="H8147" \w* \w the ears| strong="H241" \w* [of every one that heareth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} [it shall tingle]{strong=“H6750” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 12 \w In that day| strong="H3117" \w* [I will perform]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8686”} \w against Eli| strong="H5941" \w* all things [which I have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w concerning| strong="H413" \w* \w his house| strong="H1004" \w*: [when I begin]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8687”}, [I will also make an end]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8763”}.\f + \fr 3:12 \ft when…: Heb. beginning and ending \f* 
\v 13 [For I have told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} [him that I will judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} \w his house| strong="H1004" \w* \w for| strong="H5704" \w* \w ever| strong="H5769" \w* \w for the iniquity| strong="H5771" \w* [which he knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}; \w because his sons| strong="H1121" \w* [made themselves vile]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8764”}, [and he restrained]{strong=“H3543” x-morph=“strongMorph: \sc Th\sc*8765”} them not.\f + \fr 3:13 \ft For I…: or, And I will tell him \f* \f + \fr 3:13 \ft vile: or, accursed \f* \f + \fr 3:13 \ft restrained…: Heb. frowned not upon them \f* 
\v 14 [And therefore I have sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto the house| strong="H1004" \w* \w of Eli| strong="H5941" \w*, \w that the iniquity| strong="H5771" \w* [of Eli’s]{strong=“H5941”} \w house| strong="H1004" \w* [shall not be purged]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8691”} \w with sacrifice| strong="H2077" \w* \w nor offering| strong="H4503" \w* \w for| strong="H5704" \w* \w ever| strong="H5769" \w*. 
\p
\v 15 \w And Samuel| strong="H8050" \w* [lay]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w until the morning| strong="H1242" \w*, [and opened]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} \w the doors| strong="H1817" \w* \w of the house| strong="H1004" \w* of the \sc Lord\sc*. \w And Samuel| strong="H8050" \w* [feared]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8804”} [to shew]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8687”} \w Eli| strong="H5941" \w* \w the vision| strong="H4759" \w*. 
\v 16 \w Then Eli| strong="H5941" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w Samuel| strong="H8050" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Samuel| strong="H8050" \w*, \w my son| strong="H1121" \w*. [And he answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Here am I. 
\v 17 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, What is \w the thing| strong="H1697" \w* that the Lord [hath said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [unto thee? I pray thee hide]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8762”} it [not from me: God]{strong=“H430”} [do so]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [to thee, and more also]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”}, [if thou hide]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8762”} any \w thing| strong="H1697" \w* \w from me of all the things| strong="H1697" \w* [that he said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} unto thee.\f + \fr 3:17 \ft more also: Heb. so add \f* \f + \fr 3:17 \ft thing: or, word \f* 
\v 18 \w And Samuel| strong="H8050" \w* [told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w him every whit| strong="H1697" \w*, [and hid]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8765”} [nothing from him. And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, It is the \sc Lord\sc*: [let him do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w what seemeth| strong="H5869" \w* \w him good| strong="H2896" \w*.\f + \fr 3:18 \ft every…: Heb. all the things, or, words \f* 
\p
\v 19 \w And Samuel| strong="H8050" \w* [grew]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8799”}, and the \sc Lord\sc* [was with him, and did let none of his words]{strong=“H1697”} [fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8689”} \w to the ground| strong="H776" \w*. 
\v 20 \w And all Israel| strong="H3478" \w* \w from Dan| strong="H1835" \w* [even to Beer-sheba]{strong=“H884”} [knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w that Samuel| strong="H8050" \w* was [established ]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8737”} to be \w a prophet| strong="H5030" \w* of the \sc Lord\sc*.\f + \fr 3:20 \ft established: or, faithful \f* 
\v 21 And the \sc Lord\sc* [appeared ]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8736”} [again]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w in Shiloh| strong="H7887" \w*: for the \sc Lord\sc* [revealed]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8738”} \w himself to Samuel| strong="H8050" \w* \w in Shiloh| strong="H7887" \w* \w by the word| strong="H1697" \w* of the \sc Lord\sc*.
\c 4
\p 
\v 1 \w And the word| strong="H1697" \w* \w of Samuel| strong="H8050" \w* \w came to all Israel| strong="H3478" \w*. \w Now Israel| strong="H3478" \w* [went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} [against]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} \w the Philistines| strong="H6430" \w* \w to battle| strong="H4421" \w*, [and pitched]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8799”} [beside Eben-ezer]{strong=“H72”}: \w and the Philistines| strong="H6430" \w* [pitched]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8804”} \w in Aphek| strong="H663" \w*.\f + \fr 4:1 \ft came: or, came to pass: Heb. was \f* 
\v 2 \w And the Philistines| strong="H6430" \w* [put themselves in array]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8799”} [against]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} \w Israel| strong="H3478" \w*: [and when they joined]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8799”} \w battle| strong="H4421" \w*, \w Israel| strong="H3478" \w* [was smitten]{strong=“H5062” x-morph=“strongMorph: \sc Th\sc*8735”} \w before| strong="H6440" \w* \w the Philistines| strong="H6430" \w*: [and they slew]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w of the army| strong="H4634" \w* \w in the field| strong="H7704" \w* \w about four| strong="H702" \w* \w thousand| strong="H505" \w* \w men| strong="H376" \w*.\f + \fr 4:2 \ft they joined…: Heb. the battle was spread \f* \f + \fr 4:2 \ft army: Heb. array \f* 
\p
\v 3 \w And when the people| strong="H5971" \w* [were come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the camp| strong="H4264" \w*, \w the elders| strong="H2205" \w* \w of Israel| strong="H3478" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Wherefore hath the \sc Lord\sc* [smitten]{strong=“H5062” x-morph=“strongMorph: \sc Th\sc*8804”} \w us to day| strong="H3117" \w* \w before| strong="H6440" \w* \w the Philistines| strong="H6430" \w*? [Let us fetch]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the ark| strong="H727" \w* \w of the covenant| strong="H1285" \w* of the \sc Lord\sc* \w out of Shiloh| strong="H7887" \w* [unto us, that, when it cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w among| strong="H7130" \w* [us, it may save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} \w us out of the hand| strong="H3709" \w* [of our enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 4:3 \ft fetch: Heb. take unto us \f* 
\v 4 \w So the people| strong="H5971" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Shiloh| strong="H7887" \w*, [that they might bring]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w from thence the ark| strong="H727" \w* \w of the covenant| strong="H1285" \w* of the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [which dwelleth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} between \w the cherubims| strong="H3742" \w*: \w and the two| strong="H8147" \w* \w sons| strong="H1121" \w* \w of Eli| strong="H5941" \w*, \w Hophni| strong="H2652" \w* \w and Phinehas| strong="H6372" \w*, were \w there with the ark| strong="H727" \w* \w of the covenant| strong="H1285" \w* \w of God| strong="H430" \w*. 
\v 5 \w And when the ark| strong="H727" \w* \w of the covenant| strong="H1285" \w* of the \sc Lord\sc* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w into the camp| strong="H4264" \w*, \w all Israel| strong="H3478" \w* [shouted]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8686”} \w with a great| strong="H1419" \w* \w shout| strong="H8643" \w*, \w so that the earth| strong="H776" \w* [rang again]{strong=“H1949” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 6 \w And when the Philistines| strong="H6430" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w the noise| strong="H6963" \w* \w of the shout| strong="H8643" \w*, [they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, What meaneth \w the noise| strong="H6963" \w* \w of this great| strong="H1419" \w* \w shout| strong="H8643" \w* \w in the camp| strong="H4264" \w* \w of the Hebrews| strong="H5680" \w*? [And they understood]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w that the ark| strong="H727" \w* of the \sc Lord\sc* [was come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the camp| strong="H4264" \w*. 
\v 7 \w And the Philistines| strong="H6430" \w* [were afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}, [for they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w God| strong="H430" \w* [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the camp| strong="H4264" \w*. [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Woe| strong="H188" \w* [unto us! for there hath not been such a thing heretofore]{strong=“H8032 H865”}.\f + \fr 4:7 \ft heretofore: Heb. yesterday, or, the third day \f* 
\v 8 \w Woe| strong="H188" \w* [unto us! who shall deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w us out of the hand| strong="H3027" \w* \w of these mighty| strong="H117" \w* \w Gods| strong="H430" \w*? these are \w the Gods| strong="H430" \w* [that smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8688”} \w the Egyptians| strong="H4714" \w* \w with all the plagues| strong="H4347" \w* \w in the wilderness| strong="H4057" \w*. 
\v 9 [Be strong]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8690”}, [and quit]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8798”} \w yourselves like men| strong="H582" \w*, \w O ye Philistines| strong="H6430" \w*, [that ye be not servants]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the Hebrews| strong="H5680" \w*, [as they have been]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} [to you: quit]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8804”} \w yourselves like men| strong="H582" \w*, [and fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8738”}.\f + \fr 4:9 \ft quit…: Heb. be men \f* 
\p
\v 10 \w And the Philistines| strong="H6430" \w* [fought]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8735”}, \w and Israel| strong="H3478" \w* [was smitten]{strong=“H5062” x-morph=“strongMorph: \sc Th\sc*8735”}, [and they fled]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”} \w every man| strong="H376" \w* \w into his tent| strong="H168" \w*: \w and there was a very| strong="H3966" \w* \w great| strong="H1419" \w* \w slaughter| strong="H4347" \w*; [for there fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w of Israel| strong="H3478" \w* \w thirty| strong="H7970" \w* \w thousand| strong="H505" \w* \w footmen| strong="H7273" \w*. 
\v 11 \w And the ark| strong="H727" \w* \w of God| strong="H430" \w* [was taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8738”}; \w and the two| strong="H8147" \w* \w sons| strong="H1121" \w* \w of Eli| strong="H5941" \w*, \w Hophni| strong="H2652" \w* \w and Phinehas| strong="H6372" \w*, [were slain]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 4:11 \ft were slain: Heb. died \f* 
\p
