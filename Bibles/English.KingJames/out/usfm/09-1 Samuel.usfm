\v 25 \w Then Saul| strong="H7586" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to David| strong="H1732" \w*, [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} be [thou, my son]{strong=“H1121”} \w David| strong="H1732" \w*: [thou shalt both do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [great]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} things, [and also shalt still]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8800”} [prevail]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”}. \w So David| strong="H1732" \w* [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w on his way| strong="H1870" \w*, \w and Saul| strong="H7586" \w* [returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w to his place| strong="H4725" \w*. 
\c 27
\p 
\v 1 \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his heart| strong="H3820" \w*, [I shall now perish]{strong=“H5595” x-morph=“strongMorph: \sc Th\sc*8735”} \w one| strong="H259" \w* \w day| strong="H3117" \w* \w by the hand| strong="H3027" \w* \w of Saul| strong="H7586" \w*: there is \w nothing better| strong="H2896" \w* \w for me than that| strong="H3588" \w* [I should speedily]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8736”} [escape]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8735”} \w into the land| strong="H776" \w* \w of the Philistines| strong="H6430" \w*; \w and Saul| strong="H7586" \w* [shall despair]{strong=“H2976” x-morph=“strongMorph: \sc Th\sc*8738”} [of me, to seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8763”} \w me any more in any coast| strong="H1366" \w* \w of Israel| strong="H3478" \w*: [so shall I escape]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8738”} \w out of his hand| strong="H3027" \w*.\f + \fr 27:1 \ft perish: Heb. be consumed \f* 
