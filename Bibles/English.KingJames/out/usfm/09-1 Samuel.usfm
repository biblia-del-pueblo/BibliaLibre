\c 11
\p 
\v 1 \w Then Nahash| strong="H5176" \w* \w the Ammonite| strong="H5984" \w* [came up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”}, [and encamped]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8799”} [against Jabesh-gilead]{strong=“H1568 H3003”}: \w and all the men| strong="H582" \w* \w of Jabesh| strong="H3003" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Nahash| strong="H5176" \w*, [Make]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8798”} \w a covenant| strong="H1285" \w* [with us, and we will serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} thee. 
\v 2 \w And Nahash| strong="H5176" \w* \w the Ammonite| strong="H5984" \w* [answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [them, On this]{strong=“H2063”} condition [will I make]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} a covenant [with you, that I may thrust out]{strong=“H5365” x-morph=“strongMorph: \sc Th\sc*8800”} \w all your right| strong="H3225" \w* \w eyes| strong="H5869" \w*, [and lay]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} it for \w a reproach| strong="H2781" \w* \w upon all Israel| strong="H3478" \w*. 
\v 3 \w And the elders| strong="H2205" \w* \w of Jabesh| strong="H3003" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Give us seven]{strong=“H7651”} [days’]{strong=“H3117”} [respite]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8685”}, [that we may send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w messengers| strong="H4397" \w* \w unto all the coasts| strong="H1366" \w* \w of Israel| strong="H3478" \w*: and then, if there be [no man to save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8688”} [us, we will come out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} to thee.\f + \fr 11:3 \ft Give…: Heb. Forbear us \f* 
\p
