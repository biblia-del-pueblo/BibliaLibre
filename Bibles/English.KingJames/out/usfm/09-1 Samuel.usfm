\p
\v 12 [So David’s]{strong=“H1732”} \w young men| strong="H5288" \w* [turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8799”} \w their way| strong="H1870" \w*, [and went again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w him all those sayings| strong="H1697" \w*. 
