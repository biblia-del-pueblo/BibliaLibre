\c 1
\p 
\v 1 \w Now there was a certain| strong="H259" \w* \w man| strong="H376" \w* [of Ramathaim-zophim]{strong=“H7436”}, \w of mount| strong="H2022" \w* \w Ephraim| strong="H669" \w*, \w and his name| strong="H8034" \w* was \w Elkanah| strong="H511" \w*, \w the son| strong="H1121" \w* \w of Jeroham| strong="H3395" \w*, \w the son| strong="H1121" \w* \w of Elihu| strong="H453" \w*, \w the son| strong="H1121" \w* \w of Tohu| strong="H8459" \w*, \w the son| strong="H1121" \w* \w of Zuph| strong="H6689" \w*, \w an Ephrathite| strong="H673" \w*: 
