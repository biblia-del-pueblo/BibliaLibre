\c 3
\p 
\v 1 [There was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 1”} [a man]{strong=“G444” x-morph=“robinson: N-\sc Nsm\sc* 3”} [of]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 4”} [the Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 5 6”}, [named]{strong=“G3686” x-morph=“robinson: N-\sc Nsn\sc* 8”} [Nicodemus]{strong=“G3530” x-morph=“robinson: N-\sc Nsm\sc* 7”}, [a ruler]{strong=“G758” x-morph=“robinson: N-\sc Nsm\sc* 10”} [of the Jews]{strong=“G2453” x-morph=“robinson: A-\sc Gpm\sc* 12”}: 
\v 2 [The same]{strong=“G3778” x-morph=“robinson: D-\sc Nsm\sc* 1”} [came]{strong=“G2064” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”} [to]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 4 5”} [by night]{strong=“G3571” x-morph=“robinson: N-\sc Gsf\sc* 6”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 8”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 9”}, [Rabbi]{strong=“G4461” x-morph=“robinson: \sc Heb\sc* 10”}, [we know]{strong=“G1492” x-morph=“robinson: V-\sc Rai\sc*-1P 11”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 12”} [thou art]{strong=“G2064” x-morph=“robinson: V-2\sc Rai\sc*-2S 15”} [a teacher]{strong=“G1320” x-morph=“robinson: N-\sc Nsm\sc* 16”} [come]{strong=“G2064” x-morph=“robinson: V-2\sc Rai\sc*-2S 15”} [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 13”} [God]{strong=“G2316” x-morph=“robinson: N-\sc Gsm\sc* 14”}: [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 18”} [no man]{strong=“G3762” x-morph=“robinson: A-\sc Nsm\sc* 17”} [can]{strong=“G1410” x-morph=“robinson: V-\sc Pni\sc*-3S 22”} [do]{strong=“G4160” x-morph=“robinson: V-\sc Pan\sc* 23”} [these]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 19”} [miracles]{strong=“G3588 G4592” x-morph=“robinson: T-\sc Apn\sc* robinson: N-\sc Apn\sc* 20 21”} [that]{strong=“G3739” x-morph=“robinson: R-\sc Apn\sc* 24”} [thou]{strong=“G4771” x-morph=“robinson: P-2\sc Ns\sc* 25”} [doest]{strong=“G4160” x-morph=“robinson: V-\sc Pai\sc*-2S 26”}, [except]{strong=“G3361” x-morph=“robinson: \sc Prt\sc*-N 28”} [God]{strong=“G3588 G2316” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 30 31”} [be]{strong=“G5600” x-morph=“robinson: V-\sc Pxs\sc*-3S 29”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 32”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 33”}. 
\v 3 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 2 3”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 1”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 4”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 6”}, \wj Verily, verily, I say unto thee, Except a man be born again, he cannot see the kingdom of God.\wj* 
\v 4 [Nicodemus]{strong=“G3588 G3530” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 1”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 2”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 3”}, [How]{strong=“G4459” x-morph=“robinson: \sc Adv\sc*-I 6”} [can]{strong=“G1410” x-morph=“robinson: V-\sc Pni\sc*-3S 7”} [a man]{strong=“G444” x-morph=“robinson: N-\sc Nsm\sc* 8”} [be born]{strong=“G1080” x-morph=“robinson: V-\sc Apn\sc* 9”} [when he is]{strong=“G5607” x-morph=“robinson: V-\sc Pxp\sc*-\sc Nsm\sc* 11”} [old]{strong=“G1088” x-morph=“robinson: N-\sc Nsm\sc* 10”}? [can he]{strong=“G1410” x-morph=“robinson: V-\sc Pni\sc*-3S 13”} [enter]{strong=“G1525” x-morph=“robinson: V-2\sc Aan\sc* 21”} [the second time]{strong=“G1208” x-morph=“robinson: \sc Adv\sc* 20”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 14”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 19”} [mother’s]{strong=“G3588 G3384” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 17 18”} [womb]{strong=“G3588 G2836” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 15 16”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 22”} [be born]{strong=“G1080” x-morph=“robinson: V-\sc Apn\sc* 23”}? 
\v 5 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 2 3”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 1”}, \wj Verily, verily, I say unto thee, Except a man be born of water and of the Spirit, he cannot enter into the kingdom of God.\wj* 
\v 6 \wj That which is born of the flesh is flesh; and that which is born of the Spirit is spirit.\wj* 
\v 7 \wj Marvel not that I said unto thee, Ye must be born again.\wj* 
\v 8 \wj The wind bloweth where it listeth, and thou hearest the sound thereof, but canst not tell whence it cometh, and whither it goeth: so is every one that is born of the Spirit.\wj* 
\v 9 [Nicodemus]{strong=“G3530” x-morph=“robinson: N-\sc Nsm\sc* 2”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 1”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 3”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 5”}, [How]{strong=“G4459” x-morph=“robinson: \sc Adv\sc*-I 6”} [can]{strong=“G1410” x-morph=“robinson: V-\sc Pni\sc*-3S 7”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Npn\sc* 8”} [be]{strong=“G1096” x-morph=“robinson: V-2\sc Adn\sc* 9”}? 
\v 10 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 2 3”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 1”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 4”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 6”}, \wj Art thou a master of Israel, and knowest not these things?\wj* 
\v 11 \wj Verily, verily, I say unto thee, We speak that we do know, and testify that we have seen; and ye receive not our witness.\wj* 
\v 12 \wj If I have told you earthly things, and ye believe not, how shall ye believe, if I tell you of heavenly things?\wj* 
\v 13 \wj And no man hath ascended up to heaven, but he that came down from heaven, even the Son of man which is in heaven.\wj* 
\p
\v 14 \wj And as Moses lifted up the serpent in the wilderness, even so must the Son of man be lifted up:\wj* 
\v 15 \wj That whosoever believeth in him should not perish, but have eternal life.\wj* 
\p
\v 16 \wj For God so loved the world, that he gave his only begotten Son, that whosoever believeth in him should not perish, but have everlasting life.\wj* 
\v 17 \wj For God sent not his Son into the world to condemn the world; but that the world through him might be saved.\wj* 
\p
\v 18 \wj He that believeth on him is not condemned: but he that believeth not is condemned already, because he hath not believed in the name of the only begotten Son of God.\wj* 
\v 19 \wj And this is the condemnation, that light is come into the world, and men loved darkness rather than light, because their deeds were evil.\wj* 
\v 20 \wj For every one that doeth evil hateth the light, neither cometh to the light, lest his deeds should be reproved.\wj* 
\v 21 \wj But he that doeth truth cometh to the light, that his deeds may be made manifest, that they are wrought in God.\wj* 
\p
\v 22 [After]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 1”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 2”} [came]{strong=“G2064” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 9”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 7 8”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 10”} [the land]{strong=“G1093” x-morph=“robinson: N-\sc Asf\sc* 13”} [of Judæa]{strong=“G2453” x-morph=“robinson: A-\sc Asf\sc* 12”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [there]{strong=“G1563” x-morph=“robinson: \sc Adv\sc* 15”} [he tarried]{strong=“G1304” x-morph=“robinson: V-\sc Iai\sc*-3S 16”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 17”} [them]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 18”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 19”} [baptized]{strong=“G907” x-morph=“robinson: V-\sc Iai\sc*-3S 20”}. 
