\v 11 [For]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 2”} [he knew]{strong=“G1492” x-morph=“robinson: V-\sc Lai\sc*-3S 1”} [who]{strong=“G3588” x-morph=“robinson: T-\sc Asm\sc* 3”} [should betray]{strong=“G3860” x-morph=“robinson: V-\sc Pap\sc*-\sc Asm\sc* 4”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 5”}; [therefore]{strong=“G1223” x-morph=“robinson: \sc Prep\sc* 6”} [said he]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 8”}, [Ye are]{strong=“G2075” x-morph=“robinson: V-\sc Pxi\sc*-2P 12”} [not]{strong=“G3780” x-morph=“robinson: \sc Prt\sc*-N 9”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Npm\sc* 10”} [clean]{strong=“G2513” x-morph=“robinson: A-\sc Npm\sc* 11”}. 
