\v 7 [The impotent man]{strong=“G770” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 4”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 1”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, [Sir]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 5”}, [I have]{strong=“G2192” x-morph=“robinson: V-\sc Pai\sc*-1S 8”} [no]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 7”} [man]{strong=“G444” x-morph=“robinson: N-\sc Asm\sc* 6”}, [when]{strong=“G3752” x-morph=“robinson: \sc Conj\sc* 10”} [the water]{strong=“G3588 G5204” x-morph=“robinson: T-\sc Nsn\sc* robinson: N-\sc Nsn\sc* 12 13”} [is troubled]{strong=“G5015” x-morph=“robinson: V-\sc Aps\sc*-3S 11”}, [to]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 9”} [put]{strong=“G906” x-morph=“robinson: V-\sc Pas\sc*-3S 14”} [me]{strong=“G3165” x-morph=“robinson: P-1\sc As\sc* 15”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 16”} [the pool]{strong=“G3588 G2861” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 17 18”}: [but]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 21”} [while]{strong=“G3739” x-morph=“robinson: R-\sc Dsm\sc* 20”} [I]{strong=“G1473” x-morph=“robinson: P-1\sc Ns\sc* 23”} [am coming]{strong=“G2064” x-morph=“robinson: V-\sc Pni\sc*-1S 22”}, [another]{strong=“G243” x-morph=“robinson: A-\sc Nsm\sc* 24”} [steppeth down]{strong=“G2597” x-morph=“robinson: V-\sc Pai\sc*-3S 27”} [before]{strong=“G4253” x-morph=“robinson: \sc Prep\sc* 25”} [me]{strong=“G1700” x-morph=“robinson: P-1\sc Gs\sc* 26”}. 
\v 8 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, \wj Rise, take up thy bed, and walk.\wj* 
\v 9 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [immediately]{strong=“G2112” x-morph=“robinson: \sc Adv\sc* 2”} [the man]{strong=“G3588 G444” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [was made]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 3”} [whole]{strong=“G5199” x-morph=“robinson: A-\sc Nsm\sc* 4”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [took up]{strong=“G142” x-morph=“robinson: V-\sc Aai\sc*-3S 8”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 11”} [bed]{strong=“G3588 G2895” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 9 10”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”} [walked]{strong=“G4043” x-morph=“robinson: V-\sc Iai\sc*-3S 13”}: [and]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 15”} [on]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 17”} [the same]{strong=“G1565” x-morph=“robinson: D-\sc Dsf\sc* 18”} [day]{strong=“G3588 G2250” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 19 20”} [was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 14”} [the sabbath]{strong=“G4521” x-morph=“robinson: N-\sc Nsn\sc* 16”}. 
\p
\v 10 [The Jews]{strong=“G2453” x-morph=“robinson: A-\sc Npm\sc* 4”} [therefore]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3P 1”} [unto him that was cured]{strong=“G2323” x-morph=“robinson: V-\sc Rpp\sc*-\sc Dsm\sc* 6”}, It [is]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 8”} [the sabbath day]{strong=“G4521” x-morph=“robinson: N-\sc Nsn\sc* 7”}: [it is]{strong=“G1832” x-morph=“robinson: V-\sc Pqi\sc*-3S 10”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 9”} [lawful]{strong=“G1832” x-morph=“robinson: V-\sc Pqi\sc*-3S 10”} [for thee]{strong=“G4671” x-morph=“robinson: P-2\sc Ds\sc* 11”} [to carry]{strong=“G142” x-morph=“robinson: V-\sc Aan\sc* 12”} thy [bed]{strong=“G3588 G2895” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 13 14”}. 
\v 11 [He answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 1”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 2”}, [He that made]{strong=“G4160” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 4”} [me]{strong=“G3165” x-morph=“robinson: P-1\sc As\sc* 5”} [whole]{strong=“G5199” x-morph=“robinson: A-\sc Asm\sc* 6”}, [the same]{strong=“G1565” x-morph=“robinson: D-\sc Nsm\sc* 7”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 9”} [unto me]{strong=“G3427” x-morph=“robinson: P-1\sc Ds\sc* 8”}, [Take up]{strong=“G142” x-morph=“robinson: V-\sc Aam\sc*-2S 10”} [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 13”} [bed]{strong=“G3588 G2895” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 11 12”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [walk]{strong=“G4043” x-morph=“robinson: V-\sc Pam\sc*-2S 15”}. 
\v 12 [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [asked they]{strong=“G2065” x-morph=“robinson: V-\sc Aai\sc*-3P 1”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 3”}, [What]{strong=“G5101” x-morph=“robinson: I-\sc Nsm\sc* 4”} [man]{strong=“G3588 G444” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 6 7”} [is]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 5”} [that which said]{strong=“G2036” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 9”} [unto thee]{strong=“G4671” x-morph=“robinson: P-2\sc Ds\sc* 10”}, [Take up]{strong=“G142” x-morph=“robinson: V-\sc Aam\sc*-2S 11”} [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 14”} [bed]{strong=“G3588 G2895” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 12 13”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 15”} [walk]{strong=“G4043” x-morph=“robinson: V-\sc Pam\sc*-2S 16”}? 
\v 13 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he that was healed]{strong=“G2390” x-morph=“robinson: V-\sc App\sc*-\sc Nsm\sc* 3”} [wist]{strong=“G1492” x-morph=“robinson: V-\sc Lai\sc*-3S 5”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 4”} [who]{strong=“G5101” x-morph=“robinson: I-\sc Nsm\sc* 6”} [it was]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 7”}: [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 9”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 10”} [had conveyed himself away]{strong=“G1593” x-morph=“robinson: V-\sc Aai\sc*-3S 11”}, [a multitude]{strong=“G3793” x-morph=“robinson: N-\sc Gsm\sc* 12”} [being]{strong=“G5607” x-morph=“robinson: V-\sc Pxp\sc*-\sc Gsm\sc* 13”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 14”} that [place]{strong=“G3588 G5117” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 15 16”}. 
\v 14 [Afterward]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [findeth]{strong=“G2147” x-morph=“robinson: V-\sc Pai\sc*-3S 3”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 4”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 7”} [the temple]{strong=“G3588 G2411” x-morph=“robinson: T-\sc Dsn\sc* robinson: N-\sc Dsn\sc* 8 9”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 11”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 12”}, \wj Behold, thou art made whole: sin no more, lest a worse thing come unto thee.\wj* 
\v 15 [The man]{strong=“G3588 G444” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 2 3”} [departed]{strong=“G565” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 4”} [told]{strong=“G312” x-morph=“robinson: V-\sc Aai\sc*-3S 5”} [the Jews]{strong=“G2453” x-morph=“robinson: A-\sc Dpm\sc* 7”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 8”} [it was]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 10”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 9”}, [which had made]{strong=“G4160” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 12”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 13”} [whole]{strong=“G5199” x-morph=“robinson: A-\sc Asm\sc* 14”}. 
\v 16 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [therefore]{strong=“G1223” x-morph=“robinson: \sc Prep\sc* 2”} [did]{strong=“G1377” x-morph=“robinson: V-\sc Iai\sc*-3P 4”} [the Jews]{strong=“G2453” x-morph=“robinson: A-\sc Npm\sc* 8”} [persecute]{strong=“G1377” x-morph=“robinson: V-\sc Iai\sc*-3P 4”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 5 6”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [sought]{strong=“G2212” x-morph=“robinson: V-\sc Iai\sc*-3P 10”} [to slay]{strong=“G615” x-morph=“robinson: V-\sc Aan\sc* 12”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 11”}, [because]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 13”} [he had done]{strong=“G4160” x-morph=“robinson: V-\sc Iai\sc*-3S 15”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 14”} [on]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 16”} [the sabbath day]{strong=“G4521” x-morph=“robinson: N-\sc Dsn\sc* 17”}. 
\p
\v 17 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 3”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 4”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}, \wj My Father worketh hitherto, and I work.\wj* 
\v 18 [Therefore]{strong=“G1223” x-morph=“robinson: \sc Prep\sc* 1”} [the Jews]{strong=“G2453” x-morph=“robinson: A-\sc Npm\sc* 8”} [sought]{strong=“G2212” x-morph=“robinson: V-\sc Iai\sc*-3P 5”} [the more]{strong=“G3123” x-morph=“robinson: \sc Adv\sc* 4”} [to kill]{strong=“G615” x-morph=“robinson: V-\sc Aan\sc* 9”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 6”}, [because]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 10”} [he]{strong=“G3089” x-morph=“robinson: V-\sc Iai\sc*-3S 13”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 11”} [only]{strong=“G3440” x-morph=“robinson: \sc Adv\sc* 12”} [had broken]{strong=“G3089” x-morph=“robinson: V-\sc Iai\sc*-3S 13”} [the sabbath]{strong=“G3588 G4521” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 14 15”}, [but]{strong=“G235” x-morph=“robinson: \sc Conj\sc* 16”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 20”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 17”} [that]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 20”} [God]{strong=“G3588 G2316” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 21 22”} [was his]{strong=“G2398” x-morph=“robinson: A-\sc Asm\sc* 19”} [Father]{strong=“G3962” x-morph=“robinson: N-\sc Asm\sc* 18”}, [making]{strong=“G4160” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 25”} [himself]{strong=“G1438” x-morph=“robinson: F-3\sc Asm\sc* 24”} [equal]{strong=“G2470” x-morph=“robinson: A-\sc Asm\sc* 23”} [with God]{strong=“G3588 G2316” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 26 27”}. 
\v 19 [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 6”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 7”}, \wj Verily, verily, I say unto you, The Son can do nothing of himself, but what he seeth the Father do: for what things soever he doeth, these also doeth the Son likewise.\wj* 
\v 20 \wj For the Father loveth the Son, and sheweth him all things that himself doeth: and he will shew him greater works than these, that ye may marvel.\wj* 
\v 21 \wj For as the Father raiseth up the dead, and quickeneth them; even so the Son quickeneth whom he will.\wj* 
\v 22 \wj For the Father judgeth no man, but hath committed all judgment unto the Son:\wj* 
\v 23 \wj That all men should honour the Son, even as they honour the Father. He that honoureth not the Son honoureth not the Father which hath sent him.\wj* 
\v 24 \wj Verily, verily, I say unto you, He that heareth my word, and believeth on him that sent me, hath everlasting life, and shall not come into condemnation; but is passed from death unto life.\wj* 
\v 25 \wj Verily, verily, I say unto you, The hour is coming, and now is, when the dead shall hear the voice of the Son of God: and they that hear shall live.\wj* 
\v 26 \wj For as the Father hath life in himself; so hath he given to the Son to have life in himself;\wj* 
\v 27 \wj And hath given him authority to execute judgment also, because he is the Son of man.\wj* 
\v 28 \wj Marvel not at this: for the hour is coming, in the which all that are in the graves shall hear his voice,\wj* 
\v 29 \wj And shall come forth; they that have done good, unto the resurrection of life; and they that have done evil, unto the resurrection of damnation.\wj* 
\v 30 \wj I can of mine own self do nothing: as I hear, I judge: and my judgment is just; because I seek not mine own will, but the will of the Father which hath sent me.\wj* 
\v 31 \wj If I bear witness of myself, my witness is not true.\wj* 
\p
\v 32 \wj There is another that beareth witness of me; and I know that the witness which he witnesseth of me is true.\wj* 
\v 33 \wj Ye sent unto John, and he bare witness unto the truth.\wj* 
\v 34 \wj But I receive not testimony from man: but these things I say, that ye might be saved.\wj* 
\v 35 \wj He was a burning and a shining light: and ye were willing for a season to rejoice in his light.\wj* 
\p
\v 36 \wj But I have greater witness than that of John: for the works which the Father hath given me to finish, the same works that I do, bear witness of me, that the Father hath sent me.\wj* 
\v 37 \wj And the Father himself, which hath sent me, hath borne witness of me. Ye have neither heard his voice at any time, nor seen his shape.\wj* 
\v 38 \wj And ye have not his word abiding in you: for whom he hath sent, him ye believe not.\wj* 
\p
\v 39 \wj Search the scriptures; for in them ye think ye have eternal life: and they are they which testify of me.\wj* 
\v 40 \wj And ye will not come to me, that ye might have life.\wj* 
\v 41 \wj I receive not honour from men.\wj* 
\v 42 \wj But I know you, that ye have not the love of God in you.\wj* 
\v 43 \wj I am come in my Father’s name, and ye receive me not: if another shall come in his own name, him ye will receive.\wj* 
\v 44 \wj How can ye believe, which receive honour one of another, and seek not the honour that cometh from God only?\wj* 
\v 45 \wj Do not think that I will accuse you to the Father: there is one that accuseth you, even Moses, in whom ye trust.\wj* 
\v 46 \wj For had ye believed Moses, ye would have believed me: for he wrote of me.\wj* 
\v 47 \wj But if ye believe not his writings, how shall ye believe my words?\wj* 
\c 6
\p 
