\v 9 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [they which heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 3”} it, [being convicted]{strong=“G1651” x-morph=“robinson: V-\sc Ppp\sc*-\sc Npm\sc* 8”} [by]{strong=“G5259” x-morph=“robinson: \sc Prep\sc* 5”} their own [conscience]{strong=“G3588 G4893” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 6 7”}, [went out]{strong=“G1831” x-morph=“robinson: V-\sc Ini\sc*-3P 9”} [one]{strong=“G1520” x-morph=“robinson: A-\sc Nsm\sc* 10”} [by]{strong=“G2596” x-morph=“robinson: \sc Prep\sc* 11”} [one]{strong=“G1520” x-morph=“robinson: A-\sc Nsm\sc* 12”}, [beginning]{strong=“G756” x-morph=“robinson: V-\sc Amp\sc*-\sc Npm\sc* 13”} [at]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 14”} [the eldest]{strong=“G4245” x-morph=“robinson: A-\sc Gpm\sc* 16”}, even [unto]{strong=“G2193” x-morph=“robinson: \sc Conj\sc* 17”} [the last]{strong=“G2078” x-morph=“robinson: A-\sc Gpm\sc* 19”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 20”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 23 24”} [was left]{strong=“G2641” x-morph=“robinson: V-\sc Api\sc*-3S 21”} [alone]{strong=“G3441” x-morph=“robinson: A-\sc Nsm\sc* 22”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 25”} [the woman]{strong=“G3588 G1135” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 26 27”} [standing]{strong=“G2476” x-morph=“robinson: V-\sc Rap\sc*-\sc Nsf\sc* 30”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 28”} [the midst]{strong=“G3319” x-morph=“robinson: A-\sc Dsn\sc* 29”}. 
\v 10 [When]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [had lifted up himself]{strong=“G352” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 1”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [saw]{strong=“G2300” x-morph=“robinson: V-\sc Adp\sc*-\sc Nsm\sc* 7”} [none]{strong=“G3367” x-morph=“robinson: A-\sc Asm\sc* 6”} [but]{strong=“G4133” x-morph=“robinson: \sc Adv\sc* 8”} [the woman]{strong=“G3588 G1135” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 9 10”}, [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 11”} [unto her]{strong=“G846” x-morph=“robinson: P-\sc Dsf\sc* 12”}, \wj Woman, where are those thine accusers? hath no man condemned thee?\wj* 
\v 11 [She]{strong=“G3588” x-morph=“robinson: T-\sc Nsf\sc* 1”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”}, [No man]{strong=“G3762” x-morph=“robinson: A-\sc Nsm\sc* 4”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 5”}. [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 7”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 9 10”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 6”} [unto her]{strong=“G846” x-morph=“robinson: P-\sc Dsf\sc* 8”}, \wj Neither do I condemn thee: go, and sin no more.\wj* 
\p
\v 12 [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [spake]{strong=“G2980” x-morph=“robinson: V-\sc Aai\sc*-3S 6”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [again]{strong=“G3825” x-morph=“robinson: \sc Adv\sc* 1”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 7”}, \wj I am the light of the world: he that followeth me shall not walk in darkness, but shall have the light of life.\wj* 
\v 13 [The Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 4 5”} [therefore]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”}, [Thou]{strong=“G4771” x-morph=“robinson: P-2\sc Ns\sc* 6”} [bearest record]{strong=“G3140” x-morph=“robinson: V-\sc Pai\sc*-2S 9”} [of]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 7”} [thyself]{strong=“G4572” x-morph=“robinson: F-2\sc Gsm\sc* 8”}; [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 12”} [record]{strong=“G3588 G3141” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 10 11”} [is]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 14”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 13”} [true]{strong=“G227” x-morph=“robinson: A-\sc Nsf\sc* 15”}. 
\v 14 [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 2”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 1”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 3”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}, \wj Though I bear record of myself, yet my record is true: for I know whence I came, and whither I go; but ye cannot tell whence I come, and whither I go.\wj* 
\v 15 \wj Ye judge after the flesh; I judge no man.\wj* 
\v 16 \wj And yet if I judge, my judgment is true: for I am not alone, but I and the Father that sent me.\wj* 
\v 17 \wj It is also written in your law, that the testimony of two men is true.\wj* 
\v 18 \wj I am one that bear witness of myself, and the Father that sent me beareth witness of me.\wj* 
\v 19 [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [said they]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3P 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”}, [Where]{strong=“G4226” x-morph=“robinson: \sc Prt\sc*-I 4”} [is]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 5”} [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 8”} [Father]{strong=“G3588 G3962” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 6 7”}? [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 10 11”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 9”}, \wj Ye neither know me, nor my Father: if ye had known me, ye should have known my Father also.\wj* 
\v 20 [These]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 1”} [words]{strong=“G3588 G4487” x-morph=“robinson: T-\sc Apn\sc* robinson: N-\sc Apn\sc* 2 3”} [spake]{strong=“G2980” x-morph=“robinson: V-\sc Aai\sc*-3S 4”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 7”} [the treasury]{strong=“G3588 G1049” x-morph=“robinson: T-\sc Dsn\sc* robinson: N-\sc Dsn\sc* 8 9”}, [as he taught]{strong=“G1321” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 10”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 11”} [the temple]{strong=“G3588 G2411” x-morph=“robinson: T-\sc Dsn\sc* robinson: N-\sc Dsn\sc* 12 13”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [no man]{strong=“G3762” x-morph=“robinson: A-\sc Nsm\sc* 15”} [laid hands]{strong=“G4084” x-morph=“robinson: V-\sc Aai\sc*-3S 16”} [on him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 17”}; [for]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 18”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 23”} [hour]{strong=“G3588 G5610” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 21 22”} [was]{strong=“G2064” x-morph=“robinson: V-\sc Lai\sc*-3S 20”} [not yet]{strong=“G3768” x-morph=“robinson: \sc Adv\sc* 19”} [come]{strong=“G2064” x-morph=“robinson: V-\sc Lai\sc*-3S 20”}. 
\v 21 [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [again]{strong=“G3825” x-morph=“robinson: \sc Adv\sc* 3”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 4”}, \wj I go my way, and ye shall seek me, and shall die in your sins: whither I go, ye cannot come.\wj* 
\v 22 [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3P 1”} [the Jews]{strong=“G2453” x-morph=“robinson: A-\sc Npm\sc* 4”}, [Will]{strong=“G3385” x-morph=“robinson: \sc Prt\sc*-I 5”} [he kill]{strong=“G615” x-morph=“robinson: V-\sc Fai\sc*-3S 6”} [himself]{strong=“G1438” x-morph=“robinson: F-3\sc Asm\sc* 7”}? [because]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 8”} [he saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 9”}, [Whither]{strong=“G3699” x-morph=“robinson: \sc Adv\sc* 10”} [I]{strong=“G1473” x-morph=“robinson: P-1\sc Ns\sc* 11”} [go]{strong=“G5217” x-morph=“robinson: V-\sc Pai\sc*-1S 12”}, [ye]{strong=“G5210” x-morph=“robinson: P-2\sc Np\sc* 13”} [cannot]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 14”} [come]{strong=“G2064” x-morph=“robinson: V-2\sc Aan\sc* 16”}. 
\v 23 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj Ye are from beneath; I am from above: ye are of this world; I am not of this world.\wj* 
\v 24 \wj I said therefore unto you, that ye shall die in your sins: for if ye believe not that I am he, ye shall die in your sins.\wj* 
\v 25 [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [said they]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3P 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”}, [Who]{strong=“G5101” x-morph=“robinson: I-\sc Nsm\sc* 5”} art [thou]{strong=“G4771” x-morph=“robinson: P-2\sc Ns\sc* 4”}? [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 10 11”} [saith]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 8”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 9”}, \wj Even the same that I said unto you from the beginning.\wj* 
\v 26 \wj I have many things to say and to judge of you: but he that sent me is true; and I speak to the world those things which I have heard of him.\wj* 
\v 27 [They understood]{strong=“G1097” x-morph=“robinson: V-2\sc Aai\sc*-3P 2”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 1”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 3”} [he spake]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 7”} [to them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 6”} [of the Father]{strong=“G3588 G3962” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 4 5”}. 
\v 28 [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj When ye have lifted up the Son of man, then shall ye know that I am he, and that I do nothing of myself; but as my Father hath taught me, I speak these things.\wj* 
\v 29 \wj And he that sent me is with me: the Father hath not left me alone; for I do always those things that please him.\wj* 
\v 30 [As]{strong=“G2980” x-morph=“robinson: V-\sc Pap\sc*-\sc Gsm\sc* 3”} [he]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 2”} [spake]{strong=“G2980” x-morph=“robinson: V-\sc Pap\sc*-\sc Gsm\sc* 3”} [these words]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 1”}, [many]{strong=“G4183” x-morph=“robinson: A-\sc Npm\sc* 4”} [believed]{strong=“G4100” x-morph=“robinson: V-\sc Aai\sc*-3P 5”} [on]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 6”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 7”}. 
\v 31 [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [to]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 5”} [those]{strong=“G4100” x-morph=“robinson: V-\sc Rap\sc*-\sc Apm\sc* 7”} [Jews]{strong=“G2453” x-morph=“robinson: A-\sc Apm\sc* 9”} [which believed]{strong=“G4100” x-morph=“robinson: V-\sc Rap\sc*-\sc Apm\sc* 7”} [on him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 8”}, \wj If ye continue in my word, then are ye my disciples indeed;\wj* 
\v 32 \wj And ye shall know the truth, and the truth shall make you free.\wj* 
\p
\v 33 [They answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3P 1”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, [We be]{strong=“G2070” x-morph=“robinson: V-\sc Pxi\sc*-1P 5”} [Abraham’s]{strong=“G11” x-morph=“robinson: N-\sc Pri\sc* 4”} [seed]{strong=“G4690” x-morph=“robinson: N-\sc Nsn\sc* 3”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [were]{strong=“G1398” x-morph=“robinson: V-\sc Rai\sc*-1P 8”} [never]{strong=“G4455” x-morph=“robinson: \sc Adv\sc* 9”} [in bondage]{strong=“G1398” x-morph=“robinson: V-\sc Rai\sc*-1P 8”} [to any man]{strong=“G3762” x-morph=“robinson: A-\sc Dsm\sc* 7”}: [how]{strong=“G4459” x-morph=“robinson: \sc Adv\sc*-I 10”} [sayest]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-2S 12”} [thou]{strong=“G4771” x-morph=“robinson: P-2\sc Ns\sc* 11”}, [Ye shall be made]{strong=“G1096” x-morph=“robinson: V-\sc Fdi\sc*-2P 15”} [free]{strong=“G1658” x-morph=“robinson: A-\sc Npm\sc* 14”}? 
\v 34 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 1”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 2”}, \wj Verily, verily, I say unto you, Whosoever committeth sin is the servant of sin.\wj* 
\v 35 \wj And the servant abideth not in the house for ever: but the Son abideth ever.\wj* 
\v 36 \wj If the Son therefore shall make you free, ye shall be free indeed.\wj* 
\v 37 \wj I know that ye are Abraham’s seed; but ye seek to kill me, because my word hath no place in you.\wj* 
\v 38 \wj I speak that which I have seen with my Father: and ye do that which ye have seen with your father.\wj* 
\v 39 [They answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3P 1”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 2”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 3”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 4”}, [Abraham]{strong=“G11” x-morph=“robinson: N-\sc Pri\sc* 8”} [is]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 9”} [our]{strong=“G2257” x-morph=“robinson: P-1\sc Gp\sc* 7”} [father]{strong=“G3588 G3962” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”}. [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 12 13”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 10”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 11”}, \wj If ye were Abraham’s children, ye would do the works of Abraham.\wj* 
\v 40 \wj But now ye seek to kill me, a man that hath told you the truth, which I have heard of God: this did not Abraham.\wj* 
\v 41 \wj Ye do the deeds of your father.\wj* [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 9”} [said they]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 8”} [to him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 10”}, [We]{strong=“G2249” x-morph=“robinson: P-1\sc Np\sc* 11”} [be]{strong=“G1080” x-morph=“robinson: V-\sc Rpi\sc*-1P 15”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 14”} [born]{strong=“G1080” x-morph=“robinson: V-\sc Rpi\sc*-1P 15”} [of]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 12”} [fornication]{strong=“G4202” x-morph=“robinson: N-\sc Gsf\sc* 13”}; we [have]{strong=“G2192” x-morph=“robinson: V-\sc Pai\sc*-1P 18”} [one]{strong=“G1520” x-morph=“robinson: A-\sc Asm\sc* 16”} [Father]{strong=“G3962” x-morph=“robinson: N-\sc Asm\sc* 17”}, even [God]{strong=“G3588 G2316” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 19 20”}. 
\v 42 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 2”}, \wj If God were your Father, ye would love me: for I proceeded forth and came from God; neither came I of myself, but he sent me.\wj* 
\v 43 \wj Why do ye not understand my speech? even because ye cannot hear my word.\wj* 
\v 44 \wj Ye are of your father the devil, and the lusts of your father ye will do. He was a murderer from the beginning, and abode not in the truth, because there is no truth in him. When he speaketh a lie, he speaketh of his own: for he is a liar, and the father of it.\wj* 
\v 45 \wj And because I tell you the truth, ye believe me not.\wj* 
\v 46 \wj Which of you convinceth me of sin? And if I say the truth, why do ye not believe me?\wj* 
\v 47 \wj He that is of God heareth God’s words: ye therefore hear them not, because ye are not of God.\wj* 
\v 48 [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3P 1”} [the Jews]{strong=“G2453” x-morph=“robinson: A-\sc Npm\sc* 4”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 6”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 7”}, [Say]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-1P 10”} [we]{strong=“G2249” x-morph=“robinson: P-1\sc Np\sc* 11”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 8”} [well]{strong=“G2573” x-morph=“robinson: \sc Adv\sc* 9”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 12”} [thou]{strong=“G4771” x-morph=“robinson: P-2\sc Ns\sc* 15”} [art]{strong=“G1488” x-morph=“robinson: V-\sc Pxi\sc*-2S 14”} [a Samaritan]{strong=“G4541” x-morph=“robinson: N-\sc Nsm\sc* 13”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 16”} [hast]{strong=“G2192” x-morph=“robinson: V-\sc Pai\sc*-2S 18”} [a devil]{strong=“G1140” x-morph=“robinson: N-\sc Asn\sc* 17”}? 
\v 49 [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 2”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 1”}, \wj I have not a devil; but I honour my Father, and ye do dishonour me.\wj* 
\v 50 \wj And I seek not mine own glory: there is one that seeketh and judgeth.\wj* 
\v 51 \wj Verily, verily, I say unto you, If a man keep my saying, he shall never see death.\wj* 
\v 52 [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 1”} [the Jews]{strong=“G2453” x-morph=“robinson: A-\sc Npm\sc* 5”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”}, [Now]{strong=“G3568” x-morph=“robinson: \sc Adv\sc* 6”} [we know]{strong=“G1097” x-morph=“robinson: V-\sc Rai\sc*-1P 7”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 8”} [thou hast]{strong=“G2192” x-morph=“robinson: V-\sc Pai\sc*-2S 10”} [a devil]{strong=“G1140” x-morph=“robinson: N-\sc Asn\sc* 9”}. [Abraham]{strong=“G11” x-morph=“robinson: N-\sc Pri\sc* 11”} [is dead]{strong=“G599” x-morph=“robinson: V-2\sc Aai\sc*-3S 12”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 13”} [the prophets]{strong=“G3588 G4396” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 14 15”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 16”} [thou]{strong=“G4771” x-morph=“robinson: P-2\sc Ns\sc* 17”} [sayest]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-2S 18”}, [If]{strong=“G1437” x-morph=“robinson: \sc Cond\sc* 19”} [a man]{strong=“G5100” x-morph=“robinson: X-\sc Nsm\sc* 20”} [keep]{strong=“G5083” x-morph=“robinson: V-\sc Aas\sc*-3S 24”} [my]{strong=“G3450” x-morph=“robinson: P-1\sc Gs\sc* 23”} [saying]{strong=“G3588 G3056” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 21 22”}, [he shall]{strong=“G1089” x-morph=“robinson: V-\sc Fdi\sc*-3S 27”} [never]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 25”} [taste]{strong=“G1089” x-morph=“robinson: V-\sc Fdi\sc*-3S 27”} [of death]{strong=“G2288” x-morph=“robinson: N-\sc Gsm\sc* 28”}. 
\v 53 [Art]{strong=“G1488” x-morph=“robinson: V-\sc Pxi\sc*-2S 4”} [thou]{strong=“G4771” x-morph=“robinson: P-2\sc Ns\sc* 2”} [greater than]{strong=“G3187” x-morph=“robinson: A-\sc Nsm\sc*-C 3”} [our]{strong=“G2257” x-morph=“robinson: P-1\sc Gp\sc* 7”} [father]{strong=“G3588 G3962” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 5 6”} [Abraham]{strong=“G11” x-morph=“robinson: N-\sc Pri\sc* 8”}, [which]{strong=“G3748” x-morph=“robinson: R-\sc Nsm\sc* 9”} [is dead]{strong=“G599” x-morph=“robinson: V-2\sc Aai\sc*-3S 10”}? [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [the prophets]{strong=“G3588 G4396” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 12 13”} [are dead]{strong=“G599” x-morph=“robinson: V-2\sc Aai\sc*-3P 14”}: [whom]{strong=“G5101” x-morph=“robinson: I-\sc Asm\sc* 15”} [makest]{strong=“G4160” x-morph=“robinson: V-\sc Pai\sc*-2S 18”} [thou]{strong=“G4771” x-morph=“robinson: P-2\sc Ns\sc* 17”} [thyself]{strong=“G4572” x-morph=“robinson: F-2\sc Asm\sc* 16”}? 
\v 54 [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 2”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 1”}, \wj If I honour myself, my honour is nothing: it is my Father that honoureth me; of whom ye say, that he is your God:\wj* 
\v 55 \wj Yet ye have not known him; but I know him: and if I should say, I know him not, I shall be a liar like unto you: but I know him, and keep his saying.\wj* 
\v 56 \wj Your father Abraham rejoiced to see my day: and he saw it, and was glad.\wj* 
\v 57 [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 1”} [the Jews]{strong=“G2453” x-morph=“robinson: A-\sc Npm\sc* 4”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 5”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 6”}, [Thou art]{strong=“G2192” x-morph=“robinson: V-\sc Pai\sc*-2S 10”} [not yet]{strong=“G3768” x-morph=“robinson: \sc Adv\sc* 9”} [fifty]{strong=“G4004” x-morph=“robinson: A-\sc Nui\sc* 7”} [years]{strong=“G2094” x-morph=“robinson: N-\sc Apn\sc* 8”} [old]{strong=“G2192” x-morph=“robinson: V-\sc Pai\sc*-2S 10”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [hast thou seen]{strong=“G3708” x-morph=“robinson: V-\sc Rai\sc*-2S-\sc Att\sc* 13”} [Abraham]{strong=“G11” x-morph=“robinson: N-\sc Pri\sc* 12”}? 
