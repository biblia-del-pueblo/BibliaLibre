\v 7 [So]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [when]{strong=“G5613” x-morph=“robinson: \sc Adv\sc* 1”} [they continued]{strong=“G1961” x-morph=“robinson: V-\sc Iai\sc*-3P 3”} [asking]{strong=“G2065” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 4”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 5”}, [he lifted up himself]{strong=“G352” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 6”}, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 7”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 8”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 9”}, \wj He that is without sin among you, let him first cast a stone at her.\wj* 
