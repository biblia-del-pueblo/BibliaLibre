\p
\v 39 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”}, \wj For judgment I am come into this world, that they which see not might see; and that they which see might be made blind.\wj* 
\v 40 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} some [of]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 3”} [the Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 4 5”} [which were]{strong=“G5607” x-morph=“robinson: V-\sc Pxp\sc*-\sc Npm\sc* 8”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 9”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 10”} [heard]{strong=“G191” x-morph=“robinson: V-\sc Aai\sc*-3P 2”} [these words]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 6”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 12”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 13”}, [Are]{strong=“G2070” x-morph=“robinson: V-\sc Pxi\sc*-1P 18”} [we]{strong=“G2249” x-morph=“robinson: P-1\sc Np\sc* 16”} [blind]{strong=“G5185” x-morph=“robinson: A-\sc Npm\sc* 17”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 15”}? 
\v 41 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 2”}, \wj If ye were blind, ye should have no sin: but now ye say, We see; therefore your sin remaineth.\wj* 
\c 10
\p 
\v 1 \wj Verily, verily, I say unto you, He that entereth not by the door into the sheepfold, but climbeth up some other way, the same is a thief and a robber.\wj* 
\v 2 \wj But he that entereth in by the door is the shepherd of the sheep.\wj* 
\v 3 \wj To him the porter openeth; and the sheep hear his voice: and he calleth his own sheep by name, and leadeth them out.\wj* 
\v 4 \wj And when he putteth forth his own sheep, he goeth before them, and the sheep follow him: for they know his voice.\wj* 
\v 5 \wj And a stranger will they not follow, but will flee from him: for they know not the voice of strangers.\wj* 
\v 6 [This]{strong=“G3778” x-morph=“robinson: D-\sc Asf\sc* 1”} [parable]{strong=“G3588 G3942” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 2 3”} [spake]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 6 7”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}: [but]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 9”} [they]{strong=“G1565” x-morph=“robinson: D-\sc Npm\sc* 8”} [understood]{strong=“G1097” x-morph=“robinson: V-2\sc Aai\sc*-3P 11”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 10”} [what things]{strong=“G5101” x-morph=“robinson: I-\sc Npn\sc* 12”} [they were]{strong=“G2258” x-morph=“robinson: V-IXI-3S 13”} [which]{strong=“G3739” x-morph=“robinson: R-\sc Apn\sc* 14”} [he spake]{strong=“G2980” x-morph=“robinson: V-\sc Iai\sc*-3S 15”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 16”}. 
\v 7 [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 4”} [again]{strong=“G3825” x-morph=“robinson: \sc Adv\sc* 3”}, \wj Verily, verily, I say unto you, I am the door of the sheep.\wj* 
\v 8 \wj All that ever came before me are thieves and robbers: but the sheep did not hear them.\wj* 
\v 9 \wj I am the door: by me if any man enter in, he shall be saved, and shall go in and out, and find pasture.\wj* 
\v 10 \wj The thief cometh not, but for to steal, and to kill, and to destroy: I am come that they might have life, and that they might have it more abundantly.\wj* 
\v 11 \wj I am the good shepherd: the good shepherd giveth his life for the sheep.\wj* 
\v 12 \wj But he that is an hireling, and not the shepherd, whose own the sheep are not, seeth the wolf coming, and leaveth the sheep, and fleeth: and the wolf catcheth them, and scattereth the sheep.\wj* 
\v 13 \wj The hireling fleeth, because he is an hireling, and careth not for the sheep.\wj* 
\v 14 \wj I am the good shepherd, and know my sheep, and am known of mine.\wj* 
\v 15 \wj As the Father knoweth me, even so know I the Father: and I lay down my life for the sheep.\wj* 
\v 16 \wj And other sheep I have, which are not of this fold: them also I must bring, and they shall hear my voice; and there shall be one fold, and one shepherd.\wj* 
\v 17 \wj Therefore doth my Father love me, because I lay down my life, that I might take it again.\wj* 
\v 18 \wj No man taketh it from me, but I lay it down of myself. I have power to lay it down, and I have power to take it again. This commandment have I received of my Father.\wj* 
\p
\v 19 [There was]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 4”} [a division]{strong=“G4978” x-morph=“robinson: N-\sc Nsn\sc* 1”} [therefore]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [again]{strong=“G3825” x-morph=“robinson: \sc Adv\sc* 3”} [among]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 5”} [the Jews]{strong=“G2453” x-morph=“robinson: A-\sc Dpm\sc* 7”} [for]{strong=“G1223” x-morph=“robinson: \sc Prep\sc* 8”} [these]{strong=“G5128” x-morph=“robinson: D-\sc Apm\sc* 11”} [sayings]{strong=“G3588 G3056” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 9 10”}. 
\v 20 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [many of them]{strong=“G4183” x-morph=“robinson: A-\sc Npm\sc* 3”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3P 1”}, [He hath]{strong=“G2192” x-morph=“robinson: V-\sc Pai\sc*-3S 7”} [a devil]{strong=“G1140” x-morph=“robinson: N-\sc Asn\sc* 6”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [is mad]{strong=“G3105” x-morph=“robinson: V-\sc Pni\sc*-3S 9”}; [why]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 10”} [hear ye]{strong=“G191” x-morph=“robinson: V-\sc Pai\sc*-2P 12”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 11”}? 
\v 21 [Others]{strong=“G243” x-morph=“robinson: A-\sc Npm\sc* 1”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3P 2”}, [These]{strong=“G5023” x-morph=“robinson: D-\sc Npn\sc* 3”} [are]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 7”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 6”} [the words]{strong=“G3588 G4487” x-morph=“robinson: T-\sc Npn\sc* robinson: N-\sc Npn\sc* 4 5”} [of him that hath a devil]{strong=“G1139” x-morph=“robinson: V-\sc Pnp\sc*-\sc Gsm\sc* 8”}. [Can]{strong=“G1410” x-morph=“robinson: V-\sc Pni\sc*-3S 11”} [a devil]{strong=“G1140” x-morph=“robinson: N-\sc Nsn\sc* 10”} [open]{strong=“G455” x-morph=“robinson: V-\sc Pan\sc* 14”} [the eyes]{strong=“G3788” x-morph=“robinson: N-\sc Apm\sc* 13”} [of the blind]{strong=“G5185” x-morph=“robinson: A-\sc Gpm\sc* 12”}? 
\p
