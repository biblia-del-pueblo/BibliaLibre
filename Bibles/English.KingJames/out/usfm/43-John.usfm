\c 7
\p 
\v 1 [After]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 5”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 6”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [walked]{strong=“G4043” x-morph=“robinson: V-\sc Iai\sc*-3S 2”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 7”} [Galilee]{strong=“G3588 G1056” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 8 9”}: [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 11”} [he would]{strong=“G2309” x-morph=“robinson: V-\sc Iai\sc*-3S 12”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 10”} [walk]{strong=“G4043” x-morph=“robinson: V-\sc Pan\sc* 16”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 13”} [Jewry]{strong=“G3588 G2449” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 14 15”}, [because]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 17”} [the Jews]{strong=“G2453” x-morph=“robinson: A-\sc Npm\sc* 21”} [sought]{strong=“G2212” x-morph=“robinson: V-\sc Iai\sc*-3P 18”} [to kill]{strong=“G615” x-morph=“robinson: V-\sc Aan\sc* 22”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 19”}. 
