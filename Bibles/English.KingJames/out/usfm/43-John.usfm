\v 36 [He]{strong=“G1565” x-morph=“robinson: D-\sc Nsm\sc* 2”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 1”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 3”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”}, [Who]{strong=“G5101” x-morph=“robinson: I-\sc Nsm\sc* 5”} [is he]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 6”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 7”}, [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 8”} [I might believe]{strong=“G4100” x-morph=“robinson: V-\sc Aas\sc*-1S 9”} [on]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 10”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 11”}? 
\v 37 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”}, \wj Thou hast both seen him, and it is he that talketh with thee.\wj* 
