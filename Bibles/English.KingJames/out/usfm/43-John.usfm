\v 24 [Simon]{strong=“G4613” x-morph=“robinson: N-\sc Nsm\sc* 4”} [Peter]{strong=“G4074” x-morph=“robinson: N-\sc Nsm\sc* 5”} [therefore]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [beckoned]{strong=“G3506” x-morph=“robinson: V-\sc Pai\sc*-3S 1”} [to him]{strong=“G5129” x-morph=“robinson: D-\sc Dsm\sc* 3”}, [that he should ask]{strong=“G4441” x-morph=“robinson: V-2\sc Adn\sc* 6”} [who]{strong=“G5101” x-morph=“robinson: I-\sc Nsm\sc* 7”} [it should be]{strong=“G1498” x-morph=“robinson: V-\sc Pxo\sc*-3S 9”} [of]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 10”} [whom]{strong=“G3739” x-morph=“robinson: R-\sc Gsm\sc* 11”} [he spake]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 12”}. 
\v 25 [He]{strong=“G1565” x-morph=“robinson: D-\sc Nsm\sc* 3”} [then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [lying]{strong=“G1968” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 1”} [on]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 4”} [Jesus’]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 7 8”} [breast]{strong=“G3588 G4738” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 5 6”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 9”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 10”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 11”}, [who]{strong=“G5101” x-morph=“robinson: I-\sc Nsm\sc* 12”} [is it]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 13”}? 
\v 26 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 2 3”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Pni\sc*-3S 1”}, \wj He it is, to whom I shall give a sop, when I have dipped it.\wj* [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”} [when he had dipped]{strong=“G1686” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 13”} [the sop]{strong=“G3588 G5596” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 14 15”}, [he gave]{strong=“G1325” x-morph=“robinson: V-\sc Pai\sc*-3S 16”} it [to Judas]{strong=“G2455” x-morph=“robinson: N-\sc Dsm\sc* 17”} [Iscariot]{strong=“G2469” x-morph=“robinson: N-\sc Dsm\sc* 19”}, the son [of Simon]{strong=“G4613” x-morph=“robinson: N-\sc Gsm\sc* 18”}. 
\v 27 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [after]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 2”} [the sop]{strong=“G3588 G5596” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 3 4”} [Satan]{strong=“G3588 G4567” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 9 10”} [entered]{strong=“G1525” x-morph=“robinson: V-2\sc Aai\sc*-3S 6”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 7”} [him]{strong=“G1565” x-morph=“robinson: D-\sc Asm\sc* 8”}. [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 5”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 11”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 14 15”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 13”}, \wj That thou doest, do quickly.\wj* 
\v 28 [Now]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [no man]{strong=“G3762” x-morph=“robinson: A-\sc Nsm\sc* 3”} [at the table]{strong=“G345” x-morph=“robinson: V-\sc Pnp\sc*-\sc Gpm\sc* 6”} [knew]{strong=“G1097” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [for what intent]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 8”} [he spake]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 9”} [this]{strong=“G5124” x-morph=“robinson: D-\sc Asn\sc* 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 10”}. 
\v 29 [For]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 2”} [some]{strong=“G5100” x-morph=“robinson: X-\sc Npm\sc* 1”} of them [thought]{strong=“G1380” x-morph=“robinson: V-\sc Iai\sc*-3P 3”}, [because]{strong=“G1893” x-morph=“robinson: \sc Conj\sc* 4”} [Judas]{strong=“G3588 G2455” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 8 9”} [had]{strong=“G2192” x-morph=“robinson: V-\sc Iai\sc*-3S 7”} [the bag]{strong=“G3588 G1101” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 5 6”}, [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 10”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 13 14”} [had said]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 11”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 12”}, [Buy]{strong=“G59” x-morph=“robinson: V-\sc Aam\sc*-2S 15”} those things [that]{strong=“G3739” x-morph=“robinson: R-\sc Gpn\sc* 16”} [we have]{strong=“G2192” x-morph=“robinson: V-\sc Pai\sc*-1P 18”} [need]{strong=“G5532” x-morph=“robinson: N-\sc Asf\sc* 17”} [of against]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 19”} [the feast]{strong=“G3588 G1859” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 20 21”}; [or]{strong=“G2228” x-morph=“robinson: \sc Prt\sc* 22”}, [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 25”} [he should give]{strong=“G1325” x-morph=“robinson: V-2\sc Aas\sc*-3S 27”} [something]{strong=“G5100” x-morph=“robinson: X-\sc Asn\sc* 26”} [to the poor]{strong=“G4434” x-morph=“robinson: A-\sc Dpm\sc* 24”}. 
\v 30 [He]{strong=“G1565” x-morph=“robinson: D-\sc Nsm\sc* 5”} [then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [having received]{strong=“G2983” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 1”} [the sop]{strong=“G3588 G5596” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 3 4”} [went]{strong=“G1831” x-morph=“robinson: V-2\sc Aai\sc*-3S 7”} [immediately]{strong=“G2112” x-morph=“robinson: \sc Adv\sc* 6”} [out]{strong=“G1831” x-morph=“robinson: V-2\sc Aai\sc*-3S 7”}: [and]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 9”} [it was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 8”} [night]{strong=“G3571” x-morph=“robinson: N-\sc Nsf\sc* 10”}. 
\p
\v 31 [Therefore]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”}, [when]{strong=“G3753” x-morph=“robinson: \sc Adv\sc* 1”} [he was gone out]{strong=“G1831” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”}, [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 4”}, \wj Now is the Son of man glorified, and God is glorified in him.\wj* 
\v 32 \wj If God be glorified in him, God shall also glorify him in himself, and shall straightway glorify him.\wj* 
\v 33 \wj Little children, yet a little while I am with you. Ye shall seek me: and as I said unto the Jews, Whither I go, ye cannot come; so now I say to you.\wj* 
\v 34 \wj A new commandment I give unto you, That ye love one another; as I have loved you, that ye also love one another.\wj* 
\v 35 \wj By this shall all men know that ye are my disciples, if ye have love one to another.\wj* 
\p
\v 36 [Simon]{strong=“G4613” x-morph=“robinson: N-\sc Nsm\sc* 3”} [Peter]{strong=“G4074” x-morph=“robinson: N-\sc Nsm\sc* 4”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 5”}, [whither]{strong=“G4226” x-morph=“robinson: \sc Prt\sc*-I 6”} [goest thou]{strong=“G5217” x-morph=“robinson: V-\sc Pai\sc*-2S 7”}? [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 10 11”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 8”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 9”}, \wj Whither I go, thou canst not follow me now; but thou shalt follow me afterwards.\wj* 
\v 37 [Peter]{strong=“G3588 G4074” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 5”}, [why]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 7”} [cannot I]{strong=“G1410” x-morph=“robinson: V-\sc Pni\sc*-1S 9”} [follow]{strong=“G190” x-morph=“robinson: V-\sc Aan\sc* 11”} [thee]{strong=“G4671” x-morph=“robinson: P-2\sc Ds\sc* 10”} [now]{strong=“G737” x-morph=“robinson: \sc Adv\sc* 12”}? [I will lay down]{strong=“G5087” x-morph=“robinson: V-\sc Fai\sc*-1S 18”} [my]{strong=“G3450” x-morph=“robinson: P-1\sc Gs\sc* 15”} [life]{strong=“G3588 G5590” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 13 14”} [for]{strong=“G5228” x-morph=“robinson: \sc Prep\sc* 16”} [thy sake]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 17”}. 
\v 38 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 1”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, \wj Wilt thou lay down thy life for my sake? Verily, verily, I say unto thee, The cock shall not crow, till thou hast denied me thrice.\wj* 
\c 14
\p 
\v 1 \wj Let not your heart be troubled: ye believe in God, believe also in me.\wj* 
\v 2 \wj In my Father’s house are many mansions: if it were not so, I would have told you. I go to prepare a place for you.\wj* 
\v 3 \wj And if I go and prepare a place for you, I will come again, and receive you unto myself; that where I am, there ye may be also.\wj* 
\v 4 \wj And whither I go ye know, and the way ye know.\wj* 
\v 5 [Thomas]{strong=“G2381” x-morph=“robinson: N-\sc Nsm\sc* 3”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 4”}, [we know]{strong=“G1492” x-morph=“robinson: V-\sc Rai\sc*-1P 6”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 5”} [whither]{strong=“G4226” x-morph=“robinson: \sc Prt\sc*-I 7”} [thou goest]{strong=“G5217” x-morph=“robinson: V-\sc Pai\sc*-2S 8”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [how]{strong=“G4459” x-morph=“robinson: \sc Adv\sc*-I 10”} [can we]{strong=“G1410” x-morph=“robinson: V-\sc Pni\sc*-1P 11”} [know]{strong=“G1492” x-morph=“robinson: V-\sc Ran\sc* 14”} [the way]{strong=“G3588 G3598” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 12 13”}? 
\v 6 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, \wj I am the way, the truth, and the life: no man cometh unto the Father, but by me.\wj* 
\v 7 \wj If ye had known me, ye should have known my Father also: and from henceforth ye know him, and have seen him.\wj* 
\v 8 [Philip]{strong=“G5376” x-morph=“robinson: N-\sc Nsm\sc* 3”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 4”}, [shew]{strong=“G1166” x-morph=“robinson: V-\sc Aam\sc*-2S 5”} [us]{strong=“G2254” x-morph=“robinson: P-1\sc Dp\sc* 6”} [the Father]{strong=“G3588 G3962” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 7 8”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [it sufficeth]{strong=“G714” x-morph=“robinson: V-\sc Pai\sc*-3S 10”} [us]{strong=“G2254” x-morph=“robinson: P-1\sc Dp\sc* 11”}. 
\v 9 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, \wj Have I been so long time with you, and yet hast thou not known me, Philip? he that hath seen me hath seen the Father; and how sayest thou then, Shew us the Father?\wj* 
\v 10 \wj Believest thou not that I am in the Father, and the Father in me? the words that I speak unto you I speak not of myself: but the Father that dwelleth in me, he doeth the works.\wj* 
\v 11 \wj Believe me that I am in the Father, and the Father in me: or else believe me for the very works’ sake.\wj* 
\v 12 \wj Verily, verily, I say unto you, He that believeth on me, the works that I do shall he do also; and greater works than these shall he do; because I go unto my Father.\wj* 
\v 13 \wj And whatsoever ye shall ask in my name, that will I do, that the Father may be glorified in the Son.\wj* 
\v 14 \wj If ye shall ask any thing in my name, I will do it.\wj* 
\p
\v 15 \wj If ye love me, keep my commandments.\wj* 
\v 16 \wj And I will pray the Father, and he shall give you another Comforter, that he may abide with you for ever;\wj* 
\v 17 \wj Even the Spirit of truth; whom the world cannot receive, because it seeth him not, neither knoweth him: but ye know him; for he dwelleth with you, and shall be in you.\wj* 
\v 18 \wj I will not leave you comfortless: I will come to you.\wj* 
\v 19 \wj Yet a little while, and the world seeth me no more; but ye see me: because I live, ye shall live also.\wj* 
\v 20 \wj At that day ye shall know that I am in my Father, and ye in me, and I in you.\wj* 
\v 21 \wj He that hath my commandments, and keepeth them, he it is that loveth me: and he that loveth me shall be loved of my Father, and I will love him, and will manifest myself to him.\wj* 
\v 22 [Judas]{strong=“G2455” x-morph=“robinson: N-\sc Nsm\sc* 3”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 4”} [Iscariot]{strong=“G3588 G2469” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 7”}, [how]{strong=“G5101” x-morph=“robinson: I-\sc Nsn\sc* 8”} [is it]{strong=“G1096” x-morph=“robinson: V-2\sc Rai\sc*-3S 9”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 10”} [thou wilt]{strong=“G3195” x-morph=“robinson: V-\sc Pai\sc*-2S 12”} [manifest]{strong=“G1718” x-morph=“robinson: V-\sc Pan\sc* 13”} [thyself]{strong=“G4572” x-morph=“robinson: F-2\sc Asm\sc* 14”} [unto us]{strong=“G2254” x-morph=“robinson: P-1\sc Dp\sc* 11”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 15”} [not]{strong=“G3780” x-morph=“robinson: \sc Prt\sc*-I 16”} [unto the world]{strong=“G3588 G2889” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 17 18”}? 
\v 23 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 2 3”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 1”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 4”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 6”}, \wj If a man love me, he will keep my words: and my Father will love him, and we will come unto him, and make our abode with him.\wj* 
\v 24 \wj He that loveth me not keepeth not my sayings: and the word which ye hear is not mine, but the Father’s which sent me.\wj* 
\v 25 \wj These things have I spoken unto you, being yet present with you.\wj* 
\v 26 \wj But the Comforter, which is the Holy Ghost, whom the Father will send in my name, he shall teach you all things, and bring all things to your remembrance, whatsoever I have said unto you.\wj* 
\v 27 \wj Peace I leave with you, my peace I give unto you: not as the world giveth, give I unto you. Let not your heart be troubled, neither let it be afraid.\wj* 
\v 28 \wj Ye have heard how I said unto you, I go away, and come again unto you. If ye loved me, ye would rejoice, because I said, I go unto the Father: for my Father is greater than I.\wj* 
\v 29 \wj And now I have told you before it come to pass, that, when it is come to pass, ye might believe.\wj* 
\v 30 \wj Hereafter I will not talk much with you: for the prince of this world cometh, and hath nothing in me.\wj* 
\v 31 \wj But that the world may know that I love the Father; and as the Father gave me commandment, even so I do. Arise, let us go hence.\wj* 
\c 15
\p 
\v 1 \wj I am the true vine, and my Father is the husbandman.\wj* 
\v 2 \wj Every branch in me that beareth not fruit he taketh away: and every branch that beareth fruit, he purgeth it, that it may bring forth more fruit.\wj* 
\v 3 \wj Now ye are clean through the word which I have spoken unto you.\wj* 
\v 4 \wj Abide in me, and I in you. As the branch cannot bear fruit of itself, except it abide in the vine; no more can ye, except ye abide in me.\wj* 
\v 5 \wj I am the vine, ye are the branches: He that abideth in me, and I in him, the same bringeth forth much fruit: for without me ye can do nothing.\wj* 
\v 6 \wj If a man abide not in me, he is cast forth as a branch, and is withered; and men gather them, and cast them into the fire, and they are burned.\wj* 
\v 7 \wj If ye abide in me, and my words abide in you, ye shall ask what ye will, and it shall be done unto you.\wj* 
\v 8 \wj Herein is my Father glorified, that ye bear much fruit; so shall ye be my disciples.\wj* 
\v 9 \wj As the Father hath loved me, so have I loved you: continue ye in my love.\wj* 
\v 10 \wj If ye keep my commandments, ye shall abide in my love; even as I have kept my Father’s commandments, and abide in his love.\wj* 
\v 11 \wj These things have I spoken unto you, that my joy might remain in you, and that your joy might be full.\wj* 
\v 12 \wj This is my commandment, That ye love one another, as I have loved you.\wj* 
\v 13 \wj Greater love hath no man than this, that a man lay down his life for his friends.\wj* 
\v 14 \wj Ye are my friends, if ye do whatsoever I command you.\wj* 
\v 15 \wj Henceforth I call you not servants; for the servant knoweth not what his lord doeth: but I have called you friends; for all things that I have heard of my Father I have made known unto you.\wj* 
\v 16 \wj Ye have not chosen me, but I have chosen you, and ordained you, that ye should go and bring forth fruit, and that your fruit should remain: that whatsoever ye shall ask of the Father in my name, he may give it you.\wj* 
\v 17 \wj These things I command you, that ye love one another.\wj* 
\v 18 \wj If the world hate you, ye know that it hated me before it hated you.\wj* 
\v 19 \wj If ye were of the world, the world would love his own: but because ye are not of the world, but I have chosen you out of the world, therefore the world hateth you.\wj* 
\v 20 \wj Remember the word that I said unto you, The servant is not greater than his lord. If they have persecuted me, they will also persecute you; if they have kept my saying, they will keep yours also.\wj* 
\v 21 \wj But all these things will they do unto you for my name’s sake, because they know not him that sent me.\wj* 
\v 22 \wj If I had not come and spoken unto them, they had not had sin: but now they have no cloke for their sin.\wj* 
\v 23 \wj He that hateth me hateth my Father also.\wj* 
\v 24 \wj If I had not done among them the works which none other man did, they had not had sin: but now have they both seen and hated both me and my Father.\wj* 
\v 25 \wj But this cometh to pass, that the word might be fulfilled that is written in their law, They hated me without a cause.\wj* 
\v 26 \wj But when the Comforter is come, whom I will send unto you from the Father, even the Spirit of truth, which proceedeth from the Father, he shall testify of me:\wj* 
\v 27 \wj And ye also shall bear witness, because ye have been with me from the beginning.\wj* 
\c 16
\p 
\v 1 \wj These things have I spoken unto you, that ye should not be offended.\wj* 
\v 2 \wj They shall put you out of the synagogues: yea, the time cometh, that whosoever killeth you will think that he doeth God service.\wj* 
\v 3 \wj And these things will they do unto you, because they have not known the Father, nor me.\wj* 
\v 4 \wj But these things have I told you, that when the time shall come, ye may remember that I told you of them. And these things I said not unto you at the beginning, because I was with you.\wj* 
\v 5 \wj But now I go my way to him that sent me; and none of you asketh me, Whither goest thou?\wj* 
\v 6 \wj But because I have said these things unto you, sorrow hath filled your heart.\wj* 
\v 7 \wj Nevertheless I tell you the truth; It is expedient for you that I go away: for if I go not away, the Comforter will not come unto you; but if I depart, I will send him unto you.\wj* 
\v 8 \wj And when he is come, he will reprove the world of sin, and of righteousness, and of judgment:\wj* 
\v 9 \wj Of sin, because they believe not on me;\wj* 
\v 10 \wj Of righteousness, because I go to my Father, and ye see me no more;\wj* 
\v 11 \wj Of judgment, because the prince of this world is judged.\wj* 
\v 12 \wj I have yet many things to say unto you, but ye cannot bear them now.\wj* 
\v 13 \wj Howbeit when he, the Spirit of truth, is come, he will guide you into all truth: for he shall not speak of himself; but whatsoever he shall hear, that shall he speak: and he will shew you things to come.\wj* 
\v 14 \wj He shall glorify me: for he shall receive of mine, and shall shew it unto you.\wj* 
\v 15 \wj All things that the Father hath are mine: therefore said I, that he shall take of mine, and shall shew it unto you.\wj* 
\v 16 \wj A little while, and ye shall not see me: and again, a little while, and ye shall see me, because I go to the Father.\wj* 
\v 17 [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 1”} some [of]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 3”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 6”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 4 5”} [among]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 7”} [themselves]{strong=“G240” x-morph=“robinson: C-\sc Apm\sc* 8”}, [What]{strong=“G5101” x-morph=“robinson: I-\sc Nsn\sc* 9”} [is]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 10”} [this]{strong=“G5124” x-morph=“robinson: D-\sc Nsn\sc* 11”} [that]{strong=“G3739” x-morph=“robinson: R-\sc Asn\sc* 12”} [he saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 13”} [unto us]{strong=“G2254” x-morph=“robinson: P-1\sc Dp\sc* 14”}, [A little while]{strong=“G3397” x-morph=“robinson: A-\sc Asn\sc* 15”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 16”} [ye shall]{strong=“G2334” x-morph=“robinson: V-\sc Pai\sc*-2P 18”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 17”} [see]{strong=“G2334” x-morph=“robinson: V-\sc Pai\sc*-2P 18”} [me]{strong=“G3165” x-morph=“robinson: P-1\sc As\sc* 19”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 20”} [again]{strong=“G3825” x-morph=“robinson: \sc Adv\sc* 21”}, [a little while]{strong=“G3397” x-morph=“robinson: A-\sc Asn\sc* 22”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 23”} [ye shall see]{strong=“G3700” x-morph=“robinson: V-\sc Fdi\sc*-2P 24”} [me]{strong=“G3165” x-morph=“robinson: P-1\sc As\sc* 25”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 26”}, [Because]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 27”} [I]{strong=“G1473” x-morph=“robinson: P-1\sc Ns\sc* 28”} [go]{strong=“G5217” x-morph=“robinson: V-\sc Pai\sc*-1S 29”} [to]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 30”} [the Father]{strong=“G3588 G3962” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 31 32”}? 
\v 18 [They said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3P 1”} [therefore]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”}, [What]{strong=“G5101” x-morph=“robinson: I-\sc Nsn\sc* 4”} [is]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 5”} [this]{strong=“G5124” x-morph=“robinson: D-\sc Nsn\sc* 3”} [that]{strong=“G3739” x-morph=“robinson: R-\sc Asn\sc* 6”} [he saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 7”}, [A little while]{strong=“G3397” x-morph=“robinson: A-\sc Asn\sc* 9”}? [we]{strong=“G1492” x-morph=“robinson: V-\sc Rai\sc*-1P 11”} [cannot]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 10”} [tell]{strong=“G1492” x-morph=“robinson: V-\sc Rai\sc*-1P 11”} [what]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 12”} [he saith]{strong=“G2980” x-morph=“robinson: V-\sc Pai\sc*-3S 13”}. 
\v 19 [Now]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [knew]{strong=“G1097” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 5”} [they were desirous]{strong=“G2309” x-morph=“robinson: V-\sc Iai\sc*-3P 6”} [to ask]{strong=“G2065” x-morph=“robinson: V-\sc Pan\sc* 8”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 7”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 10”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 11”}, \wj Do ye enquire among yourselves of that I said, A little while, and ye shall not see me: and again, a little while, and ye shall see me?\wj* 
\v 20 \wj Verily, verily, I say unto you, That ye shall weep and lament, but the world shall rejoice: and ye shall be sorrowful, but your sorrow shall be turned into joy.\wj* 
\v 21 \wj A woman when she is in travail hath sorrow, because her hour is come: but as soon as she is delivered of the child, she remembereth no more the anguish, for joy that a man is born into the world.\wj* 
\v 22 \wj And ye now therefore have sorrow: but I will see you again, and your heart shall rejoice, and your joy no man taketh from you.\wj* 
\v 23 \wj And in that day ye shall ask me nothing. Verily, verily, I say unto you, Whatsoever ye shall ask the Father in my name, he will give it you.\wj* 
\v 24 \wj Hitherto have ye asked nothing in my name: ask, and ye shall receive, that your joy may be full.\wj* 
\v 25 \wj These things have I spoken unto you in proverbs: but the time cometh, when I shall no more speak unto you in proverbs, but I shall shew you plainly of the Father.\wj* 
\v 26 \wj At that day ye shall ask in my name: and I say not unto you, that I will pray the Father for you:\wj* 
\v 27 \wj For the Father himself loveth you, because ye have loved me, and have believed that I came out from God.\wj* 
\v 28 \wj I came forth from the Father, and am come into the world: again, I leave the world, and go to the Father.\wj* 
\v 29 [His]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 5”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [said unto]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3P 1”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, [Lo]{strong=“G1492” x-morph=“robinson: V-\sc Aam\sc*-2S 6”}, [now]{strong=“G3568” x-morph=“robinson: \sc Adv\sc* 7”} [speakest thou]{strong=“G2980” x-morph=“robinson: V-\sc Pai\sc*-2S 9”} [plainly]{strong=“G3954” x-morph=“robinson: N-\sc Dsf\sc* 8”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [speakest]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-2S 13”} [no]{strong=“G3762” x-morph=“robinson: A-\sc Asf\sc* 12”} [proverb]{strong=“G3942” x-morph=“robinson: N-\sc Asf\sc* 11”}. 
\v 30 [Now]{strong=“G3568” x-morph=“robinson: \sc Adv\sc* 1”} [are we sure]{strong=“G1492” x-morph=“robinson: V-\sc Rai\sc*-1P 2”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 3”} [thou knowest]{strong=“G1492” x-morph=“robinson: V-\sc Rai\sc*-2S 4”} [all things]{strong=“G3956” x-morph=“robinson: A-\sc Apn\sc* 5”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [needest]{strong=“G5532” x-morph=“robinson: N-\sc Asf\sc* 8”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 7”} [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 10”} [any man]{strong=“G5100” x-morph=“robinson: X-\sc Nsm\sc* 11”} [should ask]{strong=“G2065” x-morph=“robinson: V-\sc Pas\sc*-3S 13”} [thee]{strong=“G4571” x-morph=“robinson: P-2\sc As\sc* 12”}: [by]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 14”} [this]{strong=“G5129” x-morph=“robinson: D-\sc Dsn\sc* 15”} [we believe]{strong=“G4100” x-morph=“robinson: V-\sc Pai\sc*-1P 16”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 17”} [thou camest forth]{strong=“G1831” x-morph=“robinson: V-2\sc Aai\sc*-2S 20”} [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 18”} [God]{strong=“G2316” x-morph=“robinson: N-\sc Gsm\sc* 19”}. 
\v 31 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 1”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 2”}, \wj Do ye now believe?\wj* 
\v 32 \wj Behold, the hour cometh, yea, is now come, that ye shall be scattered, every man to his own, and shall leave me alone: and yet I am not alone, because the Father is with me.\wj* 
\v 33 \wj These things I have spoken unto you, that in me ye might have peace. In the world ye shall have tribulation: but be of good cheer; I have overcome the world.\wj* 
\c 17
\p 
\v 1 [These words]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 1”} [spake]{strong=“G2980” x-morph=“robinson: V-\sc Aai\sc*-3S 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [lifted up]{strong=“G1869” x-morph=“robinson: V-\sc Aai\sc*-3S 6”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 9”} [eyes]{strong=“G3588 G3788” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 7 8”} [to]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 10”} [heaven]{strong=“G3588 G3772” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 11 12”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 13”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 14”}, \wj Father, the hour is come; glorify thy Son, that thy Son also may glorify thee:\wj* 
\v 2 \wj As thou hast given him power over all flesh, that he should give eternal life to as many as thou hast given him.\wj* 
\v 3 \wj And this is life eternal, that they might know thee the only true God, and Jesus Christ, whom thou hast sent.\wj* 
\v 4 \wj I have glorified thee on the earth: I have finished the work which thou gavest me to do.\wj* 
\v 5 \wj And now, O Father, glorify thou me with thine own self with the glory which I had with thee before the world was.\wj* 
\v 6 \wj I have manifested thy name unto the men which thou gavest me out of the world: thine they were, and thou gavest them me; and they have kept thy word.\wj* 
\v 7 \wj Now they have known that all things whatsoever thou hast given me are of thee.\wj* 
\v 8 \wj For I have given unto them the words which thou gavest me; and they have received them, and have known surely that I came out from thee, and they have believed that thou didst send me.\wj* 
\v 9 \wj I pray for them: I pray not for the world, but for them which thou hast given me; for they are thine.\wj* 
\v 10 \wj And all mine are thine, and thine are mine; and I am glorified in them.\wj* 
\v 11 \wj And now I am no more in the world, but these are in the world, and I come to thee. Holy Father, keep through thine own name those whom thou hast given me, that they may be one, as we are.\wj* 
\v 12 \wj While I was with them in the world, I kept them in thy name: those that thou gavest me I have kept, and none of them is lost, but the son of perdition; that the scripture might be fulfilled.\wj* 
\v 13 \wj And now come I to thee; and these things I speak in the world, that they might have my joy fulfilled in themselves.\wj* 
\v 14 \wj I have given them thy word; and the world hath hated them, because they are not of the world, even as I am not of the world.\wj* 
\v 15 \wj I pray not that thou shouldest take them out of the world, but that thou shouldest keep them from the evil.\wj* 
\v 16 \wj They are not of the world, even as I am not of the world.\wj* 
\v 17 \wj Sanctify them through thy truth: thy word is truth.\wj* 
\v 18 \wj As thou hast sent me into the world, even so have I also sent them into the world.\wj* 
\v 19 \wj And for their sakes I sanctify myself, that they also might be sanctified through the truth.\wj* 
\v 20 \wj Neither pray I for these alone, but for them also which shall believe on me through their word;\wj* 
\v 21 \wj That they all may be one; as thou, Father, art in me, and I in thee, that they also may be one in us: that the world may believe that thou hast sent me.\wj* 
\v 22 \wj And the glory which thou gavest me I have given them; that they may be one, even as we are one:\wj* 
\v 23 \wj I in them, and thou in me, that they may be made perfect in one; and that the world may know that thou hast sent me, and hast loved them, as thou hast loved me.\wj* 
\v 24 \wj Father, I will that they also, whom thou hast given me, be with me where I am; that they may behold my glory, which thou hast given me: for thou lovedst me before the foundation of the world.\wj* 
\v 25 \wj O righteous Father, the world hath not known thee: but I have known thee, and these have known that thou hast sent me.\wj* 
\v 26 \wj And I have declared unto them thy name, and will declare it: that the love wherewith thou hast loved me may be in them, and I in them.\wj* 
\c 18
\p 
\v 1 [When Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [had spoken]{strong=“G2036” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”} [these words]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 1”}, [he went forth]{strong=“G1831” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [with]{strong=“G4862” x-morph=“robinson: \sc Prep\sc* 6”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 9”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 7 8”} [over]{strong=“G4008” x-morph=“robinson: \sc Adv\sc* 10”} [the brook]{strong=“G3588 G5493” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 11 12”} [Cedron]{strong=“G2748” x-morph=“robinson: N-\sc Pri\sc* 14”}, [where]{strong=“G3699” x-morph=“robinson: \sc Adv\sc* 15”} [was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 16”} [a garden]{strong=“G2779” x-morph=“robinson: N-\sc Nsm\sc* 17”}, [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 18”} [the which]{strong=“G3739” x-morph=“robinson: R-\sc Asm\sc* 19”} [he]{strong=“G846” x-morph=“robinson: P-\sc Nsm\sc* 21”} [entered]{strong=“G1525” x-morph=“robinson: V-2\sc Aai\sc*-3S 20”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 22”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 25”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 23 24”}. 
\v 2 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Judas]{strong=“G2455” x-morph=“robinson: N-\sc Nsm\sc* 4”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 3”}, [which]{strong=“G3588” x-morph=“robinson: T-\sc Nsm\sc* 5”} [betrayed]{strong=“G3860” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 6”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 7”}, [knew]{strong=“G1492” x-morph=“robinson: V-\sc Lai\sc*-3S 1”} [the place]{strong=“G3588 G5117” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 8 9”}: [for]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 10”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 13 14”} [ofttimes]{strong=“G4178” x-morph=“robinson: \sc Adv\sc* 11”} [resorted]{strong=“G4863” x-morph=“robinson: V-\sc Api\sc*-3S 12”} [thither]{strong=“G1563” x-morph=“robinson: \sc Adv\sc* 15”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 16”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 19”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 17 18”}. 
