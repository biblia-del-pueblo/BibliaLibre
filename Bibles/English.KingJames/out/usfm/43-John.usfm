\v 23 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 3”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 4”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 6”}, \wj The hour is come, that the Son of man should be glorified.\wj* 
\v 24 \wj Verily, verily, I say unto you, Except a corn of wheat fall into the ground and die, it abideth alone: but if it die, it bringeth forth much fruit.\wj* 
\v 25 \wj He that loveth his life shall lose it; and he that hateth his life in this world shall keep it unto life eternal.\wj* 
\v 26 \wj If any man serve me, let him follow me; and where I am, there shall also my servant be: if any man serve me, him will my Father honour.\wj* 
\v 27 \wj Now is my soul troubled; and what shall I say? Father, save me from this hour: but for this cause came I unto this hour.\wj* 
\v 28 \wj Father, glorify thy name.\wj* [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 7”} [came there]{strong=“G2064” x-morph=“robinson: V-2\sc Aai\sc*-3S 6”} [a voice]{strong=“G5456” x-morph=“robinson: N-\sc Nsf\sc* 8”} [from]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 9”} [heaven]{strong=“G3588 G3772” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 10 11”}, saying, [I have]{strong=“G1392” x-morph=“robinson: V-\sc Aai\sc*-1S 13”} [both]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”} [glorified]{strong=“G1392” x-morph=“robinson: V-\sc Aai\sc*-1S 13”} it, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [will glorify]{strong=“G1392” x-morph=“robinson: V-\sc Fai\sc*-1S 16”} it [again]{strong=“G3825” x-morph=“robinson: \sc Adv\sc* 15”}. 
\v 29 [The people]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [therefore]{strong=“G3793” x-morph=“robinson: N-\sc Nsm\sc* 3”}, [that stood by]{strong=“G2476” x-morph=“robinson: V-\sc Rap\sc*-\sc Nsm\sc* 5”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 7”} it, [said that]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 8”} [it]{strong=“G1096” x-morph=“robinson: V-2\sc Ran\sc* 10”} [thundered]{strong=“G1027” x-morph=“robinson: N-\sc Asf\sc* 9”}: [others]{strong=“G243” x-morph=“robinson: A-\sc Npm\sc* 11”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3P 12”}, [An angel]{strong=“G32” x-morph=“robinson: N-\sc Nsm\sc* 13”} [spake]{strong=“G2980” x-morph=“robinson: V-\sc Rai\sc*-3S 15”} [to him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 14”}. 
