\v 32 [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj Verily, verily, I say unto you, Moses gave you not that bread from heaven; but my Father giveth you the true bread from heaven.\wj* 
\v 33 \wj For the bread of God is he which cometh down from heaven, and giveth life unto the world.\wj* 
\v 34 [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [said they]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 1”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 4”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 5”}, [evermore]{strong=“G3842” x-morph=“robinson: \sc Adv\sc* 6”} [give]{strong=“G1325” x-morph=“robinson: V-2\sc Aam\sc*-2S 7”} [us]{strong=“G2254” x-morph=“robinson: P-1\sc Dp\sc* 8”} [this]{strong=“G5126” x-morph=“robinson: D-\sc Asm\sc* 11”} [bread]{strong=“G3588 G740” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 9 10”}. 
\v 35 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj I am the bread of life: he that cometh to me shall never hunger; and he that believeth on me shall never thirst.\wj* 
\v 36 \wj But I said unto you, That ye also have seen me, and believe not.\wj* 
\v 37 \wj All that the Father giveth me shall come to me; and him that cometh to me I will in no wise cast out.\wj* 
\v 38 \wj For I came down from heaven, not to do mine own will, but the will of him that sent me.\wj* 
\v 39 \wj And this is the Father’s will which hath sent me, that of all which he hath given me I should lose nothing, but should raise it up again at the last day.\wj* 
\v 40 \wj And this is the will of him that sent me, that every one which seeth the Son, and believeth on him, may have everlasting life: and I will raise him up at the last day.\wj* 
\v 41 [The Jews]{strong=“G2453” x-morph=“robinson: A-\sc Npm\sc* 4”} [then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [murmured]{strong=“G1111” x-morph=“robinson: V-\sc Iai\sc*-3P 1”} [at]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 5”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 6”}, [because]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 7”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 8”}, [I]{strong=“G1473” x-morph=“robinson: P-1\sc Ns\sc* 9”} [am]{strong=“G1510” x-morph=“robinson: V-\sc Pxi\sc*-1S 10”} [the bread]{strong=“G3588 G740” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 11 12”} [which came down]{strong=“G2597” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 14”} [from]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 15”} [heaven]{strong=“G3588 G3772” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 16 17”}. 
\v 42 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3P 2”}, [Is]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 5”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 3”} [this]{strong=“G3778” x-morph=“robinson: D-\sc Nsm\sc* 4”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 6”}, [the son]{strong=“G3588 G5207” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 7 8”} [of Joseph]{strong=“G2501” x-morph=“robinson: N-\sc Pri\sc* 9”}, [whose]{strong=“G3739” x-morph=“robinson: R-\sc Gsm\sc* 10”} [father]{strong=“G3588 G3962” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 13 14”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 15”} [mother]{strong=“G3588 G3384” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 16 17”} [we]{strong=“G2249” x-morph=“robinson: P-1\sc Np\sc* 11”} [know]{strong=“G1492” x-morph=“robinson: V-\sc Rai\sc*-1P 12”}? [how]{strong=“G4459” x-morph=“robinson: \sc Adv\sc*-I 18”} [is it then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 19”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 22”} [he]{strong=“G3778” x-morph=“robinson: D-\sc Nsm\sc* 21”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 20”}, [I came down]{strong=“G2597” x-morph=“robinson: V-\sc Rai\sc*-1S 26”} [from]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 23”} [heaven]{strong=“G3588 G3772” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 24 25”}? 
\v 43 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [therefore]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 1”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 6”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 7”}, \wj Murmur not among yourselves.\wj* 
\v 44 \wj No man can come to me, except the Father which hath sent me draw him: and I will raise him up at the last day.\wj* 
\v 45 \wj It is written in the prophets, And they shall be all taught of God. Every man therefore that hath heard, and hath learned of the Father, cometh unto me.\wj* 
\v 46 \wj Not that any man hath seen the Father, save he which is of God, he hath seen the Father.\wj* 
\v 47 \wj Verily, verily, I say unto you, He that believeth on me hath everlasting life.\wj* 
\v 48 \wj I am that bread of life.\wj* 
\v 49 \wj Your fathers did eat manna in the wilderness, and are dead.\wj* 
\v 50 \wj This is the bread which cometh down from heaven, that a man may eat thereof, and not die.\wj* 
\v 51 \wj I am the living bread which came down from heaven: if any man eat of this bread, he shall live for ever: and the bread that I will give is my flesh, which I will give for the life of the world.\wj* 
\v 52 [The Jews]{strong=“G2453” x-morph=“robinson: A-\sc Npm\sc* 6”} [therefore]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [strove]{strong=“G3164” x-morph=“robinson: V-\sc Ini\sc*-3P 1”} [among]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [themselves]{strong=“G240” x-morph=“robinson: C-\sc Apm\sc* 4”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 7”}, [How]{strong=“G4459” x-morph=“robinson: \sc Adv\sc*-I 8”} [can]{strong=“G1410” x-morph=“robinson: V-\sc Pni\sc*-3S 9”} [this man]{strong=“G3778” x-morph=“robinson: D-\sc Nsm\sc* 10”} [give]{strong=“G1325” x-morph=“robinson: V-2\sc Aan\sc* 12”} [us]{strong=“G2254” x-morph=“robinson: P-1\sc Dp\sc* 11”} his [flesh]{strong=“G3588 G4561” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 13 14”} [to eat]{strong=“G5315” x-morph=“robinson: V-2\sc Aan\sc* 15”}? 
\v 53 [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj Verily, verily, I say unto you, Except ye eat the flesh of the Son of man, and drink his blood, ye have no life in you.\wj* 
\v 54 \wj Whoso eateth my flesh, and drinketh my blood, hath eternal life; and I will raise him up at the last day.\wj* 
\v 55 \wj For my flesh is meat indeed, and my blood is drink indeed.\wj* 
\v 56 \wj He that eateth my flesh, and drinketh my blood, dwelleth in me, and I in him.\wj* 
\v 57 \wj As the living Father hath sent me, and I live by the Father: so he that eateth me, even he shall live by me.\wj* 
\v 58 \wj This is that bread which came down from heaven: not as your fathers did eat manna, and are dead: he that eateth of this bread shall live for ever.\wj* 
\v 59 [These things]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 1”} [said he]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 3”} [the synagogue]{strong=“G4864” x-morph=“robinson: N-\sc Dsf\sc* 4”}, [as he taught]{strong=“G1321” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 5”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 6”} [Capernaum]{strong=“G2584” x-morph=“robinson: N-\sc Pri\sc* 7”}. 
\v 60 [Many]{strong=“G4183” x-morph=“robinson: A-\sc Npm\sc* 1”} [therefore]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [of]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 4”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 7”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 5 6”}, [when they had heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 3”} this, [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 8”}, [This]{strong=“G3778” x-morph=“robinson: D-\sc Nsm\sc* 11”} [is]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 10”} [an]{strong=“G3588 G3056” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 12 13”} [hard]{strong=“G4642” x-morph=“robinson: A-\sc Nsm\sc* 9”} [saying]{strong=“G3056” x-morph=“robinson: N-\sc Nsm\sc* 13”}; [who]{strong=“G5101” x-morph=“robinson: I-\sc Nsm\sc* 14”} [can]{strong=“G1410” x-morph=“robinson: V-\sc Pni\sc*-3S 15”} [hear]{strong=“G191” x-morph=“robinson: V-\sc Pan\sc* 17”} [it]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 16”}? 
\v 61 [When]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [knew]{strong=“G1492” x-morph=“robinson: V-\sc Rap\sc*-\sc Nsm\sc* 1”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 5”} [himself]{strong=“G1438” x-morph=“robinson: F-3\sc Dsm\sc* 6”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 7”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 13”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 11 12”} [murmured]{strong=“G1111” x-morph=“robinson: V-\sc Pai\sc*-3P 8”} [at]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 9”} [it]{strong=“G5127” x-morph=“robinson: D-\sc Gsm\sc* 10”}, [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 14”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 15”}, \wj Doth this offend you?\wj* 
\v 62 \wj What and if ye shall see the Son of man ascend up where he was before?\wj* 
\v 63 \wj It is the spirit that quickeneth; the flesh profiteth nothing: the words that I speak unto you, they are spirit, and they are life.\wj* 
\v 64 \wj But there are some of you that believe not.\wj* [For]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 10”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 13 14”} [knew]{strong=“G1492” x-morph=“robinson: V-\sc Lai\sc*-3S 9”} [from]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 11”} [the beginning]{strong=“G746” x-morph=“robinson: N-\sc Gsf\sc* 12”} [who]{strong=“G5101” x-morph=“robinson: I-\sc Npm\sc* 15”} [they were]{strong=“G1526” x-morph=“robinson: V-\sc Pxi\sc*-3P 16”} [that believed]{strong=“G4100” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 19”} [not]{strong=“G3361” x-morph=“robinson: \sc Prt\sc*-N 18”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 20”} [who]{strong=“G5101” x-morph=“robinson: I-\sc Nsm\sc* 21”} [should]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 22”} [betray]{strong=“G3860” x-morph=“robinson: V-\sc Fap\sc*-\sc Nsm\sc* 24”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 25”}. 
\v 65 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 2”}, \wj Therefore said I unto you, that no man can come unto me, except it were given unto him of my Father.\wj* 
\p
\v 66 [From]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 1”} [that]{strong=“G5127” x-morph=“robinson: D-\sc Gsm\sc* 2”} time [many]{strong=“G4183” x-morph=“robinson: A-\sc Npm\sc* 3”} [of]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 5 6”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 7”} [disciples]{strong=“G3101” x-morph=“robinson: N-\sc Gpm\sc* 6”} [went]{strong=“G565” x-morph=“robinson: V-2\sc Aai\sc*-3P 4”} [back]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 8”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [walked]{strong=“G4043” x-morph=“robinson: V-\sc Iai\sc*-3P 15”} [no more]{strong=“G3765” x-morph=“robinson: \sc Adv\sc* 12”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 13”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 14”}. 
