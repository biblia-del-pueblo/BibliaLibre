\v 10 \w And Joshua| strong="H3091" \w* [had commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w the people| strong="H5971" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Ye shall not shout]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8686”}, [nor make any noise]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8686”} \w with your voice| strong="H6963" \w*, neither shall any \w word| strong="H1697" \w* [proceed]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of your mouth| strong="H6310" \w*, \w until the day| strong="H3117" \w* [I bid]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} [you shout]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8685”}; [then shall ye shout]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8689”}.\f + \fr 6:10 \ft any noise…: Heb. your voice to be heard \f* 
\v 11 \w So the ark| strong="H727" \w* of the \sc Lord\sc* [compassed]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8686”} \w the city| strong="H5892" \w*, [going about]{strong=“H5362” x-morph=“strongMorph: \sc Th\sc*8687”} it [once]{strong=“H259 H6471”}: [and they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the camp| strong="H4264" \w*, [and lodged]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the camp| strong="H4264" \w*. 
