\c 14
\p 
\v 1 And these are the countries \w which the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [inherited ]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*, \w which Eleazar| strong="H499" \w* \w the priest| strong="H3548" \w*, \w and Joshua| strong="H3091" \w* \w the son| strong="H1121" \w* \w of Nun| strong="H5126" \w*, \w and the heads| strong="H7218" \w* \w of the fathers| strong="H1" \w* \w of the tribes| strong="H4294" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [distributed for inheritance]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8765”} to them. 
\v 2 \w By lot| strong="H1486" \w* was \w their inheritance| strong="H5159" \w*, as the \sc Lord\sc* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w by the hand| strong="H3027" \w* \w of Moses| strong="H4872" \w*, \w for the nine| strong="H8672" \w* \w tribes| strong="H4294" \w*, and for \w the half| strong="H2677" \w* \w tribe| strong="H4294" \w*. 
\v 3 \w For Moses| strong="H4872" \w* [had given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w the inheritance| strong="H5159" \w* \w of two| strong="H8147" \w* \w tribes| strong="H4294" \w* \w and an half| strong="H2677" \w* \w tribe| strong="H4294" \w* \w on the other side| strong="H5676" \w* \w Jordan| strong="H3383" \w*: \w but unto the Levites| strong="H3881" \w* [he gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w none inheritance| strong="H5159" \w* \w among| strong="H8432" \w* them. 
\v 4 \w For the children| strong="H1121" \w* \w of Joseph| strong="H3130" \w* \w were two| strong="H8147" \w* \w tribes| strong="H4294" \w*, \w Manasseh| strong="H4519" \w* \w and Ephraim| strong="H669" \w*: [therefore they gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w no part| strong="H2506" \w* \w unto the Levites| strong="H3881" \w* \w in the land| strong="H776" \w*, \w save cities| strong="H5892" \w* [to dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} in, \w with their suburbs| strong="H4054" \w* \w for their cattle| strong="H4735" \w* \w and for their substance| strong="H7075" \w*. 
\v 5 As the \sc Lord\sc* [commanded ]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w Moses| strong="H4872" \w*, \w so the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [and they divided]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8799”} \w the land| strong="H776" \w*. 
\p
\v 6 \w Then the children| strong="H1121" \w* \w of Judah| strong="H3063" \w* [came]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Joshua| strong="H3091" \w* \w in Gilgal| strong="H1537" \w*: \w and Caleb| strong="H3612" \w* \w the son| strong="H1121" \w* \w of Jephunneh| strong="H3312" \w* \w the Kenezite| strong="H7074" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w the thing| strong="H1697" \w* that the \sc Lord\sc* [said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto Moses| strong="H4872" \w* \w the man| strong="H376" \w* \w of God| strong="H430" \w* \w concerning me| strong="H182" \w* \w and thee| strong="H182" \w* [in Kadesh-barnea]{strong=“H6947”}. 
\v 7 \w Forty| strong="H705" \w* \w years| strong="H8141" \w* \w old| strong="H1121" \w* was \w I when Moses| strong="H4872" \w* \w the servant| strong="H5650" \w* of the \sc Lord\sc* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8800”} [me from Kadesh-barnea]{strong=“H6947”} [to espy out]{strong=“H7270” x-morph=“strongMorph: \sc Th\sc*8763”} \w the land| strong="H776" \w*; \w and I brought| strong="H7725" \w* \w him word| strong="H1697" \w* [again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} as it was \w in mine heart| strong="H3824" \w*. 
