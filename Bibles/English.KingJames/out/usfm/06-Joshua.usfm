\v 28 [Therefore said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} we, that it shall be, when they should so [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to us or to our generations| strong="H1755" \w* \w in time to come| strong="H4279" \w*, [that we may say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} again, [Behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w the pattern| strong="H8403" \w* \w of the altar| strong="H4196" \w* of the \sc Lord\sc*, \w which our fathers| strong="H1" \w* [made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, \w not for burnt offerings| strong="H5930" \w*, \w nor for sacrifices| strong="H2077" \w*; but it is \w a witness| strong="H5707" \w* between us and you. 
\v 29 \w God forbid| strong="H2486" \w* [that we should rebel]{strong=“H4775” x-morph=“strongMorph: \sc Th\sc*8800”} against the \sc Lord\sc*, [and turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w this day| strong="H3117" \w* \w from following| strong="H310" \w* the \sc Lord\sc*, [to build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8800”} \w an altar| strong="H4196" \w* \w for burnt offerings| strong="H5930" \w*, \w for meat offerings| strong="H4503" \w*, \w or for sacrifices| strong="H2077" \w*, \w beside the altar| strong="H4196" \w* of the \sc Lord\sc* \w our God| strong="H430" \w* that is \w before| strong="H6440" \w* \w his tabernacle| strong="H4908" \w*. 
\p
\v 30 \w And when Phinehas| strong="H6372" \w* \w the priest| strong="H3548" \w*, \w and the princes| strong="H5387" \w* \w of the congregation| strong="H5712" \w* \w and heads| strong="H7218" \w* \w of the thousands| strong="H505" \w* \w of Israel| strong="H3478" \w* which were [with him, heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w the words| strong="H1697" \w* \w that the children| strong="H1121" \w* \w of Reuben| strong="H7205" \w* \w and the children| strong="H1121" \w* \w of Gad| strong="H1410" \w* \w and the children| strong="H1121" \w* \w of Manasseh| strong="H4519" \w* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}, [it pleased]{strong=“H5869 H3190” x-morph=“strongMorph: \sc Th\sc*8799”} them.\f + \fr 22:30 \ft pleased…: Heb. was good in their eyes \f* 
\v 31 \w And Phinehas| strong="H6372" \w* \w the son| strong="H1121" \w* \w of Eleazar| strong="H499" \w* \w the priest| strong="H3548" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the children| strong="H1121" \w* \w of Reuben| strong="H7205" \w*, \w and to the children| strong="H1121" \w* \w of Gad| strong="H1410" \w*, \w and to the children| strong="H1121" \w* \w of Manasseh| strong="H4519" \w*, \w This day| strong="H3117" \w* [we perceive]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that the \sc Lord\sc* is \w among| strong="H8432" \w* [us, because ye have not committed]{strong=“H4603” x-morph=“strongMorph: \sc Th\sc*8804”} \w this trespass| strong="H4604" \w* against the \sc Lord\sc*: \w now| strong="H227" \w* [ye have delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* \w out of the hand| strong="H3027" \w* of the \sc Lord\sc*.\f + \fr 22:31 \ft now: Heb. then \f* 
\p
\v 32 \w And Phinehas| strong="H6372" \w* \w the son| strong="H1121" \w* \w of Eleazar| strong="H499" \w* \w the priest| strong="H3548" \w*, \w and the princes| strong="H5387" \w*, [returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the children| strong="H1121" \w* \w of Reuben| strong="H7205" \w*, \w and from the children| strong="H1121" \w* \w of Gad| strong="H1410" \w*, \w out of the land| strong="H776" \w* \w of Gilead| strong="H1568" \w*, \w unto the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*, \w to the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, \w and brought| strong="H7725" \w* \w them word| strong="H1697" \w* [again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 33 \w And the thing| strong="H1697" \w* [pleased ]{strong=“H5869 H3190” x-morph=“strongMorph: \sc Th\sc*8799”} \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*; \w and the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w God| strong="H430" \w*, [and did not intend]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [to go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8800”} \w against them in battle| strong="H6635" \w*, [to destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8763”} \w the land| strong="H776" \w* \w wherein the children| strong="H1121" \w* \w of Reuben| strong="H7205" \w* \w and Gad| strong="H1410" \w* [dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 34 \w And the children| strong="H1121" \w* \w of Reuben| strong="H7205" \w* \w and the children| strong="H1121" \w* \w of Gad| strong="H1410" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w the altar| strong="H4196" \w* Ed: for it shall be \w a witness| strong="H5707" \w* between us that the \sc Lord\sc* is \w God| strong="H430" \w*.\f + \fr 22:34 \ft Ed: that is, A witness \f*
\c 23
\p 
\v 1 \w And it came to pass a long| strong="H7227" \w* \w time| strong="H3117" \w* \w after| strong="H310" \w* that the \sc Lord\sc* [had given rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8689”} \w unto Israel| strong="H3478" \w* [from all their enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w round about| strong="H5439" \w*, \w that Joshua| strong="H3091" \w* [waxed old]{strong=“H2204” x-morph=“strongMorph: \sc Th\sc*8804”} and [stricken]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w in age| strong="H3117" \w*.\f + \fr 23:1 \ft stricken…: Heb. come into days \f* 
\v 2 \w And Joshua| strong="H3091" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w for all Israel| strong="H3478" \w*, and \w for their elders| strong="H2205" \w*, \w and for their heads| strong="H7218" \w*, [and for their judges]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”}, [and for their officers]{strong=“H7860” x-morph=“strongMorph: \sc Th\sc*8802”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, I am old]{strong=“H2204” x-morph=“strongMorph: \sc Th\sc*8804”} and [stricken]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w in age| strong="H3117" \w*: 
\v 3 [And ye have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} all that the \sc Lord\sc* \w your God| strong="H430" \w* [hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto all these nations| strong="H1471" \w* \w because| strong="H6440" \w* of you; for the \sc Lord\sc* \w your God| strong="H430" \w* is [he that hath fought]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8737”} for you. 
\v 4 [Behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}, [I have divided]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8689”} \w unto you by lot these nations| strong="H1471" \w* [that remain]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”}, \w to be an inheritance| strong="H5159" \w* \w for your tribes| strong="H7626" \w*, \w from Jordan| strong="H3383" \w*, \w with all the nations| strong="H1471" \w* [that I have cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”}, \w even unto the great| strong="H1419" \w* \w sea| strong="H3220" \w* [westward]{strong=“H8121 H3996”}.\f + \fr 23:4 \ft westward: Heb. at the sunset \f* 
\v 5 And the \sc Lord\sc* \w your God| strong="H430" \w*, [he shall expel]{strong=“H1920” x-morph=“strongMorph: \sc Th\sc*8799”} \w them from before| strong="H6440" \w* [you, and drive]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8689”} \w them from out of your sight| strong="H6440" \w*; [and ye shall possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8804”} \w their land| strong="H776" \w*, as the \sc Lord\sc* \w your God| strong="H430" \w* [hath promised]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} unto you. 
\v 6 \w Be ye therefore very| strong="H3966" \w* [courageous ]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8804”} [to keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} [and to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [all that is written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8803”} \w in the book| strong="H5612" \w* \w of the law| strong="H8451" \w* \w of Moses| strong="H4872" \w*, [that ye turn]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8800”} not aside therefrom to \w the right hand| strong="H3225" \w* or to \w the left| strong="H8040" \w*; 
\v 7 [That ye come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w not among these nations| strong="H1471" \w*, [these that remain]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”} [among you; neither make mention]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8686”} \w of the name| strong="H8034" \w* \w of their gods| strong="H430" \w*, [nor cause to swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8686”} by them, [neither serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} [them, nor bow]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} yourselves unto them: 
\v 8 [But cleave]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc* \w your God| strong="H430" \w*, [as ye have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto this day| strong="H3117" \w*.\f + \fr 23:8 \ft But cleave…: or, For if ye will cleave, etc \f* 
\v 9 For the \sc Lord\sc* [hath driven out]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8686”} \w from before| strong="H6440" \w* \w you great| strong="H1419" \w* \w nations| strong="H1471" \w* \w and strong| strong="H6099" \w*: but as for [you, no man]{strong=“H376”} [hath been able to stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* \w you unto this day| strong="H3117" \w*.^\sc 23:9 For the [Lord\sc*…: or, Then the \sc Lord\sc* will drive] 
\v 10 \w One| strong="H259" \w* \w man| strong="H376" \w* [of you shall chase]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} \w a thousand| strong="H505" \w*: for the \sc Lord\sc* \w your God| strong="H430" \w*, he it is [that fighteth]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8737”} [for you, as he hath promised]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} you. 
\p
\v 11 \w Take good| strong="H3966" \w* [heed]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8738”} \w therefore unto yourselves| strong="H5315" \w*, [that ye love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8800”} the \sc Lord\sc* \w your God| strong="H430" \w*.\f + \fr 23:11 \ft yourselves: Heb. your souls \f* 
\v 12 [Else if ye do in any wise]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} [go back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [and cleave]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the remnant| strong="H3499" \w* \w of these nations| strong="H1471" \w*, even [these that remain]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”} [among you, and shall make marriages]{strong=“H2859” x-morph=“strongMorph: \sc Th\sc*8694”} [with them, and go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} unto them, and they to you: 
\v 13 [Know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [for a certainty]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} that the \sc Lord\sc* \w your God| strong="H430" \w* [will no more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [drive out]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8687”} any of \w these nations| strong="H1471" \w* \w from before| strong="H6440" \w* [you; but they shall be snares]{strong=“H6341”} \w and traps| strong="H4170" \w* [unto you, and scourges]{strong=“H7850”} \w in your sides| strong="H6654" \w*, \w and thorns| strong="H6796" \w* \w in your eyes| strong="H5869" \w*, [until ye perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8800”} \w from off this good| strong="H2896" \w* \w land| strong="H127" \w* which the \sc Lord\sc* \w your God| strong="H430" \w* [hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} you. 
\v 14 [And, behold, this day]{strong=“H3117”} I am [going]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w the way| strong="H1870" \w* \w of all the earth| strong="H776" \w*: [and ye know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w in all your hearts| strong="H3824" \w* \w and in all your souls| strong="H5315" \w*, \w that not one| strong="H259" \w* \w thing| strong="H1697" \w* [hath failed]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} \w of all the good| strong="H2896" \w* \w things| strong="H1697" \w* which the \sc Lord\sc* \w your God| strong="H430" \w* [spake ]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [concerning you; all are come to pass]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} unto you, and \w not one| strong="H259" \w* \w thing| strong="H1697" \w* [hath failed]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} thereof. 
\v 15 Therefore it shall come to pass, that \w as all good| strong="H2896" \w* \w things| strong="H1697" \w* [are come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} upon you, which the \sc Lord\sc* \w your God| strong="H430" \w* [promised]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} you; so shall the \sc Lord\sc* [bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w upon you all evil| strong="H7451" \w* \w things| strong="H1697" \w*, [until he have destroyed]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8687”} \w you from off this good| strong="H2896" \w* \w land| strong="H127" \w* which the \sc Lord\sc* \w your God| strong="H430" \w* [hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} you. 
\v 16 [When ye have transgressed]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8800”} \w the covenant| strong="H1285" \w* of the \sc Lord\sc* \w your God| strong="H430" \w*, [which he commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [you, and have gone]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} [and served]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} \w other| strong="H312" \w* \w gods| strong="H430" \w*, [and bowed]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8694”} [yourselves to them; then shall the anger]{strong=“H639”} of the \sc Lord\sc* [be kindled]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8804”} [against you, and ye shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”} \w quickly| strong="H4120" \w* \w from off the good| strong="H2896" \w* \w land| strong="H776" \w* [which he hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} unto you.
\c 24
\p 
\v 1 \w And Joshua| strong="H3091" \w* [gathered]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the tribes| strong="H7626" \w* \w of Israel| strong="H3478" \w* \w to Shechem| strong="H7927" \w*, [and called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w for the elders| strong="H2205" \w* \w of Israel| strong="H3478" \w*, \w and for their heads| strong="H7218" \w*, [and for their judges]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”}, [and for their officers]{strong=“H7860” x-morph=“strongMorph: \sc Th\sc*8802”}; [and they presented]{strong=“H3320” x-morph=“strongMorph: \sc Th\sc*8691”} \w themselves before| strong="H6440" \w* \w God| strong="H430" \w*. 
\v 2 \w And Joshua| strong="H3091" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto all the people| strong="H5971" \w*, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w*, \w Your fathers| strong="H1" \w* [dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w on the other side| strong="H5676" \w* \w of the flood| strong="H5104" \w* \w in old time| strong="H5769" \w*, even \w Terah| strong="H8646" \w*, \w the father| strong="H1" \w* \w of Abraham| strong="H85" \w*, \w and the father| strong="H1" \w* \w of Nachor| strong="H5152" \w*: [and they served]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} \w other| strong="H312" \w* \w gods| strong="H430" \w*. 
\v 3 [And I took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w your father| strong="H1" \w* \w Abraham| strong="H85" \w* \w from the other side| strong="H5676" \w* \w of the flood| strong="H5104" \w*, [and led]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8686”} \w him throughout all the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*, [and multiplied]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} \w his seed| strong="H2233" \w*, [and gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w him Isaac| strong="H3327" \w*. 
