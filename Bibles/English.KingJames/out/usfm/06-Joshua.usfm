\v 13 \w Nevertheless the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [expelled]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8689”} \w not the Geshurites| strong="H1651" \w*, \w nor the Maachathites| strong="H4602" \w*: \w but the Geshurites| strong="H1650" \w* \w and the Maachathites| strong="H4601" \w* [dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w among| strong="H7130" \w* \w the Israelites| strong="H3478" \w* \w until this day| strong="H3117" \w*. 
\v 14 \w Only unto the tribe| strong="H7626" \w* \w of Levi| strong="H3878" \w* [he gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w none inheritance| strong="H5159" \w*; \w the sacrifices| strong="H801" \w* of the \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w* \w made by fire| strong="H801" \w* are \w their inheritance| strong="H5159" \w*, [as he said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} unto them. 
\p
\v 15 \w And Moses| strong="H4872" \w* [gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the tribe| strong="H4294" \w* \w of the children| strong="H1121" \w* \w of Reuben| strong="H7205" \w* inheritance \w according to their families| strong="H4940" \w*. 
\v 16 \w And their coast| strong="H1366" \w* \w was from Aroer| strong="H6177" \w*, that is \w on the bank| strong="H8193" \w* \w of the river| strong="H5158" \w* \w Arnon| strong="H769" \w*, \w and the city| strong="H5892" \w* that is \w in the midst| strong="H8432" \w* \w of the river| strong="H5158" \w*, \w and all the plain| strong="H4334" \w* \w by Medeba| strong="H4311" \w*; 
\v 17 \w Heshbon| strong="H2809" \w*, \w and all her cities| strong="H5892" \w* that are \w in the plain| strong="H4334" \w*; \w Dibon| strong="H1769" \w*, [and Bamoth-baal]{strong=“H1120”}, [and Beth-baal-meon]{strong=“H1010”},\f + \fr 13:17 \ft Bamoth-baal…: or, the high places of Baal, and house of Baal-meon \f* 
