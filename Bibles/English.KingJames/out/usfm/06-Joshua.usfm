\c 8
\p 
\v 1 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Joshua| strong="H3091" \w*, [Fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [not, neither be thou dismayed]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8735”}: [take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w all the people| strong="H5971" \w* \w of war| strong="H4421" \w* [with thee, and arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”} \w to Ai| strong="H5857" \w*: [see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}, [I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w into thy hand| strong="H3027" \w* \w the king| strong="H4428" \w* \w of Ai| strong="H5857" \w*, \w and his people| strong="H5971" \w*, \w and his city| strong="H5892" \w*, \w and his land| strong="H776" \w*: 
