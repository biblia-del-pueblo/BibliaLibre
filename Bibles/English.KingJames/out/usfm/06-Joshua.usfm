\c 1
\p 
\v 1 \w Now after| strong="H310" \w* \w the death| strong="H4194" \w* \w of Moses| strong="H4872" \w* \w the servant| strong="H5650" \w* of the \sc Lord\sc* it came to pass, that the \sc Lord\sc* [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Joshua| strong="H3091" \w* \w the son| strong="H1121" \w* \w of Nun| strong="H5126" \w*, [Moses’]{strong=“H4872”} [minister]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8764”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Moses| strong="H4872" \w* \w my servant| strong="H5650" \w* [is dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}; [now therefore arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [go over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8798”} \w this Jordan| strong="H3383" \w*, [thou, and all this people]{strong=“H5971”}, \w unto the land| strong="H776" \w* [which I do give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} to them, even \w to the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*. 
\v 3 \w Every place| strong="H4725" \w* \w that the sole| strong="H3709" \w* \w of your foot| strong="H7272" \w* [shall tread upon]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8799”}, [that have I given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [unto you, as I said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto Moses| strong="H4872" \w*. 
\v 4 \w From the wilderness| strong="H4057" \w* \w and this Lebanon| strong="H3844" \w* \w even unto the great| strong="H1419" \w* \w river| strong="H5104" \w*, \w the river| strong="H5104" \w* \w Euphrates| strong="H6578" \w*, \w all the land| strong="H776" \w* \w of the Hittites| strong="H2850" \w*, \w and unto the great| strong="H1419" \w* \w sea| strong="H3220" \w* \w toward the going down| strong="H3996" \w* \w of the sun| strong="H8121" \w*, \w shall be your coast| strong="H1366" \w*. 
\v 5 \w There shall not any man| strong="H376" \w* [be able to stand]{strong=“H3320” x-morph=“strongMorph: \sc Th\sc*8691”} \w before| strong="H6440" \w* \w thee all the days| strong="H3117" \w* \w of thy life| strong="H2416" \w*: \w as I was with Moses| strong="H4872" \w*, so [I will be with thee: I will not fail]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8686”} [thee, nor forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} thee. 
\v 6 [Be strong]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8798”} [and of a good courage]{strong=“H553” x-morph=“strongMorph: \sc Th\sc*8798”}: \w for unto this people| strong="H5971" \w* [shalt thou divide for an inheritance]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8686”} \w the land| strong="H776" \w*, [which I sware]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto their fathers| strong="H1" \w* [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} them.\f + \fr 1:6 \ft unto this…: or, thou shalt cause this people to inherit the land, etc \f* 
\v 7 [Only be thou strong]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8798”} \w and very| strong="H3966" \w* [courageous]{strong=“H553” x-morph=“strongMorph: \sc Th\sc*8798”}, [that thou mayest observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w according to all the law| strong="H8451" \w*, \w which Moses| strong="H4872" \w* \w my servant| strong="H5650" \w* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [thee: turn]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8799”} not from it to \w the right hand| strong="H3225" \w* or to \w the left| strong="H8040" \w*, [that thou mayest prosper]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8686”} [whithersoever thou goest]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 1:7 \ft prosper: or, do wisely \f* 
\v 8 \w This book| strong="H5612" \w* \w of the law| strong="H8451" \w* [shall not depart]{strong=“H4185” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of thy mouth| strong="H6310" \w*; [but thou shalt meditate]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8804”} \w therein day| strong="H3119" \w* \w and night| strong="H3915" \w*, [that thou mayest observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [according to all that is written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8803”} [therein: for then thou shalt make]{strong=“H6743”} \w thy way| strong="H1870" \w* [prosperous]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8686”}, [and then thou shalt have good success]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8686”}.\f + \fr 1:8 \ft have…: or, do wisely \f* 
\v 9 [Have not I commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [thee? Be strong]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8798”} [and of a good courage]{strong=“H553” x-morph=“strongMorph: \sc Th\sc*8798”}; [be not afraid]{strong=“H6206” x-morph=“strongMorph: \sc Th\sc*8799”}, [neither be thou dismayed]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8735”}: for the \sc Lord\sc* \w thy God| strong="H430" \w* is [with thee whithersoever thou goest]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 10 \w Then Joshua| strong="H3091" \w* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} [the officers]{strong=“H7860” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the people| strong="H5971" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 11 [Pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8798”} \w through| strong="H7130" \w* \w the host| strong="H4264" \w*, [and command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8761”} \w the people| strong="H5971" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Prepare]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8685”} \w you victuals| strong="H6720" \w*; \w for within three| strong="H7969" \w* \w days| strong="H3117" \w* [ye shall pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} \w this Jordan| strong="H3383" \w*, [to go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [to possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} \w the land| strong="H776" \w*, which the \sc Lord\sc* \w your God| strong="H430" \w* [giveth ]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} [you to possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} it. 
\p
\v 12 \w And to the Reubenites| strong="H7206" \w*, \w and to the Gadites| strong="H1425" \w*, \w and to half| strong="H2677" \w* \w the tribe| strong="H7626" \w* \w of Manasseh| strong="H4519" \w*, [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w Joshua| strong="H3091" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 13 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8800”} \w the word| strong="H1697" \w* \w which Moses| strong="H4872" \w* \w the servant| strong="H5650" \w* of the \sc Lord\sc* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [you, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, The \sc Lord\sc* \w your God| strong="H430" \w* [hath given you rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8688”}, [and hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w you this land| strong="H776" \w*. 
\v 14 \w Your wives| strong="H802" \w*, \w your little ones| strong="H2945" \w*, \w and your cattle| strong="H4735" \w*, [shall remain]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the land| strong="H776" \w* \w which Moses| strong="H4872" \w* [gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w you on this side| strong="H5676" \w* \w Jordan| strong="H3383" \w*; [but ye shall pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* \w your brethren| strong="H251" \w* \w armed| strong="H2571" \w*, \w all the mighty| strong="H1368" \w* \w men of valour| strong="H2428" \w*, [and help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8804”} them;\f + \fr 1:14 \ft armed: Heb. marshalled by five \f* 
\v 15 Until the \sc Lord\sc* \w have given| strong="H5117" \w* \w your brethren| strong="H251" \w* [rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8686”}, as he hath given [you, and they also have possessed]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8804”} \w the land| strong="H776" \w* which the \sc Lord\sc* \w your God| strong="H430" \w* [giveth ]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} [them: then ye shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the land| strong="H776" \w* \w of your possession| strong="H3425" \w*, [and enjoy]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8804”} [it, which Moses]{strong=“H4872”} the \sc Lord\sc*’S \w servant| strong="H5650" \w* [gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w you on this side| strong="H5676" \w* \w Jordan| strong="H3383" \w* [toward the sunrising]{strong=“H8121 H4217”}. 
\p
\v 16 [And they answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w Joshua| strong="H3091" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [All that thou commandest]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [us we will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and whithersoever| strong="H834" \w* [thou sendest]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} [us, we will go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 17 [According as we hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto Moses| strong="H4872" \w* [in all things, so will we hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} unto thee: only the \sc Lord\sc* \w thy God| strong="H430" \w* [be with thee, as he was with Moses]{strong=“H4872”}. 
\v 18 \w Whosoever| strong="H376" \w* he be [that doth rebel]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8686”} \w against thy commandment| strong="H6310" \w*, [and will not hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto thy words| strong="H1697" \w* [in all that thou commandest]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} [him, he shall be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}: [only be strong]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8798”} [and of a good courage]{strong=“H553” x-morph=“strongMorph: \sc Th\sc*8798”}. 
\c 2
\p 
\v 1 \w And Joshua| strong="H3091" \w* \w the son| strong="H1121" \w* \w of Nun| strong="H5126" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of Shittim| strong="H7851" \w* \w two| strong="H8147" \w* \w men| strong="H582" \w* [to spy]{strong=“H7270” x-morph=“strongMorph: \sc Th\sc*8764”} \w secretly| strong="H2791" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} [view]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w the land| strong="H776" \w*, \w even Jericho| strong="H3405" \w*. [And they went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [into an harlot’s]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”} [house]{strong=“H1004 H802”}, \w named| strong="H8034" \w* \w Rahab| strong="H7343" \w*, [and lodged]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} there.\f + \fr 2:1 \ft sent: or, had sent \f* \f + \fr 2:1 \ft lodged: Heb. lay \f* 
\v 2 [And it was told]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8735”} \w the king| strong="H4428" \w* \w of Jericho| strong="H3405" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Behold, there came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w men| strong="H582" \w* \w in hither to night| strong="H3915" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [to search out]{strong=“H2658” x-morph=“strongMorph: \sc Th\sc*8800”} \w the country| strong="H776" \w*. 
\v 3 \w And the king| strong="H4428" \w* \w of Jericho| strong="H3405" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Rahab| strong="H7343" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Bring forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8685”} \w the men| strong="H582" \w* [that are come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [to thee, which are entered]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into thine house| strong="H1004" \w*: [for they be come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to search out]{strong=“H2658” x-morph=“strongMorph: \sc Th\sc*8800”} \w all the country| strong="H776" \w*. 
\v 4 \w And the woman| strong="H802" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the two| strong="H8147" \w* \w men| strong="H582" \w*, [and hid]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [thus, There came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w men| strong="H582" \w* [unto me, but I wist]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w not whence| strong="H370" \w* they were: 
\v 5 And it came to pass about the time [of shutting]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8800”} \w of the gate| strong="H8179" \w*, \w when it was dark| strong="H2822" \w*, \w that the men| strong="H582" \w* [went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”}: \w whither the men| strong="H582" \w* [went]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} [I wot]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [not: pursue]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8798”} \w after| strong="H310" \w* \w them quickly| strong="H4118" \w*; [for ye shall overtake]{strong=“H5381” x-morph=“strongMorph: \sc Th\sc*8686”} them. 
\v 6 [But she had brought them up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} \w to the roof| strong="H1406" \w* [of the house, and hid]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8799”} \w them with the stalks| strong="H6086" \w* \w of flax| strong="H6593" \w*, [which she had laid in order]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8803”} \w upon the roof| strong="H1406" \w*. 
\v 7 \w And the men| strong="H582" \w* [pursued]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8804”} \w after| strong="H310" \w* \w them the way| strong="H1870" \w* \w to Jordan| strong="H3383" \w* \w unto the fords| strong="H4569" \w*: [and as soon as they which pursued]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8802”} \w after| strong="H310" \w* [them were gone out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”}, [they shut]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8804”} \w the gate| strong="H8179" \w*. 
\p
\v 8 [And before they were laid down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”}, [she came up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto them upon the roof| strong="H1406" \w*; 
\v 9 [And she said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the men| strong="H582" \w*, [I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that the \sc Lord\sc* [hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w you the land| strong="H776" \w*, \w and that your terror| strong="H367" \w* [is fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} [upon us, and that all the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the land| strong="H776" \w* [faint]{strong=“H4127” x-morph=“strongMorph: \sc Th\sc*8738”} \w because| strong="H6440" \w* of you.\f + \fr 2:9 \ft faint: Heb. melt \f* 
\v 10 [For we have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} how the \sc Lord\sc* [dried up]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”} \w the water| strong="H4325" \w* \w of the Red| strong="H5488" \w* \w sea| strong="H3220" \w* \w for you| strong="H6440" \w*, [when ye came out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”} \w of Egypt| strong="H4714" \w*; [and what ye did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the two| strong="H8147" \w* \w kings| strong="H4428" \w* \w of the Amorites| strong="H567" \w*, that were \w on the other side| strong="H5676" \w* \w Jordan| strong="H3383" \w*, \w Sihon| strong="H5511" \w* \w and Og| strong="H5747" \w*, [whom ye utterly destroyed]{strong=“H2763” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\v 11 [And as soon as we had heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} these things, \w our hearts| strong="H3824" \w* [did melt]{strong=“H4549” x-morph=“strongMorph: \sc Th\sc*8735”}, [neither did there remain]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”} \w any more courage| strong="H7307" \w* \w in any man| strong="H376" \w*, \w because| strong="H6440" \w* of you: for the \sc Lord\sc* \w your God| strong="H430" \w*, he is \w God| strong="H430" \w* \w in heaven| strong="H8064" \w* \w above| strong="H4605" \w*, \w and in earth| strong="H776" \w* beneath.\f + \fr 2:11 \ft did there…: Heb. rose up \f* 
\v 12 [Now therefore, I pray you, swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8734”} unto me by the \sc Lord\sc*, \w since| strong="H3588" \w* [I have shewed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w you kindness| strong="H2617" \w*, [that ye will also shew]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w kindness| strong="H2617" \w* [unto my father’s]{strong=“H1”} \w house| strong="H1004" \w*, [and give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w me a true| strong="H571" \w* \w token| strong="H226" \w*: 
\v 13 And that [ye will save alive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8689”} \w my father| strong="H1" \w*, \w and my mother| strong="H517" \w*, \w and my brethren| strong="H251" \w*, \w and my sisters| strong="H269" \w*, [and all that they have, and deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w our lives| strong="H5315" \w* \w from death| strong="H4194" \w*. 
\v 14 \w And the men| strong="H582" \w* [answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [her, Our life]{strong=“H5315”} [for yours]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”}, [if ye utter]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w not this our business| strong="H1697" \w*. And it shall be, when the \sc Lord\sc* [hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w us the land| strong="H776" \w*, [that we will deal]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w kindly| strong="H2617" \w* \w and truly| strong="H571" \w* with thee.\f + \fr 2:14 \ft for…: Heb. instead of you to die \f* 
\v 15 [Then she let them down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8686”} \w by a cord| strong="H2256" \w* \w through| strong="H1157" \w* \w the window| strong="H2474" \w*: \w for her house| strong="H1004" \w* was \w upon the town| strong="H7023" \w* \w wall| strong="H2346" \w*, [and she dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the wall| strong="H2346" \w*. 
\v 16 [And she said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Get]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} \w you to the mountain| strong="H2022" \w*, [lest the pursuers]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8802”} [meet]{strong=“H6293” x-morph=“strongMorph: \sc Th\sc*8799”} [you; and hide]{strong=“H2247” x-morph=“strongMorph: \sc Th\sc*8738”} \w yourselves there three| strong="H7969" \w* \w days| strong="H3117" \w*, [until the pursuers]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8802”} [be returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”}: \w and afterward| strong="H310" \w* [may ye go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w your way| strong="H1870" \w*. 
\v 17 \w And the men| strong="H582" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto her, We will be \w blameless| strong="H5355" \w* \w of this thine oath| strong="H7621" \w* [which thou hast made us swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8689”}. 
