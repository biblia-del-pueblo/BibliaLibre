\v 2 This is \w the land| strong="H776" \w* [that yet remaineth]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”}: \w all the borders| strong="H1552" \w* \w of the Philistines| strong="H6430" \w*, \w and all Geshuri| strong="H1651" \w*, 
\v 3 \w From Sihor| strong="H7883" \w*, which is \w before| strong="H6440" \w* \w Egypt| strong="H4714" \w*, \w even unto the borders| strong="H1366" \w* \w of Ekron| strong="H6138" \w* \w northward| strong="H6828" \w*, which [is counted]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8735”} \w to the Canaanite| strong="H3669" \w*: \w five| strong="H2568" \w* \w lords| strong="H5633" \w* \w of the Philistines| strong="H6430" \w*; \w the Gazathites| strong="H5841" \w*, \w and the Ashdothites| strong="H796" \w*, \w the Eshkalonites| strong="H832" \w*, \w the Gittites| strong="H1663" \w*, \w and the Ekronites| strong="H6139" \w*; \w also the Avites| strong="H5761" \w*: 
\v 4 \w From the south| strong="H8486" \w*, \w all the land| strong="H776" \w* \w of the Canaanites| strong="H3669" \w*, \w and Mearah| strong="H4632" \w* that is \w beside the Sidonians| strong="H6722" \w*, \w unto Aphek| strong="H663" \w*, \w to the borders| strong="H1366" \w* \w of the Amorites| strong="H567" \w*:\f + \fr 13:4 \ft Mearah: or, the cave \f* 
\v 5 \w And the land| strong="H776" \w* \w of the Giblites| strong="H1382" \w*, \w and all Lebanon| strong="H3844" \w*, [toward the sunrising]{strong=“H8121 H4217”}, [from Baal-gad]{strong=“H1171”} \w under mount| strong="H2022" \w* \w Hermon| strong="H2768" \w* [unto the entering]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w into Hamath| strong="H2574" \w*. 
\v 6 [All the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the hill country| strong="H2022" \w* \w from Lebanon| strong="H3844" \w* [unto Misrephoth-maim]{strong=“H4956”}, and \w all the Sidonians| strong="H6722" \w*, [them will I drive out]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8686”} \w from before| strong="H6440" \w* \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*: [only divide thou it by lot]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto the Israelites| strong="H3478" \w* \w for an inheritance| strong="H5159" \w*, [as I have commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} thee. 
\p
\v 7 [Now therefore divide]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8761”} \w this land| strong="H776" \w* \w for an inheritance| strong="H5159" \w* \w unto the nine| strong="H8672" \w* \w tribes| strong="H7626" \w*, \w and the half| strong="H2677" \w* \w tribe| strong="H7626" \w* \w of Manasseh| strong="H4519" \w*, 
