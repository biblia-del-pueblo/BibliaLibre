\v 8 [Thou shalt not also go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the house| strong="H1004" \w* \w of feasting| strong="H4960" \w*, [to sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} [with them to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} [and to drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 9 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*; [Behold, I will cause to cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8688”} \w out of this place| strong="H4725" \w* \w in your eyes| strong="H5869" \w*, \w and in your days| strong="H3117" \w*, \w the voice| strong="H6963" \w* \w of mirth| strong="H8342" \w*, \w and the voice| strong="H6963" \w* \w of gladness| strong="H8057" \w*, \w the voice| strong="H6963" \w* \w of the bridegroom| strong="H2860" \w*, \w and the voice| strong="H6963" \w* \w of the bride| strong="H3618" \w*. 
\p
\v 10 [And it shall come to pass, when thou shalt shew]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w this people| strong="H5971" \w* \w all these words| strong="H1697" \w*, [and they shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} unto thee, Wherefore hath the \sc Lord\sc* [pronounced]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w all this great| strong="H1419" \w* \w evil| strong="H7451" \w* against us? or what is \w our iniquity| strong="H5771" \w*? or what is \w our sin| strong="H2403" \w* [that we have committed]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} against the \sc Lord\sc* \w our God| strong="H430" \w*? 
\v 11 [Then shalt thou say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Because your fathers]{strong=“H1”} [have forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} [me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [and have walked]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w other| strong="H312" \w* \w gods| strong="H430" \w*, [and have served]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and have worshipped]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} [them, and have forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and have not kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w my law| strong="H8451" \w*; 
\v 12 [And ye have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [worse]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8689”} \w than your fathers| strong="H1" \w*; [for, behold]{strong=“H2009”}, [ye walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w every one| strong="H376" \w* \w after| strong="H310" \w* \w the imagination| strong="H8307" \w* \w of his evil| strong="H7451" \w* \w heart| strong="H3820" \w*, [that they may not hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} unto me:\f + \fr 16:12 \ft imagination: or, stubbornness \f* 
\v 13 [Therefore will I cast]{strong=“H2904” x-morph=“strongMorph: \sc Th\sc*8689”} \w you out of this land| strong="H776" \w* \w into a land| strong="H776" \w* [that ye know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} not, neither \w ye nor your fathers| strong="H1" \w*; [and there shall ye serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} \w other| strong="H312" \w* \w gods| strong="H430" \w* \w day| strong="H3119" \w* \w and night| strong="H3915" \w*; [where I will not shew]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w you favour| strong="H2594" \w*. 
\p
\v 14 [Therefore, behold, the days]{strong=“H3117”} [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [that it shall no more be said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8735”}, The \sc Lord\sc* \w liveth| strong="H2416" \w*, [that brought up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* \w out of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*; 
