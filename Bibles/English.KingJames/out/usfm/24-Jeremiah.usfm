\v 18 As \w I live| strong="H2416" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the King| strong="H4428" \w*, \w whose name| strong="H8034" \w* is the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w Surely as Tabor| strong="H8396" \w* is \w among the mountains| strong="H2022" \w*, \w and as Carmel| strong="H3760" \w* \w by the sea| strong="H3220" \w*, so [shall he come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 19 \w O thou daughter| strong="H1323" \w* [dwelling]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in Egypt| strong="H4714" \w*, [furnish]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} [thyself to go into captivity]{strong=“H1473 H3627”}: \w for Noph| strong="H5297" \w* \w shall be waste| strong="H8047" \w* [and desolate]{strong=“H3341” x-morph=“strongMorph: \sc Th\sc*8738”} [without an inhabitant]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 46:19 \ft furnish…: Heb. make thee instruments of captivity \f* 
\v 20 \w Egypt| strong="H4714" \w* is like \w a very fair| strong="H3304" \w* \w heifer| strong="H5697" \w*, but \w destruction| strong="H7171" \w* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}; [it cometh out]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the north| strong="H6828" \w*. 
\v 21 \w Also her hired men| strong="H7916" \w* are \w in the midst| strong="H7130" \w* \w of her like fatted| strong="H4770" \w* \w bullocks| strong="H5695" \w*; [for they also are turned back]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8689”}, and [are fled away]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8804”} \w together| strong="H3162" \w*: [they did not stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”}, \w because the day| strong="H3117" \w* \w of their calamity| strong="H343" \w* [was come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} upon them, and \w the time| strong="H6256" \w* \w of their visitation| strong="H6486" \w*.\f + \fr 46:21 \ft fatted…: Heb. bullocks of the stall \f* 
\v 22 \w The voice| strong="H6963" \w* [thereof shall go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w like a serpent| strong="H5175" \w*; [for they shall march]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w with an army| strong="H2428" \w*, [and come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w against her with axes| strong="H7134" \w*, [as hewers]{strong=“H2404” x-morph=“strongMorph: \sc Th\sc*8802”} \w of wood| strong="H6086" \w*. 
\v 23 [They shall cut down]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8804”} \w her forest| strong="H3293" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [though it cannot be searched]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8735”}; [because they are more]{strong=“H7231” x-morph=“strongMorph: \sc Th\sc*8804”} \w than the grasshoppers| strong="H697" \w*, and are [innumerable]{strong=“H4557 H369”}. 
