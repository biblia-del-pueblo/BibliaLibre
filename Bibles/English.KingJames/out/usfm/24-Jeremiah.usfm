\v 4 [Harness]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8798”} \w the horses| strong="H5483" \w*; [and get up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”}, \w ye horsemen| strong="H6571" \w*, [and stand forth]{strong=“H3320” x-morph=“strongMorph: \sc Th\sc*8690”} with your \w helmets| strong="H3553" \w*; [furbish]{strong=“H4838” x-morph=“strongMorph: \sc Th\sc*8798”} \w the spears| strong="H7420" \w*, and [put on]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8798”} \w the brigandines| strong="H5630" \w*. 
\v 5 [Wherefore have I seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w them dismayed| strong="H2844" \w* and [turned]{strong=“H5472” x-morph=“strongMorph: \sc Th\sc*8737”} \w away back| strong="H268" \w*? \w and their mighty ones| strong="H1368" \w* [are beaten down]{strong=“H3807” x-morph=“strongMorph: \sc Th\sc*8714”}, [and are fled]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8804”} \w apace| strong="H4498" \w*, [and look not back]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8689”}: for \w fear| strong="H4032" \w* was \w round about| strong="H5439" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*.\f + \fr 46:5 \ft beaten…: Heb. broken in pieces \f* \f + \fr 46:5 \ft fled…: Heb. fled a flight \f* 
\v 6 \w Let not the swift| strong="H7031" \w* [flee away]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”}, \w nor the mighty man| strong="H1368" \w* [escape]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8735”}; [they shall stumble]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8804”}, [and fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} \w toward the north| strong="H6828" \w* \w by| strong="H3027" \w* \w the river| strong="H5104" \w* \w Euphrates| strong="H6578" \w*. 
\v 7 Who is this that [cometh up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w as a flood| strong="H2975" \w*, \w whose waters| strong="H4325" \w* [are moved]{strong=“H1607” x-morph=“strongMorph: \sc Th\sc*8691”} \w as the rivers| strong="H5104" \w*? 
\v 8 \w Egypt| strong="H4714" \w* [riseth up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w like a flood| strong="H2975" \w*, and his \w waters| strong="H4325" \w* [are moved]{strong=“H1607” x-morph=“strongMorph: \sc Th\sc*8704”} \w like the rivers| strong="H5104" \w*; [and he saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”}, and [will cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w the earth| strong="H776" \w*; [I will destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8686”} \w the city| strong="H5892" \w* [and the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} thereof. 
\v 9 [Come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”}, \w ye horses| strong="H5483" \w*; [and rage]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8703”}, \w ye chariots| strong="H7393" \w*; \w and let the mighty men| strong="H1368" \w* [come forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”}; \w the Ethiopians| strong="H3568" \w* \w and the Libyans| strong="H6316" \w*, [that handle]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8802”} \w the shield| strong="H4043" \w*; \w and the Lydians| strong="H3866" \w*, [that handle]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8802”} and [bend]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8802”} \w the bow| strong="H7198" \w*.\f + \fr 46:9 \ft the Ethiopians: Heb. Cush \f* \f + \fr 46:9 \ft the Libyans: Heb. Put \f* 
\v 10 For this is \w the day| strong="H3117" \w* \w of the Lord| strong="H136" \w* \sc God\sc* \w of hosts| strong="H6635" \w*, \w a day| strong="H3117" \w* \w of vengeance| strong="H5360" \w*, [that he may avenge]{strong=“H5358” x-morph=“strongMorph: \sc Th\sc*8736”} \w him of his adversaries| strong="H6862" \w*: \w and the sword| strong="H2719" \w* [shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”}, [and it shall be satiate]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8804”} [and made drunk]{strong=“H7301” x-morph=“strongMorph: \sc Th\sc*8804”} \w with their blood| strong="H1818" \w*: \w for the Lord| strong="H136" \w* \sc God\sc* \w of hosts| strong="H6635" \w* \w hath a sacrifice| strong="H2077" \w* \w in the north| strong="H6828" \w* \w country| strong="H776" \w* \w by the river| strong="H5104" \w* \w Euphrates| strong="H6578" \w*. 
\v 11 [Go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”} \w into Gilead| strong="H1568" \w*, [and take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w balm| strong="H6875" \w*, \w O virgin| strong="H1330" \w*, \w the daughter| strong="H1323" \w* \w of Egypt| strong="H4714" \w*: \w in vain| strong="H7723" \w* [shalt thou use many]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8689”} \w medicines| strong="H7499" \w*; for \w thou shalt not be cured| strong="H8585" \w*.\f + \fr 46:11 \ft thou shalt…: Heb. no cure shall be unto thee \f* 
\p
