\c 2
\p 
\v 1 \w Moreover the word| strong="H1697" \w* of the \sc Lord\sc* [came to me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”} [and cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the ears| strong="H241" \w* \w of Jerusalem| strong="H3389" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [I remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, the kindness]{strong=“H2617”} \w of thy youth| strong="H5271" \w*, \w the love| strong="H160" \w* \w of thine espousals| strong="H3623" \w*, [when thou wentest]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} \w after| strong="H310" \w* \w me in the wilderness| strong="H4057" \w*, \w in a land| strong="H776" \w* that was [not sown]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8803”}.\f + \fr 2:2 \ft thee: or, for thy sake \f* 
\v 3 \w Israel| strong="H3478" \w* was \w holiness| strong="H6944" \w* unto the \sc Lord\sc*, and \w the firstfruits| strong="H7225" \w* \w of his increase| strong="H8393" \w*: [all that devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} [him shall offend]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8799”}; \w evil| strong="H7451" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [upon them, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
