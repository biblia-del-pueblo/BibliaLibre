\v 19 O \sc Lord\sc*, \w my strength| strong="H5797" \w*, \w and my fortress| strong="H4581" \w*, \w and my refuge| strong="H4498" \w* \w in the day| strong="H3117" \w* \w of affliction| strong="H6869" \w*, \w the Gentiles| strong="H1471" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto thee from the ends| strong="H657" \w* \w of the earth| strong="H776" \w*, [and shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Surely our fathers| strong="H1" \w* [have inherited]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8804”} \w lies| strong="H8267" \w*, \w vanity| strong="H1892" \w*, and things wherein there is [no profit]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 20 \w Shall a man| strong="H120" \w* [make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w gods| strong="H430" \w* unto himself, and they are \w no gods| strong="H430" \w*? 
\v 21 [Therefore, behold, I will this once]{strong=“H6471”} [cause them to know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8688”}, [I will cause them to know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8686”} \w mine hand| strong="H3027" \w* \w and my might| strong="H1369" \w*; [and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w that my name| strong="H8034" \w* is The \sc Lord\sc*.^\sc 16:21 The [Lord\sc*: or, \sc Jehovah\sc*]
\c 17
\p 
\v 1 \w The sin| strong="H2403" \w* \w of Judah| strong="H3063" \w* is [written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8803”} \w with a pen| strong="H5842" \w* \w of iron| strong="H1270" \w*, and \w with the point| strong="H6856" \w* \w of a diamond| strong="H8068" \w*: it is [graven]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8803”} \w upon the table| strong="H3871" \w* \w of their heart| strong="H3820" \w*, \w and upon the horns| strong="H7161" \w* \w of your altars| strong="H4196" \w*;\f + \fr 17:1 \ft point: Heb. nail \f* 
\v 2 \w Whilst their children| strong="H1121" \w* [remember ]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8800”} \w their altars| strong="H4196" \w* \w and their groves| strong="H842" \w* \w by the green| strong="H7488" \w* \w trees| strong="H6086" \w* \w upon the high| strong="H1364" \w* \w hills| strong="H1389" \w*. 
\v 3 \w O my mountain| strong="H2042" \w* \w in the field| strong="H7704" \w*, [I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy substance| strong="H2428" \w* and \w all thy treasures| strong="H214" \w* \w to the spoil| strong="H957" \w*, and \w thy high places| strong="H1116" \w* \w for sin| strong="H2403" \w*, \w throughout all thy borders| strong="H1366" \w*. 
\v 4 [And thou, even thyself, shalt discontinue]{strong=“H8058” x-morph=“strongMorph: \sc Th\sc*8804”} \w from thine heritage| strong="H5159" \w* [that I gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [thee; and I will cause thee to serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8689”} [thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the land| strong="H776" \w* [which thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [not: for ye have kindled]{strong=“H6919” x-morph=“strongMorph: \sc Th\sc*8804”} \w a fire| strong="H784" \w* \w in mine anger| strong="H639" \w*, which [shall burn]{strong=“H3344” x-morph=“strongMorph: \sc Th\sc*8714”} \w for| strong="H5704" \w* \w ever| strong="H5769" \w*.\f + \fr 17:4 \ft thyself: Heb. in thyself \f* 
\p
\v 5 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Cursed]{strong=“H779” x-morph=“strongMorph: \sc Th\sc*8803”} be \w the man| strong="H1397" \w* [that trusteth]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} \w in man| strong="H120" \w*, [and maketh]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w flesh| strong="H1320" \w* \w his arm| strong="H2220" \w*, \w and whose heart| strong="H3820" \w* [departeth ]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8799”} from the \sc Lord\sc*. 
\v 6 \w For he shall be like the heath| strong="H6199" \w* \w in the desert| strong="H6160" \w*, [and shall not see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w when good| strong="H2896" \w* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}; [but shall inhabit]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8804”} \w the parched places| strong="H2788" \w* \w in the wilderness| strong="H4057" \w*, in \w a salt| strong="H4420" \w* \w land| strong="H776" \w* [and not inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 7 [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} is \w the man| strong="H1397" \w* [that trusteth]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} in the \sc Lord\sc*, \w and whose hope| strong="H4009" \w* the \sc Lord\sc* is. 
\v 8 \w For he shall be as a tree| strong="H6086" \w* [planted]{strong=“H8362” x-morph=“strongMorph: \sc Th\sc*8803”} \w by the waters| strong="H4325" \w*, and that [spreadeth out]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w her roots| strong="H8328" \w* \w by the river| strong="H3105" \w*, [and shall not see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w when heat| strong="H2527" \w* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, \w but her leaf| strong="H5929" \w* \w shall be green| strong="H7488" \w*; [and shall not be careful]{strong=“H1672” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the year| strong="H8141" \w* \w of drought| strong="H1226" \w*, [neither shall cease]{strong=“H4185” x-morph=“strongMorph: \sc Th\sc*8686”} [from yielding]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w fruit| strong="H6529" \w*.\f + \fr 17:8 \ft drought: or, restraint \f* 
\p
\v 9 \w The heart| strong="H3820" \w* is \w deceitful| strong="H6121" \w* above all things, [and desperately wicked]{strong=“H605” x-morph=“strongMorph: \sc Th\sc*8803”}: [who can know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} it? 
\v 10 I the \sc Lord\sc* [search]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8802”} \w the heart| strong="H3820" \w*, I [try]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8802”} \w the reins| strong="H3629" \w*, [even to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w every man| strong="H376" \w* \w according to his ways| strong="H1870" \w*, and \w according to the fruit| strong="H6529" \w* \w of his doings| strong="H4611" \w*. 
\v 11 As \w the partridge| strong="H7124" \w* [sitteth]{strong=“H1716” x-morph=“strongMorph: \sc Th\sc*8804”} on eggs, [and hatcheth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} them not; so [he that getteth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w riches| strong="H6239" \w*, \w and not by right| strong="H4941" \w*, [shall leave]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w them in the midst| strong="H2677" \w* \w of his days| strong="H3117" \w*, \w and at his end| strong="H319" \w* \w shall be a fool| strong="H5036" \w*.\f + \fr 17:11 \ft sitteth…: or, gathereth young which she hath not brought forth \f* 
\p
\v 12 \w A glorious| strong="H3519" \w* \w high| strong="H4791" \w* \w throne| strong="H3678" \w* \w from the beginning| strong="H7223" \w* is \w the place| strong="H4725" \w* \w of our sanctuary| strong="H4720" \w*. 
\v 13 O \sc Lord\sc*, \w the hope| strong="H4723" \w* \w of Israel| strong="H3478" \w*, [all that forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8802”} [thee shall be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}, and \w they that depart| strong="H3249" \w* [from me]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8803”} [shall be written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the earth| strong="H776" \w*, [because they have forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w the fountain| strong="H4726" \w* \w of living| strong="H2416" \w* \w waters| strong="H4325" \w*. 
\v 14 [Heal]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8798”} me, O \sc Lord\sc*, [and I shall be healed]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8735”}; [save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”} [me, and I shall be saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8735”}: for thou art \w my praise| strong="H8416" \w*. 
\p
\v 15 [Behold, they say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} unto me, Where is \w the word| strong="H1697" \w* of the \sc Lord\sc*? [let it come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} now. 
\v 16 [As for me, I have not hastened]{strong=“H213” x-morph=“strongMorph: \sc Th\sc*8804”} from being [a pastor]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} \w to follow| strong="H310" \w* [thee: neither have I desired]{strong=“H183” x-morph=“strongMorph: \sc Th\sc*8694”} [the woeful]{strong=“H605” x-morph=“strongMorph: \sc Th\sc*8803”} \w day| strong="H3117" \w*; [thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}: \w that which came out| strong="H4161" \w* \w of my lips| strong="H8193" \w* was right \w before| strong="H5227" \w* \w thee| strong="H6440" \w*.\f + \fr 17:16 \ft to…: Heb. after thee \f* 
\v 17 \w Be not a terror| strong="H4288" \w* unto me: thou art \w my hope| strong="H4268" \w* \w in the day| strong="H3117" \w* \w of evil| strong="H7451" \w*. 
\v 18 [Let them be confounded]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} [that persecute]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8802”} [me, but let not me be confounded]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}: [let them be dismayed]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8735”}, [but let not me be dismayed]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8735”}: [bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} \w upon them the day| strong="H3117" \w* \w of evil| strong="H7451" \w*, [and destroy]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8798”} \w them with double| strong="H4932" \w* \w destruction| strong="H7670" \w*.\f + \fr 17:18 \ft destroy…: Heb. break them with a double breach \f* 
\p
\v 19 [Thus said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* [unto me; Go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”} [and stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the gate| strong="H8179" \w* \w of the children| strong="H1121" \w* \w of the people| strong="H5971" \w*, \w whereby the kings| strong="H4428" \w* \w of Judah| strong="H3063" \w* [come in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [and by the which they go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and in all the gates| strong="H8179" \w* \w of Jerusalem| strong="H3389" \w*; 
\v 20 [And say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye the word| strong="H1697" \w* of the \sc Lord\sc*, \w ye kings| strong="H4428" \w* \w of Judah| strong="H3063" \w*, \w and all Judah| strong="H3063" \w*, [and all the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w*, [that enter in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w by these gates| strong="H8179" \w*: 
\v 21 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Take heed]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8734”} \w to yourselves| strong="H5315" \w*, [and bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w no burden| strong="H4853" \w* \w on the sabbath| strong="H7676" \w* \w day| strong="H3117" \w*, [nor bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} it \w in by the gates| strong="H8179" \w* \w of Jerusalem| strong="H3389" \w*; 
\v 22 [Neither carry forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w a burden| strong="H4853" \w* \w out of your houses| strong="H1004" \w* \w on the sabbath| strong="H7676" \w* \w day| strong="H3117" \w*, [neither do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w ye any work| strong="H4399" \w*, [but hallow]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8765”} \w ye the sabbath| strong="H7676" \w* \w day| strong="H3117" \w*, [as I commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w your fathers| strong="H1" \w*. 
\v 23 [But they obeyed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [not, neither inclined]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8689”} \w their ear| strong="H241" \w*, \w but made their neck| strong="H6203" \w* [stiff]{strong=“H7185” x-morph=“strongMorph: \sc Th\sc*8686”}, [that they might not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”}, [nor receive]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} \w instruction| strong="H4148" \w*. 
\v 24 [And it shall come to pass, if ye diligently]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} [hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [to bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} \w in no burden| strong="H4853" \w* \w through the gates| strong="H8179" \w* \w of this city| strong="H5892" \w* \w on the sabbath| strong="H7676" \w* \w day| strong="H3117" \w*, [but hallow]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8763”} \w the sabbath| strong="H7676" \w* \w day| strong="H3117" \w*, [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w no| strong="H1115" \w* \w work| strong="H4399" \w* therein; 
\v 25 [Then shall there enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the gates| strong="H8179" \w* \w of this city| strong="H5892" \w* \w kings| strong="H4428" \w* \w and princes| strong="H8269" \w* [sitting]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the throne| strong="H3678" \w* \w of David| strong="H1732" \w*, [riding]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8802”} \w in chariots| strong="H7393" \w* \w and on horses| strong="H5483" \w*, [they, and their princes]{strong=“H8269”}, \w the men| strong="H376" \w* \w of Judah| strong="H3063" \w*, [and the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w*: \w and this city| strong="H5892" \w* [shall remain]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w for ever| strong="H5769" \w*. 
\v 26 [And they shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w from the cities| strong="H5892" \w* \w of Judah| strong="H3063" \w*, \w and from the places about| strong="H5439" \w* \w Jerusalem| strong="H3389" \w*, \w and from the land| strong="H776" \w* \w of Benjamin| strong="H1144" \w*, \w and from the plain| strong="H8219" \w*, \w and from the mountains| strong="H2022" \w*, \w and from the south| strong="H5045" \w*, [bringing]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w burnt offerings| strong="H5930" \w*, \w and sacrifices| strong="H2077" \w*, \w and meat offerings| strong="H4503" \w*, \w and incense| strong="H3828" \w*, [and bringing]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w sacrifices of praise| strong="H8426" \w*, \w unto the house| strong="H1004" \w* of the \sc Lord\sc*. 
\v 27 [But if ye will not hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me to hallow]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8763”} \w the sabbath| strong="H7676" \w* \w day| strong="H3117" \w*, [and not to bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8800”} \w a burden| strong="H4853" \w*, [even entering in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w at the gates| strong="H8179" \w* \w of Jerusalem| strong="H3389" \w* \w on the sabbath| strong="H7676" \w* \w day| strong="H3117" \w*; [then will I kindle]{strong=“H3341” x-morph=“strongMorph: \sc Th\sc*8689”} \w a fire| strong="H784" \w* \w in the gates| strong="H8179" \w* [thereof, and it shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w the palaces| strong="H759" \w* \w of Jerusalem| strong="H3389" \w*, [and it shall not be quenched]{strong=“H3518” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\c 18
\p 
\v 1 \w The word| strong="H1697" \w* \w which came to Jeremiah| strong="H3414" \w* from the \sc Lord\sc*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [and go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} [to the potter’s]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w house| strong="H1004" \w*, [and there I will cause thee to hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8686”} \w my words| strong="H1697" \w*. 
\v 3 [Then I went down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} [to the potter’s]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w house| strong="H1004" \w*, [and, behold]{strong=“H2009”}, [he wrought]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w a work| strong="H4399" \w* \w on the wheels| strong="H70" \w*.\f + \fr 18:3 \ft wheels: or, frames, or, seats \f* 
\v 4 \w And the vessel| strong="H3627" \w* [that he made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w of clay| strong="H2563" \w* [was marred]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the hand| strong="H3027" \w* [of the potter]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”}: [so he made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [it again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w another| strong="H312" \w* \w vessel| strong="H3627" \w*, \w as seemed| strong="H5869" \w* [good]{strong=“H3474” x-morph=“strongMorph: \sc Th\sc*8804”} [to the potter]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} [to make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} it.\f + \fr 18:4 \ft of clay…: or, was marred, as clay in the hand of the potter \f* \f + \fr 18:4 \ft made it…: Heb. returned and made, etc \f* 
\v 5 \w Then the word| strong="H1697" \w* of the \sc Lord\sc* [came to me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 6 \w O house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, [cannot]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [I do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [with you as this potter]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”}? [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. [Behold, as the clay]{strong=“H2563”} is [in the potter’s]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w hand| strong="H3027" \w*, so are \w ye in mine hand| strong="H3027" \w*, \w O house| strong="H1004" \w* \w of Israel| strong="H3478" \w*. 
\v 7 At what \w instant| strong="H7281" \w* [I shall speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w concerning a nation| strong="H1471" \w*, \w and concerning a kingdom| strong="H4467" \w*, [to pluck up]{strong=“H5428” x-morph=“strongMorph: \sc Th\sc*8800”}, [and to pull down]{strong=“H5422” x-morph=“strongMorph: \sc Th\sc*8800”}, [and to destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8687”} it; 
\v 8 \w If that nation| strong="H1471" \w*, [against whom I have pronounced]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}, [turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w from their evil| strong="H7451" \w*, [I will repent]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8738”} \w of the evil| strong="H7451" \w* [that I thought]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8804”} [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} unto them. 
\v 9 And at what \w instant| strong="H7281" \w* [I shall speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w concerning a nation| strong="H1471" \w*, \w and concerning a kingdom| strong="H4467" \w*, [to build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8800”} [and to plant]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8800”} it; 
\v 10 [If it do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w evil| strong="H7451" \w* \w in my sight| strong="H5869" \w*, [that it obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w not my voice| strong="H6963" \w*, [then I will repent]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8738”} \w of the good| strong="H2896" \w*, [wherewith I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [I would benefit]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8687”} them. 
\p
\v 11 [Now therefore go to, speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w to the men| strong="H376" \w* \w of Judah| strong="H3063" \w*, [and to the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Behold, I frame]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w evil| strong="H7451" \w* [against you, and devise]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8802”} \w a device| strong="H4284" \w* [against you: return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye now every one| strong="H376" \w* \w from his evil| strong="H7451" \w* \w way| strong="H1870" \w*, \w and make your ways| strong="H1870" \w* \w and your doings| strong="H4611" \w* [good]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8685”}. 
\v 12 [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [There is no hope]{strong=“H2976” x-morph=“strongMorph: \sc Th\sc*8737”}: [but we will walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w our own devices| strong="H4284" \w*, \w and we will every one| strong="H376" \w* [do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w the imagination| strong="H8307" \w* \w of his evil| strong="H7451" \w* \w heart| strong="H3820" \w*. 
\v 13 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye now among the heathen| strong="H1471" \w*, [who hath heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [such things: the virgin]{strong=“H1330”} \w of Israel| strong="H3478" \w* [hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w a very| strong="H3966" \w* \w horrible thing| strong="H8186" \w*. 
\v 14 Will a man [leave]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w the snow| strong="H7950" \w* \w of Lebanon| strong="H3844" \w* which cometh \w from the rock| strong="H6697" \w* \w of the field| strong="H7704" \w*? or \w shall the cold| strong="H7119" \w* [flowing]{strong=“H5140” x-morph=“strongMorph: \sc Th\sc*8802”} \w waters| strong="H4325" \w* [that come from another place]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} [be forsaken]{strong=“H5428” x-morph=“strongMorph: \sc Th\sc*8735”}?\f + \fr 18:14 \ft the snow…: or, my fields for a rock, or for the snow of Lebanon? shall the running waters be forsaken for the strange cold waters? \f* 
\v 15 \w Because my people| strong="H5971" \w* [hath forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} [me, they have burned incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8762”} \w to vanity| strong="H7723" \w*, [and they have caused them to stumble]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8686”} \w in their ways| strong="H1870" \w* from \w the ancient| strong="H5769" \w* [paths]{strong=“H7635 H7635” x-morph=“strongMorph: \sc Th\sc*8675”}, [to walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} \w in paths| strong="H5410" \w*, in \w a way| strong="H1870" \w* [not cast up]{strong=“H5549” x-morph=“strongMorph: \sc Th\sc*8803”}; 
\v 16 [To make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w their land| strong="H776" \w* \w desolate| strong="H8047" \w*, and \w a perpetual| strong="H5769" \w* [hissing]{strong=“H8292 H8292” x-morph=“strongMorph: \sc Th\sc*8675”}; [every one that passeth]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} [thereby shall be astonished]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8799”}, [and wag]{strong=“H5110” x-morph=“strongMorph: \sc Th\sc*8686”} \w his head| strong="H7218" \w*. 
\v 17 [I will scatter]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8686”} \w them as with an east| strong="H6921" \w* \w wind| strong="H7307" \w* \w before| strong="H6440" \w* [the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}; [I will shew]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w them the back| strong="H6203" \w*, \w and not the face| strong="H6440" \w*, \w in the day| strong="H3117" \w* \w of their calamity| strong="H343" \w*. 
\p
\v 18 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [they, Come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [and let us devise]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8799”} \w devices| strong="H4284" \w* \w against Jeremiah| strong="H3414" \w*; \w for the law| strong="H8451" \w* [shall not perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the priest| strong="H3548" \w*, \w nor counsel| strong="H6098" \w* \w from the wise| strong="H2450" \w*, \w nor the word| strong="H1697" \w* \w from the prophet| strong="H5030" \w*. [Come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [and let us smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w him with the tongue| strong="H3956" \w*, [and let us not give heed]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8686”} \w to any of his words| strong="H1697" \w*.\f + \fr 18:18 \ft with…: or, for the tongue \f* 
\v 19 [Give heed]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8685”} to me, O \sc Lord\sc*, [and hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w to the voice| strong="H6963" \w* \w of them that contend| strong="H3401" \w* with me. 
\v 20 \w Shall evil| strong="H7451" \w* [be recompensed]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8792”} \w for good| strong="H2896" \w*? [for they have digged]{strong=“H3738” x-morph=“strongMorph: \sc Th\sc*8804”} \w a pit| strong="H7745" \w* \w for my soul| strong="H5315" \w*. [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”} [that I stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8800”} \w before| strong="H6440" \w* [thee to speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w good| strong="H2896" \w* for them, and [to turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} \w thy wrath| strong="H2534" \w* from them. 
\v 21 [Therefore deliver up]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w their children| strong="H1121" \w* \w to the famine| strong="H7458" \w*, [and pour out]{strong=“H5064” x-morph=“strongMorph: \sc Th\sc*8685”} their blood \w by the force| strong="H3027" \w* \w of the sword| strong="H2719" \w*; \w and let their wives| strong="H802" \w* \w be bereaved| strong="H7909" \w* of their children, and be \w widows| strong="H490" \w*; \w and let their men| strong="H582" \w* [be put]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8803”} \w to death| strong="H4194" \w*; let \w their young men| strong="H970" \w* be [slain]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8716”} \w by the sword| strong="H2719" \w* \w in battle| strong="H4421" \w*.\f + \fr 18:21 \ft pour…: Heb. pour them out \f* 
\v 22 \w Let a cry| strong="H2201" \w* [be heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8735”} \w from their houses| strong="H1004" \w*, [when thou shalt bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w a troop| strong="H1416" \w* \w suddenly| strong="H6597" \w* [upon them: for they have digged]{strong=“H3738” x-morph=“strongMorph: \sc Th\sc*8804”} [a pit]{strong=“H7882 H7745” x-morph=“strongMorph: \sc Th\sc*8675”} [to take]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8800”} [me, and hid]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8804”} \w snares| strong="H6341" \w* \w for my feet| strong="H7272" \w*. 
\v 23 Yet, \sc Lord\sc*, [thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w all their counsel| strong="H6098" \w* \w against me to slay| strong="H4194" \w* me: [forgive]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8762”} \w not their iniquity| strong="H5771" \w*, [neither blot out]{strong=“H4229” x-morph=“strongMorph: \sc Th\sc*8686”} \w their sin| strong="H2403" \w* \w from thy sight| strong="H6440" \w*, [but let them be overthrown]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8716”} \w before| strong="H6440" \w* [thee; deal]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} thus \w with them in the time| strong="H6256" \w* \w of thine anger| strong="H639" \w*.\f + \fr 18:23 \ft to slay…: Heb. for death \f*
\c 19
\p 
\v 1 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [Go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”} [and get]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8804”} [a potter’s]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w earthen| strong="H2789" \w* \w bottle| strong="H1228" \w*, and take \w of the ancients| strong="H2205" \w* \w of the people| strong="H5971" \w*, \w and of the ancients| strong="H2205" \w* \w of the priests| strong="H3548" \w*; 
\v 2 [And go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the valley| strong="H1516" \w* \w of the son| strong="H1121" \w* \w of Hinnom| strong="H2011" \w*, which is \w by the entry| strong="H6607" \w* \w of the east| strong="H2777" \w* \w gate| strong="H8179" \w*, [and proclaim]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w there the words| strong="H1697" \w* [that I shall tell]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} thee,\f + \fr 19:2 \ft the east…: Heb. the sun gate \f* 
\v 3 [And say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye the word| strong="H1697" \w* of the \sc Lord\sc*, \w O kings| strong="H4428" \w* \w of Judah| strong="H3063" \w*, [and inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w*; [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*; [Behold, I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w evil| strong="H7451" \w* \w upon this place| strong="H4725" \w*, [the which whosoever heareth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”}, \w his ears| strong="H241" \w* [shall tingle]{strong=“H6750” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 4 [Because they have forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and have estranged]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8762”} \w this place| strong="H4725" \w*, [and have burned incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8762”} \w in it unto other| strong="H312" \w* \w gods| strong="H430" \w*, \w whom neither they nor their fathers| strong="H1" \w* [have known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}, \w nor the kings| strong="H4428" \w* \w of Judah| strong="H3063" \w*, [and have filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w this place| strong="H4725" \w* \w with the blood| strong="H1818" \w* \w of innocents| strong="H5355" \w*; 
\v 5 [They have built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w also the high places| strong="H1116" \w* \w of Baal| strong="H1168" \w*, [to burn]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8800”} \w their sons| strong="H1121" \w* \w with fire| strong="H784" \w* for \w burnt offerings| strong="H5930" \w* \w unto Baal| strong="H1168" \w*, [which I commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [not, nor spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it, [neither came]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} it \w into my mind| strong="H3820" \w*: 
\v 6 [Therefore, behold, the days]{strong=“H3117”} [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, \w that this place| strong="H4725" \w* [shall no more be called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8735”} \w Tophet| strong="H8612" \w*, \w nor The valley| strong="H1516" \w* \w of the son| strong="H1121" \w* \w of Hinnom| strong="H2011" \w*, \w but The valley| strong="H1516" \w* \w of slaughter| strong="H2028" \w*. 
\v 7 [And I will make void]{strong=“H1238” x-morph=“strongMorph: \sc Th\sc*8804”} \w the counsel| strong="H6098" \w* \w of Judah| strong="H3063" \w* \w and Jerusalem| strong="H3389" \w* \w in this place| strong="H4725" \w*; [and I will cause them to fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8689”} \w by the sword| strong="H2719" \w* \w before| strong="H6440" \w* [their enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and by the hands| strong="H3027" \w* [of them that seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w their lives| strong="H5315" \w*: \w and their carcases| strong="H5038" \w* [will I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w to be meat| strong="H3978" \w* \w for the fowls| strong="H5775" \w* \w of the heaven| strong="H8064" \w*, \w and for the beasts| strong="H929" \w* \w of the earth| strong="H776" \w*. 
\v 8 [And I will make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w this city| strong="H5892" \w* \w desolate| strong="H8047" \w*, \w and an hissing| strong="H8322" \w*; [every one that passeth]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} [thereby shall be astonished]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8799”} [and hiss]{strong=“H8319” x-morph=“strongMorph: \sc Th\sc*8799”} \w because of all the plagues| strong="H4347" \w* thereof. 
\v 9 [And I will cause them to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8689”} \w the flesh| strong="H1320" \w* \w of their sons| strong="H1121" \w* \w and the flesh| strong="H1320" \w* \w of their daughters| strong="H1323" \w*, [and they shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w every one| strong="H376" \w* \w the flesh| strong="H1320" \w* \w of his friend| strong="H7453" \w* \w in the siege| strong="H4692" \w* \w and straitness| strong="H4689" \w*, [wherewith their enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, [and they that seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w their lives| strong="H5315" \w*, [shall straiten]{strong=“H6693” x-morph=“strongMorph: \sc Th\sc*8686”} them. 
\p
\v 10 [Then shalt thou break]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8804”} \w the bottle| strong="H1228" \w* \w in the sight| strong="H5869" \w* \w of the men| strong="H582" \w* [that go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} with thee, 
\v 11 [And shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*; \w Even so| strong="H3602" \w* [will I break]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8799”} \w this people| strong="H5971" \w* \w and this city| strong="H5892" \w*, as one [breaketh]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8799”} [a potter’s]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w vessel| strong="H3627" \w*, [that cannot]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [be made whole again]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8736”}: [and they shall bury]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8799”} them \w in Tophet| strong="H8612" \w*, till there be \w no place| strong="H4725" \w* [to bury]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 19:11 \ft be made…: Heb. be healed \f* 
\v 12 [Thus will I do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto this place| strong="H4725" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [and to the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} thereof, and even [make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w this city| strong="H5892" \w* \w as Tophet| strong="H8612" \w*: 
\v 13 \w And the houses| strong="H1004" \w* \w of Jerusalem| strong="H3389" \w*, \w and the houses| strong="H1004" \w* \w of the kings| strong="H4428" \w* \w of Judah| strong="H3063" \w*, \w shall be defiled| strong="H2931" \w* \w as the place| strong="H4725" \w* \w of Tophet| strong="H8612" \w*, \w because of all the houses| strong="H1004" \w* \w upon whose roofs| strong="H1406" \w* [they have burned incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto all the host| strong="H6635" \w* \w of heaven| strong="H8064" \w*, [and have poured out]{strong=“H5258” x-morph=“strongMorph: \sc Th\sc*8687”} \w drink offerings| strong="H5262" \w* \w unto other| strong="H312" \w* \w gods| strong="H430" \w*. 
\v 14 [Then came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jeremiah| strong="H3414" \w* \w from Tophet| strong="H8612" \w*, whither the \sc Lord\sc* [had sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [him to prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8736”}; [and he stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the court| strong="H2691" \w* of the \sc Lord\sc*’S \w house| strong="H1004" \w*; [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to all the people| strong="H5971" \w*, 
\v 15 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*; [Behold, I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w upon this city| strong="H5892" \w* \w and upon all her towns| strong="H5892" \w* \w all the evil| strong="H7451" \w* [that I have pronounced]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [against it, because they have hardened]{strong=“H7185” x-morph=“strongMorph: \sc Th\sc*8689”} \w their necks| strong="H6203" \w*, [that they might not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w my words| strong="H1697" \w*.
\c 20
\p 
\v 1 \w Now Pashur| strong="H6583" \w* \w the son| strong="H1121" \w* \w of Immer| strong="H564" \w* \w the priest| strong="H3548" \w*, who was \w also chief| strong="H6496" \w* \w governor| strong="H5057" \w* \w in the house| strong="H1004" \w* of the \sc Lord\sc*, [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w that Jeremiah| strong="H3414" \w* [prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8738”} \w these things| strong="H1697" \w*. 
\v 2 \w Then Pashur| strong="H6583" \w* [smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w Jeremiah| strong="H3414" \w* \w the prophet| strong="H5030" \w*, [and put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w him in the stocks| strong="H4115" \w* that were \w in the high| strong="H5945" \w* \w gate| strong="H8179" \w* \w of Benjamin| strong="H1144" \w*, which was \w by the house| strong="H1004" \w* of the \sc Lord\sc*. 
\v 3 \w And it came to pass on the morrow| strong="H4283" \w*, \w that Pashur| strong="H6583" \w* [brought forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w Jeremiah| strong="H3414" \w* \w out of the stocks| strong="H4115" \w*. [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jeremiah| strong="H3414" \w* unto him, The \sc Lord\sc* [hath not called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy name| strong="H8034" \w* \w Pashur| strong="H6583" \w*, [but Magor-missabib]{strong=“H4036”}.\f + \fr 20:3 \ft Magor-missabib: that is, Fear round about \f* 
\v 4 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [Behold, I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w thee a terror| strong="H4032" \w* [to thyself, and to all thy friends]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”}: [and they shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} \w by the sword| strong="H2719" \w* [of their enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and thine eyes| strong="H5869" \w* [shall behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} it: [and I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w all Judah| strong="H3063" \w* \w into the hand| strong="H3027" \w* \w of the king| strong="H4428" \w* \w of Babylon| strong="H894" \w*, [and he shall carry them captive]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8689”} \w into Babylon| strong="H894" \w*, [and shall slay]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w them with the sword| strong="H2719" \w*. 
\v 5 [Moreover I will deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w all the strength| strong="H2633" \w* \w of this city| strong="H5892" \w*, \w and all the labours| strong="H3018" \w* [thereof, and all the precious things]{strong=“H3366”} [thereof, and all the treasures]{strong=“H214”} \w of the kings| strong="H4428" \w* \w of Judah| strong="H3063" \w* [will I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the hand| strong="H3027" \w* [of their enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, [which shall spoil]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8804”} [them, and take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} [them, and carry]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w them to Babylon| strong="H894" \w*. 
\v 6 [And thou, Pashur]{strong=“H6583”}, [and all that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in thine house| strong="H1004" \w* [shall go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w into captivity| strong="H7628" \w*: [and thou shalt come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Babylon| strong="H894" \w*, [and there thou shalt die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, [and shalt be buried]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8735”} [there, thou, and all thy friends]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”}, [to whom thou hast prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8738”} \w lies| strong="H8267" \w*. 
\p
\v 7 O \sc Lord\sc*, [thou hast deceived]{strong=“H6601” x-morph=“strongMorph: \sc Th\sc*8765”} [me, and I was deceived]{strong=“H6601” x-morph=“strongMorph: \sc Th\sc*8735”}: [thou art stronger]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8804”} [than I, and hast prevailed]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”}: \w I am in derision| strong="H7814" \w* \w daily| strong="H3117" \w*, [every one mocketh]{strong=“H3932” x-morph=“strongMorph: \sc Th\sc*8802”} me.\f + \fr 20:7 \ft was deceived: or, was enticed \f* 
\v 8 \w For since| strong="H1767" \w* [I spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}, [I cried out]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8799”}, [I cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w violence| strong="H2555" \w* \w and spoil| strong="H7701" \w*; \w because the word| strong="H1697" \w* of the \sc Lord\sc* \w was made a reproach| strong="H2781" \w* [unto me, and a derision]{strong=“H7047”}, \w daily| strong="H3117" \w*. 
\v 9 [Then I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [I will not make mention]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} [of him, nor speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w any more in his name| strong="H8034" \w*. But his word \w was in mine heart| strong="H3820" \w* [as a burning]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8802”} \w fire| strong="H784" \w* [shut up]{strong=“H6113” x-morph=“strongMorph: \sc Th\sc*8803”} \w in my bones| strong="H6106" \w*, [and I was weary]{strong=“H3811” x-morph=“strongMorph: \sc Th\sc*8738”} [with forbearing]{strong=“H3557” x-morph=“strongMorph: \sc Th\sc*8771”}, [and I could]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} not stay. 
\p
\v 10 [For I heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the defaming| strong="H1681" \w* \w of many| strong="H7227" \w*, \w fear| strong="H4032" \w* \w on every side| strong="H5439" \w*. [Report]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”}, say they, [and we will report]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} [it. All my familiars]{strong=“H7965 H582”} [watched]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} [for my halting]{strong=“H6761 H6763” x-morph=“strongMorph: \sc Th\sc*8676”}, saying, [Peradventure he will be enticed]{strong=“H6601” x-morph=“strongMorph: \sc Th\sc*8792”}, [and we shall prevail]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [against him, and we shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w our revenge| strong="H5360" \w* on him.\f + \fr 20:10 \ft All…: Heb. Every man of my peace \f* 
\v 11 But the \sc Lord\sc* is \w with me as a mighty| strong="H1368" \w* \w terrible one| strong="H6184" \w*: [therefore my persecutors]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8802”} [shall stumble]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8735”}, [and they shall not prevail]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”}: \w they shall be greatly| strong="H3966" \w* [ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8804”}; [for they shall not prosper]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8689”}: their \w everlasting| strong="H5769" \w* \w confusion| strong="H3639" \w* [shall never be forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 12 But, O \sc Lord\sc* \w of hosts| strong="H6635" \w*, [that triest]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8802”} \w the righteous| strong="H6662" \w*, and [seest]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} \w the reins| strong="H3629" \w* \w and the heart| strong="H3820" \w*, [let me see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy vengeance| strong="H5360" \w* [on them: for unto thee have I opened]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8765”} \w my cause| strong="H7379" \w*. 
\v 13 [Sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8798”} unto the \sc Lord\sc*, [praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*: [for he hath delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w the soul| strong="H5315" \w* \w of the poor| strong="H34" \w* \w from the hand| strong="H3027" \w* [of evildoers]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\p
\v 14 [Cursed]{strong=“H779” x-morph=“strongMorph: \sc Th\sc*8803”} be \w the day| strong="H3117" \w* [wherein I was born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8795”}: \w let not the day| strong="H3117" \w* \w wherein my mother| strong="H517" \w* [bare]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} [me be blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”}. 
\v 15 [Cursed]{strong=“H779” x-morph=“strongMorph: \sc Th\sc*8803”} be \w the man| strong="H376" \w* [who brought tidings]{strong=“H1319” x-morph=“strongMorph: \sc Th\sc*8765”} \w to my father| strong="H1" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w A man| strong="H2145" \w* \w child| strong="H1121" \w* [is born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8795”} [unto thee; making him very]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8763”} [glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 16 \w And let that man| strong="H376" \w* \w be as the cities| strong="H5892" \w* which the \sc Lord\sc* [overthrew]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8804”}, [and repented]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8738”} [not: and let him hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the cry| strong="H2201" \w* \w in the morning| strong="H1242" \w*, \w and the shouting| strong="H8643" \w* [at noontide]{strong=“H6672 H6256”}; 
\v 17 [Because he slew]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8790”} \w me not from the womb| strong="H7358" \w*; \w or that my mother| strong="H517" \w* \w might have been my grave| strong="H6913" \w*, \w and her womb| strong="H7358" \w* to be \w always| strong="H5769" \w* \w great| strong="H2030" \w* with me. 
\v 18 [Wherefore came I forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w out of the womb| strong="H7358" \w* [to see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w labour| strong="H5999" \w* \w and sorrow| strong="H3015" \w*, \w that my days| strong="H3117" \w* [should be consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8799”} \w with shame| strong="H1322" \w*? 
\c 21
\p 
\v 1 \w The word| strong="H1697" \w* \w which came unto Jeremiah| strong="H3414" \w* from the \sc Lord\sc*, \w when king| strong="H4428" \w* \w Zedekiah| strong="H6667" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto him Pashur| strong="H6583" \w* \w the son| strong="H1121" \w* \w of Melchiah| strong="H4441" \w*, \w and Zephaniah| strong="H6846" \w* \w the son| strong="H1121" \w* \w of Maaseiah| strong="H4641" \w* \w the priest| strong="H3548" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Enquire]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8798”}, I pray thee, of the \sc Lord\sc* \w for us| strong="H1157" \w*; \w for Nebuchadrezzar| strong="H5019" \w* \w king| strong="H4428" \w* \w of Babylon| strong="H894" \w* [maketh war]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8737”} against us; if so be that the \sc Lord\sc* [will deal]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [with us according to all his wondrous works]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”}, [that he may go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} from us. 
\p
\v 3 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jeremiah| strong="H3414" \w* [unto them, Thus shall ye say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Zedekiah| strong="H6667" \w*: 
\v 4 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w*; [Behold, I will turn back]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8688”} \w the weapons| strong="H3627" \w* \w of war| strong="H4421" \w* that are \w in your hands| strong="H3027" \w*, [wherewith ye fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8737”} \w against the king| strong="H4428" \w* \w of Babylon| strong="H894" \w*, and against \w the Chaldeans| strong="H3778" \w*, [which besiege]{strong=“H6696” x-morph=“strongMorph: \sc Th\sc*8802”} \w you without| strong="H2351" \w* \w the walls| strong="H2346" \w*, [and I will assemble]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8804”} \w them into the midst| strong="H8432" \w* \w of this city| strong="H5892" \w*. 
\v 5 [And I myself will fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8738”} [against you with an outstretched]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8803”} \w hand| strong="H3027" \w* \w and with a strong| strong="H2389" \w* \w arm| strong="H2220" \w*, \w even in anger| strong="H639" \w*, \w and in fury| strong="H2534" \w*, \w and in great| strong="H1419" \w* \w wrath| strong="H7110" \w*. 
\v 6 [And I will smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} [the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of this city| strong="H5892" \w*, \w both man| strong="H120" \w* \w and beast| strong="H929" \w*: [they shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w of a great| strong="H1419" \w* \w pestilence| strong="H1698" \w*. 
\v 7 \w And afterward| strong="H310" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [I will deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w Zedekiah| strong="H6667" \w* \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w*, \w and his servants| strong="H5650" \w*, \w and the people| strong="H5971" \w*, [and such as are left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”} \w in this city| strong="H5892" \w* \w from the pestilence| strong="H1698" \w*, \w from the sword| strong="H2719" \w*, \w and from the famine| strong="H7458" \w*, \w into the hand| strong="H3027" \w* \w of Nebuchadrezzar| strong="H5019" \w* \w king| strong="H4428" \w* \w of Babylon| strong="H894" \w*, \w and into the hand| strong="H3027" \w* [of their enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and into the hand| strong="H3027" \w* [of those that seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w their life| strong="H5315" \w*: [and he shall smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w them with the edge| strong="H6310" \w* \w of the sword| strong="H2719" \w*; [he shall not spare]{strong=“H2347” x-morph=“strongMorph: \sc Th\sc*8799”} [them, neither have pity]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”}, [nor have mercy]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\p
\v 8 \w And unto this people| strong="H5971" \w* [thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Behold, I set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w before| strong="H6440" \w* \w you the way| strong="H1870" \w* \w of life| strong="H2416" \w*, \w and the way| strong="H1870" \w* \w of death| strong="H4194" \w*. 
\v 9 [He that abideth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in this city| strong="H5892" \w* [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w*, \w and by the famine| strong="H7458" \w*, \w and by the pestilence| strong="H1698" \w*: [but he that goeth out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”}, [and falleth]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the Chaldeans| strong="H3778" \w* [that besiege]{strong=“H6696” x-morph=“strongMorph: \sc Th\sc*8802”} [you, he shall live]{strong=“H2421 H2421” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8804”}, \w and his life| strong="H5315" \w* \w shall be unto him for a prey| strong="H7998" \w*. 
\v 10 [For I have set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w my face| strong="H6440" \w* \w against this city| strong="H5892" \w* \w for evil| strong="H7451" \w*, \w and not for good| strong="H2896" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: [it shall be given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8735”} \w into the hand| strong="H3027" \w* \w of the king| strong="H4428" \w* \w of Babylon| strong="H894" \w*, [and he shall burn]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8804”} \w it with fire| strong="H784" \w*. 
\p
\v 11 \w And touching the house| strong="H1004" \w* \w of the king| strong="H4428" \w* \w of Judah| strong="H3063" \w*, say, [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye the word| strong="H1697" \w* of the \sc Lord\sc*; 
\v 12 \w O house| strong="H1004" \w* \w of David| strong="H1732" \w*, [thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Execute]{strong=“H1777” x-morph=“strongMorph: \sc Th\sc*8798”} \w judgment| strong="H4941" \w* \w in the morning| strong="H1242" \w*, [and deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} him that is [spoiled]{strong=“H1497” x-morph=“strongMorph: \sc Th\sc*8803”} \w out of the hand| strong="H3027" \w* [of the oppressor]{strong=“H6231” x-morph=“strongMorph: \sc Th\sc*8802”}, \w lest my fury| strong="H2534" \w* [go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w like fire| strong="H784" \w*, [and burn]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8804”} [that none can quench]{strong=“H3518” x-morph=“strongMorph: \sc Th\sc*8764”} it, \w because| strong="H6440" \w* \w of the evil| strong="H7455" \w* \w of your doings| strong="H4611" \w*.\f + \fr 21:12 \ft Execute: Heb. Judge \f* 
\v 13 Behold, I am [against thee, O inhabitant]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the valley| strong="H6010" \w*, and \w rock| strong="H6697" \w* \w of the plain| strong="H4334" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*; [which say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, [Who shall come down]{strong=“H5181” x-morph=“strongMorph: \sc Th\sc*8799”} [against us? or who shall enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into our habitations| strong="H4585" \w*?\f + \fr 21:13 \ft inhabitant: Heb. inhabitress \f* 
\v 14 [But I will punish]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} \w you according to the fruit| strong="H6529" \w* \w of your doings| strong="H4611" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: [and I will kindle]{strong=“H3341” x-morph=“strongMorph: \sc Th\sc*8689”} \w a fire| strong="H784" \w* \w in the forest| strong="H3293" \w* [thereof, and it shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w all things round about| strong="H5439" \w* it.\f + \fr 21:14 \ft punish: Heb. visit upon \f*
\c 22
\p 
\v 1 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8798”} \w to the house| strong="H1004" \w* \w of the king| strong="H4428" \w* \w of Judah| strong="H3063" \w*, [and speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w there this word| strong="H1697" \w*, 
\v 2 [And say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* of the \sc Lord\sc*, \w O king| strong="H4428" \w* \w of Judah| strong="H3063" \w*, [that sittest]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the throne| strong="H3678" \w* \w of David| strong="H1732" \w*, [thou, and thy servants]{strong=“H5650”}, \w and thy people| strong="H5971" \w* [that enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w in by these gates| strong="H8179" \w*: 
\v 3 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Execute]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye judgment| strong="H4941" \w* \w and righteousness| strong="H6666" \w*, [and deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} [the spoiled]{strong=“H1497” x-morph=“strongMorph: \sc Th\sc*8803”} \w out of the hand| strong="H3027" \w* \w of the oppressor| strong="H6216" \w*: [and do no wrong]{strong=“H3238” x-morph=“strongMorph: \sc Th\sc*8686”}, [do no violence]{strong=“H2554” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the stranger| strong="H1616" \w*, \w the fatherless| strong="H3490" \w*, \w nor the widow| strong="H490" \w*, [neither shed]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8799”} \w innocent| strong="H5355" \w* \w blood| strong="H1818" \w* \w in this place| strong="H4725" \w*. 
\v 4 [For if ye do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w this thing| strong="H1697" \w* [indeed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”}, [then shall there enter in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w by the gates| strong="H8179" \w* \w of this house| strong="H1004" \w* \w kings| strong="H4428" \w* [sitting]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the throne| strong="H3678" \w* \w of David| strong="H1732" \w*, [riding]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8802”} \w in chariots| strong="H7393" \w* \w and on horses| strong="H5483" \w*, [he, and his servants]{strong=“H5650”}, \w and his people| strong="H5971" \w*.\f + \fr 22:4 \ft upon…: Heb. for David upon his throne \f* 
\v 5 [But if ye will not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w these words| strong="H1697" \w*, [I swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} [by myself, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, \w that this house| strong="H1004" \w* \w shall become a desolation| strong="H2723" \w*. 
\v 6 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* [unto the king’s]{strong=“H4428”} \w house| strong="H1004" \w* \w of Judah| strong="H3063" \w*; Thou art \w Gilead| strong="H1568" \w* unto me, and \w the head| strong="H7218" \w* \w of Lebanon| strong="H3844" \w*: yet [surely I will make]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee a wilderness| strong="H4057" \w*, and \w cities| strong="H5892" \w* which [are not inhabited]{strong=“H3427 H3427” x-morph=“strongMorph: \sc Th\sc*8737 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8738”}. 
\v 7 [And I will prepare]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8765”} [destroyers]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8688”} [against thee, every one]{strong=“H376”} \w with his weapons| strong="H3627" \w*: [and they shall cut down]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy choice| strong="H4005" \w* \w cedars| strong="H730" \w*, [and cast]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8689”} them \w into the fire| strong="H784" \w*. 
\v 8 \w And many| strong="H7227" \w* \w nations| strong="H1471" \w* [shall pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w by this city| strong="H5892" \w*, [and they shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w every man| strong="H376" \w* \w to his neighbour| strong="H7453" \w*, Wherefore hath the \sc Lord\sc* [done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w thus unto this great| strong="H1419" \w* \w city| strong="H5892" \w*? 
