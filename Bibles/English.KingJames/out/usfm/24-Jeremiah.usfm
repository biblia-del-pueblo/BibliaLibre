\v 43 \w Fear| strong="H6343" \w*, \w and the pit| strong="H6354" \w*, \w and the snare| strong="H6341" \w*, shall be [upon thee, O inhabitant]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Moab| strong="H4124" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 44 [He that fleeth]{strong=“H5211 H5127” x-morph=“strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8801”} \w from| strong="H6440" \w* \w the fear| strong="H6343" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the pit| strong="H6354" \w*; [and he that getteth up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8802”} \w out of the pit| strong="H6354" \w* [shall be taken]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the snare| strong="H6341" \w*: [for I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} upon it, even \w upon Moab| strong="H4124" \w*, \w the year| strong="H8141" \w* \w of their visitation| strong="H6486" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 45 [They that fled]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8801”} [stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} \w under the shadow| strong="H6738" \w* \w of Heshbon| strong="H2809" \w* \w because of the force| strong="H3581" \w*: \w but a fire| strong="H784" \w* [shall come forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w out of Heshbon| strong="H2809" \w*, \w and a flame| strong="H3852" \w* \w from the midst| strong="H996" \w* \w of Sihon| strong="H5511" \w*, [and shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the corner| strong="H6285" \w* \w of Moab| strong="H4124" \w*, \w and the crown of the head| strong="H6936" \w* \w of the tumultuous| strong="H7588" \w* \w ones| strong="H1121" \w*.\f + \fr 48:45 \ft tumultuous…: Heb. children of noise \f* 
\v 46 \w Woe| strong="H188" \w* [be unto thee, O Moab]{strong=“H4124”}! \w the people| strong="H5971" \w* \w of Chemosh| strong="H3645" \w* [perisheth]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”}: \w for thy sons| strong="H1121" \w* [are taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8795”} \w captives| strong="H7628" \w*, \w and thy daughters| strong="H1323" \w* \w captives| strong="H7633" \w*.\f + \fr 48:46 \ft captives, and: Heb. in captivity, etc \f* 
\p
\v 47 [Yet will I bring again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w the captivity| strong="H7622" \w* \w of Moab| strong="H4124" \w* \w in the latter| strong="H319" \w* \w days| strong="H3117" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. \w Thus far| strong="H2008" \w* is \w the judgment| strong="H4941" \w* \w of Moab| strong="H4124" \w*. 
\c 49
\p 
\v 1 [Concerning the Ammonites]{strong=“H5983 H1121”}, [thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; \w Hath Israel| strong="H3478" \w* \w no sons| strong="H1121" \w*? [hath he no heir]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8802”}? why then \w doth their king| strong="H4428" \w* [inherit]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8804”} \w Gad| strong="H1410" \w*, \w and his people| strong="H5971" \w* [dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his cities| strong="H5892" \w*?\f + \fr 49:1 \ft Concerning: or, Against \f* \f + \fr 49:1 \ft their king: or, Melcom \f* 
\v 2 [Therefore, behold, the days]{strong=“H3117”} [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w that I will cause an alarm| strong="H8643" \w* \w of war| strong="H4421" \w* [to be heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8689”} \w in Rabbah| strong="H7237" \w* [of the Ammonites]{strong=“H5983 H1121”}; \w and it shall be a desolate| strong="H8077" \w* \w heap| strong="H8510" \w*, \w and her daughters| strong="H1323" \w* [shall be burned]{strong=“H3341” x-morph=“strongMorph: \sc Th\sc*8799”} \w with fire| strong="H784" \w*: \w then shall Israel| strong="H3478" \w* [be heir]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them that were his heirs]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8802”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 3 [Howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8685”}, \w O Heshbon| strong="H2809" \w*, \w for Ai| strong="H5857" \w* [is spoiled]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8795”}: [cry]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8798”}, \w ye daughters| strong="H1323" \w* \w of Rabbah| strong="H7237" \w*, [gird]{strong=“H2296” x-morph=“strongMorph: \sc Th\sc*8798”} \w you with sackcloth| strong="H8242" \w*; [lament]{strong=“H5594” x-morph=“strongMorph: \sc Th\sc*8798”}, [and run to and fro]{strong=“H7751” x-morph=“strongMorph: \sc Th\sc*8708”} \w by the hedges| strong="H1448" \w*; \w for their king| strong="H4428" \w* [shall go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w into captivity| strong="H1473" \w*, and \w his priests| strong="H3548" \w* \w and his princes| strong="H8269" \w* \w together| strong="H3162" \w*.\f + \fr 49:3 \ft their king: or, Melcom \f* 
\v 4 [Wherefore gloriest]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8691”} \w thou in the valleys| strong="H6010" \w*, [thy flowing]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”} \w valley| strong="H6010" \w*, \w O backsliding| strong="H7728" \w* \w daughter| strong="H1323" \w*? [that trusted]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”} \w in her treasures| strong="H214" \w*, saying, [Who shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} unto me?\f + \fr 49:4 \ft thy…: or, thy valley floweth away \f* 
\v 5 [Behold, I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w a fear| strong="H6343" \w* [upon thee, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc* \w of hosts| strong="H6635" \w*, \w from all those that be about| strong="H5439" \w* [thee; and ye shall be driven out]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8738”} \w every man| strong="H376" \w* \w right forth| strong="H6440" \w*; [and none shall gather up]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8764”} [him that wandereth]{strong=“H5074” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 6 \w And afterward| strong="H310" \w* [I will bring again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w the captivity| strong="H7622" \w* \w of the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\p
\v 7 \w Concerning Edom| strong="H123" \w*, [thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*; Is \w wisdom| strong="H2451" \w* \w no more in Teman| strong="H8487" \w*? \w is counsel| strong="H6098" \w* [perished]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”} [from the prudent]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8801”}? \w is their wisdom| strong="H2451" \w* [vanished]{strong=“H5628” x-morph=“strongMorph: \sc Th\sc*8738”}? 
\v 8 [Flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8798”} [ye, turn back]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8717”}, [dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} [deep]{strong=“H6009” x-morph=“strongMorph: \sc Th\sc*8689”}, [O inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Dedan| strong="H1719" \w*; [for I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w the calamity| strong="H343" \w* \w of Esau| strong="H6215" \w* [upon him, the time]{strong=“H6256”} that [I will visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} him.\f + \fr 49:8 \ft turn…: or, they are turned back \f* 
\v 9 [If grapegatherers]{strong=“H1219” x-morph=“strongMorph: \sc Th\sc*8802”} [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to thee, would they not leave]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8686”} some \w gleaning grapes| strong="H5955" \w*? \w if thieves| strong="H1590" \w* \w by night| strong="H3915" \w*, [they will destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8689”} \w till they have enough| strong="H1767" \w*.\f + \fr 49:9 \ft till…: Heb. their sufficiency \f* 
\v 10 \w But I have made Esau| strong="H6215" \w* [bare]{strong=“H2834” x-morph=“strongMorph: \sc Th\sc*8804”}, [I have uncovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8765”} \w his secret places| strong="H4565" \w*, [and he shall not be able]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [to hide]{strong=“H2247” x-morph=“strongMorph: \sc Th\sc*8736”} [himself: his seed]{strong=“H2233”} [is spoiled]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8795”}, \w and his brethren| strong="H251" \w*, \w and his neighbours| strong="H7934" \w*, and he is not. 
\v 11 [Leave]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy fatherless children| strong="H3490" \w*, I will preserve them [alive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8762”}; \w and let thy widows| strong="H490" \w* [trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} in me. 
\v 12 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Behold, they whose judgment]{strong=“H4941”} was [not to drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”} \w of the cup| strong="H3563" \w* [have assuredly]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”} [drunken]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”}; and art thou he that [shall altogether]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8800”} [go unpunished]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8735”}? [thou shalt not go unpunished]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8735”}, [but thou shalt surely]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”} [drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} of it. 
\v 13 [For I have sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} [by myself, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, \w that Bozrah| strong="H1224" \w* \w shall become a desolation| strong="H8047" \w*, \w a reproach| strong="H2781" \w*, \w a waste| strong="H2721" \w*, \w and a curse| strong="H7045" \w*; \w and all the cities| strong="H5892" \w* \w thereof shall be perpetual| strong="H5769" \w* \w wastes| strong="H2723" \w*. 
\v 14 [I have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w a rumour| strong="H8052" \w* from the \sc Lord\sc*, \w and an ambassador| strong="H6735" \w* [is sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8803”} \w unto the heathen| strong="H1471" \w*, saying, [Gather ye together]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8690”}, [and come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} [against her, and rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”} \w to the battle| strong="H4421" \w*. 
\v 15 [For, lo, I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee small| strong="H6996" \w* \w among the heathen| strong="H1471" \w*, and [despised]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8803”} \w among men| strong="H120" \w*. 
\v 16 \w Thy terribleness| strong="H8606" \w* [hath deceived]{strong=“H5377” x-morph=“strongMorph: \sc Th\sc*8689”} thee, and \w the pride| strong="H2087" \w* \w of thine heart| strong="H3820" \w*, [O thou that dwellest]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the clefts| strong="H2288" \w* \w of the rock| strong="H5553" \w*, [that holdest]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8802”} \w the height| strong="H4791" \w* \w of the hill| strong="H1389" \w*: \w though thou shouldest make thy nest| strong="H7064" \w* [as high]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8686”} \w as the eagle| strong="H5404" \w*, [I will bring thee down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8686”} [from thence, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 17 \w Also Edom| strong="H123" \w* \w shall be a desolation| strong="H8047" \w*: [every one that goeth]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} [by it shall be astonished]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8799”}, [and shall hiss]{strong=“H8319” x-morph=“strongMorph: \sc Th\sc*8799”} \w at all the plagues| strong="H4347" \w* thereof. 
\v 18 \w As in the overthrow| strong="H4114" \w* \w of Sodom| strong="H5467" \w* \w and Gomorrah| strong="H6017" \w* \w and the neighbour| strong="H7934" \w* cities [thereof, saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w no man| strong="H376" \w* [shall abide]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} [there, neither shall a son]{strong=“H1121”} \w of man| strong="H120" \w* [dwell]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”} in it. 
\v 19 [Behold, he shall come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w like a lion| strong="H738" \w* \w from the swelling| strong="H1347" \w* \w of Jordan| strong="H3383" \w* \w against the habitation| strong="H5116" \w* \w of the strong| strong="H386" \w*: [but I will suddenly]{strong=“H7280” x-morph=“strongMorph: \sc Th\sc*8686”} [make him run away]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8686”} from her: and who is [a chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8803”} man, that [I may appoint]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} over her? for who is [like me? and who will appoint me the time]{strong=“H3259” x-morph=“strongMorph: \sc Th\sc*8686”}? and who is [that shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [that will stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* me?\f + \fr 49:19 \ft appoint me…: or, convent me in judgment? \f* 
\v 20 [Therefore hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the counsel| strong="H6098" \w* of the \sc Lord\sc*, [that he hath taken]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8804”} \w against Edom| strong="H123" \w*; \w and his purposes| strong="H4284" \w*, [that he hath purposed]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8804”} [against the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Teman| strong="H8487" \w*: \w Surely the least| strong="H6810" \w* \w of the flock| strong="H6629" \w* [shall draw them out]{strong=“H5498” x-morph=“strongMorph: \sc Th\sc*8799”}: \w surely he shall make their habitations| strong="H5116" \w* [desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8686”} with them. 
\v 21 \w The earth| strong="H776" \w* [is moved]{strong=“H7493” x-morph=“strongMorph: \sc Th\sc*8804”} \w at the noise| strong="H6963" \w* [of their fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8800”}, \w at the cry| strong="H6818" \w* \w the noise| strong="H6963" \w* [thereof was heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the Red| strong="H5488" \w* \w sea| strong="H3220" \w*.\f + \fr 49:21 \ft Red sea: Heb. Weedy sea \f* 
\v 22 [Behold, he shall come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} [and fly]{strong=“H1675” x-morph=“strongMorph: \sc Th\sc*8799”} \w as the eagle| strong="H5404" \w*, [and spread]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8799”} \w his wings| strong="H3671" \w* \w over Bozrah| strong="H1224" \w*: \w and at that day| strong="H3117" \w* \w shall the heart| strong="H3820" \w* \w of the mighty men| strong="H1368" \w* \w of Edom| strong="H123" \w* \w be as the heart| strong="H3820" \w* \w of a woman| strong="H802" \w* [in her pangs]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\p
\v 23 \w Concerning Damascus| strong="H1834" \w*. \w Hamath| strong="H2574" \w* [is confounded]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and Arpad| strong="H774" \w*: [for they have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w evil| strong="H7451" \w* \w tidings| strong="H8052" \w*: [they are fainthearted]{strong=“H4127” x-morph=“strongMorph: \sc Th\sc*8738”}; there is \w sorrow| strong="H1674" \w* \w on the sea| strong="H3220" \w*; [it cannot]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [be quiet]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8687”}.\f + \fr 49:23 \ft fainthearted: Heb. melted \f* \f + \fr 49:23 \ft on…: or, as on the sea \f* 
\v 24 \w Damascus| strong="H1834" \w* [is waxed feeble]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8804”}, and [turneth]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8689”} [herself to flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8800”}, \w and fear| strong="H7374" \w* [hath seized]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8689”} on her: \w anguish| strong="H6869" \w* \w and sorrows| strong="H2256" \w* [have taken]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8804”} [her, as a woman in travail]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 25 \w How is the city| strong="H5892" \w* \w of praise| strong="H8416" \w* [not left]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8795”}, \w the city| strong="H7151" \w* \w of my joy| strong="H4885" \w*! 
\v 26 \w Therefore her young men| strong="H970" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w in her streets| strong="H7339" \w*, \w and all the men| strong="H582" \w* \w of war| strong="H4421" \w* [shall be cut off]{strong=“H1826” x-morph=“strongMorph: \sc Th\sc*8735”} \w in that day| strong="H3117" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*. 
\v 27 [And I will kindle]{strong=“H3341” x-morph=“strongMorph: \sc Th\sc*8689”} \w a fire| strong="H784" \w* \w in the wall| strong="H2346" \w* \w of Damascus| strong="H1834" \w*, [and it shall consume]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w the palaces| strong="H759" \w* [of Ben-hadad]{strong=“H1130”}. 
\p
\v 28 \w Concerning Kedar| strong="H6938" \w*, \w and concerning the kingdoms| strong="H4467" \w* \w of Hazor| strong="H2674" \w*, \w which Nebuchadrezzar| strong="H5019" \w* \w king| strong="H4428" \w* \w of Babylon| strong="H894" \w* [shall smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”}, [thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”} [ye, go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”} \w to Kedar| strong="H6938" \w*, [and spoil]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8798”} \w the men| strong="H1121" \w* \w of the east| strong="H6924" \w*. 
\v 29 \w Their tents| strong="H168" \w* \w and their flocks| strong="H6629" \w* [shall they take away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”}: [they shall take]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w to themselves their curtains| strong="H3407" \w*, \w and all their vessels| strong="H3627" \w*, \w and their camels| strong="H1581" \w*; [and they shall cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Fear]{strong=“H4032”} is \w on every side| strong="H5439" \w*. 
\p
\v 30 [Flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8798”}, [get]{strong=“H5110” x-morph=“strongMorph: \sc Th\sc*8798”} \w you far off| strong="H3966" \w*, [dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} [deep]{strong=“H6009” x-morph=“strongMorph: \sc Th\sc*8689”}, [O ye inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Hazor| strong="H2674" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*; \w for Nebuchadrezzar| strong="H5019" \w* \w king| strong="H4428" \w* \w of Babylon| strong="H894" \w* [hath taken counsel]{strong=“H3289 H6098” x-morph=“strongMorph: \sc Th\sc*8804”} [against you, and hath conceived]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8804”} \w a purpose| strong="H4284" \w* against you.\f + \fr 49:30 \ft get…: Heb. flit greatly \f* 
\v 31 [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [get you up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto the wealthy| strong="H7961" \w* \w nation| strong="H1471" \w*, [that dwelleth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w without care| strong="H983" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, \w which have neither gates| strong="H1817" \w* \w nor bars| strong="H1280" \w*, which [dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} \w alone| strong="H910" \w*.\f + \fr 49:31 \ft wealthy: or, that is at ease \f* 
\v 32 \w And their camels| strong="H1581" \w* \w shall be a booty| strong="H957" \w*, \w and the multitude| strong="H1995" \w* \w of their cattle| strong="H4735" \w* \w a spoil| strong="H7998" \w*: [and I will scatter]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8765”} \w into all winds| strong="H7307" \w* them that are [in the utmost]{strong=“H7112” x-morph=“strongMorph: \sc Th\sc*8803”} \w corners| strong="H6285" \w*; [and I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w their calamity| strong="H343" \w* \w from all sides| strong="H5676" \w* [thereof, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*.\f + \fr 49:32 \ft in…: Heb. cut off into corners, or, that have the corners of their hair polled \f* 
\v 33 \w And Hazor| strong="H2674" \w* \w shall be a dwelling| strong="H4583" \w* \w for dragons| strong="H8577" \w*, and \w a desolation| strong="H8077" \w* \w for| strong="H5704" \w* \w ever| strong="H5769" \w*: \w there shall no man| strong="H376" \w* [abide]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} there, nor any \w son| strong="H1121" \w* \w of man| strong="H120" \w* [dwell]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”} in it. 
\p
\v 34 \w The word| strong="H1697" \w* of the \sc Lord\sc* \w that came to Jeremiah| strong="H3414" \w* \w the prophet| strong="H5030" \w* \w against Elam| strong="H5867" \w* \w in the beginning| strong="H7225" \w* \w of the reign| strong="H4438" \w* \w of Zedekiah| strong="H6667" \w* \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
