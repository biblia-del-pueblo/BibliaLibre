\c 45
\p 
\v 1 \w The word| strong="H1697" \w* \w that Jeremiah| strong="H3414" \w* \w the prophet| strong="H5030" \w* [spake ]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto Baruch| strong="H1263" \w* \w the son| strong="H1121" \w* \w of Neriah| strong="H5374" \w*, [when he had written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8800”} \w these words| strong="H1697" \w* \w in a book| strong="H5612" \w* \w at the mouth| strong="H6310" \w* \w of Jeremiah| strong="H3414" \w*, \w in the fourth| strong="H7243" \w* \w year| strong="H8141" \w* \w of Jehoiakim| strong="H3079" \w* \w the son| strong="H1121" \w* \w of Josiah| strong="H2977" \w* \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*, [unto thee, O Baruch]{strong=“H1263”}; 
\v 3 [Thou didst say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Woe| strong="H188" \w* is me now! for the \sc Lord\sc* [hath added]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8804”} \w grief| strong="H3015" \w* \w to my sorrow| strong="H4341" \w*; [I fainted]{strong=“H3021” x-morph=“strongMorph: \sc Th\sc*8804”} \w in my sighing| strong="H585" \w*, [and I find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w no rest| strong="H4496" \w*. 
\p
\v 4 [Thus shalt thou say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, The \sc Lord\sc* [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} thus; Behold, that [which I have built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} [will I break down]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8802”}, [and that which I have planted]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8804”} [I will pluck up]{strong=“H5428” x-morph=“strongMorph: \sc Th\sc*8802”}, \w even this whole land| strong="H776" \w*. 
\v 5 [And seekest]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w thou great things| strong="H1419" \w* [for thyself? seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} them [not: for, behold, I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w evil| strong="H7451" \w* \w upon all flesh| strong="H1320" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: \w but thy life| strong="H5315" \w* [will I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto thee for a prey| strong="H7998" \w* \w in all places| strong="H4725" \w* [whither thou goest]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\c 46
\p 
\v 1 \w The word| strong="H1697" \w* of the \sc Lord\sc* \w which came to Jeremiah| strong="H3414" \w* \w the prophet| strong="H5030" \w* \w against the Gentiles| strong="H1471" \w*; 
\v 2 \w Against Egypt| strong="H4714" \w*, \w against the army| strong="H2428" \w* [of Pharaoh-necho]{strong=“H6549”} \w king| strong="H4428" \w* \w of Egypt| strong="H4714" \w*, \w which was by the river| strong="H5104" \w* \w Euphrates| strong="H6578" \w* \w in Carchemish| strong="H3751" \w*, \w which Nebuchadrezzar| strong="H5019" \w* \w king| strong="H4428" \w* \w of Babylon| strong="H894" \w* [smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w in the fourth| strong="H7243" \w* \w year| strong="H8141" \w* \w of Jehoiakim| strong="H3079" \w* \w the son| strong="H1121" \w* \w of Josiah| strong="H2977" \w* \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w*. 
