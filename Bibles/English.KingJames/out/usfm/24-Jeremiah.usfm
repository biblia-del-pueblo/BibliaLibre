\v 28 [And it shall be, if they refuse]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8762”} [to take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} \w the cup| strong="H3563" \w* \w at thine hand| strong="H3027" \w* [to drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”}, [then shalt thou say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*; [Ye shall certainly]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”} [drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 29 [For, lo, I begin]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8688”} [to bring evil]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8687”} \w on the city| strong="H5892" \w* [which is called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8738”} \w by my name| strong="H8034" \w*, [and should ye be utterly]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8736”} [unpunished]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8735”}? [Ye shall not be unpunished]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8736”}: [for I will call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8802”} \w for a sword| strong="H2719" \w* [upon all the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the earth| strong="H776" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*.\f + \fr 25:29 \ft which…: Heb. upon which my name is called \f* 
\p
\v 30 [Therefore prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8735”} \w thou against them all these words| strong="H1697" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} unto them, The \sc Lord\sc* [shall roar]{strong=“H7580” x-morph=“strongMorph: \sc Th\sc*8799”} \w from on high| strong="H4791" \w*, [and utter]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w his voice| strong="H6963" \w* \w from his holy| strong="H6944" \w* \w habitation| strong="H4583" \w*; [he shall mightily]{strong=“H7580” x-morph=“strongMorph: \sc Th\sc*8800”} [roar]{strong=“H7580” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon his habitation| strong="H5116" \w*; [he shall give]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w a shout| strong="H1959" \w*, [as they that tread]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8802”} the grapes, [against all the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the earth| strong="H776" \w*. 
\v 31 \w A noise| strong="H7588" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} even \w to the ends| strong="H7097" \w* \w of the earth| strong="H776" \w*; for the \sc Lord\sc* \w hath a controversy| strong="H7379" \w* \w with the nations| strong="H1471" \w*, [he will plead]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8737”} \w with all flesh| strong="H1320" \w*; [he will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} them that are \w wicked| strong="H7563" \w* \w to the sword| strong="H2719" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 32 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [Behold, evil]{strong=“H7451”} [shall go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} \w from nation| strong="H1471" \w* \w to nation| strong="H1471" \w*, \w and a great| strong="H1419" \w* \w whirlwind| strong="H5591" \w* [shall be raised up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8735”} \w from the coasts| strong="H3411" \w* \w of the earth| strong="H776" \w*. 
\v 33 \w And the slain| strong="H2491" \w* of the \sc Lord\sc* \w shall be at that day| strong="H3117" \w* from one \w end| strong="H7097" \w* \w of the earth| strong="H776" \w* even unto the other \w end| strong="H7097" \w* \w of the earth| strong="H776" \w*: [they shall not be lamented]{strong=“H5594” x-morph=“strongMorph: \sc Th\sc*8735”}, [neither gathered]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8735”}, [nor buried]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8735”}; \w they shall be dung| strong="H1828" \w* \w upon| strong="H6440" \w* \w the ground| strong="H127" \w*. 
\p
\v 34 [Howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8685”}, [ye shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}, [and cry]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8798”}; [and wallow]{strong=“H6428” x-morph=“strongMorph: \sc Th\sc*8690”} yourselves in the ashes, \w ye principal| strong="H117" \w* \w of the flock| strong="H6629" \w*: \w for the days| strong="H3117" \w* [of your slaughter]{strong=“H2873” x-morph=“strongMorph: \sc Th\sc*8800”} \w and of your dispersions| strong="H8600" \w* [are accomplished]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”}; [and ye shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} \w like a pleasant| strong="H2532" \w* \w vessel| strong="H3627" \w*.\f + \fr 25:34 \ft the days…: Heb. your days for slaughter \f* \f + \fr 25:34 \ft a pleasant…: Heb. a vessel of desire \f* 
\v 35 [And the shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} \w shall have no way| strong="H4498" \w* [to flee]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”}, \w nor the principal| strong="H117" \w* \w of the flock| strong="H6629" \w* \w to escape| strong="H6413" \w*.\f + \fr 25:35 \ft the shepherds…: Heb. flight shall perish from the shepherds, and escaping from, etc \f* 
