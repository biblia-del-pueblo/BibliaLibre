\v 8 This is \w the word| strong="H1697" \w* \w that came unto Jeremiah| strong="H3414" \w* from the \sc Lord\sc*, \w after| strong="H310" \w* \w that the king| strong="H4428" \w* \w Zedekiah| strong="H6667" \w* [had made]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8800”} \w a covenant| strong="H1285" \w* \w with all the people| strong="H5971" \w* which were \w at Jerusalem| strong="H3389" \w*, [to proclaim]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8800”} \w liberty| strong="H1865" \w* unto them; 
\v 9 \w That every man| strong="H376" \w* \w should let his manservant| strong="H5650" \w*, \w and every man| strong="H376" \w* \w his maidservant| strong="H8198" \w*, being \w an Hebrew| strong="H5680" \w* \w or an Hebrewess| strong="H5680" \w*, [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8763”} \w free| strong="H2670" \w*; [that none should serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8800”} himself of them, to wit, \w of a Jew| strong="H3064" \w* \w his brother| strong="H251" \w*. 
