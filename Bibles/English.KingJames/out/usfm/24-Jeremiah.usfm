\c 50
\p 
\v 1 \w The word| strong="H1697" \w* that the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w against Babylon| strong="H894" \w* and \w against the land| strong="H776" \w* \w of the Chaldeans| strong="H3778" \w* \w by| strong="H3027" \w* \w Jeremiah| strong="H3414" \w* \w the prophet| strong="H5030" \w*.\f + \fr 50:1 \ft by…: Heb. by the hand of Jeremiah \f* 
\v 2 [Declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”} \w ye among the nations| strong="H1471" \w*, [and publish]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8685”}, [and set up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w a standard| strong="H5251" \w*; [publish]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8685”}, and [conceal]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8762”} [not: say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”}, \w Babylon| strong="H894" \w* [is taken]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8738”}, \w Bel| strong="H1078" \w* [is confounded]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”}, \w Merodach| strong="H4781" \w* [is broken in pieces]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8804”}; \w her idols| strong="H6091" \w* [are confounded]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”}, \w her images| strong="H1544" \w* [are broken in pieces]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 50:2 \ft set up: Heb. lift up \f* 
\v 3 \w For out of the north| strong="H6828" \w* [there cometh up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w a nation| strong="H1471" \w* [against her, which shall make]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w her land| strong="H776" \w* \w desolate| strong="H8047" \w*, [and none shall dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} [therein: they shall remove]{strong=“H5110” x-morph=“strongMorph: \sc Th\sc*8804”}, [they shall depart]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”}, \w both man| strong="H120" \w* \w and beast| strong="H929" \w*. 
\p
\v 4 \w In those days| strong="H3117" \w*, \w and in that time| strong="H6256" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, \w they and the children| strong="H1121" \w* \w of Judah| strong="H3063" \w* \w together| strong="H3162" \w*, [going]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”} [and weeping]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8800”}: [they shall go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [and seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} the \sc Lord\sc* \w their God| strong="H430" \w*. 
\v 5 [They shall ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} \w the way| strong="H1870" \w* \w to Zion| strong="H6726" \w* \w with their faces| strong="H6440" \w* \w thitherward| strong="H2008" \w*, saying, [Come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”}, [and let us join]{strong=“H3867” x-morph=“strongMorph: \sc Th\sc*8738”} ourselves to the \sc Lord\sc* \w in a perpetual| strong="H5769" \w* \w covenant| strong="H1285" \w* that [shall not be forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 6 \w My people| strong="H5971" \w* [hath been lost]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8802”} \w sheep| strong="H6629" \w*: [their shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [have caused them to go astray]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8689”}, [they have turned them away]{strong=“H7726 H7725” x-morph=“strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8790”} on \w the mountains| strong="H2022" \w*: [they have gone]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w from mountain| strong="H2022" \w* \w to hill| strong="H1389" \w*, [they have forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} \w their restingplace| strong="H7258" \w*.\f + \fr 50:6 \ft restingplace: Heb. place to lie down in \f* 
\v 7 [All that found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8802”} [them have devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} [them: and their adversaries]{strong=“H6862”} [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [We offend]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8799”} [not, because they have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} against the \sc Lord\sc*, \w the habitation| strong="H5116" \w* \w of justice| strong="H6664" \w*, even the \sc Lord\sc*, \w the hope| strong="H4723" \w* \w of their fathers| strong="H1" \w*. 
\v 8 [Remove]{strong=“H5110” x-morph=“strongMorph: \sc Th\sc*8798”} \w out of the midst| strong="H8432" \w* \w of Babylon| strong="H894" \w*, [and go forth]{strong=“H3318 H3318” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8798”} \w out of the land| strong="H776" \w* \w of the Chaldeans| strong="H3778" \w*, \w and be as the he goats| strong="H6260" \w* \w before| strong="H6440" \w* \w the flocks| strong="H6629" \w*. 
\p
\v 9 [For, lo, I will raise]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8688”} [and cause to come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8688”} \w against Babylon| strong="H894" \w* \w an assembly| strong="H6951" \w* \w of great| strong="H1419" \w* \w nations| strong="H1471" \w* \w from the north| strong="H6828" \w* \w country| strong="H776" \w*: [and they shall set themselves in array]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8804”} [against her; from thence she shall be taken]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8735”}: \w their arrows| strong="H2671" \w* shall be \w as of a mighty| strong="H1368" \w* [expert man]{strong=“H7921 H7919” x-morph=“strongMorph: \sc Th\sc*8688 strongMorph: \sc Th\sc*8676 strongMorph: \sc Th\sc*8688”}; [none shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w in vain| strong="H7387" \w*.\f + \fr 50:9 \ft expert…: or, destroyer \f* 
\v 10 \w And Chaldea| strong="H3778" \w* \w shall be a spoil| strong="H7998" \w*: [all that spoil]{strong=“H7997” x-morph=“strongMorph: \sc Th\sc*8802”} [her shall be satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 11 [Because ye were glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”}, [because ye rejoiced]{strong=“H5937” x-morph=“strongMorph: \sc Th\sc*8799”}, [O ye destroyers]{strong=“H8154” x-morph=“strongMorph: \sc Th\sc*8802”} \w of mine heritage| strong="H5159" \w*, [because ye are grown fat]{strong=“H6335” x-morph=“strongMorph: \sc Th\sc*8799”} \w as the heifer| strong="H5697" \w* [at grass]{strong=“H1758 H1877” x-morph=“strongMorph: \sc Th\sc*8801 strongMorph: \sc Th\sc*8676”}, [and bellow]{strong=“H6670” x-morph=“strongMorph: \sc Th\sc*8799”} \w as bulls| strong="H47" \w*;\f + \fr 50:11 \ft fat: Heb. big, or, corpulent \f* \f + \fr 50:11 \ft bellow…: or, neigh as steeds \f* 
\v 12 \w Your mother| strong="H517" \w* \w shall be sore| strong="H3966" \w* [confounded]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8804”}; [she that bare]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”} [you shall be ashamed]{strong=“H2659” x-morph=“strongMorph: \sc Th\sc*8804”}: [behold, the hindermost]{strong=“H319”} \w of the nations| strong="H1471" \w* shall be \w a wilderness| strong="H4057" \w*, \w a dry land| strong="H6723" \w*, \w and a desert| strong="H6160" \w*. 
\v 13 \w Because of the wrath| strong="H7110" \w* of the \sc Lord\sc* [it shall not be inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”}, \w but it shall be wholly desolate| strong="H8077" \w*: [every one that goeth]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} \w by Babylon| strong="H894" \w* [shall be astonished]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8799”}, [and hiss]{strong=“H8319” x-morph=“strongMorph: \sc Th\sc*8799”} \w at all her plagues| strong="H4347" \w*. 
\v 14 [Put yourselves in array]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8798”} \w against Babylon| strong="H894" \w* \w round about| strong="H5439" \w*: [all ye that bend]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8802”} \w the bow| strong="H7198" \w*, [shoot]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8798”} [at her, spare]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”} \w no arrows| strong="H2671" \w*: [for she hath sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} against the \sc Lord\sc*. 
\v 15 [Shout]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8685”} \w against her round about| strong="H5439" \w*: [she hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w her hand| strong="H3027" \w*: \w her foundations| strong="H803" \w* [are fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”}, \w her walls| strong="H2346" \w* [are thrown down]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8738”}: for it is \w the vengeance| strong="H5360" \w* of the \sc Lord\sc*: [take vengeance]{strong=“H5358” x-morph=“strongMorph: \sc Th\sc*8734”} [upon her; as she hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} unto her. 
\v 16 [Cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8798”} [the sower]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8802”} \w from Babylon| strong="H894" \w*, [and him that handleth]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8802”} \w the sickle| strong="H4038" \w* \w in the time| strong="H6256" \w* \w of harvest| strong="H7105" \w*: \w for fear| strong="H6440" \w* [of the oppressing]{strong=“H3238” x-morph=“strongMorph: \sc Th\sc*8802”} \w sword| strong="H2719" \w* [they shall turn]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8799”} \w every one| strong="H376" \w* \w to his people| strong="H5971" \w*, [and they shall flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”} \w every one| strong="H376" \w* \w to his own land| strong="H776" \w*.\f + \fr 50:16 \ft sickle: or, scythe \f* 
\p
\v 17 \w Israel| strong="H3478" \w* is [a scattered]{strong=“H6340” x-morph=“strongMorph: \sc Th\sc*8801”} \w sheep| strong="H7716" \w*; \w the lions| strong="H738" \w* have driven him [away]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8689”}: \w first| strong="H7223" \w* \w the king| strong="H4428" \w* \w of Assyria| strong="H804" \w* [hath devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} [him; and last]{strong=“H314”} \w this Nebuchadrezzar| strong="H5019" \w* \w king| strong="H4428" \w* \w of Babylon| strong="H894" \w* [hath broken his bones]{strong=“H6105” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 18 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*; [Behold, I will punish]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8802”} \w the king| strong="H4428" \w* \w of Babylon| strong="H894" \w* \w and his land| strong="H776" \w*, [as I have punished]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} \w the king| strong="H4428" \w* \w of Assyria| strong="H804" \w*. 
