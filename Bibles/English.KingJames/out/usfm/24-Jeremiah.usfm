\v 36 \w And upon Elam| strong="H5867" \w* [will I bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w the four| strong="H702" \w* \w winds| strong="H7307" \w* \w from the four| strong="H702" \w* \w quarters| strong="H7098" \w* \w of heaven| strong="H8064" \w*, [and will scatter]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8765”} \w them toward all those winds| strong="H7307" \w*; \w and there shall be no nation| strong="H1471" \w* [whither the outcasts]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8737”} [of Elam]{strong=“H5769 H5867” x-morph=“strongMorph: \sc Th\sc*8675”} [shall not come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 37 \w For I will cause Elam| strong="H5867" \w* [to be dismayed]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8689”} \w before| strong="H6440" \w* [their enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and before| strong="H6440" \w* [them that seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w their life| strong="H5315" \w*: [and I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w evil| strong="H7451" \w* upon them, even \w my fierce| strong="H2740" \w* \w anger| strong="H639" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*; [and I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w the sword| strong="H2719" \w* \w after| strong="H310" \w* [them, till I have consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8763”} them: 
