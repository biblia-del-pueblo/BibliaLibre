\p
\v 27 [But fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [not thou, O my servant]{strong=“H5650”} \w Jacob| strong="H3290" \w*, [and be not dismayed]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8735”}, \w O Israel| strong="H3478" \w*: [for, behold, I will save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8688”} \w thee from afar off| strong="H7350" \w*, \w and thy seed| strong="H2233" \w* \w from the land| strong="H776" \w* \w of their captivity| strong="H7628" \w*; \w and Jacob| strong="H3290" \w* [shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”}, [and be in rest]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8804”} [and at ease]{strong=“H7599” x-morph=“strongMorph: \sc Th\sc*8768”}, and none shall make him [afraid]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 28 [Fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [thou not, O Jacob]{strong=“H3290”} \w my servant| strong="H5650" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: for I am [with thee; for I will make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w a full end| strong="H3617" \w* \w of all the nations| strong="H1471" \w* [whither I have driven]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8689”} [thee: but I will not make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w a full end| strong="H3617" \w* [of thee, but correct]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8765”} \w thee in measure| strong="H4941" \w*; [yet will I not leave thee wholly]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8763”} [unpunished]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8762”}.\f + \fr 46:28 \ft not leave…: or, not utterly cut thee off \f*
\c 47
\p 
\v 1 \w The word| strong="H1697" \w* of the \sc Lord\sc* \w that came to Jeremiah| strong="H3414" \w* \w the prophet| strong="H5030" \w* \w against the Philistines| strong="H6430" \w*, \w before that Pharaoh| strong="H6547" \w* [smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w Gaza| strong="H5804" \w*.\f + \fr 47:1 \ft Gaza: Heb. Azzah \f* 
\v 2 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Behold, waters]{strong=“H4325”} [rise up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8802”} \w out of the north| strong="H6828" \w*, [and shall be an overflowing]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8802”} \w flood| strong="H5158" \w*, [and shall overflow]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8799”} \w the land| strong="H776" \w*, \w and all that is therein| strong="H4393" \w*; \w the city| strong="H5892" \w*, [and them that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} [therein: then the men]{strong=“H120”} [shall cry]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8804”}, [and all the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the land| strong="H776" \w* [shall howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8689”}.\f + \fr 47:2 \ft all that…: Heb. the fulness thereof \f* 
\v 3 \w At the noise| strong="H6963" \w* \w of the stamping| strong="H8161" \w* \w of the hoofs| strong="H6541" \w* \w of his strong| strong="H47" \w* horses, \w at the rushing| strong="H7494" \w* \w of his chariots| strong="H7393" \w*, and at \w the rumbling| strong="H1995" \w* \w of his wheels| strong="H1534" \w*, \w the fathers| strong="H1" \w* [shall not look back]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8689”} to their \w children| strong="H1121" \w* \w for feebleness| strong="H7510" \w* \w of hands| strong="H3027" \w*; 
\v 4 \w Because of the day| strong="H3117" \w* [that cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [to spoil]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8800”} \w all the Philistines| strong="H6430" \w*, and [to cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8687”} \w from Tyrus| strong="H6865" \w* \w and Zidon| strong="H6721" \w* [every helper]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8802”} \w that remaineth| strong="H8300" \w*: for the \sc Lord\sc* [will spoil]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8802”} \w the Philistines| strong="H6430" \w*, \w the remnant| strong="H7611" \w* \w of the country| strong="H339" \w* \w of Caphtor| strong="H3731" \w*.\f + \fr 47:4 \ft the country: Heb. the isle \f* 
\v 5 \w Baldness| strong="H7144" \w* [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon Gaza| strong="H5804" \w*; \w Ashkelon| strong="H831" \w* [is cut off]{strong=“H1820” x-morph=“strongMorph: \sc Th\sc*8738”} with \w the remnant| strong="H7611" \w* \w of their valley| strong="H6010" \w*: [how long wilt thou cut]{strong=“H1413” x-morph=“strongMorph: \sc Th\sc*8704”} thyself? 
\v 6 \w O| strong="H1945" \w* \w thou sword| strong="H2719" \w* of the \sc Lord\sc*, how long will it be \w ere| strong="H3808" \w* [thou be quiet]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8799”}? [put up]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8734”} \w thyself into thy scabbard| strong="H8593" \w*, [rest]{strong=“H7280” x-morph=“strongMorph: \sc Th\sc*8734”}, [and be still]{strong=“H1826” x-morph=“strongMorph: \sc Th\sc*8798”}.\f + \fr 47:6 \ft put…: Heb. gather thyself \f* 
\v 7 [How can it be quiet]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8799”}, seeing the \sc Lord\sc* [hath given it a charge]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w against Ashkelon| strong="H831" \w*, \w and against the sea| strong="H3220" \w* \w shore| strong="H2348" \w*? [there hath he appointed]{strong=“H3259” x-morph=“strongMorph: \sc Th\sc*8804”} it.\f + \fr 47:7 \ft How…: Heb. How canst thou \f*
\c 48
\p 
\v 1 \w Against Moab| strong="H4124" \w* [thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*; \w Woe| strong="H1945" \w* \w unto Nebo| strong="H5015" \w*! [for it is spoiled]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8795”}: \w Kiriathaim| strong="H7156" \w* [is confounded]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”} and [taken]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8738”}: \w Misgab| strong="H4869" \w* [is confounded]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”} [and dismayed]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 48:1 \ft Misgab: or, the high place \f* 
\v 2 There shall be \w no more praise| strong="H8416" \w* \w of Moab| strong="H4124" \w*: \w in Heshbon| strong="H2809" \w* [they have devised]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8804”} \w evil| strong="H7451" \w* [against it; come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [and let us cut it off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8686”} from being \w a nation| strong="H1471" \w*. [Also thou shalt be cut down]{strong=“H1826” x-morph=“strongMorph: \sc Th\sc*8735”}, \w O Madmen| strong="H4086" \w*; \w the sword| strong="H2719" \w* [shall pursue]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee| strong="H310" \w*.\f + \fr 48:2 \ft be cut…: or, be brought to silence \f* \f + \fr 48:2 \ft pursue…: Heb. go after thee \f* 
\v 3 \w A voice| strong="H6963" \w* \w of crying| strong="H6818" \w* shall be \w from Horonaim| strong="H2773" \w*, \w spoiling| strong="H7701" \w* \w and great| strong="H1419" \w* \w destruction| strong="H7667" \w*. 
\v 4 \w Moab| strong="H4124" \w* [is destroyed]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8738”}; \w her little ones| strong="H6810" \w* \w have caused a cry| strong="H2201" \w* [to be heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8689”}. 
