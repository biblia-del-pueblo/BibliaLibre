\c 28
\p 
\v 1 \w And it came to pass the same year| strong="H8141" \w*, \w in the beginning| strong="H7225" \w* \w of the reign| strong="H4467" \w* \w of Zedekiah| strong="H6667" \w* \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w*, \w in the fourth| strong="H7243" \w* \w year| strong="H8141" \w*, and \w in the fifth| strong="H2549" \w* \w month| strong="H2320" \w*, that \w Hananiah| strong="H2608" \w* \w the son| strong="H1121" \w* \w of Azur| strong="H5809" \w* \w the prophet| strong="H5030" \w*, which was \w of Gibeon| strong="H1391" \w*, [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto me in the house| strong="H1004" \w* of the \sc Lord\sc*, \w in the presence| strong="H5869" \w* \w of the priests| strong="H3548" \w* \w and of all the people| strong="H5971" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Thus speaketh]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [I have broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8804”} \w the yoke| strong="H5923" \w* \w of the king| strong="H4428" \w* \w of Babylon| strong="H894" \w*. 
\v 3 \w Within two full| strong="H3117" \w* \w years| strong="H8141" \w* [will I bring again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8688”} \w into this place| strong="H4725" \w* \w all the vessels| strong="H3627" \w* of the \sc Lord\sc*’S \w house| strong="H1004" \w*, \w that Nebuchadnezzar| strong="H5019" \w* \w king| strong="H4428" \w* \w of Babylon| strong="H894" \w* [took away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w from this place| strong="H4725" \w*, [and carried]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w them to Babylon| strong="H894" \w*:\f + \fr 28:3 \ft two…: Heb. two years of days \f* 
\v 4 [And I will bring again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8688”} \w to this place| strong="H4725" \w* \w Jeconiah| strong="H3204" \w* \w the son| strong="H1121" \w* \w of Jehoiakim| strong="H3079" \w* \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w*, \w with all the captives| strong="H1546" \w* \w of Judah| strong="H3063" \w*, [that went]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w into Babylon| strong="H894" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: [for I will break]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8799”} \w the yoke| strong="H5923" \w* \w of the king| strong="H4428" \w* \w of Babylon| strong="H894" \w*.\f + \fr 28:4 \ft captives: Heb. captivity \f* 
\p
\v 5 \w Then the prophet| strong="H5030" \w* \w Jeremiah| strong="H3414" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the prophet| strong="H5030" \w* \w Hananiah| strong="H2608" \w* \w in the presence| strong="H5869" \w* \w of the priests| strong="H3548" \w*, \w and in the presence| strong="H5869" \w* \w of all the people| strong="H5971" \w* [that stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the house| strong="H1004" \w* of the \sc Lord\sc*, 
\v 6 \w Even the prophet| strong="H5030" \w* \w Jeremiah| strong="H3414" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Amen| strong="H543" \w*: the \sc Lord\sc* [do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} so: the \sc Lord\sc* [perform]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy words| strong="H1697" \w* [which thou hast prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8738”}, [to bring again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} \w the vessels| strong="H3627" \w* of the \sc Lord\sc*’S \w house| strong="H1004" \w*, \w and all that is carried away captive| strong="H1473" \w*, \w from Babylon| strong="H894" \w* \w into this place| strong="H4725" \w*. 
\v 7 [Nevertheless hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou now this word| strong="H1697" \w* [that I speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} \w in thine ears| strong="H241" \w*, \w and in the ears| strong="H241" \w* \w of all the people| strong="H5971" \w*; 
\v 8 \w The prophets| strong="H5030" \w* \w that have been before| strong="H6440" \w* \w me and before| strong="H6440" \w* \w thee of old| strong="H5769" \w* [prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8735”} \w both against many| strong="H7227" \w* \w countries| strong="H776" \w*, \w and against great| strong="H1419" \w* \w kingdoms| strong="H4467" \w*, \w of war| strong="H4421" \w*, \w and of evil| strong="H7451" \w*, \w and of pestilence| strong="H1698" \w*. 
\v 9 \w The prophet| strong="H5030" \w* [which prophesieth]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8735”} \w of peace| strong="H7965" \w*, \w when the word| strong="H1697" \w* \w of the prophet| strong="H5030" \w* [shall come to pass]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}, then \w shall the prophet| strong="H5030" \w* [be known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8735”}, that the \sc Lord\sc* \w hath truly| strong="H571" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} him. 
\p
\v 10 \w Then Hananiah| strong="H2608" \w* \w the prophet| strong="H5030" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the yoke| strong="H4133" \w* \w from off the prophet| strong="H5030" \w* [Jeremiah’s]{strong=“H3414”} \w neck| strong="H6677" \w*, [and brake]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\v 11 \w And Hananiah| strong="H2608" \w* [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the presence| strong="H5869" \w* \w of all the people| strong="H5971" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Even so will I break]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8799”} \w the yoke| strong="H5923" \w* \w of Nebuchadnezzar| strong="H5019" \w* \w king| strong="H4428" \w* \w of Babylon| strong="H894" \w* \w from the neck| strong="H6677" \w* \w of all nations| strong="H1471" \w* \w within the space of two full| strong="H3117" \w* \w years| strong="H8141" \w*. \w And the prophet| strong="H5030" \w* \w Jeremiah| strong="H3414" \w* [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w his way| strong="H1870" \w*. 
\p
\v 12 \w Then the word| strong="H1697" \w* of the \sc Lord\sc* \w came unto Jeremiah| strong="H3414" \w* the prophet, \w after| strong="H310" \w* \w that Hananiah| strong="H2608" \w* \w the prophet| strong="H5030" \w* [had broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8800”} \w the yoke| strong="H4133" \w* \w from off the neck| strong="H6677" \w* \w of the prophet| strong="H5030" \w* \w Jeremiah| strong="H3414" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 13 [Go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”} [and tell]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w Hananiah| strong="H2608" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Thou hast broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8804”} \w the yokes| strong="H4133" \w* \w of wood| strong="H6086" \w*; [but thou shalt make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w for them yokes| strong="H4133" \w* \w of iron| strong="H1270" \w*. 
\v 14 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*; [I have put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w a yoke| strong="H5923" \w* \w of iron| strong="H1270" \w* \w upon the neck| strong="H6677" \w* \w of all these nations| strong="H1471" \w*, [that they may serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8800”} \w Nebuchadnezzar| strong="H5019" \w* \w king| strong="H4428" \w* \w of Babylon| strong="H894" \w*; [and they shall serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} [him: and I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w him the beasts| strong="H2416" \w* \w of the field| strong="H7704" \w* also. 
\p
\v 15 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w the prophet| strong="H5030" \w* \w Jeremiah| strong="H3414" \w* \w unto Hananiah| strong="H2608" \w* \w the prophet| strong="H5030" \w*, [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [now, Hananiah]{strong=“H2608”}; The \sc Lord\sc* [hath not sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [thee; but thou makest this people]{strong=“H5971”} [to trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8689”} \w in a lie| strong="H8267" \w*. 
\v 16 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Behold, I will cast]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8764”} \w thee from off the face| strong="H6440" \w* \w of the earth| strong="H127" \w*: \w this year| strong="H8141" \w* [thou shalt die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”}, [because thou hast taught]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w rebellion| strong="H5627" \w* against the \sc Lord\sc*.\f + \fr 28:16 \ft rebellion: Heb. revolt \f* 
\v 17 \w So Hananiah| strong="H2608" \w* \w the prophet| strong="H5030" \w* [died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w the same year| strong="H8141" \w* \w in the seventh| strong="H7637" \w* \w month| strong="H2320" \w*.
\c 29
\p 
\v 1 Now these are \w the words| strong="H1697" \w* \w of the letter| strong="H5612" \w* \w that Jeremiah| strong="H3414" \w* \w the prophet| strong="H5030" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w from Jerusalem| strong="H3389" \w* \w unto the residue| strong="H3499" \w* \w of the elders| strong="H2205" \w* \w which were carried away captives| strong="H1473" \w*, \w and to the priests| strong="H3548" \w*, \w and to the prophets| strong="H5030" \w*, \w and to all the people| strong="H5971" \w* \w whom Nebuchadnezzar| strong="H5019" \w* [had carried away captive]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8689”} \w from Jerusalem| strong="H3389" \w* \w to Babylon| strong="H894" \w*; 
\v 2 (\w After| strong="H310" \w* \w that Jeconiah| strong="H3204" \w* \w the king| strong="H4428" \w*, \w and the queen| strong="H1377" \w*, \w and the eunuchs| strong="H5631" \w*, \w the princes| strong="H8269" \w* \w of Judah| strong="H3063" \w* \w and Jerusalem| strong="H3389" \w*, \w and the carpenters| strong="H2796" \w*, \w and the smiths| strong="H4525" \w*, [were departed]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”} \w from Jerusalem| strong="H3389" \w*;)\f + \fr 29:2 \ft eunuchs: or, chamberlains \f* 
\v 3 \w By the hand| strong="H3027" \w* \w of Elasah| strong="H501" \w* \w the son| strong="H1121" \w* \w of Shaphan| strong="H8227" \w*, \w and Gemariah| strong="H1587" \w* \w the son| strong="H1121" \w* \w of Hilkiah| strong="H2518" \w*, (\w whom Zedekiah| strong="H6667" \w* \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto Babylon| strong="H894" \w* \w to Nebuchadnezzar| strong="H5019" \w* \w king| strong="H4428" \w* \w of Babylon| strong="H894" \w*) [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 4 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*, \w unto all that are carried away captives| strong="H1473" \w*, [whom I have caused to be carried away]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8689”} \w from Jerusalem| strong="H3389" \w* \w unto Babylon| strong="H894" \w*; 
\v 5 [Build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye houses| strong="H1004" \w*, [and dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8798”} in them; [and plant]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8798”} \w gardens| strong="H1593" \w*, [and eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8798”} \w the fruit| strong="H6529" \w* of them; 
\v 6 [Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye wives| strong="H802" \w*, [and beget]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8685”} \w sons| strong="H1121" \w* \w and daughters| strong="H1323" \w*; [and take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w wives| strong="H802" \w* \w for your sons| strong="H1121" \w*, [and give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w your daughters| strong="H1323" \w* \w to husbands| strong="H582" \w*, [that they may bear]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8799”} \w sons| strong="H1121" \w* \w and daughters| strong="H1121" \w*; [that ye may be increased]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8798”} [there, and not diminished]{strong=“H4591” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 7 [And seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8798”} \w the peace| strong="H7965" \w* \w of the city| strong="H5892" \w* [whither I have caused you to be carried away captives]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8689”}, [and pray]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8690”} unto the \sc Lord\sc* [for it: for in the peace]{strong=“H7965”} \w thereof shall ye have peace| strong="H7965" \w*. 
\p
\v 8 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*; \w Let not your prophets| strong="H5030" \w* [and your diviners]{strong=“H7080” x-morph=“strongMorph: \sc Th\sc*8802”}, that be \w in the midst| strong="H7130" \w* [of you, deceive]{strong=“H5377” x-morph=“strongMorph: \sc Th\sc*8686”} [you, neither hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w to your dreams| strong="H2472" \w* [which ye cause to be dreamed]{strong=“H2492” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 9 [For they prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8737”} \w falsely| strong="H8267" \w* \w unto you in my name| strong="H8034" \w*: [I have not sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [them, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*.\f + \fr 29:9 \ft falsely: Heb. in a lie \f* 
\p
\v 10 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w That after| strong="H6310" \w* \w seventy| strong="H7657" \w* \w years| strong="H8141" \w* [be accomplished]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8800”} \w at Babylon| strong="H894" \w* [I will visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} [you, and perform]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} \w my good| strong="H2896" \w* \w word| strong="H1697" \w* [toward you, in causing you to return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} \w to this place| strong="H4725" \w*. 
\v 11 [For I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w the thoughts| strong="H4284" \w* [that I think]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8802”} [toward you, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, \w thoughts| strong="H4284" \w* \w of peace| strong="H7965" \w*, \w and not of evil| strong="H7451" \w*, [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w you an expected| strong="H8615" \w* \w end| strong="H319" \w*.\f + \fr 29:11 \ft expected…: Heb. end and expectation \f* 
\v 12 [Then shall ye call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [upon me, and ye shall go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} [and pray]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8694”} [unto me, and I will hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} unto you. 
\v 13 [And ye shall seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8765”} [me, and find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} me, [when ye shall search]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”} \w for me with all your heart| strong="H3824" \w*. 
\v 14 [And I will be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8738”} [of you, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: [and I will turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} [your captivity]{strong=“H7622 H7622” x-morph=“strongMorph: \sc Th\sc*8675”}, [and I will gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8765”} \w you from all the nations| strong="H1471" \w*, \w and from all the places| strong="H4725" \w* [whither I have driven]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8689”} [you, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*; [and I will bring you again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} \w into the place| strong="H4725" \w* [whence I caused you to be carried away captive]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\p
\v 15 [Because ye have said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, The \sc Lord\sc* [hath raised us up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} \w prophets| strong="H5030" \w* \w in Babylon| strong="H894" \w*; 
\v 16 Know [that thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of the king| strong="H4428" \w* [that sitteth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the throne| strong="H3678" \w* \w of David| strong="H1732" \w*, \w and of all the people| strong="H5971" \w* [that dwelleth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in this city| strong="H5892" \w*, and \w of your brethren| strong="H251" \w* [that are not gone forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w with you into captivity| strong="H1473" \w*; 
\v 17 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*; [Behold, I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8764”} \w upon them the sword| strong="H2719" \w*, \w the famine| strong="H7458" \w*, \w and the pestilence| strong="H1698" \w*, [and will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w them like vile| strong="H8182" \w* \w figs| strong="H8384" \w*, [that cannot be eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8735”}, \w they are so evil| strong="H7455" \w*. 
\v 18 [And I will persecute]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8804”} \w them| strong="H310" \w* \w with the sword| strong="H2719" \w*, \w with the famine| strong="H7458" \w*, \w and with the pestilence| strong="H1698" \w*, [and will deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [them to be removed]{strong=“H2113 H2189” x-morph=“strongMorph: \sc Th\sc*8675”} \w to all the kingdoms| strong="H4467" \w* \w of the earth| strong="H776" \w*, \w to be a curse| strong="H423" \w*, \w and an astonishment| strong="H8047" \w*, \w and an hissing| strong="H8322" \w*, \w and a reproach| strong="H2781" \w*, \w among all the nations| strong="H1471" \w* [whither I have driven]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8689”} them:\f + \fr 29:18 \ft to be a curse: Heb. for a curse \f* 
\v 19 [Because they have not hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w to my words| strong="H1697" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [which I sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto them by my servants| strong="H5650" \w* \w the prophets| strong="H5030" \w*, [rising up early]{strong=“H7925” x-morph=“strongMorph: \sc Th\sc*8687”} [and sending]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8800”} them; [but ye would not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\p
\v 20 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye therefore the word| strong="H1697" \w* of the \sc Lord\sc*, \w all ye of the captivity| strong="H1473" \w*, [whom I have sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w from Jerusalem| strong="H3389" \w* \w to Babylon| strong="H894" \w*: 
\v 21 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*, \w of Ahab| strong="H256" \w* \w the son| strong="H1121" \w* \w of Kolaiah| strong="H6964" \w*, \w and of Zedekiah| strong="H6667" \w* \w the son| strong="H1121" \w* \w of Maaseiah| strong="H4641" \w*, [which prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8737”} \w a lie| strong="H8267" \w* \w unto you in my name| strong="H8034" \w*; [Behold, I will deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w them into the hand| strong="H3027" \w* \w of Nebuchadrezzar| strong="H5019" \w* \w king| strong="H4428" \w* \w of Babylon| strong="H894" \w*; [and he shall slay]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w them before your eyes| strong="H5869" \w*; 
\v 22 [And of them shall be taken up]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8795”} \w a curse| strong="H7045" \w* \w by all the captivity| strong="H1546" \w* \w of Judah| strong="H3063" \w* which are \w in Babylon| strong="H894" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, The \sc Lord\sc* [make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee like Zedekiah| strong="H6667" \w* \w and like Ahab| strong="H256" \w*, \w whom the king| strong="H4428" \w* \w of Babylon| strong="H894" \w* [roasted]{strong=“H7033” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the fire| strong="H784" \w*; 
\v 23 [Because they have committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w villany| strong="H5039" \w* \w in Israel| strong="H3478" \w*, [and have committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [adultery]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8762”} [with their neighbours’]{strong=“H7453”} \w wives| strong="H802" \w*, [and have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w lying| strong="H8267" \w* \w words| strong="H1697" \w* \w in my name| strong="H8034" \w*, [which I have not commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [them; even I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”}, and am \w a witness| strong="H5707" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\p
\v 24 Thus [shalt thou also speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Shemaiah| strong="H8098" \w* \w the Nehelamite| strong="H5161" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”},\f + \fr 29:24 \ft Nehelamite: or, dreamer \f* 
\v 25 [Thus speaketh]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Because thou hast sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w letters| strong="H5612" \w* \w in thy name| strong="H8034" \w* \w unto all the people| strong="H5971" \w* that are \w at Jerusalem| strong="H3389" \w*, \w and to Zephaniah| strong="H6846" \w* \w the son| strong="H1121" \w* \w of Maaseiah| strong="H4641" \w* \w the priest| strong="H3548" \w*, \w and to all the priests| strong="H3548" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 26 The \sc Lord\sc* [hath made]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee priest| strong="H3548" \w* \w in the stead of Jehoiada| strong="H3077" \w* \w the priest| strong="H3548" \w*, \w that ye should be officers| strong="H6496" \w* \w in the house| strong="H1004" \w* of the \sc Lord\sc*, \w for every man| strong="H376" \w* that is [mad]{strong=“H7696” x-morph=“strongMorph: \sc Th\sc*8794”}, [and maketh himself a prophet]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8693”}, [that thou shouldest put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w him in prison| strong="H4115" \w*, \w and in the stocks| strong="H6729" \w*. 
\v 27 [Now therefore why hast thou not reproved]{strong=“H1605” x-morph=“strongMorph: \sc Th\sc*8804”} \w Jeremiah| strong="H3414" \w* \w of Anathoth| strong="H6069" \w*, [which maketh himself a prophet]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8693”} to you? 
\v 28 [For therefore he sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} unto us in \w Babylon| strong="H894" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w This| strong="H1931" \w* captivity is \w long| strong="H752" \w*: [build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye houses| strong="H1004" \w*, [and dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8798”} in them; [and plant]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8798”} \w gardens| strong="H1593" \w*, [and eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8798”} \w the fruit| strong="H6529" \w* of them. 
\v 29 \w And Zephaniah| strong="H6846" \w* \w the priest| strong="H3548" \w* [read]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w this letter| strong="H5612" \w* \w in the ears| strong="H241" \w* \w of Jeremiah| strong="H3414" \w* \w the prophet| strong="H5030" \w*. 
\p
\v 30 \w Then came the word| strong="H1697" \w* of the \sc Lord\sc* \w unto Jeremiah| strong="H3414" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 31 [Send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8798”} \w to all them of the captivity| strong="H1473" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w concerning Shemaiah| strong="H8098" \w* \w the Nehelamite| strong="H5161" \w*; \w Because that Shemaiah| strong="H8098" \w* [hath prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8738”} [unto you, and I sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [him not, and he caused you to trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8686”} \w in a lie| strong="H8267" \w*: 
\v 32 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Behold, I will punish]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8802”} \w Shemaiah| strong="H8098" \w* \w the Nehelamite| strong="H5161" \w*, \w and his seed| strong="H2233" \w*: \w he shall not have a man| strong="H376" \w* [to dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w among| strong="H8432" \w* \w this people| strong="H5971" \w*; [neither shall he behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the good| strong="H2896" \w* [that I will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w for my people| strong="H5971" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*; [because he hath taught]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w rebellion| strong="H5627" \w* against the \sc Lord\sc*.\f + \fr 29:32 \ft rebellion: Heb. revolt \f*
\c 30
\p 
\v 1 \w The word| strong="H1697" \w* \w that came to Jeremiah| strong="H3414" \w* from the \sc Lord\sc*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Thus speaketh]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Write]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee all the words| strong="H1697" \w* [that I have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto thee in a book| strong="H5612" \w*. 
\v 3 [For, lo, the days]{strong=“H3117”} [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [that I will bring again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w the captivity| strong="H7622" \w* \w of my people| strong="H5971" \w* \w Israel| strong="H3478" \w* \w and Judah| strong="H3063" \w*, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*: [and I will cause them to return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} \w to the land| strong="H776" \w* [that I gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w to their fathers| strong="H1" \w*, [and they shall possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8804”} it. 
\p
\v 4 And these are \w the words| strong="H1697" \w* that the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w concerning Israel| strong="H3478" \w* \w and concerning Judah| strong="H3063" \w*. 
\v 5 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [We have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w a voice| strong="H6963" \w* \w of trembling| strong="H2731" \w*, \w of fear| strong="H6343" \w*, \w and not of peace| strong="H7965" \w*.\f + \fr 30:5 \ft of fear…: or, there is fear, and not peace \f* 
\v 6 [Ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8798”} [ye now, and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w whether a man| strong="H2145" \w* [doth travail with child]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”}? [wherefore do I see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w every man| strong="H1397" \w* \w with his hands| strong="H3027" \w* \w on his loins| strong="H2504" \w*, [as a woman in travail]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and all faces| strong="H6440" \w* [are turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8738”} \w into paleness| strong="H3420" \w*?\f + \fr 30:6 \ft a man: Heb. a male \f* 
\v 7 \w Alas| strong="H1945" \w*! \w for that day| strong="H3117" \w* is \w great| strong="H1419" \w*, \w so that| strong="H369" \w* none is like it: it is \w even the time| strong="H6256" \w* [of Jacob’s]{strong=“H3290”} \w trouble| strong="H6869" \w*; [but he shall be saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8735”} out of it. 
\v 8 \w For it shall come to pass in that day| strong="H3117" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, that [I will break]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8799”} \w his yoke| strong="H5923" \w* \w from off thy neck| strong="H6677" \w*, [and will burst]{strong=“H5423” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy bonds| strong="H4147" \w*, [and strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} [shall no more serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} themselves of him: 
\v 9 [But they shall serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w their God| strong="H430" \w*, \w and David| strong="H1732" \w* \w their king| strong="H4428" \w*, [whom I will raise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8686”} unto them. 
\p
\v 10 [Therefore fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [thou not, O my servant]{strong=“H5650”} \w Jacob| strong="H3290" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*; [neither be dismayed]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8735”}, \w O Israel| strong="H3478" \w*: [for, lo, I will save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8688”} \w thee from afar| strong="H7350" \w*, \w and thy seed| strong="H2233" \w* \w from the land| strong="H776" \w* \w of their captivity| strong="H7628" \w*; \w and Jacob| strong="H3290" \w* [shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”}, [and shall be in rest]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8804”}, [and be quiet]{strong=“H7599” x-morph=“strongMorph: \sc Th\sc*8768”}, and none shall make him [afraid]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 11 For I am [with thee, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [to save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8687”} [thee: though I make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w a full end| strong="H3617" \w* \w of all nations| strong="H1471" \w* [whither I have scattered]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8689”} [thee, yet will I not make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w a full end| strong="H3617" \w* [of thee: but I will correct]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8765”} \w thee in measure| strong="H4941" \w*, [and will not leave thee altogether]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8763”} [unpunished]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 12 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w Thy bruise| strong="H7667" \w* is [incurable]{strong=“H605” x-morph=“strongMorph: \sc Th\sc*8803”}, and \w thy wound| strong="H4347" \w* is [grievous]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8737”}. 
\v 13 There is [none to plead]{strong=“H1777” x-morph=“strongMorph: \sc Th\sc*8802”} \w thy cause| strong="H1779" \w*, \w that thou mayest be bound up| strong="H4205" \w*: \w thou hast no healing| strong="H8585" \w* \w medicines| strong="H7499" \w*.\f + \fr 30:13 \ft that…: Heb. for binding up, or, pressing \f* 
\v 14 [All thy lovers]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8764”} [have forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} [thee; they seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”} [thee not; for I have wounded]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee with the wound| strong="H4347" \w* [of an enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, \w with the chastisement| strong="H4148" \w* \w of a cruel one| strong="H394" \w*, \w for the multitude| strong="H7230" \w* \w of thine iniquity| strong="H5771" \w*; because \w thy sins| strong="H2403" \w* [were increased]{strong=“H6105” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 15 [Why criest]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8799”} \w thou for thine affliction| strong="H7667" \w*? \w thy sorrow| strong="H4341" \w* is [incurable]{strong=“H605” x-morph=“strongMorph: \sc Th\sc*8803”} \w for the multitude| strong="H7230" \w* \w of thine iniquity| strong="H5771" \w*: because \w thy sins| strong="H2403" \w* [were increased]{strong=“H6105” x-morph=“strongMorph: \sc Th\sc*8804”}, [I have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} these things unto thee. 
\v 16 [Therefore all they that devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} [thee shall be devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8735”}; \w and all thine adversaries| strong="H6862" \w*, [every one of them, shall go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w into captivity| strong="H7628" \w*; [and they that spoil]{strong=“H8154 H7601” x-morph=“strongMorph: \sc Th\sc*8802 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8802”} \w thee shall be a spoil| strong="H4933" \w*, [and all that prey]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8802”} [upon thee will I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w for a prey| strong="H957" \w*. 
\v 17 [For I will restore]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w health| strong="H724" \w* [unto thee, and I will heal]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee of thy wounds| strong="H4347" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*; [because they called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [thee an Outcast]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8737”}, saying, This is \w Zion| strong="H6726" \w*, [whom no man seeketh after]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\p
\v 18 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Behold, I will bring again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8802”} \w the captivity| strong="H7622" \w* [of Jacob’s]{strong=“H3290”} \w tents| strong="H168" \w*, [and have mercy]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8762”} \w on his dwellingplaces| strong="H4908" \w*; \w and the city| strong="H5892" \w* [shall be builded]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8738”} \w upon her own heap| strong="H8510" \w*, \w and the palace| strong="H759" \w* [shall remain]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w after the manner| strong="H4941" \w* thereof.\f + \fr 30:18 \ft heap: or, little hill \f* 
\v 19 [And out of them shall proceed]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w thanksgiving| strong="H8426" \w* \w and the voice| strong="H6963" \w* [of them that make merry]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8764”}: [and I will multiply]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8689”} [them, and they shall not be few]{strong=“H4591” x-morph=“strongMorph: \sc Th\sc*8799”}; [I will also glorify]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8689”} [them, and they shall not be small]{strong=“H6819” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 20 \w Their children| strong="H1121" \w* \w also shall be as aforetime| strong="H6924" \w*, \w and their congregation| strong="H5712" \w* [shall be established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8735”} \w before| strong="H6440" \w* [me, and I will punish]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} [all that oppress]{strong=“H3905” x-morph=“strongMorph: \sc Th\sc*8801”} them. 
\v 21 \w And their nobles| strong="H117" \w* [shall be of themselves, and their governor]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8802”} [shall proceed]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the midst| strong="H7130" \w* [of them; and I will cause him to draw near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8689”}, [and he shall approach]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8738”} unto me: for who is [this that engaged]{strong=“H6148” x-morph=“strongMorph: \sc Th\sc*8804”} \w his heart| strong="H3820" \w* [to approach]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8800”} [unto me? saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 22 \w And ye shall be my people| strong="H5971" \w*, \w and I will be your God| strong="H430" \w*. 
\v 23 [Behold, the whirlwind]{strong=“H5591”} of the \sc Lord\sc* [goeth forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w with fury| strong="H2534" \w*, [a continuing]{strong=“H1641” x-morph=“strongMorph: \sc Th\sc*8706”} \w whirlwind| strong="H5591" \w*: [it shall fall with pain]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the head| strong="H7218" \w* \w of the wicked| strong="H7563" \w*.\f + \fr 30:23 \ft continuing: Heb. cutting \f* \f + \fr 30:23 \ft fall…: or, remain \f* 
\v 24 \w The fierce| strong="H2740" \w* \w anger| strong="H639" \w* of the \sc Lord\sc* [shall not return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [until he have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} it, [and until he have performed]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8687”} \w the intents| strong="H4209" \w* \w of his heart| strong="H3820" \w*: \w in the latter| strong="H319" \w* \w days| strong="H3117" \w* [ye shall consider]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8709”} it.
\c 31
\p 
\v 1 \w At the same time| strong="H6256" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, \w will I be the God| strong="H430" \w* \w of all the families| strong="H4940" \w* \w of Israel| strong="H3478" \w*, \w and they shall be my people| strong="H5971" \w*. 
\v 2 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w The people| strong="H5971" \w* which were \w left| strong="H8300" \w* \w of the sword| strong="H2719" \w* [found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w grace| strong="H2580" \w* \w in the wilderness| strong="H4057" \w*; even \w Israel| strong="H3478" \w*, [when I went]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”} [to cause him to rest]{strong=“H7280” x-morph=“strongMorph: \sc Th\sc*8687”}. 
\v 3 The \sc Lord\sc* [hath appeared]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8738”} \w of old| strong="H7350" \w* unto me, saying, [Yea, I have loved]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee with an everlasting| strong="H5769" \w* \w love| strong="H160" \w*: \w therefore with lovingkindness| strong="H2617" \w* [have I drawn]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8804”} thee.\f + \fr 31:3 \ft of…: Heb. from afar \f* \f + \fr 31:3 \ft with lovingkindness…: have I extended lovingkindness unto thee \f* 
\v 4 [Again I will build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} [thee, and thou shalt be built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8738”}, \w O virgin| strong="H1330" \w* \w of Israel| strong="H3478" \w*: [thou shalt again be adorned]{strong=“H5710” x-morph=“strongMorph: \sc Th\sc*8799”} \w with thy tabrets| strong="H8596" \w*, [and shalt go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the dances| strong="H4234" \w* [of them that make merry]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8764”}.\f + \fr 31:4 \ft tabrets: or, timbrels \f* 
\v 5 [Thou shalt yet plant]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8799”} \w vines| strong="H3754" \w* \w upon the mountains| strong="H2022" \w* \w of Samaria| strong="H8111" \w*: [the planters]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8802”} [shall plant]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8804”}, and shall eat them [as common things]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8765”}.\f + \fr 31:5 \ft eat…: Heb. profane them \f* 
\v 6 \w For there shall be| strong="H3426" \w* \w a day| strong="H3117" \w*, that [the watchmen]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the mount| strong="H2022" \w* \w Ephraim| strong="H669" \w* [shall cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”}, [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”} [ye, and let us go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Zion| strong="H6726" \w* unto the \sc Lord\sc* \w our God| strong="H430" \w*. 
\v 7 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Sing]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8798”} \w with gladness| strong="H8057" \w* \w for Jacob| strong="H3290" \w*, [and shout]{strong=“H6670” x-morph=“strongMorph: \sc Th\sc*8761”} \w among the chief| strong="H7218" \w* \w of the nations| strong="H1471" \w*: [publish]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8685”} [ye, praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} [ye, and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”}, O \sc Lord\sc*, [save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”} \w thy people| strong="H5971" \w*, \w the remnant| strong="H7611" \w* \w of Israel| strong="H3478" \w*. 
\v 8 [Behold, I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w them from the north| strong="H6828" \w* \w country| strong="H776" \w*, [and gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8765”} \w them from the coasts| strong="H3411" \w* \w of the earth| strong="H776" \w*, and \w with them the blind| strong="H5787" \w* \w and the lame| strong="H6455" \w*, \w the woman with child| strong="H2030" \w* [and her that travaileth with child]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”} \w together| strong="H3162" \w*: \w a great| strong="H1419" \w* \w company| strong="H6951" \w* [shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} thither. 
\v 9 [They shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w with weeping| strong="H1065" \w*, \w and with supplications| strong="H8469" \w* [will I lead]{strong=“H2986” x-morph=“strongMorph: \sc Th\sc*8686”} [them: I will cause them to walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8686”} \w by the rivers| strong="H5158" \w* \w of waters| strong="H4325" \w* \w in a straight| strong="H3477" \w* \w way| strong="H1870" \w*, [wherein they shall not stumble]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8735”}: \w for I am a father| strong="H1" \w* \w to Israel| strong="H3478" \w*, \w and Ephraim| strong="H669" \w* is \w my firstborn| strong="H1060" \w*.\f + \fr 31:9 \ft supplications: or, favours \f* 
\p
\v 10 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* of the \sc Lord\sc*, \w O ye nations| strong="H1471" \w*, [and declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”} it \w in the isles| strong="H339" \w* \w afar off| strong="H4801" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”}, [He that scattered]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8764”} \w Israel| strong="H3478" \w* [will gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8762”} [him, and keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} [him, as a shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} doth \w his flock| strong="H5739" \w*. 
\v 11 For the \sc Lord\sc* [hath redeemed]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8804”} \w Jacob| strong="H3290" \w*, [and ransomed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8804”} \w him from the hand| strong="H3027" \w* of him that was \w stronger| strong="H2389" \w* than he. 
\v 12 [Therefore they shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [and sing]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8765”} \w in the height| strong="H4791" \w* \w of Zion| strong="H6726" \w*, [and shall flow together]{strong=“H5102” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the goodness| strong="H2898" \w* of the \sc Lord\sc*, \w for wheat| strong="H1715" \w*, \w and for wine| strong="H8492" \w*, \w and for oil| strong="H3323" \w*, \w and for the young| strong="H1121" \w* \w of the flock| strong="H6629" \w* \w and of the herd| strong="H1241" \w*: \w and their soul| strong="H5315" \w* \w shall be as a watered| strong="H7302" \w* \w garden| strong="H1588" \w*; [and they shall not sorrow]{strong=“H1669” x-morph=“strongMorph: \sc Th\sc*8800”} [any more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} at all. 
\v 13 \w Then shall the virgin| strong="H1330" \w* [rejoice ]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the dance| strong="H4234" \w*, \w both young men| strong="H970" \w* \w and old| strong="H2205" \w* \w together| strong="H3162" \w*: [for I will turn]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8804”} \w their mourning| strong="H60" \w* \w into joy| strong="H8342" \w*, [and will comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8765”} [them, and make them rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8765”} \w from their sorrow| strong="H3015" \w*. 
\v 14 [And I will satiate]{strong=“H7301” x-morph=“strongMorph: \sc Th\sc*8765”} \w the soul| strong="H5315" \w* \w of the priests| strong="H3548" \w* \w with fatness| strong="H1880" \w*, \w and my people| strong="H5971" \w* [shall be satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”} \w with my goodness| strong="H2898" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\p
\v 15 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; \w A voice| strong="H6963" \w* [was heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8738”} \w in Ramah| strong="H7414" \w*, \w lamentation| strong="H5092" \w*, and \w bitter| strong="H8563" \w* \w weeping| strong="H1065" \w*; \w Rahel| strong="H7354" \w* [weeping]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8764”} \w for her children| strong="H1121" \w* [refused]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8765”} [to be comforted]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8736”} \w for her children| strong="H1121" \w*, because they were not. 
\v 16 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Refrain]{strong=“H4513” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy voice| strong="H6963" \w* \w from weeping| strong="H1065" \w*, \w and thine eyes| strong="H5869" \w* \w from tears| strong="H1832" \w*: \w for thy work| strong="H6468" \w* \w shall be| strong="H3426" \w* \w rewarded| strong="H7939" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*; [and they shall come again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w from the land| strong="H776" \w* [of the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 17 \w And there is| strong="H3426" \w* \w hope| strong="H8615" \w* \w in thine end| strong="H319" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, \w that thy children| strong="H1121" \w* [shall come again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w to their own border| strong="H1366" \w*. 
\p
\v 18 [I have surely]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w Ephraim| strong="H669" \w* [bemoaning]{strong=“H5110” x-morph=“strongMorph: \sc Th\sc*8711”} himself thus; [Thou hast chastised]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8765”} [me, and I was chastised]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8735”}, \w as a bullock| strong="H5695" \w* [unaccustomed]{strong=“H3925 H3808” x-morph=“strongMorph: \sc Th\sc*8795”} to the yoke: [turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”} [thou me, and I shall be turned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}; for thou art the \sc Lord\sc* \w my God| strong="H430" \w*. 
\v 19 \w Surely after| strong="H310" \w* [that I was turned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”}, [I repented]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8738”}; \w and after| strong="H310" \w* [that I was instructed]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8736”}, [I smote]{strong=“H5606” x-morph=“strongMorph: \sc Th\sc*8804”} upon my \w thigh| strong="H3409" \w*: [I was ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8804”}, [yea, even confounded]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8738”}, [because I did bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w the reproach| strong="H2781" \w* \w of my youth| strong="H5271" \w*. 
\v 20 Is \w Ephraim| strong="H669" \w* \w my dear| strong="H3357" \w* \w son| strong="H1121" \w*? is he \w a pleasant| strong="H8191" \w* \w child| strong="H3206" \w*? \w for since| strong="H1767" \w* [I spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} [against him, I do earnestly]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8800”} [remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} [him still: therefore my bowels]{strong=“H4578”} [are troubled]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8804”} [for him; I will surely]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8763”} [have mercy]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8762”} [upon him, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*.\f + \fr 31:20 \ft are…: Heb. sound \f* 
\v 21 [Set thee up]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8685”} \w waymarks| strong="H6725" \w*, [make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee high heaps| strong="H8564" \w*: [set]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8798”} \w thine heart| strong="H3820" \w* \w toward the highway| strong="H4546" \w*, even \w the way| strong="H1870" \w* which [thou wentest]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”}: [turn again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O virgin| strong="H1330" \w* \w of Israel| strong="H3478" \w*, [turn again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} \w to these thy cities| strong="H5892" \w*. 
\p
\v 22 [How long wilt thou go about]{strong=“H2559” x-morph=“strongMorph: \sc Th\sc*8691”}, \w O thou backsliding| strong="H7728" \w* \w daughter| strong="H1323" \w*? for the \sc Lord\sc* [hath created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8804”} \w a new thing| strong="H2319" \w* \w in the earth| strong="H776" \w*, \w A woman| strong="H5347" \w* [shall compass]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8779”} \w a man| strong="H1397" \w*. 
\v 23 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*; [As yet they shall use]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w this speech| strong="H1697" \w* \w in the land| strong="H776" \w* \w of Judah| strong="H3063" \w* \w and in the cities| strong="H5892" \w* [thereof, when I shall bring again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w their captivity| strong="H7622" \w*; The \sc Lord\sc* [bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} [thee, O habitation]{strong=“H5116”} \w of justice| strong="H6664" \w*, and \w mountain| strong="H2022" \w* \w of holiness| strong="H6944" \w*. 
