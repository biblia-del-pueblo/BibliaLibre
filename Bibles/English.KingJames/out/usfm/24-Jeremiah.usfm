\v 46 \w At the noise| strong="H6963" \w* [of the taking]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8738”} \w of Babylon| strong="H894" \w* \w the earth| strong="H776" \w* [is moved]{strong=“H7493” x-morph=“strongMorph: \sc Th\sc*8735”}, \w and the cry| strong="H2201" \w* [is heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8738”} \w among the nations| strong="H1471" \w*.
\c 51
\p 
\v 1 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Behold, I will raise up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8688”} \w against Babylon| strong="H894" \w*, [and against them that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the midst| strong="H3820" \w* [of them that rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8801”} [against me, a destroying]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8688”} \w wind| strong="H7307" \w*;\f + \fr 51:1 \ft midst: Heb. heart \f* 
\v 2 [And will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto Babylon| strong="H894" \w* [fanners]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”}, [that shall fan]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8765”} [her, and shall empty]{strong=“H1238” x-morph=“strongMorph: \sc Th\sc*8787”} \w her land| strong="H776" \w*: \w for in the day| strong="H3117" \w* \w of trouble| strong="H7451" \w* \w they shall be against her round about| strong="H5439" \w*. 
\v 3 Against him that \w bendeth| strong="H1869" \w* [let the archer]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8802”} [bend]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8799”} \w his bow| strong="H7198" \w*, and against him that [lifteth himself up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8691”} \w in his brigandine| strong="H5630" \w*: [and spare]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”} \w ye not her young men| strong="H970" \w*; [destroy ye utterly]{strong=“H2763” x-morph=“strongMorph: \sc Th\sc*8685”} \w all her host| strong="H6635" \w*. 
