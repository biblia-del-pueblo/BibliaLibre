\v 25 [For I have satiated]{strong=“H7301” x-morph=“strongMorph: \sc Th\sc*8689”} \w the weary| strong="H5889" \w* \w soul| strong="H5315" \w*, [and I have replenished]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8765”} [every sorrowful]{strong=“H1669” x-morph=“strongMorph: \sc Th\sc*8804”} \w soul| strong="H5315" \w*. 
