\c 23
\p 
\v 1 \w Woe| strong="H1945" \w* [be unto the pastors]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [that destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8764”} [and scatter]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8688”} \w the sheep| strong="H6629" \w* \w of my pasture| strong="H4830" \w*! [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 2 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w* [against the pastors]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [that feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} \w my people| strong="H5971" \w*; [Ye have scattered]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8689”} \w my flock| strong="H6629" \w*, [and driven them away]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8686”}, [and have not visited]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} [them: behold, I will visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon you the evil| strong="H7455" \w* \w of your doings| strong="H4611" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
