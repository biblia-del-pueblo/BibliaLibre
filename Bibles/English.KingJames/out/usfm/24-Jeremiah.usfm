\v 18 [Thou shewest]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w lovingkindness| strong="H2617" \w* \w unto thousands| strong="H505" \w*, [and recompensest]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8764”} \w the iniquity| strong="H5771" \w* \w of the fathers| strong="H1" \w* \w into the bosom| strong="H2436" \w* \w of their children| strong="H1121" \w* \w after| strong="H310" \w* [them: the Great]{strong=“H1419”}, \w the Mighty| strong="H1368" \w* \w God| strong="H410" \w*, the \sc Lord\sc* \w of hosts| strong="H6635" \w*, is \w his name| strong="H8034" \w*, 
\v 19 \w Great| strong="H1419" \w* \w in counsel| strong="H6098" \w*, \w and mighty| strong="H7227" \w* \w in work| strong="H5950" \w*: \w for thine eyes| strong="H5869" \w* are [open]{strong=“H6491” x-morph=“strongMorph: \sc Th\sc*8803”} \w upon all the ways| strong="H1870" \w* \w of the sons| strong="H1121" \w* \w of men| strong="H120" \w*: [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w every one| strong="H376" \w* \w according to his ways| strong="H1870" \w*, \w and according to the fruit| strong="H6529" \w* \w of his doings| strong="H4611" \w*:\f + \fr 32:19 \ft work: Heb. doing \f* 
\v 20 [Which hast set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w signs| strong="H226" \w* \w and wonders| strong="H4159" \w* \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, even \w unto this day| strong="H3117" \w*, \w and in Israel| strong="H3478" \w*, and among other \w men| strong="H120" \w*; [and hast made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee a name| strong="H8034" \w*, \w as at this day| strong="H3117" \w*; 
\v 21 [And hast brought forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy people| strong="H5971" \w* \w Israel| strong="H3478" \w* \w out of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* \w with signs| strong="H226" \w*, \w and with wonders| strong="H4159" \w*, \w and with a strong| strong="H2389" \w* \w hand| strong="H3027" \w*, [and with a stretched out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8803”} \w arm| strong="H248" \w*, \w and with great| strong="H1419" \w* \w terror| strong="H4172" \w*; 
\v 22 [And hast given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w them this land| strong="H776" \w*, [which thou didst swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w to their fathers| strong="H1" \w* [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} [them, a land]{strong=“H776”} [flowing]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”} \w with milk| strong="H2461" \w* \w and honey| strong="H1706" \w*; 
\v 23 [And they came in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [and possessed]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8799”} [it; but they obeyed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w not thy voice| strong="H6963" \w*, [neither walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thy law| strong="H8451" \w*; [they have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [nothing of all that thou commandedst]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [them to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”}: \w therefore thou hast caused all this evil| strong="H7451" \w* [to come]{strong=“H7122” x-morph=“strongMorph: \sc Th\sc*8686”} upon them: 
\v 24 \w Behold the mounts| strong="H5550" \w*, [they are come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the city| strong="H5892" \w* [to take]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8800”} [it; and the city]{strong=“H5892”} [is given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w into the hand| strong="H3027" \w* \w of the Chaldeans| strong="H3778" \w*, [that fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8737”} [against it, because]{strong=“H6440”} \w of the sword| strong="H2719" \w*, \w and of the famine| strong="H7458" \w*, \w and of the pestilence| strong="H1698" \w*: [and what thou hast spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [is come to pass; and, behold, thou seest]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} it.\f + \fr 32:24 \ft mounts: or, engines of shot \f* 
\v 25 [And thou hast said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me, O Lord]{strong=“H136”} \sc God\sc*, [Buy]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee the field| strong="H7704" \w* \w for money| strong="H3701" \w*, [and take]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8685”} \w witnesses| strong="H5707" \w*; \w for the city| strong="H5892" \w* [is given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w into the hand| strong="H3027" \w* \w of the Chaldeans| strong="H3778" \w*.\f + \fr 32:25 \ft for the: or, though the \f* 
\p
\v 26 \w Then came the word| strong="H1697" \w* of the \sc Lord\sc* \w unto Jeremiah| strong="H3414" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 27 Behold, I am the \sc Lord\sc*, \w the God| strong="H430" \w* \w of all flesh| strong="H1320" \w*: \w is there any thing| strong="H1697" \w* [too hard]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8735”} for me? 
\v 28 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Behold, I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w this city| strong="H5892" \w* \w into the hand| strong="H3027" \w* \w of the Chaldeans| strong="H3778" \w*, \w and into the hand| strong="H3027" \w* \w of Nebuchadrezzar| strong="H5019" \w* \w king| strong="H4428" \w* \w of Babylon| strong="H894" \w*, [and he shall take]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8804”} it: 
\v 29 \w And the Chaldeans| strong="H3778" \w*, [that fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8737”} \w against this city| strong="H5892" \w*, [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [and set]{strong=“H3341” x-morph=“strongMorph: \sc Th\sc*8689”} \w fire| strong="H784" \w* \w on this city| strong="H5892" \w*, [and burn]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8804”} \w it with the houses| strong="H1004" \w*, \w upon whose roofs| strong="H1406" \w* [they have offered incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto Baal| strong="H1168" \w*, [and poured out]{strong=“H5258” x-morph=“strongMorph: \sc Th\sc*8689”} \w drink offerings| strong="H5262" \w* \w unto other| strong="H312" \w* \w gods| strong="H430" \w*, [to provoke me to anger]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8687”}. 
\v 30 \w For the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* \w and the children| strong="H1121" \w* \w of Judah| strong="H3063" \w* [have only done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w evil| strong="H7451" \w* \w before| strong="H5869" \w* \w me from their youth| strong="H5271" \w*: \w for the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [have only provoked me to anger]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8688”} \w with the work| strong="H4639" \w* \w of their hands| strong="H3027" \w*, [saith ]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 31 \w For this city| strong="H5892" \w* hath been to me as \w a provocation of mine anger| strong="H639" \w* \w and of my fury| strong="H2534" \w* \w from the day| strong="H3117" \w* [that they built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w it even unto this day| strong="H3117" \w*; [that I should remove]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8687”} \w it from before my face| strong="H6440" \w*,\f + \fr 32:31 \ft a provocation…: Heb. for my anger \f* 
\v 32 \w Because of all the evil| strong="H7451" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* \w and of the children| strong="H1121" \w* \w of Judah| strong="H3063" \w*, [which they have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [to provoke me to anger]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8687”}, [they, their kings]{strong=“H4428”}, \w their princes| strong="H8269" \w*, \w their priests| strong="H3548" \w*, \w and their prophets| strong="H5030" \w*, \w and the men| strong="H376" \w* \w of Judah| strong="H3063" \w*, [and the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w*. 
\v 33 [And they have turned]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto me the back| strong="H6203" \w*, \w and not the face| strong="H6440" \w*: [though I taught]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8763”} [them, rising up early]{strong=“H7925” x-morph=“strongMorph: \sc Th\sc*8687”} [and teaching]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8763”} them, [yet they have not hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} [to receive]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} \w instruction| strong="H4148" \w*.\f + \fr 32:33 \ft back: Heb. neck \f* 
\v 34 [But they set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w their abominations| strong="H8251" \w* \w in the house| strong="H1004" \w*, [which is called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8738”} \w by my name| strong="H8034" \w*, [to defile]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8763”} it. 
\v 35 [And they built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w the high places| strong="H1116" \w* \w of Baal| strong="H1168" \w*, which are \w in the valley| strong="H1516" \w* \w of the son| strong="H1121" \w* \w of Hinnom| strong="H2011" \w*, \w to cause their sons| strong="H1121" \w* \w and their daughters| strong="H1323" \w* [to pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8687”} through the fire \w unto Molech| strong="H4432" \w*; [which I commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [them not, neither came]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w it into my mind| strong="H3820" \w*, [that they should do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w this abomination| strong="H8441" \w*, \w to cause Judah| strong="H3063" \w* [to sin]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8687”}. 
\p
\v 36 [And now therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*, \w concerning this city| strong="H5892" \w*, [whereof ye say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, [It shall be delivered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w into the hand| strong="H3027" \w* \w of the king| strong="H4428" \w* \w of Babylon| strong="H894" \w* \w by the sword| strong="H2719" \w*, \w and by the famine| strong="H7458" \w*, \w and by the pestilence| strong="H1698" \w*; 
\v 37 [Behold, I will gather them out]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8764”} \w of all countries| strong="H776" \w*, [whither I have driven]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8689”} \w them in mine anger| strong="H639" \w*, \w and in my fury| strong="H2534" \w*, \w and in great| strong="H1419" \w* \w wrath| strong="H7110" \w*; [and I will bring them again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} \w unto this place| strong="H4725" \w*, [and I will cause them to dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8689”} \w safely| strong="H983" \w*: 
\v 38 \w And they shall be my people| strong="H5971" \w*, \w and I will be their God| strong="H430" \w*: 
\v 39 [And I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w them one| strong="H259" \w* \w heart| strong="H3820" \w*, \w and one| strong="H259" \w* \w way| strong="H1870" \w*, [that they may fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8800”} \w me for ever| strong="H3117" \w*, \w for the good| strong="H2896" \w* [of them, and of their children]{strong=“H1121”} \w after| strong="H310" \w* them:\f + \fr 32:39 \ft for ever: Heb. all days \f* 
\v 40 [And I will make]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8804”} \w an everlasting| strong="H5769" \w* \w covenant| strong="H1285" \w* [with them, that I will not turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w from them| strong="H310" \w*, [to do them good]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8687”}; [but I will put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w my fear| strong="H3374" \w* \w in their hearts| strong="H3824" \w*, [that they shall not depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8800”} from me.\f + \fr 32:40 \ft from them: Heb. from after them \f* 
\v 41 [Yea, I will rejoice]{strong=“H7797” x-morph=“strongMorph: \sc Th\sc*8804”} [over them to do them good]{strong=“H2895” x-morph=“strongMorph: \sc Th\sc*8687”}, [and I will plant]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8804”} \w them in this land| strong="H776" \w* \w assuredly| strong="H571" \w* \w with my whole heart| strong="H3820" \w* \w and with my whole soul| strong="H5315" \w*.\f + \fr 32:41 \ft assuredly: Heb. in truth, or, stability \f* 
\v 42 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Like as I have brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w all this great| strong="H1419" \w* \w evil| strong="H7451" \w* \w upon this people| strong="H5971" \w*, [so will I bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w upon them all the good| strong="H2896" \w* [that I have promised]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} them. 
\v 43 \w And fields| strong="H7704" \w* [shall be bought]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8738”} \w in this land| strong="H776" \w*, [whereof ye say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, It is \w desolate| strong="H8077" \w* \w without man| strong="H120" \w* \w or beast| strong="H929" \w*; [it is given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w into the hand| strong="H3027" \w* \w of the Chaldeans| strong="H3778" \w*. 
\v 44 [Men shall buy]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8799”} \w fields| strong="H7704" \w* \w for money| strong="H3701" \w*, [and subscribe]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8800”} \w evidences| strong="H5612" \w*, [and seal]{strong=“H2856” x-morph=“strongMorph: \sc Th\sc*8800”} them, [and take]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8687”} \w witnesses| strong="H5707" \w* \w in the land| strong="H776" \w* \w of Benjamin| strong="H1144" \w*, \w and in the places about| strong="H5439" \w* \w Jerusalem| strong="H3389" \w*, \w and in the cities| strong="H5892" \w* \w of Judah| strong="H3063" \w*, \w and in the cities| strong="H5892" \w* \w of the mountains| strong="H2022" \w*, \w and in the cities| strong="H5892" \w* \w of the valley| strong="H8219" \w*, \w and in the cities| strong="H5892" \w* \w of the south| strong="H5045" \w*: \w for I will cause their captivity| strong="H7622" \w* [to return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*.
\c 33
\p 
\v 1 \w Moreover the word| strong="H1697" \w* of the \sc Lord\sc* \w came unto Jeremiah| strong="H3414" \w* \w the second| strong="H8145" \w* [time, while he was yet shut up]{strong=“H6113” x-morph=“strongMorph: \sc Th\sc*8803”} \w in the court| strong="H2691" \w* \w of the prison| strong="H4307" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* [the maker]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} thereof, the \sc Lord\sc* [that formed]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} [it, to establish]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8687”} it; the \sc Lord\sc* is \w his name| strong="H8034" \w*;^\sc 33:2 the [Lord\sc* is: or, \sc Jehovah\sc*, etc] 
\v 3 [Call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me, and I will answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [thee, and shew]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee great| strong="H1419" \w* [and mighty things]{strong=“H1219” x-morph=“strongMorph: \sc Th\sc*8803”}, [which thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} not.\f + \fr 33:3 \ft mighty: or, hidden \f* 
\v 4 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*, \w concerning the houses| strong="H1004" \w* \w of this city| strong="H5892" \w*, \w and concerning the houses| strong="H1004" \w* \w of the kings| strong="H4428" \w* \w of Judah| strong="H3063" \w*, [which are thrown down]{strong=“H5422” x-morph=“strongMorph: \sc Th\sc*8803”} \w by the mounts| strong="H5550" \w*, \w and by the sword| strong="H2719" \w*; 
\v 5 [They come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [to fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8736”} \w with the Chaldeans| strong="H3778" \w*, but it is [to fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8763”} \w them with the dead bodies| strong="H6297" \w* \w of men| strong="H120" \w*, [whom I have slain]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w in mine anger| strong="H639" \w* \w and in my fury| strong="H2534" \w*, \w and for all whose wickedness| strong="H7451" \w* [I have hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8689”} \w my face| strong="H6440" \w* \w from this city| strong="H5892" \w*. 
