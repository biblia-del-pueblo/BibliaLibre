\p
\v 5 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w What iniquity| strong="H5766" \w* \w have your fathers| strong="H1" \w* [found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} [in me, that they are gone far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8804”} [from me, and have walked]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w vanity| strong="H1892" \w*, [and are become vain]{strong=“H1891” x-morph=“strongMorph: \sc Th\sc*8799”}? 
\v 6 [Neither said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} they, Where is the \sc Lord\sc* [that brought us up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8688”} \w out of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, [that led]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8688”} \w us through the wilderness| strong="H4057" \w*, \w through a land| strong="H776" \w* \w of deserts| strong="H6160" \w* \w and of pits| strong="H7745" \w*, \w through a land| strong="H776" \w* \w of drought| strong="H6723" \w*, \w and of the shadow of death| strong="H6757" \w*, \w through a land| strong="H776" \w* \w that no man| strong="H376" \w* [passed through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and where no man| strong="H120" \w* [dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”}? 
\v 7 [And I brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w you into a plentiful| strong="H3759" \w* \w country| strong="H776" \w*, [to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} \w the fruit| strong="H6529" \w* \w thereof and the goodness| strong="H2898" \w* [thereof; but when ye entered]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [ye defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8762”} \w my land| strong="H776" \w*, [and made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine heritage| strong="H5159" \w* \w an abomination| strong="H8441" \w*.\f + \fr 2:7 \ft a plentiful…: or, the land of Carmel \f* 
