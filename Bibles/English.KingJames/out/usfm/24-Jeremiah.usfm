\c 42
\p 
\v 1 \w Then all the captains| strong="H8269" \w* \w of the forces| strong="H2428" \w*, \w and Johanan| strong="H3110" \w* \w the son| strong="H1121" \w* \w of Kareah| strong="H7143" \w*, \w and Jezaniah| strong="H3153" \w* \w the son| strong="H1121" \w* \w of Hoshaiah| strong="H1955" \w*, \w and all the people| strong="H5971" \w* \w from the least| strong="H6996" \w* \w even unto the greatest| strong="H1419" \w*, [came near]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 [And said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Jeremiah| strong="H3414" \w* \w the prophet| strong="H5030" \w*, [Let, we beseech thee, our supplication]{strong=“H8467”} [be accepted]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* [thee, and pray]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8690”} for us unto the \sc Lord\sc* \w thy God| strong="H430" \w*, even \w for all this remnant| strong="H7611" \w*; ([for we are left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8738”} but \w a few| strong="H4592" \w* [of many]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8687”}, \w as thine eyes| strong="H5869" \w* [do behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} us:)\f + \fr 42:2 \ft Let…: or, Let our supplication fall before thee \f* 
\v 3 That the \sc Lord\sc* \w thy God| strong="H430" \w* [may shew]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w us the way| strong="H1870" \w* [wherein we may walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the thing| strong="H1697" \w* [that we may do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 4 \w Then Jeremiah| strong="H3414" \w* \w the prophet| strong="H5030" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, I have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} you; [behold, I will pray]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8693”} unto the \sc Lord\sc* \w your God| strong="H430" \w* \w according to your words| strong="H1697" \w*; and it shall come to pass, that \w whatsoever thing| strong="H1697" \w* the \sc Lord\sc* [shall answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [you, I will declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} it [unto you; I will keep]{strong=“H4513”} \w nothing| strong="H1697" \w* [back]{strong=“H4513” x-morph=“strongMorph: \sc Th\sc*8799”} from you. 
\v 5 [Then they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w to Jeremiah| strong="H3414" \w*, The \sc Lord\sc* \w be a true| strong="H571" \w* [and faithful]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8737”} \w witness| strong="H5707" \w* [between us, if we do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w not even according to all things| strong="H1697" \w* for the which the \sc Lord\sc* \w thy God| strong="H430" \w* [shall send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} thee to us. 
\v 6 Whether it be \w good| strong="H2896" \w*, or whether it be \w evil| strong="H7451" \w*, [we will obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w the voice| strong="H6963" \w* of the \sc Lord\sc* \w our God| strong="H430" \w*, \w to whom we| strong="H580" \w* [send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8802”} [thee; that it may be well]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8799”} [with us, when we obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w the voice| strong="H6963" \w* of the \sc Lord\sc* \w our God| strong="H430" \w*. 
\p
\v 7 \w And it came to pass after| strong="H7093" \w* \w ten| strong="H6235" \w* \w days| strong="H3117" \w*, \w that the word| strong="H1697" \w* of the \sc Lord\sc* \w came unto Jeremiah| strong="H3414" \w*. 
\v 8 [Then called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w he Johanan| strong="H3110" \w* \w the son| strong="H1121" \w* \w of Kareah| strong="H7143" \w*, \w and all the captains| strong="H8269" \w* \w of the forces| strong="H2428" \w* which were [with him, and all the people]{strong=“H5971”} \w from the least| strong="H6996" \w* \w even to the greatest| strong="H1419" \w*, 
\v 9 [And said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*, [unto whom ye sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [me to present]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8687”} \w your supplication| strong="H8467" \w* \w before| strong="H6440" \w* him; 
\v 10 [If ye will still]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} [abide]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in this land| strong="H776" \w*, [then will I build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} you, and not pull you [down]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8799”}, [and I will plant]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8804”} you, and not pluck you [up]{strong=“H5428” x-morph=“strongMorph: \sc Th\sc*8799”}: [for I repent]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8738”} \w me of the evil| strong="H7451" \w* [that I have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} unto you. 
\v 11 [Be not afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w of| strong="H6440" \w* \w the king| strong="H4428" \w* \w of Babylon| strong="H894" \w*, \w of whom| strong="H6440" \w* \w ye are afraid| strong="H3373" \w*; [be not afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [of him, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: for I am [with you to save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8687”} [you, and to deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8687”} \w you from his hand| strong="H3027" \w*. 
\v 12 [And I will shew]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w mercies| strong="H7356" \w* [unto you, that he may have mercy]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8765”} [upon you, and cause you to return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} \w to your own land| strong="H127" \w*. 
\p
\v 13 [But if ye say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, [We will not dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in this land| strong="H776" \w*, [neither obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w the voice| strong="H6963" \w* of the \sc Lord\sc* \w your God| strong="H430" \w*, 
\v 14 [Saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [No; but we will go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, [where we shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w no war| strong="H4421" \w*, [nor hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w the sound| strong="H6963" \w* \w of the trumpet| strong="H7782" \w*, [nor have hunger]{strong=“H7456” x-morph=“strongMorph: \sc Th\sc*8799”} \w of bread| strong="H3899" \w*; [and there will we dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”}: 
\v 15 [And now therefore hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* of the \sc Lord\sc*, \w ye remnant| strong="H7611" \w* \w of Judah| strong="H3063" \w*; [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*; [If ye wholly]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} [set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w your faces| strong="H6440" \w* [to enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w into Egypt| strong="H4714" \w*, [and go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8800”} there; 
\v 16 Then it shall come to pass, that \w the sword| strong="H2719" \w*, \w which ye feared| strong="H3373" \w*, [shall overtake]{strong=“H5381” x-morph=“strongMorph: \sc Th\sc*8686”} \w you there in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, \w and the famine| strong="H7458" \w*, [whereof ye were afraid]{strong=“H1672” x-morph=“strongMorph: \sc Th\sc*8802”}, [shall follow close]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w you there in Egypt| strong="H4714" \w*; [and there ye shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 42:16 \ft shall follow…: Heb. shall cleave after you \f* 
\v 17 \w So shall it be with all the men| strong="H582" \w* [that set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w their faces| strong="H6440" \w* [to go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w into Egypt| strong="H4714" \w* [to sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8800”} [there; they shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w*, \w by the famine| strong="H7458" \w*, \w and by the pestilence| strong="H1698" \w*: \w and none of them shall remain| strong="H8300" \w* \w or escape| strong="H6412" \w* \w from| strong="H6440" \w* \w the evil| strong="H7451" \w* [that I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} upon them.\f + \fr 42:17 \ft So…: Heb. So shall all the men be \f* 
\v 18 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*; \w As mine anger| strong="H639" \w* \w and my fury| strong="H2534" \w* [hath been poured forth]{strong=“H5413” x-morph=“strongMorph: \sc Th\sc*8738”} [upon the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w*; \w so shall my fury| strong="H2534" \w* [be poured forth]{strong=“H5413” x-morph=“strongMorph: \sc Th\sc*8799”} [upon you, when ye shall enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w into Egypt| strong="H4714" \w*: \w and ye shall be an execration| strong="H423" \w*, \w and an astonishment| strong="H8047" \w*, \w and a curse| strong="H7045" \w*, \w and a reproach| strong="H2781" \w*; [and ye shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w this place| strong="H4725" \w* no more. 
\p
\v 19 The \sc Lord\sc* [hath said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [concerning you, O ye remnant]{strong=“H7611”} \w of Judah| strong="H3063" \w*; [Go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w ye not into Egypt| strong="H4714" \w*: [know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [certainly]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} [that I have admonished]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8689”} \w you this day| strong="H3117" \w*.\f + \fr 42:19 \ft admonished…: Heb. testified against you \f* 
\v 20 [For ye dissembled]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8689”} \w in your hearts| strong="H5315" \w*, [when ye sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} me unto the \sc Lord\sc* \w your God| strong="H430" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Pray]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8690”} for us unto the \sc Lord\sc* \w our God| strong="H430" \w*; and according unto all that the \sc Lord\sc* \w our God| strong="H430" \w* [shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [so declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”} [unto us, and we will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} it.\f + \fr 42:20 \ft ye dissembled…: or, ye have used deceit against your souls \f* 
\v 21 And now \w I have this day| strong="H3117" \w* [declared]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} it [to you; but ye have not obeyed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the voice| strong="H6963" \w* of the \sc Lord\sc* \w your God| strong="H430" \w*, nor any thing [for the which he hath sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} me unto you. 
\v 22 [Now therefore know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [certainly]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} [that ye shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w*, \w by the famine| strong="H7458" \w*, \w and by the pestilence| strong="H1698" \w*, \w in the place| strong="H4725" \w* [whither ye desire]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} [to go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} and [to sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 42:22 \ft to go…: or, to go to sojourn \f*
\c 43
\p 
\v 1 And it came to pass, that \w when Jeremiah| strong="H3414" \w* [had made an end]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8763”} [of speaking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w unto all the people| strong="H5971" \w* \w all the words| strong="H1697" \w* of the \sc Lord\sc* \w their God| strong="H430" \w*, for which the \sc Lord\sc* \w their God| strong="H430" \w* [had sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} him to them, even \w all these words| strong="H1697" \w*, 
\v 2 [Then spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Azariah| strong="H5838" \w* \w the son| strong="H1121" \w* \w of Hoshaiah| strong="H1955" \w*, \w and Johanan| strong="H3110" \w* \w the son| strong="H1121" \w* \w of Kareah| strong="H7143" \w*, \w and all the proud| strong="H2086" \w* \w men| strong="H582" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} \w unto Jeremiah| strong="H3414" \w*, [Thou speakest]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8764”} \w falsely| strong="H8267" \w*: the \sc Lord\sc* \w our God| strong="H430" \w* [hath not sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [thee to say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w not into Egypt| strong="H4714" \w* [to sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8800”} there: 
\v 3 \w But Baruch| strong="H1263" \w* \w the son| strong="H1121" \w* \w of Neriah| strong="H5374" \w* [setteth thee on]{strong=“H5496” x-morph=“strongMorph: \sc Th\sc*8688”} [against us, for to]{strong=“H4616”} [deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w us into the hand| strong="H3027" \w* \w of the Chaldeans| strong="H3778" \w*, [that they might put us to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8687”}, [and carry us away captives]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8687”} \w into Babylon| strong="H894" \w*. 
\v 4 \w So Johanan| strong="H3110" \w* \w the son| strong="H1121" \w* \w of Kareah| strong="H7143" \w*, \w and all the captains| strong="H8269" \w* \w of the forces| strong="H2428" \w*, \w and all the people| strong="H5971" \w*, [obeyed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the voice| strong="H6963" \w* of the \sc Lord\sc*, [to dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the land| strong="H776" \w* \w of Judah| strong="H3063" \w*. 
\v 5 \w But Johanan| strong="H3110" \w* \w the son| strong="H1121" \w* \w of Kareah| strong="H7143" \w*, \w and all the captains| strong="H8269" \w* \w of the forces| strong="H2428" \w*, [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the remnant| strong="H7611" \w* \w of Judah| strong="H3063" \w*, [that were returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w from all nations| strong="H1471" \w*, [whither they had been driven]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8738”}, [to dwell]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the land| strong="H776" \w* \w of Judah| strong="H3063" \w*; 
\v 6 Even \w men| strong="H1397" \w*, \w and women| strong="H802" \w*, \w and children| strong="H2945" \w*, [and the king’s]{strong=“H4428”} \w daughters| strong="H1323" \w*, \w and every person| strong="H5315" \w* [that Nebuzar-adan]{strong=“H5018”} \w the captain| strong="H7227" \w* \w of the guard| strong="H2876" \w* [had left]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8689”} \w with Gedaliah| strong="H1436" \w* \w the son| strong="H1121" \w* \w of Ahikam| strong="H296" \w* \w the son| strong="H1121" \w* \w of Shaphan| strong="H8227" \w*, \w and Jeremiah| strong="H3414" \w* \w the prophet| strong="H5030" \w*, \w and Baruch| strong="H1263" \w* \w the son| strong="H1121" \w* \w of Neriah| strong="H5374" \w*. 
\v 7 [So they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*: [for they obeyed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the voice| strong="H6963" \w* of the \sc Lord\sc*: [thus came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} they even \w to Tahpanhes| strong="H8471" \w*. 
\p
\v 8 \w Then came the word| strong="H1697" \w* of the \sc Lord\sc* \w unto Jeremiah| strong="H3414" \w* \w in Tahpanhes| strong="H8471" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 9 [Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w great| strong="H1419" \w* \w stones| strong="H68" \w* \w in thine hand| strong="H3027" \w*, [and hide]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8804”} \w them in the clay| strong="H4423" \w* \w in the brickkiln| strong="H4404" \w*, which is \w at the entry| strong="H6607" \w* [of Pharaoh’s]{strong=“H6547”} \w house| strong="H1004" \w* \w in Tahpanhes| strong="H8471" \w*, \w in the sight| strong="H5869" \w* \w of the men| strong="H582" \w* \w of Judah| strong="H3064" \w*; 
\v 10 [And say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*; [Behold, I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8802”} [and take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w Nebuchadrezzar| strong="H5019" \w* \w the king| strong="H4428" \w* \w of Babylon| strong="H894" \w*, \w my servant| strong="H5650" \w*, [and will set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w his throne| strong="H3678" \w* \w upon| strong="H4605" \w* \w these stones| strong="H68" \w* [that I have hid]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8804”}; [and he shall spread]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} \w his royal pavilion| strong="H8237" \w* over them. 
\v 11 [And when he cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, [he shall smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, and deliver such as are \w for death| strong="H4194" \w* \w to death| strong="H4194" \w*; and such as are \w for captivity| strong="H7628" \w* \w to captivity| strong="H7628" \w*; and such as are \w for the sword| strong="H2719" \w* \w to the sword| strong="H2719" \w*. 
\v 12 [And I will kindle]{strong=“H3341” x-morph=“strongMorph: \sc Th\sc*8689”} \w a fire| strong="H784" \w* \w in the houses| strong="H1004" \w* \w of the gods| strong="H430" \w* \w of Egypt| strong="H4714" \w*; [and he shall burn]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8804”} [them, and carry them away captives]{strong=“H7617” x-morph=“strongMorph: \sc Th\sc*8804”}: [and he shall array]{strong=“H5844” x-morph=“strongMorph: \sc Th\sc*8804”} \w himself with the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, [as a shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [putteth on]{strong=“H5844” x-morph=“strongMorph: \sc Th\sc*8799”} \w his garment| strong="H899" \w*; [and he shall go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w from thence in peace| strong="H7965" \w*. 
\v 13 [He shall break]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8765”} \w also the images| strong="H4676" \w* [of Beth-shemesh]{strong=“H1053”}, that is \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*; \w and the houses| strong="H1004" \w* \w of the gods| strong="H430" \w* \w of the Egyptians| strong="H4714" \w* [shall he burn]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8799”} \w with fire| strong="H784" \w*.\f + \fr 43:13 \ft images: Heb. statues, or, standing images \f* \f + \fr 43:13 \ft Beth-shemesh: or, The house of the sun \f*
\c 44
\p 
\v 1 \w The word| strong="H1697" \w* \w that came to Jeremiah| strong="H3414" \w* \w concerning all the Jews| strong="H3064" \w* [which dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, [which dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w at Migdol| strong="H4024" \w*, \w and at Tahpanhes| strong="H8471" \w*, \w and at Noph| strong="H5297" \w*, \w and in the country| strong="H776" \w* \w of Pathros| strong="H6624" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*; [Ye have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w all the evil| strong="H7451" \w* [that I have brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w upon Jerusalem| strong="H3389" \w*, \w and upon all the cities| strong="H5892" \w* \w of Judah| strong="H3063" \w*; [and, behold, this day]{strong=“H3117”} they are \w a desolation| strong="H2723" \w*, [and no man dwelleth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} therein, 
\v 3 \w Because| strong="H6440" \w* \w of their wickedness| strong="H7451" \w* [which they have committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [to provoke me to anger]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8687”}, [in that they went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} [to burn incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8763”}, and [to serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8800”} \w other| strong="H312" \w* \w gods| strong="H430" \w*, [whom they knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} not, neither [they, ye, nor your fathers]{strong=“H1”}. 
\v 4 [Howbeit I sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto you all my servants| strong="H5650" \w* \w the prophets| strong="H5030" \w*, [rising early]{strong=“H7925” x-morph=“strongMorph: \sc Th\sc*8687”} [and sending]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8800”} them, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Oh, do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w not this abominable| strong="H8441" \w* \w thing| strong="H1697" \w* [that I hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 5 [But they hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [not, nor inclined]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8689”} \w their ear| strong="H241" \w* [to turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w from their wickedness| strong="H7451" \w*, [to burn no incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8763”} \w unto other| strong="H312" \w* \w gods| strong="H430" \w*. 
\v 6 \w Wherefore my fury| strong="H2534" \w* \w and mine anger| strong="H639" \w* [was poured forth]{strong=“H5413” x-morph=“strongMorph: \sc Th\sc*8799”}, [and was kindled]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the cities| strong="H5892" \w* \w of Judah| strong="H3063" \w* \w and in the streets| strong="H2351" \w* \w of Jerusalem| strong="H3389" \w*; \w and they are wasted| strong="H2723" \w* and \w desolate| strong="H8077" \w*, \w as at this day| strong="H3117" \w*. 
\v 7 [Therefore now thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w the God| strong="H430" \w* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*; [Wherefore commit]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} ye this \w great| strong="H1419" \w* \w evil| strong="H7451" \w* \w against your souls| strong="H5315" \w*, [to cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8687”} \w from you man| strong="H376" \w* \w and woman| strong="H802" \w*, \w child| strong="H5768" \w* [and suckling]{strong=“H3243” x-morph=“strongMorph: \sc Th\sc*8802”}, \w out| strong="H8432" \w* \w of Judah| strong="H3063" \w*, [to leave]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8687”} \w you none to remain| strong="H7611" \w*;\f + \fr 44:7 \ft out…: Heb. out of the midst of Judah \f* 
\v 8 [In that ye provoke me unto wrath]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8687”} \w with the works| strong="H4639" \w* \w of your hands| strong="H3027" \w*, [burning incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8763”} \w unto other| strong="H312" \w* \w gods| strong="H430" \w* \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, [whither ye be gone]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [to dwell]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8800”}, [that ye might cut yourselves off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8687”}, \w and that ye might be a curse| strong="H7045" \w* \w and a reproach| strong="H2781" \w* \w among all the nations| strong="H1471" \w* \w of the earth| strong="H776" \w*? 
\v 9 [Have ye forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} \w the wickedness| strong="H7451" \w* \w of your fathers| strong="H1" \w*, \w and the wickedness| strong="H7451" \w* \w of the kings| strong="H4428" \w* \w of Judah| strong="H3063" \w*, \w and the wickedness| strong="H7451" \w* \w of their wives| strong="H802" \w*, \w and your own wickedness| strong="H7451" \w*, \w and the wickedness| strong="H7451" \w* \w of your wives| strong="H802" \w*, [which they have committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the land| strong="H776" \w* \w of Judah| strong="H3063" \w*, \w and in the streets| strong="H2351" \w* \w of Jerusalem| strong="H3389" \w*?\f + \fr 44:9 \ft wickedness…: Heb. wickednesses, or, punishments, etc \f* 
\v 10 [They are not humbled]{strong=“H1792” x-morph=“strongMorph: \sc Th\sc*8795”} even \w unto this day| strong="H3117" \w*, [neither have they feared]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8804”}, [nor walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w in my law| strong="H8451" \w*, \w nor in my statutes| strong="H2708" \w*, [that I set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* \w you and before| strong="H6440" \w* \w your fathers| strong="H1" \w*.\f + \fr 44:10 \ft humbled: Heb. contrite \f* 
\p
\v 11 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*; [Behold, I will set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8802”} \w my face| strong="H6440" \w* \w against you for evil| strong="H7451" \w*, [and to cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8687”} \w all Judah| strong="H3063" \w*. 
\v 12 [And I will take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w the remnant| strong="H7611" \w* \w of Judah| strong="H3063" \w*, [that have set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w their faces| strong="H6440" \w* [to go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w into the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* [to sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8800”} [there, and they shall all be consumed]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8804”}, and [fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*; they shall even [be consumed]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8735”} \w by the sword| strong="H2719" \w* and \w by the famine| strong="H7458" \w*: [they shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, \w from the least| strong="H6996" \w* \w even unto the greatest| strong="H1419" \w*, \w by the sword| strong="H2719" \w* \w and by the famine| strong="H7458" \w*: \w and they shall be an execration| strong="H423" \w*, and \w an astonishment| strong="H8047" \w*, \w and a curse| strong="H7045" \w*, \w and a reproach| strong="H2781" \w*. 
\v 13 [For I will punish]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} [them that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, [as I have punished]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} \w Jerusalem| strong="H3389" \w*, \w by the sword| strong="H2719" \w*, \w by the famine| strong="H7458" \w*, \w and by the pestilence| strong="H1698" \w*: 
\v 14 \w So that none of the remnant| strong="H7611" \w* \w of Judah| strong="H3063" \w*, [which are gone]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w into the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* [to sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8800”} [there, shall escape]{strong=“H6412”} \w or remain| strong="H8300" \w*, [that they should return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w into the land| strong="H776" \w* \w of Judah| strong="H3063" \w*, [to the which they have]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8764”} \w a desire| strong="H5315" \w* [to return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} [to dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} [there: for none shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w but such as shall escape| strong="H6405" \w*.\f + \fr 44:14 \ft have…: Heb. lift up their soul \f* 
\p
\v 15 \w Then all the men| strong="H582" \w* [which knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w that their wives| strong="H802" \w* [had burned incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8764”} \w unto other| strong="H312" \w* \w gods| strong="H430" \w*, \w and all the women| strong="H802" \w* [that stood by]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”}, \w a great| strong="H1419" \w* \w multitude| strong="H6951" \w*, \w even all the people| strong="H5971" \w* [that dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, \w in Pathros| strong="H6624" \w*, [answered ]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jeremiah| strong="H3414" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 16 As for \w the word| strong="H1697" \w* [that thou hast spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto us in the name| strong="H8034" \w* of the \sc Lord\sc*, [we will not hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} unto thee. 
\v 17 [But we will certainly]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w whatsoever thing| strong="H1697" \w* [goeth forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w out of our own mouth| strong="H6310" \w*, [to burn incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8763”} \w unto the queen| strong="H4446" \w* \w of heaven| strong="H8064" \w*, [and to pour out]{strong=“H5258” x-morph=“strongMorph: \sc Th\sc*8687”} \w drink offerings| strong="H5262" \w* [unto her, as we have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [we, and our fathers]{strong=“H1”}, \w our kings| strong="H4428" \w*, \w and our princes| strong="H8269" \w*, \w in the cities| strong="H5892" \w* \w of Judah| strong="H3063" \w*, \w and in the streets| strong="H2351" \w* \w of Jerusalem| strong="H3389" \w*: for then [had we plenty]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”} \w of victuals| strong="H3899" \w*, \w and were well| strong="H2896" \w*, [and saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w no evil| strong="H7451" \w*.\f + \fr 44:17 \ft queen…: or, frame of heaven \f* \f + \fr 44:17 \ft victuals: Heb. bread \f* 
\v 18 [But since we left off]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8804”} [to burn incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8763”} \w to the queen| strong="H4446" \w* \w of heaven| strong="H8064" \w*, [and to pour out]{strong=“H5258” x-morph=“strongMorph: \sc Th\sc*8687”} \w drink offerings| strong="H5262" \w* [unto her, we have wanted]{strong=“H2637” x-morph=“strongMorph: \sc Th\sc*8804”} all things, [and have been consumed]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8804”} \w by the sword| strong="H2719" \w* \w and by the famine| strong="H7458" \w*. 
\v 19 [And when we burned incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8764”} \w to the queen| strong="H4446" \w* \w of heaven| strong="H8064" \w*, [and poured out]{strong=“H5258” x-morph=“strongMorph: \sc Th\sc*8687”} \w drink offerings| strong="H5262" \w* [unto her, did we make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w her cakes| strong="H3561" \w* [to worship]{strong=“H6087” x-morph=“strongMorph: \sc Th\sc*8687”} [her, and pour out]{strong=“H5258” x-morph=“strongMorph: \sc Th\sc*8687”} \w drink offerings| strong="H5262" \w* [unto her, without]{strong=“H1107”} \w our men| strong="H582" \w*?\f + \fr 44:19 \ft men: or, husbands? \f* 
\p
\v 20 \w Then Jeremiah| strong="H3414" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto all the people| strong="H5971" \w*, \w to the men| strong="H1397" \w*, \w and to the women| strong="H802" \w*, \w and to all the people| strong="H5971" \w* which had given him that [answer]{strong=“H6030 H1697” x-morph=“strongMorph: \sc Th\sc*8802”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 21 \w The incense| strong="H7002" \w* [that ye burned]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8765”} \w in the cities| strong="H5892" \w* \w of Judah| strong="H3063" \w*, \w and in the streets| strong="H2351" \w* \w of Jerusalem| strong="H3389" \w*, [ye, and your fathers]{strong=“H1”}, \w your kings| strong="H4428" \w*, \w and your princes| strong="H8269" \w*, \w and the people| strong="H5971" \w* \w of the land| strong="H776" \w*, did not the \sc Lord\sc* [remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} [them, and came]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} it not \w into his mind| strong="H3820" \w*? 
\v 22 So that the \sc Lord\sc* [could]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [no longer bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8800”}, \w because| strong="H6440" \w* \w of the evil| strong="H7455" \w* \w of your doings| strong="H4611" \w*, and \w because| strong="H6440" \w* \w of the abominations| strong="H8441" \w* [which ye have committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}; \w therefore is your land| strong="H776" \w* \w a desolation| strong="H2723" \w*, \w and an astonishment| strong="H8047" \w*, \w and a curse| strong="H7045" \w*, [without an inhabitant]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”}, \w as at this day| strong="H3117" \w*. 
\v 23 [Because]{strong=“H834 H6440”} [ye have burned incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8765”}, [and because ye have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} against the \sc Lord\sc*, [and have not obeyed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the voice| strong="H6963" \w* of the \sc Lord\sc*, [nor walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his law| strong="H8451" \w*, \w nor in his statutes| strong="H2708" \w*, \w nor in his testimonies| strong="H5715" \w*; \w therefore this evil| strong="H7451" \w* [is happened]{strong=“H7122” x-morph=“strongMorph: \sc Th\sc*8804”} [unto you, as at this day]{strong=“H3117”}. 
\v 24 \w Moreover Jeremiah| strong="H3414" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto all the people| strong="H5971" \w*, \w and to all the women| strong="H802" \w*, [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* of the \sc Lord\sc*, \w all Judah| strong="H3063" \w* that are \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*: 
\v 25 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}; \w Ye and your wives| strong="H802" \w* [have both spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w with your mouths| strong="H6310" \w*, [and fulfilled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8765”} \w with your hand| strong="H3027" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [We will surely]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [perform]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w our vows| strong="H5088" \w* [that we have vowed]{strong=“H5087” x-morph=“strongMorph: \sc Th\sc*8804”}, [to burn incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8763”} \w to the queen| strong="H4446" \w* \w of heaven| strong="H8064" \w*, [and to pour out]{strong=“H5258” x-morph=“strongMorph: \sc Th\sc*8687”} \w drink offerings| strong="H5262" \w* [unto her: ye will surely]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8687”} [accomplish]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8686”} \w your vows| strong="H5088" \w*, [and surely]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [perform]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w your vows| strong="H5088" \w*. 
\v 26 [Therefore hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye the word| strong="H1697" \w* of the \sc Lord\sc*, \w all Judah| strong="H3063" \w* [that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*; [Behold, I have sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w by my great| strong="H1419" \w* \w name| strong="H8034" \w*, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w that my name| strong="H8034" \w* [shall no more be named]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8737”} \w in the mouth| strong="H6310" \w* \w of any man| strong="H376" \w* \w of Judah| strong="H3063" \w* \w in all the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, \w The Lord| strong="H136" \w* \sc God\sc* \w liveth| strong="H2416" \w*. 
\v 27 [Behold, I will watch]{strong=“H8245” x-morph=“strongMorph: \sc Th\sc*8802”} \w over them for evil| strong="H7451" \w*, \w and not for good| strong="H2896" \w*: \w and all the men| strong="H376" \w* \w of Judah| strong="H3063" \w* that are \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* [shall be consumed]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8804”} \w by the sword| strong="H2719" \w* \w and by the famine| strong="H7458" \w*, [until there be an end]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8800”} of them. 
\v 28 \w Yet a small| strong="H4962" \w* \w number| strong="H4557" \w* \w that escape| strong="H6412" \w* \w the sword| strong="H2719" \w* [shall return out]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* \w into the land| strong="H776" \w* \w of Judah| strong="H3063" \w*, \w and all the remnant| strong="H7611" \w* \w of Judah| strong="H3063" \w*, [that are gone]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w into the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* [to sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8800”} [there, shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w whose words| strong="H1697" \w* [shall stand]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, mine, or theirs.\f + \fr 44:28 \ft mine…: Heb. from me, or, from them \f* 
\p
\v 29 And this shall be \w a sign| strong="H226" \w* [unto you, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [that I will punish]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8802”} \w you in this place| strong="H4725" \w*, [that ye may know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w that my words| strong="H1697" \w* [shall surely]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8800”} [stand]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w against you for evil| strong="H7451" \w*: 
