\p
\v 16 [Behold, I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8802”} \w for many| strong="H7227" \w* [fishers]{strong=“H1728 H1771” x-morph=“strongMorph: \sc Th\sc*8675”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [and they shall fish]{strong=“H1770” x-morph=“strongMorph: \sc Th\sc*8804”} [them; and after]{strong=“H310”} [will I send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w for many| strong="H7227" \w* \w hunters| strong="H6719" \w*, [and they shall hunt]{strong=“H6679” x-morph=“strongMorph: \sc Th\sc*8804”} \w them from every mountain| strong="H2022" \w*, \w and from every hill| strong="H1389" \w*, \w and out of the holes| strong="H5357" \w* \w of the rocks| strong="H5553" \w*. 
\v 17 \w For mine eyes| strong="H5869" \w* are \w upon all their ways| strong="H1870" \w*: [they are not hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8738”} \w from my face| strong="H6440" \w*, \w neither is their iniquity| strong="H5771" \w* [hid]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8738”} \w from| strong="H5048" \w* \w mine eyes| strong="H5869" \w*. 
