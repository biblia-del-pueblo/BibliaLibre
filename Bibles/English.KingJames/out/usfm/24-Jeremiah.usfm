\v 18 \w Moreover Jeremiah| strong="H3414" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto king| strong="H4428" \w* \w Zedekiah| strong="H6667" \w*, [What have I offended]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} [against thee, or against thy servants]{strong=“H5650”}, \w or against this people| strong="H5971" \w*, [that ye have put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [me in prison]{strong=“H3608 H1004”}? 
\v 19 Where are \w now| strong="H346" \w* \w your prophets| strong="H5030" \w* [which prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8738”} [unto you, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w The king| strong="H4428" \w* \w of Babylon| strong="H894" \w* [shall not come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [against you, nor against this land]{strong=“H776”}? 
\v 20 [Therefore hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [now, I pray thee, O my lord]{strong=“H113”} \w the king| strong="H4428" \w*: \w let my supplication| strong="H8467" \w*, [I pray thee, be accepted]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* [thee; that thou cause me not to return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w to the house| strong="H1004" \w* \w of Jonathan| strong="H3083" \w* [the scribe]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8802”}, [lest I die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} there.\f + \fr 37:20 \ft let…: Heb. let my supplication fall \f* 
\v 21 \w Then Zedekiah| strong="H6667" \w* \w the king| strong="H4428" \w* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} [that they should commit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8686”} \w Jeremiah| strong="H3414" \w* \w into the court| strong="H2691" \w* \w of the prison| strong="H4307" \w*, [and that they should give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w him daily| strong="H3117" \w* \w a piece| strong="H3603" \w* \w of bread| strong="H3899" \w* [out of the bakers’]{strong=“H644” x-morph=“strongMorph: \sc Th\sc*8802”} \w street| strong="H2351" \w*, \w until all the bread| strong="H3899" \w* \w in the city| strong="H5892" \w* [were spent]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8800”}. \w Thus Jeremiah| strong="H3414" \w* [remained ]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the court| strong="H2691" \w* \w of the prison| strong="H4307" \w*.
\c 38
\p 
\v 1 \w Then Shephatiah| strong="H8203" \w* \w the son| strong="H1121" \w* \w of Mattan| strong="H4977" \w*, \w and Gedaliah| strong="H1436" \w* \w the son| strong="H1121" \w* \w of Pashur| strong="H6583" \w*, \w and Jucal| strong="H3116" \w* \w the son| strong="H1121" \w* \w of Shelemiah| strong="H8018" \w*, \w and Pashur| strong="H6583" \w* \w the son| strong="H1121" \w* \w of Malchiah| strong="H4441" \w*, [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w the words| strong="H1697" \w* \w that Jeremiah| strong="H3414" \w* [had spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8764”} \w unto all the people| strong="H5971" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [He that remaineth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in this city| strong="H5892" \w* [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w*, \w by the famine| strong="H7458" \w*, \w and by the pestilence| strong="H1698" \w*: [but he that goeth forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the Chaldeans| strong="H3778" \w* [shall live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8804”}; \w for he shall have his life| strong="H5315" \w* \w for a prey| strong="H7998" \w*, [and shall live]{strong=“H2425 H2421” x-morph=“strongMorph: \sc Th\sc*8804 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8799”}. 
\v 3 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w This city| strong="H5892" \w* [shall surely]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8736”} [be given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8735”} \w into the hand| strong="H3027" \w* \w of the king| strong="H4428" \w* [of Babylon’s]{strong=“H894”} \w army| strong="H2428" \w*, [which shall take]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8804”} it. 
\v 4 \w Therefore the princes| strong="H8269" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the king| strong="H4428" \w*, [We beseech thee, let this man]{strong=“H376”} [be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}: \w for thus| strong="H3651" \w* [he weakeneth]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8764”} \w the hands| strong="H3027" \w* \w of the men| strong="H582" \w* \w of war| strong="H4421" \w* [that remain]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”} \w in this city| strong="H5892" \w*, \w and the hands| strong="H3027" \w* \w of all the people| strong="H5971" \w*, [in speaking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w such words| strong="H1697" \w* [unto them: for this man]{strong=“H376”} [seeketh]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8802”} \w not the welfare| strong="H7965" \w* \w of this people| strong="H5971" \w*, \w but the hurt| strong="H7451" \w*.\f + \fr 38:4 \ft welfare: Heb. peace \f* 
\v 5 \w Then Zedekiah| strong="H6667" \w* \w the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Behold, he is \w in your hand| strong="H3027" \w*: \w for the king| strong="H4428" \w* is not he that [can]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} do any \w thing| strong="H1697" \w* against you. 
\v 6 [Then took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w they Jeremiah| strong="H3414" \w*, [and cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w him into the dungeon| strong="H953" \w* \w of Malchiah| strong="H4441" \w* \w the son| strong="H1121" \w* \w of Hammelech| strong="H4428" \w*, that was \w in the court| strong="H2691" \w* \w of the prison| strong="H4307" \w*: [and they let down]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w Jeremiah| strong="H3414" \w* \w with cords| strong="H2256" \w*. \w And in the dungeon| strong="H953" \w* there was \w no water| strong="H4325" \w*, \w but mire| strong="H2916" \w*: \w so Jeremiah| strong="H3414" \w* [sunk]{strong=“H2883” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the mire| strong="H2916" \w*.\f + \fr 38:6 \ft of Hammelech: or, of the king \f* 
\p
\v 7 [Now when Ebed-melech]{strong=“H5663”} \w the Ethiopian| strong="H3569" \w*, \w one| strong="H376" \w* \w of the eunuchs| strong="H5631" \w* [which was in the king’s]{strong=“H4428”} \w house| strong="H1004" \w*, [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [that they had put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w Jeremiah| strong="H3414" \w* \w in the dungeon| strong="H953" \w*; \w the king| strong="H4428" \w* [then sitting]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the gate| strong="H8179" \w* \w of Benjamin| strong="H1144" \w*; 
\v 8 [Ebed-melech]{strong=“H5663”} [went forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} [out of the king’s]{strong=“H4428”} \w house| strong="H1004" \w*, [and spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w to the king| strong="H4428" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 9 \w My lord| strong="H113" \w* \w the king| strong="H4428" \w*, \w these men| strong="H582" \w* [have done evil]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8689”} [in all that they have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w to Jeremiah| strong="H3414" \w* \w the prophet| strong="H5030" \w*, [whom they have cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8689”} \w into the dungeon| strong="H953" \w*; [and he is like to die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w for| strong="H6440" \w* \w hunger| strong="H7458" \w* \w in the place| strong="H8478" \w* where he is: for there is \w no more bread| strong="H3899" \w* \w in the city| strong="H5892" \w*.\f + \fr 38:9 \ft he is like…: Heb. he will die \f* 
\v 10 \w Then the king| strong="H4428" \w* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} [Ebed-melech]{strong=“H5663”} \w the Ethiopian| strong="H3569" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w from hence thirty| strong="H7970" \w* \w men| strong="H582" \w* \w with thee| strong="H3027" \w*, [and take up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} \w Jeremiah| strong="H3414" \w* \w the prophet| strong="H5030" \w* \w out of the dungeon| strong="H953" \w*, [before he die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 38:10 \ft with thee: Heb. in thine hand \f* 
\v 11 [So Ebed-melech]{strong=“H5663”} [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the men| strong="H582" \w* \w with him| strong="H3027" \w*, [and went]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the house| strong="H1004" \w* \w of the king| strong="H4428" \w* \w under the treasury| strong="H214" \w*, [and took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w thence old| strong="H1094" \w* \w cast clouts| strong="H5499" \w* \w and old| strong="H1094" \w* \w rotten rags| strong="H4418" \w*, [and let them down]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w by cords| strong="H2256" \w* \w into the dungeon| strong="H953" \w* \w to Jeremiah| strong="H3414" \w*. 
\v 12 [And Ebed-melech]{strong=“H5663”} \w the Ethiopian| strong="H3569" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Jeremiah| strong="H3414" \w*, [Put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} now these \w old| strong="H1094" \w* \w cast clouts| strong="H5499" \w* \w and rotten rags| strong="H4418" \w* [under thine armholes]{strong=“H3027 H679”} \w under the cords| strong="H2256" \w*. \w And Jeremiah| strong="H3414" \w* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} so. 
\v 13 [So they drew up]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jeremiah| strong="H3414" \w* \w with cords| strong="H2256" \w*, [and took him up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w out of the dungeon| strong="H953" \w*: \w and Jeremiah| strong="H3414" \w* [remained]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the court| strong="H2691" \w* \w of the prison| strong="H4307" \w*. 
\p
\v 14 \w Then Zedekiah| strong="H6667" \w* \w the king| strong="H4428" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”}, [and took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jeremiah| strong="H3414" \w* \w the prophet| strong="H5030" \w* \w unto him into the third| strong="H7992" \w* \w entry| strong="H3996" \w* that is \w in the house| strong="H1004" \w* of the \sc Lord\sc*: \w and the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Jeremiah| strong="H3414" \w*, [I will ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8802”} \w thee a thing| strong="H1697" \w*; [hide]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8762”} nothing from me.\f + \fr 38:14 \ft third: or, principal \f* 
\v 15 \w Then Jeremiah| strong="H3414" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Zedekiah| strong="H6667" \w*, [If I declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} it [unto thee, wilt thou not surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8687”} [put me to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8686”}? [and if I give thee counsel]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8799”}, [wilt thou not hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} unto me? 
\v 16 \w So Zedekiah| strong="H6667" \w* \w the king| strong="H4428" \w* [sware]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8735”} \w secretly| strong="H5643" \w* \w unto Jeremiah| strong="H3414" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, As the \sc Lord\sc* \w liveth| strong="H2416" \w*, [that made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w us this soul| strong="H5315" \w*, [I will not put thee to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8686”}, [neither will I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee into the hand| strong="H3027" \w* \w of these men| strong="H582" \w* [that seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w thy life| strong="H5315" \w*. 
\v 17 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jeremiah| strong="H3414" \w* \w unto Zedekiah| strong="H6667" \w*, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w the God| strong="H430" \w* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*; [If thou wilt assuredly]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”} [go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the king| strong="H4428" \w* [of Babylon’s]{strong=“H894”} \w princes| strong="H8269" \w*, \w then thy soul| strong="H5315" \w* [shall live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and this city| strong="H5892" \w* [shall not be burned]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8735”} \w with fire| strong="H784" \w*; [and thou shalt live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and thine house| strong="H1004" \w*: 
\v 18 [But if thou wilt not go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the king| strong="H4428" \w* [of Babylon’s]{strong=“H894”} \w princes| strong="H8269" \w*, \w then shall this city| strong="H5892" \w* [be given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w into the hand| strong="H3027" \w* \w of the Chaldeans| strong="H3778" \w*, [and they shall burn]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8804”} \w it with fire| strong="H784" \w*, [and thou shalt not escape out]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8735”} \w of their hand| strong="H3027" \w*. 
\v 19 \w And Zedekiah| strong="H6667" \w* \w the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Jeremiah| strong="H3414" \w*, [I am afraid]{strong=“H1672” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the Jews| strong="H3064" \w* [that are fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the Chaldeans| strong="H3778" \w*, [lest they deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w me into their hand| strong="H3027" \w*, [and they mock]{strong=“H5953” x-morph=“strongMorph: \sc Th\sc*8694”} me. 
\v 20 \w But Jeremiah| strong="H3414" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [They shall not deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} thee. [Obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, [I beseech thee, the voice]{strong=“H6963”} of the \sc Lord\sc*, [which I speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} [unto thee: so it shall be well]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee, and thy soul]{strong=“H5315”} [shall live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 21 \w But if thou refuse| strong="H3986" \w* [to go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”}, this is \w the word| strong="H1697" \w* that the \sc Lord\sc* [hath shewed]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8689”} me: 
\v 22 [And, behold, all the women]{strong=“H802”} [that are left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the king| strong="H4428" \w* [of Judah’s]{strong=“H3063”} \w house| strong="H1004" \w* shall be [brought forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8716”} \w to the king| strong="H4428" \w* [of Babylon’s]{strong=“H894”} \w princes| strong="H8269" \w*, and those women [shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, [Thy friends]{strong=“H7965 H582”} [have set thee on]{strong=“H5496” x-morph=“strongMorph: \sc Th\sc*8689”}, [and have prevailed]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8804”} [against thee: thy feet]{strong=“H7272”} [are sunk]{strong=“H2883” x-morph=“strongMorph: \sc Th\sc*8717”} \w in the mire| strong="H1206" \w*, and [they are turned away]{strong=“H5472” x-morph=“strongMorph: \sc Th\sc*8738”} \w back| strong="H268" \w*.\f + \fr 38:22 \ft Thy friends: Heb. Men of thy peace \f* 
\v 23 [So they shall bring out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8688”} \w all thy wives| strong="H802" \w* \w and thy children| strong="H1121" \w* \w to the Chaldeans| strong="H3778" \w*: [and thou shalt not escape out]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8735”} \w of their hand| strong="H3027" \w*, [but shalt be taken]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8735”} \w by the hand| strong="H3027" \w* \w of the king| strong="H4428" \w* \w of Babylon| strong="H894" \w*: \w and thou shalt cause this city| strong="H5892" \w* [to be burned]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8799”} \w with fire| strong="H784" \w*.\f + \fr 38:23 \ft thou shalt cause…: Heb. thou shalt burn, etc \f* 
\p
\v 24 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Zedekiah| strong="H6667" \w* \w unto Jeremiah| strong="H3414" \w*, \w Let no man| strong="H376" \w* [know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w of these words| strong="H1697" \w*, [and thou shalt not die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 25 \w But if the princes| strong="H8269" \w* [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [that I have talked]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [with thee, and they come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [unto thee, and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto thee, Declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”} [unto us now what thou hast said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto the king| strong="H4428" \w*, [hide]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8762”} [it not from us, and we will not put thee to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8686”}; \w also what the king| strong="H4428" \w* [said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} unto thee: 
\v 26 [Then thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, I presented]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8688”} \w my supplication| strong="H8467" \w* \w before| strong="H6440" \w* \w the king| strong="H4428" \w*, [that he would not cause me to return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} [to Jonathan’s]{strong=“H3083”} \w house| strong="H1004" \w*, [to die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} there. 
\v 27 [Then came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the princes| strong="H8269" \w* \w unto Jeremiah| strong="H3414" \w*, [and asked]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} [him: and he told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w them according to all these words| strong="H1697" \w* \w that the king| strong="H4428" \w* [had commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”}. [So they left off speaking]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8686”} [with him; for the matter]{strong=“H1697”} [was not perceived]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8738”}.\f + \fr 38:27 \ft they…: Heb. they were silent from him \f* 
\v 28 \w So Jeremiah| strong="H3414" \w* [abode]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the court| strong="H2691" \w* \w of the prison| strong="H4307" \w* \w until the day| strong="H3117" \w* \w that Jerusalem| strong="H3389" \w* [was taken]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8738”}: and he was there \w when Jerusalem| strong="H3389" \w* [was taken]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8738”}.
\c 39
\p 
\v 1 \w In the ninth| strong="H8671" \w* \w year| strong="H8141" \w* \w of Zedekiah| strong="H6667" \w* \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w*, \w in the tenth| strong="H6224" \w* \w month| strong="H2320" \w*, [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w Nebuchadrezzar| strong="H5019" \w* \w king| strong="H4428" \w* \w of Babylon| strong="H894" \w* \w and all his army| strong="H2428" \w* \w against Jerusalem| strong="H3389" \w*, [and they besieged]{strong=“H6696” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\v 2 And [in the eleventh]{strong=“H6240 H6249”} \w year| strong="H8141" \w* \w of Zedekiah| strong="H6667" \w*, \w in the fourth| strong="H7243" \w* \w month| strong="H2320" \w*, \w the ninth| strong="H8672" \w* day \w of the month| strong="H2320" \w*, \w the city| strong="H5892" \w* [was broken up]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8717”}. 
\v 3 \w And all the princes| strong="H8269" \w* \w of the king| strong="H4428" \w* \w of Babylon| strong="H894" \w* [came in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [and sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the middle| strong="H8432" \w* \w gate| strong="H8179" \w*, even [Nergal-sharezer]{strong=“H5371”}, [Samgar-nebo]{strong=“H5562”}, \w Sarsechim| strong="H8310" \w*, [Rab-saris]{strong=“H7249”}, [Nergal-sharezer]{strong=“H5371”}, [Rab-mag]{strong=“H7248”}, \w with all the residue| strong="H7611" \w* \w of the princes| strong="H8269" \w* \w of the king| strong="H4428" \w* \w of Babylon| strong="H894" \w*. 
\p
\v 4 And it came to pass, that \w when Zedekiah| strong="H6667" \w* \w the king| strong="H4428" \w* \w of Judah| strong="H3063" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} [them, and all the men]{strong=“H582”} \w of war| strong="H4421" \w*, [then they fled]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8799”}, [and went forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of the city| strong="H5892" \w* \w by night| strong="H3915" \w*, \w by the way| strong="H1870" \w* [of the king’s]{strong=“H4428”} \w garden| strong="H1588" \w*, \w by the gate| strong="H8179" \w* \w betwixt the two walls| strong="H2346" \w*: [and he went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w the way| strong="H1870" \w* \w of the plain| strong="H6160" \w*. 
\v 5 [But the Chaldeans’]{strong=“H3778”} \w army| strong="H2428" \w* [pursued]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* [them, and overtook]{strong=“H5381” x-morph=“strongMorph: \sc Th\sc*8686”} \w Zedekiah| strong="H6667" \w* \w in the plains| strong="H6160" \w* \w of Jericho| strong="H3405" \w*: [and when they had taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [him, they brought him up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w to Nebuchadnezzar| strong="H5019" \w* \w king| strong="H4428" \w* \w of Babylon| strong="H894" \w* \w to Riblah| strong="H7247" \w* \w in the land| strong="H776" \w* \w of Hamath| strong="H2574" \w*, [where he gave]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w judgment| strong="H4941" \w* upon him.\f + \fr 39:5 \ft gave…: Heb. spake with him judgments \f* 
\v 6 \w Then the king| strong="H4428" \w* \w of Babylon| strong="H894" \w* [slew]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8799”} \w the sons| strong="H1121" \w* \w of Zedekiah| strong="H6667" \w* \w in Riblah| strong="H7247" \w* \w before his eyes| strong="H5869" \w*: \w also the king| strong="H4428" \w* \w of Babylon| strong="H894" \w* [slew]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8804”} \w all the nobles| strong="H2715" \w* \w of Judah| strong="H3063" \w*. 
\v 7 [Moreover he put out]{strong=“H5786” x-morph=“strongMorph: \sc Th\sc*8765”} [Zedekiah’s]{strong=“H6667”} \w eyes| strong="H5869" \w*, [and bound]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8799”} \w him with chains| strong="H5178" \w*, [to carry]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} \w him to Babylon| strong="H894" \w*.\f + \fr 39:7 \ft with…: Heb. with two brasen chains, or, fetters \f* 
\p
\v 8 \w And the Chaldeans| strong="H3778" \w* [burned]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8804”} [the king’s]{strong=“H4428”} \w house| strong="H1004" \w*, \w and the houses| strong="H1004" \w* \w of the people| strong="H5971" \w*, \w with fire| strong="H784" \w*, [and brake down]{strong=“H5422” x-morph=“strongMorph: \sc Th\sc*8804”} \w the walls| strong="H2346" \w* \w of Jerusalem| strong="H3389" \w*. 
\v 9 [Then Nebuzar-adan]{strong=“H5018”} \w the captain| strong="H7227" \w* \w of the guard| strong="H2876" \w* [carried away captive]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8689”} \w into Babylon| strong="H894" \w* \w the remnant| strong="H3499" \w* \w of the people| strong="H5971" \w* [that remained]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”} \w in the city| strong="H5892" \w*, [and those that fell away]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8802”}, [that fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} [to him, with the rest]{strong=“H3499”} \w of the people| strong="H5971" \w* [that remained]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”}.\f + \fr 39:9 \ft captain…: or, chief marshal: Heb. chief of the executioners, or, slaughtermen \f* 
\v 10 [But Nebuzar-adan]{strong=“H5018”} \w the captain| strong="H7227" \w* \w of the guard| strong="H2876" \w* [left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8689”} \w of the poor| strong="H1800" \w* \w of the people| strong="H5971" \w*, \w which had nothing| strong="H3972" \w*, \w in the land| strong="H776" \w* \w of Judah| strong="H3063" \w*, [and gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w them vineyards| strong="H3754" \w* \w and fields| strong="H3010" \w* \w at the same time| strong="H3117" \w*.\f + \fr 39:10 \ft captain…: or, chief marshal: Heb. chief of the executioners, or, slaughtermen \f* \f + \fr 39:10 \ft at the…: Heb. in that day \f* 
\p
\v 11 \w Now Nebuchadrezzar| strong="H5019" \w* \w king| strong="H4428" \w* \w of Babylon| strong="H894" \w* [gave charge]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} \w concerning Jeremiah| strong="H3414" \w* \w to| strong="H3027" \w* [Nebuzar-adan]{strong=“H5018”} \w the captain| strong="H7227" \w* \w of the guard| strong="H2876" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”},\f + \fr 39:11 \ft to: Heb. by the hand of \f* \f + \fr 39:11 \ft captain…: or, chief marshal: Heb. chief of the executioners, or, slaughtermen \f* 
\v 12 [Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} [him, and look well]{strong=“H7760 H5869” x-morph=“strongMorph: \sc Th\sc*8798”} [to him, and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [him no harm]{strong=“H7451 H3972”}; [but do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} [unto him even as he shall say]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} unto thee.\f + \fr 39:12 \ft look…: Heb. set thine eyes upon him \f* 
\v 13 [So Nebuzar-adan]{strong=“H5018”} \w the captain| strong="H7227" \w* \w of the guard| strong="H2876" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and Nebushasban| strong="H5021" \w*, [Rab-saris]{strong=“H7249”}, [and Nergal-sharezer]{strong=“H5371”}, [Rab-mag]{strong=“H7248”}, \w and all the king| strong="H4428" \w* [of Babylon’s]{strong=“H894”} \w princes| strong="H7227" \w*;\f + \fr 39:13 \ft captain…: or, chief marshal: Heb. chief of the executioners, or, slaughtermen \f* 
\v 14 [Even they sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”}, [and took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jeremiah| strong="H3414" \w* \w out of the court| strong="H2691" \w* \w of the prison| strong="H4307" \w*, [and committed]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w him unto Gedaliah| strong="H1436" \w* \w the son| strong="H1121" \w* \w of Ahikam| strong="H296" \w* \w the son| strong="H1121" \w* \w of Shaphan| strong="H8227" \w*, [that he should carry]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8687”} \w him home| strong="H1004" \w*: [so he dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w among| strong="H8432" \w* \w the people| strong="H5971" \w*. 
\p
\v 15 \w Now the word| strong="H1697" \w* of the \sc Lord\sc* \w came unto Jeremiah| strong="H3414" \w*, [while he was shut up]{strong=“H6113” x-morph=“strongMorph: \sc Th\sc*8803”} \w in the court| strong="H2691" \w* \w of the prison| strong="H4307" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 16 [Go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”} [and speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [to Ebed-melech]{strong=“H5663”} \w the Ethiopian| strong="H3569" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*; [Behold, I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w my words| strong="H1697" \w* \w upon this city| strong="H5892" \w* \w for evil| strong="H7451" \w*, \w and not for good| strong="H2896" \w*; and they shall be accomplished \w in that day| strong="H3117" \w* \w before| strong="H6440" \w* thee. 
\v 17 [But I will deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee in that day| strong="H3117" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: [and thou shalt not be given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8735”} \w into the hand| strong="H3027" \w* \w of the men| strong="H582" \w* \w of whom| strong="H6440" \w* thou art [afraid]{strong=“H3016” x-morph=“strongMorph: \sc Th\sc*8801”}. 
\v 18 [For I will surely]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8763”} [deliver]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8762”} [thee, and thou shalt not fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w*, \w but thy life| strong="H5315" \w* \w shall be for a prey| strong="H7998" \w* [unto thee: because thou hast put thy trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”} [in me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\c 40
\p 
\v 1 \w The word| strong="H1697" \w* \w that came to Jeremiah| strong="H3414" \w* from the \sc Lord\sc*, \w after| strong="H310" \w* [that Nebuzar-adan]{strong=“H5018”} \w the captain| strong="H7227" \w* \w of the guard| strong="H2876" \w* [had let him go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8763”} \w from Ramah| strong="H7414" \w*, [when he had taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} [him being bound]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8803”} \w in chains| strong="H246" \w* \w among| strong="H8432" \w* \w all that were carried away captive| strong="H1546" \w* \w of Jerusalem| strong="H3389" \w* \w and Judah| strong="H3063" \w*, [which were carried away captive]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8716”} \w unto Babylon| strong="H894" \w*.\f + \fr 40:1 \ft chains: or, manicles \f* 
\v 2 \w And the captain| strong="H7227" \w* \w of the guard| strong="H2876" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jeremiah| strong="H3414" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, The \sc Lord\sc* \w thy God| strong="H430" \w* [hath pronounced]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w this evil| strong="H7451" \w* \w upon this place| strong="H4725" \w*. 
\v 3 Now the \sc Lord\sc* [hath brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} it, [and done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [according as he hath said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}: [because ye have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} against the \sc Lord\sc*, [and have not obeyed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w his voice| strong="H6963" \w*, \w therefore this thing| strong="H1697" \w* is come upon you. 
\v 4 [And now, behold, I loose]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8765”} \w thee this day| strong="H3117" \w* \w from the chains| strong="H246" \w* which were \w upon thine hand| strong="H3027" \w*. [If it seem good]{strong=“H5869 H2896”} [unto thee to come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w with me into Babylon| strong="H894" \w*, [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”}; [and I will look well]{strong=“H5869 H7760” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee: but if it seem ill]{strong=“H5869 H7489” x-morph=“strongMorph: \sc Th\sc*8804”} [unto thee to come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w with me into Babylon| strong="H894" \w*, [forbear]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8798”}: [behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}, \w all the land| strong="H776" \w* is \w before| strong="H6440" \w* [thee: whither it seemeth]{strong=“H413”} \w good| strong="H2896" \w* [and convenient]{strong=“H5869 H3477”} [for thee to go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”}, [thither go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}.\f + \fr 40:4 \ft were…: or, are upon thine hand \f* \f + \fr 40:4 \ft I will…: Heb. I will set mine eye upon thee \f* 
\v 5 [Now while he was not yet gone back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, he said, [Go back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} \w also to Gedaliah| strong="H1436" \w* \w the son| strong="H1121" \w* \w of Ahikam| strong="H296" \w* \w the son| strong="H1121" \w* \w of Shaphan| strong="H8227" \w*, \w whom the king| strong="H4428" \w* \w of Babylon| strong="H894" \w* [hath made governor]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8689”} \w over the cities| strong="H5892" \w* \w of Judah| strong="H3063" \w*, [and dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8798”} \w with him among| strong="H8432" \w* \w the people| strong="H5971" \w*: [or go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} [wheresoever it seemeth convenient]{strong=“H5869 H3477”} [unto thee to go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”}. \w So the captain| strong="H7227" \w* \w of the guard| strong="H2876" \w* [gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w him victuals| strong="H737" \w* \w and a reward| strong="H4864" \w*, [and let him go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 6 [Then went]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jeremiah| strong="H3414" \w* \w unto Gedaliah| strong="H1436" \w* \w the son| strong="H1121" \w* \w of Ahikam| strong="H296" \w* \w to Mizpah| strong="H4708" \w*; [and dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w with him among| strong="H8432" \w* \w the people| strong="H5971" \w* [that were left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”} \w in the land| strong="H776" \w*. 
\p
