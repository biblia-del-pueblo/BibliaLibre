\p
\v 9 [Wherefore I will yet plead]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”} [with you, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [and with your children’s]{strong=“H1121”} \w children| strong="H1121" \w* [will I plead]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 10 [For pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8798”} \w the isles| strong="H339" \w* \w of Chittim| strong="H3794" \w*, [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}; [and send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto Kedar| strong="H6938" \w*, [and consider]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8708”} \w diligently| strong="H3966" \w*, [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} if there be such a thing.\f + \fr 2:10 \ft over: or, over to \f* 
\v 11 \w Hath a nation| strong="H1471" \w* [changed]{strong=“H3235” x-morph=“strongMorph: \sc Th\sc*8689”} their \w gods| strong="H430" \w*, which are \w yet no gods| strong="H430" \w*? \w but my people| strong="H5971" \w* [have changed]{strong=“H4171” x-morph=“strongMorph: \sc Th\sc*8689”} \w their glory| strong="H3519" \w* for that which [doth not profit]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 12 [Be astonished]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O ye heavens| strong="H8064" \w*, [at this, and be horribly afraid]{strong=“H8175” x-morph=“strongMorph: \sc Th\sc*8798”}, \w be ye very| strong="H3966" \w* [desolate]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8798”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 13 \w For my people| strong="H5971" \w* [have committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w two| strong="H8147" \w* \w evils| strong="H7451" \w*; [they have forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} \w me the fountain| strong="H4726" \w* \w of living| strong="H2416" \w* \w waters| strong="H4325" \w*, and [hewed them out]{strong=“H2672” x-morph=“strongMorph: \sc Th\sc*8800”} \w cisterns| strong="H877" \w*, [broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8737”} \w cisterns| strong="H877" \w*, [that can hold]{strong=“H3557” x-morph=“strongMorph: \sc Th\sc*8686”} \w no water| strong="H4325" \w*. 
\p
\v 14 Is \w Israel| strong="H3478" \w* \w a servant| strong="H5650" \w*? is [he a homeborn]{strong=“H3211 H1004”} slave? \w why| strong="H4069" \w* \w is he spoiled| strong="H957" \w*?\f + \fr 2:14 \ft spoiled: Heb. become a spoil? \f* 
\v 15 \w The young lions| strong="H3715" \w* [roared]{strong=“H7580” x-morph=“strongMorph: \sc Th\sc*8799”} upon him, and [yelled]{strong=“H6963 H5414” x-morph=“strongMorph: \sc Th\sc*8804”}, [and they made]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w his land| strong="H776" \w* \w waste| strong="H8047" \w*: \w his cities| strong="H5892" \w* [are burned]{strong=“H3341” x-morph=“strongMorph: \sc Th\sc*8738”} [without inhabitant]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 2:15 \ft yelled: Heb. gave out their voice \f* 
\v 16 \w Also the children| strong="H1121" \w* \w of Noph| strong="H5297" \w* \w and Tahapanes| strong="H8471" \w* [have broken]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} \w the crown of thy head| strong="H6936" \w*.\f + \fr 2:16 \ft have…: or, feed on thy crown \f* 
\v 17 [Hast thou not procured]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [this unto thyself, in that thou hast forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8800”} the \sc Lord\sc* \w thy God| strong="H430" \w*, \w when| strong="H6256" \w* [he led]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8688”} \w thee by the way| strong="H1870" \w*? 
\v 18 \w And now what hast thou to do in the way| strong="H1870" \w* \w of Egypt| strong="H4714" \w*, [to drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”} \w the waters| strong="H4325" \w* \w of Sihor| strong="H7883" \w*? \w or what hast thou to do in the way| strong="H1870" \w* \w of Assyria| strong="H804" \w*, [to drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”} \w the waters| strong="H4325" \w* \w of the river| strong="H5104" \w*? 
\v 19 \w Thine own wickedness| strong="H7451" \w* [shall correct]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8762”} [thee, and thy backslidings]{strong=“H4878”} [shall reprove]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”} [thee: know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”} [therefore and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} that it is \w an evil| strong="H7451" \w* thing \w and bitter| strong="H4751" \w*, [that thou hast forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8800”} the \sc Lord\sc* \w thy God| strong="H430" \w*, \w and that my fear| strong="H6345" \w* is [not in thee, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc* \w of hosts| strong="H6635" \w*. 
\p
\v 20 \w For of old time| strong="H5769" \w* [I have broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy yoke| strong="H5923" \w*, and [burst]{strong=“H5423” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy bands| strong="H4147" \w*; [and thou saidst]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will not transgress]{strong=“H5647 H5674” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8799”}; \w when upon every high| strong="H1364" \w* \w hill| strong="H1389" \w* \w and under every green| strong="H7488" \w* \w tree| strong="H6086" \w* [thou wanderest]{strong=“H6808” x-morph=“strongMorph: \sc Th\sc*8802”}, [playing the harlot]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 2:20 \ft transgress: or, serve \f* 
\v 21 [Yet I had planted]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee a noble vine| strong="H8321" \w*, \w wholly a right| strong="H571" \w* \w seed| strong="H2233" \w*: [how then art thou turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8738”} \w into the degenerate plant| strong="H5494" \w* \w of a strange| strong="H5237" \w* \w vine| strong="H1612" \w* unto me? 
\v 22 [For though thou wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8762”} \w thee with nitre| strong="H5427" \w*, [and take thee much]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} \w soap| strong="H1287" \w*, yet \w thine iniquity| strong="H5771" \w* [is marked]{strong=“H3799” x-morph=“strongMorph: \sc Th\sc*8737”} \w before| strong="H6440" \w* [me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\v 23 [How canst thou say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I am not polluted]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8738”}, [I have not gone]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w after| strong="H310" \w* \w Baalim| strong="H1168" \w*? [see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy way| strong="H1870" \w* \w in the valley| strong="H1516" \w*, [know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”} [what thou hast done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}: thou art \w a swift| strong="H7031" \w* \w dromedary| strong="H1072" \w* [traversing]{strong=“H8308” x-morph=“strongMorph: \sc Th\sc*8764”} \w her ways| strong="H1870" \w*;\f + \fr 2:23 \ft thou art…: or, O swift dromedary \f* 
\v 24 \w A wild ass| strong="H6501" \w* \w used| strong="H3928" \w* \w to the wilderness| strong="H4057" \w*, that [snuffeth up]{strong=“H7602” x-morph=“strongMorph: \sc Th\sc*8804”} \w the wind| strong="H7307" \w* [at her pleasure]{strong=“H5315 H185”}; \w in her occasion| strong="H8385" \w* [who can turn her away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”}? [all they that seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} [her will not weary]{strong=“H3286” x-morph=“strongMorph: \sc Th\sc*8799”} [themselves; in her month]{strong=“H2320”} [they shall find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} her.\f + \fr 2:24 \ft A wild…: or, O wild ass, etc \f* \f + \fr 2:24 \ft used: Heb. taught \f* \f + \fr 2:24 \ft her pleasure: Heb. the desire of her heart \f* \f + \fr 2:24 \ft turn…: or, reverse it? \f* 
\v 25 [Withhold]{strong=“H4513” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy foot| strong="H7272" \w* \w from being unshod| strong="H3182" \w*, \w and thy throat| strong="H1627" \w* \w from thirst| strong="H6773" \w*: [but thou saidst]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [There is no hope]{strong=“H2976” x-morph=“strongMorph: \sc Th\sc*8737”}: [no; for I have loved]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} [strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”}, \w and after| strong="H310" \w* [them will I go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 2:25 \ft There…: or, Is the case desperate? \f* 
\v 26 \w As the thief| strong="H1590" \w* \w is ashamed| strong="H1322" \w* [when he is found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”}, \w so is the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* [ashamed]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”}; [they, their kings]{strong=“H4428”}, \w their princes| strong="H8269" \w*, \w and their priests| strong="H3548" \w*, \w and their prophets| strong="H5030" \w*, 
\v 27 [Saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} \w to a stock| strong="H6086" \w*, Thou art \w my father| strong="H1" \w*; \w and to a stone| strong="H68" \w*, [Thou hast brought me forth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”}: [for they have turned]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8804”} their \w back| strong="H6203" \w* unto me, and not their \w face| strong="H6440" \w*: \w but in the time| strong="H6256" \w* \w of their trouble| strong="H7451" \w* [they will say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [and save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”} us.\f + \fr 2:27 \ft brought…: or, begotten me \f* \f + \fr 2:27 \ft their back: Heb. the hinder part of the neck \f* 
\v 28 But where are \w thy gods| strong="H430" \w* [that thou hast made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [thee? let them arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [if they can save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee in the time| strong="H6256" \w* \w of thy trouble| strong="H7451" \w*: for according to \w the number| strong="H4557" \w* \w of thy cities| strong="H5892" \w* \w are thy gods| strong="H430" \w*, \w O Judah| strong="H3063" \w*.\f + \fr 2:28 \ft trouble: Heb. evil \f* 
\p
\v 29 [Wherefore will ye plead]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”} [with me? ye all have transgressed]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8804”} [against me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 30 \w In vain| strong="H7723" \w* [have I smitten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w your children| strong="H1121" \w*; [they received]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w no correction| strong="H4148" \w*: \w your own sword| strong="H2719" \w* [hath devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w your prophets| strong="H5030" \w*, [like a destroying]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8688”} \w lion| strong="H738" \w*. 
\p
\v 31 \w O generation| strong="H1755" \w*, [see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye the word| strong="H1697" \w* of the \sc Lord\sc*. \w Have I been a wilderness| strong="H4057" \w* \w unto Israel| strong="H3478" \w*? \w a land| strong="H776" \w* \w of darkness| strong="H3991" \w*? [wherefore say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w my people| strong="H5971" \w*, [We are lords]{strong=“H7300” x-morph=“strongMorph: \sc Th\sc*8804”}; [we will come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} no more unto thee?\f + \fr 2:31 \ft We are…: Heb. We have dominion \f* 
\v 32 \w Can a maid| strong="H1330" \w* [forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} \w her ornaments| strong="H5716" \w*, or \w a bride| strong="H3618" \w* \w her attire| strong="H7196" \w*? \w yet my people| strong="H5971" \w* [have forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} \w me days| strong="H3117" \w* \w without number| strong="H4557" \w*. 
\v 33 [Why trimmest]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8686”} \w thou thy way| strong="H1870" \w* [to seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8763”} \w love| strong="H160" \w*? [therefore hast thou also taught]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8765”} \w the wicked ones| strong="H7451" \w* \w thy ways| strong="H1870" \w*. 
\v 34 \w Also in thy skirts| strong="H3671" \w* [is found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8738”} \w the blood| strong="H1818" \w* \w of the souls| strong="H5315" \w* \w of the poor| strong="H34" \w* \w innocents| strong="H5355" \w*: [I have not found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w it by secret search| strong="H4290" \w*, but upon all these.\f + \fr 2:34 \ft secret…: Heb. digging \f* 
\v 35 [Yet thou sayest]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Because I am innocent]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8738”}, \w surely his anger| strong="H639" \w* [shall turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} [from me. Behold, I will plead]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8737”} [with thee, because thou sayest]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [I have not sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 36 [Why gaddest thou about]{strong=“H235” x-morph=“strongMorph: \sc Th\sc*8799”} \w so much| strong="H3966" \w* [to change]{strong=“H8138” x-morph=“strongMorph: \sc Th\sc*8763”} \w thy way| strong="H1870" \w*? [thou also shalt be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} \w of Egypt| strong="H4714" \w*, [as thou wast ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8804”} \w of Assyria| strong="H804" \w*. 
\v 37 [Yea, thou shalt go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} [from him, and thine hands]{strong=“H3027”} \w upon thine head| strong="H7218" \w*: for the \sc Lord\sc* [hath rejected]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy confidences| strong="H4009" \w*, [and thou shalt not prosper]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8686”} in them.
\c 3
\p 
\v 1 [They say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w If a man| strong="H376" \w* [put away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w his wife| strong="H802" \w*, [and she go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} [from him, and become another]{strong=“H312”} [man’s]{strong=“H376”}, [shall he return unto her again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}? \w shall not that land| strong="H776" \w* [be greatly]{strong=“H2610” x-morph=“strongMorph: \sc Th\sc*8800”} [polluted]{strong=“H2610” x-morph=“strongMorph: \sc Th\sc*8799”}? [but thou hast played the harlot]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8804”} \w with many| strong="H7227" \w* \w lovers| strong="H7453" \w*; [yet return again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} [to me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*.\f + \fr 3:1 \ft They say: Heb. Saying \f* 
\v 2 [Lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w thine eyes| strong="H5869" \w* \w unto the high places| strong="H8205" \w*, [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w where| strong="H375" \w* [thou hast not been lien]{strong=“H7901 H7693” x-morph=“strongMorph: \sc Th\sc*8795 strongMorph: \sc Th\sc*8676 strongMorph: \sc Th\sc*8795”} [with. In the ways]{strong=“H1870”} [hast thou sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} [for them, as the Arabian]{strong=“H6163”} \w in the wilderness| strong="H4057" \w*; [and thou hast polluted]{strong=“H2610” x-morph=“strongMorph: \sc Th\sc*8686”} \w the land| strong="H776" \w* \w with thy whoredoms| strong="H2184" \w* \w and with thy wickedness| strong="H7451" \w*. 
\v 3 \w Therefore the showers| strong="H7241" \w* [have been withholden]{strong=“H4513” x-morph=“strongMorph: \sc Th\sc*8735”}, \w and there hath been no latter rain| strong="H4456" \w*; [and thou hadst a whore’s]{strong=“H802 H2181” x-morph=“strongMorph: \sc Th\sc*8802”} \w forehead| strong="H4696" \w*, [thou refusedst]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8765”} [to be ashamed]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8736”}. 
\v 4 [Wilt thou not from this time cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me, My father]{strong=“H1”}, thou art \w the guide| strong="H441" \w* \w of my youth| strong="H5271" \w*? 
\v 5 [Will he reserve]{strong=“H5201” x-morph=“strongMorph: \sc Th\sc*8799”} his anger \w for ever| strong="H5769" \w*? [will he keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} it \w to the end| strong="H5331" \w*? [Behold, thou hast spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [and done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w evil things| strong="H7451" \w* [as thou couldest]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 6 The \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w also unto me in the days| strong="H3117" \w* \w of Josiah| strong="H2977" \w* \w the king| strong="H4428" \w*, [Hast thou seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} that \w which backsliding| strong="H4878" \w* \w Israel| strong="H3478" \w* [hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}? [she is gone up]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon every high| strong="H1364" \w* \w mountain| strong="H2022" \w* \w and under| strong="H8478" \w* \w every green| strong="H7488" \w* \w tree| strong="H6086" \w*, [and there hath played the harlot]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 7 [And I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* [she had done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} all these things, [Turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [thou unto me. But she returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} [not. And her treacherous]{strong=“H901”} \w sister| strong="H269" \w* \w Judah| strong="H3063" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\v 8 [And I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, \w when for all the causes| strong="H182" \w* \w whereby backsliding| strong="H4878" \w* \w Israel| strong="H3478" \w* [committed adultery]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8765”} [I had put her away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”}, [and given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w her a bill| strong="H5612" \w* \w of divorce| strong="H3748" \w*; [yet her treacherous]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”} \w sister| strong="H269" \w* \w Judah| strong="H3063" \w* [feared]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8804”} [not, but went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [and played the harlot]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8799”} also. 
\v 9 \w And it came to pass through the lightness| strong="H6963" \w* \w of her whoredom| strong="H2184" \w*, [that she defiled]{strong=“H2610” x-morph=“strongMorph: \sc Th\sc*8799”} \w the land| strong="H776" \w*, [and committed adultery]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8799”} \w with stones| strong="H68" \w* \w and with stocks| strong="H6086" \w*.\f + \fr 3:9 \ft lightness: or, fame \f* 
\v 10 \w And yet for all this her treacherous| strong="H901" \w* \w sister| strong="H269" \w* \w Judah| strong="H3063" \w* [hath not turned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto me with her whole heart| strong="H3820" \w*, \w but feignedly| strong="H8267" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*.\f + \fr 3:10 \ft feignedly: Heb. in falsehood \f* 
\v 11 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, The backsliding]{strong=“H4878”} \w Israel| strong="H3478" \w* [hath justified]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8765”} \w herself| strong="H5315" \w* [more than treacherous]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”} \w Judah| strong="H3063" \w*. 
\p
\v 12 [Go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”} [and proclaim]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w these words| strong="H1697" \w* \w toward the north| strong="H6828" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”}, \w thou backsliding| strong="H4878" \w* \w Israel| strong="H3478" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*; and \w I will not cause mine anger| strong="H6440" \w* [to fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8686”} upon you: for I am \w merciful| strong="H2623" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, and [I will not keep]{strong=“H5201” x-morph=“strongMorph: \sc Th\sc*8799”} anger \w for ever| strong="H5769" \w*. 
\v 13 [Only acknowledge]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”} \w thine iniquity| strong="H5771" \w*, [that thou hast transgressed]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8804”} against the \sc Lord\sc* \w thy God| strong="H430" \w*, [and hast scattered]{strong=“H6340” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy ways| strong="H1870" \w* [to the strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} \w under every green| strong="H7488" \w* \w tree| strong="H6086" \w*, [and ye have not obeyed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w my voice| strong="H6963" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 14 [Turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O backsliding| strong="H7726" \w* \w children| strong="H1121" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*; [for I am married]{strong=“H1166” x-morph=“strongMorph: \sc Th\sc*8804”} [unto you: and I will take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w you one| strong="H259" \w* \w of a city| strong="H5892" \w*, \w and two| strong="H8147" \w* \w of a family| strong="H4940" \w*, [and I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w you to Zion| strong="H6726" \w*: 
\v 15 [And I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [you pastors]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} \w according to mine heart| strong="H3820" \w*, [which shall feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8804”} \w you with knowledge| strong="H1844" \w* [and understanding]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8687”}. 
\v 16 [And it shall come to pass, when ye be multiplied]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8799”} [and increased]{strong=“H6509” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the land| strong="H776" \w*, \w in those days| strong="H3117" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [they shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [no more, The ark]{strong=“H727”} \w of the covenant| strong="H1285" \w* of the \sc Lord\sc*: [neither shall it come]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w to mind| strong="H3820" \w*: [neither shall they remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} [it; neither shall they visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} it; neither shall that [be done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8735”} any more.\f + \fr 3:16 \ft come to mind: Heb. come upon the heart \f* \f + \fr 3:16 \ft that…: or, it be magnified \f* 
\v 17 \w At that time| strong="H6256" \w* [they shall call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jerusalem| strong="H3389" \w* \w the throne| strong="H3678" \w* of the \sc Lord\sc*; \w and all the nations| strong="H1471" \w* [shall be gathered]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8738”} [unto it, to the name]{strong=“H8034”} of the \sc Lord\sc*, \w to Jerusalem| strong="H3389" \w*: [neither shall they walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w any more after| strong="H310" \w* \w the imagination| strong="H8307" \w* \w of their evil| strong="H7451" \w* \w heart| strong="H3820" \w*.\f + \fr 3:17 \ft imagination: or, stubbornness \f* 
\v 18 \w In those days| strong="H3117" \w* \w the house| strong="H1004" \w* \w of Judah| strong="H3063" \w* [shall walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, [and they shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w together| strong="H3162" \w* \w out of the land| strong="H776" \w* \w of the north| strong="H6828" \w* \w to the land| strong="H776" \w* [that I have given for an inheritance]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8689”} \w unto your fathers| strong="H1" \w*.\f + \fr 3:18 \ft with: or, to \f* \f + \fr 3:18 \ft given…: or, caused your fathers to possess \f* 
\v 19 [But I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [How shall I put]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee among the children| strong="H1121" \w*, [and give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee a pleasant| strong="H2532" \w* \w land| strong="H776" \w*, \w a goodly| strong="H6643" \w* \w heritage| strong="H5159" \w* \w of the hosts| strong="H6635" \w* \w of nations| strong="H1471" \w*? [and I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Thou shalt call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} [me, My father]{strong=“H1”}; [and shalt not turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w from me| strong="H310" \w*.\f + \fr 3:19 \ft from me: Heb. from after me \f* \f + \fr 3:19 \ft a goodly…: Heb. an heritage of glory, or, beauty \f* \f + \fr 3:19 \ft pleasant…: Heb. land of desire \f* 
\p
\v 20 \w Surely| strong="H403" \w* as \w a wife| strong="H802" \w* [treacherously]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8804”} \w departeth from her husband| strong="H7453" \w*, [so have ye dealt treacherously]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8804”} [with me, O house]{strong=“H1004”} \w of Israel| strong="H3478" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*.\f + \fr 3:20 \ft husband: Heb. friend \f* 
\v 21 \w A voice| strong="H6963" \w* [was heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8738”} \w upon the high places| strong="H8205" \w*, \w weeping| strong="H1065" \w* and \w supplications| strong="H8469" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*: [for they have perverted]{strong=“H5753” x-morph=“strongMorph: \sc Th\sc*8689”} \w their way| strong="H1870" \w*, and [they have forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w their God| strong="H430" \w*. 
\v 22 [Return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”}, \w ye backsliding| strong="H7726" \w* \w children| strong="H1121" \w*, and [I will heal]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8799”} \w your backslidings| strong="H4878" \w*. [Behold, we come]{strong=“H857” x-morph=“strongMorph: \sc Th\sc*8804”} unto thee; for thou art the \sc Lord\sc* \w our God| strong="H430" \w*. 
\v 23 \w Truly| strong="H403" \w* \w in vain| strong="H8267" \w* is salvation hoped for \w from the hills| strong="H1389" \w*, and from \w the multitude| strong="H1995" \w* \w of mountains| strong="H2022" \w*: \w truly| strong="H403" \w* in the \sc Lord\sc* \w our God| strong="H430" \w* is \w the salvation| strong="H8668" \w* \w of Israel| strong="H3478" \w*. 
\v 24 \w For shame| strong="H1322" \w* [hath devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w the labour| strong="H3018" \w* \w of our fathers| strong="H1" \w* \w from our youth| strong="H5271" \w*; \w their flocks| strong="H6629" \w* \w and their herds| strong="H1241" \w*, \w their sons| strong="H1121" \w* \w and their daughters| strong="H1323" \w*. 
\v 25 [We lie down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w in our shame| strong="H1322" \w*, \w and our confusion| strong="H3639" \w* [covereth]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} [us: for we have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} against the \sc Lord\sc* \w our God| strong="H430" \w*, \w we and our fathers| strong="H1" \w*, \w from our youth| strong="H5271" \w* \w even unto this day| strong="H3117" \w*, [and have not obeyed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the voice| strong="H6963" \w* of the \sc Lord\sc* \w our God| strong="H430" \w*.
\c 4
\p 
\v 1 [If thou wilt return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, \w O Israel| strong="H3478" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me: and if thou wilt put away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8686”} \w thine abominations| strong="H8251" \w* \w out of my sight| strong="H6440" \w*, [then shalt thou not remove]{strong=“H5110” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 2 [And thou shalt swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”}, The \sc Lord\sc* \w liveth| strong="H2416" \w*, \w in truth| strong="H571" \w*, \w in judgment| strong="H4941" \w*, \w and in righteousness| strong="H6666" \w*; \w and the nations| strong="H1471" \w* [shall bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8694”} [themselves in him, and in him shall they glory]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8691”}. 
\p
\v 3 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w to the men| strong="H376" \w* \w of Judah| strong="H3063" \w* \w and Jerusalem| strong="H3389" \w*, [Break up]{strong=“H5214” x-morph=“strongMorph: \sc Th\sc*8798”} \w your fallow ground| strong="H5215" \w*, [and sow]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8799”} \w not among thorns| strong="H6975" \w*. 
\v 4 [Circumcise]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8734”} yourselves to the \sc Lord\sc*, [and take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8685”} \w the foreskins| strong="H6190" \w* \w of your heart| strong="H3824" \w*, \w ye men| strong="H376" \w* \w of Judah| strong="H3063" \w* [and inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w*: \w lest my fury| strong="H2534" \w* [come forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w like fire| strong="H784" \w*, [and burn]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8804”} [that none can quench]{strong=“H3518” x-morph=“strongMorph: \sc Th\sc*8764”} it, \w because| strong="H6440" \w* \w of the evil| strong="H7455" \w* \w of your doings| strong="H4611" \w*. 
\p
\v 5 [Declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”} \w ye in Judah| strong="H3063" \w*, [and publish]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8685”} \w in Jerusalem| strong="H3389" \w*; [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”}, [Blow]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye the trumpet| strong="H7782" \w* \w in the land| strong="H776" \w*: [cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”}, [gather together]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8761”}, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”}, [Assemble]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8734”} [yourselves, and let us go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the defenced| strong="H4013" \w* \w cities| strong="H5892" \w*. 
\v 6 [Set up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w the standard| strong="H5251" \w* \w toward Zion| strong="H6726" \w*: [retire]{strong=“H5756” x-morph=“strongMorph: \sc Th\sc*8685”}, [stay]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} [not: for I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w evil| strong="H7451" \w* \w from the north| strong="H6828" \w*, \w and a great| strong="H1419" \w* \w destruction| strong="H7667" \w*.\f + \fr 4:6 \ft retire: or, strengthen \f* \f + \fr 4:6 \ft destruction: Heb. breaking \f* 
\v 7 \w The lion| strong="H738" \w* [is come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w from his thicket| strong="H5441" \w*, [and the destroyer]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8688”} \w of the Gentiles| strong="H1471" \w* [is on his way]{strong=“H5265” x-morph=“strongMorph: \sc Th\sc*8804”}; [he is gone forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w from his place| strong="H4725" \w* [to make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy land| strong="H776" \w* \w desolate| strong="H8047" \w*; and \w thy cities| strong="H5892" \w* [shall be laid waste]{strong=“H5327” x-morph=“strongMorph: \sc Th\sc*8799”}, [without an inhabitant]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 8 [For this gird]{strong=“H2296” x-morph=“strongMorph: \sc Th\sc*8798”} \w you with sackcloth| strong="H8242" \w*, [lament]{strong=“H5594” x-morph=“strongMorph: \sc Th\sc*8798”} [and howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8685”}: \w for the fierce| strong="H2740" \w* \w anger| strong="H639" \w* of the \sc Lord\sc* [is not turned back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} from us. 
\v 9 \w And it shall come to pass at that day| strong="H3117" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, that \w the heart| strong="H3820" \w* \w of the king| strong="H4428" \w* [shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the heart| strong="H3820" \w* \w of the princes| strong="H8269" \w*; \w and the priests| strong="H3548" \w* [shall be astonished]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and the prophets| strong="H5030" \w* [shall wonder]{strong=“H8539” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 10 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [I, Ah]{strong=“H162”}, \w Lord| strong="H136" \w* \sc God\sc*! \w surely| strong="H403" \w* [thou hast greatly]{strong=“H5377” x-morph=“strongMorph: \sc Th\sc*8687”} [deceived]{strong=“H5377” x-morph=“strongMorph: \sc Th\sc*8689”} \w this people| strong="H5971" \w* \w and Jerusalem| strong="H3389" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Ye shall have peace| strong="H7965" \w*; \w whereas the sword| strong="H2719" \w* [reacheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the soul| strong="H5315" \w*. 
\v 11 \w At that time| strong="H6256" \w* [shall it be said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8735”} \w to this people| strong="H5971" \w* \w and to Jerusalem| strong="H3389" \w*, \w A dry| strong="H6703" \w* \w wind| strong="H7307" \w* \w of the high places| strong="H8205" \w* \w in the wilderness| strong="H4057" \w* \w toward| strong="H1870" \w* \w the daughter| strong="H1323" \w* \w of my people| strong="H5971" \w*, [not to fan]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8800”}, [nor to cleanse]{strong=“H1305” x-morph=“strongMorph: \sc Th\sc*8687”}, 
\v 12 Even \w a full| strong="H4392" \w* \w wind| strong="H7307" \w* from those places [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me: now also will I give]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w sentence| strong="H4941" \w* against them.\f + \fr 4:12 \ft a full…: or, a fuller wind than those \f* \f + \fr 4:12 \ft give…: Heb. utter judgments \f* 
\v 13 [Behold, he shall come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w as clouds| strong="H6051" \w*, \w and his chariots| strong="H4818" \w* shall be \w as a whirlwind| strong="H5492" \w*: \w his horses| strong="H5483" \w* [are swifter]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8804”} \w than eagles| strong="H5404" \w*. \w Woe| strong="H188" \w* [unto us! for we are spoiled]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8795”}. 
\v 14 \w O Jerusalem| strong="H3389" \w*, [wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8761”} \w thine heart| strong="H3820" \w* \w from wickedness| strong="H7451" \w*, [that thou mayest be saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8735”}. \w How long shall thy vain| strong="H205" \w* \w thoughts| strong="H4284" \w* [lodge]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8686”} \w within| strong="H7130" \w* thee? 
\v 15 \w For a voice| strong="H6963" \w* [declareth]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8688”} \w from Dan| strong="H1835" \w*, [and publisheth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8688”} \w affliction| strong="H205" \w* \w from mount| strong="H2022" \w* \w Ephraim| strong="H669" \w*. 
\v 16 [Make ye mention]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8685”} \w to the nations| strong="H1471" \w*; [behold, publish]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8685”} \w against Jerusalem| strong="H3389" \w*, that [watchers]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8802”} [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w from a far| strong="H4801" \w* \w country| strong="H776" \w*, [and give out]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w their voice| strong="H6963" \w* \w against the cities| strong="H5892" \w* \w of Judah| strong="H3063" \w*. 
\v 17 [As keepers]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w of a field| strong="H7704" \w*, \w are they against her round about| strong="H5439" \w*; [because she hath been rebellious]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8804”} [against me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 18 \w Thy way| strong="H1870" \w* \w and thy doings| strong="H4611" \w* [have procured]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} these things unto thee; this is \w thy wickedness| strong="H7451" \w*, \w because it is bitter| strong="H4751" \w*, [because it reacheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto thine heart| strong="H3820" \w*. 
\p
\v 19 \w My bowels| strong="H4578" \w*, \w my bowels| strong="H4578" \w*! [I am pained]{strong=“H3176 H2342” x-morph=“strongMorph: \sc Th\sc*8686 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8799”} \w at my very| strong="H7023" \w* \w heart| strong="H3820" \w*; \w my heart| strong="H3820" \w* [maketh a noise]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8802”} [in me; I cannot hold my peace]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8686”}, [because thou hast heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}, \w O my soul| strong="H5315" \w*, \w the sound| strong="H6963" \w* \w of the trumpet| strong="H7782" \w*, \w the alarm| strong="H8643" \w* \w of war| strong="H4421" \w*.\f + \fr 4:19 \ft my very…: Heb. the walls of my heart \f* 
\v 20 \w Destruction| strong="H7667" \w* \w upon destruction| strong="H7667" \w* [is cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8738”}; \w for the whole land| strong="H776" \w* [is spoiled]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8795”}: \w suddenly| strong="H6597" \w* \w are my tents| strong="H168" \w* [spoiled]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8795”}, and \w my curtains| strong="H3407" \w* \w in a moment| strong="H7281" \w*. 
\v 21 [How long shall I see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the standard| strong="H5251" \w*, and [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w the sound| strong="H6963" \w* \w of the trumpet| strong="H7782" \w*? 
\v 22 \w For my people| strong="H5971" \w* is \w foolish| strong="H191" \w*, [they have not known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} me; they are \w sottish| strong="H5530" \w* \w children| strong="H1121" \w*, [and they have none understanding]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8737”}: they are \w wise| strong="H2450" \w* [to do evil]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8687”}, [but to do good]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8687”} [they have no knowledge]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 23 [I beheld]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the earth| strong="H776" \w*, and, lo, it was \w without form| strong="H8414" \w*, \w and void| strong="H922" \w*; \w and the heavens| strong="H8064" \w*, and they had \w no light| strong="H216" \w*. 
\v 24 [I beheld]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the mountains| strong="H2022" \w*, [and, lo, they trembled]{strong=“H7493” x-morph=“strongMorph: \sc Th\sc*8801”}, \w and all the hills| strong="H1389" \w* [moved lightly]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8701”}. 
\v 25 [I beheld]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”}, and, lo, there was \w no man| strong="H120" \w*, \w and all the birds| strong="H5775" \w* \w of the heavens| strong="H8064" \w* [were fled]{strong=“H5074” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 26 [I beheld]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”}, [and, lo, the fruitful place]{strong=“H3759”} was \w a wilderness| strong="H4057" \w*, \w and all the cities| strong="H5892" \w* [thereof were broken down]{strong=“H5422” x-morph=“strongMorph: \sc Th\sc*8738”} \w at the presence| strong="H6440" \w* of the \sc Lord\sc*, and \w by his fierce| strong="H2740" \w* \w anger| strong="H639" \w*. 
\v 27 For thus hath the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w The whole land| strong="H776" \w* \w shall be desolate| strong="H8077" \w*; [yet will I not make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w a full end| strong="H3617" \w*. 
\v 28 \w For this shall the earth| strong="H776" \w* [mourn]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the heavens| strong="H8064" \w* \w above| strong="H4605" \w* [be black]{strong=“H6937” x-morph=“strongMorph: \sc Th\sc*8804”}: [because I have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it, [I have purposed]{strong=“H2161” x-morph=“strongMorph: \sc Th\sc*8804”} it, [and will not repent]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8738”}, [neither will I turn back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} from it. 
\v 29 \w The whole city| strong="H5892" \w* [shall flee]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8802”} \w for the noise| strong="H6963" \w* \w of the horsemen| strong="H6571" \w* [and bowmen]{strong=“H7411 H7198” x-morph=“strongMorph: \sc Th\sc*8802”}; [they shall go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into thickets| strong="H5645" \w*, [and climb up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon the rocks| strong="H3710" \w*: \w every city| strong="H5892" \w* shall be [forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8803”}, \w and not a man| strong="H376" \w* [dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w therein| strong="H2004" \w*. 
\v 30 And when thou art [spoiled]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8803”}, [what wilt thou do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}? [Though thou clothest]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w thyself with crimson| strong="H8144" \w*, [though thou deckest]{strong=“H5710” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee with ornaments| strong="H5716" \w* \w of gold| strong="H2091" \w*, [though thou rentest]{strong=“H7167” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy face| strong="H5869" \w* \w with painting| strong="H6320" \w*, \w in vain| strong="H7723" \w* [shalt thou make thyself fair]{strong=“H3302” x-morph=“strongMorph: \sc Th\sc*8691”}; thy [lovers]{strong=“H5689” x-morph=“strongMorph: \sc Th\sc*8802”} [will despise]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, they will seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy life| strong="H5315" \w*.\f + \fr 4:30 \ft face: Heb. eyes \f* 
\v 31 [For I have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w a voice| strong="H6963" \w* [as of a woman in travail]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8802”}, and \w the anguish| strong="H6869" \w* [as of her that bringeth forth her first child]{strong=“H1069” x-morph=“strongMorph: \sc Th\sc*8688”}, \w the voice| strong="H6963" \w* \w of the daughter| strong="H1323" \w* \w of Zion| strong="H6726" \w*, that [bewaileth]{strong=“H3306” x-morph=“strongMorph: \sc Th\sc*8691”} herself, that [spreadeth]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8762”} \w her hands| strong="H3709" \w*, saying, \w Woe| strong="H188" \w* is [me now! for my soul]{strong=“H5315”} [is wearied]{strong=“H5888” x-morph=“strongMorph: \sc Th\sc*8804”} [because of murderers]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8802”}.
\c 5
\p 
\v 1 [Run ye to and fro]{strong=“H7751” x-morph=“strongMorph: \sc Th\sc*8786”} \w through the streets| strong="H2351" \w* \w of Jerusalem| strong="H3389" \w*, [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} [now, and know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”}, [and seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8761”} \w in the broad places| strong="H7339" \w* [thereof, if ye can find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w a man| strong="H376" \w*, \w if there be| strong="H3426" \w* any [that executeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w judgment| strong="H4941" \w*, [that seeketh]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w the truth| strong="H530" \w*; [and I will pardon]{strong=“H5545” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\v 2 [And though they say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, The \sc Lord\sc* \w liveth| strong="H2416" \w*; [surely they swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8735”} \w falsely| strong="H8267" \w*. 
\v 3 O \sc Lord\sc*, are \w not thine eyes| strong="H5869" \w* \w upon the truth| strong="H530" \w*? [thou hast stricken]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} [them, but they have not grieved]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8804”}; [thou hast consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8765”} them, but [they have refused]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8765”} [to receive]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} \w correction| strong="H4148" \w*: \w they have made their faces| strong="H6440" \w* [harder]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8765”} \w than a rock| strong="H5553" \w*; [they have refused]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8765”} [to return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 4 [Therefore I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, Surely these are \w poor| strong="H1800" \w*; [they are foolish]{strong=“H2973” x-morph=“strongMorph: \sc Th\sc*8738”}: [for they know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the way| strong="H1870" \w* of the \sc Lord\sc*, nor \w the judgment| strong="H4941" \w* \w of their God| strong="H430" \w*. 
\v 5 [I will get]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w me unto the great men| strong="H1419" \w*, [and will speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [unto them; for they have known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w the way| strong="H1870" \w* of the \sc Lord\sc*, and \w the judgment| strong="H4941" \w* \w of their God| strong="H430" \w*: \w but these have altogether| strong="H3162" \w* [broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8804”} \w the yoke| strong="H5923" \w*, and [burst]{strong=“H5423” x-morph=“strongMorph: \sc Th\sc*8765”} \w the bonds| strong="H4147" \w*. 
\v 6 \w Wherefore a lion| strong="H738" \w* \w out of the forest| strong="H3293" \w* [shall slay]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} them, and \w a wolf| strong="H2061" \w* \w of the evenings| strong="H6160" \w* [shall spoil]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8799”} [them, a leopard]{strong=“H5246”} [shall watch]{strong=“H8245” x-morph=“strongMorph: \sc Th\sc*8802”} \w over their cities| strong="H5892" \w*: [every one that goeth out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} \w thence shall| strong="H2007" \w* [be torn in pieces]{strong=“H2963” x-morph=“strongMorph: \sc Th\sc*8735”}: \w because their transgressions| strong="H6588" \w* [are many]{strong=“H7231” x-morph=“strongMorph: \sc Th\sc*8804”}, and \w their backslidings| strong="H4878" \w* [are increased]{strong=“H6105” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 5:6 \ft evenings: or, deserts \f* \f + \fr 5:6 \ft are increased: Heb. are strong \f* 
\p
\v 7 \w How| strong="H335" \w* [shall I pardon]{strong=“H5545” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee for this| strong="H2063" \w*? \w thy children| strong="H1121" \w* [have forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8735”} by them that are \w no| strong="H3808" \w* \w gods| strong="H430" \w*: [when I had fed them to the full]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8686”}, [they then committed adultery]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8799”}, [and assembled themselves by troops]{strong=“H1413” x-morph=“strongMorph: \sc Th\sc*8704”} [in the harlots’]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”} \w houses| strong="H1004" \w*. 
\v 8 They were as [fed]{strong=“H2109” x-morph=“strongMorph: \sc Th\sc*8716”} \w horses| strong="H5483" \w* [in the morning]{strong=“H7904” x-morph=“strongMorph: \sc Th\sc*8688”}: \w every one| strong="H376" \w* [neighed]{strong=“H6670” x-morph=“strongMorph: \sc Th\sc*8799”} [after his neighbour’s]{strong=“H7453”} \w wife| strong="H802" \w*. 
\v 9 [Shall I not visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} for these things? [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: \w and shall not my soul| strong="H5315" \w* [be avenged]{strong=“H5358” x-morph=“strongMorph: \sc Th\sc*8691”} \w on such a nation| strong="H1471" \w* as this? 
\p
\v 10 [Go ye up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”} \w upon her walls| strong="H8284" \w*, [and destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8761”}; [but make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w not a full end| strong="H3617" \w*: [take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8685”} \w her battlements| strong="H5189" \w*; for they are not the \sc Lord\sc*’S. 
\v 11 \w For the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* \w and the house| strong="H1004" \w* \w of Judah| strong="H3063" \w* [have dealt very]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8800”} [treacherously]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8804”} [against me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 12 [They have belied]{strong=“H3584” x-morph=“strongMorph: \sc Th\sc*8765”} the \sc Lord\sc*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, It is [not he; neither shall evil]{strong=“H7451”} [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [upon us; neither shall we see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w sword| strong="H2719" \w* \w nor famine| strong="H7458" \w*: 
\v 13 \w And the prophets| strong="H5030" \w* \w shall become wind| strong="H7307" \w*, [and the word]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} is [not in them: thus shall it be done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8735”} unto them. 
\v 14 [Wherefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w God| strong="H430" \w* \w of hosts| strong="H6635" \w*, [Because ye speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w this word| strong="H1697" \w*, [behold, I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w my words| strong="H1697" \w* \w in thy mouth| strong="H6310" \w* \w fire| strong="H784" \w*, \w and this people| strong="H5971" \w* \w wood| strong="H6086" \w*, [and it shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} them. 
\v 15 [Lo, I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w a nation| strong="H1471" \w* \w upon you from far| strong="H4801" \w*, \w O house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: it is \w a mighty| strong="H386" \w* \w nation| strong="H1471" \w*, it is \w an ancient| strong="H5769" \w* \w nation| strong="H1471" \w*, \w a nation| strong="H1471" \w* \w whose language| strong="H3956" \w* [thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [not, neither understandest]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [what they say]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 16 \w Their quiver| strong="H827" \w* is [as an open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8803”} \w sepulchre| strong="H6913" \w*, they are \w all mighty men| strong="H1368" \w*. 
\v 17 [And they shall eat up]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w thine harvest| strong="H7105" \w*, \w and thy bread| strong="H3899" \w*, which \w thy sons| strong="H1121" \w* \w and thy daughters| strong="H1323" \w* [should eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}: [they shall eat up]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy flocks| strong="H6629" \w* \w and thine herds| strong="H1241" \w*: [they shall eat up]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy vines| strong="H1612" \w* \w and thy fig trees| strong="H8384" \w*: [they shall impoverish]{strong=“H7567” x-morph=“strongMorph: \sc Th\sc*8779”} \w thy fenced| strong="H4013" \w* \w cities| strong="H5892" \w*, \w wherein thou| strong="H2007" \w* [trustedst]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”}, \w with the sword| strong="H2719" \w*. 
\v 18 \w Nevertheless in those days| strong="H3117" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [I will not make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w a full end| strong="H3617" \w* with you. 
\p
\v 19 [And it shall come to pass, when ye shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Wherefore]{strong=“H4100 H8478”} [doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w our God| strong="H430" \w* all these things [unto us? then shalt thou answer]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [them, Like as ye have forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and served]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} \w strange| strong="H5236" \w* \w gods| strong="H430" \w* \w in your land| strong="H776" \w*, [so shall ye serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} [strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} \w in a land| strong="H776" \w* that is not yours. 
\p
\v 20 [Declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”} \w this in the house| strong="H1004" \w* \w of Jacob| strong="H3290" \w*, [and publish]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8685”} \w it in Judah| strong="H3063" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 21 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [now this, O foolish]{strong=“H5530”} \w people| strong="H5971" \w*, \w and without understanding| strong="H3820" \w*; \w which have eyes| strong="H5869" \w*, [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [not; which have ears]{strong=“H241”}, [and hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} not:\f + \fr 5:21 \ft understanding: Heb. heart \f* 
\v 22 [Fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [ye not me? saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: [will ye not tremble]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8799”} \w at my presence| strong="H6440" \w*, [which have placed]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w the sand| strong="H2344" \w* for \w the bound| strong="H1366" \w* \w of the sea| strong="H3220" \w* \w by a perpetual| strong="H5769" \w* \w decree| strong="H2706" \w*, [that it cannot pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} [it: and though the waves]{strong=“H1530”} [thereof toss]{strong=“H1607” x-morph=“strongMorph: \sc Th\sc*8691”} [themselves, yet can they not prevail]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”}; [though they roar]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8804”}, [yet can they not pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} it? 
\v 23 \w But this people| strong="H5971" \w* [hath a revolting]{strong=“H5637” x-morph=“strongMorph: \sc Th\sc*8802”} [and a rebellious]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8802”} \w heart| strong="H3820" \w*; [they are revolted]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8804”} [and gone]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 24 [Neither say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w they in their heart| strong="H3824" \w*, [Let us now fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc* \w our God| strong="H430" \w*, [that giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w rain| strong="H1653" \w*, \w both the former| strong="H3138" \w* \w and the latter| strong="H4456" \w*, \w in his season| strong="H6256" \w*: [he reserveth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto us the appointed| strong="H2708" \w* \w weeks| strong="H7620" \w* \w of the harvest| strong="H7105" \w*. 
\p
\v 25 \w Your iniquities| strong="H5771" \w* [have turned away]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8689”} these things, \w and your sins| strong="H2403" \w* [have withholden]{strong=“H4513” x-morph=“strongMorph: \sc Th\sc*8804”} \w good| strong="H2896" \w* things from you. 
\v 26 \w For among my people| strong="H5971" \w* [are found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8738”} \w wicked| strong="H7563" \w* men: [they lay wait]{strong=“H7789” x-morph=“strongMorph: \sc Th\sc*8799”}, [as he that setteth]{strong=“H7918” x-morph=“strongMorph: \sc Th\sc*8800”} \w snares| strong="H3353" \w*; [they set]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8689”} \w a trap| strong="H4889" \w*, [they catch]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8799”} \w men| strong="H582" \w*.\f + \fr 5:26 \ft they lay…: or, they pry as fowlers lie in wait \f* 
\v 27 \w As a cage| strong="H3619" \w* \w is full| strong="H4392" \w* \w of birds| strong="H5775" \w*, so are \w their houses| strong="H1004" \w* \w full| strong="H4392" \w* \w of deceit| strong="H4820" \w*: [therefore they are become great]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8804”}, [and waxen rich]{strong=“H6238” x-morph=“strongMorph: \sc Th\sc*8686”}.\f + \fr 5:27 \ft cage: or, coop \f* 
\v 28 [They are waxen fat]{strong=“H8080” x-morph=“strongMorph: \sc Th\sc*8804”}, [they shine]{strong=“H6245” x-morph=“strongMorph: \sc Th\sc*8804”}: [yea, they overpass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w the deeds| strong="H1697" \w* \w of the wicked| strong="H7451" \w*: [they judge]{strong=“H1777” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the cause| strong="H1779" \w*, \w the cause of the fatherless| strong="H3490" \w*, [yet they prosper]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8686”}; \w and the right| strong="H4941" \w* \w of the needy| strong="H34" \w* [do they not judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 29 [Shall I not visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} for these things? [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: \w shall not my soul| strong="H5315" \w* [be avenged]{strong=“H5358” x-morph=“strongMorph: \sc Th\sc*8691”} \w on such a nation| strong="H1471" \w* as this? 
\p
\v 30 \w A wonderful| strong="H8047" \w* \w and horrible thing| strong="H8186" \w* [is committed]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the land| strong="H776" \w*;\f + \fr 5:30 \ft A wonderful…: or, Astonishment and filthiness \f* 
\v 31 \w The prophets| strong="H5030" \w* [prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8738”} \w falsely| strong="H8267" \w*, \w and the priests| strong="H3548" \w* [bear rule]{strong=“H7287” x-morph=“strongMorph: \sc Th\sc*8799”} \w by their means| strong="H3027" \w*; \w and my people| strong="H5971" \w* [love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} to have it [so: and what will ye do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the end| strong="H319" \w* thereof?\f + \fr 5:31 \ft bear…: or, take into their hands \f*
\c 6
\p 
\v 1 \w O ye children| strong="H1121" \w* \w of Benjamin| strong="H1144" \w*, [gather yourselves to flee]{strong=“H5756” x-morph=“strongMorph: \sc Th\sc*8685”} \w out of the midst| strong="H7130" \w* \w of Jerusalem| strong="H3389" \w*, [and blow]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8798”} \w the trumpet| strong="H7782" \w* \w in Tekoa| strong="H8620" \w*, [and set up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w a sign| strong="H4864" \w* [of fire in Beth-haccerem]{strong=“H1021”}: \w for evil| strong="H7451" \w* [appeareth]{strong=“H8259” x-morph=“strongMorph: \sc Th\sc*8738”} \w out of the north| strong="H6828" \w*, \w and great| strong="H1419" \w* \w destruction| strong="H7667" \w*. 
\v 2 [I have likened]{strong=“H1820” x-morph=“strongMorph: \sc Th\sc*8804”} \w the daughter| strong="H1323" \w* \w of Zion| strong="H6726" \w* \w to a comely| strong="H5116" \w* [and delicate]{strong=“H6026” x-morph=“strongMorph: \sc Th\sc*8794”} woman.\f + \fr 6:2 \ft comely: or, dwelling at home \f* 
\v 3 [The shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} \w with their flocks| strong="H5739" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [unto her; they shall pitch]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8804”} their \w tents| strong="H168" \w* \w against her round about| strong="H5439" \w*; [they shall feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8804”} \w every one| strong="H376" \w* \w in his place| strong="H3027" \w*. 
\v 4 [Prepare]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8761”} \w ye war| strong="H4421" \w* [against her; arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [and let us go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w at noon| strong="H6672" \w*. \w Woe| strong="H188" \w* [unto us! for the day]{strong=“H3117”} [goeth away]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8804”}, \w for the shadows| strong="H6752" \w* \w of the evening| strong="H6153" \w* [are stretched out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 5 [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [and let us go]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w by night| strong="H3915" \w*, [and let us destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8686”} \w her palaces| strong="H759" \w*. 
\p
\v 6 For thus hath the \sc Lord\sc* \w of hosts| strong="H6635" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Hew ye down]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8798”} \w trees| strong="H6097" \w*, [and cast]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8798”} \w a mount| strong="H5550" \w* \w against Jerusalem| strong="H3389" \w*: this is \w the city| strong="H5892" \w* [to be visited]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8717”}; she is \w wholly oppression| strong="H6233" \w* \w in the midst| strong="H7130" \w* of her.\f + \fr 6:6 \ft cast…: or, pour out the engine of shot \f* 
\v 7 \w As a fountain| strong="H953" \w* [casteth out]{strong=“H6979” x-morph=“strongMorph: \sc Th\sc*8687”} \w her waters| strong="H4325" \w*, [so she casteth out]{strong=“H6979” x-morph=“strongMorph: \sc Th\sc*8689”} \w her wickedness| strong="H7451" \w*: \w violence| strong="H2555" \w* \w and spoil| strong="H7701" \w* [is heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8735”} [in her; before me]{strong=“H6440”} \w continually| strong="H8548" \w* is \w grief| strong="H2483" \w* \w and wounds| strong="H4347" \w*. 
\v 8 [Be thou instructed]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8734”}, \w O Jerusalem| strong="H3389" \w*, \w lest my soul| strong="H5315" \w* [depart]{strong=“H3363” x-morph=“strongMorph: \sc Th\sc*8799”} [from thee; lest I make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee desolate| strong="H8077" \w*, \w a land| strong="H776" \w* [not inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8738”}.\f + \fr 6:8 \ft depart: Heb. be loosed, or, disjointed \f* 
\p
\v 9 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [They shall throughly]{strong=“H5953” x-morph=“strongMorph: \sc Th\sc*8780”} [glean]{strong=“H5953” x-morph=“strongMorph: \sc Th\sc*8779”} \w the remnant| strong="H7611" \w* \w of Israel| strong="H3478" \w* \w as a vine| strong="H1612" \w*: [turn back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”} \w thine hand| strong="H3027" \w* [as a grapegatherer]{strong=“H1219” x-morph=“strongMorph: \sc Th\sc*8802”} \w into the baskets| strong="H5552" \w*. 
\v 10 [To whom shall I speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}, [and give warning]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8686”}, [that they may hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}? [behold, their ear]{strong=“H241”} is \w uncircumcised| strong="H6189" \w*, [and they cannot]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [hearken]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8687”}: [behold, the word]{strong=“H1697”} of the \sc Lord\sc* \w is unto them a reproach| strong="H2781" \w*; [they have no delight]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8799”} in it. 
\v 11 \w Therefore I am full| strong="H4392" \w* \w of the fury| strong="H2534" \w* of the \sc Lord\sc*; [I am weary]{strong=“H3811” x-morph=“strongMorph: \sc Th\sc*8738”} [with holding in]{strong=“H3557” x-morph=“strongMorph: \sc Th\sc*8687”}: [I will pour it out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8800”} \w upon the children| strong="H5768" \w* \w abroad| strong="H2351" \w*, \w and upon the assembly| strong="H5475" \w* \w of young men| strong="H970" \w* \w together| strong="H3162" \w*: \w for even the husband| strong="H376" \w* \w with the wife| strong="H802" \w* [shall be taken]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8735”}, \w the aged| strong="H2205" \w* with him that is [full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of days| strong="H3117" \w*. 
\v 12 \w And their houses| strong="H1004" \w* [shall be turned]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto others| strong="H312" \w*, with their \w fields| strong="H7704" \w* \w and wives| strong="H802" \w* \w together| strong="H3162" \w*: [for I will stretch out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w my hand| strong="H3027" \w* [upon the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the land| strong="H776" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 13 \w For from the least| strong="H6996" \w* \w of them even unto the greatest| strong="H1419" \w* of them every one is [given]{strong=“H1214” x-morph=“strongMorph: \sc Th\sc*8802”} \w to covetousness| strong="H1215" \w*; \w and from the prophet| strong="H5030" \w* \w even unto the priest| strong="H3548" \w* [every one dealeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w falsely| strong="H8267" \w*. 
\v 14 [They have healed]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8762”} \w also the hurt| strong="H7667" \w* of the daughter \w of my people| strong="H5971" \w* [slightly]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8738”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Peace| strong="H7965" \w*, \w peace| strong="H7965" \w*; when there is \w no peace| strong="H7965" \w*.\f + \fr 6:14 \ft hurt: Heb. bruise, or, breach \f* 
\v 15 [Were they ashamed]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”} [when they had committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w abomination| strong="H8441" \w*? \w nay| strong="H1571" \w*, [they were not at all]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8800”} [ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}, \w neither| strong="H1571" \w* [could]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [they blush]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8687”}: [therefore they shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} [among them that fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8802”}: \w at the time| strong="H6256" \w* that [I visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} [them they shall be cast down]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8735”}, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*. 
\v 16 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [Stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye in the ways| strong="H1870" \w*, [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, [and ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8798”} \w for the old| strong="H5769" \w* \w paths| strong="H5410" \w*, where is \w the good| strong="H2896" \w* \w way| strong="H1870" \w*, [and walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [therein, and ye shall find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8798”} \w rest| strong="H4771" \w* \w for your souls| strong="H5315" \w*. [But they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [We will not walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} therein. 
\v 17 [Also I set]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} [watchmen]{strong=“H6822” x-morph=“strongMorph: \sc Th\sc*8802”} over you, saying, [Hearken]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8685”} \w to the sound| strong="H6963" \w* \w of the trumpet| strong="H7782" \w*. [But they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [We will not hearken]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\p
\v 18 [Therefore hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, \w ye nations| strong="H1471" \w*, [and know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O congregation| strong="H5712" \w*, what is among them. 
\v 19 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O earth| strong="H776" \w*: [behold, I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w evil| strong="H7451" \w* \w upon this people| strong="H5971" \w*, even \w the fruit| strong="H6529" \w* \w of their thoughts| strong="H4284" \w*, [because they have not hearkened]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8689”} \w unto my words| strong="H1697" \w*, \w nor to my law| strong="H8451" \w*, [but rejected]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\v 20 [To what purpose cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w there to me incense| strong="H3828" \w* \w from Sheba| strong="H7614" \w*, \w and the sweet| strong="H2896" \w* \w cane| strong="H7070" \w* \w from a far| strong="H4801" \w* \w country| strong="H776" \w*? \w your burnt offerings| strong="H5930" \w* are \w not acceptable| strong="H7522" \w*, \w nor your sacrifices| strong="H2077" \w* [sweet]{strong=“H6149” x-morph=“strongMorph: \sc Th\sc*8804”} unto me. 
\v 21 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [Behold, I will lay]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w stumblingblocks| strong="H4383" \w* \w before this people| strong="H5971" \w*, \w and the fathers| strong="H1" \w* \w and the sons| strong="H1121" \w* \w together| strong="H3162" \w* [shall fall]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8804”} [upon them; the neighbour]{strong=“H7934”} \w and his friend| strong="H7453" \w* [shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 22 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [Behold, a people]{strong=“H5971”} [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w from the north| strong="H6828" \w* \w country| strong="H776" \w*, \w and a great| strong="H1419" \w* \w nation| strong="H1471" \w* [shall be raised]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8735”} \w from the sides| strong="H3411" \w* \w of the earth| strong="H776" \w*. 
\v 23 [They shall lay hold]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8686”} \w on bow| strong="H7198" \w* \w and spear| strong="H3591" \w*; they are \w cruel| strong="H394" \w*, [and have no mercy]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8762”}; \w their voice| strong="H6963" \w* [roareth ]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8799”} \w like the sea| strong="H3220" \w*; [and they ride]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon horses| strong="H5483" \w*, [set in array]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8803”} \w as men| strong="H376" \w* \w for war| strong="H4421" \w* [against thee, O daughter]{strong=“H1323”} \w of Zion| strong="H6726" \w*. 
\v 24 [We have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the fame| strong="H8089" \w* [thereof: our hands]{strong=“H3027”} [wax feeble]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8804”}: \w anguish| strong="H6869" \w* [hath taken hold]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8689”} of us, and \w pain| strong="H2427" \w*, [as of a woman in travail]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 25 [Go not forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the field| strong="H7704" \w*, [nor walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the way| strong="H1870" \w*; \w for the sword| strong="H2719" \w* [of the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} and \w fear| strong="H4032" \w* is \w on every side| strong="H5439" \w*. 
\p
\v 26 \w O daughter| strong="H1323" \w* \w of my people| strong="H5971" \w*, [gird]{strong=“H2296” x-morph=“strongMorph: \sc Th\sc*8798”} thee \w with sackcloth| strong="H8242" \w*, [and wallow]{strong=“H6428” x-morph=“strongMorph: \sc Th\sc*8690”} \w thyself in ashes| strong="H665" \w*: [make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee mourning| strong="H60" \w*, as for \w an only son| strong="H3173" \w*, \w most bitter| strong="H8563" \w* \w lamentation| strong="H4553" \w*: [for the spoiler]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8802”} \w shall suddenly| strong="H6597" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} upon us. 
\v 27 [I have set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} thee for \w a tower| strong="H969" \w* and \w a fortress| strong="H4013" \w* \w among my people| strong="H5971" \w*, [that thou mayest know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [and try]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8804”} \w their way| strong="H1870" \w*. 
\v 28 They are [all grievous]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8802”} [revolters]{strong=“H5637” x-morph=“strongMorph: \sc Th\sc*8802”}, [walking]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w with slanders| strong="H7400" \w*: they are \w brass| strong="H5178" \w* \w and iron| strong="H1270" \w*; they are [all corrupters]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 29 \w The bellows| strong="H4647" \w* [are burned]{strong=“H2787” x-morph=“strongMorph: \sc Th\sc*8738”}, \w the lead| strong="H5777" \w* [is consumed]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8804”} [of the fire]{strong=“H784 H800”}; [the founder]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8800”} [melteth]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8804”} \w in vain| strong="H7723" \w*: \w for the wicked| strong="H7451" \w* [are not plucked away]{strong=“H5423” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 30 [Reprobate]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8737”} \w silver| strong="H3701" \w* shall men [call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} them, because the \sc Lord\sc* [hath rejected]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} them.\f + \fr 6:30 \ft Reprobate…: or, Refuse silver \f*
\c 7
\p 
\v 1 \w The word| strong="H1697" \w* \w that came to Jeremiah| strong="H3414" \w* from the \sc Lord\sc*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8798”} \w in the gate| strong="H8179" \w* of the \sc Lord\sc*’S \w house| strong="H1004" \w*, [and proclaim]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w there this word| strong="H1697" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* of the \sc Lord\sc*, all ye of \w Judah| strong="H3063" \w*, [that enter in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w at these gates| strong="H8179" \w* [to worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8692”} the \sc Lord\sc*. 
\v 3 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*, [Amend]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8685”} \w your ways| strong="H1870" \w* \w and your doings| strong="H4611" \w*, [and I will cause you to dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8762”} \w in this place| strong="H4725" \w*. 
\v 4 [Trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} \w ye not in lying| strong="H8267" \w* \w words| strong="H1697" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w The temple| strong="H1964" \w* of the \sc Lord\sc*, \w The temple| strong="H1964" \w* of the \sc Lord\sc*, \w The temple| strong="H1964" \w* of the \sc Lord\sc*, are these. 
\v 5 [For if ye throughly]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8687”} [amend]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8686”} \w your ways| strong="H1870" \w* \w and your doings| strong="H4611" \w*; [if ye throughly]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [execute]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w judgment| strong="H4941" \w* \w between a man| strong="H376" \w* \w and his neighbour| strong="H7453" \w*; 
\v 6 If [ye oppress]{strong=“H6231” x-morph=“strongMorph: \sc Th\sc*8799”} \w not the stranger| strong="H1616" \w*, \w the fatherless| strong="H3490" \w*, \w and the widow| strong="H490" \w*, [and shed]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8799”} \w not innocent| strong="H5355" \w* \w blood| strong="H1818" \w* \w in this place| strong="H4725" \w*, [neither walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w other| strong="H312" \w* \w gods| strong="H430" \w* \w to your hurt| strong="H7451" \w*: 
\v 7 [Then will I cause you to dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8765”} \w in this place| strong="H4725" \w*, \w in the land| strong="H776" \w* [that I gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w to your fathers| strong="H1" \w*, \w for| strong="H5704" \w* \w ever| strong="H5769" \w* \w and ever| strong="H5769" \w*. 
\p
\v 8 [Behold, ye trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”} \w in lying| strong="H8267" \w* \w words| strong="H1697" \w*, [that cannot profit]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8687”}. 
\v 9 [Will ye steal]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8800”}, [murder]{strong=“H7523” x-morph=“strongMorph: \sc Th\sc*8800”}, [and commit adultery]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8800”}, [and swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8736”} \w falsely| strong="H8267" \w*, [and burn incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8763”} \w unto Baal| strong="H1168" \w*, [and walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”} \w after| strong="H310" \w* \w other| strong="H312" \w* \w gods| strong="H430" \w* [whom ye know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} not; 
\v 10 [And come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [and stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* \w me in this house| strong="H1004" \w*, [which is called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8738”} \w by my name| strong="H8034" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [We are delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8738”} [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w all these abominations| strong="H8441" \w*?\f + \fr 7:10 \ft which…: Heb. whereupon my name is called \f* 
\v 11 \w Is this house| strong="H1004" \w*, [which is called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8738”} \w by my name| strong="H8034" \w*, \w become a den| strong="H4631" \w* \w of robbers| strong="H6530" \w* \w in your eyes| strong="H5869" \w*? [Behold, even I have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} it, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 12 [But go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye now unto my place| strong="H4725" \w* which was \w in Shiloh| strong="H7887" \w*, [where I set]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8765”} \w my name| strong="H8034" \w* \w at the first| strong="H7223" \w*, [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} [what I did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w to it for| strong="H6440" \w* \w the wickedness| strong="H7451" \w* \w of my people| strong="H5971" \w* \w Israel| strong="H3478" \w*. 
\v 13 [And now, because ye have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w all these works| strong="H4639" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [and I spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [unto you, rising up early]{strong=“H7925” x-morph=“strongMorph: \sc Th\sc*8687”} [and speaking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”}, [but ye heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [not; and I called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} [you, but ye answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”} not; 
\v 14 [Therefore will I do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} unto this \w house| strong="H1004" \w*, [which is called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8738”} \w by my name| strong="H8034" \w*, [wherein ye trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and unto the place| strong="H4725" \w* [which I gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w to you and to your fathers| strong="H1" \w*, [as I have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w to Shiloh| strong="H7887" \w*. 
\v 15 [And I will cast you out]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8689”} \w of my sight| strong="H6440" \w*, [as I have cast out]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8689”} \w all your brethren| strong="H251" \w*, even \w the whole seed| strong="H2233" \w* \w of Ephraim| strong="H669" \w*. 
\p
\v 16 [Therefore pray]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8691”} \w not thou for this people| strong="H5971" \w*, [neither lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w cry| strong="H7440" \w* \w nor prayer| strong="H8605" \w* \w for them| strong="H1157" \w*, [neither make intercession]{strong=“H6293” x-morph=“strongMorph: \sc Th\sc*8799”} [to me: for I will not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} thee. 
\p
\v 17 [Seest]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} [thou not what they do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the cities| strong="H5892" \w* \w of Judah| strong="H3063" \w* \w and in the streets| strong="H2351" \w* \w of Jerusalem| strong="H3389" \w*? 
\v 18 \w The children| strong="H1121" \w* [gather]{strong=“H3950” x-morph=“strongMorph: \sc Th\sc*8764”} \w wood| strong="H6086" \w*, \w and the fathers| strong="H1" \w* [kindle]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8764”} \w the fire| strong="H784" \w*, \w and the women| strong="H802" \w* [knead]{strong=“H3888” x-morph=“strongMorph: \sc Th\sc*8802”} their \w dough| strong="H1217" \w*, [to make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w cakes| strong="H3561" \w* \w to the queen| strong="H4446" \w* \w of heaven| strong="H8064" \w*, [and to pour out]{strong=“H5258” x-morph=“strongMorph: \sc Th\sc*8687”} \w drink offerings| strong="H5262" \w* \w unto other| strong="H312" \w* \w gods| strong="H430" \w*, [that they may provoke me to anger]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8687”}.\f + \fr 7:18 \ft queen…: or, frame, or, workmanship of heaven \f* 
\v 19 [Do they provoke me to anger]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8688”}? [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: do they not provoke \w themselves to the confusion| strong="H1322" \w* \w of their own faces| strong="H6440" \w*? 
\v 20 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Behold, mine anger]{strong=“H639”} \w and my fury| strong="H2534" \w* [shall be poured out]{strong=“H5413” x-morph=“strongMorph: \sc Th\sc*8737”} \w upon this place| strong="H4725" \w*, \w upon man| strong="H120" \w*, \w and upon beast| strong="H929" \w*, \w and upon the trees| strong="H6086" \w* \w of the field| strong="H7704" \w*, \w and upon the fruit| strong="H6529" \w* \w of the ground| strong="H127" \w*; [and it shall burn]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8804”}, [and shall not be quenched]{strong=“H3518” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 21 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*; [Put]{strong=“H5595” x-morph=“strongMorph: \sc Th\sc*8798”} \w your burnt offerings| strong="H5930" \w* \w unto your sacrifices| strong="H2077" \w*, [and eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8798”} \w flesh| strong="H1320" \w*. 
\v 22 [For I spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w not unto your fathers| strong="H1" \w*, [nor commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w them in the day| strong="H3117" \w* [that I brought them out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8687”} \w of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, \w concerning| strong="H1697" \w* \w burnt offerings| strong="H5930" \w* \w or sacrifices| strong="H2077" \w*:\f + \fr 7:22 \ft concerning: Heb. concerning the matter of \f* 
\v 23 \w But this thing| strong="H1697" \w* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [I them, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w my voice| strong="H6963" \w*, \w and I will be your God| strong="H430" \w*, \w and ye shall be my people| strong="H5971" \w*: [and walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w ye in all the ways| strong="H1870" \w* [that I have commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} [you, that it may be well]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8799”} unto you. 
\v 24 [But they hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [not, nor inclined]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8689”} \w their ear| strong="H241" \w*, [but walked]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the counsels| strong="H4156" \w* and \w in the imagination| strong="H8307" \w* \w of their evil| strong="H7451" \w* \w heart| strong="H3820" \w*, \w and went backward| strong="H268" \w*, \w and not forward| strong="H6440" \w*.\f + \fr 7:24 \ft imagination: or, stubbornness \f* \f + \fr 7:24 \ft went: Heb. were \f* 
\v 25 \w Since the day| strong="H3117" \w* \w that your fathers| strong="H1" \w* [came forth out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* \w unto this day| strong="H3117" \w* [I have even sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto you all my servants| strong="H5650" \w* \w the prophets| strong="H5030" \w*, \w daily| strong="H3117" \w* [rising up early]{strong=“H7925” x-morph=“strongMorph: \sc Th\sc*8687”} [and sending]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8800”} them: 
\v 26 [Yet they hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [not unto me, nor inclined]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8689”} \w their ear| strong="H241" \w*, [but hardened]{strong=“H7185” x-morph=“strongMorph: \sc Th\sc*8686”} \w their neck| strong="H6203" \w*: [they did worse]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8689”} \w than their fathers| strong="H1" \w*. 
\v 27 [Therefore thou shalt speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w all these words| strong="H1697" \w* [unto them; but they will not hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [to thee: thou shalt also call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them; but they will not answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} thee. 
\v 28 [But thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} unto them, This is \w a nation| strong="H1471" \w* [that obeyeth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the voice| strong="H6963" \w* of the \sc Lord\sc* \w their God| strong="H430" \w*, [nor receiveth]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w correction| strong="H4148" \w*: \w truth| strong="H530" \w* [is perished]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”}, [and is cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8738”} \w from their mouth| strong="H6310" \w*.\f + \fr 7:28 \ft correction: or, instruction \f* 
\p
\v 29 [Cut off]{strong=“H1494” x-morph=“strongMorph: \sc Th\sc*8798”} \w thine hair| strong="H5145" \w*, O Jerusalem, and cast it [away]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8685”}, [and take up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w a lamentation| strong="H7015" \w* \w on high places| strong="H8205" \w*; for the \sc Lord\sc* [hath rejected]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} [and forsaken]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8799”} \w the generation| strong="H1755" \w* \w of his wrath| strong="H5678" \w*. 
\v 30 \w For the children| strong="H1121" \w* \w of Judah| strong="H3063" \w* [have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w evil| strong="H7451" \w* \w in my sight| strong="H5869" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: [they have set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w their abominations| strong="H8251" \w* \w in the house| strong="H1004" \w* [which is called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8738”} \w by my name| strong="H8034" \w*, [to pollute]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8763”} it. 
\v 31 [And they have built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w the high places| strong="H1116" \w* \w of Tophet| strong="H8612" \w*, which is \w in the valley| strong="H1516" \w* \w of the son| strong="H1121" \w* \w of Hinnom| strong="H2011" \w*, [to burn]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8800”} \w their sons| strong="H1121" \w* \w and their daughters| strong="H1323" \w* \w in the fire| strong="H784" \w*; [which I commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} them [not, neither came]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w it into my heart| strong="H3820" \w*.\f + \fr 7:31 \ft came…: Heb. came it upon my heart \f* 
\p
\v 32 [Therefore, behold, the days]{strong=“H3117”} [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [that it shall no more be called]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8735”} \w Tophet| strong="H8612" \w*, \w nor the valley| strong="H1516" \w* \w of the son| strong="H1121" \w* \w of Hinnom| strong="H2011" \w*, \w but the valley| strong="H1516" \w* \w of slaughter| strong="H2028" \w*: [for they shall bury]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8804”} \w in Tophet| strong="H8612" \w*, \w till there be no| strong="H369" \w* \w place| strong="H4725" \w*. 
\v 33 \w And the carcases| strong="H5038" \w* \w of this people| strong="H5971" \w* \w shall be meat| strong="H3978" \w* \w for the fowls| strong="H5775" \w* \w of the heaven| strong="H8064" \w*, \w and for the beasts| strong="H929" \w* \w of the earth| strong="H776" \w*; and none shall fray them [away]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 34 [Then will I cause to cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8689”} \w from the cities| strong="H5892" \w* \w of Judah| strong="H3063" \w*, \w and from the streets| strong="H2351" \w* \w of Jerusalem| strong="H3389" \w*, \w the voice| strong="H6963" \w* \w of mirth| strong="H8342" \w*, \w and the voice| strong="H6963" \w* \w of gladness| strong="H8057" \w*, \w the voice| strong="H6963" \w* \w of the bridegroom| strong="H2860" \w*, \w and the voice| strong="H6963" \w* \w of the bride| strong="H3618" \w*: \w for the land| strong="H776" \w* \w shall be desolate| strong="H2723" \w*. 
\c 8
\p 
\v 1 \w At that time| strong="H6256" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [they shall bring out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w the bones| strong="H6106" \w* \w of the kings| strong="H4428" \w* \w of Judah| strong="H3063" \w*, \w and the bones| strong="H6106" \w* \w of his princes| strong="H8269" \w*, \w and the bones| strong="H6106" \w* \w of the priests| strong="H3548" \w*, \w and the bones| strong="H6106" \w* \w of the prophets| strong="H5030" \w*, \w and the bones| strong="H6106" \w* [of the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w*, \w out of their graves| strong="H6913" \w*: 
\v 2 [And they shall spread]{strong=“H7849” x-morph=“strongMorph: \sc Th\sc*8804”} \w them before the sun| strong="H8121" \w*, \w and the moon| strong="H3394" \w*, \w and all the host| strong="H6635" \w* \w of heaven| strong="H8064" \w*, [whom they have loved]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”}, [and whom they have served]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and after| strong="H310" \w* [whom they have walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”}, [and whom they have sought]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8804”}, [and whom they have worshipped]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8694”}: [they shall not be gathered]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8735”}, [nor be buried]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8735”}; \w they shall be for dung| strong="H1828" \w* \w upon the face| strong="H6440" \w* \w of the earth| strong="H127" \w*. 
\v 3 \w And death| strong="H4194" \w* [shall be chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8738”} \w rather than life| strong="H2416" \w* \w by all the residue| strong="H7611" \w* [of them that remain]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”} \w of this evil| strong="H7451" \w* \w family| strong="H4940" \w*, [which remain]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”} \w in all the places| strong="H4725" \w* [whither I have driven]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8689”} [them, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*. 
\p
\v 4 [Moreover thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Shall they fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”}, [and not arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}? [shall he turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [and not return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}? 
\v 5 Why then \w is this people| strong="H5971" \w* \w of Jerusalem| strong="H3389" \w* [slidden back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8790”} [by a perpetual]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8737”} \w backsliding| strong="H4878" \w*? [they hold]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8689”} \w fast deceit| strong="H8649" \w*, [they refuse]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8765”} [to return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 6 [I hearkened]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8689”} [and heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}, but [they spake not aright]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}: \w no man| strong="H376" \w* [repented]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8737”} \w him of| strong="H5921" \w* \w his wickedness| strong="H7451" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [What have I done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}? [every one turned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w to his course| strong="H4794" \w*, \w as the horse| strong="H5483" \w* [rusheth]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8802”} \w into the battle| strong="H4421" \w*. 
\v 7 [Yea, the stork]{strong=“H2624”} \w in the heaven| strong="H8064" \w* [knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w her appointed times| strong="H4150" \w*; \w and the turtle| strong="H8449" \w* \w and the crane| strong="H5483" \w* \w and the swallow| strong="H5693" \w* [observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w the time| strong="H6256" \w* [of their coming]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}; \w but my people| strong="H5971" \w* [know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the judgment| strong="H4941" \w* of the \sc Lord\sc*. 
\v 8 [How do ye say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, We are \w wise| strong="H2450" \w*, \w and the law| strong="H8451" \w* of the \sc Lord\sc* is [with us? Lo, certainly]{strong=“H403”} \w in vain| strong="H8267" \w* [made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} he it; \w the pen| strong="H5842" \w* [of the scribes]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8802”} is \w in vain| strong="H8267" \w*.\f + \fr 8:8 \ft in vain made…: or, the false pen of the scribes worketh for falsehood \f* 
\v 9 \w The wise| strong="H2450" \w* men [are ashamed]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”}, [they are dismayed]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8804”} [and taken]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8735”}: [lo, they have rejected]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} \w the word| strong="H1697" \w* of the \sc Lord\sc*; \w and what wisdom| strong="H2451" \w* is in them?\f + \fr 8:9 \ft The wise…: or, Have they been ashamed, etc \f* \f + \fr 8:9 \ft what…: Heb. the wisdom of what thing \f* 
\v 10 [Therefore will I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w their wives| strong="H802" \w* \w unto others| strong="H312" \w*, and \w their fields| strong="H7704" \w* [to them that shall inherit]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8802”} them: \w for every one from the least| strong="H6996" \w* \w even unto the greatest| strong="H1419" \w* [is given]{strong=“H1214” x-morph=“strongMorph: \sc Th\sc*8802”} \w to covetousness| strong="H1215" \w*, \w from the prophet| strong="H5030" \w* \w even unto the priest| strong="H3548" \w* [every one dealeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w falsely| strong="H8267" \w*. 
\v 11 [For they have healed]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8762”} \w the hurt| strong="H7667" \w* \w of the daughter| strong="H1323" \w* \w of my people| strong="H5971" \w* [slightly]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8738”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Peace| strong="H7965" \w*, \w peace| strong="H7965" \w*; when there is \w no peace| strong="H7965" \w*. 
\v 12 [Were they ashamed]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”} [when they had committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w abomination| strong="H8441" \w*? [nay, they were not at all]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8800”} [ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}, [neither could]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [they blush]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8736”}: [therefore shall they fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} [among them that fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8802”}: \w in the time| strong="H6256" \w* \w of their visitation| strong="H6486" \w* [they shall be cast down]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8735”}, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*.\f + \fr 8:12 \ft I will…: or, In gathering I will consume \f* 
\p
\v 13 [I will surely]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8800”} [consume]{strong=“H5486” x-morph=“strongMorph: \sc Th\sc*8686”} [them, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: there shall be \w no grapes| strong="H6025" \w* \w on the vine| strong="H1612" \w*, \w nor figs| strong="H8384" \w* \w on the fig tree| strong="H8384" \w*, \w and the leaf| strong="H5929" \w* [shall fade]{strong=“H5034” x-morph=“strongMorph: \sc Th\sc*8804”}; and the things that [I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [them shall pass away]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} from them. 
\v 14 [Why do we sit still]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”}? [assemble]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8734”} [yourselves, and let us enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the defenced| strong="H4013" \w* \w cities| strong="H5892" \w*, [and let us be silent]{strong=“H1826” x-morph=“strongMorph: \sc Th\sc*8735”} there: for the \sc Lord\sc* \w our God| strong="H430" \w* [hath put us to silence]{strong=“H1826” x-morph=“strongMorph: \sc Th\sc*8689”}, \w and given us water| strong="H4325" \w* \w of gall| strong="H7219" \w* [to drink]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8686”}, [because we have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} against the \sc Lord\sc*.\f + \fr 8:14 \ft gall: or, poison \f* 
\v 15 [We looked]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8763”} \w for peace| strong="H7965" \w*, \w but no good| strong="H2896" \w* came; and \w for a time| strong="H6256" \w* \w of health| strong="H4832" \w*, \w and behold trouble| strong="H1205" \w*! 
\v 16 \w The snorting| strong="H5170" \w* \w of his horses| strong="H5483" \w* [was heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8738”} \w from Dan| strong="H1835" \w*: \w the whole land| strong="H776" \w* [trembled]{strong=“H7493” x-morph=“strongMorph: \sc Th\sc*8804”} \w at the sound| strong="H6963" \w* \w of the neighing| strong="H4684" \w* \w of his strong ones| strong="H47" \w*; [for they are come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [and have devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the land| strong="H776" \w*, \w and all| strong="H4393" \w* [that is in it; the city]{strong=“H5892”}, [and those that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} therein.\f + \fr 8:16 \ft all…: Heb. the fulness thereof \f* 
\v 17 [For, behold, I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8764”} \w serpents| strong="H5175" \w*, \w cockatrices| strong="H6848" \w*, among you, which will not be \w charmed| strong="H3908" \w*, [and they shall bite]{strong=“H5391” x-morph=“strongMorph: \sc Th\sc*8765”} [you, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\p
\v 18 When \w I would comfort| strong="H4010" \w* \w myself against sorrow| strong="H3015" \w*, \w my heart| strong="H3820" \w* is \w faint| strong="H1742" \w* in me.\f + \fr 8:18 \ft in: Heb. upon \f* 
\v 19 \w Behold the voice| strong="H6963" \w* \w of the cry| strong="H7775" \w* \w of the daughter| strong="H1323" \w* \w of my people| strong="H5971" \w* \w because of them that dwell in a far| strong="H4801" \w* \w country| strong="H776" \w*: Is not the \sc Lord\sc* \w in Zion| strong="H6726" \w*? is \w not her king| strong="H4428" \w* [in her? Why have they provoked me to anger]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8689”} \w with their graven images| strong="H6456" \w*, and \w with strange| strong="H5236" \w* \w vanities| strong="H1892" \w*?\f + \fr 8:19 \ft them…: Heb. the country of them that are far off \f* 
\v 20 \w The harvest| strong="H7105" \w* [is past]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the summer| strong="H7019" \w* [is ended]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”}, [and we are not saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 21 \w For the hurt| strong="H7667" \w* \w of the daughter| strong="H1323" \w* \w of my people| strong="H5971" \w* [am I hurt]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8717”}; [I am black]{strong=“H6937” x-morph=“strongMorph: \sc Th\sc*8804”}; \w astonishment| strong="H8047" \w* [hath taken hold]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8689”} on me. 
\v 22 Is there \w no balm| strong="H6875" \w* \w in Gilead| strong="H1568" \w*; is there [no physician]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8802”} [there? why then]{strong=“H3588”} \w is not the health| strong="H724" \w* \w of the daughter| strong="H1323" \w* \w of my people| strong="H5971" \w* [recovered]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”}?\f + \fr 8:22 \ft recovered: Heb. gone up? \f*
\c 9
\p 
\v 1 [Oh that]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w my head| strong="H7218" \w* \w were waters| strong="H4325" \w*, \w and mine eyes| strong="H5869" \w* \w a fountain| strong="H4726" \w* \w of tears| strong="H1832" \w*, [that I might weep]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8799”} \w day| strong="H3119" \w* \w and night| strong="H3915" \w* \w for the slain| strong="H2491" \w* \w of the daughter| strong="H1323" \w* \w of my people| strong="H5971" \w*!\f + \fr 9:1 \ft Oh…: Heb. Who will give my head, etc \f* 
\v 2 [Oh that]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w I had in the wilderness| strong="H4057" \w* \w a lodging place| strong="H4411" \w* [of wayfaring men]{strong=“H732” x-morph=“strongMorph: \sc Th\sc*8802”}; [that I might leave]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w my people| strong="H5971" \w*, [and go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} from them! for they be [all adulterers]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8764”}, \w an assembly| strong="H6116" \w* [of treacherous men]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 3 [And they bend]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8686”} \w their tongues| strong="H3956" \w* like \w their bow| strong="H7198" \w* for \w lies| strong="H8267" \w*: [but they are not valiant]{strong=“H1396” x-morph=“strongMorph: \sc Th\sc*8804”} \w for the truth| strong="H530" \w* \w upon the earth| strong="H776" \w*; [for they proceed]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w from evil| strong="H7451" \w* \w to evil| strong="H7451" \w*, [and they know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [not me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 4 [Take ye heed]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8734”} \w every one| strong="H376" \w* \w of his neighbour| strong="H7453" \w*, [and trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} \w ye not in any brother| strong="H251" \w*: \w for every brother| strong="H251" \w* [will utterly]{strong=“H6117” x-morph=“strongMorph: \sc Th\sc*8800”} [supplant]{strong=“H6117” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and every neighbour| strong="H7453" \w* [will walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8799”} \w with slanders| strong="H7400" \w*.\f + \fr 9:4 \ft neighbour: or, friend \f* 
\v 5 [And they will deceive]{strong=“H2048” x-morph=“strongMorph: \sc Th\sc*8762”} \w every one| strong="H376" \w* \w his neighbour| strong="H7453" \w*, [and will not speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w the truth| strong="H571" \w*: [they have taught]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8765”} \w their tongue| strong="H3956" \w* [to speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w lies| strong="H8267" \w*, and [weary]{strong=“H3811” x-morph=“strongMorph: \sc Th\sc*8738”} [themselves to commit iniquity]{strong=“H5753” x-morph=“strongMorph: \sc Th\sc*8687”}.\f + \fr 9:5 \ft deceive: or, mock \f* 
\v 6 [Thine habitation]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} is \w in the midst| strong="H8432" \w* \w of deceit| strong="H4820" \w*; \w through deceit| strong="H4820" \w* [they refuse]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8765”} [to know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} [me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 7 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [Behold, I will melt]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8802”} [them, and try]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8804”} [them; for how shall I do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w for| strong="H6440" \w* \w the daughter| strong="H1323" \w* \w of my people| strong="H5971" \w*? 
\v 8 \w Their tongue| strong="H3956" \w* is as \w an arrow| strong="H2671" \w* [shot out]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8803”}; [it speaketh]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w deceit| strong="H4820" \w*: one [speaketh]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w peaceably| strong="H7965" \w* \w to his neighbour| strong="H7453" \w* \w with his mouth| strong="H6310" \w*, \w but in heart| strong="H7130" \w* [he layeth]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w his wait| strong="H696" \w*.\f + \fr 9:8 \ft in heart: Heb. in the midst of him \f* \f + \fr 9:8 \ft his wait: or, wait for him \f* 
\p
\v 9 [Shall I not visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} them for these things? [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: \w shall not my soul| strong="H5315" \w* [be avenged]{strong=“H5358” x-morph=“strongMorph: \sc Th\sc*8691”} \w on such a nation| strong="H1471" \w* as this? 
\v 10 \w For the mountains| strong="H2022" \w* [will I take up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w a weeping| strong="H1065" \w* \w and wailing| strong="H5092" \w*, \w and for the habitations| strong="H4999" \w* \w of the wilderness| strong="H4057" \w* \w a lamentation| strong="H7015" \w*, [because they are burned up]{strong=“H3341” x-morph=“strongMorph: \sc Th\sc*8738”}, \w so that none| strong="H376" \w* [can pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} through them; neither can men [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the voice| strong="H6963" \w* \w of the cattle| strong="H4735" \w*; \w both the fowl| strong="H5775" \w* \w of the heavens| strong="H8064" \w* \w and the beast| strong="H929" \w* [are fled]{strong=“H5074” x-morph=“strongMorph: \sc Th\sc*8804”}; [they are gone]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 9:10 \ft habitations: or, pastures \f* \f + \fr 9:10 \ft burned up: or, desolate \f* \f + \fr 9:10 \ft both…: Heb. from the fowl even to, etc \f* 
\v 11 [And I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w Jerusalem| strong="H3389" \w* \w heaps| strong="H1530" \w*, and \w a den| strong="H4583" \w* \w of dragons| strong="H8577" \w*; [and I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w the cities| strong="H5892" \w* \w of Judah| strong="H3063" \w* \w desolate| strong="H8077" \w*, [without an inhabitant]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 9:11 \ft desolate: Heb. desolation \f* 
\p
\v 12 Who is \w the wise| strong="H2450" \w* \w man| strong="H376" \w*, [that may understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} this? and who is he \w to whom the mouth| strong="H6310" \w* of the \sc Lord\sc* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}, [that he may declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} [it, for what the land]{strong=“H776”} [perisheth]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”} and [is burned up]{strong=“H3341” x-morph=“strongMorph: \sc Th\sc*8738”} \w like a wilderness| strong="H4057" \w*, [that none passeth through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”}? 
\v 13 And the \sc Lord\sc* [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Because they have forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8800”} \w my law| strong="H8451" \w* [which I set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* [them, and have not obeyed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w my voice| strong="H6963" \w*, [neither walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} therein; 
\v 14 [But have walked]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w the imagination| strong="H8307" \w* \w of their own heart| strong="H3820" \w*, \w and after| strong="H310" \w* \w Baalim| strong="H1168" \w*, \w which their fathers| strong="H1" \w* [taught]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8765”} them:\f + \fr 9:14 \ft imagination: or, stubbornness \f* 
\v 15 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*; [Behold, I will feed]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8688”} them, even \w this people| strong="H5971" \w*, \w with wormwood| strong="H3939" \w*, \w and give them water| strong="H4325" \w* \w of gall| strong="H7219" \w* [to drink]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\v 16 [I will scatter]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8689”} \w them also among the heathen| strong="H1471" \w*, \w whom neither they nor their fathers| strong="H1" \w* [have known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}: [and I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w a sword| strong="H2719" \w* \w after| strong="H310" \w* [them, till I have consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8763”} them. 
\p
\v 17 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [Consider]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8708”} [ye, and call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} [for the mourning women]{strong=“H6969” x-morph=“strongMorph: \sc Th\sc*8789”}, [that they may come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}; [and send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8798”} \w for cunning| strong="H2450" \w* women, [that they may come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}: 
\v 18 [And let them make haste]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8762”}, [and take up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w a wailing| strong="H5092" \w* [for us, that our eyes]{strong=“H5869”} [may run down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w with tears| strong="H1832" \w*, \w and our eyelids| strong="H6079" \w* [gush out]{strong=“H5140” x-morph=“strongMorph: \sc Th\sc*8799”} \w with waters| strong="H4325" \w*. 
\v 19 \w For a voice| strong="H6963" \w* \w of wailing| strong="H5092" \w* [is heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8738”} \w out of Zion| strong="H6726" \w*, [How are we spoiled]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8795”}! \w we are greatly| strong="H3966" \w* [confounded]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8804”}, [because we have forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} \w the land| strong="H776" \w*, \w because our dwellings| strong="H4908" \w* have cast us [out]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\v 20 [Yet hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* of the \sc Lord\sc*, \w O ye women| strong="H802" \w*, \w and let your ear| strong="H241" \w* [receive]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the word| strong="H1697" \w* \w of his mouth| strong="H6310" \w*, [and teach]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8761”} \w your daughters| strong="H1323" \w* \w wailing| strong="H5092" \w*, \w and every one| strong="H802" \w* \w her neighbour| strong="H7468" \w* \w lamentation| strong="H7015" \w*. 
\v 21 \w For death| strong="H4194" \w* [is come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w into our windows| strong="H2474" \w*, and [is entered]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into our palaces| strong="H759" \w*, [to cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8687”} \w the children| strong="H5768" \w* \w from without| strong="H2351" \w*, and \w the young men| strong="H970" \w* \w from the streets| strong="H7339" \w*. 
\v 22 [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”}, [Thus saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, \w Even the carcases| strong="H5038" \w* \w of men| strong="H120" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} \w as dung| strong="H1828" \w* \w upon the open| strong="H6440" \w* \w field| strong="H7704" \w*, \w and as the handful| strong="H5995" \w* \w after| strong="H310" \w* [the harvestman]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8802”}, [and none shall gather]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8764”} them. 
\p
\v 23 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w Let not the wise| strong="H2450" \w* man [glory]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8691”} \w in his wisdom| strong="H2451" \w*, \w neither let the mighty| strong="H1368" \w* man [glory]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8691”} \w in his might| strong="H1369" \w*, \w let not the rich| strong="H6223" \w* man [glory]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8691”} \w in his riches| strong="H6239" \w*: 
\v 24 [But let him that glorieth]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8693”} [glory]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8691”} [in this, that he understandeth]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8687”} [and knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} me, that I am the \sc Lord\sc* [which exercise]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w lovingkindness| strong="H2617" \w*, \w judgment| strong="H4941" \w*, \w and righteousness| strong="H6666" \w*, \w in the earth| strong="H776" \w*: for in these things [I delight]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\p
\v 25 [Behold, the days]{strong=“H3117”} [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [that I will punish]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} all them which are [circumcised]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8803”} \w with the uncircumcised| strong="H6190" \w*;\f + \fr 9:25 \ft punish: Heb. visit upon \f* 
\v 26 \w Egypt| strong="H4714" \w*, \w and Judah| strong="H3063" \w*, \w and Edom| strong="H123" \w*, \w and the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w*, \w and Moab| strong="H4124" \w*, and all that are [in the utmost]{strong=“H7112” x-morph=“strongMorph: \sc Th\sc*8803”} \w corners| strong="H6285" \w*, [that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the wilderness| strong="H4057" \w*: for all these \w nations| strong="H1471" \w* are \w uncircumcised| strong="H6189" \w*, \w and all the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* are \w uncircumcised| strong="H6189" \w* \w in the heart| strong="H3820" \w*.\f + \fr 9:26 \ft in the utmost…: Heb. cut off into corners, or, having the corners of their hair polled \f*
\c 10
\p 
\v 1 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye the word| strong="H1697" \w* which the \sc Lord\sc* [speaketh]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [unto you, O house]{strong=“H1004”} \w of Israel| strong="H3478" \w*: 
\v 2 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [Learn]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8799”} \w not the way| strong="H1870" \w* \w of the heathen| strong="H1471" \w*, [and be not dismayed]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8735”} \w at the signs| strong="H226" \w* \w of heaven| strong="H8064" \w*; \w for the heathen| strong="H1471" \w* [are dismayed]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8735”} \w at them| strong="H1992" \w*. 
\v 3 \w For the customs| strong="H2708" \w* \w of the people| strong="H5971" \w* are \w vain| strong="H1892" \w*: for one [cutteth]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8804”} \w a tree| strong="H6086" \w* \w out of the forest| strong="H3293" \w*, \w the work| strong="H4639" \w* \w of the hands| strong="H3027" \w* \w of the workman| strong="H2796" \w*, \w with the axe| strong="H4621" \w*.\f + \fr 10:3 \ft customs…: Heb. statutes, or, ordinances are vanity \f* 
\v 4 [They deck]{strong=“H3302” x-morph=“strongMorph: \sc Th\sc*8762”} \w it with silver| strong="H3701" \w* \w and with gold| strong="H2091" \w*; [they fasten]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8762”} \w it with nails| strong="H4548" \w* \w and with hammers| strong="H4717" \w*, [that it move]{strong=“H6328” x-morph=“strongMorph: \sc Th\sc*8686”} not. 
\v 5 They are \w upright| strong="H4749" \w* \w as the palm tree| strong="H8560" \w*, [but speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [not: they must needs]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8800”} [be borne]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8735”}, [because they cannot go]{strong=“H6805” x-morph=“strongMorph: \sc Th\sc*8799”}. [Be not afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [of them; for they cannot do evil]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8686”}, neither also is it [in them to do good]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8687”}. 
\v 6 Forasmuch as there is none like unto thee, O \sc Lord\sc*; thou art \w great| strong="H1419" \w*, \w and thy name| strong="H8034" \w* is \w great| strong="H1419" \w* \w in might| strong="H1369" \w*. 
\v 7 [Who would not fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [thee, O King]{strong=“H4428”} \w of nations| strong="H1471" \w*? [for to thee doth it appertain]{strong=“H2969” x-morph=“strongMorph: \sc Th\sc*8804”}: \w forasmuch as among all the wise| strong="H2450" \w* men \w of the nations| strong="H1471" \w*, \w and in all their kingdoms| strong="H4438" \w*, there is none like unto thee.\f + \fr 10:7 \ft to…: or, it liketh thee \f* 
\v 8 \w But they are altogether| strong="H259" \w* [brutish ]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8799”} [and foolish]{strong=“H3688” x-morph=“strongMorph: \sc Th\sc*8799”}: \w the stock| strong="H6086" \w* is \w a doctrine| strong="H4148" \w* \w of vanities| strong="H1892" \w*.\f + \fr 10:8 \ft altogether: Heb. in one, or, at once \f* 
\v 9 \w Silver| strong="H3701" \w* [spread into plates]{strong=“H7554” x-morph=“strongMorph: \sc Th\sc*8794”} [is brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8714”} \w from Tarshish| strong="H8659" \w*, \w and gold| strong="H2091" \w* \w from Uphaz| strong="H210" \w*, \w the work| strong="H4639" \w* \w of the workman| strong="H2796" \w*, \w and of the hands| strong="H3027" \w* [of the founder]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8802”}: \w blue| strong="H8504" \w* \w and purple| strong="H713" \w* is \w their clothing| strong="H3830" \w*: they are \w all the work| strong="H4639" \w* \w of cunning| strong="H2450" \w* men. 
\v 10 But the \sc Lord\sc* is \w the true| strong="H571" \w* \w God| strong="H430" \w*, he is \w the living| strong="H2416" \w* \w God| strong="H430" \w*, \w and an everlasting| strong="H5769" \w* \w king| strong="H4428" \w*: \w at his wrath| strong="H7110" \w* \w the earth| strong="H776" \w* [shall tremble]{strong=“H7493” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the nations| strong="H1471" \w* [shall not be able to abide]{strong=“H3557” x-morph=“strongMorph: \sc Th\sc*8686”} \w his indignation| strong="H2195" \w*.\f + \fr 10:10 \ft true…: Heb. God of truth \f* \f + \fr 10:10 \ft living God: Heb. living Gods \f* \f + \fr 10:10 \ft everlasting…: Heb. king of eternity \f* 
\v 11 \w Thus| strong="H1836" \w* [shall ye say]{strong=“H560” x-morph=“strongMorph: \sc Th\sc*8748”} [unto them, The gods]{strong=“H426”} \w that have not| strong="H3809" \w* [made]{strong=“H5648” x-morph=“strongMorph: \sc Th\sc*8754”} \w the heavens| strong="H8065" \w* \w and the earth| strong="H778" \w*, even [they shall perish]{strong=“H7” x-morph=“strongMorph: \sc Th\sc*8748”} \w from the earth| strong="H772" \w*, \w and from under| strong="H8460" \w* \w these| strong="H429" \w* \w heavens| strong="H8065" \w*. 
\v 12 [He hath made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w the earth| strong="H776" \w* \w by his power| strong="H3581" \w*, [he hath established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8688”} \w the world| strong="H8398" \w* \w by his wisdom| strong="H2451" \w*, [and hath stretched out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} \w the heavens| strong="H8064" \w* \w by his discretion| strong="H8394" \w*. 
\v 13 [When he uttereth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w his voice| strong="H6963" \w*, there is \w a multitude| strong="H1995" \w* \w of waters| strong="H4325" \w* \w in the heavens| strong="H8064" \w*, \w and he causeth the vapours| strong="H5387" \w* [to ascend]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w from the ends| strong="H7097" \w* \w of the earth| strong="H776" \w*; [he maketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w lightnings| strong="H1300" \w* \w with rain| strong="H4306" \w*, [and bringeth forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w the wind| strong="H7307" \w* \w out of his treasures| strong="H214" \w*.\f + \fr 10:13 \ft multitude: or, noise \f* \f + \fr 10:13 \ft with: or, for \f* 
\v 14 \w Every man| strong="H120" \w* [is brutish]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8738”} in his \w knowledge| strong="H1847" \w*: [every founder]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8802”} [is confounded]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”} \w by the graven image| strong="H6459" \w*: \w for his molten image| strong="H5262" \w* is \w falsehood| strong="H8267" \w*, and there is \w no breath| strong="H7307" \w* in them.\f + \fr 10:14 \ft brutish in his knowledge: or, more brutish than to know \f* 
\v 15 They are \w vanity| strong="H1892" \w*, and \w the work| strong="H4639" \w* \w of errors| strong="H8595" \w*: \w in the time| strong="H6256" \w* \w of their visitation| strong="H6486" \w* [they shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 16 \w The portion| strong="H2506" \w* \w of Jacob| strong="H3290" \w* is not like them: for he is [the former]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} of all things; \w and Israel| strong="H3478" \w* is \w the rod| strong="H7626" \w* \w of his inheritance| strong="H5159" \w*: The \sc Lord\sc* \w of hosts| strong="H6635" \w* is \w his name| strong="H8034" \w*. 
\p
\v 17 [Gather up]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy wares| strong="H3666" \w* \w out of the land| strong="H776" \w*, [O inhabitant]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the fortress| strong="H4692" \w*.\f + \fr 10:17 \ft inhabitant: Heb. inhabitress \f* 
\v 18 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [Behold, I will sling]{strong=“H7049” x-morph=“strongMorph: \sc Th\sc*8802”} [out the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the land| strong="H776" \w* \w at this once| strong="H6471" \w*, [and will distress]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8689”} [them, that they may find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} it so. 
\p
\v 19 \w Woe| strong="H188" \w* \w is me for my hurt| strong="H7667" \w*! \w my wound| strong="H4347" \w* [is grievous]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8737”}: [but I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Truly| strong="H389" \w* this is \w a grief| strong="H2483" \w*, [and I must bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\v 20 \w My tabernacle| strong="H168" \w* [is spoiled]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8795”}, \w and all my cords| strong="H4340" \w* [are broken]{strong=“H5423” x-morph=“strongMorph: \sc Th\sc*8738”}: \w my children| strong="H1121" \w* [are gone forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} of me, and they are not: there is [none to stretch forth]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8802”} \w my tent| strong="H168" \w* [any more, and to set up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8688”} \w my curtains| strong="H3407" \w*. 
\v 21 [For the pastors]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [are become brutish]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8738”}, [and have not sought]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*: [therefore they shall not prosper]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8689”}, \w and all their flocks| strong="H4830" \w* [shall be scattered]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 22 [Behold, the noise]{strong=“H6963”} \w of the bruit| strong="H8052" \w* [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and a great| strong="H1419" \w* \w commotion| strong="H7494" \w* \w out of the north| strong="H6828" \w* \w country| strong="H776" \w*, [to make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w the cities| strong="H5892" \w* \w of Judah| strong="H3063" \w* \w desolate| strong="H8077" \w*, and \w a den| strong="H4583" \w* \w of dragons| strong="H8577" \w*. 
\p
\v 23 O \sc Lord\sc*, [I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w that the way| strong="H1870" \w* \w of man| strong="H120" \w* is not in himself: it is \w not in man| strong="H376" \w* [that walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} [to direct]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8687”} \w his steps| strong="H6806" \w*. 
\v 24 O \sc Lord\sc*, [correct]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8761”} [me, but with judgment]{strong=“H4941”}; \w not in thine anger| strong="H639" \w*, [lest thou bring me to nothing]{strong=“H4591” x-morph=“strongMorph: \sc Th\sc*8686”}.\f + \fr 10:24 \ft bring…: Heb. diminish me \f* 
\v 25 [Pour out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy fury| strong="H2534" \w* \w upon the heathen| strong="H1471" \w* [that know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [thee not, and upon the families]{strong=“H4940”} [that call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w not on thy name| strong="H8034" \w*: [for they have eaten up]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w Jacob| strong="H3290" \w*, [and devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} [him, and consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8762”} [him, and have made his habitation]{strong=“H5116”} [desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8689”}.
\c 11
\p 
\v 1 \w The word| strong="H1697" \w* \w that came to Jeremiah| strong="H3414" \w* from the \sc Lord\sc*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye the words| strong="H1697" \w* \w of this covenant| strong="H1285" \w*, [and speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto the men| strong="H376" \w* \w of Judah| strong="H3063" \w*, [and to the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w*; 
\v 3 [And say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [thou unto them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w*; [Cursed]{strong=“H779” x-morph=“strongMorph: \sc Th\sc*8803”} be \w the man| strong="H376" \w* [that obeyeth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w not the words| strong="H1697" \w* \w of this covenant| strong="H1285" \w*, 
\v 4 [Which I commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w your fathers| strong="H1" \w* \w in the day| strong="H3117" \w* that [I brought them forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8687”} \w out of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, \w from the iron| strong="H1270" \w* \w furnace| strong="H3564" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w my voice| strong="H6963" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [them, according to all which I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} [you: so shall ye be my people]{strong=“H5971”}, \w and I will be your God| strong="H430" \w*: 
\v 5 [That I may perform]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8687”} \w the oath| strong="H7621" \w* [which I have sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto your fathers| strong="H1" \w*, [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w them a land| strong="H776" \w* [flowing]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”} \w with milk| strong="H2461" \w* \w and honey| strong="H1706" \w*, as it is \w this day| strong="H3117" \w*. [Then answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [I, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w So be it| strong="H543" \w*, O \sc Lord\sc*.\f + \fr 11:5 \ft So…: Heb. Amen \f* 
\v 6 Then the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Proclaim]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} \w all these words| strong="H1697" \w* \w in the cities| strong="H5892" \w* \w of Judah| strong="H3063" \w*, \w and in the streets| strong="H2351" \w* \w of Jerusalem| strong="H3389" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye the words| strong="H1697" \w* \w of this covenant| strong="H1285" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} them. 
\v 7 [For I earnestly]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8687”} [protested]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8689”} \w unto your fathers| strong="H1" \w* \w in the day| strong="H3117" \w* that [I brought them up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8687”} \w out of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, even \w unto this day| strong="H3117" \w*, [rising early]{strong=“H7925” x-morph=“strongMorph: \sc Th\sc*8687”} [and protesting]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8687”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w my voice| strong="H6963" \w*. 
\v 8 [Yet they obeyed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [not, nor inclined]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8689”} \w their ear| strong="H241" \w*, [but walked]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w every one| strong="H376" \w* \w in the imagination| strong="H8307" \w* \w of their evil| strong="H7451" \w* \w heart| strong="H3820" \w*: [therefore I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w upon them all the words| strong="H1697" \w* \w of this covenant| strong="H1285" \w*, [which I commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} them [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”}; [but they did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} them not.\f + \fr 11:8 \ft imagination: or, stubbornness \f* 
\v 9 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, A conspiracy]{strong=“H7195”} [is found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8738”} \w among the men| strong="H376" \w* \w of Judah| strong="H3063" \w*, [and among the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w*. 
\v 10 [They are turned back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the iniquities| strong="H5771" \w* [of their forefathers]{strong=“H1 H7223”}, [which refused]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8765”} [to hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w my words| strong="H1697" \w*; [and they went]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w after| strong="H310" \w* \w other| strong="H312" \w* \w gods| strong="H430" \w* [to serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8800”} [them: the house]{strong=“H1004”} \w of Israel| strong="H3478" \w* \w and the house| strong="H1004" \w* \w of Judah| strong="H3063" \w* [have broken]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8689”} \w my covenant| strong="H1285" \w* [which I made]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8804”} \w with their fathers| strong="H1" \w*. 
\p
\v 11 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [Behold, I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w evil| strong="H7451" \w* [upon them, which they shall not be able]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [to escape]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”}; [and though they shall cry]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me, I will not hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} unto them.\f + \fr 11:11 \ft to escape: Heb. to go forth of \f* 
\v 12 \w Then shall the cities| strong="H5892" \w* \w of Judah| strong="H3063" \w* [and inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w* [go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”}, [and cry]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the gods| strong="H430" \w* [unto whom they offer incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8764”}: [but they shall not save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} [them at all]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8687”} \w in the time| strong="H6256" \w* \w of their trouble| strong="H7451" \w*.\f + \fr 11:12 \ft trouble: Heb. evil \f* 
\v 13 For according to \w the number| strong="H4557" \w* \w of thy cities| strong="H5892" \w* \w were thy gods| strong="H430" \w*, \w O Judah| strong="H3063" \w*; and according to \w the number| strong="H4557" \w* \w of the streets| strong="H2351" \w* \w of Jerusalem| strong="H3389" \w* [have ye set up]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w altars| strong="H4196" \w* to that \w shameful thing| strong="H1322" \w*, even \w altars| strong="H4196" \w* [to burn incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8763”} \w unto Baal| strong="H1168" \w*.\f + \fr 11:13 \ft shameful…: Heb. shame \f* 
\v 14 [Therefore pray]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8691”} \w not thou for this people| strong="H5971" \w*, [neither lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w a cry| strong="H7440" \w* \w or prayer| strong="H8605" \w* [for them: for I will not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} them \w in the time| strong="H6256" \w* [that they cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto me for their trouble| strong="H7451" \w*.\f + \fr 11:14 \ft trouble: Heb. evil \f* 
\v 15 \w What hath my beloved| strong="H3039" \w* \w to do in mine house| strong="H1004" \w*, seeing [she hath wrought]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w lewdness| strong="H4209" \w* \w with many| strong="H7227" \w*, \w and the holy| strong="H6944" \w* \w flesh| strong="H1320" \w* [is passed]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} [from thee? when thou doest evil]{strong=“H7451”}, [then thou rejoicest]{strong=“H5937” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 11:15 \ft What…: Heb. What is to my beloved in my house \f* \f + \fr 11:15 \ft when…: or, when thy evil is \f* 
\v 16 The \sc Lord\sc* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy name| strong="H8034" \w*, \w A green| strong="H7488" \w* \w olive tree| strong="H2132" \w*, \w fair| strong="H3303" \w*, and \w of goodly| strong="H8389" \w* \w fruit| strong="H6529" \w*: \w with the noise| strong="H6963" \w* \w of a great| strong="H1419" \w* \w tumult| strong="H1999" \w* [he hath kindled]{strong=“H3341” x-morph=“strongMorph: \sc Th\sc*8689”} \w fire| strong="H784" \w* [upon it, and the branches]{strong=“H1808”} [of it are broken]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 17 For the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [that planted]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8802”} [thee, hath pronounced]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w evil| strong="H7451" \w* [against thee, for]{strong=“H1558”} \w the evil| strong="H7451" \w* \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* \w and of the house| strong="H1004" \w* \w of Judah| strong="H3063" \w*, [which they have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [against themselves to provoke me to anger]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8687”} [in offering incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8763”} \w unto Baal| strong="H1168" \w*. 
\p
\v 18 And the \sc Lord\sc* [hath given me knowledge]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} of it, [and I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8689”} it: [then thou shewedst]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8689”} \w me their doings| strong="H4611" \w*. 
\v 19 But I was \w like a lamb| strong="H3532" \w* or \w an ox| strong="H441" \w* that [is brought]{strong=“H2986” x-morph=“strongMorph: \sc Th\sc*8714”} [to the slaughter]{strong=“H2873” x-morph=“strongMorph: \sc Th\sc*8800”}; [and I knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [not that they had devised]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8804”} \w devices| strong="H4284" \w* against me, saying, [Let us destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8686”} \w the tree| strong="H6086" \w* \w with the fruit| strong="H3899" \w* [thereof, and let us cut him off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the land| strong="H776" \w* \w of the living| strong="H2416" \w*, \w that his name| strong="H8034" \w* [may be no more remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 11:19 \ft the tree…: Heb. the stalk with his bread \f* 
\v 20 But, O \sc Lord\sc* \w of hosts| strong="H6635" \w*, [that judgest]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} \w righteously| strong="H6664" \w*, [that triest]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8802”} \w the reins| strong="H3629" \w* \w and the heart| strong="H3820" \w*, [let me see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy vengeance| strong="H5360" \w* [on them: for unto thee have I revealed]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8765”} \w my cause| strong="H7379" \w*. 
\v 21 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of the men| strong="H582" \w* \w of Anathoth| strong="H6068" \w*, [that seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w thy life| strong="H5315" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8735”} \w not in the name| strong="H8034" \w* of the \sc Lord\sc*, [that thou die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w not by our hand| strong="H3027" \w*: 
\v 22 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [Behold, I will punish]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8802”} [them: the young men]{strong=“H970”} [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w*; \w their sons| strong="H1121" \w* \w and their daughters| strong="H1323" \w* [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w by famine| strong="H7458" \w*:\f + \fr 11:22 \ft punish: Heb. visit upon \f* 
\v 23 \w And there shall be no remnant| strong="H7611" \w* [of them: for I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w evil| strong="H7451" \w* \w upon the men| strong="H582" \w* \w of Anathoth| strong="H6068" \w*, even \w the year| strong="H8141" \w* \w of their visitation| strong="H6486" \w*.
\c 12
\p 
\v 1 \w Righteous| strong="H6662" \w* art thou, O \sc Lord\sc*, [when I plead]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”} [with thee: yet let me talk]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} with thee of thy \w judgments| strong="H4941" \w*: \w Wherefore doth the way| strong="H1870" \w* \w of the wicked| strong="H7563" \w* [prosper]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8804”}? wherefore [are all they happy]{strong=“H7951” x-morph=“strongMorph: \sc Th\sc*8804”} \w that deal very| strong="H899" \w* [treacherously]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”}?\f + \fr 12:1 \ft talk…: or, reason the case with thee \f* 
\v 2 [Thou hast planted]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8804”} [them, yea, they have taken root]{strong=“H8327” x-morph=“strongMorph: \sc Th\sc*8776”}: [they grow]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [yea, they bring forth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w fruit| strong="H6529" \w*: thou art \w near| strong="H7138" \w* \w in their mouth| strong="H6310" \w*, \w and far from| strong="H7350" \w* \w their reins| strong="H3629" \w*.\f + \fr 12:2 \ft they grow: Heb. they go on \f* 
\v 3 But thou, O \sc Lord\sc*, [knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [me: thou hast seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [me, and tried]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine heart| strong="H3820" \w* [toward thee: pull them out]{strong=“H5423” x-morph=“strongMorph: \sc Th\sc*8685”} \w like sheep| strong="H6629" \w* \w for the slaughter| strong="H2878" \w*, [and prepare]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8685”} \w them for the day| strong="H3117" \w* \w of slaughter| strong="H2028" \w*.\f + \fr 12:3 \ft toward…: Heb. with thee \f* 
\v 4 \w How long shall the land| strong="H776" \w* [mourn]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the herbs| strong="H6212" \w* \w of every field| strong="H7704" \w* [wither]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8799”}, \w for the wickedness| strong="H7451" \w* [of them that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} [therein? the beasts]{strong=“H929”} [are consumed]{strong=“H5595” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and the birds| strong="H5775" \w*; [because they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [He shall not see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w our last end| strong="H319" \w*. 
\p
\v 5 [If thou hast run]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8804”} \w with the footmen| strong="H7273" \w*, [and they have wearied]{strong=“H3811” x-morph=“strongMorph: \sc Th\sc*8686”} [thee, then how canst thou contend]{strong=“H8474” x-morph=“strongMorph: \sc Th\sc*8807”} \w with horses| strong="H5483" \w*? and if \w in the land| strong="H776" \w* \w of peace| strong="H7965" \w*, wherein [thou trustedst]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”}, they wearied thee, [then how wilt thou do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the swelling| strong="H1347" \w* \w of Jordan| strong="H3383" \w*? 
\v 6 \w For even thy brethren| strong="H251" \w*, \w and the house| strong="H1004" \w* \w of thy father| strong="H1" \w*, [even they have dealt treacherously]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8804”} [with thee; yea, they have called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w a multitude| strong="H4392" \w* \w after| strong="H310" \w* [thee: believe]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”} [them not, though they speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w fair words| strong="H2896" \w* unto thee.\f + \fr 12:6 \ft they have called…: or, they cried after thee fully \f* \f + \fr 12:6 \ft fair…: Heb. good things \f* 
\p
\v 7 [I have forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine house| strong="H1004" \w*, [I have left]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine heritage| strong="H5159" \w*; [I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w the dearly beloved| strong="H3033" \w* \w of my soul| strong="H5315" \w* \w into the hand| strong="H3709" \w* [of her enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 12:7 \ft the dearly…: Heb. the love \f* 
\v 8 \w Mine heritage| strong="H5159" \w* \w is unto me as a lion| strong="H738" \w* \w in the forest| strong="H3293" \w*; [it crieth out]{strong=“H6963 H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [against me: therefore have I hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”} it.\f + \fr 12:8 \ft crieth…: or, yelleth: Heb. giveth out his voice \f* 
\v 9 \w Mine heritage| strong="H5159" \w* is unto me as \w a speckled| strong="H6641" \w* \w bird| strong="H5861" \w*, \w the birds| strong="H5861" \w* \w round about| strong="H5439" \w* are [against her; come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} [ye, assemble]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8798”} \w all the beasts| strong="H2416" \w* \w of the field| strong="H7704" \w*, [come]{strong=“H857” x-morph=“strongMorph: \sc Th\sc*8685”} \w to devour| strong="H402" \w*.\f + \fr 12:9 \ft speckled: or, taloned \f* \f + \fr 12:9 \ft come to: or, cause them to come to \f* 
\v 10 \w Many| strong="H7227" \w* [pastors]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [have destroyed]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8765”} \w my vineyard| strong="H3754" \w*, \w they have trodden| strong="H947" \w* \w my portion| strong="H2513" \w* [under foot]{strong=“H947” x-morph=“strongMorph: \sc Th\sc*8790”}, [they have made]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w my pleasant| strong="H2532" \w* \w portion| strong="H2513" \w* \w a desolate| strong="H8077" \w* \w wilderness| strong="H4057" \w*.\f + \fr 12:10 \ft pleasant…: Heb. portion of desire \f* 
\v 11 [They have made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w it desolate| strong="H8076" \w*, and being \w desolate| strong="H8077" \w* [it mourneth]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me; the whole land]{strong=“H776”} [is made desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8738”}, \w because no man| strong="H376" \w* [layeth]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8802”} it \w to heart| strong="H3820" \w*. 
\v 12 [The spoilers]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8802”} [are come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon all high places| strong="H8205" \w* \w through the wilderness| strong="H4057" \w*: \w for the sword| strong="H2719" \w* of the \sc Lord\sc* [shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} from the one \w end| strong="H7097" \w* \w of the land| strong="H776" \w* even to the other \w end| strong="H7097" \w* \w of the land| strong="H776" \w*: \w no flesh| strong="H1320" \w* \w shall have peace| strong="H7965" \w*. 
\v 13 [They have sown]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8804”} \w wheat| strong="H2406" \w*, [but shall reap]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8804”} \w thorns| strong="H6975" \w*: [they have put themselves to pain]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8738”}, but [shall not profit]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8686”}: [and they shall be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8804”} \w of your revenues| strong="H8393" \w* \w because of the fierce| strong="H2740" \w* \w anger| strong="H639" \w* of the \sc Lord\sc*.\f + \fr 12:13 \ft they shall: or, ye shall \f* 
\p
\v 14 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w against all mine evil| strong="H7451" \w* \w neighbours| strong="H7934" \w*, [that touch]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8802”} \w the inheritance| strong="H5159" \w* \w which I have caused my people| strong="H5971" \w* \w Israel| strong="H3478" \w* [to inherit]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8689”}; [Behold, I will pluck them out]{strong=“H5428” x-morph=“strongMorph: \sc Th\sc*8802”} \w of their land| strong="H127" \w*, [and pluck out]{strong=“H5428” x-morph=“strongMorph: \sc Th\sc*8799”} \w the house| strong="H1004" \w* \w of Judah| strong="H3063" \w* \w from among| strong="H8432" \w* them. 
\v 15 [And it shall come to pass, after]{strong=“H310”} [that I have plucked them out]{strong=“H5428” x-morph=“strongMorph: \sc Th\sc*8800”} [I will return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [and have compassion]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8765”} [on them, and will bring them again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”}, \w every man| strong="H376" \w* \w to his heritage| strong="H5159" \w*, \w and every man| strong="H376" \w* \w to his land| strong="H776" \w*. 
\v 16 [And it shall come to pass, if they will diligently]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8800”} [learn]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8799”} \w the ways| strong="H1870" \w* \w of my people| strong="H5971" \w*, [to swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8736”} \w by my name| strong="H8034" \w*, The \sc Lord\sc* \w liveth| strong="H2416" \w*; [as they taught]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8765”} \w my people| strong="H5971" \w* [to swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8736”} \w by Baal| strong="H1168" \w*; [then shall they be built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the midst| strong="H8432" \w* \w of my people| strong="H5971" \w*. 
\v 17 [But if they will not obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will utterly]{strong=“H5428” x-morph=“strongMorph: \sc Th\sc*8800”} [pluck up]{strong=“H5428” x-morph=“strongMorph: \sc Th\sc*8804”} [and destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8763”} \w that nation| strong="H1471" \w*, [saith ]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\c 13
\p 
\v 1 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* [unto me, Go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”} [and get]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee a linen| strong="H6593" \w* \w girdle| strong="H232" \w*, [and put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w it upon thy loins| strong="H4975" \w*, [and put]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w it not in water| strong="H4325" \w*. 
\v 2 [So I got]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8799”} \w a girdle| strong="H232" \w* \w according to the word| strong="H1697" \w* of the \sc Lord\sc*, [and put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} it \w on my loins| strong="H4975" \w*. 
\v 3 \w And the word| strong="H1697" \w* of the \sc Lord\sc* \w came unto me the second time| strong="H8145" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 4 [Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w the girdle| strong="H232" \w* [that thou hast got]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8804”}, which is \w upon thy loins| strong="H4975" \w*, [and arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} \w to Euphrates| strong="H6578" \w*, [and hide]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8798”} \w it there in a hole| strong="H5357" \w* \w of the rock| strong="H5553" \w*. 
\v 5 [So I went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [and hid]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8799”} \w it by Euphrates| strong="H6578" \w*, as the \sc Lord\sc* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} me. 
\v 6 \w And it came to pass after| strong="H7093" \w* \w many| strong="H7227" \w* \w days| strong="H3117" \w*, that the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} \w to Euphrates| strong="H6578" \w*, [and take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w the girdle| strong="H232" \w* [from thence, which I commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [thee to hide]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8800”} there. 
\v 7 [Then I went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Euphrates| strong="H6578" \w*, [and digged]{strong=“H2658” x-morph=“strongMorph: \sc Th\sc*8799”}, [and took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the girdle| strong="H232" \w* \w from the place| strong="H4725" \w* [where I had hid]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8804”} [it: and, behold, the girdle]{strong=“H232”} [was marred]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8738”}, [it was profitable]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8799”} for nothing. 
\v 8 \w Then the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 9 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [After this manner will I mar]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8686”} \w the pride| strong="H1347" \w* \w of Judah| strong="H3063" \w*, \w and the great| strong="H7227" \w* \w pride| strong="H1347" \w* \w of Jerusalem| strong="H3389" \w*. 
\v 10 \w This evil| strong="H7451" \w* \w people| strong="H5971" \w*, \w which refuse| strong="H3987" \w* [to hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w my words| strong="H1697" \w*, [which walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the imagination| strong="H8307" \w* \w of their heart| strong="H3820" \w*, [and walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w other| strong="H312" \w* \w gods| strong="H430" \w*, [to serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8800”} [them, and to worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8692”} [them, shall even be as this girdle]{strong=“H232”}, [which is good]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8799”} for nothing.\f + \fr 13:10 \ft imagination: or, stubbornness \f* 
\v 11 \w For as the girdle| strong="H232" \w* [cleaveth]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the loins| strong="H4975" \w* \w of a man| strong="H376" \w*, [so have I caused to cleave]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8689”} \w unto me the whole house| strong="H1004" \w* \w of Israel| strong="H3478" \w* \w and the whole house| strong="H1004" \w* \w of Judah| strong="H3063" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*; \w that they might be unto me for a people| strong="H5971" \w*, \w and for a name| strong="H8034" \w*, \w and for a praise| strong="H8416" \w*, \w and for a glory| strong="H8597" \w*: [but they would not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\p
\v 12 [Therefore thou shalt speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto them this word| strong="H1697" \w*; [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w*, \w Every bottle| strong="H5035" \w* [shall be filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”} \w with wine| strong="H3196" \w*: [and they shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto thee, Do we not certainly]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} [know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w that every bottle| strong="H5035" \w* [shall be filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”} \w with wine| strong="H3196" \w*? 
\v 13 [Then shalt thou say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [Behold, I will fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8764”} [all the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of this land| strong="H776" \w*, \w even the kings| strong="H4428" \w* [that sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} [upon David’s]{strong=“H1732”} \w throne| strong="H3678" \w*, \w and the priests| strong="H3548" \w*, \w and the prophets| strong="H5030" \w*, [and all the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w*, \w with drunkenness| strong="H7943" \w*. 
\v 14 [And I will dash]{strong=“H5310” x-morph=“strongMorph: \sc Th\sc*8765”} \w them one| strong="H376" \w* \w against another| strong="H251" \w*, \w even the fathers| strong="H1" \w* \w and the sons| strong="H1121" \w* \w together| strong="H3162" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: [I will not pity]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”}, [nor spare]{strong=“H2347” x-morph=“strongMorph: \sc Th\sc*8799”}, [nor have mercy]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8762”}, [but destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8687”} them.\f + \fr 13:14 \ft one…: Heb. a man against his brother \f* \f + \fr 13:14 \ft but…: Heb. from destroying them \f* 
\p
\v 15 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [ye, and give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”}; [be not proud]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8799”}: for the \sc Lord\sc* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 16 [Give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w glory| strong="H3519" \w* to the \sc Lord\sc* \w your God| strong="H430" \w*, [before he cause darkness]{strong=“H2821” x-morph=“strongMorph: \sc Th\sc*8686”}, \w and before your feet| strong="H7272" \w* [stumble]{strong=“H5062” x-morph=“strongMorph: \sc Th\sc*8691”} \w upon the dark| strong="H5399" \w* \w mountains| strong="H2022" \w*, [and, while ye look]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8765”} \w for light| strong="H216" \w*, [he turn]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w it into the shadow of death| strong="H6757" \w*, and [make]{strong=“H7896 H7896” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8798”} it \w gross darkness| strong="H6205" \w*. 
\v 17 [But if ye will not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [it, my soul]{strong=“H5315”} [shall weep]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8799”} \w in secret places| strong="H4565" \w* \w for| strong="H6440" \w* your \w pride| strong="H1466" \w*; \w and mine eye| strong="H5869" \w* [shall weep]{strong=“H1830” x-morph=“strongMorph: \sc Th\sc*8799”} [sore]{strong=“H1830” x-morph=“strongMorph: \sc Th\sc*8800”}, [and run down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w with tears| strong="H1832" \w*, because the \sc Lord\sc*’S \w flock| strong="H5739" \w* [is carried away captive]{strong=“H7617” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 18 [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto the king| strong="H4428" \w* \w and to the queen| strong="H1377" \w*, [Humble]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8685”} [yourselves, sit down]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8798”}: \w for your principalities| strong="H4761" \w* [shall come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”}, even \w the crown| strong="H5850" \w* \w of your glory| strong="H8597" \w*.\f + \fr 13:18 \ft principalities: or, head tires \f* 
\v 19 \w The cities| strong="H5892" \w* \w of the south| strong="H5045" \w* [shall be shut up]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8795”}, [and none shall open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8802”} them: \w Judah| strong="H3063" \w* [shall be carried away captive]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8717”} [all of it, it shall be wholly]{strong=“H7965”} [carried away captive]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8717”}. 
\v 20 [Lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w your eyes| strong="H5869" \w*, [and behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} [them that come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w from the north| strong="H6828" \w*: where is \w the flock| strong="H5739" \w* that [was given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} [thee, thy beautiful]{strong=“H8597”} \w flock| strong="H6629" \w*? 
\v 21 [What wilt thou say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [when he shall punish]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} [thee? for thou hast taught]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8765”} them to be \w captains| strong="H441" \w*, and \w as chief| strong="H7218" \w* [over thee: shall not sorrows]{strong=“H2256”} [take]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8799”} [thee, as a woman]{strong=“H802”} [in travail]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8800”}?\f + \fr 13:21 \ft punish: Heb visit upon \f* 
\p
\v 22 [And if thou say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thine heart| strong="H3824" \w*, [Wherefore come]{strong=“H7122” x-morph=“strongMorph: \sc Th\sc*8804”} [these things upon me? For the greatness]{strong=“H7230”} \w of thine iniquity| strong="H5771" \w* \w are thy skirts| strong="H7757" \w* [discovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8738”}, and \w thy heels| strong="H6119" \w* [made bare]{strong=“H2554” x-morph=“strongMorph: \sc Th\sc*8738”}.\f + \fr 13:22 \ft made…: or, shall be violently taken away \f* 
\v 23 \w Can the Ethiopian| strong="H3569" \w* [change]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8799”} \w his skin| strong="H5785" \w*, \w or the leopard| strong="H5246" \w* \w his spots| strong="H2272" \w*? then [may]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [ye also do good]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8687”}, \w that are accustomed| strong="H3928" \w* [to do evil]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8687”}.\f + \fr 13:23 \ft accustomed: Heb. taught \f* 
\v 24 [Therefore will I scatter]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8686”} \w them as the stubble| strong="H7179" \w* [that passeth away]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} \w by the wind| strong="H7307" \w* \w of the wilderness| strong="H4057" \w*. 
\v 25 This is \w thy lot| strong="H1486" \w*, \w the portion| strong="H4490" \w* \w of thy measures| strong="H4055" \w* [from me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*; [because thou hast forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and trusted]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} \w in falsehood| strong="H8267" \w*. 
\v 26 [Therefore will I discover]{strong=“H2834” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy skirts| strong="H7757" \w* \w upon thy face| strong="H6440" \w*, \w that thy shame| strong="H7036" \w* [may appear]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 27 [I have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w thine adulteries| strong="H5004" \w*, \w and thy neighings| strong="H4684" \w*, \w the lewdness| strong="H2154" \w* \w of thy whoredom| strong="H2184" \w*, and \w thine abominations| strong="H8251" \w* \w on the hills| strong="H1389" \w* \w in the fields| strong="H7704" \w*. \w Woe| strong="H188" \w* [unto thee, O Jerusalem]{strong=“H3389”}! [wilt thou not be made clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8799”}? when shall it [once]{strong=“H310 H5750”} be?\f + \fr 13:27 \ft when…: Heb. after when yet? \f*
\c 14
\p 
\v 1 \w The word| strong="H1697" \w* of the \sc Lord\sc* \w that came to Jeremiah| strong="H3414" \w* \w concerning| strong="H1697" \w* \w the dearth| strong="H1226" \w*.\f + \fr 14:1 \ft the dearth: Heb. the words of the dearths, or, restraints \f* 
\v 2 \w Judah| strong="H3063" \w* [mourneth]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and the gates| strong="H8179" \w* [thereof languish]{strong=“H535” x-morph=“strongMorph: \sc Th\sc*8797”}; [they are black]{strong=“H6937” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the ground| strong="H776" \w*; \w and the cry| strong="H6682" \w* \w of Jerusalem| strong="H3389" \w* [is gone up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 3 \w And their nobles| strong="H117" \w* [have sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w their little ones| strong="H6810" \w* \w to the waters| strong="H4325" \w*: [they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to the pits]{strong=“H1360 H1356” x-morph=“strongMorph: \sc Th\sc*8676”}, and [found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w no water| strong="H4325" \w*; [they returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w with their vessels| strong="H3627" \w* \w empty| strong="H7387" \w*; [they were ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8804”} [and confounded]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8717”}, [and covered]{strong=“H2645” x-morph=“strongMorph: \sc Th\sc*8804”} \w their heads| strong="H7218" \w*. 
\v 4 \w Because the ground| strong="H127" \w* [is chapt]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8804”}, \w for there was no rain| strong="H1653" \w* \w in the earth| strong="H776" \w*, \w the plowmen| strong="H406" \w* [were ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8804”}, [they covered]{strong=“H2645” x-morph=“strongMorph: \sc Th\sc*8804”} \w their heads| strong="H7218" \w*. 
\v 5 [Yea, the hind]{strong=“H365”} [also calved]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the field| strong="H7704" \w*, [and forsook]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8800”} it, \w because there was no grass| strong="H1877" \w*. 
\v 6 \w And the wild asses| strong="H6501" \w* [did stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the high places| strong="H8205" \w*, [they snuffed up]{strong=“H7602” x-morph=“strongMorph: \sc Th\sc*8804”} \w the wind| strong="H7307" \w* \w like dragons| strong="H8577" \w*; \w their eyes| strong="H5869" \w* [did fail]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”}, because there was \w no grass| strong="H6212" \w*. 
\p
\v 7 O \sc Lord\sc*, \w though our iniquities| strong="H5771" \w* [testify]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”} [against us, do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} thou it [for thy name’s]{strong=“H8034”} [sake: for our backslidings]{strong=“H4878”} [are many]{strong=“H7231” x-morph=“strongMorph: \sc Th\sc*8804”}; [we have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} against thee. 
\v 8 \w O the hope| strong="H4723" \w* \w of Israel| strong="H3478" \w*, [the saviour]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8688”} \w thereof in time| strong="H6256" \w* \w of trouble| strong="H6869" \w*, \w why shouldest thou be as a stranger| strong="H1616" \w* \w in the land| strong="H776" \w*, [and as a wayfaring man]{strong=“H732” x-morph=“strongMorph: \sc Th\sc*8802”} that [turneth aside]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} [to tarry for a night]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8800”}? 
\v 9 \w Why shouldest thou be as a man| strong="H376" \w* [astonied]{strong=“H1724” x-morph=“strongMorph: \sc Th\sc*8737”}, \w as a mighty man| strong="H1368" \w* that [cannot]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8687”}? yet thou, O \sc Lord\sc*, art \w in the midst| strong="H7130" \w* [of us, and we are called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8738”} \w by thy name| strong="H8034" \w*; [leave]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8686”} us not.\f + \fr 14:9 \ft we…: Heb. thy name is called upon us \f* 
\p
\v 10 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w unto this people| strong="H5971" \w*, [Thus have they loved]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} [to wander]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8800”}, [they have not refrained]{strong=“H2820” x-morph=“strongMorph: \sc Th\sc*8804”} \w their feet| strong="H7272" \w*, therefore the \sc Lord\sc* [doth not accept]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8804”} [them; he will now remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w their iniquity| strong="H5771" \w*, [and visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} \w their sins| strong="H2403" \w*. 
\v 11 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc* [unto me, Pray]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8691”} \w not for this people| strong="H5971" \w* for their \w good| strong="H2896" \w*. 
\v 12 [When they fast]{strong=“H6684” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} \w their cry| strong="H7440" \w*; [and when they offer]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w burnt offering| strong="H5930" \w* \w and an oblation| strong="H4503" \w*, [I will not accept]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8802”} [them: but I will consume]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8764”} \w them by the sword| strong="H2719" \w*, \w and by the famine| strong="H7458" \w*, \w and by the pestilence| strong="H1698" \w*. 
\p
\v 13 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [I, Ah]{strong=“H162”}, \w Lord| strong="H136" \w* \sc God\sc*! [behold, the prophets]{strong=“H5030”} [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} [unto them, Ye shall not see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the sword| strong="H2719" \w*, \w neither shall ye have famine| strong="H7458" \w*; [but I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w you assured| strong="H571" \w* \w peace| strong="H7965" \w* \w in this place| strong="H4725" \w*.\f + \fr 14:13 \ft assured…: Heb. peace of truth \f* 
\v 14 Then the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, The prophets]{strong=“H5030”} [prophesy ]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8737”} \w lies| strong="H8267" \w* \w in my name| strong="H8034" \w*: [I sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [them not, neither have I commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [them, neither spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [unto them: they prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8693”} \w unto you a false| strong="H8267" \w* \w vision| strong="H2377" \w* \w and divination| strong="H7081" \w*, [and a thing of nought]{strong=“H434 H457” x-morph=“strongMorph: \sc Th\sc*8675”}, \w and the deceit| strong="H8649" \w* \w of their heart| strong="H3820" \w*. 
\v 15 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w concerning the prophets| strong="H5030" \w* [that prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8737”} \w in my name| strong="H8034" \w*, [and I sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [them not, yet they say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, \w Sword| strong="H2719" \w* \w and famine| strong="H7458" \w* \w shall not be in this land| strong="H776" \w*; \w By sword| strong="H2719" \w* \w and famine| strong="H7458" \w* \w shall those prophets| strong="H5030" \w* [be consumed]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 16 \w And the people| strong="H5971" \w* [to whom they prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8737”} [shall be cast out]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8716”} \w in the streets| strong="H2351" \w* \w of Jerusalem| strong="H3389" \w* \w because| strong="H6440" \w* \w of the famine| strong="H7458" \w* \w and the sword| strong="H2719" \w*; [and they shall have none to bury]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8764”} \w them| strong="H1992" \w*, [them, their wives]{strong=“H802”}, \w nor their sons| strong="H1121" \w*, \w nor their daughters| strong="H1323" \w*: [for I will pour]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8804”} \w their wickedness| strong="H7451" \w* upon them. 
\p
\v 17 [Therefore thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w this word| strong="H1697" \w* [unto them; Let mine eyes]{strong=“H5869”} [run down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w with tears| strong="H1832" \w* \w night| strong="H3915" \w* \w and day| strong="H3119" \w*, [and let them not cease]{strong=“H1820” x-morph=“strongMorph: \sc Th\sc*8799”}: \w for the virgin| strong="H1330" \w* \w daughter| strong="H1323" \w* \w of my people| strong="H5971" \w* [is broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8738”} \w with a great| strong="H1419" \w* \w breach| strong="H7667" \w*, \w with a very| strong="H3966" \w* [grievous]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8737”} \w blow| strong="H4347" \w*. 
\v 18 [If I go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the field| strong="H7704" \w*, \w then behold the slain| strong="H2491" \w* \w with the sword| strong="H2719" \w*! [and if I enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the city| strong="H5892" \w*, \w then behold them that are sick| strong="H8463" \w* \w with famine| strong="H7458" \w*! [yea, both the prophet]{strong=“H5030”} \w and the priest| strong="H3548" \w* [go about]{strong=“H5503” x-morph=“strongMorph: \sc Th\sc*8804”} \w into a land| strong="H776" \w* [that they know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} not.\f + \fr 14:18 \ft go about…: or, make merchandise against a land, and men acknowledge it not \f* 
\v 19 [Hast thou utterly]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8800”} [rejected]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} \w Judah| strong="H3063" \w*? \w hath thy soul| strong="H5315" \w* [lothed]{strong=“H1602” x-morph=“strongMorph: \sc Th\sc*8804”} \w Zion| strong="H6726" \w*? [why hast thou smitten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} us, and there is \w no healing| strong="H4832" \w* [for us? we looked]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8763”} \w for peace| strong="H7965" \w*, and there is \w no good| strong="H2896" \w*; \w and for the time| strong="H6256" \w* \w of healing| strong="H4832" \w*, \w and behold trouble| strong="H1205" \w*! 
\v 20 [We acknowledge]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}, O \sc Lord\sc*, \w our wickedness| strong="H7562" \w*, and \w the iniquity| strong="H5771" \w* \w of our fathers| strong="H1" \w*: [for we have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} against thee. 
\v 21 [Do not abhor]{strong=“H5006” x-morph=“strongMorph: \sc Th\sc*8799”} us, [for thy name’s]{strong=“H8034”} [sake, do not disgrace]{strong=“H5034” x-morph=“strongMorph: \sc Th\sc*8762”} \w the throne| strong="H3678" \w* \w of thy glory| strong="H3519" \w*: [remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”}, [break]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8686”} \w not thy covenant| strong="H1285" \w* with us. 
\v 22 \w Are there| strong="H3426" \w* any \w among the vanities| strong="H1892" \w* \w of the Gentiles| strong="H1471" \w* [that can cause rain]{strong=“H1652” x-morph=“strongMorph: \sc Th\sc*8688”}? \w or can the heavens| strong="H8064" \w* [give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w showers| strong="H7241" \w*? art not thou he, O \sc Lord\sc* \w our God| strong="H430" \w*? [therefore we will wait]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8762”} [upon thee: for thou hast made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} all these things.
\c 15
\p 
\v 1 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc* [unto me, Though Moses]{strong=“H4872”} \w and Samuel| strong="H8050" \w* [stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* me, yet \w my mind| strong="H5315" \w* could not be \w toward this people| strong="H5971" \w*: cast them [out]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8761”} \w of my sight| strong="H6440" \w*, [and let them go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 2 [And it shall come to pass, if they say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee, Whither shall we go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”}? [then thou shalt tell]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; Such as are \w for death| strong="H4194" \w*, \w to death| strong="H4194" \w*; and such as are \w for the sword| strong="H2719" \w*, \w to the sword| strong="H2719" \w*; and such as are \w for the famine| strong="H7458" \w*, \w to the famine| strong="H7458" \w*; and such as are \w for the captivity| strong="H7628" \w*, \w to the captivity| strong="H7628" \w*. 
\v 3 [And I will appoint]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} \w over them four| strong="H702" \w* \w kinds| strong="H4940" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: \w the sword| strong="H2719" \w* [to slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8800”}, \w and the dogs| strong="H3611" \w* [to tear]{strong=“H5498” x-morph=“strongMorph: \sc Th\sc*8800”}, \w and the fowls| strong="H5775" \w* \w of the heaven| strong="H8064" \w*, \w and the beasts| strong="H929" \w* \w of the earth| strong="H776" \w*, [to devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} [and destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8687”}.\f + \fr 15:3 \ft kinds: Heb. families \f* 
\v 4 [And I will cause]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [them to be removed]{strong=“H2113 H2189” x-morph=“strongMorph: \sc Th\sc*8675”} \w into all kingdoms| strong="H4467" \w* \w of the earth| strong="H776" \w*, \w because| strong="H1558" \w* \w of Manasseh| strong="H4519" \w* \w the son| strong="H1121" \w* \w of Hezekiah| strong="H3169" \w* \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w*, for that [which he did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w in Jerusalem| strong="H3389" \w*.\f + \fr 15:4 \ft cause…: Heb. give them for a removing \f* 
\v 5 [For who shall have pity]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”} [upon thee, O Jerusalem]{strong=“H3389”}? [or who shall bemoan]{strong=“H5110” x-morph=“strongMorph: \sc Th\sc*8799”} [thee? or who shall go aside]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8799”} [to ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8800”} \w how thou doest| strong="H7965" \w*?\f + \fr 15:5 \ft how…: Heb. of thy peace? \f* 
\v 6 [Thou hast forsaken]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8804”} [me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [thou art gone]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w backward| strong="H268" \w*: [therefore will I stretch out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w my hand| strong="H3027" \w* [against thee, and destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8686”} [thee; I am weary]{strong=“H3811” x-morph=“strongMorph: \sc Th\sc*8738”} [with repenting]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8736”}. 
\v 7 [And I will fan]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8799”} \w them with a fan| strong="H4214" \w* \w in the gates| strong="H8179" \w* \w of the land| strong="H776" \w*; [I will bereave]{strong=“H7921” x-morph=“strongMorph: \sc Th\sc*8765”} them [of children, I will destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8765”} \w my people| strong="H5971" \w*, since [they return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w not from their ways| strong="H1870" \w*.\f + \fr 15:7 \ft children: or, whatsoever is dear \f* 
\v 8 \w Their widows| strong="H490" \w* [are increased]{strong=“H6105” x-morph=“strongMorph: \sc Th\sc*8804”} \w to me above the sand| strong="H2344" \w* \w of the seas| strong="H3220" \w*: [I have brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w upon them against the mother| strong="H517" \w* \w of the young men| strong="H970" \w* [a spoiler]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8802”} \w at noonday| strong="H6672" \w*: I have caused him [to fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8689”} \w upon it suddenly| strong="H6597" \w*, \w and terrors| strong="H928" \w* \w upon the city| strong="H5892" \w*.\f + \fr 15:8 \ft the mother…: or, the mother city a young man spoiling, etc, or, the mother and the young men \f* 
\v 9 [She that hath borne]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”} \w seven| strong="H7651" \w* [languisheth]{strong=“H535” x-morph=“strongMorph: \sc Th\sc*8797”}: [she hath given up]{strong=“H5301” x-morph=“strongMorph: \sc Th\sc*8804”} \w the ghost| strong="H5315" \w*; \w her sun| strong="H8121" \w* [is gone]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} down while it was [yet day]{strong=“H3117 H3119” x-morph=“strongMorph: \sc Th\sc*8676”}: [she hath been ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8804”} [and confounded]{strong=“H2659” x-morph=“strongMorph: \sc Th\sc*8804”}: \w and the residue| strong="H7611" \w* [of them will I deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the sword| strong="H2719" \w* \w before| strong="H6440" \w* [their enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\p
\v 10 \w Woe| strong="H188" \w* [is me, my mother]{strong=“H517”}, [that thou hast borne]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} \w me a man| strong="H376" \w* \w of strife| strong="H7379" \w* \w and a man| strong="H376" \w* \w of contention| strong="H4066" \w* \w to the whole earth| strong="H776" \w*! [I have neither lent on usury]{strong=“H5383” x-morph=“strongMorph: \sc Th\sc*8804”}, [nor men have lent to me on usury]{strong=“H5383” x-morph=“strongMorph: \sc Th\sc*8804”}; yet [every one of them doth curse]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8764”} me. 
\v 11 The \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Verily]{strong=“H518 H3808”} \w it shall be well| strong="H2896" \w* [with thy remnant]{strong=“H8293 H8281” x-morph=“strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8765”}; \w verily| strong="H518" \w* [I will cause the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [to entreat]{strong=“H6293” x-morph=“strongMorph: \sc Th\sc*8689”} thee well \w in the time| strong="H6256" \w* \w of evil| strong="H7451" \w* \w and in the time| strong="H6256" \w* \w of affliction| strong="H6869" \w*.\f + \fr 15:11 \ft cause…: or, intreat the enemy for thee \f* 
\v 12 \w Shall iron| strong="H1270" \w* [break]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8799”} \w the northern| strong="H6828" \w* \w iron| strong="H1270" \w* \w and the steel| strong="H5178" \w*? 
\v 13 \w Thy substance| strong="H2428" \w* \w and thy treasures| strong="H214" \w* [will I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the spoil| strong="H957" \w* \w without price| strong="H4242" \w*, and that \w for all thy sins| strong="H2403" \w*, \w even in all thy borders| strong="H1366" \w*. 
\v 14 And I will make thee [to pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8689”} [with thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w into a land| strong="H776" \w* which [thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [not: for a fire]{strong=“H784”} [is kindled]{strong=“H6919” x-morph=“strongMorph: \sc Th\sc*8804”} \w in mine anger| strong="H639" \w*, which [shall burn]{strong=“H3344” x-morph=“strongMorph: \sc Th\sc*8714”} upon you. 
\p
\v 15 O \sc Lord\sc*, [thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}: [remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”} [me, and visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8798”} [me, and revenge]{strong=“H5358” x-morph=“strongMorph: \sc Th\sc*8734”} [me of my persecutors]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8802”}; [take me not away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [in thy longsuffering]{strong=“H750 H639”}: [know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”} [that for thy sake I have suffered]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8800”} \w rebuke| strong="H2781" \w*. 
\v 16 \w Thy words| strong="H1697" \w* [were found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8738”}, [and I did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [them; and thy word]{strong=“H1697”} \w was unto me the joy| strong="H8342" \w* \w and rejoicing| strong="H8057" \w* \w of mine heart| strong="H3824" \w*: [for I am called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8738”} \w by thy name| strong="H8034" \w*, O \sc Lord\sc* \w God| strong="H430" \w* \w of hosts| strong="H6635" \w*.\f + \fr 15:16 \ft I am…: Heb. thy name is called upon me \f* 
\v 17 [I sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w not in the assembly| strong="H5475" \w* [of the mockers]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8764”}, [nor rejoiced]{strong=“H5937” x-morph=“strongMorph: \sc Th\sc*8799”}; [I sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w alone| strong="H910" \w* \w because| strong="H6440" \w* \w of thy hand| strong="H3027" \w*: [for thou hast filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8765”} \w me with indignation| strong="H2195" \w*. 
\v 18 \w Why is my pain| strong="H3511" \w* \w perpetual| strong="H5331" \w*, \w and my wound| strong="H4347" \w* [incurable]{strong=“H605” x-morph=“strongMorph: \sc Th\sc*8803”}, which [refuseth]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8765”} [to be healed]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8736”}? \w wilt thou be altogether unto me as a liar| strong="H391" \w*, and as \w waters| strong="H4325" \w* that [fail]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8738”}?\f + \fr 15:18 \ft fail: Heb. be not sure? \f* 
\p
\v 19 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [If thou return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [then will I bring thee again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”}, and [thou shalt stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* [me: and if thou take forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w the precious| strong="H3368" \w* [from the vile]{strong=“H2151” x-morph=“strongMorph: \sc Th\sc*8802”}, \w thou shalt be as my mouth| strong="H6310" \w*: [let them return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee; but return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} not thou unto them. 
\v 20 [And I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee unto this people| strong="H5971" \w* [a fenced]{strong=“H1219” x-morph=“strongMorph: \sc Th\sc*8803”} \w brasen| strong="H5178" \w* \w wall| strong="H2346" \w*: [and they shall fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8738”} [against thee, but they shall not prevail]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} against thee: for I am [with thee to save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8687”} [thee and to deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8687”} [thee, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 21 [And I will deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee out of the hand| strong="H3027" \w* \w of the wicked| strong="H7451" \w*, [and I will redeem]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee out of the hand| strong="H3709" \w* \w of the terrible| strong="H6184" \w*. 
\c 16
\p 
\v 1 \w The word| strong="H1697" \w* of the \sc Lord\sc* [came also unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Thou shalt not take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee a wife| strong="H802" \w*, \w neither shalt thou have sons| strong="H1121" \w* \w or daughters| strong="H1323" \w* \w in this place| strong="H4725" \w*. 
\v 3 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w concerning the sons| strong="H1121" \w* \w and concerning the daughters| strong="H1323" \w* [that are born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8688”} \w in this place| strong="H4725" \w*, \w and concerning their mothers| strong="H517" \w* [that bare]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”} [them, and concerning their fathers]{strong=“H1”} \w that begat| strong="H3209" \w* \w them in this land| strong="H776" \w*; 
\v 4 [They shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w of grievous| strong="H8463" \w* \w deaths| strong="H4463" \w*; [they shall not be lamented]{strong=“H5594” x-morph=“strongMorph: \sc Th\sc*8735”}; [neither shall they be buried]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8735”}; but \w they shall be as dung| strong="H1828" \w* \w upon the face| strong="H6440" \w* \w of the earth| strong="H127" \w*: [and they shall be consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w*, \w and by famine| strong="H7458" \w*; \w and their carcases| strong="H5038" \w* \w shall be meat| strong="H3978" \w* \w for the fowls| strong="H5775" \w* \w of heaven| strong="H8064" \w*, \w and for the beasts| strong="H929" \w* \w of the earth| strong="H776" \w*. 
\v 5 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [Enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w not into the house| strong="H1004" \w* \w of mourning| strong="H4798" \w*, [neither go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [to lament]{strong=“H5594” x-morph=“strongMorph: \sc Th\sc*8800”} [nor bemoan]{strong=“H5110” x-morph=“strongMorph: \sc Th\sc*8799”} [them: for I have taken away]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8804”} \w my peace| strong="H7965" \w* \w from this people| strong="H5971" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, even \w lovingkindness| strong="H2617" \w* \w and mercies| strong="H7356" \w*.\f + \fr 16:5 \ft mourning: or, mourning feast \f* 
\v 6 \w Both the great| strong="H1419" \w* \w and the small| strong="H6996" \w* [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”} \w in this land| strong="H776" \w*: [they shall not be buried]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8735”}, neither shall men [lament]{strong=“H5594” x-morph=“strongMorph: \sc Th\sc*8799”} [for them, nor cut]{strong=“H1413” x-morph=“strongMorph: \sc Th\sc*8704”} [themselves, nor make themselves bald]{strong=“H7139” x-morph=“strongMorph: \sc Th\sc*8735”} for them: 
