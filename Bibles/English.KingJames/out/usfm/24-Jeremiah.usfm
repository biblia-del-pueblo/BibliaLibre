\c 26
\p 
\v 1 \w In the beginning| strong="H7225" \w* \w of the reign| strong="H4468" \w* \w of Jehoiakim| strong="H3079" \w* \w the son| strong="H1121" \w* \w of Josiah| strong="H2977" \w* \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w* \w came this word| strong="H1697" \w* from the \sc Lord\sc*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8798”} \w in the court| strong="H2691" \w* of the \sc Lord\sc*’S \w house| strong="H1004" \w*, [and speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto all the cities| strong="H5892" \w* \w of Judah| strong="H3063" \w*, [which come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [to worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8692”} in the \sc Lord\sc*’S \w house| strong="H1004" \w*, \w all the words| strong="H1697" \w* [that I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [thee to speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} [unto them; diminish]{strong=“H1639” x-morph=“strongMorph: \sc Th\sc*8799”} \w not a word| strong="H1697" \w*: 
\v 3 [If so be they will hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}, [and turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w every man| strong="H376" \w* \w from his evil| strong="H7451" \w* \w way| strong="H1870" \w*, [that I may repent]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8738”} \w me of the evil| strong="H7451" \w*, [which I purpose]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8802”} [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto them because| strong="H6440" \w* \w of the evil| strong="H7455" \w* \w of their doings| strong="H4611" \w*. 
\v 4 [And thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [If ye will not hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [to me, to walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} \w in my law| strong="H8451" \w*, [which I have set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* you, 
\v 5 [To hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w to the words| strong="H1697" \w* \w of my servants| strong="H5650" \w* \w the prophets| strong="H5030" \w*, [whom I sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8802”} [unto you, both rising up early]{strong=“H7925” x-morph=“strongMorph: \sc Th\sc*8687”}, [and sending]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8800”} them, [but ye have not hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}; 
\v 6 [Then will I make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w this house| strong="H1004" \w* \w like Shiloh| strong="H7887" \w*, [and will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w this city| strong="H5892" \w* \w a curse| strong="H7045" \w* \w to all the nations| strong="H1471" \w* \w of the earth| strong="H776" \w*. 
\p
\v 7 \w So the priests| strong="H3548" \w* \w and the prophets| strong="H5030" \w* \w and all the people| strong="H5971" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jeremiah| strong="H3414" \w* [speaking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8764”} \w these words| strong="H1697" \w* \w in the house| strong="H1004" \w* of the \sc Lord\sc*. 
\p
\v 8 [Now it came to pass, when Jeremiah]{strong=“H3414”} [had made an end]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8763”} [of speaking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} all that the \sc Lord\sc* [had commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} him [to speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w unto all the people| strong="H5971" \w*, \w that the priests| strong="H3548" \w* \w and the prophets| strong="H5030" \w* \w and all the people| strong="H5971" \w* [took]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8799”} [him, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Thou shalt surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 9 [Why hast thou prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the name| strong="H8034" \w* of the \sc Lord\sc*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w This house| strong="H1004" \w* \w shall be like Shiloh| strong="H7887" \w*, \w and this city| strong="H5892" \w* [shall be desolate]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8799”} [without an inhabitant]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”}? \w And all the people| strong="H5971" \w* [were gathered]{strong=“H6950” x-morph=“strongMorph: \sc Th\sc*8735”} \w against Jeremiah| strong="H3414" \w* \w in the house| strong="H1004" \w* of the \sc Lord\sc*. 
\p
\v 10 \w When the princes| strong="H8269" \w* \w of Judah| strong="H3063" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w these things| strong="H1697" \w*, [then they came up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} [from the king’s]{strong=“H4428”} \w house| strong="H1004" \w* \w unto the house| strong="H1004" \w* of the \sc Lord\sc*, [and sat down]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the entry| strong="H6607" \w* \w of the new| strong="H2319" \w* \w gate| strong="H8179" \w* of the \sc Lord\sc*’S house.\f + \fr 26:10 \ft in the…: or, at the door \f* 
\v 11 [Then spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w the priests| strong="H3548" \w* \w and the prophets| strong="H5030" \w* \w unto the princes| strong="H8269" \w* \w and to all the people| strong="H5971" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w This man| strong="H376" \w* is \w worthy| strong="H4941" \w* \w to die| strong="H4194" \w*; [for he hath prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8738”} \w against this city| strong="H5892" \w*, [as ye have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w with your ears| strong="H241" \w*.\f + \fr 26:11 \ft This man…: Heb. The judgment of death is for this man \f* 
\p
\v 12 [Then spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jeremiah| strong="H3414" \w* \w unto all the princes| strong="H8269" \w* \w and to all the people| strong="H5971" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, The \sc Lord\sc* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [me to prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8736”} \w against this house| strong="H1004" \w* \w and against this city| strong="H5892" \w* \w all the words| strong="H1697" \w* [that ye have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 13 [Therefore now amend]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8685”} \w your ways| strong="H1870" \w* \w and your doings| strong="H4611" \w*, [and obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the voice| strong="H6963" \w* of the \sc Lord\sc* \w your God| strong="H430" \w*; and the \sc Lord\sc* [will repent]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8735”} \w him of the evil| strong="H7451" \w* [that he hath pronounced]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} against you. 
\v 14 As for me, behold, I am \w in your hand| strong="H3027" \w*: [do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} \w with me as seemeth| strong="H5869" \w* \w good| strong="H2896" \w* \w and meet| strong="H3477" \w* unto you.\f + \fr 26:14 \ft as…: Heb. as it is good and right in your eyes \f* 
\v 15 [But know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [ye for certain]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”}, [that if ye put me to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8688”}, [ye shall surely bring]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w innocent| strong="H5355" \w* \w blood| strong="H1818" \w* [upon yourselves, and upon this city]{strong=“H5892”}, [and upon the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} [thereof: for of a truth]{strong=“H571”} the \sc Lord\sc* [hath sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [me unto you to speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w all these words| strong="H1697" \w* \w in your ears| strong="H241" \w*. 
\p
\v 16 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w the princes| strong="H8269" \w* \w and all the people| strong="H5971" \w* \w unto the priests| strong="H3548" \w* \w and to the prophets| strong="H5030" \w*; \w This man| strong="H376" \w* is \w not worthy| strong="H4941" \w* \w to die| strong="H4194" \w*: [for he hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w to us in the name| strong="H8034" \w* of the \sc Lord\sc* \w our God| strong="H430" \w*. 
