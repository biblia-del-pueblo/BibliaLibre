\v 16 [Then took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w Johanan| strong="H3110" \w* \w the son| strong="H1121" \w* \w of Kareah| strong="H7143" \w*, \w and all the captains| strong="H8269" \w* \w of the forces| strong="H2428" \w* that were [with him, all the remnant]{strong=“H7611”} \w of the people| strong="H5971" \w* [whom he had recovered]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} \w from Ishmael| strong="H3458" \w* \w the son| strong="H1121" \w* \w of Nethaniah| strong="H5418" \w*, \w from Mizpah| strong="H4709" \w*, \w after| strong="H310" \w* that [he had slain]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w Gedaliah| strong="H1436" \w* \w the son| strong="H1121" \w* \w of Ahikam| strong="H296" \w*, even \w mighty| strong="H1397" \w* \w men| strong="H582" \w* \w of war| strong="H4421" \w*, \w and the women| strong="H802" \w*, \w and the children| strong="H2945" \w*, \w and the eunuchs| strong="H5631" \w*, [whom he had brought again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} \w from Gibeon| strong="H1391" \w*: 
