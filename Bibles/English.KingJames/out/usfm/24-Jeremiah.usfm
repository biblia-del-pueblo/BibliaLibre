\v 4 [And I will set up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} [shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [over them which shall feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8804”} [them: and they shall fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [no more, nor be dismayed]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8735”}, [neither shall they be lacking]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8735”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\p
