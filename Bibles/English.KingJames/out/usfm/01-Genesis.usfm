\c 2
\p 
\v 1 \w Thus the heavens| strong="H8064" \w* \w and the earth| strong="H776" \w* [were finished]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8792”}, \w and all the host of them| strong="H6635" \w*. 
\v 2 \w And on the seventh| strong="H7637" \w* \w day| strong="H3117" \w* \w God| strong="H430" \w* [ended]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8762”} \w his work| strong="H4399" \w* [which he had made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}; [and he rested]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8799”} \w on the seventh| strong="H7637" \w* \w day| strong="H3117" \w* \w from all his work| strong="H4399" \w* [which he had made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 3 \w And God| strong="H430" \w* [blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w the seventh| strong="H7637" \w* \w day| strong="H3117" \w*, [and sanctified]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8762”} [it: because]{strong=“H3588”} [that in it he had rested]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8804”} \w from all his work| strong="H4399" \w* \w which God| strong="H430" \w* [created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8804”} [and made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 2:3 \ft created…: Heb. created to make \f* 
\p
\v 4 \w These| strong="H428" \w* are \w the generations| strong="H8435" \w* \w of the heavens| strong="H8064" \w* \w and of the earth| strong="H776" \w* [when they were created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8736”}, \w in the day| strong="H3117" \w* that the \sc Lord\sc* \w God| strong="H430" \w* [made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w the earth| strong="H776" \w* \w and the heavens| strong="H8064" \w*, 
\v 5 \w And every plant| strong="H7880" \w* \w of the field| strong="H7704" \w* \w before| strong="H2962" \w* \w it was in the earth| strong="H776" \w*, \w and every herb| strong="H6212" \w* \w of the field| strong="H7704" \w* \w before| strong="H2962" \w* [it grew]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8799”}: \w for| strong="H3588" \w* the \sc Lord\sc* \w God| strong="H430" \w* \w had not| strong="H3808" \w* [caused it to rain]{strong=“H4305” x-morph=“strongMorph: \sc Th\sc*8689”} \w upon the earth| strong="H776" \w*, and there was \w not| strong="H369" \w* \w a man| strong="H120" \w* [to till]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8800”} \w the ground| strong="H127" \w*. 
\v 6 [But there went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w a mist| strong="H108" \w* \w from| strong="H4480" \w* \w the earth| strong="H776" \w*, [and watered]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8689”} \w the whole face| strong="H6440" \w* \w of the ground| strong="H127" \w*.\f + \fr 2:6 \ft there…: or, a mist which went up from, etc. \f* 
