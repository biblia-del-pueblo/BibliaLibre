\v 30 \w And Israel| strong="H3478" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Joseph| strong="H3130" \w*, \w Now| strong="H6471" \w* [let me die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, \w since| strong="H310" \w* [I have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy face| strong="H6440" \w*, because thou art \w yet| strong="H5750" \w* \w alive| strong="H2416" \w*. 
\v 31 \w And Joseph| strong="H3130" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his brethren| strong="H251" \w*, [and unto his father’s]{strong=“H1”} \w house| strong="H1004" \w*, [I will go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”}, [and shew]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w Pharaoh| strong="H6547" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, My brethren]{strong=“H251”}, [and my father’s]{strong=“H1”} \w house| strong="H1004" \w*, which were \w in the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*, [are come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} unto me; 
\v 32 \w And the men| strong="H582" \w* are [shepherds]{strong=“H6629 H7462” x-morph=“strongMorph: \sc Th\sc*8802”}, \w for their trade hath been to feed cattle| strong="H4735" \w*; [and they have brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w their flocks| strong="H6629" \w*, \w and their herds| strong="H1241" \w*, and all that they have.\f + \fr 46:32 \ft their trade…: Heb. they are men of cattle \f* 
\v 33 [And it shall come to pass, when Pharaoh]{strong=“H6547”} [shall call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} [you, and shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, What is \w your occupation| strong="H4639" \w*? 
\v 34 [That ye shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Thy servants’]{strong=“H5650”} \w trade| strong="H582" \w* \w hath been about cattle| strong="H4735" \w* \w from our youth| strong="H5271" \w* even until now, both we, and \w also our fathers| strong="H1" \w*: [that ye may dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the land| strong="H776" \w* \w of Goshen| strong="H1657" \w*; [for every shepherd]{strong=“H6629 H7462” x-morph=“strongMorph: \sc Th\sc*8802”} is \w an abomination| strong="H8441" \w* \w unto the Egyptians| strong="H4714" \w*.
\c 47
\p 
\v 1 \w Then Joseph| strong="H3130" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w Pharaoh| strong="H6547" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w My father| strong="H1" \w* \w and my brethren| strong="H251" \w*, \w and their flocks| strong="H6629" \w*, \w and their herds| strong="H1241" \w*, [and all that they have, are come out]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*; and, behold, they are \w in the land| strong="H776" \w* \w of Goshen| strong="H1657" \w*. 
\v 2 [And he took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w some| strong="H7097" \w* \w of his brethren| strong="H251" \w*, even \w five| strong="H2568" \w* \w men| strong="H582" \w*, [and presented]{strong=“H3322” x-morph=“strongMorph: \sc Th\sc*8686”} \w them unto| strong="H6440" \w* \w Pharaoh| strong="H6547" \w*. 
\v 3 \w And Pharaoh| strong="H6547" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his brethren| strong="H251" \w*, What is \w your occupation| strong="H4639" \w*? [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Pharaoh| strong="H6547" \w*, \w Thy servants| strong="H5650" \w* are [shepherds]{strong=“H6629 H7462” x-morph=“strongMorph: \sc Th\sc*8802”}, both we, and \w also our fathers| strong="H1" \w*. 
\v 4 [They said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w moreover unto Pharaoh| strong="H6547" \w*, [For to sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the land| strong="H776" \w* [are we come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}; \w for thy servants| strong="H5650" \w* \w have no pasture| strong="H4829" \w* \w for their flocks| strong="H6629" \w*; \w for the famine| strong="H7458" \w* is \w sore| strong="H3515" \w* \w in the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*: [now therefore, we pray thee, let thy servants]{strong=“H5650”} [dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the land| strong="H776" \w* \w of Goshen| strong="H1657" \w*. 
\v 5 \w And Pharaoh| strong="H6547" \w* [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Joseph| strong="H3130" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Thy father| strong="H1" \w* \w and thy brethren| strong="H251" \w* [are come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} unto thee: 
\v 6 \w The land| strong="H776" \w* \w of Egypt| strong="H4714" \w* is \w before thee| strong="H6440" \w*; \w in the best| strong="H4315" \w* \w of the land| strong="H776" \w* \w make| strong="H3427" \w* \w thy father| strong="H1" \w* \w and brethren| strong="H251" \w* [to dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8685”}; \w in the land| strong="H776" \w* \w of Goshen| strong="H1657" \w* [let them dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”}: [and if thou knowest]{strong=“H3426 H3045” x-morph=“strongMorph: \sc Th\sc*8804”} any \w men| strong="H582" \w* \w of activity| strong="H2428" \w* [among them, then make them]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w rulers| strong="H8269" \w* \w over my cattle| strong="H4735" \w*. 
\v 7 \w And Joseph| strong="H3130" \w* [brought in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w Jacob| strong="H3290" \w* \w his father| strong="H1" \w*, [and set him]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8686”} \w before| strong="H6440" \w* \w Pharaoh| strong="H6547" \w*: \w and Jacob| strong="H3290" \w* [blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w Pharaoh| strong="H6547" \w*. 
\v 8 \w And Pharaoh| strong="H6547" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Jacob| strong="H3290" \w*, \w How| strong="H4100" \w* [old]{strong=“H8141 H3117 H2416”} art thou?\f + \fr 47:8 \ft How…: Heb. How many are the days of the years of thy life? \f* 
\v 9 \w And Jacob| strong="H3290" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Pharaoh| strong="H6547" \w*, \w The days| strong="H3117" \w* \w of the years| strong="H8141" \w* \w of my pilgrimage| strong="H4033" \w* are \w an hundred| strong="H3967" \w* \w and thirty| strong="H7970" \w* \w years| strong="H8141" \w*: \w few| strong="H4592" \w* \w and evil| strong="H7451" \w* \w have the days| strong="H3117" \w* \w of the years| strong="H8141" \w* \w of my life| strong="H2416" \w* [been, and have not attained]{strong=“H5381” x-morph=“strongMorph: \sc Th\sc*8689”} \w unto the days| strong="H3117" \w* \w of the years| strong="H8141" \w* \w of the life| strong="H2416" \w* \w of my fathers| strong="H1" \w* \w in the days| strong="H3117" \w* \w of their pilgrimage| strong="H4033" \w*. 
\v 10 \w And Jacob| strong="H3290" \w* [blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w Pharaoh| strong="H6547" \w*, [and went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w from before| strong="H6440" \w* \w Pharaoh| strong="H6547" \w*. 
\p
\v 11 \w And Joseph| strong="H3130" \w* [placed]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8686”} \w his father| strong="H1" \w* \w and his brethren| strong="H251" \w*, [and gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w them a possession| strong="H272" \w* \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, \w in the best| strong="H4315" \w* \w of the land| strong="H776" \w*, \w in the land| strong="H776" \w* \w of Rameses| strong="H7486" \w*, \w as Pharaoh| strong="H6547" \w* [had commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 12 \w And Joseph| strong="H3130" \w* [nourished]{strong=“H3557” x-morph=“strongMorph: \sc Th\sc*8770”} \w his father| strong="H1" \w*, \w and his brethren| strong="H251" \w*, [and all his father’s]{strong=“H1”} \w household| strong="H1004" \w*, \w with bread| strong="H3899" \w*, \w according| strong="H6310" \w* to their \w families| strong="H2945" \w*.\f + \fr 47:12 \ft according…: or, as a little child is nourished: Heb. according to the little ones \f* 
\p
\v 13 And there was \w no bread| strong="H3899" \w* \w in all the land| strong="H776" \w*; \w for the famine| strong="H7458" \w* was \w very| strong="H3966" \w* \w sore| strong="H3515" \w*, \w so that the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* and all \w the land| strong="H776" \w* \w of Canaan| strong="H3667" \w* [fainted]{strong=“H3856” x-morph=“strongMorph: \sc Th\sc*8799”} \w by reason| strong="H6440" \w* \w of the famine| strong="H7458" \w*. 
\v 14 \w And Joseph| strong="H3130" \w* [gathered up]{strong=“H3950” x-morph=“strongMorph: \sc Th\sc*8762”} \w all the money| strong="H3701" \w* [that was found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8737”} \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, \w and in the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*, \w for the corn| strong="H7668" \w* [which they bought]{strong=“H7666” x-morph=“strongMorph: \sc Th\sc*8802”}: \w and Joseph| strong="H3130" \w* [brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w the money| strong="H3701" \w* [into Pharaoh’s]{strong=“H6547”} \w house| strong="H1004" \w*. 
\v 15 \w And when money| strong="H3701" \w* [failed]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, \w and in the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*, \w all the Egyptians| strong="H4714" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Joseph| strong="H3130" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Give]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”} \w us bread| strong="H3899" \w*: [for why should we die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} [in thy presence? for the money]{strong=“H3701”} [faileth]{strong=“H656” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 16 \w And Joseph| strong="H3130" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Give]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”} \w your cattle| strong="H4735" \w*; [and I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w you for your cattle| strong="H4735" \w*, \w if money| strong="H3701" \w* [fail]{strong=“H656” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 17 [And they brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w their cattle| strong="H4735" \w* \w unto Joseph| strong="H3130" \w*: \w and Joseph| strong="H3130" \w* [gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w them bread| strong="H3899" \w* in exchange \w for horses| strong="H5483" \w*, \w and for the flocks| strong="H6629" \w*, \w and for the cattle| strong="H4735" \w* \w of the herds| strong="H1241" \w*, \w and for the asses| strong="H2543" \w*: [and he fed]{strong=“H5095” x-morph=“strongMorph: \sc Th\sc*8762”} \w them with bread| strong="H3899" \w* \w for all their cattle| strong="H4735" \w* \w for that year| strong="H8141" \w*.\f + \fr 47:17 \ft fed…: Heb. led them \f* 
\v 18 \w When that year| strong="H8141" \w* [was ended]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8799”}, [they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto him the second| strong="H8145" \w* \w year| strong="H8141" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, We will not hide]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8762”} it \w from my lord| strong="H113" \w*, \w how that our money| strong="H3701" \w* [is spent]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8804”}; \w my lord| strong="H113" \w* \w also hath| strong="H413" \w* \w our herds| strong="H4735" \w* \w of cattle| strong="H929" \w*; [there is not ought left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the sight| strong="H6440" \w* \w of my lord| strong="H113" \w*, \w but our bodies| strong="H1472" \w*, \w and our lands| strong="H127" \w*: 
\v 19 [Wherefore shall we die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w before thine eyes| strong="H5869" \w*, \w both we and our land| strong="H127" \w*? [buy]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8798”} \w us and our land| strong="H127" \w* \w for bread| strong="H3899" \w*, \w and we and our land| strong="H127" \w* \w will be servants| strong="H5650" \w* \w unto Pharaoh| strong="H6547" \w*: [and give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} us \w seed| strong="H2233" \w*, [that we may live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}, [and not die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, \w that the land| strong="H127" \w* [be not desolate]{strong=“H3456” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 20 \w And Joseph| strong="H3130" \w* [bought]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the land| strong="H127" \w* \w of Egypt| strong="H4714" \w* \w for Pharaoh| strong="H6547" \w*; \w for the Egyptians| strong="H4714" \w* [sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8804”} \w every man| strong="H376" \w* \w his field| strong="H7704" \w*, \w because the famine| strong="H7458" \w* [prevailed]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8804”} [over them: so the land]{strong=“H776”} [became Pharaoh’s]{strong=“H6547”}. 
\v 21 \w And as for the people| strong="H5971" \w*, [he removed]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8689”} \w them to cities| strong="H5892" \w* from one \w end| strong="H7097" \w* \w of the borders| strong="H1366" \w* \w of Egypt| strong="H4714" \w* even to the other \w end| strong="H7097" \w* thereof. 
\v 22 \w Only the land| strong="H127" \w* \w of the priests| strong="H3548" \w* [bought he]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8804”} [not; for the priests]{strong=“H3548”} \w had a portion| strong="H2706" \w* assigned them \w of Pharaoh| strong="H6547" \w*, [and did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w their portion| strong="H2706" \w* \w which Pharaoh| strong="H6547" \w* [gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [them: wherefore they sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8804”} \w not their lands| strong="H127" \w*.\f + \fr 47:22 \ft priests: or, princes \f* 
\v 23 \w Then Joseph| strong="H3130" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the people| strong="H5971" \w*, [Behold, I have bought]{strong=“H853 H7069” x-morph=“strongMorph: \sc Th\sc*8804”} \w you this day| strong="H3117" \w* \w and your land| strong="H127" \w* \w for Pharaoh| strong="H6547" \w*: \w lo| strong="H1887" \w*, here is \w seed| strong="H2233" \w* [for you, and ye shall sow]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8804”} \w the land| strong="H127" \w*. 
\v 24 \w And it shall come to pass in the increase| strong="H8393" \w*, [that ye shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w the fifth| strong="H2549" \w* part \w unto Pharaoh| strong="H6547" \w*, \w and four| strong="H702" \w* \w parts| strong="H3027" \w* [shall be your own, for seed]{strong=“H2233”} \w of the field| strong="H7704" \w*, \w and for your food| strong="H400" \w*, \w and for them of your households| strong="H1004" \w*, [and for food]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} \w for your little ones| strong="H2945" \w*. 
\v 25 [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Thou hast saved our lives]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8689”}: [let us find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w grace| strong="H2580" \w* \w in the sight| strong="H5869" \w* \w of my lord| strong="H113" \w*, [and we will be Pharaoh’s]{strong=“H6547”} \w servants| strong="H5650" \w*. 
\v 26 \w And Joseph| strong="H3130" \w* [made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w it a law| strong="H2706" \w* \w over the land| strong="H127" \w* \w of Egypt| strong="H4714" \w* \w unto this day| strong="H3117" \w*, that \w Pharaoh| strong="H6547" \w* \w should have the fifth| strong="H2569" \w* part; \w except| strong="H7535" \w* \w the land| strong="H127" \w* \w of the priests| strong="H3548" \w* only, which [became not Pharaoh’s]{strong=“H6547”}.\f + \fr 47:26 \ft priests: or, princes \f* 
\p
\v 27 \w And Israel| strong="H3478" \w* [dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, \w in the country| strong="H776" \w* \w of Goshen| strong="H1657" \w*; [and they had possessions]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8735”} [therein, and grew]{strong=“H6509” x-morph=“strongMorph: \sc Th\sc*8799”}, [and multiplied]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8799”} \w exceedingly| strong="H3966" \w*. 
\v 28 \w And Jacob| strong="H3290" \w* [lived]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* [seventeen]{strong=“H7651 H6240”} \w years| strong="H8141" \w*: [so the whole age]{strong=“H3117 H2416”} \w of Jacob| strong="H3290" \w* \w was an hundred| strong="H3967" \w* [forty]{strong=“H8141 H705”} \w and seven| strong="H7651" \w* \w years| strong="H8141" \w*.\f + \fr 47:28 \ft the whole…: Heb. the days of the years of his life \f* 
\v 29 \w And the time| strong="H3117" \w* [drew nigh]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} \w that Israel| strong="H3478" \w* [must die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”}: [and he called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w his son| strong="H1121" \w* \w Joseph| strong="H3130" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, If now I have found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w grace| strong="H2580" \w* \w in thy sight| strong="H5869" \w*, [put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”}, [I pray thee, thy hand]{strong=“H3027”} \w under my thigh| strong="H3409" \w*, [and deal]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w kindly| strong="H2617" \w* \w and truly| strong="H571" \w* [with me; bury]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8799”} [me not, I pray thee, in Egypt]{strong=“H4714”}: 
\v 30 [But I will lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8804”} \w with my fathers| strong="H1" \w*, [and thou shalt carry]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w me out of Egypt| strong="H4714" \w*, [and bury]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8804”} \w me in their buryingplace| strong="H6900" \w*. [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w as thou hast said| strong="H1697" \w*. 
\v 31 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8734”} [unto me. And he sware]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8735”} [unto him. And Israel]{strong=“H3478”} [bowed]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} [himself upon the bed’s]{strong=“H4296”} \w head| strong="H7218" \w*.
\c 48
\p 
\v 1 \w And it came to pass after| strong="H310" \w* \w these things| strong="H1697" \w*, that one [told]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Joseph| strong="H3130" \w*, [Behold, thy father]{strong=“H1”} is [sick]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8802”}: [and he took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w with him his two| strong="H8147" \w* \w sons| strong="H1121" \w*, \w Manasseh| strong="H4519" \w* \w and Ephraim| strong="H669" \w*. 
\v 2 And one [told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w Jacob| strong="H3290" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Behold, thy son]{strong=“H1121”} \w Joseph| strong="H3130" \w* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [unto thee: and Israel]{strong=“H3478”} [strengthened ]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8691”} [himself, and sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the bed| strong="H4296" \w*. 
\v 3 \w And Jacob| strong="H3290" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Joseph| strong="H3130" \w*, \w God| strong="H410" \w* \w Almighty| strong="H7706" \w* [appeared]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto me at Luz| strong="H3870" \w* \w in the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*, [and blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} me, 
\v 4 [And said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Behold, I will make thee fruitful]{strong=“H6509” x-morph=“strongMorph: \sc Th\sc*8688”}, [and multiply]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8689”} [thee, and I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w of thee a multitude| strong="H6951" \w* \w of people| strong="H5971" \w*; [and will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w this land| strong="H776" \w* \w to thy seed| strong="H2233" \w* \w after thee| strong="H310" \w* for \w an everlasting| strong="H5769" \w* \w possession| strong="H272" \w*. 
\p
\v 5 \w And now thy two| strong="H8147" \w* \w sons| strong="H1121" \w*, \w Ephraim| strong="H669" \w* \w and Manasseh| strong="H4519" \w*, [which were born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8737”} \w unto thee in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* \w before| strong="H5704" \w* [I came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto thee into Egypt| strong="H4714" \w*, are [mine; as Reuben]{strong=“H7205”} \w and Simeon| strong="H8095" \w*, they shall be mine. 
\v 6 \w And thy issue| strong="H4138" \w*, [which thou begettest]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8689”} \w after| strong="H310" \w* them, shall be thine, and [shall be called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8735”} \w after| strong="H5921" \w* \w the name| strong="H8034" \w* \w of their brethren| strong="H251" \w* \w in their inheritance| strong="H5159" \w*. 
\v 7 [And as for me, when I came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w from Padan| strong="H6307" \w*, \w Rachel| strong="H7354" \w* [died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”} \w by me in the land| strong="H776" \w* \w of Canaan| strong="H3667" \w* \w in the way| strong="H1870" \w*, \w when| strong="H5750" \w* yet there was \w but a little| strong="H3530" \w* \w way| strong="H776" \w* [to come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto Ephrath| strong="H672" \w*: [and I buried her]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8799”} \w there in the way| strong="H1870" \w* \w of Ephrath| strong="H672" \w*; the same is [Beth-lehem]{strong=“H1035”}. 
\p
\v 8 \w And Israel| strong="H3478" \w* [beheld]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [Joseph’s]{strong=“H3130”} \w sons| strong="H1121" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Who are these? 
\v 9 \w And Joseph| strong="H3130" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his father| strong="H1" \w*, They are \w my sons| strong="H1121" \w*, \w whom God| strong="H430" \w* [hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} me in this place. [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Bring them]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”}, [I pray thee, unto me, and I will bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} them. 
\v 10 \w Now the eyes| strong="H5869" \w* \w of Israel| strong="H3478" \w* [were dim]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8804”} \w for age| strong="H2207" \w*, so that [he could]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [not see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”}. [And he brought them near]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8686”} [unto him; and he kissed]{strong=“H5401” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and embraced]{strong=“H2263” x-morph=“strongMorph: \sc Th\sc*8762”} them.\f + \fr 48:10 \ft dim: Heb. heavy \f* 
\v 11 \w And Israel| strong="H3478" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Joseph| strong="H3130" \w*, [I had not thought]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8765”} [to see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy face| strong="H6440" \w*: [and, lo, God]{strong=“H430”} [hath shewed]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8689”} \w me also thy seed| strong="H2233" \w*. 
\v 12 \w And Joseph| strong="H3130" \w* [brought them out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w from between| strong="H5973" \w* \w his knees| strong="H1290" \w*, [and he bowed]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} \w himself with his face| strong="H639" \w* \w to the earth| strong="H776" \w*. 
\v 13 \w And Joseph| strong="H3130" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w them both| strong="H8147" \w*, \w Ephraim| strong="H669" \w* \w in his right hand| strong="H3225" \w* [toward Israel’s]{strong=“H3478”} \w left hand| strong="H8040" \w*, \w and Manasseh| strong="H4519" \w* \w in his left hand| strong="H8040" \w* [toward Israel’s]{strong=“H3478”} \w right hand| strong="H3225" \w*, and brought them [near]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8686”} unto him. 
\v 14 \w And Israel| strong="H3478" \w* [stretched out]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w his right hand| strong="H3225" \w*, [and laid]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} it [upon Ephraim’s]{strong=“H669”} \w head| strong="H7218" \w*, who was \w the younger| strong="H6810" \w*, \w and his left hand| strong="H8040" \w* [upon Manasseh’s]{strong=“H4519”} \w head| strong="H7218" \w*, \w guiding| strong="H7919" \w* \w his hands| strong="H3027" \w* [wittingly]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8765”}; \w for Manasseh| strong="H4519" \w* was \w the firstborn| strong="H1060" \w*. 
\p
\v 15 [And he blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w Joseph| strong="H3130" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w God| strong="H430" \w*, \w before| strong="H6440" \w* \w whom my fathers| strong="H1" \w* \w Abraham| strong="H85" \w* \w and Isaac| strong="H3327" \w* [did walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8694”}, \w the God| strong="H430" \w* [which fed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} \w me all my life long| strong="H5750" \w* \w unto this day| strong="H3117" \w*, 
\v 16 \w The Angel| strong="H4397" \w* [which redeemed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”} \w me from all evil| strong="H7451" \w*, [bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w the lads| strong="H5288" \w*; \w and let my name| strong="H8034" \w* [be named]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8735”} [on them, and the name]{strong=“H8034”} \w of my fathers| strong="H1" \w* \w Abraham| strong="H85" \w* \w and Isaac| strong="H3327" \w*; [and let them grow]{strong=“H1711” x-morph=“strongMorph: \sc Th\sc*8799”} \w into a multitude| strong="H7230" \w* \w in the midst| strong="H7130" \w* \w of the earth| strong="H776" \w*.\f + \fr 48:16 \ft grow: Heb. as fishes do increase \f* 
\v 17 \w And when Joseph| strong="H3130" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w that his father| strong="H1" \w* [laid]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w his right| strong="H3225" \w* \w hand| strong="H3027" \w* \w upon the head| strong="H7218" \w* \w of Ephraim| strong="H669" \w*, [it displeased]{strong=“H5869 H3415” x-morph=“strongMorph: \sc Th\sc*8799”} [him: and he held up]{strong=“H8551” x-morph=“strongMorph: \sc Th\sc*8799”} [his father’s]{strong=“H1”} \w hand| strong="H3027" \w*, [to remove]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8687”} [it from Ephraim’s]{strong=“H669”} \w head| strong="H7218" \w* [unto Manasseh’s]{strong=“H4519”} \w head| strong="H7218" \w*.\f + \fr 48:17 \ft displeased…: was evil in his eyes \f* 
\v 18 \w And Joseph| strong="H3130" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his father| strong="H1" \w*, [Not so, my father]{strong=“H1”}: for this is \w the firstborn| strong="H1060" \w*; [put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy right hand| strong="H3225" \w* \w upon his head| strong="H7218" \w*. 
\v 19 \w And his father| strong="H1" \w* [refused]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8762”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} it, \w my son| strong="H1121" \w*, [I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} it: \w he also shall become a people| strong="H5971" \w*, [and he also shall be great]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8799”}: \w but truly| strong="H199" \w* \w his younger| strong="H6996" \w* \w brother| strong="H251" \w* [shall be greater]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8799”} [than he, and his seed]{strong=“H2233”} \w shall become a multitude| strong="H4393" \w* \w of nations| strong="H1471" \w*.\f + \fr 48:19 \ft multitude: Heb. fulness \f* 
\v 20 [And he blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w them that day| strong="H3117" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w In thee shall Israel| strong="H3478" \w* [bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w God| strong="H430" \w* [make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee as Ephraim| strong="H669" \w* \w and as Manasseh| strong="H4519" \w*: [and he set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w Ephraim| strong="H669" \w* \w before| strong="H6440" \w* \w Manasseh| strong="H4519" \w*. 
\v 21 \w And Israel| strong="H3478" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Joseph| strong="H3130" \w*, [Behold, I die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”}: \w but God| strong="H430" \w* [shall be with you, and bring you again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} \w unto the land| strong="H776" \w* \w of your fathers| strong="H1" \w*. 
\v 22 [Moreover I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w to thee one| strong="H259" \w* \w portion| strong="H7926" \w* \w above thy brethren| strong="H251" \w*, [which I took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w out of the hand| strong="H3027" \w* \w of the Amorite| strong="H567" \w* \w with my sword| strong="H2719" \w* \w and with my bow| strong="H7198" \w*.
\c 49
\p 
\v 1 \w And Jacob| strong="H3290" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his sons| strong="H1121" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Gather yourselves together]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8734”}, [that I may tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} you that [which shall befall]{strong=“H7122” x-morph=“strongMorph: \sc Th\sc*8799”} \w you in the last| strong="H319" \w* \w days| strong="H3117" \w*. 
\v 2 [Gather yourselves together]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8734”}, [and hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, \w ye sons| strong="H1121" \w* \w of Jacob| strong="H3290" \w*; [and hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto Israel| strong="H3478" \w* \w your father| strong="H1" \w*. 
\p
\v 3 \w Reuben| strong="H7205" \w*, thou art \w my firstborn| strong="H1060" \w*, \w my might| strong="H3581" \w*, \w and the beginning| strong="H7225" \w* \w of my strength| strong="H202" \w*, \w the excellency| strong="H3499" \w* \w of dignity| strong="H7613" \w*, \w and the excellency| strong="H3499" \w* \w of power| strong="H5794" \w*: 
\v 4 \w Unstable| strong="H6349" \w* \w as water| strong="H4325" \w*, [thou shalt not excel]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8686”}; [because thou wentest up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} [to thy father’s]{strong=“H1”} \w bed| strong="H4904" \w*; [then defiledst thou]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8765”} it: [he went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w to my couch| strong="H3326" \w*.\f + \fr 49:4 \ft thou shalt…: Heb. do not thou excel \f* \f + \fr 49:4 \ft he went…: or, my couch is gone \f* 
\p
\v 5 \w Simeon| strong="H8095" \w* \w and Levi| strong="H3878" \w* are \w brethren| strong="H251" \w*; \w instruments| strong="H3627" \w* \w of cruelty| strong="H2555" \w* are in \w their habitations| strong="H4380" \w*.\f + \fr 49:5 \ft instruments…: or, their swords are weapons of violence \f* 
\v 6 \w O my soul| strong="H5315" \w*, [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w not thou into their secret| strong="H5475" \w*; \w unto their assembly| strong="H6951" \w*, \w mine honour| strong="H3519" \w*, [be not thou united]{strong=“H3161” x-morph=“strongMorph: \sc Th\sc*8799”}: \w for in their anger| strong="H639" \w* [they slew]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”} \w a man| strong="H376" \w*, \w and in their selfwill| strong="H7522" \w* [they digged down]{strong=“H6131” x-morph=“strongMorph: \sc Th\sc*8765”} \w a wall| strong="H7794" \w*.\f + \fr 49:6 \ft digged…: or, houghed oxen \f* 
\v 7 [Cursed]{strong=“H779” x-morph=“strongMorph: \sc Th\sc*8803”} be \w their anger| strong="H639" \w*, for it was \w fierce| strong="H5794" \w*; \w and their wrath| strong="H5678" \w*, [for it was cruel]{strong=“H7185” x-morph=“strongMorph: \sc Th\sc*8804”}: [I will divide]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8762”} \w them in Jacob| strong="H3290" \w*, [and scatter]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8686”} \w them in Israel| strong="H3478" \w*. 
\p
\v 8 \w Judah| strong="H3063" \w*, thou art he \w whom thy brethren| strong="H251" \w* [shall praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”}: \w thy hand| strong="H3027" \w* shall be \w in the neck| strong="H6203" \w* [of thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}; [thy father’s]{strong=“H1”} \w children| strong="H1121" \w* [shall bow down]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} before thee. 
