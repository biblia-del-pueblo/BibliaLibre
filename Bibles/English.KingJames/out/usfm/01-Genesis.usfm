\v 26 \w And Laban| strong="H3837" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Jacob| strong="H3290" \w*, [What hast thou done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [that thou hast stolen away]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8799”} \w unawares| strong="H3824" \w* [to me, and carried away]{strong=“H5090” x-morph=“strongMorph: \sc Th\sc*8762”} \w my daughters| strong="H1323" \w*, [as captives]{strong=“H7617” x-morph=“strongMorph: \sc Th\sc*8803”} taken \w with the sword| strong="H2719" \w*? 
\v 27 [Wherefore didst thou flee away]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8800”} [secretly]{strong=“H2244” x-morph=“strongMorph: \sc Th\sc*8738”}, [and steal away]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8799”} [from me; and didst not tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} [me, that I might have sent thee away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w with mirth| strong="H8057" \w*, \w and with songs| strong="H7892" \w*, \w with tabret| strong="H8596" \w*, \w and with harp| strong="H3658" \w*?\f + \fr 31:27 \ft steal…: Heb. hast stolen me \f* 
\v 28 [And hast not suffered]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8804”} [me to kiss]{strong=“H5401” x-morph=“strongMorph: \sc Th\sc*8763”} \w my sons| strong="H1121" \w* \w and my daughters| strong="H1323" \w*? [thou hast now done foolishly]{strong=“H5528” x-morph=“strongMorph: \sc Th\sc*8689”} in so [doing]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 29 \w It is| strong="H3426" \w* \w in the power| strong="H410" \w* \w of my hand| strong="H3027" \w* [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w you hurt| strong="H7451" \w*: \w but the God| strong="H430" \w* \w of your father| strong="H1" \w* [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto me yesternight| strong="H570" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Take thou heed]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8734”} [that thou speak not]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w to Jacob| strong="H3290" \w* \w either good| strong="H2896" \w* \w or bad| strong="H7451" \w*. 
\v 30 And now, though [thou wouldest needs]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”} [be gone]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”}, [because thou sore]{strong=“H3700” x-morph=“strongMorph: \sc Th\sc*8736”} [longedst]{strong=“H3700” x-morph=“strongMorph: \sc Th\sc*8738”} [after thy father’s]{strong=“H1”} \w house| strong="H1004" \w*, yet [wherefore hast thou stolen]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8804”} \w my gods| strong="H430" \w*? 
\v 31 \w And Jacob| strong="H3290" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Laban| strong="H3837" \w*, [Because I was afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8804”}: [for I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Peradventure| strong="H6435" \w* [thou wouldest take by force]{strong=“H1497” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy daughters| strong="H1323" \w* from me. 
\v 32 \w With whomsoever| strong="H834" \w* [thou findest]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy gods| strong="H430" \w*, [let him not live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}: \w before| strong="H5048" \w* \w our brethren| strong="H251" \w* [discern]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8685”} thou what is [thine with me, and take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} it [to thee. For Jacob]{strong=“H3290”} [knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w not that Rachel| strong="H7354" \w* [had stolen]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8804”} them. 
\v 33 \w And Laban| strong="H3837" \w* [went]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [into Jacob’s]{strong=“H3290”} \w tent| strong="H168" \w*, [and into Leah’s]{strong=“H3812”} \w tent| strong="H168" \w*, \w and into the two| strong="H8147" \w* [maidservants’]{strong=“H519”} \w tents| strong="H168" \w*; [but he found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} them [not. Then went he out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} [of Leah’s]{strong=“H3812”} \w tent| strong="H168" \w*, [and entered]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [into Rachel’s]{strong=“H7354”} \w tent| strong="H168" \w*. 
\v 34 \w Now Rachel| strong="H7354" \w* [had taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w the images| strong="H8655" \w*, [and put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} [them in the camel’s]{strong=“H1581”} \w furniture| strong="H3733" \w*, [and sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} [upon them. And Laban]{strong=“H3837”} [searched]{strong=“H4959” x-morph=“strongMorph: \sc Th\sc*8762”} \w all the tent| strong="H168" \w*, [but found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} them not.\f + \fr 31:34 \ft searched: Heb. felt \f* 
\v 35 [And she said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to her father| strong="H1" \w*, [Let it not displease]{strong=“H5869 H2734” x-morph=“strongMorph: \sc Th\sc*8799”} \w my lord| strong="H113" \w* [that I cannot]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8800”} \w before thee| strong="H6440" \w*; \w for the custom| strong="H1870" \w* \w of women| strong="H802" \w* is [upon me. And he searched]{strong=“H2664” x-morph=“strongMorph: \sc Th\sc*8762”}, [but found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the images| strong="H8655" \w*. 
\p
\v 36 \w And Jacob| strong="H3290" \w* [was wroth]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8799”}, [and chode]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”} \w with Laban| strong="H3837" \w*: \w and Jacob| strong="H3290" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Laban| strong="H3837" \w*, What is \w my trespass| strong="H6588" \w*? what is \w my sin| strong="H2403" \w*, [that thou hast so hotly pursued]{strong=“H1814” x-morph=“strongMorph: \sc Th\sc*8804”} \w after me| strong="H310" \w*? 
\v 37 \w Whereas| strong="H3588" \w* [thou hast searched]{strong=“H4959” x-morph=“strongMorph: \sc Th\sc*8765”} \w all my stuff| strong="H3627" \w*, [what hast thou found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w of all thy household| strong="H1004" \w* \w stuff| strong="H3627" \w*? [set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} it \w here| strong="H3541" \w* \w before my brethren| strong="H251" \w* \w and thy brethren| strong="H251" \w*, [that they may judge]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”} \w betwixt| strong="H996" \w* \w us both| strong="H8147" \w*.\f + \fr 31:37 \ft searched: Heb. felt \f* 
\v 38 \w This twenty| strong="H6242" \w* \w years| strong="H8141" \w* have I been [with thee; thy ewes]{strong=“H7353”} \w and thy she goats| strong="H5795" \w* [have not cast their young]{strong=“H7921” x-morph=“strongMorph: \sc Th\sc*8765”}, \w and the rams| strong="H352" \w* \w of thy flock| strong="H6629" \w* [have I not eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 39 \w That which was torn| strong="H2966" \w* of beasts [I brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} [not unto thee; I bare the loss]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8762”} [of it; of my hand]{strong=“H3027”} [didst thou require]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} it, whether [stolen]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8803”} \w by day| strong="H3117" \w*, [or stolen]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8803”} \w by night| strong="H3915" \w*. 
\v 40 Thus [I was; in the day]{strong=“H3117”} \w the drought| strong="H2721" \w* [consumed]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and the frost]{strong=“H7140”} \w by night| strong="H3915" \w*; \w and my sleep| strong="H8142" \w* [departed ]{strong=“H5074” x-morph=“strongMorph: \sc Th\sc*8799”} \w from mine eyes| strong="H5869" \w*. 
\v 41 \w Thus have I been twenty| strong="H6242" \w* \w years| strong="H8141" \w* \w in thy house| strong="H1004" \w*; [I served thee]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} [fourteen]{strong=“H6240 H702”} \w years| strong="H8141" \w* \w for thy two| strong="H8147" \w* \w daughters| strong="H1323" \w*, \w and six| strong="H8337" \w* \w years| strong="H8141" \w* \w for thy cattle| strong="H6629" \w*: [and thou hast changed]{strong=“H2498” x-morph=“strongMorph: \sc Th\sc*8686”} \w my wages| strong="H4909" \w* \w ten| strong="H6235" \w* \w times| strong="H4489" \w*. 
\v 42 \w Except| strong="H3884" \w* \w the God| strong="H430" \w* \w of my father| strong="H1" \w*, \w the God| strong="H430" \w* \w of Abraham| strong="H85" \w*, \w and the fear| strong="H6343" \w* \w of Isaac| strong="H3327" \w*, [had been with me, surely thou hadst sent me away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w now empty| strong="H7387" \w*. \w God| strong="H430" \w* [hath seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine affliction| strong="H6040" \w* \w and the labour| strong="H3018" \w* \w of my hands| strong="H3709" \w*, [and rebuked]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”} thee \w yesternight| strong="H570" \w*. 
\p
\v 43 \w And Laban| strong="H3837" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Jacob| strong="H3290" \w*, These \w daughters| strong="H1323" \w* are \w my daughters| strong="H1323" \w*, and these \w children| strong="H1121" \w* are \w my children| strong="H1121" \w*, and these \w cattle| strong="H6629" \w* are \w my cattle| strong="H6629" \w*, [and all that thou seest]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} is [mine: and what can I do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w this day| strong="H3117" \w* \w unto these my daughters| strong="H1323" \w*, \w or| strong="H176" \w* \w unto their children| strong="H1121" \w* [which they have born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”}? 
\v 44 [Now therefore come thou]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [let us make]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} \w a covenant| strong="H1285" \w*, [I and thou; and let it be for a witness]{strong=“H5707”} between me and thee. 
\v 45 \w And Jacob| strong="H3290" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a stone| strong="H68" \w*, [and set it up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} for \w a pillar| strong="H4676" \w*. 
\v 46 \w And Jacob| strong="H3290" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his brethren| strong="H251" \w*, [Gather]{strong=“H3950” x-morph=“strongMorph: \sc Th\sc*8798”} \w stones| strong="H68" \w*; [and they took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w stones| strong="H68" \w*, [and made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w an heap| strong="H1530" \w*: [and they did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w there upon the heap| strong="H1530" \w*. 
\v 47 \w And Laban| strong="H3837" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} [it Jegar-sahadutha]{strong=“H3026”}: \w but Jacob| strong="H3290" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w it Galeed| strong="H1567" \w*.\f + \fr 31:47 \ft Jegar-sahadutha: that is, The heap of witness, Chaldee \f* \f + \fr 31:47 \ft Galeed: that is, The heap of witness, Heb. \f* 
\v 48 \w And Laban| strong="H3837" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w This heap| strong="H1530" \w* is \w a witness| strong="H5707" \w* \w between me and thee this day| strong="H3117" \w*. \w Therefore was the name| strong="H8034" \w* [of it called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w Galeed| strong="H1567" \w*; 
\v 49 \w And Mizpah| strong="H4709" \w*; \w for| strong="H834" \w* [he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, The \sc Lord\sc* [watch]{strong=“H6822” x-morph=“strongMorph: \sc Th\sc*8799”} [between me and thee, when we are absent]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8735”} \w one| strong="H376" \w* \w from another| strong="H7453" \w*.\f + \fr 31:49 \ft Mizpah: that is, A beacon, or, watchtower \f* 
\v 50 [If thou shalt afflict]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8762”} \w my daughters| strong="H1323" \w*, [or if thou shalt take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} other \w wives| strong="H802" \w* \w beside| strong="H5921" \w* \w my daughters| strong="H1323" \w*, \w no man| strong="H376" \w* is [with us; see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}, \w God| strong="H430" \w* is \w witness| strong="H5707" \w* betwixt me and thee. 
\v 51 \w And Laban| strong="H3837" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Jacob| strong="H3290" \w*, \w Behold this heap| strong="H1530" \w*, and behold this \w pillar| strong="H4676" \w*, [which I have cast]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8804”} betwixt me and thee; 
\v 52 \w This heap| strong="H1530" \w* be \w witness| strong="H5707" \w*, and this \w pillar| strong="H4676" \w* be \w witness| strong="H5713" \w*, [that I will not pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w this heap| strong="H1530" \w* [to thee, and that thou shalt not pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w this heap| strong="H1530" \w* \w and this pillar| strong="H4676" \w* [unto me, for harm]{strong=“H7451”}. 
\v 53 \w The God| strong="H430" \w* \w of Abraham| strong="H85" \w*, \w and the God| strong="H430" \w* \w of Nahor| strong="H5152" \w*, \w the God| strong="H430" \w* \w of their father| strong="H1" \w*, [judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} [betwixt us. And Jacob]{strong=“H3290”} [sware]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8735”} \w by the fear| strong="H6343" \w* \w of his father| strong="H1" \w* \w Isaac| strong="H3327" \w*. 
\v 54 \w Then Jacob| strong="H3290" \w* [offered]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} \w sacrifice| strong="H2077" \w* \w upon the mount| strong="H2022" \w*, [and called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w his brethren| strong="H251" \w* [to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} \w bread| strong="H3899" \w*: [and they did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w bread| strong="H3899" \w*, [and tarried all night]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the mount| strong="H2022" \w*.\f + \fr 31:54 \ft offered…: or, killed beasts \f* 
\v 55 \w And early| strong="H7925" \w* \w in the morning| strong="H1242" \w* \w Laban| strong="H3837" \w* [rose up]{strong=“H7925” x-morph=“strongMorph: \sc Th\sc*8686”}, [and kissed]{strong=“H5401” x-morph=“strongMorph: \sc Th\sc*8762”} \w his sons| strong="H1121" \w* \w and his daughters| strong="H1323" \w*, [and blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} [them: and Laban]{strong=“H3837”} [departed]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [and returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his place| strong="H4725" \w*.
\c 32
\p 
\v 1 \w And Jacob| strong="H3290" \w* [went]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w on his way| strong="H1870" \w*, \w and the angels| strong="H4397" \w* \w of God| strong="H430" \w* [met]{strong=“H6293” x-morph=“strongMorph: \sc Th\sc*8799”} him. 
\v 2 \w And when Jacob| strong="H3290" \w* [saw them]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”}, [he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, This is [God’s]{strong=“H430”} \w host| strong="H4264" \w*: [and he called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w the name| strong="H8034" \w* \w of that place| strong="H4725" \w* \w Mahanaim| strong="H4266" \w*.\f + \fr 32:2 \ft Mahanaim: that is, Two hosts, or, camps \f* 
\p
\v 3 \w And Jacob| strong="H3290" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w messengers| strong="H4397" \w* \w before him| strong="H6440" \w* \w to Esau| strong="H6215" \w* \w his brother| strong="H251" \w* \w unto the land| strong="H776" \w* \w of Seir| strong="H8165" \w*, \w the country| strong="H7704" \w* \w of Edom| strong="H123" \w*.\f + \fr 32:3 \ft country: Heb. field \f* 
\v 4 [And he commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} [them, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Thus shall ye speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto my lord| strong="H113" \w* \w Esau| strong="H6215" \w*; \w Thy servant| strong="H5650" \w* \w Jacob| strong="H3290" \w* [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [thus, I have sojourned]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8804”} \w with Laban| strong="H3837" \w*, [and stayed there]{strong=“H309” x-morph=“strongMorph: \sc Th\sc*8799”} until now: 
