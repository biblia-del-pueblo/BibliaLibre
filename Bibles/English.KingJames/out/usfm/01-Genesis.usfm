\v 15 [And she said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto her, Is it \w a small matter| strong="H4592" \w* [that thou hast taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} \w my husband| strong="H376" \w*? [and wouldest thou take away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} [my son’s]{strong=“H1121”} \w mandrakes| strong="H1736" \w* [also? And Rachel]{strong=“H7354”} [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Therefore he shall lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w with thee to night| strong="H3915" \w* \w for| strong="H8478" \w* [thy son’s]{strong=“H1121”} \w mandrakes| strong="H1736" \w*. 
\v 16 \w And Jacob| strong="H3290" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of the field| strong="H7704" \w* \w in the evening| strong="H6153" \w*, \w and Leah| strong="H3812" \w* [went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} [to meet]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} [him, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Thou must come in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me; for surely]{strong=“H7936” x-morph=“strongMorph: \sc Th\sc*8800”} [I have hired]{strong=“H7936” x-morph=“strongMorph: \sc Th\sc*8804”} [thee with my son’s]{strong=“H1121”} \w mandrakes| strong="H1736" \w*. [And he lay]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w with her that night| strong="H3915" \w*. 
