\c 30
\p 
\v 1 \w And when Rachel| strong="H7354" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [that she bare]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} \w Jacob| strong="H3290" \w* [no children, Rachel]{strong=“H7354”} [envied]{strong=“H7065” x-morph=“strongMorph: \sc Th\sc*8762”} \w her sister| strong="H269" \w*; [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Jacob| strong="H3290" \w*, [Give]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”} \w me children| strong="H1121" \w*, \w or else| strong="H369" \w* [I die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”}. 
\v 2 [And Jacob’s]{strong=“H3290”} \w anger| strong="H639" \w* [was kindled]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8799”} \w against Rachel| strong="H7354" \w*: [and he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Am [I in God’s]{strong=“H430”} [stead, who hath withheld]{strong=“H4513” x-morph=“strongMorph: \sc Th\sc*8804”} \w from thee the fruit| strong="H6529" \w* \w of the womb| strong="H990" \w*? 
