\v 20 [But bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w your youngest| strong="H6996" \w* \w brother| strong="H251" \w* [unto me; so shall your words]{strong=“H1697”} [be verified]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8735”}, [and ye shall not die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. [And they did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} so. 
\p
\v 21 [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w one| strong="H376" \w* \w to another| strong="H251" \w*, We are \w verily| strong="H61" \w* \w guilty| strong="H818" \w* \w concerning our brother| strong="H251" \w*, \w in that| strong="H834" \w* [we saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the anguish| strong="H6869" \w* \w of his soul| strong="H5315" \w*, [when he besought]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8692”} [us, and we would not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}; \w therefore is this distress| strong="H6869" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} upon us. 
\v 22 \w And Reuben| strong="H7205" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [them, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Spake I]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [not unto you, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Do not sin]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8799”} \w against the child| strong="H3206" \w*; [and ye would not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}? [therefore, behold, also his blood]{strong=“H1818”} [is required]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 23 [And they knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w not that Joseph| strong="H3130" \w* [understood ]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} them; [for he spake unto them by an interpreter]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8688”}.\f + \fr 42:23 \ft he spake…: Heb. an interpreter was between them \f* 
\v 24 [And he turned himself about]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8735”} [from them, and wept]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8799”}; [and returned to them again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [and communed]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [with them, and took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w from them Simeon| strong="H8095" \w*, [and bound]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8799”} \w him before their eyes| strong="H5869" \w*. 
\p
\v 25 \w Then Joseph| strong="H3130" \w* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} [to fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8762”} \w their sacks| strong="H3627" \w* \w with corn| strong="H1250" \w*, [and to restore]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} [every man’s]{strong=“H376”} \w money| strong="H3701" \w* \w into his sack| strong="H8242" \w*, [and to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w them provision| strong="H6720" \w* \w for the way| strong="H1870" \w*: \w and thus| strong="H3651" \w* [did he]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} unto them. 
\v 26 [And they laded]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their asses| strong="H2543" \w* \w with the corn| strong="H7668" \w*, [and departed]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} thence. 
\v 27 \w And as one| strong="H259" \w* [of them opened]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} \w his sack| strong="H8242" \w* [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w his ass| strong="H2543" \w* \w provender| strong="H4554" \w* \w in the inn| strong="H4411" \w*, [he espied]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w his money| strong="H3701" \w*; for, behold, it was [in his sack’s]{strong=“H572”} \w mouth| strong="H6310" \w*. 
\v 28 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his brethren| strong="H251" \w*, \w My money| strong="H3701" \w* [is restored]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8717”}; [and, lo]{strong=“H2009”}, it is \w even in my sack| strong="H572" \w*: \w and their heart| strong="H3820" \w* [failed]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} them, [and they were afraid]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8799”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} \w one| strong="H376" \w* \w to another| strong="H251" \w*, What is this that \w God| strong="H430" \w* [hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} unto us?\f + \fr 42:28 \ft failed…: Heb. went forth \f* 
\p
\v 29 [And they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Jacob| strong="H3290" \w* \w their father| strong="H1" \w* \w unto the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*, [and told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} [him all that befell]{strong=“H7136” x-morph=“strongMorph: \sc Th\sc*8802”} [unto them; saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 30 \w The man| strong="H376" \w*, who is \w the lord| strong="H113" \w* \w of the land| strong="H776" \w*, [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w roughly| strong="H7186" \w* [to us, and took]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [us for spies]{strong=“H7270” x-morph=“strongMorph: \sc Th\sc*8764”} \w of the country| strong="H776" \w*.\f + \fr 42:30 \ft roughly…: Heb. with us hard things \f* 
\v 31 [And we said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, We are \w true| strong="H3651" \w* men; [we are no spies]{strong=“H7270” x-morph=“strongMorph: \sc Th\sc*8764”}: 
\v 32 We be [twelve]{strong=“H8147 H6240”} \w brethren| strong="H251" \w*, \w sons| strong="H1121" \w* \w of our father| strong="H1" \w*; \w one| strong="H259" \w* is [not, and the youngest]{strong=“H6996”} is \w this day| strong="H3117" \w* \w with our father| strong="H1" \w* \w in the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*. 
\v 33 \w And the man| strong="H376" \w*, \w the lord| strong="H113" \w* \w of the country| strong="H776" \w*, [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto us, Hereby shall I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} that ye are \w true| strong="H3651" \w* men; [leave]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8685”} \w one| strong="H259" \w* \w of your brethren| strong="H251" \w* here [with me, and take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} food for \w the famine| strong="H7459" \w* \w of your households| strong="H1004" \w*, [and be gone]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}: 
\v 34 [And bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8685”} \w your youngest| strong="H6996" \w* \w brother| strong="H251" \w* [unto me: then shall I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} that ye are [no spies]{strong=“H7270” x-morph=“strongMorph: \sc Th\sc*8764”}, but that ye are \w true| strong="H3651" \w* men: so [will I deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w you your brother| strong="H251" \w*, [and ye shall traffick]{strong=“H5503” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the land| strong="H776" \w*. 
\p
\v 35 [And it came to pass as they emptied]{strong=“H7324” x-morph=“strongMorph: \sc Th\sc*8688”} \w their sacks| strong="H8242" \w*, [that, behold, every man’s]{strong=“H376”} \w bundle| strong="H6872" \w* \w of money| strong="H3701" \w* was \w in his sack| strong="H8242" \w*: and when both \w they and their father| strong="H1" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the bundles| strong="H6872" \w* \w of money| strong="H3701" \w*, [they were afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 36 \w And Jacob| strong="H3290" \w* \w their father| strong="H1" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Me have ye bereaved]{strong=“H7921” x-morph=“strongMorph: \sc Th\sc*8765”} of my children: \w Joseph| strong="H3130" \w* is [not, and Simeon]{strong=“H8095”} is [not, and ye will take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w Benjamin| strong="H1144" \w* away: all these things are against me. 
\v 37 \w And Reuben| strong="H7205" \w* [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his father| strong="H1" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Slay]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8686”} \w my two| strong="H8147" \w* \w sons| strong="H1121" \w*, [if I bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} [him not to thee: deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w him into my hand| strong="H3027" \w*, [and I will bring him to thee again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 38 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w My son| strong="H1121" \w* [shall not go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} [with you; for his brother]{strong=“H251”} [is dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}, [and he is left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8738”} [alone: if mischief]{strong=“H611”} [befall]{strong=“H7122” x-morph=“strongMorph: \sc Th\sc*8804”} \w him by the way| strong="H1870" \w* [in the which ye go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [then shall ye bring down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8689”} \w my gray hairs| strong="H7872" \w* \w with sorrow| strong="H3015" \w* \w to the grave| strong="H7585" \w*. 
\c 43
\p 
\v 1 \w And the famine| strong="H7458" \w* was \w sore| strong="H3515" \w* \w in the land| strong="H776" \w*. 
\v 2 [And it came to pass, when they had eaten up]{strong=“H398 H3615” x-morph=“strongMorph: \sc Th\sc*8800 strongMorph: \sc Th\sc*8765”} \w the corn| strong="H7668" \w* [which they had brought out]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w of Egypt| strong="H4714" \w*, \w their father| strong="H1" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Go again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”}, [buy]{strong=“H7666” x-morph=“strongMorph: \sc Th\sc*8798”} \w us a little| strong="H4592" \w* \w food| strong="H400" \w*. 
\v 3 \w And Judah| strong="H3063" \w* [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w The man| strong="H376" \w* [did solemnly]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8687”} [protest]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8689”} [unto us, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Ye shall not see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w my face| strong="H6440" \w*, \w except| strong="H1115" \w* \w your brother| strong="H251" \w* be with you.\f + \fr 43:3 \ft did…: Heb. protesting protested \f* 
\v 4 \w If thou wilt| strong="H3426" \w* [send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8764”} \w our brother| strong="H251" \w* [with us, we will go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} [and buy]{strong=“H7666” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee food| strong="H400" \w*: 
\v 5 [But if thou wilt not send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8764”} him, [we will not go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”}: \w for the man| strong="H376" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto us, Ye shall not see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w my face| strong="H6440" \w*, \w except your brother| strong="H251" \w* be with you. 
\v 6 \w And Israel| strong="H3478" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Wherefore dealt ye so [ill]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8689”} with me, as [to tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8687”} \w the man| strong="H376" \w* \w whether ye had yet a brother| strong="H251" \w*? 
\v 7 [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w The man| strong="H376" \w* [asked]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8804”} [us straitly]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8800”} [of our state, and of our kindred]{strong=“H4138”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, Is \w your father| strong="H1" \w* \w yet alive| strong="H2416" \w*? \w have ye| strong="H3426" \w* another \w brother| strong="H251" \w*? [and we told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w him according| strong="H5921" \w* \w to the tenor| strong="H6310" \w* \w of these words| strong="H1697" \w*: [could we certainly]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} [know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [that he would say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Bring| strong="H3381" \w* \w your brother| strong="H251" \w* [down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8685”}?\f + \fr 43:7 \ft asked…: Heb. asking asked us \f* \f + \fr 43:7 \ft tenor: Heb. mouth \f* \f + \fr 43:7 \ft could…: Heb. knowing could we know \f* 
\v 8 \w And Judah| strong="H3063" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Israel| strong="H3478" \w* \w his father| strong="H1" \w*, [Send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8798”} \w the lad| strong="H5288" \w* [with me, and we will arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} [and go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}; [that we may live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}, [and not die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, both we, and thou, and \w also our little ones| strong="H2945" \w*. 
\v 9 [I will be surety]{strong=“H6148” x-morph=“strongMorph: \sc Th\sc*8799”} [for him; of my hand]{strong=“H3027”} [shalt thou require]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} [him: if]{strong=“H518”} [I bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w him not| strong="H518" \w* [unto thee, and set]{strong=“H3322” x-morph=“strongMorph: \sc Th\sc*8689”} \w him before thee| strong="H6440" \w*, [then let me bear the blame]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} \w for ever| strong="H3117" \w*: 
\v 10 \w For except| strong="H3884" \w* [we had lingered]{strong=“H4102” x-morph=“strongMorph: \sc Th\sc*8701”}, [surely now we had returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w this second time| strong="H6471" \w*.\f + \fr 43:10 \ft this: or, twice by this \f* 
\p
\v 11 \w And their father| strong="H1" \w* \w Israel| strong="H3478" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto them, If it must be \w so now| strong="H645" \w*, [do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} [this; take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w of the best fruits| strong="H2173" \w* \w in the land| strong="H776" \w* \w in your vessels| strong="H3627" \w*, [and carry down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8685”} \w the man| strong="H376" \w* \w a present| strong="H4503" \w*, \w a little| strong="H4592" \w* \w balm| strong="H6875" \w*, \w and a little| strong="H4592" \w* \w honey| strong="H1706" \w*, \w spices| strong="H5219" \w*, \w and myrrh| strong="H3910" \w*, \w nuts| strong="H992" \w*, \w and almonds| strong="H8247" \w*: 
\v 12 [And take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w double| strong="H4932" \w* \w money| strong="H3701" \w* \w in your hand| strong="H3027" \w*; \w and the money| strong="H3701" \w* [that was brought again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8716”} \w in the mouth| strong="H6310" \w* \w of your sacks| strong="H572" \w*, carry it [again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w in your hand| strong="H3027" \w*; peradventure it was \w an oversight| strong="H4870" \w*: 
\v 13 [Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w also your brother| strong="H251" \w*, [and arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [go again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto the man| strong="H376" \w*: 
\v 14 \w And God| strong="H410" \w* \w Almighty| strong="H7706" \w* [give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w you mercy| strong="H7356" \w* \w before| strong="H6440" \w* \w the man| strong="H376" \w*, [that he may send away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w your other| strong="H312" \w* \w brother| strong="H251" \w*, \w and Benjamin| strong="H1144" \w*. \w If| strong="H834" \w* [I be bereaved]{strong=“H7921” x-morph=“strongMorph: \sc Th\sc*8804”} of my children, [I am bereaved]{strong=“H7921” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 43:14 \ft If…: or, And I, as I have been, etc. \f* 
\p
\v 15 \w And the men| strong="H582" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w that| strong="H2063" \w* \w present| strong="H4503" \w*, [and they took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w double| strong="H4932" \w* \w money| strong="H3701" \w* \w in their hand| strong="H3027" \w*, \w and Benjamin| strong="H1144" \w*; [and rose up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and went down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Egypt| strong="H4714" \w*, [and stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* \w Joseph| strong="H3130" \w*. 
\v 16 \w And when Joseph| strong="H3130" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w Benjamin| strong="H1144" \w* \w with| strong="H854" \w* [them, he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the ruler of his house| strong="H1004" \w*, [Bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8685”} these \w men| strong="H582" \w* \w home| strong="H1004" \w*, [and slay]{strong=“H2874 H2873” x-morph=“strongMorph: \sc Th\sc*8800”}, [and make ready]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8685”}; for these \w men| strong="H582" \w* [shall dine]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w with me at noon| strong="H6672" \w*.\f + \fr 43:16 \ft slay: Heb. kill a killing \f* \f + \fr 43:16 \ft dine: Heb. eat \f* 
