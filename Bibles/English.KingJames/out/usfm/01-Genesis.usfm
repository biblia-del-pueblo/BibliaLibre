\v 19 \w And Joseph| strong="H3130" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} not: for am \w I in the place of God| strong="H430" \w*? 
\v 20 [But as for you, ye thought]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8804”} \w evil| strong="H7451" \w* against me; but \w God| strong="H430" \w* [meant it]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto good| strong="H2896" \w*, \w to| strong="H4616" \w* [bring to pass]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”}, as it is \w this day| strong="H3117" \w*, \w to save| strong="H2421" \w* \w much| strong="H7227" \w* \w people| strong="H5971" \w* [alive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8687”}. 
\v 21 [Now therefore fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [ye not: I will nourish]{strong=“H3557” x-morph=“strongMorph: \sc Th\sc*8770”} [you, and your little ones]{strong=“H2945”}. [And he comforted]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8762”} [them, and spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w kindly| strong="H3820" \w* unto them.\f + \fr 50:21 \ft kindly…: Heb. to their hearts \f* 
\p
