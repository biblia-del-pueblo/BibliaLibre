\v 20 [And he erected]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8686”} \w there an altar| strong="H4196" \w*, [and called it]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} [El-elohe-Israel]{strong=“H415”}.\f + \fr 33:20 \ft El-elohe-Israel: that is God the God of Israel \f*
\c 34
\p 
\v 1 \w And Dinah| strong="H1783" \w* \w the daughter| strong="H1323" \w* \w of Leah| strong="H3812" \w*, [which she bare]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto Jacob| strong="H3290" \w*, [went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} [to see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w the daughters| strong="H1323" \w* \w of the land| strong="H776" \w*. 
\v 2 \w And when Shechem| strong="H7927" \w* \w the son| strong="H1121" \w* \w of Hamor| strong="H2544" \w* \w the Hivite| strong="H2340" \w*, \w prince| strong="H5387" \w* \w of the country| strong="H776" \w*, [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [her, he took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [her, and lay]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} [with her, and defiled her]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8762”}.\f + \fr 34:2 \ft defiled…: Heb. humbled her \f* 
\v 3 \w And his soul| strong="H5315" \w* [clave]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Dinah| strong="H1783" \w* \w the daughter| strong="H1323" \w* \w of Jacob| strong="H3290" \w*, [and he loved]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8799”} \w the damsel| strong="H5291" \w*, [and spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w kindly| strong="H3820" \w* \w unto the damsel| strong="H5291" \w*.\f + \fr 34:3 \ft kindly…: Heb. to the heart of the damsel \f* 
\v 4 \w And Shechem| strong="H7927" \w* [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his father| strong="H1" \w* \w Hamor| strong="H2544" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Get]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w me this damsel| strong="H3207" \w* \w to wife| strong="H802" \w*. 
\v 5 \w And Jacob| strong="H3290" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [that he had defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8765”} \w Dinah| strong="H1783" \w* \w his daughter| strong="H1323" \w*: \w now his sons| strong="H1121" \w* \w were with his cattle| strong="H4735" \w* \w in the field| strong="H7704" \w*: \w and Jacob| strong="H3290" \w* [held his peace]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8689”} [until they were come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\p
\v 6 \w And Hamor| strong="H2544" \w* \w the father| strong="H1" \w* \w of Shechem| strong="H7927" \w* [went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Jacob| strong="H3290" \w* [to commune]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w with| strong="H854" \w* him. 
\v 7 \w And the sons| strong="H1121" \w* \w of Jacob| strong="H3290" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w out of the field| strong="H7704" \w* [when they heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} it: \w and the men| strong="H582" \w* [were grieved]{strong=“H6087” x-morph=“strongMorph: \sc Th\sc*8691”}, \w and they were very| strong="H3966" \w* [wroth]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8799”}, [because he had wrought]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w folly| strong="H5039" \w* \w in Israel| strong="H3478" \w* [in lying]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8800”} [with Jacob’s]{strong=“H3290”} \w daughter| strong="H1323" \w*; [which thing ought not to be done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 8 \w And Hamor| strong="H2544" \w* [communed]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [with them, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w The soul| strong="H5315" \w* \w of my son| strong="H1121" \w* \w Shechem| strong="H7927" \w* [longeth]{strong=“H2836” x-morph=“strongMorph: \sc Th\sc*8804”} \w for your daughter| strong="H1323" \w*: [I pray you give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w her him to wife| strong="H802" \w*. 
\v 9 [And make ye marriages]{strong=“H2859” x-morph=“strongMorph: \sc Th\sc*8690”} with us, and [give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w your daughters| strong="H1323" \w* [unto us, and take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w our daughters| strong="H1323" \w* unto you. 
\v 10 [And ye shall dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} [with us: and the land]{strong=“H776”} [shall be]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8799”} \w before you| strong="H6440" \w*; [dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8798”} [and trade]{strong=“H5503” x-morph=“strongMorph: \sc Th\sc*8804”} [ye therein, and get you possessions]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8734”} therein. 
\v 11 \w And Shechem| strong="H7927" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto her father| strong="H1" \w* \w and unto her brethren| strong="H251" \w*, [Let me find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w grace| strong="H2580" \w* \w in your eyes| strong="H5869" \w*, [and what ye shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 12 [Ask]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8685”} \w me never so much| strong="H3966" \w* \w dowry| strong="H4119" \w* \w and gift| strong="H4976" \w*, [and I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [according as ye shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me: but give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w me the damsel| strong="H5291" \w* \w to wife| strong="H802" \w*. 
\v 13 \w And the sons| strong="H1121" \w* \w of Jacob| strong="H3290" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w Shechem| strong="H7927" \w* \w and Hamor| strong="H2544" \w* \w his father| strong="H1" \w* \w deceitfully| strong="H4820" \w*, [and said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}, [because he had defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8765”} \w Dinah| strong="H1783" \w* \w their sister| strong="H269" \w*: 
\v 14 [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, We cannot]{strong=“H3201 H3808” x-morph=“strongMorph: \sc Th\sc*8799”} [do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w this thing| strong="H1697" \w*, [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w our sister| strong="H269" \w* \w to one| strong="H376" \w* \w that is uncircumcised| strong="H6190" \w*; for that were \w a reproach| strong="H2781" \w* unto us: 
\v 15 \w But in this| strong="H2063" \w* [will we consent]{strong=“H225” x-morph=“strongMorph: \sc Th\sc*8735”} unto you: If ye will be as we be, \w that every male| strong="H2145" \w* [of you be circumcised]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8736”}; 
\v 16 [Then will we give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w our daughters| strong="H1323" \w* [unto you, and we will take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w your daughters| strong="H1323" \w* [to us, and we will dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} [with you, and we will become one]{strong=“H259”} \w people| strong="H5971" \w*. 
\v 17 [But if ye will not hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [unto us, to be circumcised]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8736”}; [then will we take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w our daughter| strong="H1323" \w*, [and we will be gone]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\p
\v 18 \w And their words| strong="H1697" \w* [pleased ]{strong=“H5869 H3190” x-morph=“strongMorph: \sc Th\sc*8799”} \w Hamor| strong="H2544" \w*, \w and Shechem| strong="H7927" \w* [Hamor’s]{strong=“H2544”} \w son| strong="H1121" \w*. 
\v 19 \w And the young man| strong="H5288" \w* [deferred]{strong=“H309” x-morph=“strongMorph: \sc Th\sc*8765”} [not to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w the thing| strong="H1697" \w*, [because he had delight]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} [in Jacob’s]{strong=“H3290”} \w daughter| strong="H1323" \w*: and he was [more honourable]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8737”} \w than all the house| strong="H1004" \w* \w of his father| strong="H1" \w*. 
\p
\v 20 \w And Hamor| strong="H2544" \w* \w and Shechem| strong="H7927" \w* \w his son| strong="H1121" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the gate| strong="H8179" \w* \w of their city| strong="H5892" \w*, [and communed]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w with the men| strong="H582" \w* \w of their city| strong="H5892" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 21 \w These men| strong="H582" \w* are \w peaceable| strong="H8003" \w* \w with| strong="H854" \w* [us; therefore let them dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the land| strong="H776" \w*, [and trade]{strong=“H5503” x-morph=“strongMorph: \sc Th\sc*8799”} [therein; for the land]{strong=“H776”}, behold, it is \w large| strong="H7342" \w* \w enough| strong="H3027" \w* \w for them| strong="H6440" \w*; [let us take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w their daughters| strong="H1323" \w* \w to us for wives| strong="H802" \w*, [and let us give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w them our daughters| strong="H1323" \w*. 
\v 22 \w Only herein| strong="H2063" \w* \w will the men| strong="H582" \w* [consent]{strong=“H225” x-morph=“strongMorph: \sc Th\sc*8735”} [unto us for to dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} [with us, to be one]{strong=“H259”} \w people| strong="H5971" \w*, \w if every male| strong="H2145" \w* [among us be circumcised]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8736”}, as they are [circumcised]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8737”}. 
\v 23 Shall \w not their cattle| strong="H4735" \w* \w and their substance| strong="H7075" \w* \w and every beast| strong="H929" \w* of theirs be [ours? only let us consent]{strong=“H225” x-morph=“strongMorph: \sc Th\sc*8735”} [unto them, and they will dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} with us. 
\v 24 \w And unto Hamor| strong="H2544" \w* \w and unto Shechem| strong="H7927" \w* \w his son| strong="H1121" \w* [hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [all that went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the gate| strong="H8179" \w* \w of his city| strong="H5892" \w*; \w and every male| strong="H2145" \w* [was circumcised]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8735”}, [all that went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the gate| strong="H8179" \w* \w of his city| strong="H5892" \w*. 
\p
\v 25 \w And it came to pass on the third| strong="H7992" \w* \w day| strong="H3117" \w*, [when they were sore]{strong=“H3510” x-morph=“strongMorph: \sc Th\sc*8802”}, \w that two| strong="H8147" \w* \w of the sons| strong="H1121" \w* \w of Jacob| strong="H3290" \w*, \w Simeon| strong="H8095" \w* \w and Levi| strong="H3878" \w*, [Dinah’s]{strong=“H1783”} \w brethren| strong="H251" \w*, [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w each man| strong="H376" \w* \w his sword| strong="H2719" \w*, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the city| strong="H5892" \w* \w boldly| strong="H983" \w*, [and slew]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the males| strong="H2145" \w*. 
\v 26 [And they slew]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”} \w Hamor| strong="H2544" \w* \w and Shechem| strong="H7927" \w* \w his son| strong="H1121" \w* \w with the edge| strong="H6310" \w* \w of the sword| strong="H2719" \w*, \w and took| strong="H3947" \w* \w Dinah| strong="H1783" \w* [out]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [of Shechem’s]{strong=“H7927”} \w house| strong="H1004" \w*, [and went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 34:26 \ft edge: Heb. mouth \f* 
\v 27 \w The sons| strong="H1121" \w* \w of Jacob| strong="H3290" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon the slain| strong="H2491" \w*, [and spoiled]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8799”} \w the city| strong="H5892" \w*, [because they had defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8765”} \w their sister| strong="H269" \w*. 
\v 28 [They took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w their sheep| strong="H6629" \w*, \w and their oxen| strong="H1241" \w*, \w and their asses| strong="H2543" \w*, and that which was \w in the city| strong="H5892" \w*, and that which was \w in the field| strong="H7704" \w*, 
\v 29 \w And all their wealth| strong="H2428" \w*, \w and all their little ones| strong="H2945" \w*, \w and their wives| strong="H802" \w* [took they captive]{strong=“H7617” x-morph=“strongMorph: \sc Th\sc*8804”}, [and spoiled]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8799”} even all that was \w in the house| strong="H1004" \w*. 
\v 30 \w And Jacob| strong="H3290" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Simeon| strong="H8095" \w* \w and Levi| strong="H3878" \w*, [Ye have troubled]{strong=“H5916” x-morph=“strongMorph: \sc Th\sc*8804”} [me to make me to stink]{strong=“H887” x-morph=“strongMorph: \sc Th\sc*8687”} [among the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the land| strong="H776" \w*, \w among the Canaanites| strong="H3669" \w* \w and the Perizzites| strong="H6522" \w*: and I being \w few| strong="H4962" \w* \w in number| strong="H4557" \w*, [they shall gather themselves together]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8738”} [against me, and slay me]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”}; [and I shall be destroyed]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8738”}, \w I and my house| strong="H1004" \w*. 
\v 31 [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Should he deal]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w with our sister| strong="H269" \w* [as with an harlot]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”}?
\c 35
\p 
\v 1 \w And God| strong="H430" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Jacob| strong="H3290" \w*, [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”} [to Beth-el]{strong=“H1008”}, [and dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8798”} [there: and make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} \w there an altar| strong="H4196" \w* \w unto God| strong="H410" \w*, [that appeared]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8737”} [unto thee when thou fleddest]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8800”} \w from the face| strong="H6440" \w* \w of Esau| strong="H6215" \w* \w thy brother| strong="H251" \w*. 
\v 2 \w Then Jacob| strong="H3290" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his household| strong="H1004" \w*, and to all that were [with him, Put away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8685”} \w the strange| strong="H5236" \w* \w gods| strong="H430" \w* that are \w among you| strong="H8432" \w*, [and be clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8690”}, [and change]{strong=“H2498” x-morph=“strongMorph: \sc Th\sc*8685”} \w your garments| strong="H8071" \w*: 
\v 3 [And let us arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} [to Beth-el]{strong=“H1008”}; [and I will make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w there an altar| strong="H4196" \w* \w unto God| strong="H410" \w*, [who answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8802”} \w me in the day| strong="H3117" \w* \w of my distress| strong="H6869" \w*, \w and was with me in the way| strong="H1870" \w* [which I went]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 4 [And they gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Jacob| strong="H3290" \w* \w all the strange| strong="H5236" \w* \w gods| strong="H430" \w* which were \w in their hand| strong="H3027" \w*, and all their \w earrings| strong="H5141" \w* which were \w in their ears| strong="H241" \w*; \w and Jacob| strong="H3290" \w* [hid]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8799”} \w them under the oak| strong="H424" \w* which was \w by Shechem| strong="H7927" \w*. 
\v 5 [And they journeyed]{strong=“H5265” x-morph=“strongMorph: \sc Th\sc*8799”}: \w and the terror| strong="H2847" \w* \w of God| strong="H430" \w* \w was upon the cities| strong="H5892" \w* that were \w round about| strong="H5439" \w* [them, and they did not pursue]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8804”} \w after| strong="H310" \w* \w the sons| strong="H1121" \w* \w of Jacob| strong="H3290" \w*. 
\p
\v 6 \w So Jacob| strong="H3290" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Luz| strong="H3870" \w*, which is \w in the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*, that is, [Beth-el]{strong=“H1008”}, \w he and all the people| strong="H5971" \w* that were with him. 
\v 7 [And he built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w there an altar| strong="H4196" \w*, [and called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w the place| strong="H4725" \w* [El-beth-el]{strong=“H416”}: \w because there God| strong="H430" \w* [appeared]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8738”} [unto him, when he fled]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8800”} \w from the face| strong="H6440" \w* \w of his brother| strong="H251" \w*.\f + \fr 35:7 \ft El-beth-el: that is, The God of Beth-el \f* 
\v 8 \w But Deborah| strong="H1683" \w* [Rebekah’s]{strong=“H7259”} [nurse]{strong=“H3243” x-morph=“strongMorph: \sc Th\sc*8688”} [died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, [and she was buried]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8735”} [beneath Beth-el]{strong=“H1008”} \w under an oak| strong="H437" \w*: \w and the name| strong="H8034" \w* [of it was called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} [Allon-bachuth]{strong=“H439”}.\f + \fr 35:8 \ft Allon-bachuth: that is, The oak of weeping \f* 
\p
\v 9 \w And God| strong="H430" \w* [appeared]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8735”} \w unto Jacob| strong="H3290" \w* [again, when he came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [out of Padan-aram]{strong=“H6307”}, [and blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} him. 
\v 10 \w And God| strong="H430" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Thy name]{strong=“H8034”} is \w Jacob| strong="H3290" \w*: \w thy name| strong="H8034" \w* [shall not be called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8735”} \w any more Jacob| strong="H3290" \w*, \w but Israel| strong="H3478" \w* \w shall be thy name| strong="H8034" \w*: [and he called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w his name| strong="H8034" \w* \w Israel| strong="H3478" \w*. 
\v 11 \w And God| strong="H430" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, I am \w God| strong="H410" \w* \w Almighty| strong="H7706" \w*: [be fruitful]{strong=“H6509” x-morph=“strongMorph: \sc Th\sc*8798”} [and multiply]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8798”}; \w a nation| strong="H1471" \w* \w and a company| strong="H6951" \w* \w of nations| strong="H1471" \w* [shall be of thee, and kings]{strong=“H4428”} [shall come]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of thy loins| strong="H2504" \w*; 
\v 12 \w And the land| strong="H776" \w* [which I gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w Abraham| strong="H85" \w* \w and Isaac| strong="H3327" \w*, [to thee I will give it]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and to thy seed| strong="H2233" \w* \w after thee| strong="H310" \w* [will I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w the land| strong="H776" \w*. 
\v 13 \w And God| strong="H430" \w* [went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w from him in the place| strong="H4725" \w* [where he talked]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} with him. 
\v 14 \w And Jacob| strong="H3290" \w* [set up]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8686”} \w a pillar| strong="H4676" \w* \w in the place| strong="H4725" \w* [where he talked]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} with him, even \w a pillar| strong="H4678" \w* \w of stone| strong="H68" \w*: [and he poured]{strong=“H5258” x-morph=“strongMorph: \sc Th\sc*8686”} \w a drink offering| strong="H5262" \w* [thereon, and he poured]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8799”} \w oil| strong="H8081" \w* thereon. 
\v 15 \w And Jacob| strong="H3290" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w the name| strong="H8034" \w* \w of the place| strong="H4725" \w* \w where God| strong="H430" \w* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [with him, Beth-el]{strong=“H1008”}. 
\p
\v 16 [And they journeyed]{strong=“H5265” x-morph=“strongMorph: \sc Th\sc*8799”} [from Beth-el]{strong=“H1008”}; \w and there was but| strong="H5750" \w* \w a little| strong="H3530" \w* \w way| strong="H776" \w* [to come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w to Ephrath| strong="H672" \w*: \w and Rachel| strong="H7354" \w* [travailed]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8799”}, [and she had hard]{strong=“H7185” x-morph=“strongMorph: \sc Th\sc*8762”} [labour]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 35:16 \ft a little…: Heb. a little piece of ground \f* 
\v 17 [And it came to pass, when she was in hard]{strong=“H7185” x-morph=“strongMorph: \sc Th\sc*8687”} [labour]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8800”}, [that the midwife]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8764”} [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto her, Fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [not; thou shalt have this son]{strong=“H1121”} also. 
\v 18 [And it came to pass, as her soul]{strong=“H5315”} [was in departing]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”}, ([for she died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}) [that she called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w his name| strong="H8034" \w* [Ben-oni]{strong=“H1126”}: \w but his father| strong="H1" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w him Benjamin| strong="H1144" \w*.\f + \fr 35:18 \ft Ben-oni: that is, The son of my sorrow \f* \f + \fr 35:18 \ft Benjamin: that is, The son of the right hand \f* 
\v 19 \w And Rachel| strong="H7354" \w* [died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, [and was buried]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the way| strong="H1870" \w* \w to Ephrath| strong="H672" \w*, which is [Beth-lehem]{strong=“H1035”}. 
\v 20 \w And Jacob| strong="H3290" \w* [set]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8686”} \w a pillar| strong="H4676" \w* \w upon her grave| strong="H6900" \w*: that is \w the pillar| strong="H4678" \w* [of Rachel’s]{strong=“H7354”} \w grave| strong="H6900" \w* \w unto this day| strong="H3117" \w*. 
\p
\v 21 \w And Israel| strong="H3478" \w* [journeyed]{strong=“H5265” x-morph=“strongMorph: \sc Th\sc*8799”}, [and spread]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8799”} \w his tent| strong="H168" \w* \w beyond| strong="H1973" \w* \w the tower| strong="H4026" \w* \w of Edar| strong="H4029" \w*. 
\v 22 [And it came to pass, when Israel]{strong=“H3478”} [dwelt]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8800”} \w in that land| strong="H776" \w*, \w that Reuben| strong="H7205" \w* [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [and lay]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w with Bilhah| strong="H1090" \w* [his father’s]{strong=“H1”} \w concubine| strong="H6370" \w*: \w and Israel| strong="H3478" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} it. \w Now the sons| strong="H1121" \w* \w of Jacob| strong="H3290" \w* [were twelve]{strong=“H6240 H8147”}: 
\v 23 \w The sons| strong="H1121" \w* \w of Leah| strong="H3812" \w*; \w Reuben| strong="H7205" \w*, [Jacob’s]{strong=“H3290”} \w firstborn| strong="H1060" \w*, \w and Simeon| strong="H8095" \w*, \w and Levi| strong="H3878" \w*, \w and Judah| strong="H3063" \w*, \w and Issachar| strong="H3485" \w*, \w and Zebulun| strong="H2074" \w*: 
\v 24 \w The sons| strong="H1121" \w* \w of Rachel| strong="H7354" \w*; \w Joseph| strong="H3130" \w*, \w and Benjamin| strong="H1144" \w*: 
\v 25 \w And the sons| strong="H1121" \w* \w of Bilhah| strong="H1090" \w*, [Rachel’s]{strong=“H7354”} \w handmaid| strong="H8198" \w*; \w Dan| strong="H1835" \w*, \w and Naphtali| strong="H5321" \w*: 
\v 26 \w And the sons| strong="H1121" \w* \w of Zilpah| strong="H2153" \w*, [Leah’s]{strong=“H3812”} \w handmaid| strong="H8198" \w*; \w Gad| strong="H1410" \w*, \w and Asher| strong="H836" \w*: these are \w the sons| strong="H1121" \w* \w of Jacob| strong="H3290" \w*, [which were born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8795”} [to him in Padan-aram]{strong=“H6307”}. 
\p
\v 27 \w And Jacob| strong="H3290" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Isaac| strong="H3327" \w* \w his father| strong="H1" \w* \w unto Mamre| strong="H4471" \w*, \w unto the city of Arbah| strong="H7153" \w*, which is \w Hebron| strong="H2275" \w*, \w where Abraham| strong="H85" \w* \w and Isaac| strong="H3327" \w* [sojourned]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 28 \w And the days| strong="H3117" \w* \w of Isaac| strong="H3327" \w* [were an hundred]{strong=“H8141 H3967”} \w and fourscore| strong="H8084" \w* \w years| strong="H8141" \w*. 
\v 29 \w And Isaac| strong="H3327" \w* [gave up the ghost]{strong=“H1478” x-morph=“strongMorph: \sc Th\sc*8799”}, [and died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, [and was gathered]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8735”} \w unto his people| strong="H5971" \w*, being \w old| strong="H2205" \w* \w and full| strong="H7649" \w* \w of days| strong="H3117" \w*: \w and his sons| strong="H1121" \w* \w Esau| strong="H6215" \w* \w and Jacob| strong="H3290" \w* [buried]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8799”} him. 
\c 36
\p 
\v 1 Now these are \w the generations| strong="H8435" \w* \w of Esau| strong="H6215" \w*, who is \w Edom| strong="H123" \w*. 
\v 2 \w Esau| strong="H6215" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w his wives| strong="H802" \w* \w of the daughters| strong="H1323" \w* \w of Canaan| strong="H3667" \w*; \w Adah| strong="H5711" \w* \w the daughter| strong="H1323" \w* \w of Elon| strong="H356" \w* \w the Hittite| strong="H2850" \w*, \w and Aholibamah| strong="H173" \w* \w the daughter| strong="H1323" \w* \w of Anah| strong="H6034" \w* \w the daughter| strong="H1323" \w* \w of Zibeon| strong="H6649" \w* \w the Hivite| strong="H2340" \w*; 
\v 3 \w And Bashemath| strong="H1315" \w* [Ishmael’s]{strong=“H3458”} \w daughter| strong="H1323" \w*, \w sister| strong="H269" \w* \w of Nebajoth| strong="H5032" \w*.\f + \fr 36:3 \ft Bashemath: or, Mahalath \f* 
\v 4 \w And Adah| strong="H5711" \w* [bare]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Esau| strong="H6215" \w* \w Eliphaz| strong="H464" \w*; \w and Bashemath| strong="H1315" \w* [bare]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} \w Reuel| strong="H7467" \w*; 
