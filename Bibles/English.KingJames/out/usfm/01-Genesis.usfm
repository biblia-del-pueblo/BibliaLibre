\c 16
\p 
\v 1 \w Now Sarai| strong="H8297" \w* [Abram’s]{strong=“H87”} \w wife| strong="H802" \w* \w bare| strong="H3205" \w* \w him no| strong="H3808" \w* [children]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”}: \w and she had an handmaid| strong="H8198" \w*, \w an Egyptian| strong="H4713" \w*, \w whose name| strong="H8034" \w* was \w Hagar| strong="H1904" \w*. 
