\v 11 \w And the angel| strong="H4397" \w* of the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto her, Behold]{strong=“H2009”}, thou art \w with child| strong="H2030" \w*, [and shalt bear]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”} \w a son| strong="H1121" \w*, [and shalt call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w his name| strong="H8034" \w* \w Ishmael| strong="H3458" \w*; because the \sc Lord\sc* [hath heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy affliction| strong="H6040" \w*.\f + \fr 16:11 \ft Ishmael: that is, God shall hear \f* 
\v 12 \w And he will be a wild| strong="H6501" \w* \w man| strong="H120" \w*; \w his hand| strong="H3027" \w* will be [against every man, and every man’s hand]{strong=“H3027”} [against him; and he shall dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the presence| strong="H6440" \w* \w of all his brethren| strong="H251" \w*. 
\v 13 [And she called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w the name| strong="H8034" \w* of the \sc Lord\sc* [that spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} [unto her, Thou God]{strong=“H410”} \w seest me| strong="H7210" \w*: [for she said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Have I also here| strong="H1988" \w* [looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w after him| strong="H310" \w* \w that seeth me| strong="H7210" \w*? 
\v 14 \w Wherefore the well| strong="H875" \w* [was called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [Beer-lahai-roi]{strong=“H2416 H883”}; behold, it is \w between Kadesh| strong="H6946" \w* \w and Bered| strong="H1260" \w*.\f + \fr 16:14 \ft Beer-lahai-roi: that is, The well of him that liveth and seeth me \f* 
\p
\v 15 \w And Hagar| strong="H1904" \w* [bare]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8799”} \w Abram| strong="H87" \w* \w a son| strong="H1121" \w*: \w and Abram| strong="H87" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} [his son’s]{strong=“H1121”} \w name| strong="H8034" \w*, \w which Hagar| strong="H1904" \w* [bare]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Ishmael| strong="H3458" \w*. 
\v 16 \w And Abram| strong="H87" \w* was [fourscore]{strong=“H8141 H8084”} \w and six| strong="H8337" \w* \w years| strong="H8141" \w* \w old| strong="H1121" \w*, \w when Hagar| strong="H1904" \w* [bare]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8800”} \w Ishmael| strong="H3458" \w* \w to Abram| strong="H87" \w*. 
\c 17
\p 
\v 1 \w And when Abram| strong="H87" \w* [was ninety]{strong=“H8141 H8673”} \w years| strong="H8141" \w* \w old| strong="H1121" \w* \w and nine| strong="H8672" \w*, the \sc Lord\sc* [appeared]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8735”} \w to Abram| strong="H87" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, I am \w the Almighty| strong="H7706" \w* \w God| strong="H410" \w*; [walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8690”} \w before me| strong="H6440" \w*, \w and be thou perfect| strong="H8549" \w*.\f + \fr 17:1 \ft perfect: or, upright, or, sincere \f* 
\v 2 [And I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w my covenant| strong="H1285" \w* [between me and thee, and will multiply]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} [thee exceedingly]{strong=“H3966 H3966”}. 
\v 3 \w And Abram| strong="H87" \w* [fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w on his face| strong="H6440" \w*: \w and God| strong="H430" \w* [talked]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [with him, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\p
\v 4 \w As for me| strong="H589" \w*, [behold, my covenant]{strong=“H1285”} is [with thee, and thou shalt be a father]{strong=“H1”} \w of many| strong="H1995" \w* \w nations| strong="H1471" \w*.\f + \fr 17:4 \ft many…: Heb. multitude of nations \f* 
\v 5 \w Neither shall thy name| strong="H8034" \w* [any more be called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8735”} \w Abram| strong="H87" \w*, \w but thy name| strong="H8034" \w* \w shall be Abraham| strong="H85" \w*; \w for a father| strong="H1" \w* \w of many| strong="H1995" \w* \w nations| strong="H1471" \w* [have I made thee]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 17:5 \ft Abraham: that is, Father of a great multitude \f* 
\v 6 \w And I will make| strong="H6509" \w* [thee exceeding]{strong=“H3966 H3966”} [fruitful]{strong=“H6509” x-morph=“strongMorph: \sc Th\sc*8689”}, [and I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w nations| strong="H1471" \w* [of thee, and kings]{strong=“H4428”} [shall come out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} of thee. 
\p
\v 7 [And I will establish]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} \w my covenant| strong="H1285" \w* \w between me and thee and thy seed| strong="H2233" \w* \w after thee| strong="H310" \w* \w in their generations| strong="H1755" \w* \w for an everlasting| strong="H5769" \w* \w covenant| strong="H1285" \w*, \w to be a God| strong="H430" \w* [unto thee, and to thy seed]{strong=“H2233”} \w after thee| strong="H310" \w*. 
\v 8 [And I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [unto thee, and to thy seed]{strong=“H2233”} \w after thee| strong="H310" \w*, \w the land| strong="H776" \w* \w wherein thou art a stranger| strong="H4033" \w*, \w all the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*, \w for an everlasting| strong="H5769" \w* \w possession| strong="H272" \w*; \w and I will be their God| strong="H430" \w*.\f + \fr 17:8 \ft wherein…: Heb. of thy sojournings \f* 
\p
\v 9 \w And God| strong="H430" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Abraham| strong="H85" \w*, [Thou shalt keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w my covenant| strong="H1285" \w* [therefore, thou, and thy seed]{strong=“H2233”} \w after thee| strong="H310" \w* \w in their generations| strong="H1755" \w*. 
\v 10 This is \w my covenant| strong="H1285" \w*, [which ye shall keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”}, \w between me and you and thy seed| strong="H2233" \w* \w after thee| strong="H310" \w*; \w Every man child| strong="H2145" \w* [among you shall be circumcised]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8736”}. 
\v 11 [And ye shall circumcise]{strong=“H5243” x-morph=“strongMorph: \sc Th\sc*8804”} \w the flesh| strong="H1320" \w* \w of your foreskin| strong="H6190" \w*; \w and it shall be a token| strong="H226" \w* \w of the covenant| strong="H1285" \w* betwixt me and you. 
\v 12 \w And he that is eight| strong="H8083" \w* \w days| strong="H3117" \w* \w old| strong="H1121" \w* [shall be circumcised]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8735”} [among you, every man child]{strong=“H2145”} \w in your generations| strong="H1755" \w*, \w he that is born| strong="H3211" \w* \w in the house| strong="H1004" \w*, \w or bought| strong="H4736" \w* \w with money| strong="H3701" \w* [of any stranger]{strong=“H5236 H1121”}, which is \w not of thy seed| strong="H2233" \w*.\f + \fr 17:12 \ft he that is eight…: Heb. a son of eight days \f* 
\v 13 \w He that is born| strong="H3211" \w* \w in thy house| strong="H1004" \w*, \w and he that is bought| strong="H4736" \w* \w with thy money| strong="H3701" \w*, [must needs]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8736”} [be circumcised]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8735”}: \w and my covenant| strong="H1285" \w* \w shall be in your flesh| strong="H1320" \w* \w for an everlasting| strong="H5769" \w* \w covenant| strong="H1285" \w*. 
\v 14 \w And the uncircumcised| strong="H6189" \w* \w man child| strong="H2145" \w* \w whose| strong="H834" \w* \w flesh| strong="H1320" \w* \w of his foreskin| strong="H6190" \w* [is not circumcised]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8735”}, \w that soul| strong="H5315" \w* [shall be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8738”} \w from his people| strong="H5971" \w*; [he hath broken]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8689”} \w my covenant| strong="H1285" \w*. 
\p
\v 15 \w And God| strong="H430" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Abraham| strong="H85" \w*, \w As for Sarai| strong="H8297" \w* \w thy wife| strong="H802" \w*, [thou shalt not call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w her name| strong="H8034" \w* \w Sarai| strong="H8297" \w*, \w but| strong="H3588" \w* \w Sarah| strong="H8283" \w* shall \w her name| strong="H8034" \w* be.\f + \fr 17:15 \ft Sarah: that is Princess \f* 
\v 16 [And I will bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} [her, and give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee a son| strong="H1121" \w* [also of her: yea, I will bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} her, and she shall be a mother \w of nations| strong="H1471" \w*; \w kings| strong="H4428" \w* \w of people| strong="H5971" \w* shall be of her.\f + \fr 17:16 \ft she…: Heb. she shall become nations \f* 
\v 17 \w Then Abraham| strong="H85" \w* [fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon his face| strong="H6440" \w*, [and laughed]{strong=“H6711” x-morph=“strongMorph: \sc Th\sc*8799”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his heart| strong="H3820" \w*, Shall a child [be born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8735”} \w unto him that is an hundred| strong="H3967" \w* \w years| strong="H8141" \w* \w old| strong="H1121" \w*? \w and shall Sarah| strong="H8283" \w*, \w that is ninety| strong="H8673" \w* \w years| strong="H8141" \w* \w old| strong="H1323" \w*, [bear]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8799”}? 
\v 18 \w And Abraham| strong="H85" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto God| strong="H430" \w*, \w O that| strong="H3863" \w* \w Ishmael| strong="H3458" \w* [might live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”} \w before thee| strong="H6440" \w*! 
\v 19 \w And God| strong="H430" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Sarah| strong="H8283" \w* \w thy wife| strong="H802" \w* [shall bear]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”} \w thee a son| strong="H1121" \w* \w indeed| strong="H61" \w*; [and thou shalt call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w his name| strong="H8034" \w* \w Isaac| strong="H3327" \w*: [and I will establish]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} \w my covenant| strong="H1285" \w* \w with him for an everlasting| strong="H5769" \w* \w covenant| strong="H1285" \w*, and \w with his seed| strong="H2233" \w* \w after him| strong="H310" \w*. 
\v 20 \w And as for Ishmael| strong="H3458" \w*, [I have heard thee]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}: [Behold, I have blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} [him, and will make him fruitful]{strong=“H6509” x-morph=“strongMorph: \sc Th\sc*8689”}, [and will multiply]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8689”} [him exceedingly]{strong=“H3966 H3966”}; [twelve]{strong=“H8147 H6240”} \w princes| strong="H5387" \w* [shall he beget]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8686”}, [and I will make him]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w a great| strong="H1419" \w* \w nation| strong="H1471" \w*. 
\v 21 \w But my covenant| strong="H1285" \w* [will I establish]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8686”} \w with Isaac| strong="H3327" \w*, \w which Sarah| strong="H8283" \w* [shall bear]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto thee at this set time| strong="H4150" \w* \w in the next| strong="H312" \w* \w year| strong="H8141" \w*. 
\v 22 [And he left off]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8762”} [talking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} [with him, and God]{strong=“H430”} [went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w from Abraham| strong="H85" \w*. 
\p
\v 23 \w And Abraham| strong="H85" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w Ishmael| strong="H3458" \w* \w his son| strong="H1121" \w*, \w and all that were born| strong="H3211" \w* \w in his house| strong="H1004" \w*, \w and all that were bought| strong="H4736" \w* \w with his money| strong="H3701" \w*, \w every male| strong="H2145" \w* \w among the men| strong="H582" \w* [of Abraham’s]{strong=“H85”} \w house| strong="H1004" \w*; [and circumcised]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8799”} \w the flesh| strong="H1320" \w* \w of their foreskin| strong="H6190" \w* \w in the selfsame| strong="H6106" \w* \w day| strong="H3117" \w*, \w as God| strong="H430" \w* [had said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} unto him. 
\v 24 \w And Abraham| strong="H85" \w* was \w ninety| strong="H8673" \w* \w years| strong="H8141" \w* \w old| strong="H1121" \w* \w and nine| strong="H8672" \w*, [when he was circumcised]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8736”} \w in the flesh| strong="H1320" \w* \w of his foreskin| strong="H6190" \w*. 
\v 25 \w And Ishmael| strong="H3458" \w* \w his son| strong="H1121" \w* was [thirteen]{strong=“H7969 H6240”} \w years| strong="H8141" \w* \w old| strong="H1121" \w*, [when he was circumcised]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8736”} \w in the flesh| strong="H1320" \w* \w of his foreskin| strong="H6190" \w*. 
\v 26 \w In the selfsame| strong="H6106" \w* \w day| strong="H3117" \w* \w was Abraham| strong="H85" \w* [circumcised]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and Ishmael| strong="H3458" \w* \w his son| strong="H1121" \w*. 
\v 27 \w And all the men| strong="H582" \w* \w of his house| strong="H1004" \w*, \w born| strong="H3211" \w* \w in the house| strong="H1004" \w*, \w and bought| strong="H4736" \w* \w with money| strong="H3701" \w* [of the stranger]{strong=“H5236 H1121”}, [were circumcised]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8738”} with him. 
\c 18
\p 
\v 1 And the \sc Lord\sc* [appeared ]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8735”} \w unto him in the plains| strong="H436" \w* \w of Mamre| strong="H4471" \w*: [and he sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the tent| strong="H168" \w* \w door| strong="H6607" \w* \w in the heat| strong="H2527" \w* \w of the day| strong="H3117" \w*;\f + \fr 18:1 \ft plain: Heb. plains \f* 
\v 2 [And he lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w his eyes| strong="H5869" \w* [and looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, [and, lo, three]{strong=“H7969”} \w men| strong="H582" \w* [stood]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8737”} [by him: and when he saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} them, [he ran]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”} [to meet]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} \w them from the tent| strong="H168" \w* \w door| strong="H6607" \w*, [and bowed]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} \w himself toward the ground| strong="H776" \w*, 
\v 3 [And said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w My Lord| strong="H136" \w*, [if now I have found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w favour| strong="H2580" \w* \w in thy sight| strong="H5869" \w*, [pass not away]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}, [I pray thee, from thy servant]{strong=“H5650”}: 
\v 4 \w Let a little| strong="H4592" \w* \w water| strong="H4325" \w*, \w I pray you| strong="H4994" \w*, [be fetched]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8714”}, [and wash]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8798”} \w your feet| strong="H7272" \w*, [and rest yourselves]{strong=“H8172” x-morph=“strongMorph: \sc Th\sc*8734”} \w under the tree| strong="H6086" \w*: 
\v 5 [And I will fetch]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a morsel| strong="H6595" \w* \w of bread| strong="H3899" \w*, [and comfort ye]{strong=“H5582” x-morph=“strongMorph: \sc Th\sc*8798”} \w your hearts| strong="H3820" \w*; \w after that| strong="H310" \w* [ye shall pass on]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}: [for therefore are ye come]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w to| strong="H5921" \w* \w your servant| strong="H5650" \w*. [And they said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}, [So do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}, [as thou hast said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 18:5 \ft comfort: Heb. stay \f* \f + \fr 18:5 \ft are…: Heb. you have passed \f* 
\v 6 \w And Abraham| strong="H85" \w* [hastened]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8762”} \w into the tent| strong="H168" \w* \w unto Sarah| strong="H8283" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Make ready quickly]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8761”} \w three| strong="H7969" \w* \w measures| strong="H5429" \w* \w of fine| strong="H5560" \w* \w meal| strong="H7058" \w*, [knead]{strong=“H3888” x-morph=“strongMorph: \sc Th\sc*8798”} it, \w and make| strong="H6213" \w* \w cakes| strong="H5692" \w* [upon the hearth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”}.\f + \fr 18:6 \ft Make ready…: Heb. Hasten \f* 
\v 7 \w And Abraham| strong="H85" \w* [ran]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the herd| strong="H1241" \w*, [and fetcht]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [a calf]{strong=“H1241 H1121”} \w tender| strong="H7390" \w* \w and good| strong="H2896" \w*, [and gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} it \w unto a young man| strong="H5288" \w*; [and he hasted]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8762”} [to dress]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} it. 
\v 8 [And he took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w butter| strong="H2529" \w*, \w and milk| strong="H2461" \w*, [and the calf]{strong=“H1241 H1121”} [which he had dressed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [and set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} it \w before them| strong="H6440" \w*; [and he stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w by them under the tree| strong="H6086" \w*, [and they did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 9 [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Where]{strong=“H346”} is \w Sarah| strong="H8283" \w* \w thy wife| strong="H802" \w*? [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Behold, in the tent]{strong=“H168”}. 
\v 10 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will certainly]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} [return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto thee according to the time| strong="H6256" \w* \w of life| strong="H2416" \w*; [and, lo, Sarah]{strong=“H8283”} \w thy wife| strong="H802" \w* \w shall have a son| strong="H1121" \w*. \w And Sarah| strong="H8283" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} it \w in the tent| strong="H168" \w* \w door| strong="H6607" \w*, which was \w behind him| strong="H310" \w*. 
\v 11 \w Now Abraham| strong="H85" \w* \w and Sarah| strong="H8283" \w* were \w old| strong="H2205" \w* and [well stricken]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w in age| strong="H3117" \w*; and [it ceased]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8804”} \w to be with Sarah| strong="H8283" \w* \w after the manner| strong="H734" \w* \w of women| strong="H802" \w*. 
\v 12 \w Therefore Sarah| strong="H8283" \w* [laughed]{strong=“H6711” x-morph=“strongMorph: \sc Th\sc*8799”} \w within herself| strong="H7130" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w After| strong="H310" \w* [I am waxed old]{strong=“H1086” x-morph=“strongMorph: \sc Th\sc*8800”} \w shall I have pleasure| strong="H5730" \w*, \w my lord| strong="H113" \w* [being old also]{strong=“H2204” x-morph=“strongMorph: \sc Th\sc*8804”}? 
\v 13 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Abraham| strong="H85" \w*, \w Wherefore| strong="H4100" \w* \w did Sarah| strong="H8283" \w* [laugh]{strong=“H6711” x-morph=“strongMorph: \sc Th\sc*8804”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Shall I of a surety| strong="H552" \w* [bear]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8799”} [a child, which]{strong=“H589”} [am old]{strong=“H2204” x-morph=“strongMorph: \sc Th\sc*8804”}? 
