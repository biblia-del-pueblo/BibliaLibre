\v 5 [Now therefore be not grieved]{strong=“H6087” x-morph=“strongMorph: \sc Th\sc*8735”}, [nor angry]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8799”} \w with yourselves| strong="H5869" \w*, [that ye sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8804”} [me hither: for God]{strong=“H430”} [did send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w me before you| strong="H6440" \w* \w to preserve life| strong="H4241" \w*.\f + \fr 45:5 \ft nor…: Heb. neither let there be anger in your eyes \f* 
\v 6 \w For these two years| strong="H8141" \w* hath \w the famine| strong="H7458" \w* been \w in| strong="H7130" \w* \w the land| strong="H776" \w*: and yet there are \w five| strong="H2568" \w* \w years| strong="H8141" \w*, in the which there shall \w neither| strong="H369" \w* be \w earing| strong="H2758" \w* \w nor harvest| strong="H7105" \w*. 
\v 7 \w And God| strong="H430" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w me before you| strong="H6440" \w* [to preserve]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w you a posterity| strong="H7611" \w* \w in the earth| strong="H776" \w*, [and to save your lives]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8687”} \w by a great| strong="H1419" \w* \w deliverance| strong="H6413" \w*.\f + \fr 45:7 \ft to preserve…: Heb. to put for you a remnant \f* 
