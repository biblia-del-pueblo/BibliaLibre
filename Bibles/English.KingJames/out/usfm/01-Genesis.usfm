\c 15
\p 
\v 1 \w After| strong="H310" \w* \w these things| strong="H1697" \w* \w the word| strong="H1697" \w* of the \sc Lord\sc* [came]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto Abram| strong="H87" \w* \w in a vision| strong="H4236" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [not, Abram]{strong=“H87”}: I am \w thy shield| strong="H4043" \w*, and \w thy exceeding| strong="H3966" \w* [great]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8687”} \w reward| strong="H7939" \w*. 
\p
