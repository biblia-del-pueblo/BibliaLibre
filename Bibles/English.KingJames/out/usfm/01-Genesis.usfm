\v 10 \w And Jacob| strong="H3290" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Nay, I pray thee, if now I have found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w grace| strong="H2580" \w* \w in thy sight| strong="H5869" \w*, [then receive]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w my present| strong="H4503" \w* \w at my hand| strong="H3027" \w*: [for therefore I have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy face| strong="H6440" \w*, [as though I had seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w the face| strong="H6440" \w* \w of God| strong="H430" \w*, [and thou wast pleased with me]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 11 [Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”}, [I pray thee, my blessing]{strong=“H1293”} [that is brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8717”} [to thee; because God]{strong=“H430”} [hath dealt graciously with me]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and because| strong="H3605" \w* \w I have| strong="H3426" \w* \w enough| strong="H3605" \w*. [And he urged]{strong=“H6484” x-morph=“strongMorph: \sc Th\sc*8799”} [him, and he took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} it.\f + \fr 33:11 \ft enough: Heb. all things \f* 
\v 12 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Let us take our journey]{strong=“H5265” x-morph=“strongMorph: \sc Th\sc*8799”}, [and let us go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [and I will go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} before thee. 
\v 13 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, My lord]{strong=“H113”} [knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w that the children| strong="H3206" \w* are \w tender| strong="H7390" \w*, \w and the flocks| strong="H6629" \w* \w and herds| strong="H1241" \w* [with young]{strong=“H5763” x-morph=“strongMorph: \sc Th\sc*8802”} are [with me: and if men should overdrive]{strong=“H1849” x-morph=“strongMorph: \sc Th\sc*8804”} \w them one| strong="H259" \w* \w day| strong="H3117" \w*, \w all the flock| strong="H6629" \w* [will die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 14 \w Let my lord| strong="H113" \w*, [I pray thee, pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* \w his servant| strong="H5650" \w*: [and I will lead on]{strong=“H5095” x-morph=“strongMorph: \sc Th\sc*8691”} \w softly| strong="H328" \w*, \w according as| strong="H7272" \w* \w the cattle| strong="H4399" \w* \w that goeth before me| strong="H6440" \w* \w and the children| strong="H3206" \w* \w be able to endure| strong="H7272" \w*, [until I come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto my lord| strong="H113" \w* \w unto Seir| strong="H8165" \w*.\f + \fr 33:14 \ft according…: Heb. according to the foot of the work, etc., and according to the foot of the children \f* 
\v 15 \w And Esau| strong="H6215" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Let me now leave]{strong=“H3322” x-morph=“strongMorph: \sc Th\sc*8686”} with thee some \w of the folk| strong="H5971" \w* that are [with me. And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w What| strong="H4100" \w* [needeth it? let me find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w grace| strong="H2580" \w* \w in the sight| strong="H5869" \w* \w of my lord| strong="H113" \w*.\f + \fr 33:15 \ft leave: Heb. set, or, place \f* \f + \fr 33:15 \ft What…: Heb. Wherefore is this? \f* 
\p
\v 16 \w So Esau| strong="H6215" \w* [returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w that day| strong="H3117" \w* \w on his way| strong="H1870" \w* \w unto Seir| strong="H8165" \w*. 
\v 17 \w And Jacob| strong="H3290" \w* [journeyed]{strong=“H5265” x-morph=“strongMorph: \sc Th\sc*8804”} \w to Succoth| strong="H5523" \w*, [and built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w him an house| strong="H1004" \w*, [and made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w booths| strong="H5521" \w* \w for his cattle| strong="H4735" \w*: \w therefore the name| strong="H8034" \w* \w of the place| strong="H4725" \w* [is called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w Succoth| strong="H5523" \w*.\f + \fr 33:17 \ft Succoth: that is, Booths \f* 
\p
\v 18 \w And Jacob| strong="H3290" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Shalem| strong="H8004" \w*, \w a city| strong="H5892" \w* \w of Shechem| strong="H7927" \w*, which is \w in the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*, [when he came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [from Padan-aram]{strong=“H6307”}; [and pitched his tent]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* \w the city| strong="H5892" \w*.\f + \fr 33:18 \ft Shechem: Gr. Sychem \f* 
