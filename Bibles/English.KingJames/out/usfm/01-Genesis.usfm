\v 3 [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w one| strong="H376" \w* \w to another| strong="H7453" \w*, [Go to]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”}, [let us make]{strong=“H3835” x-morph=“strongMorph: \sc Th\sc*8799”} \w brick| strong="H3843" \w*, [and burn]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8799”} \w them throughly| strong="H8316" \w*. \w And they had brick| strong="H3843" \w* \w for stone| strong="H68" \w*, \w and slime| strong="H2564" \w* [had]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8804”} \w they for morter| strong="H2563" \w*.\f + \fr 11:3 \ft they said…: Heb. a man said to his neighbour \f* \f + \fr 11:3 \ft burn…: Heb. burn them to a burning \f* 
\v 4 [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Go to]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”}, [let us build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w us a city| strong="H5892" \w* \w and a tower| strong="H4026" \w*, \w whose top| strong="H7218" \w* may reach \w unto heaven| strong="H8064" \w*; [and let us make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w us a name| strong="H8034" \w*, [lest we be scattered abroad]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the face| strong="H6440" \w* \w of the whole earth| strong="H776" \w*. 
\p
\v 5 And the \sc Lord\sc* [came down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} [to see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w the city| strong="H5892" \w* \w and the tower| strong="H4026" \w*, \w which the children| strong="H1121" \w* \w of men| strong="H120" \w* [builded]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”}. 
