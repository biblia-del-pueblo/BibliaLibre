\c 3
\p 
\v 1 \w Now the serpent| strong="H5175" \w* [was]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8804”} \w more subtil| strong="H6175" \w* \w than any beast| strong="H2416" \w* \w of the field| strong="H7704" \w* which the \sc Lord\sc* \w God| strong="H430" \w* [had made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}. [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the woman| strong="H802" \w*, \w Yea| strong="H637" \w*, \w hath God| strong="H430" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Ye shall not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w of every tree| strong="H6086" \w* \w of the garden| strong="H1588" \w*?\f + \fr 3:1 \ft Yea…: Heb. Yea, because, etc. \f* 
\v 2 \w And the woman| strong="H802" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the serpent| strong="H5175" \w*, [We may eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the fruit| strong="H6529" \w* \w of the trees| strong="H6086" \w* \w of the garden| strong="H1588" \w*: 
\v 3 \w But of the fruit| strong="H6529" \w* \w of the tree| strong="H6086" \w* which is \w in the midst| strong="H8432" \w* \w of the garden| strong="H1588" \w*, \w God| strong="H430" \w* [hath said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Ye shall not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [of it, neither shall ye touch]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8799”} [it, lest]{strong=“H6435”} [ye die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 4 \w And the serpent| strong="H5175" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the woman| strong="H802" \w*, [Ye shall not surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}: 
\v 5 \w For God| strong="H430" \w* [doth know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w that in the day| strong="H3117" \w* [ye eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} [thereof, then your eyes]{strong=“H5869”} [shall be opened]{strong=“H6491” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and ye shall be as gods| strong="H430" \w*, [knowing]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w good| strong="H2896" \w* \w and evil| strong="H7451" \w*. 
\p
\v 6 \w And when the woman| strong="H802" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w that the tree| strong="H6086" \w* was \w good| strong="H2896" \w* \w for food| strong="H3978" \w*, \w and that it| strong="H1931" \w* was \w pleasant| strong="H8378" \w* \w to the eyes| strong="H5869" \w*, \w and a tree| strong="H6086" \w* [to be desired]{strong=“H2530” x-morph=“strongMorph: \sc Th\sc*8737”} to make one [wise]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8687”}, [she took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the fruit thereof| strong="H6529" \w*, [and did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}, [and gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w also| strong="H1571" \w* \w unto her husband| strong="H376" \w* [with her; and he did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 3:6 \ft pleasant: Heb. a desire \f* 
\v 7 \w And the eyes| strong="H5869" \w* \w of them both| strong="H8147" \w* [were opened]{strong=“H6491” x-morph=“strongMorph: \sc Th\sc*8735”}, \w and they| strong="H1992" \w* [knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} that they were \w naked| strong="H5903" \w*; \w and they sewed| strong="H8609" \w* \w fig| strong="H8384" \w* \w leaves| strong="H5929" \w* [together]{strong=“H8609” x-morph=“strongMorph: \sc Th\sc*8799”}, [and made themselves]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w aprons| strong="H2290" \w*.\f + \fr 3:7 \ft aprons: or, things to gird about \f* 
\v 8 [And they heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w the voice| strong="H6963" \w* of the \sc Lord\sc* \w God| strong="H430" \w* [walking]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8693”} \w in the garden| strong="H1588" \w* \w in the cool| strong="H7307" \w* \w of the day| strong="H3117" \w*: \w and Adam| strong="H120" \w* \w and his wife| strong="H802" \w* [hid themselves]{strong=“H2244” x-morph=“strongMorph: \sc Th\sc*8691”} \w from the presence| strong="H6440" \w* of the \sc Lord\sc* \w God| strong="H430" \w* \w amongst| strong="H8432" \w* \w the trees| strong="H6086" \w* \w of the garden| strong="H1588" \w*.\f + \fr 3:8 \ft cool: Heb. wind \f* 
\p
\v 9 And the \sc Lord\sc* \w God| strong="H430" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Adam| strong="H120" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, Where art \w thou| strong="H335" \w*? 
\v 10 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy voice| strong="H6963" \w* \w in the garden| strong="H1588" \w*, [and I was afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}, \w because I| strong="H595" \w* was \w naked| strong="H5903" \w*; [and I hid myself]{strong=“H2244” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\p
\v 11 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Who| strong="H4310" \w* [told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} thee that thou wast \w naked| strong="H5903" \w*? [Hast thou eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the tree| strong="H6086" \w*, [whereof I commanded thee]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w that thou shouldest not| strong="H1115" \w* [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”}? 
\v 12 \w And the man| strong="H120" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w The woman| strong="H802" \w* [whom thou gavest]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} to be \w with me| strong="H5978" \w*, \w she| strong="H1931" \w* [gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w me of the tree| strong="H6086" \w*, [and I did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 13 And the \sc Lord\sc* \w God| strong="H430" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the woman| strong="H802" \w*, What is this that [thou hast done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}? \w And the woman| strong="H802" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w The serpent| strong="H5175" \w* [beguiled me]{strong=“H5377” x-morph=“strongMorph: \sc Th\sc*8689”}, [and I did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 14 And the \sc Lord\sc* \w God| strong="H430" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the serpent| strong="H5175" \w*, \w Because thou| strong="H859" \w* [hast done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} this, thou art [cursed]{strong=“H779” x-morph=“strongMorph: \sc Th\sc*8803”} \w above all cattle| strong="H929" \w*, \w and above every beast| strong="H2416" \w* \w of the field| strong="H7704" \w*; \w upon thy belly| strong="H1512" \w* [shalt thou go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and dust| strong="H6083" \w* [shalt thou eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the days| strong="H3117" \w* \w of thy life| strong="H2416" \w*: 
