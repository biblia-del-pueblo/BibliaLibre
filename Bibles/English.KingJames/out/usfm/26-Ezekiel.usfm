\v 36 [The merchants]{strong=“H5503” x-morph=“strongMorph: \sc Th\sc*8802”} \w among the people| strong="H5971" \w* [shall hiss]{strong=“H8319” x-morph=“strongMorph: \sc Th\sc*8804”} [at thee; thou shalt be a terror]{strong=“H1091”}, and never shalt be [any more]{strong=“H5769 H5704”}.\f + \fr 27:36 \ft a terror: Heb. terrors \f* \f + \fr 27:36 \ft never…: Heb. shalt not be for ever \f*
\c 28
\p 
\v 1 \w The word| strong="H1697" \w* of the \sc Lord\sc* [came again unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto the prince| strong="H5057" \w* \w of Tyrus| strong="H6865" \w*, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w Because thine heart| strong="H3820" \w* is [lifted up]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8804”}, [and thou hast said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, I am \w a God| strong="H410" \w*, [I sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} in \w the seat| strong="H4186" \w* \w of God| strong="H430" \w*, \w in the midst| strong="H3820" \w* \w of the seas| strong="H3220" \w*; yet thou art \w a man| strong="H120" \w*, \w and not God| strong="H410" \w*, [though thou set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thine heart| strong="H3820" \w* \w as the heart| strong="H3820" \w* \w of God| strong="H430" \w*:\f + \fr 28:2 \ft midst: Heb. heart \f* 
\v 3 Behold, thou art \w wiser| strong="H2450" \w* \w than Daniel| strong="H1840" \w*; [there is no secret]{strong=“H5640” x-morph=“strongMorph: \sc Th\sc*8803”} [that they can hide]{strong=“H6004” x-morph=“strongMorph: \sc Th\sc*8804”} from thee: 
\v 4 \w With thy wisdom| strong="H2451" \w* \w and with thine understanding| strong="H8394" \w* [thou hast gotten]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee riches| strong="H2428" \w*, [and hast gotten]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w gold| strong="H2091" \w* \w and silver| strong="H3701" \w* \w into thy treasures| strong="H214" \w*: 
\v 5 \w By thy great| strong="H7230" \w* \w wisdom| strong="H2451" \w* and \w by thy traffick| strong="H7404" \w* [hast thou increased]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy riches| strong="H2428" \w*, \w and thine heart| strong="H3824" \w* [is lifted up]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8799”} \w because of thy riches| strong="H2428" \w*:\f + \fr 28:5 \ft thy great…: Heb. the greatness of thy wisdom \f* 
\v 6 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Because thou hast set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w thine heart| strong="H3820" \w* \w as the heart| strong="H3824" \w* \w of God| strong="H430" \w*; 
\v 7 [Behold, therefore I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} [strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} [upon thee, the terrible]{strong=“H6184”} \w of the nations| strong="H1471" \w*: [and they shall draw]{strong=“H7324” x-morph=“strongMorph: \sc Th\sc*8689”} \w their swords| strong="H2719" \w* \w against the beauty| strong="H3308" \w* \w of thy wisdom| strong="H2451" \w*, [and they shall defile]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy brightness| strong="H3314" \w*. 
\v 8 [They shall bring thee down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8686”} \w to the pit| strong="H7845" \w*, [and thou shalt die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”} \w the deaths| strong="H4463" \w* of them that are \w slain| strong="H2491" \w* \w in the midst| strong="H3820" \w* \w of the seas| strong="H3220" \w*. 
\v 9 [Wilt thou yet]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* [him that slayeth]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8802”} thee, I am \w God| strong="H430" \w*? but thou shalt be \w a man| strong="H120" \w*, \w and no God| strong="H410" \w*, \w in the hand| strong="H3027" \w* [of him that slayeth]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8764”} thee.\f + \fr 28:9 \ft of him that slayeth: or, of him that woundeth \f* 
\v 10 [Thou shalt die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w the deaths| strong="H4194" \w* \w of the uncircumcised| strong="H6189" \w* \w by the hand| strong="H3027" \w* [of strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”}: [for I have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\p
\v 11 \w Moreover the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 12 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [take up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w a lamentation| strong="H7015" \w* \w upon the king| strong="H4428" \w* \w of Tyrus| strong="H6865" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto him, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Thou sealest up]{strong=“H2856” x-morph=“strongMorph: \sc Th\sc*8802”} \w the sum| strong="H8508" \w*, \w full| strong="H4392" \w* \w of wisdom| strong="H2451" \w*, \w and perfect| strong="H3632" \w* \w in beauty| strong="H3308" \w*. 
\v 13 \w Thou hast been in Eden| strong="H5731" \w* \w the garden| strong="H1588" \w* \w of God| strong="H430" \w*; \w every precious| strong="H3368" \w* \w stone| strong="H68" \w* was \w thy covering| strong="H4540" \w*, \w the sardius| strong="H124" \w*, \w topaz| strong="H6357" \w*, \w and the diamond| strong="H3095" \w*, \w the beryl| strong="H8658" \w*, \w the onyx| strong="H7718" \w*, \w and the jasper| strong="H3471" \w*, \w the sapphire| strong="H5601" \w*, \w the emerald| strong="H5306" \w*, \w and the carbuncle| strong="H1304" \w*, \w and gold| strong="H2091" \w*: \w the workmanship| strong="H4399" \w* \w of thy tabrets| strong="H8596" \w* \w and of thy pipes| strong="H5345" \w* [was prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8797”} \w in thee in the day| strong="H3117" \w* [that thou wast created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8736”}.\f + \fr 28:13 \ft sardius: or, ruby \f* \f + \fr 28:13 \ft beryl: or, chrysolite \f* \f + \fr 28:13 \ft emerald: or, chrysoprase \f* 
\v 14 Thou art \w the anointed| strong="H4473" \w* \w cherub| strong="H3742" \w* [that covereth]{strong=“H5526” x-morph=“strongMorph: \sc Th\sc*8802”}; [and I have set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} thee so: \w thou wast upon the holy| strong="H6944" \w* \w mountain| strong="H2022" \w* \w of God| strong="H430" \w*; [thou hast walked up and down]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8694”} \w in the midst| strong="H8432" \w* \w of the stones| strong="H68" \w* \w of fire| strong="H784" \w*. 
\v 15 Thou wast \w perfect| strong="H8549" \w* \w in thy ways| strong="H1870" \w* \w from the day| strong="H3117" \w* [that thou wast created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8736”}, \w till iniquity| strong="H5766" \w* [was found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8738”} in thee. 
\v 16 \w By the multitude| strong="H7230" \w* \w of thy merchandise| strong="H7404" \w* [they have filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w the midst| strong="H8432" \w* \w of thee with violence| strong="H2555" \w*, [and thou hast sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8799”}: [therefore I will cast thee as profane]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8762”} \w out of the mountain| strong="H2022" \w* \w of God| strong="H430" \w*: [and I will destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8762”} [thee, O covering]{strong=“H5526” x-morph=“strongMorph: \sc Th\sc*8802”} \w cherub| strong="H3742" \w*, \w from the midst| strong="H8432" \w* \w of the stones| strong="H68" \w* \w of fire| strong="H784" \w*. 
\v 17 \w Thine heart| strong="H3820" \w* [was lifted up]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8804”} \w because of thy beauty| strong="H3308" \w*, [thou hast corrupted]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy wisdom| strong="H2451" \w* \w by reason of| strong="H5921" \w* \w thy brightness| strong="H3314" \w*: [I will cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee to the ground| strong="H776" \w*, [I will lay]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee before| strong="H6440" \w* \w kings| strong="H4428" \w*, [that they may behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} thee. 
\v 18 [Thou hast defiled]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy sanctuaries| strong="H4720" \w* \w by the multitude| strong="H7230" \w* \w of thine iniquities| strong="H5771" \w*, \w by the iniquity| strong="H5766" \w* \w of thy traffick| strong="H7404" \w*; [therefore will I bring forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w a fire| strong="H784" \w* \w from the midst| strong="H8432" \w* [of thee, it shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, and I will bring]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee to ashes| strong="H665" \w* \w upon the earth| strong="H776" \w* \w in the sight| strong="H5869" \w* [of all them that behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} thee. 
\v 19 [All they that know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w thee among the people| strong="H5971" \w* [shall be astonished]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8804”} [at thee: thou shalt be a terror]{strong=“H1091”}, \w and never| strong="H369" \w* shalt thou be [any more]{strong=“H5769 H5704”}.\f + \fr 28:19 \ft a terror: Heb. terrors \f* 
\p
\v 20 \w Again the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 21 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy face| strong="H6440" \w* \w against Zidon| strong="H6721" \w*, [and prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} against it, 
\v 22 [And say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; Behold, I am [against thee, O Zidon]{strong=“H6721”}; [and I will be glorified]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the midst| strong="H8432" \w* [of thee: and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*, [when I shall have executed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w judgments| strong="H8201" \w* [in her, and shall be sanctified]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8738”} in her. 
\v 23 [For I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w into her pestilence| strong="H1698" \w*, \w and blood| strong="H1818" \w* \w into her streets| strong="H2351" \w*; \w and the wounded| strong="H2491" \w* [shall be judged]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8768”} \w in the midst| strong="H8432" \w* \w of her by the sword| strong="H2719" \w* \w upon her on every side| strong="H5439" \w*; [and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*. 
\p
\v 24 [And there shall be no more a pricking]{strong=“H3992” x-morph=“strongMorph: \sc Th\sc*8688”} \w brier| strong="H5544" \w* \w unto the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, nor any [grieving]{strong=“H3510” x-morph=“strongMorph: \sc Th\sc*8688”} \w thorn| strong="H6975" \w* of all that are \w round about| strong="H5439" \w* [them, that despised]{strong=“H7590” x-morph=“strongMorph: \sc Th\sc*8801”} [them; and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am \w the Lord| strong="H136" \w* \sc God\sc*. 
\v 25 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [When I shall have gathered]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8763”} \w the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* \w from the people| strong="H5971" \w* [among whom they are scattered]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8738”}, [and shall be sanctified]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8738”} \w in them in the sight| strong="H5869" \w* \w of the heathen| strong="H1471" \w*, [then shall they dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w in their land| strong="H127" \w* [that I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w to my servant| strong="H5650" \w* \w Jacob| strong="H3290" \w*. 
\v 26 [And they shall dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w safely| strong="H983" \w* [therein, and shall build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w houses| strong="H1004" \w*, [and plant]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8804”} \w vineyards| strong="H3754" \w*; [yea, they shall dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w with confidence| strong="H983" \w*, [when I have executed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w judgments| strong="H8201" \w* [upon all those that despise]{strong=“H7590” x-morph=“strongMorph: \sc Th\sc*8801”} \w them round about| strong="H5439" \w* [them; and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc* \w their God| strong="H430" \w*.\f + \fr 28:26 \ft safely: or, with confidence \f* \f + \fr 28:26 \ft despise: or, spoil \f*
\c 29
\p 
\v 1 \w In the tenth| strong="H6224" \w* \w year| strong="H8141" \w*, \w in the tenth| strong="H6224" \w* month, [in the twelfth]{strong=“H6240 H8147”} day \w of the month| strong="H2320" \w*, \w the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy face| strong="H6440" \w* \w against Pharaoh| strong="H6547" \w* \w king| strong="H4428" \w* \w of Egypt| strong="H4714" \w*, [and prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} [against him, and against all Egypt]{strong=“H4714”}: 
\v 3 [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”}, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; Behold, I am [against thee, Pharaoh]{strong=“H6547”} \w king| strong="H4428" \w* \w of Egypt| strong="H4714" \w*, \w the great| strong="H1419" \w* \w dragon| strong="H8577" \w* [that lieth]{strong=“H7257” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the midst| strong="H8432" \w* \w of his rivers| strong="H2975" \w*, [which hath said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w My river| strong="H2975" \w* is [mine own, and I have made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} it for myself. 
\v 4 [But I will put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [hooks]{strong=“H2397 H2397” x-morph=“strongMorph: \sc Th\sc*8676”} \w in thy jaws| strong="H3895" \w*, \w and I will cause the fish| strong="H1710" \w* \w of thy rivers| strong="H2975" \w* [to stick]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8689”} \w unto thy scales| strong="H7193" \w*, [and I will bring thee up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} \w out of the midst| strong="H8432" \w* \w of thy rivers| strong="H2975" \w*, \w and all the fish| strong="H1710" \w* \w of thy rivers| strong="H2975" \w* [shall stick]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto thy scales| strong="H7193" \w*. 
\v 5 [And I will leave]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8804”} thee thrown \w into the wilderness| strong="H4057" \w*, \w thee and all the fish| strong="H1710" \w* \w of thy rivers| strong="H2975" \w*: [thou shalt fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the open| strong="H6440" \w* \w fields| strong="H7704" \w*; [thou shalt not be brought together]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8735”}, [nor gathered]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8735”}: [I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee for meat| strong="H402" \w* \w to the beasts| strong="H2416" \w* \w of the field| strong="H776" \w* \w and to the fowls| strong="H5775" \w* \w of the heaven| strong="H8064" \w*.\f + \fr 29:5 \ft open…: Heb. face of the field \f* 
\v 6 [And all the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Egypt| strong="H4714" \w* [shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*, \w because they have been a staff| strong="H4938" \w* \w of reed| strong="H7070" \w* \w to the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*. 
\v 7 [When they took hold]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8800”} \w of thee by thy hand| strong="H3709" \w*, [thou didst break]{strong=“H7533” x-morph=“strongMorph: \sc Th\sc*8735”}, [and rend]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8804”} \w all their shoulder| strong="H3802" \w*: [and when they leaned]{strong=“H8172” x-morph=“strongMorph: \sc Th\sc*8736”} [upon thee, thou brakest]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8735”}, \w and madest all their loins| strong="H4975" \w* [to be at a stand]{strong=“H5976” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\p
\v 8 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Behold, I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w a sword| strong="H2719" \w* [upon thee, and cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w man| strong="H120" \w* \w and beast| strong="H929" \w* out of thee. 
\v 9 \w And the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* \w shall be desolate| strong="H8077" \w* \w and waste| strong="H2723" \w*; [and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*: [because he hath said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w The river| strong="H2975" \w* is [mine, and I have made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} it. 
\v 10 Behold, therefore I am [against thee, and against thy rivers]{strong=“H2975”}, [and I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* \w utterly| strong="H2721" \w* \w waste| strong="H2723" \w* and \w desolate| strong="H8077" \w*, \w from the tower| strong="H4024" \w* \w of Syene| strong="H5482" \w* \w even unto the border| strong="H1366" \w* \w of Ethiopia| strong="H3568" \w*.\f + \fr 29:10 \ft utterly…: Heb. wastes of waste \f* \f + \fr 29:10 \ft from…: or, from Migdol to Syene \f* \f + \fr 29:10 \ft Syene: Heb. Seveneh \f* 
\v 11 \w No foot| strong="H7272" \w* \w of man| strong="H120" \w* [shall pass through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} [it, nor foot]{strong=“H7272”} \w of beast| strong="H929" \w* [shall pass through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} [it, neither shall it be inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w forty| strong="H705" \w* \w years| strong="H8141" \w*. 
\v 12 [And I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* \w desolate| strong="H8077" \w* \w in the midst| strong="H8432" \w* \w of the countries| strong="H776" \w* that are [desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8737”}, \w and her cities| strong="H5892" \w* \w among| strong="H8432" \w* \w the cities| strong="H5892" \w* that are [laid waste]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8716”} \w shall be desolate| strong="H8077" \w* \w forty| strong="H705" \w* \w years| strong="H8141" \w*: [and I will scatter]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8689”} \w the Egyptians| strong="H4714" \w* \w among the nations| strong="H1471" \w*, [and will disperse]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8765”} \w them through the countries| strong="H776" \w*. 
\p
\v 13 [Yet thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w At the end| strong="H7093" \w* \w of forty| strong="H705" \w* \w years| strong="H8141" \w* [will I gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8762”} \w the Egyptians| strong="H4714" \w* \w from the people| strong="H5971" \w* [whither they were scattered]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8738”}: 
\v 14 [And I will bring again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w the captivity| strong="H7622" \w* \w of Egypt| strong="H4714" \w*, [and will cause them to return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} into \w the land| strong="H776" \w* \w of Pathros| strong="H6624" \w*, \w into the land| strong="H776" \w* \w of their habitation| strong="H4351" \w*; \w and they shall be there a base| strong="H8217" \w* \w kingdom| strong="H4467" \w*.\f + \fr 29:14 \ft habitation: or, birth \f* \f + \fr 29:14 \ft base: Heb. low \f* 
\v 15 \w It shall be the basest| strong="H8217" \w* \w of the kingdoms| strong="H4467" \w*; [neither shall it exalt]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8691”} \w itself any more above the nations| strong="H1471" \w*: [for I will diminish]{strong=“H4591” x-morph=“strongMorph: \sc Th\sc*8689”} [them, that they shall no more rule]{strong=“H7287” x-morph=“strongMorph: \sc Th\sc*8800”} \w over the nations| strong="H1471" \w*. 
\v 16 \w And it shall be no more the confidence| strong="H4009" \w* \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, \w which bringeth| strong="H2142" \w* their \w iniquity| strong="H5771" \w* [to remembrance]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8688”}, [when they shall look]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8800”} \w after| strong="H310" \w* [them: but they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am \w the Lord| strong="H136" \w* \sc God\sc*. 
\p
\v 17 \w And it came to pass in the seven| strong="H7651" \w* \w and twentieth| strong="H6242" \w* \w year| strong="H8141" \w*, \w in the first| strong="H7223" \w* month, \w in the first| strong="H259" \w* day \w of the month| strong="H2320" \w*, \w the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 18 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, \w Nebuchadrezzar| strong="H5019" \w* \w king| strong="H4428" \w* \w of Babylon| strong="H894" \w* \w caused| strong="H5647" \w* \w his army| strong="H2428" \w* [to serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8689”} \w a great| strong="H1419" \w* \w service| strong="H5656" \w* \w against Tyrus| strong="H6865" \w*: \w every head| strong="H7218" \w* was [made bald]{strong=“H7139” x-morph=“strongMorph: \sc Th\sc*8716”}, \w and every shoulder| strong="H3802" \w* was [peeled]{strong=“H4803” x-morph=“strongMorph: \sc Th\sc*8803”}: \w yet had he no wages| strong="H7939" \w*, \w nor his army| strong="H2428" \w*, \w for Tyrus| strong="H6865" \w*, \w for the service| strong="H5656" \w* [that he had served]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} against it: 
\v 19 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Behold, I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* \w unto Nebuchadrezzar| strong="H5019" \w* \w king| strong="H4428" \w* \w of Babylon| strong="H894" \w*; [and he shall take]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w her multitude| strong="H1995" \w*, [and take]{strong=“H7997” x-morph=“strongMorph: \sc Th\sc*8804”} \w her spoil| strong="H7998" \w*, [and take]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8804”} \w her prey| strong="H957" \w*; \w and it shall be the wages| strong="H7939" \w* \w for his army| strong="H2428" \w*.\f + \fr 29:19 \ft take her spoil…: Heb. spoil her spoil, and prey her prey \f* 
\v 20 [I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w him the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* for \w his labour| strong="H6468" \w* [wherewith he served]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} [against it, because they wrought]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [for me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*.\f + \fr 29:20 \ft for his…: or, for his hire \f* 
\p
\v 21 \w In that day| strong="H3117" \w* \w will I cause| strong="H6779" \w* \w the horn| strong="H7161" \w* \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* [to bud forth]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8686”}, [and I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee the opening| strong="H6610" \w* \w of the mouth| strong="H6310" \w* \w in the midst| strong="H8432" \w* [of them; and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*. 
\c 30
\p 
\v 1 \w The word| strong="H1697" \w* of the \sc Lord\sc* [came again unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8685”} [ye, Woe worth]{strong=“H1929”} \w the day| strong="H3117" \w*! 
\v 3 \w For the day| strong="H3117" \w* is \w near| strong="H7138" \w*, \w even the day| strong="H3117" \w* of the \sc Lord\sc* is \w near| strong="H7138" \w*, \w a cloudy| strong="H6051" \w* \w day| strong="H3117" \w*; \w it shall be the time| strong="H6256" \w* \w of the heathen| strong="H1471" \w*. 
\v 4 \w And the sword| strong="H2719" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon Egypt| strong="H4714" \w*, \w and great pain| strong="H2479" \w* \w shall be in Ethiopia| strong="H3568" \w*, \w when the slain| strong="H2491" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8800”} \w in Egypt| strong="H4714" \w*, [and they shall take away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w her multitude| strong="H1995" \w*, \w and her foundations| strong="H3247" \w* [shall be broken down]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8738”}.\f + \fr 30:4 \ft pain: or, fear \f* 
\v 5 \w Ethiopia| strong="H3568" \w*, \w and Libya| strong="H6316" \w*, \w and Lydia| strong="H3865" \w*, \w and all the mingled| strong="H6153" \w* [people, and Chub]{strong=“H3552”}, \w and the men| strong="H1121" \w* \w of the land| strong="H776" \w* \w that is in league| strong="H1285" \w*, [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w with them by the sword| strong="H2719" \w*.\f + \fr 30:5 \ft Libya: Heb. Phut \f* \f + \fr 30:5 \ft men: Heb. children \f* 
\v 6 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [They also that uphold]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8802”} \w Egypt| strong="H4714" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”}; \w and the pride| strong="H1347" \w* \w of her power| strong="H5797" \w* [shall come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”}: \w from the tower| strong="H4024" \w* \w of Syene| strong="H5482" \w* [shall they fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w in it by the sword| strong="H2719" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*.\f + \fr 30:6 \ft from…: or, from Migdol to Syene \f* 
\v 7 [And they shall be desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the midst| strong="H8432" \w* \w of the countries| strong="H776" \w* that are [desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8737”}, \w and her cities| strong="H5892" \w* \w shall be in the midst| strong="H8432" \w* \w of the cities| strong="H5892" \w* that are [wasted]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8737”}. 
