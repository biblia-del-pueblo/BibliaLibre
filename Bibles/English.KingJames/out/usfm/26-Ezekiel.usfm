\v 35 [And they shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w This| strong="H1977" \w* \w land| strong="H776" \w* [that was desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8737”} \w is become like the garden| strong="H1588" \w* \w of Eden| strong="H5731" \w*; \w and the waste| strong="H2720" \w* [and desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8737”} [and ruined]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8737”} \w cities| strong="H5892" \w* are become [fenced]{strong=“H1219” x-morph=“strongMorph: \sc Th\sc*8803”}, and [are inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 36 \w Then the heathen| strong="H1471" \w* [that are left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8735”} \w round about| strong="H5439" \w* [you shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I the \sc Lord\sc* [build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} [the ruined]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8737”} places, and [plant]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8804”} [that that was desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8737”}: I the \sc Lord\sc* [have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it, [and I will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} it. 
\v 37 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; I will yet for [this be enquired]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8735”} \w of by the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} it [for them; I will increase]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} \w them with men| strong="H120" \w* \w like a flock| strong="H6629" \w*. 
\v 38 \w As the holy| strong="H6944" \w* \w flock| strong="H6629" \w*, \w as the flock| strong="H6629" \w* \w of Jerusalem| strong="H3389" \w* \w in her solemn feasts| strong="H4150" \w*; \w so shall the waste| strong="H2720" \w* \w cities| strong="H5892" \w* \w be filled| strong="H4392" \w* \w with flocks| strong="H6629" \w* \w of men| strong="H120" \w*: [and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*.\f + \fr 36:38 \ft holy…: Heb. flock of holy things \f*
\c 37
\p 
\v 1 \w The hand| strong="H3027" \w* of the \sc Lord\sc* [was upon me, and carried me out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w in the spirit| strong="H7307" \w* of the \sc Lord\sc*, [and set me down]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8686”} \w in the midst| strong="H8432" \w* \w of the valley| strong="H1237" \w* which was \w full| strong="H4392" \w* \w of bones| strong="H6106" \w*, 
\v 2 [And caused me to pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8689”} \w by them round about| strong="H5439" \w*: and, behold, there were \w very| strong="H3966" \w* \w many| strong="H7227" \w* \w in the open| strong="H6440" \w* \w valley| strong="H1237" \w*; and, lo, they were \w very| strong="H3966" \w* \w dry| strong="H3002" \w*.\f + \fr 37:2 \ft valley: or, champaign \f* 
\v 3 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Son]{strong=“H1121”} \w of man| strong="H120" \w*, \w can these bones| strong="H6106" \w* [live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}? [And I answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w O Lord| strong="H136" \w* \sc God\sc*, [thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 4 [Again he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} \w upon these bones| strong="H6106" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, O ye dry]{strong=“H3002”} \w bones| strong="H6106" \w*, [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* of the \sc Lord\sc*. 
\v 5 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc* \w unto these bones| strong="H6106" \w*; [Behold, I will cause breath]{strong=“H7307”} [to enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} [into you, and ye shall live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8804”}: 
\v 6 [And I will lay]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w sinews| strong="H1517" \w* [upon you, and will bring up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} \w flesh| strong="H1320" \w* [upon you, and cover]{strong=“H7159” x-morph=“strongMorph: \sc Th\sc*8804”} \w you with skin| strong="H5785" \w*, [and put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w breath| strong="H7307" \w* [in you, and ye shall live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8804”}; [and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*. 
\v 7 [So I prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8738”} [as I was commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8795”}: [and as I prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8736”}, \w there was a noise| strong="H6963" \w*, \w and behold a shaking| strong="H7494" \w*, \w and the bones| strong="H6106" \w* [came together]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”}, \w bone| strong="H6106" \w* \w to his bone| strong="H6106" \w*. 
