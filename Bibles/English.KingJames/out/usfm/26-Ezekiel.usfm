\c 31
\p 
\v 1 [And it came to pass in the eleventh]{strong=“H6240 H259”} \w year| strong="H8141" \w*, \w in the third| strong="H7992" \w* month, \w in the first| strong="H259" \w* day \w of the month| strong="H2320" \w*, that \w the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
