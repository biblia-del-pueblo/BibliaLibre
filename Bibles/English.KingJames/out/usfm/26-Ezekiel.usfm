\p
\v 15 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [he unto me, Hast thou seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} this, \w O son| strong="H1121" \w* \w of man| strong="H120" \w*? [turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} thee yet again, and [thou shalt see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w greater| strong="H1419" \w* \w abominations| strong="H8441" \w* than these. 
\v 16 [And he brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w me into the inner| strong="H6442" \w* \w court| strong="H2691" \w* of the \sc Lord\sc*’S \w house| strong="H1004" \w*, [and, behold, at the door]{strong=“H6607”} \w of the temple| strong="H1964" \w* of the \sc Lord\sc*, \w between the porch| strong="H197" \w* \w and the altar| strong="H4196" \w*, were \w about five| strong="H2568" \w* \w and twenty| strong="H6242" \w* \w men| strong="H376" \w*, \w with their backs| strong="H268" \w* \w toward the temple| strong="H1964" \w* of the \sc Lord\sc*, \w and their faces| strong="H6440" \w* \w toward the east| strong="H6924" \w*; [and they worshipped]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8693”} \w the sun| strong="H8121" \w* \w toward the east| strong="H6924" \w*. 
\p
\v 17 [Then he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Hast thou seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} this, \w O son| strong="H1121" \w* \w of man| strong="H120" \w*? [Is it a light thing]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8738”} \w to the house| strong="H1004" \w* \w of Judah| strong="H3063" \w* [that they commit]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w the abominations| strong="H8441" \w* [which they commit]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [here? for they have filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w the land| strong="H776" \w* \w with violence| strong="H2555" \w*, [and have returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [to provoke me to anger]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8687”}: [and, lo, they put]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8802”} \w the branch| strong="H2156" \w* \w to their nose| strong="H639" \w*.\f + \fr 8:17 \ft Is it…: or, Is there any thing lighter than to commit \f* 
\v 18 [Therefore will I also deal]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w in fury| strong="H2534" \w*: \w mine eye| strong="H5869" \w* [shall not spare]{strong=“H2347” x-morph=“strongMorph: \sc Th\sc*8799”}, [neither will I have pity]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”}: [and though they cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w in mine ears| strong="H241" \w* \w with a loud| strong="H1419" \w* \w voice| strong="H6963" \w*, yet [will I not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} them.
\c 9
\p 
\v 1 [He cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w also in mine ears| strong="H241" \w* \w with a loud| strong="H1419" \w* \w voice| strong="H6963" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Cause them that have charge| strong="H6486" \w* \w over the city| strong="H5892" \w* [to draw near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8804”}, \w even every man| strong="H376" \w* with \w his destroying| strong="H4892" \w* \w weapon| strong="H3627" \w* \w in his hand| strong="H3027" \w*. 
\v 2 [And, behold, six]{strong=“H8337”} \w men| strong="H582" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w from the way| strong="H1870" \w* \w of the higher| strong="H5945" \w* \w gate| strong="H8179" \w*, [which lieth]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8716”} \w toward the north| strong="H6828" \w*, \w and every man| strong="H376" \w* \w a slaughter| strong="H4660" \w* \w weapon| strong="H3627" \w* \w in his hand| strong="H3027" \w*; \w and one| strong="H259" \w* \w man| strong="H376" \w* \w among| strong="H8432" \w* them was [clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8803”} \w with linen| strong="H906" \w*, [with a writer’s]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8802”} \w inkhorn| strong="H7083" \w* \w by his side| strong="H4975" \w*: [and they went in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [and stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w beside| strong="H681" \w* \w the brasen| strong="H5178" \w* \w altar| strong="H4196" \w*.\f + \fr 9:2 \ft which lieth: Heb. which is turned \f* \f + \fr 9:2 \ft a slaughter…: Heb. a weapon of his breaking in pieces \f* \f + \fr 9:2 \ft by his…: Heb. upon his loins \f* 
\v 3 \w And the glory| strong="H3519" \w* \w of the God| strong="H430" \w* \w of Israel| strong="H3478" \w* [was gone up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8738”} \w from the cherub| strong="H3742" \w*, [whereupon he was, to the threshold]{strong=“H4670”} \w of the house| strong="H1004" \w*. [And he called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the man| strong="H376" \w* [clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8803”} \w with linen| strong="H906" \w*, which had [the writer’s]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8802”} \w inkhorn| strong="H7083" \w* \w by his side| strong="H4975" \w*; 
\v 4 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Go through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8798”} \w the midst| strong="H8432" \w* \w of the city| strong="H5892" \w*, \w through the midst| strong="H8432" \w* \w of Jerusalem| strong="H3389" \w*, [and set]{strong=“H8427” x-morph=“strongMorph: \sc Th\sc*8689”} \w a mark| strong="H8420" \w* \w upon the foreheads| strong="H4696" \w* \w of the men| strong="H582" \w* [that sigh]{strong=“H584” x-morph=“strongMorph: \sc Th\sc*8737”} [and that cry]{strong=“H602” x-morph=“strongMorph: \sc Th\sc*8737”} \w for all the abominations| strong="H8441" \w* [that be done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8737”} \w in the midst| strong="H8432" \w* thereof.\f + \fr 9:4 \ft set a mark: Heb. mark a mark \f* 
\p
\v 5 \w And to the others| strong="H428" \w* [he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w in mine hearing| strong="H241" \w*, [Go]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye after| strong="H310" \w* \w him through the city| strong="H5892" \w*, [and smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8685”}: \w let not your eye| strong="H5869" \w* [spare]{strong=“H2347” x-morph=“strongMorph: \sc Th\sc*8799”}, [neither have ye pity]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”}:\f + \fr 9:5 \ft mine hearing: Heb. mine ears \f* 
\v 6 [Slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} \w utterly| strong="H4889" \w* \w old| strong="H2205" \w* and \w young| strong="H970" \w*, \w both maids| strong="H1330" \w*, \w and little children| strong="H2945" \w*, \w and women| strong="H802" \w*: [but come not near]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8799”} \w any man| strong="H376" \w* upon whom is \w the mark| strong="H8420" \w*; [and begin]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8686”} \w at my sanctuary| strong="H4720" \w*. [Then they began]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8686”} \w at the ancient| strong="H2205" \w* \w men| strong="H582" \w* which were \w before| strong="H6440" \w* \w the house| strong="H1004" \w*.\f + \fr 9:6 \ft utterly: Heb. to destruction \f* 
\v 7 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Defile]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8761”} \w the house| strong="H1004" \w*, [and fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8761”} \w the courts| strong="H2691" \w* \w with the slain| strong="H2491" \w*: [go ye forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8798”}. [And they went forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”}, [and slew]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w in the city| strong="H5892" \w*. 
\p
\v 8 [And it came to pass, while they were slaying]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8687”} [them, and I was left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”}, [that I fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon my face| strong="H6440" \w*, [and cried]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8799”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Ah| strong="H162" \w* \w Lord| strong="H136" \w* \sc God\sc*! [wilt thou destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8688”} \w all the residue| strong="H7611" \w* \w of Israel| strong="H3478" \w* [in thy pouring out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8800”} \w of thy fury| strong="H2534" \w* \w upon Jerusalem| strong="H3389" \w*? 
\v 9 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [he unto me, The iniquity]{strong=“H5771”} \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* \w and Judah| strong="H3063" \w* is [exceeding]{strong=“H3966 H3966”} \w great| strong="H1419" \w*, \w and the land| strong="H776" \w* [is full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”} \w of blood| strong="H1818" \w*, \w and the city| strong="H5892" \w* [full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of perverseness| strong="H4297" \w*: [for they say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, The \sc Lord\sc* [hath forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} \w the earth| strong="H776" \w*, and the \sc Lord\sc* [seeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} not.\f + \fr 9:9 \ft full of blood: Heb. filled with, etc \f* \f + \fr 9:9 \ft perverseness: or, wresting of judgment \f* 
\v 10 [And as for me also, mine eye]{strong=“H5869”} [shall not spare]{strong=“H2347” x-morph=“strongMorph: \sc Th\sc*8799”}, [neither will I have pity]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”}, but [I will recompense]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w their way| strong="H1870" \w* \w upon their head| strong="H7218" \w*. 
\v 11 [And, behold, the man]{strong=“H376”} [clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8803”} \w with linen| strong="H906" \w*, which had \w the inkhorn| strong="H7083" \w* \w by his side| strong="H4975" \w*, [reported]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8688”} \w the matter| strong="H1697" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [I have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [as thou hast commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} me.\f + \fr 9:11 \ft reported…: Heb. returned the word \f*
\c 10
\p 
\v 1 [Then I looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, [and, behold, in the firmament]{strong=“H7549”} \w that was above the head| strong="H7218" \w* \w of the cherubims| strong="H3742" \w* [there appeared]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8738”} \w over them as it were a sapphire| strong="H5601" \w* \w stone| strong="H68" \w*, \w as the appearance| strong="H4758" \w* \w of the likeness| strong="H1823" \w* \w of a throne| strong="H3678" \w*. 
\v 2 [And he spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the man| strong="H376" \w* [clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8803”} \w with linen| strong="H906" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} \w between| strong="H996" \w* \w the wheels| strong="H1534" \w*, even \w under the cherub| strong="H3742" \w*, [and fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8761”} \w thine hand| strong="H2651" \w* \w with coals| strong="H1513" \w* \w of fire| strong="H784" \w* \w from between| strong="H996" \w* \w the cherubims| strong="H3742" \w*, [and scatter]{strong=“H2236” x-morph=“strongMorph: \sc Th\sc*8798”} them \w over the city| strong="H5892" \w*. [And he went in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w in my sight| strong="H5869" \w*.\f + \fr 10:2 \ft thine hand: Heb. the hollow of thine hand \f* 
\v 3 \w Now the cherubims| strong="H3742" \w* [stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w on the right side| strong="H3225" \w* \w of the house| strong="H1004" \w*, \w when the man| strong="H376" \w* [went in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}; \w and the cloud| strong="H6051" \w* [filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w the inner| strong="H6442" \w* \w court| strong="H2691" \w*. 
\v 4 \w Then the glory| strong="H3519" \w* of the \sc Lord\sc* [went up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the cherub| strong="H3742" \w*, and stood \w over the threshold| strong="H4670" \w* \w of the house| strong="H1004" \w*; \w and the house| strong="H1004" \w* [was filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”} \w with the cloud| strong="H6051" \w*, \w and the court| strong="H2691" \w* [was full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the brightness| strong="H5051" \w* of the \sc Lord\sc*’S \w glory| strong="H3519" \w*.\f + \fr 10:4 \ft went up: Heb. was lifted up \f* 
\v 5 \w And the sound| strong="H6963" \w* [of the cherubims’]{strong=“H3742”} \w wings| strong="H3671" \w* [was heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8738”} even \w to the outer| strong="H2435" \w* \w court| strong="H2691" \w*, \w as the voice| strong="H6963" \w* \w of the Almighty| strong="H7706" \w* \w God| strong="H410" \w* [when he speaketh]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”}. 
\v 6 And it came to pass, that [when he had commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8763”} \w the man| strong="H376" \w* [clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8803”} \w with linen| strong="H906" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w fire| strong="H784" \w* \w from between the wheels| strong="H1534" \w*, \w from between the cherubims| strong="H3742" \w*; [then he went in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [and stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w beside| strong="H681" \w* \w the wheels| strong="H212" \w*. 
\v 7 And one \w cherub| strong="H3742" \w* [stretched forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w his hand| strong="H3027" \w* \w from between the cherubims| strong="H3742" \w* \w unto the fire| strong="H784" \w* that was \w between the cherubims| strong="H3742" \w*, [and took]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} thereof, [and put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} it \w into the hands| strong="H2651" \w* of him that was [clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8803”} \w with linen| strong="H906" \w*: [who took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} it, [and went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 10:7 \ft stretched forth: Heb. sent forth \f* 
\p
\v 8 [And there appeared]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the cherubims| strong="H3742" \w* \w the form| strong="H8403" \w* [of a man’s]{strong=“H120”} \w hand| strong="H3027" \w* \w under their wings| strong="H3671" \w*. 
\v 9 [And when I looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, \w behold the four| strong="H702" \w* \w wheels| strong="H212" \w* \w by| strong="H681" \w* \w the cherubims| strong="H3742" \w*, \w one| strong="H259" \w* \w wheel| strong="H212" \w* \w by| strong="H681" \w* \w one| strong="H259" \w* \w cherub| strong="H3742" \w*, \w and another| strong="H259" \w* \w wheel| strong="H212" \w* \w by| strong="H681" \w* \w another| strong="H259" \w* \w cherub| strong="H3742" \w*: \w and the appearance| strong="H4758" \w* \w of the wheels| strong="H212" \w* was \w as the colour| strong="H5869" \w* \w of a beryl| strong="H8658" \w* \w stone| strong="H68" \w*. 
\v 10 And as for \w their appearances| strong="H4758" \w*, \w they four| strong="H702" \w* \w had one| strong="H259" \w* \w likeness| strong="H1823" \w*, \w as if a wheel| strong="H212" \w* \w had been in the midst| strong="H8432" \w* \w of a wheel| strong="H212" \w*. 
\v 11 [When they went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”}, [they went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} \w upon their four| strong="H702" \w* \w sides| strong="H7253" \w*; [they turned]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8735”} [not as they went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”}, \w but to the place| strong="H4725" \w* \w whither the head| strong="H7218" \w* [looked]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8799”} [they followed]{strong=“H310 H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [it; they turned]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8735”} [not as they went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 12 \w And their whole body| strong="H1320" \w*, \w and their backs| strong="H1354" \w*, \w and their hands| strong="H3027" \w*, \w and their wings| strong="H3671" \w*, \w and the wheels| strong="H212" \w*, were \w full| strong="H4392" \w* \w of eyes| strong="H5869" \w* \w round about| strong="H5439" \w*, even \w the wheels| strong="H212" \w* \w that they four| strong="H702" \w* had.\f + \fr 10:12 \ft body: Heb. flesh \f* 
\v 13 \w As for the wheels| strong="H212" \w*, [it was cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8795”} \w unto them in my hearing| strong="H241" \w*, \w O wheel| strong="H1534" \w*.\f + \fr 10:13 \ft it was…: or, they were called in my hearing, wheel, or, galgal \f* 
\v 14 \w And every one| strong="H259" \w* \w had four| strong="H702" \w* \w faces| strong="H6440" \w*: \w the first| strong="H259" \w* \w face| strong="H6440" \w* was \w the face| strong="H6440" \w* \w of a cherub| strong="H3742" \w*, \w and the second| strong="H8145" \w* \w face| strong="H6440" \w* was \w the face| strong="H6440" \w* \w of a man| strong="H120" \w*, \w and the third| strong="H7992" \w* \w the face| strong="H6440" \w* \w of a lion| strong="H738" \w*, \w and the fourth| strong="H7243" \w* \w the face| strong="H6440" \w* \w of an eagle| strong="H5404" \w*. 
\v 15 \w And the cherubims| strong="H3742" \w* [were lifted up]{strong=“H7426” x-morph=“strongMorph: \sc Th\sc*8735”}. This is \w the living creature| strong="H2416" \w* [that I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w by the river| strong="H5104" \w* \w of Chebar| strong="H3529" \w*. 
\v 16 \w And when the cherubims| strong="H3742" \w* [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”}, \w the wheels| strong="H212" \w* [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w by them| strong="H681" \w*: \w and when the cherubims| strong="H3742" \w* [lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8800”} \w their wings| strong="H3671" \w* [to mount up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8800”} \w from the earth| strong="H776" \w*, \w the same wheels| strong="H212" \w* \w also| strong="H1992" \w* [turned]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8735”} \w not from beside| strong="H681" \w* them. 
\v 17 [When they stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8800”}, these [stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”}; [and when they were lifted up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8800”}, these [lifted up]{strong=“H7426” x-morph=“strongMorph: \sc Th\sc*8735”} themselves also: \w for the spirit| strong="H7307" \w* \w of the living creature| strong="H2416" \w* was in them.\f + \fr 10:17 \ft of…: or, of life \f* 
\v 18 \w Then the glory| strong="H3519" \w* of the \sc Lord\sc* [departed]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w from off the threshold| strong="H4670" \w* \w of the house| strong="H1004" \w*, [and stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w over the cherubims| strong="H3742" \w*. 
\v 19 \w And the cherubims| strong="H3742" \w* [lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their wings| strong="H3671" \w*, [and mounted up]{strong=“H7426” x-morph=“strongMorph: \sc Th\sc*8735”} \w from the earth| strong="H776" \w* \w in my sight| strong="H5869" \w*: [when they went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”}, \w the wheels| strong="H212" \w* also were \w beside| strong="H5980" \w* them, and every one [stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w at the door| strong="H6607" \w* \w of the east| strong="H6931" \w* \w gate| strong="H8179" \w* of the \sc Lord\sc*’S \w house| strong="H1004" \w*; \w and the glory| strong="H3519" \w* \w of the God| strong="H430" \w* \w of Israel| strong="H3478" \w* was \w over them above| strong="H4605" \w*. 
\v 20 This is \w the living creature| strong="H2416" \w* [that I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w under the God| strong="H430" \w* \w of Israel| strong="H3478" \w* \w by the river| strong="H5104" \w* \w of Chebar| strong="H3529" \w*; [and I knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} that they were \w the cherubims| strong="H3742" \w*. 
\v 21 \w Every one| strong="H259" \w* \w had four| strong="H702" \w* \w faces| strong="H6440" \w* \w apiece| strong="H259" \w*, \w and every one| strong="H259" \w* \w four| strong="H702" \w* \w wings| strong="H3671" \w*; \w and the likeness| strong="H1823" \w* \w of the hands| strong="H3027" \w* \w of a man| strong="H120" \w* was \w under their wings| strong="H3671" \w*. 
\v 22 \w And the likeness| strong="H1823" \w* \w of their faces| strong="H6440" \w* was \w the same| strong="H1992" \w* \w faces| strong="H6440" \w* [which I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w by the river| strong="H5104" \w* \w of Chebar| strong="H3529" \w*, \w their appearances| strong="H4758" \w* [and themselves: they went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w every one| strong="H376" \w* \w straight| strong="H5676" \w* \w forward| strong="H6440" \w*.
\c 11
\p 
\v 1 \w Moreover the spirit| strong="H7307" \w* [lifted me up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”}, [and brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w me unto the east| strong="H6931" \w* \w gate| strong="H8179" \w* of the \sc Lord\sc*’S \w house| strong="H1004" \w*, [which looketh]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8802”} \w eastward| strong="H6921" \w*: \w and behold at the door| strong="H6607" \w* \w of the gate| strong="H8179" \w* \w five| strong="H2568" \w* \w and twenty| strong="H6242" \w* \w men| strong="H376" \w*; \w among| strong="H8432" \w* [whom I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jaazaniah| strong="H2970" \w* \w the son| strong="H1121" \w* \w of Azur| strong="H5809" \w*, \w and Pelatiah| strong="H6410" \w* \w the son| strong="H1121" \w* \w of Benaiah| strong="H1141" \w*, \w princes| strong="H8269" \w* \w of the people| strong="H5971" \w*. 
\v 2 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [he unto me, Son]{strong=“H1121”} \w of man| strong="H120" \w*, these are \w the men| strong="H582" \w* [that devise]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8802”} \w mischief| strong="H205" \w*, [and give]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8802”} \w wicked| strong="H7451" \w* \w counsel| strong="H6098" \w* \w in this city| strong="H5892" \w*: 
\v 3 [Which say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, It is \w not near| strong="H7138" \w*; [let us build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8800”} \w houses| strong="H1004" \w*: this city is \w the caldron| strong="H5518" \w*, and we be \w the flesh| strong="H1320" \w*.\f + \fr 11:3 \ft It is…: or, It is not for us to build houses near \f* 
\p
\v 4 [Therefore prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} [against them, prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”}, \w O son| strong="H1121" \w* \w of man| strong="H120" \w*. 
\v 5 \w And the Spirit| strong="H7307" \w* of the \sc Lord\sc* [fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} [upon me, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”}; [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Thus have ye said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w O house| strong="H1004" \w* \w of Israel| strong="H3478" \w*: [for I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w the things that come| strong="H4609" \w* \w into your mind| strong="H7307" \w*, every one of them. 
\v 6 [Ye have multiplied]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8689”} \w your slain| strong="H2491" \w* \w in this city| strong="H5892" \w*, [and ye have filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8765”} \w the streets| strong="H2351" \w* \w thereof with the slain| strong="H2491" \w*. 
\v 7 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w Your slain| strong="H2491" \w* [whom ye have laid]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the midst| strong="H8432" \w* of it, they are \w the flesh| strong="H1320" \w*, and this city is \w the caldron| strong="H5518" \w*: [but I will bring you forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w out of the midst| strong="H8432" \w* of it. 
\v 8 [Ye have feared]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8804”} \w the sword| strong="H2719" \w*; [and I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w a sword| strong="H2719" \w* [upon you, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\v 9 [And I will bring you out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w of the midst| strong="H8432" \w* [thereof, and deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w you into the hands| strong="H3027" \w* [of strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”}, [and will execute]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w judgments| strong="H8201" \w* among you. 
\v 10 [Ye shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w*; [I will judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w you in the border| strong="H1366" \w* \w of Israel| strong="H3478" \w*; [and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*. 
\v 11 This city \w shall not be your caldron| strong="H5518" \w*, \w neither shall ye be the flesh| strong="H1320" \w* \w in the midst| strong="H8432" \w* thereof; but [I will judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w you in the border| strong="H1366" \w* \w of Israel| strong="H3478" \w*: 
\v 12 [And ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*: [for ye have not walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w in my statutes| strong="H2706" \w*, [neither executed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w my judgments| strong="H4941" \w*, [but have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w after the manners| strong="H4941" \w* \w of the heathen| strong="H1471" \w* that are \w round about| strong="H5439" \w* you.\f + \fr 11:12 \ft for ye…: or, which have not walked \f* 
\p
\v 13 [And it came to pass, when I prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8736”}, \w that Pelatiah| strong="H6410" \w* \w the son| strong="H1121" \w* \w of Benaiah| strong="H1141" \w* [died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}. [Then fell I down]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon my face| strong="H6440" \w*, [and cried]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8799”} \w with a loud| strong="H1419" \w* \w voice| strong="H6963" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Ah| strong="H162" \w* \w Lord| strong="H136" \w* \sc God\sc*! [wilt thou make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w a full end| strong="H3617" \w* \w of the remnant| strong="H7611" \w* \w of Israel| strong="H3478" \w*? 
\p
\v 14 \w Again the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 15 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, \w thy brethren| strong="H251" \w*, even \w thy brethren| strong="H251" \w*, \w the men| strong="H582" \w* \w of thy kindred| strong="H1353" \w*, \w and all the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* wholly, are [they unto whom the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w* [have said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Get you far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8798”} from the \sc Lord\sc*: \w unto us is this land| strong="H776" \w* [given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w in possession| strong="H4181" \w*. 
\v 16 [Therefore say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Although I have cast them far off]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8689”} \w among the heathen| strong="H1471" \w*, [and although I have scattered]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8689”} \w them among the countries| strong="H776" \w*, \w yet will I be to them as a little| strong="H4592" \w* \w sanctuary| strong="H4720" \w* \w in the countries| strong="H776" \w* [where they shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 17 [Therefore say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [I will even gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8765”} \w you from the people| strong="H5971" \w*, [and assemble]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8804”} \w you out of the countries| strong="H776" \w* [where ye have been scattered]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8738”}, [and I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w you the land| strong="H127" \w* \w of Israel| strong="H3478" \w*. 
\v 18 [And they shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [thither, and they shall take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8689”} \w all the detestable things| strong="H8251" \w* \w thereof and all the abominations| strong="H8441" \w* thereof from thence. 
\v 19 [And I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w them one| strong="H259" \w* \w heart| strong="H3820" \w*, [and I will put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w a new| strong="H2319" \w* \w spirit| strong="H7307" \w* \w within| strong="H7130" \w* [you; and I will take]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8689”} \w the stony| strong="H68" \w* \w heart| strong="H3820" \w* \w out of their flesh| strong="H1320" \w*, [and will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w them an heart| strong="H3820" \w* \w of flesh| strong="H1320" \w*: 
\v 20 [That they may walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w in my statutes| strong="H2708" \w*, [and keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w mine ordinances| strong="H4941" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [them: and they shall be my people]{strong=“H5971”}, \w and I will be their God| strong="H430" \w*. 
\v 21 But as for them \w whose heart| strong="H3820" \w* [walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w after the heart| strong="H3820" \w* \w of their detestable things| strong="H8251" \w* \w and their abominations| strong="H8441" \w*, [I will recompense]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w their way| strong="H1870" \w* \w upon their own heads| strong="H7218" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\p
\v 22 \w Then did the cherubims| strong="H3742" \w* [lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their wings| strong="H3671" \w*, \w and the wheels| strong="H212" \w* \w beside| strong="H5980" \w* [them; and the glory]{strong=“H3519”} \w of the God| strong="H430" \w* \w of Israel| strong="H3478" \w* was \w over them above| strong="H4605" \w*. 
\v 23 \w And the glory| strong="H3519" \w* of the \sc Lord\sc* [went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the midst| strong="H8432" \w* \w of the city| strong="H5892" \w*, [and stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the mountain| strong="H2022" \w* which is \w on the east side| strong="H6924" \w* \w of the city| strong="H5892" \w*. 
\p
\v 24 \w Afterwards the spirit| strong="H7307" \w* [took me up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”}, [and brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w me in a vision| strong="H4758" \w* \w by the Spirit| strong="H7307" \w* \w of God| strong="H430" \w* \w into Chaldea| strong="H3778" \w*, \w to them of the captivity| strong="H1473" \w*. \w So the vision| strong="H4758" \w* [that I had seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} [went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} from me. 
\v 25 [Then I spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto them of the captivity| strong="H1473" \w* \w all the things| strong="H1697" \w* that the \sc Lord\sc* [had shewed]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8689”} me. 
\c 12
\p 
\v 1 \w The word| strong="H1697" \w* of the \sc Lord\sc* [also came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [thou dwellest]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the midst| strong="H8432" \w* \w of a rebellious| strong="H4805" \w* \w house| strong="H1004" \w*, \w which have eyes| strong="H5869" \w* [to see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”}, [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} [not; they have ears]{strong=“H241”} [to hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”}, [and hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} not: for they are \w a rebellious| strong="H4805" \w* \w house| strong="H1004" \w*. 
\v 3 [Therefore, thou son]{strong=“H1121”} \w of man| strong="H120" \w*, [prepare]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee stuff| strong="H3627" \w* \w for removing| strong="H1473" \w*, [and remove]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8798”} \w by day| strong="H3119" \w* \w in their sight| strong="H5869" \w*; [and thou shalt remove]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8804”} \w from thy place| strong="H4725" \w* \w to another| strong="H312" \w* \w place| strong="H4725" \w* \w in their sight| strong="H5869" \w*: [it may be they will consider]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, though they be \w a rebellious| strong="H4805" \w* \w house| strong="H1004" \w*.\f + \fr 12:3 \ft stuff: or, instruments \f* 
\v 4 [Then shalt thou bring forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy stuff| strong="H3627" \w* \w by day| strong="H3119" \w* \w in their sight| strong="H5869" \w*, \w as stuff| strong="H3627" \w* \w for removing| strong="H1473" \w*: [and thou shalt go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w at even| strong="H6153" \w* \w in their sight| strong="H5869" \w*, \w as they that go forth| strong="H4161" \w* \w into captivity| strong="H1473" \w*.\f + \fr 12:4 \ft as they…: Heb. as the goings forth of captivity \f* 
\v 5 [Dig]{strong=“H2864” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou through the wall| strong="H7023" \w* \w in their sight| strong="H5869" \w*, [and carry out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} thereby.\f + \fr 12:5 \ft Dig…: Heb. Dig for thee \f* 
\v 6 \w In their sight| strong="H5869" \w* [shalt thou bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} it upon thy \w shoulders| strong="H3802" \w*, and carry it [forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w in the twilight| strong="H5939" \w*: [thou shalt cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy face| strong="H6440" \w*, [that thou see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w not the ground| strong="H776" \w*: [for I have set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} thee for \w a sign| strong="H4159" \w* \w unto the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*. 
\v 7 [And I did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [so as I was commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8795”}: [I brought forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w my stuff| strong="H3627" \w* \w by day| strong="H3119" \w*, \w as stuff| strong="H3627" \w* \w for captivity| strong="H1473" \w*, \w and in the even| strong="H6153" \w* [I digged]{strong=“H2864” x-morph=“strongMorph: \sc Th\sc*8804”} \w through the wall| strong="H7023" \w* \w with mine hand| strong="H3027" \w*; I brought it [forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w in the twilight| strong="H5939" \w*, and [I bare]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} it upon my \w shoulder| strong="H3802" \w* \w in their sight| strong="H5869" \w*.\f + \fr 12:7 \ft digged: Heb. digged for me \f* 
\p
\v 8 \w And in the morning| strong="H1242" \w* \w came the word| strong="H1697" \w* of the \sc Lord\sc* [unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 9 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, \w hath not the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, \w the rebellious| strong="H4805" \w* \w house| strong="H1004" \w*, [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto thee, What doest]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} thou? 
\v 10 [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} [thou unto them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w This burden| strong="H4853" \w* concerneth \w the prince| strong="H5387" \w* \w in Jerusalem| strong="H3389" \w*, \w and all the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* that are \w among| strong="H8432" \w* them. 
\v 11 [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”}, I am \w your sign| strong="H4159" \w*: [like as I have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [so shall it be done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8735”} [unto them: they shall remove]{strong=“H1473”} and [go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w into captivity| strong="H7628" \w*.\f + \fr 12:11 \ft they…: Heb. by removing go into captivity \f* 
\v 12 \w And the prince| strong="H5387" \w* that is \w among| strong="H8432" \w* [them shall bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} upon his \w shoulder| strong="H3802" \w* \w in the twilight| strong="H5939" \w*, [and shall go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”}: [they shall dig]{strong=“H2864” x-morph=“strongMorph: \sc Th\sc*8799”} \w through the wall| strong="H7023" \w* [to carry out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8687”} [thereby: he shall cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w his face| strong="H6440" \w*, \w that| strong="H3282" \w* [he see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w not the ground| strong="H776" \w* with his \w eyes| strong="H5869" \w*. 
\v 13 \w My net| strong="H7568" \w* [also will I spread]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8804”} [upon him, and he shall be taken]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8738”} \w in my snare| strong="H4686" \w*: [and I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w him to Babylon| strong="H894" \w* to \w the land| strong="H776" \w* \w of the Chaldeans| strong="H3778" \w*; [yet shall he not see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [it, though he shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} there. 
\v 14 [And I will scatter]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8762”} \w toward every wind| strong="H7307" \w* all that are \w about| strong="H5439" \w* \w him to help| strong="H5828" \w* [him, and all his bands]{strong=“H102”}; [and I will draw out]{strong=“H7324” x-morph=“strongMorph: \sc Th\sc*8686”} \w the sword| strong="H2719" \w* \w after| strong="H310" \w* them. 
\v 15 [And they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*, [when I shall scatter]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8687”} \w them among the nations| strong="H1471" \w*, [and disperse]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8765”} \w them in the countries| strong="H776" \w*. 
\v 16 [But I will leave]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8689”} \w a few| strong="H4557" \w* \w men| strong="H582" \w* \w of them from the sword| strong="H2719" \w*, \w from the famine| strong="H7458" \w*, \w and from the pestilence| strong="H1698" \w*; [that they may declare]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} \w all their abominations| strong="H8441" \w* \w among the heathen| strong="H1471" \w* [whither they come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}; [and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*.\f + \fr 12:16 \ft a few…: Heb. men of number \f* 
\p
\v 17 \w Moreover the word| strong="H1697" \w* of the \sc Lord\sc* [came to me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 18 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy bread| strong="H3899" \w* \w with quaking| strong="H7494" \w*, [and drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy water| strong="H4325" \w* \w with trembling| strong="H7269" \w* \w and with carefulness| strong="H1674" \w*; 
\v 19 [And say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the people| strong="H5971" \w* \w of the land| strong="H127" \w*, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc* [of the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w*, and \w of the land| strong="H776" \w* \w of Israel| strong="H3478" \w*; [They shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w their bread| strong="H3899" \w* \w with carefulness| strong="H1674" \w*, [and drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w their water| strong="H4325" \w* \w with astonishment| strong="H8078" \w*, \w that her land| strong="H776" \w* [may be desolate]{strong=“H3456” x-morph=“strongMorph: \sc Th\sc*8799”} \w from all that is therein| strong="H4393" \w*, \w because of the violence| strong="H2555" \w* [of all them that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} therein.\f + \fr 12:19 \ft all that…: Heb. the fulness thereof \f* 
\v 20 \w And the cities| strong="H5892" \w* [that are inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8737”} [shall be laid waste]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the land| strong="H776" \w* \w shall be desolate| strong="H8077" \w*; [and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*. 
\p
\v 21 \w And the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 22 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, what is \w that proverb| strong="H4912" \w* that \w ye have in the land| strong="H127" \w* \w of Israel| strong="H3478" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w The days| strong="H3117" \w* [are prolonged]{strong=“H748” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and every vision| strong="H2377" \w* [faileth]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”}? 
\v 23 [Tell]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} [them therefore, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w I will make this proverb| strong="H4912" \w* [to cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8689”}, [and they shall no more use it as a proverb]{strong=“H4911” x-morph=“strongMorph: \sc Th\sc*8799”} \w in Israel| strong="H3478" \w*; [but say]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} [unto them, The days]{strong=“H3117”} [are at hand]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and the effect| strong="H1697" \w* \w of every vision| strong="H2377" \w*. 
\v 24 \w For there shall be no more any vain| strong="H7723" \w* \w vision| strong="H2377" \w* \w nor flattering| strong="H2509" \w* \w divination| strong="H4738" \w* \w within| strong="H8432" \w* \w the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*. 
\v 25 For I am the \sc Lord\sc*: [I will speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}, \w and the word| strong="H1697" \w* [that I shall speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [shall come to pass]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8735”}; [it shall be no more prolonged]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8735”}: \w for in your days| strong="H3117" \w*, \w O rebellious| strong="H4805" \w* \w house| strong="H1004" \w*, [will I say]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w the word| strong="H1697" \w*, [and will perform]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [it, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\p
\v 26 \w Again the word| strong="H1697" \w* of the \sc Lord\sc* [came to me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 27 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, behold, they of \w the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, \w The vision| strong="H2377" \w* [that he seeth]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8802”} is \w for many| strong="H7227" \w* \w days| strong="H3117" \w* to come, [and he prophesieth]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8738”} \w of the times| strong="H6256" \w* that are \w far| strong="H7350" \w* off. 
\v 28 [Therefore say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} [unto them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w There shall none of my words| strong="H1697" \w* [be prolonged]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8735”} [any more, but the word]{strong=“H1697”} [which I have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [shall be done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8735”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\c 13
\p 
\v 1 \w And the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} \w against the prophets| strong="H5030" \w* \w of Israel| strong="H3478" \w* [that prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8737”}, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w thou unto them that prophesy| strong="H5030" \w* \w out of their own hearts| strong="H3820" \w*, [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye the word| strong="H1697" \w* of the \sc Lord\sc*;\f + \fr 13:2 \ft that prophesy out…: Heb. that are prophets out of their own hearts \f* 
\v 3 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w Woe| strong="H1945" \w* \w unto the foolish| strong="H5036" \w* \w prophets| strong="H5030" \w*, [that follow]{strong=“H310 H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w their own spirit| strong="H7307" \w*, [and have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} nothing!\f + \fr 13:3 \ft follow: Heb. walk after \f* \f + \fr 13:3 \ft and…: or, and things which they have not seen \f* 
\v 4 \w O Israel| strong="H3478" \w*, \w thy prophets| strong="H5030" \w* \w are like the foxes| strong="H7776" \w* \w in the deserts| strong="H2723" \w*. 
\v 5 [Ye have not gone up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the gaps| strong="H6556" \w*, [neither made up]{strong=“H1443” x-morph=“strongMorph: \sc Th\sc*8799”} \w the hedge| strong="H1447" \w* \w for the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* [to stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the battle| strong="H4421" \w* \w in the day| strong="H3117" \w* of the \sc Lord\sc*.\f + \fr 13:5 \ft gaps: or, breaches \f* \f + \fr 13:5 \ft made…: Heb. hedged the hedge \f* 
\v 6 [They have seen]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8804”} \w vanity| strong="H7723" \w* \w and lying| strong="H3577" \w* \w divination| strong="H7081" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, The \sc Lord\sc* [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”}: and the \sc Lord\sc* [hath not sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} them: and they have made others [to hope]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8765”} [that they would confirm]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8763”} \w the word| strong="H1697" \w*. 
\v 7 [Have ye not seen]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8804”} \w a vain| strong="H7723" \w* \w vision| strong="H4236" \w*, [and have ye not spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w a lying| strong="H3577" \w* \w divination| strong="H4738" \w*, [whereas ye say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, The \sc Lord\sc* [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} it; [albeit I have not spoken]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}? 
\v 8 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Because ye have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w vanity| strong="H7723" \w*, [and seen]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8804”} \w lies| strong="H3577" \w*, therefore, behold, I am [against you, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\v 9 \w And mine hand| strong="H3027" \w* \w shall be upon the prophets| strong="H5030" \w* \w that see| strong="H2374" \w* \w vanity| strong="H7723" \w*, [and that divine]{strong=“H7080” x-morph=“strongMorph: \sc Th\sc*8802”} \w lies| strong="H3577" \w*: \w they shall not be in the assembly| strong="H5475" \w* \w of my people| strong="H5971" \w*, [neither shall they be written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the writing| strong="H3791" \w* \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, [neither shall they enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the land| strong="H127" \w* \w of Israel| strong="H3478" \w*; [and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am \w the Lord| strong="H136" \w* \sc God\sc*.\f + \fr 13:9 \ft assembly: or, secret, or, counsel \f* 
\p
\v 10 [Because, even because they have seduced]{strong=“H2937” x-morph=“strongMorph: \sc Th\sc*8689”} \w my people| strong="H5971" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Peace| strong="H7965" \w*; and there was \w no peace| strong="H7965" \w*; [and one built up]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8802”} \w a wall| strong="H2434" \w*, [and, lo]{strong=“H2009”}, [others daubed]{strong=“H2902” x-morph=“strongMorph: \sc Th\sc*8802”} \w it with untempered| strong="H8602" \w* morter:\f + \fr 13:10 \ft a wall: or, a slight wall \f* 
\v 11 [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} [unto them which daub]{strong=“H2902” x-morph=“strongMorph: \sc Th\sc*8802”} it \w with untempered| strong="H8602" \w* morter, [that it shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”}: [there shall be an overflowing]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8802”} \w shower| strong="H1653" \w*; \w and ye| strong="H859" \w*, [O great hailstones]{strong=“H68 H417”}, [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”}; \w and a stormy| strong="H5591" \w* \w wind| strong="H7307" \w* [shall rend]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8762”} it. 
\v 12 [Lo, when the wall]{strong=“H7023”} [is fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”}, [shall it not be said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8735”} unto you, Where is \w the daubing| strong="H2915" \w* [wherewith ye have daubed]{strong=“H2902” x-morph=“strongMorph: \sc Th\sc*8804”} it? 
\v 13 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [I will even rend]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8765”} it \w with a stormy| strong="H5591" \w* \w wind| strong="H7307" \w* \w in my fury| strong="H2534" \w*; [and there shall be an overflowing]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8802”} \w shower| strong="H1653" \w* \w in mine anger| strong="H639" \w*, [and great hailstones]{strong=“H68 H417”} in my \w fury| strong="H2534" \w* \w to consume| strong="H3617" \w* it. 
\v 14 [So will I break down]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8804”} \w the wall| strong="H7023" \w* [that ye have daubed]{strong=“H2902” x-morph=“strongMorph: \sc Th\sc*8804”} \w with untempered| strong="H8602" \w* morter, [and bring]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8689”} \w it down to the ground| strong="H776" \w*, \w so that the foundation| strong="H3247" \w* [thereof shall be discovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8738”}, [and it shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”}, [and ye shall be consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the midst| strong="H8432" \w* [thereof: and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*. 
\v 15 [Thus will I accomplish]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8765”} \w my wrath| strong="H2534" \w* \w upon the wall| strong="H7023" \w*, [and upon them that have daubed]{strong=“H2902” x-morph=“strongMorph: \sc Th\sc*8802”} \w it with untempered| strong="H8602" \w* morter, [and will say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto you, The wall]{strong=“H7023”} is no more, [neither they that daubed]{strong=“H2902” x-morph=“strongMorph: \sc Th\sc*8802”} it; 
\v 16 To wit, \w the prophets| strong="H5030" \w* \w of Israel| strong="H3478" \w* [which prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8737”} \w concerning Jerusalem| strong="H3389" \w*, \w and which see| strong="H2374" \w* \w visions| strong="H2377" \w* \w of peace| strong="H7965" \w* for her, and there is \w no peace| strong="H7965" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\p
\v 17 [Likewise, thou son]{strong=“H1121”} \w of man| strong="H120" \w*, [set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy face| strong="H6440" \w* \w against the daughters| strong="H1323" \w* \w of thy people| strong="H5971" \w*, [which prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8693”} \w out of their own heart| strong="H3820" \w*; [and prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} thou against them, 
\v 18 [And say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w Woe| strong="H1945" \w* to the women [that sew]{strong=“H8609” x-morph=“strongMorph: \sc Th\sc*8764”} \w pillows| strong="H3704" \w* [to all armholes]{strong=“H3027 H679”}, [and make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w kerchiefs| strong="H4555" \w* \w upon the head| strong="H7218" \w* \w of every stature| strong="H6967" \w* [to hunt]{strong=“H6679” x-morph=“strongMorph: \sc Th\sc*8780”} \w souls| strong="H5315" \w*! [Will ye hunt]{strong=“H6679” x-morph=“strongMorph: \sc Th\sc*8779”} \w the souls| strong="H5315" \w* \w of my people| strong="H5971" \w*, \w and will ye save| strong="H2421" \w* \w the souls| strong="H5315" \w* [alive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8762”} that come unto you?\f + \fr 13:18 \ft armholes: or, elbows \f* 
\v 19 [And will ye pollute]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8762”} \w me among my people| strong="H5971" \w* \w for handfuls| strong="H8168" \w* \w of barley| strong="H8184" \w* \w and for pieces| strong="H6595" \w* \w of bread| strong="H3899" \w*, [to slay]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8687”} \w the souls| strong="H5315" \w* [that should not die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and to save| strong="H2421" \w* \w the souls| strong="H5315" \w* [alive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8763”} [that should not live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}, [by your lying]{strong=“H3576” x-morph=“strongMorph: \sc Th\sc*8763”} \w to my people| strong="H5971" \w* [that hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} your \w lies| strong="H3577" \w*? 
\v 20 [Wherefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; Behold, I am \w against your pillows| strong="H3704" \w*, \w wherewith ye| strong="H859" \w* [there hunt]{strong=“H6679” x-morph=“strongMorph: \sc Th\sc*8781”} \w the souls| strong="H5315" \w* to make them [fly]{strong=“H6524” x-morph=“strongMorph: \sc Th\sc*8802”}, [and I will tear]{strong=“H7167” x-morph=“strongMorph: \sc Th\sc*8804”} \w them from your arms| strong="H2220" \w*, \w and will let the souls| strong="H5315" \w* [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”}, even \w the souls| strong="H5315" \w* [that ye hunt]{strong=“H6679” x-morph=“strongMorph: \sc Th\sc*8781”} to make them [fly]{strong=“H6524” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 13:20 \ft to make…: or, into gardens \f* 
\v 21 \w Your kerchiefs| strong="H4555" \w* [also will I tear]{strong=“H7167” x-morph=“strongMorph: \sc Th\sc*8804”}, [and deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w my people| strong="H5971" \w* \w out of your hand| strong="H3027" \w*, \w and they shall be no more in your hand| strong="H3027" \w* \w to be hunted| strong="H4686" \w*; [and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*. 
\v 22 \w Because with lies| strong="H8267" \w* \w ye have made the heart| strong="H3820" \w* \w of the righteous| strong="H6662" \w* [sad]{strong=“H3512” x-morph=“strongMorph: \sc Th\sc*8687”}, [whom I have not made sad]{strong=“H3510” x-morph=“strongMorph: \sc Th\sc*8689”}; [and strengthened]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8763”} \w the hands| strong="H3027" \w* \w of the wicked| strong="H7451" \w*, [that he should not return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w from his wicked| strong="H7563" \w* \w way| strong="H1870" \w*, [by promising him life]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8687”}:\f + \fr 13:22 \ft by…: or, that I should save his life: Heb. by quickening him \f* 
\v 23 [Therefore ye shall see]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8799”} \w no more vanity| strong="H7723" \w*, [nor divine]{strong=“H7080” x-morph=“strongMorph: \sc Th\sc*8799”} \w divinations| strong="H7081" \w*: [for I will deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w my people| strong="H5971" \w* \w out of your hand| strong="H3027" \w*: [and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*.
\c 14
\p 
\v 1 [Then came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w certain| strong="H582" \w* \w of the elders| strong="H2205" \w* \w of Israel| strong="H3478" \w* [unto me, and sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* me. 
\v 2 \w And the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 3 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, \w these men| strong="H582" \w* [have set up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} \w their idols| strong="H1544" \w* \w in their heart| strong="H3820" \w*, [and put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w the stumblingblock| strong="H4383" \w* \w of their iniquity| strong="H5771" \w* \w before| strong="H5227" \w* \w their face| strong="H6440" \w*: [should I be enquired]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8735”} [of at all]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8736”} by them? 
\v 4 [Therefore speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} [unto them, and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w Every man| strong="H376" \w* \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* [that setteth up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w his idols| strong="H1544" \w* \w in his heart| strong="H3820" \w*, [and putteth]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w the stumblingblock| strong="H4383" \w* \w of his iniquity| strong="H5771" \w* \w before| strong="H5227" \w* \w his face| strong="H6440" \w*, [and cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the prophet| strong="H5030" \w*; I the \sc Lord\sc* [will answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8738”} [him that cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w according to the multitude| strong="H7230" \w* \w of his idols| strong="H1544" \w*; 
\v 5 [That I may take]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8800”} \w the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* \w in their own heart| strong="H3820" \w*, [because they are all estranged]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8738”} \w from me through their idols| strong="H1544" \w*. 
\p
\v 6 [Therefore say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Repent]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”}, [and turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”} yourselves \w from your idols| strong="H1544" \w*; [and turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”} \w your faces| strong="H6440" \w* \w from all your abominations| strong="H8441" \w*.\f + \fr 14:6 \ft yourselves: or, others \f* 
\v 7 \w For every one| strong="H376" \w* \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, \w or of the stranger| strong="H1616" \w* [that sojourneth]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”} \w in Israel| strong="H3478" \w*, [which separateth]{strong=“H5144” x-morph=“strongMorph: \sc Th\sc*8735”} \w himself from me| strong="H310" \w*, [and setteth up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w his idols| strong="H1544" \w* \w in his heart| strong="H3820" \w*, [and putteth]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w the stumblingblock| strong="H4383" \w* \w of his iniquity| strong="H5771" \w* \w before| strong="H5227" \w* \w his face| strong="H6440" \w*, [and cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w to a prophet| strong="H5030" \w* [to enquire]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8800”} of him concerning me; I the \sc Lord\sc* [will answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8737”} him by myself: 
\v 8 [And I will set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w my face| strong="H6440" \w* \w against that man| strong="H376" \w*, [and will make]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8689”} \w him a sign| strong="H226" \w* \w and a proverb| strong="H4912" \w*, [and I will cut him off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w from the midst| strong="H8432" \w* \w of my people| strong="H5971" \w*; [and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*. 
\v 9 \w And if the prophet| strong="H5030" \w* [be deceived]{strong=“H6601” x-morph=“strongMorph: \sc Th\sc*8792”} [when he hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w a thing| strong="H1697" \w*, I the \sc Lord\sc* [have deceived]{strong=“H6601” x-morph=“strongMorph: \sc Th\sc*8765”} \w that prophet| strong="H5030" \w*, [and I will stretch out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} \w my hand| strong="H3027" \w* [upon him, and will destroy]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8689”} \w him from the midst| strong="H8432" \w* \w of my people| strong="H5971" \w* \w Israel| strong="H3478" \w*. 
\v 10 [And they shall bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w the punishment of their iniquity| strong="H5771" \w*: \w the punishment| strong="H5771" \w* \w of the prophet| strong="H5030" \w* \w shall be even as the punishment| strong="H5771" \w* [of him that seeketh]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8802”} unto him; 
\v 11 \w That the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* [may go no more astray]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8799”} \w from me| strong="H310" \w*, [neither be polluted]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8691”} \w any more with all their transgressions| strong="H6588" \w*; \w but that they may be my people| strong="H5971" \w*, \w and I may be their God| strong="H430" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\p
\v 12 \w The word| strong="H1697" \w* of the \sc Lord\sc* [came again to me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 13 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, \w when the land| strong="H776" \w* [sinneth]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8799”} [against me by trespassing]{strong=“H4603” x-morph=“strongMorph: \sc Th\sc*8800”} \w grievously| strong="H4604" \w*, [then will I stretch out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine hand| strong="H3027" \w* [upon it, and will break]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8804”} \w the staff| strong="H4294" \w* \w of the bread| strong="H3899" \w* [thereof, and will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8689”} \w famine| strong="H7458" \w* [upon it, and will cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w man| strong="H120" \w* \w and beast| strong="H929" \w* from it: 
\v 14 \w Though these three| strong="H7969" \w* \w men| strong="H582" \w*, \w Noah| strong="H5146" \w*, \w Daniel| strong="H1840" \w*, \w and Job| strong="H347" \w*, \w were in it| strong="H8432" \w*, [they should deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8762”} but \w their own souls| strong="H5315" \w* \w by their righteousness| strong="H6666" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\p
\v 15 \w If| strong="H3863" \w* \w I cause noisome| strong="H7451" \w* \w beasts| strong="H2416" \w* [to pass through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8686”} \w the land| strong="H776" \w*, [and they spoil]{strong=“H7921” x-morph=“strongMorph: \sc Th\sc*8765”} [it, so that it be desolate]{strong=“H8077”}, [that no man may pass through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} \w because| strong="H6440" \w* \w of the beasts| strong="H2416" \w*:\f + \fr 14:15 \ft spoil: or, bereave \f* 
\v 16 Though \w these three| strong="H7969" \w* \w men| strong="H582" \w* were \w in it| strong="H8432" \w*, as \w I live| strong="H2416" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, [they shall deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w neither sons| strong="H1121" \w* \w nor daughters| strong="H1323" \w*; [they only shall be delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8735”}, \w but the land| strong="H776" \w* \w shall be desolate| strong="H8077" \w*.\f + \fr 14:16 \ft in it: Heb. in the midst of it \f* 
\p
\v 17 Or if [I bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w a sword| strong="H2719" \w* \w upon that land| strong="H776" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Sword| strong="H2719" \w*, [go through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w the land| strong="H776" \w*; [so that I cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w man| strong="H120" \w* \w and beast| strong="H929" \w* from it: 
\v 18 \w Though these three| strong="H7969" \w* \w men| strong="H582" \w* were \w in it| strong="H8432" \w*, as \w I live| strong="H2416" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, [they shall deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w neither sons| strong="H1121" \w* \w nor daughters| strong="H1323" \w*, [but they only shall be delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8735”} themselves. 
\p
\v 19 Or if [I send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w a pestilence| strong="H1698" \w* \w into that land| strong="H776" \w*, [and pour out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8804”} \w my fury| strong="H2534" \w* \w upon it in blood| strong="H1818" \w*, [to cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8687”} \w from it man| strong="H120" \w* \w and beast| strong="H929" \w*: 
\v 20 \w Though Noah| strong="H5146" \w*, \w Daniel| strong="H1840" \w*, \w and Job| strong="H347" \w*, were \w in it| strong="H8432" \w*, as \w I live| strong="H2416" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, [they shall deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w neither son| strong="H1121" \w* \w nor| strong="H518" \w* \w daughter| strong="H1323" \w*; they shall but [deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w their own souls| strong="H5315" \w* \w by their righteousness| strong="H6666" \w*. 
\v 21 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [How much more when I send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w my four| strong="H702" \w* \w sore| strong="H7451" \w* \w judgments| strong="H8201" \w* \w upon Jerusalem| strong="H3389" \w*, \w the sword| strong="H2719" \w*, \w and the famine| strong="H7458" \w*, \w and the noisome| strong="H7451" \w* \w beast| strong="H2416" \w*, \w and the pestilence| strong="H1698" \w*, [to cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8687”} \w from it man| strong="H120" \w* \w and beast| strong="H929" \w*?\f + \fr 14:21 \ft How…: or, Also when \f* 
\p
\v 22 [Yet, behold, therein shall be left]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8738”} \w a remnant| strong="H6413" \w* [that shall be brought forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8716”}, both \w sons| strong="H1121" \w* \w and daughters| strong="H1323" \w*: [behold, they shall come forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} [unto you, and ye shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w their way| strong="H1870" \w* \w and their doings| strong="H5949" \w*: [and ye shall be comforted]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8738”} \w concerning the evil| strong="H7451" \w* [that I have brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w upon Jerusalem| strong="H3389" \w*, even [concerning all that I have brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} upon it. 
\v 23 [And they shall comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8765”} [you, when ye see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w their ways| strong="H1870" \w* \w and their doings| strong="H5949" \w*: [and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [that I have not done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w without cause| strong="H2600" \w* [all that I have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [in it, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\c 15
\p 
\v 1 \w And the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, \w What is the vine| strong="H1612" \w* \w tree| strong="H6086" \w* \w more than any tree| strong="H6086" \w*, or than \w a branch| strong="H2156" \w* \w which is among the trees| strong="H6086" \w* \w of the forest| strong="H3293" \w*? 
\v 3 \w Shall wood| strong="H6086" \w* [be taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8714”} [thereof to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w any work| strong="H4399" \w*? or will men [take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a pin| strong="H3489" \w* [of it to hang]{strong=“H8518” x-morph=“strongMorph: \sc Th\sc*8800”} \w any vessel| strong="H3627" \w* thereon? 
\v 4 [Behold, it is cast]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w into the fire| strong="H784" \w* \w for fuel| strong="H402" \w*; \w the fire| strong="H784" \w* [devoureth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w both| strong="H8147" \w* \w the ends| strong="H7098" \w* [of it, and the midst]{strong=“H8432”} [of it is burned]{strong=“H2787” x-morph=“strongMorph: \sc Th\sc*8737”}. [Is it meet]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8799”} for any \w work| strong="H4399" \w*?\f + \fr 15:4 \ft Is it…: Heb. Will it prosper? \f* 
\v 5 [Behold, when it was whole]{strong=“H8549”}, [it was meet]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8735”} \w for no work| strong="H4399" \w*: [how much less shall it be meet]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8738”} yet for any \w work| strong="H4399" \w*, \w when the fire| strong="H784" \w* [hath devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} [it, and it is burned]{strong=“H2787” x-morph=“strongMorph: \sc Th\sc*8735”}?\f + \fr 15:5 \ft meet: Heb. made fit \f* 
\p
\v 6 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w As the vine| strong="H1612" \w* \w tree| strong="H6086" \w* \w among the trees| strong="H6086" \w* \w of the forest| strong="H3293" \w*, [which I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the fire| strong="H784" \w* \w for fuel| strong="H402" \w*, [so will I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w*. 
\v 7 [And I will set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w my face| strong="H6440" \w* [against them; they shall go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} from one \w fire| strong="H784" \w*, and another \w fire| strong="H784" \w* [shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [them; and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*, [when I set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w my face| strong="H6440" \w* against them. 
\v 8 [And I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w the land| strong="H776" \w* \w desolate| strong="H8077" \w*, [because they have committed]{strong=“H4603” x-morph=“strongMorph: \sc Th\sc*8804”} \w a trespass| strong="H4604" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*.\f + \fr 15:8 \ft committed…: Heb. trespassed a trespass \f*
\c 16
\p 
\v 1 \w Again the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, \w cause Jerusalem| strong="H3389" \w* [to know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8685”} \w her abominations| strong="H8441" \w*, 
\v 3 [And say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc* \w unto Jerusalem| strong="H3389" \w*; \w Thy birth| strong="H4351" \w* \w and thy nativity| strong="H4138" \w* is \w of the land| strong="H776" \w* \w of Canaan| strong="H3669" \w*; \w thy father| strong="H1" \w* was \w an Amorite| strong="H567" \w*, \w and thy mother| strong="H517" \w* \w an Hittite| strong="H2850" \w*.\f + \fr 16:3 \ft birth: Heb. cutting out, or, habitation \f* 
\v 4 And as for \w thy nativity| strong="H4138" \w*, \w in the day| strong="H3117" \w* [thou wast born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8715”} \w thy navel| strong="H8270" \w* [was not cut]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8795”}, [neither wast thou washed]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8795”} \w in water| strong="H4325" \w* \w to supple| strong="H4935" \w* thee; [thou wast not salted]{strong=“H4414” x-morph=“strongMorph: \sc Th\sc*8717”} [at all]{strong=“H4414” x-morph=“strongMorph: \sc Th\sc*8715”}, [nor swaddled]{strong=“H2853” x-morph=“strongMorph: \sc Th\sc*8795”} [at all]{strong=“H2853” x-morph=“strongMorph: \sc Th\sc*8715”}.\f + \fr 16:4 \ft to supple…: or, when I looked upon thee \f* 
\v 5 \w None eye| strong="H5869" \w* [pitied]{strong=“H2347” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w any| strong="H259" \w* [of these unto thee, to have compassion]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8800”} [upon thee; but thou wast cast out]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8714”} \w in the open| strong="H6440" \w* \w field| strong="H7704" \w*, \w to the lothing| strong="H1604" \w* \w of thy person| strong="H5315" \w*, \w in the day| strong="H3117" \w* [that thou wast born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8715”}. 
\p
\v 6 [And when I passed]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} [by thee, and saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [thee polluted]{strong=“H947” x-morph=“strongMorph: \sc Th\sc*8711”} \w in thine own blood| strong="H1818" \w*, [I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto thee when thou wast \w in thy blood| strong="H1818" \w*, [Live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8798”}; [yea, I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto thee when thou wast \w in thy blood| strong="H1818" \w*, [Live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8798”}.\f + \fr 16:6 \ft polluted: or, trodden under foot \f* 
\v 7 [I have caused]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee to multiply| strong="H7233" \w* \w as the bud| strong="H6780" \w* \w of the field| strong="H7704" \w*, [and thou hast increased]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8799”} [and waxen great]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8799”}, [and thou art come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to excellent| strong="H5716" \w* \w ornaments| strong="H5716" \w*: thy \w breasts| strong="H7699" \w* [are fashioned]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and thine hair| strong="H8181" \w* [is grown]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8765”}, whereas thou wast \w naked| strong="H5903" \w* \w and bare| strong="H6181" \w*.\f + \fr 16:7 \ft caused…: Heb. made thee a million \f* \f + \fr 16:7 \ft excellent…: Heb. ornament of ornaments \f* 
\v 8 [Now when I passed]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} [by thee, and looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [upon thee, behold, thy time]{strong=“H6256”} was \w the time| strong="H6256" \w* \w of love| strong="H1730" \w*; [and I spread]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8799”} \w my skirt| strong="H3671" \w* [over thee, and covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy nakedness| strong="H6172" \w*: [yea, I sware]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8735”} [unto thee, and entered]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into a covenant| strong="H1285" \w* [with thee, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, and thou becamest mine. 
