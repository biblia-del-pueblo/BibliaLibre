\v 26 [Thou hast also committed fornication]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8799”} [with the Egyptians]{strong=“H4714 H1121”} \w thy neighbours| strong="H7934" \w*, \w great| strong="H1432" \w* \w of flesh| strong="H1320" \w*; [and hast increased]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy whoredoms| strong="H8457" \w*, [to provoke me to anger]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8687”}. 
