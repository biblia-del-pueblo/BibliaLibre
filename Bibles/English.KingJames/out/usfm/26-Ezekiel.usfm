\v 37 [And I will cause you to pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8689”} \w under the rod| strong="H7626" \w*, [and I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w you into the bond| strong="H4562" \w* \w of the covenant| strong="H1285" \w*:\f + \fr 20:37 \ft bond: or, delivering \f* 
\v 38 [And I will purge out]{strong=“H1305” x-morph=“strongMorph: \sc Th\sc*8804”} [from among you the rebels]{strong=“H4775” x-morph=“strongMorph: \sc Th\sc*8802”}, [and them that transgress]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8802”} [against me: I will bring them forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w out of the country| strong="H776" \w* \w where they sojourn| strong="H4033" \w*, [and they shall not enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the land| strong="H127" \w* \w of Israel| strong="H3478" \w*: [and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*. 
\v 39 [As for you, O house]{strong=“H1004”} \w of Israel| strong="H3478" \w*, [thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} [ye, serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye every one| strong="H376" \w* \w his idols| strong="H1544" \w*, \w and hereafter| strong="H310" \w* also, [if ye will not hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} [unto me: but pollute]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8762”} \w ye my holy| strong="H6944" \w* \w name| strong="H8034" \w* \w no more with your gifts| strong="H4979" \w*, \w and with your idols| strong="H1544" \w*. 
\v 40 \w For in mine holy| strong="H6944" \w* \w mountain| strong="H2022" \w*, \w in the mountain| strong="H2022" \w* \w of the height| strong="H4791" \w* \w of Israel| strong="H3478" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, \w there shall all the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, \w all of them in the land| strong="H776" \w*, [serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} [me: there will I accept]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and there will I require]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”} \w your offerings| strong="H8641" \w*, \w and the firstfruits| strong="H7225" \w* \w of your oblations| strong="H4864" \w*, \w with all your holy things| strong="H6944" \w*.\f + \fr 20:40 \ft firstfruits: or, chief \f* 
\v 41 [I will accept]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8799”} \w you with your sweet| strong="H5207" \w* \w savour| strong="H7381" \w*, [when I bring you out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8687”} \w from the people| strong="H5971" \w*, [and gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8765”} \w you out of the countries| strong="H776" \w* [wherein ye have been scattered]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8738”}; [and I will be sanctified]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8738”} \w in you before| strong="H5869" \w* \w the heathen| strong="H1471" \w*.\f + \fr 20:41 \ft sweet…: Heb. savour of rest \f* 
\v 42 [And ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*, [when I shall bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} \w you into the land| strong="H127" \w* \w of Israel| strong="H3478" \w*, \w into the country| strong="H776" \w* for [the which I lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine hand| strong="H3027" \w* [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w it to your fathers| strong="H1" \w*. 
\v 43 [And there shall ye remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w your ways| strong="H1870" \w*, \w and all your doings| strong="H5949" \w*, [wherein ye have been defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8738”}; [and ye shall lothe]{strong=“H6962” x-morph=“strongMorph: \sc Th\sc*8738”} \w yourselves in your own sight| strong="H6440" \w* \w for all your evils| strong="H7451" \w* [that ye have committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 44 [And ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*, [when I have wrought]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [with you for my name’s]{strong=“H8034”} [sake, not according to your wicked]{strong=“H7451”} \w ways| strong="H1870" \w*, [nor according to your corrupt]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8737”} \w doings| strong="H5949" \w*, \w O ye house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\p
\v 45 \w Moreover the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 46 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy face| strong="H6440" \w* \w toward| strong="H1870" \w* \w the south| strong="H8486" \w*, [and drop]{strong=“H5197” x-morph=“strongMorph: \sc Th\sc*8685”} thy word \w toward the south| strong="H1864" \w*, [and prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} \w against the forest| strong="H3293" \w* \w of the south| strong="H5045" \w* \w field| strong="H7704" \w*; 
\v 47 [And say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the forest| strong="H3293" \w* \w of the south| strong="H5045" \w*, [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* of the \sc Lord\sc*; [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Behold, I will kindle]{strong=“H3341” x-morph=“strongMorph: \sc Th\sc*8688”} \w a fire| strong="H784" \w* [in thee, and it shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w every green| strong="H3892" \w* \w tree| strong="H6086" \w* [in thee, and every dry]{strong=“H3002”} \w tree| strong="H6086" \w*: \w the flaming| strong="H3852" \w* \w flame| strong="H7957" \w* [shall not be quenched]{strong=“H3518” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and all faces| strong="H6440" \w* \w from the south| strong="H5045" \w* \w to the north| strong="H6828" \w* [shall be burned]{strong=“H6866” x-morph=“strongMorph: \sc Th\sc*8738”} therein. 
\v 48 \w And all flesh| strong="H1320" \w* [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} that I the \sc Lord\sc* [have kindled]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8765”} [it: it shall not be quenched]{strong=“H3518” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 49 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [I, Ah]{strong=“H162”} \w Lord| strong="H136" \w* \sc God\sc*! [they say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} [of me, Doth he not speak]{strong=“H4911” x-morph=“strongMorph: \sc Th\sc*8764”} \w parables| strong="H4912" \w*? 
\c 21
\p 
\v 1 \w And the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy face| strong="H6440" \w* \w toward Jerusalem| strong="H3389" \w*, [and drop]{strong=“H5197” x-morph=“strongMorph: \sc Th\sc*8685”} thy word \w toward the holy places| strong="H4720" \w*, [and prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} \w against the land| strong="H127" \w* \w of Israel| strong="H3478" \w*, 
\v 3 [And say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the land| strong="H127" \w* \w of Israel| strong="H3478" \w*, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; Behold, I am [against thee, and will draw forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w my sword| strong="H2719" \w* \w out of his sheath| strong="H8593" \w*, [and will cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w from thee the righteous| strong="H6662" \w* \w and the wicked| strong="H7563" \w*. 
\v 4 \w Seeing| strong="H3282" \w* [then that I will cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w from thee the righteous| strong="H6662" \w* \w and the wicked| strong="H7563" \w*, \w therefore shall my sword| strong="H2719" \w* [go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of his sheath| strong="H8593" \w* \w against all flesh| strong="H1320" \w* \w from the south| strong="H5045" \w* \w to the north| strong="H6828" \w*: 
\v 5 \w That all flesh| strong="H1320" \w* [may know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I the \sc Lord\sc* [have drawn forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w my sword| strong="H2719" \w* \w out of his sheath| strong="H8593" \w*: [it shall not return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} any more. 
\v 6 [Sigh]{strong=“H584” x-morph=“strongMorph: \sc Th\sc*8734”} [therefore, thou son]{strong=“H1121”} \w of man| strong="H120" \w*, \w with the breaking| strong="H7670" \w* of thy \w loins| strong="H4975" \w*; \w and with bitterness| strong="H4814" \w* [sigh]{strong=“H584” x-morph=“strongMorph: \sc Th\sc*8735”} \w before their eyes| strong="H5869" \w*. 
\v 7 [And it shall be, when they say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee, Wherefore sighest]{strong=“H584” x-morph=“strongMorph: \sc Th\sc*8737”} [thou? that thou shalt answer]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w For the tidings| strong="H8052" \w*; [because it cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}: \w and every heart| strong="H3820" \w* [shall melt]{strong=“H4549” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and all hands| strong="H3027" \w* [shall be feeble]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and every spirit| strong="H7307" \w* [shall faint]{strong=“H3543” x-morph=“strongMorph: \sc Th\sc*8765”}, \w and all knees| strong="H1290" \w* [shall be weak]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} as \w water| strong="H4325" \w*: [behold, it cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}, [and shall be brought to pass]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8738”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*.\f + \fr 21:7 \ft shall be weak…: Heb. shall go into water \f* 
\p
\v 8 \w Again the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 9 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”}, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”}, \w A sword| strong="H2719" \w*, \w a sword| strong="H2719" \w* [is sharpened]{strong=“H2300” x-morph=“strongMorph: \sc Th\sc*8717”}, [and also furbished]{strong=“H4803” x-morph=“strongMorph: \sc Th\sc*8803”}: 
\v 10 [It is sharpened]{strong=“H2300” x-morph=“strongMorph: \sc Th\sc*8717”} \w to make a sore| strong="H2874" \w* [slaughter]{strong=“H2873” x-morph=“strongMorph: \sc Th\sc*8800”}; [it is furbished]{strong=“H4178” x-morph=“strongMorph: \sc Th\sc*8794”} \w that it may glitter| strong="H1300" \w*: \w should| strong="H176" \w* [we then make mirth]{strong=“H7797” x-morph=“strongMorph: \sc Th\sc*8799”}? [it contemneth]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8802”} \w the rod| strong="H7626" \w* \w of my son| strong="H1121" \w*, as \w every tree| strong="H6086" \w*.\f + \fr 21:10 \ft it contemneth…: or, it is the rod of my son, it despiseth every tree \f* 
\v 11 [And he hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [it to be furbished]{strong=“H4803” x-morph=“strongMorph: \sc Th\sc*8800”}, [that it may be handled]{strong=“H8610 H3709” x-morph=“strongMorph: \sc Th\sc*8800”}: \w this sword| strong="H2719" \w* [is sharpened]{strong=“H2300” x-morph=“strongMorph: \sc Th\sc*8717”}, [and it is furbished]{strong=“H4178” x-morph=“strongMorph: \sc Th\sc*8794”}, [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w it into the hand| strong="H3027" \w* [of the slayer]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 12 [Cry]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8798”} [and howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8685”}, \w son| strong="H1121" \w* \w of man| strong="H120" \w*: \w for it shall be upon my people| strong="H5971" \w*, it shall be \w upon all the princes| strong="H5387" \w* \w of Israel| strong="H3478" \w*: [terrors]{strong=“H4048” x-morph=“strongMorph: \sc Th\sc*8803”} \w by reason of| strong="H413" \w* \w the sword| strong="H2719" \w* \w shall be upon my people| strong="H5971" \w*: [smite]{strong=“H5606” x-morph=“strongMorph: \sc Th\sc*8798”} therefore upon thy \w thigh| strong="H3409" \w*.\f + \fr 21:12 \ft terrors…: or, they are thrust down to the sword with my people \f* 
\v 13 Because it is [a trial]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8795”}, and what if the sword [contemn]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8802”} \w even the rod| strong="H7626" \w*? it shall be no more, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*.\f + \fr 21:13 \ft Because…: or, When the trial hath been, what then? shall they not also belong to the despising rod? \f* 
\v 14 [Thou therefore, son]{strong=“H1121”} \w of man| strong="H120" \w*, [prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”}, \w and smite| strong="H5221" \w* thine [hands]{strong=“H3709 H3709”} [together]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8685”}, \w and let the sword| strong="H2719" \w* [be doubled]{strong=“H3717” x-morph=“strongMorph: \sc Th\sc*8735”} \w the third| strong="H7992" \w* [time, the sword]{strong=“H2719”} \w of the slain| strong="H2491" \w*: it is \w the sword| strong="H2719" \w* \w of the great| strong="H1419" \w* men that are \w slain| strong="H2491" \w*, [which entereth into their privy chambers]{strong=“H2314” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 21:14 \ft hands…: Heb. hand to hand \f* 
\v 15 [I have set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w the point| strong="H19" \w* \w of the sword| strong="H2719" \w* \w against all their gates| strong="H8179" \w*, that their \w heart| strong="H3820" \w* [may faint]{strong=“H4127” x-morph=“strongMorph: \sc Th\sc*8800”}, and their \w ruins| strong="H4383" \w* [be multiplied]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8687”}: \w ah| strong="H253" \w*! it is [made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8803”} \w bright| strong="H1300" \w*, it is \w wrapped up| strong="H4593" \w* \w for the slaughter| strong="H2874" \w*.\f + \fr 21:15 \ft point: or, glittering, or, fear \f* \f + \fr 21:15 \ft wrapped up: or, sharpened \f* 
\v 16 [Go thee one way or other]{strong=“H258” x-morph=“strongMorph: \sc Th\sc*8690”}, either [on]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8685”} [the right hand]{strong=“H3231” x-morph=“strongMorph: \sc Th\sc*8685”}, or [on the left]{strong=“H8041” x-morph=“strongMorph: \sc Th\sc*8685”}, \w whithersoever| strong="H575" \w* \w thy face| strong="H6440" \w* is [set]{strong=“H3259” x-morph=“strongMorph: \sc Th\sc*8716”}.\f + \fr 21:16 \ft or on…: Heb. set thyself, take the left hand \f* 
\v 17 [I will also smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w mine hands| strong="H3709" \w* \w together| strong="H3709" \w*, \w and I will cause my fury| strong="H2534" \w* [to rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8689”}: I the \sc Lord\sc* [have said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it. 
\p
\v 18 \w The word| strong="H1697" \w* of the \sc Lord\sc* [came unto me again, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 19 [Also, thou son]{strong=“H1121”} \w of man| strong="H120" \w*, [appoint]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee two| strong="H8147" \w* \w ways| strong="H1870" \w*, \w that the sword| strong="H2719" \w* \w of the king| strong="H4428" \w* \w of Babylon| strong="H894" \w* [may come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}: \w both twain| strong="H8147" \w* [shall come forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of one| strong="H259" \w* \w land| strong="H776" \w*: [and choose]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8761”} \w thou a place| strong="H3027" \w*, [choose]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8761”} it \w at the head| strong="H7218" \w* \w of the way| strong="H1870" \w* \w to the city| strong="H5892" \w*. 
\v 20 [Appoint]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w a way| strong="H1870" \w*, \w that the sword| strong="H2719" \w* [may come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w to Rabbath| strong="H7237" \w* [of the Ammonites]{strong=“H5983 H1121”}, \w and to Judah| strong="H3063" \w* \w in Jerusalem| strong="H3389" \w* [the defenced]{strong=“H1219” x-morph=“strongMorph: \sc Th\sc*8803”}. 
\v 21 \w For the king| strong="H4428" \w* \w of Babylon| strong="H894" \w* [stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} \w at the parting| strong="H517" \w* \w of the way| strong="H1870" \w*, \w at the head| strong="H7218" \w* \w of the two| strong="H8147" \w* \w ways| strong="H1870" \w*, [to use]{strong=“H7080” x-morph=“strongMorph: \sc Th\sc*8800”} \w divination| strong="H7081" \w*: he made his \w arrows| strong="H2671" \w* [bright]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8773”}, [he consulted]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8804”} \w with images| strong="H8655" \w*, [he looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the liver| strong="H3516" \w*.\f + \fr 21:21 \ft parting of: Heb. mother of \f* \f + \fr 21:21 \ft arrows: or, knives \f* \f + \fr 21:21 \ft images: Heb. teraphim \f* 
\v 22 \w At his right hand| strong="H3225" \w* \w was the divination| strong="H7081" \w* \w for Jerusalem| strong="H3389" \w*, [to appoint]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w captains| strong="H3733" \w*, [to open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8800”} \w the mouth| strong="H6310" \w* \w in the slaughter| strong="H7524" \w*, [to lift up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8687”} \w the voice| strong="H6963" \w* \w with shouting| strong="H8643" \w*, [to appoint]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} battering \w rams| strong="H3733" \w* \w against the gates| strong="H8179" \w*, [to cast]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8800”} \w a mount| strong="H5550" \w*, and [to build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8800”} \w a fort| strong="H1785" \w*.\f + \fr 21:22 \ft captains: or, battering rams: Heb. rams \f* 
\v 23 \w And it shall be unto them as a false| strong="H7723" \w* [divination]{strong=“H7080” x-morph=“strongMorph: \sc Th\sc*8800”} \w in their sight| strong="H5869" \w*, [to them that have sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8803”} \w oaths| strong="H7621" \w*: [but he will call to remembrance]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8688”} \w the iniquity| strong="H5771" \w*, [that they may be taken]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8736”}.\f + \fr 21:23 \ft to them…: or, for the oaths made unto them \f* 
\v 24 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w Because ye have made your iniquity| strong="H5771" \w* [to be remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8687”}, \w in that your transgressions| strong="H6588" \w* [are discovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8736”}, \w so that in all your doings| strong="H5949" \w* \w your sins| strong="H2403" \w* [do appear]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8736”}; because, I say, [that ye are come to remembrance]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8736”}, [ye shall be taken]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8735”} \w with the hand| strong="H3709" \w*. 
\p
\v 25 [And thou, profane]{strong=“H2491”} \w wicked| strong="H7563" \w* \w prince| strong="H5387" \w* \w of Israel| strong="H3478" \w*, \w whose day| strong="H3117" \w* [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, \w when| strong="H6256" \w* \w iniquity| strong="H5771" \w* shall have \w an end| strong="H7093" \w*, 
\v 26 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Remove]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8685”} \w the diadem| strong="H4701" \w*, [and take off]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8685”} \w the crown| strong="H5850" \w*: this shall not be \w the same| strong="H2063" \w*: [exalt]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8687”} him that is \w low| strong="H8217" \w*, [and abase]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8687”} him that is \w high| strong="H1364" \w*. 
\v 27 \w I will overturn| strong="H5754" \w*, \w overturn| strong="H5754" \w*, \w overturn| strong="H5754" \w*, [it: and it shall be]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} no more, [until he come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w whose right| strong="H4941" \w* [it is; and I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} it him.\f + \fr 21:27 \ft I will overturn…: Heb. Perverted, perverted, perverted, will I make it \f* 
\p
\v 28 [And thou, son]{strong=“H1121”} \w of man| strong="H120" \w*, [prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc* [concerning the Ammonites]{strong=“H5983 H1121”}, \w and concerning their reproach| strong="H2781" \w*; [even say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [thou, The sword]{strong=“H2719”}, \w the sword| strong="H2719" \w* is [drawn]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8803”}: \w for the slaughter| strong="H2874" \w* it is [furbished]{strong=“H4803” x-morph=“strongMorph: \sc Th\sc*8803”}, [to consume]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8687”} \w because of the glittering| strong="H1300" \w*: 
\v 29 [Whiles they see]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8800”} \w vanity| strong="H7723" \w* [unto thee, whiles they divine]{strong=“H7080” x-morph=“strongMorph: \sc Th\sc*8800”} \w a lie| strong="H3577" \w* [unto thee, to bring]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w thee upon the necks| strong="H6677" \w* of them that are \w slain| strong="H2491" \w*, \w of the wicked| strong="H7563" \w*, \w whose day| strong="H3117" \w* [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, \w when| strong="H6256" \w* \w their iniquity| strong="H5771" \w* shall have \w an end| strong="H7093" \w*. 
\v 30 Shall I cause it [to return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”} \w into his sheath| strong="H8593" \w*? [I will judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee in the place| strong="H4725" \w* [where thou wast created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8738”}, \w in the land| strong="H776" \w* \w of thy nativity| strong="H4351" \w*.\f + \fr 21:30 \ft Shall…: or, Cause it to return \f* 
\v 31 [And I will pour out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine indignation| strong="H2195" \w* [upon thee, I will blow]{strong=“H6315” x-morph=“strongMorph: \sc Th\sc*8686”} \w against thee in the fire| strong="H784" \w* \w of my wrath| strong="H5678" \w*, [and deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee into the hand| strong="H3027" \w* [of brutish]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8802”} \w men| strong="H582" \w*, and \w skilful| strong="H2796" \w* \w to destroy| strong="H4889" \w*.\f + \fr 21:31 \ft brutish: or, burning \f* 
\v 32 \w Thou shalt be for fuel| strong="H402" \w* \w to the fire| strong="H784" \w*; \w thy blood| strong="H1818" \w* \w shall be in the midst| strong="H8432" \w* \w of the land| strong="H776" \w*; thou shalt be no more [remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8735”}: for I the \sc Lord\sc* [have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it.
\c 22
\p 
\v 1 \w Moreover the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Now, thou son]{strong=“H1121”} \w of man| strong="H120" \w*, [wilt thou judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”}, [wilt thou judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w the bloody| strong="H1818" \w* \w city| strong="H5892" \w*? [yea, thou shalt shew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8689”} \w her all her abominations| strong="H8441" \w*.\f + \fr 22:2 \ft judge: or, plead for \f* \f + \fr 22:2 \ft bloody…: Heb. city of bloods? \f* \f + \fr 22:2 \ft shew her: Heb. make her know \f* 
\v 3 [Then say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [thou, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*, \w The city| strong="H5892" \w* [sheddeth]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8802”} \w blood| strong="H1818" \w* \w in the midst| strong="H8432" \w* [of it, that her time]{strong=“H6256”} [may come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}, [and maketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w idols| strong="H1544" \w* [against herself to defile]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8800”} herself. 
\v 4 [Thou art become guilty]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thy blood| strong="H1818" \w* [that thou hast shed]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8804”}; [and hast defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w thyself in thine idols| strong="H1544" \w* [which thou hast made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}; \w and thou hast caused thy days| strong="H3117" \w* [to draw near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”}, [and art come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} even \w unto thy years| strong="H8141" \w*: [therefore have I made]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee a reproach| strong="H2781" \w* \w unto the heathen| strong="H1471" \w*, \w and a mocking| strong="H7048" \w* \w to all countries| strong="H776" \w*. 
\v 5 Those that be \w near| strong="H7138" \w*, and those that be \w far| strong="H7350" \w* [from thee, shall mock]{strong=“H7046” x-morph=“strongMorph: \sc Th\sc*8691”} thee, which art [infamous]{strong=“H8034 H2931”} and \w much| strong="H7227" \w* \w vexed| strong="H4103" \w*.\f + \fr 22:5 \ft infamous…: Heb. polluted of name, much in vexation \f* 
\v 6 [Behold, the princes]{strong=“H5387”} \w of Israel| strong="H3478" \w*, \w every one| strong="H376" \w* \w were in thee to their power| strong="H2220" \w* [to shed]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8800”} \w blood| strong="H1818" \w*.\f + \fr 22:6 \ft power: Heb. arm \f* 
\v 7 [In thee have they set light]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8689”} \w by father| strong="H1" \w* \w and mother| strong="H517" \w*: \w in the midst| strong="H8432" \w* [of thee have they dealt]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w by oppression| strong="H6233" \w* \w with the stranger| strong="H1616" \w*: [in thee have they vexed]{strong=“H3238” x-morph=“strongMorph: \sc Th\sc*8689”} \w the fatherless| strong="H3490" \w* \w and the widow| strong="H490" \w*.\f + \fr 22:7 \ft oppression: or, deceit \f* 
\v 8 [Thou hast despised]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine holy things| strong="H6944" \w*, [and hast profaned]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8765”} \w my sabbaths| strong="H7676" \w*. 
\v 9 \w In thee are men| strong="H582" \w* \w that carry tales| strong="H7400" \w* [to shed]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8800”} \w blood| strong="H1818" \w*: [and in thee they eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon the mountains| strong="H2022" \w*: \w in the midst| strong="H8432" \w* [of thee they commit]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w lewdness| strong="H2154" \w*.\f + \fr 22:9 \ft that…: Heb. of slanders \f* 
\v 10 [In thee have they discovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8765”} [their fathers’]{strong=“H1”} \w nakedness| strong="H6172" \w*: [in thee have they humbled]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8765”} \w her that was set apart| strong="H5079" \w* \w for pollution| strong="H2931" \w*. 
\v 11 \w And one| strong="H376" \w* [hath committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w abomination| strong="H8441" \w* [with his neighbour’s]{strong=“H7453”} \w wife| strong="H802" \w*; \w and another| strong="H376" \w* \w hath lewdly| strong="H2154" \w* [defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8765”} \w his daughter in law| strong="H3618" \w*; \w and another| strong="H376" \w* [in thee hath humbled]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8765”} \w his sister| strong="H269" \w*, [his father’s]{strong=“H1”} \w daughter| strong="H1323" \w*.\f + \fr 22:11 \ft one: or, every one \f* \f + \fr 22:11 \ft another: or, every one \f* \f + \fr 22:11 \ft lewdly: or, by lewdness \f* 
\v 12 [In thee have they taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w gifts| strong="H7810" \w* [to shed]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8800”} \w blood| strong="H1818" \w*; [thou hast taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w usury| strong="H5392" \w* \w and increase| strong="H8636" \w*, [and thou hast greedily gained]{strong=“H1214” x-morph=“strongMorph: \sc Th\sc*8762”} \w of thy neighbours| strong="H7453" \w* \w by extortion| strong="H6233" \w*, [and hast forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} [me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\p
\v 13 [Behold, therefore I have smitten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w mine hand| strong="H3709" \w* \w at thy dishonest gain| strong="H1215" \w* [which thou hast made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and at thy blood| strong="H1818" \w* \w which hath been in the midst| strong="H8432" \w* of thee. 
\v 14 \w Can thine heart| strong="H3820" \w* [endure]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”}, \w or can thine hands| strong="H3027" \w* [be strong]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8799”}, \w in the days| strong="H3117" \w* [that I shall deal]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} with thee? I the \sc Lord\sc* [have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it, [and will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} it. 
\v 15 [And I will scatter]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee among the heathen| strong="H1471" \w*, [and disperse]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8765”} \w thee in the countries| strong="H776" \w*, [and will consume]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy filthiness| strong="H2932" \w* out of thee. 
\v 16 [And thou shalt take thine inheritance]{strong=“H5157 H2490” x-morph=“strongMorph: \sc Th\sc*8765 strongMorph: \sc Th\sc*8676 strongMorph: \sc Th\sc*8738”} \w in thyself in the sight| strong="H5869" \w* \w of the heathen| strong="H1471" \w*, [and thou shalt know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*.\f + \fr 22:16 \ft shalt take…: or, shalt be profaned \f* 
\p
\v 17 \w And the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 18 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, \w the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* \w is to me become dross| strong="H5509" \w*: all they are \w brass| strong="H5178" \w*, \w and tin| strong="H913" \w*, \w and iron| strong="H1270" \w*, \w and lead| strong="H5777" \w*, \w in the midst| strong="H8432" \w* \w of the furnace| strong="H3564" \w*; they are even \w the dross| strong="H5509" \w* \w of silver| strong="H3701" \w*.\f + \fr 22:18 \ft dross of silver: Heb. drosses, etc \f* 
\v 19 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w Because ye are all become dross| strong="H5509" \w*, [behold, therefore I will gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8802”} \w you into the midst| strong="H8432" \w* \w of Jerusalem| strong="H3389" \w*. 
\v 20 As \w they gather| strong="H6910" \w* \w silver| strong="H3701" \w*, \w and brass| strong="H5178" \w*, \w and iron| strong="H1270" \w*, \w and lead| strong="H5777" \w*, \w and tin| strong="H913" \w*, \w into the midst| strong="H8432" \w* \w of the furnace| strong="H3564" \w*, [to blow]{strong=“H5301” x-morph=“strongMorph: \sc Th\sc*8800”} \w the fire| strong="H784" \w* [upon it, to melt]{strong=“H5413” x-morph=“strongMorph: \sc Th\sc*8687”} it; [so will I gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8799”} you \w in mine anger| strong="H639" \w* \w and in my fury| strong="H2534" \w*, [and I will leave]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8689”} you there, [and melt]{strong=“H5413” x-morph=“strongMorph: \sc Th\sc*8689”} you.\f + \fr 22:20 \ft As…: Heb. According to the gathering \f* 
\v 21 [Yea, I will gather]{strong=“H3664” x-morph=“strongMorph: \sc Th\sc*8765”} [you, and blow]{strong=“H5301” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon you in the fire| strong="H784" \w* \w of my wrath| strong="H5678" \w*, [and ye shall be melted]{strong=“H5413” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the midst| strong="H8432" \w* thereof. 
\v 22 \w As silver| strong="H3701" \w* \w is melted| strong="H2046" \w* \w in the midst| strong="H8432" \w* \w of the furnace| strong="H3564" \w*, [so shall ye be melted]{strong=“H5413” x-morph=“strongMorph: \sc Th\sc*8714”} \w in the midst| strong="H8432" \w* [thereof; and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I the \sc Lord\sc* [have poured out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8804”} \w my fury| strong="H2534" \w* upon you. 
\p
\v 23 \w And the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 24 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} unto her, Thou art \w the land| strong="H776" \w* [that is not cleansed]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8794”}, \w nor rained| strong="H1656" \w* \w upon in the day| strong="H3117" \w* \w of indignation| strong="H2195" \w*. 
\v 25 There is \w a conspiracy| strong="H7195" \w* \w of her prophets| strong="H5030" \w* \w in the midst| strong="H8432" \w* [thereof, like a roaring]{strong=“H7580” x-morph=“strongMorph: \sc Th\sc*8802”} \w lion| strong="H738" \w* [ravening]{strong=“H2963” x-morph=“strongMorph: \sc Th\sc*8802”} \w the prey| strong="H2964" \w*; [they have devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w souls| strong="H5315" \w*; [they have taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the treasure| strong="H2633" \w* \w and precious things| strong="H3366" \w*; [they have made her many]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8689”} \w widows| strong="H490" \w* \w in the midst| strong="H8432" \w* thereof. 
\v 26 \w Her priests| strong="H3548" \w* [have violated]{strong=“H2554” x-morph=“strongMorph: \sc Th\sc*8804”} \w my law| strong="H8451" \w*, [and have profaned]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8762”} \w mine holy things| strong="H6944" \w*: [they have put no difference]{strong=“H914” x-morph=“strongMorph: \sc Th\sc*8689”} \w between the holy| strong="H6944" \w* \w and profane| strong="H2455" \w*, [neither have they shewed]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8689”} difference \w between the unclean| strong="H2931" \w* \w and the clean| strong="H2889" \w*, [and have hid]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8689”} \w their eyes| strong="H5869" \w* \w from my sabbaths| strong="H7676" \w*, [and I am profaned]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8735”} \w among| strong="H8432" \w* them.\f + \fr 22:26 \ft violated: Heb. offered violence to \f* 
\v 27 \w Her princes| strong="H8269" \w* \w in the midst| strong="H7130" \w* thereof are \w like wolves| strong="H2061" \w* [ravening]{strong=“H2963” x-morph=“strongMorph: \sc Th\sc*8802”} \w the prey| strong="H2964" \w*, [to shed]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8800”} \w blood| strong="H1818" \w*, and [to destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8763”} \w souls| strong="H5315" \w*, [to get]{strong=“H1214” x-morph=“strongMorph: \sc Th\sc*8800”} \w dishonest gain| strong="H1215" \w*. 
\v 28 \w And her prophets| strong="H5030" \w* [have daubed]{strong=“H2902” x-morph=“strongMorph: \sc Th\sc*8804”} \w them with untempered| strong="H8602" \w* morter, \w seeing| strong="H2374" \w* \w vanity| strong="H7723" \w*, [and divining]{strong=“H7080” x-morph=“strongMorph: \sc Th\sc*8802”} \w lies| strong="H3577" \w* [unto them, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*, when the \sc Lord\sc* [hath not spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 29 \w The people| strong="H5971" \w* \w of the land| strong="H776" \w* [have used oppression]{strong=“H6233 H6231” x-morph=“strongMorph: \sc Th\sc*8804”}, [and exercised]{strong=“H1497” x-morph=“strongMorph: \sc Th\sc*8804”} \w robbery| strong="H1498" \w*, [and have vexed]{strong=“H3238” x-morph=“strongMorph: \sc Th\sc*8689”} \w the poor| strong="H6041" \w* \w and needy| strong="H34" \w*: [yea, they have oppressed]{strong=“H6231” x-morph=“strongMorph: \sc Th\sc*8804”} \w the stranger| strong="H1616" \w* \w wrongfully| strong="H4941" \w*.\f + \fr 22:29 \ft oppression: or, deceit \f* \f + \fr 22:29 \ft wrongfully: Heb. without right \f* 
\v 30 [And I sought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w for a man| strong="H376" \w* [among them, that should make up]{strong=“H1443” x-morph=“strongMorph: \sc Th\sc*8802”} \w the hedge| strong="H1447" \w*, [and stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the gap| strong="H6556" \w* \w before| strong="H6440" \w* \w me for the land| strong="H776" \w*, [that I should not destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8763”} [it: but I found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} none. 
\v 31 [Therefore have I poured out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8799”} \w mine indignation| strong="H2195" \w* [upon them; I have consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8765”} \w them with the fire| strong="H784" \w* \w of my wrath| strong="H5678" \w*: \w their own way| strong="H1870" \w* [have I recompensed]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon their heads| strong="H7218" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*.
\c 23
\p 
\v 1 \w The word| strong="H1697" \w* of the \sc Lord\sc* [came again unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, \w there were two| strong="H8147" \w* \w women| strong="H802" \w*, \w the daughters| strong="H1323" \w* \w of one| strong="H259" \w* \w mother| strong="H517" \w*: 
\v 3 [And they committed whoredoms]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8799”} \w in Egypt| strong="H4714" \w*; [they committed whoredoms]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8804”} \w in their youth| strong="H5271" \w*: \w there were their breasts| strong="H7699" \w* [pressed]{strong=“H4600” x-morph=“strongMorph: \sc Th\sc*8795”}, [and there they bruised]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8765”} \w the teats| strong="H1717" \w* \w of their virginity| strong="H1331" \w*. 
\v 4 \w And the names| strong="H8034" \w* of them were \w Aholah| strong="H170" \w* \w the elder| strong="H1419" \w*, \w and Aholibah| strong="H172" \w* \w her sister| strong="H269" \w*: [and they were mine, and they bare]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8799”} \w sons| strong="H1121" \w* \w and daughters| strong="H1323" \w*. Thus were \w their names| strong="H8034" \w*; \w Samaria| strong="H8111" \w* is \w Aholah| strong="H170" \w*, \w and Jerusalem| strong="H3389" \w* \w Aholibah| strong="H172" \w*.\f + \fr 23:4 \ft Aholah: that is, His tent, or, tabernacle \f* \f + \fr 23:4 \ft Aholibah: that is, My tabernacle in her \f* 
\v 5 \w And Aholah| strong="H170" \w* [played the harlot]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8799”} \w when she was mine| strong="H8478" \w*; [and she doted]{strong=“H5689” x-morph=“strongMorph: \sc Th\sc*8799”} [on her lovers]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8764”}, \w on the Assyrians| strong="H804" \w* her \w neighbours| strong="H7138" \w*, 
\v 6 Which were [clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8803”} \w with blue| strong="H8504" \w*, \w captains| strong="H6346" \w* \w and rulers| strong="H5461" \w*, \w all of them desirable| strong="H2531" \w* \w young men| strong="H970" \w*, \w horsemen| strong="H6571" \w* [riding]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon horses| strong="H5483" \w*. 
\v 7 [Thus she committed]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w her whoredoms| strong="H8457" \w* with them, with all them that were \w the chosen| strong="H4005" \w* \w men| strong="H1121" \w* \w of Assyria| strong="H804" \w*, [and with all on whom she doted]{strong=“H5689” x-morph=“strongMorph: \sc Th\sc*8804”}: \w with all their idols| strong="H1544" \w* [she defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8738”} herself.\f + \fr 23:7 \ft committed…: Heb. bestowed her whoredoms upon them \f* \f + \fr 23:7 \ft the chosen…: Heb. the choice of the children of Asshur \f* 
\v 8 [Neither left]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} \w she her whoredoms| strong="H8457" \w* brought \w from Egypt| strong="H4714" \w*: \w for in her youth| strong="H5271" \w* [they lay]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8804”} [with her, and they bruised]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8765”} \w the breasts| strong="H1717" \w* \w of her virginity| strong="H1331" \w*, [and poured]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8799”} \w their whoredom| strong="H8457" \w* upon her. 
\v 9 [Wherefore I have delivered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w her into the hand| strong="H3027" \w* [of her lovers]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8764”}, \w into the hand| strong="H3027" \w* [of the Assyrians]{strong=“H804 H1121”}, [upon whom she doted]{strong=“H5689” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 10 [These discovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8765”} \w her nakedness| strong="H6172" \w*: [they took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w her sons| strong="H1121" \w* \w and her daughters| strong="H1323" \w*, [and slew]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”} \w her with the sword| strong="H2719" \w*: \w and she became famous| strong="H8034" \w* \w among women| strong="H802" \w*; [for they had executed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w judgment| strong="H8196" \w* upon her.\f + \fr 23:10 \ft famous: Heb. a name \f* 
\p
\v 11 \w And when her sister| strong="H269" \w* \w Aholibah| strong="H172" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} this, [she was more corrupt]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8686”} \w in her inordinate love| strong="H5691" \w* [than she, and in her whoredoms]{strong=“H8457”} \w more than her sister| strong="H269" \w* in her \w whoredoms| strong="H2183" \w*.\f + \fr 23:11 \ft she was…: Heb. she corrupted her inordinate love more than, etc \f* \f + \fr 23:11 \ft more than…: Heb. more than the whoredoms of her sister \f* 
\v 12 [She doted]{strong=“H5689” x-morph=“strongMorph: \sc Th\sc*8804”} [upon the Assyrians]{strong=“H804 H1121”} her \w neighbours| strong="H7138" \w*, \w captains| strong="H6346" \w* \w and rulers| strong="H5461" \w* [clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8803”} \w most gorgeously| strong="H4358" \w*, \w horsemen| strong="H6571" \w* [riding]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon horses| strong="H5483" \w*, \w all of them desirable| strong="H2531" \w* \w young men| strong="H970" \w*. 
\v 13 [Then I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [that she was defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8738”}, that they took \w both| strong="H8147" \w* \w one| strong="H259" \w* \w way| strong="H1870" \w*, 
\v 14 And that [she increased]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w her whoredoms| strong="H8457" \w*: [for when she saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w men| strong="H582" \w* [pourtrayed]{strong=“H2707” x-morph=“strongMorph: \sc Th\sc*8794”} \w upon the wall| strong="H7023" \w*, \w the images| strong="H6754" \w* \w of the Chaldeans| strong="H3778" \w* [pourtrayed]{strong=“H2710” x-morph=“strongMorph: \sc Th\sc*8803”} \w with vermilion| strong="H8350" \w*, 
\v 15 \w Girded| strong="H2289" \w* \w with girdles| strong="H232" \w* \w upon their loins| strong="H4975" \w*, [exceeding]{strong=“H5628” x-morph=“strongMorph: \sc Th\sc*8803”} \w in dyed attire| strong="H2871" \w* \w upon their heads| strong="H7218" \w*, \w all of them princes| strong="H7991" \w* \w to look to| strong="H4758" \w*, \w after the manner| strong="H1823" \w* [of the Babylonians]{strong=“H894 H1121”} \w of Chaldea| strong="H3778" \w*, \w the land| strong="H776" \w* \w of their nativity| strong="H4138" \w*: 
\v 16 \w And as soon as she saw| strong="H4758" \w* \w them with her eyes| strong="H5869" \w*, [she doted]{strong=“H5689” x-morph=“strongMorph: \sc Th\sc*8799”} [upon them, and sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w messengers| strong="H4397" \w* \w unto them into Chaldea| strong="H3778" \w*.\f + \fr 23:16 \ft as soon…: Heb. at the sight of her eyes \f* 
\v 17 [And the Babylonians]{strong=“H894 H1121”} [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to her into the bed| strong="H4904" \w* \w of love| strong="H1730" \w*, [and they defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8762”} \w her with their whoredom| strong="H8457" \w*, [and she was polluted]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”} [with them, and her mind]{strong=“H5315”} [was alienated]{strong=“H3363” x-morph=“strongMorph: \sc Th\sc*8799”} from them.\f + \fr 23:17 \ft Babylonians: Heb. children of Babel \f* \f + \fr 23:17 \ft alienated: Heb. loosed, or, disjointed \f* 
\v 18 [So she discovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”} \w her whoredoms| strong="H8457" \w*, [and discovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”} \w her nakedness| strong="H6172" \w*: \w then my mind| strong="H5315" \w* [was alienated]{strong=“H3363” x-morph=“strongMorph: \sc Th\sc*8799”} [from her, like as my mind]{strong=“H5315”} [was alienated]{strong=“H5361” x-morph=“strongMorph: \sc Th\sc*8804”} \w from her sister| strong="H269" \w*. 
\v 19 [Yet she multiplied]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} \w her whoredoms| strong="H8457" \w*, [in calling to remembrance]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8800”} \w the days| strong="H3117" \w* \w of her youth| strong="H5271" \w*, [wherein she had played the harlot]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*. 
\v 20 [For she doted]{strong=“H5689” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon their paramours| strong="H6370" \w*, \w whose flesh| strong="H1320" \w* is as \w the flesh| strong="H1320" \w* \w of asses| strong="H2543" \w*, \w and whose issue| strong="H2231" \w* is like \w the issue| strong="H2231" \w* \w of horses| strong="H5483" \w*. 
\v 21 [Thus thou calledst to remembrance]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} \w the lewdness| strong="H2154" \w* \w of thy youth| strong="H5271" \w*, [in bruising]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy teats| strong="H1717" \w* \w by the Egyptians| strong="H4714" \w* \w for the paps| strong="H7699" \w* \w of thy youth| strong="H5271" \w*. 
\p
\v 22 [Therefore, O Aholibah]{strong=“H172”}, [thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Behold, I will raise up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8688”} [thy lovers]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8764”} [against thee, from whom thy mind]{strong=“H5315”} [is alienated]{strong=“H5361” x-morph=“strongMorph: \sc Th\sc*8804”}, [and I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w them against thee on every side| strong="H5439" \w*; 
\v 23 [The Babylonians]{strong=“H894 H1121”}, \w and all the Chaldeans| strong="H3778" \w*, \w Pekod| strong="H6489" \w*, \w and Shoa| strong="H7772" \w*, \w and Koa| strong="H6970" \w*, and [all the Assyrians]{strong=“H804 H1121”} [with them: all of them desirable]{strong=“H2531”} \w young men| strong="H970" \w*, \w captains| strong="H6346" \w* \w and rulers| strong="H5461" \w*, \w great lords| strong="H7991" \w* [and renowned]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8803”}, [all of them riding]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon horses| strong="H5483" \w*. 
\v 24 [And they shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w against thee with chariots| strong="H2021" \w*, \w wagons| strong="H7393" \w*, \w and wheels| strong="H1534" \w*, \w and with an assembly| strong="H6951" \w* \w of people| strong="H5971" \w*, which [shall set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w against thee buckler| strong="H6793" \w* \w and shield| strong="H4043" \w* \w and helmet| strong="H6959" \w* \w round about| strong="H5439" \w*: [and I will set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w judgment| strong="H4941" \w* \w before| strong="H6440" \w* [them, and they shall judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee according to their judgments| strong="H4941" \w*. 
\v 25 [And I will set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w my jealousy| strong="H7068" \w* [against thee, and they shall deal]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w furiously| strong="H2534" \w* [with thee: they shall take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy nose| strong="H639" \w* \w and thine ears| strong="H241" \w*; \w and thy remnant| strong="H319" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w*: [they shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy sons| strong="H1121" \w* \w and thy daughters| strong="H1323" \w*; \w and thy residue| strong="H319" \w* [shall be devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8735”} \w by the fire| strong="H784" \w*. 
\v 26 [They shall also strip]{strong=“H6584” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee out of thy clothes| strong="H899" \w*, [and take away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy fair| strong="H8597" \w* \w jewels| strong="H3627" \w*.\f + \fr 23:26 \ft fair…: Heb. instruments of thy decking \f* 
\v 27 \w Thus will I make thy lewdness| strong="H2154" \w* [to cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8689”} [from thee, and thy whoredom]{strong=“H2184”} brought \w from the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*: [so that thou shalt not lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w thine eyes| strong="H5869" \w* [unto them, nor remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w Egypt| strong="H4714" \w* any more. 
\v 28 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Behold, I will deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w thee into the hand| strong="H3027" \w* of them [whom thou hatest]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”}, \w into the hand| strong="H3027" \w* of them \w from whom thy mind| strong="H5315" \w* [is alienated]{strong=“H5361” x-morph=“strongMorph: \sc Th\sc*8804”}: 
\v 29 [And they shall deal]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w with thee hatefully| strong="H8135" \w*, [and shall take away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w all thy labour| strong="H3018" \w*, [and shall leave]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee naked| strong="H5903" \w* \w and bare| strong="H6181" \w*: \w and the nakedness| strong="H6172" \w* \w of thy whoredoms| strong="H2183" \w* [shall be discovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8738”}, \w both thy lewdness| strong="H2154" \w* \w and thy whoredoms| strong="H8457" \w*. 
\v 30 [I will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} these things [unto thee, because thou hast gone a whoring]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8800”} \w after| strong="H310" \w* \w the heathen| strong="H1471" \w*, and [because thou art polluted]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8738”} \w with their idols| strong="H1544" \w*. 
\v 31 [Thou hast walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the way| strong="H1870" \w* \w of thy sister| strong="H269" \w*; [therefore will I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w her cup| strong="H3563" \w* \w into thine hand| strong="H3027" \w*. 
\v 32 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Thou shalt drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} [of thy sister’s]{strong=“H269”} \w cup| strong="H3563" \w* \w deep| strong="H6013" \w* \w and large| strong="H7342" \w*: \w thou shalt be laughed to scorn| strong="H6712" \w* \w and had in derision| strong="H3933" \w*; [it containeth]{strong=“H3557” x-morph=“strongMorph: \sc Th\sc*8687”} \w much| strong="H4767" \w*. 
\v 33 [Thou shalt be filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”} \w with drunkenness| strong="H7943" \w* \w and sorrow| strong="H3015" \w*, \w with the cup| strong="H3563" \w* \w of astonishment| strong="H8047" \w* \w and desolation| strong="H8077" \w*, \w with the cup| strong="H3563" \w* \w of thy sister| strong="H269" \w* \w Samaria| strong="H8111" \w*. 
\v 34 [Thou shalt even drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8804”} it and suck it [out]{strong=“H4680” x-morph=“strongMorph: \sc Th\sc*8804”}, [and thou shalt break]{strong=“H1633” x-morph=“strongMorph: \sc Th\sc*8762”} \w the sherds| strong="H2789" \w* [thereof, and pluck off]{strong=“H5423” x-morph=“strongMorph: \sc Th\sc*8762”} \w thine own breasts| strong="H7699" \w*: [for I have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\v 35 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Because thou hast forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w me behind| strong="H310" \w* \w thy back| strong="H1458" \w*, [therefore bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou also thy lewdness| strong="H2154" \w* \w and thy whoredoms| strong="H8457" \w*. 
\p
\v 36 The \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [moreover unto me; Son]{strong=“H1121”} \w of man| strong="H120" \w*, [wilt thou judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w Aholah| strong="H170" \w* \w and Aholibah| strong="H172" \w*? [yea, declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto them their abominations| strong="H8441" \w*;\f + \fr 23:36 \ft judge: or, plead for \f* 
\v 37 [That they have committed adultery]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8765”}, \w and blood| strong="H1818" \w* is \w in their hands| strong="H3027" \w*, \w and with their idols| strong="H1544" \w* [have they committed adultery]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8765”}, \w and have also caused their sons| strong="H1121" \w*, [whom they bare]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me, to pass for them through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8689”} the fire, \w to devour| strong="H402" \w* them. 
\v 38 [Moreover this they have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me: they have defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8765”} \w my sanctuary| strong="H4720" \w* \w in the same day| strong="H3117" \w*, [and have profaned]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8765”} \w my sabbaths| strong="H7676" \w*. 
\v 39 [For when they had slain]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8800”} \w their children| strong="H1121" \w* \w to their idols| strong="H1544" \w*, [then they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w the same day| strong="H3117" \w* \w into my sanctuary| strong="H4720" \w* [to profane]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8763”} [it; and, lo, thus have they done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the midst| strong="H8432" \w* \w of mine house| strong="H1004" \w*. 
\v 40 \w And furthermore| strong="H637" \w*, [that ye have sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w for men| strong="H582" \w* [to come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w from far| strong="H4801" \w*, \w unto whom a messenger| strong="H4397" \w* was [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8803”}; [and, lo, they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}: [for whom thou didst wash]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} [thyself, paintedst]{strong=“H3583” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy eyes| strong="H5869" \w*, [and deckedst]{strong=“H5710” x-morph=“strongMorph: \sc Th\sc*8804”} \w thyself with ornaments| strong="H5716" \w*,\f + \fr 23:40 \ft to come: Heb. coming \f* 
\v 41 [And satest]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon a stately| strong="H3520" \w* \w bed| strong="H4296" \w*, \w and a table| strong="H7979" \w* [prepared]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8803”} \w before| strong="H6440" \w* [it, whereupon thou hast set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine incense| strong="H7004" \w* \w and mine oil| strong="H8081" \w*.\f + \fr 23:41 \ft stately: Heb. honourable \f* 
\v 42 \w And a voice| strong="H6963" \w* \w of a multitude| strong="H1995" \w* \w being at ease| strong="H7961" \w* was [with her: and with the men]{strong=“H582”} [of the common sort]{strong=“H120 H7230”} were [brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8716”} [Sabeans]{strong=“H5433 H5436” x-morph=“strongMorph: \sc Th\sc*8802 strongMorph: \sc Th\sc*8675”} \w from the wilderness| strong="H4057" \w*, [which put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w bracelets| strong="H6781" \w* \w upon their hands| strong="H3027" \w*, \w and beautiful| strong="H8597" \w* \w crowns| strong="H5850" \w* \w upon their heads| strong="H7218" \w*.\f + \fr 23:42 \ft of the…: Heb. of the multitude of men \f* \f + \fr 23:42 \ft Sabeans: or, drunkards \f* 
\v 43 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} I unto her that was \w old| strong="H1087" \w* \w in adulteries| strong="H5004" \w*, [Will they now commit]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8799”} \w whoredoms| strong="H8457" \w* with her, and she with them?\f + \fr 23:43 \ft whoredoms…: Heb. her whoredoms \f* 
\v 44 [Yet they went in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [unto her, as they go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto a woman| strong="H802" \w* [that playeth the harlot]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”}: [so went they in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto Aholah| strong="H170" \w* \w and unto Aholibah| strong="H172" \w*, \w the lewd| strong="H2154" \w* \w women| strong="H802" \w*. 
\p
\v 45 \w And the righteous| strong="H6662" \w* \w men| strong="H582" \w*, [they shall judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w them after the manner| strong="H4941" \w* [of adulteresses]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and after the manner| strong="H4941" \w* [of women that shed]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8802”} \w blood| strong="H1818" \w*; because they are [adulteresses]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and blood| strong="H1818" \w* is \w in their hands| strong="H3027" \w*. 
\v 46 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [I will bring up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8687”} \w a company| strong="H6951" \w* [upon them, and will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w them to be removed| strong="H2189" \w* \w and spoiled| strong="H957" \w*.\f + \fr 23:46 \ft to be…: Heb. for a removing and spoil \f* 
\v 47 \w And the company| strong="H6951" \w* [shall stone]{strong=“H7275” x-morph=“strongMorph: \sc Th\sc*8804”} \w them with stones| strong="H68" \w*, [and dispatch]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8763”} \w them with their swords| strong="H2719" \w*; [they shall slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} \w their sons| strong="H1121" \w* \w and their daughters| strong="H1323" \w*, [and burn up]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8799”} \w their houses| strong="H1004" \w* \w with fire| strong="H784" \w*.\f + \fr 23:47 \ft dispatch…: or, single them out \f* 
\v 48 \w Thus will I cause lewdness| strong="H2154" \w* [to cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8689”} \w out of the land| strong="H776" \w*, \w that all women| strong="H802" \w* [may be taught]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8739”} [not to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w after your lewdness| strong="H2154" \w*. 
\v 49 [And they shall recompense]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w your lewdness| strong="H2154" \w* [upon you, and ye shall bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w the sins| strong="H2399" \w* \w of your idols| strong="H1544" \w*: [and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am \w the Lord| strong="H136" \w* \sc God\sc*.
\c 24
\p 
\v 1 \w Again in the ninth| strong="H8671" \w* \w year| strong="H8141" \w*, \w in the tenth| strong="H6224" \w* \w month| strong="H2320" \w*, \w in the tenth| strong="H6218" \w* day \w of the month| strong="H2320" \w*, \w the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [write]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee the name| strong="H8034" \w* \w of the day| strong="H3117" \w*, even \w of this same| strong="H6106" \w* \w day| strong="H3117" \w*: \w the king| strong="H4428" \w* \w of Babylon| strong="H894" \w* [set]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8804”} \w himself against Jerusalem| strong="H3389" \w* \w this same| strong="H6106" \w* \w day| strong="H3117" \w*. 
\v 3 [And utter]{strong=“H4911” x-morph=“strongMorph: \sc Th\sc*8798”} \w a parable| strong="H4912" \w* \w unto the rebellious| strong="H4805" \w* \w house| strong="H1004" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Set on]{strong=“H8239” x-morph=“strongMorph: \sc Th\sc*8798”} \w a pot| strong="H5518" \w*, set it [on]{strong=“H8239” x-morph=“strongMorph: \sc Th\sc*8798”}, [and also pour]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8798”} \w water| strong="H4325" \w* into it: 
\v 4 [Gather]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8798”} \w the pieces| strong="H5409" \w* thereof into it, even \w every good| strong="H2896" \w* \w piece| strong="H5409" \w*, \w the thigh| strong="H3409" \w*, \w and the shoulder| strong="H3802" \w*; [fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8761”} it \w with the choice| strong="H4005" \w* \w bones| strong="H6106" \w*. 
\v 5 [Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} \w the choice| strong="H4005" \w* \w of the flock| strong="H6629" \w*, \w and burn| strong="H1754" \w* \w also the bones| strong="H6106" \w* under it, and [make it boil]{strong=“H7570” x-morph=“strongMorph: \sc Th\sc*8761”} \w well| strong="H7571" \w*, [and let them seethe]{strong=“H1310” x-morph=“strongMorph: \sc Th\sc*8804”} \w the bones| strong="H6106" \w* \w of it therein| strong="H8432" \w*.\f + \fr 24:5 \ft burn: or, heap \f* 
\p
\v 6 [Wherefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w Woe| strong="H188" \w* \w to the bloody| strong="H1818" \w* \w city| strong="H5892" \w*, \w to the pot| strong="H5518" \w* \w whose scum| strong="H2457" \w* is [therein, and whose scum]{strong=“H2457”} [is not gone out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} [of it! bring it out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8685”} \w piece| strong="H5409" \w* \w by piece| strong="H5409" \w*; \w let no lot| strong="H1486" \w* [fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} upon it. 
\v 7 \w For her blood| strong="H1818" \w* \w is in the midst| strong="H8432" \w* [of her; she set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w it upon the top| strong="H6706" \w* \w of a rock| strong="H5553" \w*; [she poured]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8804”} \w it not upon the ground| strong="H776" \w*, [to cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8763”} \w it with dust| strong="H6083" \w*; 
\v 8 \w That it might cause fury| strong="H2534" \w* [to come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8687”} [to take]{strong=“H5358” x-morph=“strongMorph: \sc Th\sc*8800”} \w vengeance| strong="H5359" \w*; [I have set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w her blood| strong="H1818" \w* \w upon the top| strong="H6706" \w* \w of a rock| strong="H5553" \w*, [that it should not be covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8736”}. 
\v 9 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w Woe| strong="H188" \w* \w to the bloody| strong="H1818" \w* \w city| strong="H5892" \w*! \w I will even make the pile| strong="H4071" \w* [for fire great]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 10 [Heap]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8685”} \w on wood| strong="H6086" \w*, [kindle]{strong=“H1814” x-morph=“strongMorph: \sc Th\sc*8687”} \w the fire| strong="H784" \w*, [consume]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8687”} \w the flesh| strong="H1320" \w*, [and spice]{strong=“H7543” x-morph=“strongMorph: \sc Th\sc*8687”} \w it well| strong="H4841" \w*, \w and let the bones| strong="H6106" \w* [be burned]{strong=“H2787” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 11 [Then set]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8687”} \w it empty| strong="H7386" \w* \w upon the coals| strong="H1513" \w* [thereof, that the brass]{strong=“H5178”} [of it may be hot]{strong=“H3179” x-morph=“strongMorph: \sc Th\sc*8799”}, [and may burn]{strong=“H2787” x-morph=“strongMorph: \sc Th\sc*8804”}, and that \w the filthiness| strong="H2932" \w* [of it may be molten]{strong=“H5413” x-morph=“strongMorph: \sc Th\sc*8738”} \w in it| strong="H8432" \w*, that \w the scum| strong="H2457" \w* [of it may be consumed]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 12 [She hath wearied]{strong=“H3811” x-morph=“strongMorph: \sc Th\sc*8689”} herself \w with lies| strong="H8383" \w*, \w and her great| strong="H7227" \w* \w scum| strong="H2457" \w* [went not forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} [out of her: her scum]{strong=“H2457”} shall be \w in the fire| strong="H784" \w*. 
\v 13 \w In thy filthiness| strong="H2932" \w* is \w lewdness| strong="H2154" \w*: [because I have purged]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8765”} [thee, and thou wast not purged]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8804”}, [thou shalt not be purged]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8799”} \w from thy filthiness| strong="H2932" \w* [any more, till I have caused my fury]{strong=“H2534”} [to rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8687”} upon thee. 
\v 14 I the \sc Lord\sc* [have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it: [it shall come to pass]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}, [and I will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} it; [I will not go back]{strong=“H6544” x-morph=“strongMorph: \sc Th\sc*8799”}, [neither will I spare]{strong=“H2347” x-morph=“strongMorph: \sc Th\sc*8799”}, [neither will I repent]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8735”}; \w according to thy ways| strong="H1870" \w*, \w and according to thy doings| strong="H5949" \w*, [shall they judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\p
\v 15 \w Also the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 16 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [behold, I take away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8802”} \w from thee the desire| strong="H4261" \w* \w of thine eyes| strong="H5869" \w* \w with a stroke| strong="H4046" \w*: [yet neither shalt thou mourn]{strong=“H5594” x-morph=“strongMorph: \sc Th\sc*8799”} [nor weep]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8799”}, \w neither shall thy tears| strong="H1832" \w* [run down]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 24:16 \ft run down: Heb. go \f* 
\v 17 [Forbear]{strong=“H1826” x-morph=“strongMorph: \sc Th\sc*8798”} [to cry]{strong=“H602” x-morph=“strongMorph: \sc Th\sc*8736”}, [make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w no mourning| strong="H60" \w* [for the dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”}, [bind]{strong=“H2280” x-morph=“strongMorph: \sc Th\sc*8798”} \w the tire of thine head| strong="H6287" \w* [upon thee, and put on]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy shoes| strong="H5275" \w* \w upon thy feet| strong="H7272" \w*, [and cover]{strong=“H5844” x-morph=“strongMorph: \sc Th\sc*8799”} not thy \w lips| strong="H8222" \w*, [and eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w not the bread| strong="H3899" \w* \w of men| strong="H582" \w*.\f + \fr 24:17 \ft Forbear: Heb. Be silent \f* \f + \fr 24:17 \ft lips: Heb. upper lip \f* 
\v 18 [So I spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto the people| strong="H5971" \w* \w in the morning| strong="H1242" \w*: \w and at even| strong="H6153" \w* \w my wife| strong="H802" \w* [died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}; [and I did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the morning| strong="H1242" \w* [as I was commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8795”}. 
\p
\v 19 \w And the people| strong="H5971" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Wilt thou not tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} us what these things are [to us, that thou doest]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} so? 
\v 20 [Then I answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [them, The word]{strong=“H1697”} of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 21 [Speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Behold, I will profane]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8764”} \w my sanctuary| strong="H4720" \w*, \w the excellency| strong="H1347" \w* \w of your strength| strong="H5797" \w*, \w the desire| strong="H4261" \w* \w of your eyes| strong="H5869" \w*, \w and that which your soul| strong="H5315" \w* \w pitieth| strong="H4263" \w*; \w and your sons| strong="H1121" \w* \w and your daughters| strong="H1323" \w* [whom ye have left]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w*.\f + \fr 24:21 \ft that…: Heb. the pity of your soul \f* 
\v 22 [And ye shall do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [as I have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}: [ye shall not cover]{strong=“H5844” x-morph=“strongMorph: \sc Th\sc*8799”} your \w lips| strong="H8222" \w*, [nor eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the bread| strong="H3899" \w* \w of men| strong="H582" \w*. 
\v 23 \w And your tires| strong="H6287" \w* shall be \w upon your heads| strong="H7218" \w*, \w and your shoes| strong="H5275" \w* \w upon your feet| strong="H7272" \w*: [ye shall not mourn]{strong=“H5594” x-morph=“strongMorph: \sc Th\sc*8799”} [nor weep]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8799”}; [but ye shall pine away]{strong=“H4743” x-morph=“strongMorph: \sc Th\sc*8738”} \w for your iniquities| strong="H5771" \w*, [and mourn]{strong=“H5098” x-morph=“strongMorph: \sc Th\sc*8804”} \w one| strong="H376" \w* \w toward another| strong="H251" \w*. 
\v 24 \w Thus Ezekiel| strong="H3168" \w* \w is unto you a sign| strong="H4159" \w*: [according to all that he hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [shall ye do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}: [and when this cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}, [ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am \w the Lord| strong="H136" \w* \sc God\sc*. 
\v 25 [Also, thou son]{strong=“H1121”} \w of man| strong="H120" \w*, shall it not be \w in the day| strong="H3117" \w* [when I take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} \w from them their strength| strong="H4581" \w*, \w the joy| strong="H4885" \w* \w of their glory| strong="H8597" \w*, \w the desire| strong="H4261" \w* \w of their eyes| strong="H5869" \w*, \w and that whereupon they set| strong="H4853" \w* \w their minds| strong="H5315" \w*, \w their sons| strong="H1121" \w* \w and their daughters| strong="H1323" \w*,\f + \fr 24:25 \ft that…: Heb. the lifting up of their soul \f* 
\v 26 That \w he that escapeth| strong="H6412" \w* \w in that day| strong="H3117" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} unto thee, to cause thee \w to hear| strong="H2045" \w* it with thine \w ears| strong="H241" \w*? 
\v 27 \w In that day| strong="H3117" \w* \w shall thy mouth| strong="H6310" \w* [be opened]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8735”} \w to him which is escaped| strong="H6412" \w*, [and thou shalt speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}, [and be no more dumb]{strong=“H481” x-morph=“strongMorph: \sc Th\sc*8735”}: \w and thou shalt be a sign| strong="H4159" \w* [unto them; and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*.
\c 25
\p 
\v 1 \w The word| strong="H1697" \w* of the \sc Lord\sc* [came again unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy face| strong="H6440" \w* [against the Ammonites]{strong=“H5983 H1121”}, [and prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} against them; 
\v 3 [And say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto the Ammonites]{strong=“H5983 H1121”}, [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* \w of the Lord| strong="H136" \w* \sc God\sc*; [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Because thou saidst]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Aha| strong="H1889" \w*, \w against my sanctuary| strong="H4720" \w*, [when it was profaned]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8738”}; \w and against the land| strong="H127" \w* \w of Israel| strong="H3478" \w*, [when it was desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8738”}; \w and against the house| strong="H1004" \w* \w of Judah| strong="H3063" \w*, [when they went]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w into captivity| strong="H1473" \w*; 
\v 4 [Behold, therefore I will deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w thee to the men| strong="H1121" \w* \w of the east| strong="H6924" \w* \w for a possession| strong="H4181" \w*, [and they shall set]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8765”} \w their palaces| strong="H2918" \w* [in thee, and make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w their dwellings| strong="H4908" \w* [in thee: they shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy fruit| strong="H6529" \w*, [and they shall drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy milk| strong="H2461" \w*.\f + \fr 25:4 \ft men: Heb. children \f* 
\v 5 [And I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w Rabbah| strong="H7237" \w* \w a stable| strong="H5116" \w* \w for camels| strong="H1581" \w*, [and the Ammonites]{strong=“H5983 H1121”} \w a couchingplace| strong="H4769" \w* \w for flocks| strong="H6629" \w*: [and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*. 
\v 6 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Because thou hast clapped]{strong=“H4222” x-morph=“strongMorph: \sc Th\sc*8763”} thine \w hands| strong="H3027" \w*, [and stamped]{strong=“H7554” x-morph=“strongMorph: \sc Th\sc*8800”} \w with the feet| strong="H7272" \w*, [and rejoiced]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} \w in heart| strong="H5315" \w* \w with all thy despite| strong="H7589" \w* \w against the land| strong="H127" \w* \w of Israel| strong="H3478" \w*;\f + \fr 25:6 \ft hands: Heb. hand \f* \f + \fr 25:6 \ft feet: Heb. foot \f* \f + \fr 25:6 \ft heart: Heb. soul \f* 
\v 7 [Behold, therefore I will stretch out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine hand| strong="H3027" \w* [upon thee, and will deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [thee for a spoil]{strong=“H897 H957” x-morph=“strongMorph: \sc Th\sc*8675”} \w to the heathen| strong="H1471" \w*; [and I will cut thee off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w from the people| strong="H5971" \w*, [and I will cause thee to perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8689”} \w out of the countries| strong="H776" \w*: [I will destroy]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8686”} [thee; and thou shalt know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*.\f + \fr 25:7 \ft a spoil: or, meat \f* 
\p
\v 8 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w Because| strong="H3282" \w* \w that Moab| strong="H4124" \w* \w and Seir| strong="H8165" \w* [do say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Behold, the house]{strong=“H1004”} \w of Judah| strong="H3063" \w* is \w like unto all the heathen| strong="H1471" \w*; 
\v 9 [Therefore, behold, I will open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8802”} \w the side| strong="H3802" \w* \w of Moab| strong="H4124" \w* \w from the cities| strong="H5892" \w*, \w from his cities| strong="H5892" \w* which are \w on his frontiers| strong="H7097" \w*, \w the glory| strong="H6643" \w* \w of the country| strong="H776" \w*, [Beth-jeshimoth]{strong=“H1020”}, [Baal-meon]{strong=“H1186”}, \w and Kiriathaim| strong="H7156" \w*,\f + \fr 25:9 \ft side…: Heb. shoulder of Moab \f* 
\v 10 \w Unto the men| strong="H1121" \w* \w of the east| strong="H6924" \w* [with the Ammonites]{strong=“H5983 H1121”}, [and will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w them in possession| strong="H4181" \w*, [that the Ammonites]{strong=“H5983 H1121”} [may not be remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8735”} \w among the nations| strong="H1471" \w*.\f + \fr 25:10 \ft with…: or, against the children of Ammon \f* 
\v 11 [And I will execute]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w judgments| strong="H8201" \w* \w upon Moab| strong="H4124" \w*; [and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*. 
\p
\v 12 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w Because that Edom| strong="H123" \w* [hath dealt]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w against the house| strong="H1004" \w* \w of Judah| strong="H3063" \w* [by taking]{strong=“H5358” x-morph=“strongMorph: \sc Th\sc*8800”} \w vengeance| strong="H5359" \w*, [and hath greatly]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8800”} [offended]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8799”}, [and revenged]{strong=“H5358” x-morph=“strongMorph: \sc Th\sc*8738”} himself upon them;\f + \fr 25:12 \ft by…: Heb. by revenging revengement \f* 
\v 13 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [I will also stretch out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine hand| strong="H3027" \w* \w upon Edom| strong="H123" \w*, [and will cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w man| strong="H120" \w* \w and beast| strong="H929" \w* [from it; and I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w it desolate| strong="H2723" \w* \w from Teman| strong="H8487" \w*; \w and they of Dedan| strong="H1719" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w*.\f + \fr 25:13 \ft they…: or, they shall fall by the sword unto Dedan \f* 
\v 14 [And I will lay]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w my vengeance| strong="H5360" \w* \w upon Edom| strong="H123" \w* \w by the hand| strong="H3027" \w* \w of my people| strong="H5971" \w* \w Israel| strong="H3478" \w*: [and they shall do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w in Edom| strong="H123" \w* \w according to mine anger| strong="H639" \w* \w and according to my fury| strong="H2534" \w*; [and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w my vengeance| strong="H5360" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\p
\v 15 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w Because the Philistines| strong="H6430" \w* [have dealt]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w by revenge| strong="H5360" \w*, [and have taken]{strong=“H5358” x-morph=“strongMorph: \sc Th\sc*8735”} \w vengeance| strong="H5359" \w* \w with a despiteful| strong="H7589" \w* \w heart| strong="H5315" \w*, \w to destroy| strong="H4889" \w* it \w for the old| strong="H5769" \w* \w hatred| strong="H342" \w*;\f + \fr 25:15 \ft for the…: or, with perpetual hatred \f* 
\v 16 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Behold, I will stretch out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8802”} \w mine hand| strong="H3027" \w* \w upon the Philistines| strong="H6430" \w*, [and I will cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w the Cherethims| strong="H3774" \w*, [and destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8689”} \w the remnant| strong="H7611" \w* \w of the sea| strong="H3220" \w* \w coast| strong="H2348" \w*.\f + \fr 25:16 \ft sea coast: or, haven of the sea \f* 
\v 17 [And I will execute]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w great| strong="H1419" \w* \w vengeance| strong="H5360" \w* \w upon them with furious| strong="H2534" \w* \w rebukes| strong="H8433" \w*; [and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*, [when I shall lay]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w my vengeance| strong="H5360" \w* upon them.\f + \fr 25:17 \ft great vengeance: Heb. great vengeances \f*
\c 26
\p 
\v 1 [And it came to pass in the eleventh]{strong=“H6240 H6249”} \w year| strong="H8141" \w*, \w in the first| strong="H259" \w* day \w of the month| strong="H2320" \w*, that \w the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, \w because that Tyrus| strong="H6865" \w* [hath said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w against Jerusalem| strong="H3389" \w*, \w Aha| strong="H1889" \w*, [she is broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8738”} that was \w the gates| strong="H1817" \w* \w of the people| strong="H5971" \w*: [she is turned]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8738”} [unto me: I shall be replenished]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”}, now [she is laid waste]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8717”}: 
\v 3 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; Behold, I am [against thee, O Tyrus]{strong=“H6865”}, \w and will cause many| strong="H7227" \w* \w nations| strong="H1471" \w* [to come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} [against thee, as the sea]{strong=“H3220”} \w causeth his waves| strong="H1530" \w* [to come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8687”}. 
\v 4 [And they shall destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8765”} \w the walls| strong="H2346" \w* \w of Tyrus| strong="H6865" \w*, [and break down]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8804”} \w her towers| strong="H4026" \w*: [I will also scrape]{strong=“H5500” x-morph=“strongMorph: \sc Th\sc*8765”} \w her dust| strong="H6083" \w* [from her, and make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w her like the top| strong="H6706" \w* \w of a rock| strong="H5553" \w*. 
\v 5 It shall be a place for \w the spreading| strong="H4894" \w* \w of nets| strong="H2764" \w* \w in the midst| strong="H8432" \w* \w of the sea| strong="H3220" \w*: [for I have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*: \w and it shall become a spoil| strong="H957" \w* \w to the nations| strong="H1471" \w*. 
\v 6 \w And her daughters| strong="H1323" \w* which are \w in the field| strong="H7704" \w* [shall be slain]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8735”} \w by the sword| strong="H2719" \w*; [and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*. 
\p
\v 7 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Behold, I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w upon Tyrus| strong="H6865" \w* \w Nebuchadrezzar| strong="H5019" \w* \w king| strong="H4428" \w* \w of Babylon| strong="H894" \w*, \w a king| strong="H4428" \w* \w of kings| strong="H4428" \w*, \w from the north| strong="H6828" \w*, \w with horses| strong="H5483" \w*, \w and with chariots| strong="H7393" \w*, \w and with horsemen| strong="H6571" \w*, \w and companies| strong="H6951" \w*, \w and much| strong="H7227" \w* \w people| strong="H5971" \w*. 
\v 8 [He shall slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the sword| strong="H2719" \w* \w thy daughters| strong="H1323" \w* \w in the field| strong="H7704" \w*: [and he shall make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w a fort| strong="H1785" \w* [against thee, and cast]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8804”} \w a mount| strong="H5550" \w* [against thee, and lift up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} \w the buckler| strong="H6793" \w* against thee.\f + \fr 26:8 \ft cast…: or, pour out the engine of shot \f* 
\v 9 [And he shall set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w engines| strong="H4239" \w* \w of war| strong="H6904" \w* \w against thy walls| strong="H2346" \w*, \w and with his axes| strong="H2719" \w* [he shall break down]{strong=“H5422” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy towers| strong="H4026" \w*. 
\v 10 \w By reason of the abundance| strong="H8229" \w* \w of his horses| strong="H5483" \w* \w their dust| strong="H80" \w* [shall cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} [thee: thy walls]{strong=“H2346”} [shall shake]{strong=“H7493” x-morph=“strongMorph: \sc Th\sc*8799”} \w at the noise| strong="H6963" \w* \w of the horsemen| strong="H6571" \w*, \w and of the wheels| strong="H1534" \w*, \w and of the chariots| strong="H7393" \w*, [when he shall enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w into thy gates| strong="H8179" \w*, \w as men enter| strong="H3996" \w* \w into a city| strong="H5892" \w* [wherein is made a breach]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8794”}.\f + \fr 26:10 \ft as men…: Heb. according to the enterings of a city broken up \f* 
\v 11 \w With the hoofs| strong="H6541" \w* \w of his horses| strong="H5483" \w* [shall he tread down]{strong=“H7429” x-morph=“strongMorph: \sc Th\sc*8799”} \w all thy streets| strong="H2351" \w*: [he shall slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy people| strong="H5971" \w* \w by the sword| strong="H2719" \w*, \w and thy strong| strong="H5797" \w* \w garrisons| strong="H4676" \w* [shall go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the ground| strong="H776" \w*. 
\v 12 [And they shall make a spoil]{strong=“H7997” x-morph=“strongMorph: \sc Th\sc*8804”} \w of thy riches| strong="H2428" \w*, [and make a prey]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8804”} \w of thy merchandise| strong="H7404" \w*: [and they shall break down]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy walls| strong="H2346" \w*, [and destroy]{strong=“H5422” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy pleasant| strong="H2532" \w* \w houses| strong="H1004" \w*: [and they shall lay]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy stones| strong="H68" \w* \w and thy timber| strong="H6086" \w* \w and thy dust| strong="H6083" \w* \w in the midst| strong="H8432" \w* \w of the water| strong="H4325" \w*.\f + \fr 26:12 \ft thy pleasant…: Heb. houses of thy desire \f* 
\v 13 \w And I will cause the noise| strong="H1995" \w* \w of thy songs| strong="H7892" \w* [to cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8689”}; \w and the sound| strong="H6963" \w* \w of thy harps| strong="H3658" \w* [shall be no more heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 14 [And I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee like the top| strong="H6706" \w* \w of a rock| strong="H5553" \w*: thou shalt be a place \w to spread| strong="H4894" \w* \w nets| strong="H2764" \w* \w upon| strong="H4894" \w*; [thou shalt be built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8735”} no more: for I the \sc Lord\sc* [have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\p
\v 15 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc* \w to Tyrus| strong="H6865" \w*; \w Shall not the isles| strong="H339" \w* [shake]{strong=“H7493” x-morph=“strongMorph: \sc Th\sc*8799”} \w at the sound| strong="H6963" \w* \w of thy fall| strong="H4658" \w*, \w when the wounded| strong="H2491" \w* [cry]{strong=“H602” x-morph=“strongMorph: \sc Th\sc*8800”}, \w when the slaughter| strong="H2027" \w* [is made]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8736”} \w in the midst| strong="H8432" \w* of thee? 
\v 16 \w Then all the princes| strong="H5387" \w* \w of the sea| strong="H3220" \w* [shall come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} \w from their thrones| strong="H3678" \w*, [and lay away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8689”} \w their robes| strong="H4598" \w*, [and put off]{strong=“H6584” x-morph=“strongMorph: \sc Th\sc*8799”} \w their broidered| strong="H7553" \w* \w garments| strong="H899" \w*: [they shall clothe]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w themselves with trembling| strong="H2731" \w*; [they shall sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the ground| strong="H776" \w*, [and shall tremble]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8804”} at every \w moment| strong="H7281" \w*, [and be astonished]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8804”} at thee.\f + \fr 26:16 \ft trembling: Heb. tremblings \f* 
\v 17 [And they shall take up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w a lamentation| strong="H7015" \w* [for thee, and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [to thee, How art thou destroyed]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”}, that wast [inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8737”} \w of seafaring men| strong="H3220" \w*, [the renowned]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8794”} \w city| strong="H5892" \w*, \w which wast strong| strong="H2389" \w* \w in the sea| strong="H3220" \w*, [she and her inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”}, [which cause]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w their terror| strong="H2851" \w* to be [on all that haunt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} it!\f + \fr 26:17 \ft of…: Heb. of the seas \f* 
\v 18 \w Now shall the isles| strong="H339" \w* [tremble]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the day| strong="H3117" \w* \w of thy fall| strong="H4658" \w*; [yea, the isles]{strong=“H339”} that are \w in the sea| strong="H3220" \w* [shall be troubled]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8738”} [at thy departure]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 19 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [When I shall make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} [thee a desolate]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8737”} \w city| strong="H5892" \w*, \w like the cities| strong="H5892" \w* [that are not inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8738”}; [when I shall bring up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8687”} \w the deep| strong="H8415" \w* [upon thee, and great]{strong=“H7227”} \w waters| strong="H4325" \w* [shall cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”} thee; 
\v 20 [When I shall bring thee down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8689”} [with them that descend]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w into the pit| strong="H953" \w*, \w with the people| strong="H5971" \w* \w of old time| strong="H5769" \w*, [and shall set]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee in the low parts| strong="H8482" \w* \w of the earth| strong="H776" \w*, \w in places desolate| strong="H2723" \w* \w of old| strong="H5769" \w*, [with them that go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the pit| strong="H953" \w*, [that thou be not inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”}; [and I shall set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w glory| strong="H6643" \w* \w in the land| strong="H776" \w* \w of the living| strong="H2416" \w*; 
\v 21 [I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee a terror| strong="H1091" \w*, and thou shalt be no more: [though thou be sought for]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8792”}, \w yet shalt thou never| strong="H5769" \w* [be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”} [again, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*.\f + \fr 26:21 \ft a terror: Heb. terrors \f*
\c 27
\p 
\v 1 \w The word| strong="H1697" \w* of the \sc Lord\sc* [came again unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Now, thou son]{strong=“H1121”} \w of man| strong="H120" \w*, [take up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w a lamentation| strong="H7015" \w* \w for Tyrus| strong="H6865" \w*; 
\v 3 [And say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto Tyrus| strong="H6865" \w*, [O thou that art situate]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w at the entry| strong="H3997" \w* \w of the sea| strong="H3220" \w*, which art [a merchant]{strong=“H7402” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the people| strong="H5971" \w* \w for many| strong="H7227" \w* \w isles| strong="H339" \w*, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w O Tyrus| strong="H6865" \w*, [thou hast said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, I am \w of perfect| strong="H3632" \w* \w beauty| strong="H3308" \w*.\f + \fr 27:3 \ft of perfect…: Heb. perfect of beauty \f* 
\v 4 \w Thy borders| strong="H1366" \w* are \w in the midst| strong="H3820" \w* \w of the seas| strong="H3220" \w*, [thy builders]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8802”} [have perfected]{strong=“H3634” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy beauty| strong="H3308" \w*.\f + \fr 27:4 \ft midst: Heb. heart \f* 
\v 5 [They have made]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} all thy ship \w boards| strong="H3871" \w* \w of fir trees| strong="H1265" \w* \w of Senir| strong="H8149" \w*: [they have taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w cedars| strong="H730" \w* \w from Lebanon| strong="H3844" \w* [to make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w masts| strong="H8650" \w* for thee.\f + \fr 27:5 \ft made: Heb. built \f* 
\v 6 Of \w the oaks| strong="H437" \w* \w of Bashan| strong="H1316" \w* [have they made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w thine oars| strong="H4880" \w*; \w the company| strong="H1323" \w* \w of the Ashurites| strong="H839" \w* [have made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy benches| strong="H7175" \w* of \w ivory| strong="H8127" \w*, brought \w out of the isles| strong="H339" \w* \w of Chittim| strong="H3794" \w*.\f + \fr 27:6 \ft the company…: or, they have made thy hatches of ivory well trodden \f* \f + \fr 27:6 \ft company: Heb. daughter \f* 
\v 7 \w Fine linen| strong="H8336" \w* \w with broidered work| strong="H7553" \w* \w from Egypt| strong="H4714" \w* \w was that which thou spreadest forth| strong="H4666" \w* \w to be thy sail| strong="H5251" \w*; \w blue| strong="H8504" \w* \w and purple| strong="H713" \w* \w from the isles| strong="H339" \w* \w of Elishah| strong="H473" \w* \w was that which covered| strong="H4374" \w* thee.\f + \fr 27:7 \ft blue…: or, purple and scarlet \f* 
\v 8 [The inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Zidon| strong="H6721" \w* \w and Arvad| strong="H719" \w* [were thy mariners]{strong=“H7751” x-morph=“strongMorph: \sc Th\sc*8801”}: \w thy wise| strong="H2450" \w* men, \w O Tyrus| strong="H6865" \w*, that [were in thee, were thy pilots]{strong=“H2259”}. 
\v 9 \w The ancients| strong="H2205" \w* \w of Gebal| strong="H1380" \w* \w and the wise| strong="H2450" \w* men [thereof were in thee thy calkers]{strong=“H2388 H919” x-morph=“strongMorph: \sc Th\sc*8688”}: \w all the ships| strong="H591" \w* \w of the sea| strong="H3220" \w* \w with their mariners| strong="H4419" \w* [were in thee to occupy]{strong=“H6148” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy merchandise| strong="H4627" \w*.\f + \fr 27:9 \ft calkers: or, stoppers of chinks: Heb. strengtheners, etc \f* 
\v 10 \w They of Persia| strong="H6539" \w* \w and of Lud| strong="H3865" \w* \w and of Phut| strong="H6316" \w* \w were in thine army| strong="H2428" \w*, \w thy men| strong="H582" \w* \w of war| strong="H4421" \w*: [they hanged]{strong=“H8518” x-morph=“strongMorph: \sc Th\sc*8765”} \w the shield| strong="H4043" \w* \w and helmet| strong="H3553" \w* [in thee; they set forth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy comeliness| strong="H1926" \w*. 
\v 11 \w The men| strong="H1121" \w* \w of Arvad| strong="H719" \w* \w with thine army| strong="H2428" \w* were \w upon thy walls| strong="H2346" \w* \w round about| strong="H5439" \w*, \w and the Gammadims| strong="H1575" \w* \w were in thy towers| strong="H4026" \w*: [they hanged]{strong=“H8518” x-morph=“strongMorph: \sc Th\sc*8765”} \w their shields| strong="H7982" \w* \w upon thy walls| strong="H2346" \w* \w round about| strong="H5439" \w*; \w they have made| strong="H3634" \w* \w thy beauty| strong="H3308" \w* [perfect]{strong=“H3634” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 12 \w Tarshish| strong="H8659" \w* was [thy merchant]{strong=“H5503” x-morph=“strongMorph: \sc Th\sc*8802”} \w by reason of the multitude| strong="H7230" \w* of all kind of \w riches| strong="H1952" \w*; \w with silver| strong="H3701" \w*, \w iron| strong="H1270" \w*, \w tin| strong="H913" \w*, \w and lead| strong="H5777" \w*, [they traded]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thy fairs| strong="H5801" \w*. 
\v 13 \w Javan| strong="H3120" \w*, \w Tubal| strong="H8422" \w*, \w and Meshech| strong="H4902" \w*, they were [thy merchants]{strong=“H7402” x-morph=“strongMorph: \sc Th\sc*8802”}: [they traded]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w the persons| strong="H5315" \w* \w of men| strong="H120" \w* \w and vessels| strong="H3627" \w* \w of brass| strong="H5178" \w* \w in thy market| strong="H4627" \w*.\f + \fr 27:13 \ft market: or, merchandise \f* 
\v 14 \w They of the house| strong="H1004" \w* \w of Togarmah| strong="H8425" \w* [traded]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thy fairs| strong="H5801" \w* \w with horses| strong="H5483" \w* \w and horsemen| strong="H6571" \w* \w and mules| strong="H6505" \w*. 
\v 15 \w The men| strong="H1121" \w* \w of Dedan| strong="H1719" \w* were [thy merchants]{strong=“H7402” x-morph=“strongMorph: \sc Th\sc*8802”}; \w many| strong="H7227" \w* \w isles| strong="H339" \w* were \w the merchandise| strong="H5506" \w* \w of thine hand| strong="H3027" \w*: [they brought]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} thee for \w a present| strong="H814" \w* \w horns| strong="H7161" \w* \w of ivory| strong="H8127" \w* \w and ebony| strong="H1894" \w*. 
\v 16 \w Syria| strong="H758" \w* was [thy merchant]{strong=“H5503” x-morph=“strongMorph: \sc Th\sc*8802”} \w by reason of the multitude| strong="H7230" \w* \w of the wares of thy making| strong="H4639" \w*: [they occupied]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thy fairs| strong="H5801" \w* \w with emeralds| strong="H5306" \w*, \w purple| strong="H713" \w*, \w and broidered work| strong="H7553" \w*, \w and fine linen| strong="H948" \w*, \w and coral| strong="H7215" \w*, \w and agate| strong="H3539" \w*.\f + \fr 27:16 \ft the wares…: Heb. thy works \f* \f + \fr 27:16 \ft agate: or, chrysoprase \f* 
\v 17 \w Judah| strong="H3063" \w*, \w and the land| strong="H776" \w* \w of Israel| strong="H3478" \w*, they were [thy merchants]{strong=“H7402” x-morph=“strongMorph: \sc Th\sc*8802”}: [they traded]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thy market| strong="H4627" \w* \w wheat| strong="H2406" \w* \w of Minnith| strong="H4511" \w*, \w and Pannag| strong="H6436" \w*, \w and honey| strong="H1706" \w*, \w and oil| strong="H8081" \w*, \w and balm| strong="H6875" \w*.\f + \fr 27:17 \ft balm: or, rosin \f* 
\v 18 \w Damascus| strong="H1834" \w* was [thy merchant]{strong=“H5503” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the multitude| strong="H7230" \w* \w of the wares of thy making| strong="H4639" \w*, \w for the multitude| strong="H7230" \w* \w of all riches| strong="H1952" \w*; \w in the wine| strong="H3196" \w* \w of Helbon| strong="H2463" \w*, \w and white| strong="H6713" \w* \w wool| strong="H6785" \w*. 
\v 19 [Dan]{strong=“H1835 H2051” x-morph=“strongMorph: \sc Th\sc*8676”} \w also and Javan| strong="H3120" \w* [going to and fro]{strong=“H235” x-morph=“strongMorph: \sc Th\sc*8794”} [occupied]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thy fairs| strong="H5801" \w*: \w bright| strong="H6219" \w* \w iron| strong="H1270" \w*, \w cassia| strong="H6916" \w*, \w and calamus| strong="H7070" \w*, \w were in thy market| strong="H4627" \w*.\f + \fr 27:19 \ft going…: or, Meuzal \f* 
\v 20 \w Dedan| strong="H1719" \w* was [thy merchant]{strong=“H7402” x-morph=“strongMorph: \sc Th\sc*8802”} \w in precious| strong="H2667" \w* \w clothes| strong="H899" \w* \w for chariots| strong="H7396" \w*.\f + \fr 27:20 \ft precious…: Heb. clothes of freedom \f* 
\v 21 \w Arabia| strong="H6152" \w*, \w and all the princes| strong="H5387" \w* \w of Kedar| strong="H6938" \w*, \w they occupied| strong="H5503" \w* \w with thee| strong="H3027" \w* \w in lambs| strong="H3733" \w*, \w and rams| strong="H352" \w*, \w and goats| strong="H6260" \w*: in these were they [thy merchants]{strong=“H5503” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 27:21 \ft they occupied…: Heb. they were the merchants of thy hand \f* 
