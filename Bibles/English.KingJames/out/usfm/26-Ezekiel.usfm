\v 11 \w But the miry places| strong="H1207" \w* \w thereof and the marishes| strong="H1360" \w* [thereof shall not be healed]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8735”}; [they shall be given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w to salt| strong="H4417" \w*.\f + \fr 47:11 \ft shall not…: or, and that which shall not be healed \f* 
\v 12 \w And by the river| strong="H5158" \w* \w upon the bank| strong="H8193" \w* [thereof, on this side and on that side, shall grow]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w all trees| strong="H6086" \w* \w for meat| strong="H3978" \w*, \w whose leaf| strong="H5929" \w* [shall not fade]{strong=“H5034” x-morph=“strongMorph: \sc Th\sc*8799”}, \w neither shall the fruit| strong="H6529" \w* [thereof be consumed]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8799”}: [it shall bring forth new fruit]{strong=“H1069” x-morph=“strongMorph: \sc Th\sc*8762”} \w according to his months| strong="H2320" \w*, \w because their waters| strong="H4325" \w* [they issued out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the sanctuary| strong="H4720" \w*: \w and the fruit| strong="H6529" \w* \w thereof shall be for meat| strong="H3978" \w*, \w and the leaf| strong="H5929" \w* \w thereof for medicine| strong="H8644" \w*.\f + \fr 47:12 \ft shall grow: Heb. shall come up \f* \f + \fr 47:12 \ft new: or, principal \f* \f + \fr 47:12 \ft for medicine: or, for bruises and sores \f* 
\p
\v 13 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w This| strong="H1454" \w* shall be \w the border| strong="H1366" \w*, [whereby ye shall inherit]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8691”} \w the land| strong="H776" \w* [according to the twelve]{strong=“H6240 H8147”} \w tribes| strong="H7626" \w* \w of Israel| strong="H3478" \w*: \w Joseph| strong="H3130" \w* shall have two \w portions| strong="H2256" \w*. 
\v 14 [And ye shall inherit]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8804”} [it, one]{strong=“H376”} \w as well as another| strong="H251" \w*: concerning [the which I lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine hand| strong="H3027" \w* [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w it unto your fathers| strong="H1" \w*: \w and this land| strong="H776" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto you for inheritance| strong="H5159" \w*.\f + \fr 47:14 \ft lifted…: or, swore \f* 
