\v 26 [Moreover I will make]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8804”} \w a covenant| strong="H1285" \w* \w of peace| strong="H7965" \w* [with them; it shall be an everlasting]{strong=“H5769”} \w covenant| strong="H1285" \w* [with them: and I will place]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [them, and multiply]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8689”} [them, and will set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w my sanctuary| strong="H4720" \w* \w in the midst| strong="H8432" \w* \w of them for evermore| strong="H5769" \w*. 
\v 27 \w My tabernacle| strong="H4908" \w* [also shall be with them: yea, I will be their God]{strong=“H430”}, \w and they shall be my people| strong="H5971" \w*. 
\v 28 \w And the heathen| strong="H1471" \w* [shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I the \sc Lord\sc* [do sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8764”} \w Israel| strong="H3478" \w*, \w when my sanctuary| strong="H4720" \w* \w shall be in the midst| strong="H8432" \w* \w of them for evermore| strong="H5769" \w*. 
\c 38
\p 
\v 1 \w And the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy face| strong="H6440" \w* \w against Gog| strong="H1463" \w*, \w the land| strong="H776" \w* \w of Magog| strong="H4031" \w*, \w the chief| strong="H7218" \w* \w prince| strong="H5387" \w* \w of Meshech| strong="H4902" \w* \w and Tubal| strong="H8422" \w*, [and prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} against him,\f + \fr 38:2 \ft the chief…: or, prince of the chief \f* 
