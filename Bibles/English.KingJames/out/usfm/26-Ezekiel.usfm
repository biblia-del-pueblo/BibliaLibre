\v 15 Neither will I cause men [to hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8686”} \w in thee the shame| strong="H3639" \w* \w of the heathen| strong="H1471" \w* [any more, neither shalt thou bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w the reproach| strong="H2781" \w* \w of the people| strong="H5971" \w* [any more, neither shalt thou cause thy nations]{strong=“H1471”} [to fall]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8686”} [any more, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\p
\v 16 \w Moreover the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
