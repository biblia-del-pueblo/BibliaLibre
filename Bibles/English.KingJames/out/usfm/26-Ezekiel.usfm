\v 27 \w Thy riches| strong="H1952" \w*, \w and thy fairs| strong="H5801" \w*, \w thy merchandise| strong="H4627" \w*, \w thy mariners| strong="H4419" \w*, \w and thy pilots| strong="H2259" \w*, [thy calkers]{strong=“H2388 H919” x-morph=“strongMorph: \sc Th\sc*8688”}, [and the occupiers]{strong=“H6148” x-morph=“strongMorph: \sc Th\sc*8802”} \w of thy merchandise| strong="H4627" \w*, \w and all thy men| strong="H582" \w* \w of war| strong="H4421" \w*, that are [in thee, and in all thy company]{strong=“H6951”} which is \w in the midst| strong="H8432" \w* [of thee, shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the midst| strong="H3820" \w* \w of the seas| strong="H3220" \w* \w in the day| strong="H3117" \w* \w of thy ruin| strong="H4658" \w*.\f + \fr 27:27 \ft and in…: or, even with all \f* \f + \fr 27:27 \ft midst of the seas: Heb. heart, etc \f* 
\v 28 \w The suburbs| strong="H4054" \w* [shall shake]{strong=“H7493” x-morph=“strongMorph: \sc Th\sc*8799”} \w at the sound| strong="H6963" \w* \w of the cry| strong="H2201" \w* \w of thy pilots| strong="H2259" \w*.\f + \fr 27:28 \ft suburbs: or, waves \f* 
\v 29 [And all that handle]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8802”} \w the oar| strong="H4880" \w*, \w the mariners| strong="H4419" \w*, and \w all the pilots| strong="H2259" \w* \w of the sea| strong="H3220" \w*, [shall come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} \w from their ships| strong="H591" \w*, [they shall stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the land| strong="H776" \w*; 
\v 30 \w And shall cause their voice| strong="H6963" \w* [to be heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8689”} [against thee, and shall cry]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8799”} \w bitterly| strong="H4751" \w*, [and shall cast up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w dust| strong="H6083" \w* \w upon their heads| strong="H7218" \w*, [they shall wallow]{strong=“H6428” x-morph=“strongMorph: \sc Th\sc*8691”} \w themselves in the ashes| strong="H665" \w*: 
\v 31 \w And they shall make themselves utterly| strong="H7144" \w* [bald]{strong=“H7139” x-morph=“strongMorph: \sc Th\sc*8689”} [for thee, and gird]{strong=“H2296” x-morph=“strongMorph: \sc Th\sc*8804”} \w them with sackcloth| strong="H8242" \w*, [and they shall weep]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8804”} \w for thee with bitterness| strong="H4751" \w* \w of heart| strong="H5315" \w* and \w bitter| strong="H4751" \w* \w wailing| strong="H4553" \w*. 
\v 32 \w And in their wailing| strong="H5204" \w* [they shall take up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w a lamentation| strong="H7015" \w* [for thee, and lament]{strong=“H6969” x-morph=“strongMorph: \sc Th\sc*8790”} over thee, saying, What city is \w like Tyrus| strong="H6865" \w*, \w like the destroyed| strong="H1822" \w* \w in the midst| strong="H8432" \w* \w of the sea| strong="H3220" \w*? 
\v 33 \w When thy wares| strong="H5801" \w* [went forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”} \w out of the seas| strong="H3220" \w*, [thou filledst]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8689”} \w many| strong="H7227" \w* \w people| strong="H5971" \w*; [thou didst enrich]{strong=“H6238” x-morph=“strongMorph: \sc Th\sc*8689”} \w the kings| strong="H4428" \w* \w of the earth| strong="H776" \w* \w with the multitude| strong="H7230" \w* \w of thy riches| strong="H1952" \w* \w and of thy merchandise| strong="H4627" \w*. 
