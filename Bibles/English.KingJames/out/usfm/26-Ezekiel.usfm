\c 3
\p 
\v 1 [Moreover he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Son]{strong=“H1121”} \w of man| strong="H120" \w*, [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8798”} [that thou findest]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”}; [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8798”} \w this roll| strong="H4039" \w*, [and go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} [speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w unto the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*. 
\v 2 [So I opened]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} \w my mouth| strong="H6310" \w*, [and he caused me to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8686”} \w that roll| strong="H4039" \w*. 
\v 3 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Son]{strong=“H1121”} \w of man| strong="H120" \w*, \w cause thy belly| strong="H990" \w* [to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8686”}, [and fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy bowels| strong="H4578" \w* \w with this roll| strong="H4039" \w* [that I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} [thee. Then did I eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} it; \w and it was in my mouth| strong="H6310" \w* \w as honey| strong="H1706" \w* \w for sweetness| strong="H4966" \w*. 
\p
\v 4 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Son]{strong=“H1121”} \w of man| strong="H120" \w*, [go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [get]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee unto the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, [and speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w with my words| strong="H1697" \w* unto them. 
\v 5 For thou art [not sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8803”} \w to a people| strong="H5971" \w* \w of a strange| strong="H6012" \w* \w speech| strong="H8193" \w* \w and of an hard| strong="H3515" \w* \w language| strong="H3956" \w*, but \w to the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*;\f + \fr 3:5 \ft of a…: Heb. deep of lip, and heavy of tongue \f* 
\v 6 \w Not to many| strong="H7227" \w* \w people| strong="H5971" \w* \w of a strange| strong="H6012" \w* \w speech| strong="H8193" \w* \w and of an hard| strong="H3515" \w* \w language| strong="H3956" \w*, \w whose words| strong="H1697" \w* [thou canst not understand]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}. [Surely, had I sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [thee to them, they would have hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} unto thee.\f + \fr 3:6 \ft of a…: Heb. deep of lip, and heavy of language \f* \f + \fr 3:6 \ft Surely…: or, If I had sent thee, etc. would they not have hearkened unto thee? \f* 
\v 7 \w But the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* [will]{strong=“H14” x-morph=“strongMorph: \sc Th\sc*8799”} [not hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} [unto thee; for they will]{strong=“H14” x-morph=“strongMorph: \sc Th\sc*8802”} [not hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} [unto me: for all the house]{strong=“H1004”} \w of Israel| strong="H3478" \w* are [impudent]{strong=“H4696 H2389”} [and hardhearted]{strong=“H3820 H7186”}.\f + \fr 3:7 \ft impudent…: Heb. stiff of forehead, and hard of heart \f* 
\v 8 [Behold, I have made]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy face| strong="H6440" \w* \w strong| strong="H2389" \w* \w against| strong="H5980" \w* \w their faces| strong="H6440" \w*, \w and thy forehead| strong="H4696" \w* \w strong| strong="H2389" \w* \w against| strong="H5980" \w* \w their foreheads| strong="H4696" \w*. 
\v 9 \w As an adamant| strong="H8068" \w* \w harder| strong="H2389" \w* \w than flint| strong="H6864" \w* [have I made]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy forehead| strong="H4696" \w*: [fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [them not, neither be dismayed]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8735”} \w at their looks| strong="H6440" \w*, though they be \w a rebellious| strong="H4805" \w* \w house| strong="H1004" \w*. 
\v 10 [Moreover he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Son]{strong=“H1121”} \w of man| strong="H120" \w*, \w all my words| strong="H1697" \w* [that I shall speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [unto thee receive]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w in thine heart| strong="H3824" \w*, [and hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w with thine ears| strong="H241" \w*. 
\v 11 [And go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [get]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee to them of the captivity| strong="H1473" \w*, \w unto the children| strong="H1121" \w* \w of thy people| strong="H5971" \w*, [and speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [unto them, and tell]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [whether they will hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}, [or whether they will forbear]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 12 \w Then the spirit| strong="H7307" \w* [took me up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”}, [and I heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w behind| strong="H310" \w* \w me a voice| strong="H6963" \w* \w of a great| strong="H1419" \w* \w rushing| strong="H7494" \w*, saying, [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} be \w the glory| strong="H3519" \w* of the \sc Lord\sc* \w from his place| strong="H4725" \w*. 
\v 13 I heard \w also the noise| strong="H6963" \w* \w of the wings| strong="H3671" \w* \w of the living creatures| strong="H2416" \w* [that touched]{strong=“H5401” x-morph=“strongMorph: \sc Th\sc*8688”} \w one| strong="H802" \w* \w another| strong="H269" \w*, \w and the noise| strong="H6963" \w* \w of the wheels| strong="H212" \w* \w over against| strong="H5980" \w* [them, and a noise]{strong=“H6963”} \w of a great| strong="H1419" \w* \w rushing| strong="H7494" \w*.\f + \fr 3:13 \ft touched: Heb. kissed \f* 
\v 14 \w So the spirit| strong="H7307" \w* [lifted me up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”}, [and took me away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”}, [and I went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w in bitterness| strong="H4751" \w*, \w in the heat| strong="H2534" \w* \w of my spirit| strong="H7307" \w*; \w but the hand| strong="H3027" \w* of the \sc Lord\sc* [was strong]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8804”} upon me.\f + \fr 3:14 \ft in bitterness: Heb. bitter \f* \f + \fr 3:14 \ft heat: Heb. hot anger \f* 
\p
\v 15 [Then I came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to them of the captivity| strong="H1473" \w* [at Tel-abib]{strong=“H8512”}, [that dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w by the river| strong="H5104" \w* \w of Chebar| strong="H3529" \w*, [and I sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} [where they sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”}, [and remained]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} [there astonished]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8688”} \w among| strong="H8432" \w* \w them seven| strong="H7651" \w* \w days| strong="H3117" \w*. 
\p
\v 16 \w And it came to pass at the end| strong="H7097" \w* \w of seven| strong="H7651" \w* \w days| strong="H3117" \w*, \w that the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 17 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [I have made]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [thee a watchman]{strong=“H6822” x-morph=“strongMorph: \sc Th\sc*8802”} \w unto the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*: [therefore hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the word| strong="H1697" \w* \w at my mouth| strong="H6310" \w*, [and give them warning]{strong=“H2094” x-morph=“strongMorph: \sc Th\sc*8689”} from me. 
\v 18 [When I say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto the wicked| strong="H7563" \w*, [Thou shalt surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}; [and thou givest him not warning]{strong=“H2094” x-morph=“strongMorph: \sc Th\sc*8689”}, [nor speakest]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [to warn]{strong=“H2094” x-morph=“strongMorph: \sc Th\sc*8687”} \w the wicked| strong="H7563" \w* \w from his wicked| strong="H7563" \w* \w way| strong="H1870" \w*, [to save his life]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8763”}; \w the same wicked| strong="H7563" \w* man [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his iniquity| strong="H5771" \w*; \w but his blood| strong="H1818" \w* [will I require]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w at thine hand| strong="H3027" \w*. 
\v 19 [Yet if thou warn]{strong=“H2094” x-morph=“strongMorph: \sc Th\sc*8689”} \w the wicked| strong="H7563" \w*, [and he turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w not from his wickedness| strong="H7562" \w*, \w nor from his wicked| strong="H7563" \w* \w way| strong="H1870" \w*, [he shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his iniquity| strong="H5771" \w*; [but thou hast delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy soul| strong="H5315" \w*. 
\v 20 \w Again| strong="H7725" \w*, \w When a righteous| strong="H6662" \w* man [doth turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w from his righteousness| strong="H6664" \w*, [and commit]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w iniquity| strong="H5766" \w*, [and I lay]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w a stumblingblock| strong="H4383" \w* \w before| strong="H6440" \w* [him, he shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}: [because thou hast not given him warning]{strong=“H2094” x-morph=“strongMorph: \sc Th\sc*8689”}, [he shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his sin| strong="H2403" \w*, \w and his righteousness| strong="H6666" \w* [which he hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [shall not be remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8735”}; \w but his blood| strong="H1818" \w* [will I require]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w at thine hand| strong="H3027" \w*.\f + \fr 3:20 \ft righteousness which: Heb. righteousnesses \f* 
\v 21 [Nevertheless if thou warn]{strong=“H2094” x-morph=“strongMorph: \sc Th\sc*8689”} \w the righteous| strong="H6662" \w* man, \w that the righteous| strong="H6662" \w* [sin]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8800”} [not, and he doth not sin]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}, [he shall surely]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8800”} [live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}, [because he is warned]{strong=“H2094” x-morph=“strongMorph: \sc Th\sc*8737”}; [also thou hast delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy soul| strong="H5315" \w*. 
\p
\v 22 \w And the hand| strong="H3027" \w* of the \sc Lord\sc* [was there upon me; and he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8798”} \w into the plain| strong="H1237" \w*, [and I will there talk]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} with thee. 
\v 23 [Then I arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and went forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the plain| strong="H1237" \w*: [and, behold, the glory]{strong=“H3519”} of the \sc Lord\sc* [stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} [there, as the glory]{strong=“H3519”} [which I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w by the river| strong="H5104" \w* \w of Chebar| strong="H3529" \w*: [and I fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w on my face| strong="H6440" \w*. 
\v 24 \w Then the spirit| strong="H7307" \w* [entered]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [into me, and set]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8686”} \w me upon my feet| strong="H7272" \w*, [and spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [with me, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”}, [shut]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8734”} \w thyself within| strong="H8432" \w* \w thine house| strong="H1004" \w*. 
\v 25 [But thou, O son]{strong=“H1121”} \w of man| strong="H120" \w*, [behold, they shall put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w bands| strong="H5688" \w* [upon thee, and shall bind]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8804”} [thee with them, and thou shalt not go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w among| strong="H8432" \w* them: 
\v 26 \w And I will make thy tongue| strong="H3956" \w* [cleave]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8686”} \w to the roof of thy mouth| strong="H2441" \w*, [that thou shalt be dumb]{strong=“H481” x-morph=“strongMorph: \sc Th\sc*8738”}, [and shalt not be to them a reprover]{strong=“H3198 H376” x-morph=“strongMorph: \sc Th\sc*8688”}: for they are \w a rebellious| strong="H4805" \w* \w house| strong="H1004" \w*.\f + \fr 3:26 \ft a reprover: Heb. a man reproving \f* 
\v 27 [But when I speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w with| strong="H854" \w* [thee, I will open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy mouth| strong="H6310" \w*, [and thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [He that heareth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”}, [let him hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}; \w and he that forbeareth| strong="H2310" \w*, [let him forbear]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8799”}: for they are \w a rebellious| strong="H4805" \w* \w house| strong="H1004" \w*.
\c 4
\p 
\v 1 [Thou also, son]{strong=“H1121”} \w of man| strong="H120" \w*, [take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee a tile| strong="H3843" \w*, [and lay]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w it before| strong="H6440" \w* [thee, and pourtray]{strong=“H2710” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon it the city| strong="H5892" \w*, even \w Jerusalem| strong="H3389" \w*: 
\v 2 [And lay]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w siege| strong="H4692" \w* [against it, and build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w a fort| strong="H1785" \w* [against it, and cast]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8804”} \w a mount| strong="H5550" \w* [against it; set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w the camp| strong="H4264" \w* [also against it, and set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} battering \w rams| strong="H3733" \w* \w against it round about| strong="H5439" \w*.\f + \fr 4:2 \ft battering…: chief leaders \f* 
\v 3 [Moreover take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou unto thee an iron| strong="H1270" \w* \w pan| strong="H4227" \w*, [and set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} it for \w a wall| strong="H7023" \w* \w of iron| strong="H1270" \w* \w between thee and the city| strong="H5892" \w*: [and set]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy face| strong="H6440" \w* [against it, and it shall be besieged]{strong=“H4692”}, [and thou shalt lay siege]{strong=“H6696” x-morph=“strongMorph: \sc Th\sc*8804”} against it. This shall be \w a sign| strong="H226" \w* \w to the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*.\f + \fr 4:3 \ft an…: or, a flat plate, or, slice \f* 
\v 4 [Lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou also upon thy left| strong="H8042" \w* \w side| strong="H6654" \w*, [and lay]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w the iniquity| strong="H5771" \w* \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* upon it: according \w to the number| strong="H4557" \w* \w of the days| strong="H3117" \w* [that thou shalt lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} [upon it thou shalt bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their iniquity| strong="H5771" \w*. 
\v 5 [For I have laid]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon thee the years| strong="H8141" \w* \w of their iniquity| strong="H5771" \w*, \w according to the number| strong="H4557" \w* \w of the days| strong="H3117" \w*, \w three| strong="H7969" \w* \w hundred| strong="H3967" \w* \w and ninety| strong="H8673" \w* \w days| strong="H3117" \w*: [so shalt thou bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w the iniquity| strong="H5771" \w* \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*. 
\v 6 [And when thou hast accomplished]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8765”} \w them| strong="H428" \w*, [lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8804”} \w again| strong="H8145" \w* [on thy right]{strong=“H3227 H3233” x-morph=“strongMorph: \sc Th\sc*8675”} \w side| strong="H6654" \w*, [and thou shalt bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w the iniquity| strong="H5771" \w* \w of the house| strong="H1004" \w* \w of Judah| strong="H3063" \w* \w forty| strong="H705" \w* \w days| strong="H3117" \w*: [I have appointed]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [thee each day]{strong=“H3117 H3117”} [for a year]{strong=“H8141 H8141”}.\f + \fr 4:6 \ft each…: Heb. a day for a year, a day for a year \f* 
\v 7 [Therefore thou shalt set]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy face| strong="H6440" \w* \w toward the siege| strong="H4692" \w* \w of Jerusalem| strong="H3389" \w*, \w and thine arm| strong="H2220" \w* shall be [uncovered]{strong=“H2834” x-morph=“strongMorph: \sc Th\sc*8803”}, [and thou shalt prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8738”} against it. 
\v 8 [And, behold, I will lay]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w bands| strong="H5688" \w* [upon thee, and thou shalt not turn]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8735”} \w thee from one side| strong="H6654" \w* \w to another| strong="H6654" \w*, [till thou hast ended]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8763”} \w the days| strong="H3117" \w* \w of thy siege| strong="H4692" \w*.\f + \fr 4:8 \ft from one…: Heb. from thy side to thy side \f* 
\p
\v 9 [Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou also unto thee wheat| strong="H2406" \w*, \w and barley| strong="H8184" \w*, \w and beans| strong="H6321" \w*, \w and lentiles| strong="H5742" \w*, \w and millet| strong="H1764" \w*, \w and fitches| strong="H3698" \w*, [and put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w them in one| strong="H259" \w* \w vessel| strong="H3627" \w*, [and make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee bread| strong="H3899" \w* thereof, according \w to the number| strong="H4557" \w* \w of the days| strong="H3117" \w* [that thou shalt lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon thy side| strong="H6654" \w*, \w three| strong="H7969" \w* \w hundred| strong="H3967" \w* \w and ninety| strong="H8673" \w* \w days| strong="H3117" \w* [shalt thou eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} thereof.\f + \fr 4:9 \ft fitches: or, spelt \f* 
\v 10 \w And thy meat| strong="H3978" \w* [which thou shalt eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} shall be \w by weight| strong="H4946" \w*, \w twenty| strong="H6242" \w* \w shekels| strong="H8255" \w* \w a day| strong="H3117" \w*: \w from time| strong="H6256" \w* \w to time| strong="H6256" \w* [shalt thou eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\v 11 [Thou shalt drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w also water| strong="H4325" \w* \w by measure| strong="H4884" \w*, \w the sixth part| strong="H8345" \w* \w of an hin| strong="H1969" \w*: \w from time| strong="H6256" \w* \w to time| strong="H6256" \w* [shalt thou drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 12 [And thou shalt eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} it as \w barley| strong="H8184" \w* \w cakes| strong="H5692" \w*, [and thou shalt bake]{strong=“H5746” x-morph=“strongMorph: \sc Th\sc*8799”} \w it with dung| strong="H1561" \w* \w that cometh out| strong="H6627" \w* \w of man| strong="H120" \w*, \w in their sight| strong="H5869" \w*. 
\v 13 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Even thus shall the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w their defiled| strong="H2931" \w* \w bread| strong="H3899" \w* \w among the Gentiles| strong="H1471" \w*, [whither I will drive]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8686”} them. 
\v 14 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [I, Ah]{strong=“H162”} \w Lord| strong="H136" \w* \sc God\sc*! [behold, my soul]{strong=“H5315”} [hath not been polluted]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8794”}: \w for from my youth| strong="H5271" \w* [up even till now have I not eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w of that which dieth of itself| strong="H5038" \w*, \w or is torn in pieces| strong="H2966" \w*; [neither came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w there abominable| strong="H6292" \w* \w flesh| strong="H1320" \w* \w into my mouth| strong="H6310" \w*. 
\v 15 [Then he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Lo]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}, [I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [thee cow’s]{strong=“H1241”} [dung ]{strong=“H6832 H6832” x-morph=“strongMorph: \sc Th\sc*8675”} [for man’s]{strong=“H120”} \w dung| strong="H1561" \w*, [and thou shalt prepare]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy bread| strong="H3899" \w* therewith. 
\v 16 [Moreover he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Son]{strong=“H1121”} \w of man| strong="H120" \w*, [behold, I will break]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8799”} \w the staff| strong="H4294" \w* \w of bread| strong="H3899" \w* \w in Jerusalem| strong="H3389" \w*: [and they shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w bread| strong="H3899" \w* \w by weight| strong="H4948" \w*, \w and with care| strong="H1674" \w*; [and they shall drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w water| strong="H4325" \w* \w by measure| strong="H4884" \w*, \w and with astonishment| strong="H8078" \w*: 
\v 17 [That they may want]{strong=“H2637” x-morph=“strongMorph: \sc Th\sc*8799”} \w bread| strong="H3899" \w* \w and water| strong="H4325" \w*, [and be astonied]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8738”} \w one| strong="H376" \w* \w with another| strong="H251" \w*, [and consume away]{strong=“H4743” x-morph=“strongMorph: \sc Th\sc*8738”} \w for their iniquity| strong="H5771" \w*.
\c 5
\p 
\v 1 [And thou, son]{strong=“H1121”} \w of man| strong="H120" \w*, [take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee a sharp| strong="H2299" \w* \w knife| strong="H2719" \w*, [take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [thee a barber’s]{strong=“H1532”} \w razor| strong="H8593" \w*, and cause it [to pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8689”} \w upon thine head| strong="H7218" \w* \w and upon thy beard| strong="H2206" \w*: [then take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee balances| strong="H3976" \w* \w to weigh| strong="H4948" \w*, [and divide]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8765”} the hair. 
\v 2 [Thou shalt burn]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8686”} \w with fire| strong="H217" \w* \w a third part| strong="H7992" \w* \w in the midst| strong="H8432" \w* \w of the city| strong="H5892" \w*, \w when the days| strong="H3117" \w* \w of the siege| strong="H4692" \w* [are fulfilled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8800”}: [and thou shalt take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w a third part| strong="H7992" \w*, and [smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w about| strong="H5439" \w* \w it with a knife| strong="H2719" \w*: \w and a third part| strong="H7992" \w* [thou shalt scatter]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the wind| strong="H7307" \w*; [and I will draw out]{strong=“H7324” x-morph=“strongMorph: \sc Th\sc*8686”} \w a sword| strong="H2719" \w* \w after| strong="H310" \w* them. 
\v 3 [Thou shalt also take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w thereof a few| strong="H4592" \w* \w in number| strong="H4557" \w*, [and bind]{strong=“H6696” x-morph=“strongMorph: \sc Th\sc*8804”} \w them in thy skirts| strong="H3671" \w*.\f + \fr 5:3 \ft skirts: Heb. wings \f* 
\v 4 [Then take of them again]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”}, [and cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8689”} \w them into the midst| strong="H8432" \w* \w of the fire| strong="H784" \w*, [and burn]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8804”} \w them in the fire| strong="H784" \w*; for \w thereof shall a fire| strong="H784" \w* [come forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w into all the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*. 
\p
\v 5 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; This is \w Jerusalem| strong="H3389" \w*: [I have set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w it in the midst| strong="H8432" \w* \w of the nations| strong="H1471" \w* \w and countries| strong="H776" \w* that are \w round about| strong="H5439" \w* her. 
\v 6 [And she hath changed]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8686”} \w my judgments| strong="H4941" \w* \w into wickedness| strong="H7564" \w* \w more than the nations| strong="H1471" \w*, \w and my statutes| strong="H2708" \w* \w more than the countries| strong="H776" \w* that are \w round about| strong="H5439" \w* [her: for they have refused]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} \w my judgments| strong="H4941" \w* \w and my statutes| strong="H2708" \w*, [they have not walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} in them. 
\v 7 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Because ye multiplied]{strong=“H1995” x-morph=“strongMorph: \sc Th\sc*8800”} \w more than the nations| strong="H1471" \w* that are \w round about| strong="H5439" \w* you, and [have not walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w in my statutes| strong="H2708" \w*, [neither have kept]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w my judgments| strong="H4941" \w*, [neither have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w according to the judgments| strong="H4941" \w* \w of the nations| strong="H1471" \w* that are \w round about| strong="H5439" \w* you; 
\v 8 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; Behold, I, even I, am [against thee, and will execute]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w judgments| strong="H4941" \w* \w in the midst| strong="H8432" \w* \w of thee in the sight| strong="H5869" \w* \w of the nations| strong="H1471" \w*. 
\v 9 [And I will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [in thee that which I have not done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [and whereunto I will not do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [any more the like, because]{strong=“H3282”} \w of all thine abominations| strong="H8441" \w*. 
\v 10 \w Therefore the fathers| strong="H1" \w* [shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the sons| strong="H1121" \w* \w in the midst| strong="H8432" \w* [of thee, and the sons]{strong=“H1121”} [shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w their fathers| strong="H1" \w*; [and I will execute]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w judgments| strong="H8201" \w* [in thee, and the whole remnant]{strong=“H7611”} [of thee will I scatter]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8765”} \w into all the winds| strong="H7307" \w*. 
\v 11 Wherefore, as \w I live| strong="H2416" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*; [Surely, because thou hast defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8765”} \w my sanctuary| strong="H4720" \w* \w with all thy detestable things| strong="H8251" \w*, \w and with all thine abominations| strong="H8441" \w*, [therefore will I also diminish]{strong=“H1639” x-morph=“strongMorph: \sc Th\sc*8799”} thee; \w neither shall mine eye| strong="H5869" \w* [spare]{strong=“H2347” x-morph=“strongMorph: \sc Th\sc*8799”}, [neither will I have any pity]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 12 \w A third part| strong="H7992" \w* [of thee shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the pestilence| strong="H1698" \w*, \w and with famine| strong="H7458" \w* [shall they be consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the midst| strong="H8432" \w* [of thee: and a third part]{strong=“H7992”} [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w* \w round about| strong="H5439" \w* [thee; and I will scatter]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8762”} \w a third part| strong="H7992" \w* \w into all the winds| strong="H7307" \w*, [and I will draw out]{strong=“H7324” x-morph=“strongMorph: \sc Th\sc*8686”} \w a sword| strong="H2719" \w* \w after| strong="H310" \w* them. 
\v 13 \w Thus shall mine anger| strong="H639" \w* [be accomplished]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and I will cause my fury| strong="H2534" \w* [to rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8689”} [upon them, and I will be comforted]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8694”}: [and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I the \sc Lord\sc* [have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it \w in my zeal| strong="H7068" \w*, [when I have accomplished]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8763”} \w my fury| strong="H2534" \w* in them. 
\v 14 [Moreover I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee waste| strong="H2723" \w*, \w and a reproach| strong="H2781" \w* \w among the nations| strong="H1471" \w* that are \w round about| strong="H5439" \w* [thee, in the sight]{strong=“H5869”} [of all that pass by]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 15 \w So it shall be a reproach| strong="H2781" \w* \w and a taunt| strong="H1422" \w*, \w an instruction| strong="H4148" \w* \w and an astonishment| strong="H4923" \w* \w unto the nations| strong="H1471" \w* that are \w round about| strong="H5439" \w* [thee, when I shall execute]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w judgments| strong="H8201" \w* \w in thee in anger| strong="H639" \w* \w and in fury| strong="H2534" \w* \w and in furious| strong="H2534" \w* \w rebukes| strong="H8433" \w*. I the \sc Lord\sc* [have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it. 
\v 16 [When I shall send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w upon them the evil| strong="H7451" \w* \w arrows| strong="H2671" \w* \w of famine| strong="H7458" \w*, which shall be for their \w destruction| strong="H4889" \w*, and [which I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8763”} [to destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8763”} [you: and I will increase]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w the famine| strong="H7458" \w* [upon you, and will break]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8804”} \w your staff| strong="H4294" \w* \w of bread| strong="H3899" \w*: 
\v 17 [So will I send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w upon you famine| strong="H7458" \w* \w and evil| strong="H7451" \w* \w beasts| strong="H2416" \w*, [and they shall bereave]{strong=“H7921” x-morph=“strongMorph: \sc Th\sc*8765”} [thee; and pestilence]{strong=“H1698”} \w and blood| strong="H1818" \w* [shall pass through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} [thee; and I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w the sword| strong="H2719" \w* upon thee. I the \sc Lord\sc* [have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it. 
\c 6
\p 
\v 1 \w And the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy face| strong="H6440" \w* \w toward the mountains| strong="H2022" \w* \w of Israel| strong="H3478" \w*, [and prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} against them, 
\v 3 [And say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Ye mountains| strong="H2022" \w* \w of Israel| strong="H3478" \w*, [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* \w of the Lord| strong="H136" \w* \sc God\sc*; [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc* \w to the mountains| strong="H2022" \w*, \w and to the hills| strong="H1389" \w*, \w to the rivers| strong="H650" \w*, \w and to the valleys| strong="H1516" \w*; Behold, I, even [I, will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w a sword| strong="H2719" \w* [upon you, and I will destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8765”} \w your high places| strong="H1116" \w*. 
\v 4 \w And your altars| strong="H4196" \w* [shall be desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and your images| strong="H2553" \w* [shall be broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8738”}: [and I will cast down]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8689”} \w your slain| strong="H2491" \w* men \w before| strong="H6440" \w* \w your idols| strong="H1544" \w*.\f + \fr 6:4 \ft images: or, sun images \f* 
\v 5 [And I will lay]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w the dead carcases| strong="H6297" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* \w before| strong="H6440" \w* \w their idols| strong="H1544" \w*; [and I will scatter]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8765”} \w your bones| strong="H6106" \w* \w round about| strong="H5439" \w* \w your altars| strong="H4196" \w*.\f + \fr 6:5 \ft lay: Heb. give \f* 
\v 6 \w In all your dwellingplaces| strong="H4186" \w* \w the cities| strong="H5892" \w* [shall be laid waste]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the high places| strong="H1116" \w* [shall be desolate]{strong=“H3456” x-morph=“strongMorph: \sc Th\sc*8799”}; \w that your altars| strong="H4196" \w* [may be laid waste]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8799”} [and made desolate]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and your idols| strong="H1544" \w* [may be broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8738”} [and cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and your images| strong="H2553" \w* [may be cut down]{strong=“H1438” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and your works| strong="H4639" \w* [may be abolished]{strong=“H4229” x-morph=“strongMorph: \sc Th\sc*8738”}.\f + \fr 6:6 \ft images: or, sun images \f* 
\v 7 \w And the slain| strong="H2491" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the midst| strong="H8432" \w* [of you, and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*. 
\p
\v 8 [Yet will I leave a remnant]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8689”}, that ye may have some \w that shall escape| strong="H6412" \w* \w the sword| strong="H2719" \w* \w among the nations| strong="H1471" \w*, [when ye shall be scattered]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8736”} \w through the countries| strong="H776" \w*. 
\v 9 \w And they that escape| strong="H6412" \w* [of you shall remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w me among the nations| strong="H1471" \w* [whither they shall be carried captives]{strong=“H7617” x-morph=“strongMorph: \sc Th\sc*8738”}, [because I am broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8738”} [with their whorish]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”} \w heart| strong="H3820" \w*, [which hath departed]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8804”} [from me, and with their eyes]{strong=“H5869”}, [which go a whoring]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”} \w after| strong="H310" \w* \w their idols| strong="H1544" \w*: [and they shall lothe]{strong=“H6962” x-morph=“strongMorph: \sc Th\sc*8738”} \w themselves| strong="H6440" \w* \w for the evils| strong="H7451" \w* [which they have committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w in all their abominations| strong="H8441" \w*. 
\v 10 [And they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*, and that [I have not said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w in vain| strong="H2600" \w* [that I would do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w this evil| strong="H7451" \w* unto them. 
\p
\v 11 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8685”} \w with thine hand| strong="H3709" \w*, [and stamp]{strong=“H7554” x-morph=“strongMorph: \sc Th\sc*8798”} \w with thy foot| strong="H7272" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”}, \w Alas| strong="H253" \w* \w for all the evil| strong="H7451" \w* \w abominations| strong="H8441" \w* \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*! [for they shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w*, \w by the famine| strong="H7458" \w*, \w and by the pestilence| strong="H1698" \w*. 
\v 12 \w He that is far off| strong="H7350" \w* [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the pestilence| strong="H1698" \w*; \w and he that is near| strong="H7138" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w*; [and he that remaineth]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”} [and is besieged]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8803”} [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the famine| strong="H7458" \w*: [thus will I accomplish]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8765”} \w my fury| strong="H2534" \w* upon them. 
\v 13 [Then shall ye know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*, \w when their slain| strong="H2491" \w* men \w shall be among| strong="H8432" \w* \w their idols| strong="H1544" \w* \w round about| strong="H5439" \w* \w their altars| strong="H4196" \w*, [upon every high]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8802”} \w hill| strong="H1389" \w*, \w in all the tops| strong="H7218" \w* \w of the mountains| strong="H2022" \w*, \w and under every green| strong="H7488" \w* \w tree| strong="H6086" \w*, \w and under every thick| strong="H5687" \w* \w oak| strong="H424" \w*, \w the place| strong="H4725" \w* [where they did offer]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w sweet| strong="H5207" \w* \w savour| strong="H7381" \w* \w to all their idols| strong="H1544" \w*. 
\v 14 [So will I stretch out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} \w my hand| strong="H3027" \w* [upon them, and make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w the land| strong="H776" \w* \w desolate| strong="H8077" \w*, [yea, more desolate]{strong=“H4923”} \w than the wilderness| strong="H4057" \w* \w toward Diblath| strong="H1689" \w*, \w in all their habitations| strong="H4186" \w*: [and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*.\f + \fr 6:14 \ft more…: or, desolate from the wilderness \f*
\c 7
\p 
\v 1 \w Moreover the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Also, thou son]{strong=“H1121”} \w of man| strong="H120" \w*, [thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc* \w unto the land| strong="H127" \w* \w of Israel| strong="H3478" \w*; \w An end| strong="H7093" \w*, \w the end| strong="H7093" \w* [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon the four| strong="H702" \w* \w corners| strong="H3671" \w* \w of the land| strong="H776" \w*. 
\v 3 Now is \w the end| strong="H7093" \w* come [upon thee, and I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w mine anger| strong="H639" \w* [upon thee, and will judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee according to thy ways| strong="H1870" \w*, [and will recompense]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon thee all thine abominations| strong="H8441" \w*.\f + \fr 7:3 \ft recompense: Heb. give \f* 
\v 4 \w And mine eye| strong="H5869" \w* [shall not spare]{strong=“H2347” x-morph=“strongMorph: \sc Th\sc*8799”} [thee, neither will I have pity]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”}: [but I will recompense]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy ways| strong="H1870" \w* [upon thee, and thine abominations]{strong=“H8441”} \w shall be in the midst| strong="H8432" \w* [of thee: and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*. 
\v 5 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w An evil| strong="H7451" \w*, \w an only| strong="H259" \w* \w evil| strong="H7451" \w*, [behold, is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 6 \w An end| strong="H7093" \w* [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the end| strong="H7093" \w* [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}: [it watcheth]{strong=“H6974” x-morph=“strongMorph: \sc Th\sc*8689”} [for thee; behold, it is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 7:6 \ft watcheth for: Heb. awaketh against \f* 
\v 7 \w The morning| strong="H6843" \w* [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [unto thee, O thou that dwellest]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the land| strong="H776" \w*: \w the time| strong="H6256" \w* [is come]{strong=“H935 H935” x-morph=“strongMorph: \sc Th\sc*8802 strongMorph: \sc Th\sc*8676 strongMorph: \sc Th\sc*8804”}, \w the day| strong="H3117" \w* \w of trouble| strong="H4103" \w* is \w near| strong="H7138" \w*, \w and not the sounding again| strong="H1906" \w* \w of the mountains| strong="H2022" \w*.\f + \fr 7:7 \ft sounding…: or, echo \f* 
\v 8 \w Now will I shortly| strong="H7138" \w* [pour out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8799”} \w my fury| strong="H2534" \w* [upon thee, and accomplish]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8765”} \w mine anger| strong="H639" \w* [upon thee: and I will judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee according to thy ways| strong="H1870" \w*, [and will recompense]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee for all thine abominations| strong="H8441" \w*. 
\v 9 \w And mine eye| strong="H5869" \w* [shall not spare]{strong=“H2347” x-morph=“strongMorph: \sc Th\sc*8799”}, [neither will I have pity]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”}: [I will recompense]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee according to thy ways| strong="H1870" \w* \w and thine abominations| strong="H8441" \w* that \w are in the midst| strong="H8432" \w* [of thee; and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc* [that smiteth]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8688”}.\f + \fr 7:9 \ft thee according: Heb. upon thee, etc \f* 
\v 10 \w Behold the day| strong="H3117" \w*, [behold, it is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}: \w the morning| strong="H6843" \w* [is gone forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”}; \w the rod| strong="H4294" \w* [hath blossomed]{strong=“H6692” x-morph=“strongMorph: \sc Th\sc*8804”}, \w pride| strong="H2087" \w* [hath budded]{strong=“H6524” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 11 \w Violence| strong="H2555" \w* [is risen up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”} \w into a rod| strong="H4294" \w* \w of wickedness| strong="H7562" \w*: none of them shall remain, \w nor of their multitude| strong="H1995" \w*, \w nor of any| strong="H1991" \w* of theirs: neither shall there be \w wailing| strong="H5089" \w* for them.\f + \fr 7:11 \ft theirs: or, their tumultuous persons: Heb. tumult \f* 
\v 12 \w The time| strong="H6256" \w* [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the day| strong="H3117" \w* [draweth near]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8689”}: [let not the buyer]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8802”} [rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”}, [nor the seller]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8802”} [mourn]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8691”}: \w for wrath| strong="H2740" \w* is \w upon all the multitude| strong="H1995" \w* thereof. 
\v 13 [For the seller]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8802”} [shall not return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w to that which is sold| strong="H4465" \w*, \w although they were yet alive| strong="H2416" \w*: \w for the vision| strong="H2377" \w* is \w touching the whole multitude| strong="H1995" \w* thereof, which [shall not return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}; \w neither shall any| strong="H376" \w* [strengthen]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8691”} \w himself in the iniquity| strong="H5771" \w* \w of his life| strong="H2416" \w*.\f + \fr 7:13 \ft although they…: Heb. though their life were yet among the living \f* \f + \fr 7:13 \ft in the…: or, whose life is in his iniquity \f* \f + \fr 7:13 \ft the iniquity: Heb. his iniquity \f* 
\v 14 [They have blown]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8804”} \w the trumpet| strong="H8619" \w*, [even to make all ready]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8687”}; [but none goeth]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the battle| strong="H4421" \w*: \w for my wrath| strong="H2740" \w* is \w upon all the multitude| strong="H1995" \w* thereof. 
\v 15 \w The sword| strong="H2719" \w* is \w without| strong="H2351" \w*, \w and the pestilence| strong="H1698" \w* \w and the famine| strong="H7458" \w* \w within| strong="H1004" \w*: he that is \w in the field| strong="H7704" \w* [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the sword| strong="H2719" \w*; and he that is \w in the city| strong="H5892" \w*, \w famine| strong="H7458" \w* \w and pestilence| strong="H1698" \w* [shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} him. 
\p
\v 16 [But they that escape]{strong=“H6403” x-morph=“strongMorph: \sc Th\sc*8804”} \w of them shall escape| strong="H6412" \w*, \w and shall be on the mountains| strong="H2022" \w* \w like doves| strong="H3123" \w* \w of the valleys| strong="H1516" \w*, [all of them mourning]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8802”}, \w every one| strong="H376" \w* \w for his iniquity| strong="H5771" \w*. 
\v 17 \w All hands| strong="H3027" \w* [shall be feeble]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and all knees| strong="H1290" \w* [shall be weak]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} as \w water| strong="H4325" \w*.\f + \fr 7:17 \ft be weak…: Heb. go into water \f* 
\v 18 [They shall also gird]{strong=“H2296” x-morph=“strongMorph: \sc Th\sc*8804”} themselves \w with sackcloth| strong="H8242" \w*, \w and horror| strong="H6427" \w* [shall cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”} [them; and shame]{strong=“H955”} shall be \w upon all faces| strong="H6440" \w*, \w and baldness| strong="H7144" \w* \w upon all their heads| strong="H7218" \w*. 
\v 19 [They shall cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w their silver| strong="H3701" \w* \w in the streets| strong="H2351" \w*, \w and their gold| strong="H2091" \w* \w shall be removed| strong="H5079" \w*: \w their silver| strong="H3701" \w* \w and their gold| strong="H2091" \w* [shall not be able]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [to deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8687”} \w them in the day| strong="H3117" \w* \w of the wrath| strong="H5678" \w* of the \sc Lord\sc*: [they shall not satisfy]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8762”} \w their souls| strong="H5315" \w*, [neither fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8762”} \w their bowels| strong="H4578" \w*: \w because it is the stumblingblock| strong="H4383" \w* \w of their iniquity| strong="H5771" \w*.\f + \fr 7:19 \ft removed: Heb. for a separation, or, uncleanness \f* \f + \fr 7:19 \ft it is…: or, their iniquity is their stumblingblock \f* 
\p
\v 20 \w As for the beauty| strong="H6643" \w* \w of his ornament| strong="H5716" \w*, [he set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w it in majesty| strong="H1347" \w*: [but they made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w the images| strong="H6754" \w* \w of their abominations| strong="H8441" \w* and \w of their detestable things| strong="H8251" \w* [therein: therefore have I set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w it far| strong="H5079" \w* from them.\f + \fr 7:20 \ft set it far…: or, made it unto them an unclean thing \f* 
\v 21 [And I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w it into the hands| strong="H3027" \w* [of the strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} \w for a prey| strong="H957" \w*, \w and to the wicked| strong="H7563" \w* \w of the earth| strong="H776" \w* \w for a spoil| strong="H7998" \w*; [and they shall pollute]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8765”} it. 
\v 22 \w My face| strong="H6440" \w* [will I turn]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8689”} [also from them, and they shall pollute]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8765”} [my secret]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8803”} place: \w for the robbers| strong="H6530" \w* [shall enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [into it, and defile]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8765”} it.\f + \fr 7:22 \ft robbers: or, burglers \f* 
\p
\v 23 [Make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} \w a chain| strong="H7569" \w*: \w for the land| strong="H776" \w* [is full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of bloody| strong="H1818" \w* \w crimes| strong="H4941" \w*, \w and the city| strong="H5892" \w* [is full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of violence| strong="H2555" \w*. 
\v 24 [Wherefore I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w the worst| strong="H7451" \w* \w of the heathen| strong="H1471" \w*, [and they shall possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8804”} \w their houses| strong="H1004" \w*: \w I will also make the pomp| strong="H1347" \w* \w of the strong| strong="H5794" \w* [to cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8689”}; [and their holy places]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8764”} [shall be defiled]{strong=“H5157 H2490” x-morph=“strongMorph: \sc Th\sc*8765 strongMorph: \sc Th\sc*8676 strongMorph: \sc Th\sc*8738”}.\f + \fr 7:24 \ft their holy…: or, they shall inherit their holy places \f* 
\v 25 \w Destruction| strong="H7089" \w* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}; [and they shall seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8765”} \w peace| strong="H7965" \w*, and there shall be none.\f + \fr 7:25 \ft Destruction: Heb. Cutting off \f* 
\v 26 \w Mischief| strong="H1943" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon mischief| strong="H1943" \w*, \w and rumour| strong="H8052" \w* \w shall be upon rumour| strong="H8052" \w*; [then shall they seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8765”} \w a vision| strong="H2377" \w* \w of the prophet| strong="H5030" \w*; \w but the law| strong="H8451" \w* [shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the priest| strong="H3548" \w*, \w and counsel| strong="H6098" \w* \w from the ancients| strong="H2205" \w*. 
\v 27 \w The king| strong="H4428" \w* [shall mourn]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8691”}, \w and the prince| strong="H5387" \w* [shall be clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w with desolation| strong="H8077" \w*, \w and the hands| strong="H3027" \w* \w of the people| strong="H5971" \w* \w of the land| strong="H776" \w* [shall be troubled]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8735”}: [I will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto them after their way| strong="H1870" \w*, \w and according to their deserts| strong="H4941" \w* [will I judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} [them; and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*.\f + \fr 7:27 \ft according…: Heb. with their judgments \f*
\c 8
\p 
\v 1 \w And it came to pass in the sixth| strong="H8345" \w* \w year| strong="H8141" \w*, \w in the sixth| strong="H8345" \w* month, \w in the fifth| strong="H2568" \w* day \w of the month| strong="H2320" \w*, as [I sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in mine house| strong="H1004" \w*, \w and the elders| strong="H2205" \w* \w of Judah| strong="H3063" \w* [sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w before| strong="H6440" \w* [me, that the hand]{strong=“H3027”} \w of the Lord| strong="H136" \w* \sc God\sc* [fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} there upon me. 
\v 2 [Then I beheld]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and lo a likeness| strong="H1823" \w* \w as the appearance| strong="H4758" \w* \w of fire| strong="H784" \w*: \w from the appearance| strong="H4758" \w* \w of his loins| strong="H4975" \w* \w even downward| strong="H4295" \w*, \w fire| strong="H784" \w*; \w and from his loins| strong="H4975" \w* \w even upward| strong="H4605" \w*, \w as the appearance| strong="H4758" \w* \w of brightness| strong="H2096" \w*, \w as the colour| strong="H5869" \w* \w of amber| strong="H2830" \w*. 
\v 3 [And he put forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w the form| strong="H8403" \w* \w of an hand| strong="H3027" \w*, [and took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w me by a lock| strong="H6734" \w* \w of mine head| strong="H7218" \w*; \w and the spirit| strong="H7307" \w* [lifted me up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w between the earth| strong="H776" \w* \w and the heaven| strong="H8064" \w*, [and brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w me in the visions| strong="H4759" \w* \w of God| strong="H430" \w* \w to Jerusalem| strong="H3389" \w*, \w to the door| strong="H6607" \w* \w of the inner| strong="H6442" \w* \w gate| strong="H8179" \w* [that looketh]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8802”} \w toward the north| strong="H6828" \w*; where was \w the seat| strong="H4186" \w* \w of the image| strong="H5566" \w* \w of jealousy| strong="H7068" \w*, [which provoketh to jealousy]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 4 [And, behold, the glory]{strong=“H3519”} \w of the God| strong="H430" \w* \w of Israel| strong="H3478" \w* was [there, according to the vision]{strong=“H4758”} [that I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the plain| strong="H1237" \w*. 
\p
\v 5 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [he unto me, Son]{strong=“H1121”} \w of man| strong="H120" \w*, [lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w thine eyes| strong="H5869" \w* \w now the way| strong="H1870" \w* \w toward the north| strong="H6828" \w*. [So I lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w mine eyes| strong="H5869" \w* \w the way| strong="H1870" \w* \w toward the north| strong="H6828" \w*, \w and behold northward| strong="H6828" \w* \w at the gate| strong="H8179" \w* \w of the altar| strong="H4196" \w* \w this image| strong="H5566" \w* \w of jealousy| strong="H7068" \w* \w in the entry| strong="H872" \w*. 
\v 6 [He said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [furthermore unto me, Son]{strong=“H1121”} \w of man| strong="H120" \w*, [seest]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} [thou what they do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”}? even \w the great| strong="H1419" \w* \w abominations| strong="H8441" \w* \w that the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* [committeth ]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} [here, that I should go far off]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8800”} \w from my sanctuary| strong="H4720" \w*? [but turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} thee yet again, and [thou shalt see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w greater| strong="H1419" \w* \w abominations| strong="H8441" \w*. 
\p
\v 7 [And he brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w me to the door| strong="H6607" \w* \w of the court| strong="H2691" \w*; [and when I looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, \w behold a| strong="H259" \w* \w hole| strong="H2356" \w* \w in the wall| strong="H7023" \w*. 
\v 8 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [he unto me, Son]{strong=“H1121”} \w of man| strong="H120" \w*, [dig]{strong=“H2864” x-morph=“strongMorph: \sc Th\sc*8798”} \w now in the wall| strong="H7023" \w*: [and when I had digged]{strong=“H2864” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the wall| strong="H7023" \w*, \w behold a| strong="H259" \w* \w door| strong="H6607" \w*. 
\v 9 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”}, [and behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w the wicked| strong="H7451" \w* \w abominations| strong="H8441" \w* [that they do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} here. 
\v 10 [So I went in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}; \w and behold every form| strong="H8403" \w* \w of creeping things| strong="H7431" \w*, \w and abominable| strong="H8263" \w* \w beasts| strong="H929" \w*, \w and all the idols| strong="H1544" \w* \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, [pourtrayed]{strong=“H2707” x-morph=“strongMorph: \sc Th\sc*8794”} \w upon the wall| strong="H7023" \w* \w round about| strong="H5439" \w*. 
\v 11 [And there stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w before| strong="H6440" \w* \w them seventy| strong="H7657" \w* \w men| strong="H376" \w* \w of the ancients| strong="H2205" \w* \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, \w and in the midst| strong="H8432" \w* [of them stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w Jaazaniah| strong="H2970" \w* \w the son| strong="H1121" \w* \w of Shaphan| strong="H8227" \w*, \w with every man| strong="H376" \w* \w his censer| strong="H4730" \w* \w in his hand| strong="H3027" \w*; \w and a thick| strong="H6282" \w* \w cloud| strong="H6051" \w* \w of incense| strong="H7004" \w* [went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 12 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [he unto me, Son]{strong=“H1121”} \w of man| strong="H120" \w*, [hast thou seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w what the ancients| strong="H2205" \w* \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* [do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the dark| strong="H2822" \w*, \w every man| strong="H376" \w* \w in the chambers| strong="H2315" \w* \w of his imagery| strong="H4906" \w*? [for they say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, The \sc Lord\sc* [seeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} us not; the \sc Lord\sc* [hath forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} \w the earth| strong="H776" \w*. 
\p
\v 13 [He said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [also unto me, Turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} thee yet again, and [thou shalt see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w greater| strong="H1419" \w* \w abominations| strong="H8441" \w* [that they do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”}. 
