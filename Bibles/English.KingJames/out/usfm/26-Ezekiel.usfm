\c 2
\p 
\v 1 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Son]{strong=“H1121”} \w of man| strong="H120" \w*, [stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8798”} \w upon thy feet| strong="H7272" \w*, [and I will speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} unto thee. 
