\p
\v 9 [And when I looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, [behold, an hand]{strong=“H3027”} was [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8803”} [unto me; and, lo, a roll]{strong=“H4039”} \w of a book| strong="H5612" \w* was therein; 
