\v 3 \w And when the man| strong="H376" \w* \w that had the line| strong="H6957" \w* \w in his hand| strong="H3027" \w* [went forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”} \w eastward| strong="H6921" \w*, [he measured]{strong=“H4058” x-morph=“strongMorph: \sc Th\sc*8799”} \w a thousand| strong="H505" \w* \w cubits| strong="H520" \w*, [and he brought me through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8686”} \w the waters| strong="H4325" \w*; \w the waters| strong="H4325" \w* were \w to the ankles| strong="H657" \w*.\f + \fr 47:3 \ft the waters were…: Heb. waters of the ankles \f* 
\v 4 [Again he measured]{strong=“H4058” x-morph=“strongMorph: \sc Th\sc*8799”} \w a thousand| strong="H505" \w*, [and brought me through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8686”} \w the waters| strong="H4325" \w*; \w the waters| strong="H4325" \w* were \w to the knees| strong="H1290" \w*. [Again he measured]{strong=“H4058” x-morph=“strongMorph: \sc Th\sc*8799”} \w a thousand| strong="H505" \w*, [and brought me through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8686”}; \w the waters| strong="H4325" \w* were \w to the loins| strong="H4975" \w*. 
\v 5 [Afterward he measured]{strong=“H4058” x-morph=“strongMorph: \sc Th\sc*8799”} \w a thousand| strong="H505" \w*; and it was \w a river| strong="H5158" \w* [that I could]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [not pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8800”}: \w for the waters| strong="H4325" \w* [were risen]{strong=“H1342” x-morph=“strongMorph: \sc Th\sc*8804”}, \w waters| strong="H4325" \w* \w to swim in| strong="H7813" \w*, \w a river| strong="H5158" \w* [that could not be passed over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 47:5 \ft waters to…: Heb. waters of swimming \f* 
\p
\v 6 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Son]{strong=“H1121”} \w of man| strong="H120" \w*, [hast thou seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} this? [Then he brought]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8686”} [me, and caused me to return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w to the brink| strong="H8193" \w* \w of the river| strong="H5158" \w*. 
