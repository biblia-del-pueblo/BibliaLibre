\v 28 [Thou hast played the whore]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8799”} [also with the Assyrians]{strong=“H804 H1121”}, \w because| strong="H1115" \w* [thou wast unsatiable]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8804”}; [yea, thou hast played the harlot]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8799”} [with them, and yet couldest not be satisfied]{strong=“H7654”}. 
\v 29 [Thou hast moreover multiplied]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy fornication| strong="H8457" \w* \w in the land| strong="H776" \w* \w of Canaan| strong="H3667" \w* \w unto Chaldea| strong="H3778" \w*; [and yet thou wast not satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8804”} \w herewith| strong="H2063" \w*. 
\v 30 [How weak]{strong=“H535” x-morph=“strongMorph: \sc Th\sc*8802”} \w is thine heart| strong="H3826" \w*, [saith ]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, [seeing thou doest]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} all these things, \w the work| strong="H4639" \w* \w of an imperious| strong="H7986" \w* [whorish ]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8803”} \w woman| strong="H802" \w*; 
\v 31 [In that thou buildest]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8800”} \w thine eminent place| strong="H1354" \w* \w in the head| strong="H7218" \w* \w of every way| strong="H1870" \w*, [and makest]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w thine high place| strong="H7413" \w* \w in every street| strong="H7339" \w*; [and hast not been as an harlot]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”}, [in that thou scornest]{strong=“H7046” x-morph=“strongMorph: \sc Th\sc*8763”} \w hire| strong="H868" \w*;\f + \fr 16:31 \ft In that thou buildest…: or, In thy daughters is thine, etc \f* 
\v 32 But as \w a wife| strong="H802" \w* [that committeth adultery]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8764”}, which [taketh]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} \w instead of her husband| strong="H376" \w*! 
\v 33 [They give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w gifts| strong="H5078" \w* [to all whores]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”}: [but thou givest]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy gifts| strong="H5083" \w* [to all thy lovers]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8764”}, [and hirest]{strong=“H7809” x-morph=“strongMorph: \sc Th\sc*8799”} [them, that they may come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto thee on every side| strong="H5439" \w* \w for thy whoredom| strong="H8457" \w*.\f + \fr 16:33 \ft hirest: Heb. bribest \f* 
\v 34 \w And the contrary| strong="H2016" \w* is in thee from other \w women| strong="H802" \w* \w in thy whoredoms| strong="H8457" \w*, \w whereas none followeth| strong="H310" \w* [thee to commit whoredoms]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8795”}: [and in that thou givest]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w a reward| strong="H868" \w*, \w and no reward| strong="H868" \w* [is given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} [unto thee, therefore thou art]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8799”} \w contrary| strong="H2016" \w*. 
\p
\v 35 [Wherefore, O harlot]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”}, [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* of the \sc Lord\sc*: 
\v 36 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w Because thy filthiness| strong="H5178" \w* [was poured out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8736”}, \w and thy nakedness| strong="H6172" \w* [discovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8735”} \w through thy whoredoms| strong="H8457" \w* [with thy lovers]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8764”}, \w and with all the idols| strong="H1544" \w* \w of thy abominations| strong="H8441" \w*, \w and by the blood| strong="H1818" \w* \w of thy children| strong="H1121" \w*, [which thou didst give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} unto them; 
\v 37 [Behold, therefore I will gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8764”} [all thy lovers]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8764”}, [with whom thou hast taken pleasure]{strong=“H6149” x-morph=“strongMorph: \sc Th\sc*8804”}, and all them [that thou hast loved]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”}, with all them [that thou hast hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”}; [I will even gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8765”} \w them round about| strong="H5439" \w* [against thee, and will discover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy nakedness| strong="H6172" \w* [unto them, that they may see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w all thy nakedness| strong="H6172" \w*. 
\v 38 [And I will judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, as women that break wedlock]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8802”} [and shed]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8802”} \w blood| strong="H1818" \w* \w are judged| strong="H4941" \w*; [and I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee blood| strong="H1818" \w* \w in fury| strong="H2534" \w* \w and jealousy| strong="H7068" \w*.\f + \fr 16:38 \ft as: Heb. with judgments of \f* 
\v 39 [And I will also give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee into their hand| strong="H3027" \w*, [and they shall throw down]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8804”} \w thine eminent place| strong="H1354" \w*, [and shall break down]{strong=“H5422” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy high places| strong="H7413" \w*: [they shall strip]{strong=“H6584” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee also of thy clothes| strong="H899" \w*, [and shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy fair| strong="H8597" \w* \w jewels| strong="H3627" \w*, [and leave]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee naked| strong="H5903" \w* \w and bare| strong="H6181" \w*.\f + \fr 16:39 \ft thy fair…: Heb. instruments of thine ornament \f* 
\v 40 [They shall also bring up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} \w a company| strong="H6951" \w* [against thee, and they shall stone]{strong=“H7275” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee with stones| strong="H68" \w*, [and thrust thee through]{strong=“H1333” x-morph=“strongMorph: \sc Th\sc*8765”} \w with their swords| strong="H2719" \w*. 
\v 41 [And they shall burn]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8804”} \w thine houses| strong="H1004" \w* \w with fire| strong="H784" \w*, [and execute]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w judgments| strong="H8201" \w* \w upon thee in the sight| strong="H5869" \w* \w of many| strong="H7227" \w* \w women| strong="H802" \w*: [and I will cause thee to cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8689”} [from playing the harlot]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”}, [and thou also shalt give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w no hire| strong="H868" \w* any more. 
\v 42 \w So will I make my fury| strong="H2534" \w* [toward thee to rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8689”}, \w and my jealousy| strong="H7068" \w* [shall depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8804”} [from thee, and I will be quiet]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8804”}, [and will be no more angry]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 43 [Because thou hast not remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w the days| strong="H3117" \w* \w of thy youth| strong="H5271" \w*, [but hast fretted]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8799”} me in all these things; \w behold| strong="H1887" \w*, [therefore I also will recompense]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy way| strong="H1870" \w* upon thine \w head| strong="H7218" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*: [and thou shalt not commit]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w this lewdness| strong="H2154" \w* \w above all thine abominations| strong="H8441" \w*. 
\p
\v 44 [Behold, every one that useth proverbs]{strong=“H4911” x-morph=“strongMorph: \sc Th\sc*8802”} shall use this [proverb]{strong=“H4911” x-morph=“strongMorph: \sc Th\sc*8799”} [against thee, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, As is \w the mother| strong="H517" \w*, so is \w her daughter| strong="H1323" \w*. 
\v 45 Thou art [thy mother’s]{strong=“H517”} \w daughter| strong="H1323" \w*, [that lotheth]{strong=“H1602” x-morph=“strongMorph: \sc Th\sc*8802”} \w her husband| strong="H376" \w* \w and her children| strong="H1121" \w*; and thou art \w the sister| strong="H269" \w* \w of thy sisters| strong="H269" \w*, [which lothed]{strong=“H1602” x-morph=“strongMorph: \sc Th\sc*8804”} \w their husbands| strong="H582" \w* \w and their children| strong="H1121" \w*: \w your mother| strong="H517" \w* was \w an Hittite| strong="H2850" \w*, \w and your father| strong="H1" \w* \w an Amorite| strong="H567" \w*. 
\v 46 \w And thine elder| strong="H1419" \w* \w sister| strong="H269" \w* is \w Samaria| strong="H8111" \w*, \w she and her daughters| strong="H1323" \w* [that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w at thy left hand| strong="H8040" \w*: \w and thy younger| strong="H6996" \w* \w sister| strong="H269" \w*, [that dwelleth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w at thy right hand| strong="H3225" \w*, is \w Sodom| strong="H5467" \w* \w and her daughters| strong="H1323" \w*.\f + \fr 16:46 \ft thy younger: Heb. lesser than thou \f* 
\v 47 [Yet hast thou not walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w after their ways| strong="H1870" \w*, [nor done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w after their abominations| strong="H8441" \w*: but, as if that were \w a very| strong="H6985" \w* [little]{strong=“H6962 H4592” x-morph=“strongMorph: \sc Th\sc*8804”} thing, [thou wast corrupted]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8686”} \w more than they| strong="H2004" \w* \w in all thy ways| strong="H1870" \w*.\f + \fr 16:47 \ft as if…: or, that was lothed as a small thing \f* 
\v 48 As \w I live| strong="H2416" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, \w Sodom| strong="H5467" \w* \w thy sister| strong="H269" \w* [hath not done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, \w she nor her daughters| strong="H1323" \w*, [as thou hast done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, \w thou and thy daughters| strong="H1323" \w*. 
\v 49 [Behold, this was the iniquity]{strong=“H5771”} \w of thy sister| strong="H269" \w* \w Sodom| strong="H5467" \w*, \w pride| strong="H1347" \w*, \w fulness| strong="H7653" \w* \w of bread| strong="H3899" \w*, \w and abundance| strong="H7962" \w* [of idleness]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8687”} \w was in her and in her daughters| strong="H1323" \w*, [neither did she strengthen]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8689”} \w the hand| strong="H3027" \w* \w of the poor| strong="H6041" \w* \w and needy| strong="H34" \w*. 
\v 50 [And they were haughty]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8799”}, [and committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w abomination| strong="H8441" \w* \w before| strong="H6440" \w* [me: therefore I took them away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8686”} [as I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} good. 
\v 51 \w Neither hath Samaria| strong="H8111" \w* [committed ]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} \w half| strong="H2677" \w* \w of thy sins| strong="H2403" \w*; [but thou hast multiplied]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} \w thine abominations| strong="H8441" \w* \w more than they| strong="H2007" \w*, [and hast justified]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy sisters| strong="H269" \w* \w in all thine abominations| strong="H8441" \w* [which thou hast done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 52 [Thou also, which hast judged]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy sisters| strong="H269" \w*, [bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w thine own shame| strong="H3639" \w* \w for thy sins| strong="H2403" \w* [that thou hast committed more abominable]{strong=“H8581” x-morph=“strongMorph: \sc Th\sc*8689”} \w than they| strong="H2004" \w*: [they are more righteous]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8799”} [than thou: yea, be thou confounded]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8798”} [also, and bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy shame| strong="H3639" \w*, [in that thou hast justified]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8763”} \w thy sisters| strong="H269" \w*. 
\v 53 [When I shall bring again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} [their captivity]{strong=“H7622 H7622” x-morph=“strongMorph: \sc Th\sc*8675”}, [the captivity]{strong=“H7622 H7622” x-morph=“strongMorph: \sc Th\sc*8675”} \w of Sodom| strong="H5467" \w* \w and her daughters| strong="H1323" \w*, [and the captivity]{strong=“H7622 H7622” x-morph=“strongMorph: \sc Th\sc*8676”} \w of Samaria| strong="H8111" \w* \w and her daughters| strong="H1323" \w*, then will I bring again [the captivity]{strong=“H7622 H7622” x-morph=“strongMorph: \sc Th\sc*8675”} \w of thy captives| strong="H7622" \w* \w in the midst| strong="H8432" \w* of them: 
\v 54 [That thou mayest bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w thine own shame| strong="H3639" \w*, [and mayest be confounded]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8738”} [in all that thou hast done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [in that thou art a comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8763”} unto them. 
\v 55 \w When thy sisters| strong="H269" \w*, \w Sodom| strong="H5467" \w* \w and her daughters| strong="H1323" \w*, [shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w to their former estate| strong="H6927" \w*, \w and Samaria| strong="H8111" \w* \w and her daughters| strong="H1323" \w* [shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w to their former estate| strong="H6927" \w*, \w then thou and thy daughters| strong="H1323" \w* [shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w to your former estate| strong="H6927" \w*. 
\v 56 \w For thy sister| strong="H269" \w* \w Sodom| strong="H5467" \w* \w was not mentioned| strong="H8052" \w* \w by thy mouth| strong="H6310" \w* \w in the day| strong="H3117" \w* \w of thy pride| strong="H1347" \w*,\f + \fr 16:56 \ft mentioned: Heb. for a report, or, hearing \f* \f + \fr 16:56 \ft pride: Heb. prides, or, excellencies \f* 
\v 57 \w Before thy wickedness| strong="H7451" \w* [was discovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8735”}, \w as at the time| strong="H6256" \w* of thy \w reproach| strong="H2781" \w* \w of the daughters| strong="H1323" \w* \w of Syria| strong="H758" \w*, and all that are \w round about| strong="H5439" \w* [her, the daughters]{strong=“H1323”} \w of the Philistines| strong="H6430" \w*, [which despise]{strong=“H7590” x-morph=“strongMorph: \sc Th\sc*8801”} \w thee round about| strong="H5439" \w*.\f + \fr 16:57 \ft Syria: Heb. Aram \f* \f + \fr 16:57 \ft despise: or, spoil \f* 
\v 58 [Thou hast borne]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy lewdness| strong="H2154" \w* \w and thine abominations| strong="H8441" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*.\f + \fr 16:58 \ft borne: Heb. borne them \f* 
\v 59 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [I will even deal]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [with thee as thou hast done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [which hast despised]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8804”} \w the oath| strong="H423" \w* [in breaking]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8687”} \w the covenant| strong="H1285" \w*. 
\p
\v 60 [Nevertheless I will remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w my covenant| strong="H1285" \w* \w with thee in the days| strong="H3117" \w* \w of thy youth| strong="H5271" \w*, [and I will establish]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} \w unto thee an everlasting| strong="H5769" \w* \w covenant| strong="H1285" \w*. 
\v 61 [Then thou shalt remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy ways| strong="H1870" \w*, [and be ashamed]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8738”}, [when thou shalt receive]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy sisters| strong="H269" \w*, \w thine elder| strong="H1419" \w* \w and thy younger| strong="H6996" \w*: [and I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w them unto thee for daughters| strong="H1323" \w*, \w but not by thy covenant| strong="H1285" \w*. 
\v 62 [And I will establish]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} \w my covenant| strong="H1285" \w* [with thee; and thou shalt know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*: 
\v 63 [That thou mayest remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”}, [and be confounded]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and never open| strong="H6610" \w* \w thy mouth| strong="H6310" \w* \w any more because| strong="H6440" \w* \w of thy shame| strong="H3639" \w*, [when I am pacified]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8763”} [toward thee for all that thou hast done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\c 17
\p 
\v 1 \w And the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [put forth]{strong=“H2330” x-morph=“strongMorph: \sc Th\sc*8798”} \w a riddle| strong="H2420" \w*, [and speak]{strong=“H4911” x-morph=“strongMorph: \sc Th\sc*8798”} \w a parable| strong="H4912" \w* \w unto the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*; 
\v 3 [And say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w A great| strong="H1419" \w* \w eagle| strong="H5404" \w* \w with great| strong="H1419" \w* \w wings| strong="H3671" \w*, [longwinged]{strong=“H750 H83”}, \w full| strong="H4392" \w* \w of feathers| strong="H5133" \w*, \w which had divers colours| strong="H7553" \w*, [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto Lebanon| strong="H3844" \w*, [and took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the highest branch| strong="H6788" \w* \w of the cedar| strong="H730" \w*:\f + \fr 17:3 \ft divers…: Heb. embroidering \f* 
\v 4 [He cropped off]{strong=“H6998” x-morph=“strongMorph: \sc Th\sc*8804”} \w the top| strong="H7218" \w* \w of his young twigs| strong="H3242" \w*, [and carried]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w it into a land| strong="H776" \w* \w of traffick| strong="H3667" \w*; [he set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w it in a city| strong="H5892" \w* [of merchants]{strong=“H7402” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 5 [He took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w also of the seed| strong="H2233" \w* \w of the land| strong="H776" \w*, [and planted]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w it in a fruitful| strong="H2233" \w* \w field| strong="H7704" \w*; [he placed]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} it \w by great| strong="H7227" \w* \w waters| strong="H4325" \w*, and [set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} it as \w a willow tree| strong="H6851" \w*.\f + \fr 17:5 \ft planted…: Heb. put it in a field of seed \f* 
\v 6 [And it grew]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8799”}, [and became a spreading]{strong=“H5628” x-morph=“strongMorph: \sc Th\sc*8802”} \w vine| strong="H1612" \w* \w of low| strong="H8217" \w* \w stature| strong="H6967" \w*, \w whose branches| strong="H1808" \w* [turned]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8800”} [toward him, and the roots]{strong=“H8328”} [thereof were under him: so it became a vine]{strong=“H1612”}, [and brought forth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w branches| strong="H905" \w*, [and shot]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w forth sprigs| strong="H6288" \w*. 
\v 7 \w There was also another| strong="H259" \w* \w great| strong="H1419" \w* \w eagle| strong="H5404" \w* \w with great| strong="H1419" \w* \w wings| strong="H3671" \w* \w and many| strong="H7227" \w* \w feathers| strong="H5133" \w*: [and, behold, this vine]{strong=“H1612”} [did bend]{strong=“H3719” x-morph=“strongMorph: \sc Th\sc*8804”} \w her roots| strong="H8328" \w* [toward him, and shot forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w her branches| strong="H1808" \w* [toward him, that he might water]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8687”} \w it by the furrows| strong="H6170" \w* \w of her plantation| strong="H4302" \w*. 
\v 8 [It was planted]{strong=“H8362” x-morph=“strongMorph: \sc Th\sc*8803”} \w in a good| strong="H2896" \w* \w soil| strong="H7704" \w* \w by great| strong="H7227" \w* \w waters| strong="H4325" \w*, [that it might bring forth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w branches| strong="H6057" \w*, [and that it might bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8800”} \w fruit| strong="H6529" \w*, \w that it might be a goodly| strong="H155" \w* \w vine| strong="H1612" \w*.\f + \fr 17:8 \ft soil: Heb. field \f* 
\v 9 [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} [thou, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Shall it prosper]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8799”}? [shall he not pull up]{strong=“H5423” x-morph=“strongMorph: \sc Th\sc*8762”} \w the roots| strong="H8328" \w* [thereof, and cut off]{strong=“H7082” x-morph=“strongMorph: \sc Th\sc*8779”} \w the fruit| strong="H6529" \w* [thereof, that it wither]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8804”}? [it shall wither]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8799”} \w in all the leaves| strong="H2964" \w* \w of her spring| strong="H6780" \w*, \w even without great| strong="H1419" \w* \w power| strong="H2220" \w* \w or many| strong="H7227" \w* \w people| strong="H5971" \w* [to pluck it up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8800”} \w by the roots| strong="H8328" \w* thereof. 
\v 10 Yea, behold, being [planted]{strong=“H8362” x-morph=“strongMorph: \sc Th\sc*8803”}, [shall it prosper]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8799”}? [shall it not utterly]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8800”} [wither]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8799”}, \w when the east| strong="H6921" \w* \w wind| strong="H7307" \w* [toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8800”} [it? it shall wither]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the furrows| strong="H6170" \w* \w where it grew| strong="H6780" \w*. 
\p
\v 11 \w Moreover the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 12 [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w now to the rebellious| strong="H4805" \w* \w house| strong="H1004" \w*, [Know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} ye not what these things mean? [tell]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} them, [Behold, the king]{strong=“H4428”} \w of Babylon| strong="H894" \w* [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w to Jerusalem| strong="H3389" \w*, [and hath taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the king| strong="H4428" \w* [thereof, and the princes]{strong=“H8269”} [thereof, and led]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w them with him to Babylon| strong="H894" \w*; 
\v 13 [And hath taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [of the king’s]{strong=“H4410”} \w seed| strong="H2233" \w*, [and made]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} \w a covenant| strong="H1285" \w* [with him, and hath taken]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w an oath| strong="H423" \w* [of him: he hath also taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w the mighty| strong="H352" \w* \w of the land| strong="H776" \w*:\f + \fr 17:13 \ft taken an…: Heb. brought him to an oath \f* 
\v 14 \w That the kingdom| strong="H4467" \w* \w might be base| strong="H8217" \w*, [that it might not lift itself up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8692”}, but [that by keeping]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w of his covenant| strong="H1285" \w* [it might stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 17:14 \ft but…: Heb. to keep his covenant, to stand to it \f* 
\v 15 [But he rebelled]{strong=“H4775” x-morph=“strongMorph: \sc Th\sc*8799”} [against him in sending]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8800”} \w his ambassadors| strong="H4397" \w* \w into Egypt| strong="H4714" \w*, [that they might give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w him horses| strong="H5483" \w* \w and much| strong="H7227" \w* \w people| strong="H5971" \w*. [Shall he prosper]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8799”}? [shall he escape]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8735”} [that doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} such things? [or shall he break]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8689”} \w the covenant| strong="H1285" \w*, [and be delivered]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8738”}? 
\v 16 As \w I live| strong="H2416" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, \w surely in the place| strong="H4725" \w* where \w the king| strong="H4428" \w* dwelleth [that made him king]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8688”}, \w whose oath| strong="H423" \w* [he despised]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and whose covenant| strong="H1285" \w* [he brake]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8689”}, even \w with him in the midst| strong="H8432" \w* \w of Babylon| strong="H894" \w* [he shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 17 \w Neither shall Pharaoh| strong="H6547" \w* with his \w mighty| strong="H1419" \w* \w army| strong="H2428" \w* \w and great| strong="H7227" \w* \w company| strong="H6951" \w* [make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w for him in the war| strong="H4421" \w*, [by casting up]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8800”} \w mounts| strong="H5550" \w*, [and building]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8800”} \w forts| strong="H1785" \w*, [to cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8687”} \w many| strong="H7227" \w* \w persons| strong="H5315" \w*: 
\v 18 [Seeing he despised]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8804”} \w the oath| strong="H423" \w* [by breaking]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8687”} \w the covenant| strong="H1285" \w*, [when, lo, he had given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w his hand| strong="H3027" \w*, [and hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} all these things, [he shall not escape]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 19 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; As \w I live| strong="H2416" \w*, \w surely mine oath| strong="H423" \w* [that he hath despised]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and my covenant| strong="H1285" \w* [that he hath broken]{strong=“H6331” x-morph=“strongMorph: \sc Th\sc*8689”}, [even it will I recompense]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon his own head| strong="H7218" \w*. 
\v 20 [And I will spread]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8804”} \w my net| strong="H7568" \w* [upon him, and he shall be taken]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8738”} \w in my snare| strong="H4686" \w*, [and I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w him to Babylon| strong="H894" \w*, [and will plead]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8738”} [with him there for his trespass]{strong=“H4603” x-morph=“strongMorph: \sc Th\sc*8804”} \w that he hath trespassed| strong="H4604" \w* against me. 
\v 21 \w And all his fugitives| strong="H4015" \w* \w with all his bands| strong="H102" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w*, [and they that remain]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”} [shall be scattered]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8735”} \w toward all winds| strong="H7307" \w*: [and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I the \sc Lord\sc* [have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it. 
\p
\v 22 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [I will also take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the highest branch| strong="H6788" \w* [of the high]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8802”} \w cedar| strong="H730" \w*, [and will set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} it; [I will crop off]{strong=“H6998” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the top| strong="H7218" \w* \w of his young twigs| strong="H3127" \w* \w a tender one| strong="H7390" \w*, [and will plant]{strong=“H8362” x-morph=“strongMorph: \sc Th\sc*8804”} it \w upon an high| strong="H1364" \w* \w mountain| strong="H2022" \w* [and eminent]{strong=“H8524” x-morph=“strongMorph: \sc Th\sc*8803”}: 
\v 23 \w In the mountain| strong="H2022" \w* \w of the height| strong="H4791" \w* \w of Israel| strong="H3478" \w* [will I plant]{strong=“H8362” x-morph=“strongMorph: \sc Th\sc*8799”} [it: and it shall bring forth]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w boughs| strong="H6057" \w*, [and bear]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w fruit| strong="H6529" \w*, \w and be a goodly| strong="H117" \w* \w cedar| strong="H730" \w*: [and under it shall dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8804”} \w all fowl| strong="H6833" \w* \w of every wing| strong="H3671" \w*; \w in the shadow| strong="H6738" \w* \w of the branches| strong="H1808" \w* [thereof shall they dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 24 \w And all the trees| strong="H6086" \w* \w of the field| strong="H7704" \w* [shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I the \sc Lord\sc* [have brought down]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8689”} \w the high| strong="H1364" \w* \w tree| strong="H6086" \w*, [have exalted]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8689”} \w the low| strong="H8217" \w* \w tree| strong="H6086" \w*, [have dried]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”} \w up the green| strong="H3892" \w* \w tree| strong="H6086" \w*, \w and have made the dry| strong="H3002" \w* \w tree| strong="H6086" \w* [to flourish]{strong=“H6524” x-morph=“strongMorph: \sc Th\sc*8689”}: I the \sc Lord\sc* [have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [and have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} it. 
\c 18
\p 
\v 1 \w The word| strong="H1697" \w* of the \sc Lord\sc* [came unto me again, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [What mean ye, that ye use]{strong=“H4911” x-morph=“strongMorph: \sc Th\sc*8802”} \w this proverb| strong="H4912" \w* \w concerning the land| strong="H127" \w* \w of Israel| strong="H3478" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w The fathers| strong="H1" \w* [have eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w sour grapes| strong="H1155" \w*, [and the children’s]{strong=“H1121”} \w teeth| strong="H8127" \w* [are set on edge]{strong=“H6949” x-morph=“strongMorph: \sc Th\sc*8799”}? 
\v 3 As \w I live| strong="H2416" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, ye shall not have occasion [any more to use]{strong=“H4911” x-morph=“strongMorph: \sc Th\sc*8800”} \w this proverb| strong="H4912" \w* \w in Israel| strong="H3478" \w*. 
\v 4 [Behold, all souls]{strong=“H5315”} [are mine; as the soul]{strong=“H5315”} \w of the father| strong="H1" \w*, \w so also the soul| strong="H5315" \w* \w of the son| strong="H1121" \w* [is mine: the soul]{strong=“H5315”} [that sinneth]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8802”}, [it shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 5 \w But if a man| strong="H376" \w* \w be just| strong="H6662" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w that which is lawful| strong="H4941" \w* \w and right| strong="H6666" \w*,\f + \fr 18:5 \ft that…: Heb. judgment and justice \f* 
\v 6 And [hath not eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon the mountains| strong="H2022" \w*, [neither hath lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w his eyes| strong="H5869" \w* \w to the idols| strong="H1544" \w* \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, [neither hath defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8765”} [his neighbour’s]{strong=“H7453”} \w wife| strong="H802" \w*, [neither hath come near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} \w to a menstruous| strong="H5079" \w* \w woman| strong="H802" \w*, 
\v 7 [And hath not oppressed]{strong=“H3238” x-morph=“strongMorph: \sc Th\sc*8686”} \w any| strong="H376" \w*, but [hath restored]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w to the debtor| strong="H2326" \w* \w his pledge| strong="H2258" \w*, [hath spoiled]{strong=“H1497” x-morph=“strongMorph: \sc Th\sc*8799”} \w none by violence| strong="H1500" \w*, [hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w his bread| strong="H3899" \w* \w to the hungry| strong="H7457" \w*, [and hath covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w the naked| strong="H5903" \w* \w with a garment| strong="H899" \w*; 
\v 8 He that [hath not given forth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon usury| strong="H5392" \w*, [neither hath taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w any increase| strong="H8636" \w*, that [hath withdrawn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w his hand| strong="H3027" \w* \w from iniquity| strong="H5766" \w*, [hath executed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w true| strong="H571" \w* \w judgment| strong="H4941" \w* \w between man| strong="H376" \w* \w and man| strong="H376" \w*, 
\v 9 [Hath walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8762”} \w in my statutes| strong="H2708" \w*, [and hath kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w my judgments| strong="H4941" \w*, [to deal]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w truly| strong="H571" \w*; he is \w just| strong="H6662" \w*, [he shall surely]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8800”} [live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\p
\v 10 [If he beget]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8689”} \w a son| strong="H1121" \w* that is \w a robber| strong="H6530" \w*, [a shedder]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8802”} \w of blood| strong="H1818" \w*, and that [doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w the like| strong="H251" \w* to any \w one| strong="H259" \w* of these things,\f + \fr 18:10 \ft robber: or, breaker up of an house \f* \f + \fr 18:10 \ft that doeth…: or, that doeth to his brother besides any of these \f* 
\v 11 [And that doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} not any of those duties, [but even hath eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon the mountains| strong="H2022" \w*, [and defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8765”} [his neighbour’s]{strong=“H7453”} \w wife| strong="H802" \w*, 
\v 12 [Hath oppressed]{strong=“H3238” x-morph=“strongMorph: \sc Th\sc*8689”} \w the poor| strong="H6041" \w* \w and needy| strong="H34" \w*, [hath spoiled]{strong=“H1497” x-morph=“strongMorph: \sc Th\sc*8804”} \w by violence| strong="H1500" \w*, [hath not restored]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w the pledge| strong="H2258" \w*, [and hath lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w his eyes| strong="H5869" \w* \w to the idols| strong="H1544" \w*, [hath committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w abomination| strong="H8441" \w*, 
\v 13 [Hath given forth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon usury| strong="H5392" \w*, [and hath taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w increase| strong="H8636" \w*: [shall he then live]{strong=“H2425” x-morph=“strongMorph: \sc Th\sc*8804”}? [he shall not live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}: [he hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w all these abominations| strong="H8441" \w*; [he shall surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}; \w his blood| strong="H1818" \w* shall be upon him.\f + \fr 18:13 \ft blood: Heb. bloods \f* 
\p
\v 14 Now, lo, if [he beget]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8689”} \w a son| strong="H1121" \w*, [that seeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [all his father’s]{strong=“H1”} \w sins| strong="H2403" \w* [which he hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [and considereth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, [and doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w not such like| strong="H2004" \w*, 
\v 15 That [hath not eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon the mountains| strong="H2022" \w*, [neither hath lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w his eyes| strong="H5869" \w* \w to the idols| strong="H1544" \w* \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, [hath not defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8765”} [his neighbour’s]{strong=“H7453”} \w wife| strong="H802" \w*, 
\v 16 [Neither hath oppressed]{strong=“H3238” x-morph=“strongMorph: \sc Th\sc*8689”} \w any| strong="H376" \w*, [hath not withholden]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8804”} \w the pledge| strong="H2258" \w*, [neither hath spoiled]{strong=“H1497” x-morph=“strongMorph: \sc Th\sc*8804”} \w by violence| strong="H1500" \w*, but [hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w his bread| strong="H3899" \w* \w to the hungry| strong="H7457" \w*, [and hath covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”} \w the naked| strong="H5903" \w* \w with a garment| strong="H899" \w*,\f + \fr 18:16 \ft hath not…: Heb. hath not pledged the pledge, or, taken to pledge \f* 
\v 17 That [hath taken off]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} \w his hand| strong="H3027" \w* \w from the poor| strong="H6041" \w*, that [hath not received]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w usury| strong="H5392" \w* \w nor increase| strong="H8636" \w*, [hath executed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w my judgments| strong="H4941" \w*, [hath walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w in my statutes| strong="H2708" \w*; [he shall not die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w for the iniquity| strong="H5771" \w* \w of his father| strong="H1" \w*, [he shall surely]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8800”} [live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 18 As for \w his father| strong="H1" \w*, \w because he cruelly| strong="H6233" \w* [oppressed]{strong=“H6231” x-morph=“strongMorph: \sc Th\sc*8804”}, [spoiled]{strong=“H1497” x-morph=“strongMorph: \sc Th\sc*8804”} \w his brother| strong="H251" \w* \w by violence| strong="H1499" \w*, [and did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} that which is \w not good| strong="H2896" \w* \w among| strong="H8432" \w* \w his people| strong="H5971" \w*, [lo, even he shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”} \w in his iniquity| strong="H5771" \w*. 
\p
\v 19 [Yet say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [ye, Why? doth not the son]{strong=“H1121”} [bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w the iniquity| strong="H5771" \w* \w of the father| strong="H1" \w*? \w When the son| strong="H1121" \w* [hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w that which is lawful| strong="H4941" \w* \w and right| strong="H6666" \w*, and [hath kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w all my statutes| strong="H2708" \w*, [and hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [them, he shall surely]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8800”} [live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 20 \w The soul| strong="H5315" \w* [that sinneth]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8802”}, [it shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. \w The son| strong="H1121" \w* [shall not bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w the iniquity| strong="H5771" \w* \w of the father| strong="H1" \w*, \w neither shall the father| strong="H1" \w* [bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w the iniquity| strong="H5771" \w* \w of the son| strong="H1121" \w*: \w the righteousness| strong="H6666" \w* \w of the righteous| strong="H6662" \w* [shall be upon him, and the wickedness]{strong=“H7564”} \w of the wicked| strong="H7563" \w* shall be upon him. 
\p
\v 21 \w But if the wicked| strong="H7563" \w* [will turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w from all his sins| strong="H2403" \w* [that he hath committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [and keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w all my statutes| strong="H2708" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w that which is lawful| strong="H4941" \w* \w and right| strong="H6666" \w*, [he shall surely]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8800”} [live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}, [he shall not die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 22 \w All his transgressions| strong="H6588" \w* [that he hath committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [they shall not be mentioned]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8735”} [unto him: in his righteousness]{strong=“H6666”} [that he hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [he shall live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 23 [Have I any pleasure]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8799”} [at all]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8800”} \w that the wicked| strong="H7563" \w* \w should die| strong="H4194" \w*? [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*: and [not that he should return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w from his ways| strong="H1870" \w*, [and live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8804”}? 
\p
\v 24 \w But when the righteous| strong="H6662" \w* [turneth away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w from his righteousness| strong="H6666" \w*, [and committeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w iniquity| strong="H5766" \w*, and [doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w according to all the abominations| strong="H8441" \w* \w that the wicked| strong="H7563" \w* man [doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [shall he live]{strong=“H2425” x-morph=“strongMorph: \sc Th\sc*8804”}? \w All his righteousness| strong="H6666" \w* [that he hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [shall not be mentioned]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8735”}: [in his trespass]{strong=“H4603” x-morph=“strongMorph: \sc Th\sc*8804”} \w that he hath trespassed| strong="H4604" \w*, \w and in his sin| strong="H2403" \w* [that he hath sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}, [in them shall he die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 25 [Yet ye say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w The way| strong="H1870" \w* \w of the Lord| strong="H136" \w* [is not equal]{strong=“H8505” x-morph=“strongMorph: \sc Th\sc*8735”}. [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [now, O house]{strong=“H1004”} \w of Israel| strong="H3478" \w*; \w Is not my way| strong="H1870" \w* [equal]{strong=“H8505” x-morph=“strongMorph: \sc Th\sc*8735”}? \w are not your ways| strong="H1870" \w* [unequal]{strong=“H8505” x-morph=“strongMorph: \sc Th\sc*8735”}? 
\v 26 \w When a righteous| strong="H6662" \w* man [turneth away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w from his righteousness| strong="H6666" \w*, [and committeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w iniquity| strong="H5766" \w*, [and dieth]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”} [in them; for his iniquity]{strong=“H5766”} [that he hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [shall he die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 27 [Again, when the wicked]{strong=“H7563”} man [turneth away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w from his wickedness| strong="H7564" \w* [that he hath committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [and doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w that which is lawful| strong="H4941" \w* \w and right| strong="H6666" \w*, \w he shall save| strong="H2421" \w* \w his soul| strong="H5315" \w* [alive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 28 [Because he considereth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, [and turneth away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w from all his transgressions| strong="H6588" \w* [that he hath committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [he shall surely]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8800”} [live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}, [he shall not die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 29 [Yet saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, \w The way| strong="H1870" \w* \w of the Lord| strong="H136" \w* [is not equal]{strong=“H8505” x-morph=“strongMorph: \sc Th\sc*8735”}. \w O house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, \w are not my ways| strong="H1870" \w* [equal]{strong=“H8505” x-morph=“strongMorph: \sc Th\sc*8735”}? \w are not your ways| strong="H1870" \w* [unequal]{strong=“H8505” x-morph=“strongMorph: \sc Th\sc*8735”}? 
\p
\v 30 [Therefore I will judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} [you, O house]{strong=“H1004”} \w of Israel| strong="H3478" \w*, \w every one| strong="H376" \w* \w according to his ways| strong="H1870" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. [Repent]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”}, [and turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”} yourselves \w from all your transgressions| strong="H6588" \w*; \w so iniquity| strong="H5771" \w* \w shall not be your ruin| strong="H4383" \w*.\f + \fr 18:30 \ft yourselves: or, others \f* 
\p
\v 31 [Cast away]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8685”} \w from you all your transgressions| strong="H6588" \w*, [whereby ye have transgressed]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8804”}; [and make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} \w you a new| strong="H2319" \w* \w heart| strong="H3820" \w* \w and a new| strong="H2319" \w* \w spirit| strong="H7307" \w*: [for why will ye die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, \w O house| strong="H1004" \w* \w of Israel| strong="H3478" \w*? 
\v 32 [For I have no pleasure]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the death| strong="H4194" \w* [of him that dieth]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*: [wherefore turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”} yourselves, [and live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8798”} ye.\f + \fr 18:32 \ft yourselves: or, others \f*
\c 19
\p 
\v 1 [Moreover take thou up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w a lamentation| strong="H7015" \w* \w for the princes| strong="H5387" \w* \w of Israel| strong="H3478" \w*, 
\v 2 [And say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, What is \w thy mother| strong="H517" \w*? \w A lioness| strong="H3833" \w*: [she lay down]{strong=“H7257” x-morph=“strongMorph: \sc Th\sc*8804”} \w among lions| strong="H738" \w*, [she nourished]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8765”} \w her whelps| strong="H1482" \w* \w among| strong="H8432" \w* \w young lions| strong="H3715" \w*. 
\v 3 [And she brought up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w one| strong="H259" \w* \w of her whelps| strong="H1482" \w*: \w it became a young lion| strong="H3715" \w*, [and it learned]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8799”} [to catch]{strong=“H2963” x-morph=“strongMorph: \sc Th\sc*8800”} \w the prey| strong="H2964" \w*; [it devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w men| strong="H120" \w*. 
\v 4 \w The nations| strong="H1471" \w* [also heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [of him; he was taken]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8738”} \w in their pit| strong="H7845" \w*, [and they brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w him with chains| strong="H2397" \w* \w unto the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*. 
\v 5 [Now when she saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [that she had waited]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8738”}, and \w her hope| strong="H8615" \w* [was lost]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”}, [then she took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w another| strong="H259" \w* \w of her whelps| strong="H1482" \w*, and [made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w him a young lion| strong="H3715" \w*. 
\v 6 [And he went up and down]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8691”} \w among| strong="H8432" \w* \w the lions| strong="H738" \w*, \w he became a young lion| strong="H3715" \w*, [and learned]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8799”} [to catch]{strong=“H2963” x-morph=“strongMorph: \sc Th\sc*8800”} \w the prey| strong="H2964" \w*, and [devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w men| strong="H120" \w*. 
\v 7 [And he knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w their desolate palaces| strong="H490" \w*, [and he laid waste]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8689”} \w their cities| strong="H5892" \w*; \w and the land| strong="H776" \w* [was desolate]{strong=“H3456” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the fulness| strong="H4393" \w* [thereof, by the noise]{strong=“H6963”} \w of his roaring| strong="H7581" \w*.\f + \fr 19:7 \ft their desolate…: or, their widows \f* \f + \fr 19:7 \ft the fulness…: or, all it containeth \f* 
\v 8 \w Then the nations| strong="H1471" \w* [set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w against him on every side| strong="H5439" \w* \w from the provinces| strong="H4082" \w*, [and spread]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8799”} \w their net| strong="H7568" \w* [over him: he was taken]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8738”} \w in their pit| strong="H7845" \w*. 
\v 9 [And they put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w him in ward| strong="H5474" \w* \w in chains| strong="H2397" \w*, [and brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w him to the king| strong="H4428" \w* \w of Babylon| strong="H894" \w*: [they brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w him into holds| strong="H4685" \w*, \w that his voice| strong="H6963" \w* [should no more be heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8735”} \w upon the mountains| strong="H2022" \w* \w of Israel| strong="H3478" \w*.\f + \fr 19:9 \ft in chains: or, in hooks \f* 
\p
\v 10 \w Thy mother| strong="H517" \w* is \w like a vine| strong="H1612" \w* [in thy blood]{strong=“H1818 H1818” x-morph=“strongMorph: \sc Th\sc*8676”}, [planted]{strong=“H8362” x-morph=“strongMorph: \sc Th\sc*8803”} \w by the waters| strong="H4325" \w*: [she was fruitful]{strong=“H6509” x-morph=“strongMorph: \sc Th\sc*8802”} \w and full of branches| strong="H6058" \w* \w by reason of many| strong="H7227" \w* \w waters| strong="H4325" \w*.\f + \fr 19:10 \ft in…: or, in thy quietness, or, in thy likeness \f* 
\v 11 \w And she had strong| strong="H5797" \w* \w rods| strong="H4294" \w* \w for the sceptres| strong="H7626" \w* [of them that bare rule]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and her stature| strong="H6967" \w* [was exalted]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8799”} \w among the thick branches| strong="H5688" \w*, [and she appeared]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8735”} \w in her height| strong="H1363" \w* \w with the multitude| strong="H7230" \w* \w of her branches| strong="H1808" \w*. 
\v 12 [But she was plucked up]{strong=“H5428” x-morph=“strongMorph: \sc Th\sc*8714”} \w in fury| strong="H2534" \w*, [she was cast down]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8717”} \w to the ground| strong="H776" \w*, \w and the east| strong="H6921" \w* \w wind| strong="H7307" \w* [dried up]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”} \w her fruit| strong="H6529" \w*: \w her strong| strong="H5797" \w* \w rods| strong="H4294" \w* [were broken]{strong=“H6561” x-morph=“strongMorph: \sc Th\sc*8694”} [and withered]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8804”}; \w the fire| strong="H784" \w* [consumed]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} them. 
\v 13 And now she is [planted]{strong=“H8362” x-morph=“strongMorph: \sc Th\sc*8803”} \w in the wilderness| strong="H4057" \w*, \w in a dry| strong="H6723" \w* \w and thirsty| strong="H6772" \w* \w ground| strong="H776" \w*. 
\v 14 \w And fire| strong="H784" \w* [is gone out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w of a rod| strong="H4294" \w* \w of her branches| strong="H905" \w*, which [hath devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w her fruit| strong="H6529" \w*, \w so that she hath no strong| strong="H5797" \w* \w rod| strong="H4294" \w* to be \w a sceptre| strong="H7626" \w* [to rule]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8800”}. This is \w a lamentation| strong="H7015" \w*, \w and shall be for a lamentation| strong="H7015" \w*.
\c 20
\p 
\v 1 \w And it came to pass in the seventh| strong="H7637" \w* \w year| strong="H8141" \w*, \w in the fifth| strong="H2549" \w* month, \w the tenth| strong="H6218" \w* day \w of the month| strong="H2320" \w*, that \w certain| strong="H582" \w* \w of the elders| strong="H2205" \w* \w of Israel| strong="H3478" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to enquire]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8800”} of the \sc Lord\sc*, [and sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* me. 
\v 2 \w Then came the word| strong="H1697" \w* of the \sc Lord\sc* [unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 3 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w unto the elders| strong="H2205" \w* \w of Israel| strong="H3478" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Are ye come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [to enquire]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8800”} of me? As \w I live| strong="H2416" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, [I will not be enquired]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8735”} of by you. 
\v 4 [Wilt thou judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} [them, son]{strong=“H1121”} \w of man| strong="H120" \w*, [wilt thou judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} them? [cause them to know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8685”} \w the abominations| strong="H8441" \w* \w of their fathers| strong="H1" \w*:\f + \fr 20:4 \ft Wilt…: or, Wilt thou plead for them \f* 
\p
\v 5 [And say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w In the day| strong="H3117" \w* [when I chose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8800”} \w Israel| strong="H3478" \w*, [and lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w mine hand| strong="H3027" \w* \w unto the seed| strong="H2233" \w* \w of the house| strong="H1004" \w* \w of Jacob| strong="H3290" \w*, [and made myself known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8735”} \w unto them in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, [when I lifted]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w up mine hand| strong="H3027" \w* [unto them, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, I am the \sc Lord\sc* \w your God| strong="H430" \w*;\f + \fr 20:5 \ft lifted…: or, sware \f* 
\v 6 \w In the day| strong="H3117" \w* that [I lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine hand| strong="H3027" \w* [unto them, to bring them forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8687”} \w of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* \w into a land| strong="H776" \w* [that I had espied]{strong=“H8446” x-morph=“strongMorph: \sc Th\sc*8804”} [for them, flowing]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”} \w with milk| strong="H2461" \w* \w and honey| strong="H1706" \w*, which is \w the glory| strong="H6643" \w* \w of all lands| strong="H776" \w*: 
