\v 4 [And I will turn thee back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8790”}, [and put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w hooks| strong="H2397" \w* \w into thy jaws| strong="H3895" \w*, [and I will bring thee forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”}, \w and all thine army| strong="H2428" \w*, \w horses| strong="H5483" \w* \w and horsemen| strong="H6571" \w*, [all of them clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8803”} \w with all sorts| strong="H4358" \w* of armour, even \w a great| strong="H7227" \w* \w company| strong="H6951" \w* with \w bucklers| strong="H6793" \w* \w and shields| strong="H4043" \w*, [all of them handling]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8802”} \w swords| strong="H2719" \w*: 
\v 5 \w Persia| strong="H6539" \w*, \w Ethiopia| strong="H3568" \w*, \w and Libya| strong="H6316" \w* [with them; all of them with shield]{strong=“H4043”} \w and helmet| strong="H3553" \w*:\f + \fr 38:5 \ft Libya: or, Phut \f* 
\v 6 \w Gomer| strong="H1586" \w*, \w and all his bands| strong="H102" \w*; \w the house| strong="H1004" \w* \w of Togarmah| strong="H8425" \w* \w of the north| strong="H6828" \w* \w quarters| strong="H3411" \w*, \w and all his bands| strong="H102" \w*: and \w many| strong="H7227" \w* \w people| strong="H5971" \w* with thee. 
\v 7 [Be thou prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8734”}, [and prepare]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8685”} [for thyself, thou, and all thy company]{strong=“H6951”} [that are assembled]{strong=“H6950” x-morph=“strongMorph: \sc Th\sc*8737”} [unto thee, and be thou a guard]{strong=“H4929”} unto them. 
\p
\v 8 \w After many| strong="H7227" \w* \w days| strong="H3117" \w* [thou shalt be visited]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8735”}: \w in the latter| strong="H319" \w* \w years| strong="H8141" \w* [thou shalt come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the land| strong="H776" \w* that is [brought back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8796”} \w from the sword| strong="H2719" \w*, and is [gathered]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8794”} \w out of many| strong="H7227" \w* \w people| strong="H5971" \w*, \w against the mountains| strong="H2022" \w* \w of Israel| strong="H3478" \w*, \w which have been always| strong="H8548" \w* \w waste| strong="H2723" \w*: [but it is brought forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8717”} \w out of the nations| strong="H5971" \w*, [and they shall dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w safely| strong="H983" \w* all of them. 
\v 9 [Thou shalt ascend]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} [and come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w like a storm| strong="H7722" \w*, \w thou shalt be like a cloud| strong="H6051" \w* [to cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8763”} \w the land| strong="H776" \w*, [thou, and all thy bands]{strong=“H102”}, \w and many| strong="H7227" \w* \w people| strong="H5971" \w* with thee. 
\v 10 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; It shall also come to pass, that \w at the same time| strong="H3117" \w* \w shall things| strong="H1697" \w* [come]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w into thy mind| strong="H3824" \w*, [and thou shalt think]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8804”} \w an evil| strong="H7451" \w* \w thought| strong="H4284" \w*:\f + \fr 38:10 \ft think…: or, conceive a mischievous purpose \f* 
\v 11 [And thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [I will go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the land| strong="H776" \w* \w of unwalled villages| strong="H6519" \w*; [I will go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [to them that are at rest]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8802”}, [that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w safely| strong="H983" \w*, [all of them dwelling]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w without walls| strong="H2346" \w*, \w and having neither bars| strong="H1280" \w* \w nor gates| strong="H1817" \w*,\f + \fr 38:11 \ft safely: or, confidently \f* 
\v 12 [To take]{strong=“H7997” x-morph=“strongMorph: \sc Th\sc*8800”} \w a spoil| strong="H7998" \w*, [and to take]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8800”} \w a prey| strong="H957" \w*; [to turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} \w thine hand| strong="H3027" \w* \w upon the desolate places| strong="H2723" \w* that are now [inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8737”}, \w and upon the people| strong="H5971" \w* that are [gathered]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8794”} \w out of the nations| strong="H1471" \w*, [which have gotten]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w cattle| strong="H4735" \w* \w and goods| strong="H7075" \w*, [that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the midst| strong="H2872" \w* \w of the land| strong="H776" \w*.\f + \fr 38:12 \ft To take…: Heb. To spoil the spoil, and to prey the prey \f* \f + \fr 38:12 \ft midst: Heb. navel \f* 
\v 13 \w Sheba| strong="H7614" \w*, \w and Dedan| strong="H1719" \w*, [and the merchants]{strong=“H5503” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Tarshish| strong="H8659" \w*, \w with all the young lions| strong="H3715" \w* [thereof, shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee, Art thou come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [to take]{strong=“H7997” x-morph=“strongMorph: \sc Th\sc*8800”} \w a spoil| strong="H7998" \w*? [hast thou gathered]{strong=“H6950” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy company| strong="H6951" \w* [to take]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8800”} \w a prey| strong="H957" \w*? [to carry away]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8800”} \w silver| strong="H3701" \w* \w and gold| strong="H2091" \w*, [to take away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} \w cattle| strong="H4735" \w* \w and goods| strong="H7075" \w*, [to take]{strong=“H7997” x-morph=“strongMorph: \sc Th\sc*8800”} \w a great| strong="H1419" \w* \w spoil| strong="H7998" \w*? 
\p
\v 14 [Therefore, son]{strong=“H1121”} \w of man| strong="H120" \w*, [prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto Gog| strong="H1463" \w*, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w In that day| strong="H3117" \w* \w when my people| strong="H5971" \w* \w of Israel| strong="H3478" \w* [dwelleth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} \w safely| strong="H983" \w*, [shalt thou not know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} it? 
\v 15 [And thou shalt come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w from thy place| strong="H4725" \w* \w out of the north| strong="H6828" \w* \w parts| strong="H3411" \w*, [thou, and many]{strong=“H7227”} \w people| strong="H5971" \w* [with thee, all of them riding]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon horses| strong="H5483" \w*, \w a great| strong="H1419" \w* \w company| strong="H6951" \w*, \w and a mighty| strong="H7227" \w* \w army| strong="H2428" \w*: 
\v 16 [And thou shalt come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w against my people| strong="H5971" \w* \w of Israel| strong="H3478" \w*, \w as a cloud| strong="H6051" \w* [to cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8763”} \w the land| strong="H776" \w*; \w it shall be in the latter| strong="H319" \w* \w days| strong="H3117" \w*, [and I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee against my land| strong="H776" \w*, \w that the heathen| strong="H1471" \w* [may know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} [me, when I shall be sanctified]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8736”} [in thee, O Gog]{strong=“H1463”}, \w before their eyes| strong="H5869" \w*. 
\v 17 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; Art [thou he of whom I have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w in old| strong="H6931" \w* \w time| strong="H3117" \w* \w by| strong="H3027" \w* \w my servants| strong="H5650" \w* \w the prophets| strong="H5030" \w* \w of Israel| strong="H3478" \w*, [which prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8737”} \w in those days| strong="H3117" \w* many \w years| strong="H8141" \w* [that I would bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} thee against them?\f + \fr 38:17 \ft by: Heb. by the hand of \f* 
\v 18 \w And it shall come to pass at the same time| strong="H3117" \w* \w when| strong="H3117" \w* \w Gog| strong="H1463" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w against the land| strong="H127" \w* \w of Israel| strong="H3478" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, that \w my fury| strong="H2534" \w* [shall come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w in my face| strong="H639" \w*. 
\v 19 \w For in my jealousy| strong="H7068" \w* and \w in the fire| strong="H784" \w* \w of my wrath| strong="H5678" \w* [have I spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}, \w Surely in that day| strong="H3117" \w* \w there shall be a great| strong="H1419" \w* \w shaking| strong="H7494" \w* \w in the land| strong="H127" \w* \w of Israel| strong="H3478" \w*; 
\v 20 \w So that the fishes| strong="H1709" \w* \w of the sea| strong="H3220" \w*, \w and the fowls| strong="H5775" \w* \w of the heaven| strong="H8064" \w*, \w and the beasts| strong="H2416" \w* \w of the field| strong="H7704" \w*, \w and all creeping things| strong="H7431" \w* [that creep]{strong=“H7430” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the earth| strong="H127" \w*, \w and all the men| strong="H120" \w* that are \w upon the face| strong="H6440" \w* \w of the earth| strong="H127" \w*, [shall shake]{strong=“H7493” x-morph=“strongMorph: \sc Th\sc*8804”} \w at my presence| strong="H6440" \w*, \w and the mountains| strong="H2022" \w* [shall be thrown down]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and the steep places| strong="H4095" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and every wall| strong="H2346" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the ground| strong="H776" \w*.\f + \fr 38:20 \ft steep…: or, towers, or, stairs \f* 
\v 21 [And I will call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w for a sword| strong="H2719" \w* \w against him throughout all my mountains| strong="H2022" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*: [every man’s]{strong=“H376”} \w sword| strong="H2719" \w* \w shall be against his brother| strong="H251" \w*. 
\v 22 [And I will plead]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8738”} \w against him with pestilence| strong="H1698" \w* \w and with blood| strong="H1818" \w*; [and I will rain]{strong=“H4305” x-morph=“strongMorph: \sc Th\sc*8686”} [upon him, and upon his bands]{strong=“H102”}, \w and upon the many| strong="H7227" \w* \w people| strong="H5971" \w* that are [with him, an overflowing]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8802”} \w rain| strong="H1653" \w*, [and great hailstones]{strong=“H68 H417”}, \w fire| strong="H784" \w*, \w and brimstone| strong="H1614" \w*. 
\v 23 [Thus will I magnify]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8694”} [myself, and sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8694”} [myself; and I will be known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the eyes| strong="H5869" \w* \w of many| strong="H7227" \w* \w nations| strong="H1471" \w*, [and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*.
\c 39
\p 
\v 1 [Therefore, thou son]{strong=“H1121”} \w of man| strong="H120" \w*, [prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} \w against Gog| strong="H1463" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; Behold, I am [against thee, O Gog]{strong=“H1463”}, \w the chief| strong="H7218" \w* \w prince| strong="H5387" \w* \w of Meshech| strong="H4902" \w* \w and Tubal| strong="H8422" \w*: 
\v 2 [And I will turn thee back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8790”}, [and leave but the sixth part]{strong=“H8338” x-morph=“strongMorph: \sc Th\sc*8765”} [of thee, and will cause thee to come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} \w from the north| strong="H6828" \w* \w parts| strong="H3411" \w*, [and will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee upon the mountains| strong="H2022" \w* \w of Israel| strong="H3478" \w*:\f + \fr 39:2 \ft leave…: or, strike thee with six plagues: or, draw thee back with an hook of six teeth \f* \f + \fr 39:2 \ft the north…: Heb. the sides of the north \f* 
\v 3 [And I will smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy bow| strong="H7198" \w* \w out of thy left| strong="H8040" \w* \w hand| strong="H3027" \w*, \w and will cause thine arrows| strong="H2671" \w* [to fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8686”} \w out of thy right| strong="H3225" \w* \w hand| strong="H3027" \w*. 
\v 4 [Thou shalt fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the mountains| strong="H2022" \w* \w of Israel| strong="H3478" \w*, [thou, and all thy bands]{strong=“H102”}, \w and the people| strong="H5971" \w* that is [with thee: I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee unto the ravenous| strong="H5861" \w* \w birds| strong="H6833" \w* \w of every sort| strong="H3671" \w*, and to \w the beasts| strong="H2416" \w* \w of the field| strong="H7704" \w* \w to be devoured| strong="H402" \w*.\f + \fr 39:4 \ft sort: Heb. wing \f* \f + \fr 39:4 \ft to be…: Heb. to devour \f* 
\v 5 [Thou shalt fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the open| strong="H6440" \w* \w field| strong="H7704" \w*: [for I have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*.\f + \fr 39:5 \ft the open…: Heb. the face of the field \f* 
\v 6 [And I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w a fire| strong="H784" \w* \w on Magog| strong="H4031" \w*, [and among them that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w carelessly| strong="H983" \w* \w in the isles| strong="H339" \w*: [and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*.\f + \fr 39:6 \ft carelessly: or, confidently \f* 
\v 7 \w So will I make my holy| strong="H6944" \w* \w name| strong="H8034" \w* [known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8686”} \w in the midst| strong="H8432" \w* \w of my people| strong="H5971" \w* \w Israel| strong="H3478" \w*; and I will not let them [pollute]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8686”} \w my holy| strong="H6944" \w* \w name| strong="H8034" \w* [any more: and the heathen]{strong=“H1471”} [shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*, \w the Holy One| strong="H6918" \w* \w in Israel| strong="H3478" \w*. 
\p
\v 8 [Behold, it is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, [and it is done]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8738”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*; this is \w the day| strong="H3117" \w* [whereof I have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 9 [And they that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the cities| strong="H5892" \w* \w of Israel| strong="H3478" \w* [shall go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”}, [and shall set]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8765”} \w on fire| strong="H784" \w* [and burn]{strong=“H5400” x-morph=“strongMorph: \sc Th\sc*8689”} \w the weapons| strong="H5402" \w*, \w both the shields| strong="H4043" \w* \w and the bucklers| strong="H6793" \w*, \w the bows| strong="H7198" \w* \w and the arrows| strong="H2671" \w*, [and the handstaves]{strong=“H4731 H3027”}, \w and the spears| strong="H7420" \w*, [and they shall burn]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8765”} \w them with fire| strong="H784" \w* \w seven| strong="H7651" \w* \w years| strong="H8141" \w*:\f + \fr 39:9 \ft handstaves: or, javelins \f* \f + \fr 39:9 \ft burn them…: or, make a fire of them \f* 
\v 10 [So that they shall take]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w no wood| strong="H6086" \w* \w out of the field| strong="H7704" \w*, [neither cut down]{strong=“H2404” x-morph=“strongMorph: \sc Th\sc*8799”} any \w out of the forests| strong="H3293" \w*; [for they shall burn]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8762”} \w the weapons| strong="H5402" \w* \w with fire| strong="H784" \w*: [and they shall spoil]{strong=“H7997” x-morph=“strongMorph: \sc Th\sc*8804”} [those that spoiled]{strong=“H7997” x-morph=“strongMorph: \sc Th\sc*8802”} [them, and rob]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8804”} [those that robbed]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8802”} [them, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\p
\v 11 \w And it shall come to pass in that day| strong="H3117" \w*, that [I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Gog| strong="H1463" \w* \w a place| strong="H4725" \w* \w there of graves| strong="H6913" \w* \w in Israel| strong="H3478" \w*, \w the valley| strong="H1516" \w* [of the passengers]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} \w on the east| strong="H6926" \w* \w of the sea| strong="H3220" \w*: [and it shall stop]{strong=“H2629” x-morph=“strongMorph: \sc Th\sc*8802”} the noses [of the passengers]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”}: [and there shall they bury]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8804”} \w Gog| strong="H1463" \w* \w and all his multitude| strong="H1995" \w*: [and they shall call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} it \w The valley| strong="H1516" \w* [of Hamon-gog]{strong=“H1996”}.\f + \fr 39:11 \ft noses: or, mouths \f* \f + \fr 39:11 \ft Hamon-gog: that is, The multitude of Gog \f* 
\v 12 \w And seven| strong="H7651" \w* \w months| strong="H2320" \w* \w shall the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* [be burying]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8804”} [of them, that they may cleanse]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8763”} \w the land| strong="H776" \w*. 
\v 13 [Yea, all the people]{strong=“H5971”} \w of the land| strong="H776" \w* [shall bury]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8804”} them; \w and it shall be to them a renown| strong="H8034" \w* \w the day| strong="H3117" \w* [that I shall be glorified]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8736”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\v 14 [And they shall sever out]{strong=“H914” x-morph=“strongMorph: \sc Th\sc*8686”} \w men| strong="H582" \w* \w of continual employment| strong="H8548" \w*, [passing through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} \w the land| strong="H776" \w* [to bury]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8764”} [with the passengers]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} [those that remain]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8737”} \w upon the face| strong="H6440" \w* \w of the earth| strong="H776" \w*, [to cleanse]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8763”} [it: after the end]{strong=“H7097”} \w of seven| strong="H7651" \w* \w months| strong="H2320" \w* [shall they search]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 39:14 \ft men…: Heb. men of continuance \f* 
\v 15 [And the passengers]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} that [pass through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w the land| strong="H776" \w*, when any [seeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} [a man’s]{strong=“H120”} \w bone| strong="H6106" \w*, [then shall he set up]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w a sign| strong="H6725" \w* \w by| strong="H681" \w* [it, till the buriers]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8764”} [have buried]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8804”} \w it in the valley| strong="H1516" \w* [of Hamon-gog]{strong=“H1996”}.\f + \fr 39:15 \ft set up: Heb. build \f* 
\v 16 \w And also the name| strong="H8034" \w* \w of the city| strong="H5892" \w* shall be \w Hamonah| strong="H1997" \w*. [Thus shall they cleanse]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8765”} \w the land| strong="H776" \w*.\f + \fr 39:16 \ft Hamonah: that is, The multitude \f* 
\p
