\c 44
\p 
\v 1 [Then he brought me back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w the way| strong="H1870" \w* \w of the gate| strong="H8179" \w* \w of the outward| strong="H2435" \w* \w sanctuary| strong="H4720" \w* [which looketh]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8802”} \w toward the east| strong="H6921" \w*; and it was [shut]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8803”}. 
