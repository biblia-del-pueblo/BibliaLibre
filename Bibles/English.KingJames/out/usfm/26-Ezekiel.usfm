\v 31 [Then shall ye remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w your own evil| strong="H7451" \w* \w ways| strong="H1870" \w*, \w and your doings| strong="H4611" \w* that were \w not good| strong="H2896" \w*, [and shall lothe]{strong=“H6962” x-morph=“strongMorph: \sc Th\sc*8738”} \w yourselves in your own sight| strong="H6440" \w* \w for your iniquities| strong="H5771" \w* \w and for your abominations| strong="H8441" \w*. 
\v 32 [Not for your sakes do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} I this, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, [be it known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8735”} [unto you: be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8798”} [and confounded]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8734”} \w for your own ways| strong="H1870" \w*, \w O house| strong="H1004" \w* \w of Israel| strong="H3478" \w*. 
\v 33 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w In the day| strong="H3117" \w* [that I shall have cleansed]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8763”} \w you from all your iniquities| strong="H5771" \w* I will also cause you [to dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8689”} \w in the cities| strong="H5892" \w*, \w and the wastes| strong="H2723" \w* [shall be builded]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8738”}. 
