\v 17 [And join]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8761”} \w them one| strong="H259" \w* \w to another| strong="H259" \w* \w into one| strong="H259" \w* \w stick| strong="H6086" \w*; \w and they shall become one| strong="H259" \w* \w in thine hand| strong="H3027" \w*. 
\p
