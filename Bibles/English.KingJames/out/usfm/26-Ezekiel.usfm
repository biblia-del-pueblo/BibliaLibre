\v 23 [And I will sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8765”} \w my great| strong="H1419" \w* \w name| strong="H8034" \w*, [which was profaned]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8794”} \w among the heathen| strong="H1471" \w*, [which ye have profaned]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8765”} \w in the midst| strong="H8432" \w* [of them; and the heathen]{strong=“H1471”} [shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, [when I shall be sanctified]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8736”} \w in you before their eyes| strong="H5869" \w*.\f + \fr 36:23 \ft their: or, your \f* 
\v 24 [For I will take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w you from among| strong="H4480" \w* \w the heathen| strong="H1471" \w*, [and gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8765”} \w you out of all countries| strong="H776" \w*, [and will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w you into your own land| strong="H127" \w*. 
\p
\v 25 [Then will I sprinkle]{strong=“H2236” x-morph=“strongMorph: \sc Th\sc*8804”} \w clean| strong="H2889" \w* \w water| strong="H4325" \w* [upon you, and ye shall be clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8804”}: \w from all your filthiness| strong="H2932" \w*, \w and from all your idols| strong="H1544" \w*, [will I cleanse]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8762”} you. 
