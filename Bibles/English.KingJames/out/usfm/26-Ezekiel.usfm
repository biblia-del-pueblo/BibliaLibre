\c 47
\p 
\v 1 [Afterward he brought me again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto the door| strong="H6607" \w* \w of the house| strong="H1004" \w*; [and, behold, waters]{strong=“H4325”} [issued out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} \w from under the threshold| strong="H4670" \w* \w of the house| strong="H1004" \w* \w eastward| strong="H6921" \w*: \w for the forefront| strong="H6440" \w* \w of the house| strong="H1004" \w* stood toward \w the east| strong="H6921" \w*, \w and the waters| strong="H4325" \w* [came down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w from under from the right| strong="H3233" \w* \w side| strong="H3802" \w* \w of the house| strong="H1004" \w*, \w at the south| strong="H5045" \w* side \w of the altar| strong="H4196" \w*. 
