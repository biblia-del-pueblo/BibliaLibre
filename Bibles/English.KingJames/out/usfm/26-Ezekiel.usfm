\v 8 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [he unto me, These waters]{strong=“H4325”} [issue out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} \w toward the east| strong="H6930" \w* \w country| strong="H1552" \w*, [and go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the desert| strong="H6160" \w*, [and go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the sea| strong="H3220" \w*: which being [brought forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8716”} \w into the sea| strong="H3220" \w*, \w the waters| strong="H4325" \w* [shall be healed]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8738”}.\f + \fr 47:8 \ft desert: or, plain \f* 
\v 9 And it shall come to pass, that \w every thing| strong="H5315" \w* \w that liveth| strong="H2416" \w*, [which moveth]{strong=“H8317” x-morph=“strongMorph: \sc Th\sc*8799”}, \w whithersoever the rivers| strong="H5158" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [shall live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}: \w and there shall be a very| strong="H3966" \w* \w great| strong="H7227" \w* \w multitude of fish| strong="H1710" \w*, \w because these waters| strong="H4325" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [thither: for they shall be healed]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8735”}; [and every thing shall live]{strong=“H2425” x-morph=“strongMorph: \sc Th\sc*8804”} \w whither the river| strong="H5158" \w* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 47:9 \ft rivers: Heb. two rivers \f* 
