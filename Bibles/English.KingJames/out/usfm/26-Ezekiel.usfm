\v 12 [And strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”}, \w the terrible| strong="H6184" \w* \w of the nations| strong="H1471" \w*, [have cut him off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”}, [and have left]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8799”} [him: upon the mountains]{strong=“H2022”} \w and in all the valleys| strong="H1516" \w* \w his branches| strong="H1808" \w* [are fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and his boughs| strong="H6288" \w* [are broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8735”} \w by all the rivers| strong="H650" \w* \w of the land| strong="H776" \w*; \w and all the people| strong="H5971" \w* \w of the earth| strong="H776" \w* [are gone down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w from his shadow| strong="H6738" \w*, [and have left]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8799”} him. 
\v 13 \w Upon his ruin| strong="H4658" \w* \w shall all the fowls| strong="H5775" \w* \w of the heaven| strong="H8064" \w* [remain]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and all the beasts| strong="H2416" \w* \w of the field| strong="H7704" \w* \w shall be upon his branches| strong="H6288" \w*: 
\v 14 \w To the end that none of all the trees| strong="H6086" \w* \w by the waters| strong="H4325" \w* [exalt]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8799”} \w themselves for their height| strong="H6967" \w*, [neither shoot up]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w their top| strong="H6788" \w* \w among the thick boughs| strong="H5688" \w*, \w neither their trees| strong="H352" \w* [stand up]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w in their height| strong="H1363" \w*, [all that drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8802”} \w water| strong="H4325" \w*: [for they are all delivered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto death| strong="H4194" \w*, \w to the nether parts| strong="H8482" \w* \w of the earth| strong="H776" \w*, \w in the midst| strong="H8432" \w* \w of the children| strong="H1121" \w* \w of men| strong="H120" \w*, [with them that go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the pit| strong="H953" \w*.\f + \fr 31:14 \ft their trees…: or, stand upon themselves for their height \f* 
\v 15 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w In the day| strong="H3117" \w* [when he went down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8800”} \w to the grave| strong="H7585" \w* [I caused a mourning]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8689”}: [I covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”} \w the deep| strong="H8415" \w* [for him, and I restrained]{strong=“H4513” x-morph=“strongMorph: \sc Th\sc*8799”} \w the floods| strong="H5104" \w* [thereof, and the great]{strong=“H7227”} \w waters| strong="H4325" \w* [were stayed]{strong=“H3607” x-morph=“strongMorph: \sc Th\sc*8735”}: \w and I caused Lebanon| strong="H3844" \w* [to mourn]{strong=“H6937” x-morph=“strongMorph: \sc Th\sc*8686”} [for him, and all the trees]{strong=“H6086”} \w of the field| strong="H7704" \w* \w fainted| strong="H5969" \w* for him.\f + \fr 31:15 \ft to mourn: Heb. to be black \f* 
\v 16 \w I made the nations| strong="H1471" \w* [to shake]{strong=“H7493” x-morph=“strongMorph: \sc Th\sc*8689”} \w at the sound| strong="H6963" \w* \w of his fall| strong="H4658" \w*, [when I cast him down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8687”} \w to hell| strong="H7585" \w* [with them that descend]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w into the pit| strong="H953" \w*: \w and all the trees| strong="H6086" \w* \w of Eden| strong="H5731" \w*, \w the choice| strong="H4005" \w* \w and best| strong="H2896" \w* \w of Lebanon| strong="H3844" \w*, [all that drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8802”} \w water| strong="H4325" \w*, [shall be comforted]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the nether parts| strong="H8482" \w* \w of the earth| strong="H776" \w*. 
\v 17 [They also went down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} \w into hell| strong="H7585" \w* with him unto them that be \w slain| strong="H2491" \w* \w with the sword| strong="H2719" \w*; and they that were \w his arm| strong="H2220" \w*, that [dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w under his shadow| strong="H6738" \w* \w in the midst| strong="H8432" \w* \w of the heathen| strong="H1471" \w*. 
\p
\v 18 [To whom art thou thus like]{strong=“H1819” x-morph=“strongMorph: \sc Th\sc*8804”} \w in glory| strong="H3519" \w* \w and in greatness| strong="H1433" \w* \w among the trees| strong="H6086" \w* \w of Eden| strong="H5731" \w*? [yet shalt thou be brought down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8717”} \w with the trees| strong="H6086" \w* \w of Eden| strong="H5731" \w* \w unto the nether parts| strong="H8482" \w* \w of the earth| strong="H776" \w*: [thou shalt lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the midst| strong="H8432" \w* \w of the uncircumcised| strong="H6189" \w* with them that be \w slain| strong="H2491" \w* \w by the sword| strong="H2719" \w*. This is \w Pharaoh| strong="H6547" \w* \w and all his multitude| strong="H1995" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\c 32
\p 
\v 1 [And it came to pass in the twelfth]{strong=“H6240 H8147”} \w year| strong="H8141" \w*, \w in the twelfth month| strong="H2320" \w*, \w in the first| strong="H259" \w* day \w of the month| strong="H2320" \w*, that \w the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [take up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w a lamentation| strong="H7015" \w* \w for Pharaoh| strong="H6547" \w* \w king| strong="H4428" \w* \w of Egypt| strong="H4714" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto him, Thou art like]{strong=“H1819” x-morph=“strongMorph: \sc Th\sc*8738”} \w a young lion| strong="H3715" \w* \w of the nations| strong="H1471" \w*, and thou art [as a whale]{strong=“H8565 H8577” x-morph=“strongMorph: \sc Th\sc*8676”} \w in the seas| strong="H3220" \w*: [and thou camest forth]{strong=“H1518” x-morph=“strongMorph: \sc Th\sc*8799”} \w with thy rivers| strong="H5104" \w*, [and troubledst]{strong=“H1804” x-morph=“strongMorph: \sc Th\sc*8799”} \w the waters| strong="H4325" \w* \w with thy feet| strong="H7272" \w*, [and fouledst]{strong=“H7515” x-morph=“strongMorph: \sc Th\sc*8799”} \w their rivers| strong="H5104" \w*.\f + \fr 32:2 \ft whale: or, dragon \f* 
\v 3 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [I will therefore spread out]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8804”} \w my net| strong="H7568" \w* \w over thee with a company| strong="H6951" \w* \w of many| strong="H7227" \w* \w people| strong="H5971" \w*; [and they shall bring thee up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} \w in my net| strong="H2764" \w*. 
\v 4 [Then will I leave]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee upon the land| strong="H776" \w*, [I will cast thee forth]{strong=“H2904” x-morph=“strongMorph: \sc Th\sc*8686”} \w upon the open| strong="H6440" \w* \w field| strong="H7704" \w*, \w and will cause all the fowls| strong="H5775" \w* \w of the heaven| strong="H8064" \w* [to remain]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8689”} [upon thee, and I will fill]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8689”} \w the beasts| strong="H2416" \w* \w of the whole earth| strong="H776" \w* with thee. 
\v 5 [And I will lay]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy flesh| strong="H1320" \w* \w upon the mountains| strong="H2022" \w*, [and fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8765”} \w the valleys| strong="H1516" \w* \w with thy height| strong="H7419" \w*. 
\v 6 [I will also water]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8689”} \w with thy blood| strong="H1818" \w* \w the land| strong="H776" \w* \w wherein thou swimmest| strong="H6824" \w*, even \w to the mountains| strong="H2022" \w*; \w and the rivers| strong="H650" \w* [shall be full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”} of thee.\f + \fr 32:6 \ft the land wherein…: or, the land of thy swimming \f* 
\v 7 [And when I shall put thee out]{strong=“H3518” x-morph=“strongMorph: \sc Th\sc*8763”}, [I will cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”} \w the heaven| strong="H8064" \w*, \w and make| strong="H6937" \w* \w the stars| strong="H3556" \w* [thereof dark]{strong=“H6937” x-morph=“strongMorph: \sc Th\sc*8689”}; [I will cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w the sun| strong="H8121" \w* \w with a cloud| strong="H6051" \w*, \w and the moon| strong="H3394" \w* [shall not give]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8686”} \w her light| strong="H216" \w*.\f + \fr 32:7 \ft put…: or, extinguish thee \f* 
\v 8 \w All the bright| strong="H3974" \w* \w lights| strong="H216" \w* \w of heaven| strong="H8064" \w* [will I make dark]{strong=“H6937” x-morph=“strongMorph: \sc Th\sc*8686”} [over thee, and set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w darkness| strong="H2822" \w* \w upon thy land| strong="H776" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*.\f + \fr 32:8 \ft bright…: Heb. lights of the light in heaven \f* \f + \fr 32:8 \ft dark: Heb. them dark \f* 
\v 9 [I will also vex]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8689”} \w the hearts| strong="H3820" \w* \w of many| strong="H7227" \w* \w people| strong="H5971" \w*, [when I shall bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} \w thy destruction| strong="H7667" \w* \w among the nations| strong="H1471" \w*, \w into the countries| strong="H776" \w* [which thou hast not known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 32:9 \ft vex: Heb. provoke to anger, or, grief \f* 
\v 10 [Yea, I will make many]{strong=“H7227”} \w people| strong="H5971" \w* [amazed]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8689”} [at thee, and their kings]{strong=“H4428”} \w shall be horribly| strong="H8178" \w* [afraid]{strong=“H8175” x-morph=“strongMorph: \sc Th\sc*8799”} [for thee, when I shall brandish]{strong=“H5774” x-morph=“strongMorph: \sc Th\sc*8788”} \w my sword| strong="H2719" \w* \w before them| strong="H6440" \w*; [and they shall tremble]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8804”} at every \w moment| strong="H7281" \w*, \w every man| strong="H376" \w* \w for his own life| strong="H5315" \w*, \w in the day| strong="H3117" \w* \w of thy fall| strong="H4658" \w*. 
\p
\v 11 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w The sword| strong="H2719" \w* \w of the king| strong="H4428" \w* \w of Babylon| strong="H894" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} upon thee. 
\v 12 \w By the swords| strong="H2719" \w* \w of the mighty| strong="H1368" \w* \w will I cause thy multitude| strong="H1995" \w* [to fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8686”}, \w the terrible| strong="H6184" \w* \w of the nations| strong="H1471" \w*, [all of them: and they shall spoil]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8804”} \w the pomp| strong="H1347" \w* \w of Egypt| strong="H4714" \w*, \w and all the multitude| strong="H1995" \w* [thereof shall be destroyed]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 13 [I will destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8689”} \w also all the beasts| strong="H929" \w* \w thereof from| strong="H5921" \w* \w beside the great| strong="H7227" \w* \w waters| strong="H4325" \w*; \w neither shall the foot| strong="H7272" \w* \w of man| strong="H120" \w* [trouble]{strong=“H1804” x-morph=“strongMorph: \sc Th\sc*8799”} [them any more, nor the hoofs]{strong=“H6541”} \w of beasts| strong="H929" \w* [trouble]{strong=“H1804” x-morph=“strongMorph: \sc Th\sc*8799”} them. 
\v 14 \w Then will I make their waters| strong="H4325" \w* [deep]{strong=“H8257” x-morph=“strongMorph: \sc Th\sc*8686”}, \w and cause their rivers| strong="H5104" \w* [to run]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8686”} \w like oil| strong="H8081" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\v 15 [When I shall make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* \w desolate| strong="H8077" \w*, \w and the country| strong="H776" \w* [shall be destitute]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8737”} \w of that whereof it was full| strong="H4393" \w*, [when I shall smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8687”} [all them that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} [therein, then shall they know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*.\f + \fr 32:15 \ft destitute…: Heb. desolate from the fulness thereof \f* 
\v 16 This is \w the lamentation| strong="H7015" \w* [wherewith they shall lament]{strong=“H6969” x-morph=“strongMorph: \sc Th\sc*8790”} [her: the daughters]{strong=“H1323”} \w of the nations| strong="H1471" \w* [shall lament]{strong=“H6969” x-morph=“strongMorph: \sc Th\sc*8787”} [her: they shall lament]{strong=“H6969” x-morph=“strongMorph: \sc Th\sc*8787”} for her, even \w for Egypt| strong="H4714" \w*, \w and for all her multitude| strong="H1995" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\p
\v 17 [It came to pass also in the twelfth]{strong=“H6240 H8147”} \w year| strong="H8141" \w*, [in the fifteenth]{strong=“H6240 H2568”} day \w of the month| strong="H2320" \w*, that \w the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 18 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [wail]{strong=“H5091” x-morph=“strongMorph: \sc Th\sc*8798”} \w for the multitude| strong="H1995" \w* \w of Egypt| strong="H4714" \w*, [and cast them down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8685”}, even [her, and the daughters]{strong=“H1323”} \w of the famous| strong="H117" \w* \w nations| strong="H1471" \w*, \w unto the nether parts| strong="H8482" \w* \w of the earth| strong="H776" \w*, [with them that go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w into the pit| strong="H953" \w*. 
\v 19 [Whom dost thou pass in beauty]{strong=“H5276” x-morph=“strongMorph: \sc Th\sc*8804”}? [go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8798”}, [and be thou laid]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8713”} \w with the uncircumcised| strong="H6189" \w*. 
\v 20 [They shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the midst| strong="H8432" \w* of them that are \w slain| strong="H2491" \w* \w by the sword| strong="H2719" \w*: [she is delivered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w to the sword| strong="H2719" \w*: [draw]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8798”} \w her and all her multitudes| strong="H1995" \w*.\f + \fr 32:20 \ft she…: or, the sword is laid \f* 
\v 21 \w The strong| strong="H410" \w* \w among the mighty| strong="H1368" \w* [shall speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w to him out of the midst| strong="H8432" \w* \w of hell| strong="H7585" \w* [with them that help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8802”} [him: they are gone down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”}, [they lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8804”} \w uncircumcised| strong="H6189" \w*, \w slain| strong="H2491" \w* \w by the sword| strong="H2719" \w*. 
\v 22 \w Asshur| strong="H804" \w* is \w there and all her company| strong="H6951" \w*: \w his graves| strong="H6913" \w* are \w about| strong="H5439" \w* [him: all of them slain]{strong=“H2491”}, [fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8802”} \w by the sword| strong="H2719" \w*: 
\v 23 \w Whose graves| strong="H6913" \w* [are set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the sides| strong="H3411" \w* \w of the pit| strong="H953" \w*, \w and her company| strong="H6951" \w* \w is round about| strong="H5439" \w* \w her grave| strong="H6900" \w*: \w all of them slain| strong="H2491" \w*, [fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8802”} \w by the sword| strong="H2719" \w*, [which caused]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w terror| strong="H2851" \w* \w in the land| strong="H776" \w* \w of the living| strong="H2416" \w*.\f + \fr 32:23 \ft terror: or, dismaying \f* 
\v 24 There is \w Elam| strong="H5867" \w* \w and all her multitude| strong="H1995" \w* \w round about| strong="H5439" \w* \w her grave| strong="H6900" \w*, \w all of them slain| strong="H2491" \w*, [fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8802”} \w by the sword| strong="H2719" \w*, [which are gone down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} \w uncircumcised| strong="H6189" \w* \w into the nether parts| strong="H8482" \w* \w of the earth| strong="H776" \w*, [which caused]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w their terror| strong="H2851" \w* \w in the land| strong="H776" \w* \w of the living| strong="H2416" \w*; [yet have they borne]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their shame| strong="H3639" \w* [with them that go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the pit| strong="H953" \w*. 
\v 25 [They have set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w her a bed| strong="H4904" \w* \w in the midst| strong="H8432" \w* \w of the slain| strong="H2491" \w* \w with all her multitude| strong="H1995" \w*: \w her graves| strong="H6913" \w* are \w round about| strong="H5439" \w* [him: all of them uncircumcised]{strong=“H6189”}, \w slain| strong="H2491" \w* \w by the sword| strong="H2719" \w*: \w though their terror| strong="H2851" \w* [was caused]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8737”} \w in the land| strong="H776" \w* \w of the living| strong="H2416" \w*, [yet have they borne]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their shame| strong="H3639" \w* [with them that go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the pit| strong="H953" \w*: [he is put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the midst| strong="H8432" \w* of them that be \w slain| strong="H2491" \w*. 
\v 26 There is \w Meshech| strong="H4902" \w*, \w Tubal| strong="H8422" \w*, \w and all her multitude| strong="H1995" \w*: \w her graves| strong="H6913" \w* are \w round about| strong="H5439" \w* [him: all of them uncircumcised]{strong=“H6189”}, [slain]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8794”} \w by the sword| strong="H2719" \w*, [though they caused]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w their terror| strong="H2851" \w* \w in the land| strong="H776" \w* \w of the living| strong="H2416" \w*. 
\v 27 [And they shall not lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the mighty| strong="H1368" \w* that are [fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the uncircumcised| strong="H6189" \w*, [which are gone down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} \w to hell| strong="H7585" \w* \w with their weapons| strong="H3627" \w* \w of war| strong="H4421" \w*: [and they have laid]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w their swords| strong="H2719" \w* \w under their heads| strong="H7218" \w*, \w but their iniquities| strong="H5771" \w* \w shall be upon their bones| strong="H6106" \w*, though they were \w the terror| strong="H2851" \w* \w of the mighty| strong="H1368" \w* \w in the land| strong="H776" \w* \w of the living| strong="H2416" \w*.\f + \fr 32:27 \ft with their…: Heb. with weapons of their war \f* 
\v 28 [Yea, thou shalt be broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the midst| strong="H8432" \w* \w of the uncircumcised| strong="H6189" \w*, [and shalt lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} with them that are \w slain| strong="H2491" \w* \w with the sword| strong="H2719" \w*. 
\v 29 There is \w Edom| strong="H123" \w*, \w her kings| strong="H4428" \w*, \w and all her princes| strong="H5387" \w*, \w which with their might| strong="H1369" \w* [are laid]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} by them that were \w slain| strong="H2491" \w* \w by the sword| strong="H2719" \w*: [they shall lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the uncircumcised| strong="H6189" \w*, [and with them that go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the pit| strong="H953" \w*.\f + \fr 32:29 \ft laid: Heb. given, or, put \f* 
\v 30 There be \w the princes| strong="H5257" \w* \w of the north| strong="H6828" \w*, [all of them, and all the Zidonians]{strong=“H6722”}, [which are gone down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} \w with the slain| strong="H2491" \w*; \w with their terror| strong="H2851" \w* [they are ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8802”} \w of their might| strong="H1369" \w*; [and they lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w uncircumcised| strong="H6189" \w* with them that be \w slain| strong="H2491" \w* \w by the sword| strong="H2719" \w*, [and bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their shame| strong="H3639" \w* [with them that go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the pit| strong="H953" \w*. 
\v 31 \w Pharaoh| strong="H6547" \w* [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and shall be comforted]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8738”} \w over all his multitude| strong="H1995" \w*, even \w Pharaoh| strong="H6547" \w* \w and all his army| strong="H2428" \w* \w slain| strong="H2491" \w* \w by the sword| strong="H2719" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\v 32 [For I have caused]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w my terror| strong="H2851" \w* \w in the land| strong="H776" \w* \w of the living| strong="H2416" \w*: [and he shall be laid]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8717”} \w in the midst| strong="H8432" \w* \w of the uncircumcised| strong="H6189" \w* with them that are \w slain| strong="H2491" \w* \w with the sword| strong="H2719" \w*, even \w Pharaoh| strong="H6547" \w* \w and all his multitude| strong="H1995" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*.
\c 33
\p 
\v 1 \w Again the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w to the children| strong="H1121" \w* \w of thy people| strong="H5971" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, When I bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w the sword| strong="H2719" \w* \w upon a land| strong="H776" \w*, \w if the people| strong="H5971" \w* \w of the land| strong="H776" \w* [take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w a| strong="H259" \w* \w man| strong="H376" \w* \w of their coasts| strong="H7097" \w*, [and set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [him for their watchman]{strong=“H6822” x-morph=“strongMorph: \sc Th\sc*8802”}:\f + \fr 33:2 \ft When…: Heb. A land when I bring a sword upon her \f* 
\v 3 [If when he seeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the sword| strong="H2719" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the land| strong="H776" \w*, [he blow]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8804”} \w the trumpet| strong="H7782" \w*, [and warn]{strong=“H2094” x-morph=“strongMorph: \sc Th\sc*8689”} \w the people| strong="H5971" \w*; 
\v 4 [Then whosoever]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} [heareth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the sound| strong="H6963" \w* \w of the trumpet| strong="H7782" \w*, [and taketh not warning]{strong=“H2094” x-morph=“strongMorph: \sc Th\sc*8737”}; \w if the sword| strong="H2719" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [and take him away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”}, \w his blood| strong="H1818" \w* \w shall be upon his own head| strong="H7218" \w*.\f + \fr 33:4 \ft whosoever…: Heb. he that hearing heareth \f* 
\v 5 [He heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the sound| strong="H6963" \w* \w of the trumpet| strong="H7782" \w*, [and took not warning]{strong=“H2094” x-morph=“strongMorph: \sc Th\sc*8737”}; \w his blood| strong="H1818" \w* [shall be upon him. But he that taketh warning]{strong=“H2094” x-morph=“strongMorph: \sc Th\sc*8737”} [shall deliver]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8765”} \w his soul| strong="H5315" \w*. 
\v 6 [But if the watchman]{strong=“H6822” x-morph=“strongMorph: \sc Th\sc*8802”} [see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the sword| strong="H2719" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}, [and blow]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the trumpet| strong="H7782" \w*, \w and the people| strong="H5971" \w* [be not warned]{strong=“H2094” x-morph=“strongMorph: \sc Th\sc*8737”}; \w if the sword| strong="H2719" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [and take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} any \w person| strong="H5315" \w* [from among them, he is taken away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8738”} \w in his iniquity| strong="H5771" \w*; \w but his blood| strong="H1818" \w* [will I require]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”} [at the watchman’s]{strong=“H6822” x-morph=“strongMorph: \sc Th\sc*8802”} \w hand| strong="H3027" \w*. 
\p
\v 7 [So thou, O son]{strong=“H1121”} \w of man| strong="H120" \w*, [I have set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [thee a watchman]{strong=“H6822” x-morph=“strongMorph: \sc Th\sc*8802”} \w unto the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*; [therefore thou shalt hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the word| strong="H1697" \w* \w at my mouth| strong="H6310" \w*, [and warn]{strong=“H2094” x-morph=“strongMorph: \sc Th\sc*8689”} them from me. 
\v 8 [When I say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto the wicked| strong="H7563" \w*, \w O wicked| strong="H7563" \w* man, [thou shalt surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}; [if thou dost not speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [to warn]{strong=“H2094” x-morph=“strongMorph: \sc Th\sc*8687”} \w the wicked| strong="H7563" \w* \w from his way| strong="H1870" \w*, \w that wicked| strong="H7563" \w* man [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his iniquity| strong="H5771" \w*; \w but his blood| strong="H1818" \w* [will I require]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w at thine hand| strong="H3027" \w*. 
\v 9 [Nevertheless, if thou warn]{strong=“H2094” x-morph=“strongMorph: \sc Th\sc*8689”} \w the wicked| strong="H7563" \w* \w of his way| strong="H1870" \w* [to turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} [from it; if he do not turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w from his way| strong="H1870" \w*, [he shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his iniquity| strong="H5771" \w*; [but thou hast delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy soul| strong="H5315" \w*. 
\p
\v 10 [Therefore, O thou son]{strong=“H1121”} \w of man| strong="H120" \w*, [speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*; [Thus ye speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w If our transgressions| strong="H6588" \w* \w and our sins| strong="H2403" \w* be [upon us, and we pine away]{strong=“H4743” x-morph=“strongMorph: \sc Th\sc*8737”} [in them, how should we then live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}? 
\v 11 [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} unto them, As \w I live| strong="H2416" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, [I have no pleasure]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the death| strong="H4194" \w* \w of the wicked| strong="H7563" \w*; \w but that the wicked| strong="H7563" \w* [turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w from his way| strong="H1870" \w* [and live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8804”}: [turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} [ye, turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye from your evil| strong="H7451" \w* \w ways| strong="H1870" \w*; [for why will ye die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, \w O house| strong="H1004" \w* \w of Israel| strong="H3478" \w*? 
\v 12 [Therefore, thou son]{strong=“H1121”} \w of man| strong="H120" \w*, [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto the children| strong="H1121" \w* \w of thy people| strong="H5971" \w*, \w The righteousness| strong="H6666" \w* \w of the righteous| strong="H6662" \w* [shall not deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w him in the day| strong="H3117" \w* \w of his transgression| strong="H6588" \w*: \w as for the wickedness| strong="H7564" \w* \w of the wicked| strong="H7563" \w*, [he shall not fall]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8735”} \w thereby in the day| strong="H3117" \w* [that he turneth]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w from his wickedness| strong="H7562" \w*; \w neither shall the righteous| strong="H6662" \w* [be able]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [to live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8800”} for his righteousness \w in the day| strong="H3117" \w* [that he sinneth]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 13 [When I shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} \w to the righteous| strong="H6662" \w*, that [he shall surely]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8800”} [live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}; [if he trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”} \w to his own righteousness| strong="H6666" \w*, [and commit]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w iniquity| strong="H5766" \w*, \w all his righteousnesses| strong="H6666" \w* [shall not be remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8735”}; \w but for his iniquity| strong="H5766" \w* [that he hath committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [he shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} for it. 
\v 14 [Again, when I say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto the wicked| strong="H7563" \w*, [Thou shalt surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}; [if he turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w from his sin| strong="H2403" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w that which is lawful| strong="H4941" \w* \w and right| strong="H6666" \w*;\f + \fr 33:14 \ft that…: Heb. judgment and justice \f* 
\v 15 If \w the wicked| strong="H7563" \w* [restore]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w the pledge| strong="H2258" \w*, [give again]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w that he had robbed| strong="H1500" \w*, [walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the statutes| strong="H2708" \w* \w of life| strong="H2416" \w*, [without committing]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w iniquity| strong="H5766" \w*; [he shall surely]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8800”} [live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}, [he shall not die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 16 \w None of his sins| strong="H2403" \w* [that he hath committed]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} [shall be mentioned]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8735”} [unto him: he hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w that which is lawful| strong="H4941" \w* \w and right| strong="H6666" \w*; [he shall surely]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8800”} [live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 17 \w Yet the children| strong="H1121" \w* \w of thy people| strong="H5971" \w* [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w The way| strong="H1870" \w* \w of the Lord| strong="H136" \w* [is not equal]{strong=“H8505” x-morph=“strongMorph: \sc Th\sc*8735”}: [but as for them, their way]{strong=“H1870”} [is not equal]{strong=“H8505” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 18 \w When the righteous| strong="H6662" \w* [turneth]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w from his righteousness| strong="H6666" \w*, [and committeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w iniquity| strong="H5766" \w*, [he shall even die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”} thereby. 
\v 19 \w But if the wicked| strong="H7563" \w* [turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w from his wickedness| strong="H7564" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w that which is lawful| strong="H4941" \w* \w and right| strong="H6666" \w*, [he shall live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”} thereby. 
\p
\v 20 [Yet ye say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w The way| strong="H1870" \w* \w of the Lord| strong="H136" \w* [is not equal]{strong=“H8505” x-morph=“strongMorph: \sc Th\sc*8735”}. \w O ye house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, [I will judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w you every one| strong="H376" \w* \w after his ways| strong="H1870" \w*. 
\p
\v 21 [And it came to pass in the twelfth]{strong=“H6240 H8147”} \w year| strong="H8141" \w* \w of our captivity| strong="H1546" \w*, \w in the tenth| strong="H6224" \w* month, \w in the fifth| strong="H2568" \w* day \w of the month| strong="H2320" \w*, that \w one that had escaped| strong="H6412" \w* \w out of Jerusalem| strong="H3389" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w The city| strong="H5892" \w* [is smitten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8717”}. 
\v 22 \w Now the hand| strong="H3027" \w* of the \sc Lord\sc* \w was upon me in the evening| strong="H6153" \w*, \w afore| strong="H6440" \w* \w he that was escaped| strong="H6412" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}; [and had opened]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} \w my mouth| strong="H6310" \w*, [until he came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w to me in the morning| strong="H1242" \w*; \w and my mouth| strong="H6310" \w* [was opened]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8735”}, [and I was no more dumb]{strong=“H481” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 23 \w Then the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 24 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [they that inhabit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w those wastes| strong="H2723" \w* \w of the land| strong="H127" \w* \w of Israel| strong="H3478" \w* [speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Abraham| strong="H85" \w* \w was one| strong="H259" \w*, [and he inherited]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8799”} \w the land| strong="H776" \w*: but we are \w many| strong="H7227" \w*; \w the land| strong="H776" \w* [is given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w us for inheritance| strong="H4181" \w*. 
\v 25 [Wherefore say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} [unto them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Ye eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the blood| strong="H1818" \w*, [and lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w your eyes| strong="H5869" \w* \w toward your idols| strong="H1544" \w*, [and shed]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8799”} \w blood| strong="H1818" \w*: [and shall ye possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8799”} \w the land| strong="H776" \w*? 
\v 26 [Ye stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon your sword| strong="H2719" \w*, [ye work]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w abomination| strong="H8441" \w*, [and ye defile]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8765”} \w every one| strong="H376" \w* [his neighbour’s]{strong=“H7453”} \w wife| strong="H802" \w*: [and shall ye possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8799”} \w the land| strong="H776" \w*? 
\v 27 [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [thou thus unto them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; As \w I live| strong="H2416" \w*, surely they that are \w in the wastes| strong="H2723" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w*, and him that is \w in the open| strong="H6440" \w* \w field| strong="H7704" \w* [will I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the beasts| strong="H2416" \w* [to be devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”}, and they that be \w in the forts| strong="H4679" \w* \w and in the caves| strong="H4631" \w* [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the pestilence| strong="H1698" \w*.\f + \fr 33:27 \ft to be…: Heb. to devour him \f* 
\v 28 [For I will lay]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w the land| strong="H776" \w* \w most| strong="H4923" \w* \w desolate| strong="H8077" \w*, \w and the pomp| strong="H1347" \w* \w of her strength| strong="H5797" \w* [shall cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8738”}; \w and the mountains| strong="H2022" \w* \w of Israel| strong="H3478" \w* [shall be desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8804”}, [that none shall pass through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 33:28 \ft most…: Heb. desolation and desolation \f* 
\v 29 [Then shall they know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*, [when I have laid]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w the land| strong="H776" \w* \w most| strong="H4923" \w* \w desolate| strong="H8077" \w* \w because of all their abominations| strong="H8441" \w* [which they have committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\p
\v 30 [Also, thou son]{strong=“H1121”} \w of man| strong="H120" \w*, \w the children| strong="H1121" \w* \w of thy people| strong="H5971" \w* [still are talking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8737”} \w against| strong="H681" \w* \w thee by the walls| strong="H7023" \w* \w and in the doors| strong="H6607" \w* \w of the houses| strong="H1004" \w*, [and speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w one| strong="H2297" \w* \w to another| strong="H259" \w*, \w every one| strong="H376" \w* \w to his brother| strong="H251" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”}, [I pray you, and hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w what is the word| strong="H1697" \w* [that cometh forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} from the \sc Lord\sc*.\f + \fr 33:30 \ft against thee: of, of thee \f* 
\v 31 [And they come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto thee as the people| strong="H5971" \w* \w cometh| strong="H3996" \w*, [and they sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* thee as \w my people| strong="H5971" \w*, [and they hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy words| strong="H1697" \w*, [but they will not do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [them: for with their mouth]{strong=“H6310”} [they shew]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w much love| strong="H5690" \w*, but \w their heart| strong="H3820" \w* [goeth]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w after| strong="H310" \w* \w their covetousness| strong="H1215" \w*.\f + \fr 33:31 \ft as the…: Heb. according to the coming of the people \f* \f + \fr 33:31 \ft they sit…: or, my people sit before thee \f* \f + \fr 33:31 \ft they shew…: Heb. they make loves, or, jests \f* 
\v 32 And, lo, thou art \w unto them as a very lovely| strong="H5690" \w* \w song| strong="H7892" \w* \w of one that hath a pleasant| strong="H3303" \w* \w voice| strong="H6963" \w*, [and can play well]{strong=“H2895” x-morph=“strongMorph: \sc Th\sc*8688”} [on an instrument]{strong=“H5059” x-morph=“strongMorph: \sc Th\sc*8763”}: [for they hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy words| strong="H1697" \w*, [but they do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} them not.\f + \fr 33:32 \ft a very…: Heb. a song of loves \f* 
\v 33 [And when this cometh to pass]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}, ([lo, it will come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”},) [then shall they know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w that a prophet| strong="H5030" \w* \w hath been among| strong="H8432" \w* them.
\c 34
\p 
\v 1 \w And the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} [against the shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Israel| strong="H3478" \w*, [prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”}, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc* [unto the shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}; \w Woe| strong="H1945" \w* be [to the shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Israel| strong="H3478" \w* [that do feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [themselves! should not the shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} \w the flocks| strong="H6629" \w*? 
\v 3 [Ye eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the fat| strong="H2459" \w*, [and ye clothe]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w you with the wool| strong="H6785" \w*, [ye kill]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} \w them that are fed| strong="H1277" \w*: but [ye feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} \w not the flock| strong="H6629" \w*. 
\v 4 [The diseased]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8737”} [have ye not strengthened]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8765”}, [neither have ye healed]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8765”} [that which was sick]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8802”}, [neither have ye bound up]{strong=“H2280” x-morph=“strongMorph: \sc Th\sc*8804”} that which was [broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8737”}, [neither have ye brought again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} [that which was driven away]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8737”}, [neither have ye sought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8765”} [that which was lost]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8802”}; \w but with force| strong="H2394" \w* \w and with cruelty| strong="H6531" \w* [have ye ruled]{strong=“H7287” x-morph=“strongMorph: \sc Th\sc*8804”} them. 
\v 5 [And they were scattered]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8799”}, because there is [no shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}: \w and they became meat| strong="H402" \w* \w to all the beasts| strong="H2416" \w* \w of the field| strong="H7704" \w*, [when they were scattered]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 34:5 \ft because…: or, without a shepherd \f* 
\v 6 \w My sheep| strong="H6629" \w* [wandered]{strong=“H7686” x-morph=“strongMorph: \sc Th\sc*8799”} \w through all the mountains| strong="H2022" \w*, [and upon every high]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8802”} \w hill| strong="H1389" \w*: [yea, my flock]{strong=“H6629”} [was scattered]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8738”} \w upon all the face| strong="H6440" \w* \w of the earth| strong="H776" \w*, [and none did search]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8802”} [or seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} after them. 
\p
\v 7 [Therefore, ye shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}, [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* of the \sc Lord\sc*; 
\v 8 As \w I live| strong="H2416" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, \w surely because my flock| strong="H6629" \w* \w became a prey| strong="H957" \w*, \w and my flock| strong="H6629" \w* \w became meat| strong="H402" \w* \w to every beast| strong="H2416" \w* \w of the field| strong="H7704" \w*, because there was [no shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}, [neither did my shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [search]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8804”} \w for my flock| strong="H6629" \w*, [but the shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [fed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} [themselves, and fed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8804”} \w not my flock| strong="H6629" \w*;\f + \fr 34:8 \ft because…: or, without a shepherd \f* 
\v 9 [Therefore, O ye shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}, [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* of the \sc Lord\sc*; 
\v 10 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; Behold, I am [against the shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}; [and I will require]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8804”} \w my flock| strong="H6629" \w* \w at their hand| strong="H3027" \w*, [and cause them to cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8689”} [from feeding]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8800”} \w the flock| strong="H6629" \w*; [neither shall the shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} [themselves any more; for I will deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w my flock| strong="H6629" \w* \w from their mouth| strong="H6310" \w*, \w that they may not be meat| strong="H402" \w* for them. 
\p
\v 11 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; Behold, I, even [I, will both search]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8804”} \w my sheep| strong="H6629" \w*, [and seek them out]{strong=“H1239” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 12 [As a shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} \w seeketh out| strong="H1243" \w* \w his flock| strong="H5739" \w* \w in the day| strong="H3117" \w* \w that he is among| strong="H8432" \w* \w his sheep| strong="H6629" \w* that are [scattered]{strong=“H6567” x-morph=“strongMorph: \sc Th\sc*8737”}; [so will I seek out]{strong=“H1239” x-morph=“strongMorph: \sc Th\sc*8762”} \w my sheep| strong="H6629" \w*, [and will deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w them out of all places| strong="H4725" \w* [where they have been scattered]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the cloudy| strong="H6051" \w* \w and dark| strong="H6205" \w* \w day| strong="H3117" \w*.\f + \fr 34:12 \ft As…: Heb. According to the seeking \f* 
\v 13 [And I will bring them out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w from the people| strong="H5971" \w*, [and gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8765”} \w them from the countries| strong="H776" \w*, [and will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w them to their own land| strong="H127" \w*, [and feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8804”} \w them upon the mountains| strong="H2022" \w* \w of Israel| strong="H3478" \w* \w by the rivers| strong="H650" \w*, \w and in all the inhabited places| strong="H4186" \w* \w of the country| strong="H776" \w*. 
\v 14 [I will feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} \w them in a good| strong="H2896" \w* \w pasture| strong="H4829" \w*, \w and upon the high| strong="H4791" \w* \w mountains| strong="H2022" \w* \w of Israel| strong="H3478" \w* \w shall their fold| strong="H5116" \w* [be: there shall they lie]{strong=“H7257” x-morph=“strongMorph: \sc Th\sc*8799”} \w in a good| strong="H2896" \w* \w fold| strong="H5116" \w*, and in \w a fat| strong="H8082" \w* \w pasture| strong="H4829" \w* [shall they feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the mountains| strong="H2022" \w* \w of Israel| strong="H3478" \w*. 
\v 15 [I will feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} \w my flock| strong="H6629" \w*, [and I will cause them to lie down]{strong=“H7257” x-morph=“strongMorph: \sc Th\sc*8686”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\v 16 [I will seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} [that which was lost]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8802”}, [and bring again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} [that which was driven away]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8737”}, [and will bind up]{strong=“H2280” x-morph=“strongMorph: \sc Th\sc*8799”} that which was [broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8737”}, [and will strengthen]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8762”} [that which was sick]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8802”}: [but I will destroy]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8686”} \w the fat| strong="H8082" \w* \w and the strong| strong="H2389" \w*; [I will feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} \w them with judgment| strong="H4941" \w*. 
\p
\v 17 And as for \w you| strong="H859" \w*, \w O my flock| strong="H6629" \w*, [thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Behold, I judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} \w between cattle| strong="H7716" \w* \w and cattle| strong="H7716" \w*, \w between the rams| strong="H352" \w* \w and the he goats| strong="H6260" \w*.\f + \fr 34:17 \ft cattle: Heb. small cattle of lambs and kids \f* \f + \fr 34:17 \ft he goats: Heb. great he goats \f* 
\v 18 Seemeth it \w a small thing| strong="H4592" \w* [unto you to have eaten up]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} \w the good| strong="H2896" \w* \w pasture| strong="H4829" \w*, [but ye must tread down]{strong=“H7429” x-morph=“strongMorph: \sc Th\sc*8799”} \w with your feet| strong="H7272" \w* \w the residue| strong="H3499" \w* \w of your pastures| strong="H4829" \w*? [and to have drunk]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the deep| strong="H4950" \w* \w waters| strong="H4325" \w*, [but ye must foul]{strong=“H7515” x-morph=“strongMorph: \sc Th\sc*8799”} [the residue]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8737”} \w with your feet| strong="H7272" \w*? 
\v 19 And as for \w my flock| strong="H6629" \w*, [they eat]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} \w that which ye have trodden| strong="H4823" \w* \w with your feet| strong="H7272" \w*; [and they drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w that which ye have fouled| strong="H4833" \w* \w with your feet| strong="H7272" \w*. 
\p
\v 20 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc* unto them; Behold, I, even [I, will judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8804”} \w between the fat| strong="H1274" \w* \w cattle| strong="H7716" \w* \w and between the lean| strong="H7330" \w* \w cattle| strong="H7716" \w*. 
\v 21 [Because ye have thrust]{strong=“H1920” x-morph=“strongMorph: \sc Th\sc*8799”} \w with side| strong="H6654" \w* \w and with shoulder| strong="H3802" \w*, [and pushed]{strong=“H5055” x-morph=“strongMorph: \sc Th\sc*8762”} [all the diseased]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8737”} \w with your horns| strong="H7161" \w*, [till ye have scattered]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8689”} \w them abroad| strong="H2351" \w*; 
\v 22 [Therefore will I save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8689”} \w my flock| strong="H6629" \w*, \w and they shall no more be a prey| strong="H957" \w*; [and I will judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8804”} \w between cattle| strong="H7716" \w* \w and cattle| strong="H7716" \w*. 
\v 23 [And I will set up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} \w one| strong="H259" \w* [shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [over them, and he shall feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8804”} them, even \w my servant| strong="H5650" \w* \w David| strong="H1732" \w*; [he shall feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and he shall be their shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 24 And I the \sc Lord\sc* \w will be their God| strong="H430" \w*, \w and my servant| strong="H5650" \w* \w David| strong="H1732" \w* \w a prince| strong="H5387" \w* \w among| strong="H8432" \w* them; I the \sc Lord\sc* [have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it. 
\v 25 [And I will make]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8804”} \w with them a covenant| strong="H1285" \w* \w of peace| strong="H7965" \w*, \w and will cause the evil| strong="H7451" \w* \w beasts| strong="H2416" \w* [to cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8689”} \w out of the land| strong="H776" \w*: [and they shall dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w safely| strong="H983" \w* \w in the wilderness| strong="H4057" \w*, [and sleep]{strong=“H3462” x-morph=“strongMorph: \sc Th\sc*8804”} [in the woods]{strong=“H3264 H3293” x-morph=“strongMorph: \sc Th\sc*8675”}. 
\v 26 [And I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w them and the places round about| strong="H5439" \w* \w my hill| strong="H1389" \w* \w a blessing| strong="H1293" \w*; \w and I will cause the shower| strong="H1653" \w* [to come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8689”} \w in his season| strong="H6256" \w*; \w there shall be showers| strong="H1653" \w* \w of blessing| strong="H1293" \w*. 
\v 27 \w And the tree| strong="H6086" \w* \w of the field| strong="H7704" \w* [shall yield]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w her fruit| strong="H6529" \w*, \w and the earth| strong="H776" \w* [shall yield]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w her increase| strong="H2981" \w*, \w and they shall be safe| strong="H983" \w* \w in their land| strong="H127" \w*, [and shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*, [when I have broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8800”} \w the bands| strong="H4133" \w* \w of their yoke| strong="H5923" \w*, [and delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w them out of the hand| strong="H3027" \w* [of those that served]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8802”} themselves of them. 
\v 28 \w And they shall no more be a prey| strong="H957" \w* \w to the heathen| strong="H1471" \w*, \w neither shall the beast| strong="H2416" \w* \w of the land| strong="H776" \w* [devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [them; but they shall dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w safely| strong="H983" \w*, and none shall make them [afraid]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 29 [And I will raise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} \w for them a plant| strong="H4302" \w* \w of renown| strong="H8034" \w*, [and they shall be no more consumed]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8803”} \w with hunger| strong="H7458" \w* \w in the land| strong="H776" \w*, [neither bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w the shame| strong="H3639" \w* \w of the heathen| strong="H1471" \w* any more.\f + \fr 34:29 \ft of renown: or, for renown \f* \f + \fr 34:29 \ft consumed: Heb. taken away \f* 
\v 30 [Thus shall they know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I the \sc Lord\sc* \w their God| strong="H430" \w* am with them, and that they, even \w the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, are \w my people| strong="H5971" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\v 31 \w And ye| strong="H859" \w* \w my flock| strong="H6629" \w*, \w the flock| strong="H6629" \w* \w of my pasture| strong="H4830" \w*, are \w men| strong="H120" \w*, and I am \w your God| strong="H430" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*.
\c 35
\p 
\v 1 \w Moreover the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w Son| strong="H1121" \w* \w of man| strong="H120" \w*, [set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy face| strong="H6440" \w* \w against mount| strong="H2022" \w* \w Seir| strong="H8165" \w*, [and prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} against it, 
\v 3 [And say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto it, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Behold, O mount]{strong=“H2022”} \w Seir| strong="H8165" \w*, I am [against thee, and I will stretch out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine hand| strong="H3027" \w* [against thee, and I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee most| strong="H4923" \w* \w desolate| strong="H8077" \w*.\f + \fr 35:3 \ft most…: Heb. desolation and desolation \f* 
\v 4 [I will lay]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy cities| strong="H5892" \w* \w waste| strong="H2723" \w*, \w and thou shalt be desolate| strong="H8077" \w*, [and thou shalt know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*. 
\v 5 \w Because thou hast had a perpetual| strong="H5769" \w* \w hatred| strong="H342" \w*, [and hast shed]{strong=“H5064” x-morph=“strongMorph: \sc Th\sc*8686”} the blood of \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* \w by the force| strong="H3027" \w* \w of the sword| strong="H2719" \w* \w in the time| strong="H6256" \w* \w of their calamity| strong="H343" \w*, \w in the time| strong="H6256" \w* that their \w iniquity| strong="H5771" \w* had \w an end| strong="H7093" \w*:\f + \fr 35:5 \ft perpetual…: or, hatred of old \f* \f + \fr 35:5 \ft shed…: Heb. poured out the children \f* \f + \fr 35:5 \ft force: Heb. hands \f* 
\v 6 Therefore, as \w I live| strong="H2416" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, [I will prepare]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee unto blood| strong="H1818" \w*, \w and blood| strong="H1818" \w* [shall pursue]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} [thee: sith]{strong=“H518”} [thou hast not hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”} \w blood| strong="H1818" \w*, \w even blood| strong="H1818" \w* [shall pursue]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} thee. 
\v 7 [Thus will I make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w mount| strong="H2022" \w* \w Seir| strong="H8165" \w* \w most| strong="H8077" \w* \w desolate| strong="H8077" \w*, [and cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} [from it him that passeth out]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} [and him that returneth]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 35:7 \ft most…: Heb. desolation and desolation \f* 
\v 8 [And I will fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8765”} \w his mountains| strong="H2022" \w* \w with his slain| strong="H2491" \w* men: \w in thy hills| strong="H1389" \w*, \w and in thy valleys| strong="H1516" \w*, \w and in all thy rivers| strong="H650" \w*, [shall they fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w that are slain| strong="H2491" \w* \w with the sword| strong="H2719" \w*. 
\v 9 [I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee perpetual| strong="H5769" \w* \w desolations| strong="H8077" \w*, \w and thy cities| strong="H5892" \w* [shall not return]{strong=“H3427 H7725” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8799”}: [and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*. 
\p
\v 10 [Because thou hast said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w These two| strong="H8147" \w* \w nations| strong="H1471" \w* \w and these two| strong="H8147" \w* \w countries| strong="H776" \w* [shall be mine, and we will possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8804”} it; whereas the \sc Lord\sc* was there:^\sc 35:10 whereas…: or, though the [Lord\sc* was there] 
\v 11 Therefore, as \w I live| strong="H2416" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, [I will even do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w according to thine anger| strong="H639" \w*, \w and according to thine envy| strong="H7068" \w* [which thou hast used]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w out of thy hatred| strong="H8135" \w* [against them; and I will make myself known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8738”} [among them, when I have judged]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} thee. 
\v 12 [And thou shalt know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*, and that [I have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w all thy blasphemies| strong="H5007" \w* [which thou hast spoken]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w against the mountains| strong="H2022" \w* \w of Israel| strong="H3478" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [They are laid desolate]{strong=“H8077 H8074” x-morph=“strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8804”}, [they are given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w us to consume| strong="H402" \w*.\f + \fr 35:12 \ft to consume: Heb. to devour \f* 
\v 13 \w Thus with your mouth| strong="H6310" \w* [ye have boasted]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8686”} [against me, and have multiplied]{strong=“H6280” x-morph=“strongMorph: \sc Th\sc*8689”} \w your words| strong="H1697" \w* [against me: I have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} them.\f + \fr 35:13 \ft boasted: Heb. magnified \f* 
\v 14 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w When the whole earth| strong="H776" \w* [rejoiceth]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8800”}, [I will make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee desolate| strong="H8077" \w*. 
\v 15 \w As thou didst rejoice| strong="H8057" \w* \w at the inheritance| strong="H5159" \w* \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, [because it was desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8804”}, [so will I do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee: thou shalt be desolate]{strong=“H8077”}, \w O mount| strong="H2022" \w* \w Seir| strong="H8165" \w*, \w and all Idumea| strong="H123" \w*, even [all of it: and they shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*.
\c 36
\p 
\v 1 [Also, thou son]{strong=“H1121”} \w of man| strong="H120" \w*, [prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} \w unto the mountains| strong="H2022" \w* \w of Israel| strong="H3478" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Ye mountains| strong="H2022" \w* \w of Israel| strong="H3478" \w*, [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* of the \sc Lord\sc*: 
\v 2 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Because the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [hath said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [against you, Aha]{strong=“H1889”}, \w even the ancient| strong="H5769" \w* \w high places| strong="H1116" \w* \w are ours in possession| strong="H4181" \w*: 
\v 3 [Therefore prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; Because they have made you [desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8800”}, [and swallowed you up]{strong=“H7602” x-morph=“strongMorph: \sc Th\sc*8800”} \w on every side| strong="H5439" \w*, \w that ye might be a possession| strong="H4181" \w* \w unto the residue| strong="H7611" \w* \w of the heathen| strong="H1471" \w*, [and ye are taken up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the lips| strong="H8193" \w* \w of talkers| strong="H3956" \w*, and are \w an infamy| strong="H1681" \w* \w of the people| strong="H5971" \w*:\f + \fr 36:3 \ft Because: Heb. Because for because \f* \f + \fr 36:3 \ft are…: or, ye are made to come up on the lip of the tongue \f* 
\v 4 [Therefore, ye mountains]{strong=“H2022”} \w of Israel| strong="H3478" \w*, [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* \w of the Lord| strong="H136" \w* \sc God\sc*; [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc* \w to the mountains| strong="H2022" \w*, \w and to the hills| strong="H1389" \w*, \w to the rivers| strong="H650" \w*, \w and to the valleys| strong="H1516" \w*, [to the desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8802”} \w wastes| strong="H2723" \w*, \w and to the cities| strong="H5892" \w* [that are forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8737”}, \w which became a prey| strong="H957" \w* \w and derision| strong="H3933" \w* \w to the residue| strong="H7611" \w* \w of the heathen| strong="H1471" \w* that are \w round about| strong="H5439" \w*;\f + \fr 36:4 \ft rivers: or, bottoms, or, dales \f* 
\v 5 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w Surely in the fire| strong="H784" \w* \w of my jealousy| strong="H7068" \w* [have I spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w against the residue| strong="H7611" \w* \w of the heathen| strong="H1471" \w*, \w and against all Idumea| strong="H123" \w*, [which have appointed]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w my land| strong="H776" \w* \w into their possession| strong="H4181" \w* \w with the joy| strong="H8057" \w* of all their \w heart| strong="H3824" \w*, \w with despiteful| strong="H7589" \w* \w minds| strong="H5315" \w*, \w to cast it out| strong="H4054" \w* \w for a prey| strong="H957" \w*. 
\v 6 [Prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} \w therefore concerning the land| strong="H127" \w* \w of Israel| strong="H3478" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the mountains| strong="H2022" \w*, \w and to the hills| strong="H1389" \w*, \w to the rivers| strong="H650" \w*, \w and to the valleys| strong="H1516" \w*, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [Behold, I have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w in my jealousy| strong="H7068" \w* \w and in my fury| strong="H2534" \w*, [because ye have borne]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w the shame| strong="H3639" \w* \w of the heathen| strong="H1471" \w*: 
\v 7 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [I have lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine hand| strong="H3027" \w*, \w Surely the heathen| strong="H1471" \w* that are \w about| strong="H5439" \w* [you, they shall bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their shame| strong="H3639" \w*. 
\p
