\v 10 [So I prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8694”} [as he commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [me, and the breath]{strong=“H7307”} [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [into them, and they lived]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}, [and stood up]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon their feet| strong="H7272" \w*, [an exceeding]{strong=“H3966 H3966”} \w great| strong="H1419" \w* \w army| strong="H2428" \w*. 
\p
