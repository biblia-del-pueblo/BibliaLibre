\v 3 It is \w for the prince| strong="H5387" \w*; \w the prince| strong="H5387" \w*, [he shall sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} [in it to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} \w bread| strong="H3899" \w* \w before| strong="H6440" \w* the \sc Lord\sc*; [he shall enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the way| strong="H1870" \w* \w of the porch| strong="H197" \w* of that \w gate| strong="H8179" \w*, [and shall go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the way| strong="H1870" \w* of the same. 
\p
\v 4 [Then brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w he me the way| strong="H1870" \w* \w of the north| strong="H6828" \w* \w gate| strong="H8179" \w* \w before| strong="H6440" \w* \w the house| strong="H1004" \w*: [and I looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, [and, behold, the glory]{strong=“H3519”} of the \sc Lord\sc* [filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w the house| strong="H1004" \w* of the \sc Lord\sc*: [and I fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon my face| strong="H6440" \w*. 
\v 5 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Son]{strong=“H1121”} \w of man| strong="H120" \w*, [mark]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} \w well| strong="H3820" \w*, [and behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w with thine eyes| strong="H5869" \w*, [and hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w with thine ears| strong="H241" \w* [all that I say]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8764”} \w unto thee concerning all the ordinances| strong="H2708" \w* \w of the house| strong="H1004" \w* of the \sc Lord\sc*, \w and all the laws| strong="H8451" \w* [thereof; and mark]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w well| strong="H3820" \w* \w the entering in| strong="H3996" \w* \w of the house| strong="H1004" \w*, \w with every going forth| strong="H4161" \w* \w of the sanctuary| strong="H4720" \w*.\f + \fr 44:5 \ft mark well: Heb. set thine heart \f* \f + \fr 44:5 \ft mark well: Heb. set thine heart \f* 
\v 6 [And thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the rebellious| strong="H4805" \w*, even \w to the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w O ye house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, \w let it suffice| strong="H7227" \w* \w you of all your abominations| strong="H8441" \w*, 
\v 7 [In that ye have brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} into my sanctuary [strangers]{strong=“H5236 H1121”}, \w uncircumcised| strong="H6189" \w* \w in heart| strong="H3820" \w*, \w and uncircumcised| strong="H6189" \w* \w in flesh| strong="H1320" \w*, \w to be in my sanctuary| strong="H4720" \w*, [to pollute]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8763”} it, even \w my house| strong="H1004" \w*, [when ye offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8687”} \w my bread| strong="H3899" \w*, \w the fat| strong="H2459" \w* \w and the blood| strong="H1818" \w*, [and they have broken]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8686”} \w my covenant| strong="H1285" \w* \w because| strong="H413" \w* \w of all your abominations| strong="H8441" \w*.\f + \fr 44:7 \ft strangers: Heb. children of a stranger \f* 
\v 8 [And ye have not kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w the charge| strong="H4931" \w* \w of mine holy things| strong="H6944" \w*: [but ye have set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} [keepers]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w of my charge| strong="H4931" \w* \w in my sanctuary| strong="H4720" \w* for yourselves.\f + \fr 44:8 \ft my charge: or, my ward, or, ordinance \f* 
\p
\v 9 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; [No stranger]{strong=“H5236 H1121”}, \w uncircumcised| strong="H6189" \w* \w in heart| strong="H3820" \w*, \w nor uncircumcised| strong="H6189" \w* \w in flesh| strong="H1320" \w*, [shall enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into my sanctuary| strong="H4720" \w*, of any stranger that is \w among| strong="H8432" \w* \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*. 
\p
\v 10 \w And the Levites| strong="H3881" \w* [that are gone away far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8804”} [from me, when Israel]{strong=“H3478”} [went astray]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8800”}, [which went astray away]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8804”} \w from me after| strong="H310" \w* \w their idols| strong="H1544" \w*; [they shall even bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w their iniquity| strong="H5771" \w*. 
\v 11 [Yet they shall be ministers]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8764”} \w in my sanctuary| strong="H4720" \w*, having \w charge| strong="H6486" \w* \w at the gates| strong="H8179" \w* \w of the house| strong="H1004" \w*, [and ministering]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8764”} \w to the house| strong="H1004" \w*: [they shall slay]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8799”} \w the burnt offering| strong="H5930" \w* \w and the sacrifice| strong="H2077" \w* \w for the people| strong="H5971" \w*, [and they shall stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* [them to minister]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8763”} unto them. 
\v 12 [Because they ministered]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto them before| strong="H6440" \w* \w their idols| strong="H1544" \w*, \w and caused the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* \w to fall| strong="H4383" \w* \w into iniquity| strong="H5771" \w*; [therefore have I lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine hand| strong="H3027" \w* [against them, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, [and they shall bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w their iniquity| strong="H5771" \w*.\f + \fr 44:12 \ft caused…: Heb. were for a stumblingblock of iniquity unto, etc \f* 
\v 13 [And they shall not come near]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, to do the office of a priest]{strong=“H3547” x-morph=“strongMorph: \sc Th\sc*8763”} [unto me, nor to come near]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8800”} \w to any of my holy things| strong="H6944" \w*, \w in the most holy| strong="H6944" \w* place: [but they shall bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w their shame| strong="H3639" \w*, \w and their abominations| strong="H8441" \w* [which they have committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 14 [But I will make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [them keepers]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the charge| strong="H4931" \w* \w of the house| strong="H1004" \w*, \w for all the service| strong="H5656" \w* [thereof, and for all that shall be done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8735”} therein. 
\p
\v 15 \w But the priests| strong="H3548" \w* \w the Levites| strong="H3881" \w*, \w the sons| strong="H1121" \w* \w of Zadok| strong="H6659" \w*, [that kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w the charge| strong="H4931" \w* \w of my sanctuary| strong="H4720" \w* \w when the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [went astray]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8800”} [from me, they shall come near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} [to me to minister]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8763”} [unto me, and they shall stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* [me to offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8687”} \w unto me the fat| strong="H2459" \w* \w and the blood| strong="H1818" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*: 
\v 16 [They shall enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into my sanctuary| strong="H4720" \w*, [and they shall come near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} \w to my table| strong="H7979" \w*, [to minister]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8763”} [unto me, and they shall keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w my charge| strong="H4931" \w*. 
\p
\v 17 And it shall come to pass, that [when they enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w in at the gates| strong="H8179" \w* \w of the inner| strong="H6442" \w* \w court| strong="H2691" \w*, [they shall be clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w with linen| strong="H6593" \w* \w garments| strong="H899" \w*; \w and no wool| strong="H6785" \w* [shall come]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} [upon them, whiles they minister]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8763”} \w in the gates| strong="H8179" \w* \w of the inner| strong="H6442" \w* \w court| strong="H2691" \w*, \w and within| strong="H1004" \w*. 
\v 18 \w They shall have linen| strong="H6593" \w* \w bonnets| strong="H6287" \w* \w upon their heads| strong="H7218" \w*, \w and shall have linen| strong="H6593" \w* \w breeches| strong="H4370" \w* \w upon their loins| strong="H4975" \w*; [they shall not gird]{strong=“H2296” x-morph=“strongMorph: \sc Th\sc*8799”} themselves \w with any thing that causeth sweat| strong="H3154" \w*.\f + \fr 44:18 \ft with…: or, in sweating places: Heb. in, or, with sweat \f* 
\v 19 [And when they go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”} \w into the utter| strong="H2435" \w* \w court| strong="H2691" \w*, even \w into the utter| strong="H2435" \w* \w court| strong="H2691" \w* \w to the people| strong="H5971" \w*, [they shall put off]{strong=“H6584” x-morph=“strongMorph: \sc Th\sc*8799”} \w their garments| strong="H899" \w* [wherein they ministered]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8764”}, [and lay]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8689”} \w them in the holy| strong="H6944" \w* \w chambers| strong="H3957" \w*, [and they shall put]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8804”} \w on other| strong="H312" \w* \w garments| strong="H899" \w*; [and they shall not sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8762”} \w the people| strong="H5971" \w* \w with their garments| strong="H899" \w*. 
\v 20 [Neither shall they shave]{strong=“H1548” x-morph=“strongMorph: \sc Th\sc*8762”} \w their heads| strong="H7218" \w*, \w nor suffer their locks| strong="H6545" \w* [to grow long]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”}; [they shall only]{strong=“H3697” x-morph=“strongMorph: \sc Th\sc*8800”} [poll]{strong=“H3697” x-morph=“strongMorph: \sc Th\sc*8799”} \w their heads| strong="H7218" \w*. 
\v 21 \w Neither shall any priest| strong="H3548" \w* [drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w wine| strong="H3196" \w*, [when they enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w into the inner| strong="H6442" \w* \w court| strong="H2691" \w*. 
\v 22 [Neither shall they take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w for their wives| strong="H802" \w* \w a widow| strong="H490" \w*, [nor her that is put away]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8803”}: [but they shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w maidens| strong="H1330" \w* \w of the seed| strong="H2233" \w* \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, \w or a widow| strong="H490" \w* \w that had a priest| strong="H3548" \w* before.\f + \fr 44:22 \ft put…: Heb. thrust forth \f* \f + \fr 44:22 \ft that had…: Heb. from a priest \f* 
\v 23 [And they shall teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”} \w my people| strong="H5971" \w* the difference \w between the holy| strong="H6944" \w* \w and profane| strong="H2455" \w*, [and cause them to discern]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8686”} \w between the unclean| strong="H2931" \w* \w and the clean| strong="H2889" \w*. 
\v 24 \w And in controversy| strong="H7379" \w* [they shall stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} [in judgment]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8800”}; and [they shall judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w it according to my judgments| strong="H4941" \w*: [and they shall keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w my laws| strong="H8451" \w* \w and my statutes| strong="H2708" \w* \w in all mine assemblies| strong="H4150" \w*; [and they shall hallow]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8762”} \w my sabbaths| strong="H7676" \w*. 
\v 25 [And they shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [at no dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”} \w person| strong="H120" \w* [to defile]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8800”} [themselves: but for father]{strong=“H1”}, \w or for mother| strong="H517" \w*, \w or for son| strong="H1121" \w*, \w or for daughter| strong="H1323" \w*, \w for brother| strong="H251" \w*, \w or for sister| strong="H269" \w* \w that hath had no husband| strong="H376" \w*, [they may defile]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8691”} themselves. 
\v 26 \w And after| strong="H310" \w* \w he is cleansed| strong="H2893" \w*, [they shall reckon]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto him seven| strong="H7651" \w* \w days| strong="H3117" \w*. 
\v 27 \w And in the day| strong="H3117" \w* [that he goeth]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w into the sanctuary| strong="H6944" \w*, \w unto the inner| strong="H6442" \w* \w court| strong="H2691" \w*, [to minister]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8763”} \w in the sanctuary| strong="H6944" \w*, [he shall offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”} \w his sin offering| strong="H2403" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\v 28 \w And it shall be unto them for an inheritance| strong="H5159" \w*: I am \w their inheritance| strong="H5159" \w*: [and ye shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w them no possession| strong="H272" \w* \w in Israel| strong="H3478" \w*: I am \w their possession| strong="H272" \w*. 
\v 29 [They shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the meat offering| strong="H4503" \w*, \w and the sin offering| strong="H2403" \w*, \w and the trespass offering| strong="H817" \w*; \w and every dedicated thing| strong="H2764" \w* \w in Israel| strong="H3478" \w* shall be theirs.\f + \fr 44:29 \ft dedicated: or, devoted \f* 
\v 30 \w And the first| strong="H7225" \w* \w of all the firstfruits| strong="H1061" \w* of all things, \w and every oblation| strong="H8641" \w* of all, of every sort \w of your oblations| strong="H8641" \w*, [shall be the priest’s]{strong=“H3548”}: [ye shall also give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the priest| strong="H3548" \w* \w the first| strong="H7225" \w* \w of your dough| strong="H6182" \w*, \w that he may cause the blessing| strong="H1293" \w* [to rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8687”} \w in thine house| strong="H1004" \w*.\f + \fr 44:30 \ft And the first: or, And the chief \f* 
\v 31 \w The priests| strong="H3548" \w* [shall not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w of any thing that is dead of itself| strong="H5038" \w*, \w or torn| strong="H2966" \w*, \w whether it be fowl| strong="H5775" \w* \w or beast| strong="H929" \w*.
\c 45
\p 
\v 1 [Moreover, when ye shall divide]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8687”} \w by lot the land| strong="H776" \w* \w for inheritance| strong="H5159" \w*, [ye shall offer]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} \w an oblation| strong="H8641" \w* unto the \sc Lord\sc*, \w an holy portion| strong="H6944" \w* \w of the land| strong="H776" \w*: \w the length| strong="H753" \w* shall be \w the length| strong="H753" \w* \w of five| strong="H2568" \w* \w and twenty| strong="H6242" \w* \w thousand| strong="H505" \w* reeds, \w and the breadth| strong="H7341" \w* shall be \w ten| strong="H6235" \w* \w thousand| strong="H505" \w*. This shall be \w holy| strong="H6944" \w* \w in all the borders| strong="H1366" \w* \w thereof round about| strong="H5439" \w*.\f + \fr 45:1 \ft when…: Heb. when ye cause the land to fall \f* \f + \fr 45:1 \ft an holy…: Heb. holiness \f* 
\v 2 \w Of this there shall be for the sanctuary| strong="H6944" \w* \w five| strong="H2568" \w* \w hundred| strong="H3967" \w* in length, \w with five| strong="H2568" \w* \w hundred| strong="H3967" \w* in breadth, [square]{strong=“H7251” x-morph=“strongMorph: \sc Th\sc*8794”} \w round about| strong="H5439" \w*; \w and fifty| strong="H2572" \w* \w cubits| strong="H520" \w* \w round about| strong="H5439" \w* \w for the suburbs| strong="H4054" \w* thereof.\f + \fr 45:2 \ft suburbs: or, void places \f* 
\v 3 \w And of this measure| strong="H4060" \w* [shalt thou measure]{strong=“H4058” x-morph=“strongMorph: \sc Th\sc*8799”} \w the length| strong="H753" \w* \w of five| strong="H2568" \w* \w and twenty| strong="H6242" \w* \w thousand| strong="H505" \w*, \w and the breadth| strong="H7341" \w* \w of ten| strong="H6235" \w* \w thousand| strong="H505" \w*: \w and in it shall be the sanctuary| strong="H4720" \w* and \w the most| strong="H6944" \w* \w holy| strong="H6944" \w* place. 
\v 4 \w The holy| strong="H6944" \w* portion \w of the land| strong="H776" \w* \w shall be for the priests| strong="H3548" \w* [the ministers]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8764”} \w of the sanctuary| strong="H4720" \w*, \w which shall come near| strong="H7131" \w* [to minister]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8763”} unto the \sc Lord\sc*: \w and it shall be a place| strong="H4725" \w* \w for their houses| strong="H1004" \w*, \w and an holy place| strong="H4720" \w* \w for the sanctuary| strong="H4720" \w*. 
\v 5 \w And the five| strong="H2568" \w* \w and twenty| strong="H6242" \w* \w thousand| strong="H505" \w* \w of length| strong="H753" \w*, \w and the ten| strong="H6235" \w* \w thousand| strong="H505" \w* \w of breadth| strong="H7341" \w*, \w shall also the Levites| strong="H3881" \w*, [the ministers]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8764”} \w of the house| strong="H1004" \w*, [have for themselves, for a possession]{strong=“H272”} \w for twenty| strong="H6242" \w* \w chambers| strong="H3957" \w*. 
\p
\v 6 [And ye shall appoint]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w the possession| strong="H272" \w* \w of the city| strong="H5892" \w* \w five| strong="H2568" \w* \w thousand| strong="H505" \w* \w broad| strong="H7341" \w*, \w and five| strong="H2568" \w* \w and twenty| strong="H6242" \w* \w thousand| strong="H505" \w* \w long| strong="H753" \w*, \w over against| strong="H5980" \w* \w the oblation| strong="H8641" \w* \w of the holy| strong="H6944" \w* portion: \w it shall be for the whole house| strong="H1004" \w* \w of Israel| strong="H3478" \w*. 
\p
\v 7 And a portion shall be \w for the prince| strong="H5387" \w* \w on the one side and on the other side of the oblation| strong="H8641" \w* \w of the holy| strong="H6944" \w* portion, \w and of the possession| strong="H272" \w* \w of the city| strong="H5892" \w*, \w before| strong="H6440" \w* \w the oblation| strong="H8641" \w* \w of the holy| strong="H6944" \w* portion, \w and before| strong="H6440" \w* \w the possession| strong="H272" \w* \w of the city| strong="H5892" \w*, \w from the west| strong="H3220" \w* \w side| strong="H6285" \w* \w westward| strong="H3220" \w*, \w and from the east| strong="H6924" \w* \w side| strong="H6285" \w* \w eastward| strong="H6921" \w*: \w and the length| strong="H753" \w* shall be \w over against| strong="H5980" \w* \w one| strong="H259" \w* \w of the portions| strong="H2506" \w*, \w from the west| strong="H3220" \w* \w border| strong="H1366" \w* \w unto the east| strong="H6921" \w* \w border| strong="H1366" \w*. 
\v 8 \w In the land| strong="H776" \w* \w shall be his possession| strong="H272" \w* \w in Israel| strong="H3478" \w*: \w and my princes| strong="H5387" \w* [shall no more oppress]{strong=“H3238” x-morph=“strongMorph: \sc Th\sc*8686”} \w my people| strong="H5971" \w*; and the rest of \w the land| strong="H776" \w* [shall they give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* \w according to their tribes| strong="H7626" \w*. 
\p
\v 9 [Thus saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*; \w Let it suffice| strong="H7227" \w* [you, O princes]{strong=“H5387”} \w of Israel| strong="H3478" \w*: [remove]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8685”} \w violence| strong="H2555" \w* \w and spoil| strong="H7701" \w*, [and execute]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} \w judgment| strong="H4941" \w* \w and justice| strong="H6666" \w*, [take away]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8685”} \w your exactions| strong="H1646" \w* \w from my people| strong="H5971" \w*, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*.\f + \fr 45:9 \ft exactions: Heb. expulsions \f* 
\v 10 \w Ye shall have just| strong="H6664" \w* \w balances| strong="H3976" \w*, \w and a just| strong="H6664" \w* \w ephah| strong="H374" \w*, \w and a just| strong="H6664" \w* \w bath| strong="H1324" \w*. 
\v 11 \w The ephah| strong="H374" \w* \w and the bath| strong="H1324" \w* \w shall be of one| strong="H259" \w* \w measure| strong="H8506" \w*, \w that the bath| strong="H1324" \w* [may contain]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8800”} \w the tenth part| strong="H4643" \w* \w of an homer| strong="H2563" \w*, \w and the ephah| strong="H374" \w* \w the tenth part| strong="H6224" \w* \w of an homer| strong="H2563" \w*: \w the measure| strong="H4971" \w* \w thereof shall be after the homer| strong="H2563" \w*. 
\v 12 \w And the shekel| strong="H8255" \w* shall be \w twenty| strong="H6242" \w* \w gerahs| strong="H1626" \w*: \w twenty| strong="H6242" \w* \w shekels| strong="H8255" \w*, \w five| strong="H2568" \w* \w and twenty| strong="H6242" \w* \w shekels| strong="H8255" \w*, [fifteen]{strong=“H6235 H2568”} \w shekels| strong="H8255" \w*, \w shall be your maneh| strong="H4488" \w*. 
\p
\v 13 This is \w the oblation| strong="H8641" \w* [that ye shall offer]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”}; \w the sixth part| strong="H8345" \w* \w of an ephah| strong="H374" \w* \w of an homer| strong="H2563" \w* \w of wheat| strong="H2406" \w*, [and ye shall give the sixth part]{strong=“H8341” x-morph=“strongMorph: \sc Th\sc*8765”} \w of an ephah| strong="H374" \w* \w of an homer| strong="H2563" \w* \w of barley| strong="H8184" \w*: 
\v 14 \w Concerning the ordinance| strong="H2706" \w* \w of oil| strong="H8081" \w*, \w the bath| strong="H1324" \w* \w of oil| strong="H8081" \w*, ye shall offer \w the tenth part| strong="H4643" \w* \w of a bath| strong="H1324" \w* \w out of the cor| strong="H3734" \w*, which is \w an homer| strong="H2563" \w* \w of ten| strong="H6235" \w* \w baths| strong="H1324" \w*; \w for ten| strong="H6235" \w* \w baths| strong="H1324" \w* are \w an homer| strong="H2563" \w*: 
