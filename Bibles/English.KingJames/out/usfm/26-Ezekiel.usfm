\v 22 [And I will make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w them one| strong="H259" \w* \w nation| strong="H1471" \w* \w in the land| strong="H776" \w* \w upon the mountains| strong="H2022" \w* \w of Israel| strong="H3478" \w*; \w and one| strong="H259" \w* \w king| strong="H4428" \w* \w shall be king| strong="H4428" \w* [to them all: and they shall be]{strong=“H5750”} \w no more two| strong="H8147" \w* \w nations| strong="H1471" \w*, [neither shall they be divided]{strong=“H2673” x-morph=“strongMorph: \sc Th\sc*8735”} \w into two| strong="H8147" \w* \w kingdoms| strong="H4467" \w* any more at all: 
\v 23 [Neither shall they defile]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8691”} \w themselves any more with their idols| strong="H1544" \w*, \w nor with their detestable things| strong="H8251" \w*, \w nor with any of their transgressions| strong="H6588" \w*: [but I will save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8689”} \w them out of all their dwellingplaces| strong="H4186" \w*, [wherein they have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}, [and will cleanse]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8765”} [them: so shall they be my people]{strong=“H5971”}, \w and I will be their God| strong="H430" \w*. 
\v 24 \w And David| strong="H1732" \w* \w my servant| strong="H5650" \w* shall be \w king| strong="H4428" \w* [over them; and they all shall have one]{strong=“H259”} [shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}: [they shall also walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w in my judgments| strong="H4941" \w*, [and observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w my statutes| strong="H2708" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} them. 
