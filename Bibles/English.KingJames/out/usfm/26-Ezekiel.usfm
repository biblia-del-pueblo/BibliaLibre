\c 48
\p 
\v 1 Now these are \w the names| strong="H8034" \w* \w of the tribes| strong="H7626" \w*. \w From the north| strong="H6828" \w* \w end| strong="H7097" \w* \w to the coast| strong="H3027" \w* \w of the way| strong="H1870" \w* \w of Hethlon| strong="H2855" \w*, [as one goeth]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w to Hamath| strong="H2574" \w*, [Hazar-enan]{strong=“H2704”}, \w the border| strong="H1366" \w* \w of Damascus| strong="H1834" \w* \w northward| strong="H6828" \w*, \w to the coast| strong="H3027" \w* \w of Hamath| strong="H2574" \w*; \w for these are his sides| strong="H6285" \w* \w east| strong="H6921" \w* and \w west| strong="H3220" \w*; \w a| strong="H259" \w* portion for \w Dan| strong="H1835" \w*.\f + \fr 48:1 \ft a portion: Heb. one portion \f* 
\v 2 \w And by the border| strong="H1366" \w* \w of Dan| strong="H1835" \w*, \w from the east| strong="H6921" \w* \w side| strong="H6285" \w* \w unto the west| strong="H3220" \w* \w side| strong="H6285" \w*, \w a| strong="H259" \w* portion for \w Asher| strong="H836" \w*. 
\v 3 \w And by the border| strong="H1366" \w* \w of Asher| strong="H836" \w*, \w from the east| strong="H6921" \w* \w side| strong="H6285" \w* \w even unto the west| strong="H3220" \w* \w side| strong="H6285" \w*, \w a| strong="H259" \w* portion for \w Naphtali| strong="H5321" \w*. 
\v 4 \w And by the border| strong="H1366" \w* \w of Naphtali| strong="H5321" \w*, \w from the east| strong="H6921" \w* \w side| strong="H6285" \w* \w unto the west| strong="H3220" \w* \w side| strong="H6285" \w*, \w a| strong="H259" \w* portion for \w Manasseh| strong="H4519" \w*. 
\v 5 \w And by the border| strong="H1366" \w* \w of Manasseh| strong="H4519" \w*, \w from the east| strong="H6921" \w* \w side| strong="H6285" \w* \w unto the west| strong="H3220" \w* \w side| strong="H6285" \w*, \w a| strong="H259" \w* portion for \w Ephraim| strong="H669" \w*. 
\v 6 \w And by the border| strong="H1366" \w* \w of Ephraim| strong="H669" \w*, \w from the east| strong="H6921" \w* \w side| strong="H6285" \w* \w even unto the west| strong="H3220" \w* \w side| strong="H6285" \w*, \w a| strong="H259" \w* portion for \w Reuben| strong="H7205" \w*. 
\v 7 \w And by the border| strong="H1366" \w* \w of Reuben| strong="H7205" \w*, \w from the east| strong="H6921" \w* \w side| strong="H6285" \w* \w unto the west| strong="H3220" \w* \w side| strong="H6285" \w*, \w a| strong="H259" \w* portion for \w Judah| strong="H3063" \w*. 
