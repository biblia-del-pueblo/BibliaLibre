\p
\v 21 [But I had pity]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”} \w for mine holy| strong="H6944" \w* \w name| strong="H8034" \w*, \w which the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* [had profaned]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8765”} \w among the heathen| strong="H1471" \w*, [whither they went]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}. 
