\p
\v 10 \w Wherefore David| strong="H1732" \w* [blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} the \sc Lord\sc* \w before| strong="H5869" \w* \w all the congregation| strong="H6951" \w*: \w and David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} be thou, \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w* \w our father| strong="H1" \w*, \w for| strong="H5704" \w* \w ever| strong="H5769" \w* \w and ever| strong="H5769" \w*. 
\v 11 Thine, O \sc Lord\sc*, is \w the greatness| strong="H1420" \w*, \w and the power| strong="H1369" \w*, \w and the glory| strong="H8597" \w*, \w and the victory| strong="H5331" \w*, \w and the majesty| strong="H1935" \w*: for all that is \w in the heaven| strong="H8064" \w* \w and in the earth| strong="H776" \w* is thine; thine is \w the kingdom| strong="H4467" \w*, O \sc Lord\sc*, [and thou art exalted]{strong=“H4984” x-morph=“strongMorph: \sc Th\sc*8693”} \w as head| strong="H7218" \w* above all. 
\v 12 \w Both riches| strong="H6239" \w* \w and honour| strong="H3519" \w* come \w of thee| strong="H6440" \w*, [and thou reignest]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8802”} [over all; and in thine hand]{strong=“H3027”} is \w power| strong="H3581" \w* \w and might| strong="H1369" \w*; \w and in thine hand| strong="H3027" \w* it is [to make great]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8763”}, [and to give strength]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8763”} unto all. 
\v 13 [Now therefore, our God]{strong=“H430”}, [we thank]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8688”} [thee, and praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8764”} \w thy glorious| strong="H8597" \w* \w name| strong="H8034" \w*. 
\v 14 But who am I, and what is \w my people| strong="H5971" \w*, [that we should be]{strong=“H6113” x-morph=“strongMorph: \sc Th\sc*8799”} \w able| strong="H3581" \w* [to offer so willingly]{strong=“H5068” x-morph=“strongMorph: \sc Th\sc*8692”} after this sort? for all things come [of thee, and of thine own]{strong=“H3027”} [have we given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} thee.\f + \fr 29:14 \ft be able: Heb. retain, or, obtain strength \f* \f + \fr 29:14 \ft of thine…: Heb. of thine hand \f* 
\v 15 For we are \w strangers| strong="H1616" \w* \w before| strong="H6440" \w* [thee, and sojourners]{strong=“H8453”}, as were \w all our fathers| strong="H1" \w*: \w our days| strong="H3117" \w* \w on the earth| strong="H776" \w* are \w as a shadow| strong="H6738" \w*, and there is \w none abiding| strong="H4723" \w*.\f + \fr 29:15 \ft abiding: Heb. expectation \f* 
\v 16 O \sc Lord\sc* \w our God| strong="H430" \w*, \w all this store| strong="H1995" \w* [that we have prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8689”} [to build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8800”} \w thee an house| strong="H1004" \w* \w for thine holy| strong="H6944" \w* \w name| strong="H8034" \w* cometh \w of thine hand| strong="H3027" \w*, and is all thine own. 
\v 17 [I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [also, my God]{strong=“H430”}, [that thou triest]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8802”} \w the heart| strong="H3824" \w*, [and hast pleasure]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8799”} \w in uprightness| strong="H3476" \w*. [As for me, in the uprightness]{strong=“H4339”} \w of mine heart| strong="H3824" \w* [I have willingly offered]{strong=“H5068” x-morph=“strongMorph: \sc Th\sc*8694”} [all these things: and now have I seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w with joy| strong="H8057" \w* \w thy people| strong="H5971" \w*, [which are present]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8738”} [here, to offer willingly]{strong=“H5068” x-morph=“strongMorph: \sc Th\sc*8692”} unto thee.\f + \fr 29:17 \ft present: Heb. found \f* 
\v 18 O \sc Lord\sc* \w God| strong="H430" \w* \w of Abraham| strong="H85" \w*, \w Isaac| strong="H3327" \w*, \w and of Israel| strong="H3478" \w*, \w our fathers| strong="H1" \w*, [keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8798”} \w this for ever| strong="H5769" \w* \w in the imagination| strong="H3336" \w* \w of the thoughts| strong="H4284" \w* \w of the heart| strong="H3824" \w* \w of thy people| strong="H5971" \w*, [and prepare]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8685”} \w their heart| strong="H3824" \w* unto thee:\f + \fr 29:18 \ft prepare: or, stablish \f* 
