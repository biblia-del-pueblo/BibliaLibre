\p
\v 20 \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to all the congregation| strong="H6951" \w*, [Now bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc* \w your God| strong="H430" \w*. \w And all the congregation| strong="H6951" \w* [blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} the \sc Lord\sc* \w God| strong="H430" \w* \w of their fathers| strong="H1" \w*, [and bowed down their heads]{strong=“H6915” x-morph=“strongMorph: \sc Th\sc*8799”}, [and worshipped]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} the \sc Lord\sc*, \w and the king| strong="H4428" \w*. 
