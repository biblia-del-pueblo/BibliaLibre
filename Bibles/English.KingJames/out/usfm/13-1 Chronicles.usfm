\v 25 And the \sc Lord\sc* [magnified ]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8762”} \w Solomon| strong="H8010" \w* \w exceedingly| strong="H4605" \w* \w in the sight| strong="H5869" \w* \w of all Israel| strong="H3478" \w*, [and bestowed]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} upon him such \w royal| strong="H4438" \w* \w majesty| strong="H1935" \w* \w as had not been on any king| strong="H4428" \w* \w before| strong="H6440" \w* \w him in Israel| strong="H3478" \w*. 
\p
\v 26 \w Thus David| strong="H1732" \w* \w the son| strong="H1121" \w* \w of Jesse| strong="H3448" \w* [reigned]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8804”} \w over all Israel| strong="H3478" \w*. 
\v 27 \w And the time| strong="H3117" \w* [that he reigned]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8804”} \w over Israel| strong="H3478" \w* was \w forty| strong="H705" \w* \w years| strong="H8141" \w*; \w seven| strong="H7651" \w* \w years| strong="H8141" \w* [reigned]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8804”} \w he in Hebron| strong="H2275" \w*, \w and thirty| strong="H7970" \w* \w and three| strong="H7969" \w* years [reigned]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8804”} \w he in Jerusalem| strong="H3389" \w*. 
\v 28 [And he died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w in a good| strong="H2896" \w* \w old age| strong="H7872" \w*, \w full| strong="H7649" \w* \w of days| strong="H3117" \w*, \w riches| strong="H6239" \w*, \w and honour| strong="H3519" \w*: \w and Solomon| strong="H8010" \w* \w his son| strong="H1121" \w* [reigned]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8799”} in his stead. 
\v 29 \w Now the acts| strong="H1697" \w* \w of David| strong="H1732" \w* \w the king| strong="H4428" \w*, \w first| strong="H7223" \w* \w and last| strong="H314" \w*, behold, they are [written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8803”} \w in the book| strong="H1697" \w* \w of Samuel| strong="H8050" \w* [the seer]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and in the book| strong="H1697" \w* \w of Nathan| strong="H5416" \w* \w the prophet| strong="H5030" \w*, \w and in the book| strong="H1697" \w* \w of Gad| strong="H1410" \w* \w the seer| strong="H2374" \w*,\f + \fr 29:29 \ft book: or, history: Heb. words \f* 
\v 30 \w With all his reign| strong="H4438" \w* \w and his might| strong="H1369" \w*, \w and the times| strong="H6256" \w* [that went over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} [him, and over Israel]{strong=“H3478”}, \w and over all the kingdoms| strong="H4467" \w* \w of the countries| strong="H776" \w*. 
