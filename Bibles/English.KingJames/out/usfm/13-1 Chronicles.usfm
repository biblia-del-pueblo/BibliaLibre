\v 40 \w Moreover they that were nigh| strong="H7138" \w* them, even \w unto Issachar| strong="H3485" \w* \w and Zebulun| strong="H2074" \w* \w and Naphtali| strong="H5321" \w*, [brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w bread| strong="H3899" \w* \w on asses| strong="H2543" \w*, \w and on camels| strong="H1581" \w*, \w and on mules| strong="H6505" \w*, \w and on oxen| strong="H1241" \w*, and \w meat| strong="H3978" \w*, \w meal| strong="H7058" \w*, \w cakes| strong="H1690" \w* [of figs, and bunches of raisins]{strong=“H6778”}, \w and wine| strong="H3196" \w*, \w and oil| strong="H8081" \w*, \w and oxen| strong="H1241" \w*, \w and sheep| strong="H6629" \w* \w abundantly| strong="H7230" \w*: for there was \w joy| strong="H8057" \w* \w in Israel| strong="H3478" \w*.\f + \fr 12:40 \ft meat…: or, victual of meal \f*
\c 13
\p 
\v 1 \w And David| strong="H1732" \w* [consulted]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8735”} \w with the captains| strong="H8269" \w* \w of thousands| strong="H505" \w* \w and hundreds| strong="H3967" \w*, and \w with every leader| strong="H5057" \w*. 
\v 2 \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto all the congregation| strong="H6951" \w* \w of Israel| strong="H3478" \w*, If it seem [good]{strong=“H2895” x-morph=“strongMorph: \sc Th\sc*8804”} unto you, and that it be of the \sc Lord\sc* \w our God| strong="H430" \w*, [let us send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} [abroad]{strong=“H6555” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto our brethren| strong="H251" \w* every where, that are [left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”} \w in all the land| strong="H776" \w* \w of Israel| strong="H3478" \w*, and with them also \w to the priests| strong="H3548" \w* \w and Levites| strong="H3881" \w* which are \w in their cities| strong="H5892" \w* and \w suburbs| strong="H4054" \w*, [that they may gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8735”} themselves unto us:\f + \fr 13:2 \ft send…: Heb. break forth and send \f* \f + \fr 13:2 \ft in their…: Heb. in the cities of their suburbs \f* 
\v 3 [And let us bring again]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8686”} \w the ark| strong="H727" \w* \w of our God| strong="H430" \w* [to us: for we enquired]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8804”} \w not at it in the days| strong="H3117" \w* \w of Saul| strong="H7586" \w*.\f + \fr 13:3 \ft bring…: Heb. bring about \f* 
\v 4 \w And all the congregation| strong="H6951" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [that they would do so]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”}: \w for the thing| strong="H1697" \w* [was right]{strong=“H3474” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the eyes| strong="H5869" \w* \w of all the people| strong="H5971" \w*. 
\v 5 \w So David| strong="H1732" \w* \w gathered| strong="H6950" \w* \w all Israel| strong="H3478" \w* [together]{strong=“H6950” x-morph=“strongMorph: \sc Th\sc*8686”}, \w from Shihor| strong="H7883" \w* \w of Egypt| strong="H4714" \w* [even unto the entering]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w of Hemath| strong="H2574" \w*, [to bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} \w the ark| strong="H727" \w* \w of God| strong="H430" \w* [from Kirjath-jearim]{strong=“H7157”}. 
\v 6 \w And David| strong="H1732" \w* [went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and all Israel| strong="H3478" \w*, \w to Baalah| strong="H1173" \w*, that is, [to Kirjath-jearim]{strong=“H7157”}, which belonged \w to Judah| strong="H3063" \w*, [to bring up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8687”} \w thence the ark| strong="H727" \w* \w of God| strong="H430" \w* the \sc Lord\sc*, [that dwelleth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} between \w the cherubims| strong="H3742" \w*, \w whose name| strong="H8034" \w* [is called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8738”} on it. 
\v 7 [And they carried]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8686”} \w the ark| strong="H727" \w* \w of God| strong="H430" \w* \w in a new| strong="H2319" \w* \w cart| strong="H5699" \w* \w out of the house| strong="H1004" \w* \w of Abinadab| strong="H41" \w*: \w and Uzza| strong="H5798" \w* \w and Ahio| strong="H283" \w* [drave]{strong=“H5090” x-morph=“strongMorph: \sc Th\sc*8802”} \w the cart| strong="H5699" \w*.\f + \fr 13:7 \ft carried…: Heb. made the ark to ride \f* 
\v 8 \w And David| strong="H1732" \w* \w and all Israel| strong="H3478" \w* [played]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8764”} \w before| strong="H6440" \w* \w God| strong="H430" \w* with all their \w might| strong="H5797" \w*, \w and with singing| strong="H7892" \w*, \w and with harps| strong="H3658" \w*, \w and with psalteries| strong="H5035" \w*, \w and with timbrels| strong="H8596" \w*, \w and with cymbals| strong="H4700" \w*, \w and with trumpets| strong="H2689" \w*.\f + \fr 13:8 \ft singing: Heb. songs \f* 
\p
\v 9 [And when they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the threshingfloor| strong="H1637" \w* \w of Chidon| strong="H3592" \w*, \w Uzza| strong="H5798" \w* [put forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w his hand| strong="H3027" \w* [to hold]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8800”} \w the ark| strong="H727" \w*; \w for the oxen| strong="H1241" \w* [stumbled]{strong=“H8058” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 13:9 \ft Chidon: also called Nachon \f* \f + \fr 13:9 \ft stumbled: or, shook it \f* 
\v 10 \w And the anger| strong="H639" \w* of the \sc Lord\sc* [was kindled]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8799”} \w against Uzza| strong="H5798" \w*, [and he smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} [him, because he put]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w his hand| strong="H3027" \w* \w to the ark| strong="H727" \w*: [and there he died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* \w God| strong="H430" \w*. 
\v 11 \w And David| strong="H1732" \w* [was displeased]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8799”}, because the \sc Lord\sc* [had made]{strong=“H6555” x-morph=“strongMorph: \sc Th\sc*8804”} \w a breach| strong="H6556" \w* \w upon Uzza| strong="H5798" \w*: \w wherefore that place| strong="H4725" \w* [is called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} [Perez-uzza]{strong=“H6560”} \w to this day| strong="H3117" \w*.\f + \fr 13:11 \ft Perez-uzza: that is, The breach of Uzza \f* 
\v 12 \w And David| strong="H1732" \w* [was afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w of God| strong="H430" \w* \w that day| strong="H3117" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w How| strong="H1963" \w* [shall I bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w the ark| strong="H727" \w* \w of God| strong="H430" \w* home to me? 
\v 13 \w So David| strong="H1732" \w* [brought]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8689”} \w not the ark| strong="H727" \w* home \w to himself to the city| strong="H5892" \w* \w of David| strong="H1732" \w*, [but carried it aside]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w into the house| strong="H1004" \w* [of Obed-edom]{strong=“H5654”} \w the Gittite| strong="H1663" \w*.\f + \fr 13:13 \ft brought: Heb. removed \f* 
\v 14 \w And the ark| strong="H727" \w* \w of God| strong="H430" \w* [remained]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the family| strong="H1004" \w* [of Obed-edom]{strong=“H5654”} \w in his house| strong="H1004" \w* \w three| strong="H7969" \w* \w months| strong="H2320" \w*. And the \sc Lord\sc* [blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w the house| strong="H1004" \w* [of Obed-edom]{strong=“H5654”}, and all that he had.
\c 14
\p 
\v 1 [Now Hiram]{strong=“H2361 H2438” x-morph=“strongMorph: \sc Th\sc*8676”} \w king| strong="H4428" \w* \w of Tyre| strong="H6865" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w messengers| strong="H4397" \w* \w to David| strong="H1732" \w*, \w and timber| strong="H6086" \w* \w of cedars| strong="H730" \w*, \w with masons| strong="H7023" \w* \w and carpenters| strong="H2796" \w*, [to build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8800”} \w him an house| strong="H1004" \w*. 
\v 2 \w And David| strong="H1732" \w* [perceived]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} that the \sc Lord\sc* [had confirmed]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8689”} \w him king| strong="H4428" \w* \w over Israel| strong="H3478" \w*, \w for his kingdom| strong="H4438" \w* [was lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8738”} \w on high| strong="H4605" \w*, \w because of his people| strong="H5971" \w* \w Israel| strong="H3478" \w*. 
\p
\v 3 \w And David| strong="H1732" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w more wives| strong="H802" \w* \w at Jerusalem| strong="H3389" \w*: \w and David| strong="H1732" \w* [begat ]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8686”} \w more sons| strong="H1121" \w* \w and daughters| strong="H1323" \w*.\f + \fr 14:3 \ft more: Heb. yet \f* 
\v 4 Now these are \w the names| strong="H8034" \w* of his [children]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8803”} \w which he had in Jerusalem| strong="H3389" \w*; \w Shammua| strong="H8051" \w*, \w and Shobab| strong="H7727" \w*, \w Nathan| strong="H5416" \w*, \w and Solomon| strong="H8010" \w*, 
\v 5 \w And Ibhar| strong="H2984" \w*, \w and Elishua| strong="H474" \w*, \w and Elpalet| strong="H467" \w*, 
\v 6 \w And Nogah| strong="H5052" \w*, \w and Nepheg| strong="H5298" \w*, \w and Japhia| strong="H3309" \w*, 
\v 7 \w And Elishama| strong="H476" \w*, \w and Beeliada| strong="H1182" \w*, \w and Eliphalet| strong="H467" \w*.\f + \fr 14:7 \ft Beeliada: also called, Eliada \f* 
\p
\v 8 \w And when the Philistines| strong="H6430" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w that David| strong="H1732" \w* [was anointed]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8738”} \w king| strong="H4428" \w* \w over all Israel| strong="H3478" \w*, \w all the Philistines| strong="H6430" \w* [went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} [to seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8763”} \w David| strong="H1732" \w*. \w And David| strong="H1732" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} of it, [and went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w against| strong="H6440" \w* them. 
\v 9 \w And the Philistines| strong="H6430" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [and spread]{strong=“H6584” x-morph=“strongMorph: \sc Th\sc*8799”} \w themselves in the valley| strong="H6010" \w* \w of Rephaim| strong="H7497" \w*. 
\v 10 \w And David| strong="H1732" \w* [enquired]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} \w of God| strong="H430" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Shall I go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w against the Philistines| strong="H6430" \w*? [and wilt thou deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w them into mine hand| strong="H3027" \w*? And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”}; [for I will deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w them into thine hand| strong="H3027" \w*. 
\v 11 [So they came up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} [to Baal-perazim]{strong=“H1188”}; \w and David| strong="H1732" \w* [smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} [them there. Then David]{strong=“H1732”} [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w God| strong="H430" \w* [hath broken in]{strong=“H6555” x-morph=“strongMorph: \sc Th\sc*8804”} [upon mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w by mine hand| strong="H3027" \w* \w like the breaking forth| strong="H6556" \w* \w of waters| strong="H4325" \w*: [therefore they called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w the name| strong="H8034" \w* \w of that place| strong="H4725" \w* [Baal-perazim]{strong=“H1188”}.\f + \fr 14:11 \ft Baal-perazim: that is, A place of breaches \f* 
\v 12 [And when they had left]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w their gods| strong="H430" \w* [there, David]{strong=“H1732”} [gave a commandment]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [and they were burned]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8735”} \w with fire| strong="H784" \w*. 
\v 13 \w And the Philistines| strong="H6430" \w* [yet again]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [spread themselves abroad]{strong=“H6584” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the valley| strong="H6010" \w*. 
\v 14 \w Therefore David| strong="H1732" \w* [enquired]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} \w again of God| strong="H430" \w*; \w and God| strong="H430" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Go not up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* [them; turn away]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8685”} [from them, and come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon them over against| strong="H4136" \w* \w the mulberry trees| strong="H1057" \w*. 
\v 15 [And it shall be, when thou shalt hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w a sound| strong="H6963" \w* \w of going| strong="H6807" \w* \w in the tops| strong="H7218" \w* \w of the mulberry trees| strong="H1057" \w*, that [then thou shalt go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w to battle| strong="H4421" \w*: \w for God| strong="H430" \w* [is gone forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* [thee to smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8687”} \w the host| strong="H4264" \w* \w of the Philistines| strong="H6430" \w*. 
\v 16 \w David| strong="H1732" \w* [therefore did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w as God| strong="H430" \w* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [him: and they smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w the host| strong="H4264" \w* \w of the Philistines| strong="H6430" \w* \w from Gibeon| strong="H1391" \w* \w even to Gazer| strong="H1507" \w*.\f + \fr 14:16 \ft Gibeon: also called, Geba \f* 
\v 17 \w And the fame| strong="H8034" \w* \w of David| strong="H1732" \w* [went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w into all lands| strong="H776" \w*; and the \sc Lord\sc* [brought]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w the fear| strong="H6343" \w* \w of him upon all nations| strong="H1471" \w*.
\c 15
\p 
\v 1 And David [made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w him houses| strong="H1004" \w* \w in the city| strong="H5892" \w* \w of David| strong="H1732" \w*, [and prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8686”} \w a place| strong="H4725" \w* \w for the ark| strong="H727" \w* \w of God| strong="H430" \w*, [and pitched]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8799”} \w for it a tent| strong="H168" \w*. 
\v 2 \w Then David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [None ought to carry]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8800”} \w the ark| strong="H727" \w* \w of God| strong="H430" \w* \w but the Levites| strong="H3881" \w*: for them hath the \sc Lord\sc* [chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} [to carry]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8800”} \w the ark| strong="H727" \w* \w of God| strong="H430" \w*, [and to minister]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8763”} \w unto him for| strong="H5704" \w* \w ever| strong="H5769" \w*.\f + \fr 15:2 \ft None…: Heb. It is not to carry the ark of God, but for the Levites \f* 
\v 3 \w And David| strong="H1732" \w* \w gathered| strong="H6950" \w* \w all Israel| strong="H3478" \w* [together]{strong=“H6950” x-morph=“strongMorph: \sc Th\sc*8686”} \w to Jerusalem| strong="H3389" \w*, [to bring up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8687”} \w the ark| strong="H727" \w* of the \sc Lord\sc* \w unto his place| strong="H4725" \w*, [which he had prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8689”} for it. 
