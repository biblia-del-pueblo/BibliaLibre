\v 20 O \sc Lord\sc*, there is none like thee, neither is there any \w God| strong="H430" \w* \w beside| strong="H2108" \w* [thee, according to all that we have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w with our ears| strong="H241" \w*. 
\v 21 \w And what one| strong="H259" \w* \w nation| strong="H1471" \w* \w in the earth| strong="H776" \w* is \w like thy people| strong="H5971" \w* \w Israel| strong="H3478" \w*, \w whom God| strong="H430" \w* [went]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} [to redeem]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8800”} to be \w his own people| strong="H5971" \w*, [to make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w thee a name| strong="H8034" \w* \w of greatness| strong="H1420" \w* [and terribleness]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”}, [by driving out]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8763”} \w nations| strong="H1471" \w* \w from before| strong="H6440" \w* \w thy people| strong="H5971" \w*, [whom thou hast redeemed]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8804”} \w out of Egypt| strong="H4714" \w*? 
\v 22 \w For thy people| strong="H5971" \w* \w Israel| strong="H3478" \w* [didst thou make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thine own people| strong="H5971" \w* \w for| strong="H5704" \w* \w ever| strong="H5769" \w*; and thou, \sc Lord\sc*, \w becamest their God| strong="H430" \w*. 
\v 23 Therefore now, \sc Lord\sc*, \w let the thing| strong="H1697" \w* [that thou hast spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w concerning thy servant| strong="H5650" \w* \w and concerning his house| strong="H1004" \w* [be established]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8735”} \w for| strong="H5704" \w* \w ever| strong="H5769" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} [as thou hast said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 24 [Let it even be established]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8735”}, \w that thy name| strong="H8034" \w* [may be magnified]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8799”} \w for| strong="H5704" \w* \w ever| strong="H5769" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, The \sc Lord\sc* \w of hosts| strong="H6635" \w* is \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*, even \w a God| strong="H430" \w* \w to Israel| strong="H3478" \w*: and let \w the house| strong="H1004" \w* \w of David| strong="H1732" \w* \w thy servant| strong="H5650" \w* be [established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8737”} \w before| strong="H6440" \w* thee. 
\v 25 [For thou, O my God]{strong=“H430”}, [hast told]{strong=“H241 H1540” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy servant| strong="H5650" \w* [that thou wilt build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8800”} \w him an house| strong="H1004" \w*: \w therefore thy servant| strong="H5650" \w* [hath found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} in his heart [to pray]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8692”} \w before| strong="H6440" \w* thee.\f + \fr 17:25 \ft hast…: Heb. hast revealed the ear of thy servant \f* 
\v 26 And now, \sc Lord\sc*, \w thou art God| strong="H430" \w*, [and hast promised]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w this goodness| strong="H2896" \w* \w unto thy servant| strong="H5650" \w*: 
\v 27 [Now therefore let it please]{strong=“H2974” x-morph=“strongMorph: \sc Th\sc*8689”} [thee to bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8763”} \w the house| strong="H1004" \w* \w of thy servant| strong="H5650" \w*, \w that it may be before| strong="H6440" \w* \w thee for ever| strong="H5769" \w*: [for thou blessest]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”}, O \sc Lord\sc*, and it shall be [blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8794”} \w for ever| strong="H5769" \w*.\f + \fr 17:27 \ft let…: or, it hath pleased thee \f*
\c 18
\p 
\v 1 \w Now after this| strong="H310" \w* [it came to pass, that David]{strong=“H1732”} [smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w the Philistines| strong="H6430" \w*, [and subdued]{strong=“H3665” x-morph=“strongMorph: \sc Th\sc*8686”} [them, and took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w Gath| strong="H1661" \w* \w and her towns| strong="H1323" \w* \w out of the hand| strong="H3027" \w* \w of the Philistines| strong="H6430" \w*. 
\v 2 [And he smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w Moab| strong="H4124" \w*; \w and the Moabites| strong="H4124" \w* [became David’s]{strong=“H1732”} \w servants| strong="H5650" \w*, and [brought]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8802”} \w gifts| strong="H4503" \w*. 
\p
\v 3 \w And David| strong="H1732" \w* [smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w Hadarezer| strong="H1928" \w* \w king| strong="H4428" \w* \w of Zobah| strong="H6678" \w* \w unto Hamath| strong="H2574" \w*, [as he went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} [to stablish]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8687”} \w his dominion| strong="H3027" \w* \w by the river| strong="H5104" \w* \w Euphrates| strong="H6578" \w*.\f + \fr 18:3 \ft Hadarezer: or, Hadadezer \f* 
\v 4 \w And David| strong="H1732" \w* [took]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8799”} \w from him a thousand| strong="H505" \w* \w chariots| strong="H7393" \w*, \w and seven| strong="H7651" \w* \w thousand| strong="H505" \w* \w horsemen| strong="H6571" \w*, \w and twenty| strong="H6242" \w* \w thousand| strong="H505" \w* [footmen]{strong=“H7273 H376”}: \w David| strong="H1732" \w* [also houghed]{strong=“H6131” x-morph=“strongMorph: \sc Th\sc*8762”} \w all the chariot| strong="H7393" \w* horses, [but reserved]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8686”} \w of them an hundred| strong="H3967" \w* \w chariots| strong="H7393" \w*.\f + \fr 18:4 \ft seven…: or, seven hundred \f* 
\v 5 \w And when the Syrians| strong="H758" \w* \w of Damascus| strong="H1834" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [to help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8800”} \w Hadarezer| strong="H1928" \w* \w king| strong="H4428" \w* \w of Zobah| strong="H6678" \w*, \w David| strong="H1732" \w* [slew]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w of the Syrians| strong="H758" \w* \w two| strong="H8147" \w* \w and twenty| strong="H6242" \w* \w thousand| strong="H505" \w* \w men| strong="H376" \w*.\f + \fr 18:5 \ft Damascus: Heb. Darmesek \f* 
\v 6 \w Then David| strong="H1732" \w* [put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} garrisons [in Syria-damascus]{strong=“H1834 H758”}; \w and the Syrians| strong="H758" \w* [became David’s]{strong=“H1732”} \w servants| strong="H5650" \w*, and [brought]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8802”} \w gifts| strong="H4503" \w*. Thus the \sc Lord\sc* [preserved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} \w David| strong="H1732" \w* [whithersoever he went]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 7 \w And David| strong="H1732" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the shields| strong="H7982" \w* \w of gold| strong="H2091" \w* \w that were on the servants| strong="H5650" \w* \w of Hadarezer| strong="H1928" \w*, [and brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w them to Jerusalem| strong="H3389" \w*. 
\v 8 \w Likewise from Tibhath| strong="H2880" \w*, \w and from Chun| strong="H3560" \w*, \w cities| strong="H5892" \w* \w of Hadarezer| strong="H1928" \w*, [brought]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w David| strong="H1732" \w* \w very| strong="H3966" \w* \w much| strong="H7227" \w* \w brass| strong="H5178" \w*, \w wherewith Solomon| strong="H8010" \w* [made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w the brasen| strong="H5178" \w* \w sea| strong="H3220" \w*, \w and the pillars| strong="H5982" \w*, \w and the vessels| strong="H3627" \w* \w of brass| strong="H5178" \w*.\f + \fr 18:8 \ft Tibhath…: called in the book of Samuel Betah, and Berothai \f* 
\p
\v 9 \w Now when Tou| strong="H8583" \w* \w king| strong="H4428" \w* \w of Hamath| strong="H2574" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w how David| strong="H1732" \w* [had smitten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w all the host| strong="H2428" \w* \w of Hadarezer| strong="H1928" \w* \w king| strong="H4428" \w* \w of Zobah| strong="H6678" \w*;\f + \fr 18:9 \ft Tou: also called, Toi \f* 
\v 10 [He sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w Hadoram| strong="H1913" \w* \w his son| strong="H1121" \w* \w to king| strong="H4428" \w* \w David| strong="H1732" \w*, [to enquire]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8800”} \w of his welfare| strong="H7965" \w*, [and to congratulate]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8763”} [him, because he had fought]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8738”} \w against Hadarezer| strong="H1928" \w*, [and smitten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} [him; (for Hadarezer]{strong=“H1928”} [had war]{strong=“H4421 H376”} \w with Tou| strong="H8583" \w*;) and with him \w all manner of vessels| strong="H3627" \w* \w of gold| strong="H2091" \w* \w and silver| strong="H3701" \w* \w and brass| strong="H5178" \w*.\f + \fr 18:10 \ft Hadoram: also called, Joram \f* \f + \fr 18:10 \ft to enquire…: or, to salute \f* \f + \fr 18:10 \ft to congratulate: Heb. to bless \f* \f + \fr 18:10 \ft had war: Heb. was the man of wars \f* 
\p
\v 11 \w Them also king| strong="H4428" \w* \w David| strong="H1732" \w* [dedicated]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8689”} unto the \sc Lord\sc*, \w with the silver| strong="H3701" \w* \w and the gold| strong="H2091" \w* [that he brought]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} from all these \w nations| strong="H1471" \w*; \w from Edom| strong="H123" \w*, \w and from Moab| strong="H4124" \w*, \w and from the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w*, \w and from the Philistines| strong="H6430" \w*, \w and from Amalek| strong="H6002" \w*. 
\v 12 \w Moreover Abishai| strong="H52" \w* \w the son| strong="H1121" \w* \w of Zeruiah| strong="H6870" \w* [slew]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w of the Edomites| strong="H123" \w* \w in the valley| strong="H1516" \w* \w of salt| strong="H4417" \w* [eighteen]{strong=“H6240 H8083”} \w thousand| strong="H505" \w*.\f + \fr 18:12 \ft Abishai: Heb. Abshai \f* 
\p
\v 13 [And he put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w garrisons| strong="H5333" \w* \w in Edom| strong="H123" \w*; \w and all the Edomites| strong="H123" \w* [became David’s]{strong=“H1732”} \w servants| strong="H5650" \w*. Thus the \sc Lord\sc* [preserved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} \w David| strong="H1732" \w* [whithersoever he went]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\p
\v 14 \w So David| strong="H1732" \w* [reigned]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8799”} \w over all Israel| strong="H3478" \w*, [and executed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w judgment| strong="H4941" \w* \w and justice| strong="H6666" \w* \w among all his people| strong="H5971" \w*. 
\v 15 \w And Joab| strong="H3097" \w* \w the son| strong="H1121" \w* \w of Zeruiah| strong="H6870" \w* was \w over the host| strong="H6635" \w*; \w and Jehoshaphat| strong="H3092" \w* \w the son| strong="H1121" \w* \w of Ahilud| strong="H286" \w*, [recorder]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8688”}.\f + \fr 18:15 \ft recorder: or, remembrancer \f* 
\v 16 \w And Zadok| strong="H6659" \w* \w the son| strong="H1121" \w* \w of Ahitub| strong="H285" \w*, \w and Abimelech| strong="H40" \w* \w the son| strong="H1121" \w* \w of Abiathar| strong="H54" \w*, were \w the priests| strong="H3548" \w*; \w and Shavsha| strong="H7798" \w* [was scribe]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8802”};\f + \fr 18:16 \ft Abimelech: also called, Ahimelech \f* \f + \fr 18:16 \ft Shavsha: also called Seraiah or Shisha \f* 
\v 17 \w And Benaiah| strong="H1141" \w* \w the son| strong="H1121" \w* \w of Jehoiada| strong="H3077" \w* was \w over the Cherethites| strong="H3774" \w* \w and the Pelethites| strong="H6432" \w*; \w and the sons| strong="H1121" \w* \w of David| strong="H1732" \w* were \w chief| strong="H7223" \w* \w about| strong="H3027" \w* \w the king| strong="H4428" \w*.\f + \fr 18:17 \ft about…: Heb. at the hand of the king \f*
\c 19
\p 
\v 1 \w Now it came to pass after this| strong="H310" \w*, \w that Nahash| strong="H5176" \w* \w the king| strong="H4428" \w* \w of the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w* [died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and his son| strong="H1121" \w* [reigned]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8799”} in his stead. 
\v 2 \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will shew]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w kindness| strong="H2617" \w* \w unto Hanun| strong="H2586" \w* \w the son| strong="H1121" \w* \w of Nahash| strong="H5176" \w*, \w because his father| strong="H1" \w* [shewed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w kindness| strong="H2617" \w* [to me. And David]{strong=“H1732”} [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w messengers| strong="H4397" \w* [to comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8763”} \w him concerning his father| strong="H1" \w*. \w So the servants| strong="H5650" \w* \w of David| strong="H1732" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the land| strong="H776" \w* \w of the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w* \w to Hanun| strong="H2586" \w*, [to comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8763”} him. 
\v 3 \w But the princes| strong="H8269" \w* \w of the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Hanun| strong="H2586" \w*, \w Thinkest| strong="H5869" \w* \w thou that David| strong="H1732" \w* [doth honour]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8764”} \w thy father| strong="H1" \w*, [that he hath sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [comforters]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8764”} [unto thee? are not his servants]{strong=“H5650”} [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [unto thee for to search]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8800”}, [and to overthrow]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8800”}, [and to spy out]{strong=“H7270” x-morph=“strongMorph: \sc Th\sc*8763”} \w the land| strong="H776" \w*?\f + \fr 19:3 \ft Thinkest…: Heb. In thine eyes doth David, etc \f* 
\v 4 \w Wherefore Hanun| strong="H2586" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [David’s]{strong=“H1732”} \w servants| strong="H5650" \w*, [and shaved]{strong=“H1548” x-morph=“strongMorph: \sc Th\sc*8762”} [them, and cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} \w their garments| strong="H4063" \w* \w in the midst| strong="H2677" \w* \w hard by their buttocks| strong="H4667" \w*, [and sent them away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 5 [Then there went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} certain, [and told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w David| strong="H1732" \w* \w how the men| strong="H582" \w* [were served. And he sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} [to meet]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} [them: for the men]{strong=“H582”} \w were greatly| strong="H3966" \w* [ashamed]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8737”}. \w And the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Tarry]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8798”} \w at Jericho| strong="H3405" \w* \w until your beards| strong="H2206" \w* [be grown]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8762”}, and then [return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\p
\v 6 \w And when the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [that they had made themselves odious]{strong=“H887” x-morph=“strongMorph: \sc Th\sc*8694”} \w to David| strong="H1732" \w*, \w Hanun| strong="H2586" \w* \w and the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w a thousand| strong="H505" \w* \w talents| strong="H3603" \w* \w of silver| strong="H3701" \w* [to hire]{strong=“H7936” x-morph=“strongMorph: \sc Th\sc*8800”} \w them chariots| strong="H7393" \w* \w and horsemen| strong="H6571" \w* \w out of Mesopotamia| strong="H763" \w*, [and out of Syria-maachah]{strong=“H4601 H758”}, \w and out of Zobah| strong="H6678" \w*.\f + \fr 19:6 \ft odious: Heb. to stink \f* 
\v 7 [So they hired]{strong=“H7936” x-morph=“strongMorph: \sc Th\sc*8799”} \w thirty| strong="H7970" \w* \w and two| strong="H8147" \w* \w thousand| strong="H505" \w* \w chariots| strong="H7393" \w*, \w and the king| strong="H4428" \w* \w of Maachah| strong="H4601" \w* \w and his people| strong="H5971" \w*; [who came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and pitched]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* \w Medeba| strong="H4311" \w*. \w And the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w* [gathered themselves together]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8738”} \w from their cities| strong="H5892" \w*, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to battle| strong="H4421" \w*. 
