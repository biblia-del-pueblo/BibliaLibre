\c 29
\p 
\v 1 \w Furthermore David| strong="H1732" \w* \w the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto all the congregation| strong="H6951" \w*, \w Solomon| strong="H8010" \w* \w my son| strong="H1121" \w*, \w whom alone| strong="H259" \w* \w God| strong="H430" \w* [hath chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”}, is yet \w young| strong="H5288" \w* \w and tender| strong="H7390" \w*, \w and the work| strong="H4399" \w* is \w great| strong="H1419" \w*: \w for the palace| strong="H1002" \w* is \w not for man| strong="H120" \w*, but for the \sc Lord\sc* \w God| strong="H430" \w*. 
\v 2 [Now I have prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8689”} \w with all my might| strong="H3581" \w* \w for the house| strong="H1004" \w* \w of my God| strong="H430" \w* \w the gold| strong="H2091" \w* for things to be made \w of gold| strong="H2091" \w*, \w and the silver| strong="H3701" \w* for things \w of silver| strong="H3701" \w*, \w and the brass| strong="H5178" \w* for things \w of brass| strong="H5178" \w*, \w the iron| strong="H1270" \w* for things \w of iron| strong="H1270" \w*, \w and wood| strong="H6086" \w* for things \w of wood| strong="H6086" \w*; \w onyx| strong="H7718" \w* \w stones| strong="H68" \w*, and stones \w to be set| strong="H4394" \w*, \w glistering| strong="H6320" \w* \w stones| strong="H68" \w*, \w and of divers colours| strong="H7553" \w*, \w and all manner of precious| strong="H3368" \w* \w stones| strong="H68" \w*, \w and marble| strong="H7893" \w* \w stones| strong="H68" \w* \w in abundance| strong="H7230" \w*. 
\v 3 [Moreover, because I have set my affection]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8800”} \w to the house| strong="H1004" \w* \w of my God| strong="H430" \w*, \w I have| strong="H3426" \w* \w of mine own proper good| strong="H5459" \w*, \w of gold| strong="H2091" \w* \w and silver| strong="H3701" \w*, which [I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the house| strong="H1004" \w* \w of my God| strong="H430" \w*, \w over and above| strong="H4605" \w* [all that I have prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8689”} \w for the holy| strong="H6944" \w* \w house| strong="H1004" \w*, 
\v 4 Even \w three| strong="H7969" \w* \w thousand| strong="H505" \w* \w talents| strong="H3603" \w* \w of gold| strong="H2091" \w*, \w of the gold| strong="H2091" \w* \w of Ophir| strong="H211" \w*, \w and seven| strong="H7651" \w* \w thousand| strong="H505" \w* \w talents| strong="H3603" \w* [of refined]{strong=“H2212” x-morph=“strongMorph: \sc Th\sc*8794”} \w silver| strong="H3701" \w*, [to overlay]{strong=“H2902” x-morph=“strongMorph: \sc Th\sc*8800”} \w the walls| strong="H7023" \w* \w of the houses| strong="H1004" \w* withal: 
\v 5 \w The gold| strong="H2091" \w* for things \w of gold| strong="H2091" \w*, \w and the silver| strong="H3701" \w* for things \w of silver| strong="H3701" \w*, \w and for all manner of work| strong="H4399" \w* to be made \w by the hands| strong="H3027" \w* \w of artificers| strong="H2796" \w*. And who then [is willing]{strong=“H5068” x-morph=“strongMorph: \sc Th\sc*8693”} [to consecrate]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8763”} \w his service| strong="H3027" \w* \w this day| strong="H3117" \w* unto the \sc Lord\sc*?\f + \fr 29:5 \ft consecrate his service: Heb. fill his hand \f* 
\p
\v 6 \w Then the chief| strong="H8269" \w* \w of the fathers| strong="H1" \w* \w and princes| strong="H8269" \w* \w of the tribes| strong="H7626" \w* \w of Israel| strong="H3478" \w*, \w and the captains| strong="H8269" \w* \w of thousands| strong="H505" \w* \w and of hundreds| strong="H3967" \w*, \w with the rulers| strong="H8269" \w* [of the king’s]{strong=“H4428”} \w work| strong="H4399" \w*, [offered willingly]{strong=“H5068” x-morph=“strongMorph: \sc Th\sc*8691”}, 
