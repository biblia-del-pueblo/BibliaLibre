\v 22 [And did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [and drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* the \sc Lord\sc* \w on that day| strong="H3117" \w* \w with great| strong="H1419" \w* \w gladness| strong="H8057" \w*. \w And they made Solomon| strong="H8010" \w* \w the son| strong="H1121" \w* \w of David| strong="H1732" \w* [king]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8686”} \w the second time| strong="H8145" \w*, [and anointed]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8799”} him unto the \sc Lord\sc* to be \w the chief governor| strong="H5057" \w*, \w and Zadok| strong="H6659" \w* to be \w priest| strong="H3548" \w*. 
\p
\v 23 \w Then Solomon| strong="H8010" \w* [sat on]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w the throne| strong="H3678" \w* of the \sc Lord\sc* \w as king| strong="H4428" \w* \w instead of David| strong="H1732" \w* \w his father| strong="H1" \w*, [and prospered]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8686”}; \w and all Israel| strong="H3478" \w* [obeyed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} him. 
