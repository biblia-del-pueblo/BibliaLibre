\c 3
\p 
\v 1 [And he shewed]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8686”} \w me Joshua| strong="H3091" \w* \w the high| strong="H1419" \w* \w priest| strong="H3548" \w* [standing]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w before| strong="H6440" \w* \w the angel| strong="H4397" \w* of the \sc Lord\sc*, \w and Satan| strong="H7854" \w* [standing]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w at his right hand| strong="H3225" \w* [to resist]{strong=“H7853” x-morph=“strongMorph: \sc Th\sc*8800”} him.\f + \fr 3:1 \ft Satan: that is, an adversary \f* \f + \fr 3:1 \ft to…: Heb. to be his adversary \f* 
\v 2 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Satan| strong="H7854" \w*, The \sc Lord\sc* [rebuke]{strong=“H1605” x-morph=“strongMorph: \sc Th\sc*8799”} [thee, O Satan]{strong=“H7854”}; even the \sc Lord\sc* [that hath chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8802”} \w Jerusalem| strong="H3389" \w* [rebuke]{strong=“H1605” x-morph=“strongMorph: \sc Th\sc*8799”} thee: is \w not this a brand| strong="H181" \w* [plucked]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8716”} \w out of the fire| strong="H784" \w*? 
\v 3 \w Now Joshua| strong="H3091" \w* [was clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8803”} \w with filthy| strong="H6674" \w* \w garments| strong="H899" \w*, [and stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w before| strong="H6440" \w* \w the angel| strong="H4397" \w*. 
\v 4 [And he answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto those that stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w before| strong="H6440" \w* [him, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8685”} \w the filthy| strong="H6674" \w* \w garments| strong="H899" \w* [from him. And unto him he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}, \w I have caused thine iniquity| strong="H5771" \w* [to pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8689”} [from thee, and I will clothe]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8687”} \w thee with change of raiment| strong="H4254" \w*. 
\v 5 [And I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Let them set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w a fair| strong="H2889" \w* \w mitre| strong="H6797" \w* \w upon his head| strong="H7218" \w*. [So they set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w a fair| strong="H2889" \w* \w mitre| strong="H6797" \w* \w upon his head| strong="H7218" \w*, [and clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8686”} \w him with garments| strong="H899" \w*. \w And the angel| strong="H4397" \w* of the \sc Lord\sc* [stood by]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 6 \w And the angel| strong="H4397" \w* of the \sc Lord\sc* [protested]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto Joshua| strong="H3091" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 7 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*; [If thou wilt walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w in my ways| strong="H1870" \w*, [and if thou wilt keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w my charge| strong="H4931" \w*, [then thou shalt also judge]{strong=“H1777” x-morph=“strongMorph: \sc Th\sc*8799”} \w my house| strong="H1004" \w*, [and shalt also keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w my courts| strong="H2691" \w*, [and I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [thee places to walk]{strong=“H4108” x-morph=“strongMorph: \sc Th\sc*8688”} [among these that stand by]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 3:7 \ft charge: or, ordinance \f* \f + \fr 3:7 \ft places…: Heb. walks \f* 
\p
\v 8 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [now, O Joshua]{strong=“H3091”} \w the high| strong="H1419" \w* \w priest| strong="H3548" \w*, [thou, and thy fellows]{strong=“H7453”} [that sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w before| strong="H6440" \w* thee: for they are \w men| strong="H582" \w* \w wondered at| strong="H4159" \w*: [for, behold, I will bring forth]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w my servant| strong="H5650" \w* the_\sc Branch\sc*_H6780.\f + \fr 3:8 \ft wondered…: Heb. of wonder, or, sign \f* 
\v 9 \w For behold the stone| strong="H68" \w* [that I have laid]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* \w Joshua| strong="H3091" \w*; \w upon one| strong="H259" \w* \w stone| strong="H68" \w* shall be \w seven| strong="H7651" \w* \w eyes| strong="H5869" \w*: [behold, I will engrave]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8764”} \w the graving| strong="H6603" \w* [thereof, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [and I will remove]{strong=“H4185” x-morph=“strongMorph: \sc Th\sc*8804”} \w the iniquity| strong="H5771" \w* \w of that land| strong="H776" \w* \w in one| strong="H259" \w* \w day| strong="H3117" \w*. 
\v 10 \w In that day| strong="H3117" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [shall ye call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w every man| strong="H376" \w* \w his neighbour| strong="H7453" \w* \w under the vine| strong="H1612" \w* \w and under the fig tree| strong="H8384" \w*.
\c 4
\p 
\v 1 \w And the angel| strong="H4397" \w* [that talked]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} [with me came again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [and waked]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8686”} [me, as a man]{strong=“H376”} [that is wakened]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8735”} \w out of his sleep| strong="H8142" \w*, 
\v 2 [And said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, What seest]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} [thou? And I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I have looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and behold a candlestick| strong="H4501" \w* all of \w gold| strong="H2091" \w*, \w with a bowl| strong="H1531" \w* \w upon the top| strong="H7218" \w* [of it, and his seven]{strong=“H7651”} \w lamps| strong="H5216" \w* [thereon, and seven]{strong=“H7651”} \w pipes| strong="H4166" \w* \w to the seven| strong="H7651" \w* \w lamps| strong="H5216" \w*, which are \w upon the top| strong="H7218" \w* thereof:\f + \fr 4:2 \ft a bowl: Heb. her bowl \f* \f + \fr 4:2 \ft seven pipes…: or, seven several pipes to the lamps \f* 
\v 3 \w And two| strong="H8147" \w* \w olive trees| strong="H2132" \w* [by it, one]{strong=“H259”} \w upon the right| strong="H3225" \w* side \w of the bowl| strong="H1543" \w*, \w and the other| strong="H259" \w* \w upon the left| strong="H8040" \w* side thereof. 
\v 4 [So I answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the angel| strong="H4397" \w* [that talked]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} [with me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, What are [these, my lord]{strong=“H113”}? 
\v 5 \w Then the angel| strong="H4397" \w* [that talked]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} [with me answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [thou not what these be? And I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [No, my lord]{strong=“H113”}. 
\v 6 [Then he answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, This is \w the word| strong="H1697" \w* of the \sc Lord\sc* \w unto Zerubbabel| strong="H2216" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Not by might| strong="H2428" \w*, \w nor by power| strong="H3581" \w*, \w but by my spirit| strong="H7307" \w*, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*.\f + \fr 4:6 \ft might: or, army \f* 
\v 7 Who art [thou, O great]{strong=“H1419”} \w mountain| strong="H2022" \w*? \w before| strong="H6440" \w* \w Zerubbabel| strong="H2216" \w* thou shalt become \w a plain| strong="H4334" \w*: [and he shall bring forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} [the headstone]{strong=“H7222 H68”} thereof with \w shoutings| strong="H8663" \w*, crying, \w Grace| strong="H2580" \w*, \w grace| strong="H2580" \w* unto it. 
\v 8 \w Moreover the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 9 \w The hands| strong="H3027" \w* \w of Zerubbabel| strong="H2216" \w* [have laid the foundation]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8765”} \w of this house| strong="H1004" \w*; \w his hands| strong="H3027" \w* [shall also finish]{strong=“H1214” x-morph=“strongMorph: \sc Th\sc*8762”} [it; and thou shalt know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that the \sc Lord\sc* \w of hosts| strong="H6635" \w* [hath sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} me unto you. 
\v 10 [For who hath despised]{strong=“H936” x-morph=“strongMorph: \sc Th\sc*8804”} \w the day| strong="H3117" \w* \w of small things| strong="H6996" \w*? [for they shall rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8804”}, [and shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} [the plummet]{strong=“H913 H68”} \w in the hand| strong="H3027" \w* \w of Zerubbabel| strong="H2216" \w* with \w those seven| strong="H7651" \w*; they are \w the eyes| strong="H5869" \w* of the \sc Lord\sc*, [which run to and fro]{strong=“H7751” x-morph=“strongMorph: \sc Th\sc*8789”} \w through the whole earth| strong="H776" \w*.^\sc 4:10 for they…: or, since the seven eyes of the [Lord\sc* shall rejoice] \f + \fr 4:10 \ft plummet: Heb. stone of tin \f* 
\p
\v 11 [Then answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [I, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, What are \w these two| strong="H8147" \w* \w olive trees| strong="H2132" \w* \w upon the right| strong="H3225" \w* side \w of the candlestick| strong="H4501" \w* \w and upon the left| strong="H8040" \w* side thereof? 
\v 12 [And I answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w again| strong="H8145" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, What be these \w two| strong="H8147" \w* \w olive| strong="H2132" \w* \w branches| strong="H7641" \w* \w which through| strong="H3027" \w* \w the two| strong="H8147" \w* \w golden| strong="H2091" \w* \w pipes| strong="H6804" \w* [empty]{strong=“H7324” x-morph=“strongMorph: \sc Th\sc*8688”} \w the golden| strong="H2091" \w* oil out of themselves?\f + \fr 4:12 \ft through: Heb. by the hand of \f* \f + \fr 4:12 \ft empty…: or, empty out of themselves oil into the gold \f* \f + \fr 4:12 \ft the golden oil: Heb. the gold \f* 
\v 13 [And he answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [me and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} thou not what these be? [And I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [No, my lord]{strong=“H113”}. 
\v 14 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} he, These are \w the two| strong="H8147" \w* \w anointed| strong="H3323" \w* \w ones| strong="H1121" \w*, [that stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w by the Lord| strong="H113" \w* \w of the whole earth| strong="H776" \w*.\f + \fr 4:14 \ft anointed…: Heb. sons of oil \f*
\c 5
\p 
\v 1 [Then I turned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [and lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w mine eyes| strong="H5869" \w*, [and looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, [and behold a flying]{strong=“H5774” x-morph=“strongMorph: \sc Th\sc*8802”} \w roll| strong="H4039" \w*. 
\v 2 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, What seest]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} [thou? And I answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} [a flying]{strong=“H5774” x-morph=“strongMorph: \sc Th\sc*8802”} \w roll| strong="H4039" \w*; \w the length| strong="H753" \w* thereof is \w twenty| strong="H6242" \w* \w cubits| strong="H520" \w*, \w and the breadth| strong="H7341" \w* \w thereof ten| strong="H6235" \w* \w cubits| strong="H520" \w*. 
\v 3 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} he unto me, This is \w the curse| strong="H423" \w* [that goeth forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} \w over the face| strong="H6440" \w* \w of the whole earth| strong="H776" \w*: [for every one that stealeth]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8802”} [shall be cut off]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8738”} as \w on this side according| strong="H3644" \w* [to it; and every one that sweareth]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8737”} [shall be cut off]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8738”} as \w on that side according| strong="H3644" \w* to it.\f + \fr 5:3 \ft every one that stealeth…: or, every one of this people that stealeth holdeth himself guiltless, as it doth \f* 
\v 4 [I will bring it forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [and it shall enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the house| strong="H1004" \w* \w of the thief| strong="H1590" \w*, \w and into the house| strong="H1004" \w* [of him that sweareth]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8737”} \w falsely| strong="H8267" \w* \w by my name| strong="H8034" \w*: [and it shall remain]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the midst| strong="H8432" \w* \w of his house| strong="H1004" \w*, [and shall consume]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8765”} \w it with the timber| strong="H6086" \w* \w thereof and the stones| strong="H68" \w* thereof. 
\p
\v 5 \w Then the angel| strong="H4397" \w* [that talked]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} [with me went forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w now thine eyes| strong="H5869" \w*, [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} what is [this that goeth forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 6 [And I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, What is [it? And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, This is \w an ephah| strong="H374" \w* [that goeth forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”}. [He said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} moreover, This is \w their resemblance| strong="H5869" \w* \w through all the earth| strong="H776" \w*. 
\v 7 [And, behold, there was lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8738”} \w a talent| strong="H3603" \w* \w of lead| strong="H5777" \w*: and this is \w a| strong="H259" \w* \w woman| strong="H802" \w* [that sitteth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the midst| strong="H8432" \w* \w of the ephah| strong="H374" \w*.\f + \fr 5:7 \ft talent: or, weighty piece \f* 
\v 8 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, This is \w wickedness| strong="H7564" \w*. [And he cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w it into the midst| strong="H8432" \w* \w of the ephah| strong="H374" \w*; [and he cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w the weight| strong="H68" \w* \w of lead| strong="H5777" \w* \w upon the mouth| strong="H6310" \w* thereof. 
\v 9 [Then lifted I up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w mine eyes| strong="H5869" \w*, [and looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, [and, behold, there came out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} \w two| strong="H8147" \w* \w women| strong="H802" \w*, \w and the wind| strong="H7307" \w* was \w in their wings| strong="H3671" \w*; \w for they had| strong="H2007" \w* \w wings| strong="H3671" \w* \w like the wings| strong="H3671" \w* \w of a stork| strong="H2624" \w*: [and they lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w the ephah| strong="H374" \w* \w between the earth| strong="H776" \w* \w and the heaven| strong="H8064" \w*. 
\v 10 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w I to the angel| strong="H4397" \w* [that talked]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} [with me, Whither do these bear]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8688”} \w the ephah| strong="H374" \w*? 
\v 11 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, To build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8800”} \w it an house| strong="H1004" \w* \w in the land| strong="H776" \w* \w of Shinar| strong="H8152" \w*: [and it shall be established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8717”}, [and set]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8717”} \w there upon her own base| strong="H4369" \w*.
\c 6
\p 
\v 1 [And I turned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [and lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w mine eyes| strong="H5869" \w*, [and looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, [and, behold, there came]{strong=“H3318”} \w four| strong="H702" \w* \w chariots| strong="H4818" \w* [out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} \w from between two| strong="H8147" \w* \w mountains| strong="H2022" \w*; \w and the mountains| strong="H2022" \w* were \w mountains| strong="H2022" \w* \w of brass| strong="H5178" \w*. 
\v 2 \w In the first| strong="H7223" \w* \w chariot| strong="H4818" \w* were \w red| strong="H122" \w* \w horses| strong="H5483" \w*; \w and in the second| strong="H8145" \w* \w chariot| strong="H4818" \w* \w black| strong="H7838" \w* \w horses| strong="H5483" \w*; 
\v 3 \w And in the third| strong="H7992" \w* \w chariot| strong="H4818" \w* \w white| strong="H3836" \w* \w horses| strong="H5483" \w*; \w and in the fourth| strong="H7243" \w* \w chariot| strong="H4818" \w* \w grisled| strong="H1261" \w* \w and bay| strong="H554" \w* \w horses| strong="H5483" \w*.\f + \fr 6:3 \ft bay: or, strong \f* 
\v 4 [Then I answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the angel| strong="H4397" \w* [that talked]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} with me, What are [these, my lord]{strong=“H113”}? 
\v 5 \w And the angel| strong="H4397" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto me, These are \w the four| strong="H702" \w* \w spirits| strong="H7307" \w* \w of the heavens| strong="H8064" \w*, [which go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} [from standing]{strong=“H3320” x-morph=“strongMorph: \sc Th\sc*8692”} \w before the Lord| strong="H113" \w* \w of all the earth| strong="H776" \w*.\f + \fr 6:5 \ft spirits: or, winds \f* 
\v 6 \w The black| strong="H7838" \w* \w horses| strong="H5483" \w* which are [therein go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} \w into the north| strong="H6828" \w* \w country| strong="H776" \w*; \w and the white| strong="H3836" \w* [go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w after| strong="H310" \w* [them; and the grisled]{strong=“H1261”} [go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w toward the south| strong="H8486" \w* \w country| strong="H776" \w*. 
\v 7 \w And the bay| strong="H554" \w* [went forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”}, [and sought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} [to go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} [that they might walk to and fro]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8692”} \w through the earth| strong="H776" \w*: [and he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Get you hence]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [walk to and fro]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8690”} \w through the earth| strong="H776" \w*. [So they walked to and fro]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8691”} \w through the earth| strong="H776" \w*. 
\v 8 [Then cried]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8686”} \w he upon| strong="H853" \w* [me, and spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}, [these that go]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} \w toward the north| strong="H6828" \w* \w country| strong="H776" \w* [have quieted]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8689”} \w my spirit| strong="H7307" \w* \w in the north| strong="H6828" \w* \w country| strong="H776" \w*. 
\p
\v 9 \w And the word| strong="H1697" \w* of the \sc Lord\sc* [came unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 10 [Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} of them of \w the captivity| strong="H1473" \w*, even \w of Heldai| strong="H2469" \w*, \w of Tobijah| strong="H2900" \w*, \w and of Jedaiah| strong="H3048" \w*, [which are come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w from Babylon| strong="H894" \w*, [and come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w thou the same day| strong="H3117" \w*, [and go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the house| strong="H1004" \w* \w of Josiah| strong="H2977" \w* \w the son| strong="H1121" \w* \w of Zephaniah| strong="H6846" \w*; 
\v 11 [Then take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w silver| strong="H3701" \w* \w and gold| strong="H2091" \w*, [and make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w crowns| strong="H5850" \w*, [and set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} them \w upon the head| strong="H7218" \w* \w of Joshua| strong="H3091" \w* \w the son| strong="H1121" \w* \w of Josedech| strong="H3087" \w*, \w the high| strong="H1419" \w* \w priest| strong="H3548" \w*; 
\v 12 [And speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto him, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Thus speaketh]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Behold the man| strong="H376" \w* \w whose name| strong="H8034" \w* is The_\sc Branch\sc*_H6780; [and he shall grow up]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8799”} [out of his place, and he shall build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w the temple| strong="H1964" \w* of the \sc Lord\sc*:\f + \fr 6:12 \ft grow…: or, branch up from under him \f* 
\v 13 [Even he shall build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w the temple| strong="H1964" \w* of the \sc Lord\sc*; [and he shall bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w the glory| strong="H1935" \w*, [and shall sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} [and rule]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon his throne| strong="H3678" \w*; \w and he shall be a priest| strong="H3548" \w* \w upon his throne| strong="H3678" \w*: \w and the counsel| strong="H6098" \w* \w of peace| strong="H7965" \w* \w shall be between them both| strong="H8147" \w*. 
\v 14 \w And the crowns| strong="H5850" \w* \w shall be to Helem| strong="H2494" \w*, \w and to Tobijah| strong="H2900" \w*, \w and to Jedaiah| strong="H3048" \w*, \w and to Hen| strong="H2581" \w* \w the son| strong="H1121" \w* \w of Zephaniah| strong="H6846" \w*, \w for a memorial| strong="H2146" \w* \w in the temple| strong="H1964" \w* of the \sc Lord\sc*. 
\v 15 And they that are \w far off| strong="H7350" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the temple| strong="H1964" \w* of the \sc Lord\sc*, [and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that the \sc Lord\sc* \w of hosts| strong="H6635" \w* [hath sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} me unto you. And this [shall come to pass, if ye will diligently]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} [obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w the voice| strong="H6963" \w* of the \sc Lord\sc* \w your God| strong="H430" \w*.
\c 7
\p 
\v 1 \w And it came to pass in the fourth| strong="H702" \w* \w year| strong="H8141" \w* \w of king| strong="H4428" \w* \w Darius| strong="H1867" \w*, that \w the word| strong="H1697" \w* of the \sc Lord\sc* \w came unto Zechariah| strong="H2148" \w* \w in the fourth| strong="H702" \w* day \w of the ninth| strong="H8671" \w* \w month| strong="H2320" \w*, even \w in Chisleu| strong="H3691" \w*; 
\v 2 [When they had sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the house| strong="H1004" \w* \w of God| strong="H410" \w* \w Sherezer| strong="H8272" \w* [and Regem-melech]{strong=“H7278”}, \w and their men| strong="H582" \w*, [to pray]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8763”} \w before| strong="H6440" \w* the \sc Lord\sc*,\f + \fr 7:2 \ft pray…: Heb. intreat the face of \f* 
\v 3 And [to speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto the priests| strong="H3548" \w* which were \w in the house| strong="H1004" \w* of the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w and to the prophets| strong="H5030" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Should I weep]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the fifth| strong="H2549" \w* \w month| strong="H2320" \w*, [separating]{strong=“H5144” x-morph=“strongMorph: \sc Th\sc*8736”} [myself, as I have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w these so many years| strong="H8141" \w*? 
\p
\v 4 \w Then came the word| strong="H1697" \w* of the \sc Lord\sc* \w of hosts| strong="H6635" \w* [unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 5 [Speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto all the people| strong="H5971" \w* \w of the land| strong="H776" \w*, \w and to the priests| strong="H3548" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [When ye fasted]{strong=“H6684” x-morph=“strongMorph: \sc Th\sc*8804”} [and mourned]{strong=“H5594” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the fifth| strong="H2549" \w* \w and seventh| strong="H7637" \w* month, \w even those seventy| strong="H7657" \w* \w years| strong="H8141" \w*, [did ye at all]{strong=“H6684” x-morph=“strongMorph: \sc Th\sc*8800”} [fast]{strong=“H6684” x-morph=“strongMorph: \sc Th\sc*8804”} unto me, even to me? 
\v 6 [And when ye did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}, [and when ye did drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”}, [did not ye eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} for yourselves, [and drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8802”} for yourselves?\f + \fr 7:6 \ft did not ye: or, be not ye they that \f* 
\v 7 Should ye not hear \w the words| strong="H1697" \w* which the \sc Lord\sc* [hath cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w by| strong="H3027" \w* \w the former| strong="H7223" \w* \w prophets| strong="H5030" \w*, \w when Jerusalem| strong="H3389" \w* [was inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w and in prosperity| strong="H7961" \w*, \w and the cities| strong="H5892" \w* \w thereof round about her| strong="H5439" \w*, when men [inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w the south| strong="H5045" \w* \w and the plain| strong="H8219" \w*?\f + \fr 7:7 \ft Should…: or, Are not these the words \f* \f + \fr 7:7 \ft by: Heb. by the hand of \f* 
\p
\v 8 \w And the word| strong="H1697" \w* of the \sc Lord\sc* \w came unto Zechariah| strong="H2148" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 9 [Thus speaketh]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Execute]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8798”} \w true| strong="H571" \w* \w judgment| strong="H4941" \w*, [and shew]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} \w mercy| strong="H2617" \w* \w and compassions| strong="H7356" \w* \w every man| strong="H376" \w* \w to his brother| strong="H251" \w*:\f + \fr 7:9 \ft Execute…: Heb. Judge judgment of truth \f* 
\v 10 [And oppress]{strong=“H6231” x-morph=“strongMorph: \sc Th\sc*8799”} \w not the widow| strong="H490" \w*, \w nor the fatherless| strong="H3490" \w*, \w the stranger| strong="H1616" \w*, \w nor the poor| strong="H6041" \w*; [and let none of you imagine]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8799”} \w evil| strong="H7451" \w* \w against| strong="H376" \w* \w his brother| strong="H251" \w* \w in your heart| strong="H3824" \w*. 
\v 11 [But they refused]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8762”} [to hearken]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8687”}, [and pulled away]{strong=“H5637 H5414” x-morph=“strongMorph: \sc Th\sc*8802 strongMorph: \sc Th\sc*8799”} \w the shoulder| strong="H3802" \w*, [and stopped]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8689”} \w their ears| strong="H241" \w*, [that they should not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 7:11 \ft pulled…: Heb. they gave a backsliding shoulder \f* \f + \fr 7:11 \ft stopped: Heb. made heavy \f* 
\v 12 [Yea, they made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w their hearts| strong="H3820" \w* as \w an adamant stone| strong="H8068" \w*, [lest they should hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w the law| strong="H8451" \w*, \w and the words| strong="H1697" \w* which the \sc Lord\sc* \w of hosts| strong="H6635" \w* [hath sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his spirit| strong="H7307" \w* \w by| strong="H3027" \w* \w the former| strong="H7223" \w* \w prophets| strong="H5030" \w*: \w therefore came a great| strong="H1419" \w* \w wrath| strong="H7110" \w* from the \sc Lord\sc* \w of hosts| strong="H6635" \w*.\f + \fr 7:12 \ft by: Heb. by the hand of \f* 
\v 13 Therefore it is come to pass, that [as he cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”}, [and they would not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}; [so they cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”}, [and I would not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*: 
\v 14 [But I scattered them with a whirlwind]{strong=“H5590” x-morph=“strongMorph: \sc Th\sc*8762”} \w among all the nations| strong="H1471" \w* [whom they knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [not. Thus the land]{strong=“H776”} [was desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8738”} \w after| strong="H310" \w* [them, that no man passed through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} [nor returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8802”}: [for they laid]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w the pleasant| strong="H2532" \w* \w land| strong="H776" \w* \w desolate| strong="H8047" \w*.\f + \fr 7:14 \ft pleasant…: Heb. land of desire \f*
\c 8
\p 
\v 1 \w Again the word| strong="H1697" \w* of the \sc Lord\sc* \w of hosts| strong="H6635" \w* came to me, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*; [I was jealous]{strong=“H7065” x-morph=“strongMorph: \sc Th\sc*8765”} \w for Zion| strong="H6726" \w* \w with great| strong="H1419" \w* \w jealousy| strong="H7068" \w*, [and I was jealous]{strong=“H7065” x-morph=“strongMorph: \sc Th\sc*8765”} \w for her with great| strong="H1419" \w* \w fury| strong="H2534" \w*. 
\v 3 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [I am returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto Zion| strong="H6726" \w*, [and will dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the midst| strong="H8432" \w* \w of Jerusalem| strong="H3389" \w*: \w and Jerusalem| strong="H3389" \w* [shall be called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8738”} \w a city| strong="H5892" \w* \w of truth| strong="H571" \w*; \w and the mountain| strong="H2022" \w* of the \sc Lord\sc* \w of hosts| strong="H6635" \w* \w the holy| strong="H6944" \w* \w mountain| strong="H2022" \w*. 
\v 4 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*; \w There shall yet old men| strong="H2205" \w* \w and old women| strong="H2205" \w* [dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the streets| strong="H7339" \w* \w of Jerusalem| strong="H3389" \w*, \w and every man| strong="H376" \w* \w with his staff| strong="H4938" \w* \w in his hand| strong="H3027" \w* \w for very| strong="H7230" \w* \w age| strong="H3117" \w*.\f + \fr 8:4 \ft very…: Heb. multitude of days \f* 
\v 5 \w And the streets| strong="H7339" \w* \w of the city| strong="H5892" \w* [shall be full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”} \w of boys| strong="H3206" \w* \w and girls| strong="H3207" \w* [playing]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8764”} \w in the streets| strong="H7339" \w* thereof. 
\v 6 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*; [If it be marvellous]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the eyes| strong="H5869" \w* \w of the remnant| strong="H7611" \w* \w of this people| strong="H5971" \w* \w in these days| strong="H3117" \w*, [should it also be marvellous]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8735”} \w in mine eyes| strong="H5869" \w*? [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*.\f + \fr 8:6 \ft marvellous: or, hard, or, difficult \f* 
\v 7 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*; [Behold, I will save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8688”} \w my people| strong="H5971" \w* \w from the east| strong="H4217" \w* \w country| strong="H776" \w*, [and from the west]{strong=“H8121 H3996”} \w country| strong="H776" \w*;\f + \fr 8:7 \ft the west…: Heb. the country of the going down of the sun \f* 
\v 8 [And I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} [them, and they shall dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the midst| strong="H8432" \w* \w of Jerusalem| strong="H3389" \w*: \w and they shall be my people| strong="H5971" \w*, \w and I will be their God| strong="H430" \w*, \w in truth| strong="H571" \w* \w and in righteousness| strong="H6666" \w*. 
\p
\v 9 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*; \w Let your hands| strong="H3027" \w* [be strong]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8799”}, [ye that hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} \w in these days| strong="H3117" \w* \w these words| strong="H1697" \w* \w by the mouth| strong="H6310" \w* \w of the prophets| strong="H5030" \w*, which were \w in the day| strong="H3117" \w* that \w the foundation| strong="H3245" \w* \w of the house| strong="H1004" \w* of the \sc Lord\sc* \w of hosts| strong="H6635" \w* [was laid]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8795”}, \w that the temple| strong="H1964" \w* [might be built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8736”}. 
\v 10 \w For before| strong="H6440" \w* \w these days| strong="H3117" \w* [there was]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8738”} \w no hire| strong="H7939" \w* \w for man| strong="H120" \w*, \w nor any hire| strong="H7939" \w* \w for beast| strong="H929" \w*; neither was there any \w peace| strong="H7965" \w* [to him that went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} [or came in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w because of the affliction| strong="H6862" \w*: [for I set]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w all men| strong="H120" \w* \w every one| strong="H376" \w* \w against his neighbour| strong="H7453" \w*.\f + \fr 8:10 \ft there was…: or, the hire of man became nothing \f* 
\v 11 But now I will not be \w unto the residue| strong="H7611" \w* \w of this people| strong="H5971" \w* \w as in the former| strong="H7223" \w* \w days| strong="H3117" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*. 
\v 12 \w For the seed| strong="H2233" \w* shall be \w prosperous| strong="H7965" \w*; \w the vine| strong="H1612" \w* [shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w her fruit| strong="H6529" \w*, \w and the ground| strong="H776" \w* [shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w her increase| strong="H2981" \w*, \w and the heavens| strong="H8064" \w* [shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w their dew| strong="H2919" \w*; \w and I will cause the remnant| strong="H7611" \w* \w of this people| strong="H5971" \w* [to possess]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8689”} all these things.\f + \fr 8:12 \ft prosperous: Heb. of peace \f* 
\v 13 And it shall come to pass, that \w as ye were a curse| strong="H7045" \w* \w among the heathen| strong="H1471" \w*, \w O house| strong="H1004" \w* \w of Judah| strong="H3063" \w*, \w and house| strong="H1004" \w* \w of Israel| strong="H3478" \w*; [so will I save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} [you, and ye shall be a blessing]{strong=“H1293”}: [fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} not, but \w let your hands| strong="H3027" \w* [be strong]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 14 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*; [As I thought]{strong=“H2161” x-morph=“strongMorph: \sc Th\sc*8804”} [to punish]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8687”} [you, when your fathers]{strong=“H1”} [provoked me to wrath]{strong=“H7107” x-morph=“strongMorph: \sc Th\sc*8687”}, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [and I repented]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8738”} not: 
