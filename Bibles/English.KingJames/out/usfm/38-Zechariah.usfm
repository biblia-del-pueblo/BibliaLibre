\c 9
\p 
\v 1 \w The burden| strong="H4853" \w* \w of the word| strong="H1697" \w* of the \sc Lord\sc* \w in the land| strong="H776" \w* \w of Hadrach| strong="H2317" \w*, \w and Damascus| strong="H1834" \w* shall be \w the rest| strong="H4496" \w* [thereof: when the eyes]{strong=“H5869”} \w of man| strong="H120" \w*, \w as of all the tribes| strong="H7626" \w* \w of Israel| strong="H3478" \w*, shall be toward the \sc Lord\sc*. 
\v 2 \w And Hamath| strong="H2574" \w* [also shall border]{strong=“H1379” x-morph=“strongMorph: \sc Th\sc*8799”} [thereby; Tyrus]{strong=“H6865”}, \w and Zidon| strong="H6721" \w*, \w though it be very| strong="H3966" \w* [wise]{strong=“H2449” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 3 \w And Tyrus| strong="H6865" \w* [did build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w herself a strong hold| strong="H4692" \w*, [and heaped up]{strong=“H6651” x-morph=“strongMorph: \sc Th\sc*8799”} \w silver| strong="H3701" \w* \w as the dust| strong="H6083" \w*, \w and fine gold| strong="H2742" \w* \w as the mire| strong="H2916" \w* \w of the streets| strong="H2351" \w*. 
\v 4 [Behold, the Lord]{strong=“H136”} [will cast her out]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8686”}, [and he will smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w her power| strong="H2428" \w* \w in the sea| strong="H3220" \w*; [and she shall be devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8735”} \w with fire| strong="H784" \w*. 
\v 5 \w Ashkelon| strong="H831" \w* [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} it, [and fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}; \w Gaza| strong="H5804" \w* also shall see it, \w and be very| strong="H3966" \w* [sorrowful]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and Ekron| strong="H6138" \w*; \w for her expectation| strong="H4007" \w* [shall be ashamed]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”}; \w and the king| strong="H4428" \w* [shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”} \w from Gaza| strong="H5804" \w*, \w and Ashkelon| strong="H831" \w* [shall not be inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 6 \w And a bastard| strong="H4464" \w* [shall dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w in Ashdod| strong="H795" \w*, [and I will cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w the pride| strong="H1347" \w* \w of the Philistines| strong="H6430" \w*. 
\v 7 [And I will take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8689”} \w his blood| strong="H1818" \w* \w out of his mouth| strong="H6310" \w*, \w and his abominations| strong="H8251" \w* \w from between his teeth| strong="H8127" \w*: [but he that remaineth]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8738”}, even he, shall be \w for our God| strong="H430" \w*, \w and he shall be as a governor| strong="H441" \w* \w in Judah| strong="H3063" \w*, \w and Ekron| strong="H6138" \w* \w as a Jebusite| strong="H2983" \w*.\f + \fr 9:7 \ft blood: Heb. bloods \f* 
\v 8 [And I will encamp]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8804”} \w about mine house| strong="H1004" \w* \w because of the army| strong="H4675" \w*, [because of him that passeth by]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”}, [and because of him that returneth]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8802”}: [and no oppressor]{strong=“H5065” x-morph=“strongMorph: \sc Th\sc*8802”} [shall pass through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} [them any more: for now have I seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w with mine eyes| strong="H5869" \w*. 
\p
\v 9 [Rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8798”} \w greatly| strong="H3966" \w*, \w O daughter| strong="H1323" \w* \w of Zion| strong="H6726" \w*; [shout]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8685”}, \w O daughter| strong="H1323" \w* \w of Jerusalem| strong="H3389" \w*: [behold, thy King]{strong=“H4428”} [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} unto thee: he is \w just| strong="H6662" \w*, [and having salvation]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8737”}; \w lowly| strong="H6041" \w*, [and riding]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon an ass| strong="H2543" \w*, \w and upon a colt| strong="H5895" \w* \w the foal| strong="H1121" \w* \w of an ass| strong="H860" \w*.\f + \fr 9:9 \ft having…: or, saving himself \f* 
\v 10 [And I will cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w the chariot| strong="H7393" \w* \w from Ephraim| strong="H669" \w*, \w and the horse| strong="H5483" \w* \w from Jerusalem| strong="H3389" \w*, \w and the battle| strong="H4421" \w* \w bow| strong="H7198" \w* [shall be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8738”}: [and he shall speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w peace| strong="H7965" \w* \w unto the heathen| strong="H1471" \w*: \w and his dominion| strong="H4915" \w* shall be \w from sea| strong="H3220" \w* even \w to sea| strong="H3220" \w*, \w and from the river| strong="H5104" \w* even \w to the ends| strong="H657" \w* \w of the earth| strong="H776" \w*. 
\v 11 [As for thee also, by the blood]{strong=“H1818”} \w of thy covenant| strong="H1285" \w* [I have sent forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy prisoners| strong="H615" \w* \w out of the pit| strong="H953" \w* wherein is \w no water| strong="H4325" \w*.\f + \fr 9:11 \ft by…: or, whose covenant is by blood \f* 
\p
\v 12 [Turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} \w you to the strong hold| strong="H1225" \w*, \w ye prisoners| strong="H615" \w* \w of hope| strong="H8615" \w*: \w even to day| strong="H3117" \w* [do I declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8688”} that [I will render]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w double| strong="H4932" \w* unto thee; 
\v 13 [When I have bent]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8804”} \w Judah| strong="H3063" \w* [for me, filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8765”} \w the bow| strong="H7198" \w* \w with Ephraim| strong="H669" \w*, [and raised up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8790”} \w thy sons| strong="H1121" \w*, \w O Zion| strong="H6726" \w*, \w against thy sons| strong="H1121" \w*, \w O Greece| strong="H3120" \w*, [and made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee as the sword| strong="H2719" \w* \w of a mighty man| strong="H1368" \w*. 
\v 14 And the \sc Lord\sc* [shall be seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8735”} [over them, and his arrow]{strong=“H2671”} [shall go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w as the lightning| strong="H1300" \w*: \w and the Lord| strong="H136" \w* \sc God\sc* [shall blow]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8799”} \w the trumpet| strong="H7782" \w*, [and shall go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w with whirlwinds| strong="H5591" \w* \w of the south| strong="H8486" \w*. 
\v 15 The \sc Lord\sc* \w of hosts| strong="H6635" \w* [shall defend]{strong=“H1598” x-morph=“strongMorph: \sc Th\sc*8686”} [them; and they shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”}, [and subdue]{strong=“H3533” x-morph=“strongMorph: \sc Th\sc*8804”} \w with sling| strong="H7050" \w* \w stones| strong="H68" \w*; [and they shall drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8804”}, and [make a noise]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8804”} \w as through wine| strong="H3196" \w*; [and they shall be filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w like bowls| strong="H4219" \w*, and \w as the corners| strong="H2106" \w* \w of the altar| strong="H4196" \w*.\f + \fr 9:15 \ft with…: or, the stones of the sling \f* \f + \fr 9:15 \ft be…: or, fill both the bowls, etc \f* 
\v 16 And the \sc Lord\sc* \w their God| strong="H430" \w* [shall save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8689”} \w them in that day| strong="H3117" \w* \w as the flock| strong="H6629" \w* \w of his people| strong="H5971" \w*: for they shall be as \w the stones| strong="H68" \w* \w of a crown| strong="H5145" \w*, [lifted up as an ensign]{strong=“H5264” x-morph=“strongMorph: \sc Th\sc*8706”} \w upon his land| strong="H127" \w*. 
\v 17 For how great is \w his goodness| strong="H2898" \w*, and how great is \w his beauty| strong="H3308" \w*! \w corn| strong="H1715" \w* \w shall make the young men| strong="H970" \w* [cheerful]{strong=“H5107” x-morph=“strongMorph: \sc Th\sc*8766”}, \w and new wine| strong="H8492" \w* \w the maids| strong="H1330" \w*.\f + \fr 9:17 \ft cheerful: or, grow, or, speak \f*
\c 10
\p 
\v 1 [Ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8798”} ye of the \sc Lord\sc* \w rain| strong="H4306" \w* \w in the time| strong="H6256" \w* \w of the latter rain| strong="H4456" \w*; so the \sc Lord\sc* [shall make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w bright clouds| strong="H2385" \w*, [and give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w them showers| strong="H1653" \w* \w of rain| strong="H4306" \w*, \w to every one| strong="H376" \w* \w grass| strong="H6212" \w* \w in the field| strong="H7704" \w*.\f + \fr 10:1 \ft bright…: or, lightnings \f* 
\v 2 \w For the idols| strong="H8655" \w* [have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w vanity| strong="H205" \w*, [and the diviners]{strong=“H7080” x-morph=“strongMorph: \sc Th\sc*8802”} [have seen]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8804”} \w a lie| strong="H8267" \w*, [and have told]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w false| strong="H7723" \w* \w dreams| strong="H2472" \w*; [they comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8762”} \w in vain| strong="H1892" \w*: [therefore they went]{strong=“H5265” x-morph=“strongMorph: \sc Th\sc*8804”} \w their way as a flock| strong="H6629" \w*, [they were troubled]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8799”}, because there was [no shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 10:2 \ft idols: Heb. teraphims \f* \f + \fr 10:2 \ft were…: or, answered that, etc \f* 
\v 3 \w Mine anger| strong="H639" \w* [was kindled]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8804”} [against the shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}, [and I punished]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} \w the goats| strong="H6260" \w*: for the \sc Lord\sc* \w of hosts| strong="H6635" \w* [hath visited]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} \w his flock| strong="H5739" \w* \w the house| strong="H1004" \w* \w of Judah| strong="H3063" \w*, [and hath made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w them as his goodly| strong="H1935" \w* \w horse| strong="H5483" \w* \w in the battle| strong="H4421" \w*.\f + \fr 10:3 \ft punished: Heb. visited upon \f* 
\v 4 [Out of him came forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w the corner| strong="H6438" \w*, \w out of him the nail| strong="H3489" \w*, \w out of him the battle| strong="H4421" \w* \w bow| strong="H7198" \w*, [out of him every oppressor]{strong=“H5065” x-morph=“strongMorph: \sc Th\sc*8802”} \w together| strong="H3162" \w*. 
\p
\v 5 \w And they shall be as mighty| strong="H1368" \w* men, [which tread down]{strong=“H947” x-morph=“strongMorph: \sc Th\sc*8802”} their enemies \w in the mire| strong="H2916" \w* \w of the streets| strong="H2351" \w* \w in the battle| strong="H4421" \w*: [and they shall fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8738”}, because the \sc Lord\sc* is [with them, and the riders]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8802”} \w on horses| strong="H5483" \w* [shall be confounded]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”}.\f + \fr 10:5 \ft the riders…: or, they shall make the riders on horses ashamed \f* 
\v 6 [And I will strengthen]{strong=“H1396” x-morph=“strongMorph: \sc Th\sc*8765”} \w the house| strong="H1004" \w* \w of Judah| strong="H3063" \w*, [and I will save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} \w the house| strong="H1004" \w* \w of Joseph| strong="H3130" \w*, [and I will bring them again to place]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8689”} [them; for I have mercy]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8765”} [upon them: and they shall be as though]{strong=“H834”} [I had not cast them off]{strong=“H2186” x-morph=“strongMorph: \sc Th\sc*8804”}: for I am the \sc Lord\sc* \w their God| strong="H430" \w*, [and will hear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} them. 
\v 7 And they of \w Ephraim| strong="H669" \w* \w shall be like a mighty| strong="H1368" \w* man, \w and their heart| strong="H3820" \w* [shall rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8804”} \w as through wine| strong="H3196" \w*: [yea, their children]{strong=“H1121”} [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} it, [and be glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8804”}; \w their heart| strong="H3820" \w* [shall rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”} in the \sc Lord\sc*. 
\v 8 [I will hiss]{strong=“H8319” x-morph=“strongMorph: \sc Th\sc*8799”} [for them, and gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8762”} [them; for I have redeemed]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8804”} [them: and they shall increase]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8804”} [as they have increased]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 9 [And I will sow]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8799”} \w them among the people| strong="H5971" \w*: [and they shall remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w me in far countries| strong="H4801" \w*; [and they shall live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8804”} \w with their children| strong="H1121" \w*, [and turn again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 10 [I will bring them again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} \w also out of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, [and gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8762”} \w them out of Assyria| strong="H804" \w*; [and I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w them into the land| strong="H776" \w* \w of Gilead| strong="H1568" \w* \w and Lebanon| strong="H3844" \w*; and place [shall not be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”} for them. 
\v 11 [And he shall pass through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w the sea| strong="H3220" \w* \w with affliction| strong="H6869" \w*, [and shall smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w the waves| strong="H1530" \w* \w in the sea| strong="H3220" \w*, \w and all the deeps| strong="H4688" \w* \w of the river| strong="H2975" \w* [shall dry up]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”}: \w and the pride| strong="H1347" \w* \w of Assyria| strong="H804" \w* [shall be brought down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8717”}, \w and the sceptre| strong="H7626" \w* \w of Egypt| strong="H4714" \w* [shall depart away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 12 [And I will strengthen]{strong=“H1396” x-morph=“strongMorph: \sc Th\sc*8765”} them in the \sc Lord\sc*; [and they shall walk up and down]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8691”} \w in his name| strong="H8034" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*.
\c 11
\p 
\v 1 [Open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy doors| strong="H1817" \w*, \w O Lebanon| strong="H3844" \w*, \w that the fire| strong="H784" \w* [may devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy cedars| strong="H730" \w*. 
\v 2 [Howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8685”}, \w fir tree| strong="H1265" \w*; \w for the cedar| strong="H730" \w* [is fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”}; \w because the mighty| strong="H117" \w* [are spoiled]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8795”}: [howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8685”}, \w O ye oaks| strong="H437" \w* \w of Bashan| strong="H1316" \w*; \w for the forest| strong="H3293" \w* [of the vintage]{strong=“H1219 H1208” x-morph=“strongMorph: \sc Th\sc*8803 strongMorph: \sc Th\sc*8675”} [is come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 11:2 \ft mighty: or, gallants \f* \f + \fr 11:2 \ft the forest…: or, the defenced forest \f* 
\p
\v 3 There is \w a voice| strong="H6963" \w* \w of the howling| strong="H3215" \w* [of the shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}; \w for their glory| strong="H155" \w* [is spoiled]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8795”}: \w a voice| strong="H6963" \w* \w of the roaring| strong="H7581" \w* \w of young lions| strong="H3715" \w*; \w for the pride| strong="H1347" \w* \w of Jordan| strong="H3383" \w* [is spoiled]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8795”}. 
\p
\v 4 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w my God| strong="H430" \w*; [Feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8798”} \w the flock| strong="H6629" \w* \w of the slaughter| strong="H2028" \w*; 
\v 5 [Whose possessors]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8802”} [slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and hold themselves not guilty]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8799”}: [and they that sell]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8802”} [them say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} be the \sc Lord\sc*; [for I am rich]{strong=“H6238” x-morph=“strongMorph: \sc Th\sc*8686”}: [and their own shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [pity]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”} them not. 
\v 6 [For I will no more pity]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”} [the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the land| strong="H776" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: [but, lo, I will deliver]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8688”} \w the men| strong="H120" \w* \w every one| strong="H376" \w* [into his neighbour’s]{strong=“H7453”} \w hand| strong="H3027" \w*, \w and into the hand| strong="H3027" \w* \w of his king| strong="H4428" \w*: [and they shall smite]{strong=“H3807” x-morph=“strongMorph: \sc Th\sc*8765”} \w the land| strong="H776" \w*, \w and out of their hand| strong="H3027" \w* [I will not deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} them.\f + \fr 11:6 \ft deliver: Heb. make to be found \f* 
\v 7 [And I will feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} \w the flock| strong="H6629" \w* \w of slaughter| strong="H2028" \w*, even \w you| strong="H3651" \w*, \w O poor| strong="H6041" \w* \w of the flock| strong="H6629" \w*. [And I took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto me two| strong="H8147" \w* \w staves| strong="H4731" \w*; \w the one| strong="H259" \w* [I called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w Beauty| strong="H5278" \w*, \w and the other| strong="H259" \w* [I called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [Bands]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8802”}; [and I fed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} \w the flock| strong="H6629" \w*.\f + \fr 11:7 \ft even…: or, verily the poor \f* \f + \fr 11:7 \ft Bands: or, Binders \f* 
\v 8 \w Three| strong="H7969" \w* [shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [also I cut off]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8686”} \w in one| strong="H259" \w* \w month| strong="H3391" \w*; \w and my soul| strong="H5315" \w* [lothed]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and their soul]{strong=“H5315”} [also abhorred]{strong=“H973” x-morph=“strongMorph: \sc Th\sc*8804”} me.\f + \fr 11:8 \ft lothed…: Heb. was straightened for them \f* 
\v 9 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [I, I will not feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} [you: that that dieth]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”}, [let it die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}; [and that that is to be cut off]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8737”}, [let it be cut off]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8735”}; [and let the rest]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”} [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w every one| strong="H802" \w* \w the flesh| strong="H1320" \w* \w of another| strong="H7468" \w*.\f + \fr 11:9 \ft another: Heb. his fellow, or, neighbour \f* 
\p
\v 10 [And I took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w my staff| strong="H4731" \w*, even \w Beauty| strong="H5278" \w*, [and cut it asunder]{strong=“H1438” x-morph=“strongMorph: \sc Th\sc*8799”}, [that I might break]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8687”} \w my covenant| strong="H1285" \w* [which I had made]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8804”} \w with all the people| strong="H5971" \w*. 
\v 11 [And it was broken]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8714”} \w in that day| strong="H3117" \w*: \w and so the poor| strong="H6041" \w* \w of the flock| strong="H6629" \w* [that waited]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} [upon me knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} that it was \w the word| strong="H1697" \w* of the \sc Lord\sc*.\f + \fr 11:11 \ft so…: or, the poor of the flock, etc. certainly knew \f* 
\v 12 [And I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, If ye think]{strong=“H5869”} \w good| strong="H2896" \w*, [give]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”} me \w my price| strong="H7939" \w*; [and if not, forbear]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8798”}. [So they weighed]{strong=“H8254” x-morph=“strongMorph: \sc Th\sc*8799”} \w for my price| strong="H7939" \w* \w thirty| strong="H7970" \w* pieces \w of silver| strong="H3701" \w*.\f + \fr 11:12 \ft If ye…: Heb. If it be good in your eyes \f* 
\v 13 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8685”} [it unto the potter]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”}: \w a goodly| strong="H145" \w* \w price| strong="H3366" \w* [that I was prised at]{strong=“H3365” x-morph=“strongMorph: \sc Th\sc*8804”} [of them. And I took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the thirty| strong="H7970" \w* pieces \w of silver| strong="H3701" \w*, [and cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} [them to the potter]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the house| strong="H1004" \w* of the \sc Lord\sc*. 
\v 14 [Then I cut asunder]{strong=“H1438” x-morph=“strongMorph: \sc Th\sc*8799”} \w mine other| strong="H8145" \w* \w staff| strong="H4731" \w*, even [Bands]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8802”}, [that I might break]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8687”} \w the brotherhood| strong="H264" \w* \w between Judah| strong="H3063" \w* \w and Israel| strong="H3478" \w*.\f + \fr 11:14 \ft Bands: or, Binders \f* 
\p
\v 15 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto thee yet the instruments| strong="H3627" \w* \w of a foolish| strong="H196" \w* [shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 16 [For, lo, I will raise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8688”} [a shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the land| strong="H776" \w*, which [shall not visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} [those that be cut off]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8737”}, [neither shall seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w the young one| strong="H5289" \w*, [nor heal]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8762”} [that that is broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8737”}, [nor feed]{strong=“H3557” x-morph=“strongMorph: \sc Th\sc*8770”} [that that standeth]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8737”} [still: but he shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the flesh| strong="H1320" \w* \w of the fat| strong="H1277" \w*, \w and tear| strong="H6561" \w* \w their claws| strong="H6541" \w* [in pieces]{strong=“H6561” x-morph=“strongMorph: \sc Th\sc*8762”}.\f + \fr 11:16 \ft cut off: or, hidden \f* \f + \fr 11:16 \ft feed: or, bear \f* 
\v 17 \w Woe| strong="H1945" \w* \w to the idol| strong="H457" \w* \w shepherd| strong="H7473" \w* [that leaveth]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8802”} \w the flock| strong="H6629" \w*! \w the sword| strong="H2719" \w* shall be \w upon his arm| strong="H2220" \w*, \w and upon his right| strong="H3225" \w* \w eye| strong="H5869" \w*: \w his arm| strong="H2220" \w* [shall be clean]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8800”} [dried up]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and his right| strong="H3225" \w* \w eye| strong="H5869" \w* [shall be utterly]{strong=“H3543” x-morph=“strongMorph: \sc Th\sc*8800”} [darkened]{strong=“H3543” x-morph=“strongMorph: \sc Th\sc*8799”}.
\c 12
\p 
\v 1 \w The burden| strong="H4853" \w* \w of the word| strong="H1697" \w* of the \sc Lord\sc* \w for Israel| strong="H3478" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [which stretcheth]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8802”} \w forth the heavens| strong="H8064" \w*, [and layeth the foundation]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8801”} \w of the earth| strong="H776" \w*, [and formeth]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w the spirit| strong="H7307" \w* \w of man| strong="H120" \w* \w within| strong="H7130" \w* him. 
\v 2 [Behold, I will make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8802”} \w Jerusalem| strong="H3389" \w* \w a cup| strong="H5592" \w* \w of trembling| strong="H7478" \w* \w unto all the people| strong="H5971" \w* \w round about| strong="H5439" \w*, \w when they shall be in the siege| strong="H4692" \w* \w both against Judah| strong="H3063" \w* and \w against Jerusalem| strong="H3389" \w*.\f + \fr 12:2 \ft trembling: or, slumber, or, poison \f* \f + \fr 12:2 \ft when…: or, and also against Judah shall he be which shall be in siege against Jerusalem \f* 
\p
\v 3 \w And in that day| strong="H3117" \w* [will I make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jerusalem| strong="H3389" \w* \w a burdensome| strong="H4614" \w* \w stone| strong="H68" \w* \w for all people| strong="H5971" \w*: [all that burden]{strong=“H6006” x-morph=“strongMorph: \sc Th\sc*8802”} [themselves with it shall be cut in pieces]{strong=“H8295 H8295” x-morph=“strongMorph: \sc Th\sc*8735 strongMorph: \sc Th\sc*8800”}, \w though all the people| strong="H1471" \w* \w of the earth| strong="H776" \w* [be gathered together]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8738”} against it. 
\v 4 \w In that day| strong="H3117" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [I will smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w every horse| strong="H5483" \w* \w with astonishment| strong="H8541" \w*, [and his rider]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8802”} \w with madness| strong="H7697" \w*: [and I will open]{strong=“H6491” x-morph=“strongMorph: \sc Th\sc*8799”} \w mine eyes| strong="H5869" \w* \w upon the house| strong="H1004" \w* \w of Judah| strong="H3063" \w*, [and will smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w every horse| strong="H5483" \w* \w of the people| strong="H5971" \w* \w with blindness| strong="H5788" \w*. 
\v 5 \w And the governors| strong="H441" \w* \w of Judah| strong="H3063" \w* [shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w in their heart| strong="H3820" \w*, [The inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w* shall be \w my strength| strong="H556" \w* in the \sc Lord\sc* \w of hosts| strong="H6635" \w* \w their God| strong="H430" \w*.\f + \fr 12:5 \ft The inhabitants…: or, There is strength to me and to the inhabitants, etc \f* 
\p
\v 6 \w In that day| strong="H3117" \w* [will I make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w the governors| strong="H441" \w* \w of Judah| strong="H3063" \w* \w like an hearth| strong="H3595" \w* \w of fire| strong="H784" \w* \w among the wood| strong="H6086" \w*, \w and like a torch| strong="H3940" \w* \w of fire| strong="H784" \w* \w in a sheaf| strong="H5995" \w*; [and they shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w all the people| strong="H5971" \w* \w round about| strong="H5439" \w*, \w on the right hand| strong="H3225" \w* \w and on the left| strong="H8040" \w*: \w and Jerusalem| strong="H3389" \w* [shall be inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} again in her own place, even \w in Jerusalem| strong="H3389" \w*. 
\v 7 The \sc Lord\sc* [also shall save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8689”} \w the tents| strong="H168" \w* \w of Judah| strong="H3063" \w* \w first| strong="H7223" \w*, \w that the glory| strong="H8597" \w* \w of the house| strong="H1004" \w* \w of David| strong="H1732" \w* \w and the glory| strong="H8597" \w* [of the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w* [do not magnify]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8799”} themselves \w against Judah| strong="H3063" \w*. 
\v 8 \w In that day| strong="H3117" \w* shall the \sc Lord\sc* [defend]{strong=“H1598” x-morph=“strongMorph: \sc Th\sc*8686”} [the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w*; [and he that is feeble]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8737”} \w among them at that day| strong="H3117" \w* \w shall be as David| strong="H1732" \w*; \w and the house| strong="H1004" \w* \w of David| strong="H1732" \w* shall be \w as God| strong="H430" \w*, \w as the angel| strong="H4397" \w* of the \sc Lord\sc* \w before| strong="H6440" \w* them.\f + \fr 12:8 \ft feeble: or, abject: Heb. fallen \f* 
\p
\v 9 \w And it shall come to pass in that day| strong="H3117" \w*, that [I will seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} [to destroy]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8687”} \w all the nations| strong="H1471" \w* [that come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w against Jerusalem| strong="H3389" \w*. 
\v 10 [And I will pour]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon the house| strong="H1004" \w* \w of David| strong="H1732" \w*, [and upon the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w*, \w the spirit| strong="H7307" \w* \w of grace| strong="H2580" \w* \w and of supplications| strong="H8469" \w*: [and they shall look]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8689”} [upon me whom they have pierced]{strong=“H1856” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and they shall mourn| strong="H4553" \w* [for him, as one mourneth]{strong=“H5594” x-morph=“strongMorph: \sc Th\sc*8804”} for his \w only| strong="H3173" \w* son, [and shall be in bitterness]{strong=“H4843” x-morph=“strongMorph: \sc Th\sc*8687”} [for him, as one that is in bitterness]{strong=“H4843” x-morph=“strongMorph: \sc Th\sc*8687”} for his \w firstborn| strong="H1060" \w*. 
\v 11 \w In that day| strong="H3117" \w* [shall there be a great]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8799”} \w mourning| strong="H4553" \w* \w in Jerusalem| strong="H3389" \w*, \w as the mourning| strong="H4553" \w* \w of Hadadrimmon| strong="H1910" \w* \w in the valley| strong="H1237" \w* \w of Megiddon| strong="H4023" \w*. 
\v 12 \w And the land| strong="H776" \w* [shall mourn]{strong=“H5594” x-morph=“strongMorph: \sc Th\sc*8804”}, \w every| strong="H4940" \w* \w family| strong="H4940" \w* \w apart| strong="H905" \w*; \w the family| strong="H4940" \w* \w of the house| strong="H1004" \w* \w of David| strong="H1732" \w* [apart, and their wives]{strong=“H802”} [apart; the family]{strong=“H4940”} \w of the house| strong="H1004" \w* \w of Nathan| strong="H5416" \w* [apart, and their wives]{strong=“H802”} apart;\f + \fr 12:12 \ft every…: Heb. families, families \f* 
\v 13 \w The family| strong="H4940" \w* \w of the house| strong="H1004" \w* \w of Levi| strong="H3878" \w* [apart, and their wives]{strong=“H802”} [apart; the family]{strong=“H4940”} \w of Shimei| strong="H8097" \w* [apart, and their wives]{strong=“H802”} apart;^\sc 12:13 of Shimei: or, of Simeon, as [Lxx\sc*] 
\v 14 \w All the families| strong="H4940" \w* [that remain]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”}, \w every family| strong="H4940" \w* [apart, and their wives]{strong=“H802”} apart.
\c 13
\p 
\v 1 \w In that day| strong="H3117" \w* \w there shall be a fountain| strong="H4726" \w* [opened]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8737”} \w to the house| strong="H1004" \w* \w of David| strong="H1732" \w* [and to the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w* \w for sin| strong="H2403" \w* \w and for uncleanness| strong="H5079" \w*.\f + \fr 13:1 \ft uncleanness: Heb. separation for uncleanness \f* 
\p
\v 2 \w And it shall come to pass in that day| strong="H3117" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, that [I will cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8686”} \w the names| strong="H8034" \w* \w of the idols| strong="H6091" \w* \w out of the land| strong="H776" \w*, [and they shall no more be remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8735”}: \w and also I will cause the prophets| strong="H5030" \w* \w and the unclean| strong="H2932" \w* \w spirit| strong="H7307" \w* [to pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8686”} \w out of the land| strong="H776" \w*. 
\v 3 And it shall come to pass, that \w when any| strong="H376" \w* [shall yet prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8735”}, \w then his father| strong="H1" \w* \w and his mother| strong="H517" \w* [that begat]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”} [him shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto him, Thou shalt not live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}; [for thou speakest]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w lies| strong="H8267" \w* \w in the name| strong="H8034" \w* of the \sc Lord\sc*: \w and his father| strong="H1" \w* \w and his mother| strong="H517" \w* [that begat]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”} [him shall thrust]{strong=“H1856” x-morph=“strongMorph: \sc Th\sc*8804”} [him through when he prophesieth]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8736”}. 
\v 4 \w And it shall come to pass in that day| strong="H3117" \w*, that \w the prophets| strong="H5030" \w* [shall be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} \w every one| strong="H376" \w* \w of his vision| strong="H2384" \w*, [when he hath prophesied]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8736”}; [neither shall they wear]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w a rough| strong="H8181" \w* \w garment| strong="H155" \w* [to deceive]{strong=“H3584” x-morph=“strongMorph: \sc Th\sc*8763”}:\f + \fr 13:4 \ft a rough…: Heb. a garment of hair \f* \f + \fr 13:4 \ft deceive: Heb. lie \f* 
\v 5 [But he shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, I am \w no prophet| strong="H5030" \w*, I am [an husbandman]{strong=“H127 H5647 H376” x-morph=“strongMorph: \sc Th\sc*8802”}; \w for man| strong="H120" \w* [taught me to keep cattle]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8689”} \w from my youth| strong="H5271" \w*. 
\v 6 And one [shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} unto him, What are \w these wounds| strong="H4347" \w* \w in thine hands| strong="H3027" \w*? [Then he shall answer]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, Those [with which I was wounded]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8717”} in \w the house| strong="H1004" \w* [of my friends]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8764”}. 
\p
\v 7 [Awake]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O sword| strong="H2719" \w*, [against my shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and against the man| strong="H1397" \w* that is \w my fellow| strong="H5997" \w*, [saith ]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*: [smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8685”} [the shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and the sheep| strong="H6629" \w* [shall be scattered]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8799”}: [and I will turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} \w mine hand| strong="H3027" \w* [upon the little ones]{strong=“H6819” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 8 And it shall come to pass, that \w in all the land| strong="H776" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, \w two| strong="H8147" \w* \w parts| strong="H6310" \w* [therein shall be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8735”} and [die]{strong=“H1478” x-morph=“strongMorph: \sc Th\sc*8799”}; \w but the third| strong="H7992" \w* [shall be left]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8735”} therein. 
\v 9 [And I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w the third part| strong="H7992" \w* \w through the fire| strong="H784" \w*, [and will refine]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8804”} \w them as silver| strong="H3701" \w* [is refined]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8800”}, [and will try]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8804”} \w them as gold| strong="H2091" \w* [is tried]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8800”}: [they shall call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w on my name| strong="H8034" \w*, [and I will hear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [them: I will say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, It is \w my people| strong="H5971" \w*: [and they shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, The \sc Lord\sc* is \w my God| strong="H430" \w*. 
\c 14
\p 
\v 1 [Behold, the day]{strong=“H3117”} of the \sc Lord\sc* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and thy spoil| strong="H7998" \w* [shall be divided]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8795”} \w in the midst| strong="H7130" \w* of thee. 
\v 2 [For I will gather]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8804”} \w all nations| strong="H1471" \w* \w against Jerusalem| strong="H3389" \w* \w to battle| strong="H4421" \w*; \w and the city| strong="H5892" \w* [shall be taken]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and the houses| strong="H1004" \w* [rifled]{strong=“H8155” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and the women| strong="H802" \w* [ravished]{strong=“H7693 H7901” x-morph=“strongMorph: \sc Th\sc*8735 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8735”}; \w and half| strong="H2677" \w* \w of the city| strong="H5892" \w* [shall go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w into captivity| strong="H1473" \w*, \w and the residue| strong="H3499" \w* \w of the people| strong="H5971" \w* [shall not be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8735”} \w from the city| strong="H5892" \w*. 
\v 3 Then shall the \sc Lord\sc* [go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”}, [and fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8738”} \w against those nations| strong="H1471" \w*, \w as when| strong="H3117" \w* [he fought]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8736”} \w in the day| strong="H3117" \w* \w of battle| strong="H7128" \w*. 
\p
\v 4 \w And his feet| strong="H7272" \w* [shall stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} \w in that day| strong="H3117" \w* \w upon the mount| strong="H2022" \w* \w of Olives| strong="H2132" \w*, which is \w before| strong="H6440" \w* \w Jerusalem| strong="H3389" \w* \w on the east| strong="H6924" \w*, \w and the mount| strong="H2022" \w* \w of Olives| strong="H2132" \w* [shall cleave]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the midst| strong="H2677" \w* \w thereof toward the east| strong="H4217" \w* \w and toward the west| strong="H3220" \w*, and there shall be \w a very| strong="H3966" \w* \w great| strong="H1419" \w* \w valley| strong="H1516" \w*; \w and half| strong="H2677" \w* \w of the mountain| strong="H2022" \w* [shall remove]{strong=“H4185” x-morph=“strongMorph: \sc Th\sc*8804”} \w toward the north| strong="H6828" \w*, \w and half| strong="H2677" \w* \w of it toward the south| strong="H5045" \w*. 
\v 5 [And ye shall flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8804”} to \w the valley| strong="H1516" \w* \w of the mountains| strong="H2022" \w*; \w for the valley| strong="H1516" \w* \w of the mountains| strong="H2022" \w* [shall reach]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto Azal| strong="H682" \w*: [yea, ye shall flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8804”}, [like as ye fled]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8804”} \w from before| strong="H6440" \w* \w the earthquake| strong="H7494" \w* \w in the days| strong="H3117" \w* \w of Uzziah| strong="H5818" \w* \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w*: and the \sc Lord\sc* \w my God| strong="H430" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, and \w all the saints| strong="H6918" \w* with thee.\f + \fr 14:5 \ft the mountains: or, my mountains \f* \f + \fr 14:5 \ft for the…: or, when he shall touch the valley of the mountains to the place he separated \f* 
\v 6 \w And it shall come to pass in that day| strong="H3117" \w*, that \w the light| strong="H216" \w* \w shall not be clear| strong="H3368" \w*, nor [dark]{strong=“H7087 H7087” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675”}:\f + \fr 14:6 \ft that the…: that is, it shall not be clear in some places, and dark in other places of the world \f* \f + \fr 14:6 \ft clear: Heb. precious \f* \f + \fr 14:6 \ft dark: Heb. thickness \f* 
\v 7 \w But it shall be one| strong="H259" \w* \w day| strong="H3117" \w* [which shall be known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8735”} to the \sc Lord\sc*, \w not day| strong="H3117" \w*, \w nor night| strong="H3915" \w*: but it shall come to pass, that \w at evening| strong="H6153" \w* \w time| strong="H6256" \w* \w it shall be light| strong="H216" \w*.\f + \fr 14:7 \ft it shall be…: or, the day shall be one \f* 
\p
\v 8 \w And it shall be in that day| strong="H3117" \w*, that \w living| strong="H2416" \w* \w waters| strong="H4325" \w* [shall go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w from Jerusalem| strong="H3389" \w*; \w half| strong="H2677" \w* \w of them toward the former| strong="H6931" \w* \w sea| strong="H3220" \w*, \w and half| strong="H2677" \w* \w of them toward the hinder| strong="H314" \w* \w sea| strong="H3220" \w*: \w in summer| strong="H7019" \w* \w and in winter| strong="H2779" \w* shall it be.\f + \fr 14:8 \ft former: or, eastern \f* 
\v 9 And the \sc Lord\sc* \w shall be king| strong="H4428" \w* \w over all the earth| strong="H776" \w*: \w in that day| strong="H3117" \w* \w shall there be one| strong="H259" \w* \sc Lord\sc*, \w and his name| strong="H8034" \w* \w one| strong="H259" \w*. 
\v 10 \w All the land| strong="H776" \w* [shall be turned]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8735”} \w as a plain| strong="H6160" \w* \w from Geba| strong="H1387" \w* \w to Rimmon| strong="H7417" \w* \w south| strong="H5045" \w* \w of Jerusalem| strong="H3389" \w*: [and it shall be lifted up]{strong=“H7213” x-morph=“strongMorph: \sc Th\sc*8804”}, [and inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} [in her place, from Benjamin’s]{strong=“H1144”} \w gate| strong="H8179" \w* \w unto the place| strong="H4725" \w* \w of the first| strong="H7223" \w* \w gate| strong="H8179" \w*, \w unto the corner| strong="H6434" \w* \w gate| strong="H8179" \w*, and from \w the tower| strong="H4026" \w* \w of Hananeel| strong="H2606" \w* [unto the king’s]{strong=“H4428”} \w winepresses| strong="H3342" \w*.\f + \fr 14:10 \ft turned: or, compassed \f* \f + \fr 14:10 \ft inhabited: or, shall abide \f* 
\v 11 And men [shall dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} [in it, and there shall be no more utter destruction]{strong=“H2764”}; \w but Jerusalem| strong="H3389" \w* \w shall be safely| strong="H983" \w* [inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 14:11 \ft shall be: or, shall abide \f* 
\p
\v 12 \w And this shall be the plague| strong="H4046" \w* wherewith the \sc Lord\sc* [will smite]{strong=“H5062” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the people| strong="H5971" \w* [that have fought]{strong=“H6633” x-morph=“strongMorph: \sc Th\sc*8804”} \w against Jerusalem| strong="H3389" \w*; \w Their flesh| strong="H1320" \w* [shall consume away]{strong=“H4743” x-morph=“strongMorph: \sc Th\sc*8687”} [while they stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon their feet| strong="H7272" \w*, \w and their eyes| strong="H5869" \w* [shall consume away]{strong=“H4743” x-morph=“strongMorph: \sc Th\sc*8735”} \w in their holes| strong="H2356" \w*, \w and their tongue| strong="H3956" \w* [shall consume away]{strong=“H4743” x-morph=“strongMorph: \sc Th\sc*8735”} \w in their mouth| strong="H6310" \w*. 
\v 13 \w And it shall come to pass in that day| strong="H3117" \w*, that \w a great| strong="H7227" \w* \w tumult| strong="H4103" \w* from the \sc Lord\sc* [shall be among them; and they shall lay hold]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8689”} \w every one| strong="H376" \w* \w on the hand| strong="H3027" \w* \w of his neighbour| strong="H7453" \w*, \w and his hand| strong="H3027" \w* [shall rise up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w against the hand| strong="H3027" \w* \w of his neighbour| strong="H7453" \w*. 
\v 14 \w And Judah| strong="H3063" \w* [also shall fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8735”} \w at Jerusalem| strong="H3389" \w*; \w and the wealth| strong="H2428" \w* \w of all the heathen| strong="H1471" \w* \w round about| strong="H5439" \w* [shall be gathered together]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8795”}, \w gold| strong="H2091" \w*, \w and silver| strong="H3701" \w*, \w and apparel| strong="H899" \w*, \w in great| strong="H3966" \w* \w abundance| strong="H7230" \w*.\f + \fr 14:14 \ft Judah…: or, thou also, O Judah shalt \f* \f + \fr 14:14 \ft at: or, against \f* 
\v 15 \w And so shall be the plague| strong="H4046" \w* \w of the horse| strong="H5483" \w*, \w of the mule| strong="H6505" \w*, \w of the camel| strong="H1581" \w*, \w and of the ass| strong="H2543" \w*, \w and of all the beasts| strong="H929" \w* \w that shall be in these| strong="H1992" \w* \w tents| strong="H4264" \w*, \w as this plague| strong="H4046" \w*. 
\p
\v 16 And it shall come to pass, that [every one that is left]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8737”} \w of all the nations| strong="H1471" \w* [which came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w against Jerusalem| strong="H3389" \w* [shall even go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w from| strong="H1767" \w* \w year| strong="H8141" \w* \w to year| strong="H8141" \w* [to worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8692”} \w the King| strong="H4428" \w*, the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [and to keep]{strong=“H2287” x-morph=“strongMorph: \sc Th\sc*8800”} \w the feast| strong="H2282" \w* \w of tabernacles| strong="H5521" \w*. 
\v 17 And it shall be, that [whoso will not come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} of all \w the families| strong="H4940" \w* \w of the earth| strong="H776" \w* \w unto Jerusalem| strong="H3389" \w* [to worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8692”} \w the King| strong="H4428" \w*, the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w even upon them shall be no rain| strong="H1653" \w*. 
\v 18 \w And if the family| strong="H4940" \w* \w of Egypt| strong="H4714" \w* [go not up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”}, [and come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} not, that have no rain; \w there shall be the plague| strong="H4046" \w*, wherewith the \sc Lord\sc* [will smite]{strong=“H5062” x-morph=“strongMorph: \sc Th\sc*8799”} \w the heathen| strong="H1471" \w* [that come not up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} [to keep]{strong=“H2287” x-morph=“strongMorph: \sc Th\sc*8800”} \w the feast| strong="H2282" \w* \w of tabernacles| strong="H5521" \w*.\f + \fr 14:18 \ft that have no: Heb. upon whom there is not \f* 
\v 19 \w This shall be the punishment| strong="H2403" \w* \w of Egypt| strong="H4714" \w*, \w and the punishment| strong="H2403" \w* \w of all nations| strong="H1471" \w* [that come not up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} [to keep]{strong=“H2287” x-morph=“strongMorph: \sc Th\sc*8800”} \w the feast| strong="H2282" \w* \w of tabernacles| strong="H5521" \w*.\f + \fr 14:19 \ft punishment: or, sin \f* 
\p
\v 20 \w In that day| strong="H3117" \w* \w shall there be upon the bells| strong="H4698" \w* \w of the horses| strong="H5483" \w*, \sc Holiness\sc*_H6944 \sc Unto\sc* \sc The\sc* \sc Lord\sc*; \w and the pots| strong="H5518" \w* in the \sc Lord\sc*’S \w house| strong="H1004" \w* \w shall be like the bowls| strong="H4219" \w* \w before| strong="H6440" \w* \w the altar| strong="H4196" \w*.\f + \fr 14:20 \ft bells: or, bridles \f* 
