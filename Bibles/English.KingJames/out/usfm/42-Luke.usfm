\v 58 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”}, \wj Foxes have holes, and birds of the air have nests; but the Son of man hath not where to lay his head.\wj* 
\v 59 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [another]{strong=“G2087” x-morph=“robinson: A-\sc Asm\sc* 4”}, \wj Follow me.\wj* [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 8”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 9”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 10”}, [suffer]{strong=“G2010” x-morph=“robinson: V-\sc Aam\sc*-2S 11”} [me]{strong=“G3427” x-morph=“robinson: P-1\sc Ds\sc* 12”} [first]{strong=“G4412” x-morph=“robinson: \sc Adv\sc* 14”} [to go]{strong=“G565” x-morph=“robinson: V-2\sc Aap\sc*-\sc Dsm\sc* 13”} [and bury]{strong=“G2290” x-morph=“robinson: V-\sc Aan\sc* 15”} [my]{strong=“G3450” x-morph=“robinson: P-1\sc Gs\sc* 18”} [father]{strong=“G3588 G3962” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 16 17”}. 
\v 60 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”}, \wj Let the dead bury their dead: but go thou and preach the kingdom of God.\wj* 
\v 61 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [another]{strong=“G2087” x-morph=“robinson: A-\sc Nsm\sc* 4”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 3”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 7”}, [I will follow]{strong=“G190” x-morph=“robinson: V-\sc Fai\sc*-1S 5”} [thee]{strong=“G4671” x-morph=“robinson: P-2\sc Ds\sc* 6”}; [but]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 9”} [let]{strong=“G2010” x-morph=“robinson: V-\sc Aam\sc*-2S 10”} [me]{strong=“G3427” x-morph=“robinson: P-1\sc Ds\sc* 11”} [first]{strong=“G4412” x-morph=“robinson: \sc Adv\sc* 8”} [go]{strong=“G2010” x-morph=“robinson: V-\sc Aam\sc*-2S 10”} [bid]{strong=“G657” x-morph=“robinson: V-\sc Amn\sc* 12”} [them]{strong=“G3588” x-morph=“robinson: T-\sc Dpm\sc* 13”} [farewell]{strong=“G657” x-morph=“robinson: V-\sc Amn\sc* 12”}, [which are]{strong=“G3588” x-morph=“robinson: T-\sc Dpm\sc* 13”} [at home]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 14”} [at]{strong=“G3588 G3624” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 15 16”} [my]{strong=“G3450” x-morph=“robinson: P-1\sc Gs\sc* 17”} [house]{strong=“G3624” x-morph=“robinson: N-\sc Asm\sc* 16”}. 
\v 62 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 4”}, \wj No man, having put his hand to the plough, and looking back, is fit for the kingdom of God.\wj* 
\c 10
\p 
\v 1 [After]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 1”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 3”} [the Lord]{strong=“G3588 G2962” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [appointed]{strong=“G322” x-morph=“robinson: V-\sc Aai\sc*-3S 4”} [other]{strong=“G2087” x-morph=“robinson: A-\sc Apm\sc* 8”} [seventy]{strong=“G1440” x-morph=“robinson: A-\sc Nui\sc* 9”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [sent]{strong=“G649” x-morph=“robinson: V-\sc Aai\sc*-3S 11”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 12”} [two]{strong=“G1417” x-morph=“robinson: A-\sc Nui\sc* 14”} [and]{strong=“G303” x-morph=“robinson: \sc Prep\sc* 13”} [two]{strong=“G1417” x-morph=“robinson: A-\sc Nui\sc* 14”} [before]{strong=“G4253” x-morph=“robinson: \sc Prep\sc* 15”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 17”} [face]{strong=“G4383” x-morph=“robinson: N-\sc Gsn\sc* 16”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 18”} [every]{strong=“G3956” x-morph=“robinson: A-\sc Asf\sc* 19”} [city]{strong=“G4172” x-morph=“robinson: N-\sc Asf\sc* 20”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 21”} [place]{strong=“G5117” x-morph=“robinson: N-\sc Asm\sc* 22”}, [whither]{strong=“G3739” x-morph=“robinson: R-\sc Gsm\sc* 23”} [he]{strong=“G3195” x-morph=“robinson: V-\sc Iai\sc*-3S 25”} [himself]{strong=“G846” x-morph=“robinson: P-\sc Nsm\sc* 26”} [would]{strong=“G3195” x-morph=“robinson: V-\sc Iai\sc*-3S 25”} [come]{strong=“G2064” x-morph=“robinson: V-\sc Pnn\sc* 27”}. 
\v 2 [Therefore]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [said he]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 1”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 4”}, \wj The harvest truly is great, but the labourers are few: pray ye therefore the Lord of the harvest, that he would send forth labourers into his harvest.\wj* 
\v 3 \wj Go your ways: behold, I send you forth as lambs among wolves.\wj* 
\v 4 \wj Carry neither purse, nor scrip, nor shoes: and salute no man by the way.\wj* 
\v 5 \wj And into whatsoever house ye enter, first say, Peace be to this house.\wj* 
\v 6 \wj And if the son of peace be there, your peace shall rest upon it: if not, it shall turn to you again.\wj* 
\v 7 \wj And in the same house remain, eating and drinking such things as they give: for the labourer is worthy of his hire. Go not from house to house.\wj* 
\v 8 \wj And into whatsoever city ye enter, and they receive you, eat such things as are set before you:\wj* 
\v 9 \wj And heal the sick that are therein, and say unto them, The kingdom of God is come nigh unto you.\wj* 
\v 10 \wj But into whatsoever city ye enter, and they receive you not, go your ways out into the streets of the same, and say,\wj* 
\v 11 \wj Even the very dust of your city, which cleaveth on us, we do wipe off against you: notwithstanding be ye sure of this, that the kingdom of God is come nigh unto you.\wj* 
\v 12 \wj But I say unto you, that it shall be more tolerable in that day for Sodom, than for that city.\wj* 
\v 13 \wj Woe unto thee, Chorazin! woe unto thee, Bethsaida! for if the mighty works had been done in Tyre and Sidon, which have been done in you, they had a great while ago repented, sitting in sackcloth and ashes.\wj* 
\v 14 \wj But it shall be more tolerable for Tyre and Sidon at the judgment, than for you.\wj* 
\v 15 \wj And thou, Capernaum, which art exalted to heaven, shalt be thrust down to hell.\wj* 
\v 16 \wj He that heareth you heareth me; and he that despiseth you despiseth me; and he that despiseth me despiseth him that sent me.\wj* 
\p
\v 17 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [the seventy]{strong=“G1440” x-morph=“robinson: A-\sc Nui\sc* 4”} [returned again]{strong=“G5290” x-morph=“robinson: V-\sc Aai\sc*-3P 1”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 5”} [joy]{strong=“G5479” x-morph=“robinson: N-\sc Gsf\sc* 6”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 7”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 8”}, [even]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [the devils]{strong=“G3588 G1140” x-morph=“robinson: T-\sc Npn\sc* robinson: N-\sc Npn\sc* 10 11”} [are subject unto]{strong=“G5293” x-morph=“robinson: V-\sc Ppi\sc*-3S 12”} [us]{strong=“G2254” x-morph=“robinson: P-1\sc Dp\sc* 13”} [through]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 14”} [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 17”} [name]{strong=“G3588 G3686” x-morph=“robinson: T-\sc Dsn\sc* robinson: N-\sc Dsn\sc* 15 16”}. 
\v 18 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj I beheld Satan as lightning fall from heaven.\wj* 
\v 19 \wj Behold, I give unto you power to tread on serpents and scorpions, and over all the power of the enemy: and nothing shall by any means hurt you.\wj* 
\v 20 \wj Notwithstanding in this rejoice not, that the spirits are subject unto you; but rather rejoice, because your names are written in heaven.\wj* 
\p
\v 21 [In]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 1”} [that]{strong=“G846” x-morph=“robinson: P-\sc Dsf\sc* 2”} [hour]{strong=“G3588 G5610” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 3 4”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 8 9”} [rejoiced]{strong=“G21” x-morph=“robinson: V-\sc Adi\sc*-3S 5”} [in spirit]{strong=“G3588 G4151” x-morph=“robinson: T-\sc Dsn\sc* robinson: N-\sc Dsn\sc* 6 7”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 11”}, \wj I thank thee, O Father, Lord of heaven and earth, that thou hast hid these things from the wise and prudent, and hast revealed them unto babes: even so, Father; for so it seemed good in thy sight.\wj* 
\v 22 \wj All things are delivered to me of my Father: and no man knoweth who the Son is, but the Father; and who the Father is, but the Son, and he to whom the Son will reveal him.\wj* 
\p
\v 23 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he turned him]{strong=“G4762” x-morph=“robinson: V-2\sc App\sc*-\sc Nsm\sc* 2”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} his [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 4 5”}, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 8”} [privately]{strong=“G2398” x-morph=“robinson: A-\sc Asf\sc* 7”}, \wj Blessed are the eyes which see the things that ye see:\wj* 
\v 24 \wj For I tell you, that many prophets and kings have desired to see those things which ye see, and have not seen them; and to hear those things which ye hear, and have not heard them.\wj* 
\p
\v 25 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”}, [behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 2”}, [a certain]{strong=“G5100” x-morph=“robinson: X-\sc Nsm\sc* 4”} [lawyer]{strong=“G3544” x-morph=“robinson: A-\sc Nsm\sc* 3”} [stood up]{strong=“G450” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [tempted]{strong=“G1598” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 6”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 7”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 9”}, [Master]{strong=“G1320” x-morph=“robinson: N-\sc Vsm\sc* 10”}, [what]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 11”} [shall I do]{strong=“G4160” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 12”} [to inherit]{strong=“G2816” x-morph=“robinson: V-\sc Fai\sc*-1S 15”} [eternal]{strong=“G166” x-morph=“robinson: A-\sc Asf\sc* 14”} [life]{strong=“G2222” x-morph=“robinson: N-\sc Asf\sc* 13”}? 
\v 26 [He said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 4”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 5”}, \wj What is written in the law? how readest thou?\wj* 
\v 27 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [answering]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 3”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”}, [Thou shalt love]{strong=“G25” x-morph=“robinson: V-\sc Fai\sc*-2S 5”} [the Lord]{strong=“G2962” x-morph=“robinson: N-\sc Asm\sc* 6”} [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 9”} [God]{strong=“G3588 G2316” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 7 8”} [with]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 10”} [all]{strong=“G3650” x-morph=“robinson: A-\sc Gsf\sc* 11”} [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 14”} [heart]{strong=“G3588 G2588” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 12 13”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 15”} [with]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 16”} [all]{strong=“G3650” x-morph=“robinson: A-\sc Gsf\sc* 17”} [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 20”} [soul]{strong=“G3588 G5590” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 18 19”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 21”} [with]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 22”} [all]{strong=“G3650” x-morph=“robinson: A-\sc Gsf\sc* 23”} [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 26”} [strength]{strong=“G3588 G2479” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 24 25”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 27”} [with]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 28”} [all]{strong=“G3650” x-morph=“robinson: A-\sc Gsf\sc* 29”} [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 32”} [mind]{strong=“G3588 G1271” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 30 31”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 33”} [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 36”} [neighbour]{strong=“G4139” x-morph=“robinson: \sc Adv\sc* 35”} [as]{strong=“G5613” x-morph=“robinson: \sc Adv\sc* 37”} [thyself]{strong=“G4572” x-morph=“robinson: F-2\sc Asm\sc* 38”}. 
\v 28 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”}, \wj Thou hast answered right: this do, and thou shalt live.\wj* 
\v 29 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 6”}, [willing]{strong=“G2309” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 3”} [to justify]{strong=“G1344” x-morph=“robinson: V-\sc Pan\sc* 4”} [himself]{strong=“G1438” x-morph=“robinson: F-3\sc Asm\sc* 5”}, [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 6”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 7”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 8 9”}, [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [who]{strong=“G5101” x-morph=“robinson: I-\sc Nsm\sc* 11”} [is]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 12”} [my]{strong=“G3450” x-morph=“robinson: P-1\sc Gs\sc* 13”} [neighbour]{strong=“G4139” x-morph=“robinson: \sc Adv\sc* 14”}? 
\v 30 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [answering]{strong=“G5274” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 1”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”}, \wj A certain man went down from Jerusalem to Jericho, and fell among thieves, which stripped him of his raiment, and wounded him, and departed, leaving him half dead.\wj* 
\v 31 \wj And by chance there came down a certain priest that way: and when he saw him, he passed by on the other side.\wj* 
\v 32 \wj And likewise a Levite, when he was at the place, came and looked on him, and passed by on the other side.\wj* 
\v 33 \wj But a certain Samaritan, as he journeyed, came where he was: and when he saw him, he had compassion on him,\wj* 
\v 34 \wj And went to him, and bound up his wounds, pouring in oil and wine, and set him on his own beast, and brought him to an inn, and took care of him.\wj* 
\v 35 \wj And on the morrow when he departed, he took out two pence, and gave them to the host, and said unto him, Take care of him; and whatsoever thou spendest more, when I come again, I will repay thee.\wj* 
\v 36 \wj Which now of these three, thinkest thou, was neighbour unto him that fell among the thieves?\wj* 
\v 37 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”}, [He that shewed]{strong=“G4160” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 5”} [mercy]{strong=“G3588 G1656” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 6 7”} [on]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 8”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 9”}. [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 11”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 10”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 13 14”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 12”}, \wj Go, and do thou likewise.\wj* 
\p
\v 38 [Now]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [it came to pass]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 1”}, [as]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 3”} [they]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 6”} [went]{strong=“G4198” x-morph=“robinson: V-\sc Pnn\sc* 5”}, [that]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [he]{strong=“G846” x-morph=“robinson: P-\sc Nsm\sc* 8”} [entered]{strong=“G1525” x-morph=“robinson: V-2\sc Aai\sc*-3S 9”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 10”} [a]{strong=“G2968” x-morph=“robinson: N-\sc Asf\sc* 11”} [certain]{strong=“G5100” x-morph=“robinson: X-\sc Asf\sc* 12”} [village]{strong=“G2968” x-morph=“robinson: N-\sc Asf\sc* 11”}: [and]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 14”} [a]{strong=“G1135” x-morph=“robinson: N-\sc Nsf\sc* 13”} [certain]{strong=“G5100” x-morph=“robinson: X-\sc Nsf\sc* 15”} [woman]{strong=“G1135” x-morph=“robinson: N-\sc Nsf\sc* 13”} [named]{strong=“G3686” x-morph=“robinson: N-\sc Dsn\sc* 16”} [Martha]{strong=“G3136” x-morph=“robinson: N-\sc Nsf\sc* 17”} [received]{strong=“G5264” x-morph=“robinson: V-\sc Adi\sc*-3S 18”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 19”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 20”} [her]{strong=“G846” x-morph=“robinson: P-\sc Gsf\sc* 23”} [house]{strong=“G3588 G3624” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 21 22”}. 
\v 39 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [she]{strong=“G3592” x-morph=“robinson: D-\sc Dsf\sc* 2”} [had]{strong=“G2258” x-morph=“robinson: V-IXI-3S 3”} [a sister]{strong=“G79” x-morph=“robinson: N-\sc Nsf\sc* 4”} [called]{strong=“G2564” x-morph=“robinson: V-\sc Ppp\sc*-\sc Nsf\sc* 5”} [Mary]{strong=“G3137” x-morph=“robinson: N-\sc Nsf\sc* 6”}, [which]{strong=“G3739” x-morph=“robinson: R-\sc Nsf\sc* 7”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [sat]{strong=“G3869” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsf\sc* 9”} [at]{strong=“G3844” x-morph=“robinson: \sc Prep\sc* 10”} [Jesus’]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 13 14”} [feet]{strong=“G3588 G4228” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 11 12”}, [and heard]{strong=“G191” x-morph=“robinson: V-\sc Iai\sc*-3S 15”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 18”} [word]{strong=“G3588 G3056” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 16 17”}. 
\v 40 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Martha]{strong=“G3136” x-morph=“robinson: N-\sc Nsf\sc* 3”} [was cumbered]{strong=“G4049” x-morph=“robinson: V-\sc Ipi\sc*-3S 4”} [about]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 5”} [much]{strong=“G4183” x-morph=“robinson: A-\sc Asf\sc* 6”} [serving]{strong=“G1248” x-morph=“robinson: N-\sc Asf\sc* 7”}, [and]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 9”} [came to him]{strong=“G2186” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsf\sc* 8”}, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 10”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 11”}, [dost]{strong=“G3199” x-morph=“robinson: V-\sc Pqi\sc*-3S 13”} [thou]{strong=“G4671” x-morph=“robinson: P-2\sc Ds\sc* 14”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 12”} [care]{strong=“G3199” x-morph=“robinson: V-\sc Pqi\sc*-3S 13”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 15”} [my]{strong=“G3450” x-morph=“robinson: P-1\sc Gs\sc* 18”} [sister]{strong=“G3588 G79” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 16 17”} [hath left]{strong=“G2641” x-morph=“robinson: V-2\sc Aai\sc*-3S 21”} [me]{strong=“G3165” x-morph=“robinson: P-1\sc As\sc* 20”} [to serve]{strong=“G1247” x-morph=“robinson: V-\sc Pan\sc* 22”} [alone]{strong=“G3441” x-morph=“robinson: A-\sc Asf\sc* 19”}? [bid]{strong=“G2036” x-morph=“robinson: V-2\sc Aam\sc*-2S 23”} [her]{strong=“G846” x-morph=“robinson: P-\sc Dsf\sc* 25”} [therefore]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 24”} [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 26”} [she help]{strong=“G4878” x-morph=“robinson: V-2\sc Ads\sc*-3S 28”} [me]{strong=“G3427” x-morph=“robinson: P-1\sc Ds\sc* 27”}. 
\v 41 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 1”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [unto her]{strong=“G846” x-morph=“robinson: P-\sc Dsf\sc* 4”}, \wj Martha, Martha, thou art careful and troubled about many things:\wj* 
\v 42 \wj But one thing is needful: and Mary hath chosen that good part, which shall not be taken away from her.\wj* 
\c 11
\p 
\v 1 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [it came to pass, that]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 2”}, [as]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 3”} [he]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 6”} [was]{strong=“G1511” x-morph=“robinson: V-\sc Pxn\sc* 5”} [praying]{strong=“G4336” x-morph=“robinson: V-\sc Pnp\sc*-\sc Asm\sc* 10”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 7”} [a]{strong=“G5117” x-morph=“robinson: N-\sc Dsm\sc* 8”} [certain]{strong=“G5100” x-morph=“robinson: X-\sc Dsm\sc* 9”} [place]{strong=“G5117” x-morph=“robinson: N-\sc Dsm\sc* 8”}, [when]{strong=“G5613” x-morph=“robinson: \sc Adv\sc* 11”} [he ceased]{strong=“G3973” x-morph=“robinson: V-\sc Ami\sc*-3S 12”}, [one]{strong=“G5100” x-morph=“robinson: X-\sc Nsm\sc* 14”} [of]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 15 16”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 17”} [disciples]{strong=“G3101” x-morph=“robinson: N-\sc Gpm\sc* 16”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 13”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 18”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 19”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 20”}, [teach]{strong=“G1321” x-morph=“robinson: V-\sc Aam\sc*-2S 21”} [us]{strong=“G2248” x-morph=“robinson: P-1\sc Ap\sc* 22”} [to pray]{strong=“G4336” x-morph=“robinson: V-\sc Pnn\sc* 23”}, [as]{strong=“G2531” x-morph=“robinson: \sc Adv\sc* 24”} [John]{strong=“G2491” x-morph=“robinson: N-\sc Nsm\sc* 26”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 25”} [taught]{strong=“G1321” x-morph=“robinson: V-\sc Aai\sc*-3S 27”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 30”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 28 29”}. 
\v 2 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, [When]{strong=“G3752” x-morph=“robinson: \sc Conj\sc* 4”} [ye pray]{strong=“G4336” x-morph=“robinson: V-\sc Pns\sc*-2P 5”}, [say]{strong=“G3004” x-morph=“robinson: V-\sc Pam\sc*-2P 6”}, \wj Our Father which art in heaven, Hallowed be thy name. Thy kingdom come. Thy will be done, as in heaven, so in earth.\wj* 
\v 3 \wj Give us day by day our daily bread.\wj* 
\v 4 \wj And forgive us our sins; for we also forgive every one that is indebted to us. And lead us not into temptation; but deliver us from evil.\wj* 
\v 5 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 4”}, \wj Which of you shall have a friend, and shall go unto him at midnight, and say unto him, Friend, lend me three loaves;\wj* 
\v 6 \wj For a friend of mine in his journey is come to me, and I have nothing to set before him?\wj* 
\v 7 \wj And he from within shall answer and say, Trouble me not: the door is now shut, and my children are with me in bed; I cannot rise and give thee.\wj* 
\v 8 \wj I say unto you, Though he will not rise and give him, because he is his friend, yet because of his importunity he will rise and give him as many as he needeth.\wj* 
\v 9 \wj And I say unto you, Ask, and it shall be given you; seek, and ye shall find; knock, and it shall be opened unto you.\wj* 
\v 10 \wj For every one that asketh receiveth; and he that seeketh findeth; and to him that knocketh it shall be opened.\wj* 
\v 11 \wj If a son shall ask bread of any of you that is a father, will he give him a stone? or if he ask a fish, will he for a fish give him a serpent?\wj* 
\v 12 \wj Or if he shall ask an egg, will he offer him a scorpion?\wj* 
\v 13 \wj If ye then, being evil, know how to give good gifts unto your children: how much more shall your heavenly Father give the Holy Spirit to them that ask him?\wj* 
\p
\v 14 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 2”} [casting out]{strong=“G1544” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 3”} [a devil]{strong=“G1140” x-morph=“robinson: N-\sc Asn\sc* 4”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [it]{strong=“G846” x-morph=“robinson: P-\sc Nsn\sc* 6”} [was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 7”} [dumb]{strong=“G2974” x-morph=“robinson: A-\sc Nsn\sc* 8”}. [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 10”} [it came to pass]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 9”}, [when]{strong=“G1831” x-morph=“robinson: V-2\sc Aap\sc*-\sc Gsn\sc* 13”} [the devil]{strong=“G3588 G1140” x-morph=“robinson: T-\sc Gsn\sc* robinson: N-\sc Gsn\sc* 11 12”} [was gone out]{strong=“G1831” x-morph=“robinson: V-2\sc Aap\sc*-\sc Gsn\sc* 13”}, [the dumb]{strong=“G2974” x-morph=“robinson: A-\sc Nsm\sc* 16”} [spake]{strong=“G2980” x-morph=“robinson: V-\sc Aai\sc*-3S 14”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 17”} [the people]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 19 20”} [wondered]{strong=“G2296” x-morph=“robinson: V-\sc Aai\sc*-3P 18”}. 
\v 15 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [some]{strong=“G5100” x-morph=“robinson: X-\sc Npm\sc* 1”} [of]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 3”} [them]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 4”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 5”}, [He casteth out]{strong=“G1544” x-morph=“robinson: V-\sc Pai\sc*-3S 11”} [devils]{strong=“G3588 G1140” x-morph=“robinson: T-\sc Apn\sc* robinson: N-\sc Apn\sc* 12 13”} [through]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 6”} [Beelzebub]{strong=“G954” x-morph=“robinson: N-\sc Pri\sc* 7”} [the chief]{strong=“G758” x-morph=“robinson: N-\sc Dsm\sc* 8”} [of the devils]{strong=“G3588 G1140” x-morph=“robinson: T-\sc Gpn\sc* robinson: N-\sc Gpn\sc* 9 10”}. 
\v 16 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [others]{strong=“G2087” x-morph=“robinson: A-\sc Npm\sc* 1”}, [tempting]{strong=“G3985” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 3”} him, [sought]{strong=“G2212” x-morph=“robinson: V-\sc Iai\sc*-3P 7”} [of]{strong=“G3844” x-morph=“robinson: \sc Prep\sc* 5”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 6”} [a sign]{strong=“G4592” x-morph=“robinson: N-\sc Asn\sc* 4”} [from]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 8”} [heaven]{strong=“G3772” x-morph=“robinson: N-\sc Gsm\sc* 9”}. 
\v 17 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he]{strong=“G846” x-morph=“robinson: P-\sc Nsm\sc* 1”}, [knowing]{strong=“G1492” x-morph=“robinson: V-\sc Rap\sc*-\sc Nsm\sc* 3”} [their]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 4”} [thoughts]{strong=“G3588 G1270” x-morph=“robinson: T-\sc Apn\sc* robinson: N-\sc Apn\sc* 5 6”}, [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 7”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 8”}, \wj Every kingdom divided against itself is brought to desolation; and a house divided against a house falleth.\wj* 
\v 18 \wj If Satan also be divided against himself, how shall his kingdom stand? because ye say that I cast out devils through Beelzebub.\wj* 
\v 19 \wj And if I by Beelzebub cast out devils, by whom do your sons cast them out? therefore shall they be your judges.\wj* 
\v 20 \wj But if I with the finger of God cast out devils, no doubt the kingdom of God is come upon you.\wj* 
\v 21 \wj When a strong man armed keepeth his palace, his goods are in peace:\wj* 
\v 22 \wj But when a stronger than he shall come upon him, and overcome him, he taketh from him all his armour wherein he trusted, and divideth his spoils.\wj* 
\v 23 \wj He that is not with me is against me: and he that gathereth not with me scattereth.\wj* 
\v 24 \wj When the unclean spirit is gone out of a man, he walketh through dry places, seeking rest; and finding none, he saith, I will return unto my house whence I came out.\wj* 
\v 25 \wj And when he cometh, he findeth it swept and garnished.\wj* 
\v 26 \wj Then goeth he, and taketh to him seven other spirits more wicked than himself; and they enter in, and dwell there: and the last state of that man is worse than the first.\wj* 
\p
\v 27 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [it came to pass]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 1”}, [as]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 3”} [he]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 6”} [spake]{strong=“G3004” x-morph=“robinson: V-\sc Pan\sc* 5”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 7”}, [a certain]{strong=“G5100” x-morph=“robinson: X-\sc Nsf\sc* 9”} [woman]{strong=“G1135” x-morph=“robinson: N-\sc Nsf\sc* 10”} [of]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 12”} [the company]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 13 14”} [lifted up]{strong=“G1869” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsf\sc* 8”} [her voice]{strong=“G5456” x-morph=“robinson: N-\sc Asf\sc* 11”}, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 15”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 16”}, [Blessed]{strong=“G3107” x-morph=“robinson: A-\sc Nsf\sc* 17”} is [the womb]{strong=“G3588 G2836” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 18 19”} [that bare]{strong=“G941” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsf\sc* 21”} [thee]{strong=“G4571” x-morph=“robinson: P-2\sc As\sc* 22”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 23”} [the paps]{strong=“G3149” x-morph=“robinson: N-\sc Npm\sc* 24”} [which]{strong=“G3739” x-morph=“robinson: R-\sc Apm\sc* 25”} [thou hast sucked]{strong=“G2337” x-morph=“robinson: V-\sc Aai\sc*-2S 26”}. 
\v 28 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he]{strong=“G846” x-morph=“robinson: P-\sc Nsm\sc* 1”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”}, \wj Yea rather, blessed are they that hear the word of God, and keep it.\wj* 
\p
\v 29 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [when]{strong=“G1865” x-morph=“robinson: V-\sc Ppp\sc*-\sc Gpm\sc* 4”} [the people]{strong=“G3793” x-morph=“robinson: N-\sc Gpm\sc* 3”} [were gathered thick together]{strong=“G1865” x-morph=“robinson: V-\sc Ppp\sc*-\sc Gpm\sc* 4”}, [he began]{strong=“G756” x-morph=“robinson: V-\sc Adi\sc*-3S 5”} [to say]{strong=“G3004” x-morph=“robinson: V-\sc Pan\sc* 6”}, \wj This is an evil generation: they seek a sign; and there shall no sign be given it, but the sign of Jonas the prophet.\wj* 
\v 30 \wj For as Jonas was a sign unto the Ninevites, so shall also the Son of man be to this generation.\wj* 
\v 31 \wj The queen of the south shall rise up in the judgment with the men of this generation, and condemn them: for she came from the utmost parts of the earth to hear the wisdom of Solomon; and, behold, a greater than Solomon is here.\wj* 
\v 32 \wj The men of Nineve shall rise up in the judgment with this generation, and shall condemn it: for they repented at the preaching of Jonas; and, behold, a greater than Jonas is here.\wj* 
\v 33 \wj No man, when he hath lighted a candle, putteth it in a secret place, neither under a bushel, but on a candlestick, that they which come in may see the light.\wj* 
\v 34 \wj The light of the body is the eye: therefore when thine eye is single, thy whole body also is full of light; but when thine eye is evil, thy body also is full of darkness.\wj* 
\v 35 \wj Take heed therefore that the light which is in thee be not darkness.\wj* 
\v 36 \wj If thy whole body therefore be full of light, having no part dark, the whole shall be full of light, as when the bright shining of a candle doth give thee light.\wj* 
\p
\v 37 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [as]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 1”} [he spake]{strong=“G2980” x-morph=“robinson: V-\sc Aan\sc* 4”}, [a certain]{strong=“G5100” x-morph=“robinson: X-\sc Nsm\sc* 8”} [Pharisee]{strong=“G5330” x-morph=“robinson: N-\sc Nsm\sc* 7”} [besought]{strong=“G2065” x-morph=“robinson: V-\sc Iai\sc*-3S 5”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 6”} [to]{strong=“G3704” x-morph=“robinson: \sc Adv\sc* 9”} [dine]{strong=“G709” x-morph=“robinson: V-\sc Aas\sc*-3S 10”} [with]{strong=“G3844” x-morph=“robinson: \sc Prep\sc* 11”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 12”}: [and]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 14”} [he went in]{strong=“G1525” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 13”}, [and sat down to meat]{strong=“G377” x-morph=“robinson: V-2\sc Aai\sc*-3S 15”}. 
\v 38 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [when]{strong=“G1492” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 4”} [the Pharisee]{strong=“G5330” x-morph=“robinson: N-\sc Nsm\sc* 3”} [saw]{strong=“G1492” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 4”} it, [he marvelled]{strong=“G2296” x-morph=“robinson: V-\sc Aai\sc*-3S 5”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 6”} [he had]{strong=“G907” x-morph=“robinson: V-\sc Api\sc*-3S 9”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 7”} [first]{strong=“G4412” x-morph=“robinson: \sc Adv\sc* 8”} [washed]{strong=“G907” x-morph=“robinson: V-\sc Api\sc*-3S 9”} [before]{strong=“G4253” x-morph=“robinson: \sc Prep\sc* 10”} [dinner]{strong=“G3588 G712” x-morph=“robinson: T-\sc Gsn\sc* robinson: N-\sc Gsn\sc* 11 12”}. 
\v 39 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [the Lord]{strong=“G3588 G2962” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 5”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 6”}, \wj Now do ye Pharisees make clean the outside of the cup and the platter; but your inward part is full of ravening and wickedness.\wj* 
\v 40 \wj Ye fools, did not he that made that which is without make that which is within also?\wj* 
\v 41 \wj But rather give alms of such things as ye have; and, behold, all things are clean unto you.\wj* 
\v 42 \wj But woe unto you, Pharisees! for ye tithe mint and rue and all manner of herbs, and pass over judgment and the love of God: these ought ye to have done, and not to leave the other undone.\wj* 
\v 43 \wj Woe unto you, Pharisees! for ye love the uppermost seats in the synagogues, and greetings in the markets.\wj* 
\v 44 \wj Woe unto you, scribes and Pharisees, hypocrites! for ye are as graves which appear not, and the men that walk over them are not aware of them.\wj* 
\p
\v 45 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 1”} [one]{strong=“G5100” x-morph=“robinson: X-\sc Nsm\sc* 3”} [of the lawyers]{strong=“G3544” x-morph=“robinson: A-\sc Gpm\sc* 5”}, [and said]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 6”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 7”}, [Master]{strong=“G1320” x-morph=“robinson: N-\sc Vsm\sc* 8”}, [thus]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 9”} [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 10”} [thou reproachest]{strong=“G5195” x-morph=“robinson: V-\sc Pai\sc*-2S 13”} [us]{strong=“G2248” x-morph=“robinson: P-1\sc Ap\sc* 12”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”}. 
\v 46 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”}, \wj Woe unto you also, ye lawyers! for ye lade men with burdens grievous to be borne, and ye yourselves touch not the burdens with one of your fingers.\wj* 
\v 47 \wj Woe unto you! for ye build the sepulchres of the prophets, and your fathers killed them.\wj* 
\v 48 \wj Truly ye bear witness that ye allow the deeds of your fathers: for they indeed killed them, and ye build their sepulchres.\wj* 
\v 49 \wj Therefore also said the wisdom of God, I will send them prophets and apostles, and some of them they shall slay and persecute:\wj* 
\v 50 \wj That the blood of all the prophets, which was shed from the foundation of the world, may be required of this generation;\wj* 
\v 51 \wj From the blood of Abel unto the blood of Zacharias, which perished between the altar and the temple: verily I say unto you, It shall be required of this generation.\wj* 
\v 52 \wj Woe unto you, lawyers! for ye have taken away the key of knowledge: ye entered not in yourselves, and them that were entering in ye hindered.\wj* 
\v 53 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [as]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Gsm\sc* 1”} [he]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 3”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Gsm\sc* 1”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 4”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 5”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 6”}, [the scribes]{strong=“G3588 G1122” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 8 9”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [the Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 11 12”} [began]{strong=“G756” x-morph=“robinson: V-\sc Adi\sc*-3P 7”} [to urge]{strong=“G1758” x-morph=“robinson: V-\sc Pan\sc* 14”} him [vehemently]{strong=“G1171” x-morph=“robinson: \sc Adv\sc* 13”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 15”} [to provoke]{strong=“G653” x-morph=“robinson: V-\sc Pan\sc* 16”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 17”} [to speak]{strong=“G653” x-morph=“robinson: V-\sc Pan\sc* 16”} [of]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 18”} [many things]{strong=“G4119” x-morph=“robinson: A-\sc Gpn\sc*-C 19”}: 
\v 54 [Laying wait]{strong=“G1748” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 1”} [for him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 2”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 3”} [seeking]{strong=“G2212” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 4”} [to catch]{strong=“G2340” x-morph=“robinson: V-\sc Aan\sc* 5”} [something]{strong=“G5100” x-morph=“robinson: X-\sc Asn\sc* 6”} [out]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 7”} [of]{strong=“G3588 G4750” x-morph=“robinson: T-\sc Gsn\sc* robinson: N-\sc Gsn\sc* 8 9”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 10”} [mouth]{strong=“G4750” x-morph=“robinson: N-\sc Gsn\sc* 9”}, [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 11”} [they might accuse]{strong=“G2723” x-morph=“robinson: V-\sc Aas\sc*-3P 12”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 13”}. 
\c 12
\p 
\v 1 [In]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 1”} [the mean time]{strong=“G3739” x-morph=“robinson: R-\sc Dpm\sc* 2”}, [when there were gathered together]{strong=“G1996” x-morph=“robinson: V-\sc App\sc*-\sc Gpf\sc* 3”} [an innumerable multitude]{strong=“G3461” x-morph=“robinson: A-\sc Gpm\sc* 5”} [of people]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 6 7”}, [insomuch that]{strong=“G5620” x-morph=“robinson: \sc Conj\sc* 8”} [they trode]{strong=“G2662” x-morph=“robinson: V-\sc Pan\sc* 9”} [one upon another]{strong=“G240” x-morph=“robinson: C-\sc Apm\sc* 10”}, [he began]{strong=“G756” x-morph=“robinson: V-\sc Adi\sc*-3S 11”} [to say]{strong=“G3004” x-morph=“robinson: V-\sc Pan\sc* 12”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 13”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 16”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 14 15”} [first of all]{strong=“G4412” x-morph=“robinson: \sc Adv\sc* 17”}, \wj Beware ye of the leaven of the Pharisees, which is hypocrisy.\wj* 
\v 2 \wj For there is nothing covered, that shall not be revealed; neither hid, that shall not be known.\wj* 
\v 3 \wj Therefore whatsoever ye have spoken in darkness shall be heard in the light; and that which ye have spoken in the ear in closets shall be proclaimed upon the housetops.\wj* 
\v 4 \wj And I say unto you my friends, Be not afraid of them that kill the body, and after that have no more that they can do.\wj* 
\v 5 \wj But I will forewarn you whom ye shall fear: Fear him, which after he hath killed hath power to cast into hell; yea, I say unto you, Fear him.\wj* 
\v 6 \wj Are not five sparrows sold for two farthings, and not one of them is forgotten before God?\wj* 
\v 7 \wj But even the very hairs of your head are all numbered. Fear not therefore: ye are of more value than many sparrows.\wj* 
\v 8 \wj Also I say unto you, Whosoever shall confess me before men, him shall the Son of man also confess before the angels of God:\wj* 
\v 9 \wj But he that denieth me before men shall be denied before the angels of God.\wj* 
\v 10 \wj And whosoever shall speak a word against the Son of man, it shall be forgiven him: but unto him that blasphemeth against the Holy Ghost it shall not be forgiven.\wj* 
\v 11 \wj And when they bring you unto the synagogues, and unto magistrates, and powers, take ye no thought how or what thing ye shall answer, or what ye shall say:\wj* 
\v 12 \wj For the Holy Ghost shall teach you in the same hour what ye ought to say.\wj* 
\p
\v 13 And [one]{strong=“G5100” x-morph=“robinson: X-\sc Nsm\sc* 3”} [of]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 5”} [the company]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 6 7”} [said]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} unto [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 4”}, [Master]{strong=“G1320” x-morph=“robinson: N-\sc Vsm\sc* 8”}, [speak]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S robinson: V-2\sc Aam\sc*-2S 1 9”} [to]{strong=“G3588 G80” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 10 11”} [my]{strong=“G3450” x-morph=“robinson: P-1\sc Gs\sc* 12”} [brother]{strong=“G80” x-morph=“robinson: N-\sc Dsm\sc* 11”}, [that he divide]{strong=“G3307” x-morph=“robinson: V-\sc Amn\sc* 13”} [the inheritance]{strong=“G3588 G2817” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 16 17”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 14”} [me]{strong=“G1700” x-morph=“robinson: P-1\sc Gs\sc* 15”}. 
\v 14 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 4”}, \wj Man, who made me a judge or a divider over you?\wj* 
\v 15 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 4”}, \wj Take heed, and beware of covetousness: for a man’s life consisteth not in the abundance of the things which he possesseth.\wj* 
\v 16 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he spake]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [a parable]{strong=“G3850” x-morph=“robinson: N-\sc Asf\sc* 3”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 4”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 5”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 6”}, \wj The ground of a certain rich man brought forth plentifully:\wj* 
\v 17 \wj And he thought within himself, saying, What shall I do, because I have no room where to bestow my fruits?\wj* 
\v 18 \wj And he said, This will I do: I will pull down my barns, and build greater; and there will I bestow all my fruits and my goods.\wj* 
\v 19 \wj And I will say to my soul, Soul, thou hast much goods laid up for many years; take thine ease, eat, drink, and be merry.\wj* 
\v 20 \wj But God said unto him, Thou fool, this night thy soul shall be required of thee: then whose shall those things be, which thou hast provided?\wj* 
\v 21 \wj So is he that layeth up treasure for himself, and is not rich toward God.\wj* 
\p
\v 22 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 6”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 4 5”}, \wj Therefore I say unto you, Take no thought for your life, what ye shall eat; neither for the body, what ye shall put on.\wj* 
\v 23 \wj The life is more than meat, and the body is more than raiment.\wj* 
\v 24 \wj Consider the ravens: for they neither sow nor reap; which neither have storehouse nor barn; and God feedeth them: how much more are ye better than the fowls?\wj* 
\v 25 \wj And which of you with taking thought can add to his stature one cubit?\wj* 
\v 26 \wj If ye then be not able to do that thing which is least, why take ye thought for the rest?\wj* 
\v 27 \wj Consider the lilies how they grow: they toil not, they spin not; and yet I say unto you, that Solomon in all his glory was not arrayed like one of these.\wj* 
\v 28 \wj If then God so clothe the grass, which is to day in the field, and to morrow is cast into the oven; how much more will he clothe you, O ye of little faith?\wj* 
\v 29 \wj And seek not ye what ye shall eat, or what ye shall drink, neither be ye of doubtful mind.\wj* 
\v 30 \wj For all these things do the nations of the world seek after: and your Father knoweth that ye have need of these things.\wj* 
\p
\v 31 \wj But rather seek ye the kingdom of God; and all these things shall be added unto you.\wj* 
\v 32 \wj Fear not, little flock; for it is your Father’s good pleasure to give you the kingdom.\wj* 
\v 33 \wj Sell that ye have, and give alms; provide yourselves bags which wax not old, a treasure in the heavens that faileth not, where no thief approacheth, neither moth corrupteth.\wj* 
\v 34 \wj For where your treasure is, there will your heart be also.\wj* 
\v 35 \wj Let your loins be girded about, and your lights burning;\wj* 
\v 36 \wj And ye yourselves like unto men that wait for their lord, when he will return from the wedding; that when he cometh and knocketh, they may open unto him immediately.\wj* 
\v 37 \wj Blessed are those servants, whom the lord when he cometh shall find watching: verily I say unto you, that he shall gird himself, and make them to sit down to meat, and will come forth and serve them.\wj* 
\v 38 \wj And if he shall come in the second watch, or come in the third watch, and find them so, blessed are those servants.\wj* 
\v 39 \wj And this know, that if the goodman of the house had known what hour the thief would come, he would have watched, and not have suffered his house to be broken through.\wj* 
\v 40 \wj Be ye therefore ready also: for the Son of man cometh at an hour when ye think not.\wj* 
\p
\v 41 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Peter]{strong=“G3588 G4074” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 6”}, [speakest thou]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-2S 12”} [this]{strong=“G3778” x-morph=“robinson: D-\sc Asf\sc* 11”} [parable]{strong=“G3588 G3850” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 9 10”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 7”} [us]{strong=“G2248” x-morph=“robinson: P-1\sc Ap\sc* 8”}, [or]{strong=“G2228” x-morph=“robinson: \sc Prt\sc* 13”} [even]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [to]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 15”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Apm\sc* 16”}? 
\v 42 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [the Lord]{strong=“G3588 G2962” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”}, \wj Who then is that faithful and wise steward, whom his lord shall make ruler over his household, to give them their portion of meat in due season?\wj* 
\v 43 \wj Blessed is that servant, whom his lord when he cometh shall find so doing.\wj* 
\v 44 \wj Of a truth I say unto you, that he will make him ruler over all that he hath.\wj* 
\v 45 \wj But and if that servant say in his heart, My lord delayeth his coming; and shall begin to beat the menservants and maidens, and to eat and drink, and to be drunken;\wj* 
\v 46 \wj The lord of that servant will come in a day when he looketh not for him, and at an hour when he is not aware, and will cut him in sunder, and will appoint him his portion with the unbelievers.\wj* 
\v 47 \wj And that servant, which knew his lord’s will, and prepared not himself, neither did according to his will, shall be beaten with many stripes.\wj* 
\v 48 \wj But he that knew not, and did commit things worthy of stripes, shall be beaten with few stripes. For unto whomsoever much is given, of him shall be much required: and to whom men have committed much, of him they will ask the more.\wj* 
\p
\v 49 \wj I am come to send fire on the earth; and what will I, if it be already kindled?\wj* 
\v 50 \wj But I have a baptism to be baptized with; and how am I straitened till it be accomplished!\wj* 
\v 51 \wj Suppose ye that I am come to give peace on earth? I tell you, Nay; but rather division:\wj* 
\v 52 \wj For from henceforth there shall be five in one house divided, three against two, and two against three.\wj* 
\v 53 \wj The father shall be divided against the son, and the son against the father; the mother against the daughter, and the daughter against the mother; the mother in law against her daughter in law, and the daughter in law against her mother in law.\wj* 
\p
\v 54 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 1”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 3”} [to the people]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 4 5”}, \wj When ye see a cloud rise out of the west, straightway ye say, There cometh a shower; and so it is.\wj* 
\v 55 \wj And when ye see the south wind blow, ye say, There will be heat; and it cometh to pass.\wj* 
\v 56 \wj Ye hypocrites, ye can discern the face of the sky and of the earth; but how is it that ye do not discern this time?\wj* 
\v 57 \wj Yea, and why even of yourselves judge ye not what is right?\wj* 
\p
\v 58 \wj When thou goest with thine adversary to the magistrate, as thou art in the way, give diligence that thou mayest be delivered from him; lest he hale thee to the judge, and the judge deliver thee to the officer, and the officer cast thee into prison.\wj* 
\v 59 \wj I tell thee, thou shalt not depart thence, till thou hast paid the very last mite.\wj* 
\c 13
\p 
\v 1 [There]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [were present]{strong=“G3918” x-morph=“robinson: V-IXI-3P 1”} [at]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 4”} [that]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 5”} [season]{strong=“G3588 G2540” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 6 7”} [some]{strong=“G5100” x-morph=“robinson: X-\sc Npm\sc* 3”} [that told]{strong=“G518” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 8”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 9”} [of]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 10”} [the Galilæans]{strong=“G3588 G1057” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 11 12”}, [whose]{strong=“G3739” x-morph=“robinson: R-\sc Gpm\sc* 13”} [blood]{strong=“G3588 G129” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 14 15”} [Pilate]{strong=“G4091” x-morph=“robinson: N-\sc Nsm\sc* 16”} [had mingled]{strong=“G3396” x-morph=“robinson: V-\sc Aai\sc*-3S 17”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 18”} [their]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 21”} [sacrifices]{strong=“G3588 G2378” x-morph=“robinson: T-\sc Gpf\sc* robinson: N-\sc Gpf\sc* 19 20”}. 
\v 2 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [answering]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 2”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 6”}, \wj Suppose ye that these Galilæans were sinners above all the Galilæans, because they suffered such things?\wj* 
\v 3 \wj I tell you, Nay: but, except ye repent, ye shall all likewise perish.\wj* 
\v 4 \wj Or those eighteen, upon whom the tower in Siloam fell, and slew them, think ye that they were sinners above all men that dwelt in Jerusalem?\wj* 
\v 5 \wj I tell you, Nay: but, except ye repent, ye shall all likewise perish.\wj* 
\p
\v 6 [He spake]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 1”} [also]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [this]{strong=“G3778” x-morph=“robinson: D-\sc Asf\sc* 3”} [parable]{strong=“G3588 G3850” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 4 5”}; \wj A certain man had a fig tree planted in his vineyard; and he came and sought fruit thereon, and found none.\wj* 
\v 7 \wj Then said he unto the dresser of his vineyard, Behold, these three years I come seeking fruit on this fig tree, and find none: cut it down; why cumbereth it the ground?\wj* 
\v 8 \wj And he answering said unto him, Lord, let it alone this year also, till I shall dig about it, and dung it:\wj* 
\v 9 \wj And if it bear fruit, well: and if not, then after that thou shalt cut it down.\wj* 
\v 10 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 1”} [teaching]{strong=“G1321” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 3”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 4”} [one]{strong=“G1520” x-morph=“robinson: A-\sc Dsf\sc* 5”} [of the synagogues]{strong=“G3588 G4864” x-morph=“robinson: T-\sc Gpf\sc* robinson: N-\sc Gpf\sc* 6 7”} [on]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 8”} [the sabbath]{strong=“G3588 G4521” x-morph=“robinson: T-\sc Dpn\sc* robinson: N-\sc Dpn\sc* 9 10”}. 
\p
\v 11 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”}, [behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 2”}, [there was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 4”} [a woman]{strong=“G1135” x-morph=“robinson: N-\sc Nsf\sc* 3”} [which had]{strong=“G2192” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsf\sc* 6”} [a spirit]{strong=“G4151” x-morph=“robinson: N-\sc Asn\sc* 5”} [of infirmity]{strong=“G769” x-morph=“robinson: N-\sc Gsf\sc* 7”} [eighteen]{strong=“G1176” x-morph=“robinson: A-\sc Nui\sc* 9”} [years]{strong=“G2094” x-morph=“robinson: N-\sc Apn\sc* 8”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”} [was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 13”} [bowed together]{strong=“G4794” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsf\sc* 14”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 15”} [could]{strong=“G1410” x-morph=“robinson: V-\sc Pnp\sc*-\sc Nsf\sc* 17”} [in]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 19”} [no]{strong=“G3361” x-morph=“robinson: \sc Prt\sc*-N 16”} [wise]{strong=“G3838” x-morph=“robinson: A-\sc Asn\sc* 21”} [lift up]{strong=“G352” x-morph=“robinson: V-\sc Aan\sc* 18”} herself. 
\v 12 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [when Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [saw]{strong=“G1492” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 1”} [her]{strong=“G846” x-morph=“robinson: P-\sc Asf\sc* 3”}, [he called]{strong=“G4377” x-morph=“robinson: V-\sc Aai\sc*-3S 6”} her to him, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 8”} [unto her]{strong=“G846” x-morph=“robinson: P-\sc Dsf\sc* 9”}, \wj Woman, thou art loosed from thine infirmity.\wj* 
\v 13 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he laid]{strong=“G2007” x-morph=“robinson: V-\sc Aai\sc*-3S 2”} his [hands]{strong=“G3588 G5495” x-morph=“robinson: T-\sc Apf\sc* robinson: N-\sc Apf\sc* 4 5”} [on her]{strong=“G846” x-morph=“robinson: P-\sc Dsf\sc* 3”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [immediately]{strong=“G3916” x-morph=“robinson: \sc Adv\sc* 7”} [she was made straight]{strong=“G461” x-morph=“robinson: V-\sc Api\sc*-3S 8”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [glorified]{strong=“G1392” x-morph=“robinson: V-\sc Iai\sc*-3S 10”} [God]{strong=“G3588 G2316” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 11 12”}. 
\v 14 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [the ruler of the synagogue]{strong=“G3588 G752” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 1”} [with indignation]{strong=“G23” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 5”}, [because]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 6”} [that Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 10 11”} [had healed]{strong=“G2323” x-morph=“robinson: V-\sc Aai\sc*-3S 9”} [on the sabbath day]{strong=“G3588 G4521” x-morph=“robinson: T-\sc Dsn\sc* robinson: N-\sc Dsn\sc* 7 8”}, [and said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 12”} [unto the people]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 13 14”}, [There are]{strong=“G1526” x-morph=“robinson: V-\sc Pxi\sc*-3P 17”} [six]{strong=“G1803” x-morph=“robinson: A-\sc Nui\sc* 15”} [days]{strong=“G2250” x-morph=“robinson: N-\sc Npf\sc* 16”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 18”} [which men]{strong=“G3739” x-morph=“robinson: R-\sc Dpf\sc* 19”} [ought]{strong=“G1163” x-morph=“robinson: V-\sc Pqi\sc*-3S 20”} [to work]{strong=“G2038” x-morph=“robinson: V-\sc Pnn\sc* 21”}: [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 22”} [them]{strong=“G3778” x-morph=“robinson: D-\sc Dpf\sc* 23”} [therefore]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 24”} [come]{strong=“G2064” x-morph=“robinson: V-\sc Pnp\sc*-\sc Npm\sc* 25”} [and be healed]{strong=“G2323” x-morph=“robinson: V-\sc Ppm\sc*-2P 26”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 27”} [not]{strong=“G3361” x-morph=“robinson: \sc Prt\sc*-N 28”} [on the sabbath]{strong=“G3588 G4521” x-morph=“robinson: T-\sc Gsn\sc* robinson: N-\sc Gsn\sc* 31 32”} [day]{strong=“G3588 G2250” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 29 30”}. 
\v 15 [The Lord]{strong=“G3588 G2962” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 1”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 7”}, \wj Thou hypocrite, doth not each one of you on the sabbath loose his ox or his ass from the stall, and lead him away to watering?\wj* 
\v 16 \wj And ought not this woman, being a daughter of Abraham, whom Satan hath bound, lo, these eighteen years, be loosed from this bond on the sabbath day?\wj* 
\v 17 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when he]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 4”} [had said]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Gsm\sc* 3”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 2”}, [all]{strong=“G3956” x-morph=“robinson: A-\sc Npm\sc* 6”} [his]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 9”} [adversaries]{strong=“G480” x-morph=“robinson: V-\sc Pnp\sc*-\sc Npm\sc* 8”} [were ashamed]{strong=“G2617” x-morph=“robinson: V-\sc Ipi\sc*-3P 5”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Nsm\sc* 11”} [the people]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 12 13”} [rejoiced]{strong=“G5463” x-morph=“robinson: V-\sc Iai\sc*-3S 14”} [for]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 15”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Dpn\sc* 16”} [the glorious]{strong=“G1741” x-morph=“robinson: A-\sc Dpn\sc* 18”} [things that]{strong=“G3588” x-morph=“robinson: T-\sc Dpn\sc* 19”} [were done]{strong=“G1096” x-morph=“robinson: V-\sc Pnp\sc*-\sc Dpn\sc* 20”} [by]{strong=“G5259” x-morph=“robinson: \sc Prep\sc* 21”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 22”}. 
\p
\v 18 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [said he]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 1”}, \wj Unto what is the kingdom of God like? and whereunto shall I resemble it?\wj* 
\v 19 \wj It is like a grain of mustard seed, which a man took, and cast into his garden; and it grew, and waxed a great tree; and the fowls of the air lodged in the branches of it.\wj* 
\v 20 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [again]{strong=“G3825” x-morph=“robinson: \sc Adv\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”}, \wj Whereunto shall I liken the kingdom of God?\wj* 
\v 21 \wj It is like leaven, which a woman took and hid in three measures of meal, till the whole was leavened.\wj* 
\v 22 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he went]{strong=“G1279” x-morph=“robinson: V-\sc Ini\sc*-3S 2”} [through]{strong=“G2596” x-morph=“robinson: \sc Prep\sc* 3”} [the cities]{strong=“G4172” x-morph=“robinson: N-\sc Apf\sc* 4”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [villages]{strong=“G2968” x-morph=“robinson: N-\sc Apf\sc* 6”}, [teaching]{strong=“G1321” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 7”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [journeying]{strong=“G4197” x-morph=“robinson: N-\sc Asf\sc* 9”} [toward]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 11”} [Jerusalem]{strong=“G2419” x-morph=“robinson: N-\sc Pri\sc* 12”}. 
\v 23 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [one]{strong=“G5100” x-morph=“robinson: X-\sc Nsm\sc* 3”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 4”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 5”}, [are there]{strong=“G1487” x-morph=“robinson: \sc Cond\sc* 6”} [few]{strong=“G3641” x-morph=“robinson: A-\sc Npm\sc* 7”} [that]{strong=“G3588” x-morph=“robinson: T-\sc Npm\sc* 8”} [be saved]{strong=“G4982” x-morph=“robinson: V-\sc Ppp\sc*-\sc Npm\sc* 9”}? [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 11”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 12”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 13”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 14”}, 
\p
\v 24 \wj Strive to enter in at the strait gate: for many, I say unto you, will seek to enter in, and shall not be able.\wj* 
\v 25 \wj When once the master of the house is risen up, and hath shut to the door, and ye begin to stand without, and to knock at the door, saying, Lord, Lord, open unto us; and he shall answer and say unto you, I know you not whence ye are:\wj* 
\v 26 \wj Then shall ye begin to say, We have eaten and drunk in thy presence, and thou hast taught in our streets.\wj* 
\v 27 \wj But he shall say, I tell you, I know you not whence ye are; depart from me, all ye workers of iniquity.\wj* 
\v 28 \wj There shall be weeping and gnashing of teeth, when ye shall see Abraham, and Isaac, and Jacob, and all the prophets, in the kingdom of God, and you yourselves thrust out.\wj* 
\v 29 \wj And they shall come from the east, and from the west, and from the north, and from the south, and shall sit down in the kingdom of God.\wj* 
\v 30 \wj And, behold, there are last which shall be first, and there are first which shall be last.\wj* 
\p
\v 31 [The same]{strong=“G846” x-morph=“robinson: P-\sc Dsf\sc* 2”} [day]{strong=“G3588 G2250” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 3 4”} [there came]{strong=“G4334” x-morph=“robinson: V-\sc Aai\sc*-3P 5”} [certain]{strong=“G5100” x-morph=“robinson: X-\sc Npm\sc* 6”} [of the Pharisees]{strong=“G5330” x-morph=“robinson: N-\sc Npm\sc* 7”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 8”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 9”}, [Get thee out]{strong=“G1831” x-morph=“robinson: V-2\sc Aam\sc*-2S 10”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [depart]{strong=“G4198” x-morph=“robinson: V-\sc Pnm\sc*-2S 12”} [hence]{strong=“G1782” x-morph=“robinson: \sc Adv\sc* 13”}: [for]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 14”} [Herod]{strong=“G2264” x-morph=“robinson: N-\sc Nsm\sc* 15”} [will]{strong=“G2309” x-morph=“robinson: V-\sc Pai\sc*-3S 16”} [kill]{strong=“G615” x-morph=“robinson: V-\sc Aan\sc* 18”} [thee]{strong=“G4571” x-morph=“robinson: P-2\sc As\sc* 17”}. 
\v 32 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj Go ye, and tell that fox, Behold, I cast out devils, and I do cures to day and to morrow, and the third day I shall be perfected.\wj* 
\v 33 \wj Nevertheless I must walk to day, and to morrow, and the day following: for it cannot be that a prophet perish out of Jerusalem.\wj* 
\v 34 \wj O Jerusalem, Jerusalem, which killest the prophets, and stonest them that are sent unto thee; how often would I have gathered thy children together, as a hen doth gather her brood under her wings, and ye would not!\wj* 
\v 35 \wj Behold, your house is left unto you desolate: and verily I say unto you, Ye shall not see me, until the time come when ye shall say, Blessed is he that cometh in the name of the Lord.\wj* 
\c 14
\p 
\v 1 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [it came to pass]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 2”}, [as he]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 6”} [went]{strong=“G2064” x-morph=“robinson: V-2\sc Aan\sc* 5”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 7”} [the house]{strong=“G3624” x-morph=“robinson: N-\sc Asm\sc* 8”} [of one]{strong=“G5100” x-morph=“robinson: X-\sc Gsm\sc* 9”} [of the chief]{strong=“G3588 G758” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 10 11”} [Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 12 13”} [to eat]{strong=“G5315” x-morph=“robinson: V-2\sc Aan\sc* 15”} [bread]{strong=“G740” x-morph=“robinson: N-\sc Asm\sc* 16”} [on the sabbath day]{strong=“G4521” x-morph=“robinson: N-\sc Dsn\sc* 14”}, [that]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 17”} [they]{strong=“G846” x-morph=“robinson: P-\sc Npm\sc* 18”} [watched]{strong=“G3906” x-morph=“robinson: V-\sc Pmp\sc*-\sc Npm\sc* 20”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 21”}. 
\v 2 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”}, [behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 2”}, [there was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 5”} [a certain]{strong=“G5100” x-morph=“robinson: X-\sc Nsm\sc* 4”} [man]{strong=“G444” x-morph=“robinson: N-\sc Nsm\sc* 3”} [before]{strong=“G1715” x-morph=“robinson: \sc Prep\sc* 7”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 8”} [which had the dropsy]{strong=“G5203” x-morph=“robinson: A-\sc Nsm\sc* 6”}. 
\v 3 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [answering]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 2”} [spake]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 6”} [the lawyers]{strong=“G3544” x-morph=“robinson: A-\sc Apm\sc* 8”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [Pharisees]{strong=“G5330” x-morph=“robinson: N-\sc Apm\sc* 10”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 11”}, \wj Is it lawful to heal on the sabbath day?\wj* 
\v 4 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [they held their peace]{strong=“G2270” x-morph=“robinson: V-\sc Aai\sc*-3P 3”}. [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 4”} [he took]{strong=“G1949” x-morph=“robinson: V-2\sc Adp\sc*-\sc Nsm\sc* 5”} him, [and healed]{strong=“G2390” x-morph=“robinson: V-\sc Adi\sc*-3S 6”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 7”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [let him go]{strong=“G630” x-morph=“robinson: V-\sc Aai\sc*-3S 9”}; 
\v 5 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 2”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 4”}, [saying]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”}, \wj Which of you shall have an ass or an ox fallen into a pit, and will not straightway pull him out on the sabbath day?\wj* 
\v 6 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they could]{strong=“G2480” x-morph=“robinson: V-\sc Aai\sc*-3P 3”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 2”} [answer]{strong=“G470” x-morph=“robinson: V-\sc Aon\sc* 4”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 5”} [again]{strong=“G470” x-morph=“robinson: V-\sc Aon\sc* 4”} [to]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 6”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 7”}. 
\p
\v 7 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he put forth]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 1”} [a parable]{strong=“G3850” x-morph=“robinson: N-\sc Asf\sc* 6”} [to]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [those which]{strong=“G3588” x-morph=“robinson: T-\sc Apm\sc* 4”} [were bidden]{strong=“G2564” x-morph=“robinson: V-\sc Rpp\sc*-\sc Apm\sc* 5”}, [when he marked]{strong=“G1907” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 7”} [how]{strong=“G4459” x-morph=“robinson: \sc Adv\sc* 8”} [they chose out]{strong=“G1586” x-morph=“robinson: V-\sc Imi\sc*-3P 11”} [the chief rooms]{strong=“G3588 G4411” x-morph=“robinson: T-\sc Apf\sc* robinson: N-\sc Apf\sc* 9 10”}; [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 12”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 13”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 14”}, 
\v 8 \wj When thou art bidden of any man to a wedding, sit not down in the highest room; lest a more honourable man than thou be bidden of him;\wj* 
\v 9 \wj And he that bade thee and him come and say to thee, Give this man place; and thou begin with shame to take the lowest room.\wj* 
\v 10 \wj But when thou art bidden, go and sit down in the lowest room; that when he that bade thee cometh, he may say unto thee, Friend, go up higher: then shalt thou have worship in the presence of them that sit at meat with thee.\wj* 
\v 11 \wj For whosoever exalteth himself shall be abased; and he that humbleth himself shall be exalted.\wj* 
\p
\v 12 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [said he]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 1”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 3”} [to him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 6”} [that]{strong=“G3588” x-morph=“robinson: T-\sc Dsm\sc* 4”} [bade him]{strong=“G2564” x-morph=“robinson: V-\sc Rap\sc*-\sc Dsm\sc* 5”}, \wj When thou makest a dinner or a supper, call not thy friends, nor thy brethren, neither thy kinsmen, nor thy rich neighbours; lest they also bid thee again, and a recompence be made thee.\wj* 
\v 13 \wj But when thou makest a feast, call the poor, the maimed, the lame, the blind:\wj* 
\v 14 \wj And thou shalt be blessed; for they cannot recompense thee: for thou shalt be recompensed at the resurrection of the just.\wj* 
\p
\v 15 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [when one]{strong=“G5100” x-morph=“robinson: X-\sc Nsm\sc* 3”} [of them that]{strong=“G3588” x-morph=“robinson: T-\sc Gpm\sc* 4”} [sat at meat with him]{strong=“G4873” x-morph=“robinson: V-\sc Pnp\sc*-\sc Gpm\sc* 5”} [heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 1”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 6”}, [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 7”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 8”}, [Blessed]{strong=“G3107” x-morph=“robinson: A-\sc Nsm\sc* 9”} is [he that]{strong=“G3739” x-morph=“robinson: R-\sc Nsm\sc* 10”} [shall eat]{strong=“G5315” x-morph=“robinson: V-\sc Fdi\sc*-3S 11”} [bread]{strong=“G740” x-morph=“robinson: N-\sc Asm\sc* 12”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 13”} [the kingdom]{strong=“G3588 G932” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 14 15”} [of God]{strong=“G3588 G2316” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 16 17”}. 
\v 16 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [said he]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 4”}, \wj A certain man made a great supper, and bade many:\wj* 
\v 17 \wj And sent his servant at supper time to say to them that were bidden, Come; for all things are now ready.\wj* 
\v 18 \wj And they all with one consent began to make excuse. The first said unto him, I have bought a piece of ground, and I must needs go and see it: I pray thee have me excused.\wj* 
\v 19 \wj And another said, I have bought five yoke of oxen, and I go to prove them: I pray thee have me excused.\wj* 
\v 20 \wj And another said, I have married a wife, and therefore I cannot come.\wj* 
\v 21 \wj So that servant came, and shewed his lord these things. Then the master of the house being angry said to his servant, Go out quickly into the streets and lanes of the city, and bring in hither the poor, and the maimed, and the halt, and the blind.\wj* 
\v 22 \wj And the servant said, Lord, it is done as thou hast commanded, and yet there is room.\wj* 
\v 23 \wj And the lord said unto the servant, Go out into the highways and hedges, and compel them to come in, that my house may be filled.\wj* 
\v 24 \wj For I say unto you, That none of those men which were bidden shall taste of my supper.\wj* 
\p
\v 25 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [there went]{strong=“G4848” x-morph=“robinson: V-\sc Ini\sc*-3P 1”} [great]{strong=“G4183” x-morph=“robinson: A-\sc Npm\sc* 5”} [multitudes]{strong=“G3793” x-morph=“robinson: N-\sc Npm\sc* 4”} [with]{strong=“G4848” x-morph=“robinson: V-\sc Ini\sc*-3P 1”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [he turned]{strong=“G4762” x-morph=“robinson: V-2\sc App\sc*-\sc Nsm\sc* 7”}, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 8”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 9”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 10”}, 
\v 26 \wj If any man come to me, and hate not his father, and mother, and wife, and children, and brethren, and sisters, yea, and his own life also, he cannot be my disciple.\wj* 
\v 27 \wj And whosoever doth not bear his cross, and come after me, cannot be my disciple.\wj* 
\v 28 \wj For which of you, intending to build a tower, sitteth not down first, and counteth the cost, whether he have sufficient to finish it?\wj* 
\v 29 \wj Lest haply, after he hath laid the foundation, and is not able to finish it, all that behold it begin to mock him,\wj* 
\v 30 \wj Saying, This man began to build, and was not able to finish.\wj* 
\v 31 \wj Or what king, going to make war against another king, sitteth not down first, and consulteth whether he be able with ten thousand to meet him that cometh against him with twenty thousand?\wj* 
\v 32 \wj Or else, while the other is yet a great way off, he sendeth an ambassage, and desireth conditions of peace.\wj* 
\v 33 \wj So likewise, whosoever he be of you that forsaketh not all that he hath, he cannot be my disciple.\wj* 
\p
\v 34 \wj Salt is good: but if the salt have lost his savour, wherewith shall it be seasoned?\wj* 
\v 35 \wj It is neither fit for the land, nor yet for the dunghill; but men cast it out. He that hath ears to hear, let him hear.\wj* 
\c 15
\p 
\v 1 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [drew near]{strong=“G1448” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 3”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 4”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Npm\sc* 5”} [the publicans]{strong=“G3588 G5057” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 6 7”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [sinners]{strong=“G268” x-morph=“robinson: A-\sc Npm\sc* 10”} [for to hear]{strong=“G191” x-morph=“robinson: V-\sc Pan\sc* 11”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 12”}. 
\v 2 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [the Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [scribes]{strong=“G3588 G1122” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 6 7”} [murmured]{strong=“G1234” x-morph=“robinson: V-\sc Iai\sc*-3P 2”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 8”}, [This man]{strong=“G3778” x-morph=“robinson: D-\sc Nsm\sc* 10”} [receiveth]{strong=“G4327” x-morph=“robinson: V-\sc Pni\sc*-3S 12”} [sinners]{strong=“G268” x-morph=“robinson: A-\sc Apm\sc* 11”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 13”} [eateth]{strong=“G4906” x-morph=“robinson: V-\sc Pai\sc*-3S 14”} [with them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 15”}. 
\p
\v 3 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he spake]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [this]{strong=“G3778” x-morph=“robinson: D-\sc Asf\sc* 7”} [parable]{strong=“G3588 G3850” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 5 6”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 4”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 8”}, 
\v 4 \wj What man of you, having an hundred sheep, if he lose one of them, doth not leave the ninety and nine in the wilderness, and go after that which is lost, until he find it?\wj* 
\v 5 \wj And when he hath found it, he layeth it on his shoulders, rejoicing.\wj* 
\v 6 \wj And when he cometh home, he calleth together his friends and neighbours, saying unto them, Rejoice with me; for I have found my sheep which was lost.\wj* 
\v 7 \wj I say unto you, that likewise joy shall be in heaven over one sinner that repenteth, more than over ninety and nine just persons, which need no repentance.\wj* 
\p
\v 8 \wj Either what woman having ten pieces of silver, if she lose one piece, doth not light a candle, and sweep the house, and seek diligently till she find it?\wj* 
\v 9 \wj And when she hath found it, she calleth her friends and her neighbours together, saying, Rejoice with me; for I have found the piece which I had lost.\wj* 
\v 10 \wj Likewise, I say unto you, there is joy in the presence of the angels of God over one sinner that repenteth.\wj* 
\p
\v 11 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”}, \wj A certain man had two sons:\wj* 
\v 12 \wj And the younger of them said to his father, Father, give me the portion of goods that falleth to me. And he divided unto them his living.\wj* 
\v 13 \wj And not many days after the younger son gathered all together, and took his journey into a far country, and there wasted his substance with riotous living.\wj* 
\v 14 \wj And when he had spent all, there arose a mighty famine in that land; and he began to be in want.\wj* 
\v 15 \wj And he went and joined himself to a citizen of that country; and he sent him into his fields to feed swine.\wj* 
\v 16 \wj And he would fain have filled his belly with the husks that the swine did eat: and no man gave unto him.\wj* 
\v 17 \wj And when he came to himself, he said, How many hired servants of my father’s have bread enough and to spare, and I perish with hunger!\wj* 
\v 18 \wj I will arise and go to my father, and will say unto him, Father, I have sinned against heaven, and before thee,\wj* 
\v 19 \wj And am no more worthy to be called thy son: make me as one of thy hired servants.\wj* 
\v 20 \wj And he arose, and came to his father. But when he was yet a great way off, his father saw him, and had compassion, and ran, and fell on his neck, and kissed him.\wj* 
\v 21 \wj And the son said unto him, Father, I have sinned against heaven, and in thy sight, and am no more worthy to be called thy son.\wj* 
\v 22 \wj But the father said to his servants, Bring forth the best robe, and put it on him; and put a ring on his hand, and shoes on his feet:\wj* 
\v 23 \wj And bring hither the fatted calf, and kill it; and let us eat, and be merry:\wj* 
\v 24 \wj For this my son was dead, and is alive again; he was lost, and is found. And they began to be merry.\wj* 
\v 25 \wj Now his elder son was in the field: and as he came and drew nigh to the house, he heard musick and dancing.\wj* 
\v 26 \wj And he called one of the servants, and asked what these things meant.\wj* 
\v 27 \wj And he said unto him, Thy brother is come; and thy father hath killed the fatted calf, because he hath received him safe and sound.\wj* 
\v 28 \wj And he was angry, and would not go in: therefore came his father out, and intreated him.\wj* 
\v 29 \wj And he answering said to his father, Lo, these many years do I serve thee, neither transgressed I at any time thy commandment: and yet thou never gavest me a kid, that I might make merry with my friends:\wj* 
\v 30 \wj But as soon as this thy son was come, which hath devoured thy living with harlots, thou hast killed for him the fatted calf.\wj* 
\v 31 \wj And he said unto him, Son, thou art ever with me, and all that I have is thine.\wj* 
\v 32 \wj It was meet that we should make merry, and be glad: for this thy brother was dead, and is alive again; and was lost, and is found.\wj* 
\c 16
\p 
\v 1 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 1”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 3”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 4”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 7”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 5 6”}, \wj There was a certain rich man, which had a steward; and the same was accused unto him that he had wasted his goods.\wj* 
\v 2 \wj And he called him, and said unto him, How is it that I hear this of thee? give an account of thy stewardship; for thou mayest be no longer steward.\wj* 
\v 3 \wj Then the steward said within himself, What shall I do? for my lord taketh away from me the stewardship: I cannot dig; to beg I am ashamed.\wj* 
\v 4 \wj I am resolved what to do, that, when I am put out of the stewardship, they may receive me into their houses.\wj* 
\v 5 \wj So he called every one of his lord’s debtors unto him, and said unto the first, How much owest thou unto my lord?\wj* 
\v 6 \wj And he said, An hundred measures of oil. And he said unto him, Take thy bill, and sit down quickly, and write fifty.\wj* 
\v 7 \wj Then said he to another, And how much owest thou? And he said, An hundred measures of wheat. And he said unto him, Take thy bill, and write fourscore.\wj* 
\v 8 \wj And the lord commended the unjust steward, because he had done wisely: for the children of this world are in their generation wiser than the children of light.\wj* 
\v 9 \wj And I say unto you, Make to yourselves friends of the mammon of unrighteousness; that, when ye fail, they may receive you into everlasting habitations.\wj* 
\v 10 \wj He that is faithful in that which is least is faithful also in much: and he that is unjust in the least is unjust also in much.\wj* 
\v 11 \wj If therefore ye have not been faithful in the unrighteous mammon, who will commit to your trust the true riches?\wj* 
\v 12 \wj And if ye have not been faithful in that which is another man’s, who shall give you that which is your own?\wj* 
\p
\v 13 \wj No servant can serve two masters: for either he will hate the one, and love the other; or else he will hold to the one, and despise the other. Ye cannot serve God and mammon.\wj* 
\v 14 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [the Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 6 7”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”}, [who were]{strong=“G5225” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 9”} [covetous]{strong=“G5366” x-morph=“robinson: A-\sc Npm\sc* 8”}, [heard]{strong=“G191” x-morph=“robinson: V-\sc Iai\sc*-3P 1”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Apn\sc* 4”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 3”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [they derided]{strong=“G1592” x-morph=“robinson: V-\sc Iai\sc*-3P 11”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 12”}. 
\v 15 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj Ye are they which justify yourselves before men; but God knoweth your hearts: for that which is highly esteemed among men is abomination in the sight of God.\wj* 
\v 16 \wj The law and the prophets were until John: since that time the kingdom of God is preached, and every man presseth into it.\wj* 
\v 17 \wj And it is easier for heaven and earth to pass, than one tittle of the law to fail.\wj* 
\v 18 \wj Whosoever putteth away his wife, and marrieth another, committeth adultery: and whosoever marrieth her that is put away from her husband committeth adultery.\wj* 
\p
\v 19 \wj There was a certain rich man, which was clothed in purple and fine linen, and fared sumptuously every day:\wj* 
\v 20 \wj And there was a certain beggar named Lazarus, which was laid at his gate, full of sores,\wj* 
\v 21 \wj And desiring to be fed with the crumbs which fell from the rich man’s table: moreover the dogs came and licked his sores.\wj* 
\v 22 \wj And it came to pass, that the beggar died, and was carried by the angels into Abraham’s bosom: the rich man also died, and was buried;\wj* 
\v 23 \wj And in hell he lift up his eyes, being in torments, and seeth Abraham afar off, and Lazarus in his bosom.\wj* 
\v 24 \wj And he cried and said, Father Abraham, have mercy on me, and send Lazarus, that he may dip the tip of his finger in water, and cool my tongue; for I am tormented in this flame.\wj* 
\v 25 \wj But Abraham said, Son, remember that thou in thy lifetime receivedst thy good things, and likewise Lazarus evil things: but now he is comforted, and thou art tormented.\wj* 
\v 26 \wj And beside all this, between us and you there is a great gulf fixed: so that they which would pass from hence to you cannot; neither can they pass to us, that would come from thence.\wj* 
\v 27 \wj Then he said, I pray thee therefore, father, that thou wouldest send him to my father’s house:\wj* 
\v 28 \wj For I have five brethren; that he may testify unto them, lest they also come into this place of torment.\wj* 
\v 29 \wj Abraham saith unto him, They have Moses and the prophets; let them hear them.\wj* 
\v 30 \wj And he said, Nay, father Abraham: but if one went unto them from the dead, they will repent.\wj* 
\v 31 \wj And he said unto him, If they hear not Moses and the prophets, neither will they be persuaded, though one rose from the dead.\wj* 
\c 17
\p 
\v 1 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [said he]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [the disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 4 5”}, \wj It is impossible but that offences will come: but woe unto him, through whom they come!\wj* 
\v 2 \wj It were better for him that a millstone were hanged about his neck, and he cast into the sea, than that he should offend one of these little ones.\wj* 
\p
\v 3 \wj Take heed to yourselves: If thy brother trespass against thee, rebuke him; and if he repent, forgive him.\wj* 
\v 4 \wj And if he trespass against thee seven times in a day, and seven times in a day turn again to thee, saying, I repent; thou shalt forgive him.\wj* 
\v 5 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [the apostles]{strong=“G3588 G652” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 2”} [unto the Lord]{strong=“G3588 G2962” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 5 6”}, [Increase]{strong=“G4369” x-morph=“robinson: V-2\sc Aam\sc*-2S 7”} [our]{strong=“G2254” x-morph=“robinson: P-1\sc Dp\sc* 8”} [faith]{strong=“G4102” x-morph=“robinson: N-\sc Asf\sc* 9”}. 
\v 6 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [the Lord]{strong=“G3588 G2962” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”}, \wj If ye had faith as a grain of mustard seed, ye might say unto this sycamine tree, Be thou plucked up by the root, and be thou planted in the sea; and it should obey you.\wj* 
\v 7 \wj But which of you, having a servant plowing or feeding cattle, will say unto him by and by, when he is come from the field, Go and sit down to meat?\wj* 
\v 8 \wj And will not rather say unto him, Make ready wherewith I may sup, and gird thyself, and serve me, till I have eaten and drunken; and afterward thou shalt eat and drink?\wj* 
\v 9 \wj Doth he thank that servant because he did the things that were commanded him? I trow not.\wj* 
\v 10 \wj So likewise ye, when ye shall have done all those things which are commanded you, say, We are unprofitable servants: we have done that which was our duty to do.\wj* 
\p
\v 11 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [it came to pass]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 2”}, [as]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 3”} [he]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 6”} [went]{strong=“G4198” x-morph=“robinson: V-\sc Pnn\sc* 5”} [to]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 7”} [Jerusalem]{strong=“G2419” x-morph=“robinson: N-\sc Pri\sc* 8”}, [that]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [he]{strong=“G846” x-morph=“robinson: P-\sc Nsm\sc* 10”} [passed]{strong=“G1330” x-morph=“robinson: V-\sc Ini\sc*-3S 11”} [through]{strong=“G1223” x-morph=“robinson: \sc Prep\sc* 12”} [the midst]{strong=“G3319” x-morph=“robinson: A-\sc Gsn\sc* 13”} [of Samaria]{strong=“G4540” x-morph=“robinson: N-\sc Gsf\sc* 14”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 15”} [Galilee]{strong=“G1056” x-morph=“robinson: N-\sc Gsf\sc* 16”}. 
\v 12 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [as he]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 3”} [entered]{strong=“G1525” x-morph=“robinson: V-\sc Pnp\sc*-\sc Gsm\sc* 2”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 4”} [a certain]{strong=“G5100” x-morph=“robinson: X-\sc Asf\sc* 5”} [village]{strong=“G2968” x-morph=“robinson: N-\sc Asf\sc* 6”}, [there met]{strong=“G528” x-morph=“robinson: V-\sc Aai\sc*-3P 7”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 8”} [ten]{strong=“G1176” x-morph=“robinson: A-\sc Nui\sc* 9”} [men]{strong=“G435” x-morph=“robinson: N-\sc Npm\sc* 11”} [that were lepers]{strong=“G3015” x-morph=“robinson: A-\sc Npm\sc* 10”}, [which]{strong=“G3739” x-morph=“robinson: R-\sc Npm\sc* 12”} [stood]{strong=“G2476” x-morph=“robinson: V-2\sc Aai\sc*-3P 13”} [afar off]{strong=“G4207” x-morph=“robinson: \sc Adv\sc* 14”}: 
\v 13 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they]{strong=“G846” x-morph=“robinson: P-\sc Npm\sc* 2”} [lifted up]{strong=“G142” x-morph=“robinson: V-\sc Aai\sc*-3P 3”} their [voices]{strong=“G5456” x-morph=“robinson: N-\sc Asf\sc* 4”}, [and said]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 5”}, [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Vsm\sc* 6”}, [Master]{strong=“G1988” x-morph=“robinson: N-\sc Vsm\sc* 7”}, [have mercy]{strong=“G1653” x-morph=“robinson: V-\sc Aam\sc*-2S 8”} [on us]{strong=“G2248” x-morph=“robinson: P-1\sc Ap\sc* 9”}. 
\v 14 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when he saw]{strong=“G1492” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”} them, [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 4”}, \wj Go shew yourselves unto the priests.\wj* [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [it came to pass, that]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 11”}, [as]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 12”} [they went]{strong=“G5217” x-morph=“robinson: V-\sc Pan\sc* 14”}, [they]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 15”} [were cleansed]{strong=“G2511” x-morph=“robinson: V-\sc Api\sc*-3P 16”}. 
\v 15 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [one]{strong=“G1520” x-morph=“robinson: A-\sc Nsm\sc* 1”} [of]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 3”} [them]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 4”}, [when he saw]{strong=“G1492” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 5”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 6”} [he was healed]{strong=“G2390” x-morph=“robinson: V-\sc Api\sc*-3S 7”}, [turned back]{strong=“G5290” x-morph=“robinson: V-\sc Aai\sc*-3S 8”}, [and with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 9”} [a loud]{strong=“G3173” x-morph=“robinson: A-\sc Gsf\sc* 11”} [voice]{strong=“G5456” x-morph=“robinson: N-\sc Gsf\sc* 10”} [glorified]{strong=“G1392” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 12”} [God]{strong=“G3588 G2316” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 13 14”}, 
\v 16 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [fell down]{strong=“G4098” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”} [on]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 3”} his [face]{strong=“G4383” x-morph=“robinson: N-\sc Asn\sc* 4”} [at]{strong=“G3844” x-morph=“robinson: \sc Prep\sc* 5”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 8”} [feet]{strong=“G3588 G4228” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 6 7”}, [giving]{strong=“G2168” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 9”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 10”} [thanks]{strong=“G2168” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 9”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [he]{strong=“G846” x-morph=“robinson: P-\sc Nsm\sc* 12”} [was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 13”} [a Samaritan]{strong=“G4541” x-morph=“robinson: N-\sc Nsm\sc* 14”}. 
\v 17 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [answering]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 1”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”}, \wj Were there not ten cleansed? but where are the nine?\wj* 
\v 18 \wj There are not found that returned to give glory to God, save this stranger.\wj* 
\v 19 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”}, \wj Arise, go thy way: thy faith hath made thee whole.\wj* 
\p
\v 20 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [when he was demanded]{strong=“G1905” x-morph=“robinson: V-\sc App\sc*-\sc Nsm\sc* 1”} [of]{strong=“G5259” x-morph=“robinson: \sc Prep\sc* 3”} [the Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 4 5”}, [when]{strong=“G4219” x-morph=“robinson: \sc Prt\sc*-I 6”} [the kingdom]{strong=“G3588 G932” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 8 9”} [of God]{strong=“G3588 G2316” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 10 11”} [should come]{strong=“G2064” x-morph=“robinson: V-\sc Pni\sc*-3S 7”}, [he answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 12”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 13”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 15”}, \wj The kingdom of God cometh not with observation:\wj* 
\v 21 \wj Neither shall they say, Lo here! or, lo there! for, behold, the kingdom of God is within you.\wj* 
\v 22 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [the disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 4 5”}, \wj The days will come, when ye shall desire to see one of the days of the Son of man, and ye shall not see it.\wj* 
\v 23 \wj And they shall say to you, See here; or, see there: go not after them, nor follow them.\wj* 
\v 24 \wj For as the lightning, that lighteneth out of the one part under heaven, shineth unto the other part under heaven; so shall also the Son of man be in his day.\wj* 
\v 25 \wj But first must he suffer many things, and be rejected of this generation.\wj* 
\v 26 \wj And as it was in the days of Noe, so shall it be also in the days of the Son of man.\wj* 
\v 27 \wj They did eat, they drank, they married wives, they were given in marriage, until the day that Noe entered into the ark, and the flood came, and destroyed them all.\wj* 
\v 28 \wj Likewise also as it was in the days of Lot; they did eat, they drank, they bought, they sold, they planted, they builded;\wj* 
\v 29 \wj But the same day that Lot went out of Sodom it rained fire and brimstone from heaven, and destroyed them all.\wj* 
\v 30 \wj Even thus shall it be in the day when the Son of man is revealed.\wj* 
\v 31 \wj In that day, he which shall be upon the housetop, and his stuff in the house, let him not come down to take it away: and he that is in the field, let him likewise not return back.\wj* 
\v 32 \wj Remember Lot’s wife.\wj* 
\v 33 \wj Whosoever shall seek to save his life shall lose it; and whosoever shall lose his life shall preserve it.\wj* 
\v 34 \wj I tell you, in that night there shall be two men in one bed; the one shall be taken, and the other shall be left.\wj* 
\v 35 \wj Two women shall be grinding together; the one shall be taken, and the other left.\wj* 
\v 36 \wj Two men shall be in the field; the one shall be taken, and the other left.\wj* 
\v 37 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Npm\sc* 2”} [and said]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3P 3”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 4”}, [Where]{strong=“G4226” x-morph=“robinson: \sc Prt\sc*-I 5”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 6”}? [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 8”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 9”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 10”}, \wj Wheresoever the body is, thither will the eagles be gathered together.\wj* 
\c 18
\p 
\v 1 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he spake]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 1”} [a parable]{strong=“G3850” x-morph=“robinson: N-\sc Asf\sc* 4”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”} to this end, [that men ought]{strong=“G1163” x-morph=“robinson: V-\sc Pqn\sc* 8”} [always]{strong=“G3842” x-morph=“robinson: \sc Adv\sc* 9”} [to pray]{strong=“G4336” x-morph=“robinson: V-\sc Pnn\sc* 10”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [not]{strong=“G3361” x-morph=“robinson: \sc Prt\sc*-N 12”} [to faint]{strong=“G1573” x-morph=“robinson: V-\sc Pan\sc* 13”}; 
\v 2 [Saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 1”}, \wj There was in a city a judge, which feared not God, neither regarded man:\wj* 
\v 3 \wj And there was a widow in that city; and she came unto him, saying, Avenge me of mine adversary.\wj* 
\v 4 \wj And he would not for a while: but afterward he said within himself, Though I fear not God, nor regard man;\wj* 
\v 5 \wj Yet because this widow troubleth me, I will avenge her, lest by her continual coming she weary me.\wj* 
\v 6 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [the Lord]{strong=“G3588 G2962” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”}, \wj Hear what the unjust judge saith.\wj* 
\v 7 \wj And shall not God avenge his own elect, which cry day and night unto him, though he bear long with them?\wj* 
\v 8 \wj I tell you that he will avenge them speedily. Nevertheless when the Son of man cometh, shall he find faith on the earth?\wj* 
\v 9 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he spake]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [this]{strong=“G3778” x-morph=“robinson: D-\sc Asf\sc* 19”} [parable]{strong=“G3588 G3850” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 17 18”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 4”} [certain]{strong=“G5100” x-morph=“robinson: X-\sc Apm\sc* 5”} [which]{strong=“G3588” x-morph=“robinson: T-\sc Apm\sc* 6”} [trusted]{strong=“G3982” x-morph=“robinson: V-2\sc Rap\sc*-\sc Apm\sc* 7”} [in]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 8”} [themselves]{strong=“G1438” x-morph=“robinson: F-3\sc Dpm\sc* 9”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 10”} [they were]{strong=“G1526” x-morph=“robinson: V-\sc Pxi\sc*-3P 11”} [righteous]{strong=“G1342” x-morph=“robinson: A-\sc Npm\sc* 12”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 13”} [despised]{strong=“G1848” x-morph=“robinson: V-\sc Pap\sc*-\sc Apm\sc* 14”} [others]{strong=“G3062” x-morph=“robinson: A-\sc Apm\sc* 16”}: 
\v 10 \wj Two men went up into the temple to pray; the one a Pharisee, and the other a publican.\wj* 
\v 11 \wj The Pharisee stood and prayed thus with himself, God, I thank thee, that I am not as other men are, extortioners, unjust, adulterers, or even as this publican.\wj* 
\v 12 \wj I fast twice in the week, I give tithes of all that I possess.\wj* 
\v 13 \wj And the publican, standing afar off, would not lift up so much as his eyes unto heaven, but smote upon his breast, saying, God be merciful to me a sinner.\wj* 
\v 14 \wj I tell you, this man went down to his house justified rather than the other: for every one that exalteth himself shall be abased; and he that humbleth himself shall be exalted.\wj* 
\v 15 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [they brought]{strong=“G4374” x-morph=“robinson: V-\sc Iai\sc*-3P 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 4”} [infants]{strong=“G3588 G1025” x-morph=“robinson: T-\sc Apn\sc* robinson: N-\sc Apn\sc* 5 6”}, [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 7”} [he would touch]{strong=“G680” x-morph=“robinson: V-\sc Pms\sc*-3S 9”} [them]{strong=“G846” x-morph=“robinson: P-\sc Gpn\sc* 8”}: [but when]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 11”} his [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 12 13”} [saw]{strong=“G1492” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 10”} it, [they rebuked]{strong=“G2008” x-morph=“robinson: V-\sc Aai\sc*-3P 14”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 15”}. 
\v 16 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 3”} [called]{strong=“G4341” x-morph=“robinson: V-\sc Adp\sc*-\sc Nsm\sc* 4”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apn\sc* 5”} unto him, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 6”}, \wj Suffer little children to come unto me, and forbid them not: for of such is the kingdom of God.\wj* 
\v 17 \wj Verily I say unto you, Whosoever shall not receive the kingdom of God as a little child shall in no wise enter therein.\wj* 
\v 18 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [a certain]{strong=“G5100” x-morph=“robinson: X-\sc Nsm\sc* 3”} [ruler]{strong=“G758” x-morph=“robinson: N-\sc Nsm\sc* 5”} [asked]{strong=“G1905” x-morph=“robinson: V-\sc Aai\sc*-3S 2”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 4”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 6”}, [Good]{strong=“G18” x-morph=“robinson: A-\sc Vsm\sc* 8”} [Master]{strong=“G1320” x-morph=“robinson: N-\sc Vsm\sc* 7”}, [what]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 9”} [shall I do]{strong=“G4160” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 10”} [to inherit]{strong=“G2816” x-morph=“robinson: V-\sc Fai\sc*-1S 13”} [eternal]{strong=“G166” x-morph=“robinson: A-\sc Asf\sc* 12”} [life]{strong=“G2222” x-morph=“robinson: N-\sc Asf\sc* 11”}? 
\v 19 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”}, \wj Why callest thou me good? none is good, save one, that is, God.\wj* 
\v 20 \wj Thou knowest the commandments, Do not commit adultery, Do not kill, Do not steal, Do not bear false witness, Honour thy father and thy mother.\wj* 
\v 21 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”}, [All]{strong=“G3956” x-morph=“robinson: A-\sc Apn\sc* 5”} [these]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 4”} [have I kept]{strong=“G5442” x-morph=“robinson: V-\sc Ami\sc*-1S 6”} [from]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 7”} [my]{strong=“G3450” x-morph=“robinson: P-1\sc Gs\sc* 9”} [youth up]{strong=“G3503” x-morph=“robinson: N-\sc Gsf\sc* 8”}. 
