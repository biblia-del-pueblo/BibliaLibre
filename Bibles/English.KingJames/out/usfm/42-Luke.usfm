\v 22 [Then]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [answering]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 2”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 6”}, \wj Go your way, and tell John what things ye have seen and heard; how that the blind see, the lame walk, the lepers are cleansed, the deaf hear, the dead are raised, to the poor the gospel is preached.\wj* 
\v 23 \wj And blessed is he, whosoever shall not be offended in me.\wj* 
\p
\v 24 [And when]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [the messengers]{strong=“G3588 G32” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 3 4”} [of John]{strong=“G2491” x-morph=“robinson: N-\sc Gsm\sc* 5”} [were departed]{strong=“G565” x-morph=“robinson: V-2\sc Aap\sc*-\sc Gpm\sc* 1”}, [he began]{strong=“G756” x-morph=“robinson: V-\sc Adi\sc*-3S 6”} [to speak]{strong=“G3004” x-morph=“robinson: V-\sc Pan\sc* 7”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 8”} [the people]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 9 10”} [concerning]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 11”} [John]{strong=“G2491” x-morph=“robinson: N-\sc Gsm\sc* 12”}, \wj What went ye out into the wilderness for to see? A reed shaken with the wind?\wj* 
\v 25 \wj But what went ye out for to see? A man clothed in soft raiment? Behold, they which are gorgeously apparelled, and live delicately, are in kings’ courts.\wj* 
\v 26 \wj But what went ye out for to see? A prophet? Yea, I say unto you, and much more than a prophet.\wj* 
\v 27 \wj This is he, of whom it is written, Behold, I send my messenger before thy face, which shall prepare thy way before thee.\wj* 
\v 28 \wj For I say unto you, Among those that are born of women there is not a greater prophet than John the Baptist: but he that is least in the kingdom of God is greater than he.\wj* 
\v 29 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Nsm\sc* 2”} [the people]{strong=“G3588 G2992” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [that heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 5”} him, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [the publicans]{strong=“G3588 G5057” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 7 8”}, [justified]{strong=“G1344” x-morph=“robinson: V-\sc Aai\sc*-3P 9”} [God]{strong=“G3588 G2316” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 10 11”}, [being baptized]{strong=“G907” x-morph=“robinson: V-\sc App\sc*-\sc Npm\sc* 12”} [with the baptism]{strong=“G3588 G908” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 13 14”} [of John]{strong=“G2491” x-morph=“robinson: N-\sc Gsm\sc* 15”}. 
