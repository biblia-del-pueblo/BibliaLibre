\p
\v 27 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [after]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 2”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 3”} [he went forth]{strong=“G1831” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [saw]{strong=“G2300” x-morph=“robinson: V-\sc Adi\sc*-3S 6”} [a publican]{strong=“G5057” x-morph=“robinson: N-\sc Asm\sc* 7”}, [named]{strong=“G3686” x-morph=“robinson: N-\sc Dsn\sc* 8”} [Levi]{strong=“G3018” x-morph=“robinson: N-\sc Asm\sc* 9”}, [sitting]{strong=“G2521” x-morph=“robinson: V-\sc Pnp\sc*-\sc Asm\sc* 10”} [at]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 11”} [the receipt of custom]{strong=“G3588 G5058” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 12 13”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 15”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 16”}, \wj Follow me.\wj* 
\v 28 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he left]{strong=“G2641” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”} [all]{strong=“G537” x-morph=“robinson: A-\sc Apn\sc* 3”}, [rose up]{strong=“G450” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 4”}, [and followed]{strong=“G190” x-morph=“robinson: V-\sc Aai\sc*-3S 5”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 6”}. 
\v 29 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Levi]{strong=“G3588 G3018” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [made]{strong=“G4160” x-morph=“robinson: V-\sc Aai\sc*-3S 2”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 7”} [a great]{strong=“G3173” x-morph=“robinson: A-\sc Asf\sc* 4”} [feast]{strong=“G1403” x-morph=“robinson: N-\sc Asf\sc* 3”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 8”} [his own]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 11”} [house]{strong=“G3588 G3614” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 9 10”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”} [there was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 13”} [a great]{strong=“G4183” x-morph=“robinson: A-\sc Nsm\sc* 16”} [company]{strong=“G3793” x-morph=“robinson: N-\sc Nsm\sc* 14”} [of publicans]{strong=“G5057” x-morph=“robinson: N-\sc Gpm\sc* 15”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 17”} [of others]{strong=“G243” x-morph=“robinson: A-\sc Gpm\sc* 18”} [that]{strong=“G3739” x-morph=“robinson: R-\sc Npm\sc* 19”} [sat down]{strong=“G2621” x-morph=“robinson: V-\sc Pnp\sc*-\sc Npm\sc* 23”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 21”} [them]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 22”}. 
\v 30 [But]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [their]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 5”} [scribes]{strong=“G3588 G1122” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 7 8”} [murmured]{strong=“G1111” x-morph=“robinson: V-\sc Iai\sc*-3P 2”} [against]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 9”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 12”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 10 11”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 13”}, [Why]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 15”} [do ye eat]{strong=“G2068” x-morph=“robinson: V-\sc Pai\sc*-2P 20”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 21”} [drink]{strong=“G4095” x-morph=“robinson: V-\sc Pai\sc*-2P 22”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 16”} [publicans]{strong=“G5057” x-morph=“robinson: N-\sc Gpm\sc* 17”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 18”} [sinners]{strong=“G268” x-morph=“robinson: A-\sc Gpm\sc* 19”}? 
\v 31 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [answering]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 2”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 6”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 7”}, \wj They that are whole need not a physician; but they that are sick.\wj* 
\v 32 \wj I came not to call the righteous, but sinners to repentance.\wj* 
\p
\v 33 And [they said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 3”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 4”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 5”}, [Why do]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 7”} [the disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 8 9”} [of John]{strong=“G2491” x-morph=“robinson: N-\sc Gsm\sc* 10”} [fast]{strong=“G3522” x-morph=“robinson: V-\sc Pai\sc*-3P 11”} [often]{strong=“G4437” x-morph=“robinson: A-\sc Apn\sc* 12”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 13”} [make]{strong=“G4160” x-morph=“robinson: V-\sc Pmi\sc*-3P 15”} [prayers]{strong=“G1162” x-morph=“robinson: N-\sc Apf\sc* 14”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 17”} [likewise]{strong=“G3668” x-morph=“robinson: \sc Adv\sc* 16”} the disciples [of the Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 19 20”}; [but]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 22”} [thine]{strong=“G4674” x-morph=“robinson: S-2\sc Npm\sc* 23”} [eat]{strong=“G2068” x-morph=“robinson: V-\sc Pai\sc*-3P 24”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 25”} [drink]{strong=“G4095” x-morph=“robinson: V-\sc Pai\sc*-3P 26”}? 
\v 34 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 4”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 5”}, \wj Can ye make the children of the bridechamber fast, while the bridegroom is with them?\wj* 
\v 35 \wj But the days will come, when the bridegroom shall be taken away from them, and then shall they fast in those days.\wj* 
\p
\v 36 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he spake]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 1”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 3”} [a parable]{strong=“G3850” x-morph=“robinson: N-\sc Asf\sc* 4”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 5”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 6”}; \wj No man putteth a piece of a new garment upon an old; if otherwise, then both the new maketh a rent, and the piece that was taken out of the new agreeth not with the old.\wj* 
\v 37 \wj And no man putteth new wine into old bottles; else the new wine will burst the bottles, and be spilled, and the bottles shall perish.\wj* 
\v 38 \wj But new wine must be put into new bottles; and both are preserved.\wj* 
\v 39 \wj No man also having drunk old wine straightway desireth new: for he saith, The old is better.\wj* 
\c 6
\p 
\v 1 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [it came to pass]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 1”} [on]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 3”} [the second]{strong=“G1207” x-morph=“robinson: A-\sc Dsn\sc* 5”} [sabbath]{strong=“G4521” x-morph=“robinson: N-\sc Dsn\sc* 4”} [after the first]{strong=“G1207” x-morph=“robinson: A-\sc Dsn\sc* 5”}, [that]{strong=“G1279” x-morph=“robinson: V-\sc Pnn\sc* 6”} [he]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 7”} [went]{strong=“G1279” x-morph=“robinson: V-\sc Pnn\sc* 6”} [through]{strong=“G1223” x-morph=“robinson: \sc Prep\sc* 8”} [the corn fields]{strong=“G4702” x-morph=“robinson: A-\sc Gpm\sc* 10”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 15”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 13 14”} [plucked]{strong=“G5089” x-morph=“robinson: V-\sc Iai\sc*-3P 12”} [the ears of corn]{strong=“G3588 G4719” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 16 17”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 18”} [did eat]{strong=“G2068” x-morph=“robinson: V-\sc Iai\sc*-3P 19”}, [rubbing]{strong=“G5597” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 20”} them [in]{strong=“G3588 G5495” x-morph=“robinson: T-\sc Dpf\sc* robinson: N-\sc Dpf\sc* 21 22”} their [hands]{strong=“G5495” x-morph=“robinson: N-\sc Dpf\sc* 22”}. 
