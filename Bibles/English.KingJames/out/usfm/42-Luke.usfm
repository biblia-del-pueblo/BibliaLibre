\v 24 \wj But that ye may know that the Son of man hath power upon earth to forgive sins,\wj* ([he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 16”} [unto the sick of the palsy]{strong=“G3886” x-morph=“robinson: V-\sc Rpp\sc*-\sc Dsm\sc* 18”},) \wj I say unto thee, Arise, and take up thy couch, and go into thine house.\wj* 
\v 25 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [immediately]{strong=“G3916” x-morph=“robinson: \sc Adv\sc* 2”} [he rose up]{strong=“G450” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 3”} [before]{strong=“G1799” x-morph=“robinson: \sc Adv\sc* 4”} [them]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 5”}, [and took]{strong=“G142” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 6”} [up]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 7”} [that]{strong=“G3739” x-morph=“robinson: R-\sc Dsn\sc* 8”} [whereon he lay]{strong=“G2621” x-morph=“robinson: V-\sc Ini\sc*-3S 9”}, [and departed]{strong=“G565” x-morph=“robinson: V-2\sc Aai\sc*-3S 10”} [to]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 11”} [his own]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 14”} [house]{strong=“G3588 G3624” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 12 13”}, [glorifying]{strong=“G1392” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 15”} [God]{strong=“G3588 G2316” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 16 17”}. 
