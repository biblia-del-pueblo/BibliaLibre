\p
\v 19 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [John]{strong=“G3588 G2491” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 8 9”} [calling]{strong=“G4341” x-morph=“robinson: V-\sc Adp\sc*-\sc Nsm\sc* 2”} unto him [two]{strong=“G1417” x-morph=“robinson: A-\sc Nui\sc* 3”} [of his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 7”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 5 6”} [sent]{strong=“G3992” x-morph=“robinson: V-\sc Aai\sc*-3S 10”} them [to]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 11”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 12 13”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 14”}, [Art]{strong=“G1488” x-morph=“robinson: V-\sc Pxi\sc*-2S 16”} [thou]{strong=“G4771” x-morph=“robinson: P-2\sc Ns\sc* 15”} [he that should come]{strong=“G2064” x-morph=“robinson: V-\sc Pnp\sc*-\sc Nsm\sc* 18”}? [or]{strong=“G2228” x-morph=“robinson: \sc Prt\sc* 19”} [look we]{strong=“G4328” x-morph=“robinson: V-\sc Pas\sc*-1P 21”} [for another]{strong=“G243” x-morph=“robinson: A-\sc Asm\sc* 20”}? 
