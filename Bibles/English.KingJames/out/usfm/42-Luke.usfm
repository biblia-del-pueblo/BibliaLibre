\v 42 [Saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 1”}, \wj If thou hadst known, even thou, at least in this thy day, the things which belong unto thy peace! but now they are hid from thine eyes.\wj* 
\v 43 \wj For the days shall come upon thee, that thine enemies shall cast a trench about thee, and compass thee round, and keep thee in on every side,\wj* 
\v 44 \wj And shall lay thee even with the ground, and thy children within thee; and they shall not leave in thee one stone upon another; because thou knewest not the time of thy visitation.\wj* 
\v 45 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he went]{strong=“G1525” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 3”} [the temple]{strong=“G3588 G2411” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 4 5”}, [and began]{strong=“G756” x-morph=“robinson: V-\sc Adi\sc*-3S 6”} [to cast out]{strong=“G1544” x-morph=“robinson: V-\sc Pan\sc* 7”} [them that]{strong=“G3588” x-morph=“robinson: T-\sc Apm\sc* 8”} [sold]{strong=“G4453” x-morph=“robinson: V-\sc Pap\sc*-\sc Apm\sc* 9”} [therein]{strong=“G846” x-morph=“robinson: P-\sc Dsn\sc* 11”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”} [them that bought]{strong=“G59” x-morph=“robinson: V-\sc Pap\sc*-\sc Apm\sc* 13”}; 
\v 46 [Saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 1”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 2”}, \wj It is written, My house is the house of prayer: but ye have made it a den of thieves.\wj* 
\v 47 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he taught]{strong=“G1321” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 3”} [daily]{strong=“G2250” x-morph=“robinson: N-\sc Asf\sc* 6”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 7”} [the temple]{strong=“G3588 G2411” x-morph=“robinson: T-\sc Dsn\sc* robinson: N-\sc Dsn\sc* 8 9”}. [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 11”} [the chief priests]{strong=“G749” x-morph=“robinson: N-\sc Npm\sc* 12”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 13”} [the scribes]{strong=“G3588 G1122” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 14 15”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 19”} [the chief]{strong=“G4413” x-morph=“robinson: A-\sc Npm\sc* 21”} [of the people]{strong=“G3588 G2992” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 22 23”} [sought]{strong=“G2212” x-morph=“robinson: V-\sc Iai\sc*-3P 16”} [to destroy]{strong=“G622” x-morph=“robinson: V-\sc Aan\sc* 18”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 17”}, 
\v 48 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [could]{strong=“G2147” x-morph=“robinson: V-\sc Iai\sc*-3P 3”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 2”} [find]{strong=“G2147” x-morph=“robinson: V-\sc Iai\sc*-3P 3”} [what]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 5”} [they might do]{strong=“G4160” x-morph=“robinson: V-\sc Aas\sc*-3P 6”}: [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 9”} [all]{strong=“G537” x-morph=“robinson: A-\sc Nsm\sc* 10”} [the people]{strong=“G3588 G2992” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 7 8”} [were very attentive]{strong=“G1582” x-morph=“robinson: V-\sc Imi\sc*-3S 11”} [to hear]{strong=“G191” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 13”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 12”}. 
\c 20
\p 
\v 1 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [it came to pass]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 2”}, that [on]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 3”} [one]{strong=“G1520” x-morph=“robinson: A-\sc Dsf\sc* 4”} [of those]{strong=“G1565” x-morph=“robinson: D-\sc Gpf\sc* 7”} [days]{strong=“G3588 G2250” x-morph=“robinson: T-\sc Gpf\sc* robinson: N-\sc Gpf\sc* 5 6”}, [as he]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 9”} [taught]{strong=“G1321” x-morph=“robinson: V-\sc Pap\sc*-\sc Gsm\sc* 8”} [the people]{strong=“G3588 G2992” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 10 11”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 12”} [the temple]{strong=“G3588 G2411” x-morph=“robinson: T-\sc Dsn\sc* robinson: N-\sc Dsn\sc* 13 14”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 15”} [preached the gospel]{strong=“G2097” x-morph=“robinson: V-\sc Pmp\sc*-\sc Gsm\sc* 16”}, [the chief priests]{strong=“G3588 G749” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 18 19”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 20”} [the scribes]{strong=“G3588 G1122” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 21 22”} [came upon]{strong=“G2186” x-morph=“robinson: V-2\sc Aai\sc*-3P 17”} him [with]{strong=“G4862” x-morph=“robinson: \sc Prep\sc* 23”} [the elders]{strong=“G4245” x-morph=“robinson: A-\sc Dpm\sc* 25”}, 
\v 2 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [spake]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 2”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 4”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 5”}, [Tell]{strong=“G2036” x-morph=“robinson: V-2\sc Aam\sc*-2S 6”} [us]{strong=“G2254” x-morph=“robinson: P-1\sc Dp\sc* 7”}, [by]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 8”} [what]{strong=“G4169” x-morph=“robinson: I-\sc Dsf\sc* 9”} [authority]{strong=“G1849” x-morph=“robinson: N-\sc Dsf\sc* 10”} [doest thou]{strong=“G4160” x-morph=“robinson: V-\sc Pai\sc*-2S 12”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 11”}? [or]{strong=“G2228” x-morph=“robinson: \sc Prt\sc* 13”} [who]{strong=“G5101” x-morph=“robinson: I-\sc Nsm\sc* 14”} [is]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 15”} [he that]{strong=“G3588” x-morph=“robinson: T-\sc Nsm\sc* 16”} [gave]{strong=“G1325” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 17”} [thee]{strong=“G4671” x-morph=“robinson: P-2\sc Ds\sc* 18”} [this]{strong=“G3778” x-morph=“robinson: D-\sc Asf\sc* 21”} [authority]{strong=“G3588 G1849” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 19 20”}? 
\v 3 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 1”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 4”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 5”}, \wj I will also ask you one thing; and answer me:\wj* 
\v 4 \wj The baptism of John, was it from heaven, or of men?\wj* 
\v 5 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [they reasoned]{strong=“G4817” x-morph=“robinson: V-\sc Adi\sc*-3P 3”} [with]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 4”} [themselves]{strong=“G1438” x-morph=“robinson: F-3\sc Apm\sc* 5”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 6”}, [If]{strong=“G1437” x-morph=“robinson: \sc Cond\sc* 8”} [we shall say]{strong=“G2036” x-morph=“robinson: V-2\sc Aas\sc*-1P 9”}, [From]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 10”} [heaven]{strong=“G3772” x-morph=“robinson: N-\sc Gsm\sc* 11”}; [he will say]{strong=“G2046” x-morph=“robinson: V-\sc Fai\sc*-3S 12”}, [Why]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 14”} [then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 15”} [believed ye]{strong=“G4100” x-morph=“robinson: V-\sc Aai\sc*-2P 17”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 18”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 16”}? 
\v 6 [But and]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [if]{strong=“G1437” x-morph=“robinson: \sc Cond\sc* 1”} [we say]{strong=“G2036” x-morph=“robinson: V-2\sc Aas\sc*-1P 3”}, [Of]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 4”} [men]{strong=“G444” x-morph=“robinson: N-\sc Gpm\sc* 5”}; [all]{strong=“G3956” x-morph=“robinson: A-\sc Nsm\sc* 6”} [the people]{strong=“G3588 G2992” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 7 8”} [will stone]{strong=“G2642” x-morph=“robinson: V-\sc Fai\sc*-3S 9”} [us]{strong=“G2248” x-morph=“robinson: P-1\sc Ap\sc* 10”}: [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 12”} [they be]{strong=“G1511” x-morph=“robinson: V-\sc Pxn\sc* 16”} [persuaded that]{strong=“G3982” x-morph=“robinson: V-\sc Rpp\sc*-\sc Nsm\sc* 11”} [John]{strong=“G2491” x-morph=“robinson: N-\sc Asm\sc* 14”} [was]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 13”} [a prophet]{strong=“G4396” x-morph=“robinson: N-\sc Asm\sc* 15”}. 
\v 7 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3P 2”}, [that they could]{strong=“G1492” x-morph=“robinson: V-\sc Ran\sc* 4”} [not]{strong=“G3361” x-morph=“robinson: \sc Prt\sc*-N 3”} [tell]{strong=“G1492” x-morph=“robinson: V-\sc Ran\sc* 4”} [whence]{strong=“G4159” x-morph=“robinson: \sc Adv\sc*-I 5”} it was. 
\v 8 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 2 3”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}, \wj Neither tell I you by what authority I do these things.\wj* 
\v 9 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [began he]{strong=“G756” x-morph=“robinson: V-\sc Adi\sc*-3S 1”} [to speak]{strong=“G3004” x-morph=“robinson: V-\sc Pan\sc* 6”} [to]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [the people]{strong=“G3588 G2992” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 4 5”} [this]{strong=“G3778” x-morph=“robinson: D-\sc Asf\sc* 9”} [parable]{strong=“G3588 G3850” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 7 8”}; \wj A certain man planted a vineyard, and let it forth to husbandmen, and went into a far country for a long time.\wj* 
\v 10 \wj And at the season he sent a servant to the husbandmen, that they should give him of the fruit of the vineyard: but the husbandmen beat him, and sent him away empty.\wj* 
\v 11 \wj And again he sent another servant: and they beat him also, and entreated him shamefully, and sent him away empty.\wj* 
\v 12 \wj And again he sent a third: and they wounded him also, and cast him out.\wj* 
\v 13 \wj Then said the lord of the vineyard, What shall I do? I will send my beloved son: it may be they will reverence him when they see him.\wj* 
\v 14 \wj But when the husbandmen saw him, they reasoned among themselves, saying, This is the heir: come, let us kill him, that the inheritance may be ours.\wj* 
\v 15 \wj So they cast him out of the vineyard, and killed him. What therefore shall the lord of the vineyard do unto them?\wj* 
\v 16 \wj He shall come and destroy these husbandmen, and shall give the vineyard to others.\wj* [And when]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 13”} [they heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 12”} it, [they said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 14”}, [God forbid]{strong=“G1096” x-morph=“robinson: V-2\sc Ado\sc*-3S 16”}. 
\v 17 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he beheld]{strong=“G1689” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 3”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 4”}, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”}, \wj What is this then that is written, The stone which the builders rejected, the same is become the head of the corner?\wj* 
\v 18 \wj Whosoever shall fall upon that stone shall be broken; but on whomsoever it shall fall, it will grind him to powder.\wj* 
\p
\v 19 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [the chief priests]{strong=“G3588 G749” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [the scribes]{strong=“G3588 G1122” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 6 7”} [the same]{strong=“G846” x-morph=“robinson: P-\sc Dsf\sc* 14”} [hour]{strong=“G3588 G5610” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 15 16”} [sought]{strong=“G2212” x-morph=“robinson: V-\sc Aai\sc*-3P 2”} [to lay]{strong=“G1911” x-morph=“robinson: V-2\sc Aan\sc* 8”} [hands]{strong=“G3588 G5495” x-morph=“robinson: T-\sc Apf\sc* robinson: N-\sc Apf\sc* 11 12”} [on]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 9”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 10”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 17”} [they feared]{strong=“G5399” x-morph=“robinson: V-\sc Aoi\sc*-3P 18”} [the people]{strong=“G3588 G2992” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 19 20”}: [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 22”} [they perceived]{strong=“G1097” x-morph=“robinson: V-2\sc Aai\sc*-3P 21”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 23”} [he had spoken]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 29”} [this]{strong=“G3778” x-morph=“robinson: D-\sc Asf\sc* 28”} [parable]{strong=“G3588 G3850” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 26 27”} [against]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 24”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 25”}. 
\v 20 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they watched]{strong=“G3906” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 2”} him, [and sent forth]{strong=“G649” x-morph=“robinson: V-\sc Aai\sc*-3P 3”} [spies]{strong=“G1455” x-morph=“robinson: A-\sc Apm\sc* 4”}, [which should feign]{strong=“G5271” x-morph=“robinson: V-\sc Pnp\sc*-\sc Apm\sc* 5”} [themselves]{strong=“G1438” x-morph=“robinson: F-3\sc Apm\sc* 6”} [just men]{strong=“G1342” x-morph=“robinson: A-\sc Apm\sc* 7”}, [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 9”} [they might take hold]{strong=“G1949” x-morph=“robinson: V-2\sc Ads\sc*-3P 10”} [of his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 11”} [words]{strong=“G3056” x-morph=“robinson: N-\sc Gsm\sc* 12”}, [that so]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 9”} [they might deliver]{strong=“G3860” x-morph=“robinson: V-2\sc Aan\sc* 15”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 16”} [unto]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 13”} [the power]{strong=“G3588 G746” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 17 18”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 19”} [authority]{strong=“G3588 G1849” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 20 21”} [of the governor]{strong=“G3588 G2232” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 22 23”}. 
\v 21 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they asked]{strong=“G1905” x-morph=“robinson: V-\sc Aai\sc*-3P 2”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 3”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 4”}, [Master]{strong=“G1320” x-morph=“robinson: N-\sc Vsm\sc* 5”}, [we know]{strong=“G1492” x-morph=“robinson: V-\sc Rai\sc*-1P 6”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 7”} [thou sayest]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-2S 9”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [teachest]{strong=“G1321” x-morph=“robinson: V-\sc Pai\sc*-2S 11”} [rightly]{strong=“G3723” x-morph=“robinson: \sc Adv\sc* 8”}, [neither]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 13”} [acceptest thou]{strong=“G2983” x-morph=“robinson: V-\sc Pai\sc*-2S 14”} [the person]{strong=“G4383” x-morph=“robinson: N-\sc Asn\sc* 15”} of any, [but]{strong=“G235” x-morph=“robinson: \sc Conj\sc* 16”} [teachest]{strong=“G1321” x-morph=“robinson: V-\sc Pai\sc*-2S 23”} [the way]{strong=“G3588 G3598” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 19 20”} [of God]{strong=“G3588 G2316” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 21 22”} [truly]{strong=“G225” x-morph=“robinson: N-\sc Gsf\sc* 18”}: 
\v 22 [Is it lawful]{strong=“G1832” x-morph=“robinson: V-\sc Pqi\sc*-3S 1”} [for us]{strong=“G2254” x-morph=“robinson: P-1\sc Dp\sc* 2”} [to give]{strong=“G1325” x-morph=“robinson: V-2\sc Aan\sc* 5”} [tribute]{strong=“G5411” x-morph=“robinson: N-\sc Asm\sc* 4”} [unto Cæsar]{strong=“G2541” x-morph=“robinson: N-\sc Dsm\sc* 3”}, [or]{strong=“G2228” x-morph=“robinson: \sc Prt\sc* 6”} [no]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 7”}? 
\v 23 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he perceived]{strong=“G2657” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 1”} [their]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 3”} [craftiness]{strong=“G3588 G3834” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 4 5”}, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 6”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 7”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 8”}, \wj Why tempt ye me?\wj* 
\v 24 \wj Shew me a penny. Whose image and superscription hath it?\wj* [They answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Npm\sc* 9”} [and]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 10”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 11”}, [Cæsar’s]{strong=“G2541” x-morph=“robinson: N-\sc Gsm\sc* 12”}. 
\v 25 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 4”}, \wj Render therefore unto Cæsar the things which be Cæsar’s, and unto God the things which be God’s.\wj* 
\v 26 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they could]{strong=“G2480” x-morph=“robinson: V-\sc Aai\sc*-3P 3”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 2”} [take hold of]{strong=“G1949” x-morph=“robinson: V-2\sc Adn\sc* 4”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 5”} [words]{strong=“G4487” x-morph=“robinson: N-\sc Gsn\sc* 6”} [before]{strong=“G1726” x-morph=“robinson: \sc Adv\sc* 7”} [the people]{strong=“G3588 G2992” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 8 9”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [they marvelled]{strong=“G2296” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 11”} [at]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 12”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 15”} [answer]{strong=“G3588 G612” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 13 14”}, [and held their peace]{strong=“G4601” x-morph=“robinson: V-\sc Aai\sc*-3P 16”}. 
\p
\v 27 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [came to]{strong=“G4334” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 1”} him [certain]{strong=“G5100” x-morph=“robinson: X-\sc Npm\sc* 3”} [of the Sadducees]{strong=“G3588 G4523” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 4 5”}, [which]{strong=“G3588” x-morph=“robinson: T-\sc Npm\sc* 6”} [deny that]{strong=“G483” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 7”} [there is]{strong=“G1511” x-morph=“robinson: V-\sc Pxn\sc* 10”} [any resurrection]{strong=“G386” x-morph=“robinson: N-\sc Asf\sc* 8”}; [and they asked]{strong=“G1905” x-morph=“robinson: V-\sc Aai\sc*-3P 11”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 12”}, 
\v 28 [Saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 1”}, [Master]{strong=“G1320” x-morph=“robinson: N-\sc Vsm\sc* 2”}, [Moses]{strong=“G3475” x-morph=“robinson: N-\sc Nsm\sc* 3”} [wrote]{strong=“G1125” x-morph=“robinson: V-\sc Aai\sc*-3S 4”} [unto us]{strong=“G2254” x-morph=“robinson: P-1\sc Dp\sc* 5”}, [If]{strong=“G1437” x-morph=“robinson: \sc Cond\sc* 6”} [any man’s]{strong=“G5100” x-morph=“robinson: X-\sc Gsm\sc* 7”} [brother]{strong=“G80” x-morph=“robinson: N-\sc Nsm\sc* 8”} [die]{strong=“G599” x-morph=“robinson: V-2\sc Aas\sc*-3S 9”}, [having]{strong=“G2192” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 10”} [a wife]{strong=“G1135” x-morph=“robinson: N-\sc Asf\sc* 11”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”} [he]{strong=“G3778” x-morph=“robinson: D-\sc Nsm\sc* 13”} [die]{strong=“G599” x-morph=“robinson: V-2\sc Aas\sc*-3S 15”} [without children]{strong=“G815” x-morph=“robinson: A-\sc Nsm\sc* 14”}, [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 16”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 20”} [brother]{strong=“G3588 G80” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 18 19”} [should take]{strong=“G2983” x-morph=“robinson: V-2\sc Aas\sc*-3S 17”} [his wife]{strong=“G3588 G1135” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 21 22”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 23”} [raise up]{strong=“G1817” x-morph=“robinson: V-\sc Aas\sc*-3S 24”} [seed]{strong=“G4690” x-morph=“robinson: N-\sc Asn\sc* 25”} [unto his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 28”} [brother]{strong=“G3588 G80” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 26 27”}. 
\v 29 [There were]{strong=“G2258” x-morph=“robinson: V-IXI-3P 4”} [therefore]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [seven]{strong=“G2033” x-morph=“robinson: A-\sc Nui\sc* 1”} [brethren]{strong=“G80” x-morph=“robinson: N-\sc Npm\sc* 3”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [the first]{strong=“G4413” x-morph=“robinson: A-\sc Nsm\sc* 7”} [took]{strong=“G2983” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 8”} [a wife]{strong=“G1135” x-morph=“robinson: N-\sc Asf\sc* 9”}, [and died]{strong=“G599” x-morph=“robinson: V-2\sc Aai\sc*-3S 10”} [without children]{strong=“G815” x-morph=“robinson: A-\sc Nsm\sc* 11”}. 
\v 30 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [the second]{strong=“G1208” x-morph=“robinson: A-\sc Nsm\sc* 4”} [took]{strong=“G2983” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”} [her to wife]{strong=“G3588 G1135” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 5 6”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [he]{strong=“G3778” x-morph=“robinson: D-\sc Nsm\sc* 8”} [died]{strong=“G599” x-morph=“robinson: V-2\sc Aai\sc*-3S 9”} [childless]{strong=“G815” x-morph=“robinson: A-\sc Nsm\sc* 10”}. 
\v 31 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [the third]{strong=“G5154” x-morph=“robinson: A-\sc Nsm\sc* 3”} [took]{strong=“G2983” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} her; [and]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 7”} [in like manner]{strong=“G5615” x-morph=“robinson: \sc Adv\sc* 6”} [the seven]{strong=“G2033” x-morph=“robinson: A-\sc Nui\sc* 10”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”}: [and they left]{strong=“G2641” x-morph=“robinson: V-2\sc Aai\sc*-3P 12”} [no]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 11”} [children]{strong=“G5043” x-morph=“robinson: N-\sc Apn\sc* 13”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [died]{strong=“G599” x-morph=“robinson: V-2\sc Aai\sc*-3P 15”}. 
\v 32 [Last]{strong=“G5305” x-morph=“robinson: \sc Adv\sc* 1”} [of all]{strong=“G3956” x-morph=“robinson: A-\sc Gpn\sc* 3”} [the woman]{strong=“G3588 G1135” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 6 7”} [died]{strong=“G599” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”}. 
\v 33 [Therefore]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 3”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 1”} [the resurrection]{strong=“G386” x-morph=“robinson: N-\sc Dsf\sc* 4”} [whose]{strong=“G5101” x-morph=“robinson: I-\sc Gsm\sc* 5”} [wife]{strong=“G1135” x-morph=“robinson: N-\sc Nsf\sc* 8”} [of them]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 6”} [is she]{strong=“G1096” x-morph=“robinson: V-\sc Pni\sc*-3S 7”}? [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 10”} [seven]{strong=“G2033” x-morph=“robinson: A-\sc Nui\sc* 11”} [had]{strong=“G2192” x-morph=“robinson: V-2\sc Aai\sc*-3P 12”} [her]{strong=“G846” x-morph=“robinson: P-\sc Asf\sc* 13”} [to wife]{strong=“G1135” x-morph=“robinson: N-\sc Asf\sc* 14”}. 
\v 34 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [answering]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 2”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 4”}, \wj The children of this world marry, and are given in marriage:\wj* 
\v 35 \wj But they which shall be accounted worthy to obtain that world, and the resurrection from the dead, neither marry, nor are given in marriage:\wj* 
\v 36 \wj Neither can they die any more: for they are equal unto the angels; and are the children of God, being the children of the resurrection.\wj* 
\v 37 \wj Now that the dead are raised, even Moses shewed at the bush, when he calleth the Lord the God of Abraham, and the God of Isaac, and the God of Jacob.\wj* 
\v 38 \wj For he is not a God of the dead, but of the living: for all live unto him.\wj* 
\p
\v 39 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [certain]{strong=“G5100” x-morph=“robinson: X-\sc Npm\sc* 3”} [of the scribes]{strong=“G3588 G1122” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 4 5”} [answering]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Npm\sc* 1”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 6”}, [Master]{strong=“G1320” x-morph=“robinson: N-\sc Vsm\sc* 7”}, [thou hast]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-2S 9”} [well]{strong=“G2573” x-morph=“robinson: \sc Adv\sc* 8”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-2S 9”}. 
\v 40 [And after that]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [they durst]{strong=“G5111” x-morph=“robinson: V-\sc Iai\sc*-3P 3”} [not]{strong=“G3765” x-morph=“robinson: \sc Adv\sc* 1”} [ask]{strong=“G1905” x-morph=“robinson: V-\sc Pan\sc* 4”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 5”} [any]{strong=“G3762” x-morph=“robinson: A-\sc Asn\sc* 6”} question at all. 
\v 41 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 4”}, \wj How say they that Christ is David’s son?\wj* 
\v 42 \sc And David himself saith in the book of Psalms, The \wj Lord\sc* said unto my Lord, Sit thou on my right hand,\wj* 
\v 43 \wj Till I make thine enemies thy footstool.\wj* 
\v 44 \wj David therefore calleth him Lord, how is he then his son?\wj* 
\p
\v 45 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [in the audience]{strong=“G191” x-morph=“robinson: V-\sc Pap\sc*-\sc Gsm\sc* 1”} [of all]{strong=“G3956” x-morph=“robinson: A-\sc Gsm\sc* 3”} [the people]{strong=“G3588 G2992” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 4 5”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 6”} [unto his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 9”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 7 8”}, 
\v 46 \wj Beware of the scribes, which desire to walk in long robes, and love greetings in the markets, and the highest seats in the synagogues, and the chief rooms at feasts;\wj* 
\v 47 \wj Which devour widows’ houses, and for a shew make long prayers: the same shall receive greater damnation.\wj* 
\c 21
\p 
\v 1 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he looked up]{strong=“G308” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 1”}, [and saw]{strong=“G1492” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [the rich men]{strong=“G4145” x-morph=“robinson: A-\sc Apm\sc* 12”} [casting]{strong=“G906” x-morph=“robinson: V-\sc Pap\sc*-\sc Apm\sc* 5”} [their]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 8”} [gifts]{strong=“G3588 G1435” x-morph=“robinson: T-\sc Apn\sc* robinson: N-\sc Apn\sc* 6 7”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 9”} [the treasury]{strong=“G3588 G1049” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 10 11”}. 
\v 2 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he saw]{strong=“G1492” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 3”} [a certain]{strong=“G5100” x-morph=“robinson: X-\sc Asf\sc* 4”} [poor]{strong=“G3998” x-morph=“robinson: A-\sc Asf\sc* 6”} [widow]{strong=“G5503” x-morph=“robinson: N-\sc Asf\sc* 5”} [casting in]{strong=“G906” x-morph=“robinson: V-\sc Pap\sc*-\sc Asf\sc* 7”} [thither]{strong=“G1563” x-morph=“robinson: \sc Adv\sc* 8”} [two]{strong=“G1417” x-morph=“robinson: A-\sc Nui\sc* 9”} [mites]{strong=“G3016” x-morph=“robinson: N-\sc Apn\sc* 10”}. 
\v 3 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”}, \wj Of a truth I say unto you, that this poor widow hath cast in more than they all:\wj* 
\v 4 \wj For all these have of their abundance cast in unto the offerings of God: but she of her penury hath cast in all the living that she had.\wj* 
\p
\v 5 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [as some]{strong=“G5100” x-morph=“robinson: X-\sc Gpm\sc* 2”} [spake]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Gpm\sc* 3”} [of]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 4”} [the temple]{strong=“G3588 G2411” x-morph=“robinson: T-\sc Gsn\sc* robinson: N-\sc Gsn\sc* 5 6”}, [how]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 7”} [it was adorned]{strong=“G2885” x-morph=“robinson: V-\sc Rpi\sc*-3S 12”} [with goodly]{strong=“G2570” x-morph=“robinson: A-\sc Dpm\sc* 9”} [stones]{strong=“G3037” x-morph=“robinson: N-\sc Dpm\sc* 8”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [gifts]{strong=“G334” x-morph=“robinson: N-\sc Dpn\sc* 11”}, [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 13”}, 
\v 6 \wj As for these things which ye behold, the days will come, in the which there shall not be left one stone upon another, that shall not be thrown down.\wj* 
\v 7 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [they asked]{strong=“G1905” x-morph=“robinson: V-\sc Aai\sc*-3P 1”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 3”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 4”}, [Master]{strong=“G1320” x-morph=“robinson: N-\sc Vsm\sc* 5”}, [but]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 7”} [when]{strong=“G4219” x-morph=“robinson: \sc Prt\sc*-I 6”} [shall]{strong=“G2071” x-morph=“robinson: V-\sc Fxi\sc*-3S 9”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Npn\sc* 8”} [be]{strong=“G2071” x-morph=“robinson: V-\sc Fxi\sc*-3S 9”}? [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [what]{strong=“G5101” x-morph=“robinson: I-\sc Nsn\sc* 11”} [sign]{strong=“G3588 G4592” x-morph=“robinson: T-\sc Nsn\sc* robinson: N-\sc Nsn\sc* 12 13”} will there be [when]{strong=“G3752” x-morph=“robinson: \sc Conj\sc* 14”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Npn\sc* 16”} [shall come to pass]{strong=“G1096” x-morph=“robinson: V-\sc Pnn\sc* 17”}? 
\v 8 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”}, \wj Take heed that ye be not deceived: for many shall come in my name, saying, I am Christ; and the time draweth near: go ye not therefore after them.\wj* 
\v 9 \wj But when ye shall hear of wars and commotions, be not terrified: for these things must first come to pass; but the end is not by and by.\wj* 
\v 10 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [said he]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj Nation shall rise against nation, and kingdom against kingdom:\wj* 
\v 11 \wj And great earthquakes shall be in divers places, and famines, and pestilences; and fearful sights and great signs shall there be from heaven.\wj* 
\v 12 \wj But before all these, they shall lay their hands on you, and persecute you, delivering you up to the synagogues, and into prisons, being brought before kings and rulers for my name’s sake.\wj* 
\v 13 \wj And it shall turn to you for a testimony.\wj* 
\v 14 \wj Settle it therefore in your hearts, not to meditate before what ye shall answer:\wj* 
\v 15 \wj For I will give you a mouth and wisdom, which all your adversaries shall not be able to gainsay nor resist.\wj* 
\v 16 \wj And ye shall be betrayed both by parents, and brethren, and kinsfolks, and friends; and some of you shall they cause to be put to death.\wj* 
\v 17 \wj And ye shall be hated of all men for my name’s sake.\wj* 
\v 18 \wj But there shall not an hair of your head perish.\wj* 
\v 19 \wj In your patience possess ye your souls.\wj* 
\v 20 \wj And when ye shall see Jerusalem compassed with armies, then know that the desolation thereof is nigh.\wj* 
\v 21 \wj Then let them which are in Judæa flee to the mountains; and let them which are in the midst of it depart out; and let not them that are in the countries enter thereinto.\wj* 
\v 22 \wj For these be the days of vengeance, that all things which are written may be fulfilled.\wj* 
\v 23 \wj But woe unto them that are with child, and to them that give suck, in those days! for there shall be great distress in the land, and wrath upon this people.\wj* 
\v 24 \wj And they shall fall by the edge of the sword, and shall be led away captive into all nations: and Jerusalem shall be trodden down of the Gentiles, until the times of the Gentiles be fulfilled.\wj* 
\p
\v 25 \wj And there shall be signs in the sun, and in the moon, and in the stars; and upon the earth distress of nations, with perplexity; the sea and the waves roaring;\wj* 
\v 26 \wj Men’s hearts failing them for fear, and for looking after those things which are coming on the earth: for the powers of heaven shall be shaken.\wj* 
\v 27 \wj And then shall they see the Son of man coming in a cloud with power and great glory.\wj* 
\v 28 \wj And when these things begin to come to pass, then look up, and lift up your heads; for your redemption draweth nigh.\wj* 
\v 29 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he spake]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”} [to them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 4”} [a parable]{strong=“G3850” x-morph=“robinson: N-\sc Asf\sc* 3”}; \wj Behold the fig tree, and all the trees;\wj* 
\v 30 \wj When they now shoot forth, ye see and know of your own selves that summer is now nigh at hand.\wj* 
\v 31 \wj So likewise ye, when ye see these things come to pass, know ye that the kingdom of God is nigh at hand.\wj* 
\v 32 \wj Verily I say unto you, This generation shall not pass away, till all be fulfilled.\wj* 
\v 33 \wj Heaven and earth shall pass away: but my words shall not pass away.\wj* 
\p
\v 34 \wj And take heed to yourselves, lest at any time your hearts be overcharged with surfeiting, and drunkenness, and cares of this life, and so that day come upon you unawares.\wj* 
\v 35 \wj For as a snare shall it come on all them that dwell on the face of the whole earth.\wj* 
\v 36 \wj Watch ye therefore, and pray always, that ye may be accounted worthy to escape all these things that shall come to pass, and to stand before the Son of man.\wj* 
\v 37 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [in the day time]{strong=“G3588 G2250” x-morph=“robinson: T-\sc Apf\sc* robinson: N-\sc Apf\sc* 3 4”} [he was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 1”} [teaching]{strong=“G1321” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 8”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 5”} [the temple]{strong=“G3588 G2411” x-morph=“robinson: T-\sc Dsn\sc* robinson: N-\sc Dsn\sc* 6 7”}; [and]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 10”} [at night]{strong=“G3571” x-morph=“robinson: N-\sc Apf\sc* 11”} [he went out]{strong=“G1831” x-morph=“robinson: V-\sc Pnp\sc*-\sc Nsm\sc* 12”}, [and abode]{strong=“G835” x-morph=“robinson: V-\sc Ini\sc*-3S 13”} [in]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 14”} [the mount]{strong=“G3588 G3735” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 15 16”} [that is called]{strong=“G2564” x-morph=“robinson: V-\sc Ppp\sc*-\sc Asn\sc* 18”} the mount [of Olives]{strong=“G1636” x-morph=“robinson: N-\sc Gpf\sc* 19”}. 
\v 38 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Nsm\sc* 2”} [the people]{strong=“G3588 G2992” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [came early in the morning]{strong=“G3719” x-morph=“robinson: V-\sc Iai\sc*-3S 5”} [to]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 6”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 7”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 8”} [the temple]{strong=“G3588 G2411” x-morph=“robinson: T-\sc Dsn\sc* robinson: N-\sc Dsn\sc* 9 10”}, [for to hear]{strong=“G191” x-morph=“robinson: V-\sc Pan\sc* 11”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 12”}. 
\c 22
\p 
\v 1 [Now]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [the feast]{strong=“G3588 G1859” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 3 4”} [of unleavened bread]{strong=“G106” x-morph=“robinson: A-\sc Gpn\sc* 6”} [drew nigh]{strong=“G1448” x-morph=“robinson: V-\sc Iai\sc*-3S 1”}, [which]{strong=“G3588” x-morph=“robinson: T-\sc Nsf\sc* 7”} [is called]{strong=“G3004” x-morph=“robinson: V-\sc Ppp\sc*-\sc Nsf\sc* 8”} [the Passover]{strong=“G3957” x-morph=“robinson: \sc Aram\sc* 9”}. 
\v 2 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [the chief priests]{strong=“G3588 G749” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [scribes]{strong=“G3588 G1122” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 6 7”} [sought]{strong=“G2212” x-morph=“robinson: V-\sc Iai\sc*-3P 2”} [how]{strong=“G4459” x-morph=“robinson: \sc Adv\sc*-I 9”} [they might kill]{strong=“G337” x-morph=“robinson: V-\sc Aas\sc*-3P 10”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 11”}; [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 13”} [they feared]{strong=“G5399” x-morph=“robinson: V-\sc Ini\sc*-3P 12”} [the people]{strong=“G3588 G2992” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 14 15”}. 
\p
\v 3 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [entered]{strong=“G1525” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [Satan]{strong=“G3588 G4567” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 5”} [Judas]{strong=“G2455” x-morph=“robinson: N-\sc Asm\sc* 6”} [surnamed]{strong=“G1941” x-morph=“robinson: V-\sc Ppp\sc*-\sc Asm\sc* 8”} [Iscariot]{strong=“G2469” x-morph=“robinson: N-\sc Asm\sc* 9”}, [being]{strong=“G5607” x-morph=“robinson: V-\sc Pxp\sc*-\sc Asm\sc* 10”} [of]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 11”} [the number]{strong=“G3588 G706” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 12 13”} [of the twelve]{strong=“G1427” x-morph=“robinson: A-\sc Nui\sc* 15”}. 
\v 4 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he went his way]{strong=“G565” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”}, [and communed]{strong=“G4814” x-morph=“robinson: V-\sc Aai\sc*-3S 3”} [with the chief priests]{strong=“G3588 G749” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 4 5”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [captains]{strong=“G3588 G4755” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 7 8”}, [how]{strong=“G4459” x-morph=“robinson: \sc Adv\sc*-I 10”} [he might betray]{strong=“G3860” x-morph=“robinson: V-2\sc Aas\sc*-3S 12”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 11”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 13”}. 
\v 5 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they were glad]{strong=“G5463” x-morph=“robinson: V-2\sc Aoi\sc*-3P 2”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 3”} [covenanted]{strong=“G4934” x-morph=“robinson: V-2\sc Ami\sc*-3P 4”} [to give]{strong=“G1325” x-morph=“robinson: V-2\sc Aan\sc* 7”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 5”} [money]{strong=“G694” x-morph=“robinson: N-\sc Asn\sc* 6”}. 
\v 6 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he promised]{strong=“G1843” x-morph=“robinson: V-\sc Aai\sc*-3S 2”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 3”} [sought]{strong=“G2212” x-morph=“robinson: V-\sc Iai\sc*-3S 4”} [opportunity]{strong=“G2120” x-morph=“robinson: N-\sc Asf\sc* 5”} [to betray]{strong=“G3860” x-morph=“robinson: V-2\sc Aan\sc* 7”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 8”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 9”} [in the absence of]{strong=“G817” x-morph=“robinson: \sc Prep\sc* 10”} [the multitude]{strong=“G3793” x-morph=“robinson: N-\sc Gsm\sc* 11”}. 
\p
\v 7 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [came]{strong=“G2064” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [the day]{strong=“G3588 G2250” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 3 4”} [of unleavened bread]{strong=“G106” x-morph=“robinson: A-\sc Gpn\sc* 6”}, [when]{strong=“G3739” x-morph=“robinson: R-\sc Dsf\sc* 8”} [the passover]{strong=“G3957” x-morph=“robinson: \sc Aram\sc* 12”} [must]{strong=“G1163” x-morph=“robinson: V-\sc Iqi\sc*-3S 9”} [be killed]{strong=“G2380” x-morph=“robinson: V-\sc Ppn\sc* 10”}. 
\v 8 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he sent]{strong=“G649” x-morph=“robinson: V-\sc Aai\sc*-3S 2”} [Peter]{strong=“G4074” x-morph=“robinson: N-\sc Asm\sc* 3”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 4”} [John]{strong=“G2491” x-morph=“robinson: N-\sc Asm\sc* 5”}, [saying]{strong=“G2036” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 6”}, \wj Go and prepare us the passover, that we may eat.\wj* 
\v 9 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [they said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 3”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 4”}, [Where]{strong=“G4226” x-morph=“robinson: \sc Prt\sc*-I 5”} [wilt thou]{strong=“G2309” x-morph=“robinson: V-\sc Pai\sc*-2S 6”} [that we prepare]{strong=“G2090” x-morph=“robinson: V-\sc Aas\sc*-1P 7”}? 
\v 10 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 4”}, \wj Behold, when ye are entered into the city, there shall a man meet you, bearing a pitcher of water; follow him into the house where he entereth in.\wj* 
\v 11 \wj And ye shall say unto the goodman of the house, The Master saith unto thee, Where is the guestchamber, where I shall eat the passover with my disciples?\wj* 
\v 12 \wj And he shall shew you a large upper room furnished: there make ready.\wj* 
\v 13 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [they went]{strong=“G565” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 1”}, [and found]{strong=“G2147” x-morph=“robinson: V-2\sc Aai\sc*-3P 3”} [as]{strong=“G2531” x-morph=“robinson: \sc Adv\sc* 4”} [he had said]{strong=“G2046” x-morph=“robinson: V-\sc Rai\sc*-3S-\sc Att\sc* 5”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 6”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [they made ready]{strong=“G2090” x-morph=“robinson: V-\sc Aai\sc*-3P 8”} [the passover]{strong=“G3957” x-morph=“robinson: \sc Aram\sc* 10”}. 
\v 14 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when]{strong=“G3753” x-morph=“robinson: \sc Adv\sc* 2”} [the hour]{strong=“G3588 G5610” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 4 5”} [was come]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 3”}, [he sat down]{strong=“G377” x-morph=“robinson: V-2\sc Aai\sc*-3S 6”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [the twelve]{strong=“G1427” x-morph=“robinson: A-\sc Nui\sc* 9”} [apostles]{strong=“G652” x-morph=“robinson: N-\sc Npm\sc* 10”} [with]{strong=“G4862” x-morph=“robinson: \sc Prep\sc* 11”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 12”}. 
\v 15 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 4”}, \wj With desire I have desired to eat this passover with you before I suffer:\wj* 
\v 16 \wj For I say unto you, I will not any more eat thereof, until it be fulfilled in the kingdom of God.\wj* 
\v 17 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he took]{strong=“G1209” x-morph=“robinson: V-\sc Adp\sc*-\sc Nsm\sc* 2”} [the cup]{strong=“G4221” x-morph=“robinson: N-\sc Asn\sc* 3”}, [and gave thanks]{strong=“G2168” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 4”}, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”}, \wj Take this, and divide it among yourselves:\wj* 
\v 18 \wj For I say unto you, I will not drink of the fruit of the vine, until the kingdom of God shall come.\wj* 
\p
\v 19 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he took]{strong=“G2983” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”} [bread]{strong=“G740” x-morph=“robinson: N-\sc Asm\sc* 3”}, [and gave thanks]{strong=“G2168” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 4”}, [and brake]{strong=“G2806” x-morph=“robinson: V-\sc Aai\sc*-3S 5”} it, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [gave]{strong=“G1325” x-morph=“robinson: V-\sc Aai\sc*-3S 7”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 8”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 9”}, \wj This is my body which is given for you: this do in remembrance of me.\wj* 
\v 20 [Likewise]{strong=“G5615” x-morph=“robinson: \sc Adv\sc* 1”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 2”} [the cup]{strong=“G3588 G4221” x-morph=“robinson: T-\sc Nsn\sc* robinson: N-\sc Nsn\sc* 3 4”} [after]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 5”} [supper]{strong=“G1172” x-morph=“robinson: V-\sc Aan\sc* 7”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 8”}, \wj This cup is the new testament in my blood, which is shed for you.\wj* 
\p
\v 21 \wj But, behold, the hand of him that betrayeth me is with me on the table.\wj* 
\v 22 \wj And truly the Son of man goeth, as it was determined: but woe unto that man by whom he is betrayed!\wj* 
\v 23 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they]{strong=“G846” x-morph=“robinson: P-\sc Npm\sc* 2”} [began]{strong=“G756” x-morph=“robinson: V-\sc Adi\sc*-3P 3”} [to enquire]{strong=“G4802” x-morph=“robinson: V-\sc Pan\sc* 4”} [among]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 5”} [themselves]{strong=“G1438” x-morph=“robinson: F-3\sc Apm\sc* 6”}, [which]{strong=“G5101” x-morph=“robinson: I-\sc Nsm\sc* 8”} [of]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 11”} [them]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 12”} [it was]{strong=“G1498” x-morph=“robinson: V-\sc Pxo\sc*-3S 10”} [that should]{strong=“G3195” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 15”} [do]{strong=“G4238” x-morph=“robinson: V-\sc Pan\sc* 16”} [this thing]{strong=“G5124” x-morph=“robinson: D-\sc Asn\sc* 14”}. 
\p
\v 24 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [there was]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 1”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 3”} [a strife]{strong=“G5379” x-morph=“robinson: N-\sc Nsf\sc* 4”} [among]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 5”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 6”}, [which]{strong=“G5101” x-morph=“robinson: I-\sc Nsm\sc* 8”} [of them]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 9”} [should be]{strong=“G1511” x-morph=“robinson: V-\sc Pxn\sc* 11”} [accounted]{strong=“G1380” x-morph=“robinson: V-\sc Pai\sc*-3S 10”} [the greatest]{strong=“G3187” x-morph=“robinson: A-\sc Nsm\sc*-C 12”}. 
\v 25 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 4”}, \wj The kings of the Gentiles exercise lordship over them; and they that exercise authority upon them are called benefactors.\wj* 
\v 26 \wj But ye shall not be so: but he that is greatest among you, let him be as the younger; and he that is chief, as he that doth serve.\wj* 
\v 27 \wj For whether is greater, he that sitteth at meat, or he that serveth? is not he that sitteth at meat? but I am among you as he that serveth.\wj* 
\v 28 \wj Ye are they which have continued with me in my temptations.\wj* 
\v 29 \wj And I appoint unto you a kingdom, as my Father hath appointed unto me;\wj* 
\v 30 \wj That ye may eat and drink at my table in my kingdom, and sit on thrones judging the twelve tribes of Israel.\wj* 
\p
\v 31 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [the Lord]{strong=“G3588 G2962” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”}, \wj Simon, Simon, behold, Satan hath desired to have you, that he may sift you as wheat:\wj* 
\v 32 \wj But I have prayed for thee, that thy faith fail not: and when thou art converted, strengthen thy brethren.\wj* 
\v 33 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 4”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 5”}, [I am]{strong=“G1510” x-morph=“robinson: V-\sc Pxi\sc*-1S 9”} [ready]{strong=“G2092” x-morph=“robinson: A-\sc Nsm\sc* 8”} [to go]{strong=“G4198” x-morph=“robinson: V-\sc Pnn\sc* 16”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 6”} [thee]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 7”}, [both]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 11”} [prison]{strong=“G5438” x-morph=“robinson: N-\sc Asf\sc* 12”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 13”} [to]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 14”} [death]{strong=“G2288” x-morph=“robinson: N-\sc Asm\sc* 15”}. 
\v 34 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”}, \wj I tell thee, Peter, the cock shall not crow this day, before that thou shalt thrice deny that thou knowest me.\wj* 
\v 35 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj When I sent you without purse, and scrip, and shoes, lacked ye any thing?\wj* [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 17”} [they said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 18”}, [Nothing]{strong=“G3762” x-morph=“robinson: A-\sc Gsn\sc* 19”}. 
\v 36 [Then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [said he]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj But now, he that hath a purse, let him take it, and likewise his scrip: and he that hath no sword, let him sell his garment, and buy one.\wj* 
\v 37 \wj For I say unto you, that this that is written must yet be accomplished in me, And he was reckoned among the transgressors: for the things concerning me have an end.\wj* 
