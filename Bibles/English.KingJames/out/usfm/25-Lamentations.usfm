\h Lamentations
\toc1 Lamentations
\p
\rem From here on, this file is autogenerated by bibmark. You may edit the header section, as it will not be changed by bibmark.

\c 1
\p 
\v 1 \w How doth the city| strong="H5892" \w* [sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w solitary| strong="H910" \w*, that was \w full| strong="H7227" \w* \w of people| strong="H5971" \w*! how \w is she become as a widow| strong="H490" \w*! she that was \w great| strong="H7227" \w* \w among the nations| strong="H1471" \w*, and \w princess| strong="H8282" \w* \w among the provinces| strong="H4082" \w*, how \w is she become tributary| strong="H4522" \w*! 
\v 2 [She weepeth]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8799”} [sore]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the night| strong="H3915" \w*, \w and her tears| strong="H1832" \w* are \w on her cheeks| strong="H3895" \w*: [among all her lovers]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} [she hath none to comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8764”} her: \w all her friends| strong="H7453" \w* [have dealt treacherously]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8804”} [with her, they are become her enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 3 \w Judah| strong="H3063" \w* [is gone into captivity]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8804”} \w because of affliction| strong="H6040" \w*, \w and because of great| strong="H7230" \w* \w servitude| strong="H5656" \w*: [she dwelleth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w among the heathen| strong="H1471" \w*, [she findeth]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w no rest| strong="H4494" \w*: [all her persecutors]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8802”} [overtook]{strong=“H5381” x-morph=“strongMorph: \sc Th\sc*8689”} \w her between the straits| strong="H4712" \w*.\f + \fr 1:3 \ft because of great…: Heb. for the greatness of servitude \f* 
\v 4 \w The ways| strong="H1870" \w* \w of Zion| strong="H6726" \w* \w do mourn| strong="H57" \w*, [because none come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the solemn feasts| strong="H4150" \w*: \w all her gates| strong="H8179" \w* [are desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8802”}: \w her priests| strong="H3548" \w* [sigh]{strong=“H584” x-morph=“strongMorph: \sc Th\sc*8737”}, \w her virgins| strong="H1330" \w* [are afflicted]{strong=“H3013” x-morph=“strongMorph: \sc Th\sc*8737”}, and she is [in bitterness]{strong=“H4843” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 5 \w Her adversaries| strong="H6862" \w* \w are the chief| strong="H7218" \w*, [her enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [prosper]{strong=“H7951” x-morph=“strongMorph: \sc Th\sc*8804”}; for the \sc Lord\sc* [hath afflicted]{strong=“H3013” x-morph=“strongMorph: \sc Th\sc*8689”} \w her for the multitude| strong="H7230" \w* \w of her transgressions| strong="H6588" \w*: \w her children| strong="H5768" \w* [are gone]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w into captivity| strong="H7628" \w* \w before| strong="H6440" \w* \w the enemy| strong="H6862" \w*. 
\v 6 \w And from the daughter| strong="H1323" \w* \w of Zion| strong="H6726" \w* \w all her beauty| strong="H1926" \w* [is departed]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”}: \w her princes| strong="H8269" \w* \w are become like harts| strong="H354" \w* that [find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w no pasture| strong="H4829" \w*, [and they are gone]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w without strength| strong="H3581" \w* \w before| strong="H6440" \w* [the pursuer]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 7 \w Jerusalem| strong="H3389" \w* [remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the days| strong="H3117" \w* \w of her affliction| strong="H6040" \w* \w and of her miseries| strong="H4788" \w* \w all her pleasant things| strong="H4262" \w* \w that she had in the days| strong="H3117" \w* \w of old| strong="H6924" \w*, \w when her people| strong="H5971" \w* [fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8800”} \w into the hand| strong="H3027" \w* \w of the enemy| strong="H6862" \w*, [and none did help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8802”} [her: the adversaries]{strong=“H6862”} [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} her, and [did mock]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8804”} \w at her sabbaths| strong="H4868" \w*.\f + \fr 1:7 \ft pleasant: or, desirable \f* 
\v 8 \w Jerusalem| strong="H3389" \w* \w hath grievously| strong="H2399" \w* [sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}; \w therefore she is removed| strong="H5206" \w*: [all that honoured]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8764”} [her despise]{strong=“H2107” x-morph=“strongMorph: \sc Th\sc*8689”} [her, because they have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w her nakedness| strong="H6172" \w*: [yea, she sigheth]{strong=“H584” x-morph=“strongMorph: \sc Th\sc*8738”}, [and turneth]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w backward| strong="H268" \w*.\f + \fr 1:8 \ft is…: Heb. is become a removing, or, wandering \f* 
\v 9 \w Her filthiness| strong="H2932" \w* is \w in her skirts| strong="H7757" \w*; [she remembereth]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w not her last end| strong="H319" \w*; [therefore she came down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w wonderfully| strong="H6382" \w*: [she had no comforter]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8764”}. O \sc Lord\sc*, [behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w my affliction| strong="H6040" \w*: [for the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [hath magnified]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8689”} himself. 
\v 10 \w The adversary| strong="H6862" \w* [hath spread out]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8804”} \w his hand| strong="H3027" \w* \w upon all her pleasant things| strong="H4261" \w*: [for she hath seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} that \w the heathen| strong="H1471" \w* [entered]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into her sanctuary| strong="H4720" \w*, [whom thou didst command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} that [they should not enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into thy congregation| strong="H6951" \w*.\f + \fr 1:10 \ft pleasant: or, desirable \f* 
\v 11 \w All her people| strong="H5971" \w* [sigh]{strong=“H584” x-morph=“strongMorph: \sc Th\sc*8737”}, [they seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w bread| strong="H3899" \w*; [they have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [their pleasant things]{strong=“H4262 H4261” x-morph=“strongMorph: \sc Th\sc*8675”} \w for meat| strong="H400" \w* [to relieve]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} \w the soul| strong="H5315" \w*: [see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}, O \sc Lord\sc*, [and consider]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8685”}; [for I am become vile]{strong=“H2151” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 1:11 \ft to…: or, to make the soul to come again \f* 
\p
\v 12 Is it [nothing to you, all ye that pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} \w by| strong="H1870" \w*? [behold]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8685”}, [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w if there be| strong="H3426" \w* \w any sorrow| strong="H4341" \w* \w like unto my sorrow| strong="H4341" \w*, [which is done]{strong=“H5953” x-morph=“strongMorph: \sc Th\sc*8776”} unto me, wherewith the \sc Lord\sc* [hath afflicted]{strong=“H3013” x-morph=“strongMorph: \sc Th\sc*8689”} me \w in the day| strong="H3117" \w* \w of his fierce| strong="H2740" \w* \w anger| strong="H639" \w*.\f + \fr 1:12 \ft Is it…: or, It is nothing \f* \f + \fr 1:12 \ft pass by: Heb. pass by the way? \f* 
\v 13 \w From above| strong="H4791" \w* [hath he sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w fire| strong="H784" \w* \w into my bones| strong="H6106" \w*, [and it prevaileth]{strong=“H7287” x-morph=“strongMorph: \sc Th\sc*8799”} [against them: he hath spread]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8804”} \w a net| strong="H7568" \w* \w for my feet| strong="H7272" \w*, [he hath turned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} \w me back| strong="H268" \w*: [he hath made]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [me desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8802”} and \w faint| strong="H1739" \w* \w all the day| strong="H3117" \w*. 
\v 14 \w The yoke| strong="H5923" \w* \w of my transgressions| strong="H6588" \w* [is bound]{strong=“H8244” x-morph=“strongMorph: \sc Th\sc*8738”} \w by his hand| strong="H3027" \w*: [they are wreathed]{strong=“H8276” x-morph=“strongMorph: \sc Th\sc*8691”}, and [come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon my neck| strong="H6677" \w*: \w he hath made my strength| strong="H3581" \w* [to fall]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8689”}, \w the Lord| strong="H136" \w* [hath delivered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} me into their \w hands| strong="H3027" \w*, from whom [I am not able]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [to rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 15 \w The Lord| strong="H136" \w* [hath trodden under foot]{strong=“H5541” x-morph=“strongMorph: \sc Th\sc*8765”} \w all my mighty| strong="H47" \w* men \w in the midst| strong="H7130" \w* [of me: he hath called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w an assembly| strong="H4150" \w* [against me to crush]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8800”} \w my young men| strong="H970" \w*: \w the Lord| strong="H136" \w* [hath trodden]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8804”} \w the virgin| strong="H1330" \w*, \w the daughter| strong="H1323" \w* \w of Judah| strong="H3063" \w*, as \w in a winepress| strong="H1660" \w*.\f + \fr 1:15 \ft the virgin…: or, the winepress of the virgin, etc \f* 
\v 16 For these things [I weep]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8802”}; \w mine eye| strong="H5869" \w*, \w mine eye| strong="H5869" \w* [runneth down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w with water| strong="H4325" \w*, [because the comforter]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8764”} [that should relieve]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8688”} \w my soul| strong="H5315" \w* [is far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8804”} [from me: my children]{strong=“H1121”} [are desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8802”}, [because the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [prevailed]{strong=“H1396” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 1:16 \ft relieve: Heb. bring back \f* 
\v 17 \w Zion| strong="H6726" \w* [spreadeth forth]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8765”} \w her hands| strong="H3027" \w*, and there is [none to comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8764”} her: the \sc Lord\sc* [hath commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w concerning Jacob| strong="H3290" \w*, that \w his adversaries| strong="H6862" \w* should be \w round about| strong="H5439" \w* [him: Jerusalem]{strong=“H3389”} \w is as a menstruous woman| strong="H5079" \w* among them. 
\p
\v 18 The \sc Lord\sc* \w is righteous| strong="H6662" \w*; [for I have rebelled]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8804”} \w against his commandment| strong="H6310" \w*: [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, [I pray you, all people]{strong=“H5971”}, [and behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w my sorrow| strong="H4341" \w*: \w my virgins| strong="H1330" \w* \w and my young men| strong="H970" \w* [are gone]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w into captivity| strong="H7628" \w*.\f + \fr 1:18 \ft commandment: Heb. mouth \f* 
\v 19 [I called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [for my lovers]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8764”}, but [they deceived]{strong=“H7411” x-morph=“strongMorph: \sc Th\sc*8765”} [me: my priests]{strong=“H3548”} \w and mine elders| strong="H2205" \w* [gave up the ghost]{strong=“H1478” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the city| strong="H5892" \w*, [while they sought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8765”} \w their meat| strong="H400" \w* [to relieve]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w their souls| strong="H5315" \w*. 
\v 20 [Behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}, O \sc Lord\sc*; for I am [in distress]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8804”}: \w my bowels| strong="H4578" \w* [are troubled]{strong=“H2560” x-morph=“strongMorph: \sc Th\sc*8777”}; \w mine heart| strong="H3820" \w* [is turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8738”} \w within| strong="H7130" \w* [me; for I have grievously]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8800”} [rebelled]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8804”}: \w abroad| strong="H2351" \w* \w the sword| strong="H2719" \w* [bereaveth]{strong=“H7921” x-morph=“strongMorph: \sc Th\sc*8765”}, \w at home| strong="H1004" \w* there is \w as death| strong="H4194" \w*. 
\v 21 [They have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [that I sigh]{strong=“H584” x-morph=“strongMorph: \sc Th\sc*8737”}: there is [none to comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8764”} [me: all mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w of my trouble| strong="H7451" \w*; [they are glad]{strong=“H7797” x-morph=“strongMorph: \sc Th\sc*8804”} [that thou hast done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} it: [thou wilt bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w the day| strong="H3117" \w* that [thou hast called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and they shall be like| strong="H3644" \w* unto me.\f + \fr 1:21 \ft called: or, proclaimed \f* 
\v 22 \w Let all their wickedness| strong="H7451" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* [thee; and do]{strong=“H5953” x-morph=“strongMorph: \sc Th\sc*8778”} [unto them, as thou hast done]{strong=“H5953” x-morph=“strongMorph: \sc Th\sc*8782”} \w unto me for all my transgressions| strong="H6588" \w*: \w for my sighs| strong="H585" \w* are \w many| strong="H7227" \w*, \w and my heart| strong="H3820" \w* is \w faint| strong="H1742" \w*.
\c 2
\p 
\v 1 \w How hath the Lord| strong="H136" \w* \w covered| strong="H5743" \w* \w the daughter| strong="H1323" \w* \w of Zion| strong="H6726" \w* [with a cloud]{strong=“H5743” x-morph=“strongMorph: \sc Th\sc*8686”} \w in his anger| strong="H639" \w*, and [cast down]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8689”} \w from heaven| strong="H8064" \w* \w unto the earth| strong="H776" \w* \w the beauty| strong="H8597" \w* \w of Israel| strong="H3478" \w*, [and remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} [not his footstool]{strong=“H7272 H1916”} \w in the day| strong="H3117" \w* \w of his anger| strong="H639" \w*! 
\v 2 \w The Lord| strong="H136" \w* [hath swallowed up]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8765”} \w all the habitations| strong="H4999" \w* \w of Jacob| strong="H3290" \w*, [and hath not pitied]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8804”}: [he hath thrown down]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his wrath| strong="H5678" \w* \w the strong holds| strong="H4013" \w* \w of the daughter| strong="H1323" \w* \w of Judah| strong="H3063" \w*; he hath brought them [down]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8689”} \w to the ground| strong="H776" \w*: [he hath polluted]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8765”} \w the kingdom| strong="H4467" \w* \w and the princes| strong="H8269" \w* thereof.\f + \fr 2:2 \ft brought…: Heb. made to touch \f* 
\v 3 [He hath cut off]{strong=“H1438” x-morph=“strongMorph: \sc Th\sc*8804”} in his \w fierce| strong="H2750" \w* \w anger| strong="H639" \w* \w all the horn| strong="H7161" \w* \w of Israel| strong="H3478" \w*: [he hath drawn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} \w back| strong="H268" \w* \w his right hand| strong="H3225" \w* \w from before| strong="H6440" \w* [the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, [and he burned]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8799”} \w against Jacob| strong="H3290" \w* \w like a flaming| strong="H3852" \w* \w fire| strong="H784" \w*, which [devoureth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w round about| strong="H5439" \w*. 
\v 4 [He hath bent]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8804”} \w his bow| strong="H7198" \w* [like an enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}: [he stood]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8737”} \w with his right hand| strong="H3225" \w* \w as an adversary| strong="H6862" \w*, [and slew]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} all that were \w pleasant| strong="H4261" \w* \w to the eye| strong="H5869" \w* \w in the tabernacle| strong="H168" \w* \w of the daughter| strong="H1323" \w* \w of Zion| strong="H6726" \w*: [he poured out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8804”} \w his fury| strong="H2534" \w* \w like fire| strong="H784" \w*.\f + \fr 2:4 \ft all…: Heb. all the desirable of the eye \f* 
\v 5 \w The Lord| strong="H136" \w* [was as an enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}: [he hath swallowed up]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8765”} \w Israel| strong="H3478" \w*, [he hath swallowed up]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8765”} \w all her palaces| strong="H759" \w*: [he hath destroyed]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8765”} \w his strong holds| strong="H4013" \w*, [and hath increased]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} \w in the daughter| strong="H1323" \w* \w of Judah| strong="H3063" \w* \w mourning| strong="H8386" \w* \w and lamentation| strong="H592" \w*. 
\v 6 [And he hath violently taken away]{strong=“H2554” x-morph=“strongMorph: \sc Th\sc*8799”} \w his tabernacle| strong="H7900" \w*, as if it were of \w a garden| strong="H1588" \w*: [he hath destroyed]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8765”} \w his places of the assembly| strong="H4150" \w*: the \sc Lord\sc* \w hath caused the solemn feasts| strong="H4150" \w* \w and sabbaths| strong="H7676" \w* [to be forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8765”} \w in Zion| strong="H6726" \w*, [and hath despised]{strong=“H5006” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the indignation| strong="H2195" \w* \w of his anger| strong="H639" \w* \w the king| strong="H4428" \w* \w and the priest| strong="H3548" \w*.\f + \fr 2:6 \ft tabernacle: or, hedge \f* 
\v 7 \w The Lord| strong="H136" \w* [hath cast off]{strong=“H2186” x-morph=“strongMorph: \sc Th\sc*8804”} \w his altar| strong="H4196" \w*, [he hath abhorred]{strong=“H5010” x-morph=“strongMorph: \sc Th\sc*8765”} \w his sanctuary| strong="H4720" \w*, [he hath given up]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8689”} \w into the hand| strong="H3027" \w* [of the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w the walls| strong="H2346" \w* \w of her palaces| strong="H759" \w*; [they have made]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w a noise| strong="H6963" \w* \w in the house| strong="H1004" \w* of the \sc Lord\sc*, \w as in the day| strong="H3117" \w* \w of a solemn feast| strong="H4150" \w*.\f + \fr 2:7 \ft given up: Heb. shut up \f* 
\v 8 The \sc Lord\sc* [hath purposed]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8804”} [to destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8687”} \w the wall| strong="H2346" \w* \w of the daughter| strong="H1323" \w* \w of Zion| strong="H6726" \w*: [he hath stretched out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} \w a line| strong="H6957" \w*, [he hath not withdrawn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} \w his hand| strong="H3027" \w* [from destroying]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8763”}: \w therefore he made the rampart| strong="H2426" \w* \w and the wall| strong="H2346" \w* [to lament]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8686”}; [they languished]{strong=“H535” x-morph=“strongMorph: \sc Th\sc*8797”} \w together| strong="H3162" \w*.\f + \fr 2:8 \ft destroying: Heb. swallowing up \f* 
\v 9 \w Her gates| strong="H8179" \w* [are sunk]{strong=“H2883” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the ground| strong="H776" \w*; [he hath destroyed]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8765”} [and broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8765”} \w her bars| strong="H1280" \w*: \w her king| strong="H4428" \w* \w and her princes| strong="H8269" \w* are \w among the Gentiles| strong="H1471" \w*: \w the law| strong="H8451" \w* is no more; \w her prophets| strong="H5030" \w* [also find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w no vision| strong="H2377" \w* from the \sc Lord\sc*. 
\p
\v 10 \w The elders| strong="H2205" \w* \w of the daughter| strong="H1323" \w* \w of Zion| strong="H6726" \w* [sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the ground| strong="H776" \w*, and [keep silence]{strong=“H1826” x-morph=“strongMorph: \sc Th\sc*8799”}: [they have cast up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} \w dust| strong="H6083" \w* \w upon their heads| strong="H7218" \w*; [they have girded]{strong=“H2296” x-morph=“strongMorph: \sc Th\sc*8804”} \w themselves with sackcloth| strong="H8242" \w*: \w the virgins| strong="H1330" \w* \w of Jerusalem| strong="H3389" \w* [hang down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8689”} \w their heads| strong="H7218" \w* \w to the ground| strong="H776" \w*. 
\v 11 \w Mine eyes| strong="H5869" \w* [do fail]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”} \w with tears| strong="H1832" \w*, \w my bowels| strong="H4578" \w* [are troubled]{strong=“H2560” x-morph=“strongMorph: \sc Th\sc*8777”}, \w my liver| strong="H3516" \w* [is poured]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8738”} \w upon the earth| strong="H776" \w*, \w for the destruction| strong="H7667" \w* \w of the daughter| strong="H1323" \w* \w of my people| strong="H5971" \w*; \w because the children| strong="H5768" \w* [and the sucklings]{strong=“H3243” x-morph=“strongMorph: \sc Th\sc*8802”} [swoon]{strong=“H5848” x-morph=“strongMorph: \sc Th\sc*8736”} \w in the streets| strong="H7339" \w* \w of the city| strong="H7151" \w*.\f + \fr 2:11 \ft swoon: or, faint \f* 
\v 12 [They say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to their mothers| strong="H517" \w*, Where is \w corn| strong="H1715" \w* \w and wine| strong="H3196" \w*? [when they swooned]{strong=“H5848” x-morph=“strongMorph: \sc Th\sc*8692”} \w as the wounded| strong="H2491" \w* \w in the streets| strong="H7339" \w* \w of the city| strong="H5892" \w*, \w when their soul| strong="H5315" \w* [was poured out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8692”} [into their mothers’]{strong=“H517”} \w bosom| strong="H2436" \w*. 
\v 13 [What thing shall I take to witness]{strong=“H5749 H5749” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8686”} [for thee? what thing]{strong=“H4100”} [shall I liken]{strong=“H1819” x-morph=“strongMorph: \sc Th\sc*8762”} [to thee, O daughter]{strong=“H1323”} \w of Jerusalem| strong="H3389" \w*? [what shall I equal]{strong=“H7737” x-morph=“strongMorph: \sc Th\sc*8686”} [to thee, that I may comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8762”} [thee, O virgin]{strong=“H1330”} \w daughter| strong="H1323" \w* \w of Zion| strong="H6726" \w*? \w for thy breach| strong="H7667" \w* is \w great| strong="H1419" \w* \w like the sea| strong="H3220" \w*: [who can heal]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8799”} thee? 
\v 14 \w Thy prophets| strong="H5030" \w* [have seen]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8804”} \w vain| strong="H7723" \w* \w and foolish things| strong="H8602" \w* [for thee: and they have not discovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8765”} \w thine iniquity| strong="H5771" \w*, [to turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} [thy captivity]{strong=“H7622 H7622” x-morph=“strongMorph: \sc Th\sc*8675”}; [but have seen]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8799”} \w for thee false| strong="H7723" \w* \w burdens| strong="H4864" \w* \w and causes of banishment| strong="H4065" \w*. 
\v 15 [All that pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} [by clap]{strong=“H5606” x-morph=“strongMorph: \sc Th\sc*8804”} their \w hands| strong="H3709" \w* \w at thee| strong="H1870" \w*; [they hiss]{strong=“H8319” x-morph=“strongMorph: \sc Th\sc*8804”} [and wag]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8686”} \w their head| strong="H7218" \w* \w at the daughter| strong="H1323" \w* \w of Jerusalem| strong="H3389" \w*, saying, Is \w this the city| strong="H5892" \w* that men [call]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w The perfection| strong="H3632" \w* \w of beauty| strong="H3308" \w*, \w The joy| strong="H4885" \w* \w of the whole earth| strong="H776" \w*?\f + \fr 2:15 \ft by: Heb. by the way \f* 
\v 16 [All thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [have opened]{strong=“H6475” x-morph=“strongMorph: \sc Th\sc*8804”} \w their mouth| strong="H6310" \w* [against thee: they hiss]{strong=“H8319” x-morph=“strongMorph: \sc Th\sc*8804”} [and gnash]{strong=“H2786” x-morph=“strongMorph: \sc Th\sc*8799”} \w the teeth| strong="H8127" \w*: [they say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, We have swallowed her [up]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8765”}: \w certainly| strong="H389" \w* this is \w the day| strong="H3117" \w* [that we looked for]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8765”}; [we have found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”}, [we have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} it. 
\v 17 The \sc Lord\sc* [hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} that [which he had devised]{strong=“H2161” x-morph=“strongMorph: \sc Th\sc*8804”}; [he hath fulfilled]{strong=“H1214” x-morph=“strongMorph: \sc Th\sc*8765”} \w his word| strong="H565" \w* [that he had commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w in the days| strong="H3117" \w* \w of old| strong="H6924" \w*: [he hath thrown down]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8804”}, [and hath not pitied]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8804”}: and he hath caused thine [enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [to rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8762”} [over thee, he hath set up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8689”} \w the horn| strong="H7161" \w* \w of thine adversaries| strong="H6862" \w*. 
\v 18 \w Their heart| strong="H3820" \w* [cried]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the Lord| strong="H136" \w*, \w O wall| strong="H2346" \w* \w of the daughter| strong="H1323" \w* \w of Zion| strong="H6726" \w*, \w let tears| strong="H1832" \w* [run down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8685”} \w like a river| strong="H5158" \w* \w day| strong="H3119" \w* \w and night| strong="H3915" \w*: [give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thyself no rest| strong="H6314" \w*; \w let not the apple| strong="H1323" \w* \w of thine eye| strong="H5869" \w* [cease]{strong=“H1826” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 19 [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [cry out]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8798”} \w in the night| strong="H3915" \w*: \w in the beginning| strong="H7218" \w* \w of the watches| strong="H821" \w* [pour out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8798”} \w thine heart| strong="H3820" \w* \w like water| strong="H4325" \w* \w before| strong="H5227" \w* \w the face| strong="H6440" \w* \w of the Lord| strong="H136" \w*: [lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy hands| strong="H3709" \w* \w toward him for the life| strong="H5315" \w* \w of thy young children| strong="H5768" \w*, [that faint]{strong=“H5848” x-morph=“strongMorph: \sc Th\sc*8803”} \w for hunger| strong="H7458" \w* \w in the top| strong="H7218" \w* \w of every street| strong="H2351" \w*. 
\p
\v 20 [Behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}, O \sc Lord\sc*, [and consider]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8685”} [to whom thou hast done]{strong=“H5953” x-morph=“strongMorph: \sc Th\sc*8782”} \w this| strong="H3541" \w*. \w Shall the women| strong="H802" \w* [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w their fruit| strong="H6529" \w*, and \w children| strong="H5768" \w* \w of a span long| strong="H2949" \w*? \w shall the priest| strong="H3548" \w* \w and the prophet| strong="H5030" \w* [be slain]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the sanctuary| strong="H4720" \w* \w of the Lord| strong="H136" \w*?\f + \fr 2:20 \ft of a span…: or, swaddled with their hands? \f* 
\v 21 \w The young| strong="H5288" \w* \w and the old| strong="H2205" \w* [lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8804”} \w on the ground| strong="H776" \w* \w in the streets| strong="H2351" \w*: \w my virgins| strong="H1330" \w* \w and my young men| strong="H970" \w* [are fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} \w by the sword| strong="H2719" \w*; [thou hast slain]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”} them \w in the day| strong="H3117" \w* \w of thine anger| strong="H639" \w*; [thou hast killed]{strong=“H2873” x-morph=“strongMorph: \sc Th\sc*8804”}, and [not pitied]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 22 [Thou hast called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w as in a solemn| strong="H4150" \w* \w day| strong="H3117" \w* \w my terrors| strong="H4032" \w* \w round about| strong="H5439" \w*, \w so that in the day| strong="H3117" \w* of the \sc Lord\sc*’S \w anger| strong="H639" \w* \w none escaped| strong="H6412" \w* \w nor remained| strong="H8300" \w*: [those that I have swaddled]{strong=“H2946” x-morph=“strongMorph: \sc Th\sc*8765”} [and brought up]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8765”} [hath mine enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8765”}.
\c 3
\p 
\v 1 I am \w the man| strong="H1397" \w* that [hath seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w affliction| strong="H6040" \w* \w by the rod| strong="H7626" \w* \w of his wrath| strong="H5678" \w*. 
\v 2 [He hath led]{strong=“H5090” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and brought]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8686”} me into \w darkness| strong="H2822" \w*, but not into \w light| strong="H216" \w*. 
\v 3 [Surely against me is he turned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}; [he turneth]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8799”} \w his hand| strong="H3027" \w* against me \w all the day| strong="H3117" \w*. 
\v 4 \w My flesh| strong="H1320" \w* \w and my skin| strong="H5785" \w* [hath he made old]{strong=“H1086” x-morph=“strongMorph: \sc Th\sc*8765”}; [he hath broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8765”} \w my bones| strong="H6106" \w*. 
\v 5 [He hath builded against]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and compassed]{strong=“H5362” x-morph=“strongMorph: \sc Th\sc*8686”} me \w with gall| strong="H7219" \w* \w and travail| strong="H8513" \w*. 
\v 6 [He hath set]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8689”} \w me in dark places| strong="H4285" \w*, as they that be [dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”} \w of old| strong="H5769" \w*. 
\v 7 [He hath hedged]{strong=“H1443” x-morph=“strongMorph: \sc Th\sc*8804”} [me about, that I cannot get out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”}: \w he hath made my chain| strong="H5178" \w* [heavy]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\v 8 [Also when I cry]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8799”} [and shout]{strong=“H7768” x-morph=“strongMorph: \sc Th\sc*8762”}, [he shutteth out]{strong=“H5640” x-morph=“strongMorph: \sc Th\sc*8804”} \w my prayer| strong="H8605" \w*. 
\v 9 [He hath inclosed]{strong=“H1443” x-morph=“strongMorph: \sc Th\sc*8804”} \w my ways| strong="H1870" \w* \w with hewn stone| strong="H1496" \w*, \w he hath made my paths| strong="H5410" \w* [crooked]{strong=“H5753” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 10 He was unto me as \w a bear| strong="H1677" \w* [lying in wait]{strong=“H693” x-morph=“strongMorph: \sc Th\sc*8802”}, and as \w a lion| strong="H738" \w* \w in secret places| strong="H4565" \w*. 
\v 11 [He hath turned aside]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8790”} \w my ways| strong="H1870" \w*, [and pulled me in pieces]{strong=“H6582” x-morph=“strongMorph: \sc Th\sc*8762”}: [he hath made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} [me desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 12 [He hath bent]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8804”} \w his bow| strong="H7198" \w*, [and set]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8686”} \w me as a mark| strong="H4307" \w* \w for the arrow| strong="H2671" \w*. 
\v 13 \w He hath caused the arrows| strong="H1121" \w* \w of his quiver| strong="H827" \w* [to enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w into my reins| strong="H3629" \w*.\f + \fr 3:13 \ft arrows: Heb. sons \f* 
\v 14 \w I was a derision| strong="H7814" \w* \w to all my people| strong="H5971" \w*; and \w their song| strong="H5058" \w* \w all the day| strong="H3117" \w*. 
\v 15 [He hath filled]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8689”} \w me with bitterness| strong="H4844" \w*, [he hath made me drunken]{strong=“H7301” x-morph=“strongMorph: \sc Th\sc*8689”} \w with wormwood| strong="H3939" \w*.\f + \fr 3:15 \ft bitterness: Heb. bitternesses \f* 
\v 16 [He hath also broken]{strong=“H1638” x-morph=“strongMorph: \sc Th\sc*8686”} \w my teeth| strong="H8127" \w* \w with gravel stones| strong="H2687" \w*, [he hath covered]{strong=“H3728” x-morph=“strongMorph: \sc Th\sc*8689”} \w me with ashes| strong="H665" \w*.\f + \fr 3:16 \ft covered…: or, rolled me in the ashes \f* 
\v 17 \w And thou hast removed| strong="H2186" \w* \w my soul| strong="H5315" \w* [far off]{strong=“H2186” x-morph=“strongMorph: \sc Th\sc*8799”} \w from peace| strong="H7965" \w*: [I forgat]{strong=“H5382” x-morph=“strongMorph: \sc Th\sc*8804”} \w prosperity| strong="H2896" \w*.\f + \fr 3:17 \ft prosperity: Heb. good \f* 
\v 18 [And I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w My strength| strong="H5331" \w* \w and my hope| strong="H8431" \w* [is perished]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”} from the \sc Lord\sc*: 
\v 19 [Remembering]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”} \w mine affliction| strong="H6040" \w* \w and my misery| strong="H4788" \w*, \w the wormwood| strong="H3939" \w* \w and the gall| strong="H7219" \w*.\f + \fr 3:19 \ft Remembering: or, Remember \f* 
\v 20 \w My soul| strong="H5315" \w* hath them [still]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8800”} [in remembrance]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”}, [and is humbled]{strong=“H7743” x-morph=“strongMorph: \sc Th\sc*8686”} in me.\f + \fr 3:20 \ft humbled: Heb. bowed \f* 
\p
\v 21 [This I recall]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w to my mind| strong="H3820" \w*, [therefore have I hope]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8686”}.\f + \fr 3:21 \ft recall…: Heb. make to return to my heart \f* 
\p
\v 22 It is of the \sc Lord\sc*’S \w mercies| strong="H2617" \w* [that we are not consumed]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8804”}, \w because his compassions| strong="H7356" \w* [fail]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”} not. 
\v 23 They are \w new| strong="H2319" \w* \w every morning| strong="H1242" \w*: \w great| strong="H7227" \w* is \w thy faithfulness| strong="H530" \w*. 
\v 24 The \sc Lord\sc* is \w my portion| strong="H2506" \w*, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w my soul| strong="H5315" \w*; [therefore will I hope]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8686”} in him. 
\v 25 The \sc Lord\sc* is \w good| strong="H2896" \w* [unto them that wait]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8802”} [for him, to the soul]{strong=“H5315”} that [seeketh]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”} him. 
\v 26 It is \w good| strong="H2896" \w* that a man [should both hope]{strong=“H2342 H3175” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675”} \w and quietly wait| strong="H1748" \w* \w for the salvation| strong="H8668" \w* of the \sc Lord\sc*. 
\v 27 It is \w good| strong="H2896" \w* \w for a man| strong="H1397" \w* [that he bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w the yoke| strong="H5923" \w* \w in his youth| strong="H5271" \w*. 
\v 28 [He sitteth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w alone| strong="H910" \w* [and keepeth silence]{strong=“H1826” x-morph=“strongMorph: \sc Th\sc*8799”}, [because he hath borne]{strong=“H5190” x-morph=“strongMorph: \sc Th\sc*8804”} it upon him. 
\v 29 [He putteth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w his mouth| strong="H6310" \w* \w in the dust| strong="H6083" \w*; \w if so be there may be| strong="H3426" \w* \w hope| strong="H8615" \w*. 
\v 30 [He giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} his \w cheek| strong="H3895" \w* [to him that smiteth]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8688”} [him: he is filled full]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”} \w with reproach| strong="H2781" \w*. 
\v 31 \w For the Lord| strong="H136" \w* [will not cast off]{strong=“H2186” x-morph=“strongMorph: \sc Th\sc*8799”} \w for ever| strong="H5769" \w*: 
\v 32 [But though he cause grief]{strong=“H3013” x-morph=“strongMorph: \sc Th\sc*8689”}, [yet will he have compassion]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8765”} \w according to the multitude| strong="H7230" \w* \w of his mercies| strong="H2617" \w*. 
\v 33 [For he doth not afflict]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8765”} \w willingly| strong="H3820" \w* [nor grieve]{strong=“H3013” x-morph=“strongMorph: \sc Th\sc*8762”} \w the children| strong="H1121" \w* \w of men| strong="H376" \w*.\f + \fr 3:33 \ft willingly: Heb. from his heart \f* 
\v 34 [To crush]{strong=“H1792” x-morph=“strongMorph: \sc Th\sc*8763”} \w under his feet| strong="H7272" \w* \w all the prisoners| strong="H615" \w* \w of the earth| strong="H776" \w*, 
\v 35 [To turn aside]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8687”} \w the right| strong="H4941" \w* \w of a man| strong="H1397" \w* \w before the face| strong="H6440" \w* \w of the most High| strong="H5945" \w*,\f + \fr 3:35 \ft the most High: or, a superior \f* 
\v 36 [To subvert]{strong=“H5791” x-morph=“strongMorph: \sc Th\sc*8763”} \w a man| strong="H120" \w* \w in his cause| strong="H7379" \w*, \w the Lord| strong="H136" \w* [approveth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} not.\f + \fr 3:36 \ft approveth not: or, seeth not \f* 
\p
\v 37 Who is he that [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, and it cometh to pass, when \w the Lord| strong="H136" \w* [commandeth]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} it not? 
\v 38 \w Out of the mouth| strong="H6310" \w* \w of the most High| strong="H5945" \w* [proceedeth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w not evil| strong="H7451" \w* \w and good| strong="H2896" \w*? 
\v 39 \w Wherefore doth a living| strong="H2416" \w* \w man| strong="H120" \w* [complain]{strong=“H596” x-morph=“strongMorph: \sc Th\sc*8691”}, \w a man| strong="H1397" \w* \w for the punishment of his sins| strong="H2399" \w*?\f + \fr 3:39 \ft complain: or, murmur \f* 
\v 40 [Let us search]{strong=“H2664” x-morph=“strongMorph: \sc Th\sc*8799”} [and try]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8799”} \w our ways| strong="H1870" \w*, [and turn again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} to the \sc Lord\sc*. 
\v 41 [Let us lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w our heart| strong="H3824" \w* with our \w hands| strong="H3709" \w* \w unto God| strong="H410" \w* \w in the heavens| strong="H8064" \w*. 
\p
\v 42 \w We| strong="H5168" \w* [have transgressed]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8804”} [and have rebelled]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8804”}: [thou hast not pardoned]{strong=“H5545” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 43 [Thou hast covered]{strong=“H5526” x-morph=“strongMorph: \sc Th\sc*8804”} \w with anger| strong="H639" \w*, [and persecuted]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} [us: thou hast slain]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”}, [thou hast not pitied]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 44 [Thou hast covered]{strong=“H5526” x-morph=“strongMorph: \sc Th\sc*8804”} \w thyself with a cloud| strong="H6051" \w*, that our \w prayer| strong="H8605" \w* [should not pass through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 45 [Thou hast made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} us as \w the offscouring| strong="H5501" \w* \w and refuse| strong="H3973" \w* \w in the midst| strong="H7130" \w* \w of the people| strong="H5971" \w*. 
\v 46 [All our enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [have opened]{strong=“H6475” x-morph=“strongMorph: \sc Th\sc*8804”} \w their mouths| strong="H6310" \w* against us. 
\v 47 \w Fear| strong="H6343" \w* \w and a snare| strong="H6354" \w* [is come upon us, desolation]{strong=“H7612”} \w and destruction| strong="H7667" \w*. 
\v 48 \w Mine eye| strong="H5869" \w* [runneth down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w with rivers| strong="H6388" \w* \w of water| strong="H4325" \w* \w for the destruction| strong="H7667" \w* \w of the daughter| strong="H1323" \w* \w of my people| strong="H5971" \w*. 
\v 49 \w Mine eye| strong="H5869" \w* [trickleth down]{strong=“H5064” x-morph=“strongMorph: \sc Th\sc*8738”}, [and ceaseth]{strong=“H1820” x-morph=“strongMorph: \sc Th\sc*8799”} [not, without any intermission]{strong=“H2014”}, 
\v 50 Till the \sc Lord\sc* [look down]{strong=“H8259” x-morph=“strongMorph: \sc Th\sc*8686”}, [and behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w from heaven| strong="H8064" \w*. 
\v 51 \w Mine eye| strong="H5869" \w* [affecteth]{strong=“H5953” x-morph=“strongMorph: \sc Th\sc*8782”} \w mine heart| strong="H5315" \w* \w because of all the daughters| strong="H1323" \w* \w of my city| strong="H5892" \w*.\f + \fr 3:51 \ft mine heart: Heb. my soul \f* \f + \fr 3:51 \ft because…: or, more than all \f* 
\v 52 [Mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [chased]{strong=“H6679” x-morph=“strongMorph: \sc Th\sc*8804”} [me sore]{strong=“H6679” x-morph=“strongMorph: \sc Th\sc*8800”}, \w like a bird| strong="H6833" \w*, \w without cause| strong="H2600" \w*. 
\v 53 [They have cut off]{strong=“H6789” x-morph=“strongMorph: \sc Th\sc*8804”} \w my life| strong="H2416" \w* \w in the dungeon| strong="H953" \w*, [and cast]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8762”} \w a stone| strong="H68" \w* upon me. 
\v 54 \w Waters| strong="H4325" \w* [flowed over]{strong=“H6687” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine head| strong="H7218" \w*; then [I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [I am cut off]{strong=“H1504” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\p
\v 55 [I called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon thy name| strong="H8034" \w*, O \sc Lord\sc*, \w out of the low| strong="H8482" \w* \w dungeon| strong="H953" \w*. 
\v 56 [Thou hast heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w my voice| strong="H6963" \w*: [hide]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8686”} \w not thine ear| strong="H241" \w* \w at my breathing| strong="H7309" \w*, \w at my cry| strong="H7775" \w*. 
\v 57 [Thou drewest near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the day| strong="H3117" \w* that [I called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} [upon thee: thou saidst]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} not. 
\v 58 \w O Lord| strong="H136" \w*, [thou hast pleaded]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8804”} \w the causes| strong="H7379" \w* \w of my soul| strong="H5315" \w*; [thou hast redeemed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8804”} \w my life| strong="H2416" \w*. 
\v 59 O \sc Lord\sc*, [thou hast seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w my wrong| strong="H5792" \w*: [judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou my cause| strong="H4941" \w*. 
\v 60 [Thou hast seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w all their vengeance| strong="H5360" \w* and \w all their imaginations| strong="H4284" \w* against me. 
\v 61 [Thou hast heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w their reproach| strong="H2781" \w*, O \sc Lord\sc*, and \w all their imaginations| strong="H4284" \w* against me; 
\v 62 \w The lips| strong="H8193" \w* [of those that rose up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8801”} [against me, and their device]{strong=“H1902”} \w against me all the day| strong="H3117" \w*. 
\v 63 [Behold]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8685”} [their sitting down]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”}, \w and their rising up| strong="H7012" \w*; I am \w their musick| strong="H4485" \w*. 
\p
\v 64 [Render]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto them a recompence| strong="H1576" \w*, O \sc Lord\sc*, \w according to the work| strong="H4639" \w* \w of their hands| strong="H3027" \w*. 
\v 65 [Give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w them sorrow| strong="H4044" \w* \w of heart| strong="H3820" \w*, \w thy curse| strong="H8381" \w* unto them.\f + \fr 3:65 \ft sorrow…: or, obstinacy of heart \f* 
\v 66 [Persecute]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} [and destroy]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8686”} \w them in anger| strong="H639" \w* \w from under the heavens| strong="H8064" \w* of the \sc Lord\sc*.
\c 4
\p 
\v 1 \w How is the gold| strong="H2091" \w* [become dim]{strong=“H6004” x-morph=“strongMorph: \sc Th\sc*8714”}! how \w is the most| strong="H2896" \w* \w fine gold| strong="H3800" \w* [changed]{strong=“H8132” x-morph=“strongMorph: \sc Th\sc*8799”}! \w the stones| strong="H68" \w* \w of the sanctuary| strong="H6944" \w* [are poured out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8691”} \w in the top| strong="H7218" \w* \w of every street| strong="H2351" \w*. 
\v 2 \w The precious| strong="H3368" \w* \w sons| strong="H1121" \w* \w of Zion| strong="H6726" \w*, [comparable]{strong=“H5537” x-morph=“strongMorph: \sc Th\sc*8794”} \w to fine gold| strong="H6337" \w*, [how are they esteemed]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8738”} \w as earthen| strong="H2789" \w* \w pitchers| strong="H5035" \w*, \w the work| strong="H4639" \w* \w of the hands| strong="H3027" \w* [of the potter]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”}! 
\v 3 \w Even the sea monsters| strong="H8577" \w* [draw out]{strong=“H2502” x-morph=“strongMorph: \sc Th\sc*8804”} \w the breast| strong="H7699" \w*, [they give suck]{strong=“H3243” x-morph=“strongMorph: \sc Th\sc*8689”} \w to their young ones| strong="H1482" \w*: \w the daughter| strong="H1323" \w* \w of my people| strong="H5971" \w* is become \w cruel| strong="H393" \w*, \w like the ostriches| strong="H3283" \w* \w in the wilderness| strong="H4057" \w*.\f + \fr 4:3 \ft sea…: or, sea calves \f* 
\v 4 \w The tongue| strong="H3956" \w* [of the sucking child]{strong=“H3243” x-morph=“strongMorph: \sc Th\sc*8802”} [cleaveth]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the roof of his mouth| strong="H2441" \w* \w for thirst| strong="H6772" \w*: \w the young children| strong="H5768" \w* [ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8804”} \w bread| strong="H3899" \w*, and [no man breaketh]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8802”} it unto them. 
\v 5 [They that did feed]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} \w delicately| strong="H4574" \w* [are desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the streets| strong="H2351" \w*: [they that were brought up]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8803”} \w in scarlet| strong="H8438" \w* [embrace]{strong=“H2263” x-morph=“strongMorph: \sc Th\sc*8765”} \w dunghills| strong="H830" \w*. 
\v 6 \w For the punishment of the iniquity| strong="H5771" \w* \w of the daughter| strong="H1323" \w* \w of my people| strong="H5971" \w* [is greater]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8799”} \w than the punishment| strong="H2403" \w* \w of the sin of Sodom| strong="H5467" \w*, [that was overthrown]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8803”} \w as in a moment| strong="H7281" \w*, \w and no hands| strong="H3027" \w* [stayed]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8804”} on her.\f + \fr 4:6 \ft punishment of the iniquity: or, iniquity \f* 
\v 7 \w Her Nazarites| strong="H5139" \w* [were purer]{strong=“H2141” x-morph=“strongMorph: \sc Th\sc*8804”} \w than snow| strong="H7950" \w*, [they were whiter]{strong=“H6705” x-morph=“strongMorph: \sc Th\sc*8804”} \w than milk| strong="H2461" \w*, [they were more ruddy]{strong=“H119” x-morph=“strongMorph: \sc Th\sc*8804”} \w in body| strong="H6106" \w* \w than rubies| strong="H6443" \w*, \w their polishing| strong="H1508" \w* was \w of sapphire| strong="H5601" \w*: 
\v 8 \w Their visage| strong="H8389" \w* [is blacker]{strong=“H2821” x-morph=“strongMorph: \sc Th\sc*8804”} \w than a coal| strong="H7815" \w*; [they are not known]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the streets| strong="H2351" \w*: \w their skin| strong="H5785" \w* [cleaveth]{strong=“H6821” x-morph=“strongMorph: \sc Th\sc*8804”} \w to their bones| strong="H6106" \w*; [it is withered]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8804”}, \w it is become like a stick| strong="H6086" \w*.\f + \fr 4:8 \ft blacker…: Heb. darker than blackness \f* 
\v 9 They that be \w slain| strong="H2491" \w* \w with the sword| strong="H2719" \w* \w are better| strong="H2896" \w* than they that be \w slain| strong="H2491" \w* \w with hunger| strong="H7458" \w*: \w for these| strong="H1992" \w* [pine away]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8799”}, [stricken]{strong=“H1856” x-morph=“strongMorph: \sc Th\sc*8794”} through for want of \w the fruits| strong="H8570" \w* \w of the field| strong="H7704" \w*.\f + \fr 4:9 \ft pine…: Heb. flow out \f* 
\v 10 \w The hands| strong="H3027" \w* \w of the pitiful| strong="H7362" \w* \w women| strong="H802" \w* [have sodden]{strong=“H1310” x-morph=“strongMorph: \sc Th\sc*8765”} \w their own children| strong="H3206" \w*: [they were their meat]{strong=“H1262” x-morph=“strongMorph: \sc Th\sc*8763”} \w in the destruction| strong="H7667" \w* \w of the daughter| strong="H1323" \w* \w of my people| strong="H5971" \w*. 
\v 11 The \sc Lord\sc* [hath accomplished]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8765”} \w his fury| strong="H2534" \w*; [he hath poured out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8804”} \w his fierce| strong="H2740" \w* \w anger| strong="H639" \w*, [and hath kindled]{strong=“H3341” x-morph=“strongMorph: \sc Th\sc*8686”} \w a fire| strong="H784" \w* \w in Zion| strong="H6726" \w*, [and it hath devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the foundations| strong="H3247" \w* thereof. 
\v 12 \w The kings| strong="H4428" \w* \w of the earth| strong="H776" \w*, [and all the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the world| strong="H8398" \w*, [would not have believed]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8689”} \w that the adversary| strong="H6862" \w* [and the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [should have entered]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the gates| strong="H8179" \w* \w of Jerusalem| strong="H3389" \w*. 
\p
\v 13 \w For the sins| strong="H2403" \w* \w of her prophets| strong="H5030" \w*, and \w the iniquities| strong="H5771" \w* \w of her priests| strong="H3548" \w*, [that have shed]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8802”} \w the blood| strong="H1818" \w* \w of the just| strong="H6662" \w* \w in the midst| strong="H7130" \w* of her, 
\v 14 [They have wandered]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8804”} as \w blind| strong="H5787" \w* men \w in the streets| strong="H2351" \w*, [they have polluted]{strong=“H1351” x-morph=“strongMorph: \sc Th\sc*8738”} \w themselves with blood| strong="H1818" \w*, [so that men could]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} \w not| strong="H3808" \w* [touch]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8799”} \w their garments| strong="H3830" \w*.\f + \fr 4:14 \ft so…: or, in that they could not but touch \f* 
\v 15 [They cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8798”} ye; it is \w unclean| strong="H2931" \w*; [depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8798”}, [depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8798”}, [touch]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8799”} [not: when they fled away]{strong=“H5132” x-morph=“strongMorph: \sc Th\sc*8804”} [and wandered]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8804”}, [they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w among the heathen| strong="H1471" \w*, [They shall no more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8800”} there.\f + \fr 4:15 \ft it…: or, ye polluted \f* 
\v 16 \w The anger| strong="H6440" \w* of the \sc Lord\sc* [hath divided]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8765”} [them; he will no more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [regard]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8687”} [them: they respected]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the persons| strong="H6440" \w* \w of the priests| strong="H3548" \w*, [they favoured]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the elders| strong="H2205" \w*.\f + \fr 4:16 \ft anger: or, face \f* 
\v 17 [As for us, our eyes]{strong=“H5869”} [as yet failed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8799”} \w for our vain| strong="H1892" \w* \w help| strong="H5833" \w*: \w in our watching| strong="H6836" \w* [we have watched]{strong=“H6822” x-morph=“strongMorph: \sc Th\sc*8765”} \w for a nation| strong="H1471" \w* that [could not save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} us. 
\v 18 [They hunt]{strong=“H6679” x-morph=“strongMorph: \sc Th\sc*8804”} \w our steps| strong="H6806" \w*, [that we cannot go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} \w in our streets| strong="H7339" \w*: \w our end| strong="H7093" \w* [is near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8804”}, \w our days| strong="H3117" \w* [are fulfilled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”}; \w for our end| strong="H7093" \w* [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 19 [Our persecutors]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8802”} \w are swifter| strong="H7031" \w* \w than the eagles| strong="H5404" \w* \w of the heaven| strong="H8064" \w*: [they pursued]{strong=“H1814” x-morph=“strongMorph: \sc Th\sc*8804”} \w us upon the mountains| strong="H2022" \w*, [they laid wait]{strong=“H693” x-morph=“strongMorph: \sc Th\sc*8804”} \w for us in the wilderness| strong="H4057" \w*. 
\v 20 \w The breath| strong="H7307" \w* \w of our nostrils| strong="H639" \w*, \w the anointed| strong="H4899" \w* of the \sc Lord\sc*, [was taken]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8738”} \w in their pits| strong="H7825" \w*, [of whom we said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Under his shadow| strong="H6738" \w* [we shall live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”} \w among the heathen| strong="H1471" \w*. 
\p
\v 21 [Rejoice]{strong=“H7797” x-morph=“strongMorph: \sc Th\sc*8798”} [and be glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O daughter| strong="H1323" \w* \w of Edom| strong="H123" \w*, [that dwellest]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the land| strong="H776" \w* \w of Uz| strong="H5780" \w*; \w the cup| strong="H3563" \w* [also shall pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} [through unto thee: thou shalt be drunken]{strong=“H7937” x-morph=“strongMorph: \sc Th\sc*8799”}, [and shalt make thyself naked]{strong=“H6168” x-morph=“strongMorph: \sc Th\sc*8691”}. 
\p
\v 22 \w The punishment of thine iniquity| strong="H5771" \w* [is accomplished]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8804”}, \w O daughter| strong="H1323" \w* \w of Zion| strong="H6726" \w*; [he will no more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [carry thee away into captivity]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8687”}: [he will visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} \w thine iniquity| strong="H5771" \w*, \w O daughter| strong="H1323" \w* \w of Edom| strong="H123" \w*; [he will discover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy sins| strong="H2403" \w*.\f + \fr 4:22 \ft The…: or, Thine iniquity \f* \f + \fr 4:22 \ft discover…: or, carry thee captive for thy sins \f*
\c 5
\p 
\v 1 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”}, O \sc Lord\sc*, [what is come upon us: consider]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8685”}, [and behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w our reproach| strong="H2781" \w*. 
\v 2 \w Our inheritance| strong="H5159" \w* [is turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8738”} [to strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”}, \w our houses| strong="H1004" \w* \w to aliens| strong="H5237" \w*. 
\v 3 \w We are orphans| strong="H3490" \w* [and fatherless]{strong=“H1 H369”}, \w our mothers| strong="H517" \w* are \w as widows| strong="H490" \w*. 
\v 4 [We have drunken]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8804”} \w our water| strong="H4325" \w* \w for money| strong="H3701" \w*; \w our wood| strong="H6086" \w* [is sold]{strong=“H4242 H935” x-morph=“strongMorph: \sc Th\sc*8799”} unto us.\f + \fr 5:4 \ft is…: Heb. cometh for price \f* 
\v 5 \w Our necks| strong="H6677" \w* are [under persecution]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8738”}: [we labour]{strong=“H3021” x-morph=“strongMorph: \sc Th\sc*8804”}, and [have no rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8717”}.\f + \fr 5:5 \ft Our…: Heb. On our necks are we persecuted \f* 
\v 6 [We have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w the hand| strong="H3027" \w* to \w the Egyptians| strong="H4714" \w*, and to \w the Assyrians| strong="H804" \w*, [to be satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8800”} \w with bread| strong="H3899" \w*. 
\v 7 \w Our fathers| strong="H1" \w* [have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}, and are \w not| strong="H369" \w*; [and we have borne]{strong=“H5445” x-morph=“strongMorph: \sc Th\sc*8804”} \w their iniquities| strong="H5771" \w*. 
\v 8 \w Servants| strong="H5650" \w* [have ruled]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8804”} over us: there is [none that doth deliver]{strong=“H6561” x-morph=“strongMorph: \sc Th\sc*8802”} us \w out of their hand| strong="H3027" \w*. 
\v 9 [We gat]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w our bread| strong="H3899" \w* with the peril of \w our lives| strong="H5315" \w* \w because| strong="H6440" \w* \w of the sword| strong="H2719" \w* \w of the wilderness| strong="H4057" \w*. 
\v 10 \w Our skin| strong="H5785" \w* [was black]{strong=“H3648” x-morph=“strongMorph: \sc Th\sc*8738”} \w like an oven| strong="H8574" \w* \w because| strong="H6440" \w* \w of the terrible| strong="H2152" \w* \w famine| strong="H7458" \w*.\f + \fr 5:10 \ft terrible: or, terrors, or, storms \f* 
\v 11 [They ravished]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8765”} \w the women| strong="H802" \w* \w in Zion| strong="H6726" \w*, and \w the maids| strong="H1330" \w* \w in the cities| strong="H5892" \w* \w of Judah| strong="H3063" \w*. 
\v 12 \w Princes| strong="H8269" \w* [are hanged up]{strong=“H8518” x-morph=“strongMorph: \sc Th\sc*8738”} \w by their hand| strong="H3027" \w*: \w the faces| strong="H6440" \w* \w of elders| strong="H2205" \w* [were not honoured]{strong=“H1921” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 13 [They took]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w the young men| strong="H970" \w* \w to grind| strong="H2911" \w*, \w and the children| strong="H5288" \w* [fell]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8804”} \w under the wood| strong="H6086" \w*. 
\v 14 \w The elders| strong="H2205" \w* [have ceased]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8804”} \w from the gate| strong="H8179" \w*, \w the young men| strong="H970" \w* \w from their musick| strong="H5058" \w*. 
\v 15 \w The joy| strong="H4885" \w* \w of our heart| strong="H3820" \w* [is ceased]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8804”}; \w our dance| strong="H4234" \w* [is turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8738”} \w into mourning| strong="H60" \w*. 
\v 16 \w The crown| strong="H5850" \w* [is fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} from \w our head| strong="H7218" \w*: \w woe| strong="H188" \w* [unto us, that we have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}!\f + \fr 5:16 \ft The…: Heb. The crown of our head is fallen \f* 
\p
\v 17 \w For this our heart| strong="H3820" \w* \w is faint| strong="H1739" \w*; for these things \w our eyes| strong="H5869" \w* [are dim]{strong=“H2821” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 18 \w Because of the mountain| strong="H2022" \w* \w of Zion| strong="H6726" \w*, [which is desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the foxes| strong="H7776" \w* [walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8765”} upon it. 
\v 19 Thou, O \sc Lord\sc*, [remainest ]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w for ever| strong="H5769" \w*; \w thy throne| strong="H3678" \w* \w from generation| strong="H1755" \w* \w to generation| strong="H1755" \w*. 
\v 20 [Wherefore dost thou forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} \w us for ever| strong="H5331" \w*, and [forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w us so long| strong="H753" \w* \w time| strong="H3117" \w*?\f + \fr 5:20 \ft so…: Heb. for length of days? \f* 
\v 21 [Turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”} thou us unto thee, O \sc Lord\sc*, [and we shall be turned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}; [renew]{strong=“H2318” x-morph=“strongMorph: \sc Th\sc*8761”} \w our days| strong="H3117" \w* \w as of old| strong="H6924" \w*. 
\v 22 [But thou hast utterly]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8800”} [rejected]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} [us; thou art very]{strong=“H3966”} [wroth]{strong=“H7107” x-morph=“strongMorph: \sc Th\sc*8804”} against us.\f + \fr 5:22 \ft But…: or, For wilt thou utterly reject us? \f* 
