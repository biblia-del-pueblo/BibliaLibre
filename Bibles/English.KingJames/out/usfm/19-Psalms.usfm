\v 5 [They saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} it, and [so they marvelled]{strong=“H8539” x-morph=“strongMorph: \sc Th\sc*8804”}; [they were troubled]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8738”}, and [hasted away]{strong=“H2648” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 6 \w Fear| strong="H7461" \w* [took hold]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8804”} upon them there, and \w pain| strong="H2427" \w*, [as of a woman in travail]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 7 [Thou breakest]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8762”} \w the ships| strong="H591" \w* \w of Tarshish| strong="H8659" \w* \w with an east| strong="H6921" \w* \w wind| strong="H7307" \w*. 
