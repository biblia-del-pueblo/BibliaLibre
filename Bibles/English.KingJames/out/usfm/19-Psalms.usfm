\c 47
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w A Psalm| strong="H4210" \w* \w for the sons| strong="H1121" \w* \w of Korah| strong="H7141" \w*. 
\v 1 [O clap]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8798”} \w your hands| strong="H3709" \w*, \w all ye people| strong="H5971" \w*; [shout]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto God| strong="H430" \w* \w with the voice| strong="H6963" \w* \w of triumph| strong="H7440" \w*.\f + \fr 47:1 \ft for: or, of \f* 
\v 2 For the \sc Lord\sc* \w most high| strong="H5945" \w* is [terrible]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”}; he is \w a great| strong="H1419" \w* \w King| strong="H4428" \w* \w over all the earth| strong="H776" \w*. 
\v 3 [He shall subdue]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8686”} \w the people| strong="H5971" \w* [under us, and the nations]{strong=“H3816”} \w under our feet| strong="H7272" \w*. 
