\v 4 [He shall judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w the poor| strong="H6041" \w* \w of the people| strong="H5971" \w*, [he shall save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} \w the children| strong="H1121" \w* \w of the needy| strong="H34" \w*, [and shall break in pieces]{strong=“H1792” x-morph=“strongMorph: \sc Th\sc*8762”} [the oppressor]{strong=“H6231” x-morph=“strongMorph: \sc Th\sc*8802”}. 
