\v 8 [And he shall judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w the world| strong="H8398" \w* \w in righteousness| strong="H6664" \w*, [he shall minister judgment]{strong=“H1777” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the people| strong="H3816" \w* \w in uprightness| strong="H4339" \w*. 
\v 9 The \sc Lord\sc* \w also will be a refuge| strong="H4869" \w* \w for the oppressed| strong="H1790" \w*, \w a refuge| strong="H4869" \w* \w in times| strong="H6256" \w* \w of trouble| strong="H6869" \w*.\f + \fr 9:9 \ft a refuge: Heb. an high place \f* 
\v 10 [And they that know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w thy name| strong="H8034" \w* [will put their trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} in thee: for thou, \sc Lord\sc*, [hast not forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} [them that seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8802”} thee. 
\v 11 [Sing praises]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8761”} to the \sc Lord\sc*, [which dwelleth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in Zion| strong="H6726" \w*: [declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”} \w among the people| strong="H5971" \w* \w his doings| strong="H5949" \w*. 
\v 12 [When he maketh inquisition]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8802”} \w for blood| strong="H1818" \w*, [he remembereth]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} [them: he forgetteth]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the cry| strong="H6818" \w* [of the humble]{strong=“H6041 H6035” x-morph=“strongMorph: \sc Th\sc*8675”}.\f + \fr 9:12 \ft humble: or, afflicted \f* 
\v 13 [Have mercy]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} upon me, O \sc Lord\sc*; [consider]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w my trouble| strong="H6040" \w* which I suffer [of them that hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} [me, thou that liftest me up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8789”} \w from the gates| strong="H8179" \w* \w of death| strong="H4194" \w*: 
\v 14 [That I may shew forth]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} \w all thy praise| strong="H8416" \w* \w in the gates| strong="H8179" \w* \w of the daughter| strong="H1323" \w* \w of Zion| strong="H6726" \w*: [I will rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy salvation| strong="H3444" \w*. 
\v 15 \w The heathen| strong="H1471" \w* [are sunk down]{strong=“H2883” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the pit| strong="H7845" \w* that [they made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}: \w in the net| strong="H7568" \w* \w which| strong="H2098" \w* [they hid]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8804”} \w is their own foot| strong="H7272" \w* [taken]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 16 The \sc Lord\sc* [is known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8738”} by \w the judgment| strong="H4941" \w* which [he executeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}: \w the wicked| strong="H7563" \w* [is snared]{strong=“H5367” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the work| strong="H6467" \w* \w of his own hands| strong="H3709" \w*. \w Higgaion| strong="H1902" \w*. \w Selah| strong="H5542" \w*.\f + \fr 9:16 \ft Higgaion: that is, Meditation \f* 
\v 17 \w The wicked| strong="H7563" \w* [shall be turned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w into hell| strong="H7585" \w*, and \w all the nations| strong="H1471" \w* \w that forget| strong="H7913" \w* \w God| strong="H430" \w*. 
\v 18 \w For the needy| strong="H34" \w* \w shall not alway| strong="H5331" \w* [be forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8735”}: \w the expectation| strong="H8615" \w* [of the poor]{strong=“H6035 H6041” x-morph=“strongMorph: \sc Th\sc*8675”} shall not [perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”} \w for ever| strong="H5703" \w*. 
\v 19 [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, O \sc Lord\sc*; \w let not man| strong="H582" \w* [prevail]{strong=“H5810” x-morph=“strongMorph: \sc Th\sc*8799”}: \w let the heathen| strong="H1471" \w* [be judged]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8735”} \w in thy sight| strong="H6440" \w*. 
\v 20 [Put]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8798”} [them in fear]{strong=“H4172 H4172” x-morph=“strongMorph: \sc Th\sc*8675”}, O \sc Lord\sc*: that \w the nations| strong="H1471" \w* [may know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} themselves to be but \w men| strong="H582" \w*. \w Selah| strong="H5542" \w*.
\c 10
\p 
\v 1 [Why standest]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w thou afar off| strong="H7350" \w*, O \sc Lord\sc*? why [hidest]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8686”} thou thyself \w in times| strong="H6256" \w* \w of trouble| strong="H6869" \w*? 
\v 2 \w The wicked| strong="H7563" \w* in his \w pride| strong="H1346" \w* [doth persecute]{strong=“H1814” x-morph=“strongMorph: \sc Th\sc*8799”} \w the poor| strong="H6041" \w*: [let them be taken]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the devices| strong="H4209" \w* \w that| strong="H2098" \w* [they have imagined]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 10:2 \ft The wicked…: Heb. In the pride of the wicked he doth persecute \f* 
\v 3 \w For the wicked| strong="H7563" \w* [boasteth]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8765”} [of his heart’s]{strong=“H5315”} \w desire| strong="H8378" \w*, [and blesseth]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} [the covetous]{strong=“H1214” x-morph=“strongMorph: \sc Th\sc*8802”}, whom the \sc Lord\sc* [abhorreth]{strong=“H5006” x-morph=“strongMorph: \sc Th\sc*8765”}.\f + \fr 10:3 \ft heart’s: Heb. soul’s \f* ^\sc 10:3 blesseth…: or, the covetous blesseth himself, he abhorreth the [Lord\sc*] 
\v 4 \w The wicked| strong="H7563" \w*, \w through the pride| strong="H1363" \w* \w of his countenance| strong="H639" \w*, [will not seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”} after God: \w God| strong="H430" \w* is \w not in all his thoughts| strong="H4209" \w*.\f + \fr 10:4 \ft God is…: or, all his thoughts are, There is no God \f* 
\v 5 \w His ways| strong="H1870" \w* \w are always| strong="H6256" \w* [grievous]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8799”}; \w thy judgments| strong="H4941" \w* are \w far above| strong="H4791" \w* out of his sight: as for [all his enemies]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8802”}, [he puffeth]{strong=“H6315” x-morph=“strongMorph: \sc Th\sc*8686”} at them. 
\v 6 [He hath said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his heart| strong="H3820" \w*, [I shall not be moved]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8735”}: for I shall [never]{strong=“H1755 H1755”} be \w in adversity| strong="H7451" \w*.\f + \fr 10:6 \ft never: Heb. unto generation and generation \f* 
\v 7 \w His mouth| strong="H6310" \w* [is full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of cursing| strong="H423" \w* \w and deceit| strong="H4820" \w* \w and fraud| strong="H8496" \w*: \w under his tongue| strong="H3956" \w* is \w mischief| strong="H5999" \w* \w and vanity| strong="H205" \w*.\f + \fr 10:7 \ft deceit: Heb. deceits \f* \f + \fr 10:7 \ft vanity: or, iniquity \f* 
\v 8 [He sitteth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the lurking places| strong="H3993" \w* \w of the villages| strong="H2691" \w*: \w in the secret places| strong="H4565" \w* [doth he murder]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} \w the innocent| strong="H5355" \w*: \w his eyes| strong="H5869" \w* [are privily set]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8799”} \w against the poor| strong="H2489" \w*.\f + \fr 10:8 \ft are…: Heb. hide themselves \f* 
\v 9 [He lieth in wait]{strong=“H693” x-morph=“strongMorph: \sc Th\sc*8799”} \w secretly| strong="H4565" \w* \w as a lion| strong="H738" \w* \w in his den| strong="H5520" \w*: [he lieth in wait]{strong=“H693” x-morph=“strongMorph: \sc Th\sc*8799”} [to catch]{strong=“H2414” x-morph=“strongMorph: \sc Th\sc*8800”} \w the poor| strong="H6041" \w*: [he doth catch]{strong=“H2414” x-morph=“strongMorph: \sc Th\sc*8799”} \w the poor| strong="H6041" \w*, [when he draweth]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8800”} \w him into his net| strong="H7568" \w*.\f + \fr 10:9 \ft secretly: Heb. in the secret places \f* 
\v 10 [He croucheth]{strong=“H1794” x-morph=“strongMorph: \sc Th\sc*8799”}, and [humbleth]{strong=“H7817” x-morph=“strongMorph: \sc Th\sc*8799”} [himself, that the poor]{strong=“H2489 H2489 H2426” x-morph=“strongMorph: \sc Th\sc*8676 strongMorph: \sc Th\sc*8675”} [may fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} \w by his strong ones| strong="H6099" \w*.\f + \fr 10:10 \ft He…: Heb. He breaketh himself \f* \f + \fr 10:10 \ft by…: or, into his strong parts \f* 
\v 11 [He hath said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his heart| strong="H3820" \w*, \w God| strong="H410" \w* [hath forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”}: [he hideth]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8689”} \w his face| strong="H6440" \w*; \w he will never| strong="H5331" \w* [see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} it. 
\v 12 [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, O \sc Lord\sc*; \w O God| strong="H410" \w*, [lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w thine hand| strong="H3027" \w*: [forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} [not the humble]{strong=“H6041 H6035” x-morph=“strongMorph: \sc Th\sc*8675”}.\f + \fr 10:12 \ft humble: or, afflicted \f* 
\v 13 \w Wherefore doth the wicked| strong="H7563" \w* [contemn]{strong=“H5006” x-morph=“strongMorph: \sc Th\sc*8765”} \w God| strong="H430" \w*? [he hath said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his heart| strong="H3820" \w*, [Thou wilt not require]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\v 14 [Thou hast seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} it; [for thou beholdest]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”} \w mischief| strong="H5999" \w* \w and spite| strong="H3708" \w*, [to requite]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} it \w with thy hand| strong="H3027" \w*: \w the poor| strong="H2489" \w* [committeth]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} [himself unto thee; thou art the helper]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the fatherless| strong="H3490" \w*.\f + \fr 10:14 \ft committeth: Heb. leaveth \f* 
\v 15 [Break]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou the arm| strong="H2220" \w* \w of the wicked| strong="H7563" \w* \w and the evil| strong="H7451" \w* man: [seek out]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”} \w his wickedness| strong="H7562" \w* till [thou find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w none| strong="H1077" \w*. 
\v 16 The \sc Lord\sc* is \w King| strong="H4428" \w* \w for ever| strong="H5769" \w* \w and ever| strong="H5703" \w*: \w the heathen| strong="H1471" \w* [are perished]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”} \w out of his land| strong="H776" \w*. 
\v 17 \sc Lord\sc*, [thou hast heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the desire| strong="H8378" \w* \w of the humble| strong="H6035" \w*: [thou wilt prepare]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8686”} \w their heart| strong="H3820" \w*, \w thou wilt cause thine ear| strong="H241" \w* [to hear]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8686”}:\f + \fr 10:17 \ft prepare: or, establish \f* 
\v 18 [To judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8800”} \w the fatherless| strong="H3490" \w* \w and the oppressed| strong="H1790" \w*, \w that the man| strong="H582" \w* \w of the earth| strong="H776" \w* [may no more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [oppress]{strong=“H6206” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 10:18 \ft oppress: or, terrify \f*
\c 11
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, A Psalm \w of David| strong="H1732" \w*. 
\v 1 In the \sc Lord\sc* [put I my trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8804”}: [how say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w ye to my soul| strong="H5315" \w*, [Flee]{strong=“H5110” x-morph=“strongMorph: \sc Th\sc*8798”} as \w a bird| strong="H6833" \w* \w to your mountain| strong="H2022" \w*? 
\v 2 [For, lo, the wicked]{strong=“H7563”} [bend]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8799”} their \w bow| strong="H7198" \w*, [they make ready]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8790”} \w their arrow| strong="H2671" \w* \w upon the string| strong="H3499" \w*, [that they may privily]{strong=“H1119 H652” x-morph=“strongMorph: \sc Th\sc*8676”} [shoot]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8800”} \w at the upright| strong="H3477" \w* \w in heart| strong="H3820" \w*.\f + \fr 11:2 \ft privily: Heb. in darkness \f* 
\v 3 \w If the foundations| strong="H8356" \w* [be destroyed]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8735”}, \w what can the righteous| strong="H6662" \w* [do]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8804”}? 
\v 4 The \sc Lord\sc* is \w in his holy| strong="H6944" \w* \w temple| strong="H1964" \w*, the \sc Lord\sc*’S \w throne| strong="H3678" \w* is \w in heaven| strong="H8064" \w*: \w his eyes| strong="H5869" \w* [behold]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8799”}, \w his eyelids| strong="H6079" \w* [try]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8799”}, \w the children| strong="H1121" \w* \w of men| strong="H120" \w*. 
\v 5 The \sc Lord\sc* [trieth]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8799”} \w the righteous| strong="H6662" \w*: \w but the wicked| strong="H7563" \w* [and him that loveth]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} \w violence| strong="H2555" \w* \w his soul| strong="H5315" \w* [hateth]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 6 \w Upon the wicked| strong="H7563" \w* [he shall rain]{strong=“H4305” x-morph=“strongMorph: \sc Th\sc*8686”} \w snares| strong="H6341" \w*, \w fire| strong="H784" \w* \w and brimstone| strong="H1614" \w*, \w and an horrible| strong="H2152" \w* \w tempest| strong="H7307" \w*: this shall be \w the portion| strong="H4521" \w* \w of their cup| strong="H3563" \w*.\f + \fr 11:6 \ft an horrible…: or, a burning tempest \f* 
\v 7 \w For the righteous| strong="H6662" \w* \sc Lord\sc* [loveth]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} \w righteousness| strong="H6666" \w*; \w his countenance| strong="H6440" \w* [doth behold]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8799”} \w the upright| strong="H3477" \w*.
\c 12
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} \w upon Sheminith| strong="H8067" \w*, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 [Help]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”}, \sc Lord\sc*; \w for the godly man| strong="H2623" \w* [ceaseth]{strong=“H1584” x-morph=“strongMorph: \sc Th\sc*8804”}; [for the faithful]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8803”} [fail]{strong=“H6461” x-morph=“strongMorph: \sc Th\sc*8804”} \w from among the children| strong="H1121" \w* \w of men| strong="H120" \w*.\f + \fr 12:1 \ft upon…: or, upon the eighth \f* \f + \fr 12:1 \ft Help: or, Save \f* 
\v 2 [They speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w vanity| strong="H7723" \w* \w every one| strong="H376" \w* \w with his neighbour| strong="H7453" \w*: with \w flattering| strong="H2513" \w* \w lips| strong="H8193" \w* and \w with a double| strong="H3820" \w* \w heart| strong="H3820" \w* [do they speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}.\f + \fr 12:2 \ft a double…: Heb. an heart and an heart \f* 
\v 3 The \sc Lord\sc* [shall cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8686”} \w all flattering| strong="H2513" \w* \w lips| strong="H8193" \w*, and \w the tongue| strong="H3956" \w* [that speaketh]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8764”} \w proud| strong="H1419" \w* things:\f + \fr 12:3 \ft proud: Heb. great \f* 
\v 4 [Who have said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w With our tongue| strong="H3956" \w* [will we prevail]{strong=“H1396” x-morph=“strongMorph: \sc Th\sc*8686”}; \w our lips| strong="H8193" \w* are our own: who is \w lord| strong="H113" \w* over us?\f + \fr 12:4 \ft are…: Heb. are with us \f* 
\v 5 \w For the oppression| strong="H7701" \w* \w of the poor| strong="H6041" \w*, \w for the sighing| strong="H603" \w* \w of the needy| strong="H34" \w*, [now will I arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc*; [I will set]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} him \w in safety| strong="H3468" \w* from him that [puffeth]{strong=“H6315” x-morph=“strongMorph: \sc Th\sc*8686”} at him.\f + \fr 12:5 \ft puffeth…: or, would ensnare him \f* 
\v 6 \w The words| strong="H565" \w* of the \sc Lord\sc* are \w pure| strong="H2889" \w* \w words| strong="H565" \w*: as \w silver| strong="H3701" \w* [tried]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8803”} \w in a furnace| strong="H5948" \w* \w of earth| strong="H776" \w*, [purified]{strong=“H2212” x-morph=“strongMorph: \sc Th\sc*8794”} \w seven times| strong="H7659" \w*. 
\v 7 [Thou shalt keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} them, O \sc Lord\sc*, [thou shalt preserve]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8799”} \w them from this| strong="H2098" \w* \w generation| strong="H1755" \w* \w for ever| strong="H5769" \w*.\f + \fr 12:7 \ft them from: Heb. him, etc: that is, every one of them, etc \f* 
\v 8 \w The wicked| strong="H7563" \w* [walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8691”} \w on every side| strong="H5439" \w*, \w when the vilest| strong="H2149" \w* [men]{strong=“H120 H1121”} [are exalted]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 12:8 \ft men: Heb. of the sons of the men \f*
\c 13
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 [How long wilt thou forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} me, O \sc Lord\sc*? \w for ever| strong="H5331" \w*? [how long wilt thou hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy face| strong="H6440" \w* from me?\f + \fr 13:1 \ft chief…: or, overseer \f* 
\v 2 [How long shall I take]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w counsel| strong="H6098" \w* \w in my soul| strong="H5315" \w*, having \w sorrow| strong="H3015" \w* \w in my heart| strong="H3824" \w* \w daily| strong="H3119" \w*? [how long shall mine enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [be exalted]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8799”} over me? 
\v 3 [Consider]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8685”} and [hear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8798”} me, O \sc Lord\sc* \w my God| strong="H430" \w*: [lighten]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8685”} \w mine eyes| strong="H5869" \w*, [lest I sleep]{strong=“H3462” x-morph=“strongMorph: \sc Th\sc*8799”} the sleep of \w death| strong="H4194" \w*; 
\v 4 [Lest mine enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I have prevailed]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8804”} against him; and \w those that trouble| strong="H6862" \w* [me rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”} [when I am moved]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 5 [But I have trusted]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thy mercy| strong="H2617" \w*; \w my heart| strong="H3820" \w* [shall rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy salvation| strong="H3444" \w*. 
\v 6 [I will sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc*, [because he hath dealt bountifully]{strong=“H1580” x-morph=“strongMorph: \sc Th\sc*8804”} with me.
\c 14
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, A Psalm \w of David| strong="H1732" \w*. 
\v 1 \w The fool| strong="H5036" \w* [hath said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his heart| strong="H3820" \w*, There is \w no God| strong="H430" \w*. [They are corrupt]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8689”}, [they have done abominable]{strong=“H8581” x-morph=“strongMorph: \sc Th\sc*8689”} \w works| strong="H5949" \w*, there is [none that doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w good| strong="H2896" \w*. 
\v 2 The \sc Lord\sc* [looked down]{strong=“H8259” x-morph=“strongMorph: \sc Th\sc*8689”} \w from heaven| strong="H8064" \w* \w upon the children| strong="H1121" \w* \w of men| strong="H120" \w*, [to see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w if there| strong="H3426" \w* [were any that did understand]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8688”}, and [seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8802”} \w God| strong="H430" \w*. 
\v 3 [They are all gone aside]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8804”}, they are all \w together| strong="H3162" \w* [become filthy]{strong=“H444” x-morph=“strongMorph: \sc Th\sc*8738”}: there is [none that doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w good| strong="H2896" \w*, [no, not one]{strong=“H259”}.\f + \fr 14:3 \ft filthy: Heb. stinking \f* 
\v 4 [Have all the workers]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w of iniquity| strong="H205" \w* [no knowledge]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}? [who eat up]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} \w my people| strong="H5971" \w* as [they eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w bread| strong="H3899" \w*, [and call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} not upon the \sc Lord\sc*. 
\v 5 \w There were they in great| strong="H6343" \w* [fear]{strong=“H6342” x-morph=“strongMorph: \sc Th\sc*8804”}: \w for God| strong="H430" \w* is \w in the generation| strong="H1755" \w* \w of the righteous| strong="H6662" \w*.\f + \fr 14:5 \ft were…: Heb. they feared a fear \f* 
\v 6 [Ye have shamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8686”} \w the counsel| strong="H6098" \w* \w of the poor| strong="H6041" \w*, because the \sc Lord\sc* is \w his refuge| strong="H4268" \w*. 
\v 7 [Oh that]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w the salvation| strong="H3444" \w* \w of Israel| strong="H3478" \w* were come \w out of Zion| strong="H6726" \w*! when the \sc Lord\sc* [bringeth back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w the captivity| strong="H7622" \w* \w of his people| strong="H5971" \w*, \w Jacob| strong="H3290" \w* [shall rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”}, and \w Israel| strong="H3478" \w* [shall be glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 14:7 \ft Oh…: Heb. Who will give \f*
\c 15
\p 
\w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 \sc Lord\sc*, [who shall abide]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy tabernacle| strong="H168" \w*? [who shall dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy holy| strong="H6944" \w* \w hill| strong="H2022" \w*?\f + \fr 15:1 \ft abide: Heb. sojourn \f* 
\v 2 [He that walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w uprightly| strong="H8549" \w*, [and worketh]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w righteousness| strong="H6664" \w*, [and speaketh]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} \w the truth| strong="H571" \w* \w in his heart| strong="H3824" \w*. 
\v 3 He that [backbiteth]{strong=“H7270” x-morph=“strongMorph: \sc Th\sc*8804”} \w not with his tongue| strong="H3956" \w*, [nor doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w evil| strong="H7451" \w* \w to his neighbour| strong="H7453" \w*, [nor taketh up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w a reproach| strong="H2781" \w* \w against his neighbour| strong="H7138" \w*.\f + \fr 15:3 \ft taketh…: or, receiveth, or, endureth \f* 
\v 4 \w In whose eyes| strong="H5869" \w* [a vile person]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8737”} [is contemned]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8737”}; [but he honoureth]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8762”} \w them that fear| strong="H3373" \w* the \sc Lord\sc*. He that [sweareth]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} to his own [hurt]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8687”}, [and changeth]{strong=“H4171” x-morph=“strongMorph: \sc Th\sc*8686”} not. 
\v 5 He that [putteth not out]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w his money| strong="H3701" \w* \w to usury| strong="H5392" \w*, [nor taketh]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w reward| strong="H7810" \w* \w against the innocent| strong="H5355" \w*. [He that doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} these things \w shall never| strong="H5769" \w* [be moved]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8735”}.
\c 16
\p 
\w Michtam| strong="H4387" \w* \w of David| strong="H1732" \w*. 
\v 1 [Preserve]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8798”} [me, O God]{strong=“H410”}: [for in thee do I put my trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 16:1 \ft Michtam: or, A golden Psalm \f* 
\v 2 O my soul, [thou hast said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} unto the \sc Lord\sc*, Thou art \w my Lord| strong="H136" \w*: \w my goodness| strong="H2896" \w* extendeth not to thee; 
\v 3 But \w to the saints| strong="H6918" \w* \w that| strong="H1992" \w* are \w in the earth| strong="H776" \w*, and to \w the excellent| strong="H117" \w*, in whom is \w all my delight| strong="H2656" \w*. 
\v 4 \w Their sorrows| strong="H6094" \w* [shall be multiplied]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8799”} that [hasten]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8804”} after \w another| strong="H312" \w* god: \w their drink offerings| strong="H5262" \w* \w of blood| strong="H1818" \w* [will I not offer]{strong=“H5258” x-morph=“strongMorph: \sc Th\sc*8686”}, \w nor| strong="H1077" \w* [take up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their names| strong="H8034" \w* \w into my lips| strong="H8193" \w*.\f + \fr 16:4 \ft hasten…: or, give gifts to another \f* 
\v 5 The \sc Lord\sc* is \w the portion| strong="H4490" \w* \w of mine inheritance| strong="H2506" \w* \w and of my cup| strong="H3563" \w*: [thou maintainest]{strong=“H8551” x-morph=“strongMorph: \sc Th\sc*8802”} \w my lot| strong="H1486" \w*.\f + \fr 16:5 \ft of mine…: Heb. of my part \f* 
\v 6 \w The lines| strong="H2256" \w* [are fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto me in pleasant| strong="H5273" \w* places; [yea, I have a goodly]{strong=“H8231” x-morph=“strongMorph: \sc Th\sc*8804”} \w heritage| strong="H5159" \w*. 
\v 7 [I will bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} the \sc Lord\sc*, [who hath given me counsel]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8804”}: \w my reins| strong="H3629" \w* [also instruct]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8765”} \w me in the night seasons| strong="H3915" \w*. 
\v 8 [I have set]{strong=“H7737” x-morph=“strongMorph: \sc Th\sc*8765”} the \sc Lord\sc* \w always| strong="H8548" \w* before me: because he is \w at my right hand| strong="H3225" \w*, [I shall not be moved]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 9 \w Therefore my heart| strong="H3820" \w* [is glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and my glory| strong="H3519" \w* [rejoiceth]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”}: \w my flesh| strong="H1320" \w* [also shall rest]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} \w in hope| strong="H983" \w*.\f + \fr 16:9 \ft rest…: Heb. dwell confidently \f* 
\v 10 [For thou wilt not leave]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w my soul| strong="H5315" \w* \w in hell| strong="H7585" \w*; [neither wilt thou suffer]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thine Holy One| strong="H2623" \w* [to see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w corruption| strong="H7845" \w*. 
\v 11 [Thou wilt shew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8686”} \w me the path| strong="H734" \w* \w of life| strong="H2416" \w*: \w in thy presence| strong="H6440" \w* is \w fulness| strong="H7648" \w* \w of joy| strong="H8057" \w*; \w at thy right hand| strong="H3225" \w* there are \w pleasures| strong="H5273" \w* \w for evermore| strong="H5331" \w*.
\c 17
\p 
\w A Prayer| strong="H8605" \w* \w of David| strong="H1732" \w*. 
\v 1 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the right| strong="H6664" \w*, O \sc Lord\sc*, [attend]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto my cry| strong="H7440" \w*, [give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto my prayer| strong="H8605" \w*, that goeth \w not| strong="H3808" \w* \w out of feigned| strong="H4820" \w* \w lips| strong="H8193" \w*.\f + \fr 17:1 \ft the right: Heb. justice \f* \f + \fr 17:1 \ft not…: Heb. without lips of deceit \f* 
\v 2 \w Let my sentence| strong="H4941" \w* [come forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w from thy presence| strong="H6440" \w*; \w let thine eyes| strong="H5869" \w* [behold]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8799”} \w the things that are equal| strong="H4339" \w*. 
\v 3 [Thou hast proved]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine heart| strong="H3820" \w*; [thou hast visited]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} me \w in the night| strong="H3915" \w*; [thou hast tried]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8804”} me, and [shalt find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} [nothing; I am purposed]{strong=“H2161” x-morph=“strongMorph: \sc Th\sc*8800”} that \w my mouth| strong="H6310" \w* [shall not transgress]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 4 \w Concerning the works| strong="H6468" \w* \w of men| strong="H120" \w*, \w by the word| strong="H1697" \w* \w of thy lips| strong="H8193" \w* [I have kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} me from \w the paths| strong="H734" \w* \w of the destroyer| strong="H6530" \w*. 
\v 5 [Hold up]{strong=“H8551” x-morph=“strongMorph: \sc Th\sc*8800”} \w my goings| strong="H838" \w* \w in thy paths| strong="H4570" \w*, that \w my footsteps| strong="H6471" \w* [slip]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8738”} not.\f + \fr 17:5 \ft slip…: Heb. be not moved \f* 
\v 6 [I have called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [upon thee, for thou wilt hear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [me, O God]{strong=“H410”}: [incline]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8685”} \w thine ear| strong="H241" \w* unto me, and hear \w my speech| strong="H565" \w*. 
\v 7 [Shew thy marvellous]{strong=“H6395” x-morph=“strongMorph: \sc Th\sc*8685”} \w lovingkindness| strong="H2617" \w*, [O thou that savest]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8688”} \w by thy right hand| strong="H3225" \w* [them which put their trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8802”} in thee [from those that rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8693”} against them.\f + \fr 17:7 \ft by thy…: or, them which trust in thee from those that rise up against thy right hand \f* 
\v 8 [Keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8798”} \w me as the apple| strong="H380" \w* [of the eye]{strong=“H5869 H1323”}, [hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8686”} \w me under the shadow| strong="H6738" \w* \w of thy wings| strong="H3671" \w*, 
\v 9 \w From| strong="H6440" \w* \w the wicked| strong="H7563" \w* \w that| strong="H2098" \w* [oppress]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8804”} me, from \w my deadly| strong="H5315" \w* [enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, who [compass me about]{strong=“H5362” x-morph=“strongMorph: \sc Th\sc*8686”}.\f + \fr 17:9 \ft oppress: Heb. waste \f* \f + \fr 17:9 \ft my…: Heb. my enemies against the soul \f* 
\v 10 [They are inclosed]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8804”} \w in their own fat| strong="H2459" \w*: \w with their mouth| strong="H6310" \w* [they speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w proudly| strong="H1348" \w*. 
\v 11 [They have now compassed]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8804”} \w us in our steps| strong="H838" \w*: [they have set]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w their eyes| strong="H5869" \w* [bowing down]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8800”} \w to the earth| strong="H776" \w*; 
\v 12 \w Like| strong="H1825" \w* \w as a lion| strong="H738" \w* that [is greedy]{strong=“H3700” x-morph=“strongMorph: \sc Th\sc*8799”} [of his prey]{strong=“H2963” x-morph=“strongMorph: \sc Th\sc*8800”}, \w and as it were a young lion| strong="H3715" \w* [lurking]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in secret places| strong="H4565" \w*.\f + \fr 17:12 \ft Like…: Heb. The likeness of him (that is, of every one of them) is as a lion that desireth to ravin \f* \f + \fr 17:12 \ft lurking: Heb. sitting \f* 
\v 13 [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, O \sc Lord\sc*, [disappoint]{strong=“H6923” x-morph=“strongMorph: \sc Th\sc*8761”} \w him| strong="H6440" \w*, [cast him down]{strong=“H3766” x-morph=“strongMorph: \sc Th\sc*8685”}: [deliver]{strong=“H6403” x-morph=“strongMorph: \sc Th\sc*8761”} \w my soul| strong="H5315" \w* \w from the wicked| strong="H7563" \w*, which is \w thy sword| strong="H2719" \w*:\f + \fr 17:13 \ft disappoint…: Heb. prevent his face \f* \f + \fr 17:13 \ft which is: or, by \f* 
\v 14 \w From men| strong="H4962" \w* which are \w thy hand| strong="H3027" \w*, O \sc Lord\sc*, \w from men| strong="H4962" \w* \w of the world| strong="H2465" \w*, which have \w their portion| strong="H2506" \w* in this \w life| strong="H2416" \w*, \w and whose belly| strong="H990" \w* [thou fillest]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8762”} \w with thy hid| strong="H6840" \w* treasure: [they are full]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”} \w of children| strong="H1121" \w*, [and leave]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8689”} \w the rest| strong="H3499" \w* of their substance \w to their babes| strong="H5768" \w*.\f + \fr 17:14 \ft which are: or, by \f* \f + \fr 17:14 \ft they…: or, their children are full \f* 
\v 15 [As for me, I will behold]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy face| strong="H6440" \w* \w in righteousness| strong="H6664" \w*: [I shall be satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”}, [when I awake]{strong=“H6974” x-morph=“strongMorph: \sc Th\sc*8687”}, \w with thy likeness| strong="H8544" \w*.
\c 18
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, A Psalm \w of David| strong="H1732" \w*, \w the servant| strong="H5650" \w* of the \sc Lord\sc*, [who spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} unto the \sc Lord\sc* \w the words| strong="H1697" \w* \w of this song| strong="H7892" \w* \w in the day| strong="H3117" \w* that the \sc Lord\sc* [delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w him from the hand| strong="H3709" \w* [of all his enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and from the hand| strong="H3027" \w* \w of Saul| strong="H7586" \w*: [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 1 [I will love]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8799”} thee, O \sc Lord\sc*, \w my strength| strong="H2391" \w*. 
\v 2 The \sc Lord\sc* is \w my rock| strong="H5553" \w*, \w and my fortress| strong="H4686" \w*, [and my deliverer]{strong=“H6403” x-morph=“strongMorph: \sc Th\sc*8764”}; \w my God| strong="H410" \w*, \w my strength| strong="H6697" \w*, [in whom I will trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8799”}; \w my buckler| strong="H4043" \w*, \w and the horn| strong="H7161" \w* \w of my salvation| strong="H3468" \w*, and \w my high tower| strong="H4869" \w*.\f + \fr 18:2 \ft my strength: Heb. my rock \f* 
\v 3 [I will call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} upon the \sc Lord\sc*, who is worthy [to be praised]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8794”}: [so shall I be saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8735”} [from mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 4 \w The sorrows| strong="H2256" \w* \w of death| strong="H4194" \w* [compassed]{strong=“H661” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and the floods]{strong=“H5158”} \w of ungodly men| strong="H1100" \w* [made me afraid]{strong=“H1204” x-morph=“strongMorph: \sc Th\sc*8762”}.\f + \fr 18:4 \ft ungodly men: Heb. Belial \f* 
\v 5 \w The sorrows| strong="H2256" \w* \w of hell| strong="H7585" \w* [compassed me about]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8804”}: \w the snares| strong="H4170" \w* \w of death| strong="H4194" \w* [prevented]{strong=“H6923” x-morph=“strongMorph: \sc Th\sc*8765”} me.\f + \fr 18:5 \ft sorrows: or, cords \f* 
