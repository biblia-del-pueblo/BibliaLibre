\c 19
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 \w The heavens| strong="H8064" \w* [declare]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8764”} \w the glory| strong="H3519" \w* \w of God| strong="H410" \w*; \w and the firmament| strong="H7549" \w* [sheweth his]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8688”} [handywork]{strong=“H3027 H4639”}. 
\v 2 \w Day| strong="H3117" \w* \w unto day| strong="H3117" \w* [uttereth]{strong=“H5042” x-morph=“strongMorph: \sc Th\sc*8686”} \w speech| strong="H562" \w*, \w and night| strong="H3915" \w* \w unto night| strong="H3915" \w* [sheweth]{strong=“H2331” x-morph=“strongMorph: \sc Th\sc*8762”} \w knowledge| strong="H1847" \w*. 
\v 3 There is \w no speech| strong="H562" \w* \w nor language| strong="H1697" \w*, where \w their voice| strong="H6963" \w* [is not heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8738”}.\f + \fr 19:3 \ft where…: or, without these their voice is heard: Heb. without their voice heard \f* 
\v 4 \w Their line| strong="H6957" \w* [is gone out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w through all the earth| strong="H776" \w*, \w and their words| strong="H4405" \w* \w to the end| strong="H7097" \w* \w of the world| strong="H8398" \w*. [In them hath he set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w a tabernacle| strong="H168" \w* \w for the sun| strong="H8121" \w*,\f + \fr 19:4 \ft line: or, rule, or, direction \f* 
\v 5 Which is \w as a bridegroom| strong="H2860" \w* [coming out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} \w of his chamber| strong="H2646" \w*, and [rejoiceth]{strong=“H7797” x-morph=“strongMorph: \sc Th\sc*8799”} \w as a strong man| strong="H1368" \w* [to run]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8800”} \w a race| strong="H734" \w*. 
\v 6 \w His going forth| strong="H4161" \w* is \w from the end| strong="H7097" \w* \w of the heaven| strong="H8064" \w*, \w and his circuit| strong="H8622" \w* \w unto the ends| strong="H7098" \w* [of it: and there is nothing hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8737”} \w from the heat| strong="H2535" \w* thereof. 
\v 7 \w The law| strong="H8451" \w* of the \sc Lord\sc* is \w perfect| strong="H8549" \w*, [converting]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8688”} \w the soul| strong="H5315" \w*: \w the testimony| strong="H5715" \w* of the \sc Lord\sc* is [sure]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8737”}, [making wise]{strong=“H2449” x-morph=“strongMorph: \sc Th\sc*8688”} \w the simple| strong="H6612" \w*.\f + \fr 19:7 \ft law: or, doctrine \f* \f + \fr 19:7 \ft converting: or, restoring \f* 
\v 8 \w The statutes| strong="H6490" \w* of the \sc Lord\sc* are \w right| strong="H3477" \w*, [rejoicing]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8764”} \w the heart| strong="H3820" \w*: \w the commandment| strong="H4687" \w* of the \sc Lord\sc* is \w pure| strong="H1249" \w*, [enlightening]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8688”} \w the eyes| strong="H5869" \w*. 
\v 9 \w The fear| strong="H3374" \w* of the \sc Lord\sc* is \w clean| strong="H2889" \w*, [enduring]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w for ever| strong="H5703" \w*: \w the judgments| strong="H4941" \w* of the \sc Lord\sc* are \w true| strong="H571" \w* and [righteous]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8804”} \w altogether| strong="H3162" \w*.\f + \fr 19:9 \ft true: Heb. truth \f* 
\v 10 [More to be desired]{strong=“H2530” x-morph=“strongMorph: \sc Th\sc*8737”} are they \w than gold| strong="H2091" \w*, [yea, than much]{strong=“H7227”} \w fine gold| strong="H6337" \w*: \w sweeter| strong="H4966" \w* \w also than honey| strong="H1706" \w* [and the honeycomb]{strong=“H6688 H5317”}.\f + \fr 19:10 \ft the honeycomb: Heb. the dropping of honeycombs \f* 
\v 11 \w Moreover by them is thy servant| strong="H5650" \w* [warned]{strong=“H2094” x-morph=“strongMorph: \sc Th\sc*8737”}: and [in keeping]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} of them there is \w great| strong="H7227" \w* \w reward| strong="H6118" \w*. 
\v 12 [Who can understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} his \w errors| strong="H7691" \w*? [cleanse]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8761”} [thou me from secret]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8737”} faults. 
\v 13 [Keep back]{strong=“H2820” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy servant| strong="H5650" \w* \w also from presumptuous| strong="H2086" \w* sins; [let them not have dominion]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8799”} [over me: then shall I be upright]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8799”}, [and I shall be innocent]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8738”} \w from the great| strong="H7227" \w* \w transgression| strong="H6588" \w*.\f + \fr 19:13 \ft the great: or, much \f* 
\v 14 \w Let the words| strong="H561" \w* \w of my mouth| strong="H6310" \w*, \w and the meditation| strong="H1902" \w* \w of my heart| strong="H3820" \w*, \w be acceptable| strong="H7522" \w* \w in thy sight| strong="H6440" \w*, O \sc Lord\sc*, \w my strength| strong="H6697" \w*, [and my redeemer]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 19:14 \ft strength: Heb. rock \f*
\c 20
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 The \sc Lord\sc* [hear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee in the day| strong="H3117" \w* \w of trouble| strong="H6869" \w*; \w the name| strong="H8034" \w* \w of the God| strong="H430" \w* \w of Jacob| strong="H3290" \w* [defend]{strong=“H7682” x-morph=“strongMorph: \sc Th\sc*8762”} thee;\f + \fr 20:1 \ft defend…: Heb. set thee on an high place \f* 
\v 2 [Send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee help| strong="H5828" \w* \w from the sanctuary| strong="H6944" \w*, [and strengthen]{strong=“H5582” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee out of Zion| strong="H6726" \w*;\f + \fr 20:2 \ft thee help: Heb. thy help \f* \f + \fr 20:2 \ft strengthen: Heb. support \f* 
\v 3 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w all thy offerings| strong="H4503" \w*, [and accept]{strong=“H1878” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy burnt sacrifice| strong="H5930" \w*; \w Selah| strong="H5542" \w*.\f + \fr 20:3 \ft accept: Heb. turn to ashes: or, make fat \f* 
\v 4 [Grant]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee according to thine own heart| strong="H3824" \w*, [and fulfil]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8762”} \w all thy counsel| strong="H6098" \w*. 
\v 5 [We will rejoice]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8762”} \w in thy salvation| strong="H3444" \w*, \w and in the name| strong="H8034" \w* \w of our God| strong="H430" \w* we will set up our [banners]{strong=“H1713” x-morph=“strongMorph: \sc Th\sc*8799”}: the \sc Lord\sc* [fulfil]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8762”} \w all thy petitions| strong="H4862" \w*. 
\v 6 [Now know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} I that the \sc Lord\sc* [saveth]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8689”} \w his anointed| strong="H4899" \w*; [he will hear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w him from his holy| strong="H6944" \w* \w heaven| strong="H8064" \w* \w with the saving| strong="H3468" \w* \w strength| strong="H1369" \w* \w of his right hand| strong="H3225" \w*.\f + \fr 20:6 \ft his holy…: Heb. the heaven of his holiness \f* \f + \fr 20:6 \ft with…: Heb. by the strength of the salvation of \f* 
\v 7 Some trust \w in chariots| strong="H7393" \w*, \w and some in horses| strong="H5483" \w*: [but we will remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8686”} \w the name| strong="H8034" \w* of the \sc Lord\sc* \w our God| strong="H430" \w*. 
\v 8 [They are brought down]{strong=“H3766” x-morph=“strongMorph: \sc Th\sc*8804”} [and fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”}: [but we are risen]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”}, [and stand upright]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8696”}. 
\v 9 [Save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”}, \sc Lord\sc*: \w let the king| strong="H4428" \w* [hear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w us when| strong="H3117" \w* [we call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8800”}.
\c 21
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 \w The king| strong="H4428" \w* [shall joy]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy strength| strong="H5797" \w*, O \sc Lord\sc*; \w and in thy salvation| strong="H3444" \w* \w how greatly| strong="H3966" \w* [shall he rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”}! 
\v 2 [Thou hast given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [him his heart’s]{strong=“H3820”} \w desire| strong="H8378" \w*, [and hast not withholden]{strong=“H4513” x-morph=“strongMorph: \sc Th\sc*8804”} \w the request| strong="H782" \w* \w of his lips| strong="H8193" \w*. \w Selah| strong="H5542" \w*. 
\v 3 [For thou preventest]{strong=“H6923” x-morph=“strongMorph: \sc Th\sc*8762”} \w him with the blessings| strong="H1293" \w* \w of goodness| strong="H2896" \w*: [thou settest]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w a crown| strong="H5850" \w* \w of pure gold| strong="H6337" \w* \w on his head| strong="H7218" \w*. 
\v 4 [He asked]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8804”} \w life| strong="H2416" \w* of thee, and [thou gavest]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} it him, even \w length| strong="H753" \w* \w of days| strong="H3117" \w* \w for ever| strong="H5769" \w* \w and ever| strong="H5703" \w*. 
\v 5 \w His glory| strong="H3519" \w* is \w great| strong="H1419" \w* \w in thy salvation| strong="H3444" \w*: \w honour| strong="H1935" \w* \w and majesty| strong="H1926" \w* [hast thou laid]{strong=“H7737” x-morph=“strongMorph: \sc Th\sc*8762”} upon him. 
\v 6 [For thou hast made]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w him most blessed| strong="H1293" \w* \w for ever| strong="H5703" \w*: [thou hast made]{strong=“H2302” x-morph=“strongMorph: \sc Th\sc*8762”} \w him exceeding glad| strong="H8057" \w* \w with thy countenance| strong="H6440" \w*.\f + \fr 21:6 \ft made him most…: Heb. set him to be blessings \f* \f + \fr 21:6 \ft made him exceeding…: Heb. make him glad with joy \f* 
\v 7 \w For the king| strong="H4428" \w* [trusteth]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”} in the \sc Lord\sc*, \w and through the mercy| strong="H2617" \w* \w of the most High| strong="H5945" \w* [he shall not be moved]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 8 \w Thine hand| strong="H3027" \w* [shall find out]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} [all thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}: \w thy right hand| strong="H3225" \w* [shall find out]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} [those that hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} thee. 
\v 9 [Thou shalt make]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w them as a fiery| strong="H784" \w* \w oven| strong="H8574" \w* \w in the time| strong="H6256" \w* \w of thine anger| strong="H6440" \w*: the \sc Lord\sc* [shall swallow them up]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8762”} \w in his wrath| strong="H639" \w*, \w and the fire| strong="H784" \w* [shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} them. 
\v 10 \w Their fruit| strong="H6529" \w* [shalt thou destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8762”} \w from the earth| strong="H776" \w*, \w and their seed| strong="H2233" \w* \w from among the children| strong="H1121" \w* \w of men| strong="H120" \w*. 
\v 11 [For they intended]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} \w evil| strong="H7451" \w* [against thee: they imagined]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8804”} \w a mischievous device| strong="H4209" \w*, which [they are not able]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} to perform. 
\v 12 [Therefore shalt thou make]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w them turn their back| strong="H7926" \w*, when [thou shalt make ready]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8787”} thine arrows \w upon thy strings| strong="H4340" \w* \w against the face| strong="H6440" \w* of them.\f + \fr 21:12 \ft shalt thou…: or, thou shalt set them as a butt \f* \f + \fr 21:12 \ft back: Heb. shoulder \f* 
\v 13 [Be thou exalted]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8798”}, \sc Lord\sc*, \w in thine own strength| strong="H5797" \w*: so [will we sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8799”} [and praise]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy power| strong="H1369" \w*.
\c 22
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} \w upon Aijeleth| strong="H365" \w* \w Shahar| strong="H7837" \w*, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 \w My God| strong="H410" \w*, \w my God| strong="H410" \w*, [why hast thou forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} me? why art thou so \w far| strong="H7350" \w* \w from helping| strong="H3444" \w* me, and from \w the words| strong="H1697" \w* \w of my roaring| strong="H7581" \w*?\f + \fr 22:1 \ft Aijeleth…: or, the hind of the morning \f* \f + \fr 22:1 \ft helping…: Heb. my salvation \f* 
\v 2 \w O my God| strong="H430" \w*, [I cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the daytime| strong="H3119" \w*, [but thou hearest]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [not; and in the night season]{strong=“H3915”}, \w and am not silent| strong="H1747" \w*.\f + \fr 22:2 \ft am…: Heb. there is no silence to me \f* 
\v 3 But thou art \w holy| strong="H6918" \w*, O thou [that inhabitest]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w the praises| strong="H8416" \w* \w of Israel| strong="H3478" \w*. 
\v 4 \w Our fathers| strong="H1" \w* [trusted]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”} [in thee: they trusted]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”}, [and thou didst deliver]{strong=“H6403” x-morph=“strongMorph: \sc Th\sc*8762”} them. 
\v 5 [They cried]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8804”} [unto thee, and were delivered]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8738”}: [they trusted]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”} [in thee, and were not confounded]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 6 But I am \w a worm| strong="H8438" \w*, \w and no man| strong="H376" \w*; \w a reproach| strong="H2781" \w* \w of men| strong="H120" \w*, [and despised]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8803”} \w of the people| strong="H5971" \w*. 
\v 7 [All they that see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} [me laugh me to scorn]{strong=“H3932” x-morph=“strongMorph: \sc Th\sc*8686”}: [they shoot out]{strong=“H6358” x-morph=“strongMorph: \sc Th\sc*8686”} \w the lip| strong="H8193" \w*, [they shake]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8686”} \w the head| strong="H7218" \w*, saying,\f + \fr 22:7 \ft shoot…: Heb. open \f* 
\v 8 [He trusted]{strong=“H1556” x-morph=“strongMorph: \sc Th\sc*8800”} on the \sc Lord\sc* that [he would deliver]{strong=“H6403” x-morph=“strongMorph: \sc Th\sc*8762”} [him: let him deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} [him, seeing he delighted]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} in him.\f + \fr 22:8 \ft He trusted…: Heb. He rolled himself on \f* \f + \fr 22:8 \ft seeing…: or, if he delight in \f* 
\v 9 But thou art [he that took]{strong=“H1518” x-morph=“strongMorph: \sc Th\sc*8801”} \w me out of the womb| strong="H990" \w*: [thou didst make me hope]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8688”} when I was [upon my mother’s]{strong=“H517”} \w breasts| strong="H7699" \w*.\f + \fr 22:9 \ft didst…: or, kept me in safety \f* 
\v 10 [I was cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8717”} \w upon thee from the womb| strong="H7358" \w*: thou art \w my God| strong="H410" \w* [from my mother’s]{strong=“H517”} \w belly| strong="H990" \w*. 
\v 11 [Be not far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8799”} [from me; for trouble]{strong=“H6869”} is \w near| strong="H7138" \w*; for there is [none to help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 22:11 \ft none…: Heb. not a helper \f* 
\v 12 \w Many| strong="H7227" \w* \w bulls| strong="H6499" \w* [have compassed]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8804”} [me: strong]{strong=“H47”} bulls \w of Bashan| strong="H1316" \w* [have beset me round]{strong=“H3803” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 13 [They gaped]{strong=“H6475” x-morph=“strongMorph: \sc Th\sc*8804”} upon me with \w their mouths| strong="H6310" \w*, as [a ravening]{strong=“H2963” x-morph=“strongMorph: \sc Th\sc*8802”} [and a roaring]{strong=“H7580” x-morph=“strongMorph: \sc Th\sc*8802”} \w lion| strong="H738" \w*.\f + \fr 22:13 \ft gaped…: Heb. opened their mouths against me \f* 
\v 14 [I am poured out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8738”} \w like water| strong="H4325" \w*, \w and all my bones| strong="H6106" \w* [are out of joint]{strong=“H6504” x-morph=“strongMorph: \sc Th\sc*8694”}: \w my heart| strong="H3820" \w* \w is like wax| strong="H1749" \w*; [it is melted]{strong=“H4549” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the midst| strong="H8432" \w* \w of my bowels| strong="H4578" \w*.\f + \fr 22:14 \ft out of…: or, sundered \f* 
\v 15 \w My strength| strong="H3581" \w* [is dried up]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8804”} \w like a potsherd| strong="H2789" \w*; \w and my tongue| strong="H3956" \w* [cleaveth]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8716”} \w to my jaws| strong="H4455" \w*; [and thou hast brought]{strong=“H8239” x-morph=“strongMorph: \sc Th\sc*8799”} \w me into the dust| strong="H6083" \w* \w of death| strong="H4194" \w*. 
\v 16 \w For dogs| strong="H3611" \w* [have compassed]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8804”} [me: the assembly]{strong=“H5712”} [of the wicked]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8688”} [have inclosed]{strong=“H5362” x-morph=“strongMorph: \sc Th\sc*8689”} [me: they pierced]{strong=“H738 H3738” x-morph=“strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8804”} \w my hands| strong="H3027" \w* \w and my feet| strong="H7272" \w*. 
\v 17 [I may tell]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} \w all my bones| strong="H6106" \w*: [they look]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”} and [stare]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} upon me. 
\v 18 [They part]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8762”} \w my garments| strong="H899" \w* [among them, and cast]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8686”} \w lots| strong="H1486" \w* \w upon my vesture| strong="H3830" \w*. 
\v 19 [But be not thou far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8799”} from me, O \sc Lord\sc*: \w O my strength| strong="H360" \w*, [haste]{strong=“H2363” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee to help| strong="H5833" \w* me. 
\v 20 [Deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} \w my soul| strong="H5315" \w* \w from the sword| strong="H2719" \w*; \w my darling| strong="H3173" \w* \w from the power| strong="H3027" \w* \w of the dog| strong="H3611" \w*.\f + \fr 22:20 \ft my darling: Heb. my only one \f* \f + \fr 22:20 \ft power: Heb. hand \f* 
\v 21 [Save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”} [me from the lion’s]{strong=“H738”} \w mouth| strong="H6310" \w*: [for thou hast heard]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”} \w me from the horns| strong="H7161" \w* \w of the unicorns| strong="H7214" \w*. 
\v 22 [I will declare]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy name| strong="H8034" \w* \w unto my brethren| strong="H251" \w*: \w in the midst| strong="H8432" \w* \w of the congregation| strong="H6951" \w* [will I praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} thee. 
\v 23 \w Ye that fear| strong="H3373" \w* the \sc Lord\sc*, [praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} [him; all ye the seed]{strong=“H2233”} \w of Jacob| strong="H3290" \w*, [glorify]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8761”} [him; and fear]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8798”} [him, all ye the seed]{strong=“H2233”} \w of Israel| strong="H3478" \w*. 
\v 24 [For he hath not despised]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8804”} [nor abhorred]{strong=“H8262” x-morph=“strongMorph: \sc Th\sc*8765”} \w the affliction| strong="H6039" \w* \w of the afflicted| strong="H6041" \w*; [neither hath he hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8689”} \w his face| strong="H6440" \w* [from him; but when he cried]{strong=“H7768” x-morph=“strongMorph: \sc Th\sc*8763”} [unto him, he heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 25 \w My praise| strong="H8416" \w* shall be \w of thee in the great| strong="H7227" \w* \w congregation| strong="H6951" \w*: [I will pay]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w my vows| strong="H5088" \w* \w before them that fear| strong="H3373" \w* him. 
\v 26 \w The meek| strong="H6035" \w* [shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [and be satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”}: [they shall praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} the \sc Lord\sc* [that seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8802”} [him: your heart]{strong=“H3824”} [shall live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”} \w for ever| strong="H5703" \w*. 
\v 27 \w All the ends| strong="H657" \w* \w of the world| strong="H776" \w* [shall remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} [and turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc*: \w and all the kindreds| strong="H4940" \w* \w of the nations| strong="H1471" \w* [shall worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} \w before| strong="H6440" \w* thee. 
\v 28 \w For the kingdom| strong="H4410" \w* is the \sc Lord\sc*’S: and he is [the governor]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8802”} \w among the nations| strong="H1471" \w*. 
\v 29 All they that be \w fat| strong="H1879" \w* \w upon earth| strong="H776" \w* [shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} [and worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”}: [all they that go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the dust| strong="H6083" \w* [shall bow]{strong=“H3766” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* [him: and none can keep alive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8765”} \w his own soul| strong="H5315" \w*. 
\v 30 \w A seed| strong="H2233" \w* [shall serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} [him; it shall be accounted]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8792”} \w to the Lord| strong="H136" \w* \w for a generation| strong="H1755" \w*. 
\v 31 [They shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [and shall declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w his righteousness| strong="H6666" \w* \w unto a people| strong="H5971" \w* [that shall be born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8737”}, [that he hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} this.
\c 23
\p 
\w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 The \sc Lord\sc* is [my shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}; [I shall not want]{strong=“H2637” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 2 [He maketh me to lie down]{strong=“H7257” x-morph=“strongMorph: \sc Th\sc*8686”} \w in green| strong="H1877" \w* \w pastures| strong="H4999" \w*: [he leadeth]{strong=“H5095” x-morph=“strongMorph: \sc Th\sc*8762”} \w me beside the still| strong="H4496" \w* \w waters| strong="H4325" \w*.\f + \fr 23:2 \ft green…: Heb. pastures of tender grass \f* \f + \fr 23:2 \ft still…: Heb. waters of quietness \f* 
\v 3 [He restoreth]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8787”} \w my soul| strong="H5315" \w*: [he leadeth]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8686”} \w me in the paths| strong="H4570" \w* \w of righteousness| strong="H6664" \w* [for his name’s]{strong=“H8034”} sake. 
\v 4 [Yea, though I walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w through the valley| strong="H1516" \w* \w of the shadow of death| strong="H6757" \w*, [I will fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w no evil| strong="H7451" \w*: for thou art [with me; thy rod]{strong=“H7626”} \w and thy staff| strong="H4938" \w* [they comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8762”} me. 
\v 5 [Thou preparest]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8799”} \w a table| strong="H7979" \w* \w before| strong="H6440" \w* [me in the presence of mine enemies]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8802”}: [thou anointest]{strong=“H1878” x-morph=“strongMorph: \sc Th\sc*8765”} \w my head| strong="H7218" \w* \w with oil| strong="H8081" \w*; \w my cup| strong="H3563" \w* \w runneth over| strong="H7310" \w*.\f + \fr 23:5 \ft anointest: Heb. makest fat \f* 
\v 6 \w Surely goodness| strong="H2896" \w* \w and mercy| strong="H2617" \w* [shall follow]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} \w me all the days| strong="H3117" \w* \w of my life| strong="H2416" \w*: [and I will dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the house| strong="H1004" \w* of the \sc Lord\sc* [for ever]{strong=“H3117 H753”}.\f + \fr 23:6 \ft for ever: Heb. to length of days \f*
\c 24
\p 
\w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 \w The earth| strong="H776" \w* is the \sc Lord\sc*’S, \w and the fulness| strong="H4393" \w* [thereof; the world]{strong=“H8398”}, [and they that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} therein. 
\v 2 [For he hath founded]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8804”} \w it upon the seas| strong="H3220" \w*, [and established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8787”} \w it upon the floods| strong="H5104" \w*. 
\v 3 [Who shall ascend]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the hill| strong="H2022" \w* of the \sc Lord\sc*? [or who shall stand]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his holy| strong="H6944" \w* \w place| strong="H4725" \w*? 
\v 4 \w He that hath clean| strong="H5355" \w* \w hands| strong="H3709" \w*, \w and a pure| strong="H1249" \w* \w heart| strong="H3824" \w*; [who hath not lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w his soul| strong="H5315" \w* \w unto vanity| strong="H7723" \w*, [nor sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w deceitfully| strong="H4820" \w*.\f + \fr 24:4 \ft He…: Heb. The clean of hands \f* 
\v 5 [He shall receive]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w the blessing| strong="H1293" \w* from the \sc Lord\sc*, \w and righteousness| strong="H6666" \w* \w from the God| strong="H430" \w* \w of his salvation| strong="H3468" \w*. 
\v 6 This is \w the generation| strong="H1755" \w* [of them that seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8802”} [him, that seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w thy face| strong="H6440" \w*, \w O Jacob| strong="H3290" \w*. \w Selah| strong="H5542" \w*.\f + \fr 24:6 \ft O Jacob: or, O God of Jacob \f* 
\v 7 [Lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w your heads| strong="H7218" \w*, \w O ye gates| strong="H8179" \w*; [and be ye lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8734”}, \w ye everlasting| strong="H5769" \w* \w doors| strong="H6607" \w*; \w and the King| strong="H4428" \w* \w of glory| strong="H3519" \w* [shall come in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 8 Who is \w this King| strong="H4428" \w* \w of glory| strong="H3519" \w*? The \sc Lord\sc* \w strong| strong="H5808" \w* \w and mighty| strong="H1368" \w*, the \sc Lord\sc* \w mighty| strong="H1368" \w* \w in battle| strong="H4421" \w*. 
\v 9 [Lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w your heads| strong="H7218" \w*, \w O ye gates| strong="H8179" \w*; even lift them [up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”}, \w ye everlasting| strong="H5769" \w* \w doors| strong="H6607" \w*; \w and the King| strong="H4428" \w* \w of glory| strong="H3519" \w* [shall come in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 10 \w Who is this King| strong="H4428" \w* \w of glory| strong="H3519" \w*? The \sc Lord\sc* \w of hosts| strong="H6635" \w*, he is \w the King| strong="H4428" \w* \w of glory| strong="H3519" \w*. \w Selah| strong="H5542" \w*.
\c 25
\p 
A Psalm \w of David| strong="H1732" \w*. 
\v 1 Unto thee, O \sc Lord\sc*, [do I lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w my soul| strong="H5315" \w*. 
\v 2 \w O my God| strong="H430" \w*, [I trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”} [in thee: let me not be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}, [let not mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [triumph]{strong=“H5970” x-morph=“strongMorph: \sc Th\sc*8799”} over me. 
\v 3 [Yea, let none that wait]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8802”} [on thee be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}: [let them be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} [which transgress]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”} \w without cause| strong="H7387" \w*. 
\v 4 [Shew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8685”} \w me thy ways| strong="H1870" \w*, O \sc Lord\sc*; [teach]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8761”} \w me thy paths| strong="H734" \w*. 
\v 5 [Lead]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8685”} \w me in thy truth| strong="H571" \w*, [and teach]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8761”} me: for thou art \w the God| strong="H430" \w* \w of my salvation| strong="H3468" \w*; [on thee do I wait]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8765”} \w all the day| strong="H3117" \w*. 
\v 6 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”}, O \sc Lord\sc*, \w thy tender mercies| strong="H7356" \w* \w and thy lovingkindnesses| strong="H2617" \w*; for they have been \w ever of old| strong="H5769" \w*.\f + \fr 25:6 \ft tender…: Heb. bowels \f* 
\v 7 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w not the sins| strong="H2403" \w* \w of my youth| strong="H5271" \w*, \w nor my transgressions| strong="H6588" \w*: \w according to thy mercy| strong="H2617" \w* [remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”} [thou me for thy goodness’]{strong=“H2898”} sake, O \sc Lord\sc*. 
\v 8 \w Good| strong="H2896" \w* \w and upright| strong="H3477" \w* is the \sc Lord\sc*: [therefore will he teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”} \w sinners| strong="H2400" \w* \w in the way| strong="H1870" \w*. 
\v 9 \w The meek| strong="H6035" \w* [will he guide]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8686”} \w in judgment| strong="H4941" \w*: \w and the meek| strong="H6035" \w* [will he teach]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8762”} \w his way| strong="H1870" \w*. 
\v 10 \w All the paths| strong="H734" \w* of the \sc Lord\sc* are \w mercy| strong="H2617" \w* \w and truth| strong="H571" \w* [unto such as keep]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8802”} \w his covenant| strong="H1285" \w* \w and his testimonies| strong="H5713" \w*. 
\v 11 [For thy name’s]{strong=“H8034”} sake, O \sc Lord\sc*, [pardon]{strong=“H5545” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine iniquity| strong="H5771" \w*; for it is \w great| strong="H7227" \w*. 
\v 12 \w What man| strong="H376" \w* is \w he that feareth| strong="H3373" \w* the \sc Lord\sc*? [him shall he teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”} \w in the way| strong="H1870" \w* that [he shall choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 13 \w His soul| strong="H5315" \w* [shall dwell]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} \w at ease| strong="H2896" \w*; \w and his seed| strong="H2233" \w* [shall inherit]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8799”} \w the earth| strong="H776" \w*.\f + \fr 25:13 \ft dwell…: Heb. lodge in goodness \f* 
\v 14 \w The secret| strong="H5475" \w* of the \sc Lord\sc* is \w with them that fear| strong="H3373" \w* [him; and he will shew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8687”} \w them his covenant| strong="H1285" \w*.\f + \fr 25:14 \ft and…: or, and his covenant to make them know it \f* 
\v 15 \w Mine eyes| strong="H5869" \w* are \w ever| strong="H8548" \w* toward the \sc Lord\sc*; [for he shall pluck]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w my feet| strong="H7272" \w* \w out of the net| strong="H7568" \w*.\f + \fr 25:15 \ft pluck: Heb. bring forth \f* 
\v 16 [Turn]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8798”} [thee unto me, and have mercy]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} upon me; for I am \w desolate| strong="H3173" \w* \w and afflicted| strong="H6041" \w*. 
\v 17 \w The troubles| strong="H6869" \w* \w of my heart| strong="H3824" \w* [are enlarged]{strong=“H7337” x-morph=“strongMorph: \sc Th\sc*8689”}: O [bring thou me out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8685”} \w of my distresses| strong="H4691" \w*. 
\v 18 [Look]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w upon mine affliction| strong="H6040" \w* \w and my pain| strong="H5999" \w*; [and forgive]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w all my sins| strong="H2403" \w*. 
\v 19 [Consider]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} [mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}; [for they are many]{strong=“H7231” x-morph=“strongMorph: \sc Th\sc*8804”}; [and they hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”} \w me with cruel| strong="H2555" \w* \w hatred| strong="H8135" \w*.\f + \fr 25:19 \ft cruel…: Heb. hatred of violence \f* 
\v 20 [O keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8798”} \w my soul| strong="H5315" \w*, [and deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} [me: let me not be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}; [for I put my trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8804”} in thee. 
\v 21 \w Let integrity| strong="H8537" \w* \w and uprightness| strong="H3476" \w* [preserve]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8799”} [me; for I wait]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8765”} on thee. 
\v 22 [Redeem]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8798”} \w Israel| strong="H3478" \w*, \w O God| strong="H430" \w*, \w out of all his troubles| strong="H6869" \w*.
\c 26
\p 
A Psalm \w of David| strong="H1732" \w*. 
\v 1 [Judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8798”} me, O \sc Lord\sc*; [for I have walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w in mine integrity| strong="H8537" \w*: [I have trusted]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”} also in the \sc Lord\sc*; therefore [I shall not slide]{strong=“H4571” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 2 [Examine]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8798”} me, O \sc Lord\sc*, [and prove]{strong=“H5254” x-morph=“strongMorph: \sc Th\sc*8761”} [me; try]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8798”} \w my reins| strong="H3629" \w* \w and my heart| strong="H3820" \w*. 
\v 3 \w For thy lovingkindness| strong="H2617" \w* is \w before mine eyes| strong="H5869" \w*: [and I have walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8694”} \w in thy truth| strong="H571" \w*. 
\v 4 [I have not sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w with vain| strong="H7723" \w* \w persons| strong="H4962" \w*, [neither will I go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [with dissemblers]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8737”}. 
\v 5 [I have hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”} \w the congregation| strong="H6951" \w* [of evil doers]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8688”}; [and will not sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the wicked| strong="H7563" \w*. 
\v 6 [I will wash]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8799”} \w mine hands| strong="H3709" \w* \w in innocency| strong="H5356" \w*: [so will I compass]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8779”} \w thine altar| strong="H4196" \w*, O \sc Lord\sc*: 
\v 7 [That I may publish]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8687”} \w with the voice| strong="H6963" \w* \w of thanksgiving| strong="H8426" \w*, [and tell]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8763”} [of all thy wondrous works]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”}. 
\v 8 \sc Lord\sc*, [I have loved]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} \w the habitation| strong="H4583" \w* \w of thy house| strong="H1004" \w*, \w and the place| strong="H4725" \w* \w where thine honour| strong="H3519" \w* \w dwelleth| strong="H4908" \w*.\f + \fr 26:8 \ft where…: Heb. of the tabernacle of thy honour \f* 
\v 9 [Gather]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8799”} \w not my soul| strong="H5315" \w* \w with sinners| strong="H2400" \w*, \w nor my life| strong="H2416" \w* \w with bloody| strong="H1818" \w* \w men| strong="H582" \w*:\f + \fr 26:9 \ft Gather…: or, Take not away \f* \f + \fr 26:9 \ft bloody…: Heb. men of blood \f* 
\v 10 \w In whose hands| strong="H3027" \w* is \w mischief| strong="H2154" \w*, \w and their right hand| strong="H3225" \w* [is full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of bribes| strong="H7810" \w*.\f + \fr 26:10 \ft full…: Heb. filled with \f* 
\v 11 [But as for me, I will walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w in mine integrity| strong="H8537" \w*: [redeem]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8798”} [me, and be merciful]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} unto me. 
\v 12 \w My foot| strong="H7272" \w* [standeth]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} \w in an even place| strong="H4334" \w*: \w in the congregations| strong="H4721" \w* [will I bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} the \sc Lord\sc*.
\c 27
\p 
A Psalm \w of David| strong="H1732" \w*. 
\v 1 The \sc Lord\sc* is \w my light| strong="H216" \w* \w and my salvation| strong="H3468" \w*; [whom shall I fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}? the \sc Lord\sc* is \w the strength| strong="H4581" \w* \w of my life| strong="H2416" \w*; [of whom shall I be afraid]{strong=“H6342” x-morph=“strongMorph: \sc Th\sc*8799”}? 
\v 2 [When the wicked]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8688”}, even \w mine enemies| strong="H6862" \w* [and my foes]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, [came]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8800”} [upon me to eat up]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} \w my flesh| strong="H1320" \w*, [they stumbled]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8804”} [and fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 27:2 \ft came…: Heb. approached against me \f* 
\v 3 \w Though an host| strong="H4264" \w* [should encamp]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8799”} [against me, my heart]{strong=“H3820”} [shall not fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}: \w though war| strong="H4421" \w* [should rise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} against me, in this will I be [confident]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 4 \w One| strong="H259" \w* thing [have I desired]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8804”} of the \sc Lord\sc*, [that will I seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} [after; that I may dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the house| strong="H1004" \w* of the \sc Lord\sc* \w all the days| strong="H3117" \w* \w of my life| strong="H2416" \w*, [to behold]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8800”} \w the beauty| strong="H5278" \w* of the \sc Lord\sc*, [and to enquire]{strong=“H1239” x-morph=“strongMorph: \sc Th\sc*8763”} \w in his temple| strong="H1964" \w*.\f + \fr 27:4 \ft the beauty: or, the delight \f* 
\v 5 \w For in the time| strong="H3117" \w* \w of trouble| strong="H7451" \w* [he shall hide]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8799”} \w me in his pavilion| strong="H5520" \w*: \w in the secret| strong="H5643" \w* \w of his tabernacle| strong="H168" \w* [shall he hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8686”} [me; he shall set me up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8787”} \w upon a rock| strong="H6697" \w*. 
\v 6 \w And now shall mine head| strong="H7218" \w* [be lifted up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8799”} [above mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w round about| strong="H5439" \w* [me: therefore will I offer]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his tabernacle| strong="H168" \w* \w sacrifices| strong="H2077" \w* \w of joy| strong="H8643" \w*; [I will sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8799”}, [yea, I will sing praises]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8762”} unto the \sc Lord\sc*.\f + \fr 27:6 \ft joy: Heb. shouting \f* 
\v 7 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, O \sc Lord\sc*, when [I cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w with my voice| strong="H6963" \w*: [have mercy]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} [also upon me, and answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8798”} me. 
\v 8 When thou saidst, [Seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8761”} \w ye my face| strong="H6440" \w*; \w my heart| strong="H3820" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto thee, Thy face]{strong=“H6440”}, \sc Lord\sc*, [will I seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”}.\f + \fr 27:8 \ft When…: or, My heart said unto thee, Let my face seek thy face, etc \f* 
\v 9 [Hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8686”} \w not thy face| strong="H6440" \w* far [from me; put]{strong=“H5186”} \w not thy servant| strong="H5650" \w* [away]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w in anger| strong="H639" \w*: \w thou hast been my help| strong="H5833" \w*; [leave]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8799”} [me not, neither forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} [me, O God]{strong=“H430”} \w of my salvation| strong="H3468" \w*. 
\v 10 \w When my father| strong="H1" \w* \w and my mother| strong="H517" \w* [forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} me, then the \sc Lord\sc* [will take me up]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 27:10 \ft take…: Heb. gather me \f* 
\v 11 [Teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8685”} \w me thy way| strong="H1870" \w*, O \sc Lord\sc*, [and lead]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8798”} \w me in a plain| strong="H4334" \w* \w path| strong="H734" \w*, [because of mine enemies]{strong=“H8324” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 27:11 \ft a plain…: Heb. a way of plainness \f* \f + \fr 27:11 \ft mine…: Heb. those which observe me \f* 
\v 12 [Deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w me not over unto the will| strong="H5315" \w* \w of mine enemies| strong="H6862" \w*: \w for false| strong="H8267" \w* \w witnesses| strong="H5707" \w* [are risen up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”} [against me, and such as breathe out]{strong=“H3307”} \w cruelty| strong="H2555" \w*. 
\v 13 I had fainted, \w unless| strong="H3884" \w* [I had believed]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8689”} [to see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w the goodness| strong="H2898" \w* of the \sc Lord\sc* \w in the land| strong="H776" \w* \w of the living| strong="H2416" \w*. 
\v 14 [Wait]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8761”} on the \sc Lord\sc*: [be of good courage]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8798”}, [and he shall strengthen]{strong=“H553” x-morph=“strongMorph: \sc Th\sc*8686”} \w thine heart| strong="H3820" \w*: [wait]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8761”}, I say, on the \sc Lord\sc*.
\c 28
\p 
A Psalm \w of David| strong="H1732" \w*. 
\v 1 [Unto thee will I cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”}, O \sc Lord\sc* \w my rock| strong="H6697" \w*; [be not silent]{strong=“H2814” x-morph=“strongMorph: \sc Th\sc*8799”} to me: lest, if [thou be silent]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8799”} [to me, I become]{strong=“H4911” x-morph=“strongMorph: \sc Th\sc*8738”} [like them that go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w into the pit| strong="H953" \w*.\f + \fr 28:1 \ft to me: Heb. from me \f* 
\v 2 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the voice| strong="H6963" \w* \w of my supplications| strong="H8469" \w*, [when I cry]{strong=“H7768” x-morph=“strongMorph: \sc Th\sc*8763”} [unto thee, when I lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8800”} \w my hands| strong="H3027" \w* \w toward thy holy| strong="H6944" \w* \w oracle| strong="H1687" \w*.\f + \fr 28:2 \ft thy…: or, the oracle of thy sanctuary \f* 
\v 3 [Draw me not away]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the wicked| strong="H7563" \w*, [and with the workers]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w of iniquity| strong="H205" \w*, [which speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} \w peace| strong="H7965" \w* \w to their neighbours| strong="H7453" \w*, \w but mischief| strong="H7451" \w* is \w in their hearts| strong="H3824" \w*. 
\v 4 [Give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w them according to their deeds| strong="H6467" \w*, \w and according to the wickedness| strong="H7455" \w* \w of their endeavours| strong="H4611" \w*: [give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w them after the work| strong="H4639" \w* \w of their hands| strong="H3027" \w*; [render]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”} \w to them their desert| strong="H1576" \w*. 
\v 5 [Because they regard]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} \w not the works| strong="H6468" \w* of the \sc Lord\sc*, \w nor the operation| strong="H4639" \w* \w of his hands| strong="H3027" \w*, [he shall destroy]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and not build them up]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 6 [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} be the \sc Lord\sc*, [because he hath heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the voice| strong="H6963" \w* \w of my supplications| strong="H8469" \w*. 
\v 7 The \sc Lord\sc* is \w my strength| strong="H5797" \w* \w and my shield| strong="H4043" \w*; \w my heart| strong="H3820" \w* [trusted]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”} [in him, and I am helped]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8738”}: \w therefore my heart| strong="H3820" \w* [greatly rejoiceth]{strong=“H5937” x-morph=“strongMorph: \sc Th\sc*8799”}; \w and with my song| strong="H7892" \w* [will I praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} him. 
\v 8 The \sc Lord\sc* is \w their strength| strong="H5797" \w*, and he is \w the saving| strong="H3444" \w* \w strength| strong="H4581" \w* \w of his anointed| strong="H4899" \w*.\f + \fr 28:8 \ft their: or, his \f* \f + \fr 28:8 \ft saving…: Heb. strength of salvations \f* 
\v 9 [Save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”} \w thy people| strong="H5971" \w*, [and bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} \w thine inheritance| strong="H5159" \w*: [feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8798”} [them also, and lift them up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8761”} \w for ever| strong="H5769" \w*.\f + \fr 28:9 \ft feed: or, rule \f*
\c 29
\p 
\w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 [Give]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”} unto the \sc Lord\sc*, [O ye mighty]{strong=“H410 H1121”}, [give]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”} unto the \sc Lord\sc* \w glory| strong="H3519" \w* \w and strength| strong="H5797" \w*.\f + \fr 29:1 \ft ye mighty: Heb. ye sons of the mighty \f* 
\v 2 [Give]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”} unto the \sc Lord\sc* \w the glory| strong="H3519" \w* \w due unto his name| strong="H8034" \w*; [worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8690”} the \sc Lord\sc* \w in the beauty| strong="H1927" \w* \w of holiness| strong="H6944" \w*.\f + \fr 29:2 \ft the glory…: Heb. the honour of his name \f* \f + \fr 29:2 \ft in…: or, in his glorious sanctuary \f* 
\v 3 \w The voice| strong="H6963" \w* of the \sc Lord\sc* is \w upon the waters| strong="H4325" \w*: \w the God| strong="H410" \w* \w of glory| strong="H3519" \w* [thundereth]{strong=“H7481” x-morph=“strongMorph: \sc Th\sc*8689”}: the \sc Lord\sc* is \w upon many| strong="H7227" \w* \w waters| strong="H4325" \w*.\f + \fr 29:3 \ft many: or, great \f* 
\v 4 \w The voice| strong="H6963" \w* of the \sc Lord\sc* is \w powerful| strong="H3581" \w*; \w the voice| strong="H6963" \w* of the \sc Lord\sc* is \w full of majesty| strong="H1926" \w*.\f + \fr 29:4 \ft powerful: Heb. in power \f* \f + \fr 29:4 \ft full…: Heb. in majesty \f* 
\v 5 \w The voice| strong="H6963" \w* of the \sc Lord\sc* [breaketh]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8799”} \w the cedars| strong="H730" \w*; yea, the \sc Lord\sc* [breaketh]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8762”} \w the cedars| strong="H730" \w* \w of Lebanon| strong="H3844" \w*. 
\v 6 [He maketh them also to skip]{strong=“H7540” x-morph=“strongMorph: \sc Th\sc*8686”} \w like a calf| strong="H5695" \w*; \w Lebanon| strong="H3844" \w* \w and Sirion| strong="H8303" \w* \w like a young| strong="H1121" \w* \w unicorn| strong="H7214" \w*. 
\v 7 \w The voice| strong="H6963" \w* of the \sc Lord\sc* [divideth]{strong=“H2672” x-morph=“strongMorph: \sc Th\sc*8802”} \w the flames| strong="H3852" \w* \w of fire| strong="H784" \w*.\f + \fr 29:7 \ft divideth: Heb. cutteth out \f* 
\v 8 \w The voice| strong="H6963" \w* of the \sc Lord\sc* [shaketh]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8799”} \w the wilderness| strong="H4057" \w*; the \sc Lord\sc* [shaketh]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8799”} \w the wilderness| strong="H4057" \w* \w of Kadesh| strong="H6946" \w*. 
\v 9 \w The voice| strong="H6963" \w* of the \sc Lord\sc* \w maketh the hinds| strong="H355" \w* [to calve]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8787”}, [and discovereth]{strong=“H2834” x-morph=“strongMorph: \sc Th\sc*8799”} \w the forests| strong="H3295" \w*: \w and in his temple| strong="H1964" \w* [doth every one speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} of his \w glory| strong="H3519" \w*.\f + \fr 29:9 \ft to calve: or, to be in pain \f* \f + \fr 29:9 \ft doth…: or, every whit of it uttereth, etc \f* 
\v 10 The \sc Lord\sc* [sitteth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon the flood| strong="H3999" \w*; yea, the \sc Lord\sc* [sitteth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w King| strong="H4428" \w* \w for ever| strong="H5769" \w*. 
\v 11 The \sc Lord\sc* [will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w strength| strong="H5797" \w* \w unto his people| strong="H5971" \w*; the \sc Lord\sc* [will bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w his people| strong="H5971" \w* \w with peace| strong="H7965" \w*.
\c 30
\p 
\w A Psalm| strong="H4210" \w* and \w Song| strong="H7892" \w* at \w the dedication| strong="H2598" \w* \w of the house| strong="H1004" \w* \w of David| strong="H1732" \w*. 
\v 1 [I will extol]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8787”} thee, O \sc Lord\sc*; [for thou hast lifted me up]{strong=“H1802” x-morph=“strongMorph: \sc Th\sc*8765”}, [and hast not made my foes]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [to rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8765”} over me. 
\v 2 O \sc Lord\sc* \w my God| strong="H430" \w*, [I cried]{strong=“H7768” x-morph=“strongMorph: \sc Th\sc*8765”} [unto thee, and thou hast healed]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8799”} me. 
\v 3 O \sc Lord\sc*, [thou hast brought up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} \w my soul| strong="H5315" \w* \w from the grave| strong="H7585" \w*: [thou hast kept me alive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8765”}, [that I should not go down]{strong=“H3381 H3381” x-morph=“strongMorph: \sc Th\sc*8802 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8800”} \w to the pit| strong="H953" \w*. 
\v 4 [Sing]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8761”} unto the \sc Lord\sc*, \w O ye saints| strong="H2623" \w* [of his, and give thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8685”} \w at the remembrance| strong="H2143" \w* \w of his holiness| strong="H6944" \w*.\f + \fr 30:4 \ft at…: or, to the memorial \f* 
\v 5 \w For his anger| strong="H639" \w* endureth but \w a moment| strong="H7281" \w*; \w in his favour| strong="H7522" \w* is \w life| strong="H2416" \w*: \w weeping| strong="H1065" \w* [may endure]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} \w for a night| strong="H6153" \w*, \w but joy| strong="H7440" \w* cometh \w in the morning| strong="H1242" \w*.\f + \fr 30:5 \ft his anger…: Heb. there is but a moment in his anger \f* \f + \fr 30:5 \ft for a night: Heb. in the evening \f* \f + \fr 30:5 \ft joy: Heb. singing \f* 
\v 6 \w And in my prosperity| strong="H7959" \w* [I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w I shall never| strong="H5769" \w* [be moved]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 7 \sc Lord\sc*, \w by thy favour| strong="H7522" \w* \w thou hast made my mountain| strong="H2042" \w* [to stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8689”} \w strong| strong="H5797" \w*: [thou didst hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy face| strong="H6440" \w*, and [I was troubled]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8737”}.\f + \fr 30:7 \ft made…: Heb. settled strength for my mountain \f* 
\v 8 [I cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} to thee, O \sc Lord\sc*; and unto the \sc Lord\sc* [I made supplication]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8691”}. 
\v 9 \w What profit| strong="H1215" \w* is there \w in my blood| strong="H1818" \w*, [when I go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8800”} \w to the pit| strong="H7845" \w*? \w Shall the dust| strong="H6083" \w* [praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} [thee? shall it declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy truth| strong="H571" \w*? 
\v 10 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, O \sc Lord\sc*, [and have mercy]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} upon me: \sc Lord\sc*, [be thou my helper]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 11 [Thou hast turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8804”} \w for me my mourning| strong="H4553" \w* \w into dancing| strong="H4234" \w*: [thou hast put off]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8765”} \w my sackcloth| strong="H8242" \w*, [and girded]{strong=“H247” x-morph=“strongMorph: \sc Th\sc*8762”} \w me with gladness| strong="H8057" \w*; 
\v 12 To the end that my \w glory| strong="H3519" \w* [may sing]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8762”} [praise to thee, and not be silent]{strong=“H1826” x-morph=“strongMorph: \sc Th\sc*8799”}. O \sc Lord\sc* \w my God| strong="H430" \w*, [I will give thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto thee for ever| strong="H5769" \w*.\f + \fr 30:12 \ft my glory: that is, my tongue, or, my soul \f*
\c 31
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 In thee, O \sc Lord\sc*, [do I put my trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8804”}; [let me never]{strong=“H5769 H408”} [be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}: [deliver]{strong=“H6403” x-morph=“strongMorph: \sc Th\sc*8761”} \w me in thy righteousness| strong="H6666" \w*. 
\v 2 [Bow down]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8685”} \w thine ear| strong="H241" \w* [to me; deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} \w me speedily| strong="H4120" \w*: \w be thou my strong| strong="H4581" \w* \w rock| strong="H6697" \w*, \w for an house| strong="H1004" \w* \w of defence| strong="H4686" \w* [to save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8687”} me.\f + \fr 31:2 \ft my…: Heb. to me for a rock of strength \f* 
\v 3 For thou art \w my rock| strong="H5553" \w* \w and my fortress| strong="H4686" \w*; [therefore for thy name’s]{strong=“H8034”} [sake lead]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8686”} [me, and guide]{strong=“H5095” x-morph=“strongMorph: \sc Th\sc*8762”} me. 
\v 4 [Pull me out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w of the net| strong="H7568" \w* \w that| strong="H2098" \w* [they have laid privily]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8804”} for me: for thou art \w my strength| strong="H4581" \w*. 
\v 5 \w Into thine hand| strong="H3027" \w* [I commit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8686”} \w my spirit| strong="H7307" \w*: [thou hast redeemed]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8804”} me, O \sc Lord\sc* \w God| strong="H410" \w* \w of truth| strong="H571" \w*. 
\v 6 [I have hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”} [them that regard]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w lying| strong="H7723" \w* \w vanities| strong="H1892" \w*: [but I trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”} in the \sc Lord\sc*. 
\v 7 [I will be glad]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”} [and rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy mercy| strong="H2617" \w*: [for thou hast considered]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w my trouble| strong="H6040" \w*; [thou hast known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w my soul| strong="H5315" \w* \w in adversities| strong="H6869" \w*; 
\v 8 [And hast not shut me up]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8689”} \w into the hand| strong="H3027" \w* [of the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}: [thou hast set]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8689”} \w my feet| strong="H7272" \w* \w in a large room| strong="H4800" \w*. 
\v 9 [Have mercy]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} upon me, O \sc Lord\sc*, [for I am in trouble]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8804”}: \w mine eye| strong="H5869" \w* [is consumed]{strong=“H6244” x-morph=“strongMorph: \sc Th\sc*8804”} \w with grief| strong="H3708" \w*, yea, \w my soul| strong="H5315" \w* \w and my belly| strong="H990" \w*. 
\v 10 \w For my life| strong="H2416" \w* [is spent]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”} \w with grief| strong="H3015" \w*, \w and my years| strong="H8141" \w* \w with sighing| strong="H585" \w*: \w my strength| strong="H3581" \w* [faileth]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8804”} \w because of mine iniquity| strong="H5771" \w*, \w and my bones| strong="H6106" \w* [are consumed]{strong=“H6244” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 11 \w I was a reproach| strong="H2781" \w* [among all mine enemies]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8802”}, \w but especially| strong="H3966" \w* \w among my neighbours| strong="H7934" \w*, \w and a fear| strong="H6343" \w* [to mine acquaintance]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8794”}: [they that did see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} \w me without| strong="H2351" \w* [fled]{strong=“H5074” x-morph=“strongMorph: \sc Th\sc*8804”} from me. 
\v 12 [I am forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8738”} [as a dead man]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”} \w out of mind| strong="H3820" \w*: [I am like a broken]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8802”} \w vessel| strong="H3627" \w*.\f + \fr 31:12 \ft a broken…: Heb. a vessel that perisheth \f* 
\v 13 [For I have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the slander| strong="H1681" \w* \w of many| strong="H7227" \w*: \w fear| strong="H4032" \w* was \w on every side| strong="H5439" \w*: [while they took counsel]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8736”} \w together| strong="H3162" \w* [against me, they devised]{strong=“H2161” x-morph=“strongMorph: \sc Th\sc*8804”} [to take away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} \w my life| strong="H5315" \w*. 
\v 14 [But I trusted]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”} in thee, O \sc Lord\sc*: [I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, Thou art \w my God| strong="H430" \w*. 
\v 15 \w My times| strong="H6256" \w* are \w in thy hand| strong="H3027" \w*: [deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} \w me from the hand| strong="H3027" \w* [of mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, [and from them that persecute]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8802”} me. 
\v 16 \w Make thy face| strong="H6440" \w* [to shine]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8685”} \w upon thy servant| strong="H5650" \w*: [save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”} [me for thy mercies’]{strong=“H2617”} sake. 
\v 17 [Let me not be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}, O \sc Lord\sc*; [for I have called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [upon thee: let the wicked]{strong=“H7563”} [be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}, and [let them be silent]{strong=“H1826” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the grave| strong="H7585" \w*.\f + \fr 31:17 \ft silent…: or, cut off for \f* 
\v 18 \w Let the lying| strong="H8267" \w* \w lips| strong="H8193" \w* [be put to silence]{strong=“H481” x-morph=“strongMorph: \sc Th\sc*8735”}; [which speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} \w grievous| strong="H6277" \w* \w things proudly| strong="H1346" \w* \w and contemptuously| strong="H937" \w* \w against the righteous| strong="H6662" \w*.\f + \fr 31:18 \ft grievous…: Heb. a hard thing \f* 
\v 19 Oh \w how great| strong="H7227" \w* is \w thy goodness| strong="H2898" \w*, [which thou hast laid up]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8804”} \w for them that fear| strong="H3373" \w* thee; which [thou hast wrought]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8804”} [for them that trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8802”} \w in thee before the sons| strong="H1121" \w* \w of men| strong="H120" \w*! 
\v 20 [Thou shalt hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8686”} \w them in the secret| strong="H5643" \w* \w of thy presence| strong="H6440" \w* \w from the pride| strong="H7407" \w* \w of man| strong="H376" \w*: [thou shalt keep them secretly]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8799”} \w in a pavilion| strong="H5521" \w* \w from the strife| strong="H7379" \w* \w of tongues| strong="H3956" \w*. 
\v 21 [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} be the \sc Lord\sc*: [for he hath shewed me his marvellous]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8689”} \w kindness| strong="H2617" \w* \w in a strong| strong="H4692" \w* \w city| strong="H5892" \w*.\f + \fr 31:21 \ft strong: or, fenced \f* 
\v 22 [For I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [in my haste]{strong=“H2648” x-morph=“strongMorph: \sc Th\sc*8800”}, [I am cut off]{strong=“H1629” x-morph=“strongMorph: \sc Th\sc*8738”} \w from before| strong="H5048" \w* \w thine eyes| strong="H5869" \w*: \w nevertheless| strong="H403" \w* [thou heardest]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the voice| strong="H6963" \w* \w of my supplications| strong="H8469" \w* [when I cried]{strong=“H7768” x-morph=“strongMorph: \sc Th\sc*8763”} unto thee. 
\v 23 [O love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8798”} the \sc Lord\sc*, \w all ye his saints| strong="H2623" \w*: for the \sc Lord\sc* [preserveth]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8802”} [the faithful]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8803”}, \w and plentifully| strong="H3499" \w* [rewardeth]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8764”} \w the proud| strong="H1346" \w* [doer]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 24 [Be of good courage]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8798”}, [and he shall strengthen]{strong=“H553” x-morph=“strongMorph: \sc Th\sc*8686”} \w your heart| strong="H3824" \w*, [all ye that hope]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8764”} in the \sc Lord\sc*.
\c 32
\p 
A Psalm \w of David| strong="H1732" \w*, [Maschil]{strong=“H4905” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 1 \w Blessed| strong="H835" \w* is he whose \w transgression| strong="H6588" \w* is [forgiven]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8803”}, whose \w sin| strong="H2401" \w* is [covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8803”}.\f + \fr 32:1 \ft A Psalm…: or, A Psalm of David giving instruction \f* 
\v 2 \w Blessed| strong="H835" \w* is \w the man| strong="H120" \w* unto whom the \sc Lord\sc* [imputeth]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8799”} \w not iniquity| strong="H5771" \w*, \w and in whose spirit| strong="H7307" \w* there is \w no guile| strong="H7423" \w*. 
\v 3 [When I kept silence]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8689”}, \w my bones| strong="H6106" \w* [waxed old]{strong=“H1086” x-morph=“strongMorph: \sc Th\sc*8804”} \w through my roaring| strong="H7581" \w* \w all the day| strong="H3117" \w* long. 
\v 4 \w For day| strong="H3119" \w* \w and night| strong="H3915" \w* \w thy hand| strong="H3027" \w* [was heavy]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8799”} [upon me: my moisture]{strong=“H3955”} [is turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8738”} \w into the drought| strong="H2725" \w* \w of summer| strong="H7019" \w*. \w Selah| strong="H5542" \w*. 
\v 5 [I acknowledged]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8686”} \w my sin| strong="H2403" \w* [unto thee, and mine iniquity]{strong=“H5771”} [have I not hid]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”}. [I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [I will confess]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} \w my transgressions| strong="H6588" \w* unto the \sc Lord\sc*; [and thou forgavest]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w the iniquity| strong="H5771" \w* \w of my sin| strong="H2403" \w*. \w Selah| strong="H5542" \w*. 
\v 6 \w For this shall every one that is godly| strong="H2623" \w* [pray]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8691”} \w unto thee in a time| strong="H6256" \w* [when thou mayest be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8800”}: \w surely in the floods| strong="H7858" \w* \w of great| strong="H7227" \w* \w waters| strong="H4325" \w* [they shall not come nigh]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8686”} unto him.\f + \fr 32:6 \ft when…: Heb. of finding \f* 
\v 7 Thou art \w my hiding place| strong="H5643" \w*; [thou shalt preserve]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8799”} \w me from trouble| strong="H6862" \w*; [thou shalt compass]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8779”} \w me about with songs| strong="H7438" \w* \w of deliverance| strong="H6405" \w*. \w Selah| strong="H5542" \w*. 
\v 8 [I will instruct]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8686”} [thee and teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee in the way| strong="H1870" \w* \w which| strong="H2098" \w* [thou shalt go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}: [I will guide]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee with mine eye| strong="H5869" \w*.\f + \fr 32:8 \ft guide…: Heb. counsel thee, mine eye shall be upon thee \f* 
\v 9 \w Be ye not as the horse| strong="H5483" \w*, or \w as the mule| strong="H6505" \w*, which [have no understanding]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8687”}: \w whose mouth| strong="H5716" \w* [must be held]{strong=“H1102” x-morph=“strongMorph: \sc Th\sc*8800”} \w in with bit| strong="H4964" \w* \w and bridle| strong="H7448" \w*, \w lest| strong="H1077" \w* [they come near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8800”} unto thee. 
\v 10 \w Many| strong="H7227" \w* \w sorrows| strong="H4341" \w* shall be \w to the wicked| strong="H7563" \w*: [but he that trusteth]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”} in the \sc Lord\sc*, \w mercy| strong="H2617" \w* [shall compass]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8779”} him about. 
\v 11 [Be glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8798”} in the \sc Lord\sc*, [and rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8798”}, \w ye righteous| strong="H6662" \w*: [and shout]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8685”} for joy, all ye that are \w upright| strong="H3477" \w* \w in heart| strong="H3820" \w*.
\c 33
\p 
\v 1 [Rejoice]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8761”} in the \sc Lord\sc*, \w O ye righteous| strong="H6662" \w*: for \w praise| strong="H8416" \w* \w is comely| strong="H5000" \w* \w for the upright| strong="H3477" \w*. 
\v 2 [Praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8685”} the \sc Lord\sc* \w with harp| strong="H3658" \w*: [sing]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8761”} \w unto him with the psaltery| strong="H5035" \w* and \w an instrument of ten strings| strong="H6218" \w*. 
\v 3 [Sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto him a new| strong="H2319" \w* \w song| strong="H7892" \w*; [play]{strong=“H5059” x-morph=“strongMorph: \sc Th\sc*8763”} [skilfully]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8685”} \w with a loud noise| strong="H8643" \w*. 
\v 4 \w For the word| strong="H1697" \w* of the \sc Lord\sc* is \w right| strong="H3477" \w*; \w and all his works| strong="H4639" \w* are done \w in truth| strong="H530" \w*. 
\v 5 [He loveth]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} \w righteousness| strong="H6666" \w* \w and judgment| strong="H4941" \w*: \w the earth| strong="H776" \w* [is full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the goodness| strong="H2617" \w* of the \sc Lord\sc*.\f + \fr 33:5 \ft goodness: or, mercy \f* 
\v 6 \w By the word| strong="H1697" \w* of the \sc Lord\sc* \w were the heavens| strong="H8064" \w* [made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8738”}; \w and all the host| strong="H6635" \w* \w of them by the breath| strong="H7307" \w* \w of his mouth| strong="H6310" \w*. 
\v 7 [He gathereth]{strong=“H3664” x-morph=“strongMorph: \sc Th\sc*8802”} \w the waters| strong="H4325" \w* \w of the sea| strong="H3220" \w* \w together as an heap| strong="H5067" \w*: [he layeth up]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w the depth| strong="H8415" \w* \w in storehouses| strong="H214" \w*. 
\v 8 \w Let all the earth| strong="H776" \w* [fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc*: [let all the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the world| strong="H8398" \w* [stand in awe]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”} of him. 
\v 9 [For he spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, and it was done; [he commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”}, [and it stood fast]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 10 The \sc Lord\sc* \w bringeth| strong="H6331" \w* \w the counsel| strong="H6098" \w* \w of the heathen| strong="H1471" \w* [to nought]{strong=“H6331” x-morph=“strongMorph: \sc Th\sc*8689”}: \w he maketh| strong="H5106" \w* \w the devices| strong="H4284" \w* \w of the people| strong="H5971" \w* [of none effect]{strong=“H5106” x-morph=“strongMorph: \sc Th\sc*8689”}.\f + \fr 33:10 \ft bringeth: Heb. maketh frustrate \f* 
\v 11 \w The counsel| strong="H6098" \w* of the \sc Lord\sc* [standeth]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w for ever| strong="H5769" \w*, \w the thoughts| strong="H4284" \w* \w of his heart| strong="H3820" \w* \w to all| strong="H1755" \w* \w generations| strong="H1755" \w*.\f + \fr 33:11 \ft to all…: Heb. to generation and generation \f* 
\v 12 \w Blessed| strong="H835" \w* is \w the nation| strong="H1471" \w* \w whose God| strong="H430" \w* is the \sc Lord\sc*; and \w the people| strong="H5971" \w* whom [he hath chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} \w for his own inheritance| strong="H5159" \w*. 
\v 13 The \sc Lord\sc* [looketh]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8689”} \w from heaven| strong="H8064" \w*; [he beholdeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w all the sons| strong="H1121" \w* \w of men| strong="H120" \w*. 
\v 14 \w From the place| strong="H4349" \w* [of his habitation]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} [he looketh]{strong=“H7688” x-morph=“strongMorph: \sc Th\sc*8689”} [upon all the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the earth| strong="H776" \w*. 
\v 15 [He fashioneth]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w their hearts| strong="H3820" \w* \w alike| strong="H3162" \w*; [he considereth]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8688”} \w all their works| strong="H4639" \w*. 
\v 16 \w There is no king| strong="H4428" \w* [saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8737”} \w by the multitude| strong="H7230" \w* \w of an host| strong="H2428" \w*: \w a mighty man| strong="H1368" \w* [is not delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8735”} \w by much| strong="H7230" \w* \w strength| strong="H3581" \w*. 
\v 17 \w An horse| strong="H5483" \w* is \w a vain thing| strong="H8267" \w* \w for safety| strong="H8668" \w*: [neither shall he deliver]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8762”} any \w by his great| strong="H7230" \w* \w strength| strong="H2428" \w*. 
\v 18 [Behold, the eye]{strong=“H5869”} of the \sc Lord\sc* is \w upon them that fear| strong="H3373" \w* [him, upon them that hope]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8764”} \w in his mercy| strong="H2617" \w*; 
\v 19 [To deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8687”} \w their soul| strong="H5315" \w* \w from death| strong="H4194" \w*, [and to keep them alive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8763”} \w in famine| strong="H7458" \w*. 
\v 20 \w Our soul| strong="H5315" \w* [waiteth]{strong=“H2442” x-morph=“strongMorph: \sc Th\sc*8765”} for the \sc Lord\sc*: he is \w our help| strong="H5828" \w* \w and our shield| strong="H4043" \w*. 
\v 21 \w For our heart| strong="H3820" \w* [shall rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} [in him, because we have trusted]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his holy| strong="H6944" \w* \w name| strong="H8034" \w*. 
\v 22 \w Let thy mercy| strong="H2617" \w*, O \sc Lord\sc*, [be upon us, according as we hope]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8765”} in thee.
\c 34
\p 
A Psalm \w of David| strong="H1732" \w*, [when he changed]{strong=“H8138” x-morph=“strongMorph: \sc Th\sc*8763”} \w his behaviour| strong="H2940" \w* \w before| strong="H6440" \w* \w Abimelech| strong="H40" \w*; [who drove him away]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8762”}, [and he departed]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 1 [I will bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} the \sc Lord\sc* \w at all times| strong="H6256" \w*: \w his praise| strong="H8416" \w* shall \w continually| strong="H8548" \w* be \w in my mouth| strong="H6310" \w*.\f + \fr 34:1 \ft Abimelech: or, Achish \f* 
\v 2 \w My soul| strong="H5315" \w* [shall make her boast]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8691”} in the \sc Lord\sc*: \w the humble| strong="H6035" \w* [shall hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} thereof, [and be glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 3 [O magnify]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc* [with me, and let us exalt]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8787”} \w his name| strong="H8034" \w* \w together| strong="H3162" \w*. 
\v 4 [I sought]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [and he heard]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w me from all my fears| strong="H4035" \w*. 
\v 5 [They looked]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8689”} [unto him, and were lightened]{strong=“H5102” x-morph=“strongMorph: \sc Th\sc*8804”}: \w and their faces| strong="H6440" \w* [were not ashamed]{strong=“H2659” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 34:5 \ft were lightened: or, they flowed unto him \f* 
\v 6 \w This poor man| strong="H6041" \w* [cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”}, and the \sc Lord\sc* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} him, [and saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8689”} \w him out of all his troubles| strong="H6869" \w*. 
\v 7 \w The angel| strong="H4397" \w* of the \sc Lord\sc* [encampeth]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8802”} \w round about| strong="H5439" \w* \w them that fear| strong="H3373" \w* [him, and delivereth]{strong=“H2502” x-morph=“strongMorph: \sc Th\sc*8762”} them. 
\v 8 [O taste]{strong=“H2938” x-morph=“strongMorph: \sc Th\sc*8798”} [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} that the \sc Lord\sc* is \w good| strong="H2896" \w*: \w blessed| strong="H835" \w* is \w the man| strong="H1397" \w* that [trusteth]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8799”} in him. 
\v 9 [O fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8798”} the \sc Lord\sc*, \w ye his saints| strong="H6918" \w*: for there is \w no want| strong="H4270" \w* \w to them that fear| strong="H3373" \w* him. 
\v 10 \w The young lions| strong="H3715" \w* [do lack]{strong=“H7326” x-morph=“strongMorph: \sc Th\sc*8804”}, [and suffer hunger]{strong=“H7456” x-morph=“strongMorph: \sc Th\sc*8804”}: [but they that seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8802”} the \sc Lord\sc* [shall not want]{strong=“H2637” x-morph=“strongMorph: \sc Th\sc*8799”} \w any good| strong="H2896" \w* thing. 
\v 11 [Come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, \w ye children| strong="H1121" \w*, [hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me: I will teach]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8762”} \w you the fear| strong="H3374" \w* of the \sc Lord\sc*. 
\v 12 \w What man| strong="H376" \w* is he that \w desireth| strong="H2655" \w* \w life| strong="H2416" \w*, and [loveth]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} many \w days| strong="H3117" \w*, [that he may see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w good| strong="H2896" \w*? 
\v 13 [Keep]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy tongue| strong="H3956" \w* \w from evil| strong="H7451" \w*, \w and thy lips| strong="H8193" \w* [from speaking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w guile| strong="H4820" \w*. 
\v 14 [Depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8798”} \w from evil| strong="H7451" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} \w good| strong="H2896" \w*; [seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8761”} \w peace| strong="H7965" \w*, [and pursue]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8798”} it. 
\v 15 \w The eyes| strong="H5869" \w* of the \sc Lord\sc* are \w upon the righteous| strong="H6662" \w*, \w and his ears| strong="H241" \w* are open \w unto their cry| strong="H7775" \w*. 
\v 16 \w The face| strong="H6440" \w* of the \sc Lord\sc* is [against them that do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w evil| strong="H7451" \w*, [to cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8687”} \w the remembrance| strong="H2143" \w* \w of them from the earth| strong="H776" \w*. 
\v 17 The righteous [cry]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8804”}, and the \sc Lord\sc* [heareth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}, [and delivereth]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w them out of all their troubles| strong="H6869" \w*. 
\v 18 The \sc Lord\sc* is \w nigh| strong="H7138" \w* [unto them that are of a broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8737”} \w heart| strong="H3820" \w*; [and saveth]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} \w such as be of a contrite| strong="H1793" \w* \w spirit| strong="H7307" \w*.\f + \fr 34:18 \ft unto…: Heb. to the broken of heart \f* \f + \fr 34:18 \ft of a contrite…: Heb. contrite of spirit \f* 
\v 19 \w Many| strong="H7227" \w* are \w the afflictions| strong="H7451" \w* \w of the righteous| strong="H6662" \w*: but the \sc Lord\sc* [delivereth]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} him out of them all. 
\v 20 [He keepeth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w all his bones| strong="H6106" \w*: \w not one| strong="H259" \w* \w of them| strong="H2007" \w* [is broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 21 \w Evil| strong="H7451" \w* [shall slay]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8787”} \w the wicked| strong="H7563" \w*: [and they that hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} \w the righteous| strong="H6662" \w* [shall be desolate]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 34:21 \ft desolate: or, guilty \f* 
\v 22 The \sc Lord\sc* [redeemeth]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8802”} \w the soul| strong="H5315" \w* \w of his servants| strong="H5650" \w*: [and none of them that trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8802”} [in him shall be desolate]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 34:22 \ft desolate: or, guilty \f*
\c 35
\p 
A Psalm \w of David| strong="H1732" \w*. 
\v 1 [Plead]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8798”} my cause, O \sc Lord\sc*, \w with them that strive| strong="H3401" \w* [with me: fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8798”} [against them that fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8802”} against me. 
\v 2 [Take hold]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8685”} \w of shield| strong="H4043" \w* \w and buckler| strong="H6793" \w*, [and stand up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”} \w for mine help| strong="H5833" \w*. 
\v 3 [Draw out]{strong=“H7324” x-morph=“strongMorph: \sc Th\sc*8685”} \w also the spear| strong="H2595" \w*, [and stop]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8798”} the way [against]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} [them that persecute]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8802”} [me: say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto my soul| strong="H5315" \w*, I am \w thy salvation| strong="H3444" \w*. 
\v 4 [Let them be confounded]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} [and put to shame]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8735”} [that seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w after my soul| strong="H5315" \w*: [let them be turned]{strong=“H5472” x-morph=“strongMorph: \sc Th\sc*8735”} \w back| strong="H268" \w* [and brought to confusion]{strong=“H2659” x-morph=“strongMorph: \sc Th\sc*8799”} [that devise]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8802”} \w my hurt| strong="H7451" \w*. 
\v 5 \w Let them be as chaff| strong="H4671" \w* \w before| strong="H6440" \w* \w the wind| strong="H7307" \w*: \w and let the angel| strong="H4397" \w* of the \sc Lord\sc* [chase]{strong=“H1760” x-morph=“strongMorph: \sc Th\sc*8802”} them. 
\v 6 \w Let their way| strong="H1870" \w* \w be dark| strong="H2822" \w* \w and slippery| strong="H2519" \w*: \w and let the angel| strong="H4397" \w* of the \sc Lord\sc* [persecute]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8802”} them.\f + \fr 35:6 \ft dark…: Heb. darkness and slipperiness \f* 
\v 7 \w For without cause| strong="H2600" \w* [have they hid]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8804”} \w for me their net| strong="H7568" \w* in \w a pit| strong="H7845" \w*, which \w without cause| strong="H2600" \w* [they have digged]{strong=“H2658” x-morph=“strongMorph: \sc Th\sc*8804”} \w for my soul| strong="H5315" \w*. 
\v 8 \w Let destruction| strong="H7722" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [upon him at unawares]{strong=“H3808 H3045” x-morph=“strongMorph: \sc Th\sc*8799”}; \w and let his net| strong="H7568" \w* [that he hath hid]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8804”} [catch]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8799”} [himself: into that very destruction]{strong=“H7722”} [let him fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 35:8 \ft at…: Heb. which he knoweth not of \f* 
\v 9 \w And my soul| strong="H5315" \w* [shall be joyful]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”} in the \sc Lord\sc*: [it shall rejoice]{strong=“H7797” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his salvation| strong="H3444" \w*. 
\v 10 \w All my bones| strong="H6106" \w* [shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \sc Lord\sc*, who is [like unto thee, which deliverest]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8688”} \w the poor| strong="H6041" \w* \w from him that is too strong| strong="H2389" \w* [for him, yea, the poor]{strong=“H6041”} \w and the needy| strong="H34" \w* [from him that spoileth]{strong=“H1497” x-morph=“strongMorph: \sc Th\sc*8802”} him? 
\v 11 \w False| strong="H2555" \w* \w witnesses| strong="H5707" \w* [did rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}; [they laid to my charge]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} things [that I knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} not.\f + \fr 35:11 \ft False…: Heb. Witnesses of wrong \f* \f + \fr 35:11 \ft they…: Heb. they asked me \f* 
\v 12 [They rewarded]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w me evil| strong="H7451" \w* \w for good| strong="H2896" \w* to \w the spoiling| strong="H7908" \w* \w of my soul| strong="H5315" \w*.\f + \fr 35:12 \ft spoiling: Heb. depriving \f* 
\v 13 [But as for me, when they were sick]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8800”}, \w my clothing| strong="H3830" \w* was \w sackcloth| strong="H8242" \w*: [I humbled]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8765”} \w my soul| strong="H5315" \w* \w with fasting| strong="H6685" \w*; \w and my prayer| strong="H8605" \w* [returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w into mine own bosom| strong="H2436" \w*.\f + \fr 35:13 \ft humbled: or, afflicted \f* 
\v 14 [I behaved]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8694”} myself as though he had been \w my friend| strong="H7453" \w* or \w brother| strong="H251" \w*: [I bowed down]{strong=“H7817” x-morph=“strongMorph: \sc Th\sc*8804”} [heavily]{strong=“H6937” x-morph=“strongMorph: \sc Th\sc*8802”}, \w as one that mourneth| strong="H57" \w* for his \w mother| strong="H517" \w*.\f + \fr 35:14 \ft behaved myself: Heb. walked \f* \f + \fr 35:14 \ft as though…: Heb. as a friend, as a brother to me \f* 
\v 15 \w But in mine adversity| strong="H6761" \w* [they rejoiced]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8804”}, [and gathered themselves together]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8738”}: yea, \w the abjects| strong="H5222" \w* [gathered themselves together]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8738”} [against me, and I knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} it [not; they did tear]{strong=“H7167” x-morph=“strongMorph: \sc Th\sc*8804”} me, [and ceased]{strong=“H1826” x-morph=“strongMorph: \sc Th\sc*8804”} not:\f + \fr 35:15 \ft adversity: Heb. halting \f* 
\v 16 \w With hypocritical| strong="H2611" \w* \w mockers| strong="H3934" \w* \w in feasts| strong="H4580" \w*, [they gnashed]{strong=“H2786” x-morph=“strongMorph: \sc Th\sc*8800”} \w upon me with their teeth| strong="H8127" \w*. 
\v 17 \w Lord| strong="H136" \w*, [how long wilt thou look on]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}? [rescue]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”} \w my soul| strong="H5315" \w* \w from their destructions| strong="H7722" \w*, \w my darling| strong="H3173" \w* \w from the lions| strong="H3715" \w*.\f + \fr 35:17 \ft darling: Heb. only one \f* 
\v 18 [I will give thee thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} \w in the great| strong="H7227" \w* \w congregation| strong="H6951" \w*: [I will praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} \w thee among much| strong="H6099" \w* \w people| strong="H5971" \w*.\f + \fr 35:18 \ft much: Heb. strong \f* 
\v 19 [Let not them that are mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w wrongfully| strong="H8267" \w* [rejoice ]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} over me: neither [let them wink]{strong=“H7169” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the eye| strong="H5869" \w* [that hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} \w me without a cause| strong="H2600" \w*.\f + \fr 35:19 \ft wrongfully: Heb. falsely \f* 
\v 20 [For they speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w not peace| strong="H7965" \w*: [but they devise]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8799”} \w deceitful| strong="H4820" \w* \w matters| strong="H1697" \w* against them that are \w quiet| strong="H7282" \w* \w in the land| strong="H776" \w*. 
\v 21 [Yea, they opened their mouth]{strong=“H6310”} [wide]{strong=“H7337” x-morph=“strongMorph: \sc Th\sc*8686”} against me, and [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Aha| strong="H1889" \w*, \w aha| strong="H1889" \w*, \w our eye| strong="H5869" \w* [hath seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} it. 
\v 22 This [thou hast seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”}, O \sc Lord\sc*: [keep not silence]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8799”}: \w O Lord| strong="H136" \w*, [be not far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8799”} from me. 
\v 23 [Stir up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8685”} [thyself, and awake]{strong=“H6974” x-morph=“strongMorph: \sc Th\sc*8685”} \w to my judgment| strong="H4941" \w*, even \w unto my cause| strong="H7379" \w*, \w my God| strong="H430" \w* \w and my Lord| strong="H136" \w*. 
\v 24 [Judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8798”} me, O \sc Lord\sc* \w my God| strong="H430" \w*, \w according to thy righteousness| strong="H6664" \w*; [and let them not rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} over me. 
\v 25 [Let them not say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w in their hearts| strong="H3820" \w*, \w Ah| strong="H1889" \w*, \w so would we have it| strong="H5315" \w*: [let them not say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [We have swallowed him up]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8765”}.\f + \fr 35:25 \ft Ah…: Heb. Ah, ah, our soul \f* 
\v 26 [Let them be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} [and brought to confusion]{strong=“H2659” x-morph=“strongMorph: \sc Th\sc*8799”} \w together| strong="H3162" \w* \w that rejoice| strong="H8056" \w* \w at mine hurt| strong="H7451" \w*: [let them be clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w with shame| strong="H1322" \w* \w and dishonour| strong="H3639" \w* [that magnify]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8688”} themselves against me. 
\v 27 [Let them shout for joy]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8799”}, [and be glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”}, \w that favour| strong="H2655" \w* \w my righteous cause| strong="H6664" \w*: [yea, let them say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w continually| strong="H8548" \w*, Let the \sc Lord\sc* [be magnified]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8799”}, \w which hath pleasure| strong="H2655" \w* \w in the prosperity| strong="H7965" \w* \w of his servant| strong="H5650" \w*.\f + \fr 35:27 \ft righteous…: Heb. righteousness \f* 
\v 28 \w And my tongue| strong="H3956" \w* [shall speak]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8799”} \w of thy righteousness| strong="H6664" \w* and \w of thy praise| strong="H8416" \w* \w all the day| strong="H3117" \w* long.
\c 36
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, A Psalm \w of David| strong="H1732" \w* \w the servant| strong="H5650" \w* of the \sc Lord\sc*. 
\v 1 \w The transgression| strong="H6588" \w* \w of the wicked| strong="H7563" \w* [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w within| strong="H7130" \w* \w my heart| strong="H3820" \w*, that there is \w no fear| strong="H6343" \w* \w of God| strong="H430" \w* \w before his eyes| strong="H5869" \w*. 
\v 2 [For he flattereth]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8689”} \w himself in his own eyes| strong="H5869" \w*, \w until his iniquity| strong="H5771" \w* [be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8800”} [to be hateful]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 36:2 \ft until…: Heb. to find his iniquity to hate \f* 
\v 3 \w The words| strong="H1697" \w* \w of his mouth| strong="H6310" \w* are \w iniquity| strong="H205" \w* \w and deceit| strong="H4820" \w*: [he hath left off]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8804”} [to be wise]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8687”}, and [to do good]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8687”}. 
\v 4 [He deviseth]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8799”} \w mischief| strong="H205" \w* \w upon his bed| strong="H4904" \w*; [he setteth]{strong=“H3320” x-morph=“strongMorph: \sc Th\sc*8691”} \w himself in a way| strong="H1870" \w* that is \w not good| strong="H2896" \w*; [he abhorreth]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8799”} \w not evil| strong="H7451" \w*.\f + \fr 36:4 \ft mischief: or, vanity \f* 
\v 5 \w Thy mercy| strong="H2617" \w*, O \sc Lord\sc*, is \w in the heavens| strong="H8064" \w*; and \w thy faithfulness| strong="H530" \w* reacheth \w unto the clouds| strong="H7834" \w*. 
\v 6 \w Thy righteousness| strong="H6666" \w* is \w like the great| strong="H410" \w* \w mountains| strong="H2042" \w*; \w thy judgments| strong="H4941" \w* are \w a great| strong="H7227" \w* \w deep| strong="H8415" \w*: O \sc Lord\sc*, [thou preservest]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} \w man| strong="H120" \w* \w and beast| strong="H929" \w*.\f + \fr 36:6 \ft the…: Heb. the mountains of God \f* 
\v 7 \w How excellent| strong="H3368" \w* is \w thy lovingkindness| strong="H2617" \w*, \w O God| strong="H430" \w*! \w therefore the children| strong="H1121" \w* \w of men| strong="H120" \w* [put their trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8799”} \w under the shadow| strong="H6738" \w* \w of thy wings| strong="H3671" \w*.\f + \fr 36:7 \ft excellent: Heb. precious \f* 
\v 8 [They shall be abundantly satisfied]{strong=“H7301” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the fatness| strong="H1880" \w* \w of thy house| strong="H1004" \w*; [and thou shalt make them drink]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8686”} \w of the river| strong="H5158" \w* \w of thy pleasures| strong="H5730" \w*.\f + \fr 36:8 \ft abundantly…: Heb. watered \f* 
\v 9 For with thee is \w the fountain| strong="H4726" \w* \w of life| strong="H2416" \w*: \w in thy light| strong="H216" \w* [shall we see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w light| strong="H216" \w*. 
\v 10 [O continue]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy lovingkindness| strong="H2617" \w* [unto them that know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} [thee; and thy righteousness]{strong=“H6666”} \w to the upright| strong="H3477" \w* \w in heart| strong="H3820" \w*.\f + \fr 36:10 \ft continue: Heb. draw out at length \f* 
\v 11 \w Let not the foot| strong="H7272" \w* \w of pride| strong="H1346" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [against me, and let not the hand]{strong=“H3027”} \w of the wicked| strong="H7563" \w* [remove]{strong=“H5110” x-morph=“strongMorph: \sc Th\sc*8686”} me. 
\v 12 [There are the workers]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w of iniquity| strong="H205" \w* [fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”}: [they are cast down]{strong=“H1760” x-morph=“strongMorph: \sc Th\sc*8795”}, [and shall not be able]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8804”} [to rise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8800”}.
\c 37
\p 
A Psalm \w of David| strong="H1732" \w*. 
\v 1 [Fret]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8691”} [not thyself because of evildoers]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8688”}, [neither be thou envious]{strong=“H7065” x-morph=“strongMorph: \sc Th\sc*8762”} [against the workers]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w of iniquity| strong="H5766" \w*. 
\v 2 \w For they shall soon| strong="H4120" \w* [be cut down]{strong=“H5243” x-morph=“strongMorph: \sc Th\sc*8799”} \w like the grass| strong="H2682" \w*, [and wither]{strong=“H5034” x-morph=“strongMorph: \sc Th\sc*8799”} \w as the green| strong="H3418" \w* \w herb| strong="H1877" \w*. 
\v 3 [Trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8798”} in the \sc Lord\sc*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} \w good| strong="H2896" \w*; so [shalt thou dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8798”} \w in the land| strong="H776" \w*, \w and verily| strong="H530" \w* [thou shalt be fed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8798”}.\f + \fr 37:3 \ft verily: Heb. in truth, or, stableness \f* 
\v 4 [Delight]{strong=“H6026” x-morph=“strongMorph: \sc Th\sc*8690”} thyself also in the \sc Lord\sc*; [and he shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee the desires| strong="H4862" \w* \w of thine heart| strong="H3820" \w*. 
\v 5 [Commit]{strong=“H1556” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy way| strong="H1870" \w* unto the \sc Lord\sc*; [trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8798”} also in him; and he shall bring it [to pass]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 37:5 \ft Commit…: Heb. Roll thy way upon \f* 
\v 6 [And he shall bring forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy righteousness| strong="H6664" \w* \w as the light| strong="H216" \w*, \w and thy judgment| strong="H4941" \w* \w as the noonday| strong="H6672" \w*. 
\v 7 [Rest]{strong=“H1826” x-morph=“strongMorph: \sc Th\sc*8798”} in the \sc Lord\sc*, [and wait patiently]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8708”} [for him: fret]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8691”} [not thyself because of him who prospereth]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8688”} \w in his way| strong="H1870" \w*, \w because of the man| strong="H376" \w* \w who bringeth| strong="H6213" \w* \w wicked devices| strong="H4209" \w* [to pass]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 37:7 \ft Rest in: Heb. Be silent to \f* 
\v 8 [Cease]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8685”} \w from anger| strong="H639" \w*, [and forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8798”} \w wrath| strong="H2534" \w*: [fret]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8691”} \w not thyself in any wise| strong="H389" \w* [to do evil]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8687”}. 
\v 9 [For evildoers]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8688”} [shall be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8735”}: [but those that wait]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8802”} upon the \sc Lord\sc*, [they shall inherit]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8799”} \w the earth| strong="H776" \w*. 
\v 10 \w For yet a little while| strong="H4592" \w*, \w and the wicked| strong="H7563" \w* shall not be: [yea, thou shalt diligently consider]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8712”} \w his place| strong="H4725" \w*, and it shall not be. 
\v 11 \w But the meek| strong="H6035" \w* [shall inherit]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8799”} \w the earth| strong="H776" \w*; [and shall delight]{strong=“H6026” x-morph=“strongMorph: \sc Th\sc*8694”} \w themselves in the abundance| strong="H7230" \w* \w of peace| strong="H7965" \w*. 
\v 12 \w The wicked| strong="H7563" \w* [plotteth]{strong=“H2161” x-morph=“strongMorph: \sc Th\sc*8802”} \w against the just| strong="H6662" \w*, [and gnasheth]{strong=“H2786” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon him with his teeth| strong="H8127" \w*.\f + \fr 37:12 \ft plotteth: or, practiseth \f* 
\v 13 \w The Lord| strong="H136" \w* [shall laugh]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8799”} [at him: for he seeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w that his day| strong="H3117" \w* [is coming]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 14 \w The wicked| strong="H7563" \w* [have drawn out]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8804”} \w the sword| strong="H2719" \w*, [and have bent]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8804”} \w their bow| strong="H7198" \w*, [to cast down]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8687”} \w the poor| strong="H6041" \w* \w and needy| strong="H34" \w*, and [to slay]{strong=“H2873” x-morph=“strongMorph: \sc Th\sc*8800”} \w such as be of upright| strong="H3477" \w* \w conversation| strong="H1870" \w*.\f + \fr 37:14 \ft such…: Heb. the upright of way \f* 
\v 15 \w Their sword| strong="H2719" \w* [shall enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into their own heart| strong="H3820" \w*, \w and their bows| strong="H7198" \w* [shall be broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 16 \w A little| strong="H4592" \w* \w that a righteous man| strong="H6662" \w* hath is \w better| strong="H2896" \w* \w than the riches| strong="H1995" \w* \w of many| strong="H7227" \w* \w wicked| strong="H7563" \w*. 
\v 17 \w For the arms| strong="H2220" \w* \w of the wicked| strong="H7563" \w* [shall be broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8735”}: but the \sc Lord\sc* [upholdeth]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8802”} \w the righteous| strong="H6662" \w*. 
\v 18 The \sc Lord\sc* [knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w the days| strong="H3117" \w* \w of the upright| strong="H8549" \w*: \w and their inheritance| strong="H5159" \w* \w shall be for ever| strong="H5769" \w*. 
\v 19 [They shall not be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the evil| strong="H7451" \w* \w time| strong="H6256" \w*: \w and in the days| strong="H3117" \w* \w of famine| strong="H7459" \w* [they shall be satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 20 \w But the wicked| strong="H7563" \w* [shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}, [and the enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} of the \sc Lord\sc* shall be \w as the fat| strong="H3368" \w* \w of lambs| strong="H3733" \w*: [they shall consume]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”}; \w into smoke| strong="H6227" \w* [shall they consume away]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 37:20 \ft the fat: Heb. the preciousness \f* 
\v 21 \w The wicked| strong="H7563" \w* [borroweth]{strong=“H3867” x-morph=“strongMorph: \sc Th\sc*8801”}, [and payeth not again]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”}: \w but the righteous| strong="H6662" \w* [sheweth mercy]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8802”}, [and giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 22 For such as be [blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8794”} [of him shall inherit]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8799”} \w the earth| strong="H776" \w*; and they that be [cursed]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8794”} [of him shall be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 23 \w The steps| strong="H4703" \w* of a good \w man| strong="H1397" \w* [are ordered]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8797”} by the \sc Lord\sc*: [and he delighteth]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his way| strong="H1870" \w*.\f + \fr 37:23 \ft ordered: or, established \f* 
\v 24 [Though he fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”}, [he shall not be utterly cast down]{strong=“H2904” x-morph=“strongMorph: \sc Th\sc*8714”}: for the \sc Lord\sc* [upholdeth]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8802”} him with \w his hand| strong="H3027" \w*. 
\v 25 \w I have been young| strong="H5288" \w*, and now [am old]{strong=“H2204” x-morph=“strongMorph: \sc Th\sc*8804”}; [yet have I not seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the righteous| strong="H6662" \w* [forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8737”}, \w nor his seed| strong="H2233" \w* [begging]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w bread| strong="H3899" \w*. 
\v 26 He is \w ever| strong="H3117" \w* [merciful]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8802”}, [and lendeth]{strong=“H3867” x-morph=“strongMorph: \sc Th\sc*8688”}; \w and his seed| strong="H2233" \w* is \w blessed| strong="H1293" \w*.\f + \fr 37:26 \ft ever: Heb. all the day \f* 
\v 27 [Depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8798”} \w from evil| strong="H7451" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} \w good| strong="H2896" \w*; [and dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8798”} \w for evermore| strong="H5769" \w*. 
\v 28 For the \sc Lord\sc* [loveth]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} \w judgment| strong="H4941" \w*, [and forsaketh]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w not his saints| strong="H2623" \w*; [they are preserved]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8738”} \w for ever| strong="H5769" \w*: \w but the seed| strong="H2233" \w* \w of the wicked| strong="H7563" \w* [shall be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 29 \w The righteous| strong="H6662" \w* [shall inherit]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8799”} \w the land| strong="H776" \w*, [and dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} \w therein for ever| strong="H5703" \w*. 
\v 30 \w The mouth| strong="H6310" \w* \w of the righteous| strong="H6662" \w* [speaketh]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8799”} \w wisdom| strong="H2451" \w*, \w and his tongue| strong="H3956" \w* [talketh]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w of judgment| strong="H4941" \w*. 
\v 31 \w The law| strong="H8451" \w* \w of his God| strong="H430" \w* is \w in his heart| strong="H3820" \w*; \w none of his steps| strong="H838" \w* [shall slide]{strong=“H4571” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 37:31 \ft steps: or, goings \f* 
\v 32 \w The wicked| strong="H7563" \w* [watcheth]{strong=“H6822” x-morph=“strongMorph: \sc Th\sc*8802”} \w the righteous| strong="H6662" \w*, [and seeketh]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} [to slay]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8687”} him. 
\v 33 The \sc Lord\sc* [will not leave]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w him in his hand| strong="H3027" \w*, [nor condemn]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8686”} [him when he is judged]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8736”}. 
\v 34 [Wait]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8761”} on the \sc Lord\sc*, [and keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8798”} \w his way| strong="H1870" \w*, [and he shall exalt]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8787”} [thee to inherit]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} \w the land| strong="H776" \w*: \w when the wicked| strong="H7563" \w* [are cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8736”}, [thou shalt see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\v 35 [I have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the wicked| strong="H7563" \w* \w in great power| strong="H6184" \w*, [and spreading]{strong=“H6168” x-morph=“strongMorph: \sc Th\sc*8693”} \w himself like a green| strong="H7488" \w* \w bay tree| strong="H249" \w*.\f + \fr 37:35 \ft a green…: or, a green tree that groweth in his own soil \f* 
\v 36 [Yet he passed away]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}, and, lo, he was [not: yea, I sought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} [him, but he could not be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 37 [Mark]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8798”} \w the perfect| strong="H8535" \w* man, [and behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w the upright| strong="H3477" \w*: \w for the end| strong="H319" \w* of that \w man| strong="H376" \w* is \w peace| strong="H7965" \w*. 
\v 38 [But the transgressors]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8802”} [shall be destroyed]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8738”} \w together| strong="H3162" \w*: \w the end| strong="H319" \w* \w of the wicked| strong="H7563" \w* [shall be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 39 \w But the salvation| strong="H8668" \w* \w of the righteous| strong="H6662" \w* is of the \sc Lord\sc*: he is \w their strength| strong="H4581" \w* \w in the time| strong="H6256" \w* \w of trouble| strong="H6869" \w*. 
\v 40 And the \sc Lord\sc* [shall help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and deliver]{strong=“H6403” x-morph=“strongMorph: \sc Th\sc*8762”} [them: he shall deliver]{strong=“H6403” x-morph=“strongMorph: \sc Th\sc*8762”} \w them from the wicked| strong="H7563" \w*, [and save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} [them, because they trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8804”} in him.
\c 38
\p 
\w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*, [to bring to remembrance]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8687”}. 
\v 1 O \sc Lord\sc*, [rebuke]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”} \w me not in thy wrath| strong="H7110" \w*: [neither chasten]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8762”} \w me in thy hot displeasure| strong="H2534" \w*. 
\v 2 \w For thine arrows| strong="H2671" \w* [stick fast]{strong=“H5181” x-morph=“strongMorph: \sc Th\sc*8738”} [in me, and thy hand]{strong=“H3027”} [presseth me sore]{strong=“H5181” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 3 There is \w no soundness| strong="H4974" \w* \w in my flesh| strong="H1320" \w* \w because| strong="H6440" \w* \w of thine anger| strong="H2195" \w*; neither is there any \w rest| strong="H7965" \w* \w in my bones| strong="H6106" \w* \w because| strong="H6440" \w* \w of my sin| strong="H2403" \w*.\f + \fr 38:3 \ft rest: Heb. peace, or, health \f* 
\v 4 \w For mine iniquities| strong="H5771" \w* [are gone over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine head| strong="H7218" \w*: \w as an heavy| strong="H3515" \w* \w burden| strong="H4853" \w* [they are too heavy]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8799”} for me. 
\v 5 \w My wounds| strong="H2250" \w* [stink]{strong=“H887” x-morph=“strongMorph: \sc Th\sc*8689”} and [are corrupt]{strong=“H4743” x-morph=“strongMorph: \sc Th\sc*8738”} \w because| strong="H6440" \w* \w of my foolishness| strong="H200" \w*. 
\v 6 [I am troubled]{strong=“H5753” x-morph=“strongMorph: \sc Th\sc*8738”}; [I am bowed down]{strong=“H7817” x-morph=“strongMorph: \sc Th\sc*8804”} \w greatly| strong="H3966" \w*; [I go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8765”} [mourning]{strong=“H6937” x-morph=“strongMorph: \sc Th\sc*8802”} \w all the day| strong="H3117" \w* long.\f + \fr 38:6 \ft troubled: Heb. wried \f* 
\v 7 \w For my loins| strong="H3689" \w* [are filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} [with a loathsome]{strong=“H7033” x-morph=“strongMorph: \sc Th\sc*8737”} disease: and there is \w no soundness| strong="H4974" \w* \w in my flesh| strong="H1320" \w*. 
\v 8 [I am feeble]{strong=“H6313” x-morph=“strongMorph: \sc Th\sc*8738”} \w and sore| strong="H3966" \w* [broken]{strong=“H1794” x-morph=“strongMorph: \sc Th\sc*8738”}: [I have roared]{strong=“H7580” x-morph=“strongMorph: \sc Th\sc*8804”} \w by reason of the disquietness| strong="H5100" \w* \w of my heart| strong="H3820" \w*. 
\v 9 \w Lord| strong="H136" \w*, \w all my desire| strong="H8378" \w* is [before thee; and my groaning]{strong=“H585”} [is not hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8738”} from thee. 
\v 10 \w My heart| strong="H3820" \w* [panteth]{strong=“H5503” x-morph=“strongMorph: \sc Th\sc*8773”}, \w my strength| strong="H3581" \w* [faileth]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} [me: as for the light]{strong=“H216”} \w of mine eyes| strong="H5869" \w*, \w it| strong="H1992" \w* \w also is gone| strong="H369" \w* from me.\f + \fr 38:10 \ft is gone…: Heb. is not with me \f* 
\v 11 [My lovers]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} \w and my friends| strong="H7453" \w* [stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w aloof from| strong="H5048" \w* \w my sore| strong="H5061" \w*; \w and my kinsmen| strong="H7138" \w* [stand ]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} \w afar off| strong="H7350" \w*.\f + \fr 38:11 \ft sore: Heb. stroke \f* \f + \fr 38:11 \ft my kinsmen: or, my neighbours \f* 
\v 12 [They also that seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w after my life| strong="H5315" \w* [lay snares]{strong=“H5367” x-morph=“strongMorph: \sc Th\sc*8762”} for me: [and they that seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8802”} \w my hurt| strong="H7451" \w* [speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w mischievous things| strong="H1942" \w*, [and imagine]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8799”} \w deceits| strong="H4820" \w* \w all the day| strong="H3117" \w* long. 
\v 13 [But I, as a deaf]{strong=“H2795”} man, [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} not; and I was \w as a dumb man| strong="H483" \w* that [openeth]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} \w not his mouth| strong="H6310" \w*. 
\v 14 \w Thus I was as a man| strong="H376" \w* [that heareth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} [not, and in whose mouth]{strong=“H6310”} are \w no reproofs| strong="H8433" \w*. 
\v 15 For in thee, O \sc Lord\sc*, [do I hope]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8689”}: [thou wilt hear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”}, \w O Lord| strong="H136" \w* \w my God| strong="H430" \w*.\f + \fr 38:15 \ft in…: or, thee do I wait for \f* \f + \fr 38:15 \ft hear: or, answer \f* 
\v 16 [For I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, Hear me, lest otherwise [they should rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} [over me: when my foot]{strong=“H7272”} [slippeth]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8800”}, [they magnify]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8689”} themselves against me. 
\v 17 For I am [ready]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8737”} \w to halt| strong="H6761" \w*, \w and my sorrow| strong="H4341" \w* is \w continually| strong="H8548" \w* before me.\f + \fr 38:17 \ft to halt: Heb. for halting \f* 
\v 18 [For I will declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w mine iniquity| strong="H5771" \w*; [I will be sorry]{strong=“H1672” x-morph=“strongMorph: \sc Th\sc*8799”} \w for my sin| strong="H2403" \w*. 
\v 19 [But mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} are \w lively| strong="H2416" \w*, and [they are strong]{strong=“H6105” x-morph=“strongMorph: \sc Th\sc*8804”}: [and they that hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} \w me wrongfully| strong="H8267" \w* [are multiplied]{strong=“H7231” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 38:19 \ft are lively…: Heb. being living, are strong \f* 
\v 20 [They also that render]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8764”} \w evil| strong="H7451" \w* \w for good| strong="H2896" \w* [are mine adversaries]{strong=“H7853” x-morph=“strongMorph: \sc Th\sc*8799”}; [because I follow]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8800”} the thing that \w good| strong="H2896" \w* is. 
\v 21 [Forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} me not, O \sc Lord\sc*: \w O my God| strong="H430" \w*, [be not far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8799”} from me. 
\v 22 [Make haste]{strong=“H2363” x-morph=“strongMorph: \sc Th\sc*8798”} \w to help| strong="H5833" \w* [me, O Lord]{strong=“H136”} \w my salvation| strong="H8668" \w*.\f + \fr 38:22 \ft to…: Heb. for my help \f*
\c 39
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, even \w to Jeduthun| strong="H3038" \w*, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 [I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [I will take heed]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w to my ways| strong="H1870" \w*, [that I sin]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8800”} \w not with my tongue| strong="H3956" \w*: [I will keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w my mouth| strong="H6310" \w* \w with a bridle| strong="H4269" \w*, \w while the wicked| strong="H7563" \w* is before me.\f + \fr 39:1 \ft my mouth…: Heb. a bridle, or, muzzle for my mouth \f* 
\v 2 [I was dumb]{strong=“H481” x-morph=“strongMorph: \sc Th\sc*8738”} \w with silence| strong="H1747" \w*, [I held my peace]{strong=“H2814” x-morph=“strongMorph: \sc Th\sc*8689”}, even \w from good| strong="H2896" \w*; \w and my sorrow| strong="H3511" \w* [was stirred]{strong=“H5916” x-morph=“strongMorph: \sc Th\sc*8738”}.\f + \fr 39:2 \ft stirred: Heb. troubled \f* 
\v 3 \w My heart| strong="H3820" \w* [was hot]{strong=“H2552” x-morph=“strongMorph: \sc Th\sc*8804”} \w within| strong="H7130" \w* [me, while I was musing]{strong=“H1901”} \w the fire| strong="H784" \w* [burned]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8799”}: then [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w I with my tongue| strong="H3956" \w*, 
\v 4 \sc Lord\sc*, [make me to know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8685”} \w mine end| strong="H7093" \w*, \w and the measure| strong="H4060" \w* \w of my days| strong="H3117" \w*, what it is; that [I may know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w how frail| strong="H2310" \w* I am.\f + \fr 39:4 \ft how…: or, what time I have here \f* 
\v 5 [Behold, thou hast made]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w my days| strong="H3117" \w* as \w an handbreadth| strong="H2947" \w*; \w and mine age| strong="H2465" \w* is [as nothing before thee: verily every]{strong=“H3605”} \w man| strong="H120" \w* [at his best state]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8737”} is \w altogether| strong="H3605" \w* \w vanity| strong="H1892" \w*. \w Selah| strong="H5542" \w*.\f + \fr 39:5 \ft at…: Heb. settled \f* 
\v 6 \w Surely every man| strong="H376" \w* [walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8691”} \w in a vain shew| strong="H6754" \w*: [surely they are disquieted]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8799”} \w in vain| strong="H1892" \w*: [he heapeth up]{strong=“H6651” x-morph=“strongMorph: \sc Th\sc*8799”} riches, [and knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [not who shall gather]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8802”} them.\f + \fr 39:6 \ft a vain…: Heb. an image \f* 
\v 7 [And now, Lord]{strong=“H136”}, [what wait]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8765”} [I for? my hope]{strong=“H8431”} is in thee. 
\v 8 [Deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} \w me from all my transgressions| strong="H6588" \w*: [make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w me not the reproach| strong="H2781" \w* \w of the foolish| strong="H5036" \w*. 
\v 9 [I was dumb]{strong=“H481” x-morph=“strongMorph: \sc Th\sc*8738”}, [I opened]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} \w not my mouth| strong="H6310" \w*; [because thou didst]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} it. 
\v 10 \w Remove| strong="H5493" \w* \w thy stroke| strong="H5061" \w* [away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8685”} [from me: I am consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”} \w by the blow| strong="H8409" \w* \w of thine hand| strong="H3027" \w*.\f + \fr 39:10 \ft blow: Heb. conflict \f* 
\v 11 \w When thou with rebukes| strong="H8433" \w* [dost correct]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8765”} \w man| strong="H376" \w* \w for iniquity| strong="H5771" \w*, [thou makest his beauty]{strong=“H2530” x-morph=“strongMorph: \sc Th\sc*8803”} [to consume away]{strong=“H4529” x-morph=“strongMorph: \sc Th\sc*8686”} \w like a moth| strong="H6211" \w*: \w surely every man| strong="H120" \w* is \w vanity| strong="H1892" \w*. \w Selah| strong="H5542" \w*.\f + \fr 39:11 \ft his…: Heb. that which is to be desired in him to melt away \f* 
\v 12 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w my prayer| strong="H8605" \w*, O \sc Lord\sc*, [and give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto my cry| strong="H7775" \w*; [hold not thy peace]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8799”} \w at my tears| strong="H1832" \w*: for I am \w a stranger| strong="H1616" \w* with thee, and \w a sojourner| strong="H8453" \w*, \w as all my fathers| strong="H1" \w* were. 
\v 13 [O spare]{strong=“H8159” x-morph=“strongMorph: \sc Th\sc*8685”} [me, that I may recover strength]{strong=“H1082” x-morph=“strongMorph: \sc Th\sc*8686”}, [before I go hence]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, and be no more.
\c 40
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 [I waited]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8765”} [patiently]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8763”} for the \sc Lord\sc*; [and he inclined]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, and heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w my cry| strong="H7775" \w*.\f + \fr 40:1 \ft I waited…: Heb. In waiting I waited \f* 
\v 2 [He brought me up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w also out of an horrible| strong="H7588" \w* \w pit| strong="H953" \w*, \w out of the miry| strong="H3121" \w* \w clay| strong="H2916" \w*, [and set]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8686”} \w my feet| strong="H7272" \w* \w upon a rock| strong="H5553" \w*, and [established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8790”} \w my goings| strong="H838" \w*.\f + \fr 40:2 \ft an…: Heb. a pit of noise \f* 
\v 3 [And he hath put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w a new| strong="H2319" \w* \w song| strong="H7892" \w* \w in my mouth| strong="H6310" \w*, even \w praise| strong="H8416" \w* \w unto our God| strong="H430" \w*: \w many| strong="H7227" \w* [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} it, [and fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}, [and shall trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} in the \sc Lord\sc*. 
\v 4 \w Blessed| strong="H835" \w* is \w that man| strong="H1397" \w* [that maketh]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w his trust| strong="H4009" \w*, [and respecteth]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the proud| strong="H7295" \w*, [nor such as turn aside]{strong=“H7750” x-morph=“strongMorph: \sc Th\sc*8802”} \w to lies| strong="H3577" \w*. 
\v 5 \w Many| strong="H7227" \w*, O \sc Lord\sc* \w my God| strong="H430" \w*, are [thy wonderful]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} works which [thou hast done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and thy thoughts| strong="H4284" \w* which are [to us-ward: they cannot be reckoned up in order]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8800”} unto thee: if [I would declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} [and speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} of them, [they are more]{strong=“H6105” x-morph=“strongMorph: \sc Th\sc*8804”} [than can be numbered]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8763”}.\f + \fr 40:5 \ft they cannot…: or, none can order them unto thee \f* 
\v 6 \w Sacrifice| strong="H2077" \w* \w and offering| strong="H4503" \w* [thou didst not desire]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”}; \w mine ears| strong="H241" \w* [hast thou opened]{strong=“H3738” x-morph=“strongMorph: \sc Th\sc*8804”}: \w burnt offering| strong="H5930" \w* \w and sin offering| strong="H2401" \w* [hast thou not required]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 40:6 \ft opened: Heb. digged \f* 
\v 7 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [I, Lo, I come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}: \w in the volume| strong="H4039" \w* \w of the book| strong="H5612" \w* it is [written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8803”} of me, 
\v 8 [I delight]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy will| strong="H7522" \w*, \w O my God| strong="H430" \w*: [yea, thy law]{strong=“H8451”} is \w within| strong="H8432" \w* \w my heart| strong="H4578" \w*.\f + \fr 40:8 \ft within…: Heb. in the midst of my bowels \f* 
\v 9 [I have preached]{strong=“H1319” x-morph=“strongMorph: \sc Th\sc*8765”} \w righteousness| strong="H6664" \w* \w in the great| strong="H7227" \w* \w congregation| strong="H6951" \w*: [lo, I have not refrained]{strong=“H3607” x-morph=“strongMorph: \sc Th\sc*8799”} \w my lips| strong="H8193" \w*, O \sc Lord\sc*, [thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 10 [I have not hid]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy righteousness| strong="H6666" \w* \w within| strong="H8432" \w* \w my heart| strong="H3820" \w*; [I have declared]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy faithfulness| strong="H530" \w* \w and thy salvation| strong="H8668" \w*: [I have not concealed]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy lovingkindness| strong="H2617" \w* \w and thy truth| strong="H571" \w* \w from the great| strong="H7227" \w* \w congregation| strong="H6951" \w*. 
\v 11 [Withhold]{strong=“H3607” x-morph=“strongMorph: \sc Th\sc*8799”} \w not thou thy tender mercies| strong="H7356" \w* from me, O \sc Lord\sc*: \w let thy lovingkindness| strong="H2617" \w* \w and thy truth| strong="H571" \w* \w continually| strong="H8548" \w* [preserve]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8799”} me. 
\v 12 \w For innumerable| strong="H4557" \w* \w evils| strong="H7451" \w* [have compassed]{strong=“H661” x-morph=“strongMorph: \sc Th\sc*8804”} [me about: mine iniquities]{strong=“H5771”} [have taken hold]{strong=“H5381” x-morph=“strongMorph: \sc Th\sc*8689”} [upon me, so that I am not able]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8804”} [to look up]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”}; [they are more]{strong=“H6105” x-morph=“strongMorph: \sc Th\sc*8804”} \w than the hairs| strong="H8185" \w* \w of mine head| strong="H7218" \w*: \w therefore my heart| strong="H3820" \w* [faileth]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} me.\f + \fr 40:12 \ft faileth: Heb. forsaketh \f* 
\v 13 [Be pleased]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8798”}, O \sc Lord\sc*, [to deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8687”} me: O \sc Lord\sc*, [make haste]{strong=“H2363” x-morph=“strongMorph: \sc Th\sc*8798”} \w to help| strong="H5833" \w* me. 
\v 14 [Let them be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} [and confounded]{strong=“H2659” x-morph=“strongMorph: \sc Th\sc*8799”} \w together| strong="H3162" \w* [that seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w after my soul| strong="H5315" \w* [to destroy]{strong=“H5595” x-morph=“strongMorph: \sc Th\sc*8800”} [it; let them be driven]{strong=“H5472” x-morph=“strongMorph: \sc Th\sc*8735”} \w backward| strong="H268" \w* [and put to shame]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8735”} \w that wish| strong="H2655" \w* \w me evil| strong="H7451" \w*. 
\v 15 [Let them be desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8799”} \w for a reward| strong="H6118" \w* \w of their shame| strong="H1322" \w* [that say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} [unto me, Aha]{strong=“H1889”}, \w aha| strong="H1889" \w*. 
\v 16 [Let all those that seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} [thee rejoice]{strong=“H7797” x-morph=“strongMorph: \sc Th\sc*8799”} [and be glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} [in thee: let such as love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} \w thy salvation| strong="H8668" \w* [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w continually| strong="H8548" \w*, The \sc Lord\sc* [be magnified]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 17 But I am \w poor| strong="H6041" \w* \w and needy| strong="H34" \w*; yet \w the Lord| strong="H136" \w* [thinketh]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8799”} upon me: thou art \w my help| strong="H5833" \w* [and my deliverer]{strong=“H6403” x-morph=“strongMorph: \sc Th\sc*8764”}; [make no tarrying]{strong=“H309” x-morph=“strongMorph: \sc Th\sc*8762”}, \w O my God| strong="H430" \w*.
\c 41
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 \w Blessed| strong="H835" \w* is [he that considereth]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8688”} \w the poor| strong="H1800" \w*: the \sc Lord\sc* [will deliver]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8762”} \w him in time| strong="H3117" \w* \w of trouble| strong="H7451" \w*.\f + \fr 41:1 \ft the poor: or, the weak, or, sick \f* \f + \fr 41:1 \ft in time…: Heb. in the day of evil \f* 
\v 2 The \sc Lord\sc* [will preserve]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} [him, and keep him alive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8762”}; and [he shall be blessed]{strong=“H833” x-morph=“strongMorph: \sc Th\sc*8795”} \w upon the earth| strong="H776" \w*: [and thou wilt not deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w him unto the will| strong="H5315" \w* [of his enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 41:2 \ft thou…: or, do not thou deliver \f* 
\v 3 The \sc Lord\sc* [will strengthen]{strong=“H5582” x-morph=“strongMorph: \sc Th\sc*8799”} \w him upon the bed| strong="H6210" \w* \w of languishing| strong="H1741" \w*: [thou wilt make]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8804”} \w all his bed| strong="H4904" \w* \w in his sickness| strong="H2483" \w*.\f + \fr 41:3 \ft make: Heb. turn \f* 
\v 4 [I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \sc Lord\sc*, [be merciful]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me: heal]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8798”} \w my soul| strong="H5315" \w*; [for I have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} against thee. 
\v 5 [Mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w evil| strong="H7451" \w* [of me, When shall he die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and his name| strong="H8034" \w* [perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”}? 
\v 6 [And if he come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} me, [he speaketh]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w vanity| strong="H7723" \w*: \w his heart| strong="H3820" \w* [gathereth]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8799”} \w iniquity| strong="H205" \w* to itself; when [he goeth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w abroad| strong="H2351" \w*, [he telleth]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} it. 
\v 7 [All that hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} [me whisper]{strong=“H3907” x-morph=“strongMorph: \sc Th\sc*8691”} \w together| strong="H3162" \w* [against me: against me do they devise]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8799”} \w my hurt| strong="H7451" \w*.\f + \fr 41:7 \ft my…: Heb. evil to me \f* 
\v 8 \w An evil| strong="H1100" \w* \w disease| strong="H1697" \w*, say they, [cleaveth fast]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8803”} unto him: and now [that he lieth]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8804”} [he shall rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8800”} [no more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”}.\f + \fr 41:8 \ft An…: Heb. A thing of Belial \f* 
\v 9 [Yea, mine own familiar]{strong=“H7965”} \w friend| strong="H376" \w*, [in whom I trusted]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”}, [which did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} \w of my bread| strong="H3899" \w*, [hath lifted up]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8689”} his \w heel| strong="H6119" \w* against me.\f + \fr 41:9 \ft mine…: Heb. the man of my peace \f* \f + \fr 41:9 \ft lifted…: Heb. magnified \f* 
\v 10 But thou, O \sc Lord\sc*, [be merciful]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me, and raise me up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8685”}, [that I may requite]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} them. 
\v 11 [By this I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [that thou favourest]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} [me, because mine enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [doth not triumph]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8686”} over me. 
\v 12 [And as for me, thou upholdest]{strong=“H8551” x-morph=“strongMorph: \sc Th\sc*8804”} \w me in mine integrity| strong="H8537" \w*, [and settest]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8686”} \w me before thy face| strong="H6440" \w* \w for ever| strong="H5769" \w*. 
\v 13 [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} be the \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w* \w from everlasting| strong="H5769" \w*, \w and to everlasting| strong="H5769" \w*. \w Amen| strong="H543" \w*, \w and Amen| strong="H543" \w*.
\c 42
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, [Maschil]{strong=“H4905” x-morph=“strongMorph: \sc Th\sc*8688”}, \w for the sons| strong="H1121" \w* \w of Korah| strong="H7141" \w*. 
\v 1 \w As the hart| strong="H354" \w* [panteth]{strong=“H6165” x-morph=“strongMorph: \sc Th\sc*8799”} \w after the water| strong="H4325" \w* \w brooks| strong="H650" \w*, [so panteth]{strong=“H6165” x-morph=“strongMorph: \sc Th\sc*8799”} \w my soul| strong="H5315" \w* [after thee, O God]{strong=“H430”}.\f + \fr 42:1 \ft Maschil…: or, A Psalm giving instruction of the sons, etc \f* \f + \fr 42:1 \ft panteth: Heb. brayeth \f* 
\v 2 \w My soul| strong="H5315" \w* [thirsteth]{strong=“H6770” x-morph=“strongMorph: \sc Th\sc*8804”} \w for God| strong="H430" \w*, \w for the living| strong="H2416" \w* \w God| strong="H410" \w*: [when shall I come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and appear]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8735”} \w before| strong="H6440" \w* \w God| strong="H430" \w*? 
\v 3 \w My tears| strong="H1832" \w* \w have been my meat| strong="H3899" \w* \w day| strong="H3119" \w* \w and night| strong="H3915" \w*, \w while they continually| strong="H3117" \w* [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} unto me, Where is \w thy God| strong="H430" \w*? 
\v 4 [When I remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} these things, [I pour out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8799”} \w my soul| strong="H5315" \w* [in me: for I had gone]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the multitude| strong="H5519" \w*, [I went]{strong=“H1718” x-morph=“strongMorph: \sc Th\sc*8691”} \w with them to the house| strong="H1004" \w* \w of God| strong="H430" \w*, \w with the voice| strong="H6963" \w* \w of joy| strong="H7440" \w* \w and praise| strong="H8426" \w*, \w with a multitude| strong="H1995" \w* [that kept holyday]{strong=“H2287” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 5 [Why art thou cast down]{strong=“H7817” x-morph=“strongMorph: \sc Th\sc*8709”}, \w O my soul| strong="H5315" \w*? and why [art thou disquieted]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8799”} [in me? hope]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8685”} \w thou in God| strong="H430" \w*: [for I shall yet praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} him for \w the help| strong="H3444" \w* \w of his countenance| strong="H6440" \w*.\f + \fr 42:5 \ft cast: Heb. bowed \f* \f + \fr 42:5 \ft praise: or, give thanks \f* \f + \fr 42:5 \ft for the…: or, his presence is salvation \f* 
\v 6 \w O my God| strong="H430" \w*, \w my soul| strong="H5315" \w* [is cast down]{strong=“H7817” x-morph=“strongMorph: \sc Th\sc*8709”} [within me: therefore will I remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee from the land| strong="H776" \w* \w of Jordan| strong="H3383" \w*, \w and of the Hermonites| strong="H2769" \w*, \w from the hill| strong="H2022" \w* \w Mizar| strong="H4706" \w*.\f + \fr 42:6 \ft the hill…: or, the little hill \f* 
\v 7 \w Deep| strong="H8415" \w* [calleth]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8802”} \w unto deep| strong="H8415" \w* \w at the noise| strong="H6963" \w* \w of thy waterspouts| strong="H6794" \w*: \w all thy waves| strong="H4867" \w* \w and thy billows| strong="H1530" \w* [are gone]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} over me. 
\v 8 Yet the \sc Lord\sc* [will command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} \w his lovingkindness| strong="H2617" \w* \w in the daytime| strong="H3119" \w*, \w and in the night| strong="H3915" \w* \w his song| strong="H7892" \w* shall be with me, and \w my prayer| strong="H8605" \w* \w unto the God| strong="H410" \w* \w of my life| strong="H2416" \w*. 
\v 9 [I will say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto God| strong="H410" \w* \w my rock| strong="H5553" \w*, [Why hast thou forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} [me? why go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [I mourning]{strong=“H6937” x-morph=“strongMorph: \sc Th\sc*8802”} \w because of the oppression| strong="H3906" \w* [of the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}? 
\v 10 As \w with a sword| strong="H7524" \w* \w in my bones| strong="H6106" \w*, [mine enemies]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8802”} [reproach]{strong=“H2778” x-morph=“strongMorph: \sc Th\sc*8765”} [me; while they say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} \w daily| strong="H3117" \w* unto me, Where is \w thy God| strong="H430" \w*?\f + \fr 42:10 \ft sword: or, killing \f* 
\v 11 [Why art thou cast down]{strong=“H7817” x-morph=“strongMorph: \sc Th\sc*8709”}, \w O my soul| strong="H5315" \w*? [and why art thou disquieted]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8799”} [within me? hope]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8685”} \w thou in God| strong="H430" \w*: [for I shall yet praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} him, who is \w the health| strong="H3444" \w* \w of my countenance| strong="H6440" \w*, \w and my God| strong="H430" \w*.
\c 43
\p 
\v 1 [Judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8798”} [me, O God]{strong=“H430”}, [and plead]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8798”} \w my cause| strong="H7379" \w* [against an ungodly]{strong=“H2623 H3808”} \w nation| strong="H1471" \w*: [O deliver]{strong=“H6403” x-morph=“strongMorph: \sc Th\sc*8762”} \w me from the deceitful| strong="H4820" \w* \w and unjust| strong="H5766" \w* \w man| strong="H376" \w*.\f + \fr 43:1 \ft ungodly: or, unmerciful \f* \f + \fr 43:1 \ft the deceitful…: Heb. a man of deceit and iniquity \f* 
\v 2 For thou art \w the God| strong="H430" \w* \w of my strength| strong="H4581" \w*: [why dost thou cast me off]{strong=“H2186” x-morph=“strongMorph: \sc Th\sc*8804”}? [why go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8691”} [I mourning]{strong=“H6937” x-morph=“strongMorph: \sc Th\sc*8802”} \w because of the oppression| strong="H3906" \w* [of the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}? 
\v 3 [O send out]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy light| strong="H216" \w* \w and thy truth| strong="H571" \w*: [let them lead]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8686”} [me; let them bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w me unto thy holy| strong="H6944" \w* \w hill| strong="H2022" \w*, \w and to thy tabernacles| strong="H4908" \w*. 
\v 4 [Then will I go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the altar| strong="H4196" \w* \w of God| strong="H430" \w*, \w unto God| strong="H410" \w* \w my exceeding| strong="H8057" \w* \w joy| strong="H1524" \w*: [yea, upon the harp]{strong=“H3658”} [will I praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} [thee, O God]{strong=“H430”} \w my God| strong="H430" \w*.\f + \fr 43:4 \ft my exceeding…: Heb. the gladness of my joy \f* 
\v 5 [Why art thou cast down]{strong=“H7817” x-morph=“strongMorph: \sc Th\sc*8709”}, \w O my soul| strong="H5315" \w*? [and why art thou disquieted]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8799”} [within me? hope]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8685”} \w in God| strong="H430" \w*: [for I shall yet praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} him, who is \w the health| strong="H3444" \w* \w of my countenance| strong="H6440" \w*, \w and my God| strong="H430" \w*.
\c 44
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} \w for the sons| strong="H1121" \w* \w of Korah| strong="H7141" \w*, [Maschil]{strong=“H4905” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 1 [We have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w with our ears| strong="H241" \w*, \w O God| strong="H430" \w*, \w our fathers| strong="H1" \w* [have told]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8765”} us, what \w work| strong="H6467" \w* [thou didst]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8804”} \w in their days| strong="H3117" \w*, \w in the times| strong="H3117" \w* \w of old| strong="H6924" \w*.\f + \fr 44:1 \ft Maschil: or, of instruction \f* 
\v 2 How [thou didst drive out]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8689”} \w the heathen| strong="H1471" \w* \w with thy hand| strong="H3027" \w*, [and plantedst]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8799”} them; how [thou didst afflict]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8686”} \w the people| strong="H3816" \w*, [and cast them out]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 3 \w For they got| strong="H3423" \w* \w not the land| strong="H776" \w* [in possession]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8804”} \w by their own sword| strong="H2719" \w*, \w neither did their own arm| strong="H2220" \w* [save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8689”} [them: but thy right hand]{strong=“H3225”}, \w and thine arm| strong="H2220" \w*, \w and the light| strong="H216" \w* \w of thy countenance| strong="H6440" \w*, [because thou hadst a favour]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8804”} unto them. 
\v 4 \w Thou art my King| strong="H4428" \w*, \w O God| strong="H430" \w*: [command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8761”} \w deliverances| strong="H3444" \w* \w for Jacob| strong="H3290" \w*. 
\v 5 [Through thee will we push down]{strong=“H5055” x-morph=“strongMorph: \sc Th\sc*8762”} \w our enemies| strong="H6862" \w*: \w through thy name| strong="H8034" \w* [will we tread them under]{strong=“H947” x-morph=“strongMorph: \sc Th\sc*8799”} [that rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8801”} against us. 
\v 6 [For I will not trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} \w in my bow| strong="H7198" \w*, \w neither shall my sword| strong="H2719" \w* [save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} me. 
\v 7 [But thou hast saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8689”} \w us from our enemies| strong="H6862" \w*, [and hast put them to shame]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8689”} [that hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8764”} us. 
\v 8 \w In God| strong="H430" \w* [we boast]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8765”} \w all the day| strong="H3117" \w* [long, and praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy name| strong="H8034" \w* \w for ever| strong="H5769" \w*. \w Selah| strong="H5542" \w*. 
\v 9 \w But| strong="H637" \w* [thou hast cast off]{strong=“H2186” x-morph=“strongMorph: \sc Th\sc*8804”}, [and put us to shame]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8686”}; [and goest not forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w with our armies| strong="H6635" \w*. 
\v 10 [Thou makest us to turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w back| strong="H268" \w* \w from the enemy| strong="H6862" \w*: [and they which hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8764”} [us spoil]{strong=“H8154” x-morph=“strongMorph: \sc Th\sc*8804”} for themselves. 
\v 11 [Thou hast given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w us like sheep| strong="H6629" \w* appointed \w for meat| strong="H3978" \w*; [and hast scattered]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8765”} \w us among the heathen| strong="H1471" \w*.\f + \fr 44:11 \ft like…: Heb. as sheep of meat \f* 
\v 12 [Thou sellest]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy people| strong="H5971" \w* \w for nought| strong="H1952" \w*, [and dost not increase]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8765”} thy wealth \w by their price| strong="H4242" \w*.\f + \fr 44:12 \ft for…: Heb. without riches \f* 
\v 13 [Thou makest]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w us a reproach| strong="H2781" \w* \w to our neighbours| strong="H7934" \w*, \w a scorn| strong="H3933" \w* \w and a derision| strong="H7047" \w* \w to them that are round about| strong="H5439" \w* us. 
\v 14 [Thou makest]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w us a byword| strong="H4912" \w* \w among the heathen| strong="H1471" \w*, \w a shaking| strong="H4493" \w* \w of the head| strong="H7218" \w* \w among the people| strong="H3816" \w*. 
\v 15 \w My confusion| strong="H3639" \w* is \w continually| strong="H3117" \w* [before me, and the shame]{strong=“H1322”} \w of my face| strong="H6440" \w* [hath covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”} me, 
\v 16 \w For the voice| strong="H6963" \w* [of him that reproacheth]{strong=“H2778” x-morph=“strongMorph: \sc Th\sc*8764”} [and blasphemeth]{strong=“H1442” x-morph=“strongMorph: \sc Th\sc*8764”}; \w by reason| strong="H6440" \w* [of the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [and avenger]{strong=“H5358” x-morph=“strongMorph: \sc Th\sc*8693”}. 
\v 17 [All this is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [upon us; yet have we not forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, neither have we dealt falsely]{strong=“H8266” x-morph=“strongMorph: \sc Th\sc*8765”} \w in thy covenant| strong="H1285" \w*. 
\v 18 \w Our heart| strong="H3820" \w* [is not turned]{strong=“H5472” x-morph=“strongMorph: \sc Th\sc*8738”} \w back| strong="H268" \w*, \w neither have our steps| strong="H838" \w* [declined]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8799”} \w from thy way| strong="H734" \w*;\f + \fr 44:18 \ft steps: or, goings \f* 
\v 19 [Though thou hast sore broken]{strong=“H1794” x-morph=“strongMorph: \sc Th\sc*8765”} \w us in the place| strong="H4725" \w* \w of dragons| strong="H8577" \w*, [and covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w us with the shadow of death| strong="H6757" \w*. 
\v 20 [If we have forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} \w the name| strong="H8034" \w* \w of our God| strong="H430" \w*, [or stretched out]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8799”} \w our hands| strong="H3709" \w* [to a strange]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} \w god| strong="H410" \w*; 
\v 21 \w Shall not God| strong="H430" \w* [search this out]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8799”}? [for he knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w the secrets| strong="H8587" \w* \w of the heart| strong="H3820" \w*. 
\v 22 [Yea, for thy sake are we killed]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8795”} \w all the day| strong="H3117" \w* [long; we are counted]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8738”} \w as sheep| strong="H6629" \w* \w for the slaughter| strong="H2878" \w*. 
\v 23 [Awake]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8798”}, [why sleepest]{strong=“H3462” x-morph=“strongMorph: \sc Th\sc*8799”} [thou, O Lord]{strong=“H136”}? [arise]{strong=“H6974” x-morph=“strongMorph: \sc Th\sc*8685”}, cast us [not off]{strong=“H2186” x-morph=“strongMorph: \sc Th\sc*8799”} \w for ever| strong="H5331" \w*. 
\v 24 [Wherefore hidest]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8686”} \w thou thy face| strong="H6440" \w*, and [forgettest]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} \w our affliction| strong="H6040" \w* \w and our oppression| strong="H3906" \w*? 
\v 25 \w For our soul| strong="H5315" \w* [is bowed down]{strong=“H7743” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the dust| strong="H6083" \w*: \w our belly| strong="H990" \w* [cleaveth]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the earth| strong="H776" \w*. 
\v 26 [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”} \w for our help| strong="H5833" \w*, [and redeem]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8798”} [us for thy mercies’]{strong=“H2617”} sake.\f + \fr 44:26 \ft for our…: Heb. a help for us \f*
\c 45
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} \w upon Shoshannim| strong="H7799" \w*, \w for the sons| strong="H1121" \w* \w of Korah| strong="H7141" \w*, [Maschil]{strong=“H4905” x-morph=“strongMorph: \sc Th\sc*8688”}, \w A Song| strong="H7892" \w* \w of loves| strong="H3039" \w*. 
\v 1 \w My heart| strong="H3820" \w* [is inditing]{strong=“H7370” x-morph=“strongMorph: \sc Th\sc*8804”} \w a good| strong="H2896" \w* \w matter| strong="H1697" \w*: [I speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the things which I have made| strong="H4639" \w* \w touching the king| strong="H4428" \w*: \w my tongue| strong="H3956" \w* is \w the pen| strong="H5842" \w* \w of a ready| strong="H4106" \w* [writer]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 45:1 \ft Maschil: or, of instruction \f* \f + \fr 45:1 \ft is inditing: Heb. boileth, or, bubbleth up \f* 
\v 2 [Thou art fairer]{strong=“H3302” x-morph=“strongMorph: \sc Th\sc*8795”} \w than the children| strong="H1121" \w* \w of men| strong="H120" \w*: \w grace| strong="H2580" \w* [is poured]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8717”} \w into thy lips| strong="H8193" \w*: \w therefore God| strong="H430" \w* [hath blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} \w thee for ever| strong="H5769" \w*. 
\v 3 [Gird]{strong=“H2296” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy sword| strong="H2719" \w* upon thy \w thigh| strong="H3409" \w*, O most \w mighty| strong="H1368" \w*, \w with thy glory| strong="H1935" \w* \w and thy majesty| strong="H1926" \w*. 
\v 4 \w And in thy majesty| strong="H1926" \w* [ride]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8798”} [prosperously]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8798”} \w because| strong="H1697" \w* \w of truth| strong="H571" \w* \w and meekness| strong="H6037" \w* and \w righteousness| strong="H6664" \w*; \w and thy right hand| strong="H3225" \w* [shall teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”} [thee terrible things]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”}.\f + \fr 45:4 \ft ride…: Heb. prosper thou, ride thou \f* 
\v 5 \w Thine arrows| strong="H2671" \w* are [sharp]{strong=“H8150” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the heart| strong="H3820" \w* [of the king’s]{strong=“H4428”} [enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}; whereby \w the people| strong="H5971" \w* [fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} under thee. 
\v 6 \w Thy throne| strong="H3678" \w*, \w O God| strong="H430" \w*, is \w for ever| strong="H5769" \w* \w and ever| strong="H5703" \w*: \w the sceptre| strong="H7626" \w* \w of thy kingdom| strong="H4438" \w* is \w a right| strong="H4334" \w* \w sceptre| strong="H7626" \w*. 
\v 7 [Thou lovest]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} \w righteousness| strong="H6664" \w*, [and hatest]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8799”} \w wickedness| strong="H7562" \w*: \w therefore God| strong="H430" \w*, \w thy God| strong="H430" \w*, [hath anointed]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee with the oil| strong="H8081" \w* \w of gladness| strong="H8342" \w* \w above thy fellows| strong="H2270" \w*. 
\v 8 \w All thy garments| strong="H899" \w* smell \w of myrrh| strong="H4753" \w*, \w and aloes| strong="H174" \w*, and \w cassia| strong="H7102" \w*, \w out of the ivory| strong="H8127" \w* \w palaces| strong="H1964" \w*, \w whereby| strong="H4482" \w* [they have made thee glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 9 [Kings’]{strong=“H4428”} \w daughters| strong="H1323" \w* were \w among thy honourable women| strong="H3368" \w*: \w upon thy right hand| strong="H3225" \w* [did stand]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8738”} \w the queen| strong="H7694" \w* \w in gold| strong="H3800" \w* \w of Ophir| strong="H211" \w*. 
\v 10 [Hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O daughter| strong="H1323" \w*, [and consider]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}, [and incline]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8685”} \w thine ear| strong="H241" \w*; [forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8798”} \w also thine own people| strong="H5971" \w*, [and thy father’s]{strong=“H1”} \w house| strong="H1004" \w*; 
\v 11 \w So shall the king| strong="H4428" \w* [greatly desire]{strong=“H183” x-morph=“strongMorph: \sc Th\sc*8691”} \w thy beauty| strong="H3308" \w*: for he is \w thy Lord| strong="H113" \w*; [and worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8690”} thou him. 
\v 12 \w And the daughter| strong="H1323" \w* \w of Tyre| strong="H6865" \w* shall be there \w with a gift| strong="H4503" \w*; even \w the rich| strong="H6223" \w* \w among the people| strong="H5971" \w* [shall intreat]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy favour| strong="H6440" \w*.\f + \fr 45:12 \ft favour: Heb. face \f* 
\v 13 [The king’s]{strong=“H4428”} \w daughter| strong="H1323" \w* is \w all glorious| strong="H3520" \w* \w within| strong="H6441" \w*: \w her clothing| strong="H3830" \w* is \w of wrought| strong="H4865" \w* \w gold| strong="H2091" \w*. 
\v 14 [She shall be brought]{strong=“H2986” x-morph=“strongMorph: \sc Th\sc*8714”} \w unto the king| strong="H4428" \w* \w in raiment of needlework| strong="H7553" \w*: \w the virgins| strong="H1330" \w* \w her companions| strong="H7464" \w* \w that follow| strong="H310" \w* [her shall be brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8716”} unto thee. 
\v 15 \w With gladness| strong="H8057" \w* \w and rejoicing| strong="H1524" \w* [shall they be brought]{strong=“H2986” x-morph=“strongMorph: \sc Th\sc*8714”}: [they shall enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [into the king’s]{strong=“H4428”} \w palace| strong="H1964" \w*. 
\v 16 \w Instead of thy fathers| strong="H1" \w* \w shall be thy children| strong="H1121" \w*, [whom thou mayest make]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w princes| strong="H8269" \w* \w in all the earth| strong="H776" \w*. 
\v 17 \w I will make thy name| strong="H8034" \w* [to be remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8686”} \w in all| strong="H1755" \w* \w generations| strong="H1755" \w*: \w therefore shall the people| strong="H5971" \w* [praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee for ever| strong="H5769" \w* \w and ever| strong="H5703" \w*.
\c 46
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} \w for the sons| strong="H1121" \w* \w of Korah| strong="H7141" \w*, \w A Song| strong="H7892" \w* \w upon Alamoth| strong="H5961" \w*. 
\v 1 \w God| strong="H430" \w* is \w our refuge| strong="H4268" \w* \w and strength| strong="H5797" \w*, \w a very| strong="H3966" \w* [present]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8738”} \w help| strong="H5833" \w* \w in trouble| strong="H6869" \w*.\f + \fr 46:1 \ft for: or, of \f* 
\v 2 [Therefore will not we fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}, \w though the earth| strong="H776" \w* [be removed]{strong=“H4171” x-morph=“strongMorph: \sc Th\sc*8687”}, \w and though the mountains| strong="H2022" \w* [be carried]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8800”} \w into the midst| strong="H3820" \w* \w of the sea| strong="H3220" \w*;\f + \fr 46:2 \ft midst…: Heb. heart of the seas \f* 
\v 3 Though \w the waters| strong="H4325" \w* [thereof roar]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8799”} and [be troubled]{strong=“H2560” x-morph=“strongMorph: \sc Th\sc*8799”}, though \w the mountains| strong="H2022" \w* [shake]{strong=“H7493” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the swelling| strong="H1346" \w* [thereof. Selah]{strong=“H5542”}. 
\v 4 There is \w a river| strong="H5104" \w*, \w the streams| strong="H6388" \w* [whereof shall make glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8762”} \w the city| strong="H5892" \w* \w of God| strong="H430" \w*, \w the holy| strong="H6918" \w* place \w of the tabernacles| strong="H4908" \w* \w of the most High| strong="H5945" \w*. 
\v 5 \w God| strong="H430" \w* is \w in the midst| strong="H7130" \w* [of her; she shall not be moved]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8735”}: \w God| strong="H430" \w* [shall help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8799”} her, and that [right]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8800”} \w early| strong="H1242" \w*.\f + \fr 46:5 \ft and…: Heb. when the morning appeareth \f* 
\v 6 \w The heathen| strong="H1471" \w* [raged]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the kingdoms| strong="H4467" \w* [were moved]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8804”}: [he uttered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w his voice| strong="H6963" \w*, \w the earth| strong="H776" \w* [melted]{strong=“H4127” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 7 The \sc Lord\sc* \w of hosts| strong="H6635" \w* is [with us; the God]{strong=“H430”} \w of Jacob| strong="H3290" \w* is \w our refuge| strong="H4869" \w*. \w Selah| strong="H5542" \w*.\f + \fr 46:7 \ft our…: Heb. an high place for us \f* 
\v 8 [Come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [behold]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8798”} \w the works| strong="H4659" \w* of the \sc Lord\sc*, \w what desolations| strong="H8047" \w* [he hath made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the earth| strong="H776" \w*. 
\v 9 \w He maketh wars| strong="H4421" \w* [to cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8688”} \w unto the end| strong="H7097" \w* \w of the earth| strong="H776" \w*; [he breaketh]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8762”} \w the bow| strong="H7198" \w*, \w and cutteth| strong="H7112" \w* \w the spear| strong="H2595" \w* [in sunder]{strong=“H7112” x-morph=“strongMorph: \sc Th\sc*8765”}; [he burneth]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8799”} \w the chariot| strong="H5699" \w* \w in the fire| strong="H784" \w*. 
\v 10 [Be still]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8685”}, [and know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”} that I am \w God| strong="H430" \w*: [I will be exalted]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8799”} \w among the heathen| strong="H1471" \w*, [I will be exalted]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the earth| strong="H776" \w*. 
