\v 13 [But as for me, my prayer]{strong=“H8605”} is unto thee, O \sc Lord\sc*, in \w an acceptable| strong="H7522" \w* \w time| strong="H6256" \w*: \w O God| strong="H430" \w*, \w in the multitude| strong="H7230" \w* \w of thy mercy| strong="H2617" \w* [hear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8798”} [me, in the truth]{strong=“H571”} \w of thy salvation| strong="H3468" \w*. 
\v 14 [Deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} \w me out of the mire| strong="H2916" \w*, [and let me not sink]{strong=“H2883” x-morph=“strongMorph: \sc Th\sc*8799”}: [let me be delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8735”} [from them that hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} [me, and out of the deep]{strong=“H4615”} \w waters| strong="H4325" \w*. 
\v 15 [Let not the waterflood]{strong=“H7641 H4325”} [overflow]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8799”} [me, neither let the deep]{strong=“H4688”} [swallow me up]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and let not the pit| strong="H875" \w* [shut]{strong=“H332” x-morph=“strongMorph: \sc Th\sc*8799”} \w her mouth| strong="H6310" \w* upon me. 
\v 16 [Hear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8798”} me, O \sc Lord\sc*; \w for thy lovingkindness| strong="H2617" \w* is \w good| strong="H2896" \w*: [turn]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto me according to the multitude| strong="H7230" \w* \w of thy tender mercies| strong="H7356" \w*. 
\v 17 [And hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8686”} \w not thy face| strong="H6440" \w* \w from thy servant| strong="H5650" \w*; [for I am in trouble]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8804”}: [hear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8798”} \w me speedily| strong="H4118" \w*.\f + \fr 69:17 \ft hear…: Heb. make haste to hear me \f* 
\v 18 [Draw nigh]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto my soul| strong="H5315" \w*, and [redeem]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8798”} [it: deliver]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8798”} [me because of mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 19 [Thou hast known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w my reproach| strong="H2781" \w*, \w and my shame| strong="H1322" \w*, \w and my dishonour| strong="H3639" \w*: [mine adversaries]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8802”} are all before thee. 
\v 20 \w Reproach| strong="H2781" \w* [hath broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8804”} \w my heart| strong="H3820" \w*; [and I am full of heaviness]{strong=“H5136” x-morph=“strongMorph: \sc Th\sc*8799”}: [and I looked]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8762”} for some [to take pity]{strong=“H5110” x-morph=“strongMorph: \sc Th\sc*8800”}, but there was [none; and for comforters]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8764”}, [but I found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} none.\f + \fr 69:20 \ft to take…: Heb. to lament with me \f* 
\v 21 [They gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w me also gall| strong="H7219" \w* \w for my meat| strong="H1267" \w*; \w and in my thirst| strong="H6772" \w* \w they gave me vinegar| strong="H2558" \w* [to drink]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 22 \w Let their table| strong="H7979" \w* \w become a snare| strong="H6341" \w* \w before| strong="H6440" \w* them: and that which should have been for their \w welfare| strong="H7965" \w*, let it become \w a trap| strong="H4170" \w*. 
\v 23 \w Let their eyes| strong="H5869" \w* [be darkened]{strong=“H2821” x-morph=“strongMorph: \sc Th\sc*8799”}, [that they see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} [not; and make their loins]{strong=“H4975”} \w continually| strong="H8548" \w* [to shake]{strong=“H4571” x-morph=“strongMorph: \sc Th\sc*8685”}. 
\v 24 [Pour out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8798”} \w thine indignation| strong="H2195" \w* [upon them, and let thy wrathful]{strong=“H2740”} \w anger| strong="H639" \w* [take hold]{strong=“H5381” x-morph=“strongMorph: \sc Th\sc*8686”} of them. 
\v 25 \w Let their habitation| strong="H2918" \w* [be desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8737”}; and [let none dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in their tents| strong="H168" \w*.\f + \fr 69:25 \ft their habitation: Heb. their palace \f* \f + \fr 69:25 \ft let none…: Heb. let there not be a dweller \f* 
\v 26 [For they persecute]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8804”} him [whom thou hast smitten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”}; [and they talk]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} \w to the grief| strong="H4341" \w* \w of those whom thou hast wounded| strong="H2491" \w*.\f + \fr 69:26 \ft those…: Heb. thy wounded \f* 
\v 27 [Add]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w iniquity| strong="H5771" \w* \w unto their iniquity| strong="H5771" \w*: [and let them not come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into thy righteousness| strong="H6666" \w*.\f + \fr 69:27 \ft iniquity unto…: or, punishment of iniquity, etc \f* 
\v 28 [Let them be blotted]{strong=“H4229” x-morph=“strongMorph: \sc Th\sc*8735”} \w out of the book| strong="H5612" \w* \w of the living| strong="H2416" \w*, [and not be written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8735”} \w with the righteous| strong="H6662" \w*. 
\v 29 But I am \w poor| strong="H6041" \w* [and sorrowful]{strong=“H3510” x-morph=“strongMorph: \sc Th\sc*8802”}: \w let thy salvation| strong="H3444" \w*, \w O God| strong="H430" \w*, [set me up on high]{strong=“H7682” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 30 [I will praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} \w the name| strong="H8034" \w* \w of God| strong="H430" \w* \w with a song| strong="H7892" \w*, [and will magnify]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8762”} \w him with thanksgiving| strong="H8426" \w*. 
\v 31 This \w also shall please| strong="H3190" \w* the \sc Lord\sc* [better]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8799”} \w than an ox| strong="H7794" \w* or \w bullock| strong="H6499" \w* [that hath horns]{strong=“H7160” x-morph=“strongMorph: \sc Th\sc*8688”} [and hoofs]{strong=“H6536” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 32 \w The humble| strong="H6035" \w* [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} this, and [be glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”}: \w and your heart| strong="H3824" \w* [shall live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”} [that seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8802”} \w God| strong="H430" \w*.\f + \fr 69:32 \ft humble: or, meek \f* 
\v 33 For the \sc Lord\sc* [heareth ]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} \w the poor| strong="H34" \w*, [and despiseth]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8804”} \w not his prisoners| strong="H615" \w*. 
\v 34 \w Let the heaven| strong="H8064" \w* \w and earth| strong="H776" \w* [praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} [him, the seas]{strong=“H3220”}, [and every thing that moveth]{strong=“H7430” x-morph=“strongMorph: \sc Th\sc*8802”} therein.\f + \fr 69:34 \ft moveth: Heb. creepeth \f* 
\v 35 \w For God| strong="H430" \w* [will save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} \w Zion| strong="H6726" \w*, [and will build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w the cities| strong="H5892" \w* \w of Judah| strong="H3063" \w*: [that they may dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} [there, and have it in possession]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 36 \w The seed| strong="H2233" \w* \w also of his servants| strong="H5650" \w* [shall inherit]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8799”} [it: and they that love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} \w his name| strong="H8034" \w* [shall dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} therein.
\c 70
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, A Psalm \w of David| strong="H1732" \w*, [to bring to remembrance]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8687”}. 
\v 1 Make haste, \w O God| strong="H430" \w*, [to deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8687”} [me; make haste]{strong=“H2363” x-morph=“strongMorph: \sc Th\sc*8798”} \w to help| strong="H5833" \w* me, O \sc Lord\sc*.\f + \fr 70:1 \ft to help…: Heb. to my help \f* 
\v 2 [Let them be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} [and confounded]{strong=“H2659” x-morph=“strongMorph: \sc Th\sc*8799”} [that seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w after my soul| strong="H5315" \w*: [let them be turned]{strong=“H5472” x-morph=“strongMorph: \sc Th\sc*8735”} \w backward| strong="H268" \w*, [and put to confusion]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8735”}, \w that desire| strong="H2655" \w* \w my hurt| strong="H7451" \w*. 
\v 3 [Let them be turned back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w for a reward| strong="H6118" \w* \w of their shame| strong="H1322" \w* [that say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, \w Aha| strong="H1889" \w*, \w aha| strong="H1889" \w*. 
\v 4 [Let all those that seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} [thee rejoice]{strong=“H7797” x-morph=“strongMorph: \sc Th\sc*8799”} [and be glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} [in thee: and let such as love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} \w thy salvation| strong="H3444" \w* [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w continually| strong="H8548" \w*, \w Let God| strong="H430" \w* [be magnified]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 5 But I am \w poor| strong="H6041" \w* \w and needy| strong="H34" \w*: [make haste]{strong=“H2363” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me, O God]{strong=“H430”}: thou art \w my help| strong="H5828" \w* [and my deliverer]{strong=“H6403” x-morph=“strongMorph: \sc Th\sc*8764”}; O \sc Lord\sc*, [make no tarrying]{strong=“H309” x-morph=“strongMorph: \sc Th\sc*8762”}.
\c 71
\p 
\v 1 In thee, O \sc Lord\sc*, [do I put my trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8804”}: [let me never]{strong=“H5769 H408”} [be put to confusion]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 2 [Deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w me in thy righteousness| strong="H6666" \w*, [and cause me to escape]{strong=“H6403” x-morph=“strongMorph: \sc Th\sc*8762”}: [incline]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8685”} \w thine ear| strong="H241" \w* [unto me, and save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”} me. 
\v 3 \w Be thou my strong| strong="H6697" \w* \w habitation| strong="H4583" \w*, \w whereunto I may continually| strong="H8548" \w* [resort]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}: [thou hast given commandment]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [to save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8687”} me; for thou art \w my rock| strong="H5553" \w* \w and my fortress| strong="H4686" \w*.\f + \fr 71:3 \ft Be…: Heb. Be thou to me for a rock of habitation \f* 
\v 4 [Deliver]{strong=“H6403” x-morph=“strongMorph: \sc Th\sc*8761”} [me, O my God]{strong=“H430”}, \w out of the hand| strong="H3027" \w* \w of the wicked| strong="H7563" \w*, \w out of the hand| strong="H3709" \w* [of the unrighteous]{strong=“H5765” x-morph=“strongMorph: \sc Th\sc*8764”} [and cruel man]{strong=“H2556” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 5 For thou art \w my hope| strong="H8615" \w*, \w O Lord| strong="H136" \w* \sc God\sc*: thou art \w my trust| strong="H4009" \w* \w from my youth| strong="H5271" \w*. 
\v 6 [By thee have I been holden up]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8738”} \w from the womb| strong="H990" \w*: [thou art he that took]{strong=“H1491” x-morph=“strongMorph: \sc Th\sc*8802”} [me out of my mother’s]{strong=“H517”} \w bowels| strong="H4578" \w*: \w my praise| strong="H8416" \w* shall be \w continually| strong="H8548" \w* of thee. 
\v 7 \w I am as a wonder| strong="H4159" \w* \w unto many| strong="H7227" \w*; but thou art \w my strong| strong="H5797" \w* \w refuge| strong="H4268" \w*. 
\v 8 \w Let my mouth| strong="H6310" \w* [be filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”} with \w thy praise| strong="H8416" \w* and with \w thy honour| strong="H8597" \w* \w all the day| strong="H3117" \w*. 
\v 9 [Cast me not off]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w in the time| strong="H6256" \w* \w of old age| strong="H2209" \w*; [forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w me not when my strength| strong="H3581" \w* [faileth]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 10 [For mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [against me; and they that lay wait]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w for my soul| strong="H5315" \w* [take counsel]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8738”} \w together| strong="H3162" \w*,\f + \fr 71:10 \ft lay…: Heb. watch, or, observe \f* 
\v 11 [Saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w God| strong="H430" \w* [hath forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} [him: persecute]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8798”} [and take]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8798”} him; for there is [none to deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8688”} him. 
\v 12 \w O God| strong="H430" \w*, [be not far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8799”} [from me: O my God]{strong=“H430”}, [make haste]{strong=“H2439 H2363” x-morph=“strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8798”} \w for my help| strong="H5833" \w*. 
\v 13 [Let them be confounded]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} and [consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8799”} [that are adversaries]{strong=“H7853” x-morph=“strongMorph: \sc Th\sc*8802”} \w to my soul| strong="H5315" \w*; [let them be covered]{strong=“H5844” x-morph=“strongMorph: \sc Th\sc*8799”} with \w reproach| strong="H2781" \w* \w and dishonour| strong="H3639" \w* [that seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w my hurt| strong="H7451" \w*. 
\v 14 [But I will hope]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8762”} \w continually| strong="H8548" \w*, \w and will yet praise| strong="H8416" \w* [thee more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8689”} [and more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\v 15 \w My mouth| strong="H6310" \w* [shall shew forth]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy righteousness| strong="H6666" \w* and \w thy salvation| strong="H8668" \w* \w all the day| strong="H3117" \w*; [for I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the numbers| strong="H5615" \w* thereof. 
\v 16 [I will go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w the strength| strong="H1369" \w* \w of the Lord| strong="H136" \w* \sc God\sc*: [I will make mention]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8686”} \w of thy righteousness| strong="H6666" \w*, even of thine only. 
\v 17 \w O God| strong="H430" \w*, [thou hast taught]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8765”} \w me from my youth| strong="H5271" \w*: [and hitherto have I declared]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} [thy wondrous works]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”}. 
\v 18 \w Now also when| strong="H5704" \w* \w I am old| strong="H2209" \w* \w and grayheaded| strong="H7872" \w*, \w O God| strong="H430" \w*, [forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} [me not; until I have shewed]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy strength| strong="H2220" \w* unto this \w generation| strong="H1755" \w*, and \w thy power| strong="H1369" \w* to every one that [is to come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 71:18 \ft when…: Heb. unto old age and gray hairs \f* \f + \fr 71:18 \ft thy strength: Heb. thine arm \f* 
\v 19 \w Thy righteousness| strong="H6666" \w* [also, O God]{strong=“H430”}, is \w very high| strong="H4791" \w*, [who hast done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w great things| strong="H1419" \w*: \w O God| strong="H430" \w*, who is like unto thee! 
\v 20 Thou, [which hast shewed]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8689”} \w me great| strong="H7227" \w* \w and sore| strong="H7451" \w* \w troubles| strong="H6869" \w*, [shalt quicken]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8762”} [me again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [and shalt bring me up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} [again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the depths| strong="H8415" \w* \w of the earth| strong="H776" \w*. 
\v 21 [Thou shalt increase]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} \w my greatness| strong="H1420" \w*, [and comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8762”} [me on every side]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 22 [I will also praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} [thee with the psaltery]{strong=“H5035 H3627” x-morph=“strongMorph: \sc Th\sc*8676”}, even \w thy truth| strong="H571" \w*, \w O my God| strong="H430" \w*: [unto thee will I sing]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8762”} \w with the harp| strong="H3658" \w*, \w O thou Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w*.\f + \fr 71:22 \ft the psaltery: Heb. the instrument of psaltery \f* 
\v 23 \w My lips| strong="H8193" \w* [shall greatly rejoice]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8762”} [when I sing]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8762”} [unto thee; and my soul]{strong=“H5315”}, [which thou hast redeemed]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 24 \w My tongue| strong="H3956" \w* [also shall talk]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8799”} \w of thy righteousness| strong="H6666" \w* \w all the day| strong="H3117" \w* [long: for they are confounded]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8804”}, [for they are brought unto shame]{strong=“H2659” x-morph=“strongMorph: \sc Th\sc*8804”}, [that seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w my hurt| strong="H7451" \w*.
\c 72
\p 
A Psalm \w for Solomon| strong="H8010" \w*. 
\v 1 [Give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w the king| strong="H4428" \w* \w thy judgments| strong="H4941" \w*, \w O God| strong="H430" \w*, \w and thy righteousness| strong="H6666" \w* [unto the king’s]{strong=“H4428”} \w son| strong="H1121" \w*.\f + \fr 72:1 \ft for: or, of \f* 
\v 2 [He shall judge]{strong=“H1777” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy people| strong="H5971" \w* \w with righteousness| strong="H6664" \w*, \w and thy poor| strong="H6041" \w* \w with judgment| strong="H4941" \w*. 
