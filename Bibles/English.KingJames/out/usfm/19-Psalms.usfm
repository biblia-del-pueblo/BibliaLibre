\c 49
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w A Psalm| strong="H4210" \w* \w for the sons| strong="H1121" \w* \w of Korah| strong="H7141" \w*. 
\v 1 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} this, all ye \w people| strong="H5971" \w*; [give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”}, all ye [inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the world| strong="H2465" \w*:\f + \fr 49:1 \ft for: or, of \f* 
\v 2 [Both low]{strong=“H120 H1121”} [and high]{strong=“H376 H1121”}, \w rich| strong="H6223" \w* \w and poor| strong="H34" \w*, \w together| strong="H3162" \w*. 
\v 3 \w My mouth| strong="H6310" \w* [shall speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w of wisdom| strong="H2454" \w*; \w and the meditation| strong="H1900" \w* \w of my heart| strong="H3820" \w* shall be \w of understanding| strong="H8394" \w*. 
\v 4 [I will incline]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w mine ear| strong="H241" \w* \w to a parable| strong="H4912" \w*: [I will open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} \w my dark saying| strong="H2420" \w* \w upon the harp| strong="H3658" \w*. 
\v 5 [Wherefore should I fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the days| strong="H3117" \w* \w of evil| strong="H7451" \w*, when \w the iniquity| strong="H5771" \w* \w of my heels| strong="H6120" \w* [shall compass]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8799”} me about? 
\v 6 [They that trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”} \w in their wealth| strong="H2428" \w*, [and boast]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8691”} \w themselves in the multitude| strong="H7230" \w* \w of their riches| strong="H6239" \w*; 
\v 7 None of them \w can| strong="H376" \w* [by any means]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8800”} [redeem]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8799”} \w his brother| strong="H251" \w*, [nor give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w to God| strong="H430" \w* \w a ransom| strong="H3724" \w* for him: 
\v 8 (\w For the redemption| strong="H6306" \w* \w of their soul| strong="H5315" \w* is [precious]{strong=“H3365” x-morph=“strongMorph: \sc Th\sc*8799”}, [and it ceaseth]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8804”} \w for ever| strong="H5769" \w*:) 
\v 9 [That he should still live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”} \w for ever| strong="H5331" \w*, and [not see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w corruption| strong="H7845" \w*. 
\v 10 [For he seeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} that \w wise men| strong="H2450" \w* [die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, \w likewise| strong="H3162" \w* \w the fool| strong="H3684" \w* \w and the brutish person| strong="H1198" \w* [perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}, [and leave]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} \w their wealth| strong="H2428" \w* \w to others| strong="H312" \w*. 
\v 11 \w Their inward| strong="H7130" \w* thought is, that \w their houses| strong="H1004" \w* shall continue \w for ever| strong="H5769" \w*, and \w their dwelling| strong="H4908" \w* \w places to all| strong="H1755" \w* \w generations| strong="H1755" \w*; [they call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} their \w lands| strong="H127" \w* \w after their own names| strong="H8034" \w*.\f + \fr 49:11 \ft all…: Heb. generation and generation \f* 
\v 12 \w Nevertheless man| strong="H120" \w* being \w in honour| strong="H3366" \w* [abideth]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} [not: he is like]{strong=“H4911” x-morph=“strongMorph: \sc Th\sc*8738”} \w the beasts| strong="H929" \w* that [perish]{strong=“H1820” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 13 \w This their way| strong="H1870" \w* is \w their folly| strong="H3689" \w*: \w yet their posterity| strong="H310" \w* [approve]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8799”} \w their sayings| strong="H6310" \w*. \w Selah| strong="H5542" \w*.\f + \fr 49:13 \ft approve…: Heb. delight in their mouth \f* 
\v 14 \w Like sheep| strong="H6629" \w* [they are laid]{strong=“H8371” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the grave| strong="H7585" \w*; \w death| strong="H4194" \w* [shall feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} [on them; and the upright]{strong=“H3477”} [shall have dominion]{strong=“H7287” x-morph=“strongMorph: \sc Th\sc*8799”} \w over them in the morning| strong="H1242" \w*; [and their beauty]{strong=“H6736 H6697” x-morph=“strongMorph: \sc Th\sc*8675”} [shall consume]{strong=“H1086” x-morph=“strongMorph: \sc Th\sc*8763”} \w in the grave| strong="H7585" \w* \w from their dwelling| strong="H2073" \w*.\f + \fr 49:14 \ft beauty: or, strength \f* \f + \fr 49:14 \ft in the grave from…: or, the grave being an habitation to every one of them \f* 
\v 15 \w But God| strong="H430" \w* [will redeem]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8799”} \w my soul| strong="H5315" \w* \w from the power| strong="H3027" \w* \w of the grave| strong="H7585" \w*: [for he shall receive]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [me. Selah]{strong=“H5542”}.\f + \fr 49:15 \ft power: Heb. hand \f* \f + \fr 49:15 \ft the grave: or, hell \f* 
\v 16 [Be not thou afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w when one| strong="H376" \w* [is made rich]{strong=“H6238” x-morph=“strongMorph: \sc Th\sc*8686”}, \w when the glory| strong="H3519" \w* \w of his house| strong="H1004" \w* [is increased]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8799”}; 
\v 17 \w For when he dieth| strong="H4194" \w* [he shall carry nothing away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”}: \w his glory| strong="H3519" \w* [shall not descend]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* him. 
\v 18 \w Though while he lived| strong="H2416" \w* [he blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w his soul| strong="H5315" \w*: and men [will praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} [thee, when thou doest well]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8686”} to thyself.\f + \fr 49:18 \ft while…: Heb. in his life \f* 
\v 19 [He shall go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the generation| strong="H1755" \w* \w of his fathers| strong="H1" \w*; [they shall never]{strong=“H5331 H3808”} [see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w light| strong="H216" \w*.\f + \fr 49:19 \ft He…: Heb. The soul shall \f* 
\v 20 \w Man| strong="H120" \w* that is \w in honour| strong="H3366" \w*, [and understandeth]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} [not, is like]{strong=“H4911” x-morph=“strongMorph: \sc Th\sc*8738”} \w the beasts| strong="H929" \w* that [perish]{strong=“H1820” x-morph=“strongMorph: \sc Th\sc*8738”}.
\c 50
\p 
\w A Psalm| strong="H4210" \w* \w of Asaph| strong="H623" \w*. 
\v 1 \w The mighty| strong="H410" \w* \w God| strong="H430" \w*, even the \sc Lord\sc*, [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}, [and called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w the earth| strong="H776" \w* \w from the rising| strong="H4217" \w* \w of the sun| strong="H8121" \w* \w unto the going down| strong="H3996" \w* thereof.\f + \fr 50:1 \ft of…: or, for Asaph \f* 
\v 2 \w Out of Zion| strong="H6726" \w*, \w the perfection| strong="H4359" \w* \w of beauty| strong="H3308" \w*, \w God| strong="H430" \w* [hath shined]{strong=“H3313” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\v 3 \w Our God| strong="H430" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [and shall not keep silence]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8799”}: \w a fire| strong="H784" \w* [shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* [him, and it shall be very]{strong=“H3966”} [tempestuous]{strong=“H8175” x-morph=“strongMorph: \sc Th\sc*8738”} \w round about| strong="H5439" \w* him. 
\v 4 [He shall call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the heavens| strong="H8064" \w* \w from above| strong="H5920" \w*, \w and to the earth| strong="H776" \w*, [that he may judge]{strong=“H1777” x-morph=“strongMorph: \sc Th\sc*8800”} \w his people| strong="H5971" \w*. 
\v 5 [Gather]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8798”} \w my saints| strong="H2623" \w* [together unto me; those that have made]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8802”} \w a covenant| strong="H1285" \w* \w with me by sacrifice| strong="H2077" \w*. 
\v 6 \w And the heavens| strong="H8064" \w* [shall declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w his righteousness| strong="H6664" \w*: \w for God| strong="H430" \w* is [judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} [himself. Selah]{strong=“H5542”}. 
\v 7 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O my people| strong="H5971" \w*, [and I will speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}; \w O Israel| strong="H3478" \w*, [and I will testify]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8686”} against thee: I am \w God| strong="H430" \w*, even \w thy God| strong="H430" \w*. 
\v 8 [I will not reprove]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee for thy sacrifices| strong="H2077" \w* \w or thy burnt offerings| strong="H5930" \w*, to have been \w continually| strong="H8548" \w* before me. 
\v 9 [I will take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w no bullock| strong="H6499" \w* \w out of thy house| strong="H1004" \w*, nor \w he goats| strong="H6260" \w* \w out of thy folds| strong="H4356" \w*. 
\v 10 \w For every beast| strong="H2416" \w* \w of the forest| strong="H3293" \w* is mine, and \w the cattle| strong="H929" \w* \w upon a thousand| strong="H505" \w* \w hills| strong="H2042" \w*. 
\v 11 [I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w all the fowls| strong="H5775" \w* \w of the mountains| strong="H2022" \w*: \w and the wild beasts| strong="H2123" \w* \w of the field| strong="H7704" \w* are \w mine| strong="H5978" \w*.\f + \fr 50:11 \ft mine: Heb. with me \f* 
\v 12 [If I were hungry]{strong=“H7456” x-morph=“strongMorph: \sc Th\sc*8799”}, [I would not tell]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [thee: for the world]{strong=“H8398”} is [mine, and the fulness]{strong=“H4393”} thereof. 
\v 13 [Will I eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the flesh| strong="H1320" \w* \w of bulls| strong="H47" \w*, [or drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w the blood| strong="H1818" \w* \w of goats| strong="H6260" \w*? 
\v 14 [Offer]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto God| strong="H430" \w* \w thanksgiving| strong="H8426" \w*; [and pay]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8761”} \w thy vows| strong="H5088" \w* \w unto the most High| strong="H5945" \w*: 
\v 15 [And call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} \w upon me in the day| strong="H3117" \w* \w of trouble| strong="H6869" \w*: [I will deliver]{strong=“H2502” x-morph=“strongMorph: \sc Th\sc*8762”} [thee, and thou shalt glorify]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8762”} me. 
\v 16 \w But unto the wicked| strong="H7563" \w* \w God| strong="H430" \w* [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [What hast thou to do to declare]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8763”} \w my statutes| strong="H2706" \w*, or that [thou shouldest take]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w my covenant| strong="H1285" \w* \w in thy mouth| strong="H6310" \w*? 
\v 17 [Seeing thou hatest]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”} \w instruction| strong="H4148" \w*, [and castest]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w my words| strong="H1697" \w* \w behind| strong="H310" \w* thee. 
\v 18 [When thou sawest]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w a thief| strong="H1590" \w*, [then thou consentedst]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8799”} [with him, and hast been partaker]{strong=“H2506”} [with adulterers]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8764”}.\f + \fr 50:18 \ft hast…: Heb. thy portion was with \f* 
\v 19 [Thou givest]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy mouth| strong="H6310" \w* \w to evil| strong="H7451" \w*, \w and thy tongue| strong="H3956" \w* [frameth ]{strong=“H6775” x-morph=“strongMorph: \sc Th\sc*8686”} \w deceit| strong="H4820" \w*.\f + \fr 50:19 \ft givest: Heb. sendest \f* 
\v 20 [Thou sittest]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} and [speakest]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w against thy brother| strong="H251" \w*; [thou]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w slanderest| strong="H1848" \w* [thine own mother’s]{strong=“H517”} \w son| strong="H1121" \w*. 
\v 21 These things [hast thou done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [and I kept silence]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8689”}; [thou thoughtest]{strong=“H1819” x-morph=“strongMorph: \sc Th\sc*8765”} [that I was altogether]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8800”} such an one as thyself: but [I will reprove]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”} thee, and set them [in order]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8799”} \w before thine eyes| strong="H5869" \w*. 
\v 22 [Now consider]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8798”} [this, ye that forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8802”} \w God| strong="H433" \w*, lest I tear you [in pieces]{strong=“H2963” x-morph=“strongMorph: \sc Th\sc*8799”}, and there be [none to deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 23 [Whoso offereth]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8802”} \w praise| strong="H8426" \w* [glorifieth ]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8762”} [me: and to him that ordereth]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} his \w conversation| strong="H1870" \w* aright [will I shew]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8686”} \w the salvation| strong="H3468" \w* \w of God| strong="H430" \w*.\f + \fr 50:23 \ft that…: Heb. that disposeth his way \f*
\c 51
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*, \w when Nathan| strong="H5416" \w* \w the prophet| strong="H5030" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [unto him, after he had gone in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to Bath-sheba]{strong=“H1339”}. 
\v 1 [Have mercy]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} [upon me, O God]{strong=“H430”}, \w according to thy lovingkindness| strong="H2617" \w*: \w according unto the multitude| strong="H7230" \w* \w of thy tender mercies| strong="H7356" \w* [blot out]{strong=“H4229” x-morph=“strongMorph: \sc Th\sc*8798”} \w my transgressions| strong="H6588" \w*. 
\v 2 [Wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8761”} [me throughly]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8685”} \w from mine iniquity| strong="H5771" \w*, [and cleanse]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8761”} \w me from my sin| strong="H2403" \w*. 
\v 3 [For I acknowledge]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w my transgressions| strong="H6588" \w*: \w and my sin| strong="H2403" \w* is \w ever| strong="H8548" \w* before me. 
\v 4 [Against thee, thee only, have I sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}, [and done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} this \w evil| strong="H7451" \w* \w in thy sight| strong="H5869" \w*: [that thou mightest be justified]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8799”} [when thou speakest]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8800”}, and [be clear]{strong=“H2135” x-morph=“strongMorph: \sc Th\sc*8799”} [when thou judgest]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 5 [Behold, I was shapen]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8797”} \w in iniquity| strong="H5771" \w*; \w and in sin| strong="H2399" \w* \w did my mother| strong="H517" \w* [conceive]{strong=“H3179” x-morph=“strongMorph: \sc Th\sc*8765”} me.\f + \fr 51:5 \ft conceive…: Heb. warm me \f* 
\v 6 [Behold, thou desirest]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} \w truth| strong="H571" \w* \w in the inward parts| strong="H2910" \w*: [and in the hidden]{strong=“H5640” x-morph=“strongMorph: \sc Th\sc*8803”} part [thou shalt make me to know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8686”} \w wisdom| strong="H2451" \w*. 
\v 7 [Purge]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8762”} \w me with hyssop| strong="H231" \w*, [and I shall be clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8799”}: [wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8762”} [me, and I shall be whiter]{strong=“H3835” x-morph=“strongMorph: \sc Th\sc*8686”} \w than snow| strong="H7950" \w*. 
\v 8 [Make me to hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8686”} \w joy| strong="H8342" \w* \w and gladness| strong="H8057" \w*; that \w the bones| strong="H6106" \w* which [thou hast broken]{strong=“H1794” x-morph=“strongMorph: \sc Th\sc*8765”} [may rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 9 [Hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8685”} \w thy face| strong="H6440" \w* \w from my sins| strong="H2399" \w*, [and blot out]{strong=“H4229” x-morph=“strongMorph: \sc Th\sc*8798”} \w all mine iniquities| strong="H5771" \w*. 
\v 10 [Create]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8798”} \w in me a clean| strong="H2889" \w* \w heart| strong="H3820" \w*, \w O God| strong="H430" \w*; [and renew]{strong=“H2318” x-morph=“strongMorph: \sc Th\sc*8761”} [a right]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8737”} \w spirit| strong="H7307" \w* \w within| strong="H7130" \w* me.\f + \fr 51:10 \ft right: or, constant \f* 
\v 11 [Cast me not away]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w from thy presence| strong="H6440" \w*; [and take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w not thy holy| strong="H6944" \w* \w spirit| strong="H7307" \w* from me. 
\v 12 [Restore]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto me the joy| strong="H8342" \w* \w of thy salvation| strong="H3468" \w*; [and uphold]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8799”} me with thy \w free| strong="H5081" \w* \w spirit| strong="H7307" \w*. 
\v 13 Then [will I teach]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8762”} [transgressors]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8802”} \w thy ways| strong="H1870" \w*; \w and sinners| strong="H2400" \w* [shall be converted]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} unto thee. 
\v 14 [Deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} \w me from bloodguiltiness| strong="H1818" \w*, \w O God| strong="H430" \w*, \w thou God| strong="H430" \w* \w of my salvation| strong="H8668" \w*: and \w my tongue| strong="H3956" \w* [shall sing aloud]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8762”} \w of thy righteousness| strong="H6666" \w*.\f + \fr 51:14 \ft bloodguiltiness: Heb. bloods \f* 
\v 15 \w O Lord| strong="H136" \w*, [open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} \w thou my lips| strong="H8193" \w*; \w and my mouth| strong="H6310" \w* [shall shew forth]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy praise| strong="H8416" \w*. 
\v 16 [For thou desirest]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8799”} \w not sacrifice| strong="H2077" \w*; [else would I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} it: [thou delightest]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8799”} \w not in burnt offering| strong="H5930" \w*.\f + \fr 51:16 \ft else…: or, that I should \f* 
\v 17 \w The sacrifices| strong="H2077" \w* \w of God| strong="H430" \w* are [a broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8737”} \w spirit| strong="H7307" \w*: [a broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8737”} [and a contrite]{strong=“H1794” x-morph=“strongMorph: \sc Th\sc*8737”} \w heart| strong="H3820" \w*, \w O God| strong="H430" \w*, [thou wilt not despise]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 18 [Do good]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8685”} \w in thy good pleasure| strong="H7522" \w* \w unto Zion| strong="H6726" \w*: [build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w thou the walls| strong="H2346" \w* \w of Jerusalem| strong="H3389" \w*. 
\v 19 [Then shalt thou be pleased]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the sacrifices| strong="H2077" \w* \w of righteousness| strong="H6664" \w*, \w with burnt offering| strong="H5930" \w* \w and whole| strong="H3632" \w* \w burnt offering| strong="H5930" \w*: [then shall they offer]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w bullocks| strong="H6499" \w* \w upon thine altar| strong="H4196" \w*.
\c 52
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, [Maschil]{strong=“H4905” x-morph=“strongMorph: \sc Th\sc*8688”}, A Psalm \w of David| strong="H1732" \w*, \w when Doeg| strong="H1673" \w* \w the Edomite| strong="H130" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [and told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w Saul| strong="H7586" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, David]{strong=“H1732”} [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the house| strong="H1004" \w* \w of Ahimelech| strong="H288" \w*. 
\v 1 [Why boastest]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8691”} \w thou thyself in mischief| strong="H7451" \w*, \w O mighty| strong="H1368" \w* [man? the goodness]{strong=“H2617”} \w of God| strong="H410" \w* endureth \w continually| strong="H3117" \w*.\f + \fr 52:1 \ft Maschil: or, of instruction \f* 
\v 2 \w Thy tongue| strong="H3956" \w* [deviseth]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8799”} \w mischiefs| strong="H1942" \w*; [like a sharp]{strong=“H3913” x-morph=“strongMorph: \sc Th\sc*8794”} \w razor| strong="H8593" \w*, [working]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w deceitfully| strong="H7423" \w*. 
\v 3 [Thou lovest]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} \w evil| strong="H7451" \w* \w more than good| strong="H2896" \w*; and \w lying| strong="H8267" \w* [rather than to speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w righteousness| strong="H6664" \w*. \w Selah| strong="H5542" \w*. 
\v 4 [Thou lovest]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} \w all devouring| strong="H1105" \w* \w words| strong="H1697" \w*, O thou \w deceitful| strong="H4820" \w* \w tongue| strong="H3956" \w*.\f + \fr 52:4 \ft O thou…: or, and the deceitful tongue \f* 
\v 5 \w God| strong="H410" \w* [shall likewise destroy]{strong=“H5422” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee for ever| strong="H5331" \w*, [he shall take thee away]{strong=“H2846” x-morph=“strongMorph: \sc Th\sc*8799”}, [and pluck thee out]{strong=“H5255” x-morph=“strongMorph: \sc Th\sc*8799”} of thy \w dwelling place| strong="H168" \w*, [and root thee out]{strong=“H8327” x-morph=“strongMorph: \sc Th\sc*8765”} \w of the land| strong="H776" \w* \w of the living| strong="H2416" \w*. \w Selah| strong="H5542" \w*.\f + \fr 52:5 \ft destroy…: Heb. beat thee down \f* 
\v 6 \w The righteous| strong="H6662" \w* [also shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, [and fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}, [and shall laugh]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8799”} at him: 
\v 7 Lo, this is \w the man| strong="H1397" \w* that [made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w not God| strong="H430" \w* \w his strength| strong="H4581" \w*; [but trusted]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the abundance| strong="H7230" \w* \w of his riches| strong="H6239" \w*, and [strengthened ]{strong=“H5810” x-morph=“strongMorph: \sc Th\sc*8799”} \w himself in his wickedness| strong="H1942" \w*.\f + \fr 52:7 \ft wickedness: or, substance \f* 
\v 8 But I am \w like a green| strong="H7488" \w* \w olive tree| strong="H2132" \w* \w in the house| strong="H1004" \w* \w of God| strong="H430" \w*: [I trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the mercy| strong="H2617" \w* \w of God| strong="H430" \w* \w for ever| strong="H5769" \w* \w and ever| strong="H5703" \w*. 
\v 9 [I will praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee for ever| strong="H5769" \w*, [because thou hast done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} it: [and I will wait]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8762”} \w on thy name| strong="H8034" \w*; for it is \w good| strong="H2896" \w* \w before thy saints| strong="H2623" \w*.
\c 53
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} \w upon Mahalath| strong="H4257" \w*, [Maschil]{strong=“H4905” x-morph=“strongMorph: \sc Th\sc*8688”}, A Psalm \w of David| strong="H1732" \w*. 
\v 1 \w The fool| strong="H5036" \w* [hath said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his heart| strong="H3820" \w*, There is \w no God| strong="H430" \w*. [Corrupt]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8689”} [are they, and have done abominable]{strong=“H8581” x-morph=“strongMorph: \sc Th\sc*8689”} \w iniquity| strong="H5766" \w*: there is [none that doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w good| strong="H2896" \w*.\f + \fr 53:1 \ft Maschil: or, of instruction \f* 
\v 2 \w God| strong="H430" \w* [looked down]{strong=“H8259” x-morph=“strongMorph: \sc Th\sc*8689”} \w from heaven| strong="H8064" \w* \w upon the children| strong="H1121" \w* \w of men| strong="H120" \w*, [to see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w if there were| strong="H3426" \w* any [that did understand]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8688”}, [that did seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8802”} \w God| strong="H430" \w*. 
\v 3 [Every one of them is gone back]{strong=“H5472” x-morph=“strongMorph: \sc Th\sc*8804”}: \w they are altogether| strong="H3162" \w* [become filthy]{strong=“H444” x-morph=“strongMorph: \sc Th\sc*8738”}; there is [none that doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w good| strong="H2896" \w*, [no, not one]{strong=“H259”}. 
\v 4 [Have the workers]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w of iniquity| strong="H205" \w* [no knowledge]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}? [who eat up]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} \w my people| strong="H5971" \w* as [they eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w bread| strong="H3899" \w*: [they have not called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon God| strong="H430" \w*. 
\v 5 \w There were they in great| strong="H6343" \w* [fear]{strong=“H6342” x-morph=“strongMorph: \sc Th\sc*8804”}, where \w no fear| strong="H6343" \w* [was: for God]{strong=“H430”} [hath scattered]{strong=“H6340” x-morph=“strongMorph: \sc Th\sc*8765”} \w the bones| strong="H6106" \w* [of him that encampeth]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8802”} against thee: thou hast put them [to shame]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8689”}, \w because God| strong="H430" \w* [hath despised]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} them.\f + \fr 53:5 \ft were…: Heb. they feared a fear \f* 
\v 6 [Oh that]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w the salvation| strong="H3444" \w* \w of Israel| strong="H3478" \w* were come \w out of Zion| strong="H6726" \w*! \w When God| strong="H430" \w* [bringeth back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w the captivity| strong="H7622" \w* \w of his people| strong="H5971" \w*, \w Jacob| strong="H3290" \w* [shall rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”}, and \w Israel| strong="H3478" \w* [shall be glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 53:6 \ft Oh that…: Heb. Who will give salvation, etc \f*
\c 54
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} \w on Neginoth| strong="H5058" \w*, [Maschil]{strong=“H4905” x-morph=“strongMorph: \sc Th\sc*8688”}, A Psalm \w of David| strong="H1732" \w*, \w when the Ziphims| strong="H2130" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Saul| strong="H7586" \w*, \w Doth not David| strong="H1732" \w* [hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8693”} himself with us? 
\v 1 [Save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”} [me, O God]{strong=“H430”}, \w by thy name| strong="H8034" \w*, [and judge]{strong=“H1777” x-morph=“strongMorph: \sc Th\sc*8799”} \w me by thy strength| strong="H1369" \w*.\f + \fr 54:1 \ft chief…: or, overseer \f* \f + \fr 54:1 \ft Maschil: or, of instruction \f* 
\v 2 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w my prayer| strong="H8605" \w*, \w O God| strong="H430" \w*; [give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”} \w to the words| strong="H561" \w* \w of my mouth| strong="H6310" \w*. 
\v 3 [For strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} [are risen up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”} [against me, and oppressors]{strong=“H6184”} [seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8765”} \w after my soul| strong="H5315" \w*: [they have not set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w God| strong="H430" \w* [before them. Selah]{strong=“H5542”}. 
\v 4 [Behold, God]{strong=“H430”} is [mine helper]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8802”}: \w the Lord| strong="H136" \w* is [with them that uphold]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8802”} \w my soul| strong="H5315" \w*. 
\v 5 [He shall reward]{strong=“H7725 H7725” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8686”} \w evil| strong="H7451" \w* [unto mine enemies]{strong=“H8324” x-morph=“strongMorph: \sc Th\sc*8802”}: [cut them off]{strong=“H6789” x-morph=“strongMorph: \sc Th\sc*8685”} \w in thy truth| strong="H571" \w*.\f + \fr 54:5 \ft mine…: Heb. those that observe me \f* 
\v 6 \w I will freely| strong="H5071" \w* [sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee: I will praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy name| strong="H8034" \w*, O \sc Lord\sc*; for it is \w good| strong="H2896" \w*. 
\v 7 [For he hath delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w me out of all trouble| strong="H6869" \w*: \w and mine eye| strong="H5869" \w* [hath seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} his desire [upon mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}.
\c 55
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} \w on Neginoth| strong="H5058" \w*, [Maschil]{strong=“H4905” x-morph=“strongMorph: \sc Th\sc*8688”}, A Psalm \w of David| strong="H1732" \w*. 
\v 1 [Give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”} \w to my prayer| strong="H8605" \w*, \w O God| strong="H430" \w*; [and hide]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8691”} \w not thyself from my supplication| strong="H8467" \w*.\f + \fr 55:1 \ft chief…: or, overseer \f* \f + \fr 55:1 \ft Maschil: or, of instruction \f* 
\v 2 [Attend]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8685”} [unto me, and hear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8798”} [me: I mourn]{strong=“H7300” x-morph=“strongMorph: \sc Th\sc*8686”} \w in my complaint| strong="H7879" \w*, [and make a noise]{strong=“H1949” x-morph=“strongMorph: \sc Th\sc*8686”}; 
\v 3 \w Because of the voice| strong="H6963" \w* [of the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, \w because| strong="H6440" \w* \w of the oppression| strong="H6125" \w* \w of the wicked| strong="H7563" \w*: [for they cast]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8686”} \w iniquity| strong="H205" \w* [upon me, and in wrath]{strong=“H639”} [they hate]{strong=“H7852” x-morph=“strongMorph: \sc Th\sc*8799”} me. 
\v 4 \w My heart| strong="H3820" \w* [is sore pained]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8799”} \w within| strong="H7130" \w* [me: and the terrors]{strong=“H367”} \w of death| strong="H4194" \w* [are fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} upon me. 
\v 5 \w Fearfulness| strong="H3374" \w* \w and trembling| strong="H7461" \w* [are come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [upon me, and horror]{strong=“H6427”} [hath overwhelmed]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} me.\f + \fr 55:5 \ft overwhelmed: Heb. covered \f* 
\v 6 [And I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Oh that]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w I had wings| strong="H83" \w* \w like a dove| strong="H3123" \w*! for then [would I fly away]{strong=“H5774” x-morph=“strongMorph: \sc Th\sc*8799”}, [and be at rest]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 7 Lo, then [would I wander]{strong=“H5074” x-morph=“strongMorph: \sc Th\sc*8800”} [far off]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8686”}, and [remain]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the wilderness| strong="H4057" \w*. \w Selah| strong="H5542" \w*. 
\v 8 [I would hasten]{strong=“H2363” x-morph=“strongMorph: \sc Th\sc*8686”} \w my escape| strong="H4655" \w* \w from the windy| strong="H7307" \w* [storm]{strong=“H5584” x-morph=“strongMorph: \sc Th\sc*8801”} and \w tempest| strong="H5591" \w*. 
\v 9 [Destroy]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8761”}, \w O Lord| strong="H136" \w*, and [divide]{strong=“H6385” x-morph=“strongMorph: \sc Th\sc*8761”} \w their tongues| strong="H3956" \w*: [for I have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w violence| strong="H2555" \w* \w and strife| strong="H7379" \w* \w in the city| strong="H5892" \w*. 
\v 10 \w Day| strong="H3119" \w* \w and night| strong="H3915" \w* [they go about]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8779”} \w it upon the walls| strong="H2346" \w* [thereof: mischief]{strong=“H205”} \w also and sorrow| strong="H5999" \w* are \w in the midst| strong="H7130" \w* of it. 
\v 11 \w Wickedness| strong="H1942" \w* is \w in the midst| strong="H7130" \w* [thereof: deceit]{strong=“H8496”} \w and guile| strong="H4820" \w* [depart]{strong=“H4185” x-morph=“strongMorph: \sc Th\sc*8686”} \w not from her streets| strong="H7339" \w*. 
\v 12 For it was [not an enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} that [reproached]{strong=“H2778” x-morph=“strongMorph: \sc Th\sc*8762”} [me; then I could have borne]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} it: neither was it [he that hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8764”} me that [did magnify]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8689”} himself [against me; then I would have hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8735”} myself from him: 
\v 13 But it was [thou, a man]{strong=“H582”} \w mine equal| strong="H6187" \w*, \w my guide| strong="H441" \w*, [and mine acquaintance]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8794”}.\f + \fr 55:13 \ft mine equal: Heb. according to my rank \f* 
\v 14 [We took sweet]{strong=“H4985” x-morph=“strongMorph: \sc Th\sc*8686”} \w counsel| strong="H5475" \w* \w together| strong="H3162" \w*, and [walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto the house| strong="H1004" \w* \w of God| strong="H430" \w* \w in company| strong="H7285" \w*.\f + \fr 55:14 \ft We…: Heb. Who sweetened counsel \f* 
\v 15 \w Let death| strong="H4194" \w* [seize]{strong=“H3451 H5377” x-morph=“strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8686”} upon them, and [let them go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w quick| strong="H2416" \w* \w into hell| strong="H7585" \w*: \w for wickedness| strong="H7451" \w* is \w in their dwellings| strong="H4033" \w*, and \w among| strong="H7130" \w* them.\f + \fr 55:15 \ft hell: or, the grave \f* 
\v 16 [As for me, I will call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon God| strong="H430" \w*; and the \sc Lord\sc* [shall save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} me. 
\v 17 \w Evening| strong="H6153" \w*, \w and morning| strong="H1242" \w*, \w and at noon| strong="H6672" \w*, [will I pray]{strong=“H7878” x-morph=“strongMorph: \sc Th\sc*8799”}, [and cry aloud]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8799”}: [and he shall hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w my voice| strong="H6963" \w*. 
\v 18 [He hath delivered]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8804”} \w my soul| strong="H5315" \w* \w in peace| strong="H7965" \w* \w from the battle| strong="H7128" \w* that was [against me: for there were many]{strong=“H7227”} with me. 
\v 19 \w God| strong="H410" \w* [shall hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}, [and afflict]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [them, even he that abideth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of old| strong="H6924" \w*. \w Selah| strong="H5542" \w*. \w Because they have no changes| strong="H2487" \w*, [therefore they fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8804”} \w not God| strong="H430" \w*.\f + \fr 55:19 \ft Because…: or, With whom also there be no changes, yet they \f* 
\v 20 [He hath put forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w his hands| strong="H3027" \w* \w against such as be at peace| strong="H7965" \w* [with him: he hath broken]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8765”} \w his covenant| strong="H1285" \w*.\f + \fr 55:20 \ft broken: Heb. profaned \f* 
\v 21 The words \w of his mouth| strong="H6310" \w* [were smoother]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8804”} \w than butter| strong="H4260" \w*, \w but war| strong="H7128" \w* was \w in his heart| strong="H3820" \w*: \w his words| strong="H1697" \w* [were softer]{strong=“H7401” x-morph=“strongMorph: \sc Th\sc*8804”} \w than oil| strong="H8081" \w*, yet were \w they drawn swords| strong="H6609" \w*. 
\v 22 [Cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8685”} \w thy burden| strong="H3053" \w* upon the \sc Lord\sc*, [and he shall sustain]{strong=“H3557” x-morph=“strongMorph: \sc Th\sc*8770”} [thee: he shall never]{strong=“H5769”} [suffer]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w the righteous| strong="H6662" \w* [to be moved]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 55:22 \ft burden: or, gift \f* 
\v 23 [But thou, O God]{strong=“H430”}, [shalt bring them down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8686”} \w into the pit| strong="H875" \w* \w of destruction| strong="H7845" \w*: \w bloody| strong="H1818" \w* \w and deceitful| strong="H4820" \w* \w men| strong="H582" \w* [shall not live out half]{strong=“H2673” x-morph=“strongMorph: \sc Th\sc*8799”} \w their days| strong="H3117" \w*; [but I will trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} in thee.\f + \fr 55:23 \ft bloody…: Heb. men of bloods and deceit \f* \f + \fr 55:23 \ft shall…: Heb. shall not half their days \f*
\c 56
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} [upon Jonath-elem-rechokim]{strong=“H3128”}, \w Michtam| strong="H4387" \w* \w of David| strong="H1732" \w*, \w when the Philistines| strong="H6430" \w* [took]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8800”} \w him in Gath| strong="H1661" \w*. 
\v 1 [Be merciful]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me, O God]{strong=“H430”}: \w for man| strong="H582" \w* [would swallow me up]{strong=“H7602” x-morph=“strongMorph: \sc Th\sc*8804”}; [he fighting]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8802”} \w daily| strong="H3117" \w* [oppresseth]{strong=“H3905” x-morph=“strongMorph: \sc Th\sc*8799”} me.\f + \fr 56:1 \ft Michtam…: or, A golden Psalm of David \f* 
\v 2 [Mine enemies]{strong=“H8324” x-morph=“strongMorph: \sc Th\sc*8802”} \w would daily| strong="H3117" \w* [swallow ]{strong=“H7602” x-morph=“strongMorph: \sc Th\sc*8804”} me up: for they be \w many| strong="H7227" \w* [that fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8802”} [against me, O thou most High]{strong=“H4791”}.\f + \fr 56:2 \ft enemies: Heb. observers \f* 
\v 3 \w What time| strong="H3117" \w* [I am afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} in thee. 
\v 4 \w In God| strong="H430" \w* [I will praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} \w his word| strong="H1697" \w*, \w in God| strong="H430" \w* [I have put my trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”}; [I will not fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w what flesh| strong="H1320" \w* [can do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} unto me. 
\v 5 \w Every day| strong="H3117" \w* [they wrest]{strong=“H6087” x-morph=“strongMorph: \sc Th\sc*8762”} \w my words| strong="H1697" \w*: \w all their thoughts| strong="H4284" \w* are \w against me for evil| strong="H7451" \w*. 
\v 6 [They gather themselves together]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”}, [they hide]{strong=“H6845 H6845” x-morph=“strongMorph: \sc Th\sc*8686 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8799”} [themselves, they mark]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w my steps| strong="H6119" \w*, [when they wait]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8765”} \w for my soul| strong="H5315" \w*. 
\v 7 \w Shall they escape| strong="H6405" \w* \w by iniquity| strong="H205" \w*? in thine \w anger| strong="H639" \w* [cast down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8685”} \w the people| strong="H5971" \w*, \w O God| strong="H430" \w*. 
\v 8 [Thou tellest]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8804”} \w my wanderings| strong="H5112" \w*: [put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou my tears| strong="H1832" \w* \w into thy bottle| strong="H4997" \w*: are they \w not in thy book| strong="H5612" \w*? 
\v 9 \w When| strong="H3117" \w* [I cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} unto thee, [then shall mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w back| strong="H268" \w*: [this I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}; \w for God| strong="H430" \w* is for me. 
\v 10 \w In God| strong="H430" \w* [will I praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} his \w word| strong="H1697" \w*: in the \sc Lord\sc* [will I praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} his \w word| strong="H1697" \w*. 
\v 11 \w In God| strong="H430" \w* [have I put my trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”}: [I will not be afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w what man| strong="H120" \w* [can do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} unto me. 
\v 12 \w Thy vows| strong="H5088" \w* are [upon me, O God]{strong=“H430”}: [I will render]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w praises| strong="H8426" \w* unto thee. 
\v 13 [For thou hast delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w my soul| strong="H5315" \w* \w from death| strong="H4194" \w*: wilt not thou deliver \w my feet| strong="H7272" \w* \w from falling| strong="H1762" \w*, [that I may walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8692”} \w before| strong="H6440" \w* \w God| strong="H430" \w* \w in the light| strong="H216" \w* \w of the living| strong="H2416" \w*?
\c 57
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, [Al-taschith]{strong=“H516” x-morph=“strongMorph: \sc Th\sc*8686”}, \w Michtam| strong="H4387" \w* \w of David| strong="H1732" \w*, [when he fled]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8800”} \w from| strong="H6440" \w* \w Saul| strong="H7586" \w* \w in the cave| strong="H4631" \w*. 
\v 1 [Be merciful]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me, O God]{strong=“H430”}, [be merciful]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me: for my soul]{strong=“H5315”} [trusteth]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8804”} [in thee: yea, in the shadow]{strong=“H6738”} \w of thy wings| strong="H3671" \w* [will I make my refuge]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8799”}, until these \w calamities| strong="H1942" \w* [be overpast]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 57:1 \ft Al-taschith: or, Destroy not \f* \f + \fr 57:1 \ft Michtam: or, A golden Psalm \f* 
\v 2 [I will cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto God| strong="H430" \w* \w most high| strong="H5945" \w*; \w unto God| strong="H410" \w* [that performeth]{strong=“H1584” x-morph=“strongMorph: \sc Th\sc*8802”} all things for me. 
\v 3 [He shall send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w from heaven| strong="H8064" \w*, [and save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} me from [the reproach]{strong=“H2778” x-morph=“strongMorph: \sc Th\sc*8765”} [of him that would swallow me up]{strong=“H7602” x-morph=“strongMorph: \sc Th\sc*8802”}. \w Selah| strong="H5542" \w*. \w God| strong="H430" \w* [shall send forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w his mercy| strong="H2617" \w* \w and his truth| strong="H571" \w*.\f + \fr 57:3 \ft from the…: or, he reproacheth him that \f* 
\v 4 \w My soul| strong="H5315" \w* is \w among| strong="H8432" \w* \w lions| strong="H3833" \w*: and [I lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} even among [them that are set on fire]{strong=“H3857” x-morph=“strongMorph: \sc Th\sc*8802”}, even \w the sons| strong="H1121" \w* \w of men| strong="H120" \w*, \w whose teeth| strong="H8127" \w* are \w spears| strong="H2595" \w* \w and arrows| strong="H2671" \w*, \w and their tongue| strong="H3956" \w* \w a sharp| strong="H2299" \w* \w sword| strong="H2719" \w*. 
\v 5 [Be thou exalted]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O God| strong="H430" \w*, \w above the heavens| strong="H8064" \w*; let \w thy glory| strong="H3519" \w* be \w above all the earth| strong="H776" \w*. 
\v 6 [They have prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8689”} \w a net| strong="H7568" \w* \w for my steps| strong="H6471" \w*; \w my soul| strong="H5315" \w* [is bowed down]{strong=“H3721” x-morph=“strongMorph: \sc Th\sc*8804”}: [they have digged]{strong=“H3738” x-morph=“strongMorph: \sc Th\sc*8804”} \w a pit| strong="H7882" \w* \w before| strong="H6440" \w* [me, into the midst]{strong=“H8432”} [whereof they are fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} themselves. \w Selah| strong="H5542" \w*. 
\v 7 \w My heart| strong="H3820" \w* [is fixed]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8737”}, \w O God| strong="H430" \w*, \w my heart| strong="H3820" \w* [is fixed]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8737”}: [I will sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8799”} [and give praise]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8762”}.\f + \fr 57:7 \ft fixed: or, prepared \f* 
\v 8 [Awake up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8798”}, \w my glory| strong="H3519" \w*; [awake]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8798”}, \w psaltery| strong="H5035" \w* \w and harp| strong="H3658" \w*: I myself [will awake]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8686”} \w early| strong="H7837" \w*. 
\v 9 [I will praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} [thee, O Lord]{strong=“H136”}, \w among the people| strong="H5971" \w*: [I will sing]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto thee among the nations| strong="H3816" \w*. 
\v 10 \w For thy mercy| strong="H2617" \w* is \w great| strong="H1419" \w* \w unto the heavens| strong="H8064" \w*, \w and thy truth| strong="H571" \w* \w unto the clouds| strong="H7834" \w*. 
\v 11 [Be thou exalted]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O God| strong="H430" \w*, \w above the heavens| strong="H8064" \w*: let \w thy glory| strong="H3519" \w* be \w above all the earth| strong="H776" \w*.
\c 58
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, [Al-taschith]{strong=“H516” x-morph=“strongMorph: \sc Th\sc*8686”}, \w Michtam| strong="H4387" \w* \w of David| strong="H1732" \w*. 
\v 1 \w Do ye indeed| strong="H552" \w* [speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w righteousness| strong="H6664" \w*, \w O congregation| strong="H482" \w*? [do ye judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w uprightly| strong="H4339" \w*, \w O ye sons| strong="H1121" \w* \w of men| strong="H120" \w*?\f + \fr 58:1 \ft Al-taschith…: or, Destroy not \f* \f + \fr 58:1 \ft Michtam: or, A golden Psalm \f* 
\v 2 [Yea, in heart]{strong=“H3820”} [ye work]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8799”} \w wickedness| strong="H5766" \w*; [ye weigh]{strong=“H6424” x-morph=“strongMorph: \sc Th\sc*8762”} \w the violence| strong="H2555" \w* \w of your hands| strong="H3027" \w* \w in the earth| strong="H776" \w*. 
\v 3 \w The wicked| strong="H7563" \w* [are estranged]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8804”} \w from the womb| strong="H7358" \w*: [they go astray]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8804”} \w as soon as they be born| strong="H990" \w*, [speaking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} \w lies| strong="H3577" \w*.\f + \fr 58:3 \ft as soon…: Heb. from the belly \f* 
\v 4 \w Their poison| strong="H2534" \w* is \w like| strong="H1823" \w* \w the poison| strong="H2534" \w* \w of a serpent| strong="H5175" \w*: they are \w like the deaf| strong="H2795" \w* \w adder| strong="H6620" \w* that [stoppeth]{strong=“H331” x-morph=“strongMorph: \sc Th\sc*8686”} \w her ear| strong="H241" \w*;\f + \fr 58:4 \ft like the poison: Heb. according to the likeness, etc \f* \f + \fr 58:4 \ft adder: or, asp \f* 
\v 5 [Which will not hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the voice| strong="H6963" \w* [of charmers]{strong=“H3907” x-morph=“strongMorph: \sc Th\sc*8764”}, [charming]{strong=“H2267 H2266” x-morph=“strongMorph: \sc Th\sc*8802”} [never so wisely]{strong=“H2449” x-morph=“strongMorph: \sc Th\sc*8794”}.\f + \fr 58:5 \ft charming…: or, be the charmer never so cunning \f* 
\v 6 [Break]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8798”} \w their teeth| strong="H8127" \w*, \w O God| strong="H430" \w*, \w in their mouth| strong="H6310" \w*: [break out]{strong=“H5422” x-morph=“strongMorph: \sc Th\sc*8800”} \w the great teeth| strong="H4459" \w* \w of the young lions| strong="H3715" \w*, O \sc Lord\sc*. 
\v 7 [Let them melt away]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8735”} \w as waters| strong="H4325" \w* which [run continually]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8691”}: when [he bendeth]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8799”} his bow to shoot \w his arrows| strong="H2671" \w*, [let them be as cut in pieces]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8709”}. 
\v 8 \w As a snail| strong="H7642" \w* which \w melteth| strong="H8557" \w*, let every one of them [pass away]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8799”}: like \w the untimely birth| strong="H5309" \w* \w of a woman| strong="H802" \w*, that [they may not see]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8804”} \w the sun| strong="H8121" \w*. 
\v 9 \w Before your pots| strong="H5518" \w* [can feel]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} \w the thorns| strong="H329" \w*, [he shall take them away as with a whirlwind]{strong=“H8175” x-morph=“strongMorph: \sc Th\sc*8799”}, \w both living| strong="H2416" \w*, and in his \w wrath| strong="H2740" \w*.\f + \fr 58:9 \ft both…: Heb. as living as wrath \f* 
\v 10 \w The righteous| strong="H6662" \w* [shall rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} [when he seeth]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8804”} \w the vengeance| strong="H5359" \w*: [he shall wash]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8799”} \w his feet| strong="H6471" \w* \w in the blood| strong="H1818" \w* \w of the wicked| strong="H7563" \w*. 
\v 11 \w So that a man| strong="H120" \w* [shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Verily there is \w a reward| strong="H6529" \w* \w for the righteous| strong="H6662" \w*: \w verily he is| strong="H3426" \w* \w a God| strong="H430" \w* [that judgeth]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the earth| strong="H776" \w*.\f + \fr 58:11 \ft a reward…: Heb. fruit of the, etc \f*
\c 59
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, [Al-taschith]{strong=“H516” x-morph=“strongMorph: \sc Th\sc*8686”}, \w Michtam| strong="H4387" \w* \w of David| strong="H1732" \w*; \w when Saul| strong="H7586" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8800”}, [and they watched]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w the house| strong="H1004" \w* [to kill him]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8687”}. 
\v 1 [Deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} [me from mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, \w O my God| strong="H430" \w*: [defend]{strong=“H7682” x-morph=“strongMorph: \sc Th\sc*8762”} [me from them that rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8693”} against me.\f + \fr 59:1 \ft Al-taschith…: or, Destroy not \f* \f + \fr 59:1 \ft Michtam: or, A golden Psalm \f* \f + \fr 59:1 \ft defend…: Heb. set me on high \f* 
\v 2 [Deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} [me from the workers]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w of iniquity| strong="H205" \w*, [and save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”} \w me from bloody| strong="H1818" \w* \w men| strong="H582" \w*. 
\v 3 [For, lo, they lie in wait]{strong=“H693” x-morph=“strongMorph: \sc Th\sc*8804”} \w for my soul| strong="H5315" \w*: \w the mighty| strong="H5794" \w* [are gathered]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”} against me; not for \w my transgression| strong="H6588" \w*, nor for \w my sin| strong="H2403" \w*, O \sc Lord\sc*. 
\v 4 [They run]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”} [and prepare]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8709”} themselves without my \w fault| strong="H5771" \w*: [awake]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8798”} [to help]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} [me, and behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}.\f + \fr 59:4 \ft help: Heb. meet \f* 
\v 5 Thou therefore, O \sc Lord\sc* \w God| strong="H430" \w* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*, [awake]{strong=“H6974” x-morph=“strongMorph: \sc Th\sc*8685”} [to visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8800”} \w all the heathen| strong="H1471" \w*: [be not merciful]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8799”} \w to any wicked| strong="H205" \w* [transgressors]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”}. \w Selah| strong="H5542" \w*. 
\v 6 [They return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w at evening| strong="H6153" \w*: [they make a noise]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8799”} \w like a dog| strong="H3611" \w*, [and go round about]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8779”} \w the city| strong="H5892" \w*. 
\v 7 [Behold, they belch out]{strong=“H5042” x-morph=“strongMorph: \sc Th\sc*8686”} \w with their mouth| strong="H6310" \w*: \w swords| strong="H2719" \w* are \w in their lips| strong="H8193" \w*: for who, say they, [doth hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”}? 
\v 8 But thou, O \sc Lord\sc*, [shalt laugh]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8799”} [at them; thou shalt have all the heathen]{strong=“H1471”} [in derision]{strong=“H3932” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 9 Because of \w his strength| strong="H5797" \w* [will I wait]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} [upon thee: for God]{strong=“H430”} is \w my defence| strong="H4869" \w*.\f + \fr 59:9 \ft defence: Heb. high place \f* 
\v 10 \w The God| strong="H430" \w* \w of my mercy| strong="H2617" \w* [shall prevent]{strong=“H6923” x-morph=“strongMorph: \sc Th\sc*8762”} [me: God]{strong=“H430”} [shall let me see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8686”} my desire [upon mine enemies]{strong=“H8324” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 59:10 \ft enemies: Heb. observers \f* 
\v 11 [Slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} [them not, lest my people]{strong=“H5971”} [forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”}: [scatter]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8685”} \w them by thy power| strong="H2428" \w*; [and bring them down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8685”}, \w O Lord| strong="H136" \w* \w our shield| strong="H4043" \w*. 
\v 12 For \w the sin| strong="H2403" \w* \w of their mouth| strong="H6310" \w* and \w the words| strong="H1697" \w* \w of their lips| strong="H8193" \w* [let them even be taken]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8735”} \w in their pride| strong="H1347" \w*: \w and for cursing| strong="H423" \w* \w and lying| strong="H3585" \w* which [they speak]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 13 [Consume]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8761”} them \w in wrath| strong="H2534" \w*, [consume]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8761”} them, that they may not be: [and let them know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w that God| strong="H430" \w* [ruleth]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8802”} \w in Jacob| strong="H3290" \w* \w unto the ends| strong="H657" \w* \w of the earth| strong="H776" \w*. \w Selah| strong="H5542" \w*. 
\v 14 \w And at evening| strong="H6153" \w* [let them return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}; and [let them make a noise]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8799”} \w like a dog| strong="H3611" \w*, [and go round about]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8779”} \w the city| strong="H5892" \w*. 
\v 15 [Let them wander up and down]{strong=“H5128 H5128” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8686”} [for meat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”}, [and grudge]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} [if they be not satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 59:15 \ft for meat: Heb. to eat \f* \f + \fr 59:15 \ft and grudge…: or, if they be not satisfied, then they will stay all night \f* 
\v 16 [But I will sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8799”} \w of thy power| strong="H5797" \w*; [yea, I will sing aloud]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8762”} \w of thy mercy| strong="H2617" \w* \w in the morning| strong="H1242" \w*: \w for thou hast been my defence| strong="H4869" \w* \w and refuge| strong="H4498" \w* \w in the day| strong="H3117" \w* \w of my trouble| strong="H6862" \w*. 
\v 17 [Unto thee, O my strength]{strong=“H5797”}, [will I sing]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8762”}: \w for God| strong="H430" \w* is \w my defence| strong="H4869" \w*, and \w the God| strong="H430" \w* \w of my mercy| strong="H2617" \w*.
\c 60
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} [upon Shushan-eduth]{strong=“H7802”}, \w Michtam| strong="H4387" \w* \w of David| strong="H1732" \w*, [to teach]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8763”}; [when he strove]{strong=“H5327” x-morph=“strongMorph: \sc Th\sc*8687”} [with Aram-naharaim]{strong=“H5104 H763”} [and with Aram-zobah]{strong=“H760”}, \w when Joab| strong="H3097" \w* [returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [and smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w of Edom| strong="H123" \w* \w in the valley| strong="H1516" \w* \w of salt| strong="H4417" \w* [twelve]{strong=“H6240 H8147”} \w thousand| strong="H505" \w*. 
\v 1 \w O God| strong="H430" \w*, [thou hast cast us off]{strong=“H2186” x-morph=“strongMorph: \sc Th\sc*8804”}, [thou hast scattered]{strong=“H6555” x-morph=“strongMorph: \sc Th\sc*8804”} [us, thou hast been displeased]{strong=“H599” x-morph=“strongMorph: \sc Th\sc*8804”}; [O turn thyself to us again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8787”}.\f + \fr 60:1 \ft Michtam: or, A golden Psalm \f* \f + \fr 60:1 \ft scattered: Heb. broken \f* 
\v 2 \w Thou hast made the earth| strong="H776" \w* [to tremble]{strong=“H7493” x-morph=“strongMorph: \sc Th\sc*8689”}; [thou hast broken]{strong=“H6480” x-morph=“strongMorph: \sc Th\sc*8804”} [it: heal]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8798”} \w the breaches| strong="H7667" \w* [thereof; for it shaketh]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 3 [Thou hast shewed]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy people| strong="H5971" \w* \w hard things| strong="H7186" \w*: [thou hast made us to drink]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8689”} \w the wine| strong="H3196" \w* \w of astonishment| strong="H8653" \w*. 
\v 4 [Thou hast given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w a banner| strong="H5251" \w* \w to them that fear| strong="H3373" \w* [thee, that it may be displayed]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8710”} \w because| strong="H6440" \w* \w of the truth| strong="H7189" \w*. \w Selah| strong="H5542" \w*. 
\v 5 \w That thy beloved| strong="H3039" \w* [may be delivered]{strong=“H2502” x-morph=“strongMorph: \sc Th\sc*8735”}; [save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”} with \w thy right hand| strong="H3225" \w*, [and hear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8798”} me. 
\v 6 \w God| strong="H430" \w* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w in his holiness| strong="H6944" \w*; [I will rejoice]{strong=“H5937” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will divide]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8762”} \w Shechem| strong="H7927" \w*, [and mete out]{strong=“H4058” x-morph=“strongMorph: \sc Th\sc*8762”} \w the valley| strong="H6010" \w* \w of Succoth| strong="H5523" \w*. 
\v 7 \w Gilead| strong="H1568" \w* is [mine, and Manasseh]{strong=“H4519”} is [mine; Ephraim]{strong=“H669”} also is \w the strength| strong="H4581" \w* \w of mine head| strong="H7218" \w*; \w Judah| strong="H3063" \w* is [my lawgiver]{strong=“H2710” x-morph=“strongMorph: \sc Th\sc*8781”}; 
\v 8 \w Moab| strong="H4124" \w* is [my washpot]{strong=“H7366 H5518”}; \w over Edom| strong="H123" \w* [will I cast out]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w my shoe| strong="H5275" \w*: \w Philistia| strong="H6429" \w*, [triumph]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8708”} thou because of me.\f + \fr 60:8 \ft triumph…: or, triumph thou over me: (by an irony) \f* 
\v 9 [Who will bring]{strong=“H2986” x-morph=“strongMorph: \sc Th\sc*8686”} me into \w the strong| strong="H4692" \w* \w city| strong="H5892" \w*? [who will lead]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8804”} \w me into Edom| strong="H123" \w*?\f + \fr 60:9 \ft strong…: Heb. city of strength? \f* 
\v 10 Wilt [not thou, O God]{strong=“H430”}, which [hadst cast us off]{strong=“H2186” x-morph=“strongMorph: \sc Th\sc*8804”}? and thou, \w O God| strong="H430" \w*, which [didst not go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w with our armies| strong="H6635" \w*? 
\v 11 [Give]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”} \w us help| strong="H5833" \w* \w from trouble| strong="H6862" \w*: \w for vain| strong="H7723" \w* is \w the help| strong="H8668" \w* \w of man| strong="H120" \w*.\f + \fr 60:11 \ft help of man: Heb. salvation, etc \f* 
\v 12 \w Through God| strong="H430" \w* [we shall do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w valiantly| strong="H2428" \w*: for he it is that [shall tread down]{strong=“H947” x-morph=“strongMorph: \sc Th\sc*8799”} \w our enemies| strong="H6862" \w*.
\c 61
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} \w upon Neginah| strong="H5058" \w*, A Psalm \w of David| strong="H1732" \w*. 
\v 1 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w my cry| strong="H7440" \w*, \w O God| strong="H430" \w*; [attend]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto my prayer| strong="H8605" \w*. 
\v 2 \w From the end| strong="H7097" \w* \w of the earth| strong="H776" \w* [will I cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee, when my heart]{strong=“H3820”} [is overwhelmed]{strong=“H5848” x-morph=“strongMorph: \sc Th\sc*8800”}: [lead]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8686”} \w me to the rock| strong="H6697" \w* that [is higher]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8799”} than I. 
\v 3 \w For thou hast been a shelter| strong="H4268" \w* for me, and \w a strong| strong="H5797" \w* \w tower| strong="H4026" \w* \w from| strong="H6440" \w* [the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 4 [I will abide]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy tabernacle| strong="H168" \w* \w for ever| strong="H5769" \w*: [I will trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the covert| strong="H5643" \w* \w of thy wings| strong="H3671" \w*. \w Selah| strong="H5542" \w*.\f + \fr 61:4 \ft trust: or, make my refuge \f* 
\v 5 [For thou, O God]{strong=“H430”}, [hast heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w my vows| strong="H5088" \w*: [thou hast given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} me \w the heritage| strong="H3425" \w* \w of those that fear| strong="H3373" \w* \w thy name| strong="H8034" \w*. 
\v 6 [Thou wilt prolong]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [the king’s]{strong=“H4428”} [life]{strong=“H3117 H3117”}: and \w his years| strong="H8141" \w* \w as many| strong="H1755" \w* \w generations| strong="H1755" \w*.\f + \fr 61:6 \ft Thou…: Heb. Thou shalt add days to the days of the king \f* \f + \fr 61:6 \ft as…: Heb. as generation and generation \f* 
\v 7 [He shall abide]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* \w God| strong="H430" \w* \w for ever| strong="H5769" \w*: [O prepare]{strong=“H4487” x-morph=“strongMorph: \sc Th\sc*8761”} \w mercy| strong="H2617" \w* \w and truth| strong="H571" \w*, which [may preserve]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8799”} him. 
\v 8 [So will I sing]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8762”} \w praise unto thy name| strong="H8034" \w* \w for ever| strong="H5703" \w*, [that I may daily]{strong=“H3117 H3117”} [perform]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8763”} \w my vows| strong="H5088" \w*.
\c 62
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w to Jeduthun| strong="H3038" \w*, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 \w Truly my soul| strong="H5315" \w* \w waiteth| strong="H1747" \w* \w upon God| strong="H430" \w*: from him cometh \w my salvation| strong="H3444" \w*.\f + \fr 62:1 \ft Truly: or, Only \f* \f + \fr 62:1 \ft waiteth: Heb. is silent \f* 
\v 2 He only is \w my rock| strong="H6697" \w* \w and my salvation| strong="H3444" \w*; he is \w my defence| strong="H4869" \w*; \w I shall not be greatly| strong="H7227" \w* [moved]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 62:2 \ft defence: Heb. high place \f* 
\v 3 [How long will ye imagine mischief]{strong=“H2050” x-morph=“strongMorph: \sc Th\sc*8779”} \w against a man| strong="H376" \w*? [ye shall be slain]{strong=“H7523” x-morph=“strongMorph: \sc Th\sc*8792”} [all of you: as a bowing]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8803”} \w wall| strong="H7023" \w* shall ye be, and as [a tottering]{strong=“H1760” x-morph=“strongMorph: \sc Th\sc*8803”} \w fence| strong="H1447" \w*. 
\v 4 [They only consult]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8804”} to cast him [down]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8687”} \w from his excellency| strong="H7613" \w*: [they delight]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8799”} \w in lies| strong="H3577" \w*: [they bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w with their mouth| strong="H6310" \w*, [but they curse]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8762”} \w inwardly| strong="H7130" \w*. \w Selah| strong="H5542" \w*.\f + \fr 62:4 \ft inwardly: Heb. in their inward parts \f* 
\v 5 \w My soul| strong="H5315" \w*, [wait]{strong=“H1826” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou only upon God| strong="H430" \w*; \w for my expectation| strong="H8615" \w* is from him. 
\v 6 He only is \w my rock| strong="H6697" \w* \w and my salvation| strong="H3444" \w*: he is \w my defence| strong="H4869" \w*; [I shall not be moved]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 7 \w In God| strong="H430" \w* is \w my salvation| strong="H3468" \w* \w and my glory| strong="H3519" \w*: \w the rock| strong="H6697" \w* \w of my strength| strong="H5797" \w*, and \w my refuge| strong="H4268" \w*, is \w in God| strong="H430" \w*. 
\v 8 [Trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8798”} \w in him at all times| strong="H6256" \w*; ye \w people| strong="H5971" \w*, [pour out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8798”} \w your heart| strong="H3824" \w* \w before| strong="H6440" \w* [him: God]{strong=“H430”} is \w a refuge| strong="H4268" \w* [for us. Selah]{strong=“H5542”}. 
\v 9 [Surely men]{strong=“H1121 H120”} of low degree are \w vanity| strong="H1892" \w*, and \w men| strong="H376" \w* of high degree are \w a lie| strong="H3577" \w*: [to be laid]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the balance| strong="H3976" \w*, they are \w altogether| strong="H3162" \w* lighter \w than vanity| strong="H1892" \w*.\f + \fr 62:9 \ft altogether: or, alike \f* 
\v 10 [Trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} \w not in oppression| strong="H6233" \w*, [and become not vain]{strong=“H1891” x-morph=“strongMorph: \sc Th\sc*8799”} \w in robbery| strong="H1498" \w*: \w if riches| strong="H2428" \w* [increase]{strong=“H5107” x-morph=“strongMorph: \sc Th\sc*8799”}, [set]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w not your heart| strong="H3820" \w* upon them. 
\v 11 \w God| strong="H430" \w* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w once| strong="H259" \w*; \w twice| strong="H8147" \w* [have I heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w this| strong="H2098" \w*; \w that power| strong="H5797" \w* belongeth \w unto God| strong="H430" \w*.\f + \fr 62:11 \ft power: or, strength \f* 
\v 12 [Also unto thee, O Lord]{strong=“H136”}, belongeth \w mercy| strong="H2617" \w*: [for thou renderest]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w to every man| strong="H376" \w* \w according to his work| strong="H4639" \w*.
\c 63
\p 
\w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*, \w when he was in the wilderness| strong="H4057" \w* \w of Judah| strong="H3063" \w*. 
\v 1 \w O God| strong="H430" \w*, thou art \w my God| strong="H410" \w*; [early will I seek]{strong=“H7836” x-morph=“strongMorph: \sc Th\sc*8762”} [thee: my soul]{strong=“H5315”} [thirsteth ]{strong=“H6770” x-morph=“strongMorph: \sc Th\sc*8804”} [for thee, my flesh]{strong=“H1320”} [longeth ]{strong=“H3642” x-morph=“strongMorph: \sc Th\sc*8804”} \w for thee in a dry| strong="H6723" \w* \w and thirsty| strong="H5889" \w* \w land| strong="H776" \w*, \w where no| strong="H1097" \w* \w water| strong="H4325" \w* is;\f + \fr 63:1 \ft thirsty: Heb. weary \f* \f + \fr 63:1 \ft where…: without water \f* 
\v 2 [To see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy power| strong="H5797" \w* \w and thy glory| strong="H3519" \w*, so as [I have seen]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee in the sanctuary| strong="H6944" \w*. 
\v 3 \w Because thy lovingkindness| strong="H2617" \w* is \w better| strong="H2896" \w* \w than life| strong="H2416" \w*, \w my lips| strong="H8193" \w* [shall praise]{strong=“H7623” x-morph=“strongMorph: \sc Th\sc*8762”} thee. 
\v 4 [Thus will I bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w thee while I live| strong="H2416" \w*: [I will lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w my hands| strong="H3709" \w* \w in thy name| strong="H8034" \w*. 
\v 5 \w My soul| strong="H5315" \w* [shall be satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”} as with \w marrow| strong="H2459" \w* \w and fatness| strong="H1880" \w*; \w and my mouth| strong="H6310" \w* [shall praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} thee \w with joyful| strong="H7445" \w* \w lips| strong="H8193" \w*:\f + \fr 63:5 \ft marrow: Heb. fatness \f* 
\v 6 [When I remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee upon my bed| strong="H3326" \w*, and [meditate]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8799”} on thee in the night \w watches| strong="H821" \w*. 
\v 7 \w Because thou hast been my help| strong="H5833" \w*, \w therefore in the shadow| strong="H6738" \w* \w of thy wings| strong="H3671" \w* [will I rejoice]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 8 \w My soul| strong="H5315" \w* [followeth hard]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8804”} \w after| strong="H310" \w* [thee: thy right hand]{strong=“H3225”} [upholdeth]{strong=“H8551” x-morph=“strongMorph: \sc Th\sc*8804”} me. 
\v 9 But those that [seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w my soul| strong="H5315" \w*, \w to destroy| strong="H7722" \w* it, [shall go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the lower parts| strong="H8482" \w* \w of the earth| strong="H776" \w*. 
\v 10 [They shall fall]{strong=“H5064” x-morph=“strongMorph: \sc Th\sc*8686”} [by the sword]{strong=“H2719 H3027”}: \w they shall be a portion| strong="H4521" \w* \w for foxes| strong="H7776" \w*.\f + \fr 63:10 \ft They shall fall…: Heb. They shall make him run out like water by the hands of \f* 
\v 11 \w But the king| strong="H4428" \w* [shall rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} \w in God| strong="H430" \w*; [every one that sweareth]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8737”} [by him shall glory]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8691”}: \w but the mouth| strong="H6310" \w* [of them that speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} \w lies| strong="H8267" \w* [shall be stopped]{strong=“H5534” x-morph=“strongMorph: \sc Th\sc*8735”}.
\c 64
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w my voice| strong="H6963" \w*, \w O God| strong="H430" \w*, \w in my prayer| strong="H7879" \w*: [preserve ]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8799”} \w my life| strong="H2416" \w* \w from fear| strong="H6343" \w* [of the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 2 [Hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8686”} \w me from the secret counsel| strong="H5475" \w* [of the wicked]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8688”}; \w from the insurrection| strong="H7285" \w* [of the workers]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w of iniquity| strong="H205" \w*: 
\v 3 [Who whet]{strong=“H8150” x-morph=“strongMorph: \sc Th\sc*8804”} \w their tongue| strong="H3956" \w* \w like a sword| strong="H2719" \w*, and [bend]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8804”} their bows to shoot \w their arrows| strong="H2671" \w*, even \w bitter| strong="H4751" \w* \w words| strong="H1697" \w*: 
\v 4 [That they may shoot]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8800”} \w in secret| strong="H4565" \w* \w at the perfect| strong="H8535" \w*: \w suddenly| strong="H6597" \w* [do they shoot]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”} [at him, and fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} not. 
\v 5 [They encourage]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8762”} themselves in \w an evil| strong="H7451" \w* \w matter| strong="H1697" \w*: [they commune]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} \w of laying| strong="H2934" \w* \w snares| strong="H4170" \w* [privily]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8800”}; [they say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Who shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} them?\f + \fr 64:5 \ft matter: or, speech \f* \f + \fr 64:5 \ft of…: Heb. to hide his snares \f* 
\v 6 [They search out]{strong=“H2664” x-morph=“strongMorph: \sc Th\sc*8799”} \w iniquities| strong="H5766" \w*; [they accomplish]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8804”} [a diligent]{strong=“H2664” x-morph=“strongMorph: \sc Th\sc*8794”} \w search| strong="H2665" \w*: \w both the inward| strong="H7130" \w* thought \w of every one| strong="H376" \w* of them, \w and the heart| strong="H3820" \w*, is \w deep| strong="H6013" \w*.\f + \fr 64:6 \ft they…: or, we are consumed by that which they have throughly searched \f* \f + \fr 64:6 \ft a diligent…: Heb. a search searched \f* 
\v 7 \w But God| strong="H430" \w* [shall shoot]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”} at them with \w an arrow| strong="H2671" \w*; \w suddenly| strong="H6597" \w* \w shall they be wounded| strong="H4347" \w*.\f + \fr 64:7 \ft shall they…: Heb. their wound shall be \f* 
\v 8 \w So they shall make their own tongue| strong="H3956" \w* [to fall]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8686”} [upon themselves: all that see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} [them shall flee away]{strong=“H5074” x-morph=“strongMorph: \sc Th\sc*8709”}. 
\v 9 \w And all men| strong="H120" \w* [shall fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}, [and shall declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w the work| strong="H6467" \w* \w of God| strong="H430" \w*; [for they shall wisely consider]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8689”} \w of his doing| strong="H4639" \w*. 
\v 10 \w The righteous| strong="H6662" \w* [shall be glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} in the \sc Lord\sc*, [and shall trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8804”} [in him; and all the upright]{strong=“H3477”} \w in heart| strong="H3820" \w* [shall glory]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8691”}.
\c 65
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w A Psalm| strong="H4210" \w* and \w Song| strong="H7892" \w* \w of David| strong="H1732" \w*. 
\v 1 \w Praise| strong="H8416" \w* \w waiteth| strong="H1747" \w* [for thee, O God]{strong=“H430”}, \w in Sion| strong="H6726" \w*: \w and unto thee shall the vow| strong="H5088" \w* [be performed]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8792”}.\f + \fr 65:1 \ft waiteth: Heb. is silent \f* 
\v 2 [O thou that hearest]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} \w prayer| strong="H8605" \w*, \w unto thee shall all flesh| strong="H1320" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 3 [Iniquities]{strong=“H5771 H1697”} [prevail]{strong=“H1396” x-morph=“strongMorph: \sc Th\sc*8804”} against me: as for \w our transgressions| strong="H6588" \w*, [thou shalt purge them away]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8762”}.\f + \fr 65:3 \ft Iniquities: Heb. Words, or, Matters of iniquities \f* 
\v 4 \w Blessed| strong="H835" \w* is the man whom [thou choosest]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”}, [and causest to approach]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8762”} unto thee, that [he may dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy courts| strong="H2691" \w*: [we shall be satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the goodness| strong="H2898" \w* \w of thy house| strong="H1004" \w*, even \w of thy holy| strong="H6918" \w* \w temple| strong="H1964" \w*. 
\v 5 By [terrible things]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”} \w in righteousness| strong="H6664" \w* [wilt thou answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [us, O God]{strong=“H430”} \w of our salvation| strong="H3468" \w*; who art \w the confidence| strong="H4009" \w* \w of all the ends| strong="H7099" \w* \w of the earth| strong="H776" \w*, \w and of them that are afar off| strong="H7350" \w* upon \w the sea| strong="H3220" \w*: 
\v 6 \w Which by his strength| strong="H3581" \w* [setteth fast]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8688”} \w the mountains| strong="H2022" \w*; being [girded]{strong=“H247” x-morph=“strongMorph: \sc Th\sc*8737”} \w with power| strong="H1369" \w*: 
\v 7 [Which stilleth]{strong=“H7623” x-morph=“strongMorph: \sc Th\sc*8688”} \w the noise| strong="H7588" \w* \w of the seas| strong="H3220" \w*, \w the noise| strong="H7588" \w* \w of their waves| strong="H1530" \w*, \w and the tumult| strong="H1995" \w* \w of the people| strong="H3816" \w*. 
\v 8 [They also that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the uttermost parts| strong="H7099" \w* [are afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w at thy tokens| strong="H226" \w*: \w thou makest the outgoings| strong="H4161" \w* \w of the morning| strong="H1242" \w* \w and evening| strong="H6153" \w* [to rejoice]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8686”}.\f + \fr 65:8 \ft rejoice: or, sing \f* 
\v 9 [Thou visitest]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} \w the earth| strong="H776" \w*, [and waterest]{strong=“H7783” x-morph=“strongMorph: \sc Th\sc*8787”} [it: thou greatly]{strong=“H7227”} [enrichest]{strong=“H6238” x-morph=“strongMorph: \sc Th\sc*8686”} \w it with the river| strong="H6388" \w* \w of God| strong="H430" \w*, which [is full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of water| strong="H4325" \w*: [thou preparest]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8686”} \w them corn| strong="H1715" \w*, [when thou hast so provided]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8686”} for it.\f + \fr 65:9 \ft and…: or, after thou hadst made it to desire rain \f* 
\v 10 \w Thou waterest| strong="H7301" \w* \w the ridges| strong="H8525" \w* [thereof abundantly]{strong=“H7301” x-morph=“strongMorph: \sc Th\sc*8761”}: [thou settlest]{strong=“H5181” x-morph=“strongMorph: \sc Th\sc*8763”} [the furrows]{strong=“H1418 H1417” x-morph=“strongMorph: \sc Th\sc*8676”} [thereof: thou makest it soft]{strong=“H4127” x-morph=“strongMorph: \sc Th\sc*8787”} \w with showers| strong="H7241" \w*: [thou blessest]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w the springing| strong="H6780" \w* thereof.\f + \fr 65:10 \ft settlest: or, causest rain to descend into \f* \f + \fr 65:10 \ft makest…: Heb. dissolvest it \f* 
\v 11 [Thou crownest]{strong=“H5849” x-morph=“strongMorph: \sc Th\sc*8765”} \w the year| strong="H8141" \w* \w with thy goodness| strong="H2896" \w*; \w and thy paths| strong="H4570" \w* [drop]{strong=“H7491” x-morph=“strongMorph: \sc Th\sc*8799”} \w fatness| strong="H1880" \w*.\f + \fr 65:11 \ft with: Heb. of \f* 
\v 12 [They drop]{strong=“H7491” x-morph=“strongMorph: \sc Th\sc*8799”} upon \w the pastures| strong="H4999" \w* \w of the wilderness| strong="H4057" \w*: \w and the little hills| strong="H1389" \w* \w rejoice| strong="H1524" \w* [on every side]{strong=“H2296” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 65:12 \ft rejoice…: Heb. are girded with joy \f* 
\v 13 \w The pastures| strong="H3733" \w* [are clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8804”} \w with flocks| strong="H6629" \w*; \w the valleys| strong="H6010" \w* [also are covered over]{strong=“H5848” x-morph=“strongMorph: \sc Th\sc*8799”} \w with corn| strong="H1250" \w*; [they shout for joy]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8709”}, [they also sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8799”}.
\c 66
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w A Song| strong="H7892" \w* or \w Psalm| strong="H4210" \w*. 
\v 1 [Make a joyful noise]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto God| strong="H430" \w*, \w all ye lands| strong="H776" \w*:\f + \fr 66:1 \ft all…: Heb. all the earth \f* 
\v 2 [Sing forth]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8761”} \w the honour| strong="H3519" \w* \w of his name| strong="H8034" \w*: [make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} \w his praise| strong="H8416" \w* \w glorious| strong="H3519" \w*. 
\v 3 [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto God| strong="H430" \w*, [How terrible]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”} art thou in \w thy works| strong="H4639" \w*! \w through the greatness| strong="H7230" \w* \w of thy power| strong="H5797" \w* [shall thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [submit]{strong=“H3584” x-morph=“strongMorph: \sc Th\sc*8762”} themselves unto thee.\f + \fr 66:3 \ft submit…: or, yield feigned obedience: Heb. lie \f* 
\v 4 \w All the earth| strong="H776" \w* [shall worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} [thee, and shall sing]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8762”} [unto thee; they shall sing]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8762”} to \w thy name| strong="H8034" \w*. \w Selah| strong="H5542" \w*. 
\v 5 [Come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w the works| strong="H4659" \w* \w of God| strong="H430" \w*: he is [terrible]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”} in his \w doing| strong="H5949" \w* \w toward the children| strong="H1121" \w* \w of men| strong="H120" \w*. 
\v 6 [He turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8804”} \w the sea| strong="H3220" \w* \w into dry| strong="H3004" \w* land: [they went]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w through the flood| strong="H5104" \w* \w on foot| strong="H7272" \w*: [there did we rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} in him. 
\v 7 [He ruleth]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8802”} \w by his power| strong="H1369" \w* \w for ever| strong="H5769" \w*; \w his eyes| strong="H5869" \w* [behold]{strong=“H6822” x-morph=“strongMorph: \sc Th\sc*8799”} \w the nations| strong="H1471" \w*: [let not the rebellious]{strong=“H5637” x-morph=“strongMorph: \sc Th\sc*8802”} [exalt ]{strong=“H7311 H7311” x-morph=“strongMorph: \sc Th\sc*8686 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8799”} [themselves. Selah]{strong=“H5542”}. 
\v 8 [O bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} \w our God| strong="H430" \w*, \w ye people| strong="H5971" \w*, \w and make the voice| strong="H6963" \w* \w of his praise| strong="H8416" \w* [to be heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8685”}: 
\v 9 [Which holdeth]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8802”} \w our soul| strong="H5315" \w* \w in life| strong="H2416" \w*, [and suffereth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w not our feet| strong="H7272" \w* \w to be moved| strong="H4132" \w*.\f + \fr 66:9 \ft holdeth: Heb. putteth \f* 
\v 10 [For thou, O God]{strong=“H430”}, [hast proved]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8804”} [us: thou hast tried]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8804”} [us, as silver]{strong=“H3701”} [is tried]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 11 [Thou broughtest]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w us into the net| strong="H4686" \w*; [thou laidst]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w affliction| strong="H4157" \w* \w upon our loins| strong="H4975" \w*. 
\v 12 \w Thou hast caused men| strong="H582" \w* [to ride]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8689”} \w over our heads| strong="H7218" \w*; [we went]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w through fire| strong="H784" \w* \w and through water| strong="H4325" \w*: [but thou broughtest us out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w into a wealthy| strong="H7310" \w* place.\f + \fr 66:12 \ft wealthy: Heb. moist \f* 
\v 13 [I will go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into thy house| strong="H1004" \w* \w with burnt offerings| strong="H5930" \w*: [I will pay]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w thee my vows| strong="H5088" \w*, 
\v 14 \w Which my lips| strong="H8193" \w* [have uttered]{strong=“H6475” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and my mouth| strong="H6310" \w* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}, \w when I was in trouble| strong="H6862" \w*.\f + \fr 66:14 \ft uttered: Heb. opened \f* 
\v 15 [I will offer]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto thee burnt sacrifices| strong="H5930" \w* \w of fatlings| strong="H4220" \w*, \w with the incense| strong="H7004" \w* \w of rams| strong="H352" \w*; [I will offer]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w bullocks| strong="H1241" \w* \w with goats| strong="H6260" \w*. \w Selah| strong="H5542" \w*.\f + \fr 66:15 \ft fatlings: Heb. marrow \f* 
\v 16 [Come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} and [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, \w all ye that fear| strong="H3373" \w* \w God| strong="H430" \w*, [and I will declare]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} [what he hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w for my soul| strong="H5315" \w*. 
\v 17 [I cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto him with my mouth| strong="H6310" \w*, [and he was extolled]{strong=“H7318 H7311” x-morph=“strongMorph: \sc Th\sc*8785 strongMorph: \sc Th\sc*8676 strongMorph: \sc Th\sc*8785”} \w with| strong="H8478" \w* \w my tongue| strong="H3956" \w*. 
\v 18 [If I regard]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w iniquity| strong="H205" \w* \w in my heart| strong="H3820" \w*, \w the Lord| strong="H136" \w* [will not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} me: 
\v 19 But \w verily| strong="H403" \w* \w God| strong="H430" \w* [hath heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} me; [he hath attended]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8689”} \w to the voice| strong="H6963" \w* \w of my prayer| strong="H8605" \w*. 
\v 20 [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} be \w God| strong="H430" \w*, [which hath not turned away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8689”} \w my prayer| strong="H8605" \w*, \w nor his mercy| strong="H2617" \w* from me.
\c 67
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} \w on Neginoth| strong="H5058" \w*, \w A Psalm| strong="H4210" \w* or \w Song| strong="H7892" \w*. 
\v 1 \w God| strong="H430" \w* [be merciful]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8799”} [unto us, and bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} us; and \w cause his face| strong="H6440" \w* [to shine]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8686”} [upon us; Selah]{strong=“H5542”}.\f + \fr 67:1 \ft chief…: or, overseer \f* \f + \fr 67:1 \ft upon: Heb. with \f* 
\v 2 \w That thy way| strong="H1870" \w* [may be known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} \w upon earth| strong="H776" \w*, \w thy saving health| strong="H3444" \w* \w among all nations| strong="H1471" \w*. 
\v 3 \w Let the people| strong="H5971" \w* [praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} [thee, O God]{strong=“H430”}; \w let all the people| strong="H5971" \w* [praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} thee. 
\v 4 \w O let the nations| strong="H3816" \w* [be glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} [and sing for joy]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8762”}: [for thou shalt judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w the people| strong="H5971" \w* \w righteously| strong="H4334" \w*, [and govern]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8686”} \w the nations| strong="H3816" \w* \w upon earth| strong="H776" \w*. \w Selah| strong="H5542" \w*.\f + \fr 67:4 \ft govern: Heb. lead \f* 
\v 5 \w Let the people| strong="H5971" \w* [praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} [thee, O God]{strong=“H430”}; \w let all the people| strong="H5971" \w* [praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} thee. 
\v 6 Then \w shall the earth| strong="H776" \w* [yield]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w her increase| strong="H2981" \w*; and \w God| strong="H430" \w*, even \w our own God| strong="H430" \w*, [shall bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} us. 
\v 7 \w God| strong="H430" \w* [shall bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} [us; and all the ends]{strong=“H657”} \w of the earth| strong="H776" \w* [shall fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} him.
\c 68
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w A Psalm| strong="H4210" \w* or \w Song| strong="H7892" \w* \w of David| strong="H1732" \w*. 
\v 1 \w Let God| strong="H430" \w* [arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [let his enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [be scattered]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8799”}: [let them also that hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8764”} [him flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* him.\f + \fr 68:1 \ft before…: Heb. from his face \f* 
\v 2 \w As smoke| strong="H6227" \w* [is driven away]{strong=“H5086” x-morph=“strongMorph: \sc Th\sc*8736”}, so drive them [away]{strong=“H5086” x-morph=“strongMorph: \sc Th\sc*8799”}: \w as wax| strong="H1749" \w* [melteth]{strong=“H4549” x-morph=“strongMorph: \sc Th\sc*8736”} \w before| strong="H6440" \w* \w the fire| strong="H784" \w*, so \w let the wicked| strong="H7563" \w* [perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”} \w at the presence| strong="H6440" \w* \w of God| strong="H430" \w*. 
