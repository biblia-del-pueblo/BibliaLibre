\v 6 [He shall come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w like rain| strong="H4306" \w* \w upon the mown| strong="H1488" \w* [grass: as showers]{strong=“H7241”} that \w water| strong="H2222" \w* \w the earth| strong="H776" \w*. 
\v 7 \w In his days| strong="H3117" \w* \w shall the righteous| strong="H6662" \w* [flourish]{strong=“H6524” x-morph=“strongMorph: \sc Th\sc*8799”}; \w and abundance| strong="H7230" \w* \w of peace| strong="H7965" \w* \w so long as the moon| strong="H3394" \w* endureth.\f + \fr 72:7 \ft so long…: Heb. till there be no moon \f* 
\v 8 [He shall have dominion]{strong=“H7287” x-morph=“strongMorph: \sc Th\sc*8799”} \w also from sea| strong="H3220" \w* \w to sea| strong="H3220" \w*, \w and from the river| strong="H5104" \w* \w unto the ends| strong="H657" \w* \w of the earth| strong="H776" \w*. 
\v 9 \w They that dwell in the wilderness| strong="H6728" \w* [shall bow]{strong=“H3766” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* [him; and his enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [shall lick]{strong=“H3897” x-morph=“strongMorph: \sc Th\sc*8762”} \w the dust| strong="H6083" \w*. 
\v 10 \w The kings| strong="H4428" \w* \w of Tarshish| strong="H8659" \w* \w and of the isles| strong="H339" \w* [shall bring]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w presents| strong="H4503" \w*: \w the kings| strong="H4428" \w* \w of Sheba| strong="H7614" \w* \w and Seba| strong="H5434" \w* [shall offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”} \w gifts| strong="H814" \w*. 
\v 11 [Yea, all kings]{strong=“H4428”} [shall fall down]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} [before him: all nations]{strong=“H1471”} [shall serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} him. 
\v 12 [For he shall deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w the needy| strong="H34" \w* [when he crieth]{strong=“H7768” x-morph=“strongMorph: \sc Th\sc*8764”}; \w the poor| strong="H6041" \w* also, and him [that hath no helper]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 13 [He shall spare]{strong=“H2347” x-morph=“strongMorph: \sc Th\sc*8799”} \w the poor| strong="H1800" \w* \w and needy| strong="H34" \w*, [and shall save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} \w the souls| strong="H5315" \w* \w of the needy| strong="H34" \w*. 
\v 14 [He shall redeem]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8799”} \w their soul| strong="H5315" \w* \w from deceit| strong="H8496" \w* \w and violence| strong="H2555" \w*: [and precious]{strong=“H3365” x-morph=“strongMorph: \sc Th\sc*8799”} \w shall their blood| strong="H1818" \w* \w be in his sight| strong="H5869" \w*. 
\v 15 [And he shall live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}, [and to him shall be given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the gold| strong="H2091" \w* \w of Sheba| strong="H7614" \w*: [prayer also shall be made]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8691”} \w for him continually| strong="H8548" \w*; and \w daily| strong="H3117" \w* [shall he be praised]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”}.\f + \fr 72:15 \ft shall be given: Heb. one shall give \f* 
\v 16 \w There shall be an handful| strong="H6451" \w* \w of corn| strong="H1250" \w* \w in the earth| strong="H776" \w* \w upon the top| strong="H7218" \w* \w of the mountains| strong="H2022" \w*; \w the fruit| strong="H6529" \w* [thereof shall shake]{strong=“H7493” x-morph=“strongMorph: \sc Th\sc*8799”} \w like Lebanon| strong="H3844" \w*: and they \w of the city| strong="H5892" \w* [shall flourish]{strong=“H6692” x-morph=“strongMorph: \sc Th\sc*8686”} \w like grass| strong="H6212" \w* \w of the earth| strong="H776" \w*. 
\v 17 \w His name| strong="H8034" \w* \w shall endure for ever| strong="H5769" \w*: \w his name| strong="H8034" \w* [shall be continued]{strong=“H5125 H5125” x-morph=“strongMorph: \sc Th\sc*8686 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8735”} \w as long as| strong="H6440" \w* \w the sun| strong="H8121" \w*: and men [shall be blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8691”} [in him: all nations]{strong=“H1471”} [shall call him blessed]{strong=“H833” x-morph=“strongMorph: \sc Th\sc*8762”}.\f + \fr 72:17 \ft endure: Heb. be \f* \f + \fr 72:17 \ft his name shall be…: Heb. shall be as a son to continue his father’s name for ever \f* 
\v 18 [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} be the \sc Lord\sc* \w God| strong="H430" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*, [who only doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} [wondrous things]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”}. 
\v 19 [And blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} be \w his glorious| strong="H3519" \w* \w name| strong="H8034" \w* \w for ever| strong="H5769" \w*: \w and let the whole earth| strong="H776" \w* [be filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”} with \w his glory| strong="H3519" \w*; \w Amen| strong="H543" \w*, \w and Amen| strong="H543" \w*. 
\v 20 \w The prayers| strong="H8605" \w* \w of David| strong="H1732" \w* \w the son| strong="H1121" \w* \w of Jesse| strong="H3448" \w* [are ended]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8795”}.
\c 73
\p 
\w A Psalm| strong="H4210" \w* \w of Asaph| strong="H623" \w*. 
\v 1 \w Truly God| strong="H430" \w* is \w good| strong="H2896" \w* \w to Israel| strong="H3478" \w*, even \w to such as are of a clean| strong="H1249" \w* \w heart| strong="H3824" \w*.\f + \fr 73:1 \ft of: or, for \f* \f + \fr 73:1 \ft Truly: or, Yet \f* \f + \fr 73:1 \ft of…: Heb. clean of heart \f* 
\v 2 [But as for me, my feet]{strong=“H7272”} \w were almost| strong="H4592" \w* [gone]{strong=“H5186 H5186” x-morph=“strongMorph: \sc Th\sc*8803 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8804”}; \w my steps| strong="H838" \w* \w had well nigh| strong="H369" \w* [slipped]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8795”}. 
\v 3 [For I was envious]{strong=“H7065” x-morph=“strongMorph: \sc Th\sc*8765”} [at the foolish]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8802”}, when [I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the prosperity| strong="H7965" \w* \w of the wicked| strong="H7563" \w*. 
\v 4 For there are \w no bands| strong="H2784" \w* \w in their death| strong="H4194" \w*: \w but their strength| strong="H193" \w* is \w firm| strong="H1277" \w*.\f + \fr 73:4 \ft firm: Heb. fat \f* 
\v 5 They are \w not in trouble| strong="H5999" \w* as other \w men| strong="H582" \w*; [neither are they plagued]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8792”} \w like| strong="H5973" \w* other \w men| strong="H120" \w*.\f + \fr 73:5 \ft in…: Heb. in the trouble of other men \f* \f + \fr 73:5 \ft like: Heb. with \f* 
\v 6 \w Therefore pride| strong="H1346" \w* [compasseth them about as a chain]{strong=“H6059” x-morph=“strongMorph: \sc Th\sc*8804”}; \w violence| strong="H2555" \w* [covereth]{strong=“H5848” x-morph=“strongMorph: \sc Th\sc*8799”} them as \w a garment| strong="H7897" \w*. 
\v 7 \w Their eyes| strong="H5869" \w* [stand out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w with fatness| strong="H2459" \w*: [they have more]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w than heart| strong="H3824" \w* \w could wish| strong="H4906" \w*.\f + \fr 73:7 \ft have…: Heb. pass the thoughts of the heart \f* 
\v 8 [They are corrupt]{strong=“H4167” x-morph=“strongMorph: \sc Th\sc*8686”}, [and speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w wickedly| strong="H7451" \w* concerning \w oppression| strong="H6233" \w*: [they speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w loftily| strong="H4791" \w*. 
\v 9 [They set]{strong=“H8371” x-morph=“strongMorph: \sc Th\sc*8804”} \w their mouth| strong="H6310" \w* \w against the heavens| strong="H8064" \w*, \w and their tongue| strong="H3956" \w* [walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8799”} \w through the earth| strong="H776" \w*. 
\v 10 \w Therefore his people| strong="H5971" \w* [return]{strong=“H7725 H7725” x-morph=“strongMorph: \sc Th\sc*8686 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8799”} \w hither| strong="H1988" \w*: \w and waters| strong="H4325" \w* \w of a full| strong="H4392" \w* cup [are wrung out]{strong=“H4680” x-morph=“strongMorph: \sc Th\sc*8735”} to them. 
\v 11 [And they say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w How doth God| strong="H410" \w* [know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}? \w and is there| strong="H3426" \w* \w knowledge| strong="H1844" \w* \w in the most High| strong="H5945" \w*? 
\v 12 Behold, these are \w the ungodly| strong="H7563" \w*, \w who prosper| strong="H7961" \w* \w in the world| strong="H5769" \w*; [they increase]{strong=“H7685” x-morph=“strongMorph: \sc Th\sc*8689”} in \w riches| strong="H2428" \w*. 
\v 13 [Verily I have cleansed]{strong=“H2135” x-morph=“strongMorph: \sc Th\sc*8765”} \w my heart| strong="H3824" \w* in \w vain| strong="H7385" \w*, [and washed]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8799”} \w my hands| strong="H3709" \w* \w in innocency| strong="H5356" \w*. 
\v 14 \w For all the day| strong="H3117" \w* [long have I been plagued]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8803”}, \w and chastened| strong="H8433" \w* \w every morning| strong="H1242" \w*.\f + \fr 73:14 \ft chastened: Heb. my chastisement was \f* 
\v 15 [If I say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [I will speak]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} \w thus| strong="H3644" \w*; [behold, I should offend]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8804”} against \w the generation| strong="H1755" \w* \w of thy children| strong="H1121" \w*. 
\v 16 [When I thought]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8762”} [to know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} this, it was \w too painful| strong="H5999" \w* \w for me| strong="H5869" \w*;\f + \fr 73:16 \ft too…: Heb. labour in mine eyes \f* 
\v 17 [Until I went]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the sanctuary| strong="H4720" \w* \w of God| strong="H410" \w*; then [understood]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} \w I their end| strong="H319" \w*. 
\v 18 [Surely thou didst set]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w them in slippery places| strong="H2513" \w*: [thou castedst them down]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8689”} \w into destruction| strong="H4876" \w*. 
\v 19 How are they brought \w into desolation| strong="H8047" \w*, \w as in a moment| strong="H7281" \w*! [they are utterly]{strong=“H5486” x-morph=“strongMorph: \sc Th\sc*8804”} [consumed]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8804”} \w with terrors| strong="H1091" \w*. 
\v 20 \w As a dream| strong="H2472" \w* when one [awaketh]{strong=“H6974” x-morph=“strongMorph: \sc Th\sc*8687”}; so, \w O Lord| strong="H136" \w*, \w when thou awakest| strong="H5782" \w*, [thou shalt despise]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8799”} \w their image| strong="H6754" \w*. 
\v 21 \w Thus my heart| strong="H3824" \w* [was grieved]{strong=“H2556” x-morph=“strongMorph: \sc Th\sc*8691”}, [and I was pricked]{strong=“H8150” x-morph=“strongMorph: \sc Th\sc*8709”} \w in my reins| strong="H3629" \w*. 
\v 22 \w So foolish| strong="H1198" \w* was [I, and ignorant]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”}: I was as \w a beast| strong="H929" \w* before thee.\f + \fr 73:22 \ft ignorant: Heb. I knew not \f* \f + \fr 73:22 \ft before: Heb. with \f* 
\v 23 Nevertheless I am \w continually| strong="H8548" \w* [with thee: thou hast holden]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8804”} me \w by my right| strong="H3225" \w* \w hand| strong="H3027" \w*. 
\v 24 [Thou shalt guide]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8686”} \w me with thy counsel| strong="H6098" \w*, \w and afterward| strong="H310" \w* [receive]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} me to \w glory| strong="H3519" \w*. 
\v 25 \w Whom have I in heaven| strong="H8064" \w* but thee? and there is \w none upon earth| strong="H776" \w* that [I desire]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} beside thee. 
\v 26 \w My flesh| strong="H7607" \w* \w and my heart| strong="H3824" \w* [faileth]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”}: but \w God| strong="H430" \w* is \w the strength| strong="H6697" \w* \w of my heart| strong="H3824" \w*, \w and my portion| strong="H2506" \w* \w for ever| strong="H5769" \w*.\f + \fr 73:26 \ft strength: Heb. rock \f* 
\v 27 [For, lo, they that are far]{strong=“H7369”} [from thee shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}: [thou hast destroyed]{strong=“H6789” x-morph=“strongMorph: \sc Th\sc*8689”} [all them that go a whoring]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”} from thee. 
\v 28 \w But| strong="H589" \w* it is \w good| strong="H2896" \w* \w for me to draw near| strong="H7132" \w* \w to God| strong="H430" \w*: [I have put]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8804”} \w my trust| strong="H4268" \w* \w in the Lord| strong="H136" \w* \sc God\sc*, [that I may declare]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8763”} \w all thy works| strong="H4399" \w*.
\c 74
\p 
[Maschil]{strong=“H4905” x-morph=“strongMorph: \sc Th\sc*8688”} \w of Asaph| strong="H623" \w*. 
\v 1 \w O God| strong="H430" \w*, why hast thou cast us [off]{strong=“H2186” x-morph=“strongMorph: \sc Th\sc*8804”} \w for ever| strong="H5331" \w*? why \w doth thine anger| strong="H639" \w* [smoke]{strong=“H6225” x-morph=“strongMorph: \sc Th\sc*8799”} \w against the sheep| strong="H6629" \w* \w of thy pasture| strong="H4830" \w*?\f + \fr 74:1 \ft Maschil…: or, A Psalm for Asaph to give instruction \f* 
\v 2 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy congregation| strong="H5712" \w*, which [thou hast purchased]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8804”} \w of old| strong="H6924" \w*; \w the rod| strong="H7626" \w* \w of thine inheritance| strong="H5159" \w*, which [thou hast redeemed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8804”}; \w this mount| strong="H2022" \w* \w Zion| strong="H6726" \w*, [wherein thou hast dwelt]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 74:2 \ft rod: or, tribe \f* 
\v 3 [Lift up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8685”} \w thy feet| strong="H6471" \w* \w unto the perpetual| strong="H5331" \w* \w desolations| strong="H4876" \w*; even all that [the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [hath done wickedly]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8689”} \w in the sanctuary| strong="H6944" \w*. 
\v 4 [Thine enemies]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8802”} [roar]{strong=“H7580” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the midst| strong="H7130" \w* \w of thy congregations| strong="H4150" \w*; [they set up]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w their ensigns| strong="H226" \w* for \w signs| strong="H226" \w*. 
\v 5 A man [was famous]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8735”} [according as he had lifted up]{strong=“H4605 H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w axes| strong="H7134" \w* \w upon the thick| strong="H5442" \w* \w trees| strong="H6086" \w*. 
\v 6 [But now they break down]{strong=“H1986” x-morph=“strongMorph: \sc Th\sc*8799”} \w the carved work| strong="H6603" \w* \w thereof at once| strong="H3162" \w* \w with axes| strong="H3781" \w* \w and hammers| strong="H3597" \w*. 
\v 7 [They have cast]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w fire| strong="H784" \w* \w into thy sanctuary| strong="H4720" \w*, [they have defiled]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8765”} by casting down \w the dwelling place| strong="H4908" \w* \w of thy name| strong="H8034" \w* \w to the ground| strong="H776" \w*.\f + \fr 74:7 \ft They have cast…: Heb. They have sent thy sanctuary unto the fire \f* 
\v 8 [They said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w in their hearts| strong="H3820" \w*, [Let us destroy]{strong=“H3238” x-morph=“strongMorph: \sc Th\sc*8799”} \w them together| strong="H3162" \w*: [they have burned up]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8804”} \w all the synagogues| strong="H4150" \w* \w of God| strong="H410" \w* \w in the land| strong="H776" \w*.\f + \fr 74:8 \ft destroy: Heb. break \f* 
\v 9 [We see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w not our signs| strong="H226" \w*: there is \w no more any prophet| strong="H5030" \w*: neither is there [among us any that knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w how long| strong="H5704" \w*. 
\v 10 \w O God| strong="H430" \w*, \w how long shall the adversary| strong="H6862" \w* [reproach]{strong=“H2778” x-morph=“strongMorph: \sc Th\sc*8762”}? [shall the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [blaspheme]{strong=“H5006” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy name| strong="H8034" \w* \w for ever| strong="H5331" \w*? 
\v 11 [Why withdrawest]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w thou thy hand| strong="H3027" \w*, \w even thy right hand| strong="H3225" \w*? [pluck]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8761”} it \w out of| strong="H7130" \w* [thy bosom]{strong=“H2436 H2436” x-morph=“strongMorph: \sc Th\sc*8675”}. 
\v 12 \w For God| strong="H430" \w* is \w my King| strong="H4428" \w* \w of old| strong="H6924" \w*, [working]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w salvation| strong="H3444" \w* \w in the midst| strong="H7130" \w* \w of the earth| strong="H776" \w*. 
\v 13 [Thou didst divide]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8782”} \w the sea| strong="H3220" \w* \w by thy strength| strong="H5797" \w*: [thou brakest]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8765”} \w the heads| strong="H7218" \w* \w of the dragons| strong="H8577" \w* \w in the waters| strong="H4325" \w*.\f + \fr 74:13 \ft divide: Heb. break \f* \f + \fr 74:13 \ft dragons: or, whales \f* 
\v 14 [Thou brakest]{strong=“H7533” x-morph=“strongMorph: \sc Th\sc*8765”} \w the heads| strong="H7218" \w* \w of leviathan| strong="H3882" \w* in pieces, and [gavest]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} him to be \w meat| strong="H3978" \w* \w to the people| strong="H5971" \w* \w inhabiting the wilderness| strong="H6728" \w*. 
\v 15 [Thou didst cleave]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8804”} \w the fountain| strong="H4599" \w* \w and the flood| strong="H5158" \w*: [thou driedst up]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”} \w mighty| strong="H386" \w* \w rivers| strong="H5104" \w*.\f + \fr 74:15 \ft mighty…: Heb. rivers of strength \f* 
\v 16 \w The day| strong="H3117" \w* is [thine, the night]{strong=“H3915”} also is [thine: thou hast prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8689”} \w the light| strong="H3974" \w* \w and the sun| strong="H8121" \w*. 
\v 17 [Thou hast set]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8689”} \w all the borders| strong="H1367" \w* \w of the earth| strong="H776" \w*: [thou hast made]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8804”} \w summer| strong="H7019" \w* \w and winter| strong="H2779" \w*.\f + \fr 74:17 \ft made: Heb. made them \f* 
\v 18 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”} this, that [the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [hath reproached]{strong=“H2778” x-morph=“strongMorph: \sc Th\sc*8765”}, O \sc Lord\sc*, and that \w the foolish| strong="H5036" \w* \w people| strong="H5971" \w* [have blasphemed]{strong=“H5006” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy name| strong="H8034" \w*. 
\v 19 [O deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w not the soul| strong="H5315" \w* \w of thy turtledove| strong="H8449" \w* \w unto the multitude| strong="H2416" \w* of the wicked: [forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} \w not the congregation| strong="H2416" \w* \w of thy poor| strong="H6041" \w* \w for ever| strong="H5331" \w*. 
\v 20 [Have respect]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto the covenant| strong="H1285" \w*: \w for the dark| strong="H4285" \w* \w places of the earth| strong="H776" \w* [are full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the habitations| strong="H4999" \w* \w of cruelty| strong="H2555" \w*. 
\v 21 \w O let not the oppressed| strong="H1790" \w* [return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [ashamed]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8737”}: \w let the poor| strong="H6041" \w* \w and needy| strong="H34" \w* [praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy name| strong="H8034" \w*. 
\v 22 [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O God| strong="H430" \w*, [plead]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8798”} \w thine own cause| strong="H7379" \w*: [remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”} \w how the foolish man| strong="H5036" \w* \w reproacheth| strong="H2781" \w* \w thee daily| strong="H3117" \w*. 
\v 23 [Forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} \w not the voice| strong="H6963" \w* [of thine enemies]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8802”}: \w the tumult| strong="H7588" \w* [of those that rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8801”} [against thee increaseth]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8802”} \w continually| strong="H8548" \w*.\f + \fr 74:23 \ft increaseth: Heb. ascendeth \f*
\c 75
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, [Al-taschith]{strong=“H516” x-morph=“strongMorph: \sc Th\sc*8686”}, \w A Psalm| strong="H4210" \w* or \w Song| strong="H7892" \w* \w of Asaph| strong="H623" \w*. 
\v 1 [Unto thee, O God]{strong=“H430”}, [do we give thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8689”}, unto thee [do we give thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8689”}: for that \w thy name| strong="H8034" \w* \w is near| strong="H7138" \w* [thy wondrous works]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} [declare]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8765”}.\f + \fr 75:1 \ft Al-taschith: or, Destroy not \f* \f + \fr 75:1 \ft of: or, for \f* 
\v 2 [When I shall receive]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the congregation| strong="H4150" \w* [I will judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w uprightly| strong="H4339" \w*.\f + \fr 75:2 \ft receive…: or, take a set time \f* 
\v 3 \w The earth| strong="H776" \w* [and all the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} [thereof are dissolved]{strong=“H4127” x-morph=“strongMorph: \sc Th\sc*8737”}: [I bear up]{strong=“H8505” x-morph=“strongMorph: \sc Th\sc*8765”} \w the pillars| strong="H5982" \w* [of it. Selah]{strong=“H5542”}. 
\v 4 [I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto the fools]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8802”}, [Deal not foolishly]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8799”}: \w and to the wicked| strong="H7563" \w*, [Lift not up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} \w the horn| strong="H7161" \w*: 
\v 5 [Lift not up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} \w your horn| strong="H7161" \w* \w on high| strong="H4791" \w*: [speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} not with \w a stiff| strong="H6277" \w* \w neck| strong="H6677" \w*. 
\v 6 [For promotion]{strong=“H2022 H7311” x-morph=“strongMorph: \sc Th\sc*8676 strongMorph: \sc Th\sc*8687”} cometh \w neither from the east| strong="H4161" \w*, \w nor from the west| strong="H4628" \w*, \w nor from the south| strong="H4057" \w*.\f + \fr 75:6 \ft south: Heb. desert \f* 
\v 7 \w But God| strong="H430" \w* is [the judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”}: [he putteth down]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8686”} [one, and setteth up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} another. 
\v 8 \w For in the hand| strong="H3027" \w* of the \sc Lord\sc* there is \w a cup| strong="H3563" \w*, \w and the wine| strong="H3196" \w* [is red]{strong=“H2560” x-morph=“strongMorph: \sc Th\sc*8804”}; \w it is full| strong="H4392" \w* \w of mixture| strong="H4538" \w*; [and he poureth out]{strong=“H5064” x-morph=“strongMorph: \sc Th\sc*8686”} \w of the same| strong="H2088" \w*: \w but the dregs| strong="H8105" \w* [thereof, all the wicked]{strong=“H7563”} \w of the earth| strong="H776" \w* shall wring them [out]{strong=“H4680” x-morph=“strongMorph: \sc Th\sc*8799”}, and [drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} them. 
\v 9 [But I will declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w for ever| strong="H5769" \w*; [I will sing praises]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8762”} \w to the God| strong="H430" \w* \w of Jacob| strong="H3290" \w*. 
\v 10 \w All the horns| strong="H7161" \w* \w of the wicked| strong="H7563" \w* [also will I cut off]{strong=“H1438” x-morph=“strongMorph: \sc Th\sc*8762”}; but \w the horns| strong="H7161" \w* \w of the righteous| strong="H6662" \w* [shall be exalted]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8783”}.
\c 76
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} \w on Neginoth| strong="H5058" \w*, \w A Psalm| strong="H4210" \w* or \w Song| strong="H7892" \w* \w of Asaph| strong="H623" \w*. 
\v 1 \w In Judah| strong="H3063" \w* is \w God| strong="H430" \w* [known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8737”}: \w his name| strong="H8034" \w* is \w great| strong="H1419" \w* \w in Israel| strong="H3478" \w*.\f + \fr 76:1 \ft chief…: or, overseer \f* \f + \fr 76:1 \ft of: or, for \f* 
\v 2 \w In Salem| strong="H8004" \w* \w also is his tabernacle| strong="H5520" \w*, \w and his dwelling place| strong="H4585" \w* \w in Zion| strong="H6726" \w*. 
\v 3 [There brake]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8765”} \w he the arrows| strong="H7565" \w* \w of the bow| strong="H7198" \w*, \w the shield| strong="H4043" \w*, \w and the sword| strong="H2719" \w*, \w and the battle| strong="H4421" \w*. \w Selah| strong="H5542" \w*. 
\v 4 Thou art [more glorious]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8737”} and \w excellent| strong="H117" \w* \w than the mountains| strong="H2042" \w* \w of prey| strong="H2964" \w*. 
\v 5 [The stouthearted]{strong=“H3820 H47”} [are spoiled]{strong=“H7997” x-morph=“strongMorph: \sc Th\sc*8709”}, [they have slept]{strong=“H5123” x-morph=“strongMorph: \sc Th\sc*8804”} \w their sleep| strong="H8142" \w*: \w and none of the men| strong="H582" \w* \w of might| strong="H2428" \w* [have found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w their hands| strong="H3027" \w*. 
\v 6 \w At thy rebuke| strong="H1606" \w*, \w O God| strong="H430" \w* \w of Jacob| strong="H3290" \w*, \w both the chariot| strong="H7393" \w* \w and horse| strong="H5483" \w* [are cast into a dead sleep]{strong=“H7290” x-morph=“strongMorph: \sc Th\sc*8737”}. 
\v 7 Thou, even thou, art [to be feared]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”}: [and who may stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy sight| strong="H6440" \w* \w when| strong="H227" \w* \w once thou art angry| strong="H639" \w*? 
\v 8 \w Thou didst cause judgment| strong="H1779" \w* [to be heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8689”} \w from heaven| strong="H8064" \w*; \w the earth| strong="H776" \w* [feared]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8804”}, [and was still]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8804”}, 
\v 9 \w When God| strong="H430" \w* [arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8800”} \w to judgment| strong="H4941" \w*, [to save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8687”} \w all the meek| strong="H6035" \w* \w of the earth| strong="H776" \w*. \w Selah| strong="H5542" \w*. 
\v 10 \w Surely the wrath| strong="H2534" \w* \w of man| strong="H120" \w* [shall praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} [thee: the remainder]{strong=“H7611”} \w of wrath| strong="H2534" \w* [shalt thou restrain]{strong=“H2296” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 11 [Vow]{strong=“H5087” x-morph=“strongMorph: \sc Th\sc*8798”}, [and pay]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8761”} unto the \sc Lord\sc* \w your God| strong="H430" \w*: \w let all that be round about| strong="H5439" \w* [him bring]{strong=“H2986” x-morph=“strongMorph: \sc Th\sc*8686”} \w presents| strong="H7862" \w* \w unto him that ought to be feared| strong="H4172" \w*.\f + \fr 76:11 \ft unto him…: Heb. to fear \f* 
\v 12 [He shall cut off]{strong=“H1219” x-morph=“strongMorph: \sc Th\sc*8799”} \w the spirit| strong="H7307" \w* \w of princes| strong="H5057" \w*: he is [terrible]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”} \w to the kings| strong="H4428" \w* \w of the earth| strong="H776" \w*.
\c 77
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w to Jeduthun| strong="H3038" \w*, \w A Psalm| strong="H4210" \w* \w of Asaph| strong="H623" \w*. 
\v 1 [I cried]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto God| strong="H430" \w* \w with my voice| strong="H6963" \w*, even \w unto God| strong="H430" \w* \w with my voice| strong="H6963" \w*; [and he gave ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8689”} unto me.\f + \fr 77:1 \ft of: or, for \f* 
\v 2 \w In the day| strong="H3117" \w* \w of my trouble| strong="H6869" \w* [I sought]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w*: \w my sore| strong="H3027" \w* [ran]{strong=“H5064” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the night| strong="H3915" \w*, [and ceased]{strong=“H6313” x-morph=“strongMorph: \sc Th\sc*8799”} [not: my soul]{strong=“H5315”} [refused ]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8765”} [to be comforted]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8736”}.\f + \fr 77:2 \ft sore: Heb. hand \f* 
\v 3 [I remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w God| strong="H430" \w*, [and was troubled]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8799”}: [I complained]{strong=“H7878” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and my spirit| strong="H7307" \w* [was overwhelmed]{strong=“H5848” x-morph=“strongMorph: \sc Th\sc*8691”}. \w Selah| strong="H5542" \w*. 
\v 4 [Thou holdest]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine eyes| strong="H5869" \w* \w waking| strong="H8109" \w*: [I am so troubled]{strong=“H6470” x-morph=“strongMorph: \sc Th\sc*8738”} [that I cannot speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 5 [I have considered]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8765”} \w the days| strong="H3117" \w* \w of old| strong="H6924" \w*, \w the years| strong="H8141" \w* \w of ancient times| strong="H5769" \w*. 
\v 6 [I call to remembrance]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w my song| strong="H5058" \w* \w in the night| strong="H3915" \w*: [I commune]{strong=“H7878” x-morph=“strongMorph: \sc Th\sc*8799”} \w with mine own heart| strong="H3824" \w*: \w and my spirit| strong="H7307" \w* [made diligent search]{strong=“H2664” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 7 \w Will the Lord| strong="H136" \w* [cast off]{strong=“H2186” x-morph=“strongMorph: \sc Th\sc*8799”} \w for ever| strong="H5769" \w*? [and will]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [he be favourable]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8800”} no more? 
\v 8 \w Is his mercy| strong="H2617" \w* [clean gone]{strong=“H656” x-morph=“strongMorph: \sc Th\sc*8804”} \w for ever| strong="H5331" \w*? doth his \w promise| strong="H562" \w* [fail]{strong=“H1584” x-morph=“strongMorph: \sc Th\sc*8804”} [for evermore]{strong=“H1755 H1755”}?\f + \fr 77:8 \ft for evermore: Heb. to generation and generation? \f* 
\v 9 \w Hath God| strong="H410" \w* [forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} [to be gracious]{strong=“H2589” x-morph=“strongMorph: \sc Th\sc*8800”}? \w hath he in anger| strong="H639" \w* [shut up]{strong=“H7092” x-morph=“strongMorph: \sc Th\sc*8804”} \w his tender mercies| strong="H7356" \w*? \w Selah| strong="H5542" \w*. 
\v 10 [And I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, This is [my infirmity]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8763”}: but I will remember \w the years| strong="H8141" \w* \w of the right hand| strong="H3225" \w* \w of the most High| strong="H5945" \w*. 
