\v 25 [He turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8804”} \w their heart| strong="H3820" \w* [to hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8800”} \w his people| strong="H5971" \w*, [to deal subtilly]{strong=“H5230” x-morph=“strongMorph: \sc Th\sc*8692”} \w with his servants| strong="H5650" \w*. 
\v 26 [He sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w Moses| strong="H4872" \w* \w his servant| strong="H5650" \w*; and \w Aaron| strong="H175" \w* [whom he had chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”}. 
