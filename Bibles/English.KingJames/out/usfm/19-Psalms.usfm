\c 105
\p 
\v 1 [O give thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8685”} unto the \sc Lord\sc*; [call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} \w upon his name| strong="H8034" \w*: [make known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8685”} \w his deeds| strong="H5949" \w* \w among the people| strong="H5971" \w*. 
