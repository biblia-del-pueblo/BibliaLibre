\v 9 [We have thought]{strong=“H1819” x-morph=“strongMorph: \sc Th\sc*8765”} \w of thy lovingkindness| strong="H2617" \w*, \w O God| strong="H430" \w*, \w in the midst| strong="H7130" \w* \w of thy temple| strong="H1964" \w*. 
\v 10 \w According to thy name| strong="H8034" \w*, \w O God| strong="H430" \w*, so is \w thy praise| strong="H8416" \w* \w unto the ends| strong="H7099" \w* \w of the earth| strong="H776" \w*: \w thy right hand| strong="H3225" \w* [is full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of righteousness| strong="H6664" \w*. 
\v 11 \w Let mount| strong="H2022" \w* \w Zion| strong="H6726" \w* [rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”}, \w let the daughters| strong="H1323" \w* \w of Judah| strong="H3063" \w* [be glad]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”}, \w because of thy judgments| strong="H4941" \w*. 
\v 12 [Walk about]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8798”} \w Zion| strong="H6726" \w*, [and go round about]{strong=“H5362” x-morph=“strongMorph: \sc Th\sc*8685”} [her: tell]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8798”} \w the towers| strong="H4026" \w* thereof. 
