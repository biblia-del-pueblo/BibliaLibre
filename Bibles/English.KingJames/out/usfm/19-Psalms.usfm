\c 106
\p 
\v 1 [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*. [O give thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8685”} unto the \sc Lord\sc*; for he is \w good| strong="H2896" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*.\f + \fr 106:1 \ft Praise…: Heb. Hallelujah \f* 
\v 2 [Who can utter]{strong=“H4448” x-morph=“strongMorph: \sc Th\sc*8762”} \w the mighty acts| strong="H1369" \w* of the \sc Lord\sc*? who [can shew forth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8686”} \w all his praise| strong="H8416" \w*? 
\v 3 \w Blessed| strong="H835" \w* are [they that keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w judgment| strong="H4941" \w*, and [he that doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w righteousness| strong="H6666" \w* \w at all times| strong="H6256" \w*. 
\v 4 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”} me, O \sc Lord\sc*, \w with the favour| strong="H7522" \w* that thou bearest unto \w thy people| strong="H5971" \w*: [O visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8798”} \w me with thy salvation| strong="H3444" \w*; 
\v 5 [That I may see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w the good| strong="H2896" \w* \w of thy chosen| strong="H972" \w*, [that I may rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the gladness| strong="H8057" \w* \w of thy nation| strong="H1471" \w*, [that I may glory]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8692”} \w with thine inheritance| strong="H5159" \w*. 
\v 6 [We have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} \w with our fathers| strong="H1" \w*, [we have committed iniquity]{strong=“H5753” x-morph=“strongMorph: \sc Th\sc*8689”}, [we have done wickedly]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\v 7 \w Our fathers| strong="H1" \w* [understood]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8689”} [not thy wonders]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} \w in Egypt| strong="H4714" \w*; [they remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the multitude| strong="H7230" \w* \w of thy mercies| strong="H2617" \w*; [but provoked]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8686”} him \w at the sea| strong="H3220" \w*, even \w at the Red| strong="H5488" \w* \w sea| strong="H3220" \w*. 
\v 8 [Nevertheless he saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} [them for his name’s]{strong=“H8034”} [sake, that he might make his mighty power]{strong=“H1369”} [to be known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8687”}. 
\v 9 [He rebuked]{strong=“H1605” x-morph=“strongMorph: \sc Th\sc*8799”} \w the Red| strong="H5488" \w* \w sea| strong="H3220" \w* [also, and it was dried up]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8799”}: [so he led]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8686”} \w them through the depths| strong="H8415" \w*, \w as through the wilderness| strong="H4057" \w*. 
\v 10 [And he saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} \w them from the hand| strong="H3027" \w* [of him that hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} them, [and redeemed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8799”} \w them from the hand| strong="H3027" \w* [of the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 11 \w And the waters| strong="H4325" \w* [covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w their enemies| strong="H6862" \w*: \w there was not one| strong="H259" \w* [of them left]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 12 [Then believed]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”} \w they his words| strong="H1697" \w*; [they sang]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8799”} \w his praise| strong="H8416" \w*. 
\v 13 [They soon]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8765”} [forgat]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} \w his works| strong="H4639" \w*; [they waited]{strong=“H2442” x-morph=“strongMorph: \sc Th\sc*8765”} \w not for his counsel| strong="H6098" \w*:\f + \fr 106:13 \ft They soon…: Heb. They made haste, they forgat \f* 
\v 14 [But lusted]{strong=“H183” x-morph=“strongMorph: \sc Th\sc*8691”} \w exceedingly| strong="H8378" \w* \w in the wilderness| strong="H4057" \w*, [and tempted]{strong=“H5254” x-morph=“strongMorph: \sc Th\sc*8762”} \w God| strong="H410" \w* \w in the desert| strong="H3452" \w*.\f + \fr 106:14 \ft lusted…: Heb. lusted a lust \f* 
\v 15 [And he gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w them their request| strong="H7596" \w*; [but sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w leanness| strong="H7332" \w* \w into their soul| strong="H5315" \w*. 
\v 16 [They envied]{strong=“H7065” x-morph=“strongMorph: \sc Th\sc*8762”} \w Moses| strong="H4872" \w* \w also in the camp| strong="H4264" \w*, and \w Aaron| strong="H175" \w* \w the saint| strong="H6918" \w* of the \sc Lord\sc*. 
\v 17 \w The earth| strong="H776" \w* [opened]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} [and swallowed up]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8799”} \w Dathan| strong="H1885" \w*, [and covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w the company| strong="H5712" \w* \w of Abiram| strong="H48" \w*. 
\v 18 \w And a fire| strong="H784" \w* [was kindled]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8799”} \w in their company| strong="H5712" \w*; \w the flame| strong="H3852" \w* [burned up]{strong=“H3857” x-morph=“strongMorph: \sc Th\sc*8762”} \w the wicked| strong="H7563" \w*. 
\v 19 [They made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w a calf| strong="H5695" \w* \w in Horeb| strong="H2722" \w*, [and worshipped]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} \w the molten image| strong="H4541" \w*. 
\v 20 [Thus they changed]{strong=“H4171” x-morph=“strongMorph: \sc Th\sc*8686”} \w their glory| strong="H3519" \w* \w into the similitude| strong="H8403" \w* \w of an ox| strong="H7794" \w* [that eateth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} \w grass| strong="H6212" \w*. 
\v 21 [They forgat]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} \w God| strong="H410" \w* [their saviour]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8688”}, [which had done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w great things| strong="H1419" \w* \w in Egypt| strong="H4714" \w*; 
\v 22 [Wondrous works]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} \w in the land| strong="H776" \w* \w of Ham| strong="H2526" \w*, and [terrible things]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”} \w by the Red| strong="H5488" \w* \w sea| strong="H3220" \w*. 
\v 23 [Therefore he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [that he would destroy]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8687”} [them, had not]{strong=“H3884”} \w Moses| strong="H4872" \w* \w his chosen| strong="H972" \w* [stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* \w him in the breach| strong="H6556" \w*, [to turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} \w his wrath| strong="H2534" \w*, [lest he should destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8687”} them. 
\v 24 [Yea, they despised]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8799”} \w the pleasant| strong="H2532" \w* \w land| strong="H776" \w*, [they believed]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8689”} \w not his word| strong="H1697" \w*:\f + \fr 106:24 \ft the pleasant…: Heb. a land of desire \f* 
\v 25 [But murmured]{strong=“H7279” x-morph=“strongMorph: \sc Th\sc*8735”} \w in their tents| strong="H168" \w*, and [hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w not unto the voice| strong="H6963" \w* of the \sc Lord\sc*. 
\v 26 [Therefore he lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w his hand| strong="H3027" \w* [against them, to overthrow]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8687”} \w them in the wilderness| strong="H4057" \w*:\f + \fr 106:26 \ft to overthrow: Heb. to make them fall \f* 
\v 27 [To overthrow]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8687”} \w their seed| strong="H2233" \w* \w also among the nations| strong="H1471" \w*, [and to scatter]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8763”} \w them in the lands| strong="H776" \w*.\f + \fr 106:27 \ft To overthrow: Heb. To make them fall \f* 
\v 28 [They joined]{strong=“H6775” x-morph=“strongMorph: \sc Th\sc*8735”} [themselves also unto Baal-peor]{strong=“H1187”}, [and ate]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the sacrifices| strong="H2077" \w* [of the dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”}. 
\v 29 Thus they provoked him [to anger]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8686”} \w with their inventions| strong="H4611" \w*: \w and the plague| strong="H4046" \w* [brake in]{strong=“H6555” x-morph=“strongMorph: \sc Th\sc*8799”} upon them. 
\v 30 [Then stood up]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w Phinehas| strong="H6372" \w*, [and executed judgment]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8762”}: and so \w the plague| strong="H4046" \w* [was stayed]{strong=“H6113” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 31 [And that was counted]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8735”} \w unto him for righteousness| strong="H6666" \w* \w unto all| strong="H1755" \w* \w generations| strong="H1755" \w* \w for| strong="H5704" \w* \w evermore| strong="H5769" \w*. 
\v 32 [They angered]{strong=“H7107” x-morph=“strongMorph: \sc Th\sc*8686”} him \w also at the waters| strong="H4325" \w* [of strife]{strong=“H4809 H4808” x-morph=“strongMorph: \sc Th\sc*8677”}, [so that it went ill]{strong=“H3415” x-morph=“strongMorph: \sc Th\sc*8799”} \w with Moses| strong="H4872" \w* for their sakes: 
\v 33 [Because they provoked]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8689”} \w his spirit| strong="H7307" \w*, [so that he spake unadvisedly]{strong=“H981” x-morph=“strongMorph: \sc Th\sc*8762”} \w with his lips| strong="H8193" \w*. 
\v 34 [They did not destroy]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8689”} \w the nations| strong="H5971" \w*, concerning whom the \sc Lord\sc* [commanded]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} them: 
\v 35 [But were mingled]{strong=“H6148” x-morph=“strongMorph: \sc Th\sc*8691”} \w among the heathen| strong="H1471" \w*, [and learned]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8799”} \w their works| strong="H4639" \w*. 
\v 36 [And they served]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} \w their idols| strong="H6091" \w*: \w which were a snare| strong="H4170" \w* unto them. 
\v 37 [Yea, they sacrificed]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} \w their sons| strong="H1121" \w* \w and their daughters| strong="H1323" \w* \w unto devils| strong="H7700" \w*, 
\v 38 [And shed]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8799”} \w innocent| strong="H5355" \w* \w blood| strong="H1818" \w*, even \w the blood| strong="H1818" \w* \w of their sons| strong="H1121" \w* \w and of their daughters| strong="H1323" \w*, [whom they sacrificed]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto the idols| strong="H6091" \w* \w of Canaan| strong="H3667" \w*: \w and the land| strong="H776" \w* [was polluted]{strong=“H2610” x-morph=“strongMorph: \sc Th\sc*8799”} \w with blood| strong="H1818" \w*. 
\v 39 [Thus were they defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”} \w with their own works| strong="H4639" \w*, [and went a whoring]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8799”} \w with their own inventions| strong="H4611" \w*. 
\v 40 \w Therefore was the wrath| strong="H639" \w* of the \sc Lord\sc* [kindled]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8799”} \w against his people| strong="H5971" \w*, [insomuch that he abhorred]{strong=“H8581” x-morph=“strongMorph: \sc Th\sc*8762”} \w his own inheritance| strong="H5159" \w*. 
\v 41 [And he gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w them into the hand| strong="H3027" \w* \w of the heathen| strong="H1471" \w*; [and they that hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} [them ruled]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8799”} over them. 
\v 42 [Their enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [also oppressed]{strong=“H3905” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and they were brought into subjection]{strong=“H3665” x-morph=“strongMorph: \sc Th\sc*8735”} \w under their hand| strong="H3027" \w*. 
\v 43 \w Many| strong="H7227" \w* \w times| strong="H6471" \w* [did he deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} [them; but they provoked]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8686”} him \w with their counsel| strong="H6098" \w*, [and were brought low]{strong=“H4355” x-morph=“strongMorph: \sc Th\sc*8799”} \w for their iniquity| strong="H5771" \w*.\f + \fr 106:43 \ft brought…: or, impoverished, or, weakened \f* 
\v 44 [Nevertheless he regarded]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w their affliction| strong="H6862" \w*, [when he heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w their cry| strong="H7440" \w*: 
\v 45 [And he remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w for them his covenant| strong="H1285" \w*, [and repented]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8735”} \w according to the multitude| strong="H7230" \w* \w of his mercies| strong="H2617" \w*. 
\v 46 [He made]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w them also to be pitied| strong="H7356" \w* \w of| strong="H6440" \w* [all those that carried them captives]{strong=“H7617” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 47 [Save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”} us, O \sc Lord\sc* \w our God| strong="H430" \w*, [and gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8761”} \w us from among the heathen| strong="H1471" \w*, [to give thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8687”} \w unto thy holy| strong="H6944" \w* \w name| strong="H8034" \w*, and [to triumph]{strong=“H7623” x-morph=“strongMorph: \sc Th\sc*8692”} \w in thy praise| strong="H8416" \w*. 
\v 48 [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} be the \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w* \w from everlasting| strong="H5769" \w* \w to everlasting| strong="H5769" \w*: \w and let all the people| strong="H5971" \w* [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Amen| strong="H543" \w*. [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*.\f + \fr 106:48 \ft Praise…: Heb. Hallelujah \f*
\c 107
\p 
\v 1 [O give thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8685”} unto the \sc Lord\sc*, for he is \w good| strong="H2896" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*. 
\v 2 [Let the redeemed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8803”} of the \sc Lord\sc* [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} so, [whom he hath redeemed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8804”} \w from the hand| strong="H3027" \w* \w of the enemy| strong="H6862" \w*; 
\v 3 [And gathered]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8765”} \w them out of the lands| strong="H776" \w*, \w from the east| strong="H4217" \w*, \w and from the west| strong="H4628" \w*, \w from the north| strong="H6828" \w*, \w and from the south| strong="H3220" \w*.\f + \fr 107:3 \ft south: Heb. sea \f* 
\v 4 [They wandered]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the wilderness| strong="H4057" \w* \w in a solitary| strong="H3452" \w* \w way| strong="H1870" \w*; [they found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w no city| strong="H5892" \w* \w to dwell| strong="H4186" \w* in. 
\v 5 \w Hungry| strong="H7457" \w* \w and thirsty| strong="H6771" \w*, \w their soul| strong="H5315" \w* [fainted ]{strong=“H5848” x-morph=“strongMorph: \sc Th\sc*8691”} in them. 
\v 6 [Then they cried]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc* \w in their trouble| strong="H6862" \w*, and [he delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w them out of their distresses| strong="H4691" \w*. 
\v 7 [And he led them forth]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8686”} \w by the right| strong="H3477" \w* \w way| strong="H1870" \w*, [that they might go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} \w to a city| strong="H5892" \w* \w of habitation| strong="H4186" \w*. 
\v 8 Oh that men [would praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} the \sc Lord\sc* for \w his goodness| strong="H2617" \w*, and for [his wonderful works]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} \w to the children| strong="H1121" \w* \w of men| strong="H120" \w*! 
\v 9 [For he satisfieth]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8689”} [the longing]{strong=“H8264” x-morph=“strongMorph: \sc Th\sc*8802”} \w soul| strong="H5315" \w*, [and filleth]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8765”} \w the hungry| strong="H7457" \w* \w soul| strong="H5315" \w* \w with goodness| strong="H2896" \w*. 
\v 10 [Such as sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in darkness| strong="H2822" \w* \w and in the shadow of death| strong="H6757" \w*, being \w bound| strong="H615" \w* \w in affliction| strong="H6040" \w* \w and iron| strong="H1270" \w*; 
\v 11 [Because they rebelled]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8689”} \w against the words| strong="H561" \w* \w of God| strong="H410" \w*, [and contemned]{strong=“H5006” x-morph=“strongMorph: \sc Th\sc*8804”} \w the counsel| strong="H6098" \w* \w of the most High| strong="H5945" \w*: 
\v 12 [Therefore he brought down]{strong=“H3665” x-morph=“strongMorph: \sc Th\sc*8686”} \w their heart| strong="H3820" \w* \w with labour| strong="H5999" \w*; [they fell down]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8804”}, and there was [none to help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 13 [Then they cried]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc* \w in their trouble| strong="H6862" \w*, and [he saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} \w them out of their distresses| strong="H4691" \w*. 
\v 14 [He brought them out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w of darkness| strong="H2822" \w* \w and the shadow of death| strong="H6757" \w*, \w and brake| strong="H5423" \w* \w their bands| strong="H4147" \w* [in sunder]{strong=“H5423” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 15 Oh that men [would praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} the \sc Lord\sc* for \w his goodness| strong="H2617" \w*, and for [his wonderful works]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} \w to the children| strong="H1121" \w* \w of men| strong="H120" \w*! 
\v 16 [For he hath broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8765”} \w the gates| strong="H1817" \w* \w of brass| strong="H5178" \w*, \w and cut| strong="H1438" \w* \w the bars| strong="H1280" \w* \w of iron| strong="H1270" \w* [in sunder]{strong=“H1438” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 17 \w Fools| strong="H191" \w* \w because| strong="H1870" \w* \w of their transgression| strong="H6588" \w*, \w and because of their iniquities| strong="H5771" \w*, [are afflicted]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8691”}. 
\v 18 \w Their soul| strong="H5315" \w* [abhorreth]{strong=“H8581” x-morph=“strongMorph: \sc Th\sc*8762”} \w all manner of meat| strong="H400" \w*; [and they draw near]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto the gates| strong="H8179" \w* \w of death| strong="H4194" \w*. 
\v 19 [Then they cry]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc* \w in their trouble| strong="H6862" \w*, and [he saveth]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} \w them out of their distresses| strong="H4691" \w*. 
\v 20 [He sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w his word| strong="H1697" \w*, [and healed]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and delivered]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8762”} them \w from their destructions| strong="H7825" \w*. 
\v 21 Oh that men [would praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} the \sc Lord\sc* for \w his goodness| strong="H2617" \w*, and for [his wonderful works]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} \w to the children| strong="H1121" \w* \w of men| strong="H120" \w*! 
\v 22 [And let them sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} \w the sacrifices| strong="H2077" \w* \w of thanksgiving| strong="H8426" \w*, [and declare]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} \w his works| strong="H4639" \w* \w with rejoicing| strong="H7440" \w*.\f + \fr 107:22 \ft rejoicing: Heb. singing \f* 
\v 23 [They that go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the sea| strong="H3220" \w* \w in ships| strong="H591" \w*, [that do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w business| strong="H4399" \w* \w in great| strong="H7227" \w* \w waters| strong="H4325" \w*; 
\v 24 [These see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the works| strong="H4639" \w* of the \sc Lord\sc*, [and his wonders]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} \w in the deep| strong="H4688" \w*. 
\v 25 [For he commandeth]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [and raiseth]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8686”} \w the stormy| strong="H5591" \w* \w wind| strong="H7307" \w*, [which lifteth up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8787”} \w the waves| strong="H1530" \w* thereof.\f + \fr 107:25 \ft raiseth: Heb. maketh to stand \f* 
\v 26 [They mount up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the heaven| strong="H8064" \w*, [they go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w again to the depths| strong="H8415" \w*: \w their soul| strong="H5315" \w* [is melted]{strong=“H4127” x-morph=“strongMorph: \sc Th\sc*8709”} \w because of trouble| strong="H7451" \w*. 
\v 27 [They reel to and fro]{strong=“H2287” x-morph=“strongMorph: \sc Th\sc*8799”}, [and stagger]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8799”} \w like a drunken man| strong="H7910" \w*, [and are at their wits’]{strong=“H2451”} [end]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8691”}. \f + \fr 107:27 \ft are…: Heb. all their wisdom is swallowed up \f* 
\v 28 [Then they cry]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc* \w in their trouble| strong="H6862" \w*, [and he bringeth them out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w of their distresses| strong="H4691" \w*. 
\v 29 [He maketh]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8686”} \w the storm| strong="H5591" \w* \w a calm| strong="H1827" \w*, \w so that the waves| strong="H1530" \w* [thereof are still]{strong=“H2814” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 30 [Then are they glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} [because they be quiet]{strong=“H8367” x-morph=“strongMorph: \sc Th\sc*8799”}; [so he bringeth]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8686”} \w them unto their desired| strong="H2656" \w* \w haven| strong="H4231" \w*. 
\v 31 Oh that men [would praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} the \sc Lord\sc* for \w his goodness| strong="H2617" \w*, and for [his wonderful works]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} \w to the children| strong="H1121" \w* \w of men| strong="H120" \w*! 
\v 32 [Let them exalt]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8787”} \w him also in the congregation| strong="H6951" \w* \w of the people| strong="H5971" \w*, [and praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} \w him in the assembly| strong="H4186" \w* \w of the elders| strong="H2205" \w*. 
\v 33 [He turneth]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w rivers| strong="H5104" \w* \w into a wilderness| strong="H4057" \w*, [and the watersprings]{strong=“H4161 H4325”} \w into dry ground| strong="H6774" \w*; 
\v 34 \w A fruitful| strong="H6529" \w* \w land| strong="H776" \w* \w into barrenness| strong="H4420" \w*, \w for the wickedness| strong="H7451" \w* [of them that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} therein.\f + \fr 107:34 \ft barrenness: Heb. saltiness \f* 
\v 35 [He turneth]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w the wilderness| strong="H4057" \w* \w into a standing| strong="H98" \w* \w water| strong="H4325" \w*, \w and dry| strong="H6723" \w* \w ground| strong="H776" \w* [into watersprings]{strong=“H4161 H4325”}. 
\v 36 \w And there he maketh the hungry| strong="H7457" \w* [to dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8686”}, [that they may prepare]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8787”} \w a city| strong="H5892" \w* \w for habitation| strong="H4186" \w*; 
\v 37 [And sow]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8799”} \w the fields| strong="H7704" \w*, [and plant]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8799”} \w vineyards| strong="H3754" \w*, [which may yield]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w fruits| strong="H6529" \w* \w of increase| strong="H8393" \w*. 
\v 38 [He blesseth]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} [them also, so that they are multiplied]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8799”} \w greatly| strong="H3966" \w*; \w and suffereth| strong="H4591" \w* \w not their cattle| strong="H929" \w* [to decrease]{strong=“H4591” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 39 [Again, they are minished]{strong=“H4591” x-morph=“strongMorph: \sc Th\sc*8799”} [and brought low]{strong=“H7817” x-morph=“strongMorph: \sc Th\sc*8799”} \w through oppression| strong="H6115" \w*, \w affliction| strong="H7451" \w*, \w and sorrow| strong="H3015" \w*. 
\v 40 [He poureth]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8802”} \w contempt| strong="H937" \w* \w upon princes| strong="H5081" \w*, [and causeth them to wander]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8686”} \w in the wilderness| strong="H8414" \w*, where there is \w no way| strong="H1870" \w*.\f + \fr 107:40 \ft wilderness: or, void place \f* 
\v 41 \w Yet setteth he the poor| strong="H34" \w* [on high]{strong=“H7682” x-morph=“strongMorph: \sc Th\sc*8762”} \w from affliction| strong="H6040" \w*, [and maketh]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} him \w families| strong="H4940" \w* \w like a flock| strong="H6629" \w*.\f + \fr 107:41 \ft from: or, after \f* 
\v 42 \w The righteous| strong="H3477" \w* [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} it, [and rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”}: \w and all iniquity| strong="H5766" \w* [shall stop]{strong=“H7092” x-morph=“strongMorph: \sc Th\sc*8804”} \w her mouth| strong="H6310" \w*. 
\v 43 Whoso is \w wise| strong="H2450" \w*, [and will observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} these things, [even they shall understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8709”} \w the lovingkindness| strong="H2617" \w* of the \sc Lord\sc*.
\c 108
\p 
\w A Song| strong="H7892" \w* or \w Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 \w O God| strong="H430" \w*, \w my heart| strong="H3820" \w* [is fixed]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8737”}; [I will sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8799”} [and give praise]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8762”}, \w even with my glory| strong="H3519" \w*. 
\v 2 [Awake]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8798”}, \w psaltery| strong="H5035" \w* \w and harp| strong="H3658" \w*: I myself [will awake]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8686”} \w early| strong="H7837" \w*. 
\v 3 [I will praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} thee, O \sc Lord\sc*, \w among the people| strong="H5971" \w*: [and I will sing praises]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto thee among the nations| strong="H3816" \w*. 
\v 4 \w For thy mercy| strong="H2617" \w* is \w great| strong="H1419" \w* \w above the heavens| strong="H8064" \w*: \w and thy truth| strong="H571" \w* reacheth \w unto the clouds| strong="H7834" \w*.\f + \fr 108:4 \ft clouds: or, skies \f* 
\v 5 [Be thou exalted]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O God| strong="H430" \w*, \w above the heavens| strong="H8064" \w*: \w and thy glory| strong="H3519" \w* \w above all the earth| strong="H776" \w*; 
\v 6 \w That thy beloved| strong="H3039" \w* [may be delivered]{strong=“H2502” x-morph=“strongMorph: \sc Th\sc*8735”}: [save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”} with \w thy right hand| strong="H3225" \w*, [and answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8798”} me. 
\v 7 \w God| strong="H430" \w* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w in his holiness| strong="H6944" \w*; [I will rejoice]{strong=“H5937” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will divide]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8762”} \w Shechem| strong="H7927" \w*, [and mete out]{strong=“H4058” x-morph=“strongMorph: \sc Th\sc*8762”} \w the valley| strong="H6010" \w* \w of Succoth| strong="H5523" \w*. 
\v 8 \w Gilead| strong="H1568" \w* is [mine; Manasseh]{strong=“H4519”} is [mine; Ephraim]{strong=“H669”} also is \w the strength| strong="H4581" \w* \w of mine head| strong="H7218" \w*; \w Judah| strong="H3063" \w* is [my lawgiver]{strong=“H2710” x-morph=“strongMorph: \sc Th\sc*8781”}; 
\v 9 \w Moab| strong="H4124" \w* is [my washpot]{strong=“H5518 H7366”}; \w over Edom| strong="H123" \w* [will I cast out]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w my shoe| strong="H5275" \w*; \w over Philistia| strong="H6429" \w* [will I triumph]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8709”}. 
\v 10 [Who will bring]{strong=“H2986” x-morph=“strongMorph: \sc Th\sc*8686”} \w me into the strong| strong="H4013" \w* \w city| strong="H5892" \w*? [who will lead]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8804”} \w me into Edom| strong="H123" \w*? 
\v 11 Wilt not thou, \w O God| strong="H430" \w*, who [hast cast us off]{strong=“H2186” x-morph=“strongMorph: \sc Th\sc*8804”}? [and wilt not thou, O God]{strong=“H430”}, [go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w with our hosts| strong="H6635" \w*? 
\v 12 [Give]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”} \w us help| strong="H5833" \w* \w from trouble| strong="H6862" \w*: \w for vain| strong="H7723" \w* is \w the help| strong="H8668" \w* \w of man| strong="H120" \w*. 
\v 13 \w Through God| strong="H430" \w* [we shall do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w valiantly| strong="H2428" \w*: for he it is that [shall tread down]{strong=“H947” x-morph=“strongMorph: \sc Th\sc*8799”} \w our enemies| strong="H6862" \w*.
\c 109
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 [Hold not thy peace]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8799”}, \w O God| strong="H430" \w* \w of my praise| strong="H8416" \w*; 
\v 2 \w For the mouth| strong="H6310" \w* \w of the wicked| strong="H7563" \w* \w and the mouth| strong="H6310" \w* \w of the deceitful| strong="H4820" \w* [are opened]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8804”} [against me: they have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w against me with a lying| strong="H8267" \w* \w tongue| strong="H3956" \w*.\f + \fr 109:2 \ft of the deceitful: Heb. of deceit \f* \f + \fr 109:2 \ft are opened: Heb. have opened themselves \f* 
\v 3 [They compassed]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8804”} \w me about also with words| strong="H1697" \w* \w of hatred| strong="H8135" \w*; [and fought]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8735”} \w against me without a cause| strong="H2600" \w*. 
\v 4 \w For my love| strong="H160" \w* [they are my adversaries]{strong=“H7853” x-morph=“strongMorph: \sc Th\sc*8799”}: but I give myself unto \w prayer| strong="H8605" \w*. 
\v 5 [And they have rewarded]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w me evil| strong="H7451" \w* \w for good| strong="H2896" \w*, \w and hatred| strong="H8135" \w* \w for my love| strong="H160" \w*. 
\v 6 [Set]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8685”} \w thou a wicked man| strong="H7563" \w* [over him: and let Satan]{strong=“H7854”} [stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w at his right hand| strong="H3225" \w*.\f + \fr 109:6 \ft Satan: or, an adversary \f* 
\v 7 [When he shall be judged]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8736”}, [let him be]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w condemned| strong="H7563" \w*: \w and let his prayer| strong="H8605" \w* \w become sin| strong="H2401" \w*.\f + \fr 109:7 \ft be condemned: Heb. go out guilty, or, wicked \f* 
\v 8 \w Let his days| strong="H3117" \w* \w be few| strong="H4592" \w*; and \w let another| strong="H312" \w* [take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w his office| strong="H6486" \w*.\f + \fr 109:8 \ft office: or, charge \f* 
\v 9 \w Let his children| strong="H1121" \w* \w be fatherless| strong="H3490" \w*, \w and his wife| strong="H802" \w* \w a widow| strong="H490" \w*. 
\v 10 \w Let his children| strong="H1121" \w* [be continually]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8800”} [vagabonds]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8799”}, [and beg]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8765”}: [let them seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8804”} their bread \w also out of their desolate places| strong="H2723" \w*. 
\v 11 [Let the extortioner]{strong=“H5383” x-morph=“strongMorph: \sc Th\sc*8802”} [catch]{strong=“H5367” x-morph=“strongMorph: \sc Th\sc*8762”} [all that he hath; and let the strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} [spoil]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8799”} \w his labour| strong="H3018" \w*. 
\v 12 [Let there be none to extend]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8802”} \w mercy| strong="H2617" \w* [unto him: neither let there be any to favour]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8802”} \w his fatherless children| strong="H3490" \w*. 
\v 13 \w Let his posterity| strong="H319" \w* [be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8687”}; and \w in the generation| strong="H1755" \w* \w following| strong="H312" \w* \w let their name| strong="H8034" \w* [be blotted out]{strong=“H4229” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 14 \w Let the iniquity| strong="H5771" \w* \w of his fathers| strong="H1" \w* [be remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8735”} with the \sc Lord\sc*; \w and let not the sin| strong="H2403" \w* \w of his mother| strong="H517" \w* [be blotted out]{strong=“H4229” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 15 Let them be before the \sc Lord\sc* \w continually| strong="H8548" \w*, [that he may cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8686”} \w the memory| strong="H2143" \w* \w of them from the earth| strong="H776" \w*. 
\v 16 [Because that he remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} [not to shew]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w mercy| strong="H2617" \w*, [but persecuted]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} \w the poor| strong="H6041" \w* \w and needy| strong="H34" \w* \w man| strong="H376" \w*, [that he might even slay]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8788”} [the broken]{strong=“H3512” x-morph=“strongMorph: \sc Th\sc*8737”} \w in heart| strong="H3824" \w*. 
\v 17 [As he loved]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8799”} \w cursing| strong="H7045" \w*, [so let it come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him: as he delighted]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} \w not in blessing| strong="H1293" \w*, [so let it be far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8799”} from him. 
\v 18 [As he clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w himself with cursing| strong="H7045" \w* \w like as with his garment| strong="H4055" \w*, [so let it come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into his bowels| strong="H7130" \w* \w like water| strong="H4325" \w*, \w and like oil| strong="H8081" \w* \w into his bones| strong="H6106" \w*.\f + \fr 109:18 \ft into his bowels: Heb. within him \f* 
\v 19 \w Let it be unto him as the garment| strong="H899" \w* which [covereth]{strong=“H5844” x-morph=“strongMorph: \sc Th\sc*8799”} [him, and for a girdle]{strong=“H4206”} [wherewith he is girded]{strong=“H2296” x-morph=“strongMorph: \sc Th\sc*8799”} \w continually| strong="H8548" \w*. 
\v 20 Let this be \w the reward| strong="H6468" \w* [of mine adversaries]{strong=“H7853” x-morph=“strongMorph: \sc Th\sc*8802”} from the \sc Lord\sc*, [and of them that speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} \w evil| strong="H7451" \w* \w against my soul| strong="H5315" \w*. 
\v 21 [But do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} thou for me, O \sc God\sc* \w the Lord| strong="H136" \w*, [for thy name’s]{strong=“H8034”} [sake: because thy mercy]{strong=“H2617”} is \w good| strong="H2896" \w*, [deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} thou me. 
\v 22 For I am \w poor| strong="H6041" \w* \w and needy| strong="H34" \w*, \w and my heart| strong="H3820" \w* [is wounded]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8804”} \w within| strong="H7130" \w* me. 
\v 23 [I am gone]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8738”} \w like the shadow| strong="H6738" \w* [when it declineth]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8800”}: [I am tossed up and down]{strong=“H5287” x-morph=“strongMorph: \sc Th\sc*8738”} \w as the locust| strong="H697" \w*. 
\v 24 \w My knees| strong="H1290" \w* [are weak]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8804”} \w through fasting| strong="H6685" \w*; \w and my flesh| strong="H1320" \w* [faileth]{strong=“H3584” x-morph=“strongMorph: \sc Th\sc*8804”} \w of fatness| strong="H8081" \w*. 
\v 25 \w I became also a reproach| strong="H2781" \w* unto them: when [they looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [upon me they shaked]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8686”} \w their heads| strong="H7218" \w*. 
\v 26 [Help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8798”} me, O \sc Lord\sc* \w my God| strong="H430" \w*: [O save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”} \w me according to thy mercy| strong="H2617" \w*: 
\v 27 [That they may know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} that this is \w thy hand| strong="H3027" \w*; that thou, \sc Lord\sc*, [hast done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} it. 
\v 28 [Let them curse]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8762”}, [but bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} [thou: when they arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”}, [let them be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}; \w but let thy servant| strong="H5650" \w* [rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 29 [Let mine adversaries]{strong=“H7853” x-morph=“strongMorph: \sc Th\sc*8802”} [be clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w with shame| strong="H3639" \w*, [and let them cover]{strong=“H5844” x-morph=“strongMorph: \sc Th\sc*8799”} \w themselves with their own confusion| strong="H1322" \w*, \w as with a mantle| strong="H4598" \w*. 
\v 30 \w I will greatly| strong="H3966" \w* [praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} the \sc Lord\sc* \w with my mouth| strong="H6310" \w*; [yea, I will praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} \w him among| strong="H8432" \w* \w the multitude| strong="H7227" \w*. 
\v 31 [For he shall stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w at the right hand| strong="H3225" \w* \w of the poor| strong="H34" \w*, [to save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8687”} him [from those that condemn]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} \w his soul| strong="H5315" \w*.\f + \fr 109:31 \ft those…: Heb. the judges of \f*
\c 110
\p 
\w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 The \sc Lord\sc* [said]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w unto my Lord| strong="H113" \w*, [Sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou at my right hand| strong="H3225" \w*, [until I make]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} [thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [thy footstool]{strong=“H7272 H1916”}. 
\v 2 The \sc Lord\sc* [shall send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w the rod| strong="H4294" \w* \w of thy strength| strong="H5797" \w* \w out of Zion| strong="H6726" \w*: [rule]{strong=“H7287” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou in the midst| strong="H7130" \w* [of thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 3 \w Thy people| strong="H5971" \w* shall be \w willing| strong="H5071" \w* \w in the day| strong="H3117" \w* \w of thy power| strong="H2428" \w*, \w in the beauties| strong="H1926" \w* \w of holiness| strong="H6944" \w* \w from the womb| strong="H7358" \w* \w of the morning| strong="H4891" \w*: \w thou hast the dew| strong="H2919" \w* \w of thy youth| strong="H3208" \w*.\f + \fr 110:3 \ft from…: or, more than the womb of the morning: thou shalt have, etc \f* 
\v 4 The \sc Lord\sc* [hath sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”}, [and will not repent]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8735”}, Thou art \w a priest| strong="H3548" \w* \w for ever| strong="H5769" \w* \w after the order| strong="H1700" \w* \w of Melchizedek| strong="H4442" \w*. 
\v 5 \w The Lord| strong="H136" \w* \w at thy right hand| strong="H3225" \w* [shall strike]{strong=“H4272” x-morph=“strongMorph: \sc Th\sc*8804”} \w through kings| strong="H4428" \w* \w in the day| strong="H3117" \w* \w of his wrath| strong="H639" \w*. 
\v 6 [He shall judge]{strong=“H1777” x-morph=“strongMorph: \sc Th\sc*8799”} \w among the heathen| strong="H1471" \w*, [he shall fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} the places \w with the dead bodies| strong="H1472" \w*; [he shall wound]{strong=“H4272” x-morph=“strongMorph: \sc Th\sc*8804”} \w the heads| strong="H7218" \w* \w over many| strong="H7227" \w* \w countries| strong="H776" \w*.\f + \fr 110:6 \ft many: or, great \f* 
\v 7 [He shall drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the brook| strong="H5158" \w* \w in the way| strong="H1870" \w*: [therefore shall he lift up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} \w the head| strong="H7218" \w*.
\c 111
\p 
\v 1 [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*. [I will praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} the \sc Lord\sc* with my \w whole heart| strong="H3824" \w*, \w in the assembly| strong="H5475" \w* \w of the upright| strong="H3477" \w*, and in \w the congregation| strong="H5712" \w*.\f + \fr 111:1 \ft Praise ye…: Heb. Hallelujah \f* 
\v 2 \w The works| strong="H4639" \w* of the \sc Lord\sc* are \w great| strong="H1419" \w*, [sought out]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8803”} \w of all them that have pleasure| strong="H2656" \w* therein. 
\v 3 \w His work| strong="H6467" \w* is \w honourable| strong="H1935" \w* \w and glorious| strong="H1926" \w*: \w and his righteousness| strong="H6666" \w* [endureth]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w for ever| strong="H5703" \w*. 
\v 4 [He hath made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [his wonderful works]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} \w to be remembered| strong="H2143" \w*: the \sc Lord\sc* is \w gracious| strong="H2587" \w* \w and full of compassion| strong="H7349" \w*. 
\v 5 [He hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w meat| strong="H2964" \w* \w unto them that fear| strong="H3373" \w* [him: he will ever]{strong=“H5769”} [be mindful]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w of his covenant| strong="H1285" \w*.\f + \fr 111:5 \ft meat: Heb. prey \f* 
\v 6 [He hath shewed]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} \w his people| strong="H5971" \w* \w the power| strong="H3581" \w* \w of his works| strong="H4639" \w*, [that he may give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w them the heritage| strong="H5159" \w* \w of the heathen| strong="H1471" \w*. 
\v 7 \w The works| strong="H4639" \w* \w of his hands| strong="H3027" \w* are \w verity| strong="H571" \w* \w and judgment| strong="H4941" \w*; \w all his commandments| strong="H6490" \w* are [sure]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8737”}. 
\v 8 [They stand fast]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8803”} \w for ever| strong="H5703" \w* \w and ever| strong="H5769" \w*, and are [done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8803”} \w in truth| strong="H571" \w* \w and uprightness| strong="H3477" \w*.\f + \fr 111:8 \ft stand…: Heb. are established \f* 
\v 9 [He sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w redemption| strong="H6304" \w* \w unto his people| strong="H5971" \w*: [he hath commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w his covenant| strong="H1285" \w* \w for ever| strong="H5769" \w*: \w holy| strong="H6918" \w* [and reverend]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”} is \w his name| strong="H8034" \w*. 
\v 10 \w The fear| strong="H3374" \w* of the \sc Lord\sc* is \w the beginning| strong="H7225" \w* \w of wisdom| strong="H2451" \w*: \w a good| strong="H2896" \w* \w understanding| strong="H7922" \w* [have all they that do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} his commandments: \w his praise| strong="H8416" \w* [endureth]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w for ever| strong="H5703" \w*.\f + \fr 111:10 \ft a good…: or, good success \f* \f + \fr 111:10 \ft his commandments: Heb. them \f*
\c 112
\p 
\v 1 [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*. \w Blessed| strong="H835" \w* is \w the man| strong="H376" \w* that [feareth]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, that [delighteth]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} \w greatly| strong="H3966" \w* \w in his commandments| strong="H4687" \w*.\f + \fr 112:1 \ft Praise…: Heb. Hallelujah \f* 
\v 2 \w His seed| strong="H2233" \w* \w shall be mighty| strong="H1368" \w* \w upon earth| strong="H776" \w*: \w the generation| strong="H1755" \w* \w of the upright| strong="H3477" \w* [shall be blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8792”}. 
\v 3 \w Wealth| strong="H1952" \w* \w and riches| strong="H6239" \w* shall be \w in his house| strong="H1004" \w*: \w and his righteousness| strong="H6666" \w* [endureth]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w for ever| strong="H5703" \w*. 
\v 4 \w Unto the upright| strong="H3477" \w* [there ariseth]{strong=“H2224” x-morph=“strongMorph: \sc Th\sc*8804”} \w light| strong="H216" \w* \w in the darkness| strong="H2822" \w*: he is \w gracious| strong="H2587" \w*, \w and full of compassion| strong="H7349" \w*, \w and righteous| strong="H6662" \w*. 
\v 5 \w A good| strong="H2896" \w* \w man| strong="H376" \w* [sheweth favour]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8802”}, [and lendeth]{strong=“H3867” x-morph=“strongMorph: \sc Th\sc*8688”}: [he will guide]{strong=“H3557” x-morph=“strongMorph: \sc Th\sc*8770”} \w his affairs| strong="H1697" \w* \w with discretion| strong="H4941" \w*.\f + \fr 112:5 \ft discretion: Heb. judgment \f* 
\v 6 [Surely he shall not be moved]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8735”} \w for ever| strong="H5769" \w*: \w the righteous| strong="H6662" \w* \w shall be in everlasting| strong="H5769" \w* \w remembrance| strong="H2143" \w*. 
\v 7 [He shall not be afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w of evil| strong="H7451" \w* \w tidings| strong="H8052" \w*: \w his heart| strong="H3820" \w* [is fixed]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8737”}, [trusting]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8803”} in the \sc Lord\sc*. 
\v 8 \w His heart| strong="H3820" \w* is [established]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8803”}, [he shall not be afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}, [until he see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} his desire \w upon his enemies| strong="H6862" \w*. 
\v 9 [He hath dispersed]{strong=“H6340” x-morph=“strongMorph: \sc Th\sc*8765”}, [he hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the poor| strong="H34" \w*; \w his righteousness| strong="H6666" \w* [endureth]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w for ever| strong="H5703" \w*; \w his horn| strong="H7161" \w* [shall be exalted]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8799”} \w with honour| strong="H3519" \w*. 
\v 10 \w The wicked| strong="H7563" \w* [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} it, [and be grieved]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8804”}; [he shall gnash]{strong=“H2786” x-morph=“strongMorph: \sc Th\sc*8799”} \w with his teeth| strong="H8127" \w*, [and melt away]{strong=“H4549” x-morph=“strongMorph: \sc Th\sc*8738”}: \w the desire| strong="H8378" \w* \w of the wicked| strong="H7563" \w* [shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}.
\c 113
\p 
\v 1 [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*. [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”}, \w O ye servants| strong="H5650" \w* of the \sc Lord\sc*, [praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} \w the name| strong="H8034" \w* of the \sc Lord\sc*.\f + \fr 113:1 \ft Praise ye…: Heb. Hallelujah \f* 
\v 2 [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8794”} \w be the name| strong="H8034" \w* of the \sc Lord\sc* \w from this time forth| strong="H6258" \w* \w and for| strong="H5704" \w* \w evermore| strong="H5769" \w*. 
\v 3 \w From the rising| strong="H4217" \w* \w of the sun| strong="H8121" \w* \w unto the going down| strong="H3996" \w* of the same the \sc Lord\sc*’S \w name| strong="H8034" \w* is [to be praised]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8794”}. 
\v 4 The \sc Lord\sc* is [high]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8802”} \w above all nations| strong="H1471" \w*, and \w his glory| strong="H3519" \w* \w above the heavens| strong="H8064" \w*. 
\v 5 Who is like unto the \sc Lord\sc* \w our God| strong="H430" \w*, [who dwelleth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} [on high]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8688”},\f + \fr 113:5 \ft dwelleth…: Heb. exalteth himself to dwell \f* 
\v 6 [Who humbleth]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8688”} himself [to behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} the things that are \w in heaven| strong="H8064" \w*, \w and in the earth| strong="H776" \w*! 
\v 7 [He raiseth up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8688”} \w the poor| strong="H1800" \w* \w out of the dust| strong="H6083" \w*, and [lifteth]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} \w the needy| strong="H34" \w* \w out of the dunghill| strong="H830" \w*; 
\v 8 [That he may set]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8687”} him \w with princes| strong="H5081" \w*, even \w with the princes| strong="H5081" \w* \w of his people| strong="H5971" \w*. 
\v 9 \w He maketh the barren woman| strong="H6135" \w* [to keep]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8688”} \w house| strong="H1004" \w*, and to be \w a joyful| strong="H8056" \w* \w mother| strong="H517" \w* \w of children| strong="H1121" \w*. [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*.\f + \fr 113:9 \ft to keep…: Heb. to dwell in an house \f*
\c 114
\p 
\v 1 \w When Israel| strong="H3478" \w* [went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”} \w of Egypt| strong="H4714" \w*, \w the house| strong="H1004" \w* \w of Jacob| strong="H3290" \w* \w from a people| strong="H5971" \w* [of strange language]{strong=“H3937” x-morph=“strongMorph: \sc Th\sc*8802”}; 
\v 2 \w Judah| strong="H3063" \w* \w was his sanctuary| strong="H6944" \w*, and \w Israel| strong="H3478" \w* \w his dominion| strong="H4475" \w*. 
\v 3 \w The sea| strong="H3220" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} it, [and fled]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”}: \w Jordan| strong="H3383" \w* [was driven]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8735”} \w back| strong="H268" \w*. 
\v 4 \w The mountains| strong="H2022" \w* [skipped]{strong=“H7540” x-morph=“strongMorph: \sc Th\sc*8804”} \w like rams| strong="H352" \w*, and \w the little hills| strong="H1389" \w* [like lambs]{strong=“H6629 H1121”}. 
\v 5 What ailed [thee, O thou sea]{strong=“H3220”}, [that thou fleddest]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”}? \w thou Jordan| strong="H3383" \w*, that [thou wast driven]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8735”} \w back| strong="H268" \w*? 
\v 6 \w Ye mountains| strong="H2022" \w*, that [ye skipped]{strong=“H7540” x-morph=“strongMorph: \sc Th\sc*8799”} \w like rams| strong="H352" \w*; and \w ye little hills| strong="H1389" \w*, [like lambs]{strong=“H6629 H1121”}? 
\v 7 [Tremble]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8798”}, \w thou earth| strong="H776" \w*, \w at the presence| strong="H6440" \w* \w of the Lord| strong="H113" \w*, \w at the presence| strong="H6440" \w* \w of the God| strong="H433" \w* \w of Jacob| strong="H3290" \w*; 
\v 8 [Which turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8802”} \w the rock| strong="H6697" \w* into \w a standing| strong="H98" \w* \w water| strong="H4325" \w*, \w the flint| strong="H2496" \w* \w into a fountain| strong="H4599" \w* \w of waters| strong="H4325" \w*. 
\c 115
\p 
\v 1 Not unto us, O \sc Lord\sc*, [not unto us, but unto thy name]{strong=“H8034”} [give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w glory| strong="H3519" \w*, \w for thy mercy| strong="H2617" \w*, and [for thy truth’s]{strong=“H571”} sake. 
\v 2 \w Wherefore should the heathen| strong="H1471" \w* [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Where is \w now their God| strong="H430" \w*? 
\v 3 \w But our God| strong="H430" \w* is \w in the heavens| strong="H8064" \w*: [he hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [whatsoever he hath pleased]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 4 \w Their idols| strong="H6091" \w* are \w silver| strong="H3701" \w* \w and gold| strong="H2091" \w*, \w the work| strong="H4639" \w* [of men’s]{strong=“H120”} \w hands| strong="H3027" \w*. 
\v 5 \w They have mouths| strong="H6310" \w*, [but they speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [not: eyes]{strong=“H5869”} [have they, but they see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} not: 
\v 6 \w They have ears| strong="H241" \w*, [but they hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [not: noses]{strong=“H639”} [have they, but they smell]{strong=“H7306” x-morph=“strongMorph: \sc Th\sc*8686”} not: 
\v 7 \w They have hands| strong="H3027" \w*, [but they handle]{strong=“H4184” x-morph=“strongMorph: \sc Th\sc*8686”} [not: feet]{strong=“H7272”} [have they, but they walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8762”} [not: neither speak]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8799”} \w they through their throat| strong="H1627" \w*. 
\v 8 [They that make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} them are like unto them; so is [every one that trusteth]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”} in them. 
\v 9 \w O Israel| strong="H3478" \w*, [trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8798”} thou in the \sc Lord\sc*: he is \w their help| strong="H5828" \w* \w and their shield| strong="H4043" \w*. 
\v 10 \w O house| strong="H1004" \w* \w of Aaron| strong="H175" \w*, [trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8798”} in the \sc Lord\sc*: he is \w their help| strong="H5828" \w* \w and their shield| strong="H4043" \w*. 
\v 11 \w Ye that fear| strong="H3373" \w* the \sc Lord\sc*, [trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8798”} in the \sc Lord\sc*: he is \w their help| strong="H5828" \w* \w and their shield| strong="H4043" \w*. 
\v 12 The \sc Lord\sc* [hath been mindful]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} [of us: he will bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} us; [he will bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*; [he will bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w the house| strong="H1004" \w* \w of Aaron| strong="H175" \w*. 
\v 13 [He will bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w them that fear| strong="H3373" \w* the \sc Lord\sc*, both \w small| strong="H6996" \w* \w and great| strong="H1419" \w*.\f + \fr 115:13 \ft and: Heb. with \f* 
\v 14 The \sc Lord\sc* [shall increase]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [you more and more, you and your children]{strong=“H1121”}. 
\v 15 Ye are [blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} of the \sc Lord\sc* [which made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w heaven| strong="H8064" \w* \w and earth| strong="H776" \w*. 
\v 16 \w The heaven| strong="H8064" \w*, even \w the heavens| strong="H8064" \w*, are the \sc Lord\sc*’S: \w but the earth| strong="H776" \w* [hath he given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the children| strong="H1121" \w* \w of men| strong="H120" \w*. 
\v 17 [The dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”} [praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} not the \sc Lord\sc*, [neither any that go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w into silence| strong="H1745" \w*. 
\v 18 [But we will bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} the \sc Lord\sc* \w from this time forth and for| strong="H5704" \w* \w evermore| strong="H5769" \w*. [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc*.
\c 116
\p 
\v 1 [I love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [because he hath heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w my voice| strong="H6963" \w* and \w my supplications| strong="H8469" \w*. 
\v 2 [Because he hath inclined]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8689”} \w his ear| strong="H241" \w* [unto me, therefore will I call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} upon him \w as long as I live| strong="H3117" \w*.\f + \fr 116:2 \ft as long…: Heb. in my days \f* 
\v 3 \w The sorrows| strong="H2256" \w* \w of death| strong="H4194" \w* [compassed]{strong=“H661” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and the pains]{strong=“H4712”} \w of hell| strong="H7585" \w* [gat hold]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} [upon me: I found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w trouble| strong="H6869" \w* \w and sorrow| strong="H3015" \w*.\f + \fr 116:3 \ft gat…: Heb. found me \f* 
\v 4 [Then called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w I upon the name| strong="H8034" \w* of the \sc Lord\sc*; O \sc Lord\sc*, \w I beseech| strong="H577" \w* [thee, deliver]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8761”} \w my soul| strong="H5315" \w*. 
\v 5 \w Gracious| strong="H2587" \w* is the \sc Lord\sc*, \w and righteous| strong="H6662" \w*; [yea, our God]{strong=“H430”} is [merciful]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8764”}. 
\v 6 The \sc Lord\sc* [preserveth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w the simple| strong="H6612" \w*: [I was brought low]{strong=“H1809” x-morph=“strongMorph: \sc Th\sc*8804”}, [and he helped]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} me. 
\v 7 [Return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto thy rest| strong="H4494" \w*, \w O my soul| strong="H5315" \w*; for the \sc Lord\sc* [hath dealt bountifully]{strong=“H1580” x-morph=“strongMorph: \sc Th\sc*8804”} with thee. 
\v 8 [For thou hast delivered]{strong=“H2502” x-morph=“strongMorph: \sc Th\sc*8765”} \w my soul| strong="H5315" \w* \w from death| strong="H4194" \w*, \w mine eyes| strong="H5869" \w* \w from tears| strong="H1832" \w*, and \w my feet| strong="H7272" \w* \w from falling| strong="H1762" \w*. 
\v 9 [I will walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8691”} \w before| strong="H6440" \w* the \sc Lord\sc* \w in the land| strong="H776" \w* \w of the living| strong="H2416" \w*. 
\v 10 [I believed]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8689”}, [therefore have I spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}: \w I was greatly| strong="H3966" \w* [afflicted]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8804”}: 
\v 11 [I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [in my haste]{strong=“H2648” x-morph=“strongMorph: \sc Th\sc*8800”}, \w All men| strong="H120" \w* are [liars]{strong=“H3576” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 12 [What shall I render]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} unto the \sc Lord\sc* for \w all his benefits| strong="H8408" \w* toward me? 
\v 13 [I will take]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w the cup| strong="H3563" \w* \w of salvation| strong="H3444" \w*, [and call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the name| strong="H8034" \w* of the \sc Lord\sc*. 
\v 14 [I will pay]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w my vows| strong="H5088" \w* unto the \sc Lord\sc* \w now in the presence of all his people| strong="H5971" \w*. 
\v 15 \w Precious| strong="H3368" \w* \w in the sight| strong="H5869" \w* of the \sc Lord\sc* is \w the death| strong="H4194" \w* \w of his saints| strong="H2623" \w*. 
\v 16 O \sc Lord\sc*, \w truly| strong="H577" \w* I am \w thy servant| strong="H5650" \w*; I am \w thy servant| strong="H5650" \w*, and \w the son| strong="H1121" \w* \w of thine handmaid| strong="H519" \w*: [thou hast loosed]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8765”} \w my bonds| strong="H4147" \w*. 
\v 17 [I will offer]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} \w to thee the sacrifice| strong="H2077" \w* \w of thanksgiving| strong="H8426" \w*, [and will call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the name| strong="H8034" \w* of the \sc Lord\sc*. 
\v 18 [I will pay]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w my vows| strong="H5088" \w* unto the \sc Lord\sc* \w now in the presence of all his people| strong="H5971" \w*, 
\v 19 \w In the courts| strong="H2691" \w* of the \sc Lord\sc*’S \w house| strong="H1004" \w*, \w in the midst| strong="H8432" \w* [of thee, O Jerusalem]{strong=“H3389”}. [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*.
\c 117
\p 
\v 1 [O praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc*, \w all ye nations| strong="H1471" \w*: [praise]{strong=“H7623” x-morph=“strongMorph: \sc Th\sc*8761”} [him, all ye people]{strong=“H523”}. 
\v 2 \w For his merciful| strong="H2617" \w* \w kindness| strong="H2617" \w* [is great]{strong=“H1396” x-morph=“strongMorph: \sc Th\sc*8804”} [toward us: and the truth]{strong=“H571”} of the \sc Lord\sc* endureth \w for ever| strong="H5769" \w*. [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*. 
\c 118
\p 
\v 1 [O give thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8685”} unto the \sc Lord\sc*; for he is \w good| strong="H2896" \w*: \w because his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*. 
\v 2 \w Let Israel| strong="H3478" \w* [now say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w that his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*. 
\v 3 \w Let the house| strong="H1004" \w* \w of Aaron| strong="H175" \w* [now say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w that his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*. 
\v 4 \w Let them now that fear| strong="H3373" \w* the \sc Lord\sc* [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w that his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*. 
\v 5 [I called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} upon the \sc Lord\sc* \w in distress| strong="H4712" \w*: the \sc Lord\sc* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”} me, and set me \w in a large place| strong="H4800" \w*.\f + \fr 118:5 \ft in distress: Heb. out of distress \f* 
\v 6 The \sc Lord\sc* is [on my side; I will not fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}: \w what can| strong="H6213" \w* \w man| strong="H120" \w* [do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} unto me?\f + \fr 118:6 \ft on…: Heb. for me \f* 
\v 7 The \sc Lord\sc* [taketh my part with them that help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8802”} [me: therefore shall I see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} my desire [upon them that hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} me. 
\v 8 It is \w better| strong="H2896" \w* [to trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8800”} in the \sc Lord\sc* [than to put confidence]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8800”} \w in man| strong="H120" \w*. 
\v 9 It is \w better| strong="H2896" \w* [to trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8800”} in the \sc Lord\sc* [than to put confidence]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8800”} \w in princes| strong="H5081" \w*. 
\v 10 \w All nations| strong="H1471" \w* [compassed me about]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8804”}: \w but in the name| strong="H8034" \w* of the \sc Lord\sc* [will I destroy]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8686”} them.\f + \fr 118:10 \ft destroy…: Heb. cut them off \f* 
\v 11 [They compassed me about]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8804”}; [yea, they compassed me about]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8804”}: \w but in the name| strong="H8034" \w* of the \sc Lord\sc* [I will destroy]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8686”} them. 
\v 12 [They compassed me about]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8804”} \w like bees| strong="H1682" \w*; [they are quenched]{strong=“H1846” x-morph=“strongMorph: \sc Th\sc*8795”} \w as the fire| strong="H784" \w* \w of thorns| strong="H6975" \w*: \w for in the name| strong="H8034" \w* of the \sc Lord\sc* [I will destroy]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8686”} them.\f + \fr 118:12 \ft destroy: Heb. cut down \f* 
\v 13 [Thou hast thrust]{strong=“H1760” x-morph=“strongMorph: \sc Th\sc*8804”} [sore]{strong=“H1760” x-morph=“strongMorph: \sc Th\sc*8800”} [at me that I might fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8800”}: but the \sc Lord\sc* [helped]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8804”} me. 
\v 14 The \sc Lord\sc* is \w my strength| strong="H5797" \w* \w and song| strong="H2176" \w*, \w and is become my salvation| strong="H3444" \w*. 
\v 15 \w The voice| strong="H6963" \w* \w of rejoicing| strong="H7440" \w* \w and salvation| strong="H3444" \w* is \w in the tabernacles| strong="H168" \w* \w of the righteous| strong="H6662" \w*: \w the right hand| strong="H3225" \w* of the \sc Lord\sc* [doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w valiantly| strong="H2428" \w*. 
\v 16 \w The right hand| strong="H3225" \w* of the \sc Lord\sc* [is exalted]{strong=“H7426” x-morph=“strongMorph: \sc Th\sc*8802”}: \w the right hand| strong="H3225" \w* of the \sc Lord\sc* [doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w valiantly| strong="H2428" \w*. 
\v 17 [I shall not die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, [but live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}, [and declare]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} \w the works| strong="H4639" \w* of the \sc Lord\sc*. 
\v 18 The \sc Lord\sc* [hath chastened]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8765”} [me sore]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8763”}: [but he hath not given me over]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto death| strong="H4194" \w*. 
\v 19 [Open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8798”} \w to me the gates| strong="H8179" \w* \w of righteousness| strong="H6664" \w*: [I will go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} into them, and [I will praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} the \sc Lord\sc*: 
\v 20 \w This gate| strong="H8179" \w* of the \sc Lord\sc*, \w into which the righteous| strong="H6662" \w* [shall enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 21 [I will praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} [thee: for thou hast heard]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and art become my salvation]{strong=“H3444”}. 
\v 22 \w The stone| strong="H68" \w* which [the builders]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8802”} [refused]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} \w is become the head| strong="H7218" \w* stone \w of the corner| strong="H6438" \w*. 
\v 23 This is the \sc Lord\sc*’S doing; it is [marvellous]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8738”} \w in our eyes| strong="H5869" \w*.^\sc 118:23 the [Lord\sc*’s…: Heb. from the \sc Lord\sc*] 
\v 24 This is \w the day| strong="H3117" \w* which the \sc Lord\sc* [hath made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}; [we will rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”} [and be glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} in it. 
\v 25 [Save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”} [now, I beseech]{strong=“H577”} thee, O \sc Lord\sc*: O \sc Lord\sc*, \w I beseech| strong="H577" \w* [thee, send now prosperity]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8685”}. 
\v 26 [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} be [he that cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the name| strong="H8034" \w* of the \sc Lord\sc*: [we have blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} \w you out of the house| strong="H1004" \w* of the \sc Lord\sc*. 
\v 27 \w God| strong="H410" \w* is the \sc Lord\sc*, [which hath shewed us light]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8686”}: [bind]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8798”} \w the sacrifice| strong="H2282" \w* \w with cords| strong="H5688" \w*, even \w unto the horns| strong="H7161" \w* \w of the altar| strong="H4196" \w*. 
\v 28 Thou art \w my God| strong="H410" \w*, [and I will praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} thee: thou art \w my God| strong="H430" \w*, [I will exalt]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8787”} thee. 
\v 29 [O give thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8685”} unto the \sc Lord\sc*; for he is \w good| strong="H2896" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*.
\c 119
\p 
#
# 
א \sc Aleph\sc*. 
\v 1 \w Blessed| strong="H835" \w* are \w the undefiled| strong="H8549" \w* \w in the way| strong="H1870" \w*, [who walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the law| strong="H8451" \w* of the \sc Lord\sc*.\f + \fr 119:1 \ft undefiled: or, perfect, or, sincere \f* 
\v 2 \w Blessed| strong="H835" \w* are [they that keep]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8802”} \w his testimonies| strong="H5713" \w*, and that [seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”} \w him with the whole heart| strong="H3820" \w*. 
\v 3 [They also do]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8804”} \w no iniquity| strong="H5766" \w*: [they walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his ways| strong="H1870" \w*. 
\v 4 [Thou hast commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} us [to keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy precepts| strong="H6490" \w* \w diligently| strong="H3966" \w*. 
\v 5 \w O that| strong="H305" \w* \w my ways| strong="H1870" \w* [were directed]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8735”} [to keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy statutes| strong="H2706" \w*! 
\v 6 [Then shall I not be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}, [when I have respect]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8687”} \w unto all thy commandments| strong="H4687" \w*. 
\v 7 [I will praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee with uprightness| strong="H3476" \w* \w of heart| strong="H3824" \w*, [when I shall have learned]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy righteous| strong="H6664" \w* \w judgments| strong="H4941" \w*.\f + \fr 119:7 \ft thy…: Heb. judgments of thy righteousness \f* 
\v 8 [I will keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy statutes| strong="H2706" \w*: [O forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w me not utterly| strong="H3966" \w*.
\p
#
# 
ב \sc Beth\sc*. 
\v 9 \w Wherewithal shall a young man| strong="H5288" \w* [cleanse]{strong=“H2135” x-morph=“strongMorph: \sc Th\sc*8762”} \w his way| strong="H734" \w*? [by taking heed]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} thereto \w according to thy word| strong="H1697" \w*. 
\v 10 \w With my whole heart| strong="H3820" \w* [have I sought]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8804”} [thee: O let me not wander]{strong=“H7686” x-morph=“strongMorph: \sc Th\sc*8686”} \w from thy commandments| strong="H4687" \w*. 
\v 11 \w Thy word| strong="H565" \w* [have I hid]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8804”} \w in mine heart| strong="H3820" \w*, [that I might not sin]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8799”} against thee. 
\v 12 [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} art thou, O \sc Lord\sc*: [teach]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8761”} \w me thy statutes| strong="H2706" \w*. 
\v 13 \w With my lips| strong="H8193" \w* [have I declared]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8765”} \w all the judgments| strong="H4941" \w* \w of thy mouth| strong="H6310" \w*. 
\v 14 [I have rejoiced]{strong=“H7797” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the way| strong="H1870" \w* \w of thy testimonies| strong="H5715" \w*, as much as \w in| strong="H5921" \w* \w all riches| strong="H1952" \w*. 
\v 15 [I will meditate]{strong=“H7878” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy precepts| strong="H6490" \w*, [and have respect]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto thy ways| strong="H734" \w*. 
\v 16 [I will delight]{strong=“H8173” x-morph=“strongMorph: \sc Th\sc*8698”} \w myself in thy statutes| strong="H2708" \w*: [I will not forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy word| strong="H1697" \w*. 
#
# 
ג \sc Gimel\sc*. 
\v 17 [Deal bountifully]{strong=“H1580” x-morph=“strongMorph: \sc Th\sc*8798”} \w with thy servant| strong="H5650" \w*, that [I may live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}, [and keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy word| strong="H1697" \w*. 
\v 18 [Open]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8761”} \w thou mine eyes| strong="H5869" \w*, [that I may behold]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”} [wondrous things]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} \w out of thy law| strong="H8451" \w*.\f + \fr 119:18 \ft Open: Heb. Reveal \f* 
\v 19 I am \w a stranger| strong="H1616" \w* \w in the earth| strong="H776" \w*: [hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8686”} \w not thy commandments| strong="H4687" \w* from me. 
\v 20 \w My soul| strong="H5315" \w* [breaketh]{strong=“H1638” x-morph=“strongMorph: \sc Th\sc*8804”} \w for the longing| strong="H8375" \w* that it hath \w unto thy judgments| strong="H4941" \w* \w at all times| strong="H6256" \w*. 
\v 21 [Thou hast rebuked]{strong=“H1605” x-morph=“strongMorph: \sc Th\sc*8804”} \w the proud| strong="H2086" \w* that are [cursed]{strong=“H779” x-morph=“strongMorph: \sc Th\sc*8803”}, [which do err]{strong=“H7686” x-morph=“strongMorph: \sc Th\sc*8802”} \w from thy commandments| strong="H4687" \w*. 
\v 22 [Remove]{strong=“H1556” x-morph=“strongMorph: \sc Th\sc*8798”} \w from me reproach| strong="H2781" \w* \w and contempt| strong="H937" \w*; [for I have kept]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy testimonies| strong="H5713" \w*. 
\v 23 \w Princes| strong="H8269" \w* [also did sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} and [speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8738”} against me: but \w thy servant| strong="H5650" \w* [did meditate]{strong=“H7878” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy statutes| strong="H2706" \w*. 
\v 24 \w Thy testimonies| strong="H5713" \w* also are \w my delight| strong="H8191" \w* and [my counsellors]{strong=“H6098 H582”}.\f + \fr 119:24 \ft my counsellors: Heb. men of my counsel \f*
\p
#
# 
ד \sc Daleth\sc*. 
\v 25 \w My soul| strong="H5315" \w* [cleaveth ]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the dust| strong="H6083" \w*: [quicken]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8761”} \w thou me according to thy word| strong="H1697" \w*. 
\v 26 [I have declared]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8765”} \w my ways| strong="H1870" \w*, [and thou heardest]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [me: teach]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8761”} \w me thy statutes| strong="H2706" \w*. 
\v 27 [Make me to understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8685”} \w the way| strong="H1870" \w* \w of thy precepts| strong="H6490" \w*: [so shall I talk]{strong=“H7878” x-morph=“strongMorph: \sc Th\sc*8799”} [of thy wondrous works]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”}. 
\v 28 \w My soul| strong="H5315" \w* [melteth]{strong=“H1811” x-morph=“strongMorph: \sc Th\sc*8804”} \w for heaviness| strong="H8424" \w*: [strengthen]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8761”} \w thou me according unto thy word| strong="H1697" \w*.\f + \fr 119:28 \ft melteth: Heb. droppeth \f* 
\v 29 [Remove]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8685”} \w from me the way| strong="H1870" \w* \w of lying| strong="H8267" \w*: \w and grant me thy law| strong="H8451" \w* [graciously]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”}. 
\v 30 [I have chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} \w the way| strong="H1870" \w* \w of truth| strong="H530" \w*: \w thy judgments| strong="H4941" \w* [have I laid]{strong=“H7737” x-morph=“strongMorph: \sc Th\sc*8765”} before me. 
\v 31 [I have stuck]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto thy testimonies| strong="H5715" \w*: O \sc Lord\sc*, [put me not to shame]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 32 [I will run]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”} \w the way| strong="H1870" \w* \w of thy commandments| strong="H4687" \w*, [when thou shalt enlarge]{strong=“H7337” x-morph=“strongMorph: \sc Th\sc*8686”} \w my heart| strong="H3820" \w*. 
\p
#
# 
ה \sc He\sc*. 
\v 33 [Teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8685”} me, O \sc Lord\sc*, \w the way| strong="H1870" \w* \w of thy statutes| strong="H2706" \w*; [and I shall keep]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8799”} it unto \w the end| strong="H6118" \w*. 
\v 34 [Give me understanding]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8685”}, [and I shall keep]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy law| strong="H8451" \w*; [yea, I shall observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} it with my \w whole heart| strong="H3820" \w*. 
\v 35 [Make me to go]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8685”} \w in the path| strong="H5410" \w* \w of thy commandments| strong="H4687" \w*; [for therein do I delight]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 36 [Incline]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8685”} \w my heart| strong="H3820" \w* \w unto thy testimonies| strong="H5715" \w*, \w and not to covetousness| strong="H1215" \w*. 
\v 37 [Turn away]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8685”} \w mine eyes| strong="H5869" \w* [from beholding]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w vanity| strong="H7723" \w*; and [quicken]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8761”} \w thou me in thy way| strong="H1870" \w*.\f + \fr 119:37 \ft Turn…: Heb. Make to pass \f* 
\v 38 [Stablish]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8685”} \w thy word| strong="H565" \w* \w unto thy servant| strong="H5650" \w*, who is devoted \w to thy fear| strong="H3374" \w*. 
\v 39 [Turn away]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8685”} \w my reproach| strong="H2781" \w* [which I fear]{strong=“H3025” x-morph=“strongMorph: \sc Th\sc*8804”}: \w for thy judgments| strong="H4941" \w* are \w good| strong="H2896" \w*. 
\v 40 [Behold, I have longed]{strong=“H8373” x-morph=“strongMorph: \sc Th\sc*8804”} \w after thy precepts| strong="H6490" \w*: [quicken]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8761”} \w me in thy righteousness| strong="H6666" \w*. 
\p
#
# 
ו \sc Vau\sc*. 
\v 41 \w Let thy mercies| strong="H2617" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} also unto me, O \sc Lord\sc*, even \w thy salvation| strong="H8668" \w*, \w according to thy word| strong="H565" \w*. 
\v 42 \w So shall I have wherewith| strong="H1697" \w* [to answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [him that reproacheth]{strong=“H2778” x-morph=“strongMorph: \sc Th\sc*8802”} [me: for I trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thy word| strong="H1697" \w*.\f + \fr 119:42 \ft So…: or, So shall I answer him that reproveth me in a thing \f* 
\v 43 [And take]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w not the word| strong="H1697" \w* \w of truth| strong="H571" \w* \w utterly| strong="H3966" \w* \w out of my mouth| strong="H6310" \w*; [for I have hoped]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8765”} \w in thy judgments| strong="H4941" \w*. 
\v 44 [So shall I keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy law| strong="H8451" \w* \w continually| strong="H8548" \w* \w for ever| strong="H5769" \w* \w and ever| strong="H5703" \w*. 
\v 45 [And I will walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8691”} \w at liberty| strong="H7342" \w*: [for I seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy precepts| strong="H6490" \w*.\f + \fr 119:45 \ft at liberty: Heb. at large \f* 
\v 46 [I will speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w of thy testimonies| strong="H5713" \w* \w also before kings| strong="H4428" \w*, [and will not be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 47 [And I will delight]{strong=“H8173” x-morph=“strongMorph: \sc Th\sc*8698”} \w myself in thy commandments| strong="H4687" \w*, [which I have loved]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 48 \w My hands| strong="H3709" \w* [also will I lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto thy commandments| strong="H4687" \w*, [which I have loved]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”}; [and I will meditate]{strong=“H7878” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy statutes| strong="H2706" \w*.
\p
#
# 
ז \sc Zain\sc*. 
\v 49 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* \w unto thy servant| strong="H5650" \w*, [upon which thou hast caused me to hope]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 50 This is \w my comfort| strong="H5165" \w* \w in my affliction| strong="H6040" \w*: \w for thy word| strong="H565" \w* [hath quickened]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8765”} me. 
\v 51 \w The proud| strong="H2086" \w* \w have had me greatly| strong="H3966" \w* [in derision]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8689”}: yet [have I not declined]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} \w from thy law| strong="H8451" \w*. 
\v 52 [I remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy judgments| strong="H4941" \w* \w of old| strong="H5769" \w*, O \sc Lord\sc*; [and have comforted]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8691”} myself. 
\v 53 \w Horror| strong="H2152" \w* [hath taken hold]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon me because of the wicked| strong="H7563" \w* [that forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8802”} \w thy law| strong="H8451" \w*. 
\v 54 \w Thy statutes| strong="H2706" \w* \w have been my songs| strong="H2158" \w* \w in the house| strong="H1004" \w* \w of my pilgrimage| strong="H4033" \w*. 
\v 55 [I have remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy name| strong="H8034" \w*, O \sc Lord\sc*, \w in the night| strong="H3915" \w*, [and have kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy law| strong="H8451" \w*. 
\v 56 [This I had, because I kept]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy precepts| strong="H6490" \w*. 
#
# 
ח \sc Cheth\sc*. 
\v 57 Thou art \w my portion| strong="H2506" \w*, O \sc Lord\sc*: [I have said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [that I would keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy words| strong="H1697" \w*. 
\v 58 [I intreated]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy favour| strong="H6440" \w* with my \w whole heart| strong="H3820" \w*: [be merciful]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto me according to thy word| strong="H565" \w*.\f + \fr 119:58 \ft favour: Heb. face \f* 
\v 59 [I thought]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8765”} \w on my ways| strong="H1870" \w*, [and turned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w my feet| strong="H7272" \w* \w unto thy testimonies| strong="H5713" \w*. 
\v 60 [I made haste]{strong=“H2363” x-morph=“strongMorph: \sc Th\sc*8804”}, [and delayed]{strong=“H4102” x-morph=“strongMorph: \sc Th\sc*8701”} [not to keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy commandments| strong="H4687" \w*. 
\v 61 \w The bands| strong="H2256" \w* \w of the wicked| strong="H7563" \w* [have robbed]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8765”} me: but [I have not forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy law| strong="H8451" \w*.\f + \fr 119:61 \ft bands: or, companies \f* 
\v 62 [At midnight]{strong=“H3915 H2676”} [I will rise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} [to give thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8687”} \w unto thee because of thy righteous| strong="H6664" \w* \w judgments| strong="H4941" \w*. 
\v 63 I am \w a companion| strong="H2270" \w* of all them [that fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, and of them that keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w thy precepts| strong="H6490" \w*. 
\v 64 \w The earth| strong="H776" \w*, O \sc Lord\sc*, [is full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of thy mercy| strong="H2617" \w*: [teach]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8761”} \w me thy statutes| strong="H2706" \w*. 
\p
#
# 
ט \sc Teth\sc*. 
