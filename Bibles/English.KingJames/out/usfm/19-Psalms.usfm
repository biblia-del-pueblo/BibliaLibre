\v 9 \w The princes| strong="H5081" \w* \w of the people| strong="H5971" \w* [are gathered together]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8738”}, even \w the people| strong="H5971" \w* \w of the God| strong="H430" \w* \w of Abraham| strong="H85" \w*: \w for the shields| strong="H4043" \w* \w of the earth| strong="H776" \w* belong \w unto God| strong="H430" \w*: \w he is greatly| strong="H3966" \w* [exalted]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8738”}.\f + \fr 47:9 \ft princes…: or, voluntary of the people are gathered unto the people of the God of Abraham \f*
\c 48
\p 
\w A Song| strong="H7892" \w* and \w Psalm| strong="H4210" \w* \w for the sons| strong="H1121" \w* \w of Korah| strong="H7141" \w*. 
\v 1 \w Great| strong="H1419" \w* is the \sc Lord\sc*, \w and greatly| strong="H3966" \w* [to be praised]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8794”} \w in the city| strong="H5892" \w* \w of our God| strong="H430" \w*, in \w the mountain| strong="H2022" \w* \w of his holiness| strong="H6944" \w*.\f + \fr 48:1 \ft for: or, of \f* 
\v 2 \w Beautiful| strong="H3303" \w* \w for situation| strong="H5131" \w*, \w the joy| strong="H4885" \w* \w of the whole earth| strong="H776" \w*, is \w mount| strong="H2022" \w* \w Zion| strong="H6726" \w*, on \w the sides| strong="H3411" \w* \w of the north| strong="H6828" \w*, \w the city| strong="H7151" \w* \w of the great| strong="H7227" \w* \w King| strong="H4428" \w*. 
\v 3 \w God| strong="H430" \w* [is known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8738”} \w in her palaces| strong="H759" \w* \w for a refuge| strong="H4869" \w*. 
