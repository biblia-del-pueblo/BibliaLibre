\c 9
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} [upon Muthlabben]{strong=“H1121 H4192”}, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 [I will praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} thee, O \sc Lord\sc*, \w with my whole heart| strong="H3820" \w*; [I will shew forth]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} [all thy marvellous works]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”}. 
