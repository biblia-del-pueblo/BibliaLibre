\c 79
\p 
\w A Psalm| strong="H4210" \w* \w of Asaph| strong="H623" \w*. 
\v 1 \w O God| strong="H430" \w*, \w the heathen| strong="H1471" \w* [are come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into thine inheritance| strong="H5159" \w*; \w thy holy| strong="H6944" \w* \w temple| strong="H1964" \w* [have they defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8765”}; [they have laid]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w Jerusalem| strong="H3389" \w* \w on heaps| strong="H5856" \w*.\f + \fr 79:1 \ft of: or, for \f* 
\v 2 \w The dead bodies| strong="H5038" \w* \w of thy servants| strong="H5650" \w* [have they given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} to be \w meat| strong="H3978" \w* \w unto the fowls| strong="H5775" \w* \w of the heaven| strong="H8064" \w*, \w the flesh| strong="H1320" \w* \w of thy saints| strong="H2623" \w* \w unto the beasts| strong="H2416" \w* \w of the earth| strong="H776" \w*. 
\v 3 \w Their blood| strong="H1818" \w* [have they shed]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8804”} \w like water| strong="H4325" \w* \w round about| strong="H5439" \w* \w Jerusalem| strong="H3389" \w*; and there was [none to bury]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8802”} them. 
\v 4 \w We are become a reproach| strong="H2781" \w* \w to our neighbours| strong="H7934" \w*, \w a scorn| strong="H3933" \w* \w and derision| strong="H7047" \w* \w to them that are round about| strong="H5439" \w* us. 
\v 5 How long, \sc Lord\sc*? [wilt thou be angry]{strong=“H599” x-morph=“strongMorph: \sc Th\sc*8799”} \w for ever| strong="H5331" \w*? \w shall thy jealousy| strong="H7068" \w* [burn]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8799”} \w like fire| strong="H784" \w*? 
\v 6 [Pour out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy wrath| strong="H2534" \w* \w upon the heathen| strong="H1471" \w* [that have not known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, and upon the kingdoms]{strong=“H4467”} [that have not called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon thy name| strong="H8034" \w*. 
\v 7 [For they have devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w Jacob| strong="H3290" \w*, [and laid waste]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8689”} \w his dwelling place| strong="H5116" \w*. 
\v 8 [O remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w not against us former| strong="H7223" \w* \w iniquities| strong="H5771" \w*: \w let thy tender mercies| strong="H7356" \w* \w speedily| strong="H4118" \w* [prevent]{strong=“H6923” x-morph=“strongMorph: \sc Th\sc*8762”} [us: for we are brought]{strong=“H1809”} \w very| strong="H3966" \w* [low]{strong=“H1809” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 79:8 \ft former…: or, the iniquities of them that were before us \f* 
\v 9 [Help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8798”} [us, O God]{strong=“H430”} \w of our salvation| strong="H3468" \w*, \w for| strong="H1697" \w* \w the glory| strong="H3519" \w* \w of thy name| strong="H8034" \w*: [and deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} [us, and purge away]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8761”} \w our sins| strong="H2403" \w*, [for thy name’s]{strong=“H8034”} sake. 
\v 10 \w Wherefore should the heathen| strong="H1471" \w* [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Where is \w their God| strong="H430" \w*? [let him be known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8735”} \w among the heathen| strong="H1471" \w* \w in our sight| strong="H5869" \w* by \w the revenging| strong="H5360" \w* \w of the blood| strong="H1818" \w* \w of thy servants| strong="H5650" \w* which is [shed]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8803”}.\f + \fr 79:10 \ft revenging: Heb. vengeance \f* 
\v 11 \w Let the sighing| strong="H603" \w* \w of the prisoner| strong="H615" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* [thee; according to the greatness]{strong=“H1433”} \w of thy power| strong="H2220" \w* [preserve]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8685”} \w thou those that are appointed| strong="H1121" \w* \w to die| strong="H8546" \w*;\f + \fr 79:11 \ft thy…: Heb. thine arm \f* \f + \fr 79:11 \ft preserve…: Heb. reserve the children of death \f* 
\v 12 [And render]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto our neighbours| strong="H7934" \w* \w sevenfold| strong="H7659" \w* \w into their bosom| strong="H2436" \w* \w their reproach| strong="H2781" \w*, [wherewith they have reproached]{strong=“H2778” x-morph=“strongMorph: \sc Th\sc*8765”} [thee, O Lord]{strong=“H136”}. 
\v 13 \w So we thy people| strong="H5971" \w* \w and sheep| strong="H6629" \w* \w of thy pasture| strong="H4830" \w* [will give thee thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} \w for ever| strong="H5769" \w*: [we will shew forth]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy praise| strong="H8416" \w* \w to all| strong="H1755" \w* \w generations| strong="H1755" \w*.\f + \fr 79:13 \ft to all…: Heb. to generation and generation \f*
\c 80
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} [upon Shoshannim-eduth]{strong=“H7802”}, \w A Psalm| strong="H4210" \w* \w of Asaph| strong="H623" \w*. 
\v 1 [Give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”}, [O Shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Israel| strong="H3478" \w*, [thou that leadest]{strong=“H5090” x-morph=“strongMorph: \sc Th\sc*8802”} \w Joseph| strong="H3130" \w* \w like a flock| strong="H6629" \w*; [thou that dwellest]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} between \w the cherubims| strong="H3742" \w*, [shine forth]{strong=“H3313” x-morph=“strongMorph: \sc Th\sc*8685”}.\f + \fr 80:1 \ft of: or, for \f* 
\v 2 \w Before| strong="H6440" \w* \w Ephraim| strong="H669" \w* \w and Benjamin| strong="H1144" \w* \w and Manasseh| strong="H4519" \w* [stir up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8786”} \w thy strength| strong="H1369" \w*, [and come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} and \w save| strong="H3444" \w* us.\f + \fr 80:2 \ft come…: Heb. come for salvation to us \f* 
\v 3 [Turn us again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”}, \w O God| strong="H430" \w*, \w and cause thy face| strong="H6440" \w* [to shine]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8685”}; [and we shall be saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 4 O \sc Lord\sc* \w God| strong="H430" \w* \w of hosts| strong="H6635" \w*, [how long wilt thou be angry]{strong=“H6225” x-morph=“strongMorph: \sc Th\sc*8804”} \w against the prayer| strong="H8605" \w* \w of thy people| strong="H5971" \w*?\f + \fr 80:4 \ft be…: Heb. smoke \f* 
\v 5 [Thou feedest]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8689”} \w them with the bread| strong="H3899" \w* \w of tears| strong="H1832" \w*; \w and givest them tears| strong="H1832" \w* [to drink]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8686”} \w in great measure| strong="H7991" \w*. 
\v 6 [Thou makest]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w us a strife| strong="H4066" \w* \w unto our neighbours| strong="H7934" \w*: [and our enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [laugh]{strong=“H3932” x-morph=“strongMorph: \sc Th\sc*8799”} among themselves. 
\v 7 [Turn us again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”}, \w O God| strong="H430" \w* \w of hosts| strong="H6635" \w*, \w and cause thy face| strong="H6440" \w* [to shine]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8685”}; [and we shall be saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 8 [Thou hast brought]{strong=“H5265” x-morph=“strongMorph: \sc Th\sc*8686”} \w a vine| strong="H1612" \w* \w out of Egypt| strong="H4714" \w*: [thou hast cast out]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8762”} \w the heathen| strong="H1471" \w*, [and planted]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\v 9 [Thou preparedst]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8765”} room \w before| strong="H6440" \w* [it, and didst cause it to take deep]{strong=“H8328”} [root]{strong=“H8327” x-morph=“strongMorph: \sc Th\sc*8686”}, [and it filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8762”} \w the land| strong="H776" \w*. 
\v 10 \w The hills| strong="H2022" \w* [were covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8795”} \w with the shadow| strong="H6738" \w* [of it, and the boughs]{strong=“H6057”} thereof were like \w the goodly| strong="H410" \w* \w cedars| strong="H730" \w*.\f + \fr 80:10 \ft goodly…: Heb. cedars of God \f* 
\v 11 [She sent out]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w her boughs| strong="H7105" \w* \w unto the sea| strong="H3220" \w*, \w and her branches| strong="H3127" \w* \w unto the river| strong="H5104" \w*. 
\v 12 Why hast thou then [broken down]{strong=“H6555” x-morph=“strongMorph: \sc Th\sc*8804”} \w her hedges| strong="H1447" \w*, [so that all they which pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} \w by the way| strong="H1870" \w* [do pluck]{strong=“H717” x-morph=“strongMorph: \sc Th\sc*8804”} her? 
\v 13 \w The boar| strong="H2386" \w* \w out of the wood| strong="H3293" \w* [doth waste]{strong=“H3765” x-morph=“strongMorph: \sc Th\sc*8762”} [it, and the wild beast]{strong=“H2123”} \w of the field| strong="H7704" \w* [doth devour]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\v 14 [Return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”}, [we beseech thee, O God]{strong=“H430”} \w of hosts| strong="H6635" \w*: [look down]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8685”} \w from heaven| strong="H8064" \w*, [and behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}, [and visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8798”} \w this vine| strong="H1612" \w*; 
\v 15 [And the vineyard]{strong=“H3661 H3657” x-morph=“strongMorph: \sc Th\sc*8798”} \w which thy right hand| strong="H3225" \w* [hath planted]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and the branch| strong="H1121" \w* that [thou madest strong]{strong=“H553” x-morph=“strongMorph: \sc Th\sc*8765”} for thyself. 
\v 16 It is [burned]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8803”} \w with fire| strong="H784" \w*, it is [cut down]{strong=“H3683” x-morph=“strongMorph: \sc Th\sc*8803”}: [they perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”} \w at the rebuke| strong="H1606" \w* \w of thy countenance| strong="H6440" \w*. 
\v 17 \w Let thy hand| strong="H3027" \w* \w be upon the man| strong="H376" \w* \w of thy right hand| strong="H3225" \w*, \w upon the son| strong="H1121" \w* \w of man| strong="H120" \w* whom [thou madest strong]{strong=“H553” x-morph=“strongMorph: \sc Th\sc*8765”} for thyself. 
\v 18 [So will not we go back]{strong=“H5472” x-morph=“strongMorph: \sc Th\sc*8799”} [from thee: quicken]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8762”} [us, and we will call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon thy name| strong="H8034" \w*. 
\v 19 [Turn us again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”}, O \sc Lord\sc* \w God| strong="H430" \w* \w of hosts| strong="H6635" \w*, \w cause thy face| strong="H6440" \w* [to shine]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8685”}; [and we shall be saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8735”}.
\c 81
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} \w upon Gittith| strong="H1665" \w*, A Psalm \w of Asaph| strong="H623" \w*. 
\v 1 [Sing aloud]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto God| strong="H430" \w* \w our strength| strong="H5797" \w*: [make a joyful noise]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto the God| strong="H430" \w* \w of Jacob| strong="H3290" \w*.\f + \fr 81:1 \ft of Asaph: or, for Asaph \f* 
\v 2 [Take]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w a psalm| strong="H2172" \w*, [and bring]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w hither the timbrel| strong="H8596" \w*, \w the pleasant| strong="H5273" \w* \w harp| strong="H3658" \w* \w with the psaltery| strong="H5035" \w*. 
\v 3 [Blow up]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8798”} \w the trumpet| strong="H7782" \w* \w in the new moon| strong="H2320" \w*, \w in the time appointed| strong="H3677" \w*, \w on our solemn feast| strong="H2282" \w* \w day| strong="H3117" \w*. 
\v 4 For this was \w a statute| strong="H2706" \w* \w for Israel| strong="H3478" \w*, and \w a law| strong="H4941" \w* \w of the God| strong="H430" \w* \w of Jacob| strong="H3290" \w*. 
\v 5 [This he ordained]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w in Joseph| strong="H3084" \w* for \w a testimony| strong="H5715" \w*, [when he went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”} \w through the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*: where [I heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w a language| strong="H8193" \w* that [I understood]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} not.\f + \fr 81:5 \ft through: or, against \f* 
\v 6 [I removed]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8689”} \w his shoulder| strong="H7926" \w* \w from the burden| strong="H5447" \w*: \w his hands| strong="H3709" \w* [were delivered]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the pots| strong="H1731" \w*.\f + \fr 81:6 \ft were…: Heb. passed away \f* 
\v 7 [Thou calledst]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w in trouble| strong="H6869" \w*, [and I delivered]{strong=“H2502” x-morph=“strongMorph: \sc Th\sc*8762”} [thee; I answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee in the secret place| strong="H5643" \w* \w of thunder| strong="H7482" \w*: [I proved]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee at the waters| strong="H4325" \w* \w of Meribah| strong="H4809" \w*. \w Selah| strong="H5542" \w*.\f + \fr 81:7 \ft Meribah: or, Strife \f* 
\v 8 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O my people| strong="H5971" \w*, [and I will testify]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8686”} [unto thee: O Israel]{strong=“H3478”}, [if thou wilt hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} unto me; 
\v 9 [There shall no strange]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} \w god| strong="H410" \w* [be in thee; neither shalt thou worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} \w any strange| strong="H5236" \w* \w god| strong="H410" \w*. 
\v 10 I am the \sc Lord\sc* \w thy God| strong="H430" \w*, [which brought]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8688”} \w thee out of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*: \w open thy mouth| strong="H6310" \w* [wide]{strong=“H7337” x-morph=“strongMorph: \sc Th\sc*8685”}, [and I will fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8762”} it. 
\v 11 \w But my people| strong="H5971" \w* [would not hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w to my voice| strong="H6963" \w*; \w and Israel| strong="H3478" \w* [would]{strong=“H14” x-morph=“strongMorph: \sc Th\sc*8804”} none of me. 
\v 12 [So I gave them up]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} [unto their own hearts’]{strong=“H3820”} \w lust| strong="H8307" \w*: and [they walked]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w in their own counsels| strong="H4156" \w*.\f + \fr 81:12 \ft unto…: or, to the hardness of their hearts, or, imagination \f* 
\v 13 \w Oh| strong="H3863" \w* \w that my people| strong="H5971" \w* [had hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} unto me, and \w Israel| strong="H3478" \w* [had walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8762”} \w in my ways| strong="H1870" \w*! 
\v 14 \w I should soon| strong="H4592" \w* [have subdued]{strong=“H3665” x-morph=“strongMorph: \sc Th\sc*8686”} [their enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, [and turned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w my hand| strong="H3027" \w* \w against their adversaries| strong="H6862" \w*. 
\v 15 [The haters]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8764”} of the \sc Lord\sc* [should have submitted]{strong=“H3584” x-morph=“strongMorph: \sc Th\sc*8762”} [themselves unto him: but their time]{strong=“H6256”} \w should have endured for ever| strong="H5769" \w*.\f + \fr 81:15 \ft submitted…: or, yielded feigned obedience: Heb. lied \f* 
\v 16 [He should have fed]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8686”} \w them also with the finest| strong="H2459" \w* \w of the wheat| strong="H2406" \w*: \w and with honey| strong="H1706" \w* \w out of the rock| strong="H6697" \w* [should I have satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8686”} thee.\f + \fr 81:16 \ft finest…: Heb. fat of wheat \f*
\c 82
\p 
\w A Psalm| strong="H4210" \w* \w of Asaph| strong="H623" \w*. 
\v 1 \w God| strong="H430" \w* [standeth]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8737”} \w in the congregation| strong="H5712" \w* \w of the mighty| strong="H410" \w*; [he judgeth]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w among| strong="H7130" \w* \w the gods| strong="H430" \w*.\f + \fr 82:1 \ft of Asaph: or, for Asaph \f* 
\v 2 [How long will ye judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w unjustly| strong="H5766" \w*, [and accept]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w the persons| strong="H6440" \w* \w of the wicked| strong="H7563" \w*? \w Selah| strong="H5542" \w*. 
\v 3 [Defend]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8798”} \w the poor| strong="H1800" \w* \w and fatherless| strong="H3490" \w*: [do justice]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8685”} \w to the afflicted| strong="H6041" \w* [and needy]{strong=“H7326” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 82:3 \ft Defend: Heb. Judge \f* 
\v 4 [Deliver]{strong=“H6403” x-morph=“strongMorph: \sc Th\sc*8761”} \w the poor| strong="H1800" \w* \w and needy| strong="H34" \w*: [rid]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} them \w out of the hand| strong="H3027" \w* \w of the wicked| strong="H7563" \w*. 
\v 5 [They know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [not, neither will they understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”}; [they walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8691”} \w on in darkness| strong="H2825" \w*: \w all the foundations| strong="H4144" \w* \w of the earth| strong="H776" \w* [are out of course]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 82:5 \ft out…: Heb. moved \f* 
\v 6 [I have said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, Ye are \w gods| strong="H430" \w*; and all of you are \w children| strong="H1121" \w* \w of the most High| strong="H5945" \w*. 
\v 7 \w But| strong="H403" \w* [ye shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w like men| strong="H120" \w*, [and fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w like one| strong="H259" \w* \w of the princes| strong="H8269" \w*. 
\v 8 [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O God| strong="H430" \w*, [judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8798”} \w the earth| strong="H776" \w*: [for thou shalt inherit]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8799”} \w all nations| strong="H1471" \w*.
\c 83
\p 
\w A Song| strong="H7892" \w* or \w Psalm| strong="H4210" \w* \w of Asaph| strong="H623" \w*. 
\v 1 \w Keep not thou silence| strong="H1824" \w*, \w O God| strong="H430" \w*: [hold not thy peace]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8799”}, [and be not still]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8799”}, \w O God| strong="H410" \w*.\f + \fr 83:1 \ft of Asaph: or, for Asaph \f* 
\v 2 [For, lo, thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [make a tumult]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8799”}: [and they that hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8764”} [thee have lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w the head| strong="H7218" \w*. 
\v 3 [They have taken crafty]{strong=“H6191” x-morph=“strongMorph: \sc Th\sc*8686”} \w counsel| strong="H5475" \w* \w against thy people| strong="H5971" \w*, [and consulted]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8691”} [against thy hidden ones]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8803”}. 
\v 4 [They have said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [and let us cut them off]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8686”} from being \w a nation| strong="H1471" \w*; \w that the name| strong="H8034" \w* \w of Israel| strong="H3478" \w* [may be no more in remembrance]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 5 [For they have consulted]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8738”} \w together| strong="H3162" \w* \w with one consent| strong="H3820" \w*: [they are]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} \w confederate| strong="H1285" \w* against thee:\f + \fr 83:5 \ft consent: Heb. heart \f* 
\v 6 \w The tabernacles| strong="H168" \w* \w of Edom| strong="H123" \w*, \w and the Ishmaelites| strong="H3459" \w*; \w of Moab| strong="H4124" \w*, \w and the Hagarenes| strong="H1905" \w*; 
\v 7 \w Gebal| strong="H1381" \w*, \w and Ammon| strong="H5983" \w*, \w and Amalek| strong="H6002" \w*; \w the Philistines| strong="H6429" \w* [with the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Tyre| strong="H6865" \w*; 
\v 8 \w Assur| strong="H804" \w* [also is joined]{strong=“H3867” x-morph=“strongMorph: \sc Th\sc*8738”} [with them: they have holpen]{strong=“H2220”} \w the children| strong="H1121" \w* \w of Lot| strong="H3876" \w*. \w Selah| strong="H5542" \w*.\f + \fr 83:8 \ft holpen: Heb. been an arm to \f* 
\v 9 [Do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} unto them as unto \w the Midianites| strong="H4080" \w*; as to \w Sisera| strong="H5516" \w*, as to \w Jabin| strong="H2985" \w*, \w at the brook| strong="H5158" \w* \w of Kison| strong="H7028" \w*: 
\v 10 Which [perished]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8738”} \w at Endor| strong="H5874" \w*: they became as \w dung| strong="H1828" \w* \w for the earth| strong="H127" \w*. 
\v 11 [Make]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8798”} \w their nobles| strong="H5081" \w* \w like Oreb| strong="H6159" \w*, \w and like Zeeb| strong="H2062" \w*: [yea, all their princes]{strong=“H5257”} \w as Zebah| strong="H2078" \w*, \w and as Zalmunna| strong="H6759" \w*: 
\v 12 [Who said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Let us take to ourselves the houses| strong="H4999" \w* \w of God| strong="H430" \w* [in possession]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 13 \w O my God| strong="H430" \w*, [make]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8798”} \w them like a wheel| strong="H1534" \w*; \w as the stubble| strong="H7179" \w* \w before| strong="H6440" \w* \w the wind| strong="H7307" \w*. 
\v 14 \w As the fire| strong="H784" \w* [burneth]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8799”} \w a wood| strong="H3293" \w*, \w and as the flame| strong="H3852" \w* \w setteth| strong="H3857" \w* \w the mountains| strong="H2022" \w* [on fire]{strong=“H3857” x-morph=“strongMorph: \sc Th\sc*8762”}; 
\v 15 [So persecute]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} \w them with thy tempest| strong="H5591" \w*, [and make them afraid]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8762”} \w with thy storm| strong="H5492" \w*. 
\v 16 [Fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8761”} \w their faces| strong="H6440" \w* \w with shame| strong="H7036" \w*; [that they may seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy name| strong="H8034" \w*, O \sc Lord\sc*. 
\v 17 [Let them be confounded]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} [and troubled]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8735”} \w for ever| strong="H5703" \w*; [yea, let them be put to shame]{strong=“H2659” x-morph=“strongMorph: \sc Th\sc*8799”}, [and perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}: 
\v 18 That men [may know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [that thou, whose name]{strong=“H8034”} alone is \sc Jehovah\sc*, art \w the most high| strong="H5945" \w* \w over all the earth| strong="H776" \w*.
\c 84
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} \w upon Gittith| strong="H1665" \w*, \w A Psalm| strong="H4210" \w* \w for the sons| strong="H1121" \w* \w of Korah| strong="H7141" \w*. 
\v 1 \w How amiable| strong="H3039" \w* are \w thy tabernacles| strong="H4908" \w*, O \sc Lord\sc* \w of hosts| strong="H6635" \w*!\f + \fr 84:1 \ft for the sons: or, of the sons \f* 
\v 2 \w My soul| strong="H5315" \w* [longeth]{strong=“H3700” x-morph=“strongMorph: \sc Th\sc*8738”}, [yea, even fainteth]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”} \w for the courts| strong="H2691" \w* of the \sc Lord\sc*: \w my heart| strong="H3820" \w* \w and my flesh| strong="H1320" \w* [crieth out]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8762”} \w for the living| strong="H2416" \w* \w God| strong="H410" \w*. 
\v 3 [Yea, the sparrow]{strong=“H6833”} [hath found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w an house| strong="H1004" \w*, \w and the swallow| strong="H1866" \w* \w a nest| strong="H7064" \w* [for herself, where she may lay]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8804”} \w her young| strong="H667" \w*, even \w thine altars| strong="H4196" \w*, O \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w my King| strong="H4428" \w*, \w and my God| strong="H430" \w*. 
\v 4 \w Blessed| strong="H835" \w* are [they that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in thy house| strong="H1004" \w*: [they will be still praising]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} [thee. Selah]{strong=“H5542”}. 
\v 5 \w Blessed| strong="H835" \w* is \w the man| strong="H120" \w* \w whose strength| strong="H5797" \w* is [in thee; in whose heart]{strong=“H3824”} are \w the ways| strong="H4546" \w* of them. 
\v 6 Who [passing]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} \w through the valley| strong="H6010" \w* [of Baca]{strong=“H1057 H1056” x-morph=“strongMorph: \sc Th\sc*8676”} [make]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w it a well| strong="H4599" \w*; \w the rain| strong="H4175" \w* [also filleth]{strong=“H5844” x-morph=“strongMorph: \sc Th\sc*8799”} \w the pools| strong="H1293" \w*.\f + \fr 84:6 \ft Baca…: or, mulberry trees make him a well, etc \f* \f + \fr 84:6 \ft filleth: Heb. covereth \f* 
\v 7 [They go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w from strength| strong="H2428" \w* \w to strength| strong="H2428" \w*, every one of them \w in Zion| strong="H6726" \w* [appeareth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8735”} \w before God| strong="H430" \w*.\f + \fr 84:7 \ft strength to…: or, company to company \f* 
\v 8 O \sc Lord\sc* \w God| strong="H430" \w* \w of hosts| strong="H6635" \w*, [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w my prayer| strong="H8605" \w*: [give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”}, \w O God| strong="H430" \w* \w of Jacob| strong="H3290" \w*. \w Selah| strong="H5542" \w*. 
\v 9 [Behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O God| strong="H430" \w* \w our shield| strong="H4043" \w*, [and look]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8685”} \w upon the face| strong="H6440" \w* \w of thine anointed| strong="H4899" \w*. 
\v 10 \w For a day| strong="H3117" \w* \w in thy courts| strong="H2691" \w* is \w better| strong="H2896" \w* \w than a thousand| strong="H505" \w*. [I had rather]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} [be a doorkeeper]{strong=“H5605” x-morph=“strongMorph: \sc Th\sc*8705”} \w in the house| strong="H1004" \w* \w of my God| strong="H430" \w*, [than to dwell]{strong=“H1752” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the tents| strong="H168" \w* \w of wickedness| strong="H7562" \w*.\f + \fr 84:10 \ft I had…: Heb. I would choose rather to sit at the threshold \f* 
\v 11 For the \sc Lord\sc* \w God| strong="H430" \w* is \w a sun| strong="H8121" \w* \w and shield| strong="H4043" \w*: the \sc Lord\sc* [will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w grace| strong="H2580" \w* \w and glory| strong="H3519" \w*: \w no good| strong="H2896" \w* thing [will he withhold]{strong=“H4513” x-morph=“strongMorph: \sc Th\sc*8799”} [from them that walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w uprightly| strong="H8549" \w*. 
\v 12 O \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w blessed| strong="H835" \w* is \w the man| strong="H120" \w* [that trusteth]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”} in thee.
\c 85
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w A Psalm| strong="H4210" \w* \w for the sons| strong="H1121" \w* \w of Korah| strong="H7141" \w*. 
\v 1 \sc Lord\sc*, [thou hast been favourable]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto thy land| strong="H776" \w*: [thou hast brought back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} [the captivity]{strong=“H7622 H7622” x-morph=“strongMorph: \sc Th\sc*8675”} \w of Jacob| strong="H3290" \w*.\f + \fr 85:1 \ft for the sons: or, of the sons \f* \f + \fr 85:1 \ft favourable: or, well pleased \f* 
\v 2 [Thou hast forgiven]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w the iniquity| strong="H5771" \w* \w of thy people| strong="H5971" \w*, [thou hast covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”} \w all their sin| strong="H2403" \w*. \w Selah| strong="H5542" \w*. 
\v 3 [Thou hast taken away]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8804”} \w all thy wrath| strong="H5678" \w*: [thou hast turned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} thyself \w from the fierceness| strong="H2740" \w* \w of thine anger| strong="H639" \w*.\f + \fr 85:3 \ft thyself…: or, thine anger from waxing hot \f* 
\v 4 [Turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} [us, O God]{strong=“H430”} \w of our salvation| strong="H3468" \w*, \w and cause thine anger| strong="H3708" \w* [toward us to cease]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8685”}. 
\v 5 [Wilt thou be angry]{strong=“H599” x-morph=“strongMorph: \sc Th\sc*8799”} \w with us for ever| strong="H5769" \w*? [wilt thou draw out]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8799”} \w thine anger| strong="H639" \w* \w to all| strong="H1755" \w* \w generations| strong="H1755" \w*? 
\v 6 [Wilt thou not revive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8762”} [us again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}: \w that thy people| strong="H5971" \w* [may rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} in thee? 
\v 7 [Shew]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8685”} \w us thy mercy| strong="H2617" \w*, O \sc Lord\sc*, [and grant]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w us thy salvation| strong="H3468" \w*. 
\v 8 [I will hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w what God| strong="H410" \w* the \sc Lord\sc* [will speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}: [for he will speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w peace| strong="H7965" \w* \w unto his people| strong="H5971" \w*, \w and to his saints| strong="H2623" \w*: [but let them not turn again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w to folly| strong="H3690" \w*. 
\v 9 \w Surely his salvation| strong="H3468" \w* is \w nigh| strong="H7138" \w* \w them that fear| strong="H3373" \w* [him; that glory]{strong=“H3519”} [may dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8800”} \w in our land| strong="H776" \w*. 
\v 10 \w Mercy| strong="H2617" \w* \w and truth| strong="H571" \w* [are met together]{strong=“H6298” x-morph=“strongMorph: \sc Th\sc*8738”}; \w righteousness| strong="H6664" \w* \w and peace| strong="H7965" \w* [have kissed]{strong=“H5401” x-morph=“strongMorph: \sc Th\sc*8804”} each other. 
\v 11 \w Truth| strong="H571" \w* [shall spring out]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the earth| strong="H776" \w*; \w and righteousness| strong="H6664" \w* [shall look down]{strong=“H8259” x-morph=“strongMorph: \sc Th\sc*8738”} \w from heaven| strong="H8064" \w*. 
\v 12 Yea, the \sc Lord\sc* [shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} that which is \w good| strong="H2896" \w*; \w and our land| strong="H776" \w* [shall yield]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w her increase| strong="H2981" \w*. 
\v 13 \w Righteousness| strong="H6664" \w* [shall go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8762”} \w before| strong="H6440" \w* [him; and shall set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} us \w in the way| strong="H1870" \w* \w of his steps| strong="H6471" \w*.
\c 86
\p 
\w A Prayer| strong="H8605" \w* \w of David| strong="H1732" \w*. 
\v 1 [Bow down]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8685”} \w thine ear| strong="H241" \w*, O \sc Lord\sc*, [hear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8798”} me: for I am \w poor| strong="H6041" \w* \w and needy| strong="H34" \w*.\f + \fr 86:1 \ft A Prayer…: or, A Prayer, being a Psalm of David \f* 
\v 2 [Preserve]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8798”} \w my soul| strong="H5315" \w*; for I am \w holy| strong="H2623" \w*: \w O thou my God| strong="H430" \w*, [save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”} \w thy servant| strong="H5650" \w* [that trusteth]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”} in thee.\f + \fr 86:2 \ft holy: or, one whom thou favourest \f* 
\v 3 [Be merciful]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me, O Lord]{strong=“H136”}: [for I cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto thee daily| strong="H3117" \w*.\f + \fr 86:3 \ft daily: or, all the day \f* 
\v 4 [Rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8761”} \w the soul| strong="H5315" \w* \w of thy servant| strong="H5650" \w*: [for unto thee, O Lord]{strong=“H136”}, [do I lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w my soul| strong="H5315" \w*. 
\v 5 [For thou, Lord]{strong=“H136”}, art \w good| strong="H2896" \w*, \w and ready to forgive| strong="H5546" \w*; \w and plenteous| strong="H7227" \w* \w in mercy| strong="H2617" \w* [unto all them that call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8802”} upon thee. 
\v 6 [Give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”}, O \sc Lord\sc*, \w unto my prayer| strong="H8605" \w*; [and attend]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8685”} \w to the voice| strong="H6963" \w* \w of my supplications| strong="H8469" \w*. 
\v 7 \w In the day| strong="H3117" \w* \w of my trouble| strong="H6869" \w* [I will call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} [upon thee: for thou wilt answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} me. 
\v 8 \w Among the gods| strong="H430" \w* there is [none like unto thee, O Lord]{strong=“H136”}; neither are there any works \w like unto thy works| strong="H4639" \w*. 
\v 9 \w All nations| strong="H1471" \w* [whom thou hast made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} \w before| strong="H6440" \w* [thee, O Lord]{strong=“H136”}; [and shall glorify]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy name| strong="H8034" \w*. 
\v 10 For thou art \w great| strong="H1419" \w*, [and doest]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} [wondrous things]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”}: thou art \w God| strong="H430" \w* alone. 
\v 11 [Teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8685”} \w me thy way| strong="H1870" \w*, O \sc Lord\sc*; [I will walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8762”} \w in thy truth| strong="H571" \w*: [unite]{strong=“H3161” x-morph=“strongMorph: \sc Th\sc*8761”} \w my heart| strong="H3824" \w* [to fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy name| strong="H8034" \w*. 
\v 12 [I will praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} [thee, O Lord]{strong=“H136”} \w my God| strong="H430" \w*, \w with all my heart| strong="H3824" \w*: [and I will glorify]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy name| strong="H8034" \w* \w for evermore| strong="H5769" \w*. 
\v 13 \w For great| strong="H1419" \w* is \w thy mercy| strong="H2617" \w* [toward me: and thou hast delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w my soul| strong="H5315" \w* \w from the lowest| strong="H8482" \w* \w hell| strong="H7585" \w*.\f + \fr 86:13 \ft hell: or, grave \f* 
\v 14 \w O God| strong="H430" \w*, \w the proud| strong="H2086" \w* [are risen]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”} [against me, and the assemblies]{strong=“H5712”} \w of violent| strong="H6184" \w* men [have sought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8765”} \w after my soul| strong="H5315" \w*; [and have not set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} thee before them.\f + \fr 86:14 \ft violent: Heb. terrible \f* 
\v 15 [But thou, O Lord]{strong=“H136”}, art \w a God| strong="H410" \w* \w full of compassion| strong="H7349" \w*, \w and gracious| strong="H2587" \w*, [longsuffering]{strong=“H639 H750”}, \w and plenteous| strong="H7227" \w* \w in mercy| strong="H2617" \w* \w and truth| strong="H571" \w*. 
\v 16 [O turn]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me, and have mercy]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} [upon me; give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy strength| strong="H5797" \w* \w unto thy servant| strong="H5650" \w*, [and save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”} \w the son| strong="H1121" \w* \w of thine handmaid| strong="H519" \w*. 
\v 17 [Shew]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} \w me a token| strong="H226" \w* \w for good| strong="H2896" \w*; [that they which hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} [me may see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} it, [and be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}: because thou, \sc Lord\sc*, [hast holpen]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and comforted]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8765”} me.
\c 87
\p 
\w A Psalm| strong="H4210" \w* or \w Song| strong="H7892" \w* \w for the sons| strong="H1121" \w* \w of Korah| strong="H7141" \w*. 
\v 1 \w His foundation| strong="H3248" \w* is \w in the holy| strong="H6944" \w* \w mountains| strong="H2042" \w*.\f + \fr 87:1 \ft for the sons: or, of the sons \f* 
\v 2 The \sc Lord\sc* [loveth]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} \w the gates| strong="H8179" \w* \w of Zion| strong="H6726" \w* \w more than all the dwellings| strong="H4908" \w* \w of Jacob| strong="H3290" \w*. 
\v 3 [Glorious things]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8737”} [are spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8794”} [of thee, O city]{strong=“H5892”} \w of God| strong="H430" \w*. \w Selah| strong="H5542" \w*. 
\v 4 [I will make mention]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8686”} \w of Rahab| strong="H7294" \w* \w and Babylon| strong="H894" \w* [to them that know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} [me: behold Philistia]{strong=“H6429”}, \w and Tyre| strong="H6865" \w*, \w with Ethiopia| strong="H3568" \w*; this man [was born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8795”} there. 
\v 5 \w And of Zion| strong="H6726" \w* [it shall be said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8735”}, \w This and that man| strong="H376" \w* [was born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8795”} [in her: and the highest]{strong=“H5945”} [himself shall establish]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8787”} her. 
\v 6 The \sc Lord\sc* [shall count]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8799”}, [when he writeth up]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8800”} \w the people| strong="H5971" \w*, that this man [was born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8795”} [there. Selah]{strong=“H5542”}. 
\v 7 [As well the singers]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8802”} [as the players]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8802”} on instruments shall be there: \w all my springs| strong="H4599" \w* are in thee.
\c 88
\p 
\w A Song| strong="H7892" \w* or \w Psalm| strong="H4210" \w* \w for the sons| strong="H1121" \w* \w of Korah| strong="H7141" \w*, [to the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} \w upon Mahalath| strong="H4257" \w* [Leannoth]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8763”}, [Maschil]{strong=“H4905” x-morph=“strongMorph: \sc Th\sc*8688”} \w of Heman| strong="H1968" \w* \w the Ezrahite| strong="H250" \w*. 
\v 1 O \sc Lord\sc* \w God| strong="H430" \w* \w of my salvation| strong="H3444" \w*, [I have cried]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8804”} \w day| strong="H3117" \w* and \w night| strong="H3915" \w* before thee:\f + \fr 88:1 \ft for the sons: or, of the sons \f* \f + \fr 88:1 \ft Maschil…: or, A Psalm of Heman the Ezrahite, giving instruction \f* 
\v 2 \w Let my prayer| strong="H8605" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* [thee: incline]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8685”} \w thine ear| strong="H241" \w* \w unto my cry| strong="H7440" \w*; 
\v 3 \w For my soul| strong="H5315" \w* [is full]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8804”} \w of troubles| strong="H7451" \w*: \w and my life| strong="H2416" \w* [draweth nigh]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8689”} \w unto the grave| strong="H7585" \w*. 
\v 4 [I am counted]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8738”} [with them that go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w into the pit| strong="H953" \w*: \w I am as a man| strong="H1397" \w* that hath \w no strength| strong="H353" \w*: 
\v 5 \w Free| strong="H2670" \w* [among the dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”}, \w like the slain| strong="H2491" \w* [that lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the grave| strong="H6913" \w*, [whom thou rememberest]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} [no more: and they are cut off]{strong=“H1504” x-morph=“strongMorph: \sc Th\sc*8738”} \w from thy hand| strong="H3027" \w*.\f + \fr 88:5 \ft from: or, by \f* 
\v 6 [Thou hast laid]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8804”} \w me in the lowest| strong="H8482" \w* \w pit| strong="H953" \w*, \w in darkness| strong="H4285" \w*, \w in the deeps| strong="H4688" \w*. 
\v 7 \w Thy wrath| strong="H2534" \w* [lieth hard]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8804”} [upon me, and thou hast afflicted]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8765”} me \w with all thy waves| strong="H4867" \w*. \w Selah| strong="H5542" \w*. 
