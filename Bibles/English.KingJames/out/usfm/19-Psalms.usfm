\v 48 \w What man| strong="H1397" \w* is he that [liveth]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}, [and shall not see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w death| strong="H4194" \w*? [shall he deliver]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8762”} \w his soul| strong="H5315" \w* \w from the hand| strong="H3027" \w* \w of the grave| strong="H7585" \w*? \w Selah| strong="H5542" \w*. 
\v 49 \w Lord| strong="H136" \w*, where are \w thy former| strong="H7223" \w* \w lovingkindnesses| strong="H2617" \w*, which [thou swarest]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto David| strong="H1732" \w* \w in thy truth| strong="H530" \w*? 
\v 50 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”}, \w Lord| strong="H136" \w*, \w the reproach| strong="H2781" \w* \w of thy servants| strong="H5650" \w*; how [I do bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8800”} \w in my bosom| strong="H2436" \w* the reproach of \w all the mighty| strong="H7227" \w* \w people| strong="H5971" \w*; 
\v 51 [Wherewith thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [have reproached]{strong=“H2778” x-morph=“strongMorph: \sc Th\sc*8765”}, O \sc Lord\sc*; [wherewith they have reproached]{strong=“H2778” x-morph=“strongMorph: \sc Th\sc*8765”} \w the footsteps| strong="H6119" \w* \w of thine anointed| strong="H4899" \w*. 
\v 52 [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} be the \sc Lord\sc* \w for evermore| strong="H5769" \w*. \w Amen| strong="H543" \w*, \w and Amen| strong="H543" \w*.
\c 90
\p 
\w A Prayer| strong="H8605" \w* \w of Moses| strong="H4872" \w* \w the man| strong="H376" \w* \w of God| strong="H430" \w*. 
\v 1 \w Lord| strong="H136" \w*, \w thou hast been our dwelling place| strong="H4583" \w* \w in all| strong="H1755" \w* \w generations| strong="H1755" \w*.\f + \fr 90:1 \ft A Prayer…: or, A Prayer, being a Psalm of Moses \f* \f + \fr 90:1 \ft in…: Heb. in generation and generation \f* 
\v 2 \w Before the mountains| strong="H2022" \w* [were brought forth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8795”}, [or ever thou hadst formed]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8787”} \w the earth| strong="H776" \w* \w and the world| strong="H8398" \w*, \w even from everlasting| strong="H5769" \w* \w to| strong="H5704" \w* \w everlasting| strong="H5769" \w*, thou art \w God| strong="H410" \w*. 
\v 3 [Thou turnest]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w man| strong="H582" \w* \w to destruction| strong="H1793" \w*; [and sayest]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”}, \w ye children| strong="H1121" \w* \w of men| strong="H120" \w*. 
\v 4 \w For a thousand| strong="H505" \w* \w years| strong="H8141" \w* \w in thy sight| strong="H5869" \w* are but \w as| strong="H3117" \w* \w yesterday| strong="H865" \w* [when it is past]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}, and as \w a watch| strong="H821" \w* \w in the night| strong="H3915" \w*.\f + \fr 90:4 \ft when…: or, when he hath passed them \f* 
\v 5 [Thou carriest them away as with a flood]{strong=“H2229” x-morph=“strongMorph: \sc Th\sc*8804”}; they are as \w a sleep| strong="H8142" \w*: \w in the morning| strong="H1242" \w* they are \w like grass| strong="H2682" \w* which [groweth up]{strong=“H2498” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 90:5 \ft groweth…: or, is changed \f* 
\v 6 \w In the morning| strong="H1242" \w* [it flourisheth]{strong=“H6692” x-morph=“strongMorph: \sc Th\sc*8686”}, [and groweth up]{strong=“H2498” x-morph=“strongMorph: \sc Th\sc*8804”}; \w in the evening| strong="H6153" \w* [it is cut down]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8787”}, [and withereth]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 7 [For we are consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”} \w by thine anger| strong="H639" \w*, \w and by thy wrath| strong="H2534" \w* [are we troubled]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 8 [Thou hast set]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8804”} \w our iniquities| strong="H5771" \w* [before thee, our secret]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8803”} sins \w in the light| strong="H3974" \w* \w of thy countenance| strong="H6440" \w*. 
\v 9 \w For all our days| strong="H3117" \w* [are passed away]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thy wrath| strong="H5678" \w*: [we spend]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8765”} \w our years| strong="H8141" \w* \w as a tale| strong="H1899" \w* that is told.\f + \fr 90:9 \ft passed…: Heb. turned away \f* \f + \fr 90:9 \ft as a…: or, as a meditation \f* 
\v 10 \w The days| strong="H3117" \w* \w of our years| strong="H8141" \w* are \w threescore| strong="H7657" \w* \w years| strong="H8141" \w* \w and ten| strong="H7657" \w*; \w and if by reason of strength| strong="H1369" \w* they be \w fourscore| strong="H8084" \w* \w years| strong="H8141" \w*, yet is \w their strength| strong="H7296" \w* \w labour| strong="H5999" \w* \w and sorrow| strong="H205" \w*; \w for it is soon| strong="H2440" \w* [cut off]{strong=“H1468” x-morph=“strongMorph: \sc Th\sc*8804”}, [and we fly away]{strong=“H5774” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 90:10 \ft The days…: Heb. As for the days of our years, in them are seventy years \f* 
\v 11 [Who knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w the power| strong="H5797" \w* \w of thine anger| strong="H639" \w*? \w even according to thy fear| strong="H3374" \w*, so is \w thy wrath| strong="H5678" \w*. 
\v 12 [So teach]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8685”} us [to number]{strong=“H4487” x-morph=“strongMorph: \sc Th\sc*8800”} \w our days| strong="H3117" \w*, [that we may apply]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} our \w hearts| strong="H3824" \w* \w unto wisdom| strong="H2451" \w*.\f + \fr 90:12 \ft apply: Heb. cause to come \f* 
\v 13 [Return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”}, O \sc Lord\sc*, [how long? and let it repent]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8734”} \w thee concerning thy servants| strong="H5650" \w*. 
\v 14 [O satisfy]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8761”} \w us early| strong="H1242" \w* \w with thy mercy| strong="H2617" \w*; [that we may rejoice]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8762”} [and be glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} \w all our days| strong="H3117" \w*. 
\v 15 [Make us glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8761”} \w according to the days| strong="H3117" \w* wherein [thou hast afflicted]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8765”} us, and \w the years| strong="H8141" \w* wherein [we have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w evil| strong="H7451" \w*. 
\v 16 \w Let thy work| strong="H6467" \w* [appear]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8735”} \w unto thy servants| strong="H5650" \w*, \w and thy glory| strong="H1926" \w* \w unto their children| strong="H1121" \w*. 
\v 17 \w And let the beauty| strong="H5278" \w* of the \sc Lord\sc* \w our God| strong="H430" \w* [be upon us: and establish]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8786”} \w thou the work| strong="H4639" \w* \w of our hands| strong="H3027" \w* [upon us; yea, the work]{strong=“H4639”} \w of our hands| strong="H3027" \w* [establish ]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8786”} thou it.
\c 91
\p 
\v 1 [He that dwelleth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the secret| strong="H5643" \w* \w place of the most High| strong="H5945" \w* [shall abide]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8698”} \w under the shadow| strong="H6738" \w* \w of the Almighty| strong="H7706" \w*.\f + \fr 91:1 \ft abide: Heb. lodge \f* 
\v 2 [I will say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} of the \sc Lord\sc*, He is \w my refuge| strong="H4268" \w* \w and my fortress| strong="H4686" \w*: \w my God| strong="H430" \w*; [in him will I trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 3 [Surely he shall deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee from the snare| strong="H6341" \w* \w of the fowler| strong="H3353" \w*, and \w from the noisome| strong="H1942" \w* \w pestilence| strong="H1698" \w*. 
\v 4 [He shall cover]{strong=“H5526” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee with his feathers| strong="H84" \w*, \w and under his wings| strong="H3671" \w* [shalt thou trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8799”}: \w his truth| strong="H571" \w* shall be thy \w shield| strong="H6793" \w* \w and buckler| strong="H5507" \w*. 
\v 5 [Thou shalt not be afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w for the terror| strong="H6343" \w* \w by night| strong="H3915" \w*; nor \w for the arrow| strong="H2671" \w* that [flieth]{strong=“H5774” x-morph=“strongMorph: \sc Th\sc*8799”} \w by day| strong="H3119" \w*; 
\v 6 Nor \w for the pestilence| strong="H1698" \w* that [walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8799”} \w in darkness| strong="H652" \w*; nor \w for the destruction| strong="H6986" \w* that [wasteth]{strong=“H7736” x-morph=“strongMorph: \sc Th\sc*8799”} \w at noonday| strong="H6672" \w*. 
\v 7 \w A thousand| strong="H505" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w at thy side| strong="H6654" \w*, \w and ten thousand| strong="H7233" \w* \w at thy right hand| strong="H3225" \w*; but [it shall not come nigh]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8799”} thee. 
\v 8 \w Only with thine eyes| strong="H5869" \w* [shalt thou behold]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”} [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the reward| strong="H8011" \w* \w of the wicked| strong="H7563" \w*. 
\v 9 [Because thou hast made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, which is \w my refuge| strong="H4268" \w*, even \w the most High| strong="H5945" \w*, \w thy habitation| strong="H4583" \w*; 
\v 10 \w There shall no evil| strong="H7451" \w* [befall]{strong=“H579” x-morph=“strongMorph: \sc Th\sc*8792”} [thee, neither shall any plague]{strong=“H5061”} [come nigh]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy dwelling| strong="H168" \w*. 
\v 11 \w For he shall give his angels| strong="H4397" \w* [charge]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} [over thee, to keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w thee in all thy ways| strong="H1870" \w*. 
\v 12 [They shall bear thee up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} in their \w hands| strong="H3709" \w*, [lest thou dash]{strong=“H5062” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy foot| strong="H7272" \w* \w against a stone| strong="H68" \w*. 
\v 13 [Thou shalt tread]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the lion| strong="H7826" \w* \w and adder| strong="H6620" \w*: \w the young lion| strong="H3715" \w* \w and the dragon| strong="H8577" \w* [shalt thou trample under feet]{strong=“H7429” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 91:13 \ft adder: or, asp \f* 
\v 14 [Because he hath set his love]{strong=“H2836” x-morph=“strongMorph: \sc Th\sc*8804”} [upon me, therefore will I deliver]{strong=“H6403” x-morph=“strongMorph: \sc Th\sc*8762”} [him: I will set him on high]{strong=“H7682” x-morph=“strongMorph: \sc Th\sc*8762”}, [because he hath known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w my name| strong="H8034" \w*. 
\v 15 [He shall call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} [upon me, and I will answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} him: I will be \w with him in trouble| strong="H6869" \w*; [I will deliver]{strong=“H2502” x-morph=“strongMorph: \sc Th\sc*8762”} [him, and honour]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8762”} him. 
\v 16 \w With long| strong="H753" \w* \w life| strong="H3117" \w* [will I satisfy]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8686”} [him, and shew]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8686”} \w him my salvation| strong="H3444" \w*.\f + \fr 91:16 \ft long…: Heb. length of days \f*
\c 92
\p 
\w A Psalm| strong="H4210" \w* or \w Song| strong="H7892" \w* \w for the sabbath| strong="H7676" \w* \w day| strong="H3117" \w*. 
\v 1 It is a \w good| strong="H2896" \w* thing [to give thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8687”} unto the \sc Lord\sc*, [and to sing praises]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8763”} \w unto thy name| strong="H8034" \w*, \w O most High| strong="H5945" \w*: 
\v 2 [To shew forth]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8687”} \w thy lovingkindness| strong="H2617" \w* \w in the morning| strong="H1242" \w*, \w and thy faithfulness| strong="H530" \w* \w every night| strong="H3915" \w*,\f + \fr 92:2 \ft every…: Heb. in the nights \f* 
\v 3 \w Upon an instrument of ten strings| strong="H6218" \w*, \w and upon the psaltery| strong="H5035" \w*; \w upon the harp| strong="H3658" \w* \w with a solemn sound| strong="H1902" \w*.\f + \fr 92:3 \ft the harp…: or, the solemn sound with the harp \f* \f + \fr 92:3 \ft a solemn…: Heb. Higgaion \f* 
\v 4 For thou, \sc Lord\sc*, [hast made me glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8765”} \w through thy work| strong="H6467" \w*: [I will triumph]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8762”} \w in the works| strong="H4639" \w* \w of thy hands| strong="H3027" \w*. 
\v 5 O \sc Lord\sc*, [how great]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8804”} \w are thy works| strong="H4639" \w*! and \w thy thoughts| strong="H4284" \w* \w are very| strong="H3966" \w* [deep]{strong=“H6009” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 6 \w A brutish| strong="H1198" \w* \w man| strong="H376" \w* [knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [not; neither doth a fool]{strong=“H3684”} [understand ]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} this. 
\v 7 \w When the wicked| strong="H7563" \w* [spring]{strong=“H6524” x-morph=“strongMorph: \sc Th\sc*8800”} \w as the grass| strong="H6212" \w*, [and when all the workers]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w of iniquity| strong="H205" \w* [do flourish]{strong=“H6692” x-morph=“strongMorph: \sc Th\sc*8686”}; it is [that they shall be destroyed]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8736”} \w for ever| strong="H5703" \w*: 
\v 8 But thou, \sc Lord\sc*, art most \w high| strong="H4791" \w* \w for evermore| strong="H5769" \w*. 
\v 9 [For, lo, thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, O \sc Lord\sc*, [for, lo, thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}; [all the workers]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w of iniquity| strong="H205" \w* [shall be scattered]{strong=“H6504” x-morph=“strongMorph: \sc Th\sc*8691”}. 
\v 10 \w But my horn| strong="H7161" \w* [shalt thou exalt]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} like the horn of \w an unicorn| strong="H7214" \w*: [I shall be anointed]{strong=“H1101” x-morph=“strongMorph: \sc Th\sc*8804”} \w with fresh| strong="H7488" \w* \w oil| strong="H8081" \w*. 
\v 11 \w Mine eye| strong="H5869" \w* [also shall see]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”} my desire \w on mine enemies| strong="H7790" \w*, and \w mine ears| strong="H241" \w* [shall hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} my desire [of the wicked]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8688”} [that rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8801”} against me. 
\v 12 \w The righteous| strong="H6662" \w* [shall flourish]{strong=“H6524” x-morph=“strongMorph: \sc Th\sc*8799”} \w like the palm tree| strong="H8558" \w*: [he shall grow]{strong=“H7685” x-morph=“strongMorph: \sc Th\sc*8799”} \w like a cedar| strong="H730" \w* \w in Lebanon| strong="H3844" \w*. 
\v 13 [Those that be planted]{strong=“H8362” x-morph=“strongMorph: \sc Th\sc*8803”} \w in the house| strong="H1004" \w* of the \sc Lord\sc* [shall flourish]{strong=“H6524” x-morph=“strongMorph: \sc Th\sc*8686”} \w in the courts| strong="H2691" \w* \w of our God| strong="H430" \w*. 
\v 14 [They shall still bring forth fruit]{strong=“H5107” x-morph=“strongMorph: \sc Th\sc*8799”} \w in old age| strong="H7872" \w*; \w they shall be fat| strong="H1879" \w* \w and flourishing| strong="H7488" \w*;\f + \fr 92:14 \ft flourishing: Heb. green \f* 
\v 15 [To shew]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8687”} that the \sc Lord\sc* is \w upright| strong="H3477" \w*: he is \w my rock| strong="H6697" \w*, and there is [no unrighteousness]{strong=“H5766 H5766” x-morph=“strongMorph: \sc Th\sc*8675”} in him.
\c 93
\p 
\v 1 The \sc Lord\sc* [reigneth]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8804”}, [he is clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8804”} \w with majesty| strong="H1348" \w*; the \sc Lord\sc* [is clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8804”} \w with strength| strong="H5797" \w*, wherewith [he hath girded]{strong=“H247” x-morph=“strongMorph: \sc Th\sc*8694”} [himself: the world]{strong=“H8398”} [also is stablished]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8735”}, [that it cannot be moved]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 2 \w Thy throne| strong="H3678" \w* is [established ]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8737”} \w of old| strong="H227" \w*: thou art \w from everlasting| strong="H5769" \w*.\f + \fr 93:2 \ft of old: Heb. from then \f* 
\v 3 \w The floods| strong="H5104" \w* [have lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”}, O \sc Lord\sc*, \w the floods| strong="H5104" \w* [have lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w their voice| strong="H6963" \w*; \w the floods| strong="H5104" \w* [lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their waves| strong="H1796" \w*. 
\v 4 The \sc Lord\sc* \w on high| strong="H4791" \w* is \w mightier| strong="H117" \w* \w than the noise| strong="H6963" \w* \w of many| strong="H7227" \w* \w waters| strong="H4325" \w*, yea, than \w the mighty| strong="H117" \w* \w waves| strong="H4867" \w* \w of the sea| strong="H3220" \w*. 
\v 5 \w Thy testimonies| strong="H5713" \w* \w are very| strong="H3966" \w* [sure]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8738”}: \w holiness| strong="H6944" \w* [becometh]{strong=“H4998” x-morph=“strongMorph: \sc Th\sc*8773”} \w thine house| strong="H1004" \w*, O \sc Lord\sc*, [for ever]{strong=“H3117 H753”}.\f + \fr 93:5 \ft for ever: Heb. to length of days \f*
\c 94
\p 
\v 1 O \sc Lord\sc* \w God| strong="H410" \w*, \w to whom vengeance| strong="H5360" \w* [belongeth; O God]{strong=“H410”}, \w to whom vengeance| strong="H5360" \w* [belongeth, shew]{strong=“H3313” x-morph=“strongMorph: \sc Th\sc*8685”} thyself.\f + \fr 94:1 \ft God…: Heb. God of revenges \f* \f + \fr 94:1 \ft shew…: Heb. shine forth \f* 
\v 2 [Lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8734”} [thyself, thou judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the earth| strong="H776" \w*: [render]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”} \w a reward| strong="H1576" \w* \w to the proud| strong="H1343" \w*. 
\v 3 \sc Lord\sc*, \w how long shall the wicked| strong="H7563" \w*, \w how long shall the wicked| strong="H7563" \w* [triumph]{strong=“H5937” x-morph=“strongMorph: \sc Th\sc*8799”}? 
\v 4 How long [shall they utter]{strong=“H5042” x-morph=“strongMorph: \sc Th\sc*8686”} and [speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w hard things| strong="H6277" \w*? and [all the workers]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w of iniquity| strong="H205" \w* [boast]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8691”} themselves? 
\v 5 [They break in pieces]{strong=“H1792” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy people| strong="H5971" \w*, O \sc Lord\sc*, [and afflict]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8762”} \w thine heritage| strong="H5159" \w*. 
\v 6 [They slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} \w the widow| strong="H490" \w* \w and the stranger| strong="H1616" \w*, [and murder]{strong=“H7523” x-morph=“strongMorph: \sc Th\sc*8762”} \w the fatherless| strong="H3490" \w*. 
\v 7 [Yet they say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, The \sc Lord\sc* [shall not see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, \w neither shall the God| strong="H430" \w* \w of Jacob| strong="H3290" \w* [regard]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\v 8 [Understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8798”}, [ye brutish]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8802”} \w among the people| strong="H5971" \w*: and ye \w fools| strong="H3684" \w*, [when will ye be wise]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8686”}? 
\v 9 [He that planted]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8802”} \w the ear| strong="H241" \w*, [shall he not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}? [he that formed]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w the eye| strong="H5869" \w*, [shall he not see]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”}? 
\v 10 [He that chastiseth]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8802”} \w the heathen| strong="H1471" \w*, [shall not he correct]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”}? [he that teacheth]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8764”} \w man| strong="H120" \w* \w knowledge| strong="H1847" \w*, shall not he know? 
\v 11 The \sc Lord\sc* [knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w the thoughts| strong="H4284" \w* \w of man| strong="H120" \w*, that they are \w vanity| strong="H1892" \w*. 
\v 12 \w Blessed| strong="H835" \w* is \w the man| strong="H1397" \w* [whom thou chastenest]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8762”}, O \sc Lord\sc*, [and teachest]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8762”} \w him out of thy law| strong="H8451" \w*; 
\v 13 [That thou mayest give him rest]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8687”} \w from the days| strong="H3117" \w* \w of adversity| strong="H7451" \w*, \w until the pit| strong="H7845" \w* [be digged]{strong=“H3738” x-morph=“strongMorph: \sc Th\sc*8735”} \w for the wicked| strong="H7563" \w*. 
\v 14 For the \sc Lord\sc* [will not cast off]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8799”} \w his people| strong="H5971" \w*, [neither will he forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w his inheritance| strong="H5159" \w*. 
\v 15 \w But judgment| strong="H4941" \w* [shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto righteousness| strong="H6664" \w*: \w and all the upright| strong="H3477" \w* \w in heart| strong="H3820" \w* \w shall follow| strong="H310" \w* it.\f + \fr 94:15 \ft shall follow…: Heb. shall be after it \f* 
\v 16 [Who will rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} [for me against the evildoers]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8688”}? or [who will stand up]{strong=“H3320” x-morph=“strongMorph: \sc Th\sc*8691”} [for me against the workers]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w of iniquity| strong="H205" \w*? 
\v 17 \w Unless| strong="H3884" \w* the \sc Lord\sc* had been \w my help| strong="H5833" \w*, \w my soul| strong="H5315" \w* \w had almost| strong="H4592" \w* [dwelt]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8804”} \w in silence| strong="H1745" \w*.\f + \fr 94:17 \ft almost: or, quickly \f* 
\v 18 [When I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w My foot| strong="H7272" \w* [slippeth]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8804”}; \w thy mercy| strong="H2617" \w*, O \sc Lord\sc*, [held me up]{strong=“H5582” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 19 \w In the multitude| strong="H7230" \w* \w of my thoughts| strong="H8312" \w* \w within| strong="H7130" \w* \w me thy comforts| strong="H8575" \w* [delight]{strong=“H8173” x-morph=“strongMorph: \sc Th\sc*8770”} \w my soul| strong="H5315" \w*. 
\v 20 \w Shall the throne| strong="H3678" \w* \w of iniquity| strong="H1942" \w* [have fellowship]{strong=“H2266” x-morph=“strongMorph: \sc Th\sc*8792”} [with thee, which frameth]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w mischief| strong="H5999" \w* \w by a law| strong="H2706" \w*? 
\v 21 [They gather themselves together]{strong=“H1413” x-morph=“strongMorph: \sc Th\sc*8799”} \w against the soul| strong="H5315" \w* \w of the righteous| strong="H6662" \w*, [and condemn]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8686”} \w the innocent| strong="H5355" \w* \w blood| strong="H1818" \w*. 
\v 22 But the \sc Lord\sc* \w is my defence| strong="H4869" \w*; \w and my God| strong="H430" \w* is \w the rock| strong="H6697" \w* \w of my refuge| strong="H4268" \w*. 
\v 23 [And he shall bring]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w upon them their own iniquity| strong="H205" \w*, [and shall cut them off]{strong=“H6789” x-morph=“strongMorph: \sc Th\sc*8686”} \w in their own wickedness| strong="H7451" \w*; yea, the \sc Lord\sc* \w our God| strong="H430" \w* [shall cut them off]{strong=“H6789” x-morph=“strongMorph: \sc Th\sc*8686”}.
\c 95
\p 
\v 1 [O come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [let us sing]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8762”} unto the \sc Lord\sc*: [let us make a joyful noise]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8686”} \w to the rock| strong="H6697" \w* \w of our salvation| strong="H3468" \w*. 
\v 2 [Let us come]{strong=“H6923” x-morph=“strongMorph: \sc Th\sc*8762”} \w before his presence| strong="H6440" \w* \w with thanksgiving| strong="H8426" \w*, [and make a joyful noise]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto him with psalms| strong="H2158" \w*.\f + \fr 95:2 \ft come…: Heb. prevent his face \f* 
\v 3 For the \sc Lord\sc* is \w a great| strong="H1419" \w* \w God| strong="H410" \w*, \w and a great| strong="H1419" \w* \w King| strong="H4428" \w* \w above all gods| strong="H430" \w*. 
\v 4 \w In his hand| strong="H3027" \w* are \w the deep places| strong="H4278" \w* \w of the earth| strong="H776" \w*: \w the strength| strong="H8443" \w* \w of the hills| strong="H2022" \w* is his also.\f + \fr 95:4 \ft In…: Heb. In whose \f* \f + \fr 95:4 \ft the strength…: or, the heights of the hills are his \f* 
\v 5 \w The sea| strong="H3220" \w* is [his, and he made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [it: and his hands]{strong=“H3027”} [formed]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8804”} \w the dry| strong="H3006" \w* land.\f + \fr 95:5 \ft The sea…: Heb. Whose the sea is \f* 
\v 6 [O come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”}, [let us worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} [and bow down]{strong=“H3766” x-morph=“strongMorph: \sc Th\sc*8799”}: [let us kneel]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* the \sc Lord\sc* [our maker]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 7 For he is \w our God| strong="H430" \w*; and we are \w the people| strong="H5971" \w* \w of his pasture| strong="H4830" \w*, \w and the sheep| strong="H6629" \w* \w of his hand| strong="H3027" \w*. \w To day| strong="H3117" \w* [if ye will hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w his voice| strong="H6963" \w*, 
\v 8 [Harden]{strong=“H7185” x-morph=“strongMorph: \sc Th\sc*8686”} \w not your heart| strong="H3824" \w*, \w as in the provocation| strong="H4808" \w*, and as in \w the day| strong="H3117" \w* \w of temptation| strong="H4531" \w* \w in the wilderness| strong="H4057" \w*:\f + \fr 95:8 \ft provocation: Heb. contention \f* 
\v 9 \w When your fathers| strong="H1" \w* [tempted]{strong=“H5254” x-morph=“strongMorph: \sc Th\sc*8765”} [me, proved]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w my work| strong="H6467" \w*. 
\v 10 \w Forty| strong="H705" \w* \w years| strong="H8141" \w* [long was I grieved]{strong=“H6962” x-morph=“strongMorph: \sc Th\sc*8799”} with this \w generation| strong="H1755" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, It is \w a people| strong="H5971" \w* [that do err]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8802”} \w in their heart| strong="H3824" \w*, [and they have not known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w my ways| strong="H1870" \w*: 
\v 11 [Unto whom I sware]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w in my wrath| strong="H639" \w* [that they should not enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into my rest| strong="H4496" \w*.\f + \fr 95:11 \ft that…: Heb. if they enter into my rest \f*
\c 96
\p 
\v 1 [O sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8798”} unto the \sc Lord\sc* \w a new| strong="H2319" \w* \w song| strong="H7892" \w*: [sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8798”} unto the \sc Lord\sc*, \w all the earth| strong="H776" \w*. 
\v 2 [Sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8798”} unto the \sc Lord\sc*, [bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} \w his name| strong="H8034" \w*; [shew forth]{strong=“H1319” x-morph=“strongMorph: \sc Th\sc*8761”} \w his salvation| strong="H3444" \w* \w from day| strong="H3117" \w* \w to day| strong="H3117" \w*. 
\v 3 [Declare]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8761”} \w his glory| strong="H3519" \w* \w among the heathen| strong="H1471" \w*, [his wonders]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} \w among all people| strong="H5971" \w*. 
\v 4 For the \sc Lord\sc* is \w great| strong="H1419" \w*, \w and greatly| strong="H3966" \w* [to be praised]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8794”}: he is [to be feared]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”} \w above all gods| strong="H430" \w*. 
\v 5 \w For all the gods| strong="H430" \w* \w of the nations| strong="H5971" \w* are \w idols| strong="H457" \w*: but the \sc Lord\sc* [made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w the heavens| strong="H8064" \w*. 
\v 6 \w Honour| strong="H1935" \w* \w and majesty| strong="H1926" \w* are \w before| strong="H6440" \w* [him: strength]{strong=“H5797”} \w and beauty| strong="H8597" \w* are \w in his sanctuary| strong="H4720" \w*. 
\v 7 [Give]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”} unto the \sc Lord\sc*, \w O ye kindreds| strong="H4940" \w* \w of the people| strong="H5971" \w*, [give]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”} unto the \sc Lord\sc* \w glory| strong="H3519" \w* \w and strength| strong="H5797" \w*. 
\v 8 [Give]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”} unto the \sc Lord\sc* \w the glory| strong="H3519" \w* due unto \w his name| strong="H8034" \w*: [bring]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w an offering| strong="H4503" \w*, [and come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} \w into his courts| strong="H2691" \w*.\f + \fr 96:8 \ft due…: Heb. of his name \f* 
\v 9 [O worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8690”} the \sc Lord\sc* \w in the beauty| strong="H1927" \w* \w of holiness| strong="H6944" \w*: [fear]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8798”} \w before| strong="H6440" \w* [him, all the earth]{strong=“H776”}.\f + \fr 96:9 \ft in the…: or, in the glorious sanctuary \f* 
\v 10 [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w among the heathen| strong="H1471" \w* that the \sc Lord\sc* [reigneth]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8804”}: \w the world| strong="H8398" \w* [also shall be established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8735”} [that it shall not be moved]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8735”}: [he shall judge]{strong=“H1777” x-morph=“strongMorph: \sc Th\sc*8799”} \w the people| strong="H5971" \w* \w righteously| strong="H4339" \w*. 
\v 11 \w Let the heavens| strong="H8064" \w* [rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and let the earth| strong="H776" \w* [be glad]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”}; \w let the sea| strong="H3220" \w* [roar]{strong=“H7481” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the fulness| strong="H4393" \w* thereof.\f + \fr 96:11 \ft the fulness…: or, all it containeth \f* 
\v 12 \w Let the field| strong="H7704" \w* [be joyful]{strong=“H5937” x-morph=“strongMorph: \sc Th\sc*8799”}, and all that is [therein: then shall all the trees]{strong=“H6086”} \w of the wood| strong="H3293" \w* [rejoice]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8762”} 
\v 13 \w Before| strong="H6440" \w* the \sc Lord\sc*: [for he cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, [for he cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8800”} \w the earth| strong="H776" \w*: [he shall judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w the world| strong="H8398" \w* \w with righteousness| strong="H6664" \w*, \w and the people| strong="H5971" \w* \w with his truth| strong="H530" \w*.
\c 97
\p 
\v 1 The \sc Lord\sc* [reigneth]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8804”}; \w let the earth| strong="H776" \w* [rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”}; \w let the multitude| strong="H7227" \w* \w of isles| strong="H339" \w* [be glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} thereof.\f + \fr 97:1 \ft multitude…: Heb. many, or, great isles \f* 
\v 2 \w Clouds| strong="H6051" \w* \w and darkness| strong="H6205" \w* are \w round about| strong="H5439" \w* [him: righteousness]{strong=“H6664”} \w and judgment| strong="H4941" \w* are \w the habitation| strong="H4349" \w* \w of his throne| strong="H3678" \w*.\f + \fr 97:2 \ft habitation: or, establishment \f* 
\v 3 \w A fire| strong="H784" \w* [goeth]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* [him, and burneth up]{strong=“H3857” x-morph=“strongMorph: \sc Th\sc*8762”} \w his enemies| strong="H6862" \w* \w round about| strong="H5439" \w*. 
\v 4 \w His lightnings| strong="H1300" \w* [enlightened]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8689”} \w the world| strong="H8398" \w*: \w the earth| strong="H776" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”}, [and trembled]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 5 \w The hills| strong="H2022" \w* [melted]{strong=“H4549” x-morph=“strongMorph: \sc Th\sc*8738”} \w like wax| strong="H1749" \w* \w at the presence| strong="H6440" \w* of the \sc Lord\sc*, \w at the presence| strong="H6440" \w* \w of the Lord| strong="H113" \w* \w of the whole earth| strong="H776" \w*. 
\v 6 \w The heavens| strong="H8064" \w* [declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} \w his righteousness| strong="H6664" \w*, \w and all the people| strong="H5971" \w* [see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w his glory| strong="H3519" \w*. 
\v 7 [Confounded]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} [be all they that serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8802”} \w graven images| strong="H6459" \w*, [that boast]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8693”} \w themselves of idols| strong="H457" \w*: [worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8690”} him, all ye \w gods| strong="H430" \w*. 
\v 8 \w Zion| strong="H6726" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}, [and was glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”}; \w and the daughters| strong="H1323" \w* \w of Judah| strong="H3063" \w* [rejoiced]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”} \w because of thy judgments| strong="H4941" \w*, O \sc Lord\sc*. 
\v 9 For thou, \sc Lord\sc*, art \w high above| strong="H5945" \w* \w all the earth| strong="H776" \w*: [thou art exalted]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8738”} \w far above| strong="H3966" \w* \w all gods| strong="H430" \w*. 
\v 10 [Ye that love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} the \sc Lord\sc*, [hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8798”} \w evil| strong="H7451" \w*: [he preserveth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w the souls| strong="H5315" \w* \w of his saints| strong="H2623" \w*; [he delivereth]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w them out of the hand| strong="H3027" \w* \w of the wicked| strong="H7563" \w*. 
\v 11 \w Light| strong="H216" \w* [is sown]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8803”} \w for the righteous| strong="H6662" \w*, \w and gladness| strong="H8057" \w* \w for the upright| strong="H3477" \w* \w in heart| strong="H3820" \w*. 
\v 12 [Rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8798”} in the \sc Lord\sc*, \w ye righteous| strong="H6662" \w*; [and give thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8685”} \w at the remembrance| strong="H2143" \w* \w of his holiness| strong="H6944" \w*.\f + \fr 97:12 \ft at…: or, to the memorial \f*
\c 98
\p 
\w A Psalm| strong="H4210" \w*. 
\v 1 [O sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8798”} unto the \sc Lord\sc* \w a new| strong="H2319" \w* \w song| strong="H7892" \w*; [for he hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [marvellous things]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”}: \w his right hand| strong="H3225" \w*, \w and his holy| strong="H6944" \w* \w arm| strong="H2220" \w*, [hath gotten him the victory]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\v 2 The \sc Lord\sc* [hath made known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8689”} \w his salvation| strong="H3444" \w*: \w his righteousness| strong="H6666" \w* [hath he openly shewed]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8765”} \w in the sight| strong="H5869" \w* \w of the heathen| strong="H1471" \w*.\f + \fr 98:2 \ft openly…: or, revealed \f* 
\v 3 [He hath remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w his mercy| strong="H2617" \w* \w and his truth| strong="H530" \w* \w toward the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*: \w all the ends| strong="H657" \w* \w of the earth| strong="H776" \w* [have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the salvation| strong="H3444" \w* \w of our God| strong="H430" \w*. 
\v 4 [Make a joyful noise]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8685”} unto the \sc Lord\sc*, \w all the earth| strong="H776" \w*: [make a loud noise]{strong=“H6476” x-morph=“strongMorph: \sc Th\sc*8798”}, [and rejoice]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8761”}, [and sing]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8761”} praise. 
\v 5 [Sing]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8761”} unto the \sc Lord\sc* \w with the harp| strong="H3658" \w*; \w with the harp| strong="H3658" \w*, \w and the voice| strong="H6963" \w* \w of a psalm| strong="H2172" \w*. 
\v 6 \w With trumpets| strong="H2689" \w* \w and sound| strong="H6963" \w* \w of cornet| strong="H7782" \w* [make a joyful noise]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8685”} \w before| strong="H6440" \w* the \sc Lord\sc*, \w the King| strong="H4428" \w*. 
\v 7 \w Let the sea| strong="H3220" \w* [roar]{strong=“H7481” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the fulness| strong="H4393" \w* [thereof; the world]{strong=“H8398”}, [and they that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} therein.\f + \fr 98:7 \ft the fulness…: or, all it containeth \f* 
\v 8 \w Let the floods| strong="H5104" \w* [clap]{strong=“H4222” x-morph=“strongMorph: \sc Th\sc*8799”} their \w hands| strong="H3709" \w*: \w let the hills| strong="H2022" \w* [be joyful]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8762”} \w together| strong="H3162" \w* 
\v 9 \w Before| strong="H6440" \w* the \sc Lord\sc*; [for he cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8800”} \w the earth| strong="H776" \w*: \w with righteousness| strong="H6664" \w* [shall he judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w the world| strong="H8398" \w*, \w and the people| strong="H5971" \w* \w with equity| strong="H4339" \w*.
\c 99
\p 
\v 1 The \sc Lord\sc* [reigneth]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8804”}; \w let the people| strong="H5971" \w* [tremble]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8799”}: [he sitteth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} between \w the cherubims| strong="H3742" \w*; \w let the earth| strong="H776" \w* [be moved]{strong=“H5120” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 99:1 \ft be moved: Heb. stagger \f* 
\v 2 The \sc Lord\sc* is \w great| strong="H1419" \w* \w in Zion| strong="H6726" \w*; and he is [high]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8804”} \w above all the people| strong="H5971" \w*. 
\v 3 [Let them praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy great| strong="H1419" \w* [and terrible]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”} \w name| strong="H8034" \w*; for it is \w holy| strong="H6918" \w*. 
\v 4 [The king’s]{strong=“H4428”} \w strength| strong="H5797" \w* [also loveth]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} \w judgment| strong="H4941" \w*; [thou dost establish]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8790”} \w equity| strong="H4339" \w*, [thou executest]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w judgment| strong="H4941" \w* \w and righteousness| strong="H6666" \w* \w in Jacob| strong="H3290" \w*. 
\v 5 [Exalt]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8786”} ye the \sc Lord\sc* \w our God| strong="H430" \w*, [and worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8690”} [at his footstool]{strong=“H1916 H7272”}; for he is \w holy| strong="H6918" \w*.\f + \fr 99:5 \ft he is…: or, it is holy \f* 
\v 6 \w Moses| strong="H4872" \w* \w and Aaron| strong="H175" \w* \w among his priests| strong="H3548" \w*, \w and Samuel| strong="H8050" \w* [among them that call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon his name| strong="H8034" \w*; [they called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8802”} upon the \sc Lord\sc*, [and he answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} them. 
\v 7 [He spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto them in the cloudy| strong="H6051" \w* \w pillar| strong="H5982" \w*: [they kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w his testimonies| strong="H5713" \w*, \w and the ordinance| strong="H2706" \w* that [he gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} them. 
\v 8 [Thou answeredst]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”} them, O \sc Lord\sc* \w our God| strong="H430" \w*: \w thou wast a God| strong="H410" \w* [that forgavest]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8802”} [them, though thou tookest vengeance]{strong=“H5358” x-morph=“strongMorph: \sc Th\sc*8802”} \w of their inventions| strong="H5949" \w*. 
\v 9 [Exalt]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8786”} the \sc Lord\sc* \w our God| strong="H430" \w*, [and worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8690”} \w at his holy| strong="H6944" \w* \w hill| strong="H2022" \w*; for the \sc Lord\sc* \w our God| strong="H430" \w* is \w holy| strong="H6918" \w*.
\c 100
\p 
\w A Psalm| strong="H4210" \w* \w of praise| strong="H8426" \w*. 
\v 1 [Make a joyful noise]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8685”} unto the \sc Lord\sc*, \w all ye lands| strong="H776" \w*.\f + \fr 100:1 \ft praise: or, thanksgiving \f* \f + \fr 100:1 \ft all…: Heb. all the earth \f* 
\v 2 [Serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8798”} the \sc Lord\sc* \w with gladness| strong="H8057" \w*: [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} \w before his presence| strong="H6440" \w* \w with singing| strong="H7445" \w*. 
\v 3 [Know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”} ye that the \sc Lord\sc* he is \w God| strong="H430" \w*: it is he that [hath made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} us, and not we ourselves; we are \w his people| strong="H5971" \w*, \w and the sheep| strong="H6629" \w* \w of his pasture| strong="H4830" \w*.\f + \fr 100:3 \ft and not…: or, and his we are \f* 
\v 4 [Enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} \w into his gates| strong="H8179" \w* \w with thanksgiving| strong="H8426" \w*, and \w into his courts| strong="H2691" \w* \w with praise| strong="H8416" \w*: [be thankful]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8685”} unto him, and [bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} \w his name| strong="H8034" \w*. 
\v 5 For the \sc Lord\sc* is \w good| strong="H2896" \w*; \w his mercy| strong="H2617" \w* is \w everlasting| strong="H5769" \w*; \w and his truth| strong="H530" \w* endureth \w to all| strong="H1755" \w* \w generations| strong="H1755" \w*.\f + \fr 100:5 \ft to all…: Heb. to generation and generation \f*
\c 101
\p 
\w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 [I will sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8799”} \w of mercy| strong="H2617" \w* \w and judgment| strong="H4941" \w*: unto thee, O \sc Lord\sc*, [will I sing]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 2 [I will behave myself wisely]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8686”} \w in a perfect| strong="H8549" \w* \w way| strong="H1870" \w*. [O when wilt thou come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me? I will walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8691”} \w within| strong="H7130" \w* \w my house| strong="H1004" \w* \w with a perfect| strong="H8537" \w* \w heart| strong="H3824" \w*. 
\v 3 [I will set]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w no wicked| strong="H1100" \w* \w thing| strong="H1697" \w* \w before mine eyes| strong="H5869" \w*: [I hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”} [the work]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w of them that turn aside| strong="H7750" \w*; it [shall not cleave]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8799”} to me.\f + \fr 101:3 \ft wicked…: Heb. thing of Belial \f* 
\v 4 \w A froward| strong="H6141" \w* \w heart| strong="H3824" \w* [shall depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8799”} [from me: I will not know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w a wicked| strong="H7451" \w* person. 
\v 5 \w Whoso privily| strong="H5643" \w* [slandereth]{strong=“H3960 H3960” x-morph=“strongMorph: \sc Th\sc*8781 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8764”} \w his neighbour| strong="H7453" \w*, [him will I cut off]{strong=“H6789” x-morph=“strongMorph: \sc Th\sc*8686”}: \w him that hath an high| strong="H1362" \w* \w look| strong="H5869" \w* \w and a proud| strong="H7342" \w* \w heart| strong="H3824" \w* [will not I suffer]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 6 \w Mine eyes| strong="H5869" \w* shall be [upon the faithful]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8737”} \w of the land| strong="H776" \w*, [that they may dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} [with me: he that walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w in a perfect| strong="H8549" \w* \w way| strong="H1870" \w*, [he shall serve]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8762”} me.\f + \fr 101:6 \ft in a…: or, perfect in the way \f* 
\v 7 [He that worketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w deceit| strong="H7423" \w* [shall not dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w within| strong="H7130" \w* \w my house| strong="H1004" \w*: [he that telleth]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} \w lies| strong="H8267" \w* [shall not tarry]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8735”} \w in my sight| strong="H5869" \w*.\f + \fr 101:7 \ft shall not tarry: Heb. shall not be established \f* 
\v 8 \w I will early| strong="H1242" \w* [destroy]{strong=“H6789” x-morph=“strongMorph: \sc Th\sc*8686”} \w all the wicked| strong="H7563" \w* \w of the land| strong="H776" \w*; [that I may cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8687”} \w all wicked| strong="H205" \w* [doers]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w from the city| strong="H5892" \w* of the \sc Lord\sc*.
\c 102
\p 
\w A Prayer| strong="H8605" \w* \w of the afflicted| strong="H6041" \w*, [when he is overwhelmed]{strong=“H5848” x-morph=“strongMorph: \sc Th\sc*8799”}, [and poureth out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8799”} \w his complaint| strong="H7879" \w* \w before| strong="H6440" \w* the \sc Lord\sc*. 
\v 1 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w my prayer| strong="H8605" \w*, O \sc Lord\sc*, \w and let my cry| strong="H7775" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} unto thee.\f + \fr 102:1 \ft of: or, for \f* 
\v 2 [Hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8686”} \w not thy face| strong="H6440" \w* \w from me in the day| strong="H3117" \w* when \w I am in trouble| strong="H6862" \w*; [incline]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8685”} \w thine ear| strong="H241" \w* [unto me: in the day]{strong=“H3117”} when [I call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} [answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8798”} \w me speedily| strong="H4118" \w*. 
\v 3 \w For my days| strong="H3117" \w* [are consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”} \w like smoke| strong="H6227" \w*, \w and my bones| strong="H6106" \w* [are burned]{strong=“H2787” x-morph=“strongMorph: \sc Th\sc*8738”} \w as an hearth| strong="H4168" \w*.\f + \fr 102:3 \ft like…: or, (as some read) into smoke \f* 
\v 4 \w My heart| strong="H3820" \w* [is smitten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8717”}, [and withered]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8799”} \w like grass| strong="H6212" \w*; [so that I forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} [to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} \w my bread| strong="H3899" \w*. 
\v 5 \w By reason of the voice| strong="H6963" \w* \w of my groaning| strong="H585" \w* \w my bones| strong="H6106" \w* [cleave]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8804”} \w to my skin| strong="H1320" \w*.\f + \fr 102:5 \ft skin: or, flesh \f* 
\v 6 [I am like]{strong=“H1819” x-morph=“strongMorph: \sc Th\sc*8804”} \w a pelican| strong="H6893" \w* \w of the wilderness| strong="H4057" \w*: \w I am like an owl| strong="H3563" \w* \w of the desert| strong="H2723" \w*. 
\v 7 [I watch]{strong=“H8245” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and am as a sparrow| strong="H6833" \w* [alone]{strong=“H909” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the house top| strong="H1406" \w*. 
\v 8 [Mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [reproach]{strong=“H2778” x-morph=“strongMorph: \sc Th\sc*8765”} \w me all the day| strong="H3117" \w*; and [they that are mad]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8781”} [against me are sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} against me. 
\v 9 [For I have eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w ashes| strong="H665" \w* \w like bread| strong="H3899" \w*, [and mingled]{strong=“H4537” x-morph=“strongMorph: \sc Th\sc*8804”} \w my drink| strong="H8249" \w* \w with weeping| strong="H1065" \w*, 
\v 10 \w Because| strong="H6440" \w* \w of thine indignation| strong="H2195" \w* \w and thy wrath| strong="H7110" \w*: [for thou hast lifted me up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”}, [and cast me down]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 11 \w My days| strong="H3117" \w* are \w like a shadow| strong="H6738" \w* [that declineth]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8803”}; [and I am withered]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8799”} \w like grass| strong="H6212" \w*. 
\v 12 But thou, O \sc Lord\sc*, [shalt endure]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w for ever| strong="H5769" \w*; \w and thy remembrance| strong="H2143" \w* \w unto all| strong="H1755" \w* \w generations| strong="H1755" \w*. 
\v 13 [Thou shalt arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, and [have mercy]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8762”} \w upon Zion| strong="H6726" \w*: \w for the time| strong="H6256" \w* [to favour]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8800”} [her, yea, the set time]{strong=“H4150”}, [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 14 \w For thy servants| strong="H5650" \w* [take pleasure]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8804”} \w in her stones| strong="H68" \w*, [and favour]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8779”} \w the dust| strong="H6083" \w* thereof. 
\v 15 \w So the heathen| strong="H1471" \w* [shall fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w the name| strong="H8034" \w* of the \sc Lord\sc*, \w and all the kings| strong="H4428" \w* \w of the earth| strong="H776" \w* \w thy glory| strong="H3519" \w*. 
\v 16 When the \sc Lord\sc* [shall build up]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w Zion| strong="H6726" \w*, [he shall appear]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8738”} \w in his glory| strong="H3519" \w*. 
\v 17 [He will regard]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8804”} \w the prayer| strong="H8605" \w* \w of the destitute| strong="H6199" \w*, [and not despise]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8804”} \w their prayer| strong="H8605" \w*. 
\v 18 [This shall be written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8735”} \w for the generation| strong="H1755" \w* \w to come| strong="H314" \w*: \w and the people| strong="H5971" \w* [which shall be created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8737”} [shall praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} the \sc Lord\sc*. 
\v 19 [For he hath looked down]{strong=“H8259” x-morph=“strongMorph: \sc Th\sc*8689”} \w from the height| strong="H4791" \w* \w of his sanctuary| strong="H6944" \w*; \w from heaven| strong="H8064" \w* did the \sc Lord\sc* [behold]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8689”} \w the earth| strong="H776" \w*; 
\v 20 [To hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w the groaning| strong="H603" \w* \w of the prisoner| strong="H615" \w*; [to loose]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8763”} \w those that are appointed| strong="H1121" \w* \w to death| strong="H8546" \w*;\f + \fr 102:20 \ft those…: Heb. the children of death \f* 
\v 21 [To declare]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8763”} \w the name| strong="H8034" \w* of the \sc Lord\sc* \w in Zion| strong="H6726" \w*, \w and his praise| strong="H8416" \w* \w in Jerusalem| strong="H3389" \w*; 
\v 22 \w When the people| strong="H5971" \w* [are gathered]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8736”} \w together| strong="H3162" \w*, \w and the kingdoms| strong="H4467" \w*, [to serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8800”} the \sc Lord\sc*. 
\v 23 [He weakened]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8765”} \w my strength| strong="H3581" \w* \w in the way| strong="H1870" \w*; [he shortened]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8765”} \w my days| strong="H3117" \w*.\f + \fr 102:23 \ft weakened: Heb. afflicted \f* 
\v 24 [I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w O my God| strong="H410" \w*, [take me not away]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w in the midst| strong="H2677" \w* \w of my days| strong="H3117" \w*: \w thy years| strong="H8141" \w* are \w throughout all| strong="H1755" \w* \w generations| strong="H1755" \w*. 
\v 25 \w Of old| strong="H6440" \w* [hast thou laid the foundation]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the earth| strong="H776" \w*: \w and the heavens| strong="H8064" \w* are \w the work| strong="H4639" \w* \w of thy hands| strong="H3027" \w*. 
\v 26 [They shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}, [but thou shalt endure]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”}: [yea, all of them shall wax old]{strong=“H1086” x-morph=“strongMorph: \sc Th\sc*8799”} \w like a garment| strong="H899" \w*; \w as a vesture| strong="H3830" \w* [shalt thou change]{strong=“H2498” x-morph=“strongMorph: \sc Th\sc*8686”} [them, and they shall be changed]{strong=“H2498” x-morph=“strongMorph: \sc Th\sc*8799”}:\f + \fr 102:26 \ft endure: Heb. stand \f* 
\v 27 But thou art [the same, and thy years]{strong=“H8141”} [shall have no end]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 28 \w The children| strong="H1121" \w* \w of thy servants| strong="H5650" \w* [shall continue]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and their seed| strong="H2233" \w* [shall be established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8735”} \w before| strong="H6440" \w* thee.
\c 103
\p 
A Psalm \w of David| strong="H1732" \w*. 
\v 1 [Bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc*, \w O my soul| strong="H5315" \w*: \w and all that is within| strong="H7130" \w* me, bless \w his holy| strong="H6944" \w* \w name| strong="H8034" \w*. 
\v 2 [Bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc*, \w O my soul| strong="H5315" \w*, [and forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} \w not all his benefits| strong="H1576" \w*: 
\v 3 [Who forgiveth]{strong=“H5545” x-morph=“strongMorph: \sc Th\sc*8802”} \w all thine iniquities| strong="H5771" \w*; [who healeth]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8802”} \w all thy diseases| strong="H8463" \w*; 
\v 4 [Who redeemeth]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”} \w thy life| strong="H2416" \w* \w from destruction| strong="H7845" \w*; [who crowneth]{strong=“H5849” x-morph=“strongMorph: \sc Th\sc*8764”} \w thee with lovingkindness| strong="H2617" \w* \w and tender mercies| strong="H7356" \w*; 
\v 5 [Who satisfieth]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8688”} \w thy mouth| strong="H5716" \w* \w with good| strong="H2896" \w* things; so that \w thy youth| strong="H5271" \w* [is renewed]{strong=“H2318” x-morph=“strongMorph: \sc Th\sc*8691”} [like the eagle’s]{strong=“H5404”}. 
\v 6 The \sc Lord\sc* [executeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w righteousness| strong="H6666" \w* \w and judgment| strong="H4941" \w* [for all that are oppressed]{strong=“H6231” x-morph=“strongMorph: \sc Th\sc*8803”}. 
\v 7 [He made known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8686”} \w his ways| strong="H1870" \w* \w unto Moses| strong="H4872" \w*, \w his acts| strong="H5949" \w* \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*. 
\v 8 The \sc Lord\sc* is \w merciful| strong="H7349" \w* \w and gracious| strong="H2587" \w*, \w slow| strong="H750" \w* \w to anger| strong="H639" \w*, \w and plenteous| strong="H7227" \w* \w in mercy| strong="H2617" \w*.\f + \fr 103:8 \ft plenteous…: Heb. great in mercy \f* 
\v 9 \w He will not always| strong="H5331" \w* [chide]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”}: [neither will he keep]{strong=“H5201” x-morph=“strongMorph: \sc Th\sc*8799”} his anger \w for ever| strong="H5769" \w*. 
\v 10 [He hath not dealt]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w with us after our sins| strong="H2399" \w*; [nor rewarded]{strong=“H1580” x-morph=“strongMorph: \sc Th\sc*8804”} \w us according to our iniquities| strong="H5771" \w*. 
\v 11 \w For as the heaven| strong="H8064" \w* [is high above]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8800”} \w the earth| strong="H776" \w*, so [great]{strong=“H1396” x-morph=“strongMorph: \sc Th\sc*8804”} \w is his mercy| strong="H2617" \w* \w toward them that fear| strong="H3373" \w* him.\f + \fr 103:11 \ft as…: Heb. according to the height of the heaven \f* 
\v 12 [As far as]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8800”} \w the east| strong="H4217" \w* \w is from the west| strong="H4628" \w*, so [far hath he removed]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8689”} \w our transgressions| strong="H6588" \w* from us. 
\v 13 \w Like as a father| strong="H1" \w* [pitieth]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8763”} his \w children| strong="H1121" \w*, so the \sc Lord\sc* [pitieth]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8765”} \w them that fear| strong="H3373" \w* him. 
\v 14 [For he knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w our frame| strong="H3336" \w*; [he remembereth]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8803”} that we are \w dust| strong="H6083" \w*. 
\v 15 As for \w man| strong="H582" \w*, \w his days| strong="H3117" \w* are \w as grass| strong="H2682" \w*: \w as a flower| strong="H6731" \w* \w of the field| strong="H7704" \w*, [so he flourisheth]{strong=“H6692” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 16 \w For the wind| strong="H7307" \w* [passeth over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} [it, and it is gone; and the place]{strong=“H4725”} [thereof shall know]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8686”} it no more.\f + \fr 103:16 \ft it is…: Heb. it is not \f* 
\v 17 \w But the mercy| strong="H2617" \w* of the \sc Lord\sc* is \w from everlasting| strong="H5769" \w* \w to| strong="H5704" \w* \w everlasting| strong="H5769" \w* \w upon them that fear| strong="H3373" \w* [him, and his righteousness]{strong=“H6666”} [unto children’s]{strong=“H1121”} \w children| strong="H1121" \w*; 
\v 18 [To such as keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w his covenant| strong="H1285" \w*, [and to those that remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8802”} \w his commandments| strong="H6490" \w* [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} them. 
\v 19 The \sc Lord\sc* [hath prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8689”} \w his throne| strong="H3678" \w* \w in the heavens| strong="H8064" \w*; \w and his kingdom| strong="H4438" \w* [ruleth]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8804”} over all. 
\v 20 [Bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc*, \w ye his angels| strong="H4397" \w*, \w that excel| strong="H1368" \w* \w in strength| strong="H3581" \w*, [that do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w his commandments| strong="H1697" \w*, [hearkening ]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto the voice| strong="H6963" \w* \w of his word| strong="H1697" \w*.\f + \fr 103:20 \ft that excel…: Heb. mighty in strength \f* 
\v 21 [Bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*, all ye \w his hosts| strong="H6635" \w*; ye [ministers]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8764”} [of his, that do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w his pleasure| strong="H7522" \w*. 
\v 22 [Bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc*, \w all his works| strong="H4639" \w* \w in all places| strong="H4725" \w* \w of his dominion| strong="H4475" \w*: [bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc*, \w O my soul| strong="H5315" \w*.
\c 104
\p 
\v 1 [Bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc*, \w O my soul| strong="H5315" \w*. O \sc Lord\sc* \w my God| strong="H430" \w*, \w thou art very| strong="H3966" \w* [great]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8804”}; [thou art clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8804”} \w with honour| strong="H1935" \w* \w and majesty| strong="H1926" \w*. 
\v 2 [Who coverest]{strong=“H5844” x-morph=“strongMorph: \sc Th\sc*8802”} thyself \w with light| strong="H216" \w* as with \w a garment| strong="H8008" \w*: [who stretchest out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8802”} \w the heavens| strong="H8064" \w* \w like a curtain| strong="H3407" \w*: 
\v 3 [Who layeth the beams]{strong=“H7136” x-morph=“strongMorph: \sc Th\sc*8764”} \w of his chambers| strong="H5944" \w* \w in the waters| strong="H4325" \w*: [who maketh]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8802”} \w the clouds| strong="H5645" \w* \w his chariot| strong="H7398" \w*: [who walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8764”} \w upon the wings| strong="H3671" \w* \w of the wind| strong="H7307" \w*: 
\v 4 [Who maketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w his angels| strong="H4397" \w* \w spirits| strong="H7307" \w*; [his ministers]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8764”} [a flaming]{strong=“H3857” x-morph=“strongMorph: \sc Th\sc*8802”} \w fire| strong="H784" \w*: 
\v 5 Who [laid]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8804”} \w the foundations| strong="H4349" \w* \w of the earth| strong="H776" \w*, that [it should not be removed]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8735”} [for ever]{strong=“H5703 H5769”}.\f + \fr 104:5 \ft Who…: Heb. He hath founded the earth upon her bases \f* 
\v 6 [Thou coveredst]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”} \w it with the deep| strong="H8415" \w* as with \w a garment| strong="H3830" \w*: \w the waters| strong="H4325" \w* [stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w above the mountains| strong="H2022" \w*. 
\v 7 \w At| strong="H4480" \w* \w thy rebuke| strong="H1606" \w* [they fled]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”}; \w at the voice| strong="H6963" \w* \w of thy thunder| strong="H7482" \w* [they hasted]{strong=“H2648” x-morph=“strongMorph: \sc Th\sc*8735”} away. 
\v 8 [They go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the mountains| strong="H2022" \w*; [they go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the valleys| strong="H1237" \w* \w unto the place| strong="H4725" \w* \w which| strong="H2088" \w* [thou hast founded]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8804”} for them.\f + \fr 104:8 \ft They go up…: or, The mountains ascend, the valleys descend \f* 
\v 9 [Thou hast set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w a bound| strong="H1366" \w* [that they may not pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}; [that they turn not again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [to cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8763”} \w the earth| strong="H776" \w*. 
\v 10 [He sendeth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8764”} \w the springs| strong="H4599" \w* \w into the valleys| strong="H5158" \w*, which [run]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8762”} \w among the hills| strong="H2022" \w*.\f + \fr 104:10 \ft He: Heb. Who \f* \f + \fr 104:10 \ft run: Heb. walk \f* 
\v 11 [They give drink]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8686”} \w to every beast| strong="H2416" \w* \w of the field| strong="H7704" \w*: \w the wild asses| strong="H6501" \w* [quench]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8799”} \w their thirst| strong="H6772" \w*.\f + \fr 104:11 \ft quench: Heb. break \f* 
\v 12 \w By them shall the fowls| strong="H5775" \w* \w of the heaven| strong="H8064" \w* [have their habitation]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”}, which [sing]{strong=“H6963 H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w among| strong="H996" \w* \w the branches| strong="H6073" \w*.\f + \fr 104:12 \ft sing: Heb. give a voice \f* 
\v 13 [He watereth]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8688”} \w the hills| strong="H2022" \w* \w from his chambers| strong="H5944" \w*: \w the earth| strong="H776" \w* [is satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the fruit| strong="H6529" \w* \w of thy works| strong="H4639" \w*. 
\v 14 \w He causeth the grass| strong="H2682" \w* [to grow]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8688”} \w for the cattle| strong="H929" \w*, \w and herb| strong="H6212" \w* \w for the service| strong="H5656" \w* \w of man| strong="H120" \w*: [that he may bring forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8687”} \w food| strong="H3899" \w* \w out of the earth| strong="H776" \w*; 
\v 15 \w And wine| strong="H3196" \w* that [maketh glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8762”} \w the heart| strong="H3824" \w* \w of man| strong="H582" \w*, and \w oil| strong="H8081" \w* to make his \w face| strong="H6440" \w* [to shine]{strong=“H6670” x-morph=“strongMorph: \sc Th\sc*8687”}, \w and bread| strong="H3899" \w* which [strengtheneth]{strong=“H5582” x-morph=“strongMorph: \sc Th\sc*8799”} [man’s]{strong=“H582”} \w heart| strong="H3824" \w*.\f + \fr 104:15 \ft oil…: Heb. to make his face shine with oil, or, more than oil \f* 
\v 16 \w The trees| strong="H6086" \w* of the \sc Lord\sc* [are full]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”} of sap; \w the cedars| strong="H730" \w* \w of Lebanon| strong="H3844" \w*, [which he hath planted]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8804”}; 
\v 17 \w Where the birds| strong="H6833" \w* [make their nests]{strong=“H7077” x-morph=“strongMorph: \sc Th\sc*8762”}: as for \w the stork| strong="H2624" \w*, \w the fir trees| strong="H1265" \w* are \w her house| strong="H1004" \w*. 
\v 18 \w The high| strong="H1364" \w* \w hills| strong="H2022" \w* are \w a refuge| strong="H4268" \w* \w for the wild goats| strong="H3277" \w*; and \w the rocks| strong="H5553" \w* \w for the conies| strong="H8227" \w*. 
\v 19 [He appointed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w the moon| strong="H3394" \w* \w for seasons| strong="H4150" \w*: \w the sun| strong="H8121" \w* [knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w his going down| strong="H3996" \w*. 
\v 20 [Thou makest]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w darkness| strong="H2822" \w*, \w and it is night| strong="H3915" \w*: \w wherein all the beasts| strong="H2416" \w* \w of the forest| strong="H3293" \w* [do creep]{strong=“H7430” x-morph=“strongMorph: \sc Th\sc*8799”} forth.\f + \fr 104:20 \ft beasts…: Heb. beasts thereof do trample on the forest \f* 
