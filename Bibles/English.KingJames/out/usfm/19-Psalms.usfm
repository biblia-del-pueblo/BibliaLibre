\h Psalms
\toc1 Psalms
\p
\rem From here on, this file is autogenerated by bibmark. You may edit the header section, as it will not be changed by bibmark.

\c 1
\p 
\v 1 \w Blessed| strong="H835" \w* is \w the man| strong="H376" \w* [that walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w not in the counsel| strong="H6098" \w* \w of the ungodly| strong="H7563" \w*, [nor standeth]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the way| strong="H1870" \w* \w of sinners| strong="H2400" \w*, [nor sitteth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the seat| strong="H4186" \w* [of the scornful]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8801”}.\f + \fr 1:1 \ft ungodly: or, wicked \f* 
\v 2 \w But his delight| strong="H2656" \w* is \w in the law| strong="H8451" \w* of the \sc Lord\sc*; \w and in his law| strong="H8451" \w* [doth he meditate]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8799”} \w day| strong="H3119" \w* \w and night| strong="H3915" \w*. 
\v 3 \w And he shall be like a tree| strong="H6086" \w* [planted]{strong=“H8362” x-morph=“strongMorph: \sc Th\sc*8803”} \w by the rivers| strong="H6388" \w* \w of water| strong="H4325" \w*, [that bringeth forth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w his fruit| strong="H6529" \w* \w in his season| strong="H6256" \w*; \w his leaf| strong="H5929" \w* [also shall not wither]{strong=“H5034” x-morph=“strongMorph: \sc Th\sc*8799”}; [and whatsoever he doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [shall prosper]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8686”}.\f + \fr 1:3 \ft wither: Heb. fade \f* 
\v 4 \w The ungodly| strong="H7563" \w* are not so: but are \w like the chaff| strong="H4671" \w* \w which the wind| strong="H7307" \w* [driveth away]{strong=“H5086” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 5 \w Therefore the ungodly| strong="H7563" \w* [shall not stand]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the judgment| strong="H4941" \w*, \w nor sinners| strong="H2400" \w* \w in the congregation| strong="H5712" \w* \w of the righteous| strong="H6662" \w*. 
\v 6 For the \sc Lord\sc* [knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w the way| strong="H1870" \w* \w of the righteous| strong="H6662" \w*: \w but the way| strong="H1870" \w* \w of the ungodly| strong="H7563" \w* [shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}.
\c 2
\p 
\v 1 \w Why do the heathen| strong="H1471" \w* [rage]{strong=“H7283” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and the people| strong="H3816" \w* [imagine]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8799”} \w a vain thing| strong="H7385" \w*?\f + \fr 2:1 \ft rage: or, tumultuously assemble \f* \f + \fr 2:1 \ft imagine: Heb. meditate \f* 
\v 2 \w The kings| strong="H4428" \w* \w of the earth| strong="H776" \w* [set]{strong=“H3320” x-morph=“strongMorph: \sc Th\sc*8691”} [themselves, and the rulers]{strong=“H7336” x-morph=“strongMorph: \sc Th\sc*8802”} [take counsel]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8738”} \w together| strong="H3162" \w*, against the \sc Lord\sc*, \w and against his anointed| strong="H4899" \w*, saying, 
\v 3 \w Let us break| strong="H5423" \w* \w their bands| strong="H4147" \w* [asunder]{strong=“H5423” x-morph=“strongMorph: \sc Th\sc*8762”}, [and cast away]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w their cords| strong="H5688" \w* from us. 
\v 4 [He that sitteth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the heavens| strong="H8064" \w* [shall laugh]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8799”}: \w the Lord| strong="H136" \w* [shall have them in derision]{strong=“H3932” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 5 [Then shall he speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto them in his wrath| strong="H639" \w*, [and vex]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8762”} \w them in his sore displeasure| strong="H2740" \w*.\f + \fr 2:5 \ft vex: or, trouble \f* 
\v 6 [Yet have I set]{strong=“H5258” x-morph=“strongMorph: \sc Th\sc*8804”} \w my king| strong="H4428" \w* \w upon my holy| strong="H6944" \w* \w hill| strong="H2022" \w* \w of Zion| strong="H6726" \w*.\f + \fr 2:6 \ft set: Heb. anointed \f* \f + \fr 2:6 \ft upon…: Heb. upon Zion, the hill of my holiness \f* 
\v 7 [I will declare]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} \w the decree| strong="H2706" \w*: the \sc Lord\sc* [hath said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} unto me, Thou art \w my Son| strong="H1121" \w*; \w this day| strong="H3117" \w* [have I begotten]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} thee.\f + \fr 2:7 \ft the decree: or, for a decree \f* 
\v 8 [Ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8798”} [of me, and I shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} thee \w the heathen| strong="H1471" \w* for \w thine inheritance| strong="H5159" \w*, \w and the uttermost parts| strong="H657" \w* \w of the earth| strong="H776" \w* for \w thy possession| strong="H272" \w*. 
\v 9 [Thou shalt break]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8799”} \w them with a rod| strong="H7626" \w* \w of iron| strong="H1270" \w*; [thou shalt dash them in pieces]{strong=“H5310” x-morph=“strongMorph: \sc Th\sc*8762”} [like a potter’s]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w vessel| strong="H3627" \w*. 
\v 10 [Be wise]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8685”} [now therefore, O ye kings]{strong=“H4428”}: [be instructed]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8734”}, [ye judges]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the earth| strong="H776" \w*. 
\v 11 [Serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8798”} the \sc Lord\sc* \w with fear| strong="H3374" \w*, [and rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8798”} \w with trembling| strong="H7461" \w*. 
\v 12 [Kiss]{strong=“H5401” x-morph=“strongMorph: \sc Th\sc*8761”} \w the Son| strong="H1248" \w*, [lest he be angry]{strong=“H599” x-morph=“strongMorph: \sc Th\sc*8799”}, [and ye perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”} from \w the way| strong="H1870" \w*, \w when his wrath| strong="H639" \w* [is kindled]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8799”} \w but a little| strong="H4592" \w*. \w Blessed| strong="H835" \w* are [all they that put their trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8802”} in him.
\c 3
\p 
\w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*, [when he fled]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8800”} \w from| strong="H6440" \w* \w Absalom| strong="H53" \w* \w his son| strong="H1121" \w*. 
\v 1 \sc Lord\sc*, [how are they increased]{strong=“H7231” x-morph=“strongMorph: \sc Th\sc*8804”} \w that trouble| strong="H6862" \w* [me! many]{strong=“H7227”} are [they that rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8801”} against me. 
\v 2 \w Many| strong="H7227" \w* there be [which say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} \w of my soul| strong="H5315" \w*, There is \w no help| strong="H3444" \w* \w for him in God| strong="H430" \w*. \w Selah| strong="H5542" \w*. 
\v 3 But thou, O \sc Lord\sc*, art \w a shield| strong="H4043" \w* [for me; my glory]{strong=“H3519”}, [and the lifter up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8688”} \w of mine head| strong="H7218" \w*.\f + \fr 3:3 \ft for: or, about \f* 
\v 4 [I cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc* \w with my voice| strong="H6963" \w*, [and he heard]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w me out of his holy| strong="H6944" \w* \w hill| strong="H2022" \w*. \w Selah| strong="H5542" \w*. 
\v 5 [I laid me down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8804”} [and slept]{strong=“H3462” x-morph=“strongMorph: \sc Th\sc*8799”}; [I awaked]{strong=“H6974” x-morph=“strongMorph: \sc Th\sc*8689”}; for the \sc Lord\sc* [sustained]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8799”} me. 
\v 6 [I will not be afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w of ten thousands| strong="H7233" \w* \w of people| strong="H5971" \w*, [that have set]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8804”} themselves \w against me round about| strong="H5439" \w*. 
\v 7 [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, O \sc Lord\sc*; [save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”} [me, O my God]{strong=“H430”}: [for thou hast smitten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} [all mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} upon \w the cheek bone| strong="H3895" \w*; [thou hast broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8765”} \w the teeth| strong="H8127" \w* \w of the ungodly| strong="H7563" \w*. 
\v 8 \w Salvation| strong="H3444" \w* belongeth unto the \sc Lord\sc*: \w thy blessing| strong="H1293" \w* is \w upon thy people| strong="H5971" \w*. \w Selah| strong="H5542" \w*.
\c 4
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} \w on Neginoth| strong="H5058" \w*, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 [Hear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8798”} [me when I call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8800”}, \w O God| strong="H430" \w* \w of my righteousness| strong="H6664" \w*: [thou hast enlarged]{strong=“H7337” x-morph=“strongMorph: \sc Th\sc*8689”} me when I was \w in distress| strong="H6862" \w*; [have mercy]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} [upon me, and hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w my prayer| strong="H8605" \w*.\f + \fr 4:1 \ft chief…: or, overseer \f* \f + \fr 4:1 \ft have…: or, be gracious unto me \f* 
\v 2 \w O ye sons| strong="H1121" \w* \w of men| strong="H376" \w*, \w how long| strong="H5704" \w* will ye turn \w my glory| strong="H3519" \w* \w into shame| strong="H3639" \w*? how long [will ye love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8799”} \w vanity| strong="H7385" \w*, and [seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w after leasing| strong="H3577" \w*? \w Selah| strong="H5542" \w*. 
\v 3 [But know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”} that the \sc Lord\sc* [hath set apart]{strong=“H6395” x-morph=“strongMorph: \sc Th\sc*8689”} \w him that is godly| strong="H2623" \w* for himself: the \sc Lord\sc* [will hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [when I call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8800”} unto him. 
\v 4 [Stand in awe]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8798”}, [and sin]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8799”} [not: commune]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w with your own heart| strong="H3824" \w* \w upon your bed| strong="H4904" \w*, [and be still]{strong=“H1826” x-morph=“strongMorph: \sc Th\sc*8798”}. \w Selah| strong="H5542" \w*. 
\v 5 [Offer]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8798”} \w the sacrifices| strong="H2077" \w* \w of righteousness| strong="H6664" \w*, [and put your trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8798”} in the \sc Lord\sc*. 
\v 6 There be \w many| strong="H7227" \w* [that say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, [Who will shew]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8686”} us any \w good| strong="H2896" \w*? \sc Lord\sc*, [lift thou up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w the light| strong="H216" \w* \w of thy countenance| strong="H6440" \w* upon us. 
\v 7 [Thou hast put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w gladness| strong="H8057" \w* \w in my heart| strong="H3820" \w*, \w more than in the time| strong="H6256" \w* that \w their corn| strong="H1715" \w* \w and their wine| strong="H8492" \w* [increased]{strong=“H7231” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 8 \w I will both| strong="H3162" \w* [lay me down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w in peace| strong="H7965" \w*, [and sleep]{strong=“H3462” x-morph=“strongMorph: \sc Th\sc*8799”}: for thou, \sc Lord\sc*, \w only| strong="H910" \w* [makest me dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8686”} \w in safety| strong="H983" \w*.
\c 5
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} \w upon Nehiloth| strong="H5155" \w*, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 [Give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”} \w to my words| strong="H561" \w*, O \sc Lord\sc*, [consider]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8798”} \w my meditation| strong="H1901" \w*. 
\v 2 [Hearken]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto the voice| strong="H6963" \w* \w of my cry| strong="H7773" \w*, \w my King| strong="H4428" \w*, \w and my God| strong="H430" \w*: [for unto thee will I pray]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8691”}. 
\v 3 \w My voice| strong="H6963" \w* [shalt thou hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the morning| strong="H1242" \w*, O \sc Lord\sc*; \w in the morning| strong="H1242" \w* [will I direct]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8799”} my prayer [unto thee, and will look up]{strong=“H6822” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 4 For thou art \w not a God| strong="H410" \w* \w that hath pleasure| strong="H2655" \w* \w in wickedness| strong="H7562" \w*: \w neither shall evil| strong="H7451" \w* [dwell]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”} with thee. 
\v 5 [The foolish]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8802”} [shall not stand]{strong=“H3320” x-morph=“strongMorph: \sc Th\sc*8691”} \w in thy sight| strong="H5869" \w*: [thou hatest]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”} [all workers]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w of iniquity| strong="H205" \w*.\f + \fr 5:5 \ft in…: Heb. before thine eyes \f* 
\v 6 [Thou shalt destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8762”} [them that speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} \w leasing| strong="H3577" \w*: the \sc Lord\sc* [will abhor]{strong=“H8581” x-morph=“strongMorph: \sc Th\sc*8762”} \w the bloody| strong="H1818" \w* \w and deceitful| strong="H4820" \w* \w man| strong="H376" \w*.\f + \fr 5:6 \ft bloody…: Heb. man of bloods and deceit \f* 
\v 7 [But as for me, I will come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} into \w thy house| strong="H1004" \w* \w in the multitude| strong="H7230" \w* \w of thy mercy| strong="H2617" \w*: and \w in thy fear| strong="H3374" \w* [will I worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} \w toward thy holy| strong="H6944" \w* \w temple| strong="H1964" \w*.\f + \fr 5:7 \ft thy holy…: Heb. the temple of thy holiness \f* 
\v 8 [Lead]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8798”} me, O \sc Lord\sc*, \w in thy righteousness| strong="H6666" \w* [because of mine enemies]{strong=“H8324” x-morph=“strongMorph: \sc Th\sc*8802”}; \w make thy way| strong="H1870" \w* [straight]{strong=“H3474” x-morph=“strongMorph: \sc Th\sc*8685”} \w before my face| strong="H6440" \w*.\f + \fr 5:8 \ft mine…: Heb. those which observe me \f* 
\v 9 For there is [no faithfulness]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8737”} \w in their mouth| strong="H6310" \w*; \w their inward| strong="H7130" \w* part is \w very wickedness| strong="H1942" \w*; \w their throat| strong="H1627" \w* is [an open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8803”} \w sepulchre| strong="H6913" \w*; [they flatter]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8686”} \w with their tongue| strong="H3956" \w*.\f + \fr 5:9 \ft faithfulness: or, stedfastness \f* \f + \fr 5:9 \ft their mouth: Heb. his mouth, that is, the mouth of any of them \f* \f + \fr 5:9 \ft very…: Heb. wickednesses \f* 
\v 10 [Destroy]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8685”} [thou them, O God]{strong=“H430”}; [let them fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w by their own counsels| strong="H4156" \w*; [cast them out]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8685”} \w in the multitude| strong="H7230" \w* \w of their transgressions| strong="H6588" \w*; [for they have rebelled]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8804”} against thee.\f + \fr 5:10 \ft Destroy…: or, Make them guilty \f* \f + \fr 5:10 \ft by…: or, from their counsels \f* 
\v 11 [But let all those that put their trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8802”} [in thee rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”}: \w let them ever| strong="H5769" \w* [shout for joy]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8762”}, [because thou defendest]{strong=“H5526” x-morph=“strongMorph: \sc Th\sc*8686”} [them: let them also that love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} \w thy name| strong="H8034" \w* [be joyful]{strong=“H5970” x-morph=“strongMorph: \sc Th\sc*8799”} in thee.\f + \fr 5:11 \ft defendest…: Heb. coverest over, or, protectest them \f* 
\v 12 For thou, \sc Lord\sc*, [wilt bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w the righteous| strong="H6662" \w*; \w with favour| strong="H7522" \w* [wilt thou compass]{strong=“H5849” x-morph=“strongMorph: \sc Th\sc*8799”} him as with \w a shield| strong="H6793" \w*.\f + \fr 5:12 \ft compass: Heb. crown \f*
\c 6
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} \w on Neginoth| strong="H5058" \w* \w upon Sheminith| strong="H8067" \w*, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 O \sc Lord\sc*, [rebuke]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”} \w me not in thine anger| strong="H639" \w*, [neither chasten]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8762”} \w me in thy hot displeasure| strong="H2534" \w*.\f + \fr 6:1 \ft chief…: or, overseer \f* \f + \fr 6:1 \ft Sheminith: or, the eighth \f* 
\v 2 [Have mercy]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} upon me, O \sc Lord\sc*; for I am \w weak| strong="H536" \w*: O \sc Lord\sc*, [heal]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8798”} [me; for my bones]{strong=“H6106”} [are vexed]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8738”}. 
