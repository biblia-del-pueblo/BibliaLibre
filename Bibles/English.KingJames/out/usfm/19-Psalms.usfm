\v 5 [For there are set]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w thrones| strong="H3678" \w* \w of judgment| strong="H4941" \w*, \w the thrones| strong="H3678" \w* \w of the house| strong="H1004" \w* \w of David| strong="H1732" \w*.\f + \fr 122:5 \ft are…: Heb. do sit \f* 
\v 6 [Pray]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8798”} \w for the peace| strong="H7965" \w* \w of Jerusalem| strong="H3389" \w*: [they shall prosper]{strong=“H7951” x-morph=“strongMorph: \sc Th\sc*8799”} [that love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} thee. 
\v 7 \w Peace| strong="H7965" \w* \w be within thy walls| strong="H2426" \w*, and \w prosperity| strong="H7962" \w* \w within thy palaces| strong="H759" \w*. 
\v 8 \w For my brethren| strong="H251" \w* [and companions’]{strong=“H7453”} [sakes, I will now say]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}, \w Peace| strong="H7965" \w* be within thee. 
\v 9 \w Because of the house| strong="H1004" \w* of the \sc Lord\sc* \w our God| strong="H430" \w* [I will seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy good| strong="H2896" \w*.
\c 123
\p 
\w A Song| strong="H7892" \w* \w of degrees| strong="H4609" \w*. 
\v 1 [Unto thee lift I up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine eyes| strong="H5869" \w*, [O thou that dwellest]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the heavens| strong="H8064" \w*. 
\v 2 [Behold, as the eyes]{strong=“H5869”} \w of servants| strong="H5650" \w* look \w unto the hand| strong="H3027" \w* \w of their masters| strong="H113" \w*, and \w as the eyes| strong="H5869" \w* \w of a maiden| strong="H8198" \w* \w unto the hand| strong="H3027" \w* \w of her mistress| strong="H1404" \w*; \w so our eyes| strong="H5869" \w* wait upon the \sc Lord\sc* \w our God| strong="H430" \w*, [until that he have mercy]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8799”} upon us. 
\v 3 [Have mercy]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} upon us, O \sc Lord\sc*, [have mercy]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} [upon us: for we are exceedingly]{strong=“H7227”} [filled]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8804”} \w with contempt| strong="H937" \w*. 
\v 4 \w Our soul| strong="H5315" \w* \w is exceedingly| strong="H7227" \w* [filled]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8804”} \w with the scorning| strong="H3933" \w* \w of those that are at ease| strong="H7600" \w*, and \w with the contempt| strong="H937" \w* [of the proud]{strong=“H1349 H1343 H3238” x-morph=“strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8678 strongMorph: \sc Th\sc*8802”}. 
\c 124
\p 
\w A Song| strong="H7892" \w* \w of degrees| strong="H4609" \w* \w of David| strong="H1732" \w*. 
\v 1 \w If| strong="H3884" \w* it had not been the \sc Lord\sc* [who was on our side, now may Israel]{strong=“H3478”} [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}; 
\v 2 \w If| strong="H3884" \w* it had not been the \sc Lord\sc* [who was on our side, when men]{strong=“H120”} [rose up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8800”} against us: 
\v 3 \w Then| strong="H233" \w* [they had swallowed us up]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8804”} \w quick| strong="H2416" \w*, \w when their wrath| strong="H639" \w* [was kindled]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8800”} against us: 
\v 4 \w Then| strong="H233" \w* \w the waters| strong="H4325" \w* [had overwhelmed]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8804”} [us, the stream]{strong=“H5158”} [had gone over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w our soul| strong="H5315" \w*: 
\v 5 \w Then| strong="H233" \w* \w the proud| strong="H2121" \w* \w waters| strong="H4325" \w* [had gone over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w our soul| strong="H5315" \w*. 
\v 6 [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} be the \sc Lord\sc*, [who hath not given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} us as \w a prey| strong="H2964" \w* \w to their teeth| strong="H8127" \w*. 
\v 7 \w Our soul| strong="H5315" \w* [is escaped]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8738”} \w as a bird| strong="H6833" \w* \w out of the snare| strong="H6341" \w* [of the fowlers]{strong=“H3369” x-morph=“strongMorph: \sc Th\sc*8802”}: \w the snare| strong="H6341" \w* [is broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8738”}, [and we are escaped]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 8 \w Our help| strong="H5828" \w* is \w in the name| strong="H8034" \w* of the \sc Lord\sc*, [who made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w heaven| strong="H8064" \w* \w and earth| strong="H776" \w*. 
\c 125
\p 
\w A Song| strong="H7892" \w* \w of degrees| strong="H4609" \w*. 
\v 1 [They that trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”} in the \sc Lord\sc* shall be \w as mount| strong="H2022" \w* \w Zion| strong="H6726" \w*, which [cannot be removed]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8735”}, but [abideth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w for ever| strong="H5769" \w*. 
\v 2 \w As the mountains| strong="H2022" \w* are \w round about| strong="H5439" \w* \w Jerusalem| strong="H3389" \w*, so the \sc Lord\sc* is \w round about| strong="H5439" \w* \w his people| strong="H5971" \w* \w from henceforth even for| strong="H5704" \w* \w ever| strong="H5769" \w*. 
\v 3 \w For the rod| strong="H7626" \w* \w of the wicked| strong="H7562" \w* [shall not rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the lot| strong="H1486" \w* \w of the righteous| strong="H6662" \w*; \w lest| strong="H4616" \w* \w the righteous| strong="H6662" \w* [put forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w their hands| strong="H3027" \w* \w unto iniquity| strong="H5766" \w*.\f + \fr 125:3 \ft the wicked: Heb. wickedness \f* 
\v 4 [Do good]{strong=“H2895” x-morph=“strongMorph: \sc Th\sc*8685”}, O \sc Lord\sc*, unto those that be \w good| strong="H2896" \w*, and to them that are \w upright| strong="H3477" \w* \w in their hearts| strong="H3826" \w*. 
\v 5 [As for such as turn aside]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8688”} \w unto their crooked ways| strong="H6128" \w*, the \sc Lord\sc* [shall lead them forth]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8686”} [with the workers]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w of iniquity| strong="H205" \w*: but \w peace| strong="H7965" \w* shall be \w upon Israel| strong="H3478" \w*.
\c 126
\p 
\w A Song| strong="H7892" \w* \w of degrees| strong="H4609" \w*. 
\v 1 When the \sc Lord\sc* [turned again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w the captivity| strong="H7870" \w* \w of Zion| strong="H6726" \w*, [we were like them that dream]{strong=“H2492” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 126:1 \ft turned…: Heb. returned the returning \f* 
\v 2 \w Then was our mouth| strong="H6310" \w* [filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”} \w with laughter| strong="H7814" \w*, \w and our tongue| strong="H3956" \w* \w with singing| strong="H7440" \w*: [then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w they among the heathen| strong="H1471" \w*, The \sc Lord\sc* [hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [great things]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8689”} for them.\f + \fr 126:2 \ft hath…: Heb. hath magnified to do with them \f* 
\v 3 The \sc Lord\sc* [hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [great things]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8689”} for us; whereof \w we are glad| strong="H8056" \w*. 
\v 4 [Turn again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} [our captivity]{strong=“H7622 H7622” x-morph=“strongMorph: \sc Th\sc*8675”}, O \sc Lord\sc*, \w as the streams| strong="H650" \w* \w in the south| strong="H5045" \w*. 
\v 5 [They that sow]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8802”} \w in tears| strong="H1832" \w* [shall reap]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8799”} \w in joy| strong="H7440" \w*.\f + \fr 126:5 \ft joy: or, singing \f* 
\v 6 [He that goeth]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [forth]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”} [and weepeth]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8800”}, [bearing]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8802”} \w precious| strong="H4901" \w* \w seed| strong="H2233" \w*, [shall doubtless]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w again with rejoicing| strong="H7440" \w*, [bringing]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8802”} \w his sheaves| strong="H485" \w* with him.\f + \fr 126:6 \ft precious…: or, seed basket \f*
\c 127
\p 
\w A Song| strong="H7892" \w* \w of degrees| strong="H4609" \w* \w for Solomon| strong="H8010" \w*. 
\v 1 Except the \sc Lord\sc* [build ]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w the house| strong="H1004" \w*, [they labour]{strong=“H5998” x-morph=“strongMorph: \sc Th\sc*8804”} \w in vain| strong="H7723" \w* [that build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8802”} it: except the \sc Lord\sc* [keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w the city| strong="H5892" \w*, [the watchman]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} [waketh]{strong=“H8245” x-morph=“strongMorph: \sc Th\sc*8804”} but \w in vain| strong="H7723" \w*.\f + \fr 127:1 \ft for…: or, of Solomon \f* \f + \fr 127:1 \ft that…: Heb. that are builders of it in it \f* 
\v 2 It is \w vain| strong="H7723" \w* [for you to rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8800”} [early]{strong=“H7925” x-morph=“strongMorph: \sc Th\sc*8688”}, [to sit up]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} [late]{strong=“H309” x-morph=“strongMorph: \sc Th\sc*8764”}, [to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} \w the bread| strong="H3899" \w* \w of sorrows| strong="H6089" \w*: for [so he giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w his beloved| strong="H3039" \w* \w sleep| strong="H8142" \w*. 
\v 3 [Lo, children]{strong=“H1121”} are \w an heritage| strong="H5159" \w* of the \sc Lord\sc*: and \w the fruit| strong="H6529" \w* \w of the womb| strong="H990" \w* is his \w reward| strong="H7939" \w*. 
\v 4 \w As arrows| strong="H2671" \w* are \w in the hand| strong="H3027" \w* \w of a mighty man| strong="H1368" \w*; so are \w children| strong="H1121" \w* \w of the youth| strong="H5271" \w*. 
\v 5 \w Happy| strong="H835" \w* is \w the man| strong="H1397" \w* \w that hath his quiver| strong="H827" \w* [full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8765”} [of them: they shall not be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}, [but they shall speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [with the enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the gate| strong="H8179" \w*.\f + \fr 127:5 \ft his…: Heb. filled his quiver with them \f* \f + \fr 127:5 \ft speak…: or, subdue, or, destroy \f*
\c 128
\p 
\w A Song| strong="H7892" \w* \w of degrees| strong="H4609" \w*. 
\v 1 \w Blessed| strong="H835" \w* is \w every one that feareth| strong="H3373" \w* the \sc Lord\sc*; [that walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w in his ways| strong="H1870" \w*. 
\v 2 [For thou shalt eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the labour| strong="H3018" \w* \w of thine hands| strong="H3709" \w*: \w happy| strong="H835" \w* shalt thou be, and it shall be \w well| strong="H2896" \w* with thee. 
\v 3 \w Thy wife| strong="H802" \w* shall be [as a fruitful]{strong=“H6509” x-morph=“strongMorph: \sc Th\sc*8802”} \w vine| strong="H1612" \w* \w by the sides| strong="H3411" \w* \w of thine house| strong="H1004" \w*: \w thy children| strong="H1121" \w* \w like olive| strong="H2132" \w* \w plants| strong="H8363" \w* \w round about| strong="H5439" \w* \w thy table| strong="H7979" \w*. 
\v 4 [Behold, that thus shall the man]{strong=“H1397”} [be blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8792”} \w that feareth| strong="H3373" \w* the \sc Lord\sc*. 
\v 5 The \sc Lord\sc* [shall bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w thee out of Zion| strong="H6726" \w*: [and thou shalt see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w the good| strong="H2898" \w* \w of Jerusalem| strong="H3389" \w* \w all the days| strong="H3117" \w* \w of thy life| strong="H2416" \w*. 
\v 6 [Yea, thou shalt see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} [thy children’s]{strong=“H1121”} \w children| strong="H1121" \w*, and \w peace| strong="H7965" \w* \w upon Israel| strong="H3478" \w*. 
\c 129
\p 
\w A Song| strong="H7892" \w* \w of degrees| strong="H4609" \w*. 
\v 1 \w Many a time| strong="H7227" \w* [have they afflicted]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8804”} \w me from my youth| strong="H5271" \w*, \w may Israel| strong="H3478" \w* [now say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}:\f + \fr 129:1 \ft Many…: or, Much \f* 
\v 2 \w Many a time| strong="H7227" \w* [have they afflicted]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8804”} \w me from my youth| strong="H5271" \w*: [yet they have not prevailed]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8804”} against me.\f + \fr 129:2 \ft Many…: or, Much \f* 
\v 3 [The plowers]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8802”} [plowed]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon my back| strong="H1354" \w*: [they made long]{strong=“H748” x-morph=“strongMorph: \sc Th\sc*8689”} [their furrows]{strong=“H4618 H4618” x-morph=“strongMorph: \sc Th\sc*8675”}. 
\v 4 The \sc Lord\sc* is \w righteous| strong="H6662" \w*: [he hath cut asunder]{strong=“H7112” x-morph=“strongMorph: \sc Th\sc*8765”} \w the cords| strong="H5688" \w* \w of the wicked| strong="H7563" \w*. 
\v 5 [Let them all be confounded]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} [and turned]{strong=“H5472” x-morph=“strongMorph: \sc Th\sc*8735”} \w back| strong="H268" \w* [that hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} \w Zion| strong="H6726" \w*. 
\v 6 \w Let them be as the grass| strong="H2682" \w* upon \w the housetops| strong="H1406" \w*, [which withereth]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8804”} \w afore| strong="H6927" \w* [it groweth up]{strong=“H8025” x-morph=“strongMorph: \sc Th\sc*8804”}: 
\v 7 [Wherewith the mower]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8802”} [filleth]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8765”} \w not his hand| strong="H3709" \w*; [nor he that bindeth sheaves]{strong=“H6014” x-morph=“strongMorph: \sc Th\sc*8764”} \w his bosom| strong="H2683" \w*. 
\v 8 [Neither do they which go by]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w The blessing| strong="H1293" \w* of the \sc Lord\sc* be [upon you: we bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} \w you in the name| strong="H8034" \w* of the \sc Lord\sc*.
\c 130
\p 
\w A Song| strong="H7892" \w* \w of degrees| strong="H4609" \w*. 
\v 1 \w Out of the depths| strong="H4615" \w* [have I cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} unto thee, O \sc Lord\sc*. 
\v 2 \w Lord| strong="H136" \w*, [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w my voice| strong="H6963" \w*: \w let thine ears| strong="H241" \w* \w be attentive| strong="H7183" \w* \w to the voice| strong="H6963" \w* \w of my supplications| strong="H8469" \w*. 
\v 3 If thou, \sc Lord\sc*, [shouldest mark]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w iniquities| strong="H5771" \w*, \w O Lord| strong="H136" \w*, [who shall stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”}? 
\v 4 But there is \w forgiveness| strong="H5547" \w* [with thee, that thou mayest be feared]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 5 [I wait]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8765”} for the \sc Lord\sc*, \w my soul| strong="H5315" \w* [doth wait]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8765”}, \w and in his word| strong="H1697" \w* [do I hope]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\v 6 \w My soul| strong="H5315" \w* waiteth \w for the Lord| strong="H136" \w* [more than they that watch]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w for the morning| strong="H1242" \w*: I say, more than [they that watch]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w for the morning| strong="H1242" \w*.\f + \fr 130:6 \ft I say…: or, which watch unto \f* 
\v 7 \w Let Israel| strong="H3478" \w* [hope]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8761”} in the \sc Lord\sc*: for with the \sc Lord\sc* there is \w mercy| strong="H2617" \w*, and with him is [plenteous]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8687”} \w redemption| strong="H6304" \w*. 
\v 8 [And he shall redeem]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8799”} \w Israel| strong="H3478" \w* \w from all his iniquities| strong="H5771" \w*.
\c 131
\p 
\w A Song| strong="H7892" \w* \w of degrees| strong="H4609" \w* \w of David| strong="H1732" \w*. 
\v 1 \sc Lord\sc*, \w my heart| strong="H3820" \w* [is not haughty]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8804”}, \w nor mine eyes| strong="H5869" \w* [lofty]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8804”}: [neither do I exercise]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8765”} \w myself in great matters| strong="H1419" \w*, [or in things too high]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} for me.\f + \fr 131:1 \ft exercise…: Heb. walk \f* \f + \fr 131:1 \ft high: Heb. wonderful \f* 
\v 2 [Surely I have behaved]{strong=“H7737” x-morph=“strongMorph: \sc Th\sc*8765”} [and quieted]{strong=“H1826” x-morph=“strongMorph: \sc Th\sc*8776”} \w myself| strong="H5315" \w*, [as a child that is weaned]{strong=“H1580” x-morph=“strongMorph: \sc Th\sc*8803”} \w of his mother| strong="H517" \w*: \w my soul| strong="H5315" \w* is [even as a weaned child]{strong=“H1580” x-morph=“strongMorph: \sc Th\sc*8803”}.\f + \fr 131:2 \ft myself: Heb. my soul \f* 
\v 3 \w Let Israel| strong="H3478" \w* [hope]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8761”} in the \sc Lord\sc* \w from henceforth and for| strong="H5704" \w* \w ever| strong="H5769" \w*.\f + \fr 131:3 \ft henceforth: Heb. now \f*
\c 132
\p 
\w A Song| strong="H7892" \w* \w of degrees| strong="H4609" \w*. 
\v 1 \sc Lord\sc*, [remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”} \w David| strong="H1732" \w*, and [all his afflictions]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8793”}: 
\v 2 [How he sware]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} unto the \sc Lord\sc*, and [vowed]{strong=“H5087” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the mighty| strong="H46" \w* God \w of Jacob| strong="H3290" \w*; 
\v 3 [Surely I will not come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the tabernacle| strong="H168" \w* \w of my house| strong="H1004" \w*, [nor go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} [into my bed]{strong=“H3326 H6210”}; 
\v 4 [I will not give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w sleep| strong="H8153" \w* \w to mine eyes| strong="H5869" \w*, or \w slumber| strong="H8572" \w* \w to mine eyelids| strong="H6079" \w*, 
\v 5 [Until I find out]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w a place| strong="H4725" \w* for the \sc Lord\sc*, \w an habitation| strong="H4908" \w* \w for the mighty| strong="H46" \w* God \w of Jacob| strong="H3290" \w*.\f + \fr 132:5 \ft an habitation: Heb. habitations \f* 
\v 6 [Lo, we heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w of it at Ephratah| strong="H672" \w*: [we found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w it in the fields| strong="H7704" \w* \w of the wood| strong="H3293" \w*. 
\v 7 [We will go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into his tabernacles| strong="H4908" \w*: [we will worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} [at his footstool]{strong=“H7272 H1916”}. 
\v 8 [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, O \sc Lord\sc*, \w into thy rest| strong="H4496" \w*; [thou, and the ark]{strong=“H727”} \w of thy strength| strong="H5797" \w*. 
\v 9 \w Let thy priests| strong="H3548" \w* [be clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w with righteousness| strong="H6664" \w*; \w and let thy saints| strong="H2623" \w* [shout for joy]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 10 \w For thy servant| strong="H5650" \w* [David’s]{strong=“H1732”} [sake turn not away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w the face| strong="H6440" \w* \w of thine anointed| strong="H4899" \w*. 
\v 11 The \sc Lord\sc* [hath sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} in \w truth| strong="H571" \w* \w unto David| strong="H1732" \w*; [he will not turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [from it; Of the fruit]{strong=“H6529”} \w of thy body| strong="H990" \w* [will I set]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon thy throne| strong="H3678" \w*.\f + \fr 132:11 \ft body: Heb. belly \f* 
\v 12 \w If thy children| strong="H1121" \w* [will keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w my covenant| strong="H1285" \w* \w and my testimony| strong="H5713" \w* [that]{strong=“H2097 H2090” x-morph=“strongMorph: \sc Th\sc*8675”} [I shall teach]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8762”} [them, their children]{strong=“H1121”} [shall also sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon thy throne| strong="H3678" \w* \w for evermore| strong="H5703" \w*. 
\v 13 For the \sc Lord\sc* [hath chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} \w Zion| strong="H6726" \w*; [he hath desired]{strong=“H183” x-morph=“strongMorph: \sc Th\sc*8765”} it \w for his habitation| strong="H4186" \w*. 
\v 14 This is \w my rest| strong="H4496" \w* \w for ever| strong="H5703" \w*: [here will I dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”}; [for I have desired]{strong=“H183” x-morph=“strongMorph: \sc Th\sc*8765”} it. 
\v 15 [I will abundantly]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8763”} [bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w her provision| strong="H6718" \w*: [I will satisfy]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8686”} \w her poor| strong="H34" \w* \w with bread| strong="H3899" \w*.\f + \fr 132:15 \ft abundantly: or, surely \f* 
\v 16 [I will also clothe]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8686”} \w her priests| strong="H3548" \w* \w with salvation| strong="H3468" \w*: \w and her saints| strong="H2623" \w* [shall shout aloud]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8762”} [for joy]{strong=“H7444” x-morph=“strongMorph: \sc Th\sc*8763”}. 
\v 17 \w There will I make| strong="H6779" \w* \w the horn| strong="H7161" \w* \w of David| strong="H1732" \w* [to bud]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8686”}: [I have ordained]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8804”} \w a lamp| strong="H5216" \w* \w for mine anointed| strong="H4899" \w*.\f + \fr 132:17 \ft lamp: or, candle \f* 
\v 18 [His enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [will I clothe]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8686”} \w with shame| strong="H1322" \w*: \w but upon himself shall his crown| strong="H5145" \w* [flourish]{strong=“H6692” x-morph=“strongMorph: \sc Th\sc*8686”}.
\c 133
\p 
\w A Song| strong="H7892" \w* \w of degrees| strong="H4609" \w* \w of David| strong="H1732" \w*. 
\v 1 [Behold, how good]{strong=“H2896”} \w and how pleasant| strong="H5273" \w* it is \w for brethren| strong="H251" \w* [to dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} \w together| strong="H3162" \w* \w in unity| strong="H3162" \w*!\f + \fr 133:1 \ft together…: Heb. even together \f* 
\v 2 It is \w like the precious| strong="H2896" \w* \w ointment| strong="H8081" \w* \w upon the head| strong="H7218" \w*, [that ran down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the beard| strong="H2206" \w*, even [Aaron’s]{strong=“H175”} \w beard| strong="H2206" \w*: [that went down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the skirts| strong="H6310" \w* \w of his garments| strong="H4060" \w*; 
\v 3 \w As the dew| strong="H2919" \w* \w of Hermon| strong="H2768" \w*, and as the dew [that descended]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the mountains| strong="H2042" \w* \w of Zion| strong="H6726" \w*: for there the \sc Lord\sc* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w the blessing| strong="H1293" \w*, even \w life| strong="H2416" \w* \w for evermore| strong="H5769" \w*.
\c 134
\p 
\w A Song| strong="H7892" \w* \w of degrees| strong="H4609" \w*. 
\v 1 [Behold, bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*, all ye \w servants| strong="H5650" \w* of the \sc Lord\sc*, \w which by night| strong="H3915" \w* [stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the house| strong="H1004" \w* of the \sc Lord\sc*. 
\v 2 [Lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w your hands| strong="H3027" \w* in \w the sanctuary| strong="H6944" \w*, [and bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc*.\f + \fr 134:2 \ft the sanctuary: or, holiness \f* 
\v 3 The \sc Lord\sc* [that made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w heaven| strong="H8064" \w* \w and earth| strong="H776" \w* [bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w thee out of Zion| strong="H6726" \w*.
\c 135
\p 
\v 1 [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*. [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} \w ye the name| strong="H8034" \w* of the \sc Lord\sc*; [praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} him, \w O ye servants| strong="H5650" \w* of the \sc Lord\sc*. 
\v 2 [Ye that stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the house| strong="H1004" \w* of the \sc Lord\sc*, \w in the courts| strong="H2691" \w* \w of the house| strong="H1004" \w* \w of our God| strong="H430" \w*, 
\v 3 [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc*; for the \sc Lord\sc* is \w good| strong="H2896" \w*: [sing praises]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8761”} \w unto his name| strong="H8034" \w*; for it is \w pleasant| strong="H5273" \w*. 
\v 4 For the \sc Lord\sc* [hath chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} \w Jacob| strong="H3290" \w* unto himself, and \w Israel| strong="H3478" \w* \w for his peculiar treasure| strong="H5459" \w*. 
\v 5 [For I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that the \sc Lord\sc* is \w great| strong="H1419" \w*, and that \w our Lord| strong="H113" \w* is \w above all gods| strong="H430" \w*. 
\v 6 Whatsoever the \sc Lord\sc* [pleased]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”}, that [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w he in heaven| strong="H8064" \w*, \w and in earth| strong="H776" \w*, \w in the seas| strong="H3220" \w*, \w and all deep places| strong="H8415" \w*. 
\v 7 \w He causeth the vapours| strong="H5387" \w* [to ascend]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8688”} \w from the ends| strong="H7097" \w* \w of the earth| strong="H776" \w*; [he maketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w lightnings| strong="H1300" \w* \w for the rain| strong="H4306" \w*; [he bringeth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8688”} \w the wind| strong="H7307" \w* \w out of his treasuries| strong="H214" \w*. 
\v 8 [Who smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w the firstborn| strong="H1060" \w* \w of Egypt| strong="H4714" \w*, \w both of man| strong="H120" \w* \w and beast| strong="H929" \w*.\f + \fr 135:8 \ft both…: Heb. from man unto beast \f* 
\v 9 Who [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w tokens| strong="H226" \w* \w and wonders| strong="H4159" \w* \w into the midst| strong="H8432" \w* [of thee, O Egypt]{strong=“H4714”}, \w upon Pharaoh| strong="H6547" \w*, \w and upon all his servants| strong="H5650" \w*. 
\v 10 [Who smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w great| strong="H7227" \w* \w nations| strong="H1471" \w*, [and slew]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”} \w mighty| strong="H6099" \w* \w kings| strong="H4428" \w*; 
\v 11 \w Sihon| strong="H5511" \w* \w king| strong="H4428" \w* \w of the Amorites| strong="H567" \w*, \w and Og| strong="H5747" \w* \w king| strong="H4428" \w* \w of Bashan| strong="H1316" \w*, \w and all the kingdoms| strong="H4467" \w* \w of Canaan| strong="H3667" \w*: 
\v 12 [And gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w their land| strong="H776" \w* for \w an heritage| strong="H5159" \w*, \w an heritage| strong="H5159" \w* \w unto Israel| strong="H3478" \w* \w his people| strong="H5971" \w*. 
\v 13 \w Thy name| strong="H8034" \w*, O \sc Lord\sc*, endureth \w for ever| strong="H5769" \w*; and \w thy memorial| strong="H2143" \w*, O \sc Lord\sc*, \w throughout all| strong="H1755" \w* \w generations| strong="H1755" \w*.\f + \fr 135:13 \ft throughout…: Heb. to generation and generation \f* 
\v 14 For the \sc Lord\sc* [will judge]{strong=“H1777” x-morph=“strongMorph: \sc Th\sc*8799”} \w his people| strong="H5971" \w*, [and he will repent]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8691”} \w himself concerning his servants| strong="H5650" \w*. 
\v 15 \w The idols| strong="H6091" \w* \w of the heathen| strong="H1471" \w* are \w silver| strong="H3701" \w* \w and gold| strong="H2091" \w*, \w the work| strong="H4639" \w* [of men’s]{strong=“H120”} \w hands| strong="H3027" \w*. 
\v 16 \w They have mouths| strong="H6310" \w*, [but they speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [not; eyes]{strong=“H5869”} [have they, but they see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} not; 
\v 17 \w They have ears| strong="H241" \w*, [but they hear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8686”} [not; neither is there]{strong=“H3426”} any \w breath| strong="H7307" \w* \w in their mouths| strong="H6310" \w*. 
\v 18 [They that make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} them are like unto them: so is [every one that trusteth]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”} in them. 
\v 19 [Bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc*, \w O house| strong="H1004" \w* \w of Israel| strong="H3478" \w*: [bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc*, \w O house| strong="H1004" \w* \w of Aaron| strong="H175" \w*: 
\v 20 [Bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc*, \w O house| strong="H1004" \w* \w of Levi| strong="H3878" \w*: \w ye that fear| strong="H3373" \w* the \sc Lord\sc*, [bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc*. 
\v 21 [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} be the \sc Lord\sc* \w out of Zion| strong="H6726" \w*, [which dwelleth]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8802”} \w at Jerusalem| strong="H3389" \w*. [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*.
\c 136
\p 
\v 1 [O give thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8685”} unto the \sc Lord\sc*; for he is \w good| strong="H2896" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*. 
\v 2 [O give thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto the God| strong="H430" \w* \w of gods| strong="H430" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*. 
\v 3 [O give thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8685”} \w to the Lord| strong="H113" \w* \w of lords| strong="H113" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*. 
\v 4 [To him who alone doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w great| strong="H1419" \w* [wonders]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”}: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*. 
\v 5 \w To him that by wisdom| strong="H8394" \w* [made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w the heavens| strong="H8064" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*. 
\v 6 [To him that stretched out]{strong=“H7554” x-morph=“strongMorph: \sc Th\sc*8802”} \w the earth| strong="H776" \w* \w above the waters| strong="H4325" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*. 
\v 7 [To him that made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w great| strong="H1419" \w* \w lights| strong="H216" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*: 
\v 8 \w The sun| strong="H8121" \w* \w to rule| strong="H4475" \w* \w by day| strong="H3117" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*:\f + \fr 136:8 \ft to rule…: Heb. for the rulings by day \f* 
\v 9 \w The moon| strong="H3394" \w* \w and stars| strong="H3556" \w* \w to rule| strong="H4475" \w* \w by night| strong="H3915" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*. 
\v 10 [To him that smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8688”} \w Egypt| strong="H4714" \w* \w in their firstborn| strong="H1060" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*: 
\v 11 [And brought out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w Israel| strong="H3478" \w* \w from among| strong="H8432" \w* [them: for his mercy]{strong=“H2617”} endureth \w for ever| strong="H5769" \w*: 
\v 12 \w With a strong| strong="H2389" \w* \w hand| strong="H3027" \w*, [and with a stretched out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8803”} \w arm| strong="H2220" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*. 
\v 13 [To him which divided]{strong=“H1504” x-morph=“strongMorph: \sc Th\sc*8802”} \w the Red| strong="H5488" \w* \w sea| strong="H3220" \w* \w into parts| strong="H1506" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*: 
\v 14 \w And made Israel| strong="H3478" \w* [to pass through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8689”} \w the midst| strong="H8432" \w* [of it: for his mercy]{strong=“H2617”} endureth \w for ever| strong="H5769" \w*: 
\v 15 [But overthrew]{strong=“H5287” x-morph=“strongMorph: \sc Th\sc*8765”} \w Pharaoh| strong="H6547" \w* \w and his host| strong="H2428" \w* \w in the Red| strong="H5488" \w* \w sea| strong="H3220" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*.\f + \fr 136:15 \ft overthrew: Heb. shaked off \f* 
\v 16 [To him which led]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8688”} \w his people| strong="H5971" \w* \w through the wilderness| strong="H4057" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*. 
\v 17 [To him which smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8688”} \w great| strong="H1419" \w* \w kings| strong="H4428" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*: 
\v 18 [And slew]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} \w famous| strong="H117" \w* \w kings| strong="H4428" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*: 
\v 19 \w Sihon| strong="H5511" \w* \w king| strong="H4428" \w* \w of the Amorites| strong="H567" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*: 
\v 20 \w And Og| strong="H5747" \w* \w the king| strong="H4428" \w* \w of Bashan| strong="H1316" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*: 
\v 21 [And gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w their land| strong="H776" \w* \w for an heritage| strong="H5159" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*: 
\v 22 Even \w an heritage| strong="H5159" \w* \w unto Israel| strong="H3478" \w* \w his servant| strong="H5650" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*. 
\v 23 [Who remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w us in our low estate| strong="H8216" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*: 
\v 24 [And hath redeemed]{strong=“H6561” x-morph=“strongMorph: \sc Th\sc*8799”} \w us from our enemies| strong="H6862" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*. 
\v 25 [Who giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w food| strong="H3899" \w* \w to all flesh| strong="H1320" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*. 
\v 26 [O give thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto the God| strong="H410" \w* \w of heaven| strong="H8064" \w*: \w for his mercy| strong="H2617" \w* endureth \w for ever| strong="H5769" \w*.
\c 137
\p 
\v 1 \w By the rivers| strong="H5104" \w* \w of Babylon| strong="H894" \w*, [there we sat down]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”}, [yea, we wept]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8804”}, [when we remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8800”} \w Zion| strong="H6726" \w*. 
\v 2 [We hanged]{strong=“H8518” x-morph=“strongMorph: \sc Th\sc*8804”} \w our harps| strong="H3658" \w* \w upon the willows| strong="H6155" \w* \w in the midst| strong="H8432" \w* thereof. 
\v 3 [For there they that carried us away captive]{strong=“H7617” x-morph=“strongMorph: \sc Th\sc*8802”} [required]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8804”} [of us a song]{strong=“H7892 H1697”}; \w and they that wasted| strong="H8437" \w* us required of us \w mirth| strong="H8057" \w*, saying, [Sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8798”} us one \w of the songs| strong="H7892" \w* \w of Zion| strong="H6726" \w*.\f + \fr 137:3 \ft a song: Heb. the words of a song \f* \f + \fr 137:3 \ft wasted…: Heb. laid us on heaps \f* 
\v 4 [How shall we sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc*’S \w song| strong="H7892" \w* \w in a strange| strong="H5236" \w* \w land| strong="H127" \w*?\f + \fr 137:4 \ft strange…: Heb. land of a stranger? \f* 
\v 5 [If I forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} [thee, O Jerusalem]{strong=“H3389”}, \w let my right hand| strong="H3225" \w* [forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} her cunning. 
\v 6 [If I do not remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} [thee, let my tongue]{strong=“H3956”} [cleave]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the roof of my mouth| strong="H2441" \w*; [if I prefer]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w not Jerusalem| strong="H3389" \w* \w above my chief| strong="H7218" \w* \w joy| strong="H8057" \w*.\f + \fr 137:6 \ft my chief…: Heb. the head of my joy \f* 
\v 7 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”}, O \sc Lord\sc*, \w the children| strong="H1121" \w* \w of Edom| strong="H123" \w* \w in the day| strong="H3117" \w* \w of Jerusalem| strong="H3389" \w*; [who said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, [Rase]{strong=“H6168” x-morph=“strongMorph: \sc Th\sc*8761”} it, [rase]{strong=“H6168” x-morph=“strongMorph: \sc Th\sc*8761”} it, even \w to the foundation| strong="H3247" \w* thereof.\f + \fr 137:7 \ft Rase it: Heb. Make bare \f* 
\v 8 \w O daughter| strong="H1323" \w* \w of Babylon| strong="H894" \w*, [who art to be destroyed]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8803”}; \w happy| strong="H835" \w* shall he be, [that rewardeth]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} [thee as thou hast served]{strong=“H1576 H1580” x-morph=“strongMorph: \sc Th\sc*8804”} us.\f + \fr 137:8 \ft destroyed: Heb. wasted \f* \f + \fr 137:8 \ft rewardeth…: Heb. recompenseth unto thee thy deed which thou didst to us \f* 
\v 9 \w Happy| strong="H835" \w* shall he be, [that taketh]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8799”} [and dasheth]{strong=“H5310” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy little ones| strong="H5768" \w* \w against the stones| strong="H5553" \w*.\f + \fr 137:9 \ft the stones: Heb. the rock \f*
\c 138
\p 
A Psalm \w of David| strong="H1732" \w*. 
\v 1 [I will praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee with my whole heart| strong="H3820" \w*: \w before the gods| strong="H430" \w* [will I sing praise]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8762”} unto thee. 
\v 2 [I will worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} \w toward thy holy| strong="H6944" \w* \w temple| strong="H1964" \w*, [and praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy name| strong="H8034" \w* \w for thy lovingkindness| strong="H2617" \w* \w and for thy truth| strong="H571" \w*: [for thou hast magnified]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy word| strong="H565" \w* \w above all thy name| strong="H8034" \w*. 
\v 3 \w In the day| strong="H3117" \w* [when I cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [thou answeredst]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} me, and [strengthenedst]{strong=“H7292” x-morph=“strongMorph: \sc Th\sc*8686”} me with \w strength| strong="H5797" \w* \w in my soul| strong="H5315" \w*. 
\v 4 \w All the kings| strong="H4428" \w* \w of the earth| strong="H776" \w* [shall praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} thee, O \sc Lord\sc*, [when they hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the words| strong="H561" \w* \w of thy mouth| strong="H6310" \w*. 
\v 5 [Yea, they shall sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the ways| strong="H1870" \w* of the \sc Lord\sc*: \w for great| strong="H1419" \w* is \w the glory| strong="H3519" \w* of the \sc Lord\sc*. 
\v 6 Though the \sc Lord\sc* be [high]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8802”}, [yet hath he respect]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the lowly| strong="H8217" \w*: \w but the proud| strong="H1364" \w* [he knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w afar off| strong="H4801" \w*. 
\v 7 [Though I walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the midst| strong="H7130" \w* \w of trouble| strong="H6869" \w*, [thou wilt revive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8762”} [me: thou shalt stretch forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w thine hand| strong="H3027" \w* \w against the wrath| strong="H639" \w* [of mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and thy right hand| strong="H3225" \w* [shall save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} me. 
\v 8 The \sc Lord\sc* [will perfect]{strong=“H1584” x-morph=“strongMorph: \sc Th\sc*8799”} that which [concerneth me: thy mercy]{strong=“H2617”}, O \sc Lord\sc*, endureth \w for ever| strong="H5769" \w*: [forsake ]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8686”} \w not the works| strong="H4639" \w* \w of thine own hands| strong="H3027" \w*. 
\c 139
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 O \sc Lord\sc*, [thou hast searched]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} me. 
\v 2 [Thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [my downsitting]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} [and mine uprising]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8800”}, [thou understandest]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8804”} \w my thought| strong="H7454" \w* \w afar off| strong="H7350" \w*. 
\v 3 [Thou compassest]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8765”} \w my path| strong="H734" \w* \w and my lying down| strong="H7252" \w*, [and art acquainted]{strong=“H5532” x-morph=“strongMorph: \sc Th\sc*8689”} with \w all my ways| strong="H1870" \w*.\f + \fr 139:3 \ft compassest: or, winnowest \f* 
\v 4 For there is \w not a word| strong="H4405" \w* \w in my tongue| strong="H3956" \w*, but, lo, O \sc Lord\sc*, [thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} it altogether. 
\v 5 [Thou hast beset]{strong=“H6696” x-morph=“strongMorph: \sc Th\sc*8804”} \w me behind| strong="H268" \w* \w and before| strong="H6924" \w*, [and laid]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w thine hand| strong="H3709" \w* upon me. 
\v 6 Such \w knowledge| strong="H1847" \w* is [too wonderful]{strong=“H6383 H6383” x-morph=“strongMorph: \sc Th\sc*8675”} [for me; it is high]{strong=“H7682” x-morph=“strongMorph: \sc Th\sc*8738”}, [I cannot]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} attain unto it. 
\v 7 [Whither shall I go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w from thy spirit| strong="H7307" \w*? [or whither shall I flee]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8799”} \w from thy presence| strong="H6440" \w*? 
\v 8 [If I ascend up]{strong=“H5266” x-morph=“strongMorph: \sc Th\sc*8799”} \w into heaven| strong="H8064" \w*, thou art [there: if I make my bed]{strong=“H3331” x-morph=“strongMorph: \sc Th\sc*8686”} \w in hell| strong="H7585" \w*, behold, thou art there. 
\v 9 If [I take]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w the wings| strong="H3671" \w* \w of the morning| strong="H7837" \w*, and [dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the uttermost parts| strong="H319" \w* \w of the sea| strong="H3220" \w*; 
\v 10 \w Even there shall thy hand| strong="H3027" \w* [lead]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8686”} [me, and thy right hand]{strong=“H3225”} [shall hold]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8799”} me. 
\v 11 [If I say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Surely the darkness| strong="H2822" \w* [shall cover]{strong=“H7779” x-morph=“strongMorph: \sc Th\sc*8799”} [me; even the night]{strong=“H3915”} \w shall be light| strong="H216" \w* \w about me| strong="H1157" \w*. 
\v 12 [Yea, the darkness]{strong=“H2822”} [hideth]{strong=“H2821” x-morph=“strongMorph: \sc Th\sc*8686”} [not from thee; but the night]{strong=“H3915”} [shineth]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8686”} \w as the day| strong="H3117" \w*: \w the darkness| strong="H2825" \w* \w and the light| strong="H219" \w* are both alike to thee.\f + \fr 139:12 \ft hideth…: Heb. darkeneth not \f* \f + \fr 139:12 \ft the darkness and…: Heb. as is the darkness, so is the light \f* 
\v 13 [For thou hast possessed]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8804”} \w my reins| strong="H3629" \w*: [thou hast covered]{strong=“H5526” x-morph=“strongMorph: \sc Th\sc*8799”} [me in my mother’s]{strong=“H517”} \w womb| strong="H990" \w*. 
\v 14 [I will praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} [thee; for I am fearfully]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”} and [wonderfully made]{strong=“H6395” x-morph=“strongMorph: \sc Th\sc*8738”}: [marvellous]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} are \w thy works| strong="H4639" \w*; and that \w my soul| strong="H5315" \w* [knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w right well| strong="H3966" \w*.\f + \fr 139:14 \ft right…: Heb. greatly \f* 
\v 15 \w My substance| strong="H6108" \w* [was not hid]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8738”} [from thee, when I was made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8795”} \w in secret| strong="H5643" \w*, and [curiously wrought]{strong=“H7551” x-morph=“strongMorph: \sc Th\sc*8795”} \w in the lowest parts| strong="H8482" \w* \w of the earth| strong="H776" \w*.\f + \fr 139:15 \ft substance: or, strength, or, body \f* 
\v 16 \w Thine eyes| strong="H5869" \w* [did see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} [my substance, yet being unperfect]{strong=“H1564”}; \w and in thy book| strong="H5612" \w* all my members [were written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8735”}, which \w in continuance| strong="H3117" \w* [were fashioned]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8795”}, when as yet there was \w none| strong="H259" \w* of them.\f + \fr 139:16 \ft all…: Heb. all of them \f* \f + \fr 139:16 \ft which…: or, what days they should be fashioned \f* 
\v 17 [How precious]{strong=“H3365” x-morph=“strongMorph: \sc Th\sc*8804”} \w also are thy thoughts| strong="H7454" \w* [unto me, O God]{strong=“H410”}! [how great]{strong=“H6105” x-morph=“strongMorph: \sc Th\sc*8804”} \w is the sum| strong="H7218" \w* of them! 
\v 18 If [I should count]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8799”} [them, they are more in number]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8799”} \w than the sand| strong="H2344" \w*: [when I awake]{strong=“H6974” x-morph=“strongMorph: \sc Th\sc*8689”}, \w I am still| strong="H5750" \w* with thee. 
\v 19 [Surely thou wilt slay]{strong=“H6991” x-morph=“strongMorph: \sc Th\sc*8799”} \w the wicked| strong="H7563" \w*, \w O God| strong="H433" \w*: [depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8798”} [from me therefore, ye bloody]{strong=“H1818”} \w men| strong="H582" \w*. 
\v 20 [For they speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w against thee wickedly| strong="H4209" \w*, and \w thine enemies| strong="H6145" \w* [take]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} thy name \w in vain| strong="H7723" \w*. 
\v 21 [Do not I hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8799”} them, O \sc Lord\sc*, [that hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8764”} [thee? and am not I grieved]{strong=“H6962” x-morph=“strongMorph: \sc Th\sc*8709”} \w with those that rise up| strong="H8618" \w* against thee? 
\v 22 [I hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”} \w them with perfect| strong="H8503" \w* \w hatred| strong="H8135" \w*: [I count them mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 23 [Search]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8798”} [me, O God]{strong=“H410”}, [and know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”} \w my heart| strong="H3824" \w*: [try]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8798”} [me, and know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”} \w my thoughts| strong="H8312" \w*: 
\v 24 [And see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} if there be any \w wicked| strong="H6090" \w* \w way| strong="H1870" \w* [in me, and lead]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8798”} \w me in the way| strong="H1870" \w* \w everlasting| strong="H5769" \w*.\f + \fr 139:24 \ft wicked…: Heb. way of pain, or, grief \f*
\c 140
\p 
[To the chief Musician]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”}, \w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 [Deliver]{strong=“H2502” x-morph=“strongMorph: \sc Th\sc*8761”} me, O \sc Lord\sc*, \w from the evil| strong="H7451" \w* \w man| strong="H120" \w*: [preserve]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8799”} \w me from the violent| strong="H2555" \w* \w man| strong="H376" \w*;\f + \fr 140:1 \ft violent…: Heb. man of violences \f* 
\v 2 [Which imagine]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8804”} \w mischiefs| strong="H7451" \w* in their \w heart| strong="H3820" \w*; \w continually| strong="H3117" \w* [are they gathered together]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”} for \w war| strong="H4421" \w*. 
\v 3 [They have sharpened]{strong=“H8150” x-morph=“strongMorph: \sc Th\sc*8804”} \w their tongues| strong="H3956" \w* \w like a serpent| strong="H5175" \w*; [adders’]{strong=“H5919”} \w poison| strong="H2534" \w* is \w under their lips| strong="H8193" \w*. \w Selah| strong="H5542" \w*. 
\v 4 [Keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8798”} me, O \sc Lord\sc*, \w from the hands| strong="H3027" \w* \w of the wicked| strong="H7563" \w*; [preserve ]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8799”} \w me from the violent| strong="H2555" \w* \w man| strong="H376" \w*; [who have purposed]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8804”} [to overthrow]{strong=“H1760” x-morph=“strongMorph: \sc Th\sc*8800”} \w my goings| strong="H6471" \w*. 
\v 5 \w The proud| strong="H1343" \w* [have hid]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8804”} \w a snare| strong="H6341" \w* [for me, and cords]{strong=“H2256”}; [they have spread]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8804”} \w a net| strong="H7568" \w* [by the wayside]{strong=“H4570 H3027”}; [they have set]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8804”} \w gins| strong="H4170" \w* [for me. Selah]{strong=“H5542”}. 
\v 6 [I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} unto the \sc Lord\sc*, Thou art \w my God| strong="H410" \w*: [hear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”} \w the voice| strong="H6963" \w* \w of my supplications| strong="H8469" \w*, O \sc Lord\sc*. 
\v 7 O \sc God\sc* \w the Lord| strong="H136" \w*, \w the strength| strong="H5797" \w* \w of my salvation| strong="H3444" \w*, [thou hast covered]{strong=“H5526” x-morph=“strongMorph: \sc Th\sc*8804”} \w my head| strong="H7218" \w* \w in the day| strong="H3117" \w* \w of battle| strong="H5402" \w*. 
\v 8 [Grant]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} not, O \sc Lord\sc*, \w the desires| strong="H3970" \w* \w of the wicked| strong="H7563" \w*: [further]{strong=“H6329” x-morph=“strongMorph: \sc Th\sc*8686”} \w not his wicked device| strong="H2162" \w*; lest [they exalt]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8799”} [themselves. Selah]{strong=“H5542”}.\f + \fr 140:8 \ft lest…: or, let them not be exalted \f* 
\v 9 As for \w the head| strong="H7218" \w* \w of those that compass me about| strong="H4524" \w*, \w let the mischief| strong="H5999" \w* \w of their own lips| strong="H8193" \w* [cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} them. 
\v 10 \w Let burning coals| strong="H1513" \w* [fall]{strong=“H4131 H4131” x-morph=“strongMorph: \sc Th\sc*8686 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8735”} [upon them: let them be cast]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8686”} \w into the fire| strong="H784" \w*; \w into deep pits| strong="H4113" \w*, [that they rise not up again]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 11 [Let not an evil speaker]{strong=“H3956 H376”} [be established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the earth| strong="H776" \w*: \w evil| strong="H7451" \w* [shall hunt]{strong=“H6679” x-morph=“strongMorph: \sc Th\sc*8799”} \w the violent| strong="H2555" \w* \w man| strong="H376" \w* \w to overthrow| strong="H4073" \w* him.\f + \fr 140:11 \ft an…: or, an evil speaker (Heb. a man of tongue), a wicked man of violence, be established in the earth: let him be hunted to his overthrow \f* 
\v 12 [I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that the \sc Lord\sc* [will maintain]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w the cause| strong="H1779" \w* \w of the afflicted| strong="H6041" \w*, and \w the right| strong="H4941" \w* \w of the poor| strong="H34" \w*. 
\v 13 \w Surely the righteous| strong="H6662" \w* [shall give thanks]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto thy name| strong="H8034" \w*: \w the upright| strong="H3477" \w* [shall dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy presence| strong="H6440" \w*.
\c 141
\p 
\w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 \sc Lord\sc*, [I cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [unto thee: make haste]{strong=“H2363” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me; give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto my voice| strong="H6963" \w*, [when I cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8800”} unto thee. 
\v 2 \w Let my prayer| strong="H8605" \w* [be set forth]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8735”} \w before| strong="H6440" \w* thee as \w incense| strong="H7004" \w*; and \w the lifting up| strong="H4864" \w* \w of my hands| strong="H3709" \w* as \w the evening| strong="H6153" \w* \w sacrifice| strong="H4503" \w*.\f + \fr 141:2 \ft set…: Heb. directed \f* 
\v 3 [Set]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8798”} \w a watch| strong="H8108" \w*, O \sc Lord\sc*, \w before my mouth| strong="H6310" \w*; [keep]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8798”} \w the door| strong="H1817" \w* \w of my lips| strong="H8193" \w*. 
\v 4 [Incline]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w not my heart| strong="H3820" \w* to any \w evil| strong="H7451" \w* \w thing| strong="H1697" \w*, [to practise]{strong=“H5953” x-morph=“strongMorph: \sc Th\sc*8705”} \w wicked| strong="H7562" \w* \w works| strong="H5949" \w* \w with men| strong="H376" \w* [that work]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w iniquity| strong="H205" \w*: [and let me not eat]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8799”} \w of their dainties| strong="H4516" \w*. 
\v 5 \w Let the righteous| strong="H6662" \w* [smite]{strong=“H1986” x-morph=“strongMorph: \sc Th\sc*8799”} me; it shall be \w a kindness| strong="H2617" \w*: [and let him reprove]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”} me; it shall be \w an excellent| strong="H7218" \w* \w oil| strong="H8081" \w*, which [shall not break]{strong=“H5106” x-morph=“strongMorph: \sc Th\sc*8686”} \w my head| strong="H7218" \w*: \w for yet my prayer| strong="H8605" \w* also shall be \w in their calamities| strong="H7451" \w*.\f + \fr 141:5 \ft me; it shall be a…: or, me kindly, and reprove me; let not their precious oil break, etc \f* 
\v 6 [When their judges]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} [are overthrown]{strong=“H8058” x-morph=“strongMorph: \sc Th\sc*8738”} \w in stony| strong="H5553" \w* \w places| strong="H3027" \w*, [they shall hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w my words| strong="H561" \w*; [for they are sweet]{strong=“H5276” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 7 \w Our bones| strong="H6106" \w* [are scattered]{strong=“H6340” x-morph=“strongMorph: \sc Th\sc*8738”} [at the grave’s]{strong=“H7585”} \w mouth| strong="H6310" \w*, [as when one cutteth]{strong=“H6398” x-morph=“strongMorph: \sc Th\sc*8802”} [and cleaveth]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8802”} wood \w upon the earth| strong="H776" \w*. 
\v 8 \w But mine eyes| strong="H5869" \w* are unto thee, O \sc God\sc* \w the Lord| strong="H136" \w*: [in thee is my trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8804”}; \w leave| strong="H6168" \w* \w not my soul| strong="H5315" \w* [destitute]{strong=“H6168” x-morph=“strongMorph: \sc Th\sc*8762”}.\f + \fr 141:8 \ft leave…: Heb. make not my soul bare \f* 
\v 9 [Keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8798”} [me from the snares]{strong=“H6341 H3027”} which [they have laid]{strong=“H3369” x-morph=“strongMorph: \sc Th\sc*8804”} [for me, and the gins]{strong=“H4170”} [of the workers]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w of iniquity| strong="H205" \w*. 
\v 10 \w Let the wicked| strong="H7563" \w* [fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w into their own nets| strong="H4364" \w*, \w whilst that I withal| strong="H3162" \w* [escape]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 141:10 \ft escape: Heb. pass over \f*
\c 142
\p 
[Maschil]{strong=“H4905” x-morph=“strongMorph: \sc Th\sc*8688”} \w of David| strong="H1732" \w*; \w A Prayer| strong="H8605" \w* \w when he was in the cave| strong="H4631" \w*. 
\v 1 [I cried]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc* \w with my voice| strong="H6963" \w*; \w with my voice| strong="H6963" \w* unto the \sc Lord\sc* [did I make my supplication]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8691”}.\f + \fr 142:1 \ft Maschil…: or, A Psalm of David, giving instruction \f* 
\v 2 [I poured out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8799”} \w my complaint| strong="H7879" \w* \w before| strong="H6440" \w* [him; I shewed]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w before| strong="H6440" \w* \w him my trouble| strong="H6869" \w*. 
\v 3 \w When my spirit| strong="H7307" \w* [was overwhelmed]{strong=“H5848” x-morph=“strongMorph: \sc Th\sc*8692”} [within me, then thou knewest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w my path| strong="H5410" \w*. \w In the way| strong="H734" \w* \w wherein| strong="H2098" \w* [I walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8762”} [have they privily laid]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8804”} \w a snare| strong="H6341" \w* for me. 
\v 4 [I looked]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8685”} on my \w right hand| strong="H3225" \w*, [and beheld]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}, but there was [no man that would know]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8688”} [me: refuge]{strong=“H4498”} [failed]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”} [me; no man cared]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8802”} \w for my soul| strong="H5315" \w*.\f + \fr 142:4 \ft I looked…: or, Look on the right hand, and see \f* \f + \fr 142:4 \ft failed…: Heb. perished from me \f* \f + \fr 142:4 \ft cared…: Heb. sought after \f* 
\v 5 [I cried]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8804”} unto thee, O \sc Lord\sc*: [I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, Thou art \w my refuge| strong="H4268" \w* and \w my portion| strong="H2506" \w* \w in the land| strong="H776" \w* \w of the living| strong="H2416" \w*. 
\v 6 [Attend]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto my cry| strong="H7440" \w*; \w for I am brought| strong="H1809" \w* \w very| strong="H3966" \w* [low]{strong=“H1809” x-morph=“strongMorph: \sc Th\sc*8804”}: [deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} [me from my persecutors]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8802”}; [for they are stronger]{strong=“H553” x-morph=“strongMorph: \sc Th\sc*8804”} than I. 
\v 7 [Bring]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8685”} \w my soul| strong="H5315" \w* \w out of prison| strong="H4525" \w*, [that I may praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8687”} \w thy name| strong="H8034" \w*: \w the righteous| strong="H6662" \w* [shall compass me about]{strong=“H3803” x-morph=“strongMorph: \sc Th\sc*8686”}; [for thou shalt deal bountifully]{strong=“H1580” x-morph=“strongMorph: \sc Th\sc*8799”} with me.
\c 143
\p 
\w A Psalm| strong="H4210" \w* \w of David| strong="H1732" \w*. 
\v 1 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w my prayer| strong="H8605" \w*, O \sc Lord\sc*, [give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”} \w to my supplications| strong="H8469" \w*: \w in thy faithfulness| strong="H530" \w* [answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8798”} me, and \w in thy righteousness| strong="H6666" \w*. 
\v 2 [And enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w not into judgment| strong="H4941" \w* \w with thy servant| strong="H5650" \w*: \w for in thy sight| strong="H6440" \w* \w shall no man living| strong="H2416" \w* [be justified]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 3 [For the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [hath persecuted]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8804”} \w my soul| strong="H5315" \w*; \w he hath smitten| strong="H1792" \w* \w my life| strong="H2416" \w* [down]{strong=“H1792” x-morph=“strongMorph: \sc Th\sc*8765”} \w to the ground| strong="H776" \w*; [he hath made me to dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8689”} \w in darkness| strong="H4285" \w*, \w as those that have been long| strong="H5769" \w* [dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”}. 
\v 4 \w Therefore is my spirit| strong="H7307" \w* [overwhelmed ]{strong=“H5848” x-morph=“strongMorph: \sc Th\sc*8691”} [within me; my heart]{strong=“H3820”} \w within| strong="H8432" \w* [me is desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8709”}. 
\v 5 [I remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w the days| strong="H3117" \w* \w of old| strong="H6924" \w*; [I meditate]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8804”} \w on all thy works| strong="H6467" \w*; [I muse]{strong=“H7878” x-morph=“strongMorph: \sc Th\sc*8787”} \w on the work| strong="H4639" \w* \w of thy hands| strong="H3027" \w*. 
\v 6 [I stretch forth]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8765”} \w my hands| strong="H3027" \w* [unto thee: my soul]{strong=“H5315”} thirsteth [after thee, as a thirsty]{strong=“H5889”} \w land| strong="H776" \w*. \w Selah| strong="H5542" \w*. 
\v 7 [Hear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8798”} \w me speedily| strong="H4118" \w*, O \sc Lord\sc*: \w my spirit| strong="H7307" \w* [faileth]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”}: [hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8686”} \w not thy face| strong="H6440" \w* [from me, lest I be like]{strong=“H4911” x-morph=“strongMorph: \sc Th\sc*8738”} [unto them that go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w into the pit| strong="H953" \w*.\f + \fr 143:7 \ft lest…: or, for I am become like, etc \f* 
\v 8 [Cause me to hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8685”} \w thy lovingkindness| strong="H2617" \w* \w in the morning| strong="H1242" \w*; [for in thee do I trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”}: [cause me to know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8685”} \w the way| strong="H1870" \w* \w wherein| strong="H2098" \w* [I should walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}; [for I lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w my soul| strong="H5315" \w* unto thee. 
\v 9 [Deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} me, O \sc Lord\sc*, [from mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}: [I flee unto thee to hide]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”} me.\f + \fr 143:9 \ft flee…: Heb. hide me with thee \f* 
\v 10 [Teach]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8761”} [me to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy will| strong="H7522" \w*; for thou art \w my God| strong="H430" \w*: \w thy spirit| strong="H7307" \w* is \w good| strong="H2896" \w*; [lead]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8686”} \w me into the land| strong="H776" \w* \w of uprightness| strong="H4334" \w*. 
\v 11 [Quicken]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8762”} me, O \sc Lord\sc*, [for thy name’s]{strong=“H8034”} [sake: for thy righteousness’]{strong=“H6666”} [sake bring]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w my soul| strong="H5315" \w* \w out of trouble| strong="H6869" \w*. 
\v 12 \w And of thy mercy| strong="H2617" \w* [cut off]{strong=“H6789” x-morph=“strongMorph: \sc Th\sc*8686”} [mine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, [and destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8689”} [all them that afflict]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8802”} \w my soul| strong="H5315" \w*: for I am \w thy servant| strong="H5650" \w*.
\c 144
\p 
A Psalm \w of David| strong="H1732" \w*. 
\v 1 [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} be the \sc Lord\sc* \w my strength| strong="H6697" \w*, [which teacheth]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8764”} \w my hands| strong="H3027" \w* \w to war| strong="H7128" \w*, and \w my fingers| strong="H676" \w* \w to fight| strong="H4421" \w*:\f + \fr 144:1 \ft strength: Heb. rock \f* \f + \fr 144:1 \ft to war…: Heb. to the war, etc \f* 
\v 2 \w My goodness| strong="H2617" \w*, \w and my fortress| strong="H4686" \w*; \w my high tower| strong="H4869" \w*, [and my deliverer]{strong=“H6403” x-morph=“strongMorph: \sc Th\sc*8764”}; \w my shield| strong="H4043" \w*, and he [in whom I trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8804”}; [who subdueth]{strong=“H7286” x-morph=“strongMorph: \sc Th\sc*8802”} \w my people| strong="H5971" \w* under me.\f + \fr 144:2 \ft My goodness: or, My mercy \f* 
\v 3 \sc Lord\sc*, what is \w man| strong="H120" \w*, [that thou takest knowledge]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} of him! or \w the son| strong="H1121" \w* \w of man| strong="H582" \w*, [that thou makest account]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8762”} of him! 
\v 4 \w Man| strong="H120" \w* [is like]{strong=“H1819” x-morph=“strongMorph: \sc Th\sc*8804”} \w to vanity| strong="H1892" \w*: \w his days| strong="H3117" \w* are \w as a shadow| strong="H6738" \w* [that passeth away]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 5 [Bow]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8685”} \w thy heavens| strong="H8064" \w*, O \sc Lord\sc*, [and come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”}: [touch]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8798”} \w the mountains| strong="H2022" \w*, [and they shall smoke]{strong=“H6225” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 6 [Cast forth]{strong=“H1299” x-morph=“strongMorph: \sc Th\sc*8798”} \w lightning| strong="H1300" \w*, [and scatter]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8686”} [them: shoot out]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8798”} \w thine arrows| strong="H2671" \w*, [and destroy]{strong=“H2000” x-morph=“strongMorph: \sc Th\sc*8799”} them. 
\v 7 [Send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8798”} \w thine hand| strong="H3027" \w* \w from above| strong="H4791" \w*; [rid]{strong=“H6475” x-morph=“strongMorph: \sc Th\sc*8798”} [me, and deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} \w me out of great| strong="H7227" \w* \w waters| strong="H4325" \w*, \w from the hand| strong="H3027" \w* \w of strange| strong="H5236" \w* \w children| strong="H1121" \w*;\f + \fr 144:7 \ft hand from: Heb. hands from \f* 
\v 8 \w Whose mouth| strong="H6310" \w* [speaketh]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w vanity| strong="H7723" \w*, \w and their right hand| strong="H3225" \w* is \w a right hand| strong="H3225" \w* \w of falsehood| strong="H8267" \w*. 
\v 9 [I will sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8799”} \w a new| strong="H2319" \w* \w song| strong="H7892" \w* [unto thee, O God]{strong=“H430”}: \w upon a psaltery| strong="H5035" \w* and \w an instrument of ten strings| strong="H6218" \w* [will I sing praises]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8762”} unto thee. 
\v 10 It is he [that giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w salvation| strong="H8668" \w* \w unto kings| strong="H4428" \w*: [who delivereth]{strong=“H6475” x-morph=“strongMorph: \sc Th\sc*8802”} \w David| strong="H1732" \w* \w his servant| strong="H5650" \w* \w from the hurtful| strong="H7451" \w* \w sword| strong="H2719" \w*.\f + \fr 144:10 \ft salvation: or, victory \f* 
\v 11 [Rid]{strong=“H6475” x-morph=“strongMorph: \sc Th\sc*8798”} [me, and deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} \w me from the hand| strong="H3027" \w* \w of strange| strong="H5236" \w* \w children| strong="H1121" \w*, \w whose mouth| strong="H6310" \w* [speaketh]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w vanity| strong="H7723" \w*, \w and their right hand| strong="H3225" \w* is \w a right hand| strong="H3225" \w* \w of falsehood| strong="H8267" \w*: 
\v 12 \w That our sons| strong="H1121" \w* may be \w as plants| strong="H5195" \w* [grown up]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8794”} \w in their youth| strong="H5271" \w*; that \w our daughters| strong="H1323" \w* may be \w as corner stones| strong="H2106" \w*, [polished]{strong=“H2404” x-morph=“strongMorph: \sc Th\sc*8794”} after \w the similitude| strong="H8403" \w* \w of a palace| strong="H1964" \w*:\f + \fr 144:12 \ft polished: Heb. cut \f* 
\v 13 That \w our garners| strong="H4200" \w* may be \w full| strong="H4392" \w*, [affording]{strong=“H6329” x-morph=“strongMorph: \sc Th\sc*8688”} [all manner of store]{strong=“H2177 H2177”}: that \w our sheep| strong="H6629" \w* [may bring forth thousands]{strong=“H503” x-morph=“strongMorph: \sc Th\sc*8688”} [and ten thousands]{strong=“H7231” x-morph=“strongMorph: \sc Th\sc*8794”} \w in our streets| strong="H2351" \w*:\f + \fr 144:13 \ft all…: Heb. from kind to kind \f* 
\v 14 That \w our oxen| strong="H441" \w* may be [strong to labour]{strong=“H5445” x-morph=“strongMorph: \sc Th\sc*8794”}; that there be \w no breaking in| strong="H6556" \w*, [nor going out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”}; that there be \w no complaining| strong="H6682" \w* \w in our streets| strong="H7339" \w*.\f + \fr 144:14 \ft strong…: Heb. able to bear burdens, or, loaden with flesh \f* 
\v 15 \w Happy| strong="H835" \w* is that \w people| strong="H5971" \w*, \w that is in such a case| strong="H3602" \w*: yea, \w happy| strong="H835" \w* is that \w people| strong="H5971" \w*, \w whose God| strong="H430" \w* is the \sc Lord\sc*.
\c 145
\p 
[David’s]{strong=“H1732”} Psalm \w of praise| strong="H8416" \w*. 
\v 1 [I will extol]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8787”} [thee, my God]{strong=“H430”}, \w O king| strong="H4428" \w*; [and I will bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy name| strong="H8034" \w* \w for ever| strong="H5769" \w* \w and ever| strong="H5703" \w*. 
\v 2 \w Every day| strong="H3117" \w* [will I bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} [thee; and I will praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy name| strong="H8034" \w* \w for ever| strong="H5769" \w* \w and ever| strong="H5703" \w*. 
\v 3 \w Great| strong="H1419" \w* is the \sc Lord\sc*, \w and greatly| strong="H3966" \w* [to be praised]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8794”}; \w and his greatness| strong="H1420" \w* is \w unsearchable| strong="H2714" \w*.\f + \fr 145:3 \ft and his…: Heb. and of his greatness there is no search \f* 
\v 4 \w One| strong="H1755" \w* \w generation| strong="H1755" \w* [shall praise]{strong=“H7623” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy works| strong="H4639" \w* [to another, and shall declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy mighty acts| strong="H1369" \w*. 
\v 5 [I will speak]{strong=“H7878” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the glorious| strong="H3519" \w* \w honour| strong="H1926" \w* \w of thy majesty| strong="H1935" \w*, [and of thy wondrous]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} \w works| strong="H1697" \w*.\f + \fr 145:5 \ft works: Heb. things, or, words \f* 
\v 6 And men [shall speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the might| strong="H5807" \w* [of thy terrible acts]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”}: [and I will declare]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy greatness| strong="H1420" \w*.\f + \fr 145:6 \ft declare: Heb. declare it \f* 
\v 7 [They shall abundantly utter]{strong=“H5042” x-morph=“strongMorph: \sc Th\sc*8686”} \w the memory| strong="H2143" \w* \w of thy great| strong="H7227" \w* \w goodness| strong="H2898" \w*, [and shall sing]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8762”} \w of thy righteousness| strong="H6666" \w*. 
\v 8 The \sc Lord\sc* is \w gracious| strong="H2587" \w*, \w and full of compassion| strong="H7349" \w*; \w slow| strong="H750" \w* \w to anger| strong="H639" \w*, \w and of great| strong="H1419" \w* \w mercy| strong="H2617" \w*.\f + \fr 145:8 \ft of great…: Heb. great in mercy \f* 
\v 9 The \sc Lord\sc* is \w good| strong="H2896" \w* [to all: and his tender mercies]{strong=“H7356”} are \w over all his works| strong="H4639" \w*. 
\v 10 \w All thy works| strong="H4639" \w* [shall praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} thee, O \sc Lord\sc*; \w and thy saints| strong="H2623" \w* [shall bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} thee. 
\v 11 [They shall speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the glory| strong="H3519" \w* \w of thy kingdom| strong="H4438" \w*, [and talk]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w of thy power| strong="H1369" \w*; 
\v 12 [To make known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8687”} \w to the sons| strong="H1121" \w* \w of men| strong="H120" \w* \w his mighty acts| strong="H1369" \w*, \w and the glorious| strong="H3519" \w* \w majesty| strong="H1926" \w* \w of his kingdom| strong="H4438" \w*. 
\v 13 \w Thy kingdom| strong="H4438" \w* is \w an everlasting| strong="H5769" \w* \w kingdom| strong="H4438" \w*, \w and thy dominion| strong="H4475" \w* endureth \w throughout all| strong="H1755" \w* \w generations| strong="H1755" \w*.\f + \fr 145:13 \ft an…: Heb. a kingdom of all ages \f* 
\v 14 The \sc Lord\sc* [upholdeth]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8802”} [all that fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8802”}, [and raiseth up]{strong=“H2210” x-morph=“strongMorph: \sc Th\sc*8802”} all those that be [bowed down]{strong=“H3721” x-morph=“strongMorph: \sc Th\sc*8803”}. 
\v 15 \w The eyes| strong="H5869" \w* [of all wait]{strong=“H7663” x-morph=“strongMorph: \sc Th\sc*8762”} [upon thee; and thou givest]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w them their meat| strong="H400" \w* \w in due season| strong="H6256" \w*.\f + \fr 145:15 \ft wait…: or, look unto \f* 
\v 16 [Thou openest]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8802”} \w thine hand| strong="H3027" \w*, [and satisfiest]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8688”} \w the desire| strong="H7522" \w* \w of every living thing| strong="H2416" \w*. 
\v 17 The \sc Lord\sc* is \w righteous| strong="H6662" \w* \w in all his ways| strong="H1870" \w*, \w and holy| strong="H2623" \w* \w in all his works| strong="H4639" \w*.\f + \fr 145:17 \ft holy: or, merciful, or, bountiful \f* 
\v 18 The \sc Lord\sc* is \w nigh| strong="H7138" \w* [unto all them that call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8802”} [upon him, to all that call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon him in truth| strong="H571" \w*. 
\v 19 [He will fulfil]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w the desire| strong="H7522" \w* \w of them that fear| strong="H3373" \w* [him: he also will hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w their cry| strong="H7775" \w*, [and will save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} them. 
\v 20 The \sc Lord\sc* [preserveth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} [all them that love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} [him: but all the wicked]{strong=“H7563”} [will he destroy]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 21 \w My mouth| strong="H6310" \w* [shall speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w the praise| strong="H8416" \w* of the \sc Lord\sc*: \w and let all flesh| strong="H1320" \w* [bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w his holy| strong="H6944" \w* \w name| strong="H8034" \w* \w for ever| strong="H5769" \w* \w and ever| strong="H5703" \w*.
\c 146
\p 
\v 1 [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*. [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc*, \w O my soul| strong="H5315" \w*.\f + \fr 146:1 \ft Praise ye…: Heb. Hallelujah \f* 
\v 2 \w While I live| strong="H2416" \w* [will I praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} the \sc Lord\sc*: [I will sing praises]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto my God| strong="H430" \w* while I have any being. 
\v 3 [Put not your trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} \w in princes| strong="H5081" \w*, nor \w in the son| strong="H1121" \w* \w of man| strong="H120" \w*, in whom there is \w no help| strong="H8668" \w*.\f + \fr 146:3 \ft help: or, salvation \f* 
\v 4 \w His breath| strong="H7307" \w* [goeth forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”}, [he returneth]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w to his earth| strong="H127" \w*; \w in that very day| strong="H3117" \w* \w his thoughts| strong="H6250" \w* [perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 5 \w Happy| strong="H835" \w* is he that hath \w the God| strong="H410" \w* \w of Jacob| strong="H3290" \w* \w for his help| strong="H5828" \w*, \w whose hope| strong="H7664" \w* is in the \sc Lord\sc* \w his God| strong="H430" \w*: 
\v 6 [Which made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w heaven| strong="H8064" \w*, \w and earth| strong="H776" \w*, \w the sea| strong="H3220" \w*, and all that therein is: [which keepeth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w truth| strong="H571" \w* \w for ever| strong="H5769" \w*: 
\v 7 [Which executeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w judgment| strong="H4941" \w* [for the oppressed]{strong=“H6231” x-morph=“strongMorph: \sc Th\sc*8803”}: [which giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w food| strong="H3899" \w* \w to the hungry| strong="H7457" \w*. The \sc Lord\sc* [looseth]{strong=“H5425” x-morph=“strongMorph: \sc Th\sc*8688”} [the prisoners]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8803”}: 
\v 8 The \sc Lord\sc* [openeth]{strong=“H6491” x-morph=“strongMorph: \sc Th\sc*8802”} the eyes of \w the blind| strong="H5787" \w*: the \sc Lord\sc* [raiseth]{strong=“H2210” x-morph=“strongMorph: \sc Th\sc*8802”} [them that are bowed down]{strong=“H3721” x-morph=“strongMorph: \sc Th\sc*8803”}: the \sc Lord\sc* [loveth]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} \w the righteous| strong="H6662" \w*: 
\v 9 The \sc Lord\sc* [preserveth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w the strangers| strong="H1616" \w*; [he relieveth]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8766”} \w the fatherless| strong="H3490" \w* \w and widow| strong="H490" \w*: \w but the way| strong="H1870" \w* \w of the wicked| strong="H7563" \w* [he turneth upside down]{strong=“H5791” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 10 The \sc Lord\sc* [shall reign]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8799”} \w for ever| strong="H5769" \w*, even \w thy God| strong="H430" \w*, \w O Zion| strong="H6726" \w*, \w unto all| strong="H1755" \w* \w generations| strong="H1755" \w*. [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*.
\c 147
\p 
\v 1 [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*: for it is \w good| strong="H2896" \w* [to sing praises]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8763”} \w unto our God| strong="H430" \w*; for it is \w pleasant| strong="H5273" \w*; and \w praise| strong="H8416" \w* \w is comely| strong="H5000" \w*. 
\v 2 The \sc Lord\sc* [doth build up]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8802”} \w Jerusalem| strong="H3389" \w*: [he gathereth together]{strong=“H3664” x-morph=“strongMorph: \sc Th\sc*8762”} [the outcasts]{strong=“H1760” x-morph=“strongMorph: \sc Th\sc*8737”} \w of Israel| strong="H3478" \w*. 
\v 3 [He healeth]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8802”} [the broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8803”} \w in heart| strong="H3820" \w*, [and bindeth up]{strong=“H2280” x-morph=“strongMorph: \sc Th\sc*8764”} \w their wounds| strong="H6094" \w*.\f + \fr 147:3 \ft wounds: Heb. griefs \f* 
\v 4 [He telleth]{strong=“H4487” x-morph=“strongMorph: \sc Th\sc*8802”} \w the number| strong="H4557" \w* \w of the stars| strong="H3556" \w*; [he calleth]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} them all by their \w names| strong="H8034" \w*. 
\v 5 \w Great| strong="H1419" \w* is \w our Lord| strong="H113" \w*, \w and of great| strong="H7227" \w* \w power| strong="H3581" \w*: \w his understanding| strong="H8394" \w* is \w infinite| strong="H4557" \w*.\f + \fr 147:5 \ft his…: Heb. of his understanding there is no number \f* 
\v 6 The \sc Lord\sc* [lifteth up]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8767”} \w the meek| strong="H6035" \w*: \w he casteth| strong="H8213" \w* \w the wicked| strong="H7563" \w* [down]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8688”} \w to the ground| strong="H776" \w*. 
\v 7 [Sing]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8798”} unto the \sc Lord\sc* \w with thanksgiving| strong="H8426" \w*; [sing praise]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8761”} \w upon the harp| strong="H3658" \w* \w unto our God| strong="H430" \w*: 
\v 8 [Who covereth]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8764”} \w the heaven| strong="H8064" \w* \w with clouds| strong="H5645" \w*, [who prepareth]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8688”} \w rain| strong="H4306" \w* \w for the earth| strong="H776" \w*, \w who maketh grass| strong="H2682" \w* [to grow]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8688”} \w upon the mountains| strong="H2022" \w*. 
\v 9 [He giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the beast| strong="H929" \w* \w his food| strong="H3899" \w*, and \w to the young| strong="H1121" \w* \w ravens| strong="H6158" \w* [which cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 10 [He delighteth]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8799”} \w not in the strength| strong="H1369" \w* \w of the horse| strong="H5483" \w*: [he taketh not pleasure]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the legs| strong="H7785" \w* \w of a man| strong="H376" \w*. 
\v 11 The \sc Lord\sc* [taketh pleasure]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8802”} \w in them that fear| strong="H3373" \w* [him, in those that hope]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8764”} \w in his mercy| strong="H2617" \w*. 
\v 12 [Praise]{strong=“H7623” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc*, \w O Jerusalem| strong="H3389" \w*; [praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} \w thy God| strong="H430" \w*, \w O Zion| strong="H6726" \w*. 
\v 13 [For he hath strengthened]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8765”} \w the bars| strong="H1280" \w* \w of thy gates| strong="H8179" \w*; [he hath blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy children| strong="H1121" \w* \w within| strong="H7130" \w* thee. 
\v 14 [He maketh]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8802”} \w peace| strong="H7965" \w* in \w thy borders| strong="H1366" \w*, and [filleth ]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee with the finest| strong="H2459" \w* \w of the wheat| strong="H2406" \w*.\f + \fr 147:14 \ft He…: Heb. Who maketh thy border peace \f* \f + \fr 147:14 \ft finest…: Heb. fat of wheat \f* 
\v 15 [He sendeth forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8802”} \w his commandment| strong="H565" \w* upon \w earth| strong="H776" \w*: \w his word| strong="H1697" \w* [runneth]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”} \w very swiftly| strong="H4120" \w*. 
\v 16 [He giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w snow| strong="H7950" \w* \w like wool| strong="H6785" \w*: [he scattereth]{strong=“H6340” x-morph=“strongMorph: \sc Th\sc*8762”} \w the hoarfrost| strong="H3713" \w* \w like ashes| strong="H665" \w*. 
\v 17 [He casteth forth]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8688”} \w his ice| strong="H7140" \w* \w like morsels| strong="H6595" \w*: [who can stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* \w his cold| strong="H7135" \w*? 
\v 18 [He sendeth out]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w his word| strong="H1697" \w*, [and melteth]{strong=“H4529” x-morph=“strongMorph: \sc Th\sc*8686”} [them: he causeth his wind]{strong=“H7307”} [to blow]{strong=“H5380” x-morph=“strongMorph: \sc Th\sc*8686”}, and \w the waters| strong="H4325" \w* [flow]{strong=“H5140” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 19 [He sheweth]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8688”} [his word]{strong=“H1697 H1697” x-morph=“strongMorph: \sc Th\sc*8675”} \w unto Jacob| strong="H3290" \w*, \w his statutes| strong="H2706" \w* \w and his judgments| strong="H4941" \w* \w unto Israel| strong="H3478" \w*.\f + \fr 147:19 \ft his word: Heb. his words \f* 
\v 20 [He hath not dealt]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w so with any nation| strong="H1471" \w*: and as for his \w judgments| strong="H4941" \w*, [they have not known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [them. Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*.
\c 148
\p 
\v 1 [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*. [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc* \w from the heavens| strong="H8064" \w*: [praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} \w him in the heights| strong="H4791" \w*.^\sc 148:1 Praise ye the [Lord\sc*. Praise: Heb. Hallelujah, etc] 
\v 2 [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} [ye him, all his angels]{strong=“H4397”}: [praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} [ye him, all his hosts]{strong=“H6635”}. 
\v 3 [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} [ye him, sun]{strong=“H8121”} \w and moon| strong="H3394" \w*: [praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} [him, all ye stars]{strong=“H3556”} \w of light| strong="H216" \w*. 
\v 4 [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} [him, ye heavens]{strong=“H8064”} \w of heavens| strong="H8064" \w*, \w and ye waters| strong="H4325" \w* that be \w above the heavens| strong="H8064" \w*. 
\v 5 [Let them praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} \w the name| strong="H8034" \w* of the \sc Lord\sc*: [for he commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”}, [and they were created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 6 [He hath also stablished]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8686”} \w them for ever| strong="H5703" \w* \w and ever| strong="H5769" \w*: [he hath made]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w a decree| strong="H2706" \w* [which shall not pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 7 [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc* \w from the earth| strong="H776" \w*, \w ye dragons| strong="H8577" \w*, \w and all deeps| strong="H8415" \w*: 
\v 8 \w Fire| strong="H784" \w*, \w and hail| strong="H1259" \w*; \w snow| strong="H7950" \w*, \w and vapour| strong="H7008" \w*; \w stormy| strong="H5591" \w* \w wind| strong="H7307" \w* [fulfilling]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w his word| strong="H1697" \w*: 
\v 9 \w Mountains| strong="H2022" \w*, \w and all hills| strong="H1389" \w*; \w fruitful| strong="H6529" \w* \w trees| strong="H6086" \w*, \w and all cedars| strong="H730" \w*: 
\v 10 \w Beasts| strong="H2416" \w*, \w and all cattle| strong="H929" \w*; \w creeping things| strong="H7431" \w*, \w and flying| strong="H3671" \w* \w fowl| strong="H6833" \w*:\f + \fr 148:10 \ft flying…: Heb. birds of wing \f* 
\v 11 \w Kings| strong="H4428" \w* \w of the earth| strong="H776" \w*, \w and all people| strong="H3816" \w*; \w princes| strong="H8269" \w*, [and all judges]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the earth| strong="H776" \w*: 
\v 12 \w Both young men| strong="H970" \w*, \w and maidens| strong="H1330" \w*; \w old men| strong="H2205" \w*, \w and children| strong="H5288" \w*: 
\v 13 [Let them praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} \w the name| strong="H8034" \w* of the \sc Lord\sc*: \w for his name| strong="H8034" \w* [alone is excellent]{strong=“H7682” x-morph=“strongMorph: \sc Th\sc*8737”}; \w his glory| strong="H1935" \w* is \w above the earth| strong="H776" \w* \w and heaven| strong="H8064" \w*.\f + \fr 148:13 \ft excellent: Heb. exalted \f* 
\v 14 [He also exalteth]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} \w the horn| strong="H7161" \w* \w of his people| strong="H5971" \w*, \w the praise| strong="H8416" \w* \w of all his saints| strong="H2623" \w*; even \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, \w a people| strong="H5971" \w* \w near| strong="H7138" \w* [unto him. Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*.
\c 149
\p 
\v 1 [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*. [Sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8798”} unto the \sc Lord\sc* \w a new| strong="H2319" \w* \w song| strong="H7892" \w*, and \w his praise| strong="H8416" \w* \w in the congregation| strong="H6951" \w* \w of saints| strong="H2623" \w*.\f + \fr 149:1 \ft Praise…: Heb. Hallelujah \f* 
\v 2 \w Let Israel| strong="H3478" \w* [rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} [in him that made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} [him: let the children]{strong=“H1121”} \w of Zion| strong="H6726" \w* [be joyful]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”} \w in their King| strong="H4428" \w*.\f + \fr 149:2 \ft in him…: Heb. in his Makers \f* 
\v 3 [Let them praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} \w his name| strong="H8034" \w* \w in the dance| strong="H4234" \w*: [let them sing praises]{strong=“H2167” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto him with the timbrel| strong="H8596" \w* \w and harp| strong="H3658" \w*.\f + \fr 149:3 \ft in…: or, with the pipe \f* 
\v 4 For the \sc Lord\sc* [taketh pleasure]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8802”} \w in his people| strong="H5971" \w*: [he will beautify]{strong=“H6286” x-morph=“strongMorph: \sc Th\sc*8762”} \w the meek| strong="H6035" \w* \w with salvation| strong="H3444" \w*. 
\v 5 \w Let the saints| strong="H2623" \w* [be joyful]{strong=“H5937” x-morph=“strongMorph: \sc Th\sc*8799”} \w in glory| strong="H3519" \w*: [let them sing aloud]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8762”} \w upon their beds| strong="H4904" \w*. 
\v 6 Let \w the high| strong="H7319" \w* praises \w of God| strong="H410" \w* be \w in their mouth| strong="H1627" \w*, \w and a twoedged| strong="H6374" \w* \w sword| strong="H2719" \w* \w in their hand| strong="H3027" \w*;\f + \fr 149:6 \ft mouth: Heb. throat \f* 
\v 7 [To execute]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w vengeance| strong="H5360" \w* \w upon the heathen| strong="H1471" \w*, and \w punishments| strong="H8433" \w* \w upon the people| strong="H3816" \w*; 
\v 8 [To bind]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8800”} \w their kings| strong="H4428" \w* \w with chains| strong="H2131" \w*, [and their nobles]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8737”} \w with fetters| strong="H3525" \w* \w of iron| strong="H1270" \w*; 
\v 9 [To execute]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w upon them the judgment| strong="H4941" \w* [written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8803”}: \w this honour| strong="H1926" \w* \w have all his saints| strong="H2623" \w*. [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*.
\c 150
\p 
\v 1 [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*. [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} \w God| strong="H410" \w* \w in his sanctuary| strong="H6944" \w*: [praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} \w him in the firmament| strong="H7549" \w* \w of his power| strong="H5797" \w*.\f + \fr 150:1 \ft Praise ye…: Heb. Hallelujah \f* 
\v 2 [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} \w him for his mighty acts| strong="H1369" \w*: [praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} \w him according to his excellent| strong="H7230" \w* \w greatness| strong="H1433" \w*. 
\v 3 [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} \w him with the sound| strong="H8629" \w* \w of the trumpet| strong="H7782" \w*: [praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} \w him with the psaltery| strong="H5035" \w* \w and harp| strong="H3658" \w*.\f + \fr 150:3 \ft trumpet: or, cornet \f* 
\v 4 [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} \w him with the timbrel| strong="H8596" \w* \w and dance| strong="H4234" \w*: [praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} \w him with stringed instruments| strong="H4482" \w* \w and organs| strong="H5748" \w*.\f + \fr 150:4 \ft dance: or, pipe \f* 
\v 5 [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} \w him upon the loud| strong="H8088" \w* \w cymbals| strong="H6767" \w*: [praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} \w him upon the high sounding| strong="H8643" \w* \w cymbals| strong="H6767" \w*. 
\v 6 \w Let every thing that hath breath| strong="H5397" \w* [praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} the \sc Lord\sc*. [Praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*. 
