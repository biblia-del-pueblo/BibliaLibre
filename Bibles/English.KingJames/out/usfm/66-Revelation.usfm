\v 10 [I was]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-1S 1”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 2”} [the Spirit]{strong=“G4151” x-morph=“robinson: N-\sc Dsn\sc* 3”} [on]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 4”} [the]{strong=“G2250” x-morph=“robinson: N-\sc Dsf\sc* 7”} [Lord’s]{strong=“G2960” x-morph=“robinson: A-\sc Dsf\sc* 6”} [day]{strong=“G2250” x-morph=“robinson: N-\sc Dsf\sc* 7”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [heard]{strong=“G191” x-morph=“robinson: V-\sc Aai\sc*-1S 9”} [behind]{strong=“G3694” x-morph=“robinson: \sc Adv\sc* 10”} [me]{strong=“G3450” x-morph=“robinson: P-1\sc Gs\sc* 11”} [a]{strong=“G5456” x-morph=“robinson: N-\sc Asf\sc* 12”} [great]{strong=“G3173” x-morph=“robinson: A-\sc Asf\sc* 13”} [voice]{strong=“G5456” x-morph=“robinson: N-\sc Asf\sc* 12”}, [as]{strong=“G5613” x-morph=“robinson: \sc Adv\sc* 14”} [of a trumpet]{strong=“G4536” x-morph=“robinson: N-\sc Gsf\sc* 15”}, 
\v 11 [Saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Gsf\sc* 1”}, \wj I am Alpha and Omega, the first and the last:\wj* [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”}, \wj What thou seest, write in a book, and send it unto the seven churches which are in Asia; unto Ephesus, and unto Smyrna, and unto Pergamos, and unto Thyatira, and unto Sardis, and unto Philadelphia, and unto Laodicea.\wj* 
\v 12 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [I turned]{strong=“G1994” x-morph=“robinson: V-\sc Aai\sc*-1S 2”} [to see]{strong=“G991” x-morph=“robinson: V-\sc Pan\sc* 3”} [the voice]{strong=“G3588 G5456” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 4 5”} [that]{strong=“G3748” x-morph=“robinson: R-\sc Nsf\sc* 6”} [spake]{strong=“G2980” x-morph=“robinson: V-\sc Aai\sc*-3S 7”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 8”} [me]{strong=“G1700” x-morph=“robinson: P-1\sc Gs\sc* 9”}. [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [being turned]{strong=“G1994” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 11”}, [I saw]{strong=“G1492” x-morph=“robinson: V-2\sc Aai\sc*-1S 12”} [seven]{strong=“G2033” x-morph=“robinson: A-\sc Nui\sc* 13”} golden [candlesticks]{strong=“G3087” x-morph=“robinson: N-\sc Apf\sc* 14”}; 
\v 13 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 2”} [the midst]{strong=“G3319” x-morph=“robinson: A-\sc Dsn\sc* 3”} [of the]{strong=“G3087” x-morph=“robinson: N-\sc Gpf\sc* 6”} [seven]{strong=“G2033” x-morph=“robinson: A-\sc Nui\sc* 5”} [candlesticks]{strong=“G3087” x-morph=“robinson: N-\sc Gpf\sc* 6”} one [like]{strong=“G3664” x-morph=“robinson: A-\sc Asm\sc* 7”} [unto the Son]{strong=“G5207” x-morph=“robinson: N-\sc Dsm\sc* 8”} [of man]{strong=“G444” x-morph=“robinson: N-\sc Gsm\sc* 9”}, [clothed]{strong=“G1746” x-morph=“robinson: V-\sc Rmp\sc*-\sc Asm\sc* 10”} [with a garment down to the foot]{strong=“G4158” x-morph=“robinson: A-\sc Asm\sc* 11”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”} [girt]{strong=“G4024” x-morph=“robinson: V-\sc Rpp\sc*-\sc Asm\sc* 13”} [about]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 14”} [the paps]{strong=“G3588 G3149” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 15 16”} [with a]{strong=“G2223” x-morph=“robinson: N-\sc Asf\sc* 17”} [golden]{strong=“G5552” x-morph=“robinson: A-\sc Asf\sc* 18”} [girdle]{strong=“G2223” x-morph=“robinson: N-\sc Asf\sc* 17”}. 
\v 14 [His]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 4”} [head]{strong=“G2776” x-morph=“robinson: N-\sc Nsf\sc* 3”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} his [hairs]{strong=“G3588 G2359” x-morph=“robinson: T-\sc Npf\sc* robinson: N-\sc Npf\sc* 6 7”} were [white]{strong=“G3022” x-morph=“robinson: A-\sc Npf\sc* 8”} [like]{strong=“G5616” x-morph=“robinson: \sc Adv\sc* 9”} [wool]{strong=“G2053” x-morph=“robinson: N-\sc Nsn\sc* 10”}, [as]{strong=“G5613” x-morph=“robinson: \sc Adv\sc* 12”} [white]{strong=“G3022” x-morph=“robinson: A-\sc Nsn\sc* 11”} [as snow]{strong=“G5510” x-morph=“robinson: N-\sc Nsf\sc* 13”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 17”} [eyes]{strong=“G3588 G3788” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 15 16”} were [as]{strong=“G5613” x-morph=“robinson: \sc Adv\sc* 18”} [a flame]{strong=“G5395” x-morph=“robinson: N-\sc Nsf\sc* 19”} [of fire]{strong=“G4442” x-morph=“robinson: N-\sc Gsn\sc* 20”}; 
\v 15 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 4”} [feet]{strong=“G3588 G4228” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 2 3”} [like]{strong=“G3664” x-morph=“robinson: A-\sc Npm\sc* 5”} [unto fine brass]{strong=“G5474” x-morph=“robinson: N-\sc Dsn\sc* 6”}, [as if]{strong=“G5613” x-morph=“robinson: \sc Adv\sc* 7”} [they burned]{strong=“G4448” x-morph=“robinson: V-\sc Rpp\sc*-\sc Npm\sc* 10”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 8”} [a furnace]{strong=“G2575” x-morph=“robinson: N-\sc Dsf\sc* 9”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 14”} [voice]{strong=“G3588 G5456” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 12 13”} [as]{strong=“G5613” x-morph=“robinson: \sc Adv\sc* 15”} [the sound]{strong=“G5456” x-morph=“robinson: N-\sc Nsf\sc* 16”} [of]{strong=“G5204” x-morph=“robinson: N-\sc Gpn\sc* 17”} [many]{strong=“G4183” x-morph=“robinson: A-\sc Gpn\sc* 18”} [waters]{strong=“G5204” x-morph=“robinson: N-\sc Gpn\sc* 17”}. 
\v 16 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he had]{strong=“G2192” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 2”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 3”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 6”} [right hand]{strong=“G1188” x-morph=“robinson: A-\sc Dsf\sc* 5”} [seven]{strong=“G2033” x-morph=“robinson: A-\sc Nui\sc* 9”} [stars]{strong=“G792” x-morph=“robinson: N-\sc Apm\sc* 8”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [out]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 11”} [of]{strong=“G3588 G4750” x-morph=“robinson: T-\sc Gsn\sc* robinson: N-\sc Gsn\sc* 12 13”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 14”} [mouth]{strong=“G4750” x-morph=“robinson: N-\sc Gsn\sc* 13”} [went]{strong=“G1607” x-morph=“robinson: V-\sc Pnp\sc*-\sc Nsf\sc* 18”} [a]{strong=“G4501” x-morph=“robinson: N-\sc Nsf\sc* 15”} [sharp]{strong=“G3691” x-morph=“robinson: A-\sc Nsf\sc* 17”} [twoedged]{strong=“G1366” x-morph=“robinson: A-\sc Nsm\sc* 16”} [sword]{strong=“G4501” x-morph=“robinson: N-\sc Nsf\sc* 15”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 19”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 22”} [countenance]{strong=“G3588 G3799” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 20 21”} was [as]{strong=“G5613” x-morph=“robinson: \sc Adv\sc* 23”} [the sun]{strong=“G3588 G2246” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 24 25”} [shineth]{strong=“G5316” x-morph=“robinson: V-\sc Pai\sc*-3S 26”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 27”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 30”} [strength]{strong=“G3588 G1411” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 28 29”}. 
\v 17 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when]{strong=“G3753” x-morph=“robinson: \sc Adv\sc* 2”} [I saw]{strong=“G1492” x-morph=“robinson: V-2\sc Aai\sc*-1S 3”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 4”}, [I fell]{strong=“G4098” x-morph=“robinson: V-2\sc Aai\sc*-1S 5”} [at]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 6”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 9”} [feet]{strong=“G3588 G4228” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 7 8”} [as]{strong=“G5613” x-morph=“robinson: \sc Adv\sc* 10”} [dead]{strong=“G3498” x-morph=“robinson: A-\sc Nsm\sc* 11”}. [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”} [he laid]{strong=“G2007” x-morph=“robinson: V-\sc Aai\sc*-3S 13”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 16”} [right]{strong=“G1188” x-morph=“robinson: A-\sc Asf\sc* 15”} [hand]{strong=“G5495” x-morph=“robinson: N-\sc Asf\sc* 17”} [upon]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 18”} [me]{strong=“G1691” x-morph=“robinson: P-1\sc As\sc* 19”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 20”} [unto me]{strong=“G3427” x-morph=“robinson: P-1\sc Ds\sc* 21”}, \wj Fear not; I am the first and the last:\wj* 
\v 18 \wj I am he that liveth, and was dead; and, behold, I am alive for evermore, Amen; and have the keys of hell and of death.\wj* 
\p
\v 19 \wj Write the things which thou hast seen, and the things which are, and the things which shall be hereafter;\wj* 
\v 20 \wj The mystery of the seven stars which thou sawest in my right hand, and the seven golden candlesticks. The seven stars are the angels of the seven churches: and the seven candlesticks which thou sawest are the seven churches.\wj* 
\c 2
\p 
\v 1 \wj Unto the angel of the church of Ephesus write; These things saith he that holdeth the seven stars in his right hand, who walketh in the midst of the seven golden candlesticks;\wj* 
\v 2 \wj I know thy works, and thy labour, and thy patience, and how thou canst not bear them which are evil: and thou hast tried them which say they are apostles, and are not, and hast found them liars:\wj* 
\v 3 \wj And hast borne, and hast patience, and for my name’s sake hast laboured, and hast not fainted.\wj* 
\v 4 \wj Nevertheless I have somewhat against thee, because thou hast left thy first love.\wj* 
\v 5 \wj Remember therefore from whence thou art fallen, and repent, and do the first works; or else I will come unto thee quickly, and will remove thy candlestick out of his place, except thou repent.\wj* 
\v 6 \wj But this thou hast, that thou hatest the deeds of the Nicolaitans, which I also hate.\wj* 
\v 7 \wj He that hath an ear, let him hear what the Spirit saith unto the churches; To him that overcometh will I give to eat of the tree of life, which is in the midst of the paradise of God.\wj* 
\p
\v 8 \wj And unto the angel of the church in Smyrna write; These things saith the first and the last, which was dead, and is alive;\wj* 
\v 9 \wj I know thy works, and tribulation, and poverty, (but thou art rich) and I know the blasphemy of them which say they are Jews, and are not, but are the synagogue of Satan.\wj* 
\v 10 \wj Fear none of those things which thou shalt suffer: behold, the devil shall cast some of you into prison, that ye may be tried; and ye shall have tribulation ten days: be thou faithful unto death, and I will give thee a crown of life.\wj* 
\v 11 \wj He that hath an ear, let him hear what the Spirit saith unto the churches; He that overcometh shall not be hurt of the second death.\wj* 
\p
\v 12 \wj And to the angel of the church in Pergamos write; These things saith he which hath the sharp sword with two edges;\wj* 
\v 13 \wj I know thy works, and where thou dwellest, even where Satan’s seat is: and thou holdest fast my name, and hast not denied my faith, even in those days wherein Antipas was my faithful martyr, who was slain among you, where Satan dwelleth.\wj* 
\v 14 \wj But I have a few things against thee, because thou hast there them that hold the doctrine of Balaam, who taught Balac to cast a stumblingblock before the children of Israel, to eat things sacrificed unto idols, and to commit fornication.\wj* 
\v 15 \wj So hast thou also them that hold the doctrine of the Nicolaitans, which thing I hate.\wj* 
\v 16 \wj Repent; or else I will come unto thee quickly, and will fight against them with the sword of my mouth.\wj* 
\v 17 \wj He that hath an ear, let him hear what the Spirit saith unto the churches; To him that overcometh will I give to eat of the hidden manna, and will give him a white stone, and in the stone a new name written, which no man knoweth saving he that receiveth it.\wj* 
\p
\v 18 \wj And unto the angel of the church in Thyatira write; These things saith the Son of God, who hath his eyes like unto a flame of fire, and his feet are like fine brass;\wj* 
\v 19 \wj I know thy works, and charity, and service, and faith, and thy patience, and thy works; and the last to be more than the first.\wj* 
\v 20 \wj Notwithstanding I have a few things against thee, because thou sufferest that woman Jezebel, which calleth herself a prophetess, to teach and to seduce my servants to commit fornication, and to eat things sacrificed unto idols.\wj* 
\v 21 \wj And I gave her space to repent of her fornication; and she repented not.\wj* 
\v 22 \wj Behold, I will cast her into a bed, and them that commit adultery with her into great tribulation, except they repent of their deeds.\wj* 
\v 23 \wj And I will kill her children with death; and all the churches shall know that I am he which searcheth the reins and hearts: and I will give unto every one of you according to your works.\wj* 
\v 24 \wj But unto you I say, and unto the rest in Thyatira, as many as have not this doctrine, and which have not known the depths of Satan, as they speak; I will put upon you none other burden.\wj* 
\v 25 \wj But that which ye have already hold fast till I come.\wj* 
\v 26 \wj And he that overcometh, and keepeth my works unto the end, to him will I give power over the nations:\wj* 
\v 27 \wj And he shall rule them with a rod of iron; as the vessels of a potter shall they be broken to shivers: even as I received of my Father.\wj* 
\v 28 \wj And I will give him the morning star.\wj* 
\v 29 \wj He that hath an ear, let him hear what the Spirit saith unto the churches.\wj* 
\c 3
\p 
\v 1 \wj And unto the angel of the church in Sardis write; These things saith he that hath the seven Spirits of God, and the seven stars; I know thy works, that thou hast a name that thou livest, and art dead.\wj* 
\v 2 \wj Be watchful, and strengthen the things which remain, that are ready to die: for I have not found thy works perfect before God.\wj* 
\v 3 \wj Remember therefore how thou hast received and heard, and hold fast, and repent. If therefore thou shalt not watch, I will come on thee as a thief, and thou shalt not know what hour I will come upon thee.\wj* 
\v 4 \wj Thou hast a few names even in Sardis which have not defiled their garments; and they shall walk with me in white: for they are worthy.\wj* 
\v 5 \wj He that overcometh, the same shall be clothed in white raiment; and I will not blot out his name out of the book of life, but I will confess his name before my Father, and before his angels.\wj* 
\v 6 \wj He that hath an ear, let him hear what the Spirit saith unto the churches.\wj* 
\p
\v 7 \wj And to the angel of the church in Philadelphia write; These things saith he that is holy, he that is true, he that hath the key of David, he that openeth, and no man shutteth; and shutteth, and no man openeth;\wj* 
\v 8 \wj I know thy works: behold, I have set before thee an open door, and no man can shut it: for thou hast a little strength, and hast kept my word, and hast not denied my name.\wj* 
\v 9 \wj Behold, I will make them of the synagogue of Satan, which say they are Jews, and are not, but do lie; behold, I will make them to come and worship before thy feet, and to know that I have loved thee.\wj* 
\v 10 \wj Because thou hast kept the word of my patience, I also will keep thee from the hour of temptation, which shall come upon all the world, to try them that dwell upon the earth.\wj* 
\v 11 \wj Behold, I come quickly: hold that fast which thou hast, that no man take thy crown.\wj* 
\v 12 \wj Him that overcometh will I make a pillar in the temple of my God, and he shall go no more out: and I will write upon him the name of my God, and the name of the city of my God, which is new Jerusalem, which cometh down out of heaven from my God: and I will write upon him my new name.\wj* 
\v 13 \wj He that hath an ear, let him hear what the Spirit saith unto the churches.\wj* 
\p
\v 14 \wj And unto the angel of the church of the Laodiceans write; These things saith the Amen, the faithful and true witness, the beginning of the creation of God;\wj* 
\v 15 \wj I know thy works, that thou art neither cold nor hot: I would thou wert cold or hot.\wj* 
\v 16 \wj So then because thou art lukewarm, and neither cold nor hot, I will spue thee out of my mouth.\wj* 
\v 17 \wj Because thou sayest, I am rich, and increased with goods, and have need of nothing; and knowest not that thou art wretched, and miserable, and poor, and blind, and naked:\wj* 
\v 18 \wj I counsel thee to buy of me gold tried in the fire, that thou mayest be rich; and white raiment, that thou mayest be clothed, and that the shame of thy nakedness do not appear; and anoint thine eyes with eyesalve, that thou mayest see.\wj* 
\v 19 \wj As many as I love, I rebuke and chasten: be zealous therefore, and repent.\wj* 
\v 20 \wj Behold, I stand at the door, and knock: if any man hear my voice, and open the door, I will come in to him, and will sup with him, and he with me.\wj* 
\v 21 \wj To him that overcometh will I grant to sit with me in my throne, even as I also overcame, and am set down with my Father in his throne.\wj* 
\v 22 \wj He that hath an ear, let him hear what the Spirit saith unto the churches.\wj* 
\c 4
\p 
