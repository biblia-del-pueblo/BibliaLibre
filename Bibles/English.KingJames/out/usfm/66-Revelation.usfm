\v 3 [Blessed]{strong=“G3107” x-morph=“robinson: A-\sc Nsm\sc* 1”} is [he that readeth]{strong=“G314” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 3”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 4”} [they that hear]{strong=“G191” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 6”} [the words]{strong=“G3588 G3056” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 7 8”} [of this prophecy]{strong=“G3588 G4394” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 9 10”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [keep]{strong=“G5083” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 12”} [those things which are written]{strong=“G1125” x-morph=“robinson: V-\sc Rpp\sc*-\sc Apn\sc* 16”} [therein]{strong=“G846” x-morph=“robinson: P-\sc Dsf\sc* 15”}: [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 18”} [the time]{strong=“G2540” x-morph=“robinson: N-\sc Nsm\sc* 19”} is [at hand]{strong=“G1451” x-morph=“robinson: \sc Adv\sc* 20”}. 
\v 4 [John]{strong=“G2491” x-morph=“robinson: N-\sc Nsm\sc* 1”} [to the]{strong=“G1577” x-morph=“robinson: N-\sc Dpf\sc* 4”} [seven]{strong=“G2033” x-morph=“robinson: A-\sc Nui\sc* 3”} [churches]{strong=“G1577” x-morph=“robinson: N-\sc Dpf\sc* 4”} [which are in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 6”} [Asia]{strong=“G3588 G773” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 7 8”}: [Grace]{strong=“G5485” x-morph=“robinson: N-\sc Nsf\sc* 9”} be [unto you]{strong=“G5213” x-morph=“robinson: P-2\sc Dp\sc* 10”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [peace]{strong=“G1515” x-morph=“robinson: N-\sc Nsf\sc* 12”}, [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 13”} [him which is]{strong=“G5607” x-morph=“robinson: V-\sc Pxp\sc*-\sc Nsm\sc* 16”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 17”} [which was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 19”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 20”} [which is to come]{strong=“G2064” x-morph=“robinson: V-\sc Pnp\sc*-\sc Nsm\sc* 22”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 23”} [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 24”} [the]{strong=“G4151” x-morph=“robinson: N-\sc Gpn\sc* 27”} [seven]{strong=“G2033” x-morph=“robinson: A-\sc Nui\sc* 26”} [Spirits]{strong=“G4151” x-morph=“robinson: N-\sc Gpn\sc* 27”} [which]{strong=“G3739” x-morph=“robinson: R-\sc Npn\sc* 28”} [are]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 29”} [before]{strong=“G1799” x-morph=“robinson: \sc Adv\sc* 30”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 33”} [throne]{strong=“G3588 G2362” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 31 32”}; 
\v 5 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 2”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Gsm\sc* 3”} [Christ]{strong=“G5547” x-morph=“robinson: N-\sc Gsm\sc* 4”}, who is [the]{strong=“G3588 G3144” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [faithful]{strong=“G4103” x-morph=“robinson: A-\sc Nsm\sc* 8”} [witness]{strong=“G3144” x-morph=“robinson: N-\sc Nsm\sc* 6”}, and [the first begotten]{strong=“G4416” x-morph=“robinson: A-\sc Nsm\sc* 10”} [of]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 11”} [the dead]{strong=“G3498” x-morph=“robinson: A-\sc Gpm\sc* 13”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [the prince]{strong=“G3588 G758” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 15 16”} [of the kings]{strong=“G3588 G935” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 17 18”} [of the earth]{strong=“G3588 G1093” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 19 20”}. [Unto him that loved]{strong=“G25” x-morph=“robinson: V-\sc Aap\sc*-\sc Dsm\sc* 22”} [us]{strong=“G2248” x-morph=“robinson: P-1\sc Ap\sc* 23”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 24”} [washed]{strong=“G3068” x-morph=“robinson: V-\sc Aap\sc*-\sc Dsm\sc* 25”} [us]{strong=“G2248” x-morph=“robinson: P-1\sc Ap\sc* 26”} [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 27”} [our]{strong=“G2257” x-morph=“robinson: P-1\sc Gp\sc* 30”} [sins]{strong=“G3588 G266” x-morph=“robinson: T-\sc Gpf\sc* robinson: N-\sc Gpf\sc* 28 29”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 31”} [his own]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 34”} [blood]{strong=“G3588 G129” x-morph=“robinson: T-\sc Dsn\sc* robinson: N-\sc Dsn\sc* 32 33”}, 
\v 6 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [hath made]{strong=“G4160” x-morph=“robinson: V-\sc Aai\sc*-3S 2”} [us]{strong=“G2248” x-morph=“robinson: P-1\sc Ap\sc* 3”} [kings]{strong=“G935” x-morph=“robinson: N-\sc Apm\sc* 4”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [priests]{strong=“G2409” x-morph=“robinson: N-\sc Apm\sc* 6”} [unto God]{strong=“G3588 G2316” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 7 8”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 11”} [Father]{strong=“G3962” x-morph=“robinson: N-\sc Dsm\sc* 10”}; [to him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 12”} be [glory]{strong=“G3588 G1391” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 13 14”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 15”} [dominion]{strong=“G3588 G2904” x-morph=“robinson: T-\sc Nsn\sc* robinson: N-\sc Nsn\sc* 16 17”} [for]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 18”} [ever]{strong=“G3588 G165” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 19 20”} [and ever]{strong=“G3588 G165” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 21 22”}. [Amen]{strong=“G281” x-morph=“robinson: \sc Heb\sc* 23”}. 
\v 7 [Behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 1”}, [he cometh]{strong=“G2064” x-morph=“robinson: V-\sc Pni\sc*-3S 2”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 3”} [clouds]{strong=“G3588 G3507” x-morph=“robinson: T-\sc Gpf\sc* robinson: N-\sc Gpf\sc* 4 5”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [every]{strong=“G3956” x-morph=“robinson: A-\sc Nsm\sc* 9”} [eye]{strong=“G3788” x-morph=“robinson: N-\sc Nsm\sc* 10”} [shall see]{strong=“G3700” x-morph=“robinson: V-\sc Fdi\sc*-3S 7”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 8”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [they]{strong=“G3748” x-morph=“robinson: R-\sc Npm\sc* 12”} also [which]{strong=“G3748” x-morph=“robinson: R-\sc Npm\sc* 12”} [pierced]{strong=“G1574” x-morph=“robinson: V-\sc Aai\sc*-3P 14”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 13”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 15”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Npf\sc* 19”} [kindreds]{strong=“G3588 G5443” x-morph=“robinson: T-\sc Npf\sc* robinson: N-\sc Npf\sc* 20 21”} [of the earth]{strong=“G3588 G1093” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 22 23”} [shall wail]{strong=“G2875” x-morph=“robinson: V-\sc Fdi\sc*-3P 16”} [because of]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 17”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 18”}. [Even so]{strong=“G3483” x-morph=“robinson: \sc Prt\sc* 24”}, [Amen]{strong=“G281” x-morph=“robinson: \sc Heb\sc* 25”}. 
\v 8 \wj I am Alpha and Omega, the beginning and the ending,\wj* [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 11”} [the Lord]{strong=“G3588 G2962” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 12 13”}, [which is]{strong=“G5607” x-morph=“robinson: V-\sc Pxp\sc*-\sc Nsm\sc* 15”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 16”} [which was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 18”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 19”} [which is to come]{strong=“G2064” x-morph=“robinson: V-\sc Pnp\sc*-\sc Nsm\sc* 21”}, [the Almighty]{strong=“G3588 G3841” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 22 23”}. 
\p
\v 9 [I]{strong=“G1473” x-morph=“robinson: P-1\sc Ns\sc* 1”} [John]{strong=“G2491” x-morph=“robinson: N-\sc Nsm\sc* 2”}, who [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 4”} am [your]{strong=“G5216” x-morph=“robinson: P-2\sc Gp\sc* 6”} [brother]{strong=“G80” x-morph=“robinson: N-\sc Nsm\sc* 5”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [companion]{strong=“G4791” x-morph=“robinson: A-\sc Nsm\sc* 8”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 9”} [tribulation]{strong=“G3588 G2347” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 10 11”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 13”} [the kingdom]{strong=“G3588 G932” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 14 15”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 16”} [patience]{strong=“G5281” x-morph=“robinson: N-\sc Dsf\sc* 17”} [of Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Gsm\sc* 18”} [Christ]{strong=“G5547” x-morph=“robinson: N-\sc Gsm\sc* 19”}, [was]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-1S 20”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 21”} [the isle]{strong=“G3588 G3520” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 22 23”} [that is called]{strong=“G2564” x-morph=“robinson: V-\sc Ppp\sc*-\sc Dsf\sc* 25”} [Patmos]{strong=“G3963” x-morph=“robinson: N-\sc Dsf\sc* 26”}, [for]{strong=“G1223” x-morph=“robinson: \sc Prep\sc* 27”} [the word]{strong=“G3588 G3056” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 28 29”} [of God]{strong=“G3588 G2316” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 30 31”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 32”} [for]{strong=“G1223” x-morph=“robinson: \sc Prep\sc* 33”} [the testimony]{strong=“G3588 G3141” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 34 35”} [of Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Gsm\sc* 36”} [Christ]{strong=“G5547” x-morph=“robinson: N-\sc Gsm\sc* 3