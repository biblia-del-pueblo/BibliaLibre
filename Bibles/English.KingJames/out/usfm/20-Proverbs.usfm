\v 21 [He that followeth]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8802”} \w after righteousness| strong="H6666" \w* \w and mercy| strong="H2617" \w* [findeth]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w life| strong="H2416" \w*, \w righteousness| strong="H6666" \w*, \w and honour| strong="H3519" \w*. 
\v 22 \w A wise| strong="H2450" \w* man [scaleth ]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w the city| strong="H5892" \w* \w of the mighty| strong="H1368" \w*, [and casteth down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8686”} \w the strength| strong="H5797" \w* \w of the confidence| strong="H4009" \w* thereof. 
