\c 13
\p 
\v 1 \w A wise| strong="H2450" \w* \w son| strong="H1121" \w* heareth [his father’s]{strong=“H1”} \w instruction| strong="H4148" \w*: [but a scorner]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8801”} [heareth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w not rebuke| strong="H1606" \w*. 
\v 2 \w A man| strong="H376" \w* [shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w good| strong="H2896" \w* \w by the fruit| strong="H6529" \w* of his \w mouth| strong="H6310" \w*: \w but the soul| strong="H5315" \w* [of the transgressors]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”} shall eat \w violence| strong="H2555" \w*. 
\v 3 [He that keepeth]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8802”} \w his mouth| strong="H6310" \w* [keepeth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w his life| strong="H5315" \w*: but [he that openeth wide]{strong=“H6589” x-morph=“strongMorph: \sc Th\sc*8802”} \w his lips| strong="H8193" \w* \w shall have destruction| strong="H4288" \w*. 
\v 4 \w The soul| strong="H5315" \w* \w of the sluggard| strong="H6102" \w* [desireth]{strong=“H183” x-morph=“strongMorph: \sc Th\sc*8693”}, and hath [nothing: but the soul]{strong=“H5315”} \w of the diligent| strong="H2742" \w* [shall be made fat]{strong=“H1878” x-morph=“strongMorph: \sc Th\sc*8792”}. 
\v 5 \w A righteous| strong="H6662" \w* man [hateth]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8799”} [lying]{strong=“H8267 H1697”}: \w but a wicked| strong="H7563" \w* man [is loathsome]{strong=“H887” x-morph=“strongMorph: \sc Th\sc*8686”}, [and cometh to shame]{strong=“H2659” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 6 \w Righteousness| strong="H6666" \w* [keepeth]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8799”} him that is \w upright| strong="H8537" \w* \w in the way| strong="H1870" \w*: \w but wickedness| strong="H7564" \w* [overthroweth]{strong=“H5557” x-morph=“strongMorph: \sc Th\sc*8762”} \w the sinner| strong="H2403" \w*.\f + \fr 13:6 \ft the sinner: Heb. sin \f* 
\v 7 \w There is| strong="H3426" \w* [that maketh himself rich]{strong=“H6238” x-morph=“strongMorph: \sc Th\sc*8693”}, yet hath nothing: there is [that maketh himself poor]{strong=“H7326” x-morph=“strongMorph: \sc Th\sc*8711”}, \w yet| strong="H3605" \w* hath \w great| strong="H7227" \w* \w riches| strong="H1952" \w*. 
\v 8 \w The ransom| strong="H3724" \w* [of a man’s]{strong=“H376”} \w life| strong="H5315" \w* are \w his riches| strong="H6239" \w*: [but the poor]{strong=“H7326” x-morph=“strongMorph: \sc Th\sc*8802”} [heareth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w not rebuke| strong="H1606" \w*. 
\v 9 \w The light| strong="H216" \w* \w of the righteous| strong="H6662" \w* [rejoiceth]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”}: \w but the lamp| strong="H5216" \w* \w of the wicked| strong="H7563" \w* [shall be put out]{strong=“H1846” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 13:9 \ft lamp: or, candle \f* 
\v 10 \w Only by pride| strong="H2087" \w* [cometh]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w contention| strong="H4683" \w*: [but with the well advised]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8737”} is \w wisdom| strong="H2451" \w*. 
\v 11 \w Wealth| strong="H1952" \w* gotten \w by vanity| strong="H1892" \w* [shall be diminished]{strong=“H4591” x-morph=“strongMorph: \sc Th\sc*8799”}: [but he that gathereth]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8802”} \w by labour| strong="H3027" \w* [shall increase]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”}.\f + \fr 13:11 \ft by labour: Heb. with the hand \f* 
\v 12 \w Hope| strong="H8431" \w* [deferred]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8794”} \w maketh the heart| strong="H3820" \w* [sick]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8688”}: but when \w the desire| strong="H8378" \w* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}, it is \w a tree| strong="H6086" \w* \w of life| strong="H2416" \w*. 
\v 13 [Whoso despiseth]{strong=“H936” x-morph=“strongMorph: \sc Th\sc*8802”} \w the word| strong="H1697" \w* [shall be destroyed]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8735”}: \w but he that feareth| strong="H3373" \w* \w the commandment| strong="H4687" \w* [shall be rewarded]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8792”}.\f + \fr 13:13 \ft shall be rewarded: or, shall be in peace \f* 
\v 14 \w The law| strong="H8451" \w* \w of the wise| strong="H2450" \w* is \w a fountain| strong="H4726" \w* \w of life| strong="H2416" \w*, [to depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8800”} \w from the snares| strong="H4170" \w* \w of death| strong="H4194" \w*. 
\v 15 \w Good| strong="H2896" \w* \w understanding| strong="H7922" \w* [giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w favour| strong="H2580" \w*: \w but the way| strong="H1870" \w* [of transgressors]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”} is \w hard| strong="H386" \w*. 
\v 16 \w Every prudent| strong="H6175" \w* man [dealeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w with knowledge| strong="H1847" \w*: \w but a fool| strong="H3684" \w* [layeth open]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8799”} his \w folly| strong="H200" \w*.\f + \fr 13:16 \ft layeth…: Heb. spreadeth \f* 
\v 17 \w A wicked| strong="H7563" \w* \w messenger| strong="H4397" \w* [falleth]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w into mischief| strong="H7451" \w*: \w but a faithful| strong="H529" \w* \w ambassador| strong="H6735" \w* is \w health| strong="H4832" \w*.\f + \fr 13:17 \ft a faithful…: Heb. an ambassador of faithfulness \f* 
\v 18 \w Poverty| strong="H7389" \w* \w and shame| strong="H7036" \w* shall be to [him that refuseth]{strong=“H6544” x-morph=“strongMorph: \sc Th\sc*8802”} \w instruction| strong="H4148" \w*: [but he that regardeth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w reproof| strong="H8433" \w* [shall be honoured]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8792”}. 
\v 19 \w The desire| strong="H8378" \w* [accomplished]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8738”} [is sweet]{strong=“H6149” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the soul| strong="H5315" \w*: but it is \w abomination| strong="H8441" \w* \w to fools| strong="H3684" \w* [to depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8800”} \w from evil| strong="H7451" \w*. 
\v 20 [He that walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w with wise| strong="H2450" \w* men [shall be wise]{strong=“H2449” x-morph=“strongMorph: \sc Th\sc*8799”}: [but a companion]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} \w of fools| strong="H3684" \w* [shall be destroyed]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 13:20 \ft destroyed: Heb. broken \f* 
\v 21 \w Evil| strong="H7451" \w* [pursueth]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8762”} \w sinners| strong="H2400" \w*: \w but to the righteous| strong="H6662" \w* \w good| strong="H2896" \w* [shall be repayed]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 22 \w A good| strong="H2896" \w* man [leaveth an inheritance]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8686”} [to his children’s]{strong=“H1121”} \w children| strong="H1121" \w*: \w and the wealth| strong="H2428" \w* [of the sinner]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8802”} is [laid up]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8803”} \w for the just| strong="H6662" \w*. 
\v 23 \w Much| strong="H7230" \w* \w food| strong="H400" \w* is in \w the tillage| strong="H5215" \w* [of the poor]{strong=“H7326 H7218” x-morph=“strongMorph: \sc Th\sc*8802 strongMorph: \sc Th\sc*8676”}: \w but there is| strong="H3426" \w* that is [destroyed]{strong=“H5595” x-morph=“strongMorph: \sc Th\sc*8737”} \w for want| strong="H3808" \w* \w of judgment| strong="H4941" \w*. 
\v 24 [He that spareth]{strong=“H2820” x-morph=“strongMorph: \sc Th\sc*8802”} \w his rod| strong="H7626" \w* [hateth]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} \w his son| strong="H1121" \w*: [but he that loveth]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} \w him chasteneth| strong="H4148" \w* [him betimes]{strong=“H7836” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 25 \w The righteous| strong="H6662" \w* [eateth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the satisfying| strong="H7648" \w* \w of his soul| strong="H5315" \w*: \w but the belly| strong="H990" \w* \w of the wicked| strong="H7563" \w* [shall want]{strong=“H2637” x-morph=“strongMorph: \sc Th\sc*8799”}.
\c 14
\p 
\v 1 \w Every wise| strong="H2454" \w* \w woman| strong="H802" \w* [buildeth]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w her house| strong="H1004" \w*: \w but the foolish| strong="H200" \w* [plucketh it down]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8799”} \w with her hands| strong="H3027" \w*. 
\v 2 [He that walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w in his uprightness| strong="H3476" \w* \w feareth| strong="H3373" \w* the \sc Lord\sc*: but he that is [perverse]{strong=“H3868” x-morph=“strongMorph: \sc Th\sc*8737”} \w in his ways| strong="H1870" \w* [despiseth]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8802”} him. 
\v 3 \w In the mouth| strong="H6310" \w* \w of the foolish| strong="H191" \w* is \w a rod| strong="H2415" \w* \w of pride| strong="H1346" \w*: \w but the lips| strong="H8193" \w* \w of the wise| strong="H2450" \w* [shall preserve]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} them. 
\v 4 \w Where no oxen| strong="H504" \w* are, \w the crib| strong="H18" \w* is \w clean| strong="H1249" \w*: \w but much| strong="H7230" \w* \w increase| strong="H8393" \w* is \w by the strength| strong="H3581" \w* \w of the ox| strong="H7794" \w*. 
\v 5 \w A faithful| strong="H529" \w* \w witness| strong="H5707" \w* \w will not lie| strong="H3577" \w*: \w but a false| strong="H8267" \w* \w witness| strong="H5707" \w* [will utter]{strong=“H6315” x-morph=“strongMorph: \sc Th\sc*8686”} [lies]{strong=“H3576” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 6 [A scorner]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8801”} [seeketh]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8765”} \w wisdom| strong="H2451" \w*, and findeth it [not: but knowledge]{strong=“H1847”} is [easy]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8738”} [unto him that understandeth]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8737”}. 
\v 7 [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} \w from the presence| strong="H5048" \w* \w of a foolish| strong="H3684" \w* \w man| strong="H376" \w*, [when thou perceivest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} not in him \w the lips| strong="H8193" \w* \w of knowledge| strong="H1847" \w*. 
\v 8 \w The wisdom| strong="H2451" \w* \w of the prudent| strong="H6175" \w* is [to understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8687”} \w his way| strong="H1870" \w*: \w but the folly| strong="H200" \w* \w of fools| strong="H3684" \w* is \w deceit| strong="H4820" \w*. 
\v 9 \w Fools| strong="H191" \w* [make a mock]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8686”} \w at sin| strong="H817" \w*: \w but among the righteous| strong="H3477" \w* there is \w favour| strong="H7522" \w*. 
\v 10 \w The heart| strong="H3820" \w* [knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w his own| strong="H5315" \w* \w bitterness| strong="H4787" \w*; [and a stranger]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} [doth not intermeddle]{strong=“H6148” x-morph=“strongMorph: \sc Th\sc*8691”} \w with his joy| strong="H8057" \w*.\f + \fr 14:10 \ft his own…: Heb. the bitterness of his soul \f* 
\v 11 \w The house| strong="H1004" \w* \w of the wicked| strong="H7563" \w* [shall be overthrown]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8735”}: \w but the tabernacle| strong="H168" \w* \w of the upright| strong="H3477" \w* [shall flourish]{strong=“H6524” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 12 \w There is| strong="H3426" \w* \w a way| strong="H1870" \w* \w which seemeth right| strong="H3477" \w* \w unto| strong="H6440" \w* \w a man| strong="H376" \w*, \w but the end| strong="H319" \w* thereof are \w the ways| strong="H1870" \w* \w of death| strong="H4194" \w*. 
\v 13 \w Even in laughter| strong="H7814" \w* \w the heart| strong="H3820" \w* [is sorrowful]{strong=“H3510” x-morph=“strongMorph: \sc Th\sc*8799”}; \w and the end| strong="H319" \w* \w of that mirth| strong="H8057" \w* is \w heaviness| strong="H8424" \w*. 
\v 14 [The backslider]{strong=“H5472” x-morph=“strongMorph: \sc Th\sc*8803”} \w in heart| strong="H3820" \w* [shall be filled]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”} \w with his own ways| strong="H1870" \w*: \w and a good| strong="H2896" \w* \w man| strong="H376" \w* shall be satisfied from himself. 
\v 15 \w The simple| strong="H6612" \w* [believeth]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”} \w every word| strong="H1697" \w*: \w but the prudent| strong="H6175" \w* man [looketh well]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} \w to his going| strong="H838" \w*. 
\v 16 \w A wise| strong="H2450" \w* man \w feareth| strong="H3373" \w*, [and departeth]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8802”} \w from evil| strong="H7451" \w*: \w but the fool| strong="H3684" \w* [rageth]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8693”}, [and is confident]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 17 He that is \w soon| strong="H7116" \w* \w angry| strong="H639" \w* [dealeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w foolishly| strong="H200" \w*: \w and a man| strong="H376" \w* \w of wicked devices| strong="H4209" \w* [is hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 18 \w The simple| strong="H6612" \w* [inherit]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8804”} \w folly| strong="H200" \w*: \w but the prudent| strong="H6175" \w* [are crowned]{strong=“H3803” x-morph=“strongMorph: \sc Th\sc*8686”} \w with knowledge| strong="H1847" \w*. 
\v 19 \w The evil| strong="H7451" \w* [bow]{strong=“H7817” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* \w the good| strong="H2896" \w*; \w and the wicked| strong="H7563" \w* \w at the gates| strong="H8179" \w* \w of the righteous| strong="H6662" \w*. 
\v 20 [The poor]{strong=“H7326” x-morph=“strongMorph: \sc Th\sc*8802”} [is hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8735”} \w even of his own neighbour| strong="H7453" \w*: \w but the rich| strong="H6223" \w* hath \w many| strong="H7227" \w* [friends]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 14:20 \ft the rich…: Heb. many are the lovers of the rich \f* 
\v 21 [He that despiseth]{strong=“H936” x-morph=“strongMorph: \sc Th\sc*8802”} \w his neighbour| strong="H7453" \w* [sinneth]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8802”}: [but he that hath mercy]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8781”} [on the poor]{strong=“H6041 H6035” x-morph=“strongMorph: \sc Th\sc*8675”}, \w happy| strong="H835" \w* is he. 
\v 22 [Do they not err]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8799”} [that devise]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8802”} \w evil| strong="H7451" \w*? \w but mercy| strong="H2617" \w* \w and truth| strong="H571" \w* shall be [to them that devise]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8802”} \w good| strong="H2896" \w*. 
\v 23 \w In all labour| strong="H6089" \w* \w there is profit| strong="H4195" \w*: \w but the talk| strong="H1697" \w* \w of the lips| strong="H8193" \w* tendeth \w only to penury| strong="H4270" \w*. 
\v 24 \w The crown| strong="H5850" \w* \w of the wise| strong="H2450" \w* is \w their riches| strong="H6239" \w*: but \w the foolishness| strong="H200" \w* \w of fools| strong="H3684" \w* is \w folly| strong="H200" \w*. 
\v 25 \w A true| strong="H571" \w* \w witness| strong="H5707" \w* [delivereth]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8688”} \w souls| strong="H5315" \w*: \w but a deceitful| strong="H4820" \w* witness [speaketh]{strong=“H6315” x-morph=“strongMorph: \sc Th\sc*8686”} \w lies| strong="H3577" \w*. 
\p
\v 26 \w In the fear| strong="H3374" \w* of the \sc Lord\sc* is \w strong| strong="H5797" \w* \w confidence| strong="H4009" \w*: \w and his children| strong="H1121" \w* \w shall have a place of refuge| strong="H4268" \w*. 
\v 27 \w The fear| strong="H3374" \w* of the \sc Lord\sc* is \w a fountain| strong="H4726" \w* \w of life| strong="H2416" \w*, [to depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8800”} \w from the snares| strong="H4170" \w* \w of death| strong="H4194" \w*. 
\v 28 \w In the multitude| strong="H7230" \w* \w of people| strong="H5971" \w* is [the king’s]{strong=“H4428”} \w honour| strong="H1927" \w*: \w but in the want| strong="H657" \w* \w of people| strong="H3816" \w* is \w the destruction| strong="H4288" \w* \w of the prince| strong="H7333" \w*. 
\v 29 He that is \w slow| strong="H750" \w* \w to wrath| strong="H639" \w* is \w of great| strong="H7227" \w* \w understanding| strong="H8394" \w*: but he that is \w hasty| strong="H7116" \w* \w of spirit| strong="H7307" \w* [exalteth]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8688”} \w folly| strong="H200" \w*.\f + \fr 14:29 \ft hasty…: Heb. short of spirit \f* 
\v 30 \w A sound| strong="H4832" \w* \w heart| strong="H3820" \w* is \w the life| strong="H2416" \w* \w of the flesh| strong="H1320" \w*: \w but envy| strong="H7068" \w* \w the rottenness| strong="H7538" \w* \w of the bones| strong="H6106" \w*. 
