\p
\v 25 \w The desire| strong="H8378" \w* \w of the slothful| strong="H6102" \w* [killeth]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8686”} [him; for his hands]{strong=“H3027”} [refuse]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8765”} [to labour]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”}. 
