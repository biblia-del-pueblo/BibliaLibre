\c 6
\p 
\v 1 \w My son| strong="H1121" \w*, [if thou be surety]{strong=“H6148” x-morph=“strongMorph: \sc Th\sc*8804”} \w for thy friend| strong="H7453" \w*, if [thou hast stricken]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy hand| strong="H3709" \w* [with a stranger]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”}, 
