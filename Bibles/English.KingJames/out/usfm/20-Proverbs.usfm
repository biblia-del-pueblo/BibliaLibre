\v 21 [Bind]{strong=“H7194” x-morph=“strongMorph: \sc Th\sc*8798”} \w them continually| strong="H8548" \w* \w upon thine heart| strong="H3820" \w*, and [tie]{strong=“H6029” x-morph=“strongMorph: \sc Th\sc*8798”} \w them about thy neck| strong="H1621" \w*. 
\v 22 [When thou goest]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8692”}, [it shall lead]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8686”} [thee; when thou sleepest]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8800”}, [it shall keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} thee; and when [thou awakest]{strong=“H6974” x-morph=“strongMorph: \sc Th\sc*8689”}, [it shall talk]{strong=“H7878” x-morph=“strongMorph: \sc Th\sc*8799”} with thee. 
\v 23 \w For the commandment| strong="H4687" \w* is \w a lamp| strong="H5216" \w*; \w and the law| strong="H8451" \w* is \w light| strong="H216" \w*; \w and reproofs| strong="H8433" \w* \w of instruction| strong="H4148" \w* are \w the way| strong="H1870" \w* \w of life| strong="H2416" \w*:\f + \fr 6:23 \ft lamp: or, candle \f* 
\v 24 [To keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w thee from the evil| strong="H7451" \w* \w woman| strong="H802" \w*, \w from the flattery| strong="H2513" \w* \w of the tongue| strong="H3956" \w* \w of a strange woman| strong="H5237" \w*.\f + \fr 6:24 \ft of the…: or, of the strange tongue \f* 
\v 25 [Lust]{strong=“H2530” x-morph=“strongMorph: \sc Th\sc*8799”} \w not after her beauty| strong="H3308" \w* \w in thine heart| strong="H3824" \w*; [neither let her take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee with her eyelids| strong="H6079" \w*. 
\v 26 \w For by means of| strong="H1157" \w* [a whorish]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”} \w woman| strong="H802" \w* a man is brought \w to a piece| strong="H3603" \w* \w of bread| strong="H3899" \w*: [and the adulteress]{strong=“H376 H802”} [will hunt]{strong=“H6679” x-morph=“strongMorph: \sc Th\sc*8799”} \w for the precious| strong="H3368" \w* \w life| strong="H5315" \w*.\f + \fr 6:26 \ft the adulteress: Heb. the woman of a man, or, a man’s wife \f* 
\v 27 \w Can a man| strong="H376" \w* [take]{strong=“H2846” x-morph=“strongMorph: \sc Th\sc*8799”} \w fire| strong="H784" \w* \w in his bosom| strong="H2436" \w*, \w and his clothes| strong="H899" \w* [not be burned]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8735”}? 
\v 28 \w Can one| strong="H376" \w* [go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8762”} \w upon hot coals| strong="H1513" \w*, \w and his feet| strong="H7272" \w* [not be burned]{strong=“H3554” x-morph=“strongMorph: \sc Th\sc*8735”}? 
\v 29 [So he that goeth in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [to his neighbour’s]{strong=“H7453”} \w wife| strong="H802" \w*; [whosoever toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8802”} [her shall not be innocent]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 30 Men [do not despise]{strong=“H936” x-morph=“strongMorph: \sc Th\sc*8799”} \w a thief| strong="H1590" \w*, [if he steal]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8799”} [to satisfy]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8763”} \w his soul| strong="H5315" \w* [when he is hungry]{strong=“H7456” x-morph=“strongMorph: \sc Th\sc*8799”}; 
\v 31 But if [he be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8738”}, [he shall restore]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w sevenfold| strong="H7659" \w*; [he shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the substance| strong="H1952" \w* \w of his house| strong="H1004" \w*. 
\v 32 But [whoso committeth adultery]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8802”} \w with a woman| strong="H802" \w* \w lacketh| strong="H2638" \w* \w understanding| strong="H3820" \w*: he that [doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [it destroyeth]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8688”} \w his own soul| strong="H5315" \w*.\f + \fr 6:32 \ft understanding: Heb. heart \f* 
\v 33 \w A wound| strong="H5061" \w* \w and dishonour| strong="H7036" \w* [shall he get]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”}; \w and his reproach| strong="H2781" \w* [shall not be wiped away]{strong=“H4229” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 34 \w For jealousy| strong="H7068" \w* is \w the rage| strong="H2534" \w* \w of a man| strong="H1397" \w*: [therefore he will not spare]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the day| strong="H3117" \w* \w of vengeance| strong="H5359" \w*. 
\v 35 [He will not regard]{strong=“H6440 H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w any ransom| strong="H3724" \w*; [neither will he rest content]{strong=“H14” x-morph=“strongMorph: \sc Th\sc*8799”}, [though thou givest many]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} \w gifts| strong="H7810" \w*.\f + \fr 6:35 \ft He will…: Heb. He will not accept the face of any ransom \f*
\c 7
\p 
\v 1 \w My son| strong="H1121" \w*, [keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8798”} \w my words| strong="H561" \w*, [and lay up]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8799”} \w my commandments| strong="H4687" \w* with thee. 
\v 2 [Keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8798”} \w my commandments| strong="H4687" \w*, [and live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8798”}; \w and my law| strong="H8451" \w* \w as the apple| strong="H380" \w* \w of thine eye| strong="H5869" \w*. 
\v 3 [Bind]{strong=“H7194” x-morph=“strongMorph: \sc Th\sc*8798”} \w them upon thy fingers| strong="H676" \w*, [write]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8798”} \w them upon the table| strong="H3871" \w* \w of thine heart| strong="H3820" \w*. 
\v 4 [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto wisdom| strong="H2451" \w*, Thou art \w my sister| strong="H269" \w*; [and call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w understanding| strong="H998" \w* thy \w kinswoman| strong="H4129" \w*: 
