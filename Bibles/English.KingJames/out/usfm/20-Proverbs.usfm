\v 4 [Give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w not sleep| strong="H8142" \w* \w to thine eyes| strong="H5869" \w*, \w nor slumber| strong="H8572" \w* \w to thine eyelids| strong="H6079" \w*. 
\v 5 [Deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8734”} \w thyself as a roe| strong="H6643" \w* \w from the hand| strong="H3027" \w* of the hunter, \w and as a bird| strong="H6833" \w* \w from the hand| strong="H3027" \w* \w of the fowler| strong="H3353" \w*. 
\p
\v 6 [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} \w to the ant| strong="H5244" \w*, \w thou sluggard| strong="H6102" \w*; [consider]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w her ways| strong="H1870" \w*, [and be wise]{strong=“H2449” x-morph=“strongMorph: \sc Th\sc*8798”}: 
