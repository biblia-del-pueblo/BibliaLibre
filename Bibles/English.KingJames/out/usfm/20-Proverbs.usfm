\v 22 \w A merry| strong="H8056" \w* \w heart| strong="H3820" \w* [doeth good]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8686”} like \w a medicine| strong="H1456" \w*: \w but a broken| strong="H5218" \w* \w spirit| strong="H7307" \w* [drieth]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8762”} \w the bones| strong="H1634" \w*.\f + \fr 17:22 \ft like: or, to \f* 
