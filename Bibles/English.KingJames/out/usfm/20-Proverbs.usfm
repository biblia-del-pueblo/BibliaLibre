\v 17 [I love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8799”} [them that love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} [me; and those that seek me early]{strong=“H7836” x-morph=“strongMorph: \sc Th\sc*8764”} [shall find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} me. 
\v 18 \w Riches| strong="H6239" \w* \w and honour| strong="H3519" \w* are with me; yea, \w durable| strong="H6276" \w* \w riches| strong="H1952" \w* \w and righteousness| strong="H6666" \w*. 
\v 19 \w My fruit| strong="H6529" \w* is \w better| strong="H2896" \w* \w than gold| strong="H2742" \w*, [yea, than fine gold]{strong=“H6337”}; \w and my revenue| strong="H8393" \w* [than choice]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8737”} \w silver| strong="H3701" \w*. 
\v 20 [I lead]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8762”} \w in the way| strong="H734" \w* \w of righteousness| strong="H6666" \w*, \w in the midst| strong="H8432" \w* \w of the paths| strong="H5410" \w* \w of judgment| strong="H4941" \w*:\f + \fr 8:20 \ft lead: or, walk \f* 
\v 21 [That I may cause those that love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} [me to inherit]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8687”} \w substance| strong="H3426" \w*; [and I will fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8762”} \w their treasures| strong="H214" \w*. 
\p
\v 22 The \sc Lord\sc* [possessed]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8804”} \w me in the beginning| strong="H7225" \w* \w of his way| strong="H1870" \w*, \w before| strong="H6924" \w* \w his works| strong="H4659" \w* of old. 
\v 23 [I was set up]{strong=“H5258” x-morph=“strongMorph: \sc Th\sc*8738”} \w from everlasting| strong="H5769" \w*, \w from the beginning| strong="H7218" \w*, \w or ever| strong="H6924" \w* \w the earth| strong="H776" \w* was. 
\v 24 When there were \w no depths| strong="H8415" \w*, [I was brought forth]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8797”}; when there were \w no fountains| strong="H4599" \w* [abounding]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8737”} \w with water| strong="H4325" \w*. 
\v 25 \w Before the mountains| strong="H2022" \w* [were settled]{strong=“H2883” x-morph=“strongMorph: \sc Th\sc*8717”}, \w before| strong="H6440" \w* \w the hills| strong="H1389" \w* [was I brought forth]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8797”}: 
\v 26 [While as yet he had not made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w the earth| strong="H776" \w*, \w nor the fields| strong="H2351" \w*, \w nor the highest part| strong="H7218" \w* \w of the dust| strong="H6083" \w* \w of the world| strong="H8398" \w*.\f + \fr 8:26 \ft fields: or, open places \f* \f + \fr 8:26 \ft the highest…: or, the chief part \f* 
\v 27 [When he prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8687”} \w the heavens| strong="H8064" \w*, I was [there: when he set]{strong=“H2710” x-morph=“strongMorph: \sc Th\sc*8800”} \w a compass| strong="H2329" \w* \w upon the face| strong="H6440" \w* \w of the depth| strong="H8415" \w*:\f + \fr 8:27 \ft a compass: or, a circle \f* 
