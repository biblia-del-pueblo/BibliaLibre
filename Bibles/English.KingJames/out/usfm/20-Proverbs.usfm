\v 29 [When he gave]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w to the sea| strong="H3220" \w* \w his decree| strong="H2706" \w*, \w that the waters| strong="H4325" \w* [should not pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w his commandment| strong="H6310" \w*: [when he appointed]{strong=“H2710” x-morph=“strongMorph: \sc Th\sc*8800”} \w the foundations| strong="H4144" \w* \w of the earth| strong="H776" \w*: 
\v 30 \w Then I was by him| strong="H681" \w*, as \w one brought up| strong="H525" \w* with him: [and I was daily]{strong=“H3117 H3117”} his \w delight| strong="H8191" \w*, [rejoicing]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8764”} \w always| strong="H6256" \w* \w before| strong="H6440" \w* him; 
\v 31 [Rejoicing]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8764”} \w in the habitable part| strong="H8398" \w* \w of his earth| strong="H776" \w*; \w and my delights| strong="H8191" \w* were \w with the sons| strong="H1121" \w* \w of men| strong="H120" \w*. 
\p
\v 32 [Now therefore hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me, O ye children]{strong=“H1121”}: \w for blessed| strong="H835" \w* are they that [keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w my ways| strong="H1870" \w*. 
\v 33 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w instruction| strong="H4148" \w*, [and be wise]{strong=“H2449” x-morph=“strongMorph: \sc Th\sc*8798”}, [and refuse]{strong=“H6544” x-morph=“strongMorph: \sc Th\sc*8799”} it not. 
\v 34 \w Blessed| strong="H835" \w* is \w the man| strong="H120" \w* [that heareth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} [me, watching]{strong=“H8245” x-morph=“strongMorph: \sc Th\sc*8800”} [daily]{strong=“H3117 H3117”} \w at my gates| strong="H1817" \w*, [waiting]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w at the posts| strong="H4201" \w* \w of my doors| strong="H6607" \w*. 
\v 35 [For whoso findeth]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8802”} [me findeth]{strong=“H4672 H4672” x-morph=“strongMorph: \sc Th\sc*8802 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8804”} \w life| strong="H2416" \w*, [and shall obtain]{strong=“H6329” x-morph=“strongMorph: \sc Th\sc*8686”} \w favour| strong="H7522" \w* of the \sc Lord\sc*.\f + \fr 8:35 \ft obtain: Heb. bring forth \f* 
\v 36 [But he that sinneth]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8802”} [against me wrongeth]{strong=“H2554” x-morph=“strongMorph: \sc Th\sc*8802”} \w his own soul| strong="H5315" \w*: [all they that hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8764”} [me love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} \w death| strong="H4194" \w*.
\c 9
\p 
\v 1 \w Wisdom| strong="H2454" \w* [hath builded]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w her house| strong="H1004" \w*, [she hath hewn out]{strong=“H2672” x-morph=“strongMorph: \sc Th\sc*8804”} \w her seven| strong="H7651" \w* \w pillars| strong="H5982" \w*: 
\v 2 [She hath killed]{strong=“H2873” x-morph=“strongMorph: \sc Th\sc*8804”} \w her beasts| strong="H2874" \w*; [she hath mingled]{strong=“H4537” x-morph=“strongMorph: \sc Th\sc*8804”} \w her wine| strong="H3196" \w*; [she hath also furnished]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8804”} \w her table| strong="H7979" \w*.\f + \fr 9:2 \ft her beasts: Heb. her killing \f* 
\v 3 [She hath sent forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w her maidens| strong="H5291" \w*: [she crieth]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon| strong="H1610" \w* \w the highest places| strong="H4791" \w* \w of the city| strong="H7176" \w*, 
\v 4 Whoso is \w simple| strong="H6612" \w*, [let him turn in]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8799”} hither: as for \w him that wanteth| strong="H2638" \w* \w understanding| strong="H3820" \w*, [she saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} to him, 
\v 5 [Come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [eat]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8798”} \w of my bread| strong="H3899" \w*, [and drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8798”} \w of the wine| strong="H3196" \w* which [I have mingled]{strong=“H4537” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 6 [Forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8798”} \w the foolish| strong="H6612" \w*, [and live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8798”}; [and go]{strong=“H833” x-morph=“strongMorph: \sc Th\sc*8798”} \w in the way| strong="H1870" \w* \w of understanding| strong="H998" \w*. 
\v 7 [He that reproveth]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8802”} [a scorner]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8801”} [getteth]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8802”} \w to himself shame| strong="H7036" \w*: [and he that rebuketh]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8688”} \w a wicked| strong="H7563" \w* man getteth \w himself a blot| strong="H3971" \w*. 
\v 8 [Reprove]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”} [not a scorner]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8801”}, [lest he hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8799”} [thee: rebuke]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8685”} \w a wise man| strong="H2450" \w*, [and he will love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8799”} thee. 
\v 9 [Give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} instruction \w to a wise| strong="H2450" \w* man, [and he will be yet wiser]{strong=“H2449” x-morph=“strongMorph: \sc Th\sc*8799”}: [teach]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8685”} \w a just| strong="H6662" \w* man, [and he will increase]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w in learning| strong="H3948" \w*. 
\v 10 \w The fear| strong="H3374" \w* of the \sc Lord\sc* is \w the beginning| strong="H8462" \w* \w of wisdom| strong="H2451" \w*: \w and the knowledge| strong="H1847" \w* \w of the holy| strong="H6918" \w* is \w understanding| strong="H998" \w*. 
\v 11 \w For by me thy days| strong="H3117" \w* [shall be multiplied]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the years| strong="H8141" \w* \w of thy life| strong="H2416" \w* [shall be increased]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 12 [If thou be wise]{strong=“H2449” x-morph=“strongMorph: \sc Th\sc*8804”}, [thou shalt be wise]{strong=“H2449” x-morph=“strongMorph: \sc Th\sc*8804”} for thyself: but if [thou scornest]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8804”}, [thou alone shalt bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\p
\v 13 \w A foolish| strong="H3687" \w* \w woman| strong="H802" \w* is [clamorous]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8802”}: she is \w simple| strong="H6615" \w*, \w and| strong="H1077" \w* [knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w nothing| strong="H4100" \w*. 
\v 14 [For she sitteth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w at the door| strong="H6607" \w* \w of her house| strong="H1004" \w*, \w on a seat| strong="H3678" \w* \w in the high places| strong="H4791" \w* \w of the city| strong="H7176" \w*, 
\v 15 [To call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8800”} [passengers]{strong=“H1870 H5674” x-morph=“strongMorph: \sc Th\sc*8802”} [who go right]{strong=“H3474” x-morph=“strongMorph: \sc Th\sc*8764”} \w on their ways| strong="H734" \w*: 
\v 16 Whoso is \w simple| strong="H6612" \w*, [let him turn in]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8799”} hither: and as for \w him that wanteth| strong="H2638" \w* \w understanding| strong="H3820" \w*, [she saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} to him, 
\v 17 [Stolen]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8803”} \w waters| strong="H4325" \w* [are sweet]{strong=“H4985” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and bread| strong="H3899" \w* eaten \w in secret| strong="H5643" \w* [is pleasant]{strong=“H5276” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 9:17 \ft eaten…: Heb. of secrecies \f* 
\v 18 [But he knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w not that the dead| strong="H7496" \w* are there; and that [her guests]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8803”} are \w in the depths| strong="H6012" \w* \w of hell| strong="H7585" \w*.
\c 10
\p 
\v 1 \w The proverbs| strong="H4912" \w* \w of Solomon| strong="H8010" \w*. \w A wise| strong="H2450" \w* \w son| strong="H1121" \w* [maketh a glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8762”} \w father| strong="H1" \w*: \w but a foolish| strong="H3684" \w* \w son| strong="H1121" \w* is \w the heaviness| strong="H8424" \w* \w of his mother| strong="H517" \w*. 
\p
\v 2 \w Treasures| strong="H214" \w* \w of wickedness| strong="H7562" \w* [profit]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8686”} [nothing: but righteousness]{strong=“H6666”} [delivereth ]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w from death| strong="H4194" \w*. 
\v 3 The \sc Lord\sc* \w will not suffer| strong="H7456" \w* \w the soul| strong="H5315" \w* \w of the righteous| strong="H6662" \w* [to famish]{strong=“H7456” x-morph=“strongMorph: \sc Th\sc*8686”}: [but he casteth away]{strong=“H1920” x-morph=“strongMorph: \sc Th\sc*8799”} \w the substance| strong="H1942" \w* \w of the wicked| strong="H7563" \w*.\f + \fr 10:3 \ft the substance…: or, the wicked for their wickedness \f* 
\v 4 [He becometh poor]{strong=“H7326” x-morph=“strongMorph: \sc Th\sc*8802”} [that dealeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} with \w a slack| strong="H7423" \w* \w hand| strong="H3709" \w*: \w but the hand| strong="H3027" \w* \w of the diligent| strong="H2742" \w* [maketh rich]{strong=“H6238” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 5 [He that gathereth]{strong=“H103” x-morph=“strongMorph: \sc Th\sc*8802”} \w in summer| strong="H7019" \w* is [a wise]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8688”} \w son| strong="H1121" \w*: but [he that sleepeth]{strong=“H7290” x-morph=“strongMorph: \sc Th\sc*8737”} \w in harvest| strong="H7105" \w* is \w a son| strong="H1121" \w* [that causeth shame]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 6 \w Blessings| strong="H1293" \w* are \w upon the head| strong="H7218" \w* \w of the just| strong="H6662" \w*: \w but violence| strong="H2555" \w* [covereth]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w the mouth| strong="H6310" \w* \w of the wicked| strong="H7563" \w*. 
\v 7 \w The memory| strong="H2143" \w* \w of the just| strong="H6662" \w* is \w blessed| strong="H1293" \w*: \w but the name| strong="H8034" \w* \w of the wicked| strong="H7563" \w* [shall rot]{strong=“H7537” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 8 \w The wise| strong="H2450" \w* \w in heart| strong="H3820" \w* [will receive]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w commandments| strong="H4687" \w*: \w but a prating| strong="H8193" \w* \w fool| strong="H191" \w* [shall fall]{strong=“H3832” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 10:8 \ft a prating…: Heb. a fool of lips \f* \f + \fr 10:8 \ft fall: Heb. be beaten \f* 
\v 9 [He that walketh]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w uprightly| strong="H8537" \w* [walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w surely| strong="H983" \w*: [but he that perverteth]{strong=“H6140” x-morph=“strongMorph: \sc Th\sc*8764”} \w his ways| strong="H1870" \w* [shall be known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 10 [He that winketh]{strong=“H7169” x-morph=“strongMorph: \sc Th\sc*8802”} \w with the eye| strong="H5869" \w* [causeth ]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w sorrow| strong="H6094" \w*: \w but a prating| strong="H8193" \w* \w fool| strong="H191" \w* [shall fall]{strong=“H3832” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 10:10 \ft fall: Heb. be beaten \f* 
\v 11 \w The mouth| strong="H6310" \w* \w of a righteous| strong="H6662" \w* man is \w a well| strong="H4726" \w* \w of life| strong="H2416" \w*: \w but violence| strong="H2555" \w* [covereth]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w the mouth| strong="H6310" \w* \w of the wicked| strong="H7563" \w*. 
\v 12 \w Hatred| strong="H8135" \w* [stirreth up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8787”} \w strifes| strong="H4090" \w*: \w but love| strong="H160" \w* [covereth]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w all sins| strong="H6588" \w*. 
\v 13 \w In the lips| strong="H8193" \w* [of him that hath understanding]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8737”} \w wisdom| strong="H2451" \w* [is found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”}: \w but a rod| strong="H7626" \w* is \w for the back| strong="H1460" \w* \w of him that is void| strong="H2638" \w* \w of understanding| strong="H3820" \w*.\f + \fr 10:13 \ft of understanding: Heb. of heart \f* 
\v 14 \w Wise| strong="H2450" \w* men [lay up]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8799”} \w knowledge| strong="H1847" \w*: \w but the mouth| strong="H6310" \w* \w of the foolish| strong="H191" \w* is \w near| strong="H7138" \w* \w destruction| strong="H4288" \w*. 
\v 15 [The rich man’s]{strong=“H6223”} \w wealth| strong="H1952" \w* is \w his strong| strong="H5797" \w* \w city| strong="H7151" \w*: \w the destruction| strong="H4288" \w* \w of the poor| strong="H1800" \w* is \w their poverty| strong="H7389" \w*. 
\v 16 \w The labour| strong="H6468" \w* \w of the righteous| strong="H6662" \w* tendeth \w to life| strong="H2416" \w*: \w the fruit| strong="H8393" \w* \w of the wicked| strong="H7563" \w* \w to sin| strong="H2403" \w*. 
\v 17 He is in \w the way| strong="H734" \w* \w of life| strong="H2416" \w* [that keepeth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w instruction| strong="H4148" \w*: [but he that refuseth]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8802”} \w reproof| strong="H8433" \w* [erreth]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8688”}.\f + \fr 10:17 \ft erreth: or, causeth to err \f* 
\v 18 [He that hideth]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8764”} \w hatred| strong="H8135" \w* with \w lying| strong="H8267" \w* \w lips| strong="H8193" \w*, [and he that uttereth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8688”} \w a slander| strong="H1681" \w*, is \w a fool| strong="H3684" \w*. 
\v 19 \w In the multitude| strong="H7230" \w* \w of words| strong="H1697" \w* [there wanteth]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8799”} \w not sin| strong="H6588" \w*: [but he that refraineth]{strong=“H2820” x-morph=“strongMorph: \sc Th\sc*8802”} \w his lips| strong="H8193" \w* is [wise]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\p
\v 20 \w The tongue| strong="H3956" \w* \w of the just| strong="H6662" \w* is as [choice]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8737”} \w silver| strong="H3701" \w*: \w the heart| strong="H3820" \w* \w of the wicked| strong="H7563" \w* is \w little worth| strong="H4592" \w*. 
\v 21 \w The lips| strong="H8193" \w* \w of the righteous| strong="H6662" \w* [feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} \w many| strong="H7227" \w*: \w but fools| strong="H191" \w* [die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w for want| strong="H2638" \w* \w of wisdom| strong="H3820" \w*.\f + \fr 10:21 \ft of wisdom: Heb. of heart \f* 
\v 22 \w The blessing| strong="H1293" \w* of the \sc Lord\sc*, [it maketh rich]{strong=“H6238” x-morph=“strongMorph: \sc Th\sc*8686”}, [and he addeth]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w no sorrow| strong="H6089" \w* with it. 
\v 23 It is \w as sport| strong="H7814" \w* \w to a fool| strong="H3684" \w* [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w mischief| strong="H2154" \w*: \w but a man| strong="H376" \w* \w of understanding| strong="H8394" \w* \w hath wisdom| strong="H2451" \w*. 
\p
\v 24 \w The fear| strong="H4034" \w* \w of the wicked| strong="H7563" \w*, [it shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [upon him: but the desire]{strong=“H8378”} \w of the righteous| strong="H6662" \w* [shall be granted]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 25 \w As the whirlwind| strong="H5492" \w* [passeth]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8800”}, so is \w the wicked| strong="H7563" \w* no more: \w but the righteous| strong="H6662" \w* is \w an everlasting| strong="H5769" \w* \w foundation| strong="H3247" \w*. 
\v 26 \w As vinegar| strong="H2558" \w* \w to the teeth| strong="H8127" \w*, \w and as smoke| strong="H6227" \w* \w to the eyes| strong="H5869" \w*, so is \w the sluggard| strong="H6102" \w* [to them that send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8802”} him. 
\p
\v 27 \w The fear| strong="H3374" \w* of the \sc Lord\sc* [prolongeth]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w days| strong="H3117" \w*: \w but the years| strong="H8141" \w* \w of the wicked| strong="H7563" \w* [shall be shortened]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 10:27 \ft prolongeth: Heb. addeth \f* 
\v 28 \w The hope| strong="H8431" \w* \w of the righteous| strong="H6662" \w* shall be \w gladness| strong="H8057" \w*: \w but the expectation| strong="H8615" \w* \w of the wicked| strong="H7563" \w* [shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 29 \w The way| strong="H1870" \w* of the \sc Lord\sc* is \w strength| strong="H4581" \w* \w to the upright| strong="H8537" \w*: \w but destruction| strong="H4288" \w* shall be [to the workers]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w of iniquity| strong="H205" \w*. 
\v 30 \w The righteous| strong="H6662" \w* \w shall never| strong="H5769" \w* [be removed]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8735”}: \w but the wicked| strong="H7563" \w* [shall not inhabit]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} \w the earth| strong="H776" \w*. 
\p
\v 31 \w The mouth| strong="H6310" \w* \w of the just| strong="H6662" \w* [bringeth forth]{strong=“H5107” x-morph=“strongMorph: \sc Th\sc*8799”} \w wisdom| strong="H2451" \w*: \w but the froward| strong="H8419" \w* \w tongue| strong="H3956" \w* [shall be cut out]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 32 \w The lips| strong="H8193" \w* \w of the righteous| strong="H6662" \w* [know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w what is acceptable| strong="H7522" \w*: \w but the mouth| strong="H6310" \w* \w of the wicked| strong="H7563" \w* speaketh \w frowardness| strong="H8419" \w*.\f + \fr 10:32 \ft frowardness: Heb. frowardnesses \f*
\c 11
\p 
\v 1 \w A false| strong="H4820" \w* \w balance| strong="H3976" \w* is \w abomination| strong="H8441" \w* to the \sc Lord\sc*: \w but a just| strong="H8003" \w* \w weight| strong="H68" \w* is \w his delight| strong="H7522" \w*.\f + \fr 11:1 \ft A false…: Heb. Balances of deceit \f* \f + \fr 11:1 \ft just…: Heb. perfect stone \f* 
\v 2 When \w pride| strong="H2087" \w* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, [then cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w shame| strong="H7036" \w*: [but with the lowly]{strong=“H6800” x-morph=“strongMorph: \sc Th\sc*8803”} is \w wisdom| strong="H2451" \w*. 
\v 3 \w The integrity| strong="H8538" \w* \w of the upright| strong="H3477" \w* [shall guide]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8686”} [them: but the perverseness]{strong=“H5558”} [of transgressors]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”} [shall destroy]{strong=“H7703 H7703” x-morph=“strongMorph: \sc Th\sc*8804 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8799”} them. 
\v 4 \w Riches| strong="H1952" \w* [profit]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8686”} \w not in the day| strong="H3117" \w* \w of wrath| strong="H5678" \w*: \w but righteousness| strong="H6666" \w* [delivereth]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w from death| strong="H4194" \w*. 
\p
\v 5 \w The righteousness| strong="H6666" \w* \w of the perfect| strong="H8549" \w* [shall direct]{strong=“H3474” x-morph=“strongMorph: \sc Th\sc*8762”} \w his way| strong="H1870" \w*: \w but the wicked| strong="H7563" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w by his own wickedness| strong="H7564" \w*.\f + \fr 11:5 \ft direct: Heb. rectify \f* 
