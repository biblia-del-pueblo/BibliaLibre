\p
\v 12 \w A naughty| strong="H1100" \w* \w person| strong="H120" \w*, \w a wicked| strong="H205" \w* \w man| strong="H376" \w*, [walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w with a froward| strong="H6143" \w* \w mouth| strong="H6310" \w*. 
