\c 22
\p 
\v 1 A good \w name| strong="H8034" \w* is [rather to be chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8737”} \w than great| strong="H7227" \w* \w riches| strong="H6239" \w*, and \w loving| strong="H2896" \w* \w favour| strong="H2580" \w* \w rather than silver| strong="H3701" \w* \w and gold| strong="H2091" \w*.\f + \fr 22:1 \ft loving…: or, favour is better than, etc \f* 
\v 2 \w The rich| strong="H6223" \w* [and poor]{strong=“H7326” x-morph=“strongMorph: \sc Th\sc*8802”} [meet together]{strong=“H6298” x-morph=“strongMorph: \sc Th\sc*8738”}: the \sc Lord\sc* is [the maker]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} of them all. 
\v 3 \w A prudent| strong="H6175" \w* man [foreseeth ]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the evil| strong="H7451" \w*, [and hideth]{strong=“H5641 H5641” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8738”} [himself: but the simple]{strong=“H6612”} [pass on]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”}, [and are punished]{strong=“H6064” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 4 \w By| strong="H6118" \w* \w humility| strong="H6038" \w* and \w the fear| strong="H3374" \w* of the \sc Lord\sc* are \w riches| strong="H6239" \w*, \w and honour| strong="H3519" \w*, \w and life| strong="H2416" \w*.\f + \fr 22:4 \ft By…: or, The reward of humility, etc \f* 
\v 5 \w Thorns| strong="H6791" \w* and \w snares| strong="H6341" \w* are \w in the way| strong="H1870" \w* \w of the froward| strong="H6141" \w*: [he that doth keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w his soul| strong="H5315" \w* [shall be far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8799”} from them. 
\v 6 [Train up]{strong=“H2596” x-morph=“strongMorph: \sc Th\sc*8798”} \w a child| strong="H5288" \w* \w in the way| strong="H1870" \w* \w he should go| strong="H6310" \w*: [and when he is old]{strong=“H2204” x-morph=“strongMorph: \sc Th\sc*8686”}, [he will not depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8799”} from it.\f + \fr 22:6 \ft Train…: or, Catechise \f* \f + \fr 22:6 \ft in…: Heb. in his way \f* 
\v 7 \w The rich| strong="H6223" \w* [ruleth]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8799”} [over the poor]{strong=“H7326” x-morph=“strongMorph: \sc Th\sc*8802”}, [and the borrower]{strong=“H3867” x-morph=“strongMorph: \sc Th\sc*8801”} is \w servant| strong="H5650" \w* [to the lender]{strong=“H3867 H376” x-morph=“strongMorph: \sc Th\sc*8688”}.\f + \fr 22:7 \ft the lender: Heb. the man that lendeth \f* 
\v 8 [He that soweth]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8802”} \w iniquity| strong="H5766" \w* [shall reap]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8799”} \w vanity| strong="H205" \w*: \w and the rod| strong="H7626" \w* \w of his anger| strong="H5678" \w* [shall fail]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 22:8 \ft the rod…: or, with the rod of his anger he shall be consumed \f* 
\v 9 \w He that hath a bountiful| strong="H2896" \w* \w eye| strong="H5869" \w* [shall be blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8792”}; [for he giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w of his bread| strong="H3899" \w* \w to the poor| strong="H1800" \w*.\f + \fr 22:9 \ft He that…: Heb. Good of eye \f* 
\v 10 [Cast out]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8763”} [the scorner]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8801”}, \w and contention| strong="H4066" \w* [shall go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”}; [yea, strife]{strong=“H1779”} \w and reproach| strong="H7036" \w* [shall cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 11 [He that loveth]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} [pureness]{strong=“H2889 H2890” x-morph=“strongMorph: \sc Th\sc*8675”} \w of heart| strong="H3820" \w*, for \w the grace| strong="H2580" \w* \w of his lips| strong="H8193" \w* \w the king| strong="H4428" \w* shall be \w his friend| strong="H7453" \w*.\f + \fr 22:11 \ft for…: or, and hath grace in his lips \f* 
\v 12 \w The eyes| strong="H5869" \w* of the \sc Lord\sc* [preserve]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8804”} \w knowledge| strong="H1847" \w*, [and he overthroweth]{strong=“H5557” x-morph=“strongMorph: \sc Th\sc*8762”} \w the words| strong="H1697" \w* [of the transgressor]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 22:12 \ft the words: or, the matters \f* 
\v 13 \w The slothful| strong="H6102" \w* man [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, There is \w a lion| strong="H738" \w* \w without| strong="H2351" \w*, [I shall be slain]{strong=“H7523” x-morph=“strongMorph: \sc Th\sc*8735”} \w in| strong="H8432" \w* \w the streets| strong="H7339" \w*. 
\v 14 \w The mouth| strong="H6310" \w* [of strange women]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} is \w a deep| strong="H6013" \w* \w pit| strong="H7745" \w*: [he that is abhorred]{strong=“H2194” x-morph=“strongMorph: \sc Th\sc*8803”} of the \sc Lord\sc* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} therein. 
\v 15 \w Foolishness| strong="H200" \w* is [bound]{strong=“H7194” x-morph=“strongMorph: \sc Th\sc*8803”} \w in the heart| strong="H3820" \w* \w of a child| strong="H5288" \w*; but \w the rod| strong="H7626" \w* \w of correction| strong="H4148" \w* [shall drive it far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8686”} from him. 
\v 16 [He that oppresseth]{strong=“H6231” x-morph=“strongMorph: \sc Th\sc*8802”} \w the poor| strong="H1800" \w* [to increase]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8687”} his riches, and [he that giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the rich| strong="H6223" \w*, shall surely come \w to want| strong="H4270" \w*. 
\p
\v 17 [Bow down]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8685”} \w thine ear| strong="H241" \w*, [and hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the words| strong="H1697" \w* \w of the wise| strong="H2450" \w*, [and apply]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w thine heart| strong="H3820" \w* \w unto my knowledge| strong="H1847" \w*. 
\v 18 For it is \w a pleasant thing| strong="H5273" \w* [if thou keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w them within| strong="H990" \w* [thee; they shall withal]{strong=“H3162”} [be fitted]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8735”} \w in thy lips| strong="H8193" \w*.\f + \fr 22:18 \ft within…: Heb. in thy belly \f* 
\v 19 \w That thy trust| strong="H4009" \w* may be in the \sc Lord\sc*, [I have made known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8689”} \w to thee this day| strong="H3117" \w*, even to thee.\f + \fr 22:19 \ft even…: or, trust thou also \f* 
\v 20 [Have not I written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8804”} \w to thee| strong="H8032" \w* \w excellent things| strong="H7991" \w* \w in counsels| strong="H4156" \w* \w and knowledge| strong="H1847" \w*, 
\v 21 [That I might make thee know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8687”} \w the certainty| strong="H7189" \w* \w of the words| strong="H561" \w* \w of truth| strong="H571" \w*; [that thou mightest answer]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} \w the words| strong="H561" \w* \w of truth| strong="H571" \w* [to them that send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8802”} unto thee?\f + \fr 22:21 \ft to them…: or, to those that send thee? \f* 
\p
\v 22 [Rob]{strong=“H1497” x-morph=“strongMorph: \sc Th\sc*8799”} \w not the poor| strong="H1800" \w*, because he is \w poor| strong="H1800" \w*: [neither oppress]{strong=“H1792” x-morph=“strongMorph: \sc Th\sc*8762”} \w the afflicted| strong="H6041" \w* \w in the gate| strong="H8179" \w*: 
\v 23 For the \sc Lord\sc* [will plead]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”} \w their cause| strong="H7379" \w*, [and spoil]{strong=“H6906” x-morph=“strongMorph: \sc Th\sc*8804”} \w the soul| strong="H5315" \w* [of those that spoiled]{strong=“H6906” x-morph=“strongMorph: \sc Th\sc*8802”} them. 
\p
\v 24 [Make no friendship]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8691”} \w with an angry| strong="H639" \w* \w man| strong="H1167" \w*; \w and with a furious| strong="H2534" \w* \w man| strong="H376" \w* [thou shalt not go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}: 
\v 25 [Lest thou learn]{strong=“H502” x-morph=“strongMorph: \sc Th\sc*8799”} \w his ways| strong="H734" \w*, [and get]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w a snare| strong="H4170" \w* \w to thy soul| strong="H5315" \w*. 
\p
\v 26 Be not thou one [of them that strike]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8802”} \w hands| strong="H3709" \w*, or [of them that are sureties]{strong=“H6148” x-morph=“strongMorph: \sc Th\sc*8802”} \w for debts| strong="H4859" \w*. 
\v 27 [If thou hast nothing to pay]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8763”}, [why should he take away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy bed| strong="H4904" \w* from under thee? 
\v 28 [Remove]{strong=“H5253” x-morph=“strongMorph: \sc Th\sc*8686”} \w not the ancient| strong="H5769" \w* \w landmark| strong="H1366" \w*, \w which thy fathers| strong="H1" \w* [have set]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 22:28 \ft landmark: or, bound \f* 
\v 29 [Seest]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8804”} \w thou a man| strong="H376" \w* \w diligent| strong="H4106" \w* \w in his business| strong="H4399" \w*? [he shall stand]{strong=“H3320” x-morph=“strongMorph: \sc Th\sc*8691”} \w before| strong="H6440" \w* \w kings| strong="H4428" \w*; [he shall not stand]{strong=“H3320” x-morph=“strongMorph: \sc Th\sc*8691”} \w before| strong="H6440" \w* \w mean| strong="H2823" \w* men.\f + \fr 22:29 \ft mean…: Heb. obscure men \f*
\c 23
\p 
\v 1 [When thou sittest]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} [to eat]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8800”} [with a ruler]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8802”}, [consider]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} [diligently]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8800”} what is \w before| strong="H6440" \w* thee: 
\v 2 [And put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w a knife| strong="H7915" \w* \w to thy throat| strong="H3930" \w*, if thou be \w a man given| strong="H1167" \w* \w to appetite| strong="H5315" \w*. 
\v 3 [Be not desirous]{strong=“H183” x-morph=“strongMorph: \sc Th\sc*8691”} \w of his dainties| strong="H4303" \w*: for they are \w deceitful| strong="H3577" \w* \w meat| strong="H3899" \w*. 
\p
\v 4 [Labour]{strong=“H3021” x-morph=“strongMorph: \sc Th\sc*8799”} [not to be rich]{strong=“H6238” x-morph=“strongMorph: \sc Th\sc*8687”}: [cease]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8798”} \w from thine own wisdom| strong="H998" \w*. 
\v 5 [Wilt thou set]{strong=“H5774 H5774” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8686”} \w thine eyes| strong="H5869" \w* upon that which is not? for riches [certainly]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w themselves wings| strong="H3671" \w*; [they fly away]{strong=“H5774 H5774” x-morph=“strongMorph: \sc Th\sc*8687 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8799”} \w as an eagle| strong="H5404" \w* \w toward heaven| strong="H8064" \w*.\f + \fr 23:5 \ft set…: Heb. cause thine eyes to fly upon \f* 
\p
\v 6 [Eat]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8799”} \w thou not the bread| strong="H3899" \w* of him that hath \w an evil| strong="H7451" \w* \w eye| strong="H5869" \w*, [neither desire]{strong=“H183” x-morph=“strongMorph: \sc Th\sc*8691”} \w thou his dainty meats| strong="H4303" \w*: 
\v 7 [For as he thinketh]{strong=“H8176” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his heart| strong="H5315" \w*, so is [he: Eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8798”} [and drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8798”}, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [he to thee; but his heart]{strong=“H3820”} is not with thee. 
\v 8 \w The morsel| strong="H6595" \w* which [thou hast eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} [shalt thou vomit up]{strong=“H6958” x-morph=“strongMorph: \sc Th\sc*8686”}, [and lose]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy sweet| strong="H5273" \w* \w words| strong="H1697" \w*. 
\v 9 [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w not in the ears| strong="H241" \w* \w of a fool| strong="H3684" \w*: [for he will despise]{strong=“H936” x-morph=“strongMorph: \sc Th\sc*8799”} \w the wisdom| strong="H7922" \w* \w of thy words| strong="H4405" \w*. 
\p
\v 10 [Remove]{strong=“H5253” x-morph=“strongMorph: \sc Th\sc*8686”} \w not the old| strong="H5769" \w* \w landmark| strong="H1366" \w*; [and enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w not into the fields| strong="H7704" \w* \w of the fatherless| strong="H3490" \w*:\f + \fr 23:10 \ft landmark: or, bound \f* 
\v 11 [For their redeemer]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”} is \w mighty| strong="H2389" \w*; [he shall plead]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”} \w their cause| strong="H7379" \w* with thee. 
\p
\v 12 [Apply]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8685”} \w thine heart| strong="H3820" \w* \w unto instruction| strong="H4148" \w*, \w and thine ears| strong="H241" \w* \w to the words| strong="H561" \w* \w of knowledge| strong="H1847" \w*. 
\v 13 [Withhold]{strong=“H4513” x-morph=“strongMorph: \sc Th\sc*8799”} \w not correction| strong="H4148" \w* \w from the child| strong="H5288" \w*: for if [thou beatest]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w him with the rod| strong="H7626" \w*, [he shall not die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 14 [Thou shalt beat]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w him with the rod| strong="H7626" \w*, [and shalt deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w his soul| strong="H5315" \w* \w from hell| strong="H7585" \w*. 
\v 15 \w My son| strong="H1121" \w*, \w if thine heart| strong="H3820" \w* [be wise]{strong=“H2449” x-morph=“strongMorph: \sc Th\sc*8804”}, \w my heart| strong="H3820" \w* [shall rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”}, \w even mine| strong="H589" \w*.\f + \fr 23:15 \ft even…: or, even I will rejoice \f* 
\v 16 [Yea, my reins]{strong=“H3629”} [shall rejoice]{strong=“H5937” x-morph=“strongMorph: \sc Th\sc*8799”}, \w when thy lips| strong="H8193" \w* [speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w right things| strong="H4339" \w*. 
\p
\v 17 \w Let not thine heart| strong="H3820" \w* [envy]{strong=“H7065” x-morph=“strongMorph: \sc Th\sc*8762”} \w sinners| strong="H2400" \w*: but be thou \w in the fear| strong="H3374" \w* of the \sc Lord\sc* \w all the day| strong="H3117" \w* long. 
\v 18 \w For surely there is| strong="H3426" \w* \w an end| strong="H319" \w*; \w and thine expectation| strong="H8615" \w* [shall not be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 23:18 \ft end: or, reward \f* 
\p
\v 19 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [thou, my son]{strong=“H1121”}, [and be wise]{strong=“H2449” x-morph=“strongMorph: \sc Th\sc*8798”}, [and guide]{strong=“H833” x-morph=“strongMorph: \sc Th\sc*8761”} \w thine heart| strong="H3820" \w* \w in the way| strong="H1870" \w*. 
\v 20 [Be not among winebibbers]{strong=“H5433 H3196” x-morph=“strongMorph: \sc Th\sc*8802”}; [among riotous eaters]{strong=“H2151” x-morph=“strongMorph: \sc Th\sc*8802”} \w of flesh| strong="H1320" \w*:\f + \fr 23:20 \ft of flesh: Heb. of their flesh \f* 
\v 21 [For the drunkard]{strong=“H5433” x-morph=“strongMorph: \sc Th\sc*8802”} [and the glutton]{strong=“H2151” x-morph=“strongMorph: \sc Th\sc*8802”} [shall come to poverty]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8735”}: \w and drowsiness| strong="H5124" \w* [shall clothe]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8686”} a man \w with rags| strong="H7168" \w*. 
\v 22 [Hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto thy father| strong="H1" \w* [that begat]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, and despise]{strong=“H936” x-morph=“strongMorph: \sc Th\sc*8799”} \w not thy mother| strong="H517" \w* [when she is old]{strong=“H2204” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 23 [Buy]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8798”} \w the truth| strong="H571" \w*, [and sell]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8799”} it not; also \w wisdom| strong="H2451" \w*, \w and instruction| strong="H4148" \w*, \w and understanding| strong="H998" \w*. 
\v 24 \w The father| strong="H1" \w* \w of the righteous| strong="H6662" \w* \w shall greatly| strong="H1524" \w* [rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”}: [and he that begetteth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”} \w a wise| strong="H2450" \w* child [shall have joy]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} of him. 
\v 25 \w Thy father| strong="H1" \w* \w and thy mother| strong="H517" \w* [shall be glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”}, [and she that bare]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”} [thee shall rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 26 \w My son| strong="H1121" \w*, [give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w me thine heart| strong="H3820" \w*, \w and let thine eyes| strong="H5869" \w* [observe]{strong=“H5341 H7521” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8799”} \w my ways| strong="H1870" \w*. 
\v 27 [For a whore]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”} is \w a deep| strong="H6013" \w* \w ditch| strong="H7745" \w*; \w and a strange woman| strong="H5237" \w* is \w a narrow| strong="H6862" \w* \w pit| strong="H875" \w*. 
\v 28 [She also lieth in wait]{strong=“H693” x-morph=“strongMorph: \sc Th\sc*8799”} as for \w a prey| strong="H2863" \w*, [and increaseth]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [the transgressors]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”} \w among men| strong="H120" \w*.\f + \fr 23:28 \ft as for…: or, as a robber \f* 
\p
\v 29 \w Who hath woe| strong="H188" \w*? \w who hath sorrow| strong="H17" \w*? [who hath contentions]{strong=“H4066 H4079” x-morph=“strongMorph: \sc Th\sc*8675”}? \w who hath babbling| strong="H7879" \w*? \w who hath wounds| strong="H6482" \w* \w without cause| strong="H2600" \w*? \w who hath redness| strong="H2448" \w* \w of eyes| strong="H5869" \w*? 
\v 30 [They that tarry long]{strong=“H309” x-morph=“strongMorph: \sc Th\sc*8764”} \w at the wine| strong="H3196" \w*; [they that go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [to seek]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8800”} \w mixed wine| strong="H4469" \w*. 
\v 31 [Look]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w not thou upon the wine| strong="H3196" \w* [when it is red]{strong=“H119” x-morph=“strongMorph: \sc Th\sc*8691”}, [when it giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w his colour| strong="H5869" \w* [in the cup]{strong=“H3599 H3563” x-morph=“strongMorph: \sc Th\sc*8675”}, when [it moveth]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8691”} \w itself aright| strong="H4339" \w*. 
\v 32 \w At the last| strong="H319" \w* [it biteth]{strong=“H5391” x-morph=“strongMorph: \sc Th\sc*8799”} \w like a serpent| strong="H5175" \w*, [and stingeth]{strong=“H6567” x-morph=“strongMorph: \sc Th\sc*8686”} \w like an adder| strong="H6848" \w*.\f + \fr 23:32 \ft an…: or, a cockatrice \f* 
\v 33 \w Thine eyes| strong="H5869" \w* [shall behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [strange women]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”}, \w and thine heart| strong="H3820" \w* [shall utter]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w perverse things| strong="H8419" \w*. 
\v 34 [Yea, thou shalt be as he that lieth down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the midst| strong="H3820" \w* \w of the sea| strong="H3220" \w*, [or as he that lieth]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the top| strong="H7218" \w* \w of a mast| strong="H2260" \w*.\f + \fr 23:34 \ft the midst…: Heb. the heart of the sea \f* 
\v 35 [They have stricken]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} me, shalt thou say, and [I was not sick]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8804”}; [they have beaten]{strong=“H1986” x-morph=“strongMorph: \sc Th\sc*8804”} me, and [I felt]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} it [not: when shall I awake]{strong=“H6974” x-morph=“strongMorph: \sc Th\sc*8686”}? [I will seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} [it yet]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} again.\f + \fr 23:35 \ft I felt…: Heb. I knew it not \f*
\c 24
\p 
\v 1 [Be not thou envious]{strong=“H7065” x-morph=“strongMorph: \sc Th\sc*8762”} \w against evil| strong="H7451" \w* \w men| strong="H582" \w*, [neither desire]{strong=“H183” x-morph=“strongMorph: \sc Th\sc*8691”} to be with them. 
\v 2 \w For their heart| strong="H3820" \w* [studieth]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8799”} \w destruction| strong="H7701" \w*, \w and their lips| strong="H8193" \w* [talk]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w of mischief| strong="H5999" \w*. 
\p
\v 3 \w Through wisdom| strong="H2451" \w* \w is an house| strong="H1004" \w* [builded]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8735”}; \w and by understanding| strong="H8394" \w* [it is established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8709”}: 
\v 4 \w And by knowledge| strong="H1847" \w* \w shall the chambers| strong="H2315" \w* [be filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”} \w with all precious| strong="H3368" \w* \w and pleasant| strong="H5273" \w* \w riches| strong="H1952" \w*. 
\v 5 \w A wise| strong="H2450" \w* \w man| strong="H1397" \w* is \w strong| strong="H5797" \w*; [yea, a man]{strong=“H376”} \w of knowledge| strong="H1847" \w* [increaseth ]{strong=“H553” x-morph=“strongMorph: \sc Th\sc*8764”} \w strength| strong="H3581" \w*.\f + \fr 24:5 \ft is strong: Heb. is in strength \f* \f + \fr 24:5 \ft increaseth…: Heb. strengtheneth might \f* 
\v 6 \w For by wise counsel| strong="H8458" \w* [thou shalt make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy war| strong="H4421" \w*: \w and in multitude| strong="H7230" \w* [of counsellors]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8802”} there is \w safety| strong="H8668" \w*. 
\p
\v 7 \w Wisdom| strong="H2454" \w* is [too high]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8802”} \w for a fool| strong="H191" \w*: [he openeth]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} \w not his mouth| strong="H6310" \w* \w in the gate| strong="H8179" \w*. 
\v 8 [He that deviseth]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8764”} [to do evil]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8687”} [shall be called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w a mischievous| strong="H4209" \w* \w person| strong="H1167" \w*. 
\v 9 \w The thought| strong="H2154" \w* \w of foolishness| strong="H200" \w* is \w sin| strong="H2403" \w*: [and the scorner]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8801”} is \w an abomination| strong="H8441" \w* \w to men| strong="H120" \w*. 
\v 10 If [thou faint]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8694”} \w in the day| strong="H3117" \w* \w of adversity| strong="H6869" \w*, \w thy strength| strong="H3581" \w* is \w small| strong="H6862" \w*.\f + \fr 24:10 \ft small: Heb. narrow \f* 
\p
\v 11 [If thou forbear]{strong=“H2820” x-morph=“strongMorph: \sc Th\sc*8799”} [to deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} them that are [drawn]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8803”} \w unto death| strong="H4194" \w*, and those that are [ready]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8801”} \w to be slain| strong="H2027" \w*; 
\v 12 [If thou sayest]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Behold, we knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [it not; doth not he that pondereth]{strong=“H8505” x-morph=“strongMorph: \sc Th\sc*8802”} \w the heart| strong="H3826" \w* [consider ]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} it? [and he that keepeth]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8802”} \w thy soul| strong="H5315" \w*, doth not [he know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} it? and shall not [he render]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} to every \w man| strong="H120" \w* \w according to his works| strong="H6467" \w*? 
\p
\v 13 \w My son| strong="H1121" \w*, [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou honey| strong="H1706" \w*, because it is \w good| strong="H2896" \w*; \w and the honeycomb| strong="H5317" \w*, which is \w sweet| strong="H4966" \w* \w to thy taste| strong="H2441" \w*:\f + \fr 24:13 \ft to…: Heb. upon thy palate \f* 
\v 14 So shall [the knowledge]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”} \w of wisdom| strong="H2451" \w* be \w unto thy soul| strong="H5315" \w*: [when thou hast found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} it, \w then there shall be| strong="H3426" \w* \w a reward| strong="H319" \w*, \w and thy expectation| strong="H8615" \w* [shall not be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\p
\v 15 [Lay not wait]{strong=“H693” x-morph=“strongMorph: \sc Th\sc*8799”}, \w O wicked| strong="H7563" \w* man, \w against the dwelling| strong="H5116" \w* \w of the righteous| strong="H6662" \w*; [spoil]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8762”} \w not his resting place| strong="H7258" \w*: 
\v 16 \w For a just| strong="H6662" \w* man [falleth]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w seven times| strong="H7651" \w*, [and riseth up again]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”}: \w but the wicked| strong="H7563" \w* [shall fall]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8735”} \w into mischief| strong="H7451" \w*. 
\p
\v 17 [Rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} [not when thine enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [falleth]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8800”}, \w and let not thine heart| strong="H3820" \w* [be glad]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”} [when he stumbleth]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8736”}: 
\v 18 Lest the \sc Lord\sc* [see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} it, [and it displease]{strong=“H5869 H7489” x-morph=“strongMorph: \sc Th\sc*8804”} [him, and he turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} \w his wrath| strong="H639" \w* from him.\f + \fr 24:18 \ft it displease…: Heb. it be evil in his eyes \f* 
\p
\v 19 [Fret]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8691”} [not thyself because of evil]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8688”} men, [neither be thou envious]{strong=“H7065” x-morph=“strongMorph: \sc Th\sc*8762”} \w at the wicked| strong="H7563" \w*;\f + \fr 24:19 \ft Fret…: or, Keep not company with the wicked \f* 
\v 20 \w For there shall be no reward| strong="H319" \w* \w to the evil| strong="H7451" \w* man; \w the candle| strong="H5216" \w* \w of the wicked| strong="H7563" \w* [shall be put out]{strong=“H1846” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 24:20 \ft candle: or, lamp \f* 
\p
\v 21 \w My son| strong="H1121" \w*, [fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8798”} thou the \sc Lord\sc* \w and the king| strong="H4428" \w*: and [meddle]{strong=“H6148” x-morph=“strongMorph: \sc Th\sc*8691”} [not with them that are given to change]{strong=“H8138” x-morph=“strongMorph: \sc Th\sc*8802”}:\f + \fr 24:21 \ft them…: Heb. changers \f* 
\v 22 \w For their calamity| strong="H343" \w* [shall rise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w suddenly| strong="H6597" \w*; [and who knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w the ruin| strong="H6365" \w* \w of them both| strong="H8147" \w*? 
\p
\v 23 These things also belong \w to the wise| strong="H2450" \w*. It is \w not good| strong="H2896" \w* [to have respect]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8687”} \w of persons| strong="H6440" \w* \w in judgment| strong="H4941" \w*. 
\v 24 [He that saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} \w unto the wicked| strong="H7563" \w*, Thou art \w righteous| strong="H6662" \w*; \w him shall the people| strong="H5971" \w* [curse]{strong=“H5344” x-morph=“strongMorph: \sc Th\sc*8799”}, \w nations| strong="H3816" \w* [shall abhor]{strong=“H2194” x-morph=“strongMorph: \sc Th\sc*8799”} him: 
\v 25 [But to them that rebuke]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8688”} him [shall be delight]{strong=“H5276” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and a good| strong="H2896" \w* \w blessing| strong="H1293" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} upon them.\f + \fr 24:25 \ft a good…: Heb. a blessing of good \f* 
\v 26 Every man [shall kiss]{strong=“H5401” x-morph=“strongMorph: \sc Th\sc*8799”} his \w lips| strong="H8193" \w* [that giveth]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8688”} \w a right| strong="H5228" \w* \w answer| strong="H1697" \w*.\f + \fr 24:26 \ft that…: Heb. that answereth right words \f* 
\v 27 [Prepare]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8685”} \w thy work| strong="H4399" \w* \w without| strong="H2351" \w*, [and make it fit]{strong=“H6257” x-morph=“strongMorph: \sc Th\sc*8761”} \w for thyself in the field| strong="H7704" \w*; \w and afterwards| strong="H310" \w* [build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w thine house| strong="H1004" \w*. 
\p
\v 28 \w Be not a witness| strong="H5707" \w* \w against thy neighbour| strong="H7453" \w* \w without cause| strong="H2600" \w*; [and deceive]{strong=“H6601” x-morph=“strongMorph: \sc Th\sc*8765”} not \w with thy lips| strong="H8193" \w*. 
\v 29 [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [not, I will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [so to him as he hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [to me: I will render]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w to the man| strong="H376" \w* \w according to his work| strong="H6467" \w*. 
\p
\v 30 [I went]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w by the field| strong="H7704" \w* [of the slothful]{strong=“H6102 H376”}, \w and by the vineyard| strong="H3754" \w* \w of the man| strong="H120" \w* \w void| strong="H2638" \w* \w of understanding| strong="H3820" \w*; 
\v 31 [And, lo, it was all grown over]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w with thorns| strong="H7063" \w*, and \w nettles| strong="H2738" \w* [had covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8795”} \w the face| strong="H6440" \w* [thereof, and the stone]{strong=“H68”} \w wall| strong="H1444" \w* [thereof was broken down]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 32 [Then I saw]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8799”}, and considered it [well]{strong=“H3820 H7896” x-morph=“strongMorph: \sc Th\sc*8799”}: [I looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} upon it, and [received]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w instruction| strong="H4148" \w*.\f + \fr 24:32 \ft considered…: Heb. set my heart \f* 
\v 33 Yet \w a little| strong="H4592" \w* \w sleep| strong="H8142" \w*, \w a little| strong="H4592" \w* \w slumber| strong="H8572" \w*, \w a little| strong="H4592" \w* \w folding| strong="H2264" \w* \w of the hands| strong="H3027" \w* [to sleep]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8800”}: 
\v 34 \w So shall thy poverty| strong="H7389" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} as [one that travelleth]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8693”}; \w and thy want| strong="H4270" \w* \w as an armed| strong="H4043" \w* \w man| strong="H376" \w*.\f + \fr 24:34 \ft an…: Heb. a man of shield \f*
\c 25
\p 
\v 1 These are \w also proverbs| strong="H4912" \w* \w of Solomon| strong="H8010" \w*, \w which the men| strong="H582" \w* \w of Hezekiah| strong="H2396" \w* \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w* [copied out]{strong=“H6275” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\p
\v 2 It is \w the glory| strong="H3519" \w* \w of God| strong="H430" \w* [to conceal]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8687”} \w a thing| strong="H1697" \w*: \w but the honour| strong="H3519" \w* \w of kings| strong="H4428" \w* is [to search out]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8800”} \w a matter| strong="H1697" \w*. 
\v 3 \w The heaven| strong="H8064" \w* \w for height| strong="H7312" \w*, \w and the earth| strong="H776" \w* \w for depth| strong="H6011" \w*, \w and the heart| strong="H3820" \w* \w of kings| strong="H4428" \w* is \w unsearchable| strong="H2714" \w*.\f + \fr 25:3 \ft is…: Heb. there is no searching \f* 
\p
\v 4 [Take away]{strong=“H1898” x-morph=“strongMorph: \sc Th\sc*8800”} \w the dross| strong="H5509" \w* \w from the silver| strong="H3701" \w*, [and there shall come forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w a vessel| strong="H3627" \w* [for the finer]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 5 [Take away]{strong=“H1898” x-morph=“strongMorph: \sc Th\sc*8800”} \w the wicked| strong="H7563" \w* from \w before| strong="H6440" \w* \w the king| strong="H4428" \w*, \w and his throne| strong="H3678" \w* [shall be established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8735”} \w in righteousness| strong="H6664" \w*. 
\p
\v 6 [Put not forth]{strong=“H1921” x-morph=“strongMorph: \sc Th\sc*8691”} \w thyself in the presence| strong="H6440" \w* \w of the king| strong="H4428" \w*, [and stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w not in the place| strong="H4725" \w* \w of great| strong="H1419" \w* men:\f + \fr 25:6 \ft Put…: Heb. Set not out thy glory \f* 
\v 7 \w For better| strong="H2896" \w* it is [that it be said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} [unto thee, Come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”} [hither; than that thou shouldest be put lower]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8687”} \w in the presence| strong="H6440" \w* \w of the prince| strong="H5081" \w* \w whom thine eyes| strong="H5869" \w* [have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\p
\v 8 [Go not forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w hastily| strong="H4118" \w* [to strive]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8800”}, lest thou know not [what to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the end| strong="H319" \w* [thereof, when thy neighbour]{strong=“H7453”} [hath put thee to shame]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8687”}. 
\v 9 [Debate]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy cause| strong="H7379" \w* \w with thy neighbour| strong="H7453" \w* himself; [and discover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”} \w not a secret| strong="H5475" \w* \w to another| strong="H312" \w*:\f + \fr 25:9 \ft a secret…: or, the secret of \f* 
\v 10 [Lest he that heareth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} it [put thee to shame]{strong=“H2616” x-morph=“strongMorph: \sc Th\sc*8762”}, \w and thine infamy| strong="H1681" \w* [turn not away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 11 \w A word| strong="H1697" \w* [fitly]{strong=“H655 H212” x-morph=“strongMorph: \sc Th\sc*8675”} [spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8803”} is like \w apples| strong="H8598" \w* \w of gold| strong="H2091" \w* \w in pictures| strong="H4906" \w* \w of silver| strong="H3701" \w*.\f + \fr 25:11 \ft fitly…: Heb. spoken upon his wheels \f* 
\v 12 As \w an earring| strong="H5141" \w* \w of gold| strong="H2091" \w*, \w and an ornament| strong="H2481" \w* \w of fine gold| strong="H3800" \w*, so is \w a wise| strong="H2450" \w* [reprover]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8688”} [upon an obedient]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} \w ear| strong="H241" \w*. 
\v 13 \w As the cold| strong="H6793" \w* \w of snow| strong="H7950" \w* \w in the time| strong="H3117" \w* \w of harvest| strong="H7105" \w*, so is [a faithful]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8737”} \w messenger| strong="H6735" \w* [to them that send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8802”} [him: for he refresheth]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w the soul| strong="H5315" \w* \w of his masters| strong="H113" \w*. 
\v 14 \w Whoso| strong="H376" \w* [boasteth]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8693”} \w himself of a false| strong="H8267" \w* \w gift| strong="H4991" \w* is like \w clouds| strong="H5387" \w* \w and wind| strong="H7307" \w* \w without rain| strong="H1653" \w*.\f + \fr 25:14 \ft of a…: Heb. in a gift of falsehood \f* 
\v 15 \w By long| strong="H753" \w* \w forbearing| strong="H639" \w* \w is a prince| strong="H7101" \w* [persuaded]{strong=“H6601” x-morph=“strongMorph: \sc Th\sc*8792”}, \w and a soft| strong="H7390" \w* \w tongue| strong="H3956" \w* [breaketh]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8799”} \w the bone| strong="H1634" \w*. 
\v 16 [Hast thou found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w honey| strong="H1706" \w*? [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8798”} \w so much as is sufficient| strong="H1767" \w* [for thee, lest thou be filled]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”} [therewith, and vomit]{strong=“H6958” x-morph=“strongMorph: \sc Th\sc*8689”} it. 
\v 17 [Withdraw]{strong=“H3365” x-morph=“strongMorph: \sc Th\sc*8685”} \w thy foot| strong="H7272" \w* [from thy neighbour’s]{strong=“H7453”} \w house| strong="H1004" \w*; [lest he be weary]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”} of thee, and so [hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”} thee.\f + \fr 25:17 \ft Withdraw…: or, Let thy foot be seldom in \f* \f + \fr 25:17 \ft weary…: Heb. full of thee \f* 
\v 18 \w A man| strong="H376" \w* [that beareth]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8802”} \w false| strong="H8267" \w* \w witness| strong="H5707" \w* \w against his neighbour| strong="H7453" \w* is \w a maul| strong="H4650" \w*, \w and a sword| strong="H2719" \w*, [and a sharp]{strong=“H8150” x-morph=“strongMorph: \sc Th\sc*8802”} \w arrow| strong="H2671" \w*. 
\v 19 \w Confidence| strong="H4009" \w* [in an unfaithful man]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”} \w in time| strong="H3117" \w* \w of trouble| strong="H6869" \w* is like \w a broken| strong="H7465" \w* \w tooth| strong="H8127" \w*, \w and a foot| strong="H7272" \w* \w out of joint| strong="H4154" \w*. 
\v 20 As [he that taketh away]{strong=“H5710” x-morph=“strongMorph: \sc Th\sc*8688”} \w a garment| strong="H899" \w* \w in cold| strong="H7135" \w* \w weather| strong="H3117" \w*, and as \w vinegar| strong="H2558" \w* \w upon nitre| strong="H5427" \w*, so is [he that singeth]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8802”} \w songs| strong="H7892" \w* \w to an heavy| strong="H7451" \w* \w heart| strong="H3820" \w*. 
\p
\v 21 [If thine enemy]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} \w be hungry| strong="H7457" \w*, \w give him bread| strong="H3899" \w* [to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8685”}; \w and if he be thirsty| strong="H6771" \w*, \w give him water| strong="H4325" \w* [to drink]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8685”}: 
\v 22 [For thou shalt heap]{strong=“H2846” x-morph=“strongMorph: \sc Th\sc*8802”} \w coals of fire| strong="H1513" \w* \w upon his head| strong="H7218" \w*, and the \sc Lord\sc* [shall reward]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} thee. 
\v 23 \w The north| strong="H6828" \w* \w wind| strong="H7307" \w* [driveth away]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8787”} \w rain| strong="H1653" \w*: so doth [an angry]{strong=“H2194” x-morph=“strongMorph: \sc Th\sc*8737”} \w countenance| strong="H6440" \w* \w a backbiting| strong="H5643" \w* \w tongue| strong="H3956" \w*.\f + \fr 25:23 \ft driveth…: or, bringeth forth rain: so doth a backbiting tongue an angry countenance \f* 
\v 24 It is \w better| strong="H2896" \w* [to dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the corner| strong="H6438" \w* \w of the housetop| strong="H1406" \w*, [than with a brawling]{strong=“H4066 H4079” x-morph=“strongMorph: \sc Th\sc*8675”} \w woman| strong="H802" \w* \w and in a wide| strong="H2267" \w* \w house| strong="H1004" \w*. 
\v 25 As \w cold| strong="H7119" \w* \w waters| strong="H4325" \w* \w to a thirsty| strong="H5889" \w* \w soul| strong="H5315" \w*, so is \w good| strong="H2896" \w* \w news| strong="H8052" \w* \w from a far| strong="H4801" \w* \w country| strong="H776" \w*. 
\v 26 \w A righteous| strong="H6662" \w* [man falling down]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8801”} \w before| strong="H6440" \w* \w the wicked| strong="H7563" \w* is as [a troubled]{strong=“H7515” x-morph=“strongMorph: \sc Th\sc*8737”} \w fountain| strong="H4599" \w*, [and a corrupt]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8716”} \w spring| strong="H4726" \w*. 
\v 27 It is \w not good| strong="H2896" \w* [to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} [much]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8687”} \w honey| strong="H1706" \w*: so for men \w to search| strong="H2714" \w* \w their own glory| strong="H3519" \w* is not \w glory| strong="H3519" \w*. 
\v 28 \w He| strong="H376" \w* that hath \w no rule| strong="H4623" \w* \w over his own spirit| strong="H7307" \w* is like \w a city| strong="H5892" \w* that is [broken down]{strong=“H6555” x-morph=“strongMorph: \sc Th\sc*8803”}, and \w without walls| strong="H2346" \w*.
\c 26
\p 
\v 1 \w As snow| strong="H7950" \w* \w in summer| strong="H7019" \w*, \w and as rain| strong="H4306" \w* \w in harvest| strong="H7105" \w*, \w so honour| strong="H3519" \w* \w is not seemly| strong="H5000" \w* \w for a fool| strong="H3684" \w*. 
\v 2 \w As the bird| strong="H6833" \w* [by wandering]{strong=“H5110” x-morph=“strongMorph: \sc Th\sc*8800”}, \w as the swallow| strong="H1866" \w* [by flying]{strong=“H5774” x-morph=“strongMorph: \sc Th\sc*8800”}, \w so the curse| strong="H7045" \w* \w causeless| strong="H2600" \w* [shall not come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 3 \w A whip| strong="H7752" \w* \w for the horse| strong="H5483" \w*, \w a bridle| strong="H4964" \w* \w for the ass| strong="H2543" \w*, \w and a rod| strong="H7626" \w* [for the fool’s]{strong=“H3684”} \w back| strong="H1460" \w*. 
\p
\v 4 [Answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w not a fool| strong="H3684" \w* \w according to his folly| strong="H200" \w*, [lest thou also be like]{strong=“H7737” x-morph=“strongMorph: \sc Th\sc*8799”} unto him. 
\v 5 [Answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8798”} \w a fool| strong="H3684" \w* \w according to his folly| strong="H200" \w*, \w lest he be wise| strong="H2450" \w* \w in his own conceit| strong="H5869" \w*.\f + \fr 26:5 \ft conceit: Heb. eyes \f* 
\p
\v 6 [He that sendeth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8802”} \w a message| strong="H1697" \w* \w by the hand| strong="H3027" \w* \w of a fool| strong="H3684" \w* [cutteth off]{strong=“H7096” x-morph=“strongMorph: \sc Th\sc*8764”} \w the feet| strong="H7272" \w*, and [drinketh]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8802”} \w damage| strong="H2555" \w*.\f + \fr 26:6 \ft damage: or, violence \f* 
\v 7 \w The legs| strong="H7785" \w* \w of the lame| strong="H6455" \w* [are not equal]{strong=“H1809” x-morph=“strongMorph: \sc Th\sc*8804”}: so is \w a parable| strong="H4912" \w* \w in the mouth| strong="H6310" \w* \w of fools| strong="H3684" \w*.\f + \fr 26:7 \ft are…: Heb. are lifted up \f* 
\v 8 [As he that bindeth]{strong=“H6887 H6872” x-morph=“strongMorph: \sc Th\sc*8800 strongMorph: \sc Th\sc*8675”} \w a stone| strong="H68" \w* \w in a sling| strong="H4773" \w*, so is [he that giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w honour| strong="H3519" \w* \w to a fool| strong="H3684" \w*.\f + \fr 26:8 \ft bindeth…: or, putteth a precious stone in an heap of stones \f* 
\v 9 As \w a thorn| strong="H2336" \w* [goeth up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the hand| strong="H3027" \w* \w of a drunkard| strong="H7910" \w*, so is \w a parable| strong="H4912" \w* \w in the mouth| strong="H6310" \w* \w of fools| strong="H3684" \w*. 
\v 10 \w The great| strong="H7227" \w* God [that formed]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8789”} all things [both rewardeth]{strong=“H7936” x-morph=“strongMorph: \sc Th\sc*8802”} \w the fool| strong="H3684" \w*, [and rewardeth]{strong=“H7936” x-morph=“strongMorph: \sc Th\sc*8802”} [transgressors]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 26:10 \ft The great…: or, A great man grieveth all, and he hireth the fool, he hireth also transgressors \f* 
\v 11 \w As a dog| strong="H3611" \w* [returneth]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w to his vomit| strong="H6892" \w*, so \w a fool| strong="H3684" \w* [returneth]{strong=“H8138” x-morph=“strongMorph: \sc Th\sc*8802”} \w to his folly| strong="H200" \w*.\f + \fr 26:11 \ft returneth to his folly: Heb. iterateth his folly \f* 
\v 12 [Seest]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w thou a man| strong="H376" \w* \w wise| strong="H2450" \w* \w in his own conceit| strong="H5869" \w*? there is \w more hope| strong="H8615" \w* \w of a fool| strong="H3684" \w* than of him. 
\v 13 \w The slothful| strong="H6102" \w* man [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, There is \w a lion| strong="H7826" \w* \w in the way| strong="H1870" \w*; \w a lion| strong="H738" \w* is \w in the streets| strong="H7339" \w*. 
\v 14 As \w the door| strong="H1817" \w* [turneth ]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8735”} \w upon his hinges| strong="H6735" \w*, so doth \w the slothful| strong="H6102" \w* \w upon his bed| strong="H4296" \w*. 
\v 15 \w The slothful| strong="H6102" \w* [hideth]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8804”} \w his hand| strong="H3027" \w* in his \w bosom| strong="H6747" \w*; [it grieveth]{strong=“H3811” x-morph=“strongMorph: \sc Th\sc*8738”} [him to bring it again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} \w to his mouth| strong="H6310" \w*.\f + \fr 26:15 \ft it grieveth…: or, he is weary \f* 
\v 16 \w The sluggard| strong="H6102" \w* is \w wiser| strong="H2450" \w* \w in his own conceit| strong="H5869" \w* \w than seven men| strong="H7651" \w* [that can render]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8688”} \w a reason| strong="H2940" \w*. 
\v 17 [He that passeth by]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”}, and [meddleth]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8693”} \w with strife| strong="H7379" \w* belonging not to him, is like [one that taketh]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8688”} \w a dog| strong="H3611" \w* \w by the ears| strong="H241" \w*.\f + \fr 26:17 \ft meddleth: or, is enraged \f* 
\p
\v 18 [As a mad]{strong=“H3856” x-morph=“strongMorph: \sc Th\sc*8700”} man [who casteth]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8802”} \w firebrands| strong="H2131" \w*, \w arrows| strong="H2671" \w*, \w and death| strong="H4194" \w*,\f + \fr 26:18 \ft firebrands: Heb. flames, or, sparks \f* 
\v 19 So is \w the man| strong="H376" \w* that [deceiveth]{strong=“H7411” x-morph=“strongMorph: \sc Th\sc*8765”} \w his neighbour| strong="H7453" \w*, [and saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Am not I in sport]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8764”}? 
\p
\v 20 \w Where no| strong="H657" \w* \w wood| strong="H6086" \w* is, there \w the fire| strong="H784" \w* [goeth out]{strong=“H3518” x-morph=“strongMorph: \sc Th\sc*8799”}: so where there is \w no talebearer| strong="H5372" \w*, \w the strife| strong="H4066" \w* [ceaseth]{strong=“H8367” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 26:20 \ft Where no…: Heb. Without wood \f* \f + \fr 26:20 \ft talebearer: or, whisperer \f* \f + \fr 26:20 \ft ceaseth: Heb. is silent \f* 
\v 21 As \w coals| strong="H6352" \w* are \w to burning coals| strong="H1513" \w*, \w and wood| strong="H6086" \w* \w to fire| strong="H784" \w*; so is [a contentious]{strong=“H4066 H4079” x-morph=“strongMorph: \sc Th\sc*8675”} \w man| strong="H376" \w* [to kindle]{strong=“H2787” x-morph=“strongMorph: \sc Th\sc*8771”} \w strife| strong="H7379" \w*. 
\v 22 \w The words| strong="H1697" \w* \w of a talebearer| strong="H5372" \w* are [as wounds]{strong=“H3859” x-morph=“strongMorph: \sc Th\sc*8693”}, [and they go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the innermost parts| strong="H2315" \w* \w of the belly| strong="H990" \w*.\f + \fr 26:22 \ft innermost…: Heb. chambers \f* 
\v 23 [Burning]{strong=“H1814” x-morph=“strongMorph: \sc Th\sc*8801”} \w lips| strong="H8193" \w* \w and a wicked| strong="H7451" \w* \w heart| strong="H3820" \w* are like \w a potsherd| strong="H2789" \w* [covered]{strong=“H6823” x-morph=“strongMorph: \sc Th\sc*8794”} \w with silver| strong="H3701" \w* \w dross| strong="H5509" \w*. 
\p
\v 24 [He that hateth]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} [dissembleth]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8735”} \w with his lips| strong="H8193" \w*, [and layeth up]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w deceit| strong="H4820" \w* \w within| strong="H7130" \w* him;\f + \fr 26:24 \ft dissembleth: or, is known \f* 
\v 25 \w When he speaketh| strong="H6963" \w* [fair]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8762”}, [believe]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”} him not: for there are \w seven| strong="H7651" \w* \w abominations| strong="H8441" \w* \w in his heart| strong="H3820" \w*.\f + \fr 26:25 \ft speaketh…: Heb. maketh his voice gracious \f* 
\v 26 Whose \w hatred| strong="H8135" \w* [is covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8691”} \w by deceit| strong="H4860" \w*, \w his wickedness| strong="H7451" \w* [shall be shewed]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8735”} before the whole \w congregation| strong="H6951" \w*.\f + \fr 26:26 \ft by…: or, in secret \f* 
\v 27 [Whoso diggeth]{strong=“H3738” x-morph=“strongMorph: \sc Th\sc*8802”} \w a pit| strong="H7845" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} [therein: and he that rolleth]{strong=“H1556” x-morph=“strongMorph: \sc Th\sc*8802”} \w a stone| strong="H68" \w*, [it will return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} upon him. 
\v 28 \w A lying| strong="H8267" \w* \w tongue| strong="H3956" \w* [hateth]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8799”} those that are \w afflicted| strong="H1790" \w* [by it; and a flattering]{strong=“H2509”} \w mouth| strong="H6310" \w* [worketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w ruin| strong="H4072" \w*.
\c 27
\p 
\v 1 [Boast]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8691”} \w not thyself of to morrow| strong="H4279" \w*; [for thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w not what a day| strong="H3117" \w* [may bring forth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 27:1 \ft to…: Heb. to morrow day \f* 
\v 2 [Let another man]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} [praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} [thee, and not thine own mouth]{strong=“H6310”}; \w a stranger| strong="H5237" \w*, \w and not thine own lips| strong="H8193" \w*. 
\p
\v 3 \w A stone| strong="H68" \w* is \w heavy| strong="H3514" \w*, \w and the sand| strong="H2344" \w* \w weighty| strong="H5192" \w*; [but a fool’s]{strong=“H191”} \w wrath| strong="H3708" \w* is \w heavier| strong="H3515" \w* \w than them both| strong="H8147" \w*.\f + \fr 27:3 \ft heavy: Heb. heaviness \f* 
\v 4 \w Wrath| strong="H2534" \w* is \w cruel| strong="H395" \w*, \w and anger| strong="H639" \w* is \w outrageous| strong="H7858" \w*; but who is [able to stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* \w envy| strong="H7068" \w*?\f + \fr 27:4 \ft Wrath…: Heb. Wrath is cruelty, and anger an overflowing \f* \f + \fr 27:4 \ft envy: or, jealousy? \f* 
\p
\v 5 [Open]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8794”} \w rebuke| strong="H8433" \w* is \w better| strong="H2896" \w* [than secret]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8794”} \w love| strong="H160" \w*. 
\v 6 [Faithful]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8737”} are \w the wounds| strong="H6482" \w* [of a friend]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”}; \w but the kisses| strong="H5390" \w* [of an enemy]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} are [deceitful]{strong=“H6280” x-morph=“strongMorph: \sc Th\sc*8737”}.\f + \fr 27:6 \ft deceitful: or, earnest, or, frequent \f* 
\v 7 \w The full| strong="H7649" \w* \w soul| strong="H5315" \w* [loatheth]{strong=“H947” x-morph=“strongMorph: \sc Th\sc*8799”} \w an honeycomb| strong="H5317" \w*; \w but to the hungry| strong="H7457" \w* \w soul| strong="H5315" \w* \w every bitter thing| strong="H4751" \w* \w is sweet| strong="H4966" \w*.\f + \fr 27:7 \ft loatheth: Heb. treadeth under foot \f* 
