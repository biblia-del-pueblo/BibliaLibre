\c 1
\p 
\v 1 \w The proverbs| strong="H4912" \w* \w of Solomon| strong="H8010" \w* \w the son| strong="H1121" \w* \w of David| strong="H1732" \w*, \w king| strong="H4428" \w* \w of Israel| strong="H3478" \w*; 
\v 2 [To know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} \w wisdom| strong="H2451" \w* \w and instruction| strong="H4148" \w*; [to perceive]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8687”} \w the words| strong="H561" \w* \w of understanding| strong="H998" \w*; 
\v 3 [To receive]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} \w the instruction| strong="H4148" \w* [of wisdom]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8687”}, \w justice| strong="H6664" \w*, \w and judgment| strong="H4941" \w*, \w and equity| strong="H4339" \w*;\f + \fr 1:3 \ft equity: Heb. equities \f* 
\v 4 [To give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w subtilty| strong="H6195" \w* \w to the simple| strong="H6612" \w*, \w to the young man| strong="H5288" \w* \w knowledge| strong="H1847" \w* \w and discretion| strong="H4209" \w*.\f + \fr 1:4 \ft discretion: or, advisement \f* 
\v 5 \w A wise| strong="H2450" \w* man [will hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}, [and will increase]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w learning| strong="H3948" \w*; [and a man of understanding]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8737”} [shall attain]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto wise counsels| strong="H8458" \w*: 
\v 6 [To understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8687”} \w a proverb| strong="H4912" \w*, \w and the interpretation| strong="H4426" \w*; \w the words| strong="H1697" \w* \w of the wise| strong="H2450" \w*, \w and their dark sayings| strong="H2420" \w*.\f + \fr 1:6 \ft the interpretation: or, an eloquent speech \f* 
\p
\v 7 \w The fear| strong="H3374" \w* of the \sc Lord\sc* is \w the beginning| strong="H7225" \w* \w of knowledge| strong="H1847" \w*: but \w fools| strong="H191" \w* [despise]{strong=“H936” x-morph=“strongMorph: \sc Th\sc*8804”} \w wisdom| strong="H2451" \w* \w and instruction| strong="H4148" \w*.\f + \fr 1:7 \ft the beginning: or, the principal part \f* 
\v 8 \w My son| strong="H1121" \w*, [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the instruction| strong="H4148" \w* \w of thy father| strong="H1" \w*, [and forsake]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8799”} \w not the law| strong="H8451" \w* \w of thy mother| strong="H517" \w*: 
\v 9 For they shall be \w an ornament| strong="H3880" \w* \w of grace| strong="H2580" \w* \w unto thy head| strong="H7218" \w*, \w and chains| strong="H6060" \w* \w about thy neck| strong="H1621" \w*.\f + \fr 1:9 \ft an…: Heb. an adding \f* 
\p
\v 10 \w My son| strong="H1121" \w*, \w if sinners| strong="H2400" \w* [entice]{strong=“H6601” x-morph=“strongMorph: \sc Th\sc*8762”} [thee, consent]{strong=“H14” x-morph=“strongMorph: \sc Th\sc*8799”} thou not. 
\v 11 [If they say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} [with us, let us lay wait]{strong=“H693” x-morph=“strongMorph: \sc Th\sc*8799”} \w for blood| strong="H1818" \w*, [let us lurk]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8799”} \w privily for the innocent| strong="H5355" \w* \w without cause| strong="H2600" \w*: 
\v 12 [Let us swallow them up]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8799”} \w alive| strong="H2416" \w* \w as the grave| strong="H7585" \w*; \w and whole| strong="H8549" \w*, [as those that go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w into the pit| strong="H953" \w*: 
\v 13 [We shall find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w all precious| strong="H3368" \w* \w substance| strong="H1952" \w*, [we shall fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8762”} \w our houses| strong="H1004" \w* \w with spoil| strong="H7998" \w*: 
\v 14 [Cast]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8686”} \w in thy lot| strong="H1486" \w* \w among| strong="H8432" \w* [us; let us all have one]{strong=“H259”} \w purse| strong="H3599" \w*: 
\v 15 \w My son| strong="H1121" \w*, [walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w not thou in the way| strong="H1870" \w* [with them; refrain]{strong=“H4513” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy foot| strong="H7272" \w* \w from their path| strong="H5410" \w*: 
\v 16 \w For their feet| strong="H7272" \w* [run]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”} \w to evil| strong="H7451" \w*, [and make haste]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8762”} [to shed]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8800”} \w blood| strong="H1818" \w*. 
\v 17 \w Surely in vain| strong="H2600" \w* \w the net| strong="H7568" \w* [is spread]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8794”} \w in the sight| strong="H5869" \w* [of any bird]{strong=“H3671 H1167”}.\f + \fr 1:17 \ft in the…: Heb. in the eyes of every thing that hath a wing \f* 
\v 18 [And they lay wait]{strong=“H693” x-morph=“strongMorph: \sc Th\sc*8799”} for their own \w blood| strong="H1818" \w*; [they lurk privily]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8799”} for their own \w lives| strong="H5315" \w*. 
\v 19 So are \w the ways| strong="H734" \w* [of every one that is greedy]{strong=“H1214” x-morph=“strongMorph: \sc Th\sc*8802”} \w of gain| strong="H1215" \w*; which [taketh away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the life| strong="H5315" \w* \w of the owners| strong="H1167" \w* thereof. 
\p
\v 20 \w Wisdom| strong="H2454" \w* [crieth]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8799”} \w without| strong="H2351" \w*; [she uttereth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w her voice| strong="H6963" \w* \w in the streets| strong="H7339" \w*:\f + \fr 1:20 \ft Wisdom: Heb. Wisdoms, that is, Excellent wisdom \f* 
\v 21 [She crieth]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the chief place| strong="H7218" \w* [of concourse]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8802”}, \w in the openings| strong="H6607" \w* \w of the gates| strong="H8179" \w*: \w in the city| strong="H5892" \w* [she uttereth]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w her words| strong="H561" \w*, saying, 
\v 22 [How long, ye simple ones]{strong=“H6612”}, [will ye love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8799”} \w simplicity| strong="H6612" \w*? [and the scorners]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8801”} [delight]{strong=“H2530” x-morph=“strongMorph: \sc Th\sc*8804”} \w in their scorning| strong="H3944" \w*, \w and fools| strong="H3684" \w* [hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8799”} \w knowledge| strong="H1847" \w*? 
\v 23 [Turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w you at my reproof| strong="H8433" \w*: [behold, I will pour out]{strong=“H5042” x-morph=“strongMorph: \sc Th\sc*8686”} \w my spirit| strong="H7307" \w* [unto you, I will make known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8686”} \w my words| strong="H1697" \w* unto you. 
\p
\v 24 [Because I have called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”}, [and ye refused]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8762”}; [I have stretched out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} \w my hand| strong="H3027" \w*, [and no man regarded]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8688”}; 
\v 25 [But ye have set at nought]{strong=“H6544” x-morph=“strongMorph: \sc Th\sc*8799”} \w all my counsel| strong="H6098" \w*, [and would]{strong=“H14” x-morph=“strongMorph: \sc Th\sc*8804”} \w none of my reproof| strong="H8433" \w*: 
\v 26 [I also will laugh]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8799”} \w at your calamity| strong="H343" \w*; [I will mock]{strong=“H3932” x-morph=“strongMorph: \sc Th\sc*8799”} \w when your fear| strong="H6343" \w* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}; 
\v 27 \w When your fear| strong="H6343" \w* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [as desolation]{strong=“H7584 H7722” x-morph=“strongMorph: \sc Th\sc*8675”}, \w and your destruction| strong="H343" \w* [cometh]{strong=“H857” x-morph=“strongMorph: \sc Th\sc*8799”} \w as a whirlwind| strong="H5492" \w*; \w when distress| strong="H6869" \w* \w and anguish| strong="H6695" \w* [cometh ]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} upon you. 
\v 28 [Then shall they call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} [upon me, but I will not answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”}; [they shall seek me early]{strong=“H7836” x-morph=“strongMorph: \sc Th\sc*8762”}, [but they shall not find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} me: 
\v 29 [For that they hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”} \w knowledge| strong="H1847" \w*, [and did not choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} \w the fear| strong="H3374" \w* of the \sc Lord\sc*: 
\v 30 [They would]{strong=“H14” x-morph=“strongMorph: \sc Th\sc*8804”} \w none of my counsel| strong="H6098" \w*: [they despised]{strong=“H5006” x-morph=“strongMorph: \sc Th\sc*8804”} \w all my reproof| strong="H8433" \w*. 
\v 31 [Therefore shall they eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the fruit| strong="H6529" \w* \w of their own way| strong="H1870" \w*, [and be filled]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”} \w with their own devices| strong="H4156" \w*. 
\v 32 \w For the turning away| strong="H4878" \w* \w of the simple| strong="H6612" \w* [shall slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and the prosperity]{strong=“H7962”} \w of fools| strong="H3684" \w* [shall destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8762”} them.\f + \fr 1:32 \ft turning…: or, ease of the simple \f* 
\v 33 [But whoso hearkeneth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} [unto me shall dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} \w safely| strong="H983" \w*, [and shall be quiet]{strong=“H7599” x-morph=“strongMorph: \sc Th\sc*8768”} \w from fear| strong="H6343" \w* \w of evil| strong="H7451" \w*.
\c 2
\p 
\v 1 \w My son| strong="H1121" \w*, [if thou wilt receive]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w my words| strong="H561" \w*, [and hide]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8799”} \w my commandments| strong="H4687" \w* with thee; 
\v 2 [So that thou incline]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8687”} \w thine ear| strong="H241" \w* \w unto wisdom| strong="H2451" \w*, and [apply]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w thine heart| strong="H3820" \w* \w to understanding| strong="H8394" \w*; 
\v 3 [Yea, if thou criest]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w after knowledge| strong="H998" \w*, and [liftest up]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy voice| strong="H6963" \w* \w for understanding| strong="H8394" \w*;\f + \fr 2:3 \ft liftest…: Heb. givest thy voice \f* 
\v 4 [If thou seekest]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w her as silver| strong="H3701" \w*, [and searchest]{strong=“H2664” x-morph=“strongMorph: \sc Th\sc*8799”} for her as for \w hid treasures| strong="H4301" \w*; 
\v 5 [Then shalt thou understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} \w the fear| strong="H3374" \w* of the \sc Lord\sc*, [and find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w the knowledge| strong="H1847" \w* \w of God| strong="H430" \w*. 
\v 6 For the \sc Lord\sc* [giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w wisdom| strong="H2451" \w*: \w out of his mouth| strong="H6310" \w* cometh \w knowledge| strong="H1847" \w* \w and understanding| strong="H8394" \w*. 
\v 7 [He layeth up]{strong=“H6845 H6845” x-morph=“strongMorph: \sc Th\sc*8804 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8799”} \w sound wisdom| strong="H8454" \w* \w for the righteous| strong="H3477" \w*: he is \w a buckler| strong="H4043" \w* [to them that walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w uprightly| strong="H8537" \w*. 
\v 8 [He keepeth]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8800”} \w the paths| strong="H734" \w* \w of judgment| strong="H4941" \w*, [and preserveth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w the way| strong="H1870" \w* \w of his saints| strong="H2623" \w*. 
\v 9 [Then shalt thou understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} \w righteousness| strong="H6664" \w*, \w and judgment| strong="H4941" \w*, \w and equity| strong="H4339" \w*; yea, \w every good| strong="H2896" \w* \w path| strong="H4570" \w*. 
\p
\v 10 \w When wisdom| strong="H2451" \w* [entereth]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into thine heart| strong="H3820" \w*, \w and knowledge| strong="H1847" \w* [is pleasant]{strong=“H5276” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto thy soul| strong="H5315" \w*; 
\v 11 \w Discretion| strong="H4209" \w* [shall preserve]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} [thee, understanding]{strong=“H8394”} [shall keep]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8799”} thee: 
\v 12 [To deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8687”} \w thee from the way| strong="H1870" \w* \w of the evil| strong="H7451" \w* man, \w from the man| strong="H376" \w* [that speaketh]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8764”} \w froward things| strong="H8419" \w*; 
\v 13 [Who leave]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8802”} \w the paths| strong="H734" \w* \w of uprightness| strong="H3476" \w*, [to walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the ways| strong="H1870" \w* \w of darkness| strong="H2822" \w*; 
\v 14 \w Who rejoice| strong="H8056" \w* [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w evil| strong="H7451" \w*, and [delight]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the frowardness| strong="H8419" \w* \w of the wicked| strong="H7451" \w*; 
\v 15 \w Whose ways| strong="H734" \w* are \w crooked| strong="H6141" \w*, and they [froward ]{strong=“H3868” x-morph=“strongMorph: \sc Th\sc*8737”} \w in their paths| strong="H4570" \w*: 
\v 16 [To deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8687”} [thee from the strange]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} \w woman| strong="H802" \w*, even \w from the stranger| strong="H5237" \w* which [flattereth]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8689”} \w with her words| strong="H561" \w*; 
\v 17 [Which forsaketh]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8802”} \w the guide| strong="H441" \w* \w of her youth| strong="H5271" \w*, [and forgetteth]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} \w the covenant| strong="H1285" \w* \w of her God| strong="H430" \w*. 
\v 18 \w For her house| strong="H1004" \w* [inclineth]{strong=“H7743” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto death| strong="H4194" \w*, \w and her paths| strong="H4570" \w* \w unto the dead| strong="H7496" \w*. 
\v 19 [None that go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [unto her return again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [neither take they hold]{strong=“H5381” x-morph=“strongMorph: \sc Th\sc*8686”} \w of the paths| strong="H734" \w* \w of life| strong="H2416" \w*. 
\v 20 [That thou mayest walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the way| strong="H1870" \w* \w of good| strong="H2896" \w* men, [and keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w the paths| strong="H734" \w* \w of the righteous| strong="H6662" \w*. 
\v 21 \w For the upright| strong="H3477" \w* [shall dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the land| strong="H776" \w*, \w and the perfect| strong="H8549" \w* [shall remain]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8735”} in it. 
\v 22 \w But the wicked| strong="H7563" \w* [shall be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8735”} \w from the earth| strong="H776" \w*, [and the transgressors]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”} [shall be rooted out]{strong=“H5255” x-morph=“strongMorph: \sc Th\sc*8799”} of it.\f + \fr 2:22 \ft rooted: or, plucked up \f*
\c 3
\p 
\v 1 \w My son| strong="H1121" \w*, [forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} \w not my law| strong="H8451" \w*; \w but let thine heart| strong="H3820" \w* [keep]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8799”} \w my commandments| strong="H4687" \w*: 
\v 2 \w For length| strong="H753" \w* \w of days| strong="H3117" \w*, \w and long| strong="H8141" \w* \w life| strong="H2416" \w*, \w and peace| strong="H7965" \w*, [shall they add]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} to thee.\f + \fr 3:2 \ft long…: Heb. years of life \f* 
\v 3 \w Let not mercy| strong="H2617" \w* \w and truth| strong="H571" \w* [forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} [thee: bind]{strong=“H7194” x-morph=“strongMorph: \sc Th\sc*8798”} \w them about thy neck| strong="H1621" \w*; [write]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8798”} \w them upon the table| strong="H3871" \w* \w of thine heart| strong="H3820" \w*: 
\v 4 [So shalt thou find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8798”} \w favour| strong="H2580" \w* \w and good| strong="H2896" \w* \w understanding| strong="H7922" \w* \w in the sight| strong="H5869" \w* \w of God| strong="H430" \w* \w and man| strong="H120" \w*.\f + \fr 3:4 \ft good…: or, good success \f* 
\p
\v 5 [Trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8798”} in the \sc Lord\sc* \w with all thine heart| strong="H3820" \w*; [and lean]{strong=“H8172” x-morph=“strongMorph: \sc Th\sc*8735”} \w not unto thine own understanding| strong="H998" \w*. 
\v 6 \w In all thy ways| strong="H1870" \w* [acknowledge]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”} [him, and he shall direct]{strong=“H3474” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy paths| strong="H734" \w*. 
\p
\v 7 \w Be not wise| strong="H2450" \w* \w in thine own eyes| strong="H5869" \w*: [fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8798”} the \sc Lord\sc*, [and depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8798”} \w from evil| strong="H7451" \w*. 
\v 8 \w It shall be health| strong="H7500" \w* \w to thy navel| strong="H8270" \w*, \w and marrow| strong="H8250" \w* \w to thy bones| strong="H6106" \w*.\f + \fr 3:8 \ft health: Heb. medicine \f* \f + \fr 3:8 \ft marrow: Heb. watering, or, moistening \f* 
\v 9 [Honour]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8761”} the \sc Lord\sc* \w with thy substance| strong="H1952" \w*, \w and with the firstfruits| strong="H7225" \w* \w of all thine increase| strong="H8393" \w*: 
\v 10 \w So shall thy barns| strong="H618" \w* [be filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”} \w with plenty| strong="H7647" \w*, \w and thy presses| strong="H3342" \w* [shall burst out]{strong=“H6555” x-morph=“strongMorph: \sc Th\sc*8799”} \w with new wine| strong="H8492" \w*. 
\p
\v 11 \w My son| strong="H1121" \w*, [despise]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8799”} \w not the chastening| strong="H4148" \w* of the \sc Lord\sc*; [neither be weary]{strong=“H6973” x-morph=“strongMorph: \sc Th\sc*8799”} \w of his correction| strong="H8433" \w*: 
\v 12 For whom the \sc Lord\sc* [loveth]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8799”} [he correcteth]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”}; \w even as a father| strong="H1" \w* \w the son| strong="H1121" \w* in whom [he delighteth]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 13 \w Happy| strong="H835" \w* is \w the man| strong="H120" \w* that [findeth]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w wisdom| strong="H2451" \w*, \w and the man| strong="H120" \w* that [getteth]{strong=“H6329” x-morph=“strongMorph: \sc Th\sc*8686”} \w understanding| strong="H8394" \w*.\f + \fr 3:13 \ft that getteth…: Heb. that draweth out understanding \f* 
\v 14 \w For the merchandise| strong="H5504" \w* of it is \w better| strong="H2896" \w* \w than the merchandise| strong="H5505" \w* \w of silver| strong="H3701" \w*, \w and the gain| strong="H8393" \w* \w thereof than fine gold| strong="H2742" \w*. 
\v 15 She is \w more precious| strong="H3368" \w* \w than rubies| strong="H6443" \w*: \w and all the things thou canst desire| strong="H2656" \w* [are not to be compared]{strong=“H7737” x-morph=“strongMorph: \sc Th\sc*8799”} unto her. 
\v 16 \w Length| strong="H753" \w* \w of days| strong="H3117" \w* is \w in her right hand| strong="H3225" \w*; and \w in her left hand| strong="H8040" \w* \w riches| strong="H6239" \w* \w and honour| strong="H3519" \w*. 
\v 17 \w Her ways| strong="H1870" \w* are \w ways| strong="H1870" \w* \w of pleasantness| strong="H5278" \w*, \w and all her paths| strong="H5410" \w* are \w peace| strong="H7965" \w*. 
\v 18 She is \w a tree| strong="H6086" \w* \w of life| strong="H2416" \w* [to them that lay hold]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8688”} [upon her: and happy]{strong=“H833” x-morph=“strongMorph: \sc Th\sc*8794”} is every one [that retaineth]{strong=“H8551” x-morph=“strongMorph: \sc Th\sc*8802”} her. 
\v 19 The \sc Lord\sc* \w by wisdom| strong="H2451" \w* [hath founded]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8804”} \w the earth| strong="H776" \w*; \w by understanding| strong="H8394" \w* [hath he established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8790”} \w the heavens| strong="H8064" \w*.\f + \fr 3:19 \ft established: or, prepared \f* 
\v 20 \w By his knowledge| strong="H1847" \w* \w the depths| strong="H8415" \w* [are broken up]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and the clouds| strong="H7834" \w* [drop down]{strong=“H7491” x-morph=“strongMorph: \sc Th\sc*8799”} \w the dew| strong="H2919" \w*. 
\p
\v 21 \w My son| strong="H1121" \w*, [let not them depart]{strong=“H3868” x-morph=“strongMorph: \sc Th\sc*8799”} \w from thine eyes| strong="H5869" \w*: [keep]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8798”} \w sound wisdom| strong="H8454" \w* \w and discretion| strong="H4209" \w*: 
\v 22 \w So shall they be life| strong="H2416" \w* \w unto thy soul| strong="H5315" \w*, \w and grace| strong="H2580" \w* \w to thy neck| strong="H1621" \w*. 
\v 23 [Then shalt thou walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy way| strong="H1870" \w* \w safely| strong="H983" \w*, \w and thy foot| strong="H7272" \w* [shall not stumble]{strong=“H5062” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 24 [When thou liest down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”}, [thou shalt not be afraid]{strong=“H6342” x-morph=“strongMorph: \sc Th\sc*8799”}: [yea, thou shalt lie down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and thy sleep| strong="H8142" \w* [shall be sweet]{strong=“H6149” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 25 [Be not afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w of sudden| strong="H6597" \w* \w fear| strong="H6343" \w*, \w neither of the desolation| strong="H7722" \w* \w of the wicked| strong="H7563" \w*, [when it cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 26 For the \sc Lord\sc* \w shall be thy confidence| strong="H3689" \w*, [and shall keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy foot| strong="H7272" \w* \w from being taken| strong="H3921" \w*. 
\p
\v 27 [Withhold]{strong=“H4513” x-morph=“strongMorph: \sc Th\sc*8799”} \w not good| strong="H2896" \w* \w from them to whom it is due| strong="H1167" \w*, \w when it is in the power| strong="H410" \w* \w of thine hand| strong="H3027" \w* [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} it.\f + \fr 3:27 \ft them…: Heb. the owners thereof \f* 
\v 28 [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w not unto thy neighbour| strong="H7453" \w*, [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [and come again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”}, \w and to morrow| strong="H4279" \w* [I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”}; \w when thou hast| strong="H3426" \w* it by thee. 
\v 29 [Devise]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8799”} \w not evil| strong="H7451" \w* \w against thy neighbour| strong="H7453" \w*, [seeing he dwelleth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w securely| strong="H983" \w* by thee.\f + \fr 3:29 \ft Devise…: or, Practise no evil \f* 
\p
\v 30 [Strive]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”} \w not with a man| strong="H120" \w* \w without cause| strong="H2600" \w*, [if he have done]{strong=“H1580” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee no harm| strong="H7451" \w*. 
\p
\v 31 [Envy]{strong=“H7065” x-morph=“strongMorph: \sc Th\sc*8762”} [thou not the oppressor]{strong=“H2555 H376”}, [and choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} \w none of his ways| strong="H1870" \w*.\f + \fr 3:31 \ft the oppressor: Heb. a man of violence \f* 
\v 32 [For the froward]{strong=“H3868” x-morph=“strongMorph: \sc Th\sc*8737”} is \w abomination| strong="H8441" \w* to the \sc Lord\sc*: \w but his secret| strong="H5475" \w* is \w with the righteous| strong="H3477" \w*. 
\p
\v 33 \w The curse| strong="H3994" \w* of the \sc Lord\sc* is \w in the house| strong="H1004" \w* \w of the wicked| strong="H7563" \w*: [but he blesseth]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w the habitation| strong="H5116" \w* \w of the just| strong="H6662" \w*. 
\v 34 [Surely he scorneth]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8686”} [the scorners]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8801”}: [but he giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w grace| strong="H2580" \w* [unto the lowly]{strong=“H6041 H6035” x-morph=“strongMorph: \sc Th\sc*8675”}. 
\v 35 \w The wise| strong="H2450" \w* [shall inherit]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8799”} \w glory| strong="H3519" \w*: \w but shame| strong="H7036" \w* [shall be the promotion]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8688”} \w of fools| strong="H3684" \w*.\f + \fr 3:35 \ft shall be…: Heb. exalteth the fools \f*
\c 4
\p 
\v 1 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, \w ye children| strong="H1121" \w*, \w the instruction| strong="H4148" \w* \w of a father| strong="H1" \w*, [and attend]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8685”} [to know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} \w understanding| strong="H998" \w*. 
\v 2 [For I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w you good| strong="H2896" \w* \w doctrine| strong="H3948" \w*, [forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w ye not my law| strong="H8451" \w*. 
\v 3 [For I was my father’s]{strong=“H1”} \w son| strong="H1121" \w*, \w tender| strong="H7390" \w* \w and only| strong="H3173" \w* beloved \w in the sight| strong="H6440" \w* \w of my mother| strong="H517" \w*. 
\v 4 [He taught]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”} [me also, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Let thine heart]{strong=“H3820”} [retain]{strong=“H8551” x-morph=“strongMorph: \sc Th\sc*8799”} \w my words| strong="H1697" \w*: [keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8798”} \w my commandments| strong="H4687" \w*, [and live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8798”}. 
\v 5 [Get]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8798”} \w wisdom| strong="H2451" \w*, [get]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8798”} \w understanding| strong="H998" \w*: [forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} it [not; neither decline]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the words| strong="H561" \w* \w of my mouth| strong="H6310" \w*. 
\v 6 [Forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} [her not, and she shall preserve]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} [thee: love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8798”} [her, and she shall keep]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8799”} thee. 
\v 7 \w Wisdom| strong="H2451" \w* is \w the principal thing| strong="H7225" \w*; therefore [get]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8798”} \w wisdom| strong="H2451" \w*: \w and with all thy getting| strong="H7075" \w* \w get understanding| strong="H998" \w*. 
\v 8 [Exalt]{strong=“H5549” x-morph=“strongMorph: \sc Th\sc*8769”} [her, and she shall promote]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8787”} [thee: she shall bring thee to honour]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8762”}, [when thou dost embrace]{strong=“H2263” x-morph=“strongMorph: \sc Th\sc*8762”} her. 
\v 9 [She shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w to thine head| strong="H7218" \w* \w an ornament| strong="H3880" \w* \w of grace| strong="H2580" \w*: \w a crown| strong="H5850" \w* \w of glory| strong="H8597" \w* [shall she deliver]{strong=“H4042” x-morph=“strongMorph: \sc Th\sc*8762”} to thee.\f + \fr 4:9 \ft a crown…: or, she shall compass thee with a crown of glory \f* 
\v 10 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O my son| strong="H1121" \w*, [and receive]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w my sayings| strong="H561" \w*; \w and the years| strong="H8141" \w* \w of thy life| strong="H2416" \w* [shall be many]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 11 [I have taught]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee in the way| strong="H1870" \w* \w of wisdom| strong="H2451" \w*; [I have led]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee in right| strong="H3476" \w* \w paths| strong="H4570" \w*. 
\v 12 [When thou goest]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”}, \w thy steps| strong="H6806" \w* [shall not be straitened]{strong=“H3334” x-morph=“strongMorph: \sc Th\sc*8799”}; [and when thou runnest]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”}, [thou shalt not stumble]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 13 [Take fast hold]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8685”} \w of instruction| strong="H4148" \w*; let her [not go]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8686”}: [keep]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8798”} her; for she is \w thy life| strong="H2416" \w*. 
\p
\v 14 [Enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w not into the path| strong="H734" \w* \w of the wicked| strong="H7563" \w*, [and go]{strong=“H833” x-morph=“strongMorph: \sc Th\sc*8762”} \w not in the way| strong="H1870" \w* \w of evil| strong="H7451" \w* men. 
\v 15 [Avoid]{strong=“H6544” x-morph=“strongMorph: \sc Th\sc*8798”} [it, pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} [not by it, turn]{strong=“H7847” x-morph=“strongMorph: \sc Th\sc*8798”} [from it, and pass away]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8798”}. 
\v 16 [For they sleep]{strong=“H3462” x-morph=“strongMorph: \sc Th\sc*8799”} [not, except they have done mischief]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8686”}; \w and their sleep| strong="H8142" \w* [is taken away]{strong=“H1497” x-morph=“strongMorph: \sc Th\sc*8738”}, unless they cause some [to fall]{strong=“H3782 H3782” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8686”}. 
\v 17 [For they eat]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8804”} \w the bread| strong="H3899" \w* \w of wickedness| strong="H7562" \w*, [and drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w the wine| strong="H3196" \w* \w of violence| strong="H2555" \w*. 
\v 18 \w But the path| strong="H734" \w* \w of the just| strong="H6662" \w* is \w as the shining| strong="H5051" \w* \w light| strong="H216" \w*, [that shineth]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8804”} [more]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} [and more unto the perfect]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8737”} \w day| strong="H3117" \w*. 
\v 19 \w The way| strong="H1870" \w* \w of the wicked| strong="H7563" \w* is \w as darkness| strong="H653" \w*: [they know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [not at what they stumble]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\p
\v 20 \w My son| strong="H1121" \w*, [attend]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8685”} \w to my words| strong="H1697" \w*; [incline]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8685”} \w thine ear| strong="H241" \w* \w unto my sayings| strong="H561" \w*. 
\v 21 [Let them not depart]{strong=“H3868” x-morph=“strongMorph: \sc Th\sc*8686”} \w from thine eyes| strong="H5869" \w*; [keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8798”} \w them in the midst| strong="H8432" \w* \w of thine heart| strong="H3824" \w*. 
\v 22 For they are \w life| strong="H2416" \w* [unto those that find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8802”} [them, and health]{strong=“H4832”} \w to all their flesh| strong="H1320" \w*.\f + \fr 4:22 \ft health: Heb. medicine \f* 
\p
\v 23 [Keep]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy heart| strong="H3820" \w* \w with all diligence| strong="H4929" \w*; for out of it are \w the issues| strong="H8444" \w* \w of life| strong="H2416" \w*.\f + \fr 4:23 \ft with…: Heb. above all keeping \f* 
\v 24 [Put away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8685”} \w from thee a froward| strong="H6143" \w* \w mouth| strong="H6310" \w*, \w and perverse| strong="H3891" \w* \w lips| strong="H8193" \w* [put far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8685”} from thee.\f + \fr 4:24 \ft a froward…: Heb. frowardness of mouth and perverseness of lips \f* 
\v 25 \w Let thine eyes| strong="H5869" \w* [look]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”} \w right on| strong="H5227" \w*, \w and let thine eyelids| strong="H6079" \w* [look straight]{strong=“H3474” x-morph=“strongMorph: \sc Th\sc*8686”} before thee. 
\v 26 [Ponder]{strong=“H6424” x-morph=“strongMorph: \sc Th\sc*8761”} \w the path| strong="H4570" \w* \w of thy feet| strong="H7272" \w*, \w and let all thy ways| strong="H1870" \w* [be established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 4:26 \ft let…: or, all thy ways shall be ordered aright \f* 
\v 27 [Turn]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8799”} \w not to the right hand| strong="H3225" \w* \w nor to the left| strong="H8040" \w*: [remove]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8685”} \w thy foot| strong="H7272" \w* \w from evil| strong="H7451" \w*.
\c 5
\p 
\v 1 \w My son| strong="H1121" \w*, [attend]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto my wisdom| strong="H2451" \w*, and [bow]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8685”} \w thine ear| strong="H241" \w* \w to my understanding| strong="H8394" \w*: 
\v 2 [That thou mayest regard]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w discretion| strong="H4209" \w*, and that \w thy lips| strong="H8193" \w* [may keep]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8799”} \w knowledge| strong="H1847" \w*. 
\p
\v 3 \w For the lips| strong="H8193" \w* [of a strange woman]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} [drop]{strong=“H5197” x-morph=“strongMorph: \sc Th\sc*8799”} as \w an honeycomb| strong="H5317" \w*, \w and her mouth| strong="H2441" \w* is \w smoother| strong="H2509" \w* \w than oil| strong="H8081" \w*:\f + \fr 5:3 \ft mouth: Heb. palate \f* 
\v 4 \w But her end| strong="H319" \w* \w is bitter| strong="H4751" \w* \w as wormwood| strong="H3939" \w*, \w sharp| strong="H2299" \w* \w as a twoedged| strong="H6310" \w* \w sword| strong="H2719" \w*. 
\v 5 \w Her feet| strong="H7272" \w* [go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w to death| strong="H4194" \w*; \w her steps| strong="H6806" \w* [take hold]{strong=“H8551” x-morph=“strongMorph: \sc Th\sc*8799”} \w on hell| strong="H7585" \w*. 
