\c 18
\p 
\v 1 \w Through desire| strong="H8378" \w* [a man, having separated]{strong=“H6504” x-morph=“strongMorph: \sc Th\sc*8737”} [himself, seeketh]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} and [intermeddleth]{strong=“H1566” x-morph=“strongMorph: \sc Th\sc*8691”} \w with all wisdom| strong="H8454" \w*.\f + \fr 18:1 \ft Through…: or, He that separateth himself seeketh according to his desire, and intermeddleth in every business \f* 
\v 2 \w A fool| strong="H3684" \w* [hath no delight]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8799”} \w in understanding| strong="H8394" \w*, \w but that his heart| strong="H3820" \w* [may discover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8692”} itself. 
\v 3 \w When the wicked| strong="H7563" \w* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}, then [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w also contempt| strong="H937" \w*, \w and with ignominy| strong="H7036" \w* \w reproach| strong="H2781" \w*. 
\v 4 \w The words| strong="H1697" \w* [of a man’s]{strong=“H376”} \w mouth| strong="H6310" \w* are as \w deep| strong="H6013" \w* \w waters| strong="H4325" \w*, and \w the wellspring| strong="H4726" \w* \w of wisdom| strong="H2451" \w* as [a flowing]{strong=“H5042” x-morph=“strongMorph: \sc Th\sc*8802”} \w brook| strong="H5158" \w*. 
\v 5 It is \w not good| strong="H2896" \w* [to accept]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8800”} \w the person| strong="H6440" \w* \w of the wicked| strong="H7563" \w*, [to overthrow]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8687”} \w the righteous| strong="H6662" \w* \w in judgment| strong="H4941" \w*. 
\p
\v 6 [A fool’s]{strong=“H3684”} \w lips| strong="H8193" \w* [enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into contention| strong="H7379" \w*, \w and his mouth| strong="H6310" \w* [calleth]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w for strokes| strong="H4112" \w*. 
\v 7 [A fool’s]{strong=“H3684”} \w mouth| strong="H6310" \w* is \w his destruction| strong="H4288" \w*, \w and his lips| strong="H8193" \w* are \w the snare| strong="H4170" \w* \w of his soul| strong="H5315" \w*. 
\v 8 \w The words| strong="H1697" \w* \w of a talebearer| strong="H5372" \w* are [as wounds]{strong=“H3859” x-morph=“strongMorph: \sc Th\sc*8693”}, [and they go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the innermost parts| strong="H2315" \w* \w of the belly| strong="H990" \w*.\f + \fr 18:8 \ft talebearer: or, whisperer \f* \f + \fr 18:8 \ft as wounds: or, like as when men are wounded \f* \f + \fr 18:8 \ft innermost…: Heb. chambers \f* 
\v 9 [He also that is slothful]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8693”} \w in his work| strong="H4399" \w* \w is brother| strong="H251" \w* \w to him that is a great| strong="H1167" \w* [waster]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 10 \w The name| strong="H8034" \w* of the \sc Lord\sc* is \w a strong| strong="H5797" \w* \w tower| strong="H4026" \w*: \w the righteous| strong="H6662" \w* [runneth]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”} [into it, and is safe]{strong=“H7682” x-morph=“strongMorph: \sc Th\sc*8738”}.\f + \fr 18:10 \ft safe: Heb. set aloft \f* 
\v 11 [The rich man’s]{strong=“H6223”} \w wealth| strong="H1952" \w* is \w his strong| strong="H5797" \w* \w city| strong="H7151" \w*, [and as an high]{strong=“H7682” x-morph=“strongMorph: \sc Th\sc*8737”} \w wall| strong="H2346" \w* \w in his own conceit| strong="H4906" \w*. 
\v 12 \w Before| strong="H6440" \w* \w destruction| strong="H7667" \w* \w the heart| strong="H3820" \w* \w of man| strong="H376" \w* [is haughty]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and before| strong="H6440" \w* \w honour| strong="H3519" \w* is \w humility| strong="H6038" \w*. 
\v 13 [He that answereth]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8688”} \w a matter| strong="H1697" \w* [before he heareth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} it, it is \w folly| strong="H200" \w* \w and shame| strong="H3639" \w* unto him.\f + \fr 18:13 \ft answereth…: Heb. returneth a word \f* 
\v 14 \w The spirit| strong="H7307" \w* \w of a man| strong="H376" \w* [will sustain]{strong=“H3557” x-morph=“strongMorph: \sc Th\sc*8770”} \w his infirmity| strong="H4245" \w*; \w but a wounded| strong="H5218" \w* \w spirit| strong="H7307" \w* [who can bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”}? 
\v 15 \w The heart| strong="H3820" \w* [of the prudent]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8737”} [getteth]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8799”} \w knowledge| strong="H1847" \w*; \w and the ear| strong="H241" \w* \w of the wise| strong="H2450" \w* [seeketh]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w knowledge| strong="H1847" \w*. 
\v 16 [A man’s]{strong=“H120”} \w gift| strong="H4976" \w* [maketh room]{strong=“H7337” x-morph=“strongMorph: \sc Th\sc*8686”} [for him, and bringeth]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8686”} \w him before| strong="H6440" \w* \w great men| strong="H1419" \w*. 
\v 17 He that is \w first| strong="H7223" \w* \w in his own cause| strong="H7379" \w* seemeth \w just| strong="H6662" \w*; \w but his neighbour| strong="H7453" \w* [cometh]{strong=“H935 H935” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8804”} [and searcheth]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8804”} him. 
\v 18 \w The lot| strong="H1486" \w* \w causeth contentions| strong="H4079" \w* [to cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8686”}, [and parteth]{strong=“H6504” x-morph=“strongMorph: \sc Th\sc*8686”} \w between the mighty| strong="H6099" \w*. 
\v 19 \w A brother| strong="H251" \w* [offended]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8737”} is harder to be won \w than a strong| strong="H5797" \w* \w city| strong="H7151" \w*: and their [contentions ]{strong=“H4066 H4079” x-morph=“strongMorph: \sc Th\sc*8675”} are \w like the bars| strong="H1280" \w* \w of a castle| strong="H759" \w*. 
\v 20 [A man’s]{strong=“H376”} \w belly| strong="H990" \w* [shall be satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the fruit| strong="H6529" \w* \w of his mouth| strong="H6310" \w*; and \w with the increase| strong="H8393" \w* \w of his lips| strong="H8193" \w* [shall he be filled]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 21 \w Death| strong="H4194" \w* \w and life| strong="H2416" \w* are \w in the power| strong="H3027" \w* \w of the tongue| strong="H3956" \w*: [and they that love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} [it shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the fruit| strong="H6529" \w* thereof. 
\v 22 Whoso [findeth]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w a wife| strong="H802" \w* [findeth]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w a good| strong="H2896" \w* thing, [and obtaineth]{strong=“H6329” x-morph=“strongMorph: \sc Th\sc*8686”} \w favour| strong="H7522" \w* of the \sc Lord\sc*. 
\v 23 [The poor]{strong=“H7326” x-morph=“strongMorph: \sc Th\sc*8802”} [useth]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w intreaties| strong="H8469" \w*; \w but the rich| strong="H6223" \w* [answereth]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w roughly| strong="H5794" \w*. 
\v 24 \w A man| strong="H376" \w* that hath \w friends| strong="H7453" \w* [must shew himself friendly]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8710”}: \w and there is| strong="H3426" \w* [a friend]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} that \w sticketh closer| strong="H1695" \w* \w than a brother| strong="H251" \w*.
\c 19
\p 
\v 1 \w Better| strong="H2896" \w* is [the poor]{strong=“H7326” x-morph=“strongMorph: \sc Th\sc*8802”} [that walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w in his integrity| strong="H8537" \w*, than he that is \w perverse| strong="H6141" \w* \w in his lips| strong="H8193" \w*, \w and is a fool| strong="H3684" \w*. 
\v 2 Also, that \w the soul| strong="H5315" \w* be \w without knowledge| strong="H1847" \w*, it is \w not good| strong="H2896" \w*; [and he that hasteth]{strong=“H213” x-morph=“strongMorph: \sc Th\sc*8801”} with his \w feet| strong="H7272" \w* [sinneth]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 3 \w The foolishness| strong="H200" \w* \w of man| strong="H120" \w* [perverteth]{strong=“H5557” x-morph=“strongMorph: \sc Th\sc*8762”} \w his way| strong="H1870" \w*: \w and his heart| strong="H3820" \w* [fretteth]{strong=“H2196” x-morph=“strongMorph: \sc Th\sc*8799”} against the \sc Lord\sc*. 
\v 4 \w Wealth| strong="H1952" \w* [maketh]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w many| strong="H7227" \w* \w friends| strong="H7453" \w*; \w but the poor| strong="H1800" \w* [is separated]{strong=“H6504” x-morph=“strongMorph: \sc Th\sc*8735”} \w from his neighbour| strong="H7453" \w*. 
\v 5 \w A false| strong="H8267" \w* \w witness| strong="H5707" \w* [shall not be unpunished]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8735”}, and he that [speaketh]{strong=“H6315” x-morph=“strongMorph: \sc Th\sc*8686”} \w lies| strong="H3577" \w* [shall not escape]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 19:5 \ft unpunished: Heb. held innocent \f* 
\p
\v 6 \w Many| strong="H7227" \w* [will intreat]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8762”} \w the favour| strong="H6440" \w* \w of the prince| strong="H5081" \w*: and every man is \w a friend| strong="H7453" \w* \w to him| strong="H376" \w* \w that giveth gifts| strong="H4976" \w*.\f + \fr 19:6 \ft him…: Heb. a man of gifts \f* 
\v 7 \w All the brethren| strong="H251" \w* [of the poor]{strong=“H7326” x-morph=“strongMorph: \sc Th\sc*8802”} [do hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”} [him: how much more do his friends]{strong=“H4828”} [go far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8804”} [from him? he pursueth]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8764”} them with \w words| strong="H561" \w*, yet they are wanting to him. 
\v 8 [He that getteth]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8802”} \w wisdom| strong="H3820" \w* [loveth]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} \w his own soul| strong="H5315" \w*: [he that keepeth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w understanding| strong="H8394" \w* [shall find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8800”} \w good| strong="H2896" \w*.\f + \fr 19:8 \ft wisdom: Heb. an heart \f* 
\v 9 \w A false| strong="H8267" \w* \w witness| strong="H5707" \w* [shall not be unpunished]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8735”}, and he that [speaketh]{strong=“H6315” x-morph=“strongMorph: \sc Th\sc*8686”} \w lies| strong="H3577" \w* [shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 10 \w Delight| strong="H8588" \w* \w is not seemly| strong="H5000" \w* \w for a fool| strong="H3684" \w*; \w much less for a servant| strong="H5650" \w* [to have rule]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8800”} \w over princes| strong="H8269" \w*. 
\v 11 \w The discretion| strong="H7922" \w* \w of a man| strong="H120" \w* [deferreth]{strong=“H748” x-morph=“strongMorph: \sc Th\sc*8689”} \w his anger| strong="H639" \w*; and it is \w his glory| strong="H8597" \w* [to pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8800”} \w a transgression| strong="H6588" \w*.\f + \fr 19:11 \ft discretion: or, prudence \f* 
\v 12 [The king’s]{strong=“H4428”} \w wrath| strong="H2197" \w* is \w as the roaring| strong="H5099" \w* \w of a lion| strong="H3715" \w*; \w but his favour| strong="H7522" \w* is \w as dew| strong="H2919" \w* \w upon the grass| strong="H6212" \w*. 
\v 13 \w A foolish| strong="H3684" \w* \w son| strong="H1121" \w* is \w the calamity| strong="H1942" \w* \w of his father| strong="H1" \w*: \w and the contentions| strong="H4079" \w* \w of a wife| strong="H802" \w* are [a continual]{strong=“H2956” x-morph=“strongMorph: \sc Th\sc*8802”} \w dropping| strong="H1812" \w*. 
\v 14 \w House| strong="H1004" \w* \w and riches| strong="H1952" \w* are \w the inheritance| strong="H5159" \w* \w of fathers| strong="H1" \w*: [and a prudent]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8688”} \w wife| strong="H802" \w* is from the \sc Lord\sc*. 
\v 15 \w Slothfulness| strong="H6103" \w* [casteth]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8686”} \w into a deep sleep| strong="H8639" \w*; \w and an idle| strong="H7423" \w* \w soul| strong="H5315" \w* [shall suffer hunger]{strong=“H7456” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 16 [He that keepeth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w the commandment| strong="H4687" \w* [keepeth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w his own soul| strong="H5315" \w*; but [he that despiseth]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8802”} \w his ways| strong="H1870" \w* [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 17 [He that hath pity]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the poor| strong="H1800" \w* [lendeth ]{strong=“H3867” x-morph=“strongMorph: \sc Th\sc*8688”} unto the \sc Lord\sc*; \w and that which he hath given| strong="H1576" \w* [will he pay him again]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”}.\f + \fr 19:17 \ft that which…: or, his deed \f* 
\v 18 [Chasten]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8761”} \w thy son| strong="H1121" \w* \w while there is| strong="H3426" \w* \w hope| strong="H8615" \w*, \w and let not thy soul| strong="H5315" \w* [spare]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} [for his crying]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8687”}.\f + \fr 19:18 \ft for…: or, to his destruction: or, to cause him to die \f* 
\v 19 \w A man| strong="H1419" \w* \w of great| strong="H1632" \w* \w wrath| strong="H2534" \w* [shall suffer]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8802”} \w punishment| strong="H6066" \w*: [for if thou deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} him, [yet thou must do it again]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”}.\f + \fr 19:19 \ft do: Heb. add \f* 
\v 20 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w counsel| strong="H6098" \w*, [and receive]{strong=“H6901” x-morph=“strongMorph: \sc Th\sc*8761”} \w instruction| strong="H4148" \w*, [that thou mayest be wise]{strong=“H2449” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy latter end| strong="H319" \w*. 
\v 21 There are \w many| strong="H7227" \w* \w devices| strong="H4284" \w* [in a man’s]{strong=“H376”} \w heart| strong="H3820" \w*; \w nevertheless the counsel| strong="H6098" \w* of the \sc Lord\sc*, [that shall stand]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 22 \w The desire| strong="H8378" \w* \w of a man| strong="H120" \w* is \w his kindness| strong="H2617" \w*: [and a poor man]{strong=“H7326” x-morph=“strongMorph: \sc Th\sc*8802”} is \w better| strong="H2896" \w* \w than| strong="H376" \w* \w a liar| strong="H3577" \w*. 
\v 23 \w The fear| strong="H3374" \w* of the \sc Lord\sc* tendeth \w to life| strong="H2416" \w*: and he that hath it [shall abide]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} \w satisfied| strong="H7649" \w*; [he shall not be visited]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8735”} \w with evil| strong="H7451" \w*. 
\v 24 \w A slothful| strong="H6102" \w* man [hideth]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8804”} \w his hand| strong="H3027" \w* in his \w bosom| strong="H6747" \w*, \w and will not so much as bring| strong="H7725" \w* \w it to his mouth| strong="H6310" \w* [again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 25 [Smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} [a scorner]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8801”}, \w and the simple| strong="H6612" \w* [will beware]{strong=“H6191” x-morph=“strongMorph: \sc Th\sc*8686”}: [and reprove]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8689”} [one that hath understanding]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8737”}, and [he will understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} \w knowledge| strong="H1847" \w*.\f + \fr 19:25 \ft will beware: Heb. will be cunning \f* 
\v 26 [He that wasteth]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8764”} his \w father| strong="H1" \w*, and [chaseth away]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8686”} his \w mother| strong="H517" \w*, is \w a son| strong="H1121" \w* [that causeth shame]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8688”}, [and bringeth reproach]{strong=“H2659” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 27 [Cease]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8798”}, \w my son| strong="H1121" \w*, [to hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w the instruction| strong="H4148" \w* that causeth [to err]{strong=“H7686” x-morph=“strongMorph: \sc Th\sc*8800”} \w from the words| strong="H561" \w* \w of knowledge| strong="H1847" \w*. 
\v 28 \w An ungodly| strong="H1100" \w* \w witness| strong="H5707" \w* [scorneth]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8686”} \w judgment| strong="H4941" \w*: \w and the mouth| strong="H6310" \w* \w of the wicked| strong="H7563" \w* [devoureth ]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8762”} \w iniquity| strong="H205" \w*.\f + \fr 19:28 \ft An…: Heb. A witness of Belial \f* 
\v 29 \w Judgments| strong="H8201" \w* [are prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8738”} [for scorners]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8801”}, \w and stripes| strong="H4112" \w* \w for the back| strong="H1460" \w* \w of fools| strong="H3684" \w*.
\c 20
\p 
\v 1 \w Wine| strong="H3196" \w* is [a mocker]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8801”}, \w strong drink| strong="H7941" \w* is [raging]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8802”}: [and whosoever is deceived]{strong=“H7686” x-morph=“strongMorph: \sc Th\sc*8802”} [thereby is not wise]{strong=“H2449” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 2 \w The fear| strong="H367" \w* \w of a king| strong="H4428" \w* is \w as the roaring| strong="H5099" \w* \w of a lion| strong="H3715" \w*: whoso [provoketh him to anger]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8693”} [sinneth]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8802”} against \w his own soul| strong="H5315" \w*. 
\v 3 It is \w an honour| strong="H3519" \w* \w for a man| strong="H376" \w* \w to cease| strong="H7674" \w* \w from strife| strong="H7379" \w*: \w but every fool| strong="H191" \w* [will be meddling]{strong=“H1566” x-morph=“strongMorph: \sc Th\sc*8691”}. 
\v 4 \w The sluggard| strong="H6102" \w* [will not plow]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8799”} \w by reason of the cold| strong="H2779" \w*; therefore [shall he beg]{strong=“H7592 H7592” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8804”} \w in harvest| strong="H7105" \w*, and have nothing.\f + \fr 20:4 \ft cold: or, winter \f* 
\v 5 \w Counsel| strong="H6098" \w* \w in the heart| strong="H3820" \w* \w of man| strong="H376" \w* is like \w deep| strong="H6013" \w* \w water| strong="H4325" \w*; \w but a man| strong="H376" \w* \w of understanding| strong="H8394" \w* [will draw it out]{strong=“H1802” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 6 \w Most| strong="H7230" \w* \w men| strong="H120" \w* [will proclaim]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w every one| strong="H376" \w* \w his own goodness| strong="H2617" \w*: \w but a faithful| strong="H529" \w* \w man| strong="H376" \w* [who can find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”}?\f + \fr 20:6 \ft goodness: or, bounty \f* 
\v 7 \w The just| strong="H6662" \w* man [walketh ]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8693”} \w in his integrity| strong="H8537" \w*: \w his children| strong="H1121" \w* are \w blessed| strong="H835" \w* \w after| strong="H310" \w* him. 
\v 8 \w A king| strong="H4428" \w* [that sitteth in]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w the throne| strong="H3678" \w* \w of judgment| strong="H1779" \w* [scattereth away]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8764”} \w all evil| strong="H7451" \w* \w with his eyes| strong="H5869" \w*. 
\v 9 [Who can say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w I have made my heart| strong="H3820" \w* [clean]{strong=“H2135” x-morph=“strongMorph: \sc Th\sc*8765”}, [I am pure]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8804”} \w from my sin| strong="H2403" \w*? 
\v 10 [Divers weights]{strong=“H68 H68”}, and [divers measures]{strong=“H374 H374”}, \w both| strong="H8147" \w* of them are \w alike| strong="H1571" \w* \w abomination| strong="H8441" \w* to the \sc Lord\sc*.\f + \fr 20:10 \ft Divers weights: Heb. A stone and a stone \f* \f + \fr 20:10 \ft divers measures: Heb. an ephah and an ephah \f* 
\v 11 \w Even a child| strong="H5288" \w* [is known]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8691”} \w by his doings| strong="H4611" \w*, \w whether his work| strong="H6467" \w* be \w pure| strong="H2134" \w*, and whether it be \w right| strong="H3477" \w*. 
