\v 26 [He that trusteth]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”} \w in his own heart| strong="H3820" \w* \w is a fool| strong="H3684" \w*: [but whoso walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w wisely| strong="H2451" \w*, [he shall be delivered]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 27 [He that giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} [unto the poor]{strong=“H7326” x-morph=“strongMorph: \sc Th\sc*8802”} \w shall not lack| strong="H4270" \w*: [but he that hideth]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8688”} \w his eyes| strong="H5869" \w* \w shall have many| strong="H7227" \w* \w a curse| strong="H3994" \w*. 
\v 28 \w When the wicked| strong="H7563" \w* [rise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8800”}, \w men| strong="H120" \w* [hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8735”} [themselves: but when they perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8800”}, \w the righteous| strong="H6662" \w* [increase]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8799”}.
\c 29
\p 
\v 1 \w He| strong="H376" \w*, \w that being often reproved| strong="H8433" \w* [hardeneth]{strong=“H7185” x-morph=“strongMorph: \sc Th\sc*8688”} his \w neck| strong="H6203" \w*, \w shall suddenly| strong="H6621" \w* [be destroyed]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8735”}, \w and that without remedy| strong="H4832" \w*.\f + \fr 29:1 \ft He…: Heb. A man of reproofs \f* 
\v 2 \w When the righteous| strong="H6662" \w* [are in authority]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8800”}, \w the people| strong="H5971" \w* [rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”}: \w but when the wicked| strong="H7563" \w* [beareth rule]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8800”}, \w the people| strong="H5971" \w* [mourn]{strong=“H584” x-morph=“strongMorph: \sc Th\sc*8735”}. \f + \fr 29:2 \ft in…: or, increased \f* 
\v 3 \w Whoso| strong="H376" \w* [loveth]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} \w wisdom| strong="H2451" \w* [rejoiceth]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8762”} \w his father| strong="H1" \w*: [but he that keepeth company]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [with harlots]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”} [spendeth]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8762”} his \w substance| strong="H1952" \w*. 
\v 4 \w The king| strong="H4428" \w* \w by judgment| strong="H4941" \w* [establisheth]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8686”} \w the land| strong="H776" \w*: \w but he| strong="H376" \w* \w that receiveth gifts| strong="H8641" \w* [overthroweth]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8799”} it.\f + \fr 29:4 \ft he…: Heb. a man of oblations \f* 
\v 5 \w A man| strong="H1397" \w* [that flattereth]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8688”} \w his neighbour| strong="H7453" \w* [spreadeth]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8802”} \w a net| strong="H7568" \w* \w for his feet| strong="H6471" \w*. 
\v 6 \w In the transgression| strong="H6588" \w* \w of an evil| strong="H7451" \w* \w man| strong="H376" \w* there is \w a snare| strong="H4170" \w*: \w but the righteous| strong="H6662" \w* [doth sing]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8799”} \w and rejoice| strong="H8056" \w*. 
\v 7 \w The righteous| strong="H6662" \w* [considereth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w the cause| strong="H1779" \w* \w of the poor| strong="H1800" \w*: but \w the wicked| strong="H7563" \w* [regardeth]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} \w not to know| strong="H1847" \w* it. 
\v 8 \w Scornful| strong="H3944" \w* \w men| strong="H582" \w* \w bring| strong="H6315" \w* \w a city| strong="H7151" \w* [into a snare]{strong=“H6315” x-morph=“strongMorph: \sc Th\sc*8686”}: \w but wise| strong="H2450" \w* men [turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w wrath| strong="H639" \w*.\f + \fr 29:8 \ft bring…: or, set a city on fire \f* 
\v 9 If \w a wise| strong="H2450" \w* \w man| strong="H376" \w* [contendeth]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8737”} \w with a foolish| strong="H191" \w* \w man| strong="H376" \w*, [whether he rage]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8804”} [or laugh]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8804”}, there is \w no rest| strong="H5183" \w*. 
\v 10 [The bloodthirsty]{strong=“H1818 H582”} [hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8799”} \w the upright| strong="H8535" \w*: \w but the just| strong="H3477" \w* [seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w his soul| strong="H5315" \w*.\f + \fr 29:10 \ft The bloodthirsty: Heb. Men of blood \f* 
\v 11 \w A fool| strong="H3684" \w* [uttereth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w all his mind| strong="H7307" \w*: \w but a wise| strong="H2450" \w* man [keepeth]{strong=“H7623” x-morph=“strongMorph: \sc Th\sc*8762”} \w it in till afterwards| strong="H268" \w*. 
\v 12 [If a ruler]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8802”} [hearken]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8688”} [to lies]{strong=“H8267 H1697”}, [all his servants]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8764”} are \w wicked| strong="H7563" \w*. 
\v 13 [The poor]{strong=“H7326” x-morph=“strongMorph: \sc Th\sc*8802”} \w and the deceitful| strong="H8501" \w* \w man| strong="H376" \w* [meet together]{strong=“H6298” x-morph=“strongMorph: \sc Th\sc*8738”}: the \sc Lord\sc* [lighteneth]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8688”} \w both| strong="H8147" \w* \w their eyes| strong="H5869" \w*.\f + \fr 29:13 \ft the deceitful…: or, the usurer \f* 
\v 14 \w The king| strong="H4428" \w* \w that faithfully| strong="H571" \w* [judgeth]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} \w the poor| strong="H1800" \w*, \w his throne| strong="H3678" \w* [shall be established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8735”} \w for ever| strong="H5703" \w*. 
\v 15 \w The rod| strong="H7626" \w* \w and reproof| strong="H8433" \w* [give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w wisdom| strong="H2451" \w*: \w but a child| strong="H5288" \w* [left]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8794”} to himself \w bringeth his mother| strong="H517" \w* [to shame]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 16 \w When the wicked| strong="H7563" \w* [are multiplied]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8800”}, \w transgression| strong="H6588" \w* [increaseth]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8799”}: \w but the righteous| strong="H6662" \w* [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w their fall| strong="H4658" \w*. 
\v 17 [Correct]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8761”} \w thy son| strong="H1121" \w*, [and he shall give thee rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8686”}; [yea, he shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w delight| strong="H4574" \w* \w unto thy soul| strong="H5315" \w*. 
\v 18 Where there is \w no vision| strong="H2377" \w*, \w the people| strong="H5971" \w* [perish]{strong=“H6544” x-morph=“strongMorph: \sc Th\sc*8735”}: [but he that keepeth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w the law| strong="H8451" \w*, \w happy| strong="H835" \w* is he.\f + \fr 29:18 \ft perish: or, is made naked \f* 
\v 19 \w A servant| strong="H5650" \w* [will not be corrected]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8735”} \w by words| strong="H1697" \w*: [for though he understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} \w he will not answer| strong="H4617" \w*. 
\v 20 [Seest]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8804”} \w thou a man| strong="H376" \w* that is [hasty]{strong=“H213” x-morph=“strongMorph: \sc Th\sc*8801”} \w in his words| strong="H1697" \w*? there is \w more hope| strong="H8615" \w* \w of a fool| strong="H3684" \w* than of him.\f + \fr 29:20 \ft words: or, matters? \f* 
\v 21 [He that delicately bringeth up]{strong=“H6445” x-morph=“strongMorph: \sc Th\sc*8764”} \w his servant| strong="H5650" \w* \w from a child| strong="H5290" \w* shall have him become his \w son| strong="H4497" \w* \w at the length| strong="H319" \w*. 
\v 22 \w An angry| strong="H639" \w* \w man| strong="H376" \w* [stirreth up]{strong=“H1624” x-morph=“strongMorph: \sc Th\sc*8762”} \w strife| strong="H4066" \w*, \w and a furious| strong="H2534" \w* \w man| strong="H1167" \w* \w aboundeth in| strong="H7227" \w* \w transgression| strong="H6588" \w*. 
\v 23 [A man’s]{strong=“H120”} \w pride| strong="H1346" \w* [shall bring him low]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8686”}: \w but honour| strong="H3519" \w* [shall uphold]{strong=“H8551” x-morph=“strongMorph: \sc Th\sc*8799”} \w the humble| strong="H8217" \w* \w in spirit| strong="H7307" \w*. 
\v 24 [Whoso is partner]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8802”} \w with a thief| strong="H1590" \w* [hateth ]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} \w his own soul| strong="H5315" \w*: [he heareth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w cursing| strong="H423" \w*, [and bewrayeth]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} it not. 
\v 25 \w The fear| strong="H2731" \w* \w of man| strong="H120" \w* [bringeth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w a snare| strong="H4170" \w*: [but whoso putteth his trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”} in the \sc Lord\sc* [shall be safe]{strong=“H7682” x-morph=“strongMorph: \sc Th\sc*8792”}.\f + \fr 29:25 \ft safe: Heb. set on high \f* 
\v 26 \w Many| strong="H7227" \w* [seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} [the ruler’s]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8802”} \w favour| strong="H6440" \w*; but every [man’s]{strong=“H376”} \w judgment| strong="H4941" \w* cometh from the \sc Lord\sc*.\f + \fr 29:26 \ft the ruler’s…: Heb. the face of a ruler \f* 
\v 27 \w An unjust| strong="H5766" \w* \w man| strong="H376" \w* is \w an abomination| strong="H8441" \w* \w to the just| strong="H6662" \w*: and he that is \w upright| strong="H3477" \w* \w in the way| strong="H1870" \w* is \w abomination| strong="H8441" \w* \w to the wicked| strong="H7563" \w*.
\c 30
\p 
\v 1 \w The words| strong="H1697" \w* \w of Agur| strong="H94" \w* \w the son| strong="H1121" \w* \w of Jakeh| strong="H3348" \w*, even \w the prophecy| strong="H4853" \w*: \w the man| strong="H1397" \w* [spake]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w unto Ithiel| strong="H384" \w*, \w even unto Ithiel| strong="H384" \w* \w and Ucal| strong="H401" \w*, 
\v 2 Surely I am \w more brutish| strong="H1198" \w* than any \w man| strong="H376" \w*, \w and have not the understanding| strong="H998" \w* \w of a man| strong="H120" \w*. 
\v 3 [I neither learned]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8804”} \w wisdom| strong="H2451" \w*, [nor have]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w the knowledge| strong="H1847" \w* \w of the holy| strong="H6918" \w*.\f + \fr 30:3 \ft have: Heb. know \f* 
\v 4 [Who hath ascended up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w into heaven| strong="H8064" \w*, [or descended]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”}? [who hath gathered]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8804”} \w the wind| strong="H7307" \w* \w in his fists| strong="H2651" \w*? [who hath bound]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8804”} \w the waters| strong="H4325" \w* \w in a garment| strong="H8071" \w*? [who hath established]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} \w all the ends| strong="H657" \w* \w of the earth| strong="H776" \w*? what is \w his name| strong="H8034" \w*, and what is [his son’s]{strong=“H1121”} \w name| strong="H8034" \w*, [if thou canst tell]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”}? 
\v 5 \w Every word| strong="H565" \w* \w of God| strong="H433" \w* is [pure]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8803”}: he is \w a shield| strong="H4043" \w* [unto them that put their trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8802”} in him.\f + \fr 30:5 \ft pure: Heb. purified \f* 
\v 6 [Add]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w thou not unto his words| strong="H1697" \w*, [lest he reprove]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”} [thee, and thou be found a liar]{strong=“H3576” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\p
\v 7 \w Two| strong="H8147" \w* things [have I required]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8804”} [of thee; deny]{strong=“H4513” x-morph=“strongMorph: \sc Th\sc*8799”} me them [not before I die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}:\f + \fr 30:7 \ft deny…: Heb. withhold not from me \f* 
\v 8 [Remove far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8685”} \w from me vanity| strong="H7723" \w* [and lies]{strong=“H3577 H1697”}: [give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w me neither poverty| strong="H7389" \w* \w nor riches| strong="H6239" \w*; [feed]{strong=“H2963” x-morph=“strongMorph: \sc Th\sc*8685”} \w me with food| strong="H3899" \w* \w convenient| strong="H2706" \w* for me:\f + \fr 30:8 \ft convenient…: Heb. of my allowance \f* 
\v 9 [Lest I be full]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”}, [and deny]{strong=“H3584” x-morph=“strongMorph: \sc Th\sc*8765”} thee, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, Who is the \sc Lord\sc*? [or lest I be poor]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8735”}, [and steal]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8804”}, [and take]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8804”} \w the name| strong="H8034" \w* \w of my God| strong="H430" \w* in vain.\f + \fr 30:9 \ft deny…: Heb. belie thee \f* 
\p
\v 10 [Accuse]{strong=“H3960” x-morph=“strongMorph: \sc Th\sc*8686”} \w not a servant| strong="H5650" \w* \w unto his master| strong="H113" \w*, [lest he curse]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8762”} [thee, and thou be found guilty]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 30:10 \ft Accuse…: Heb. Hurt not with thy tongue \f* 
\v 11 There is \w a generation| strong="H1755" \w* that [curseth]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8762”} \w their father| strong="H1" \w*, [and doth not bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w their mother| strong="H517" \w*. 
\v 12 There is \w a generation| strong="H1755" \w* that are \w pure| strong="H2889" \w* \w in their own eyes| strong="H5869" \w*, and yet [is not washed]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8795”} \w from their filthiness| strong="H6675" \w*. 
\v 13 There is \w a generation| strong="H1755" \w*, [O how lofty]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8804”} \w are their eyes| strong="H5869" \w*! \w and their eyelids| strong="H6079" \w* [are lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 14 There is \w a generation| strong="H1755" \w*, \w whose teeth| strong="H8127" \w* are as \w swords| strong="H2719" \w*, \w and their jaw teeth| strong="H4973" \w* as \w knives| strong="H3979" \w*, [to devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} \w the poor| strong="H6041" \w* \w from off the earth| strong="H776" \w*, \w and the needy| strong="H34" \w* from among \w men| strong="H120" \w*. 
\p
\v 15 \w The horseleach| strong="H5936" \w* \w hath two| strong="H8147" \w* \w daughters| strong="H1323" \w*, crying, [Give]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”}, [give]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”}. \w There are three| strong="H7969" \w* things that [are never satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”}, yea, \w four| strong="H702" \w* things [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} not, It is \w enough| strong="H1952" \w*:\f + \fr 30:15 \ft It is…: Heb. Wealth \f* 
\v 16 \w The grave| strong="H7585" \w*; \w and the barren| strong="H6115" \w* \w womb| strong="H7356" \w*; \w the earth| strong="H776" \w* that [is not filled]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8804”} \w with water| strong="H4325" \w*; \w and the fire| strong="H784" \w* that [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} not, It is \w enough| strong="H1952" \w*. 
\v 17 \w The eye| strong="H5869" \w* that [mocketh ]{strong=“H3932” x-morph=“strongMorph: \sc Th\sc*8799”} at his \w father| strong="H1" \w*, [and despiseth]{strong=“H936” x-morph=“strongMorph: \sc Th\sc*8799”} \w to obey| strong="H3349" \w* his \w mother| strong="H517" \w*, \w the ravens| strong="H6158" \w* \w of the valley| strong="H5158" \w* [shall pick it out]{strong=“H5365” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the young| strong="H1121" \w* \w eagles| strong="H5404" \w* [shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} it.\f + \fr 30:17 \ft the valley: or, the brook \f* 
\p
\v 18 \w There be three| strong="H7969" \w* things which [are too wonderful]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8738”} [for me, yea, four]{strong=“H702”} [which I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} not: 
\v 19 \w The way| strong="H1870" \w* \w of an eagle| strong="H5404" \w* \w in the air| strong="H8064" \w*; \w the way| strong="H1870" \w* \w of a serpent| strong="H5175" \w* \w upon a rock| strong="H6697" \w*; \w the way| strong="H1870" \w* \w of a ship| strong="H591" \w* \w in the midst| strong="H3820" \w* \w of the sea| strong="H3220" \w*; \w and the way| strong="H1870" \w* \w of a man| strong="H1397" \w* \w with a maid| strong="H5959" \w*.\f + \fr 30:19 \ft midst: Heb. heart \f* 
\v 20 Such is \w the way| strong="H1870" \w* [of an adulterous]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8764”} \w woman| strong="H802" \w*; [she eateth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”}, [and wipeth]{strong=“H4229” x-morph=“strongMorph: \sc Th\sc*8804”} \w her mouth| strong="H6310" \w*, [and saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [I have done]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8804”} \w no wickedness| strong="H205" \w*. 
