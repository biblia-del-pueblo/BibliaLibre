\c 17
\p 
\v 1 \w Better| strong="H2896" \w* is \w a dry| strong="H2720" \w* \w morsel| strong="H6595" \w*, \w and quietness| strong="H7962" \w* [therewith, than an house]{strong=“H1004”} \w full| strong="H4392" \w* \w of sacrifices| strong="H2077" \w* with \w strife| strong="H7379" \w*.\f + \fr 17:1 \ft sacrifices: or, good cheer \f* 
