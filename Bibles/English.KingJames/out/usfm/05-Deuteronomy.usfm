\v 17 [Cursed]{strong=“H779” x-morph=“strongMorph: \sc Th\sc*8803”} be [he that removeth]{strong=“H5253” x-morph=“strongMorph: \sc Th\sc*8688”} [his neighbour’s]{strong=“H7453”} \w landmark| strong="H1366" \w*. \w And all the people| strong="H5971" \w* [shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Amen| strong="H543" \w*. 
\v 18 [Cursed]{strong=“H779” x-morph=“strongMorph: \sc Th\sc*8803”} be \w he that maketh the blind| strong="H5787" \w* [to wander]{strong=“H7686” x-morph=“strongMorph: \sc Th\sc*8688”} \w out of the way| strong="H1870" \w*. \w And all the people| strong="H5971" \w* [shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Amen| strong="H543" \w*. 
\v 19 [Cursed]{strong=“H779” x-morph=“strongMorph: \sc Th\sc*8803”} be [he that perverteth]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8688”} \w the judgment| strong="H4941" \w* \w of the stranger| strong="H1616" \w*, \w fatherless| strong="H3490" \w*, \w and widow| strong="H490" \w*. \w And all the people| strong="H5971" \w* [shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Amen| strong="H543" \w*. 
\v 20 [Cursed]{strong=“H779” x-morph=“strongMorph: \sc Th\sc*8803”} be [he that lieth]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8802”} [with his father’s]{strong=“H1”} \w wife| strong="H802" \w*; [because he uncovereth]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8765”} [his father’s]{strong=“H1”} \w skirt| strong="H3671" \w*. \w And all the people| strong="H5971" \w* [shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Amen| strong="H543" \w*. 
\v 21 [Cursed]{strong=“H779” x-morph=“strongMorph: \sc Th\sc*8803”} be [he that lieth]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8802”} \w with any manner of beast| strong="H929" \w*. \w And all the people| strong="H5971" \w* [shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Amen| strong="H543" \w*. 
\v 22 [Cursed]{strong=“H779” x-morph=“strongMorph: \sc Th\sc*8803”} be [he that lieth]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8802”} \w with his sister| strong="H269" \w*, \w the daughter| strong="H1323" \w* \w of his father| strong="H1" \w*, \w or the daughter| strong="H1323" \w* \w of his mother| strong="H517" \w*. \w And all the people| strong="H5971" \w* [shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Amen| strong="H543" \w*. 
\v 23 [Cursed]{strong=“H779” x-morph=“strongMorph: \sc Th\sc*8803”} be [he that lieth]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8802”} [with his mother in law]{strong=“H2859” x-morph=“strongMorph: \sc Th\sc*8802”}. \w And all the people| strong="H5971" \w* [shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Amen| strong="H543" \w*. 
\v 24 [Cursed]{strong=“H779” x-morph=“strongMorph: \sc Th\sc*8803”} be [he that smiteth]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8688”} \w his neighbour| strong="H7453" \w* \w secretly| strong="H5643" \w*. \w And all the people| strong="H5971" \w* [shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Amen| strong="H543" \w*. 
\v 25 [Cursed]{strong=“H779” x-morph=“strongMorph: \sc Th\sc*8803”} be [he that taketh]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8802”} \w reward| strong="H7810" \w* [to slay]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8687”} \w an innocent| strong="H5355" \w* [person]{strong=“H1818 H5315”}. \w And all the people| strong="H5971" \w* [shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Amen| strong="H543" \w*. 
\v 26 [Cursed]{strong=“H779” x-morph=“strongMorph: \sc Th\sc*8803”} be [he that confirmeth]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8686”} not all \w the words| strong="H1697" \w* \w of this law| strong="H8451" \w* [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [them. And all the people]{strong=“H5971”} [shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Amen| strong="H543" \w*. 
\c 28
\p 
\v 1 [And it shall come to pass, if thou shalt hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [diligently]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto the voice| strong="H6963" \w* of the \sc Lord\sc* \w thy God| strong="H430" \w*, [to observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} and [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w all his commandments| strong="H4687" \w* [which I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} \w thee this day| strong="H3117" \w*, that the \sc Lord\sc* \w thy God| strong="H430" \w* [will set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee on high| strong="H5945" \w* \w above all nations| strong="H1471" \w* \w of the earth| strong="H776" \w*: 
\v 2 \w And all these blessings| strong="H1293" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [on thee, and overtake]{strong=“H5381” x-morph=“strongMorph: \sc Th\sc*8689”} [thee, if thou shalt hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the voice| strong="H6963" \w* of the \sc Lord\sc* \w thy God| strong="H430" \w*. 
\v 3 [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} shalt thou be \w in the city| strong="H5892" \w*, [and blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} shalt thou be \w in the field| strong="H7704" \w*. 
\v 4 [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} shall be \w the fruit| strong="H6529" \w* \w of thy body| strong="H990" \w*, \w and the fruit| strong="H6529" \w* \w of thy ground| strong="H127" \w*, \w and the fruit| strong="H6529" \w* \w of thy cattle| strong="H929" \w*, \w the increase| strong="H7698" \w* \w of thy kine| strong="H504" \w*, \w and the flocks| strong="H6251" \w* \w of thy sheep| strong="H6629" \w*. 
\v 5 [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} shall be \w thy basket| strong="H2935" \w* \w and thy store| strong="H4863" \w*.\f + \fr 28:5 \ft store: or, dough, or, kneadingtroughs \f* 
\v 6 [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} shalt thou be [when thou comest in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}, [and blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} shalt thou be [when thou goest out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 7 The \sc Lord\sc* [shall cause]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [that rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8801”} [against thee to be smitten]{strong=“H5062” x-morph=“strongMorph: \sc Th\sc*8737”} \w before thy face| strong="H6440" \w*: [they shall come out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w against thee one| strong="H259" \w* \w way| strong="H1870" \w*, [and flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* \w thee seven| strong="H7651" \w* \w ways| strong="H1870" \w*. 
\v 8 The \sc Lord\sc* [shall command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} \w the blessing| strong="H1293" \w* \w upon thee in thy storehouses| strong="H618" \w*, \w and in all that thou settest| strong="H4916" \w* \w thine hand| strong="H3027" \w* [unto; and he shall bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} \w thee in the land| strong="H776" \w* which the \sc Lord\sc* \w thy God| strong="H430" \w* [giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} thee.\f + \fr 28:8 \ft storehouses: or, barns \f* 
\v 9 The \sc Lord\sc* [shall establish]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee an holy| strong="H6918" \w* \w people| strong="H5971" \w* [unto himself, as he hath sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} [unto thee, if thou shalt keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w the commandments| strong="H4687" \w* of the \sc Lord\sc* \w thy God| strong="H430" \w*, [and walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his ways| strong="H1870" \w*. 
\v 10 \w And all people| strong="H5971" \w* \w of the earth| strong="H776" \w* [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} [that thou art called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8738”} \w by the name| strong="H8034" \w* of the \sc Lord\sc*; [and they shall be afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8804”} of thee. 
