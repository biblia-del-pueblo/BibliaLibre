\v 27 [For I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy rebellion| strong="H4805" \w*, \w and thy stiff| strong="H7186" \w* \w neck| strong="H6203" \w*: [behold, while I am yet alive]{strong=“H2416”} \w with you this day| strong="H3117" \w*, [ye have been rebellious]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8688”} against the \sc Lord\sc*; \w and how much more after| strong="H310" \w* \w my death| strong="H4194" \w*? 
\p
\v 28 [Gather]{strong=“H6950” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto me all the elders| strong="H2205" \w* \w of your tribes| strong="H7626" \w*, [and your officers]{strong=“H7860” x-morph=“strongMorph: \sc Th\sc*8802”}, [that I may speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w these words| strong="H1697" \w* \w in their ears| strong="H241" \w*, \w and call| strong="H5749" \w* \w heaven| strong="H8064" \w* \w and earth| strong="H776" \w* [to record]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8686”} against them. 
\v 29 [For I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w that after| strong="H310" \w* \w my death| strong="H4194" \w* [ye will utterly]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8687”} [corrupt]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8686”} yourselves, [and turn aside]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8804”} \w from the way| strong="H1870" \w* [which I have commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [you; and evil]{strong=“H7451”} [will befall]{strong=“H7122” x-morph=“strongMorph: \sc Th\sc*8804”} \w you in the latter| strong="H319" \w* \w days| strong="H3117" \w*; [because ye will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w evil| strong="H7451" \w* \w in the sight| strong="H5869" \w* of the \sc Lord\sc*, [to provoke him to anger]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8687”} \w through the work| strong="H4639" \w* \w of your hands| strong="H3027" \w*. 
\v 30 \w And Moses| strong="H4872" \w* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w in the ears| strong="H241" \w* \w of all the congregation| strong="H6951" \w* \w of Israel| strong="H3478" \w* \w the words| strong="H1697" \w* \w of this song| strong="H7892" \w*, [until they were ended]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\c 32
\p 
\v 1 [Give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”}, \w O ye heavens| strong="H8064" \w*, [and I will speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}; [and hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}, \w O earth| strong="H776" \w*, \w the words| strong="H561" \w* \w of my mouth| strong="H6310" \w*. 
\v 2 \w My doctrine| strong="H3948" \w* [shall drop]{strong=“H6201” x-morph=“strongMorph: \sc Th\sc*8799”} \w as the rain| strong="H4306" \w*, \w my speech| strong="H565" \w* [shall distil]{strong=“H5140” x-morph=“strongMorph: \sc Th\sc*8799”} \w as the dew| strong="H2919" \w*, \w as the small rain| strong="H8164" \w* \w upon the tender herb| strong="H1877" \w*, \w and as the showers| strong="H7241" \w* \w upon the grass| strong="H6212" \w*: 
\v 3 [Because I will publish]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w the name| strong="H8034" \w* of the \sc Lord\sc*: [ascribe]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye greatness| strong="H1433" \w* \w unto our God| strong="H430" \w*. 
\v 4 He is \w the Rock| strong="H6697" \w*, \w his work| strong="H6467" \w* is \w perfect| strong="H8549" \w*: \w for all his ways| strong="H1870" \w* are \w judgment| strong="H4941" \w*: \w a God| strong="H410" \w* \w of truth| strong="H530" \w* \w and without iniquity| strong="H5766" \w*, \w just| strong="H6662" \w* \w and right| strong="H3477" \w* is he. 
\v 5 [They have corrupted]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8765”} [themselves, their spot]{strong=“H3971”} is not the spot \w of his children| strong="H1121" \w*: they are \w a perverse| strong="H6141" \w* \w and crooked| strong="H6618" \w* \w generation| strong="H1755" \w*.\f + \fr 32:5 \ft They have…: Heb. He hath corrupted to himself \f* \f + \fr 32:5 \ft their…: or, that they are not his children, that is their blot \f* 
\v 6 [Do ye thus requite]{strong=“H1580” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc*, \w O foolish| strong="H5036" \w* \w people| strong="H5971" \w* \w and unwise| strong="H2450" \w*? is \w not he thy father| strong="H1" \w* that [hath bought]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8804”} [thee? hath he not made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, and established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8787”} thee? 
\p
\v 7 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”} \w the days| strong="H3117" \w* \w of old| strong="H5769" \w*, [consider]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8798”} \w the years| strong="H8141" \w* \w of many| strong="H1755" \w* \w generations| strong="H1755" \w*: [ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy father| strong="H1" \w*, [and he will shew]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} [thee; thy elders]{strong=“H2205”}, [and they will tell]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} thee.\f + \fr 32:7 \ft many…: Heb. generation and generation \f* 
\v 8 \w When the most High| strong="H5945" \w* \w divided| strong="H5157" \w* \w to the nations| strong="H1471" \w* [their inheritance]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8687”}, [when he separated]{strong=“H6504” x-morph=“strongMorph: \sc Th\sc*8687”} \w the sons| strong="H1121" \w* \w of Adam| strong="H120" \w*, [he set]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8686”} \w the bounds| strong="H1367" \w* \w of the people| strong="H5971" \w* \w according to the number| strong="H4557" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*. 
\v 9 For the \sc Lord\sc*’S \w portion| strong="H2506" \w* is \w his people| strong="H5971" \w*; \w Jacob| strong="H3290" \w* is \w the lot| strong="H2256" \w* \w of his inheritance| strong="H5159" \w*.\f + \fr 32:9 \ft lot: Heb. cord \f* 
\v 10 [He found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w him in a desert| strong="H4057" \w* \w land| strong="H776" \w*, \w and in the waste| strong="H8414" \w* \w howling| strong="H3214" \w* \w wilderness| strong="H3452" \w*; [he led him about]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8779”}, [he instructed]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8787”} [him, he kept]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8799”} \w him as the apple| strong="H380" \w* \w of his eye| strong="H5869" \w*.\f + \fr 32:10 \ft led: or, compassed \f* 
\v 11 \w As an eagle| strong="H5404" \w* [stirreth up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8686”} \w her nest| strong="H7064" \w*, [fluttereth]{strong=“H7363” x-morph=“strongMorph: \sc Th\sc*8762”} \w over her young| strong="H1469" \w*, [spreadeth abroad]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8799”} \w her wings| strong="H3671" \w*, [taketh]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [them, beareth]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w them on her wings| strong="H84" \w*: 
\v 12 So the \sc Lord\sc* \w alone| strong="H910" \w* [did lead]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8686”} him, and there was \w no strange| strong="H5236" \w* \w god| strong="H410" \w* with him. 
\v 13 [He made him ride]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8686”} \w on the high places| strong="H1116" \w* \w of the earth| strong="H776" \w*, [that he might eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the increase| strong="H8570" \w* \w of the fields| strong="H7704" \w*; [and he made him to suck]{strong=“H3243” x-morph=“strongMorph: \sc Th\sc*8686”} \w honey| strong="H1706" \w* \w out of the rock| strong="H5553" \w*, \w and oil| strong="H8081" \w* \w out of the flinty| strong="H2496" \w* \w rock| strong="H6697" \w*; 
\v 14 \w Butter| strong="H2529" \w* \w of kine| strong="H1241" \w*, \w and milk| strong="H2461" \w* \w of sheep| strong="H6629" \w*, \w with fat| strong="H2459" \w* \w of lambs| strong="H3733" \w*, \w and rams| strong="H352" \w* \w of the breed| strong="H1121" \w* \w of Bashan| strong="H1316" \w*, \w and goats| strong="H6260" \w*, \w with the fat| strong="H2459" \w* \w of kidneys| strong="H3629" \w* \w of wheat| strong="H2406" \w*; [and thou didst drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w the pure| strong="H2561" \w* \w blood| strong="H1818" \w* \w of the grape| strong="H6025" \w*. 
\p
\v 15 \w But Jeshurun| strong="H3484" \w* [waxed fat]{strong=“H8080” x-morph=“strongMorph: \sc Th\sc*8799”}, [and kicked]{strong=“H1163” x-morph=“strongMorph: \sc Th\sc*8799”}: [thou art waxen fat]{strong=“H8080” x-morph=“strongMorph: \sc Th\sc*8804”}, [thou art grown thick]{strong=“H5666” x-morph=“strongMorph: \sc Th\sc*8804”}, [thou art covered]{strong=“H3780” x-morph=“strongMorph: \sc Th\sc*8804”} with fatness; [then he forsook]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8799”} \w God| strong="H433" \w* which [made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [him, and lightly esteemed]{strong=“H5034” x-morph=“strongMorph: \sc Th\sc*8762”} \w the Rock| strong="H6697" \w* \w of his salvation| strong="H3444" \w*. 
\v 16 [They provoked him to jealousy]{strong=“H7065” x-morph=“strongMorph: \sc Th\sc*8686”} [with strange]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} gods, \w with abominations| strong="H8441" \w* [provoked they him to anger]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 17 [They sacrificed]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto devils| strong="H7700" \w*, \w not to God| strong="H433" \w*; \w to gods| strong="H430" \w* [whom they knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [not, to new]{strong=“H2319”} gods that \w came| strong="H935" \w* \w newly| strong="H7138" \w* [up]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, \w whom your fathers| strong="H1" \w* [feared]{strong=“H8175” x-morph=“strongMorph: \sc Th\sc*8804”} not.\f + \fr 32:17 \ft not to…: or, which were not God \f* 
\v 18 \w Of the Rock| strong="H6697" \w* that [begat]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} [thee thou art unmindful]{strong=“H7876” x-morph=“strongMorph: \sc Th\sc*8799”}, [and hast forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} \w God| strong="H410" \w* [that formed]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8789”} thee. 
\p
\v 19 And when the \sc Lord\sc* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} it, [he abhorred]{strong=“H5006” x-morph=“strongMorph: \sc Th\sc*8799”} them, \w because of the provoking| strong="H3708" \w* \w of his sons| strong="H1121" \w*, \w and of his daughters| strong="H1323" \w*.\f + \fr 32:19 \ft abhorred: or, despised \f* 
\v 20 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8686”} \w my face| strong="H6440" \w* [from them, I will see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w what their end| strong="H319" \w* shall be: for they are \w a very froward| strong="H8419" \w* \w generation| strong="H1755" \w*, \w children| strong="H1121" \w* in whom is \w no faith| strong="H529" \w*. 
\v 21 [They have moved me to jealousy]{strong=“H7065” x-morph=“strongMorph: \sc Th\sc*8765”} with that which is \w not| strong="H3808" \w* \w God| strong="H410" \w*; [they have provoked me to anger]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8765”} \w with their vanities| strong="H1892" \w*: [and I will move them to jealousy]{strong=“H7065” x-morph=“strongMorph: \sc Th\sc*8686”} with those which are \w not a people| strong="H5971" \w*; [I will provoke them to anger]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8686”} \w with a foolish| strong="H5036" \w* \w nation| strong="H1471" \w*. 
\v 22 \w For a fire| strong="H784" \w* [is kindled]{strong=“H6919” x-morph=“strongMorph: \sc Th\sc*8804”} \w in mine anger| strong="H639" \w*, [and shall burn]{strong=“H3344” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the lowest| strong="H8482" \w* \w hell| strong="H7585" \w*, [and shall consume]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the earth| strong="H776" \w* \w with her increase| strong="H2981" \w*, [and set on fire]{strong=“H3857” x-morph=“strongMorph: \sc Th\sc*8762”} \w the foundations| strong="H4144" \w* \w of the mountains| strong="H2022" \w*.\f + \fr 32:22 \ft shall burn: or, hath burned \f* \f + \fr 32:22 \ft shall consume: or, hath consumed \f* 
\v 23 [I will heap]{strong=“H5595” x-morph=“strongMorph: \sc Th\sc*8686”} \w mischiefs| strong="H7451" \w* [upon them; I will spend]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8762”} \w mine arrows| strong="H2671" \w* upon them. 
\v 24 They shall be \w burnt| strong="H4198" \w* \w with hunger| strong="H7458" \w*, [and devoured]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8803”} \w with burning heat| strong="H7565" \w*, \w and with bitter| strong="H4815" \w* \w destruction| strong="H6986" \w*: [I will also send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w the teeth| strong="H8127" \w* \w of beasts| strong="H929" \w* [upon them, with the poison]{strong=“H2534”} [of serpents]{strong=“H2119” x-morph=“strongMorph: \sc Th\sc*8801”} \w of the dust| strong="H6083" \w*.\f + \fr 32:24 \ft heat: Heb. coals \f* 
\v 25 \w The sword| strong="H2719" \w* \w without| strong="H2351" \w*, \w and terror| strong="H367" \w* \w within| strong="H2315" \w*, [shall destroy]{strong=“H7921” x-morph=“strongMorph: \sc Th\sc*8762”} \w both the young man| strong="H970" \w* \w and the virgin| strong="H1330" \w*, [the suckling]{strong=“H3243” x-morph=“strongMorph: \sc Th\sc*8802”} also \w with the man| strong="H376" \w* \w of gray hairs| strong="H7872" \w*.\f + \fr 32:25 \ft within: Heb. from the chambers \f* \f + \fr 32:25 \ft destroy: Heb. bereave \f* 
\p
\v 26 [I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [I would scatter them into corners]{strong=“H6284” x-morph=“strongMorph: \sc Th\sc*8686”}, \w I would make the remembrance| strong="H2143" \w* [of them to cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8686”} \w from among men| strong="H582" \w*: 
\v 27 \w Were it not| strong="H3884" \w* [that I feared]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”} \w the wrath| strong="H3708" \w* [of the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, \w lest their adversaries| strong="H6862" \w* [should behave themselves strangely]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8762”}, and [lest they should say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Our hand| strong="H3027" \w* is [high]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8804”}, and the \sc Lord\sc* [hath not done]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8804”} all this.^\sc 32:27 Our…: or, Our high hand, and not the [Lord\sc* hath done] 
\v 28 For they are \w a nation| strong="H1471" \w* [void]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8802”} \w of counsel| strong="H6098" \w*, neither is there any \w understanding| strong="H8394" \w* in them. 
\v 29 \w O that| strong="H3863" \w* [they were wise]{strong=“H2449” x-morph=“strongMorph: \sc Th\sc*8804”}, that [they understood]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8686”} this, that [they would consider]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} \w their latter end| strong="H319" \w*! 
\v 30 \w How should one| strong="H259" \w* [chase]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} \w a thousand| strong="H505" \w*, \w and two| strong="H8147" \w* \w put ten| strong="H7233" \w* \w thousand| strong="H505" \w* [to flight]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8686”}, \w except| strong="H3808" \w* \w their Rock| strong="H6697" \w* [had sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8804”} \w them| strong="H3588" \w*, and the \sc Lord\sc* [had shut them up]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8689”}? 
\v 31 \w For their rock| strong="H6697" \w* is \w not as our Rock| strong="H6697" \w*, [even our enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} themselves being \w judges| strong="H6414" \w*. 
\v 32 \w For their vine| strong="H1612" \w* is \w of the vine| strong="H1612" \w* \w of Sodom| strong="H5467" \w*, \w and of the fields| strong="H7709" \w* \w of Gomorrah| strong="H6017" \w*: \w their grapes| strong="H6025" \w* are \w grapes| strong="H6025" \w* \w of gall| strong="H7219" \w*, \w their clusters| strong="H811" \w* are \w bitter| strong="H4846" \w*:\f + \fr 32:32 \ft of the vine: or, worse than the vine \f* 
\v 33 \w Their wine| strong="H3196" \w* is \w the poison| strong="H2534" \w* \w of dragons| strong="H8577" \w*, \w and the cruel| strong="H393" \w* \w venom| strong="H7219" \w* \w of asps| strong="H6620" \w*. 
\v 34 Is [not this laid up in store]{strong=“H3647” x-morph=“strongMorph: \sc Th\sc*8803”} with me, and [sealed up]{strong=“H2856” x-morph=“strongMorph: \sc Th\sc*8803”} \w among my treasures| strong="H214" \w*? 
\v 35 To me belongeth \w vengeance| strong="H5359" \w*, \w and recompence| strong="H8005" \w*; \w their foot| strong="H7272" \w* [shall slide]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8799”} in due \w time| strong="H6256" \w*: \w for the day| strong="H3117" \w* \w of their calamity| strong="H343" \w* is \w at hand| strong="H7138" \w*, \w and the things that shall come| strong="H6264" \w* [upon them make haste]{strong=“H2363” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 36 For the \sc Lord\sc* [shall judge]{strong=“H1777” x-morph=“strongMorph: \sc Th\sc*8799”} \w his people| strong="H5971" \w*, [and repent]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8691”} \w himself for his servants| strong="H5650" \w*, [when he seeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} that their \w power| strong="H3027" \w* [is gone]{strong=“H235” x-morph=“strongMorph: \sc Th\sc*8804”}, and there is \w none| strong="H657" \w* [shut up]{strong=“H6113” x-morph=“strongMorph: \sc Th\sc*8803”}, [or left]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8803”}.\f + \fr 32:36 \ft power: Heb. hand \f* 
\v 37 [And he shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, Where are \w their gods| strong="H430" \w*, their \w rock| strong="H6697" \w* [in whom they trusted]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8804”}, 
