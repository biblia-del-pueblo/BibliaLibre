\c 6
\p 
\v 1 Now these are \w the commandments| strong="H4687" \w*, \w the statutes| strong="H2706" \w*, \w and the judgments| strong="H4941" \w*, which the \sc Lord\sc* \w your God| strong="H430" \w* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [to teach]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8763”} [you, that ye might do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} them \w in the land| strong="H776" \w* [whither ye go]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} [to possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} it:\f + \fr 6:1 \ft go: Heb. pass over \f* 
\v 2 [That thou mightest fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc* \w thy God| strong="H430" \w*, [to keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w all his statutes| strong="H2708" \w* \w and his commandments| strong="H4687" \w*, [which I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} [thee, thou, and thy son]{strong=“H1121”}, [and thy son’s]{strong=“H1121”} \w son| strong="H1121" \w*, \w all the days| strong="H3117" \w* \w of thy life| strong="H2416" \w*; \w and that thy days| strong="H3117" \w* [may be prolonged]{strong=“H748” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\p
\v 3 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [therefore, O Israel]{strong=“H3478”}, [and observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} it; [that it may be well]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8799”} [with thee, and that ye may increase]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8799”} \w mightily| strong="H3966" \w*, as the \sc Lord\sc* \w God| strong="H430" \w* \w of thy fathers| strong="H1" \w* [hath promised]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [thee, in the land]{strong=“H776”} [that floweth]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”} \w with milk| strong="H2461" \w* \w and honey| strong="H1706" \w*. 
\p
\v 4 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O Israel| strong="H3478" \w*: The \sc Lord\sc* \w our God| strong="H430" \w* is \w one| strong="H259" \w* \sc Lord\sc*: 
\v 5 [And thou shalt love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w thy God| strong="H430" \w* \w with all thine heart| strong="H3824" \w*, \w and with all thy soul| strong="H5315" \w*, \w and with all thy might| strong="H3966" \w*. 
\v 6 \w And these words| strong="H1697" \w*, [which I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} \w thee this day| strong="H3117" \w*, \w shall be in thine heart| strong="H3824" \w*: 
\v 7 [And thou shalt teach them diligently]{strong=“H8150” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto thy children| strong="H1121" \w*, [and shalt talk]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [of them when thou sittest]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} \w in thine house| strong="H1004" \w*, [and when thou walkest]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} \w by the way| strong="H1870" \w*, [and when thou liest down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8800”}, [and when thou risest up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 6:7 \ft teach: Heb. whet, or, sharpen \f* 
\v 8 [And thou shalt bind]{strong=“H7194” x-morph=“strongMorph: \sc Th\sc*8804”} \w them for a sign| strong="H226" \w* \w upon thine hand| strong="H3027" \w*, \w and they shall be as frontlets| strong="H2903" \w* \w between thine eyes| strong="H5869" \w*. 
\v 9 [And thou shalt write]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8804”} \w them upon the posts| strong="H4201" \w* \w of thy house| strong="H1004" \w*, \w and on thy gates| strong="H8179" \w*. 
