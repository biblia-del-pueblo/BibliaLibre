\v 14 [Then shalt thou enquire]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8804”}, [and make search]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8804”}, [and ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8804”} [diligently]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8687”}; and, behold, if it be \w truth| strong="H571" \w*, and \w the thing| strong="H1697" \w* [certain]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8737”}, that \w such| strong="H2063" \w* \w abomination| strong="H8441" \w* [is wrought]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8738”} \w among| strong="H7130" \w* you; 
\v 15 [Thou shalt surely]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8687”} [smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} [the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of that city| strong="H5892" \w* \w with the edge| strong="H6310" \w* \w of the sword| strong="H2719" \w*, [destroying it utterly]{strong=“H2763” x-morph=“strongMorph: \sc Th\sc*8685”}, and all that is [therein, and the cattle]{strong=“H929”} [thereof, with the edge]{strong=“H6310”} \w of the sword| strong="H2719" \w*. 
\v 16 [And thou shalt gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the spoil| strong="H7998" \w* \w of it into the midst| strong="H8432" \w* \w of the street| strong="H7339" \w* [thereof, and shalt burn]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8804”} \w with fire| strong="H784" \w* \w the city| strong="H5892" \w*, \w and all the spoil| strong="H7998" \w* \w thereof every whit| strong="H3632" \w*, for the \sc Lord\sc* \w thy God| strong="H430" \w*: \w and it shall be an heap| strong="H8510" \w* \w for ever| strong="H5769" \w*; [it shall not be built again]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 17 [And there shall cleave]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8799”} \w nought| strong="H3972" \w* \w of the cursed thing| strong="H2764" \w* \w to thine hand| strong="H3027" \w*: that the \sc Lord\sc* [may turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the fierceness| strong="H2740" \w* \w of his anger| strong="H639" \w*, [and shew]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee mercy| strong="H7356" \w*, [and have compassion]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8765”} [upon thee, and multiply]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8689”} [thee, as he hath sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto thy fathers| strong="H1" \w*;\f + \fr 13:17 \ft cursed: or, devoted \f* 
\v 18 [When thou shalt hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the voice| strong="H6963" \w* of the \sc Lord\sc* \w thy God| strong="H430" \w*, [to keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w all his commandments| strong="H4687" \w* [which I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} \w thee this day| strong="H3117" \w*, [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} that which is \w right| strong="H3477" \w* \w in the eyes| strong="H5869" \w* of the \sc Lord\sc* \w thy God| strong="H430" \w*.
\c 14
\p 
\v 1 Ye are \w the children| strong="H1121" \w* of the \sc Lord\sc* \w your God| strong="H430" \w*: [ye shall not cut]{strong=“H1413” x-morph=“strongMorph: \sc Th\sc*8704”} [yourselves, nor make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w any baldness| strong="H7144" \w* \w between your eyes| strong="H5869" \w* [for the dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”}. 
\v 2 For thou art \w an holy| strong="H6918" \w* \w people| strong="H5971" \w* unto the \sc Lord\sc* \w thy God| strong="H430" \w*, and the \sc Lord\sc* [hath chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee to be a peculiar| strong="H5459" \w* \w people| strong="H5971" \w* [unto himself, above all the nations]{strong=“H5971”} that are \w upon| strong="H6440" \w* \w the earth| strong="H127" \w*. 
\p
\v 3 [Thou shalt not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w any abominable thing| strong="H8441" \w*. 
\v 4 These are \w the beasts| strong="H929" \w* [which ye shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}: \w the ox| strong="H7794" \w*, [the sheep]{strong=“H3775 H7716”}, \w and the goat| strong="H5795" \w*, 
\v 5 \w The hart| strong="H354" \w*, \w and the roebuck| strong="H6643" \w*, \w and the fallow deer| strong="H3180" \w*, \w and the wild goat| strong="H689" \w*, \w and the pygarg| strong="H1788" \w*, \w and the wild ox| strong="H8377" \w*, \w and the chamois| strong="H2169" \w*.\f + \fr 14:5 \ft pygarg: or bison: Heb. dishon \f* 
\v 6 \w And every beast| strong="H929" \w* [that parteth]{strong=“H6536” x-morph=“strongMorph: \sc Th\sc*8688”} \w the hoof| strong="H6541" \w*, \w and cleaveth| strong="H8157" \w* [the cleft]{strong=“H8156” x-morph=“strongMorph: \sc Th\sc*8802”} \w into two| strong="H8147" \w* \w claws| strong="H6541" \w*, and [cheweth]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8688”} \w the cud| strong="H1625" \w* \w among the beasts| strong="H929" \w*, [that ye shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 7 [Nevertheless these ye shall not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [of them that chew]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8688”} \w the cud| strong="H1625" \w*, [or of them that divide]{strong=“H6536” x-morph=“strongMorph: \sc Th\sc*8688”} [the cloven]{strong=“H8156” x-morph=“strongMorph: \sc Th\sc*8803”} \w hoof| strong="H6541" \w*; as \w the camel| strong="H1581" \w*, \w and the hare| strong="H768" \w*, \w and the coney| strong="H8227" \w*: [for they chew]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8688”} \w the cud| strong="H1625" \w*, [but divide]{strong=“H6536” x-morph=“strongMorph: \sc Th\sc*8689”} \w not the hoof| strong="H6541" \w*; therefore they are \w unclean| strong="H2931" \w* unto you. 
\v 8 \w And the swine| strong="H2386" \w*, [because it divideth]{strong=“H6536” x-morph=“strongMorph: \sc Th\sc*8688”} \w the hoof| strong="H6541" \w*, \w yet cheweth not the cud| strong="H1625" \w*, it is \w unclean| strong="H2931" \w* [unto you: ye shall not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w of their flesh| strong="H1320" \w*, [nor touch]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8799”} \w their dead carcase| strong="H5038" \w*. 
\p
\v 9 [These ye shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} of all that are \w in the waters| strong="H4325" \w*: \w all that have fins| strong="H5579" \w* \w and scales| strong="H7193" \w* [shall ye eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}: 
\v 10 \w And whatsoever hath not fins| strong="H5579" \w* \w and scales| strong="H7193" \w* [ye may not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}; it is \w unclean| strong="H2931" \w* unto you. 
\p
\v 11 Of \w all clean| strong="H2889" \w* \w birds| strong="H6833" \w* [ye shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 12 But these are they [of which ye shall not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}: \w the eagle| strong="H5404" \w*, \w and the ossifrage| strong="H6538" \w*, \w and the ospray| strong="H5822" \w*, 
\v 13 \w And the glede| strong="H7201" \w*, \w and the kite| strong="H344" \w*, \w and the vulture| strong="H1772" \w* \w after his kind| strong="H4327" \w*, 
\v 14 \w And every raven| strong="H6158" \w* \w after his kind| strong="H4327" \w*, 
\v 15 [And the owl]{strong=“H3284 H1323”}, \w and the night hawk| strong="H8464" \w*, \w and the cuckow| strong="H7828" \w*, \w and the hawk| strong="H5322" \w* \w after his kind| strong="H4327" \w*, 
\v 16 \w The little owl| strong="H3563" \w*, \w and the great owl| strong="H3244" \w*, \w and the swan| strong="H8580" \w*, 
\v 17 \w And the pelican| strong="H6893" \w*, \w and the gier eagle| strong="H7360" \w*, \w and the cormorant| strong="H7994" \w*, 
\v 18 \w And the stork| strong="H2624" \w*, \w and the heron| strong="H601" \w* \w after her kind| strong="H4327" \w*, \w and the lapwing| strong="H1744" \w*, \w and the bat| strong="H5847" \w*. 
\v 19 \w And every creeping thing| strong="H8318" \w* \w that flieth| strong="H5775" \w* is \w unclean| strong="H2931" \w* [unto you: they shall not be eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 20 But of \w all clean| strong="H2889" \w* \w fowls| strong="H5775" \w* [ye may eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 21 [Ye shall not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} of \w any thing that dieth of itself| strong="H5038" \w*: [thou shalt give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w it unto the stranger| strong="H1616" \w* that is \w in thy gates| strong="H8179" \w*, [that he may eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} [it; or thou mayest sell]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8800”} \w it unto an alien| strong="H5237" \w*: for thou art \w an holy| strong="H6918" \w* \w people| strong="H5971" \w* unto the \sc Lord\sc* \w thy God| strong="H430" \w*. [Thou shalt not seethe]{strong=“H1310” x-morph=“strongMorph: \sc Th\sc*8762”} \w a kid| strong="H1423" \w* [in his mother’s]{strong=“H517”} \w milk| strong="H2461" \w*. 
\p
\v 22 [Thou shalt truly]{strong=“H6237” x-morph=“strongMorph: \sc Th\sc*8763”} [tithe]{strong=“H6237” x-morph=“strongMorph: \sc Th\sc*8762”} \w all the increase| strong="H8393" \w* \w of thy seed| strong="H2233" \w*, \w that the field| strong="H7704" \w* [bringeth forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} \w year| strong="H8141" \w* \w by year| strong="H8141" \w*. 
\v 23 [And thou shalt eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* the \sc Lord\sc* \w thy God| strong="H430" \w*, \w in the place| strong="H4725" \w* [which he shall choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} [to place]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8763”} \w his name| strong="H8034" \w* [there, the tithe]{strong=“H4643”} \w of thy corn| strong="H1715" \w*, \w of thy wine| strong="H8492" \w*, \w and of thine oil| strong="H3323" \w*, \w and the firstlings| strong="H1062" \w* \w of thy herds| strong="H1241" \w* \w and of thy flocks| strong="H6629" \w*; [that thou mayest learn]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8799”} [to fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8800”} the \sc Lord\sc* \w thy God| strong="H430" \w* \w always| strong="H3117" \w*. 
\v 24 \w And if the way| strong="H1870" \w* [be too long]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8799”} [for thee, so that]{strong=“H3588”} [thou art not able]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [to carry]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8800”} it; or \w if the place| strong="H4725" \w* [be too far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8799”} from thee, which the \sc Lord\sc* \w thy God| strong="H430" \w* [shall choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} [to set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w his name| strong="H8034" \w* there, when the \sc Lord\sc* \w thy God| strong="H430" \w* [hath blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} thee: 
\v 25 [Then shalt thou turn]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} it \w into money| strong="H3701" \w*, [and bind up]{strong=“H6696” x-morph=“strongMorph: \sc Th\sc*8804”} \w the money| strong="H3701" \w* \w in thine hand| strong="H3027" \w*, [and shalt go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the place| strong="H4725" \w* which the \sc Lord\sc* \w thy God| strong="H430" \w* [shall choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”}: 
\v 26 [And thou shalt bestow]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w that money| strong="H3701" \w* \w for whatsoever thy soul| strong="H5315" \w* [lusteth after]{strong=“H183” x-morph=“strongMorph: \sc Th\sc*8762”}, \w for oxen| strong="H1241" \w*, \w or for sheep| strong="H6629" \w*, \w or for wine| strong="H3196" \w*, \w or for strong drink| strong="H7941" \w*, \w or for whatsoever thy soul| strong="H5315" \w* [desireth]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”}: [and thou shalt eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w there before| strong="H6440" \w* the \sc Lord\sc* \w thy God| strong="H430" \w*, [and thou shalt rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8804”}, [thou, and thine household]{strong=“H1004”},\f + \fr 14:26 \ft desireth: Heb. asketh of thee \f* 
\v 27 \w And the Levite| strong="H3881" \w* that is \w within thy gates| strong="H8179" \w*; [thou shalt not forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} [him; for he hath no part]{strong=“H2506”} \w nor inheritance| strong="H5159" \w* with thee. 
\p
\v 28 \w At the end| strong="H7097" \w* \w of three| strong="H7969" \w* \w years| strong="H8141" \w* [thou shalt bring forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w all the tithe| strong="H4643" \w* \w of thine increase| strong="H8393" \w* \w the same year| strong="H8141" \w*, and shalt lay it [up]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8689”} \w within thy gates| strong="H8179" \w*: 
\v 29 \w And the Levite| strong="H3881" \w*, (\w because he hath no part| strong="H2506" \w* \w nor inheritance| strong="H5159" \w* [with thee,) and the stranger]{strong=“H1616”}, \w and the fatherless| strong="H3490" \w*, \w and the widow| strong="H490" \w*, which are \w within thy gates| strong="H8179" \w*, [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, [and shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} [and be satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8804”}; that the \sc Lord\sc* \w thy God| strong="H430" \w* [may bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w thee in all the work| strong="H4639" \w* \w of thine hand| strong="H3027" \w* [which thou doest]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\c 15
\p 
\v 1 \w At the end| strong="H7093" \w* of every \w seven| strong="H7651" \w* \w years| strong="H8141" \w* [thou shalt make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w a release| strong="H8059" \w*. 
\v 2 And this is \w the manner| strong="H1697" \w* \w of the release| strong="H8059" \w*: [Every creditor]{strong=“H3027 H4874 H1167”} [that lendeth]{strong=“H5383” x-morph=“strongMorph: \sc Th\sc*8686”} ought \w unto his neighbour| strong="H7453" \w* [shall release]{strong=“H8058” x-morph=“strongMorph: \sc Th\sc*8800”} it; [he shall not exact]{strong=“H5065” x-morph=“strongMorph: \sc Th\sc*8799”} it \w of his neighbour| strong="H7453" \w*, \w or of his brother| strong="H251" \w*; [because it is called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*’S \w release| strong="H8059" \w*.\f + \fr 15:2 \ft creditor: Heb. master of the lending of his hand \f* 
\v 3 \w Of a foreigner| strong="H5237" \w* [thou mayest exact]{strong=“H5065” x-morph=“strongMorph: \sc Th\sc*8799”} it again: but that \w which is thine with thy brother| strong="H251" \w* \w thine hand| strong="H3027" \w* [shall release]{strong=“H8058” x-morph=“strongMorph: \sc Th\sc*8686”}; 
\v 4 \w Save| strong="H657" \w* \w when there shall be no poor| strong="H34" \w* among you; for the \sc Lord\sc* [shall greatly]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8763”} [bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w thee in the land| strong="H776" \w* which the \sc Lord\sc* \w thy God| strong="H430" \w* [giveth ]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} thee for \w an inheritance| strong="H5159" \w* [to possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} it:\f + \fr 15:4 \ft Save…: or, To the end that there be no poor among you \f* 
\v 5 [Only if thou carefully]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} [hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the voice| strong="H6963" \w* of the \sc Lord\sc* \w thy God| strong="H430" \w*, [to observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w all these commandments| strong="H4687" \w* [which I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} \w thee this day| strong="H3117" \w*. 
\v 6 For the \sc Lord\sc* \w thy God| strong="H430" \w* [blesseth]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} [thee, as he promised]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [thee: and thou shalt lend]{strong=“H5670” x-morph=“strongMorph: \sc Th\sc*8689”} \w unto many| strong="H7227" \w* \w nations| strong="H1471" \w*, [but thou shalt not borrow]{strong=“H5670” x-morph=“strongMorph: \sc Th\sc*8799”}; [and thou shalt reign]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8804”} \w over many| strong="H7227" \w* \w nations| strong="H1471" \w*, [but they shall not reign]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8799”} over thee. 
\p
\v 7 \w If there be among you a poor man| strong="H34" \w* \w of one| strong="H259" \w* \w of thy brethren| strong="H251" \w* \w within any| strong="H259" \w* \w of thy gates| strong="H8179" \w* \w in thy land| strong="H776" \w* which the \sc Lord\sc* \w thy God| strong="H430" \w* [giveth ]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} [thee, thou shalt not harden]{strong=“H553” x-morph=“strongMorph: \sc Th\sc*8762”} \w thine heart| strong="H3824" \w*, [nor shut]{strong=“H7092” x-morph=“strongMorph: \sc Th\sc*8799”} \w thine hand| strong="H3027" \w* \w from thy poor| strong="H34" \w* \w brother| strong="H251" \w*: 
\v 8 [But thou shalt open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} \w thine hand| strong="H3027" \w* [wide]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8800”} [unto him, and shalt surely]{strong=“H5670” x-morph=“strongMorph: \sc Th\sc*8687”} [lend]{strong=“H5670” x-morph=“strongMorph: \sc Th\sc*8686”} \w him sufficient| strong="H1767" \w* \w for his need| strong="H4270" \w*, in that [which he wanteth]{strong=“H2637” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 9 [Beware]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8734”} \w that there be not a thought| strong="H1697" \w* \w in thy wicked| strong="H1100" \w* \w heart| strong="H3824" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w The seventh| strong="H7651" \w* \w year| strong="H8141" \w*, \w the year| strong="H8141" \w* \w of release| strong="H8059" \w*, [is at hand]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8804”}; \w and thine eye| strong="H5869" \w* [be evil]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8804”} \w against thy poor| strong="H34" \w* \w brother| strong="H251" \w*, [and thou givest]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [him nought; and he cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} unto the \sc Lord\sc* [against thee, and it be sin]{strong=“H2399”} unto thee.\f + \fr 15:9 \ft thought: Heb. word \f* \f + \fr 15:9 \ft wicked: Heb. Belial \f* 
\v 10 [Thou shalt surely]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} [give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [him, and thine heart]{strong=“H3824”} [shall not be grieved]{strong=“H3415” x-morph=“strongMorph: \sc Th\sc*8799”} [when thou givest]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} [unto him: because]{strong=“H1558”} \w that for this thing| strong="H1697" \w* the \sc Lord\sc* \w thy God| strong="H430" \w* [shall bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w thee in all thy works| strong="H4639" \w*, \w and in all that thou puttest| strong="H4916" \w* \w thine hand| strong="H3027" \w* unto. 
\v 11 \w For the poor| strong="H34" \w* [shall never cease]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of| strong="H7130" \w* \w the land| strong="H776" \w*: [therefore I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} [thee, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Thou shalt open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} \w thine hand| strong="H3027" \w* [wide]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto thy brother| strong="H251" \w*, \w to thy poor| strong="H6041" \w*, \w and to thy needy| strong="H34" \w*, \w in thy land| strong="H776" \w*. 
\p
\v 12 And \w if thy brother| strong="H251" \w*, \w an Hebrew man| strong="H5680" \w*, \w or an Hebrew woman| strong="H5680" \w*, [be sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8735”} [unto thee, and serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee six| strong="H8337" \w* \w years| strong="H8141" \w*; \w then in the seventh| strong="H7637" \w* \w year| strong="H8141" \w* [thou shalt let him go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w free| strong="H2670" \w* from thee. 
\v 13 [And when thou sendest]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w him out free| strong="H2670" \w* [from thee, thou shalt not let him go away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w empty| strong="H7387" \w*: 
\v 14 [Thou shalt furnish]{strong=“H6059” x-morph=“strongMorph: \sc Th\sc*8686”} [him liberally]{strong=“H6059” x-morph=“strongMorph: \sc Th\sc*8687”} \w out of thy flock| strong="H6629" \w*, \w and out of thy floor| strong="H1637" \w*, \w and out of thy winepress| strong="H3342" \w*: of that wherewith the \sc Lord\sc* \w thy God| strong="H430" \w* [hath blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} [thee thou shalt give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} unto him. 
\v 15 [And thou shalt remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w that thou wast a bondman| strong="H5650" \w* \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, and the \sc Lord\sc* \w thy God| strong="H430" \w* [redeemed]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8799”} [thee: therefore I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} \w thee this thing| strong="H1697" \w* \w to day| strong="H3117" \w*. 
\v 16 [And it shall be, if he say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee, I will not go away]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} [from thee; because he loveth]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee and thine house| strong="H1004" \w*, [because he is well]{strong=“H2895” x-morph=“strongMorph: \sc Th\sc*8804”} with thee; 
\v 17 [Then thou shalt take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w an aul| strong="H4836" \w*, [and thrust]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} it \w through his ear| strong="H241" \w* \w unto the door| strong="H1817" \w*, \w and he shall be thy servant| strong="H5650" \w* \w for ever| strong="H5769" \w*. \w And also unto thy maidservant| strong="H519" \w* [thou shalt do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} likewise. 
\v 18 [It shall not seem hard]{strong=“H7185” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto thee| strong="H5869" \w*, [when thou sendest him away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8763”} \w free| strong="H2670" \w* [from thee; for he hath been worth]{strong=“H7939”} \w a double| strong="H4932" \w* \w hired servant| strong="H7916" \w* to thee, [in serving]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee six| strong="H8337" \w* \w years| strong="H8141" \w*: and the \sc Lord\sc* \w thy God| strong="H430" \w* [shall bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} [thee in all that thou doest]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 19 \w All the firstling| strong="H1060" \w* \w males| strong="H2145" \w* [that come]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8735”} \w of thy herd| strong="H1241" \w* \w and of thy flock| strong="H6629" \w* [thou shalt sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8686”} unto the \sc Lord\sc* \w thy God| strong="H430" \w*: [thou shalt do no work]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the firstling| strong="H1060" \w* \w of thy bullock| strong="H7794" \w*, [nor shear]{strong=“H1494” x-morph=“strongMorph: \sc Th\sc*8799”} \w the firstling| strong="H1060" \w* \w of thy sheep| strong="H6629" \w*. 
\v 20 [Thou shalt eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} it \w before| strong="H6440" \w* the \sc Lord\sc* \w thy God| strong="H430" \w* \w year| strong="H8141" \w* \w by year| strong="H8141" \w* \w in the place| strong="H4725" \w* which the \sc Lord\sc* [shall choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”}, \w thou and thy household| strong="H1004" \w*. 
\v 21 And if there be any \w blemish| strong="H3971" \w* therein, as if it be \w lame| strong="H6455" \w*, \w or blind| strong="H5787" \w*, or have \w any ill| strong="H7451" \w* \w blemish| strong="H3971" \w*, [thou shalt not sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} it unto the \sc Lord\sc* \w thy God| strong="H430" \w*. 
\v 22 [Thou shalt eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w it within thy gates| strong="H8179" \w*: \w the unclean| strong="H2931" \w* \w and the clean| strong="H2889" \w* person shall eat it \w alike| strong="H3162" \w*, \w as the roebuck| strong="H6643" \w*, \w and as the hart| strong="H354" \w*. 
\v 23 [Only thou shalt not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the blood| strong="H1818" \w* [thereof; thou shalt pour]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8799”} \w it upon the ground| strong="H776" \w* \w as water| strong="H4325" \w*. 
\c 16
\p 
\v 1 [Observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w the month| strong="H2320" \w* \w of Abib| strong="H24" \w*, [and keep]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w the passover| strong="H6453" \w* unto the \sc Lord\sc* \w thy God| strong="H430" \w*: \w for in the month| strong="H2320" \w* \w of Abib| strong="H24" \w* the \sc Lord\sc* \w thy God| strong="H430" \w* [brought thee forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w out of Egypt| strong="H4714" \w* \w by night| strong="H3915" \w*. 
\v 2 [Thou shalt therefore sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8804”} \w the passover| strong="H6453" \w* unto the \sc Lord\sc* \w thy God| strong="H430" \w*, \w of the flock| strong="H6629" \w* \w and the herd| strong="H1241" \w*, \w in the place| strong="H4725" \w* which the \sc Lord\sc* [shall choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} [to place]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8763”} \w his name| strong="H8034" \w* there. 
\v 3 [Thou shalt eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w no leavened bread| strong="H2557" \w* [with it; seven]{strong=“H7651”} \w days| strong="H3117" \w* [shalt thou eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w unleavened bread| strong="H4682" \w* therewith, even \w the bread| strong="H3899" \w* \w of affliction| strong="H6040" \w*; [for thou camest forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w out of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* \w in haste| strong="H2649" \w*: [that thou mayest remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w the day| strong="H3117" \w* [when thou camest forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”} \w out of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* \w all the days| strong="H3117" \w* \w of thy life| strong="H2416" \w*. 
\v 4 \w And there shall be no leavened bread| strong="H7603" \w* [seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8735”} \w with thee in all thy coast| strong="H1366" \w* \w seven| strong="H7651" \w* \w days| strong="H3117" \w*; neither shall there any thing \w of the flesh| strong="H1320" \w*, [which thou sacrificedst]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} \w the first| strong="H7223" \w* \w day| strong="H3117" \w* \w at even| strong="H6153" \w*, [remain]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} \w all night until the morning| strong="H1242" \w*. 
\v 5 [Thou mayest]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [not sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8800”} \w the passover| strong="H6453" \w* \w within any| strong="H259" \w* \w of thy gates| strong="H8179" \w*, which the \sc Lord\sc* \w thy God| strong="H430" \w* [giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} thee:\f + \fr 16:5 \ft sacrifice: or, kill \f* 
\v 6 \w But at the place| strong="H4725" \w* which the \sc Lord\sc* \w thy God| strong="H430" \w* [shall choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} [to place]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8763”} \w his name| strong="H8034" \w* [in, there thou shalt sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} \w the passover| strong="H6453" \w* \w at even| strong="H6153" \w*, [at the going down]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w of the sun| strong="H8121" \w*, \w at the season| strong="H4150" \w* [that thou camest forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”} \w out of Egypt| strong="H4714" \w*. 
\v 7 [And thou shalt roast]{strong=“H1310” x-morph=“strongMorph: \sc Th\sc*8765”} [and eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} it \w in the place| strong="H4725" \w* which the \sc Lord\sc* \w thy God| strong="H430" \w* [shall choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”}: [and thou shalt turn]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the morning| strong="H1242" \w*, [and go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto thy tents| strong="H168" \w*. 
\v 8 \w Six| strong="H8337" \w* \w days| strong="H3117" \w* [thou shalt eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w unleavened bread| strong="H4682" \w*: \w and on the seventh| strong="H7637" \w* \w day| strong="H3117" \w* shall be \w a solemn assembly| strong="H6116" \w* to the \sc Lord\sc* \w thy God| strong="H430" \w*: [thou shalt do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w no work| strong="H4399" \w* therein.\f + \fr 16:8 \ft solemn…: Heb. restraint \f* 
\p
\v 9 \w Seven| strong="H7651" \w* \w weeks| strong="H7620" \w* [shalt thou number]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee: begin]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8687”} [to number]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8800”} \w the seven| strong="H7651" \w* \w weeks| strong="H7620" \w* from such time as [thou beginnest]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8686”} to put \w the sickle| strong="H2770" \w* \w to the corn| strong="H7054" \w*. 
