\c 23
\p 
\v 1 [He that is wounded in the stones]{strong=“H1795 H6481” x-morph=“strongMorph: \sc Th\sc*8803”}, \w or hath his privy member| strong="H8212" \w* [cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8803”}, [shall not enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the congregation| strong="H6951" \w* of the \sc Lord\sc*. 
