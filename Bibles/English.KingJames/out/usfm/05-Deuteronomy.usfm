\v 9 [And he hath brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w us into this place| strong="H4725" \w*, [and hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w us this land| strong="H776" \w*, even \w a land| strong="H776" \w* [that floweth]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”} \w with milk| strong="H2461" \w* \w and honey| strong="H1706" \w*. 
\v 10 [And now, behold, I have brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} [the firstfruits]{strong=“H7225 H6529”} \w of the land| strong="H127" \w*, which thou, O \sc Lord\sc*, [hast given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [me. And thou shalt set]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8689”} \w it before| strong="H6440" \w* the \sc Lord\sc* \w thy God| strong="H430" \w*, [and worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8694”} \w before| strong="H6440" \w* the \sc Lord\sc* \w thy God| strong="H430" \w*: 
\v 11 [And thou shalt rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8804”} \w in every good| strong="H2896" \w* thing which the \sc Lord\sc* \w thy God| strong="H430" \w* [hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [unto thee, and unto thine house]{strong=“H1004”}, [thou, and the Levite]{strong=“H3881”}, \w and the stranger| strong="H1616" \w* that is \w among| strong="H7130" \w* you. 
\p
\v 12 [When thou hast made an end]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8762”} [of tithing]{strong=“H6237” x-morph=“strongMorph: \sc Th\sc*8687”} \w all the tithes| strong="H4643" \w* \w of thine increase| strong="H8393" \w* \w the third| strong="H7992" \w* \w year| strong="H8141" \w*, which is \w the year| strong="H8141" \w* \w of tithing| strong="H4643" \w*, [and hast given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} it \w unto the Levite| strong="H3881" \w*, \w the stranger| strong="H1616" \w*, \w the fatherless| strong="H3490" \w*, \w and the widow| strong="H490" \w*, [that they may eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w within thy gates| strong="H8179" \w*, [and be filled]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8804”}; 
\v 13 [Then thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* the \sc Lord\sc* \w thy God| strong="H430" \w*, [I have brought away]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8765”} \w the hallowed things| strong="H6944" \w* out of mine \w house| strong="H1004" \w*, [and also have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w them unto the Levite| strong="H3881" \w*, \w and unto the stranger| strong="H1616" \w*, \w to the fatherless| strong="H3490" \w*, \w and to the widow| strong="H490" \w*, \w according to all thy commandments| strong="H4687" \w* [which thou hast commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [me: I have not transgressed]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy commandments| strong="H4687" \w*, [neither have I forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} them: 
\v 14 [I have not eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w thereof in my mourning| strong="H205" \w*, [neither have I taken away]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8765”} ought thereof for any \w unclean| strong="H2931" \w* use, [nor given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} ought [thereof for the dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”}: but [I have hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the voice| strong="H6963" \w* of the \sc Lord\sc* \w my God| strong="H430" \w*, and [have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [according to all that thou hast commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} me. 
\v 15 [Look down]{strong=“H8259” x-morph=“strongMorph: \sc Th\sc*8685”} \w from thy holy| strong="H6944" \w* \w habitation| strong="H4583" \w*, \w from heaven| strong="H8064" \w*, [and bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} \w thy people| strong="H5971" \w* \w Israel| strong="H3478" \w*, \w and the land| strong="H127" \w* [which thou hast given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [us, as thou swarest]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto our fathers| strong="H1" \w*, \w a land| strong="H776" \w* [that floweth]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”} \w with milk| strong="H2461" \w* \w and honey| strong="H1706" \w*. 
\p
\v 16 \w This day| strong="H3117" \w* the \sc Lord\sc* \w thy God| strong="H430" \w* [hath commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} [thee to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w these statutes| strong="H2706" \w* \w and judgments| strong="H4941" \w*: [thou shalt therefore keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w them with all thine heart| strong="H3824" \w*, \w and with all thy soul| strong="H5315" \w*. 
\v 17 [Thou hast avouched]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8689”} the \sc Lord\sc* \w this day| strong="H3117" \w* \w to be thy God| strong="H430" \w*, [and to walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} \w in his ways| strong="H1870" \w*, [and to keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w his statutes| strong="H2706" \w*, \w and his commandments| strong="H4687" \w*, \w and his judgments| strong="H4941" \w*, [and to hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto his voice| strong="H6963" \w*: 
\v 18 And the \sc Lord\sc* [hath avouched]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee this day| strong="H3117" \w* \w to be his peculiar| strong="H5459" \w* \w people| strong="H5971" \w*, [as he hath promised]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} thee, and that thou [shouldest keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w all his commandments| strong="H4687" \w*; 
\v 19 [And to make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w thee high| strong="H5945" \w* \w above all nations| strong="H1471" \w* [which he hath made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, \w in praise| strong="H8416" \w*, \w and in name| strong="H8034" \w*, \w and in honour| strong="H8597" \w*; \w and that thou mayest be an holy| strong="H6918" \w* \w people| strong="H5971" \w* unto the \sc Lord\sc* \w thy God| strong="H430" \w*, [as he hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\c 27
\p 
\v 1 \w And Moses| strong="H4872" \w* \w with the elders| strong="H2205" \w* \w of Israel| strong="H3478" \w* [commanded ]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} \w the people| strong="H5971" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w all the commandments| strong="H4687" \w* [which I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} \w you this day| strong="H3117" \w*. 
\v 2 \w And it shall be on the day| strong="H3117" \w* [when ye shall pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jordan| strong="H3383" \w* \w unto the land| strong="H776" \w* which the \sc Lord\sc* \w thy God| strong="H430" \w* [giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} [thee, that thou shalt set thee up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} \w great| strong="H1419" \w* \w stones| strong="H68" \w*, [and plaister]{strong=“H7874” x-morph=“strongMorph: \sc Th\sc*8804”} \w them with plaister| strong="H7875" \w*: 
\v 3 [And thou shalt write]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon them all the words| strong="H1697" \w* \w of this law| strong="H8451" \w*, [when thou art passed over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8800”}, [that thou mayest go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the land| strong="H776" \w* which the \sc Lord\sc* \w thy God| strong="H430" \w* [giveth ]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} [thee, a land]{strong=“H776”} [that floweth]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”} \w with milk| strong="H2461" \w* \w and honey| strong="H1706" \w*; as the \sc Lord\sc* \w God| strong="H430" \w* \w of thy fathers| strong="H1" \w* [hath promised]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} thee. 
\v 4 [Therefore it shall be when ye be gone over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8800”} \w Jordan| strong="H3383" \w*, that [ye shall set up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8686”} \w these stones| strong="H68" \w*, [which I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} \w you this day| strong="H3117" \w*, \w in mount| strong="H2022" \w* \w Ebal| strong="H5858" \w*, \w and thou shalt plaister| strong="H7875" \w* [them with plaister]{strong=“H7874” x-morph=“strongMorph: \sc Th\sc*8804”}. 
