\v 11 \w When men| strong="H582" \w* [strive]{strong=“H5327” x-morph=“strongMorph: \sc Th\sc*8735”} \w together| strong="H3162" \w* [one with another]{strong=“H376 H251”}, \w and the wife| strong="H802" \w* \w of the one| strong="H259" \w* [draweth near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8804”} [for to deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8687”} \w her husband| strong="H376" \w* \w out of the hand| strong="H3027" \w* [of him that smiteth]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8688”} [him, and putteth forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w her hand| strong="H3027" \w*, [and taketh]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8689”} \w him by the secrets| strong="H4016" \w*: 
