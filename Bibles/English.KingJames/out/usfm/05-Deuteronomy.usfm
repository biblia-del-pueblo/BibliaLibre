\p
\v 7 \w And Moses| strong="H4872" \w* was \w an hundred| strong="H3967" \w* \w and twenty| strong="H6242" \w* \w years| strong="H8141" \w* \w old| strong="H1121" \w* \w when he died| strong="H4194" \w*: \w his eye| strong="H5869" \w* [was not dim]{strong=“H3543” x-morph=“strongMorph: \sc Th\sc*8804”}, \w nor his natural force| strong="H3893" \w* [abated]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 34:7 \ft natural…: Heb. moisture \f* \f + \fr 34:7 \ft abated: Heb. fled \f* 
\p
