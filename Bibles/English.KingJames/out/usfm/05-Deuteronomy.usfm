\p 
\v 1 [Thou shalt not sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc* \w thy God| strong="H430" \w* any \w bullock| strong="H7794" \w*, \w or sheep| strong="H7716" \w*, \w wherein is blemish| strong="H3971" \w*, or [any evilfavouredness]{strong=“H1697 H7451”}: for that is \w an abomination| strong="H8441" \w* unto the \sc Lord\sc* \w thy God| strong="H430" \w*.\f + \fr 17:1 \ft sheep: or, goat \f* 
\p
