\v 18 [And I will surely]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8687”} [hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8686”} \w my face| strong="H6440" \w* \w in that day| strong="H3117" \w* \w for all the evils| strong="H7451" \w* [which they shall have wrought]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, \w in that| strong="H3588" \w* [they are turned]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto other| strong="H312" \w* \w gods| strong="H430" \w*. 
