\v 21 [And he provided]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the first part| strong="H7225" \w* for himself, because there, in \w a portion| strong="H2513" \w* [of the lawgiver]{strong=“H2710” x-morph=“strongMorph: \sc Th\sc*8781”}, was he [seated]{strong=“H5603” x-morph=“strongMorph: \sc Th\sc*8803”}; [and he came]{strong=“H857” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the heads| strong="H7218" \w* \w of the people| strong="H5971" \w*, [he executed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w the justice| strong="H6666" \w* of the \sc Lord\sc*, \w and his judgments| strong="H4941" \w* \w with Israel| strong="H3478" \w*.\f + \fr 33:21 \ft seated: Heb. cieled \f* 
\p
\v 22 \w And of Dan| strong="H1835" \w* [he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Dan| strong="H1835" \w* is [a lion’s]{strong=“H738”} \w whelp| strong="H1482" \w*: [he shall leap]{strong=“H2187” x-morph=“strongMorph: \sc Th\sc*8762”} \w from Bashan| strong="H1316" \w*. 
\p
\v 23 \w And of Naphtali| strong="H5321" \w* [he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w O Naphtali| strong="H5321" \w*, \w satisfied| strong="H7649" \w* \w with favour| strong="H7522" \w*, \w and full| strong="H4392" \w* \w with the blessing| strong="H1293" \w* of the \sc Lord\sc*: [possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou the west| strong="H3220" \w* \w and the south| strong="H1864" \w*. 
\p
\v 24 \w And of Asher| strong="H836" \w* [he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, Let \w Asher| strong="H836" \w* be [blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} \w with children| strong="H1121" \w*; [let him be acceptable]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8803”} \w to his brethren| strong="H251" \w*, [and let him dip]{strong=“H2881” x-morph=“strongMorph: \sc Th\sc*8802”} \w his foot| strong="H7272" \w* \w in oil| strong="H8081" \w*. 
\v 25 \w Thy shoes| strong="H4515" \w* shall be \w iron| strong="H1270" \w* \w and brass| strong="H5178" \w*; \w and as thy days| strong="H3117" \w*, so shall \w thy strength| strong="H1679" \w* be.\f + \fr 33:25 \ft Thy shoes: or, Under thy shoes \f* 
\p
\v 26 There is \w none like unto the God| strong="H410" \w* \w of Jeshurun| strong="H3484" \w*, who [rideth]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the heaven| strong="H8064" \w* \w in thy help| strong="H5828" \w*, \w and in his excellency| strong="H1346" \w* \w on the sky| strong="H7834" \w*. 
\v 27 \w The eternal| strong="H6924" \w* \w God| strong="H430" \w* is thy \w refuge| strong="H4585" \w*, and underneath are \w the everlasting| strong="H5769" \w* \w arms| strong="H2220" \w*: [and he shall thrust out]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8762”} [the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w from before| strong="H6440" \w* [thee; and shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Destroy]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8685”} them. 
\v 28 \w Israel| strong="H3478" \w* [then shall dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} \w in safety| strong="H983" \w* \w alone| strong="H910" \w*: \w the fountain| strong="H5869" \w* \w of Jacob| strong="H3290" \w* shall be \w upon a land| strong="H776" \w* \w of corn| strong="H1715" \w* \w and wine| strong="H8492" \w*; \w also his heavens| strong="H8064" \w* [shall drop down]{strong=“H6201” x-morph=“strongMorph: \sc Th\sc*8799”} \w dew| strong="H2919" \w*. 
\v 29 \w Happy| strong="H835" \w* art [thou, O Israel]{strong=“H3478”}: who is [like unto thee, O people]{strong=“H5971”} [saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8737”} by the \sc Lord\sc*, \w the shield| strong="H4043" \w* \w of thy help| strong="H5828" \w*, and who is \w the sword| strong="H2719" \w* \w of thy excellency| strong="H1346" \w*! [and thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [shall be found liars]{strong=“H3584” x-morph=“strongMorph: \sc Th\sc*8735”} [unto thee; and thou shalt tread]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon their high places| strong="H1116" \w*.\f + \fr 33:29 \ft found…: or, subdued \f*
\c 34
\p 
\v 1 \w And Moses| strong="H4872" \w* [went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the plains| strong="H6160" \w* \w of Moab| strong="H4124" \w* \w unto the mountain| strong="H2022" \w* \w of Nebo| strong="H5015" \w*, \w to the top| strong="H7218" \w* \w of Pisgah| strong="H6449" \w*, that is \w over against| strong="H6440" \w* \w Jericho| strong="H3405" \w*. And the \sc Lord\sc* [shewed]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8686”} \w him all the land| strong="H776" \w* \w of Gilead| strong="H1568" \w*, \w unto Dan| strong="H1835" \w*,\f + \fr 34:1 \ft Pisgah: or, the hill \f* 
\v 2 \w And all Naphtali| strong="H5321" \w*, \w and the land| strong="H776" \w* \w of Ephraim| strong="H669" \w*, \w and Manasseh| strong="H4519" \w*, \w and all the land| strong="H776" \w* \w of Judah| strong="H3063" \w*, \w unto the utmost| strong="H314" \w* \w sea| strong="H3220" \w*, 
