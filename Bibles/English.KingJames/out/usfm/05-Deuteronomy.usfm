\v 6 [Thou shalt build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w the altar| strong="H4196" \w* of the \sc Lord\sc* \w thy God| strong="H430" \w* \w of whole| strong="H8003" \w* \w stones| strong="H68" \w*: [and thou shalt offer]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} \w burnt offerings| strong="H5930" \w* thereon unto the \sc Lord\sc* \w thy God| strong="H430" \w*: 
\v 7 [And thou shalt offer]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8804”} \w peace offerings| strong="H8002" \w*, [and shalt eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} [there, and rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* the \sc Lord\sc* \w thy God| strong="H430" \w*. 
