\p
\v 15 [See]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}, [I have set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* \w thee this day| strong="H3117" \w* \w life| strong="H2416" \w* \w and good| strong="H2896" \w*, \w and death| strong="H4194" \w* \w and evil| strong="H7451" \w*; 
