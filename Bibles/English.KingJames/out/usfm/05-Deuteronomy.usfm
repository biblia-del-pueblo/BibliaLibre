\p
\v 7 [Thou shalt not abhor]{strong=“H8581” x-morph=“strongMorph: \sc Th\sc*8762”} \w an Edomite| strong="H130" \w*; for he is \w thy brother| strong="H251" \w*: [thou shalt not abhor]{strong=“H8581” x-morph=“strongMorph: \sc Th\sc*8762”} \w an Egyptian| strong="H4713" \w*; \w because thou wast a stranger| strong="H1616" \w* \w in his land| strong="H776" \w*. 
