\c 12
\p 
\v 1 These are \w the statutes| strong="H2706" \w* \w and judgments| strong="H4941" \w*, [which ye shall observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the land| strong="H776" \w*, which the \sc Lord\sc* \w God| strong="H430" \w* \w of thy fathers| strong="H1" \w* [giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [thee to possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} [it, all the days]{strong=“H3117”} \w that ye live| strong="H2416" \w* \w upon the earth| strong="H127" \w*. 
\v 2 [Ye shall utterly]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8763”} [destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8762”} \w all the places| strong="H4725" \w*, \w wherein the nations| strong="H1471" \w* \w which| strong="H834" \w* [ye shall possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8802”} [served]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} \w their gods| strong="H430" \w*, [upon the high]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8802”} \w mountains| strong="H2022" \w*, \w and upon the hills| strong="H1389" \w*, \w and under every green| strong="H7488" \w* \w tree| strong="H6086" \w*:\f + \fr 12:2 \ft possess: or, inherit \f* 
\v 3 [And ye shall overthrow]{strong=“H5422” x-morph=“strongMorph: \sc Th\sc*8765”} \w their altars| strong="H4196" \w*, [and break]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8765”} \w their pillars| strong="H4676" \w*, [and burn]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8799”} \w their groves| strong="H842" \w* \w with fire| strong="H784" \w*; [and ye shall hew down]{strong=“H1438” x-morph=“strongMorph: \sc Th\sc*8762”} \w the graven images| strong="H6456" \w* \w of their gods| strong="H430" \w*, [and destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8765”} \w the names| strong="H8034" \w* \w of them out of that place| strong="H4725" \w*.\f + \fr 12:3 \ft overthrow: Heb. break down \f* 
