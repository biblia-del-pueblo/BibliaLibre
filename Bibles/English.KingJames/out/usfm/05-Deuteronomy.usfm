\v 14 For the \sc Lord\sc* \w thy God| strong="H430" \w* [walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8693”} \w in the midst| strong="H7130" \w* \w of thy camp| strong="H4264" \w*, [to deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8687”} [thee, and to give up]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} [thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w before| strong="H6440" \w* [thee; therefore shall thy camp]{strong=“H4264”} \w be holy| strong="H6918" \w*: [that he see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w no unclean| strong="H6172" \w* \w thing| strong="H1697" \w* [in thee, and turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w from thee| strong="H310" \w*.\f + \fr 23:14 \ft unclean…: Heb. nakedness of any thing \f* 
\p
\v 15 [Thou shalt not deliver]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto his master| strong="H113" \w* \w the servant| strong="H5650" \w* [which is escaped]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8735”} \w from his master| strong="H113" \w* unto thee: 
\v 16 [He shall dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} with thee, even \w among| strong="H7130" \w* [you, in that place]{strong=“H4725”} [which he shall choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} \w in one| strong="H259" \w* \w of thy gates| strong="H8179" \w*, \w where it liketh him best| strong="H2896" \w*: [thou shalt not oppress]{strong=“H3238” x-morph=“strongMorph: \sc Th\sc*8686”} him.\f + \fr 23:16 \ft liketh…: Heb. is good for him \f* 
\p
\v 17 \w There shall be no whore| strong="H6948" \w* \w of the daughters| strong="H1323" \w* \w of Israel| strong="H3478" \w*, \w nor a sodomite| strong="H6945" \w* \w of the sons| strong="H1121" \w* \w of Israel| strong="H3478" \w*.\f + \fr 23:17 \ft whore: or, sodomitess \f* 
\v 18 [Thou shalt not bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w the hire| strong="H868" \w* [of a whore]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”}, \w or the price| strong="H4242" \w* \w of a dog| strong="H3611" \w*, \w into the house| strong="H1004" \w* of the \sc Lord\sc* \w thy God| strong="H430" \w* \w for any vow| strong="H5088" \w*: \w for even both| strong="H8147" \w* these are \w abomination| strong="H8441" \w* unto the \sc Lord\sc* \w thy God| strong="H430" \w*. 
\p
\v 19 [Thou shalt not lend upon usury]{strong=“H5391” x-morph=“strongMorph: \sc Th\sc*8686”} \w to thy brother| strong="H251" \w*; \w usury| strong="H5392" \w* \w of money| strong="H3701" \w*, \w usury| strong="H5392" \w* \w of victuals| strong="H400" \w*, \w usury| strong="H5392" \w* \w of any thing| strong="H1697" \w* [that is lent upon usury]{strong=“H5391” x-morph=“strongMorph: \sc Th\sc*8799”}: 
\v 20 \w Unto a stranger| strong="H5237" \w* [thou mayest lend upon usury]{strong=“H5391” x-morph=“strongMorph: \sc Th\sc*8686”}; \w but unto thy brother| strong="H251" \w* [thou shalt not lend upon usury]{strong=“H5391” x-morph=“strongMorph: \sc Th\sc*8686”}: that the \sc Lord\sc* \w thy God| strong="H430" \w* [may bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w thee in all that thou settest| strong="H4916" \w* \w thine hand| strong="H3027" \w* \w to in the land| strong="H776" \w* [whither thou goest]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [to possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} it. 
\p
\v 21 [When thou shalt vow]{strong=“H5087” x-morph=“strongMorph: \sc Th\sc*8799”} \w a vow| strong="H5088" \w* unto the \sc Lord\sc* \w thy God| strong="H430" \w*, [thou shalt not slack]{strong=“H309” x-morph=“strongMorph: \sc Th\sc*8762”} [to pay]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8763”} it: for the \sc Lord\sc* \w thy God| strong="H430" \w* [will surely]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8800”} [require]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”} [it of thee; and it would be sin]{strong=“H2399”} in thee. 
\v 22 [But if thou shalt forbear]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8799”} [to vow]{strong=“H5087” x-morph=“strongMorph: \sc Th\sc*8800”}, \w it shall be no sin| strong="H2399" \w* in thee. 
\v 23 \w That which is gone out| strong="H4161" \w* \w of thy lips| strong="H8193" \w* [thou shalt keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} [and perform]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}; even \w a freewill offering| strong="H5071" \w*, [according as thou hast vowed]{strong=“H5087” x-morph=“strongMorph: \sc Th\sc*8804”} unto the \sc Lord\sc* \w thy God| strong="H430" \w*, [which thou hast promised]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w with thy mouth| strong="H6310" \w*. 
\p
\v 24 [When thou comest]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [into thy neighbour’s]{strong=“H7453”} \w vineyard| strong="H3754" \w*, [then thou mayest eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w grapes| strong="H6025" \w* \w thy fill| strong="H7648" \w* \w at thine own pleasure| strong="H5315" \w*; [but thou shalt not put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} any \w in thy vessel| strong="H3627" \w*. 
\v 25 [When thou comest]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the standing corn| strong="H7054" \w* \w of thy neighbour| strong="H7453" \w*, [then thou mayest pluck]{strong=“H6998” x-morph=“strongMorph: \sc Th\sc*8804”} \w the ears| strong="H4425" \w* \w with thine hand| strong="H3027" \w*; [but thou shalt not move]{strong=“H5130” x-morph=“strongMorph: \sc Th\sc*8686”} \w a sickle| strong="H2770" \w* [unto thy neighbour’s]{strong=“H7453”} \w standing corn| strong="H7054" \w*. 
\c 24
\p 
\v 1 \w When a man| strong="H376" \w* [hath taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a wife| strong="H802" \w*, [and married]{strong=“H1166” x-morph=“strongMorph: \sc Th\sc*8804”} [her, and it come to pass that she find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w no favour| strong="H2580" \w* \w in his eyes| strong="H5869" \w*, [because he hath found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w some| strong="H1697" \w* \w uncleanness| strong="H6172" \w* [in her: then let him write]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8804”} \w her a bill| strong="H5612" \w* \w of divorcement| strong="H3748" \w*, [and give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} it \w in her hand| strong="H3027" \w*, [and send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w her out of his house| strong="H1004" \w*.\f + \fr 24:1 \ft some…: Heb. matter of nakedness \f* \f + \fr 24:1 \ft divorcement: Heb. cutting off \f* 
\v 2 [And when she is departed out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w of his house| strong="H1004" \w*, [she may go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w and be another| strong="H312" \w* [man’s]{strong=“H376”} wife. 
\v 3 And if \w the latter| strong="H314" \w* \w husband| strong="H376" \w* [hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”} [her, and write]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8804”} \w her a bill| strong="H5612" \w* \w of divorcement| strong="H3748" \w*, [and giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} it \w in her hand| strong="H3027" \w*, [and sendeth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w her out of his house| strong="H1004" \w*; \w or if the latter| strong="H314" \w* \w husband| strong="H376" \w* [die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, [which took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} her to be \w his wife| strong="H802" \w*; 
\v 4 \w Her former| strong="H7223" \w* \w husband| strong="H1167" \w*, [which sent her away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”}, [may]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [not take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} [her again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w to be his wife| strong="H802" \w*, \w after| strong="H310" \w* [that she is defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8719”}; for that is \w abomination| strong="H8441" \w* \w before| strong="H6440" \w* the \sc Lord\sc*: \w and thou shalt not cause the land| strong="H776" \w* [to sin]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8686”}, which the \sc Lord\sc* \w thy God| strong="H430" \w* [giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} thee for \w an inheritance| strong="H5159" \w*. 
\p
\v 5 \w When a man| strong="H376" \w* [hath taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a new| strong="H2319" \w* \w wife| strong="H802" \w*, [he shall not go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w to war| strong="H6635" \w*, [neither shall he be charged]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w with any business| strong="H1697" \w*: but \w he shall be free| strong="H5355" \w* \w at home| strong="H1004" \w* \w one| strong="H259" \w* \w year| strong="H8141" \w*, [and shall cheer up]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8765”} \w his wife| strong="H802" \w* [which he hath taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 24:5 \ft neither…: Heb. not any thing shall pass upon him \f* 
\p
\v 6 \w No man shall take| strong="H2254" \w* \w the nether| strong="H7347" \w* \w or the upper millstone| strong="H7393" \w* [to pledge]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8799”}: \w for he taketh| strong="H2254" \w* a man’s \w life| strong="H5315" \w* [to pledge]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\p
\v 7 \w If a man| strong="H376" \w* [be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”} [stealing]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8802”} \w any| strong="H5315" \w* \w of his brethren| strong="H251" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [and maketh merchandise]{strong=“H6014” x-morph=“strongMorph: \sc Th\sc*8694”} [of him, or selleth]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8804”} [him; then that thief]{strong=“H1590”} [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}; \w and thou shalt put| strong="H1197" \w* \w evil| strong="H7451" \w* [away]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8765”} \w from among| strong="H7130" \w* you. 
\p
\v 8 [Take heed]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8734”} \w in the plague| strong="H5061" \w* \w of leprosy| strong="H6883" \w*, [that thou observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w diligently| strong="H3966" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w according to all that the priests| strong="H3548" \w* \w the Levites| strong="H3881" \w* [shall teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”} [you: as I commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} them, so [ye shall observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 9 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8800”} what the \sc Lord\sc* \w thy God| strong="H430" \w* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto Miriam| strong="H4813" \w* \w by the way| strong="H1870" \w*, [after that ye were come forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”} \w out of Egypt| strong="H4714" \w*. 
\p
\v 10 [When thou dost lend]{strong=“H5383” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy brother| strong="H7453" \w* \w any| strong="H3972" \w* \w thing| strong="H4859" \w*, [thou shalt not go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into his house| strong="H1004" \w* [to fetch]{strong=“H5670” x-morph=“strongMorph: \sc Th\sc*8800”} \w his pledge| strong="H5667" \w*.\f + \fr 24:10 \ft lend…: Heb. lend the loan of any thing to, etc \f* 
\v 11 [Thou shalt stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w abroad| strong="H2351" \w*, \w and the man| strong="H376" \w* [to whom thou dost lend]{strong=“H5383” x-morph=“strongMorph: \sc Th\sc*8802”} [shall bring out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w the pledge| strong="H5667" \w* \w abroad| strong="H2351" \w* unto thee. 
\v 12 \w And if the man| strong="H376" \w* be \w poor| strong="H6041" \w*, [thou shalt not sleep]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w with his pledge| strong="H5667" \w*: 
\v 13 [In any case]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} \w thou shalt deliver| strong="H7725" \w* \w him the pledge| strong="H5667" \w* [again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w when the sun| strong="H8121" \w* [goeth down]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}, [that he may sleep]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his own raiment| strong="H8008" \w*, [and bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} [thee: and it shall be righteousness]{strong=“H6666”} \w unto thee before| strong="H6440" \w* the \sc Lord\sc* \w thy God| strong="H430" \w*. 
\p
\v 14 [Thou shalt not oppress]{strong=“H6231” x-morph=“strongMorph: \sc Th\sc*8799”} \w an hired servant| strong="H7916" \w* that is \w poor| strong="H6041" \w* \w and needy| strong="H34" \w*, whether he be \w of thy brethren| strong="H251" \w*, \w or of thy strangers| strong="H1616" \w* that are \w in thy land| strong="H776" \w* \w within thy gates| strong="H8179" \w*: 
\v 15 \w At his day| strong="H3117" \w* [thou shalt give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} him \w his hire| strong="H7939" \w*, \w neither shall the sun| strong="H8121" \w* [go down]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} upon it; for he is \w poor| strong="H6041" \w*, [and setteth]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8802”} \w his heart| strong="H5315" \w* [upon it: lest he cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} against thee unto the \sc Lord\sc*, \w and it be sin| strong="H2399" \w* unto thee.\f + \fr 24:15 \ft setteth…: Heb. lifteth his soul unto it \f* 
\v 16 \w The fathers| strong="H1" \w* [shall not be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”} \w for the children| strong="H1121" \w*, \w neither shall the children| strong="H1121" \w* [be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”} \w for the fathers| strong="H1" \w*: \w every man| strong="H376" \w* [shall be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”} \w for his own sin| strong="H2399" \w*. 
\p
\v 17 [Thou shalt not pervert]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w the judgment| strong="H4941" \w* \w of the stranger| strong="H1616" \w*, nor \w of the fatherless| strong="H3490" \w*; \w nor take| strong="H2254" \w* [a widow’s]{strong=“H490”} \w raiment| strong="H899" \w* [to pledge]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8799”}: 
\v 18 [But thou shalt remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w that thou wast a bondman| strong="H5650" \w* \w in Egypt| strong="H4714" \w*, and the \sc Lord\sc* \w thy God| strong="H430" \w* [redeemed ]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8799”} [thee thence: therefore I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} [thee to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w this thing| strong="H1697" \w*. 
\p
\v 19 [When thou cuttest down]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8799”} \w thine harvest| strong="H7105" \w* \w in thy field| strong="H7704" \w*, [and hast forgot]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} \w a sheaf| strong="H6016" \w* \w in the field| strong="H7704" \w*, [thou shalt not go again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [to fetch]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} [it: it shall be for the stranger]{strong=“H1616”}, \w for the fatherless| strong="H3490" \w*, \w and for the widow| strong="H490" \w*: that the \sc Lord\sc* \w thy God| strong="H430" \w* [may bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w thee in all the work| strong="H4639" \w* \w of thine hands| strong="H3027" \w*. 
\v 20 [When thou beatest]{strong=“H2251” x-morph=“strongMorph: \sc Th\sc*8799”} \w thine olive tree| strong="H2132" \w*, [thou shalt not go over the boughs]{strong=“H6286” x-morph=“strongMorph: \sc Th\sc*8762”} \w again| strong="H310" \w*: \w it shall be for the stranger| strong="H1616" \w*, \w for the fatherless| strong="H3490" \w*, \w and for the widow| strong="H490" \w*.\f + \fr 24:20 \ft go…: Heb. bough it after thee \f* 
\v 21 [When thou gatherest]{strong=“H1219” x-morph=“strongMorph: \sc Th\sc*8799”} \w the grapes of thy vineyard| strong="H3754" \w*, [thou shalt not glean]{strong=“H5953” x-morph=“strongMorph: \sc Th\sc*8779”} it \w afterward| strong="H310" \w*: \w it shall be for the stranger| strong="H1616" \w*, \w for the fatherless| strong="H3490" \w*, \w and for the widow| strong="H490" \w*.\f + \fr 24:21 \ft afterward: Heb. after thee \f* 
\v 22 [And thou shalt remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w that thou wast a bondman| strong="H5650" \w* \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*: [therefore I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} [thee to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w this thing| strong="H1697" \w*.
\c 25
\p 
\v 1 \w If there be a controversy| strong="H7379" \w* \w between men| strong="H582" \w*, [and they come]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto judgment| strong="H4941" \w*, that the judges [may judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8804”} [them; then they shall justify]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8689”} \w the righteous| strong="H6662" \w*, [and condemn]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8689”} \w the wicked| strong="H7563" \w*. 
\v 2 [And it shall be, if the wicked man]{strong=“H7563”} be \w worthy| strong="H1121" \w* [to be beaten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8687”}, [that the judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} [shall cause him to lie down]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8689”}, [and to be beaten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w before his face| strong="H6440" \w*, \w according| strong="H1767" \w* \w to his fault| strong="H7564" \w*, \w by a certain number| strong="H4557" \w*. 
\v 3 \w Forty| strong="H705" \w* [stripes]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} he may give him, and [not exceed]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”}: lest, if [he should exceed]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”}, [and beat]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8687”} \w him above these with many| strong="H7227" \w* \w stripes| strong="H4347" \w*, \w then thy brother| strong="H251" \w* [should seem vile]{strong=“H5869 H7034” x-morph=“strongMorph: \sc Th\sc*8738”} unto thee. 
\p
\v 4 [Thou shalt not muzzle]{strong=“H2629” x-morph=“strongMorph: \sc Th\sc*8799”} \w the ox| strong="H7794" \w* [when he treadeth out]{strong=“H1778” x-morph=“strongMorph: \sc Th\sc*8800”} the corn.\f + \fr 25:4 \ft treadeth…: Heb. thresheth \f* 
\p
\v 5 \w If brethren| strong="H251" \w* [dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w together| strong="H3162" \w*, \w and one| strong="H259" \w* [of them die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and have no child| strong="H1121" \w*, \w the wife| strong="H802" \w* [of the dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”} \w shall not marry without| strong="H2351" \w* [unto a stranger]{strong=“H2114 H376” x-morph=“strongMorph: \sc Th\sc*8801”}: [her husband’s brother]{strong=“H2993”} [shall go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [unto her, and take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w her to him to wife| strong="H802" \w*, [and perform the duty of an husband’s brother]{strong=“H2992” x-morph=“strongMorph: \sc Th\sc*8762”} unto her.\f + \fr 25:5 \ft her husband’s…: or, her next kinsman \f* 
\v 6 And it shall be, that \w the firstborn| strong="H1060" \w* [which she beareth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8799”} [shall succeed]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the name| strong="H8034" \w* \w of his brother| strong="H251" \w* which is [dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”}, \w that his name| strong="H8034" \w* [be not put out]{strong=“H4229” x-morph=“strongMorph: \sc Th\sc*8735”} \w of Israel| strong="H3478" \w*. 
