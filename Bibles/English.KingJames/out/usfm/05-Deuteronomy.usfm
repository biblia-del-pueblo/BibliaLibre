\c 29
\p 
\v 1 These are \w the words| strong="H1697" \w* \w of the covenant| strong="H1285" \w*, which the \sc Lord\sc* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w Moses| strong="H4872" \w* [to make]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8800”} \w with the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* \w in the land| strong="H776" \w* \w of Moab| strong="H4124" \w*, \w beside the covenant| strong="H1285" \w* [which he made]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8804”} \w with them in Horeb| strong="H2722" \w*. 
\p
\v 2 \w And Moses| strong="H4872" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto all Israel| strong="H3478" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Ye have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} all that the \sc Lord\sc* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w before your eyes| strong="H5869" \w* \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* \w unto Pharaoh| strong="H6547" \w*, \w and unto all his servants| strong="H5650" \w*, \w and unto all his land| strong="H776" \w*; 
\v 3 \w The great| strong="H1419" \w* \w temptations| strong="H4531" \w* \w which thine eyes| strong="H5869" \w* [have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the signs| strong="H226" \w*, \w and those great| strong="H1419" \w* \w miracles| strong="H4159" \w*: 
\v 4 Yet the \sc Lord\sc* [hath not given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w you an heart| strong="H3820" \w* [to perceive]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”}, \w and eyes| strong="H5869" \w* [to see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”}, \w and ears| strong="H241" \w* [to hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”}, \w unto this day| strong="H3117" \w*. 
\v 5 [And I have led]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8686”} \w you forty| strong="H705" \w* \w years| strong="H8141" \w* \w in the wilderness| strong="H4057" \w*: \w your clothes| strong="H8008" \w* [are not waxen old]{strong=“H1086” x-morph=“strongMorph: \sc Th\sc*8804”} [upon you, and thy shoe]{strong=“H5275”} [is not waxen old]{strong=“H1086” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon thy foot| strong="H7272" \w*. 
\v 6 [Ye have not eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w bread| strong="H3899" \w*, [neither have ye drunk]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8804”} \w wine| strong="H3196" \w* \w or strong drink| strong="H7941" \w*: [that ye might know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} that I am the \sc Lord\sc* \w your God| strong="H430" \w*. 
\v 7 [And when ye came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto this place| strong="H4725" \w*, \w Sihon| strong="H5511" \w* \w the king| strong="H4428" \w* \w of Heshbon| strong="H2809" \w*, \w and Og| strong="H5747" \w* \w the king| strong="H4428" \w* \w of Bashan| strong="H1316" \w*, [came out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} [against]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} \w us unto battle| strong="H4421" \w*, [and we smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} them: 
\v 8 [And we took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w their land| strong="H776" \w*, [and gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w it for an inheritance| strong="H5159" \w* \w unto the Reubenites| strong="H7206" \w*, \w and to the Gadites| strong="H1425" \w*, \w and to the half| strong="H2677" \w* \w tribe| strong="H7626" \w* \w of Manasseh| strong="H4520" \w*. 
\v 9 [Keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w therefore the words| strong="H1697" \w* \w of this covenant| strong="H1285" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [them, that ye may prosper]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8686”} [in all that ye do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 10 [Ye stand]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8737”} \w this day| strong="H3117" \w* \w all of you before| strong="H6440" \w* the \sc Lord\sc* \w your God| strong="H430" \w*; \w your captains| strong="H7218" \w* \w of your tribes| strong="H7626" \w*, \w your elders| strong="H2205" \w*, [and your officers]{strong=“H7860” x-morph=“strongMorph: \sc Th\sc*8802”}, with \w all the men| strong="H376" \w* \w of Israel| strong="H3478" \w*, 
\v 11 \w Your little ones| strong="H2945" \w*, \w your wives| strong="H802" \w*, \w and thy stranger| strong="H1616" \w* that is \w in| strong="H7130" \w* \w thy camp| strong="H4264" \w*, [from the hewer]{strong=“H2404” x-morph=“strongMorph: \sc Th\sc*8802”} \w of thy wood| strong="H6086" \w* [unto the drawer]{strong=“H7579” x-morph=“strongMorph: \sc Th\sc*8802”} \w of thy water| strong="H4325" \w*: 
\v 12 [That thou shouldest enter]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8800”} \w into covenant| strong="H1285" \w* with the \sc Lord\sc* \w thy God| strong="H430" \w*, \w and into his oath| strong="H423" \w*, which the \sc Lord\sc* \w thy God| strong="H430" \w* [maketh]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8802”} \w with thee this day| strong="H3117" \w*:\f + \fr 29:12 \ft enter: Heb. pass \f* 
\v 13 [That he may establish]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8687”} \w thee to day| strong="H3117" \w* \w for a people| strong="H5971" \w* unto himself, and that \w he may be unto thee a God| strong="H430" \w*, [as he hath said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [unto thee, and as he hath sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto thy fathers| strong="H1" \w*, \w to Abraham| strong="H85" \w*, \w to Isaac| strong="H3327" \w*, \w and to Jacob| strong="H3290" \w*. 
\v 14 [Neither with you only do I make]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8802”} \w this covenant| strong="H1285" \w* \w and this oath| strong="H423" \w*; 
