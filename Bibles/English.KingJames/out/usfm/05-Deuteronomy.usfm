\v 23 [And he brought us out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} [from thence, that he might bring us in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”}, [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w us the land| strong="H776" \w* [which he sware]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto our fathers| strong="H1" \w*. 
\v 24 And the \sc Lord\sc* [commanded ]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} [us to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w all these statutes| strong="H2706" \w*, [to fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8800”} the \sc Lord\sc* \w our God| strong="H430" \w*, \w for our good| strong="H2896" \w* \w always| strong="H3117" \w*, [that he might preserve us alive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8763”}, as it is \w at this day| strong="H3117" \w*. 
\v 25 \w And it shall be our righteousness| strong="H6666" \w*, [if we observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w all these| strong="H2063" \w* \w commandments| strong="H4687" \w* \w before| strong="H6440" \w* the \sc Lord\sc* \w our God| strong="H430" \w*, [as he hath commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} us.
\c 7
\p 
\v 1 When the \sc Lord\sc* \w thy God| strong="H430" \w* [shall bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee into the land| strong="H776" \w* [whither thou goest]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [to possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} [it, and hath cast out]{strong=“H5394” x-morph=“strongMorph: \sc Th\sc*8804”} \w many| strong="H7227" \w* \w nations| strong="H1471" \w* \w before| strong="H6440" \w* [thee, the Hittites]{strong=“H2850”}, \w and the Girgashites| strong="H1622" \w*, \w and the Amorites| strong="H567" \w*, \w and the Canaanites| strong="H3669" \w*, \w and the Perizzites| strong="H6522" \w*, \w and the Hivites| strong="H2340" \w*, \w and the Jebusites| strong="H2983" \w*, \w seven| strong="H7651" \w* \w nations| strong="H1471" \w* \w greater| strong="H7227" \w* \w and mightier| strong="H6099" \w* than thou; 
\v 2 And when the \sc Lord\sc* \w thy God| strong="H430" \w* [shall deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w them before| strong="H6440" \w* [thee; thou shalt smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} them, and [utterly]{strong=“H2763” x-morph=“strongMorph: \sc Th\sc*8687”} [destroy]{strong=“H2763” x-morph=“strongMorph: \sc Th\sc*8686”} [them; thou shalt make]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} \w no covenant| strong="H1285" \w* [with them, nor shew mercy]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8799”} unto them: 
\v 3 [Neither shalt thou make marriages]{strong=“H2859” x-morph=“strongMorph: \sc Th\sc*8691”} [with them; thy daughter]{strong=“H1323”} [thou shalt not give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his son| strong="H1121" \w*, \w nor his daughter| strong="H1323" \w* [shalt thou take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto thy son| strong="H1121" \w*. 
\v 4 [For they will turn away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy son| strong="H1121" \w* \w from following| strong="H310" \w* [me, that they may serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} \w other| strong="H312" \w* \w gods| strong="H430" \w*: \w so will the anger| strong="H639" \w* of the \sc Lord\sc* [be kindled]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8804”} [against you, and destroy]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee suddenly| strong="H4118" \w*. 
\v 5 [But thus shall ye deal]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [with them; ye shall destroy]{strong=“H5422” x-morph=“strongMorph: \sc Th\sc*8799”} \w their altars| strong="H4196" \w*, [and break down]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8762”} \w their images| strong="H4676" \w*, [and cut down]{strong=“H1438” x-morph=“strongMorph: \sc Th\sc*8762”} \w their groves| strong="H842" \w*, [and burn]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8799”} \w their graven images| strong="H6456" \w* \w with fire| strong="H784" \w*.\f + \fr 7:5 \ft their images: Heb. their statues, or, pillars \f* 
\v 6 For thou art \w an holy| strong="H6918" \w* \w people| strong="H5971" \w* unto the \sc Lord\sc* \w thy God| strong="H430" \w*: the \sc Lord\sc* \w thy God| strong="H430" \w* [hath chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee to be a special| strong="H5459" \w* \w people| strong="H5971" \w* [unto himself, above all people]{strong=“H5971”} that are \w upon the face| strong="H6440" \w* \w of the earth| strong="H127" \w*. 
\v 7 The \sc Lord\sc* [did not set his love]{strong=“H2836” x-morph=“strongMorph: \sc Th\sc*8804”} [upon you, nor choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} [you, because ye were more]{strong=“H7230”} \w in number than any people| strong="H5971" \w*; for ye were \w the fewest| strong="H4592" \w* \w of all people| strong="H5971" \w*: 
\v 8 But because the \sc Lord\sc* \w loved| strong="H160" \w* [you, and because he would keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w the oath| strong="H7621" \w* [which he had sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto your fathers| strong="H1" \w*, hath the \sc Lord\sc* [brought you out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w with a mighty| strong="H2389" \w* \w hand| strong="H3027" \w*, [and redeemed]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8799”} \w you out of the house| strong="H1004" \w* \w of bondmen| strong="H5650" \w*, \w from the hand| strong="H3027" \w* \w of Pharaoh| strong="H6547" \w* \w king| strong="H4428" \w* \w of Egypt| strong="H4714" \w*. 
\v 9 [Know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} therefore that the \sc Lord\sc* \w thy God| strong="H430" \w*, he is \w God| strong="H430" \w*, [the faithful]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8737”} \w God| strong="H410" \w*, [which keepeth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w covenant| strong="H1285" \w* \w and mercy| strong="H2617" \w* [with them that love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} [him and keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w his commandments| strong="H4687" \w* \w to a thousand| strong="H505" \w* \w generations| strong="H1755" \w*; 
\v 10 [And repayeth]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8764”} [them that hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} \w him to their face| strong="H6440" \w*, [to destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8687”} [them: he will not be slack]{strong=“H309” x-morph=“strongMorph: \sc Th\sc*8762”} [to him that hateth]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} [him, he will repay]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w him to his face| strong="H6440" \w*. 
\v 11 [Thou shalt therefore keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w the commandments| strong="H4687" \w*, \w and the statutes| strong="H2706" \w*, \w and the judgments| strong="H4941" \w*, [which I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} \w thee this day| strong="H3117" \w*, [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} them. 
\p
\v 12 [Wherefore it shall come to pass, if]{strong=“H6118”} [ye hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w to these judgments| strong="H4941" \w*, [and keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”}, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} them, that the \sc Lord\sc* \w thy God| strong="H430" \w* [shall keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto thee the covenant| strong="H1285" \w* \w and the mercy| strong="H2617" \w* [which he sware]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto thy fathers| strong="H1" \w*:\f + \fr 7:12 \ft if: Heb. because \f* 
\v 13 [And he will love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, and bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} [thee, and multiply]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8689”} [thee: he will also bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} \w the fruit| strong="H6529" \w* \w of thy womb| strong="H990" \w*, \w and the fruit| strong="H6529" \w* \w of thy land| strong="H127" \w*, \w thy corn| strong="H1715" \w*, \w and thy wine| strong="H8492" \w*, \w and thine oil| strong="H3323" \w*, \w the increase| strong="H7698" \w* \w of thy kine| strong="H504" \w*, \w and the flocks| strong="H6251" \w* \w of thy sheep| strong="H6629" \w*, \w in the land| strong="H127" \w* [which he sware]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto thy fathers| strong="H1" \w* [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} thee. 
\v 14 [Thou shalt be blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} \w above all people| strong="H5971" \w*: \w there shall not be male| strong="H6135" \w* \w or female barren| strong="H6135" \w* [among you, or among your cattle]{strong=“H929”}. 
\v 15 And the \sc Lord\sc* [will take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8689”} \w from thee all sickness| strong="H2483" \w*, [and will put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w none of the evil| strong="H7451" \w* \w diseases| strong="H4064" \w* \w of Egypt| strong="H4714" \w*, [which thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}, [upon thee; but will lay]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} them upon all them [that hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} thee. 
\v 16 [And thou shalt consume]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w all the people| strong="H5971" \w* which the \sc Lord\sc* \w thy God| strong="H430" \w* [shall deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} [thee; thine eye]{strong=“H5869”} [shall have no pity]{strong=“H2347” x-morph=“strongMorph: \sc Th\sc*8799”} [upon them: neither shalt thou serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} \w their gods| strong="H430" \w*; for that will be \w a snare| strong="H4170" \w* unto thee. 
\v 17 [If thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thine heart| strong="H3824" \w*, \w These nations| strong="H1471" \w* are \w more| strong="H7227" \w* [than I; how]{strong=“H349”} [can]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [I dispossess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8687”} them? 
\v 18 [Thou shalt not be afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} of them: but [shalt well]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8800”} [remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} what the \sc Lord\sc* \w thy God| strong="H430" \w* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto Pharaoh| strong="H6547" \w*, \w and unto all Egypt| strong="H4714" \w*; 
\v 19 \w The great| strong="H1419" \w* \w temptations| strong="H4531" \w* \w which thine eyes| strong="H5869" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and the signs| strong="H226" \w*, \w and the wonders| strong="H4159" \w*, \w and the mighty| strong="H2389" \w* \w hand| strong="H3027" \w*, [and the stretched out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8803”} \w arm| strong="H2220" \w*, whereby the \sc Lord\sc* \w thy God| strong="H430" \w* [brought thee out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”}: so shall the \sc Lord\sc* \w thy God| strong="H430" \w* [do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto all the people| strong="H5971" \w* [of whom thou art afraid]{strong=“H6440 H3373”}. 
\v 20 Moreover the \sc Lord\sc* \w thy God| strong="H430" \w* [will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w the hornet| strong="H6880" \w* [among them, until they that are left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”}, [and hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8737”} \w themselves from| strong="H6440" \w* [thee, be destroyed]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 21 [Thou shalt not be affrighted]{strong=“H6206” x-morph=“strongMorph: \sc Th\sc*8799”} \w at| strong="H6440" \w* them: for the \sc Lord\sc* \w thy God| strong="H430" \w* is \w among| strong="H7130" \w* [you, a mighty]{strong=“H1419”} \w God| strong="H410" \w* [and terrible]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”}. 
\v 22 And the \sc Lord\sc* \w thy God| strong="H430" \w* [will put out]{strong=“H5394” x-morph=“strongMorph: \sc Th\sc*8804”} \w those| strong="H411" \w* \w nations| strong="H1471" \w* \w before| strong="H6440" \w* \w thee by little| strong="H4592" \w* \w and little| strong="H4592" \w*: [thou mayest]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [not consume]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8763”} \w them at once| strong="H4118" \w*, \w lest the beasts| strong="H2416" \w* \w of the field| strong="H7704" \w* [increase]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8799”} upon thee.\f + \fr 7:22 \ft put…: Heb. pluck off \f* 
\v 23 But the \sc Lord\sc* \w thy God| strong="H430" \w* [shall deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w them unto thee| strong="H6440" \w*, [and shall destroy]{strong=“H1949” x-morph=“strongMorph: \sc Th\sc*8804”} \w them with a mighty| strong="H1419" \w* \w destruction| strong="H4103" \w*, [until they be destroyed]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8736”}.\f + \fr 7:23 \ft unto…: Heb. before thy face \f* 
\v 24 [And he shall deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w their kings| strong="H4428" \w* \w into thine hand| strong="H3027" \w*, [and thou shalt destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8689”} \w their name| strong="H8034" \w* \w from under heaven| strong="H8064" \w*: \w there shall no man| strong="H376" \w* [be able to stand]{strong=“H3320” x-morph=“strongMorph: \sc Th\sc*8691”} \w before| strong="H6440" \w* [thee, until thou have destroyed]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8687”} them. 
\v 25 \w The graven images| strong="H6456" \w* \w of their gods| strong="H430" \w* [shall ye burn]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8799”} \w with fire| strong="H784" \w*: [thou shalt not desire]{strong=“H2530” x-morph=“strongMorph: \sc Th\sc*8799”} \w the silver| strong="H3701" \w* \w or gold| strong="H2091" \w* that is [on them, nor take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} it [unto thee, lest thou be snared]{strong=“H3369” x-morph=“strongMorph: \sc Th\sc*8735”} therein: for it is \w an abomination| strong="H8441" \w* to the \sc Lord\sc* \w thy God| strong="H430" \w*. 
\v 26 [Neither shalt thou bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w an abomination| strong="H8441" \w* \w into thine house| strong="H1004" \w*, \w lest thou be a cursed thing| strong="H2764" \w* like it: but [thou shalt utterly]{strong=“H8262” x-morph=“strongMorph: \sc Th\sc*8763”} [detest]{strong=“H8262” x-morph=“strongMorph: \sc Th\sc*8762”} [it, and thou shalt utterly]{strong=“H8581” x-morph=“strongMorph: \sc Th\sc*8763”} [abhor]{strong=“H8581” x-morph=“strongMorph: \sc Th\sc*8762”} it; for it is \w a cursed thing| strong="H2764" \w*.
\c 8
\p 
\v 1 \w All the commandments| strong="H4687" \w* [which I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} \w thee this day| strong="H3117" \w* [shall ye observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”}, [that ye may live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}, [and multiply]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8804”}, [and go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [and possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8804”} \w the land| strong="H776" \w* which the \sc Lord\sc* [sware]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto your fathers| strong="H1" \w*. 
\v 2 [And thou shalt remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w all the way| strong="H1870" \w* which the \sc Lord\sc* \w thy God| strong="H430" \w* [led]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee these forty| strong="H705" \w* \w years| strong="H8141" \w* \w in the wilderness| strong="H4057" \w*, [to humble]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8763”} thee, and [to prove]{strong=“H5254” x-morph=“strongMorph: \sc Th\sc*8763”} [thee, to know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} what was \w in thine heart| strong="H3824" \w*, [whether thou wouldest keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w his commandments| strong="H4687" \w*, or no. 
\v 3 [And he humbled]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8762”} [thee, and suffered thee to hunger]{strong=“H7456” x-morph=“strongMorph: \sc Th\sc*8686”}, [and fed]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee with manna| strong="H4478" \w*, [which thou knewest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [not, neither did thy fathers]{strong=“H1”} [know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}; [that he might make thee know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8687”} \w that man| strong="H120" \w* [doth not live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”} \w by bread| strong="H3899" \w* \w only| strong="H905" \w*, but by every word \w that proceedeth| strong="H4161" \w* \w out of the mouth| strong="H6310" \w* of the \sc Lord\sc* \w doth man| strong="H120" \w* [live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 4 \w Thy raiment| strong="H8071" \w* [waxed not old]{strong=“H1086” x-morph=“strongMorph: \sc Th\sc*8804”} [upon thee, neither did thy foot]{strong=“H7272”} [swell]{strong=“H1216” x-morph=“strongMorph: \sc Th\sc*8804”}, \w these forty| strong="H705" \w* \w years| strong="H8141" \w*. 
\v 5 [Thou shalt also consider]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w in| strong="H5973" \w* \w thine heart| strong="H3824" \w*, [that, as a man]{strong=“H376”} [chasteneth ]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8762”} \w his son| strong="H1121" \w*, so the \sc Lord\sc* \w thy God| strong="H430" \w* [chasteneth]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8764”} thee. 
\v 6 [Therefore thou shalt keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w the commandments| strong="H4687" \w* of the \sc Lord\sc* \w thy God| strong="H430" \w*, [to walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} \w in his ways| strong="H1870" \w*, [and to fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8800”} him. 
\v 7 For the \sc Lord\sc* \w thy God| strong="H430" \w* [bringeth]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w thee into a good| strong="H2896" \w* \w land| strong="H776" \w*, \w a land| strong="H776" \w* \w of brooks| strong="H5158" \w* \w of water| strong="H4325" \w*, \w of fountains| strong="H5869" \w* \w and depths| strong="H8415" \w* [that spring out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} \w of valleys| strong="H1237" \w* \w and hills| strong="H2022" \w*; 
\v 8 \w A land| strong="H776" \w* \w of wheat| strong="H2406" \w*, \w and barley| strong="H8184" \w*, \w and vines| strong="H1612" \w*, \w and fig trees| strong="H8384" \w*, \w and pomegranates| strong="H7416" \w*; \w a land| strong="H776" \w* \w of oil| strong="H8081" \w* \w olive| strong="H2132" \w*, \w and honey| strong="H1706" \w*;\f + \fr 8:8 \ft of oil…: Heb. of olive tree of oil \f* 
