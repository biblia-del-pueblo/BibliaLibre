\p
\v 12 \w Thou shalt have a place also| strong="H3027" \w* \w without| strong="H2351" \w* \w the camp| strong="H4264" \w*, [whither thou shalt go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w abroad| strong="H2351" \w*: 
