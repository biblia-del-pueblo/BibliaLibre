\v 31 [Thou shalt not do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} so unto the \sc Lord\sc* \w thy God| strong="H430" \w*: \w for every abomination| strong="H8441" \w* to the \sc Lord\sc*, [which he hateth]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”}, [have they done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto their gods| strong="H430" \w*; \w for even their sons| strong="H1121" \w* \w and their daughters| strong="H1323" \w* [they have burnt]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the fire| strong="H784" \w* \w to their gods| strong="H430" \w*.\f + \fr 12:31 \ft to the: Heb. of the \f* 
\v 32 \w What thing| strong="H1697" \w* [soever I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} [you, observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [it: thou shalt not add]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [thereto, nor diminish]{strong=“H1639” x-morph=“strongMorph: \sc Th\sc*8799”} from it.
\c 13
\p 
\v 1 [If there arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w among| strong="H7130" \w* \w you a prophet| strong="H5030" \w*, [or a dreamer]{strong=“H2492” x-morph=“strongMorph: \sc Th\sc*8802”} \w of dreams| strong="H2472" \w*, [and giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee a sign| strong="H226" \w* \w or a wonder| strong="H4159" \w*, 
\v 2 \w And the sign| strong="H226" \w* \w or the wonder| strong="H4159" \w* [come to pass]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, [whereof he spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [unto thee, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Let us go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w other| strong="H312" \w* \w gods| strong="H430" \w*, [which thou hast not known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}, [and let us serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8714”} them; 
\v 3 [Thou shalt not hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the words| strong="H1697" \w* \w of that prophet| strong="H5030" \w*, [or that dreamer]{strong=“H2492” x-morph=“strongMorph: \sc Th\sc*8802”} \w of dreams| strong="H2472" \w*: for the \sc Lord\sc* \w your God| strong="H430" \w* [proveth ]{strong=“H5254” x-morph=“strongMorph: \sc Th\sc*8764”} [you, to know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} \w whether ye| strong="H3426" \w* [love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} the \sc Lord\sc* \w your God| strong="H430" \w* \w with all your heart| strong="H3824" \w* \w and with all your soul| strong="H5315" \w*. 
\v 4 [Ye shall walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* the \sc Lord\sc* \w your God| strong="H430" \w*, [and fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [him, and keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w his commandments| strong="H4687" \w*, [and obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w his voice| strong="H6963" \w*, [and ye shall serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} [him, and cleave]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8799”} unto him. 
\v 5 \w And that prophet| strong="H5030" \w*, [or that dreamer]{strong=“H2492” x-morph=“strongMorph: \sc Th\sc*8802”} \w of dreams| strong="H2472" \w*, [shall be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}; [because he hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w to turn| strong="H5627" \w* you away from the \sc Lord\sc* \w your God| strong="H430" \w*, [which brought you out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8688”} \w of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, [and redeemed]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8802”} \w you out of the house| strong="H1004" \w* \w of bondage| strong="H5650" \w*, [to thrust]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8687”} \w thee out of the way| strong="H1870" \w* which the \sc Lord\sc* \w thy God| strong="H430" \w* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [thee to walk in]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”}. \w So shalt thou put| strong="H1197" \w* \w the evil| strong="H7451" \w* [away]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8765”} \w from the midst| strong="H7130" \w* of thee.^\sc 13:5 to turn…: Heb. revolt against the [Lord\sc*] 
\p
\v 6 \w If thy brother| strong="H251" \w*, \w the son| strong="H1121" \w* \w of thy mother| strong="H517" \w*, \w or thy son| strong="H1121" \w*, \w or thy daughter| strong="H1323" \w*, \w or the wife| strong="H802" \w* \w of thy bosom| strong="H2436" \w*, \w or thy friend| strong="H7453" \w*, which is \w as thine own soul| strong="H5315" \w*, [entice]{strong=“H5496” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee secretly| strong="H5643" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Let us go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [and serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} \w other| strong="H312" \w* \w gods| strong="H430" \w*, [which thou hast not known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}, [thou, nor thy fathers]{strong=“H1”}; 
\v 7 Namely, \w of the gods| strong="H430" \w* \w of the people| strong="H5971" \w* which are \w round about| strong="H5439" \w* [you, nigh]{strong=“H7138”} [unto thee, or far off]{strong=“H7350”} from thee, from the one \w end| strong="H7097" \w* \w of the earth| strong="H776" \w* even unto the other \w end| strong="H7097" \w* \w of the earth| strong="H776" \w*; 
\v 8 [Thou shalt not consent]{strong=“H14” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, nor hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him; neither shall thine eye]{strong=“H5869”} [pity]{strong=“H2347” x-morph=“strongMorph: \sc Th\sc*8799”} [him, neither shalt thou spare]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”}, [neither shalt thou conceal]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} him: 
\v 9 [But thou shalt surely]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8800”} [kill]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} [him; thine hand]{strong=“H3027”} \w shall be first| strong="H7223" \w* [upon him to put him to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8687”}, \w and afterwards| strong="H314" \w* \w the hand| strong="H3027" \w* \w of all the people| strong="H5971" \w*. 
\v 10 [And thou shalt stone]{strong=“H5619” x-morph=“strongMorph: \sc Th\sc*8804”} \w him with stones| strong="H68" \w*, [that he die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}; [because he hath sought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8765”} [to thrust thee away]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8687”} from the \sc Lord\sc* \w thy God| strong="H430" \w*, [which brought thee out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8688”} \w of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, \w from the house| strong="H1004" \w* \w of bondage| strong="H5650" \w*.\f + \fr 13:10 \ft bondage: Heb. bondmen \f* 
\v 11 \w And all Israel| strong="H3478" \w* [shall hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}, [and fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}, [and shall do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [no more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w any| strong="H1697" \w* \w such wickedness| strong="H7451" \w* \w as this is among| strong="H7130" \w* you. 
\p
\v 12 [If thou shalt hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} say \w in one| strong="H259" \w* \w of thy cities| strong="H5892" \w*, which the \sc Lord\sc* \w thy God| strong="H430" \w* [hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} [thee to dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} [there, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
