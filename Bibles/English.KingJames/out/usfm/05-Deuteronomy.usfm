\v 18 [I denounce]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} \w unto you this day| strong="H3117" \w*, [that ye shall surely]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8800”} [perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}, and that [ye shall not prolong]{strong=“H748” x-morph=“strongMorph: \sc Th\sc*8686”} your \w days| strong="H3117" \w* \w upon the land| strong="H127" \w*, [whither thou passest over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} \w Jordan| strong="H3383" \w* [to go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [to possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} it. 
\v 19 \w I call| strong="H5749" \w* \w heaven| strong="H8064" \w* \w and earth| strong="H776" \w* [to record]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8689”} \w this day| strong="H3117" \w* against you, that [I have set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* \w you life| strong="H2416" \w* \w and death| strong="H4194" \w*, \w blessing| strong="H1293" \w* \w and cursing| strong="H7045" \w*: [therefore choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} \w life| strong="H2416" \w*, \w that both thou and thy seed| strong="H2233" \w* [may live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}: 
