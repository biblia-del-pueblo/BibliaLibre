\v 18 [And it shall be, when he sitteth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} \w upon the throne| strong="H3678" \w* \w of his kingdom| strong="H4467" \w*, [that he shall write]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8804”} \w him a copy| strong="H4932" \w* \w of this law| strong="H8451" \w* \w in a book| strong="H5612" \w* out of that which is \w before| strong="H6440" \w* \w the priests| strong="H3548" \w* \w the Levites| strong="H3881" \w*: 
\v 19 [And it shall be with him, and he shall read]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w therein all the days| strong="H3117" \w* \w of his life| strong="H2416" \w*: [that he may learn]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8799”} [to fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8800”} the \sc Lord\sc* \w his God| strong="H430" \w*, [to keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w all the words| strong="H1697" \w* \w of this law| strong="H8451" \w* \w and these statutes| strong="H2706" \w*, [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} them: 
\v 20 \w That his heart| strong="H3824" \w* [be not lifted up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8800”} \w above his brethren| strong="H251" \w*, [and that he turn not aside]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8800”} \w from the commandment| strong="H4687" \w*, to \w the right hand| strong="H3225" \w*, or to \w the left| strong="H8040" \w*: [to the end that he may prolong]{strong=“H748” x-morph=“strongMorph: \sc Th\sc*8686”} his \w days| strong="H3117" \w* \w in his kingdom| strong="H4467" \w*, [he, and his children]{strong=“H1121”}, \w in the midst| strong="H7130" \w* \w of Israel| strong="H3478" \w*. 
\c 18
\p 
\v 1 \w The priests| strong="H3548" \w* \w the Levites| strong="H3881" \w*, and \w all the tribe| strong="H7626" \w* \w of Levi| strong="H3878" \w*, \w shall have no part| strong="H2506" \w* \w nor inheritance| strong="H5159" \w* \w with Israel| strong="H3478" \w*: [they shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the offerings| strong="H801" \w* of the \sc Lord\sc* \w made by fire| strong="H801" \w*, \w and his inheritance| strong="H5159" \w*. 
\v 2 \w Therefore shall they have no inheritance| strong="H5159" \w* \w among| strong="H7130" \w* \w their brethren| strong="H251" \w*: the \sc Lord\sc* is \w their inheritance| strong="H5159" \w*, [as he hath said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} unto them. 
\p
\v 3 [And this shall be the priest’s]{strong=“H3548”} \w due| strong="H4941" \w* \w from the people| strong="H5971" \w*, [from them that offer]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8802”} \w a sacrifice| strong="H2077" \w*, whether it be \w ox| strong="H7794" \w* \w or sheep| strong="H7716" \w*; [and they shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the priest| strong="H3548" \w* \w the shoulder| strong="H2220" \w*, \w and the two cheeks| strong="H3895" \w*, \w and the maw| strong="H6896" \w*. 
\v 4 \w The firstfruit| strong="H7225" \w* also \w of thy corn| strong="H1715" \w*, \w of thy wine| strong="H8492" \w*, \w and of thine oil| strong="H3323" \w*, \w and the first| strong="H7225" \w* \w of the fleece| strong="H1488" \w* \w of thy sheep| strong="H6629" \w*, [shalt thou give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} him. 
\v 5 For the \sc Lord\sc* \w thy God| strong="H430" \w* [hath chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} \w him out of all thy tribes| strong="H7626" \w*, [to stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8800”} [to minister]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8763”} \w in the name| strong="H8034" \w* of the \sc Lord\sc*, \w him and his sons| strong="H1121" \w* \w for ever| strong="H3117" \w*. 
\p
\v 6 \w And if a Levite| strong="H3881" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w from any| strong="H259" \w* \w of thy gates| strong="H8179" \w* \w out of all Israel| strong="H3478" \w*, [where he sojourned]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8802”}, [and come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w with all the desire| strong="H185" \w* \w of his mind| strong="H5315" \w* \w unto the place| strong="H4725" \w* which the \sc Lord\sc* [shall choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”}; 
\v 7 [Then he shall minister]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8765”} \w in the name| strong="H8034" \w* of the \sc Lord\sc* \w his God| strong="H430" \w*, \w as all his brethren| strong="H251" \w* \w the Levites| strong="H3881" \w* do, [which stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w there before| strong="H6440" \w* the \sc Lord\sc*. 
\v 8 \w They shall have like portions| strong="H2506" \w* [to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}, \w beside that which cometh of the sale| strong="H4465" \w* \w of his patrimony| strong="H1" \w*.\f + \fr 18:8 \ft that…: Heb. his sale by the fathers \f* 
\p
\v 9 [When thou art come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w into the land| strong="H776" \w* which the \sc Lord\sc* \w thy God| strong="H430" \w* [giveth ]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} [thee, thou shalt not learn]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8799”} [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w after the abominations| strong="H8441" \w* \w of those nations| strong="H1471" \w*. 
\v 10 [There shall not be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”} among you any one \w that maketh his son| strong="H1121" \w* \w or his daughter| strong="H1323" \w* [to pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8688”} \w through the fire| strong="H784" \w*, or [that useth]{strong=“H7080” x-morph=“strongMorph: \sc Th\sc*8802”} \w divination| strong="H7081" \w*, or [an observer of times]{strong=“H6049” x-morph=“strongMorph: \sc Th\sc*8781”}, [or an enchanter]{strong=“H5172” x-morph=“strongMorph: \sc Th\sc*8764”}, [or a witch]{strong=“H3784” x-morph=“strongMorph: \sc Th\sc*8764”}, 
\v 11 [Or a charmer]{strong=“H2267 H2266” x-morph=“strongMorph: \sc Th\sc*8802”}, [or a consulter]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8802”} \w with familiar spirits| strong="H178" \w*, \w or a wizard| strong="H3049" \w*, [or a necromancer]{strong=“H4191 H1875” x-morph=“strongMorph: \sc Th\sc*8801 strongMorph: \sc Th\sc*8802”}. 
\v 12 [For all that do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} these things are \w an abomination| strong="H8441" \w* unto the \sc Lord\sc*: \w and because| strong="H1558" \w* \w of these abominations| strong="H8441" \w* the \sc Lord\sc* \w thy God| strong="H430" \w* [doth drive them out]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8688”} \w from before| strong="H6440" \w* thee. 
\v 13 \w Thou shalt be perfect| strong="H8549" \w* with the \sc Lord\sc* \w thy God| strong="H430" \w*.\f + \fr 18:13 \ft perfect: or, upright, or, sincere \f* 
\v 14 \w For these nations| strong="H1471" \w*, [which thou shalt possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8802”}, [hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [unto observers of times]{strong=“H6049” x-morph=“strongMorph: \sc Th\sc*8781”}, [and unto diviners]{strong=“H7080” x-morph=“strongMorph: \sc Th\sc*8802”}: but as for thee, the \sc Lord\sc* \w thy God| strong="H430" \w* [hath not suffered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} thee so to do.\f + \fr 18:14 \ft possess: or, inherit \f* 
\p
\v 15 The \sc Lord\sc* \w thy God| strong="H430" \w* [will raise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto thee a Prophet| strong="H5030" \w* \w from the midst| strong="H7130" \w* [of thee, of thy brethren]{strong=“H251”}, [like unto me; unto him ye shall hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}; 
\v 16 [According to all that thou desiredst]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8804”} of the \sc Lord\sc* \w thy God| strong="H430" \w* \w in Horeb| strong="H2722" \w* \w in the day| strong="H3117" \w* \w of the assembly| strong="H6951" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Let me not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} [again]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w the voice| strong="H6963" \w* of the \sc Lord\sc* \w my God| strong="H430" \w*, [neither let me see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w this great| strong="H1419" \w* \w fire| strong="H784" \w* [any more, that I die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} not. 
\v 17 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, They have well]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8689”} spoken that [which they have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 18 [I will raise them up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8686”} \w a Prophet| strong="H5030" \w* \w from among| strong="H7130" \w* \w their brethren| strong="H251" \w*, [like unto thee, and will put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w my words| strong="H1697" \w* \w in his mouth| strong="H6310" \w*; [and he shall speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [unto them all that I shall command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} him. 
\v 19 And it shall come to pass, that \w whosoever| strong="H376" \w* [will not hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto my words| strong="H1697" \w* [which he shall speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w in my name| strong="H8034" \w*, [I will require]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”} it of him. 
\v 20 \w But the prophet| strong="H5030" \w*, [which shall presume]{strong=“H2102” x-morph=“strongMorph: \sc Th\sc*8686”} [to speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w a word| strong="H1697" \w* \w in my name| strong="H8034" \w*, [which I have not commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [him to speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”}, [or that shall speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w in the name| strong="H8034" \w* \w of other| strong="H312" \w* \w gods| strong="H430" \w*, \w even that prophet| strong="H5030" \w* [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 21 [And if thou say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thine heart| strong="H3824" \w*, [How shall we know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w the word| strong="H1697" \w* which the \sc Lord\sc* [hath not spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}? 
\v 22 \w When a prophet| strong="H5030" \w* [speaketh]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w in the name| strong="H8034" \w* of the \sc Lord\sc*, \w if the thing| strong="H1697" \w* [follow not, nor come to pass]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, that is \w the thing| strong="H1697" \w* which the \sc Lord\sc* [hath not spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}, but \w the prophet| strong="H5030" \w* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w it presumptuously| strong="H2087" \w*: [thou shalt not be afraid]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”} of him. 
\c 19
\p 
\v 1 When the \sc Lord\sc* \w thy God| strong="H430" \w* [hath cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8686”} \w the nations| strong="H1471" \w*, \w whose land| strong="H776" \w* the \sc Lord\sc* \w thy God| strong="H430" \w* [giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} [thee, and thou succeedest]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8804”} [them, and dwellest]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w in their cities| strong="H5892" \w*, \w and in their houses| strong="H1004" \w*;\f + \fr 19:1 \ft succeedest: Heb. inheritest, or, possessest \f* 
\v 2 [Thou shalt separate]{strong=“H914” x-morph=“strongMorph: \sc Th\sc*8686”} \w three| strong="H7969" \w* \w cities| strong="H5892" \w* \w for thee in the midst| strong="H8432" \w* \w of thy land| strong="H776" \w*, which the \sc Lord\sc* \w thy God| strong="H430" \w* [giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} [thee to possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} it. 
\v 3 [Thou shalt prepare]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee a way| strong="H1870" \w*, \w and divide the coasts| strong="H1366" \w* \w of thy land| strong="H776" \w*, which the \sc Lord\sc* \w thy God| strong="H430" \w* [giveth thee to inherit]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8686”}, [into three parts]{strong=“H8027” x-morph=“strongMorph: \sc Th\sc*8765”}, [that every slayer]{strong=“H7523” x-morph=“strongMorph: \sc Th\sc*8802”} [may flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8800”} thither. 
\p
\v 4 And this is \w the case| strong="H1697" \w* [of the slayer]{strong=“H7523” x-morph=“strongMorph: \sc Th\sc*8802”}, [which shall flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”} [thither, that he may live]{strong=“H2425” x-morph=“strongMorph: \sc Th\sc*8804”}: [Whoso killeth]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w his neighbour| strong="H7453" \w* [ignorantly]{strong=“H1847 H1097”}, [whom he hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} \w not in time| strong="H8543" \w* \w past| strong="H8032" \w*;\f + \fr 19:4 \ft in…: Heb. from yesterday the third day \f* 
\v 5 [As when a man goeth]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the wood| strong="H3293" \w* \w with his neighbour| strong="H7453" \w* [to hew]{strong=“H2404” x-morph=“strongMorph: \sc Th\sc*8800”} \w wood| strong="H6086" \w*, \w and his hand| strong="H3027" \w* [fetcheth a stroke]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8738”} \w with the axe| strong="H1631" \w* [to cut down]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8800”} \w the tree| strong="H6086" \w*, \w and the head| strong="H1270" \w* [slippeth]{strong=“H5394” x-morph=“strongMorph: \sc Th\sc*8804”} \w from the helve| strong="H6086" \w*, [and lighteth]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon his neighbour| strong="H7453" \w*, [that he die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}; [he shall flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto one| strong="H259" \w* \w of those cities| strong="H5892" \w*, [and live]{strong=“H2425” x-morph=“strongMorph: \sc Th\sc*8804”}:\f + \fr 19:5 \ft head: Heb. iron \f* \f + \fr 19:5 \ft helve: Heb. wood \f* \f + \fr 19:5 \ft lighteth…: Heb. findeth \f* 
\v 6 [Lest the avenger]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”} [of the blood]{strong=“H1818” x-morph=“strongMorph: \sc Th\sc*8676”} [pursue]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} [the slayer]{strong=“H7523 H310” x-morph=“strongMorph: \sc Th\sc*8802”}, \w while| strong="H3588" \w* \w his heart| strong="H3824" \w* [is hot]{strong=“H3179” x-morph=“strongMorph: \sc Th\sc*8799”}, [and overtake]{strong=“H5381” x-morph=“strongMorph: \sc Th\sc*8689”} [him, because the way]{strong=“H1870”} [is long]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8799”}, [and slay]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w him| strong="H5315" \w*; whereas he was \w not worthy| strong="H4941" \w* \w of death| strong="H4194" \w*, \w inasmuch as| strong="H3588" \w* [he hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} \w him not in time| strong="H8543" \w* \w past| strong="H8032" \w*.\f + \fr 19:6 \ft slay…: Heb. smite him in life \f* \f + \fr 19:6 \ft in…: Heb. from yesterday the third day \f* 
\v 7 [Wherefore I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} [thee, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Thou shalt separate]{strong=“H914” x-morph=“strongMorph: \sc Th\sc*8686”} \w three| strong="H7969" \w* \w cities| strong="H5892" \w* for thee. 
\v 8 And if the \sc Lord\sc* \w thy God| strong="H430" \w* [enlarge]{strong=“H7337” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy coast| strong="H1366" \w*, [as he hath sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto thy fathers| strong="H1" \w*, [and give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee all the land| strong="H776" \w* [which he promised]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto thy fathers| strong="H1" \w*; 
\v 9 [If thou shalt keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w all these commandments| strong="H4687" \w* [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [them, which I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} \w thee this day| strong="H3117" \w*, [to love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8800”} the \sc Lord\sc* \w thy God| strong="H430" \w*, [and to walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} \w ever| strong="H3117" \w* \w in his ways| strong="H1870" \w*; [then shalt thou add]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8804”} \w three| strong="H7969" \w* \w cities| strong="H5892" \w* [more for thee, beside these three]{strong=“H7969”}: 
\v 10 \w That innocent| strong="H5355" \w* \w blood| strong="H1818" \w* [be not shed]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8735”} \w in| strong="H7130" \w* \w thy land| strong="H776" \w*, which the \sc Lord\sc* \w thy God| strong="H430" \w* [giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} thee for \w an inheritance| strong="H5159" \w*, and so \w blood| strong="H1818" \w* be upon thee. 
\p
\v 11 \w But if any man| strong="H376" \w* [hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} \w his neighbour| strong="H7453" \w*, [and lie in wait]{strong=“H693” x-morph=“strongMorph: \sc Th\sc*8804”} [for him, and rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”} [against him, and smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w him mortally| strong="H5315" \w* [that he die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}, [and fleeth]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8804”} \w into one| strong="H259" \w* \w of these| strong="H411" \w* \w cities| strong="H5892" \w*:\f + \fr 19:11 \ft mortally: Heb. in life \f* 
\v 12 \w Then the elders| strong="H2205" \w* \w of his city| strong="H5892" \w* [shall send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [and fetch]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} [him thence, and deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w him into the hand| strong="H3027" \w* [of the avenger]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”} \w of blood| strong="H1818" \w*, [that he may die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 13 \w Thine eye| strong="H5869" \w* [shall not pity]{strong=“H2347” x-morph=“strongMorph: \sc Th\sc*8799”} [him, but thou shalt put away]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8765”} the guilt of \w innocent| strong="H5355" \w* \w blood| strong="H1818" \w* \w from Israel| strong="H3478" \w*, [that it may go well]{strong=“H2895” x-morph=“strongMorph: \sc Th\sc*8804”} with thee. 
\p
\v 14 [Thou shalt not remove]{strong=“H5253” x-morph=“strongMorph: \sc Th\sc*8686”} [thy neighbour’s]{strong=“H7453”} \w landmark| strong="H1366" \w*, \w which they of old time| strong="H7223" \w* [have set]{strong=“H1379” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thine inheritance| strong="H5159" \w*, [which thou shalt inherit]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the land| strong="H776" \w* that the \sc Lord\sc* \w thy God| strong="H430" \w* [giveth ]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} [thee to possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} it. 
\p
\v 15 \w One| strong="H259" \w* \w witness| strong="H5707" \w* [shall not rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w against a man| strong="H376" \w* \w for any iniquity| strong="H5771" \w*, \w or for any sin| strong="H2403" \w*, \w in any sin| strong="H2399" \w* [that he sinneth]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8799”}: \w at the mouth| strong="H6310" \w* \w of two| strong="H8147" \w* \w witnesses| strong="H5707" \w*, \w or at the mouth| strong="H6310" \w* \w of three| strong="H7969" \w* \w witnesses| strong="H5707" \w*, \w shall the matter| strong="H1697" \w* [be established]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 16 \w If a false| strong="H2555" \w* \w witness| strong="H5707" \w* [rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w against any man| strong="H376" \w* [to testify]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8800”} against him that which is \w wrong| strong="H5627" \w*;\f + \fr 19:16 \ft that…: or, falling away \f* 
\v 17 \w Then both| strong="H8147" \w* \w the men| strong="H582" \w*, \w between whom the controversy| strong="H7379" \w* is, [shall stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* the \sc Lord\sc*, \w before| strong="H6440" \w* \w the priests| strong="H3548" \w* [and the judges]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”}, \w which shall be in those days| strong="H3117" \w*; 
\v 18 [And the judges]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} [shall make diligent]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8687”} [inquisition]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8804”}: and, behold, if \w the witness| strong="H5707" \w* be \w a false| strong="H8267" \w* \w witness| strong="H5707" \w*, and [hath testified]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”} \w falsely| strong="H8267" \w* \w against his brother| strong="H251" \w*; 
\v 19 [Then shall ye do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [unto him, as he had thought]{strong=“H2161” x-morph=“strongMorph: \sc Th\sc*8804”} [to have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto his brother| strong="H251" \w*: \w so shalt thou put| strong="H1197" \w* \w the evil| strong="H7451" \w* [away]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8765”} \w from among| strong="H7130" \w* you. 
\v 20 [And those which remain]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”} [shall hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}, [and fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}, [and shall henceforth]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [commit]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w no more any| strong="H1697" \w* \w such evil| strong="H7451" \w* \w among| strong="H7130" \w* you. 
\v 21 \w And thine eye| strong="H5869" \w* [shall not pity]{strong=“H2347” x-morph=“strongMorph: \sc Th\sc*8799”}; but \w life| strong="H5315" \w* shall go \w for life| strong="H5315" \w*, \w eye| strong="H5869" \w* \w for eye| strong="H5869" \w*, \w tooth| strong="H8127" \w* \w for tooth| strong="H8127" \w*, \w hand| strong="H3027" \w* \w for hand| strong="H3027" \w*, \w foot| strong="H7272" \w* \w for foot| strong="H7272" \w*.
\c 20
\p 
\v 1 [When thou goest out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w to battle| strong="H4421" \w* [against thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, [and seest]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w horses| strong="H5483" \w*, \w and chariots| strong="H7393" \w*, and \w a people| strong="H5971" \w* \w more| strong="H7227" \w* [than thou, be not afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} of them: for the \sc Lord\sc* \w thy God| strong="H430" \w* is [with thee, which brought thee up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8688”} \w out of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*. 
\v 2 [And it shall be, when ye are come nigh]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto the battle| strong="H4421" \w*, \w that the priest| strong="H3548" \w* [shall approach]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8738”} [and speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto the people| strong="H5971" \w*, 
\v 3 [And shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O Israel| strong="H3478" \w*, \w ye approach| strong="H7131" \w* \w this day| strong="H3117" \w* \w unto battle| strong="H4421" \w* [against your enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}: \w let not your hearts| strong="H3824" \w* [faint]{strong=“H7401” x-morph=“strongMorph: \sc Th\sc*8735”}, [fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [not, and do not tremble]{strong=“H2648” x-morph=“strongMorph: \sc Th\sc*8799”}, [neither be ye terrified]{strong=“H6206” x-morph=“strongMorph: \sc Th\sc*8799”} \w because| strong="H6440" \w* of them;\f + \fr 20:3 \ft faint: Heb. be tender \f* \f + \fr 20:3 \ft tremble: Heb. make haste \f* 
\v 4 For the \sc Lord\sc* \w your God| strong="H430" \w* is [he that goeth]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} [with you, to fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8736”} [for you against your enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, [to save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8687”} you. 
\p
\v 5 [And the officers]{strong=“H7860” x-morph=“strongMorph: \sc Th\sc*8802”} [shall speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto the people| strong="H5971" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w What man| strong="H376" \w* is there [that hath built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w a new| strong="H2319" \w* \w house| strong="H1004" \w*, [and hath not dedicated]{strong=“H2596” x-morph=“strongMorph: \sc Th\sc*8804”} [it? let him go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [and return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w to his house| strong="H1004" \w*, [lest he die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the battle| strong="H4421" \w*, \w and another| strong="H312" \w* \w man| strong="H376" \w* [dedicate]{strong=“H2596” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\v 6 \w And what man| strong="H376" \w* is he [that hath planted]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8804”} \w a vineyard| strong="H3754" \w*, and hath not yet [eaten]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8765”} of it? let him also [go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [and return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his house| strong="H1004" \w*, [lest he die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the battle| strong="H4421" \w*, \w and another| strong="H312" \w* \w man| strong="H376" \w* [eat]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8762”} of it.\f + \fr 20:6 \ft eaten…: Heb. made it common \f* 
\v 7 \w And what man| strong="H376" \w* is there [that hath betrothed]{strong=“H781” x-morph=“strongMorph: \sc Th\sc*8765”} \w a wife| strong="H802" \w*, [and hath not taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} [her? let him go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [and return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his house| strong="H1004" \w*, [lest he die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the battle| strong="H4421" \w*, \w and another| strong="H312" \w* \w man| strong="H376" \w* [take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} her. 
\v 8 [And the officers]{strong=“H7860” x-morph=“strongMorph: \sc Th\sc*8802”} [shall speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} [further]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the people| strong="H5971" \w*, [and they shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w What man| strong="H376" \w* is there that is \w fearful| strong="H3373" \w* [and fainthearted]{strong=“H3824 H7390”}? [let him go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [and return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his house| strong="H1004" \w*, [lest his brethren’s]{strong=“H251”} \w heart| strong="H3824" \w* [faint]{strong=“H4549” x-morph=“strongMorph: \sc Th\sc*8735”} \w as well as his heart| strong="H3824" \w*.\f + \fr 20:8 \ft faint: Heb. melt \f* 
\v 9 [And it shall be, when the officers]{strong=“H7860” x-morph=“strongMorph: \sc Th\sc*8802”} [have made an end]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8763”} [of speaking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w unto the people| strong="H5971" \w*, [that they shall make]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} \w captains| strong="H8269" \w* \w of the armies| strong="H6635" \w* \w to lead| strong="H7218" \w* \w the people| strong="H5971" \w*.\f + \fr 20:9 \ft to lead…: Heb. to be in the head of the people \f* 
\p
\v 10 [When thou comest nigh]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto a city| strong="H5892" \w* [to fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8736”} [against it, then proclaim]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w peace| strong="H7965" \w* unto it. 
\v 11 [And it shall be, if it make thee answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w of peace| strong="H7965" \w*, [and open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8804”} unto thee, then it shall be, that \w all the people| strong="H5971" \w* that is [found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8737”} \w therein shall be tributaries| strong="H4522" \w* [unto thee, and they shall serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} thee. 
\v 12 [And if it will make no peace]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8686”} [with thee, but will make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w war| strong="H4421" \w* [against thee, then thou shalt besiege]{strong=“H6696” x-morph=“strongMorph: \sc Th\sc*8804”} it: 
\v 13 And when the \sc Lord\sc* \w thy God| strong="H430" \w* [hath delivered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w it into thine hands| strong="H3027" \w*, [thou shalt smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w every male| strong="H2138" \w* \w thereof with the edge| strong="H6310" \w* \w of the sword| strong="H2719" \w*: 
\v 14 \w But the women| strong="H802" \w*, \w and the little ones| strong="H2945" \w*, \w and the cattle| strong="H929" \w*, \w and all that is in the city| strong="H5892" \w*, even \w all the spoil| strong="H7998" \w* [thereof, shalt thou take]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thyself; and thou shalt eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w the spoil| strong="H7998" \w* [of thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, which the \sc Lord\sc* \w thy God| strong="H430" \w* [hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} thee.\f + \fr 20:14 \ft take: Heb. spoil \f* 
\v 15 [Thus shalt thou do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto all the cities| strong="H5892" \w* which are \w very| strong="H3966" \w* \w far off| strong="H7350" \w* [from thee, which]{strong=“H2007”} are \w not of the cities| strong="H5892" \w* \w of these nations| strong="H1471" \w*. 
\v 16 \w But of the cities| strong="H5892" \w* \w of these people| strong="H5971" \w*, which the \sc Lord\sc* \w thy God| strong="H430" \w* [doth give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} thee for \w an inheritance| strong="H5159" \w*, [thou shalt save alive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8762”} \w nothing that breatheth| strong="H5397" \w*: 
\v 17 [But thou shalt utterly]{strong=“H2763” x-morph=“strongMorph: \sc Th\sc*8687”} [destroy]{strong=“H2763” x-morph=“strongMorph: \sc Th\sc*8686”} them; namely, \w the Hittites| strong="H2850" \w*, \w and the Amorites| strong="H567" \w*, \w the Canaanites| strong="H3669" \w*, \w and the Perizzites| strong="H6522" \w*, \w the Hivites| strong="H2340" \w*, \w and the Jebusites| strong="H2983" \w*; as the \sc Lord\sc* \w thy God| strong="H430" \w* [hath commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} thee: 
\v 18 [That they teach]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8762”} [you not to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w after all their abominations| strong="H8441" \w*, [which they have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto their gods| strong="H430" \w*; [so should ye sin]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} against the \sc Lord\sc* \w your God| strong="H430" \w*. 
\p
\v 19 [When thou shalt besiege]{strong=“H6696” x-morph=“strongMorph: \sc Th\sc*8799”} \w a city| strong="H5892" \w* \w a long| strong="H7227" \w* \w time| strong="H3117" \w*, [in making war]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8736”} [against it to take]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8800”} [it, thou shalt not destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8686”} \w the trees| strong="H6086" \w* [thereof by forcing]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8800”} \w an axe| strong="H1631" \w* [against them: for thou mayest eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [of them, and thou shalt not cut them down]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} (\w for the tree| strong="H6086" \w* \w of the field| strong="H7704" \w* is [man’s]{strong=“H120”} life) [to employ]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} them [in the siege]{strong=“H4692 H6440”}:\f + \fr 20:19 \ft for the…: or, for, O man, the tree of the field is to be employed in the siege \f* \f + \fr 20:19 \ft to employ…: Heb. to go from before thee \f* 
\v 20 \w Only the trees| strong="H6086" \w* [which thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} that they be \w not trees| strong="H6086" \w* \w for meat| strong="H3978" \w*, [thou shalt destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8686”} [and cut them down]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8804”}; [and thou shalt build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w bulwarks| strong="H4692" \w* \w against the city| strong="H5892" \w* [that maketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w war| strong="H4421" \w* [with thee, until it be subdued]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 20:20 \ft it…: Heb. it come down \f*
\c 21
\p 
\v 1 If one [be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”} \w slain| strong="H2491" \w* \w in the land| strong="H127" \w* which the \sc Lord\sc* \w thy God| strong="H430" \w* [giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} [thee to possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} [it, lying]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the field| strong="H7704" \w*, and [it be not known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8738”} [who hath slain]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} him: 
\v 2 \w Then thy elders| strong="H2205" \w* [and thy judges]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} [shall come forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”}, [and they shall measure]{strong=“H4058” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the cities| strong="H5892" \w* which are \w round about| strong="H5439" \w* \w him that is slain| strong="H2491" \w*: 
\v 3 And it shall be, that \w the city| strong="H5892" \w* which is \w next| strong="H7138" \w* \w unto the slain man| strong="H2491" \w*, \w even the elders| strong="H2205" \w* \w of that city| strong="H5892" \w* [shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} [an heifer]{strong=“H5697 H1241”}, [which hath not been wrought with]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8795”}, and [which hath not drawn]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the yoke| strong="H5923" \w*; 
\v 4 \w And the elders| strong="H2205" \w* \w of that city| strong="H5892" \w* [shall bring down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8689”} \w the heifer| strong="H5697" \w* \w unto a rough| strong="H386" \w* \w valley| strong="H5158" \w*, [which is neither eared]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8735”} [nor sown]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8735”}, \w and shall strike off| strong="H6202" \w* [the heifer’s]{strong=“H5697”} [neck]{strong=“H6202” x-morph=“strongMorph: \sc Th\sc*8804”} \w there in the valley| strong="H5158" \w*: 
\v 5 \w And the priests| strong="H3548" \w* \w the sons| strong="H1121" \w* \w of Levi| strong="H3878" \w* [shall come near]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8738”}; for them the \sc Lord\sc* \w thy God| strong="H430" \w* [hath chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} [to minister]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8763”} [unto him, and to bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8763”} \w in the name| strong="H8034" \w* of the \sc Lord\sc*; \w and by their word| strong="H6310" \w* \w shall every controversy| strong="H7379" \w* \w and every stroke| strong="H5061" \w* be tried:\f + \fr 21:5 \ft word: Heb. mouth \f* 
\v 6 \w And all the elders| strong="H2205" \w* \w of that city| strong="H5892" \w*, that are \w next| strong="H7138" \w* \w unto the slain| strong="H2491" \w* man, [shall wash]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8799”} \w their hands| strong="H3027" \w* \w over the heifer| strong="H5697" \w* [that is beheaded]{strong=“H6202” x-morph=“strongMorph: \sc Th\sc*8803”} \w in the valley| strong="H5158" \w*: 
\v 7 [And they shall answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”} [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Our hands| strong="H3027" \w* [have not shed]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8804”} \w this blood| strong="H1818" \w*, \w neither have our eyes| strong="H5869" \w* [seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} it. 
\v 8 [Be merciful]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8761”}, O \sc Lord\sc*, \w unto thy people| strong="H5971" \w* \w Israel| strong="H3478" \w*, [whom thou hast redeemed]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8804”}, [and lay]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w not innocent| strong="H5355" \w* \w blood| strong="H1818" \w* \w unto thy people| strong="H5971" \w* [of Israel’s]{strong=“H3478”} \w charge| strong="H7130" \w*. \w And the blood| strong="H1818" \w* [shall be forgiven]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8694”} them.\f + \fr 21:8 \ft unto thy people of: Heb. in the midst, etc \f* 
\v 9 [So shalt thou put away]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8762”} the guilt of \w innocent| strong="H5355" \w* \w blood| strong="H1818" \w* \w from among| strong="H7130" \w* [you, when thou shalt do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} that which is \w right| strong="H3477" \w* \w in the sight| strong="H5869" \w* of the \sc Lord\sc*. 
\p
\v 10 [When thou goest forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w to war| strong="H4421" \w* [against thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, and the \sc Lord\sc* \w thy God| strong="H430" \w* [hath delivered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w them into thine hands| strong="H3027" \w*, [and thou hast taken]{strong=“H7617” x-morph=“strongMorph: \sc Th\sc*8804”} \w them captive| strong="H7628" \w*, 
\v 11 [And seest]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w among the captives| strong="H7633" \w* [a beautiful]{strong=“H3303 H8389”} \w woman| strong="H802" \w*, [and hast a desire]{strong=“H2836” x-morph=“strongMorph: \sc Th\sc*8804”} [unto her, that thou wouldest have her]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w to thy wife| strong="H802" \w*; 
\v 12 [Then thou shalt bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w her home| strong="H8432" \w* \w to thine house| strong="H1004" \w*; [and she shall shave]{strong=“H1548” x-morph=“strongMorph: \sc Th\sc*8765”} \w her head| strong="H7218" \w*, [and pare]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w her nails| strong="H6856" \w*;\f + \fr 21:12 \ft pare: or, suffer to grow: Heb. make, or, dress \f* 
\v 13 [And she shall put]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8689”} \w the raiment| strong="H8071" \w* \w of her captivity| strong="H7628" \w* [from off her, and shall remain]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thine house| strong="H1004" \w*, [and bewail]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8804”} \w her father| strong="H1" \w* \w and her mother| strong="H517" \w* \w a full| strong="H3117" \w* \w month| strong="H3391" \w*: \w and after| strong="H310" \w* [that thou shalt go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [in unto her, and be her husband]{strong=“H1166” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and she shall be thy wife| strong="H802" \w*. 
\v 14 [And it shall be, if thou have no delight]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} [in her, then thou shalt let her go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w whither she will| strong="H5315" \w*; [but thou shalt not sell]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8799”} [her at all]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8800”} \w for money| strong="H3701" \w*, [thou shalt not make merchandise]{strong=“H6014” x-morph=“strongMorph: \sc Th\sc*8691”} [of her, because]{strong=“H834”} [thou hast humbled]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8765”} her. 
\p
\v 15 \w If a man| strong="H376" \w* \w have two| strong="H8147" \w* \w wives| strong="H802" \w*, \w one| strong="H259" \w* [beloved]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8803”}, \w and another| strong="H259" \w* [hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8803”}, [and they have born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} \w him children| strong="H1121" \w*, both [the beloved]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8803”} [and the hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8803”}; and if \w the firstborn| strong="H1060" \w* \w son| strong="H1121" \w* \w be hers that was hated| strong="H8146" \w*: 
\v 16 [Then it shall be, when]{strong=“H3117”} \w he maketh his sons| strong="H1121" \w* [to inherit]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8687”} that which he hath, that [he may]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} \w not make the son| strong="H1121" \w* [of the beloved]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8803”} [firstborn]{strong=“H1069” x-morph=“strongMorph: \sc Th\sc*8763”} \w before| strong="H6440" \w* \w the son| strong="H1121" \w* [of the hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8803”}, which is indeed \w the firstborn| strong="H1060" \w*: 
\v 17 [But he shall acknowledge]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8686”} \w the son| strong="H1121" \w* [of the hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8803”} for \w the firstborn| strong="H1060" \w*, [by giving]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w him a double| strong="H8147" \w* \w portion| strong="H6310" \w* [of all that he hath]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”}: for he is \w the beginning| strong="H7225" \w* \w of his strength| strong="H202" \w*; \w the right| strong="H4941" \w* \w of the firstborn| strong="H1062" \w* is his.\f + \fr 21:17 \ft that…: Heb. that is found with him \f* 
\p
\v 18 \w If a man| strong="H376" \w* [have a stubborn]{strong=“H5637” x-morph=“strongMorph: \sc Th\sc*8802”} [and rebellious]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8802”} \w son| strong="H1121" \w*, [which will not obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} \w the voice| strong="H6963" \w* \w of his father| strong="H1" \w*, \w or the voice| strong="H6963" \w* \w of his mother| strong="H517" \w*, and that, [when they have chastened]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8765”} [him, will not hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} unto them: 
\v 19 \w Then shall his father| strong="H1" \w* \w and his mother| strong="H517" \w* [lay hold]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8804”} [on him, and bring him out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w unto the elders| strong="H2205" \w* \w of his city| strong="H5892" \w*, \w and unto the gate| strong="H8179" \w* \w of his place| strong="H4725" \w*; 
\v 20 [And they shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the elders| strong="H2205" \w* \w of his city| strong="H5892" \w*, \w This our son| strong="H1121" \w* is [stubborn]{strong=“H5637” x-morph=“strongMorph: \sc Th\sc*8802”} [and rebellious]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8802”}, [he will not obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} \w our voice| strong="H6963" \w*; he is [a glutton]{strong=“H2151” x-morph=“strongMorph: \sc Th\sc*8802”}, [and a drunkard]{strong=“H5433” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 21 \w And all the men| strong="H582" \w* \w of his city| strong="H5892" \w* [shall stone]{strong=“H7275” x-morph=“strongMorph: \sc Th\sc*8804”} \w him with stones| strong="H68" \w*, [that he die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}: \w so shalt thou put| strong="H1197" \w* \w evil| strong="H7451" \w* [away]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8765”} \w from among| strong="H7130" \w* [you; and all Israel]{strong=“H3478”} [shall hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}, [and fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 22 \w And if a man| strong="H376" \w* \w have committed a sin| strong="H2399" \w* \w worthy of| strong="H4941" \w* \w death| strong="H4194" \w*, [and he be to be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8717”}, [and thou hang]{strong=“H8518” x-morph=“strongMorph: \sc Th\sc*8804”} \w him on a tree| strong="H6086" \w*: 
\v 23 \w His body| strong="H5038" \w* [shall not remain all night]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the tree| strong="H6086" \w*, [but thou shalt in any wise]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8800”} [bury]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8799”} \w him that day| strong="H3117" \w*; ([for he that is hanged]{strong=“H8518” x-morph=“strongMorph: \sc Th\sc*8803”} is \w accursed| strong="H7045" \w* \w of God| strong="H430" \w*;) \w that thy land| strong="H127" \w* [be not defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8762”}, which the \sc Lord\sc* \w thy God| strong="H430" \w* [giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} thee for \w an inheritance| strong="H5159" \w*.\f + \fr 21:23 \ft accursed…: Heb. the curse of God \f*
\c 22
\p 
\v 1 [Thou shalt not see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [thy brother’s]{strong=“H251”} \w ox| strong="H7794" \w* \w or his sheep| strong="H7716" \w* [go astray]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8737”}, [and hide]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8694”} [thyself from them: thou shalt in any case]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} [bring them again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto thy brother| strong="H251" \w*. 
\v 2 \w And if thy brother| strong="H251" \w* be \w not nigh| strong="H7138" \w* [unto thee, or if thou know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [him not, then thou shalt bring]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8804”} \w it unto| strong="H8432" \w* \w thine own house| strong="H1004" \w*, \w and it shall be with thee until thy brother| strong="H251" \w* [seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8800”} [after it, and thou shalt restore it to him again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\v 3 \w In like manner| strong="H3651" \w* [shalt thou do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w with his ass| strong="H2543" \w*; [and so shalt thou do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w with his raiment| strong="H8071" \w*; \w and with all lost thing| strong="H9" \w* [of thy brother’s]{strong=“H251”}, [which he hath lost]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}, [and thou hast found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”}, [shalt thou do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [likewise: thou mayest]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [not hide]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8692”} thyself. 
\p
\v 4 [Thou shalt not see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [thy brother’s]{strong=“H251”} \w ass| strong="H2543" \w* \w or his ox| strong="H7794" \w* [fall down]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8802”} \w by the way| strong="H1870" \w*, [and hide]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8694”} [thyself from them: thou shalt surely]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8687”} help him to lift them [up again]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\p
\v 5 \w The woman| strong="H802" \w* \w shall not wear that which pertaineth| strong="H3627" \w* \w unto a man| strong="H1397" \w*, \w neither shall a man| strong="H1397" \w* [put]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} [on a woman’s]{strong=“H802”} \w garment| strong="H8071" \w*: [for all that do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w so| strong="H428" \w* are \w abomination| strong="H8441" \w* unto the \sc Lord\sc* \w thy God| strong="H430" \w*. 
\p
\v 6 [If a bird’s]{strong=“H6833”} \w nest| strong="H7064" \w* [chance]{strong=“H7122” x-morph=“strongMorph: \sc Th\sc*8735”} \w to be before| strong="H6440" \w* \w thee in the way| strong="H1870" \w* \w in any tree| strong="H6086" \w*, \w or on the ground| strong="H776" \w*, whether they be \w young ones| strong="H667" \w*, \w or eggs| strong="H1000" \w*, \w and the dam| strong="H517" \w* [sitting]{strong=“H7257” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the young| strong="H667" \w*, \w or upon the eggs| strong="H1000" \w*, [thou shalt not take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the dam| strong="H517" \w* \w with the young| strong="H1121" \w*: 
\v 7 But [thou shalt in any wise]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8763”} \w let the dam| strong="H517" \w* [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”}, [and take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the young| strong="H1121" \w* [to thee; that it may be well]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8799”} with thee, and that [thou mayest prolong]{strong=“H748” x-morph=“strongMorph: \sc Th\sc*8689”} thy \w days| strong="H3117" \w*. 
\p
\v 8 [When thou buildest]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w a new| strong="H2319" \w* \w house| strong="H1004" \w*, [then thou shalt make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w a battlement| strong="H4624" \w* \w for thy roof| strong="H1406" \w*, [that thou bring]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w not blood| strong="H1818" \w* \w upon thine house| strong="H1004" \w*, [if any man]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8802”} [fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} from thence. 
\p
\v 9 [Thou shalt not sow]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy vineyard| strong="H3754" \w* \w with divers seeds| strong="H3610" \w*: \w lest the fruit| strong="H4395" \w* \w of thy seed| strong="H2233" \w* [which thou hast sown]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the fruit| strong="H8393" \w* \w of thy vineyard| strong="H3754" \w*, [be defiled]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 22:9 \ft fruit of thy seed: Heb. fulness of the seed \f* 
\p
\v 10 [Thou shalt not plow]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8799”} \w with an ox| strong="H7794" \w* \w and an ass| strong="H2543" \w* \w together| strong="H3162" \w*. 
\p
\v 11 [Thou shalt not wear]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w a garment of divers sorts| strong="H8162" \w*, as \w of woollen| strong="H6785" \w* \w and linen| strong="H6593" \w* \w together| strong="H3162" \w*. 
\p
\v 12 [Thou shalt make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee fringes| strong="H1434" \w* \w upon the four| strong="H702" \w* \w quarters| strong="H3671" \w* \w of thy vesture| strong="H3682" \w*, [wherewith thou coverest]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} thyself.\f + \fr 22:12 \ft quarters: Heb. wings \f* 
\p
\v 13 \w If any man| strong="H376" \w* [take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a wife| strong="H802" \w*, [and go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [unto her, and hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”} her, 
