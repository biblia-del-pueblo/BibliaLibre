\v 15 [Cursed]{strong=“H779” x-morph=“strongMorph: \sc Th\sc*8803”} be \w the man| strong="H376" \w* [that maketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} any \w graven| strong="H6459" \w* \w or molten image| strong="H4541" \w*, \w an abomination| strong="H8441" \w* unto the \sc Lord\sc*, \w the work| strong="H4639" \w* \w of the hands| strong="H3027" \w* \w of the craftsman| strong="H2796" \w*, [and putteth]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} it in a \w secret| strong="H5643" \w* place. \w And all the people| strong="H5971" \w* [shall answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”} [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Amen| strong="H543" \w*. 
