\v 11 \w And houses| strong="H1004" \w* \w full| strong="H4392" \w* \w of all good| strong="H2898" \w* things, [which thou filledst]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8765”} [not, and wells]{strong=“H953”} [digged]{strong=“H2672” x-morph=“strongMorph: \sc Th\sc*8803”}, [which thou diggedst]{strong=“H2672” x-morph=“strongMorph: \sc Th\sc*8804”} [not, vineyards]{strong=“H3754”} \w and olive trees| strong="H2132" \w*, [which thou plantedst]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8804”} [not; when thou shalt have eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} [and be full]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8804”}; 
\v 12 Then [beware]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8734”} [lest thou forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc*, [which brought thee forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w out of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, \w from the house| strong="H1004" \w* \w of bondage| strong="H5650" \w*.\f + \fr 6:12 \ft bondage: Heb. bondmen or, servants \f* 
\v 13 [Thou shalt fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc* \w thy God| strong="H430" \w*, [and serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} [him, and shalt swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8735”} \w by his name| strong="H8034" \w*. 
\v 14 [Ye shall not go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w other| strong="H312" \w* \w gods| strong="H430" \w*, \w of the gods| strong="H430" \w* \w of the people| strong="H5971" \w* which are \w round about| strong="H5439" \w* you; 
\v 15 (For the \sc Lord\sc* \w thy God| strong="H430" \w* is \w a jealous| strong="H7067" \w* \w God| strong="H410" \w* \w among| strong="H7130" \w* [you) lest the anger]{strong=“H639”} of the \sc Lord\sc* \w thy God| strong="H430" \w* [be kindled]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8799”} [against thee, and destroy]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee from off the face| strong="H6440" \w* \w of the earth| strong="H127" \w*. 
\p
\v 16 [Ye shall not tempt]{strong=“H5254” x-morph=“strongMorph: \sc Th\sc*8762”} the \sc Lord\sc* \w your God| strong="H430" \w*, [as ye tempted]{strong=“H5254” x-morph=“strongMorph: \sc Th\sc*8765”} him \w in Massah| strong="H4532" \w*. 
\p
\v 17 [Ye shall diligently]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} [keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w the commandments| strong="H4687" \w* of the \sc Lord\sc* \w your God| strong="H430" \w*, \w and his testimonies| strong="H5713" \w*, \w and his statutes| strong="H2706" \w*, [which he hath commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} thee. 
\v 18 [And thou shalt do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} that which is \w right| strong="H3477" \w* \w and good| strong="H2896" \w* \w in the sight| strong="H5869" \w* of the \sc Lord\sc*: [that it may be well]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8799”} [with thee, and that thou mayest go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [and possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8804”} \w the good| strong="H2896" \w* \w land| strong="H776" \w* which the \sc Lord\sc* [sware]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto thy fathers| strong="H1" \w*, 
\v 19 [To cast out]{strong=“H1920” x-morph=“strongMorph: \sc Th\sc*8800”} [all thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w from before| strong="H6440" \w* thee, as the \sc Lord\sc* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 20 And \w when thy son| strong="H1121" \w* [asketh]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee in time to come| strong="H4279" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, What mean \w the testimonies| strong="H5713" \w*, \w and the statutes| strong="H2706" \w*, \w and the judgments| strong="H4941" \w*, which the \sc Lord\sc* \w our God| strong="H430" \w* [hath commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} you?\f + \fr 6:20 \ft in…: Heb. to morrow \f* 
\v 21 [Then thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto thy son| strong="H1121" \w*, [We were Pharaoh’s]{strong=“H6547”} \w bondmen| strong="H5650" \w* \w in Egypt| strong="H4714" \w*; and the \sc Lord\sc* [brought us out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w of Egypt| strong="H4714" \w* \w with a mighty| strong="H2389" \w* \w hand| strong="H3027" \w*: 
