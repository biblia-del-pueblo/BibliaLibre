\v 10 [Thou shalt therefore obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the voice| strong="H6963" \w* of the \sc Lord\sc* \w thy God| strong="H430" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w his commandments| strong="H4687" \w* \w and his statutes| strong="H2706" \w*, [which I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} \w thee this day| strong="H3117" \w*. 
\p
