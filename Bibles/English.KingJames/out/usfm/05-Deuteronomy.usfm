\p
\v 5 \w But unto the place| strong="H4725" \w* which the \sc Lord\sc* \w your God| strong="H430" \w* [shall choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of all your tribes| strong="H7626" \w* [to put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w his name| strong="H8034" \w* there, even \w unto his habitation| strong="H7933" \w* [shall ye seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”}, [and thither thou shalt come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}: 
