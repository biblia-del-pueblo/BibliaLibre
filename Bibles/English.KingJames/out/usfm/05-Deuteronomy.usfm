\p
\v 9 \w When the host| strong="H4264" \w* [goeth forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} [against thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, [then keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8738”} \w thee from every wicked| strong="H7451" \w* \w thing| strong="H1697" \w*. 
\p
\v 10 \w If there be among you any man| strong="H376" \w*, \w that is not clean| strong="H2889" \w* \w by reason of uncleanness that chanceth| strong="H7137" \w* \w him by night| strong="H3915" \w*, [then shall he go]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w abroad| strong="H2351" \w* \w out of the camp| strong="H4264" \w*, [he shall not come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w within| strong="H8432" \w* \w the camp| strong="H4264" \w*: 
