\p
\v 22 \w Moses| strong="H4872" \w* [therefore wrote]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8799”} \w this song| strong="H7892" \w* \w the same day| strong="H3117" \w*, [and taught]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8762”} \w it the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*. 
