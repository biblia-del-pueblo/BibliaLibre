\v 18 [And I fell down]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8691”} \w before| strong="H6440" \w* the \sc Lord\sc*, \w as at the first| strong="H7223" \w*, \w forty| strong="H705" \w* \w days| strong="H3117" \w* \w and forty| strong="H705" \w* \w nights| strong="H3915" \w*: [I did neither eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w bread| strong="H3899" \w*, [nor drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8804”} \w water| strong="H4325" \w*, \w because of all your sins| strong="H2403" \w* [which ye sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}, [in doing]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w wickedly| strong="H7451" \w* \w in the sight| strong="H5869" \w* of the \sc Lord\sc*, [to provoke him to anger]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8687”}. 
\v 19 [For I was afraid]{strong=“H3025” x-morph=“strongMorph: \sc Th\sc*8804”} \w of| strong="H6440" \w* \w the anger| strong="H639" \w* \w and hot displeasure| strong="H2534" \w*, wherewith the \sc Lord\sc* [was wroth]{strong=“H7107” x-morph=“strongMorph: \sc Th\sc*8804”} [against you to destroy]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8687”} you. But the \sc Lord\sc* [hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto me at that time| strong="H6471" \w* also. 
\v 20 And the \sc Lord\sc* \w was very| strong="H3966" \w* [angry]{strong=“H599” x-morph=“strongMorph: \sc Th\sc*8694”} \w with Aaron| strong="H175" \w* [to have destroyed]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8687”} [him: and I prayed]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8691”} \w for Aaron| strong="H175" \w* \w also the same time| strong="H6256" \w*. 
\v 21 [And I took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w your sin| strong="H2403" \w*, \w the calf| strong="H5695" \w* [which ye had made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [and burnt]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8799”} \w it with fire| strong="H784" \w*, [and stamped]{strong=“H3807” x-morph=“strongMorph: \sc Th\sc*8799”} it, and [ground]{strong=“H2912” x-morph=“strongMorph: \sc Th\sc*8800”} it [very small]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8687”}, even [until it was as small]{strong=“H1854” x-morph=“strongMorph: \sc Th\sc*8804”} \w as dust| strong="H6083" \w*: [and I cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w the dust| strong="H6083" \w* \w thereof into the brook| strong="H5158" \w* [that descended out]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the mount| strong="H2022" \w*. 
\v 22 \w And at Taberah| strong="H8404" \w*, \w and at Massah| strong="H4532" \w*, [and at Kibroth-hattaavah]{strong=“H6914”}, ye provoked the \sc Lord\sc* [to wrath]{strong=“H7107” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 23 Likewise when the \sc Lord\sc* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8800”} [you from Kadesh-barnea]{strong=“H6947”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”} [and possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8798”} \w the land| strong="H776" \w* [which I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [you; then ye rebelled]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8686”} \w against the commandment| strong="H6310" \w* of the \sc Lord\sc* \w your God| strong="H430" \w*, [and ye believed]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8689”} [him not, nor hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w to his voice| strong="H6963" \w*. 
\v 24 [Ye have been rebellious]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8688”} against the \sc Lord\sc* \w from the day| strong="H3117" \w* [that I knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} you. 
\v 25 [Thus I fell down]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8691”} \w before| strong="H6440" \w* the \sc Lord\sc* \w forty| strong="H705" \w* \w days| strong="H3117" \w* \w and forty| strong="H705" \w* \w nights| strong="H3915" \w*, [as I fell down]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8694”} at the first; because the \sc Lord\sc* [had said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [he would destroy]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8687”} you. 
\v 26 [I prayed]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8691”} therefore unto the \sc Lord\sc*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w O Lord| strong="H136" \w* \sc God\sc*, [destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8686”} \w not thy people| strong="H5971" \w* \w and thine inheritance| strong="H5159" \w*, [which thou hast redeemed]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8804”} \w through thy greatness| strong="H1433" \w*, [which thou hast brought forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w out of Egypt| strong="H4714" \w* \w with a mighty| strong="H2389" \w* \w hand| strong="H3027" \w*. 
\v 27 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy servants| strong="H5650" \w*, \w Abraham| strong="H85" \w*, \w Isaac| strong="H3327" \w*, \w and Jacob| strong="H3290" \w*; [look]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8799”} \w not unto the stubbornness| strong="H7190" \w* \w of this people| strong="H5971" \w*, \w nor to their wickedness| strong="H7562" \w*, \w nor to their sin| strong="H2403" \w*: 
\v 28 \w Lest the land| strong="H776" \w* [whence thou broughtest us out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Because the \sc Lord\sc* [was not able]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8800”} [to bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} \w them into the land| strong="H776" \w* [which he promised]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [them, and because he hated]{strong=“H8135”} [them, he hath brought them out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} [to slay]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8687”} \w them in the wilderness| strong="H4057" \w*. 
\v 29 Yet they are \w thy people| strong="H5971" \w* \w and thine inheritance| strong="H5159" \w*, [which thou broughtest out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w by thy mighty| strong="H1419" \w* \w power| strong="H3581" \w* [and by thy stretched out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8803”} \w arm| strong="H2220" \w*. 
\c 10
\p 
\v 1 \w At that time| strong="H6256" \w* the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me, Hew]{strong=“H6458” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee two| strong="H8147" \w* \w tables| strong="H3871" \w* \w of stone| strong="H68" \w* \w like unto the first| strong="H7223" \w*, [and come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto me into the mount| strong="H2022" \w*, [and make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee an ark| strong="H727" \w* \w of wood| strong="H6086" \w*. 
\v 2 [And I will write]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8799”} \w on the tables| strong="H3871" \w* \w the words| strong="H1697" \w* \w that were in the first| strong="H7223" \w* \w tables| strong="H3871" \w* [which thou brakest]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8765”}, [and thou shalt put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w them in the ark| strong="H727" \w*. 
\v 3 [And I made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w an ark| strong="H727" \w* of \w shittim| strong="H7848" \w* \w wood| strong="H6086" \w*, [and hewed]{strong=“H6458” x-morph=“strongMorph: \sc Th\sc*8799”} \w two| strong="H8147" \w* \w tables| strong="H3871" \w* \w of stone| strong="H68" \w* \w like unto the first| strong="H7223" \w*, [and went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the mount| strong="H2022" \w*, \w having the two| strong="H8147" \w* \w tables| strong="H3871" \w* \w in mine hand| strong="H3027" \w*. 
\v 4 [And he wrote]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8799”} \w on the tables| strong="H3871" \w*, \w according to the first| strong="H7223" \w* \w writing| strong="H4385" \w*, \w the ten| strong="H6235" \w* \w commandments| strong="H1697" \w*, which the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto you in the mount| strong="H2022" \w* \w out of the midst| strong="H8432" \w* \w of the fire| strong="H784" \w* \w in the day| strong="H3117" \w* \w of the assembly| strong="H6951" \w*: and the \sc Lord\sc* [gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} them unto me.\f + \fr 10:4 \ft commandments: Heb. words \f* 
\v 5 [And I turned]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8799”} [myself and came down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the mount| strong="H2022" \w*, [and put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w the tables| strong="H3871" \w* \w in the ark| strong="H727" \w* [which I had made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}; and there they be, as the \sc Lord\sc* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} me. 
\p
\v 6 \w And the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [took their journey]{strong=“H5265” x-morph=“strongMorph: \sc Th\sc*8804”} \w from Beeroth of the children of Jaakan| strong="H885" \w* \w to Mosera| strong="H4149" \w*: \w there Aaron| strong="H175" \w* [died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}, [and there he was buried]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8735”}; \w and Eleazar| strong="H499" \w* \w his son| strong="H1121" \w* [ministered in the priest’s office]{strong=“H3547” x-morph=“strongMorph: \sc Th\sc*8762”} in his stead. 
\v 7 [From thence they journeyed]{strong=“H5265” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto Gudgodah| strong="H1412" \w*; \w and from Gudgodah| strong="H1412" \w* \w to Jotbath| strong="H3193" \w*, \w a land| strong="H776" \w* \w of rivers| strong="H5158" \w* \w of waters| strong="H4325" \w*. 
\p
\v 8 \w At that time| strong="H6256" \w* the \sc Lord\sc* [separated]{strong=“H914” x-morph=“strongMorph: \sc Th\sc*8689”} \w the tribe| strong="H7626" \w* \w of Levi| strong="H3878" \w*, [to bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8800”} \w the ark| strong="H727" \w* \w of the covenant| strong="H1285" \w* of the \sc Lord\sc*, [to stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8800”} \w before| strong="H6440" \w* the \sc Lord\sc* [to minister]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8763”} [unto him, and to bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8763”} \w in his name| strong="H8034" \w*, \w unto this day| strong="H3117" \w*. 
\v 9 \w Wherefore Levi| strong="H3878" \w* \w hath no part| strong="H2506" \w* \w nor inheritance| strong="H5159" \w* \w with his brethren| strong="H251" \w*; the \sc Lord\sc* is \w his inheritance| strong="H5159" \w*, according as the \sc Lord\sc* \w thy God| strong="H430" \w* [promised]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} him. 
\v 10 [And I stayed]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the mount| strong="H2022" \w*, \w according to the first| strong="H7223" \w* \w time| strong="H3117" \w*, \w forty| strong="H705" \w* \w days| strong="H3117" \w* \w and forty| strong="H705" \w* \w nights| strong="H3915" \w*; and the \sc Lord\sc* [hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto me at that time| strong="H6471" \w* also, and the \sc Lord\sc* [would]{strong=“H14” x-morph=“strongMorph: \sc Th\sc*8804”} [not destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8687”} thee.\f + \fr 10:10 \ft first…: or, former days \f* 
\v 11 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [take]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} thy \w journey| strong="H4550" \w* \w before| strong="H6440" \w* \w the people| strong="H5971" \w*, [that they may go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8799”} \w the land| strong="H776" \w*, [which I sware]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto their fathers| strong="H1" \w* [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} unto them.\f + \fr 10:11 \ft take…: Heb. go in journey \f* 
\p
\v 12 [And now, Israel]{strong=“H3478”}, what doth the \sc Lord\sc* \w thy God| strong="H430" \w* [require ]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8802”} [of thee, but to fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8800”} the \sc Lord\sc* \w thy God| strong="H430" \w*, [to walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} \w in all his ways| strong="H1870" \w*, [and to love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8800”} [him, and to serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8800”} the \sc Lord\sc* \w thy God| strong="H430" \w* \w with all thy heart| strong="H3824" \w* \w and with all thy soul| strong="H5315" \w*, 
\v 13 [To keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w the commandments| strong="H4687" \w* of the \sc Lord\sc*, \w and his statutes| strong="H2708" \w*, [which I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} \w thee this day| strong="H3117" \w* \w for thy good| strong="H2896" \w*? 
\v 14 [Behold, the heaven]{strong=“H8064”} \w and the heaven| strong="H8064" \w* \w of heavens| strong="H8064" \w* is the \sc Lord\sc*’S \w thy God| strong="H430" \w*, \w the earth| strong="H776" \w* also, with all that therein is. 
\v 15 Only the \sc Lord\sc* [had a delight]{strong=“H2836” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thy fathers| strong="H1" \w* [to love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8800”} [them, and he chose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} \w their seed| strong="H2233" \w* \w after| strong="H310" \w* them, even \w you above all people| strong="H5971" \w*, as it is \w this day| strong="H3117" \w*. 
\v 16 [Circumcise]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8804”} \w therefore the foreskin| strong="H6190" \w* \w of your heart| strong="H3824" \w*, [and be no more stiffnecked]{strong=“H7185 H6203” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 17 For the \sc Lord\sc* \w your God| strong="H430" \w* is \w God| strong="H430" \w* \w of gods| strong="H430" \w*, \w and Lord| strong="H113" \w* \w of lords| strong="H113" \w*, \w a great| strong="H1419" \w* \w God| strong="H410" \w*, \w a mighty| strong="H1368" \w*, [and a terrible]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”}, [which regardeth]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w not persons| strong="H6440" \w*, [nor taketh]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w reward| strong="H7810" \w*: 
\v 18 [He doth execute]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w the judgment| strong="H4941" \w* \w of the fatherless| strong="H3490" \w* \w and widow| strong="H490" \w*, [and loveth]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} \w the stranger| strong="H1616" \w*, [in giving]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w him food| strong="H3899" \w* \w and raiment| strong="H8071" \w*. 
\v 19 [Love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} \w ye therefore the stranger| strong="H1616" \w*: \w for ye were strangers| strong="H1616" \w* \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*. 
\v 20 [Thou shalt fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc* \w thy God| strong="H430" \w*; [him shalt thou serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”}, [and to him shalt thou cleave]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8799”}, [and swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8735”} \w by his name| strong="H8034" \w*. 
\v 21 He is \w thy praise| strong="H8416" \w*, and he is \w thy God| strong="H430" \w*, [that hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w for thee these great| strong="H1419" \w* [and terrible things]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”}, \w which thine eyes| strong="H5869" \w* [have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 22 \w Thy fathers| strong="H1" \w* [went down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} \w into Egypt| strong="H4714" \w* \w with threescore and ten| strong="H7657" \w* \w persons| strong="H5315" \w*; and now the \sc Lord\sc* \w thy God| strong="H430" \w* [hath made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee as the stars| strong="H3556" \w* \w of heaven| strong="H8064" \w* \w for multitude| strong="H7230" \w*. 
\c 11
\p 
\v 1 [Therefore thou shalt love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w thy God| strong="H430" \w*, [and keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w his charge| strong="H4931" \w*, \w and his statutes| strong="H2708" \w*, \w and his judgments| strong="H4941" \w*, \w and his commandments| strong="H4687" \w*, \w alway| strong="H3117" \w*. 
\v 2 [And know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w ye this day| strong="H3117" \w*: for I speak \w not with your children| strong="H1121" \w* [which have not known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}, [and which have not seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the chastisement| strong="H4148" \w* of the \sc Lord\sc* \w your God| strong="H430" \w*, \w his greatness| strong="H1433" \w*, \w his mighty| strong="H2389" \w* \w hand| strong="H3027" \w*, [and his stretched out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8803”} \w arm| strong="H2220" \w*, 
