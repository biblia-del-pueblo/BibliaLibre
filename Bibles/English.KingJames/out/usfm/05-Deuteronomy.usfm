\v 24 [And ye said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Behold, the \sc Lord\sc* \w our God| strong="H430" \w* [hath shewed]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8689”} \w us his glory| strong="H3519" \w* \w and his greatness| strong="H1433" \w*, [and we have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w his voice| strong="H6963" \w* \w out of the midst| strong="H8432" \w* \w of the fire| strong="H784" \w*: [we have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w this day| strong="H3117" \w* \w that God| strong="H430" \w* [doth talk]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w with man| strong="H120" \w*, [and he liveth]{strong=“H2425” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 25 [Now therefore why should we die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}? \w for this great| strong="H1419" \w* \w fire| strong="H784" \w* [will consume]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [us: if we hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w the voice| strong="H6963" \w* of the \sc Lord\sc* \w our God| strong="H430" \w* [any more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8802”}, [then we shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 5:25 \ft hear: Heb. add to hear \f* 
\v 26 For who is there of \w all flesh| strong="H1320" \w*, [that hath heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the voice| strong="H6963" \w* \w of the living| strong="H2416" \w* \w God| strong="H430" \w* [speaking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8764”} \w out of the midst| strong="H8432" \w* \w of the fire| strong="H784" \w*, as we have, [and lived]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}? 
\v 27 [Go thou near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8798”}, [and hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} all that the \sc Lord\sc* \w our God| strong="H430" \w* [shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}: [and speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} thou unto us all that the \sc Lord\sc* \w our God| strong="H430" \w* [shall speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [unto thee; and we will hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} it, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} it. 
