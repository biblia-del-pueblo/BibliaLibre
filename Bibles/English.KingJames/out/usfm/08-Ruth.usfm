\c 3
\p 
\v 1 \w Then Naomi| strong="H5281" \w* \w her mother in law| strong="H2545" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto her, My daughter]{strong=“H1323”}, [shall I not seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w rest| strong="H4494" \w* [for thee, that it may be well]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8799”} with thee? 
\v 2 And now is \w not Boaz| strong="H1162" \w* \w of our kindred| strong="H4130" \w*, \w with whose maidens| strong="H5291" \w* [thou wast? Behold, he winnoweth]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8802”} \w barley| strong="H8184" \w* \w to night| strong="H3915" \w* \w in the threshingfloor| strong="H1637" \w*. 
