\c 1
\p 
\v 1 \w Now it came to pass in the days| strong="H3117" \w* [when the judges]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} [ruled]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8800”}, \w that there was a famine| strong="H7458" \w* \w in the land| strong="H776" \w*. \w And a certain man| strong="H376" \w* [of Beth-lehem-judah]{strong=“H3063 H1035”} [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [to sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the country| strong="H7704" \w* \w of Moab| strong="H4124" \w*, [he, and his wife]{strong=“H802”}, \w and his two| strong="H8147" \w* \w sons| strong="H1121" \w*.\f + \fr 1:1 \ft ruled: Heb. judged \f* 
\v 2 \w And the name| strong="H8034" \w* \w of the man| strong="H376" \w* was \w Elimelech| strong="H458" \w*, \w and the name| strong="H8034" \w* \w of his wife| strong="H802" \w* \w Naomi| strong="H5281" \w*, \w and the name| strong="H8034" \w* \w of his two| strong="H8147" \w* \w sons| strong="H1121" \w* \w Mahlon| strong="H4248" \w* \w and Chilion| strong="H3630" \w*, \w Ephrathites| strong="H673" \w* [of Beth-lehem-judah]{strong=“H3063 H1035”}. [And they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the country| strong="H7704" \w* \w of Moab| strong="H4124" \w*, and continued there.\f + \fr 1:2 \ft continued: Heb. were \f* 
\v 3 \w And Elimelech| strong="H458" \w* [Naomi’s]{strong=“H5281”} \w husband| strong="H376" \w* [died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}; [and she was left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8735”}, \w and her two| strong="H8147" \w* \w sons| strong="H1121" \w*. 
\v 4 [And they took]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w them wives| strong="H802" \w* \w of the women| strong="H802" \w* \w of Moab| strong="H4125" \w*; \w the name| strong="H8034" \w* \w of the one| strong="H259" \w* was \w Orpah| strong="H6204" \w*, \w and the name| strong="H8034" \w* \w of the other| strong="H8145" \w* \w Ruth| strong="H7327" \w*: [and they dwelled]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w there about ten| strong="H6235" \w* \w years| strong="H8141" \w*. 
\v 5 \w And Mahlon| strong="H4248" \w* \w and Chilion| strong="H3630" \w* [died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w also both| strong="H8147" \w* [of them; and the woman]{strong=“H802”} [was left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8735”} \w of her two| strong="H8147" \w* \w sons| strong="H3206" \w* \w and her husband| strong="H376" \w*. 
\p
\v 6 [Then she arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w with her daughters in law| strong="H3618" \w*, [that she might return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the country| strong="H7704" \w* \w of Moab| strong="H4124" \w*: [for she had heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the country| strong="H7704" \w* \w of Moab| strong="H4124" \w* how that the \sc Lord\sc* [had visited]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} \w his people| strong="H5971" \w* [in giving]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w them bread| strong="H3899" \w*. 
\v 7 [Wherefore she went forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of the place| strong="H4725" \w* [where she was, and her two]{strong=“H8147”} \w daughters in law| strong="H3618" \w* [with her; and they went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w on the way| strong="H1870" \w* [to return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto the land| strong="H776" \w* \w of Judah| strong="H3063" \w*. 
\v 8 \w And Naomi| strong="H5281" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto her two| strong="H8147" \w* \w daughters in law| strong="H3618" \w*, [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} \w each| strong="H802" \w* [to her mother’s]{strong=“H517”} \w house| strong="H1004" \w*: the \sc Lord\sc* [deal]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w kindly| strong="H2617" \w* [with you, as ye have dealt]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [with the dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”}, and with me. 
\v 9 The \sc Lord\sc* [grant]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [you that ye may find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8798”} \w rest| strong="H4496" \w*, \w each| strong="H802" \w* of you \w in the house| strong="H1004" \w* \w of her husband| strong="H376" \w*. [Then she kissed]{strong=“H5401” x-morph=“strongMorph: \sc Th\sc*8799”} [them; and they lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their voice| strong="H6963" \w*, [and wept]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 10 [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto her, Surely we will return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w with thee unto thy people| strong="H5971" \w*. 
\v 11 \w And Naomi| strong="H5281" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Turn again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”}, \w my daughters| strong="H1323" \w*: [why will ye go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} with me? are there yet any more \w sons| strong="H1121" \w* \w in my womb| strong="H4578" \w*, \w that they may be your husbands| strong="H582" \w*? 
\v 12 [Turn again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”}, \w my daughters| strong="H1323" \w*, [go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} your way; [for I am too old]{strong=“H2204” x-morph=“strongMorph: \sc Th\sc*8804”} \w to have an husband| strong="H376" \w*. [If I should say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w I have| strong="H3426" \w* \w hope| strong="H8615" \w*, if \w I should have an husband| strong="H376" \w* \w also to night| strong="H3915" \w*, [and should also bear]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} \w sons| strong="H1121" \w*;\f + \fr 1:12 \ft should have…: or were with an husband \f* 
\v 13 [Would ye tarry]{strong=“H7663” x-morph=“strongMorph: \sc Th\sc*8762”} \w for them| strong="H3860" \w* [till they were grown]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8799”}? [would ye stay]{strong=“H5702” x-morph=“strongMorph: \sc Th\sc*8735”} \w for them| strong="H3860" \w* \w from having husbands| strong="H376" \w*? [nay, my daughters]{strong=“H1323”}; [for it grieveth]{strong=“H4843” x-morph=“strongMorph: \sc Th\sc*8804”} \w me much| strong="H3966" \w* \w for your sakes that the hand| strong="H3027" \w* of the \sc Lord\sc* [is gone out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} against me.\f + \fr 1:13 \ft tarry: Heb. hope \f* \f + \fr 1:13 \ft it grieveth…: Heb. I have much bitterness \f* 
\v 14 [And they lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their voice| strong="H6963" \w*, [and wept again]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8799”}: \w and Orpah| strong="H6204" \w* [kissed]{strong=“H5401” x-morph=“strongMorph: \sc Th\sc*8799”} \w her mother in law| strong="H2545" \w*; \w but Ruth| strong="H7327" \w* [clave]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8804”} unto her. 
\v 15 [And she said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Behold, thy sister in law]{strong=“H2994”} [is gone back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto her people| strong="H5971" \w*, \w and unto her gods| strong="H430" \w*: [return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou after| strong="H310" \w* \w thy sister in law| strong="H2994" \w*. 
\v 16 \w And Ruth| strong="H7327" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Intreat]{strong=“H6293” x-morph=“strongMorph: \sc Th\sc*8799”} [me not to leave]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8800”} thee, or [to return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w from following after| strong="H310" \w* [thee: for whither thou goest]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}; [and where thou lodgest]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will lodge]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”}: \w thy people| strong="H5971" \w* shall be \w my people| strong="H5971" \w*, \w and thy God| strong="H430" \w* \w my God| strong="H430" \w*:\f + \fr 1:16 \ft Intreat…: or, Be not against me \f* 
\v 17 [Where thou diest]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, [will I die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, [and there will I be buried]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8735”}: the \sc Lord\sc* [do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [so to me, and more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} also, if ought \w but death| strong="H4194" \w* [part]{strong=“H6504” x-morph=“strongMorph: \sc Th\sc*8686”} thee and me. 
\v 18 [When she saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [that she was stedfastly minded]{strong=“H553” x-morph=“strongMorph: \sc Th\sc*8693”} [to go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} [with her, then she left]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8799”} [speaking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} unto her.\f + \fr 1:18 \ft was…: Heb. strengthened herself \f* 
\p
\v 19 \w So they two| strong="H8147" \w* [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [until they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [to Beth-lehem]{strong=“H1035”}. [And it came to pass, when they were come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [to Beth-lehem]{strong=“H1035”}, \w that all the city| strong="H5892" \w* [was moved]{strong=“H1949” x-morph=“strongMorph: \sc Th\sc*8735”} [about them, and they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Is \w this Naomi| strong="H5281" \w*? 
\v 20 [And she said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w me not Naomi| strong="H5281" \w*, [call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} \w me Mara| strong="H4755" \w*: \w for the Almighty| strong="H7706" \w* \w hath dealt very| strong="H3966" \w* [bitterly]{strong=“H4843” x-morph=“strongMorph: \sc Th\sc*8689”} with me.\f + \fr 1:20 \ft Naomi: that is, Pleasant \f* \f + \fr 1:20 \ft Mara: that is, Bitter \f* 
\v 21 [I went out]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w full| strong="H4392" \w*, and the \sc Lord\sc* [hath brought me home again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} \w empty| strong="H7387" \w*: why then [call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w ye me Naomi| strong="H5281" \w*, seeing the \sc Lord\sc* [hath testified]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”} [against me, and the Almighty]{strong=“H7706”} [hath afflicted]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8689”} me? 
\v 22 \w So Naomi| strong="H5281" \w* [returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and Ruth| strong="H7327" \w* \w the Moabitess| strong="H4125" \w*, \w her daughter in law| strong="H3618" \w*, [with her, which returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w out of the country| strong="H7704" \w* \w of Moab| strong="H4124" \w*: [and they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to Beth-lehem]{strong=“H1035”} \w in the beginning| strong="H8462" \w* \w of barley| strong="H8184" \w* \w harvest| strong="H7105" \w*.
\c 2
\p 
\v 1 \w And Naomi| strong="H5281" \w* [had a kinsman]{strong=“H3045 H4129” x-morph=“strongMorph: \sc Th\sc*8794 strongMorph: \sc Th\sc*8675”} [of her husband’s]{strong=“H376”}, \w a mighty| strong="H1368" \w* \w man| strong="H376" \w* \w of wealth| strong="H2428" \w*, \w of the family| strong="H4940" \w* \w of Elimelech| strong="H458" \w*; \w and his name| strong="H8034" \w* was \w Boaz| strong="H1162" \w*.\f + \fr 2:1 \ft Boaz: Gr. Booz \f* 
\v 2 \w And Ruth| strong="H7327" \w* \w the Moabitess| strong="H4125" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Naomi| strong="H5281" \w*, [Let me now go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the field| strong="H7704" \w*, [and glean]{strong=“H3950” x-morph=“strongMorph: \sc Th\sc*8762”} \w ears of corn| strong="H7641" \w* \w after| strong="H310" \w* him \w in whose sight| strong="H5869" \w* [I shall find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w grace| strong="H2580" \w*. [And she said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto her, Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, \w my daughter| strong="H1323" \w*. 
\v 3 [And she went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [and gleaned]{strong=“H3950” x-morph=“strongMorph: \sc Th\sc*8762”} \w in the field| strong="H7704" \w* \w after| strong="H310" \w* [the reapers]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8802”}: \w and her hap| strong="H4745" \w* [was to light]{strong=“H7136” x-morph=“strongMorph: \sc Th\sc*8799”} \w on a part| strong="H2513" \w* \w of the field| strong="H7704" \w* belonging \w unto Boaz| strong="H1162" \w*, who was \w of the kindred| strong="H4940" \w* \w of Elimelech| strong="H458" \w*.\f + \fr 2:3 \ft hap…: Heb. hap happened \f* 
\p
\v 4 [And, behold, Boaz]{strong=“H1162”} [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [from Beth-lehem]{strong=“H1035”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto the reapers]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8802”}, The \sc Lord\sc* be [with you. And they answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} him, The \sc Lord\sc* [bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} thee. 
\v 5 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Boaz| strong="H1162" \w* \w unto his servant| strong="H5288" \w* [that was set]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8737”} [over the reapers]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8802”}, \w Whose damsel| strong="H5291" \w* is this? 
\v 6 \w And the servant| strong="H5288" \w* [that was set]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8737”} [over the reapers]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8802”} [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, It is \w the Moabitish| strong="H4125" \w* \w damsel| strong="H5291" \w* [that came back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w with Naomi| strong="H5281" \w* \w out of the country| strong="H7704" \w* \w of Moab| strong="H4124" \w*: 
\v 7 [And she said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I pray you, let me glean]{strong=“H3950” x-morph=“strongMorph: \sc Th\sc*8762”} [and gather]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8804”} \w after| strong="H310" \w* [the reapers]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8802”} \w among the sheaves| strong="H6016" \w*: [so she came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [and hath continued]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w even| strong="H227" \w* \w from the morning| strong="H1242" \w* [until now, that she tarried]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} \w a little| strong="H4592" \w* \w in the house| strong="H1004" \w*. 
\v 8 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Boaz| strong="H1162" \w* \w unto Ruth| strong="H7327" \w*, [Hearest]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [thou not, my daughter]{strong=“H1323”}? [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [not to glean]{strong=“H3950” x-morph=“strongMorph: \sc Th\sc*8800”} \w in another| strong="H312" \w* \w field| strong="H7704" \w*, [neither go]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} [from hence, but abide]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8799”} \w here fast by my maidens| strong="H5291" \w*: 
\v 9 Let \w thine eyes| strong="H5869" \w* be \w on the field| strong="H7704" \w* [that they do reap]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8799”}, [and go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w thou after| strong="H310" \w* [them: have I not charged]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w the young men| strong="H5288" \w* [that they shall not touch]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8800”} [thee? and when thou art athirst]{strong=“H6770” x-morph=“strongMorph: \sc Th\sc*8804”}, [go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the vessels| strong="H3627" \w*, [and drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8804”} of that \w which the young men| strong="H5288" \w* [have drawn]{strong=“H7579” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 10 [Then she fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w on her face| strong="H6440" \w*, [and bowed]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} \w herself to the ground| strong="H776" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Why have I found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w grace| strong="H2580" \w* \w in thine eyes| strong="H5869" \w*, [that thou shouldest take knowledge]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8687”} of me, seeing I am \w a stranger| strong="H5237" \w*? 
