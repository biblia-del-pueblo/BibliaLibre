\c 9
\p 
\v 1 \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Is there yet| strong="H3426" \w* [any that is left]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8738”} \w of the house| strong="H1004" \w* \w of Saul| strong="H7586" \w*, [that I may shew]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w him kindness| strong="H2617" \w* [for Jonathan’s]{strong=“H3083”} sake? 
\v 2 And there was \w of the house| strong="H1004" \w* \w of Saul| strong="H7586" \w* \w a servant| strong="H5650" \w* \w whose name| strong="H8034" \w* was \w Ziba| strong="H6717" \w*. [And when they had called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w him unto David| strong="H1732" \w*, \w the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, Art \w thou Ziba| strong="H6717" \w*? [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Thy servant| strong="H5650" \w* is he. 
\v 3 \w And the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Is \w there not| strong="H657" \w* \w yet any| strong="H376" \w* \w of the house| strong="H1004" \w* \w of Saul| strong="H7586" \w*, [that I may shew]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w the kindness| strong="H2617" \w* \w of God| strong="H430" \w* [unto him? And Ziba]{strong=“H6717”} [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the king| strong="H4428" \w*, \w Jonathan| strong="H3083" \w* \w hath yet a son| strong="H1121" \w*, which is \w lame| strong="H5223" \w* on his \w feet| strong="H7272" \w*. 
\v 4 \w And the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Where]{strong=“H375”} is [he? And Ziba]{strong=“H6717”} [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the king| strong="H4428" \w*, Behold, he is \w in the house| strong="H1004" \w* \w of Machir| strong="H4353" \w*, \w the son| strong="H1121" \w* \w of Ammiel| strong="H5988" \w*, [in Lo-debar]{strong=“H3810”}. 
\p
\v 5 \w Then king| strong="H4428" \w* \w David| strong="H1732" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”}, [and fetched]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w him out of the house| strong="H1004" \w* \w of Machir| strong="H4353" \w*, \w the son| strong="H1121" \w* \w of Ammiel| strong="H5988" \w*, [from Lo-debar]{strong=“H3810”}. 
\v 6 \w Now when Mephibosheth| strong="H4648" \w*, \w the son| strong="H1121" \w* \w of Jonathan| strong="H3083" \w*, \w the son| strong="H1121" \w* \w of Saul| strong="H7586" \w*, [was come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto David| strong="H1732" \w*, [he fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w on his face| strong="H6440" \w*, [and did reverence]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”}. \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Mephibosheth| strong="H4648" \w*. [And he answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Behold thy servant| strong="H5650" \w*!\f + \fr 9:6 \ft Mephibosheth: also called Merib-baal \f* 
\p
\v 7 \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [not: for I will surely]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [shew]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee kindness| strong="H2617" \w* \w for Jonathan| strong="H3083" \w* [thy father’s]{strong=“H1”} [sake, and will restore]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee all the land| strong="H7704" \w* \w of Saul| strong="H7586" \w* \w thy father| strong="H1" \w*; [and thou shalt eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w bread| strong="H3899" \w* \w at my table| strong="H7979" \w* \w continually| strong="H8548" \w*. 
