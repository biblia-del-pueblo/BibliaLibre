\p 
\v 1 [And it was told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8714”} \w Joab| strong="H3097" \w*, [Behold, the king]{strong=“H4428”} [weepeth]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8802”} [and mourneth]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8691”} \w for Absalom| strong="H53" \w*. 
