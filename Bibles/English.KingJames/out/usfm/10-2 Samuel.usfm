\v 6 [In that thou lovest]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8800”} [thine enemies]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”}, [and hatest]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8800”} [thy friends]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”}. [For thou hast declared]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} \w this day| strong="H3117" \w*, \w that thou regardest neither princes| strong="H8269" \w* \w nor servants| strong="H5650" \w*: \w for this day| strong="H3117" \w* [I perceive]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}, \w that if| strong="H3863" \w* \w Absalom| strong="H53" \w* \w had lived| strong="H2416" \w*, [and all we had died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”} \w this day| strong="H3117" \w*, [then it had pleased thee well]{strong=“H5869 H3477”}.\f + \fr 19:6 \ft In…: Heb. By loving, etc \f* \f + \fr 19:6 \ft that thou regardest…: Heb. that princes or servants are not to thee \f* 
\v 7 [Now therefore arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8798”}, [and speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w comfortably| strong="H3820" \w* \w unto thy servants| strong="H5650" \w*: [for I swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} by the \sc Lord\sc*, [if thou go not forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”}, [there will not tarry]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} \w one| strong="H376" \w* \w with thee this night| strong="H3915" \w*: [and that will be worse]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto thee than all the evil| strong="H7451" \w* [that befell]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee from thy youth| strong="H5271" \w* until now.\f + \fr 19:7 \ft comfortably…: Heb. to the heart of thy servants \f* 
