\v 15 [And he wrote]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the letter| strong="H5612" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Set]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye Uriah| strong="H223" \w* [in the forefront]{strong=“H4136 H6440”} \w of the hottest| strong="H2389" \w* \w battle| strong="H4421" \w*, [and retire]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w ye from him| strong="H310" \w*, [that he may be smitten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8738”}, [and die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 11:15 \ft hottest: Heb. strong \f* \f + \fr 11:15 \ft from him: Heb. from after him \f* 
\v 16 [And it came to pass, when Joab]{strong=“H3097”} [observed]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w the city| strong="H5892" \w*, [that he assigned]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w Uriah| strong="H223" \w* \w unto a place| strong="H4725" \w* [where he knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w that valiant| strong="H2428" \w* \w men| strong="H582" \w* were. 
