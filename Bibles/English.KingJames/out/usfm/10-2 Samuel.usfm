\p 
\v 1 [And there happened]{strong=“H7122” x-morph=“strongMorph: \sc Th\sc*8738”} \w to be there a man| strong="H376" \w* \w of Belial| strong="H1100" \w*, \w whose name| strong="H8034" \w* was \w Sheba| strong="H7652" \w*, \w the son| strong="H1121" \w* \w of Bichri| strong="H1075" \w*, \w a Benjamite| strong="H1145" \w*: [and he blew]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8799”} \w a trumpet| strong="H7782" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w We have no part| strong="H2506" \w* \w in David| strong="H1732" \w*, \w neither have we inheritance| strong="H5159" \w* \w in the son| strong="H1121" \w* \w of Jesse| strong="H3448" \w*: \w every| strong="H376" \w* \w man| strong="H376" \w* \w to his tents| strong="H168" \w*, \w O Israel| strong="H3478" \w*. 
