\p
\v 20 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Absalom| strong="H53" \w* \w to Ahithophel| strong="H302" \w*, [Give]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”} \w counsel| strong="H6098" \w* [among you what we shall do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 21 \w And Ahithophel| strong="H302" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Absalom| strong="H53" \w*, [Go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} [unto thy father’s]{strong=“H1”} \w concubines| strong="H6370" \w*, [which he hath left]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8689”} [to keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w the house| strong="H1004" \w*; \w and all Israel| strong="H3478" \w* [shall hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [that thou art abhorred]{strong=“H887” x-morph=“strongMorph: \sc Th\sc*8738”} \w of thy father| strong="H1" \w*: \w then shall the hands| strong="H3027" \w* of all that are [with thee be strong]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 22 [So they spread]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w Absalom| strong="H53" \w* \w a tent| strong="H168" \w* \w upon the top of the house| strong="H1406" \w*; \w and Absalom| strong="H53" \w* [went in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [unto his father’s]{strong=“H1”} \w concubines| strong="H6370" \w* \w in the sight| strong="H5869" \w* \w of all Israel| strong="H3478" \w*. 
\v 23 \w And the counsel| strong="H6098" \w* \w of Ahithophel| strong="H302" \w*, [which he counselled]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8804”} \w in those days| strong="H3117" \w*, was \w as if a man| strong="H376" \w* [had enquired]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} \w at the oracle| strong="H1697" \w* \w of God| strong="H430" \w*: so was \w all the counsel| strong="H6098" \w* \w of Ahithophel| strong="H302" \w* \w both with David| strong="H1732" \w* \w and with Absalom| strong="H53" \w*.\f + \fr 16:23 \ft oracle: Heb. word \f*
\c 17
\p 
\v 1 \w Moreover Ahithophel| strong="H302" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Absalom| strong="H53" \w*, [Let me now choose out]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} [twelve]{strong=“H6240 H8147”} \w thousand| strong="H505" \w* \w men| strong="H376" \w*, [and I will arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} [and pursue]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w David| strong="H1732" \w* \w this night| strong="H3915" \w*: 
\v 2 [And I will come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} upon him while he is \w weary| strong="H3023" \w* \w and weak| strong="H7504" \w* \w handed| strong="H3027" \w*, [and will make him afraid]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8689”}: \w and all the people| strong="H5971" \w* that are [with him shall flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8804”}; [and I will smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w the king| strong="H4428" \w* only: 
\v 3 [And I will bring back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w all the people| strong="H5971" \w* [unto thee: the man]{strong=“H376”} [whom thou seekest]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} is [as if all returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”}: so \w all the people| strong="H5971" \w* \w shall be in peace| strong="H7965" \w*. 
\v 4 \w And the saying| strong="H1697" \w* [pleased]{strong=“H3474” x-morph=“strongMorph: \sc Th\sc*8799”} \w Absalom| strong="H53" \w* \w well| strong="H5869" \w*, \w and all the elders| strong="H2205" \w* \w of Israel| strong="H3478" \w*.\f + \fr 17:4 \ft pleased…: Heb. was right in the eyes of, etc \f* 
\v 5 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Absalom| strong="H53" \w*, [Call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} \w now Hushai| strong="H2365" \w* \w the Archite| strong="H757" \w* [also, and let us hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w likewise what he saith| strong="H6310" \w*.\f + \fr 17:5 \ft what…: Heb. what is in his mouth \f* 
\v 6 \w And when Hushai| strong="H2365" \w* [was come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Absalom| strong="H53" \w*, \w Absalom| strong="H53" \w* [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Ahithophel| strong="H302" \w* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w after this manner| strong="H1697" \w*: [shall we do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} after \w his saying| strong="H1697" \w*? [if not; speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} thou.\f + \fr 17:6 \ft his saying: Heb. his word \f* 
\v 7 \w And Hushai| strong="H2365" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Absalom| strong="H53" \w*, \w The counsel| strong="H6098" \w* \w that Ahithophel| strong="H302" \w* [hath given]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8804”} is \w not good| strong="H2896" \w* \w at this time| strong="H6471" \w*.\f + \fr 17:7 \ft given: Heb. counselled \f* 
\v 8 [For, said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Hushai| strong="H2365" \w*, [thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy father| strong="H1" \w* \w and his men| strong="H582" \w*, that they be \w mighty men| strong="H1368" \w*, and they be \w chafed| strong="H4751" \w* \w in their minds| strong="H5315" \w*, \w as a bear| strong="H1677" \w* \w robbed| strong="H7909" \w* \w of her whelps in the field| strong="H7704" \w*: \w and thy father| strong="H1" \w* is \w a man| strong="H376" \w* \w of war| strong="H4421" \w*, [and will not lodge]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the people| strong="H5971" \w*.\f + \fr 17:8 \ft chafed…: Heb. bitter of soul \f* 
\v 9 [Behold, he is hid]{strong=“H2244” x-morph=“strongMorph: \sc Th\sc*8737”} \w now in some| strong="H259" \w* \w pit| strong="H6354" \w*, \w or in some| strong="H259" \w* other \w place| strong="H4725" \w*: [and it will come to pass, when some of them be overthrown]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8800”} \w at the first| strong="H8462" \w*, [that whosoever]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} [heareth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [it will say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w There is a slaughter| strong="H4046" \w* \w among the people| strong="H5971" \w* \w that follow| strong="H310" \w* \w Absalom| strong="H53" \w*.\f + \fr 17:9 \ft overthrown: Heb. fallen \f* 
\v 10 And he also that is [valiant]{strong=“H2428 H1121”}, \w whose heart| strong="H3820" \w* is \w as the heart| strong="H3820" \w* \w of a lion| strong="H738" \w*, [shall utterly]{strong=“H4549” x-morph=“strongMorph: \sc Th\sc*8736”} [melt]{strong=“H4549” x-morph=“strongMorph: \sc Th\sc*8735”}: \w for all Israel| strong="H3478" \w* [knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w that thy father| strong="H1" \w* is \w a mighty man| strong="H1368" \w*, and they which be with him are \w valiant| strong="H2428" \w* \w men| strong="H1121" \w*. 
\v 11 [Therefore I counsel]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8804”} \w that all Israel| strong="H3478" \w* [be generally]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8736”} [gathered]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8735”} [unto thee, from Dan]{strong=“H1835”} [even to Beer-sheba]{strong=“H884”}, \w as the sand| strong="H2344" \w* that is \w by the sea| strong="H3220" \w* \w for multitude| strong="H7230" \w*; [and that thou go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w to battle| strong="H7128" \w* \w in thine own person| strong="H6440" \w*.\f + \fr 17:11 \ft that thou…: Heb. that thy face, or, presence go, etc \f* 
\v 12 [So shall we come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon him in some| strong="H259" \w* \w place| strong="H4725" \w* [where he shall be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and we will light| strong="H5168" \w* \w upon him as the dew| strong="H2919" \w* [falleth]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w on the ground| strong="H127" \w*: \w and of him and of all the men| strong="H582" \w* that are [with him there shall not be left]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8738”} \w so much as| strong="H1571" \w* \w one| strong="H259" \w*. 
\v 13 [Moreover, if]{strong=“H518”} [he be gotten]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8735”} \w into a city| strong="H5892" \w*, \w then shall all Israel| strong="H3478" \w* [bring]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8689”} \w ropes| strong="H2256" \w* \w to that city| strong="H5892" \w*, [and we will draw]{strong=“H5498” x-morph=“strongMorph: \sc Th\sc*8804”} \w it into the river| strong="H5158" \w*, \w until there be not one| strong="H1571" \w* \w small stone| strong="H6872" \w* [found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8738”} there. 
\v 14 \w And Absalom| strong="H53" \w* \w and all the men| strong="H376" \w* \w of Israel| strong="H3478" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w The counsel| strong="H6098" \w* \w of Hushai| strong="H2365" \w* \w the Archite| strong="H757" \w* is \w better| strong="H2896" \w* \w than the counsel| strong="H6098" \w* \w of Ahithophel| strong="H302" \w*. For the \sc Lord\sc* [had appointed]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [to defeat]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8687”} \w the good| strong="H2896" \w* \w counsel| strong="H6098" \w* \w of Ahithophel| strong="H302" \w*, \w to the intent| strong="H5668" \w* that the \sc Lord\sc* [might bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} \w evil| strong="H7451" \w* \w upon Absalom| strong="H53" \w*.\f + \fr 17:14 \ft appointed: Heb. commanded \f* 
\p
\v 15 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Hushai| strong="H2365" \w* \w unto Zadok| strong="H6659" \w* \w and to Abiathar| strong="H54" \w* \w the priests| strong="H3548" \w*, \w Thus and thus did Ahithophel| strong="H302" \w* [counsel]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8804”} \w Absalom| strong="H53" \w* \w and the elders| strong="H2205" \w* \w of Israel| strong="H3478" \w*; [and thus and thus have I counselled]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 16 [Now therefore send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8798”} \w quickly| strong="H4120" \w*, [and tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”} \w David| strong="H1732" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Lodge]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} \w not this night| strong="H3915" \w* [in the plains]{strong=“H5679 H6160” x-morph=“strongMorph: \sc Th\sc*8675”} \w of the wilderness| strong="H4057" \w*, [but speedily]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8800”} [pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}; \w lest the king| strong="H4428" \w* [be swallowed up]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8792”}, \w and all the people| strong="H5971" \w* that are with him. 
\v 17 \w Now Jonathan| strong="H3083" \w* \w and Ahimaaz| strong="H290" \w* [stayed]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} [by En-rogel]{strong=“H5883”}; [for they might]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [not be seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8736”} [to come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w into the city| strong="H5892" \w*: \w and a wench| strong="H8198" \w* [went]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} [and told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} [them; and they went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [and told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} \w king| strong="H4428" \w* \w David| strong="H1732" \w*. 
\v 18 \w Nevertheless a lad| strong="H5288" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w Absalom| strong="H53" \w*: [but they went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w both| strong="H8147" \w* \w of them away quickly| strong="H4120" \w*, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [to a man’s]{strong=“H376”} \w house| strong="H1004" \w* \w in Bahurim| strong="H980" \w*, \w which had a well| strong="H875" \w* \w in his court| strong="H2691" \w*; \w whither| strong="H8033" \w* [they went down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 19 \w And the woman| strong="H802" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [and spread]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8799”} \w a covering| strong="H4539" \w* [over the well’s]{strong=“H875”} \w mouth| strong="H6440" \w*, [and spread]{strong=“H7849” x-morph=“strongMorph: \sc Th\sc*8799”} \w ground corn| strong="H7383" \w* [thereon; and the thing]{strong=“H1697”} [was not known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 20 [And when Absalom’s]{strong=“H53”} \w servants| strong="H5650" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the woman| strong="H802" \w* \w to the house| strong="H1004" \w*, [they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Where is \w Ahimaaz| strong="H290" \w* \w and Jonathan| strong="H3083" \w*? \w And the woman| strong="H802" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, They be gone over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w the brook| strong="H4323" \w* \w of water| strong="H4325" \w*. [And when they had sought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} [and could not find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} them, [they returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Jerusalem| strong="H3389" \w*. 
\v 21 [And it came to pass, after]{strong=“H310”} [they were departed]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”}, [that they came up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of the well| strong="H875" \w*, [and went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [and told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w king| strong="H4428" \w* \w David| strong="H1732" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto David| strong="H1732" \w*, [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, \w and pass quickly| strong="H4120" \w* [over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8798”} \w the water| strong="H4325" \w*: \w for thus hath Ahithophel| strong="H302" \w* [counselled]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8804”} against you. 
\p
\v 22 \w Then David| strong="H1732" \w* [arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and all the people| strong="H5971" \w* that were [with him, and they passed over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jordan| strong="H3383" \w*: \w by the morning| strong="H1242" \w* \w light| strong="H216" \w* [there lacked]{strong=“H5737” x-morph=“strongMorph: \sc Th\sc*8738”} \w not one| strong="H259" \w* [of them that was not gone over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w Jordan| strong="H3383" \w*. 
\p
\v 23 \w And when Ahithophel| strong="H302" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w that his counsel| strong="H6098" \w* [was not followed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8738”}, [he saddled]{strong=“H2280” x-morph=“strongMorph: \sc Th\sc*8799”} his \w ass| strong="H2543" \w*, [and arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and gat him home]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w to his house| strong="H1004" \w*, \w to his city| strong="H5892" \w*, \w and put his household| strong="H1004" \w* [in order]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”}, [and hanged]{strong=“H2614” x-morph=“strongMorph: \sc Th\sc*8735”} [himself, and died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, [and was buried]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the sepulchre| strong="H6913" \w* \w of his father| strong="H1" \w*.\f + \fr 17:23 \ft followed: Heb. done \f* \f + \fr 17:23 \ft put his…: Heb. gave charge concerning his house \f* 
\v 24 \w Then David| strong="H1732" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w to Mahanaim| strong="H4266" \w*. \w And Absalom| strong="H53" \w* [passed over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w Jordan| strong="H3383" \w*, \w he and all the men| strong="H376" \w* \w of Israel| strong="H3478" \w* with him. 
\p
\v 25 \w And Absalom| strong="H53" \w* [made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w Amasa| strong="H6021" \w* \w captain of the host| strong="H6635" \w* \w instead of Joab| strong="H3097" \w*: \w which Amasa| strong="H6021" \w* was [a man’s]{strong=“H376”} \w son| strong="H1121" \w*, \w whose name| strong="H8034" \w* was \w Ithra| strong="H3501" \w* \w an Israelite| strong="H3481" \w*, [that went in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w to Abigail| strong="H26" \w* \w the daughter| strong="H1323" \w* \w of Nahash| strong="H5176" \w*, \w sister| strong="H269" \w* \w to Zeruiah| strong="H6870" \w* [Joab’s]{strong=“H3097”} \w mother| strong="H517" \w*.\f + \fr 17:25 \ft Ithra an Israelite: or, Jether an Ishmaelite \f* \f + \fr 17:25 \ft Abigail: Heb. Abigal \f* \f + \fr 17:25 \ft Nahash: or, Jesse \f* 
\v 26 \w So Israel| strong="H3478" \w* \w and Absalom| strong="H53" \w* [pitched]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the land| strong="H776" \w* \w of Gilead| strong="H1568" \w*. 
\p
