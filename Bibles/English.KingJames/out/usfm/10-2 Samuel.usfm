\c 12
\p 
\v 1 And the \sc Lord\sc* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w Nathan| strong="H5416" \w* \w unto David| strong="H1732" \w*. [And he came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, There were two]{strong=“H8147”} \w men| strong="H582" \w* \w in one| strong="H259" \w* \w city| strong="H5892" \w*; \w the one| strong="H259" \w* \w rich| strong="H6223" \w*, \w and the other| strong="H259" \w* [poor]{strong=“H7326” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 2 \w The rich| strong="H6223" \w* man \w had exceeding| strong="H3966" \w* [many]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8687”} \w flocks| strong="H6629" \w* \w and herds| strong="H1241" \w*: 
\v 3 [But the poor]{strong=“H7326” x-morph=“strongMorph: \sc Th\sc*8802”} man [had nothing, save one]{strong=“H259”} \w little| strong="H6996" \w* \w ewe lamb| strong="H3535" \w*, [which he had bought]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8804”} [and nourished up]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8762”}: [and it grew up]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8799”} \w together| strong="H3162" \w* [with him, and with his children]{strong=“H1121”}; [it did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w of his own meat| strong="H6595" \w*, [and drank]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w of his own cup| strong="H3563" \w*, [and lay]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his bosom| strong="H2436" \w*, \w and was unto him as a daughter| strong="H1323" \w*.\f + \fr 12:3 \ft meat: Heb. morsel \f* 
\v 4 [And there came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w a traveller| strong="H1982" \w* \w unto the rich| strong="H6223" \w* \w man| strong="H376" \w*, [and he spared]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”} [to take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} \w of his own flock| strong="H6629" \w* \w and of his own herd| strong="H1241" \w*, [to dress]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [for the wayfaring man]{strong=“H732” x-morph=“strongMorph: \sc Th\sc*8802”} [that was come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [unto him; but took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [the poor]{strong=“H7326” x-morph=“strongMorph: \sc Th\sc*8802”} [man’s]{strong=“H376”} \w lamb| strong="H3535" \w*, [and dressed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w it for the man| strong="H376" \w* [that was come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} to him. 
\v 5 [And David’s]{strong=“H1732”} \w anger| strong="H639" \w* \w was greatly| strong="H3966" \w* [kindled]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8799”} \w against the man| strong="H376" \w*; [and he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Nathan| strong="H5416" \w*, As the \sc Lord\sc* \w liveth| strong="H2416" \w*, \w the man| strong="H376" \w* [that hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} this thing \w shall surely| strong="H1121" \w* \w die| strong="H4194" \w*:\f + \fr 12:5 \ft shall…: or, is worthy to die, or, is a son of death \f* 
\v 6 [And he shall restore]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w the lamb| strong="H3535" \w* \w fourfold| strong="H706" \w*, \w because| strong="H6118" \w* [he did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w this thing| strong="H1697" \w*, \w and because| strong="H834" \w* [he had no pity]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\p
\v 7 \w And Nathan| strong="H5416" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to David| strong="H1732" \w*, Thou art \w the man| strong="H376" \w*. [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w*, [I anointed]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee king| strong="H4428" \w* \w over Israel| strong="H3478" \w*, [and I delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee out of the hand| strong="H3027" \w* \w of Saul| strong="H7586" \w*; 
\v 8 [And I gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [thee thy master’s]{strong=“H113”} \w house| strong="H1004" \w*, [and thy master’s]{strong=“H113”} \w wives| strong="H802" \w* \w into thy bosom| strong="H2436" \w*, [and gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* \w and of Judah| strong="H3063" \w*; and if that had been \w too little| strong="H4592" \w*, [I would moreover have given]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto thee such| strong="H2007" \w* \w and such things| strong="H2007" \w*. 
\v 9 [Wherefore hast thou despised]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8804”} \w the commandment| strong="H1697" \w* of the \sc Lord\sc*, [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w evil| strong="H7451" \w* \w in his sight| strong="H5869" \w*? [thou hast killed]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w Uriah| strong="H223" \w* \w the Hittite| strong="H2850" \w* \w with the sword| strong="H2719" \w*, [and hast taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w his wife| strong="H802" \w* to be \w thy wife| strong="H802" \w*, [and hast slain]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”} \w him with the sword| strong="H2719" \w* \w of the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w*. 
\v 10 \w Now therefore the sword| strong="H2719" \w* [shall never]{strong=“H5769 H5704”} [depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8799”} \w from thine house| strong="H1004" \w*; \w because| strong="H6118" \w* [thou hast despised]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and hast taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the wife| strong="H802" \w* \w of Uriah| strong="H223" \w* \w the Hittite| strong="H2850" \w* \w to be thy wife| strong="H802" \w*. 
\v 11 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [Behold, I will raise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8688”} \w evil| strong="H7451" \w* \w against thee out of thine own house| strong="H1004" \w*, [and I will take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy wives| strong="H802" \w* \w before thine eyes| strong="H5869" \w*, [and give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} them \w unto thy neighbour| strong="H7453" \w*, [and he shall lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8804”} \w with thy wives| strong="H802" \w* \w in the sight| strong="H5869" \w* \w of this sun| strong="H8121" \w*. 
\v 12 [For thou didst]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} it \w secretly| strong="H5643" \w*: [but I will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w this thing| strong="H1697" \w* \w before all Israel| strong="H3478" \w*, \w and before the sun| strong="H8121" \w*. 
\v 13 \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Nathan| strong="H5416" \w*, [I have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} against the \sc Lord\sc*. \w And Nathan| strong="H5416" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto David| strong="H1732" \w*, The \sc Lord\sc* [also hath put away]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy sin| strong="H2403" \w*; [thou shalt not die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 14 \w Howbeit| strong="H657" \w*, \w because by this deed| strong="H1697" \w* \w thou hast given| strong="H5006" \w* [great occasion]{strong=“H5006” x-morph=“strongMorph: \sc Th\sc*8763”} [to the enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} of the \sc Lord\sc* [to blaspheme]{strong=“H5006” x-morph=“strongMorph: \sc Th\sc*8765”}, \w the child| strong="H1121" \w* also that is \w born| strong="H3209" \w* [unto thee shall surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 15 \w And Nathan| strong="H5416" \w* [departed]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his house| strong="H1004" \w*. And the \sc Lord\sc* [struck]{strong=“H5062” x-morph=“strongMorph: \sc Th\sc*8799”} \w the child| strong="H3206" \w* [that Uriah’s]{strong=“H223”} \w wife| strong="H802" \w* [bare]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto David| strong="H1732" \w*, [and it was very sick]{strong=“H605” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 16 \w David| strong="H1732" \w* [therefore besought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w God| strong="H430" \w* \w for the child| strong="H5288" \w*; \w and David| strong="H1732" \w* [fasted]{strong=“H6685 H6684” x-morph=“strongMorph: \sc Th\sc*8799”}, [and went in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, [and lay]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8804”} [all night]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon the earth| strong="H776" \w*.\f + \fr 12:16 \ft fasted: Heb. fasted a fast \f* 
\v 17 \w And the elders| strong="H2205" \w* \w of his house| strong="H1004" \w* [arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, and went [to him, to raise him up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8687”} \w from the earth| strong="H776" \w*: [but he would]{strong=“H14” x-morph=“strongMorph: \sc Th\sc*8804”} [not, neither did he eat]{strong=“H1262” x-morph=“strongMorph: \sc Th\sc*8804”} \w bread| strong="H3899" \w* with them. 
\v 18 \w And it came to pass on the seventh| strong="H7637" \w* \w day| strong="H3117" \w*, \w that the child| strong="H3206" \w* [died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. \w And the servants| strong="H5650" \w* \w of David| strong="H1732" \w* [feared]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [to tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8687”} \w him that the child| strong="H3206" \w* [was dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}: [for they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Behold, while the child]{strong=“H3206”} \w was yet alive| strong="H2416" \w*, [we spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [unto him, and he would not hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto our voice| strong="H6963" \w*: \w how will he then| strong="H6213" \w* \w vex| strong="H7451" \w* [himself]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [if we tell]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w him that the child| strong="H3206" \w* [is dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}?\f + \fr 12:18 \ft vex: Heb. do hurt \f* 
