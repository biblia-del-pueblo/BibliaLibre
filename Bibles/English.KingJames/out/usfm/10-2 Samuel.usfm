\c 11
\p 
\v 1 [And it came to pass, after the year]{strong=“H8141”} \w was expired| strong="H8666" \w*, \w at the time| strong="H6256" \w* [when kings]{strong=“H4397 H4428” x-morph=“strongMorph: \sc Th\sc*8675”} [go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”} to battle, \w that David| strong="H1732" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w Joab| strong="H3097" \w*, \w and his servants| strong="H5650" \w* [with him, and all Israel]{strong=“H3478”}; [and they destroyed]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8686”} \w the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w*, [and besieged]{strong=“H6696” x-morph=“strongMorph: \sc Th\sc*8799”} \w Rabbah| strong="H7237" \w*. \w But David| strong="H1732" \w* [tarried still]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w at Jerusalem| strong="H3389" \w*.\f + \fr 11:1 \ft after…: Heb. at the return of the year, or, in the spring \f* 
\p
