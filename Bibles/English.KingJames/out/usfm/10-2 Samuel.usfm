\p
\v 10 [And David’s]{strong=“H1732”} \w heart| strong="H3820" \w* [smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w him after| strong="H310" \w* [that he had numbered]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8804”} \w the people| strong="H5971" \w*. \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc*, [I have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} \w greatly| strong="H3966" \w* [in that I have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}: and now, I beseech thee, O \sc Lord\sc*, [take away]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8685”} \w the iniquity| strong="H5771" \w* \w of thy servant| strong="H5650" \w*; \w for I have done very| strong="H3966" \w* [foolishly]{strong=“H5528” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 11 \w For when David| strong="H1732" \w* [was up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the morning| strong="H1242" \w*, \w the word| strong="H1697" \w* of the \sc Lord\sc* \w came unto the prophet| strong="H5030" \w* \w Gad| strong="H1410" \w*, [David’s]{strong=“H1732”} \w seer| strong="H2374" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 12 [Go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”} [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto David| strong="H1732" \w*, [Thus saith]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} the \sc Lord\sc*, [I offer]{strong=“H5190” x-morph=“strongMorph: \sc Th\sc*8802”} \w thee three| strong="H7969" \w* things; [choose ]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee one| strong="H259" \w* of them, that I may do it [unto thee]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 13 \w So Gad| strong="H1410" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to David| strong="H1732" \w*, [and told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} [him, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Shall seven]{strong=“H7651”} \w years| strong="H8141" \w* \w of famine| strong="H7458" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto thee in thy land| strong="H776" \w*? [or wilt thou flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8800”} \w three| strong="H7969" \w* \w months| strong="H2320" \w* \w before| strong="H6440" \w* \w thine enemies| strong="H6862" \w*, [while they pursue]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8802”} [thee? or that there be three]{strong=“H7969”} [days’]{strong=“H3117”} \w pestilence| strong="H1698" \w* \w in thy land| strong="H776" \w*? [now advise]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”}, [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w what answer| strong="H1697" \w* [I shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} [to him that sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8802”} me. 
\v 14 \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Gad| strong="H1410" \w*, \w I am in a great| strong="H3966" \w* [strait]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8804”}: [let us fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w now into the hand| strong="H3027" \w* of the \sc Lord\sc*; \w for his mercies| strong="H7356" \w* are \w great| strong="H7227" \w*: [and let me not fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the hand| strong="H3027" \w* \w of man| strong="H120" \w*.\f + \fr 24:14 \ft are great: or, are many \f* 
\p
\v 15 So the \sc Lord\sc* [sent]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w a pestilence| strong="H1698" \w* \w upon Israel| strong="H3478" \w* \w from the morning| strong="H1242" \w* \w even to the time| strong="H6256" \w* \w appointed| strong="H4150" \w*: [and there died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the people| strong="H5971" \w* \w from Dan| strong="H1835" \w* [even to Beer-sheba]{strong=“H884”} \w seventy| strong="H7657" \w* \w thousand| strong="H505" \w* \w men| strong="H376" \w*. 
\v 16 \w And when the angel| strong="H4397" \w* [stretched out]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w his hand| strong="H3027" \w* \w upon Jerusalem| strong="H3389" \w* [to destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8763”} it, the \sc Lord\sc* [repented]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8735”} \w him of the evil| strong="H7451" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the angel| strong="H4397" \w* [that destroyed]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8688”} \w the people| strong="H5971" \w*, \w It is enough| strong="H7227" \w*: [stay]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8685”} \w now thine hand| strong="H3027" \w*. \w And the angel| strong="H4397" \w* of the \sc Lord\sc* \w was by the threshingplace| strong="H1637" \w* \w of Araunah| strong="H728" \w* \w the Jebusite| strong="H2983" \w*.\f + \fr 24:16 \ft Araunah: also called, Ornan \f* 
\v 17 \w And David| strong="H1732" \w* [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc* [when he saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w the angel| strong="H4397" \w* [that smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8688”} \w the people| strong="H5971" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Lo, I have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}, [and I have done wickedly]{strong=“H5753” x-morph=“strongMorph: \sc Th\sc*8689”}: \w but these sheep| strong="H6629" \w*, [what have they done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}? \w let thine hand| strong="H3027" \w*, [I pray thee, be against me, and against my father’s]{strong=“H1”} \w house| strong="H1004" \w*. 
\p
\v 18 \w And Gad| strong="H1410" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w that day| strong="H3117" \w* \w to David| strong="H1732" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”}, [rear]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8685”} \w an altar| strong="H4196" \w* unto the \sc Lord\sc* \w in the threshingfloor| strong="H1637" \w* \w of Araunah| strong="H728" \w* \w the Jebusite| strong="H2983" \w*.\f + \fr 24:18 \ft Araunah: Heb. Araniah \f* 
\v 19 \w And David| strong="H1732" \w*, \w according to the saying| strong="H1697" \w* \w of Gad| strong="H1410" \w*, [went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} as the \sc Lord\sc* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 20 \w And Araunah| strong="H728" \w* [looked]{strong=“H8259” x-morph=“strongMorph: \sc Th\sc*8686”}, [and saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the king| strong="H4428" \w* \w and his servants| strong="H5650" \w* [coming on]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} [toward him: and Araunah]{strong=“H728”} [went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”}, [and bowed]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} \w himself before the king| strong="H4428" \w* \w on his face| strong="H639" \w* \w upon the ground| strong="H776" \w*. 
\v 21 \w And Araunah| strong="H728" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Wherefore is my lord| strong="H113" \w* \w the king| strong="H4428" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w to his servant| strong="H5650" \w*? \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [To buy]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8800”} \w the threshingfloor| strong="H1637" \w* [of thee, to build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8800”} \w an altar| strong="H4196" \w* unto the \sc Lord\sc*, \w that the plague| strong="H4046" \w* [may be stayed]{strong=“H6113” x-morph=“strongMorph: \sc Th\sc*8735”} \w from the people| strong="H5971" \w*. 
\v 22 \w And Araunah| strong="H728" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto David| strong="H1732" \w*, \w Let my lord| strong="H113" \w* \w the king| strong="H4428" \w* [take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [and offer up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} what seemeth \w good| strong="H2896" \w* \w unto him| strong="H5869" \w*: [behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}, here be \w oxen| strong="H1241" \w* \w for burnt sacrifice| strong="H5930" \w*, \w and threshing instruments| strong="H4173" \w* and other \w instruments| strong="H3627" \w* \w of the oxen| strong="H1241" \w* \w for wood| strong="H6086" \w*. 
\v 23 All these things \w did Araunah| strong="H728" \w*, as \w a king| strong="H4428" \w*, [give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the king| strong="H4428" \w*. \w And Araunah| strong="H728" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the king| strong="H4428" \w*, The \sc Lord\sc* \w thy God| strong="H430" \w* [accept ]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8799”} thee. 
\v 24 \w And the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Araunah| strong="H728" \w*, [Nay; but I will surely]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8800”} [buy]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8799”} it \w of thee at a price| strong="H4242" \w*: [neither will I offer]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w burnt offerings| strong="H5930" \w* unto the \sc Lord\sc* \w my God| strong="H430" \w* \w of that which doth cost me nothing| strong="H2600" \w*. \w So David| strong="H1732" \w* [bought]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8799”} \w the threshingfloor| strong="H1637" \w* \w and the oxen| strong="H1241" \w* \w for fifty| strong="H2572" \w* \w shekels| strong="H8255" \w* \w of silver| strong="H3701" \w*. 
\v 25 \w And David| strong="H1732" \w* [built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w there an altar| strong="H4196" \w* unto the \sc Lord\sc*, [and offered]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w burnt offerings| strong="H5930" \w* \w and peace offerings| strong="H8002" \w*. So the \sc Lord\sc* [was intreated]{strong=“H6279” x-morph=“strongMorph: \sc Th\sc*8735”} \w for the land| strong="H776" \w*, \w and the plague| strong="H4046" \w* [was stayed]{strong=“H6113” x-morph=“strongMorph: \sc Th\sc*8735”} \w from Israel| strong="H3478" \w*. 
