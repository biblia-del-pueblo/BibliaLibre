\c 13
\p 
\v 1 \w And it came to pass after| strong="H310" \w* [this, that Absalom]{strong=“H53”} \w the son| strong="H1121" \w* \w of David| strong="H1732" \w* \w had a fair| strong="H3303" \w* \w sister| strong="H269" \w*, \w whose name| strong="H8034" \w* was \w Tamar| strong="H8559" \w*; \w and Amnon| strong="H550" \w* \w the son| strong="H1121" \w* \w of David| strong="H1732" \w* [loved]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8799”} her. 
\v 2 \w And Amnon| strong="H550" \w* [was so vexed]{strong=“H3334” x-morph=“strongMorph: \sc Th\sc*8799”}, [that he fell sick]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8692”} \w for his sister| strong="H269" \w* \w Tamar| strong="H8559" \w*; for she was \w a virgin| strong="H1330" \w*; \w and Amnon| strong="H550" \w* \w thought| strong="H5869" \w* [it hard]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8735”} [for him to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w any thing| strong="H3972" \w* to her.\f + \fr 13:2 \ft Amnon thought…: Heb. it was marvellous, or, hidden in the eyes of Amnon \f* 
\v 3 \w But Amnon| strong="H550" \w* \w had a friend| strong="H7453" \w*, \w whose name| strong="H8034" \w* was \w Jonadab| strong="H3122" \w*, \w the son| strong="H1121" \w* \w of Shimeah| strong="H8093" \w* [David’s]{strong=“H1732”} \w brother| strong="H251" \w*: \w and Jonadab| strong="H3122" \w* was \w a very| strong="H3966" \w* \w subtil| strong="H2450" \w* \w man| strong="H376" \w*. 
\v 4 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, Why art thou, being [the king’s]{strong=“H4428”} \w son| strong="H1121" \w*, \w lean| strong="H1800" \w* \w from day| strong="H1242" \w* \w to day| strong="H1242" \w*? [wilt thou not tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} [me? And Amnon]{strong=“H550”} [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, I love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} \w Tamar| strong="H8559" \w*, \w my brother| strong="H251" \w* [Absalom’s]{strong=“H53”} \w sister| strong="H269" \w*.\f + \fr 13:4 \ft lean: Heb. thin \f* \f + \fr 13:4 \ft from day…: Heb. morning by morning \f* 
\v 5 \w And Jonadab| strong="H3082" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Lay thee down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8798”} \w on thy bed| strong="H4904" \w*, [and make thyself sick]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8690”}: \w and when thy father| strong="H1" \w* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} [thee, say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto him, I pray thee, let my sister]{strong=“H269”} \w Tamar| strong="H8559" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [and give]{strong=“H1262” x-morph=“strongMorph: \sc Th\sc*8686”} \w me meat| strong="H3899" \w*, [and dress]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w the meat| strong="H1279" \w* \w in my sight| strong="H5869" \w*, [that I may see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} it, [and eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} it \w at her hand| strong="H3027" \w*. 
\p
\v 6 \w So Amnon| strong="H550" \w* [lay down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”}, [and made himself sick]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8691”}: \w and when the king| strong="H4428" \w* [was come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [to see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} [him, Amnon]{strong=“H550”} [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the king| strong="H4428" \w*, [I pray thee, let Tamar]{strong=“H8559”} \w my sister| strong="H269" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [and make]{strong=“H3823” x-morph=“strongMorph: \sc Th\sc*8762”} \w me a couple| strong="H8147" \w* \w of cakes| strong="H3834" \w* \w in my sight| strong="H5869" \w*, [that I may eat]{strong=“H1262” x-morph=“strongMorph: \sc Th\sc*8799”} \w at her hand| strong="H3027" \w*. 
\v 7 \w Then David| strong="H1732" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w home| strong="H1004" \w* \w to Tamar| strong="H8559" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} \w now to thy brother| strong="H251" \w* [Amnon’s]{strong=“H550”} \w house| strong="H1004" \w*, [and dress]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} \w him meat| strong="H1279" \w*. 
\v 8 \w So Tamar| strong="H8559" \w* [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w to her brother| strong="H251" \w* [Amnon’s]{strong=“H550”} \w house| strong="H1004" \w*; [and he was laid down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8802”}. [And she took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w flour| strong="H1217" \w*, [and kneaded]{strong=“H3888” x-morph=“strongMorph: \sc Th\sc*8799”} it, [and made cakes]{strong=“H3823” x-morph=“strongMorph: \sc Th\sc*8762”} \w in his sight| strong="H5869" \w*, [and did bake]{strong=“H1310” x-morph=“strongMorph: \sc Th\sc*8762”} \w the cakes| strong="H3834" \w*.\f + \fr 13:8 \ft flour: or, paste \f* 
\v 9 [And she took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a pan| strong="H4958" \w*, and poured them [out]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* [him; but he refused]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8762”} [to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”}. \w And Amnon| strong="H550" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Have out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8685”} \w all men| strong="H376" \w* [from me. And they went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w every man| strong="H376" \w* from him. 
\v 10 \w And Amnon| strong="H550" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Tamar| strong="H8559" \w*, [Bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8685”} \w the meat| strong="H1279" \w* \w into the chamber| strong="H2315" \w*, [that I may eat]{strong=“H1262” x-morph=“strongMorph: \sc Th\sc*8799”} \w of thine hand| strong="H3027" \w*. \w And Tamar| strong="H8559" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the cakes| strong="H3834" \w* [which she had made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [and brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} them \w into the chamber| strong="H2315" \w* \w to Amnon| strong="H550" \w* \w her brother| strong="H251" \w*. 
\v 11 [And when she had brought]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8686”} them [unto him to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”}, [he took hold]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8686”} [of her, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto her, Come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} [lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8798”} [with me, my sister]{strong=“H269”}. 
\v 12 [And she answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [him, Nay, my brother]{strong=“H251”}, [do not force]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8762”} [me; for no such thing ought]{strong=“H3651”} [to be done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8735”} \w in Israel| strong="H3478" \w*: [do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w not thou this folly| strong="H5039" \w*.\f + \fr 13:12 \ft force…: Heb. humble me \f* \f + \fr 13:12 \ft no such…: Heb. it ought not so to be done \f* 
\v 13 [And I, whither shall I cause my shame]{strong=“H2781”} [to go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8686”}? [and as for thee, thou shalt be as one]{strong=“H259”} \w of the fools| strong="H5036" \w* \w in Israel| strong="H3478" \w*. [Now therefore, I pray thee, speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w unto the king| strong="H4428" \w*; [for he will not withhold]{strong=“H4513” x-morph=“strongMorph: \sc Th\sc*8799”} me from thee. 
