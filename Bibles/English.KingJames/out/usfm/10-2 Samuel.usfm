\c 4
\p 
\v 1 [And when Saul’s]{strong=“H7586”} \w son| strong="H1121" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w that Abner| strong="H74" \w* [was dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”} \w in Hebron| strong="H2275" \w*, \w his hands| strong="H3027" \w* [were feeble]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and all the Israelites| strong="H3478" \w* [were troubled]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 2 [And Saul’s]{strong=“H7586”} \w son| strong="H1121" \w* [had]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8804”} \w two| strong="H8147" \w* \w men| strong="H582" \w* that were \w captains| strong="H8269" \w* \w of bands| strong="H1416" \w*: \w the name| strong="H8034" \w* \w of the one| strong="H259" \w* was \w Baanah| strong="H1196" \w*, \w and the name| strong="H8034" \w* \w of the other| strong="H8145" \w* \w Rechab| strong="H7394" \w*, \w the sons| strong="H1121" \w* \w of Rimmon| strong="H7417" \w* \w a Beerothite| strong="H886" \w*, \w of the children| strong="H1121" \w* \w of Benjamin| strong="H1144" \w*: (\w for Beeroth| strong="H881" \w* [also was reckoned]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8735”} \w to Benjamin| strong="H1144" \w*:\f + \fr 4:2 \ft other: Heb. second \f* 
\v 3 \w And the Beerothites| strong="H886" \w* [fled]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Gittaim| strong="H1664" \w*, [and were sojourners]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8802”} \w there until this day| strong="H3117" \w*.) 
\v 4 \w And Jonathan| strong="H3083" \w*, [Saul’s]{strong=“H7586”} \w son| strong="H1121" \w*, \w had a son| strong="H1121" \w* that was \w lame| strong="H5223" \w* of his \w feet| strong="H7272" \w*. \w He was five| strong="H2568" \w* \w years| strong="H8141" \w* \w old| strong="H1121" \w* \w when the tidings| strong="H8052" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w of Saul| strong="H7586" \w* \w and Jonathan| strong="H3083" \w* \w out of Jezreel| strong="H3157" \w*, [and his nurse]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8802”} [took him up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”}, [and fled]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”}: [and it came to pass, as she made haste]{strong=“H2648” x-morph=“strongMorph: \sc Th\sc*8800”} [to flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8800”}, [that he fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”}, [and became lame]{strong=“H6452” x-morph=“strongMorph: \sc Th\sc*8735”}. \w And his name| strong="H8034" \w* was \w Mephibosheth| strong="H4648" \w*.\f + \fr 4:4 \ft Mephibosheth: or, Merib-baal \f* 
\v 5 \w And the sons| strong="H1121" \w* \w of Rimmon| strong="H7417" \w* \w the Beerothite| strong="H886" \w*, \w Rechab| strong="H7394" \w* \w and Baanah| strong="H1196" \w*, [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w about the heat| strong="H2527" \w* \w of the day| strong="H3117" \w* \w to the house| strong="H1004" \w* [of Ish-bosheth]{strong=“H378”}, [who lay]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8802”} \w on a bed| strong="H4904" \w* \w at noon| strong="H6672" \w*. 
\v 6 [And they came thither]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the midst| strong="H8432" \w* \w of the house| strong="H1004" \w*, as though [they would have fetched]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8802”} \w wheat| strong="H2406" \w*; [and they smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w him under the fifth| strong="H2570" \w* rib: \w and Rechab| strong="H7394" \w* \w and Baanah| strong="H1196" \w* \w his brother| strong="H251" \w* [escaped]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 7 [For when they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the house| strong="H1004" \w*, [he lay]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8802”} \w on his bed| strong="H4296" \w* [in his bedchamber]{strong=“H4904 H2315”}, [and they smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} [him, and slew]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8686”} [him, and beheaded]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8686”} [him, and took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w his head| strong="H7218" \w*, [and gat them away]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w through| strong="H1870" \w* \w the plain| strong="H6160" \w* \w all night| strong="H3915" \w*. 
\v 8 [And they brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w the head| strong="H7218" \w* [of Ish-bosheth]{strong=“H378”} \w unto David| strong="H1732" \w* \w to Hebron| strong="H2275" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the king| strong="H4428" \w*, \w Behold the head| strong="H7218" \w* [of Ish-bosheth]{strong=“H378”} \w the son| strong="H1121" \w* \w of Saul| strong="H7586" \w* [thine enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, [which sought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy life| strong="H5315" \w*; and the \sc Lord\sc* [hath]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w avenged| strong="H5360" \w* \w my lord| strong="H113" \w* \w the king| strong="H4428" \w* \w this day| strong="H3117" \w* \w of Saul| strong="H7586" \w*, \w and of his seed| strong="H2233" \w*. 
\p
\v 9 \w And David| strong="H1732" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w Rechab| strong="H7394" \w* \w and Baanah| strong="H1196" \w* \w his brother| strong="H251" \w*, \w the sons| strong="H1121" \w* \w of Rimmon| strong="H7417" \w* \w the Beerothite| strong="H886" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto them, As the \sc Lord\sc* \w liveth| strong="H2416" \w*, [who hath redeemed]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8804”} \w my soul| strong="H5315" \w* \w out of all adversity| strong="H6869" \w*, 
\v 10 [When one told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8688”} [me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Behold, Saul]{strong=“H7586”} [is dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}, \w thinking to have brought| strong="H5869" \w* [good tidings]{strong=“H1319” x-morph=“strongMorph: \sc Th\sc*8764”}, [I took hold]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8799”} [of him, and slew]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} \w him in Ziklag| strong="H6860" \w*, who thought [that I would have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w him a reward for his tidings| strong="H1309" \w*:\f + \fr 4:10 \ft thinking…: Heb. he was in his own eyes as a bringer, etc \f* \f + \fr 4:10 \ft who…: or, which was the reward I gave him for his tidings \f* 
\v 11 [How much more, when wicked]{strong=“H7563”} \w men| strong="H582" \w* [have slain]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”} \w a righteous| strong="H6662" \w* \w person| strong="H376" \w* \w in his own house| strong="H1004" \w* \w upon his bed| strong="H4904" \w*? [shall I not therefore now require]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w his blood| strong="H1818" \w* \w of your hand| strong="H3027" \w*, [and take you away]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8765”} \w from the earth| strong="H776" \w*? 
\v 12 \w And David| strong="H1732" \w* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} \w his young men| strong="H5288" \w*, [and they slew]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and cut off]{strong=“H7112” x-morph=“strongMorph: \sc Th\sc*8762”} \w their hands| strong="H3027" \w* \w and their feet| strong="H7272" \w*, and hanged them [up]{strong=“H8518” x-morph=“strongMorph: \sc Th\sc*8799”} \w over the pool| strong="H1295" \w* \w in Hebron| strong="H2275" \w*. [But they took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w the head| strong="H7218" \w* [of Ish-bosheth]{strong=“H378”}, [and buried]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8799”} it \w in the sepulchre| strong="H6913" \w* \w of Abner| strong="H74" \w* \w in Hebron| strong="H2275" \w*.
\c 5
\p 
\v 1 [Then came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the tribes| strong="H7626" \w* \w of Israel| strong="H3478" \w* \w to David| strong="H1732" \w* \w unto Hebron| strong="H2275" \w*, [and spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, Behold, we are \w thy bone| strong="H6106" \w* \w and thy flesh| strong="H1320" \w*. 
\v 2 [Also in time past]{strong=“H8032 H865”}, \w when Saul| strong="H7586" \w* \w was king| strong="H4428" \w* [over us, thou wast he that leddest out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8688”} [and broughtest in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} \w Israel| strong="H3478" \w*: and the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [to thee, Thou shalt feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} \w my people| strong="H5971" \w* \w Israel| strong="H3478" \w*, \w and thou shalt be a captain| strong="H5057" \w* \w over Israel| strong="H3478" \w*. 
\v 3 \w So all the elders| strong="H2205" \w* \w of Israel| strong="H3478" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the king| strong="H4428" \w* \w to Hebron| strong="H2275" \w*; \w and king| strong="H4428" \w* \w David| strong="H1732" \w* [made]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} \w a league| strong="H1285" \w* \w with them in Hebron| strong="H2275" \w* \w before| strong="H6440" \w* the \sc Lord\sc*: [and they anointed]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8799”} \w David| strong="H1732" \w* \w king| strong="H4428" \w* \w over Israel| strong="H3478" \w*. 
\p
\v 4 \w David| strong="H1732" \w* was \w thirty| strong="H7970" \w* \w years| strong="H8141" \w* \w old| strong="H1121" \w* [when he began to reign]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8800”}, and [he reigned]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8804”} \w forty| strong="H705" \w* \w years| strong="H8141" \w*. 
\v 5 \w In Hebron| strong="H2275" \w* [he reigned]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8804”} \w over Judah| strong="H3063" \w* \w seven| strong="H7651" \w* \w years| strong="H8141" \w* \w and six| strong="H8337" \w* \w months| strong="H2320" \w*: \w and in Jerusalem| strong="H3389" \w* [he reigned]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8804”} \w thirty| strong="H7970" \w* \w and three| strong="H7969" \w* \w years| strong="H8141" \w* \w over all Israel| strong="H3478" \w* \w and Judah| strong="H3063" \w*. 
\p
\v 6 \w And the king| strong="H4428" \w* \w and his men| strong="H582" \w* [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Jerusalem| strong="H3389" \w* \w unto the Jebusites| strong="H2983" \w*, [the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the land| strong="H776" \w*: [which spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto David| strong="H1732" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Except thou take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8687”} \w the blind| strong="H5787" \w* \w and the lame| strong="H6455" \w*, [thou shalt not come in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [hither: thinking]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w David| strong="H1732" \w* [cannot come in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} hither.\f + \fr 5:6 \ft thinking…: or, saying David shall not, etc \f* 
\v 7 \w Nevertheless David| strong="H1732" \w* [took]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8799”} \w the strong hold| strong="H4686" \w* \w of Zion| strong="H6726" \w*: the same is \w the city| strong="H5892" \w* \w of David| strong="H1732" \w*. 
\v 8 \w And David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w on that day| strong="H3117" \w*, [Whosoever getteth up]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the gutter| strong="H6794" \w*, [and smiteth]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8688”} \w the Jebusites| strong="H2983" \w*, \w and the lame| strong="H6455" \w* \w and the blind| strong="H5787" \w*, that are [hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8803”} [of David’s]{strong=“H1732”} \w soul| strong="H5315" \w*, he shall be chief and captain. [Wherefore they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w The blind| strong="H5787" \w* \w and the lame| strong="H6455" \w* [shall not come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the house| strong="H1004" \w*.\f + \fr 5:8 \ft Wherefore…: or, Because they had said, even the blind and the lame, He shall not \f* 
\v 9 \w So David| strong="H1732" \w* [dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the fort| strong="H4686" \w*, [and called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w it the city| strong="H5892" \w* \w of David| strong="H1732" \w*. \w And David| strong="H1732" \w* [built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w round about| strong="H5439" \w* \w from Millo| strong="H4407" \w* \w and inward| strong="H1004" \w*. 
\v 10 \w And David| strong="H1732" \w* [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [on]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”}, \w and grew great| strong="H1419" \w*, and the \sc Lord\sc* \w God| strong="H430" \w* \w of hosts| strong="H6635" \w* was with him.\f + \fr 5:10 \ft went…: Heb. went, going and growing \f* 
\p
\v 11 \w And Hiram| strong="H2438" \w* \w king| strong="H4428" \w* \w of Tyre| strong="H6865" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w messengers| strong="H4397" \w* \w to David| strong="H1732" \w*, \w and cedar| strong="H730" \w* \w trees| strong="H6086" \w*, \w and carpenters| strong="H2796" \w*, [and masons]{strong=“H68 H7023”}: [and they built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w David| strong="H1732" \w* \w an house| strong="H1004" \w*.\f + \fr 5:11 \ft masons: Heb. hewers of the stone of the wall \f* 
\v 12 \w And David| strong="H1732" \w* [perceived]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} that the \sc Lord\sc* [had established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8689”} \w him king| strong="H4428" \w* \w over Israel| strong="H3478" \w*, [and that he had exalted]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8765”} \w his kingdom| strong="H4467" \w* \w for his people| strong="H5971" \w* [Israel’s]{strong=“H3478”} sake. 
\p
\v 13 \w And David| strong="H1732" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} him \w more concubines| strong="H6370" \w* \w and wives| strong="H802" \w* \w out of Jerusalem| strong="H3389" \w*, \w after| strong="H310" \w* [he was come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w from Hebron| strong="H2275" \w*: \w and there were yet sons| strong="H1121" \w* \w and daughters| strong="H1323" \w* [born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8735”} \w to David| strong="H1732" \w*. 
\v 14 And these be \w the names| strong="H8034" \w* \w of those that were born| strong="H3209" \w* \w unto him in Jerusalem| strong="H3389" \w*; \w Shammua| strong="H8051" \w*, \w and Shobab| strong="H7727" \w*, \w and Nathan| strong="H5416" \w*, \w and Solomon| strong="H8010" \w*, 
\v 15 \w Ibhar| strong="H2984" \w* [also, and Elishua]{strong=“H474”}, \w and Nepheg| strong="H5298" \w*, \w and Japhia| strong="H3309" \w*, 
\v 16 \w And Elishama| strong="H476" \w*, \w and Eliada| strong="H450" \w*, \w and Eliphalet| strong="H467" \w*. 
\p
\v 17 \w But when the Philistines| strong="H6430" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [that they had anointed]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8804”} \w David| strong="H1732" \w* \w king| strong="H4428" \w* \w over Israel| strong="H3478" \w*, \w all the Philistines| strong="H6430" \w* [came up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} [to seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8763”} \w David| strong="H1732" \w*; \w and David| strong="H1732" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} of it, [and went down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the hold| strong="H4686" \w*. 
\v 18 \w The Philistines| strong="H6430" \w* [also came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [and spread]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8735”} \w themselves in the valley| strong="H6010" \w* \w of Rephaim| strong="H7497" \w*. 
