\v 11 \w And Uriah| strong="H223" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto David| strong="H1732" \w*, \w The ark| strong="H727" \w*, \w and Israel| strong="H3478" \w*, \w and Judah| strong="H3063" \w*, [abide]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in tents| strong="H5521" \w*; \w and my lord| strong="H113" \w* \w Joab| strong="H3097" \w*, \w and the servants| strong="H5650" \w* \w of my lord| strong="H113" \w*, [are encamped]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the open| strong="H6440" \w* \w fields| strong="H7704" \w*; \w shall I| strong="H589" \w* [then go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into mine house| strong="H1004" \w*, [to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} [and to drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”}, [and to lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8800”} \w with my wife| strong="H802" \w*? as \w thou livest| strong="H2416" \w*, and as \w thy soul| strong="H5315" \w* \w liveth| strong="H2416" \w*, [I will not do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w this thing| strong="H1697" \w*. 
