\v 11 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Ziba| strong="H6717" \w* \w unto the king| strong="H4428" \w*, \w According to all that my lord| strong="H113" \w* \w the king| strong="H4428" \w* [hath commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} \w his servant| strong="H5650" \w*, \w so shall thy servant| strong="H5650" \w* [do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}. \w As for Mephibosheth| strong="H4648" \w*, said the king, [he shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} \w at my table| strong="H7979" \w*, \w as one| strong="H259" \w* [of the king’s]{strong=“H4428”} \w sons| strong="H1121" \w*. 
\v 12 \w And Mephibosheth| strong="H4648" \w* \w had a young| strong="H6996" \w* \w son| strong="H1121" \w*, \w whose name| strong="H8034" \w* was \w Micha| strong="H4316" \w*. \w And all that dwelt| strong="H4186" \w* \w in the house| strong="H1004" \w* \w of Ziba| strong="H6717" \w* were \w servants| strong="H5650" \w* \w unto Mephibosheth| strong="H4648" \w*. 
\v 13 \w So Mephibosheth| strong="H4648" \w* [dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in Jerusalem| strong="H3389" \w*: [for he did eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} \w continually| strong="H8548" \w* [at the king’s]{strong=“H4428”} \w table| strong="H7979" \w*; \w and was lame| strong="H6455" \w* \w on both| strong="H8147" \w* \w his feet| strong="H7272" \w*. 
\c 10
\p 
\v 1 \w And it came to pass after this| strong="H310" \w*, \w that the king| strong="H4428" \w* \w of the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w* [died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and Hanun| strong="H2586" \w* \w his son| strong="H1121" \w* [reigned]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8799”} in his stead. 
\v 2 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w David| strong="H1732" \w*, [I will shew]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w kindness| strong="H2617" \w* \w unto Hanun| strong="H2586" \w* \w the son| strong="H1121" \w* \w of Nahash| strong="H5176" \w*, \w as his father| strong="H1" \w* [shewed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w kindness| strong="H2617" \w* [unto me. And David]{strong=“H1732”} [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} [to comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8763”} \w him by the hand| strong="H3027" \w* \w of his servants| strong="H5650" \w* \w for his father| strong="H1" \w*. [And David’s]{strong=“H1732”} \w servants| strong="H5650" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the land| strong="H776" \w* \w of the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w*. 
\v 3 \w And the princes| strong="H8269" \w* \w of the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Hanun| strong="H2586" \w* \w their lord| strong="H113" \w*, \w Thinkest| strong="H5869" \w* \w thou that David| strong="H1732" \w* [doth honour]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8764”} \w thy father| strong="H1" \w*, [that he hath sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [comforters]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8764”} [unto thee? hath not David]{strong=“H1732”} rather [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w his servants| strong="H5650" \w* [unto thee, to]{strong=“H5668”} [search]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8800”} \w the city| strong="H5892" \w*, [and to spy it out]{strong=“H7270” x-morph=“strongMorph: \sc Th\sc*8763”}, [and to overthrow]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8800”} it?\f + \fr 10:3 \ft Thinkest…: Heb. In thine eyes doth David \f* 
\v 4 \w Wherefore Hanun| strong="H2586" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [David’s]{strong=“H1732”} \w servants| strong="H5650" \w*, [and shaved off]{strong=“H1548” x-morph=“strongMorph: \sc Th\sc*8762”} \w the one half| strong="H2677" \w* \w of their beards| strong="H2206" \w*, [and cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} \w their garments| strong="H4063" \w* \w in the middle| strong="H2677" \w*, even \w to their buttocks| strong="H8357" \w*, [and sent them away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 5 [When they told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} it \w unto David| strong="H1732" \w*, [he sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} [to meet]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} [them, because the men]{strong=“H582”} \w were greatly| strong="H3966" \w* [ashamed]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8737”}: \w and the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Tarry]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8798”} \w at Jericho| strong="H3405" \w* \w until your beards| strong="H2206" \w* [be grown]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8762”}, and then [return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\p
\v 6 \w And when the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [that they stank]{strong=“H887” x-morph=“strongMorph: \sc Th\sc*8738”} \w before David| strong="H1732" \w*, \w the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} [and hired]{strong=“H7936” x-morph=“strongMorph: \sc Th\sc*8799”} \w the Syrians| strong="H758" \w* [of Beth-rehob]{strong=“H1050”}, \w and the Syrians| strong="H758" \w* \w of Zoba| strong="H6678" \w*, \w twenty| strong="H6242" \w* \w thousand| strong="H505" \w* \w footmen| strong="H7273" \w*, \w and of king| strong="H4428" \w* \w Maacah| strong="H4601" \w* \w a thousand| strong="H505" \w* \w men| strong="H376" \w*, [and of Ish-tob]{strong=“H382”} [twelve]{strong=“H8147 H6240”} \w thousand| strong="H505" \w* \w men| strong="H376" \w*.\f + \fr 10:6 \ft Ish-tob: or, the men of Tob \f* 
