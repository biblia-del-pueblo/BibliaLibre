\v 24 [And the shooters]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8688”} [shot]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”} \w from off the wall| strong="H2346" \w* \w upon thy servants| strong="H5650" \w*; and some [of the king’s]{strong=“H4428”} \w servants| strong="H5650" \w* [be dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and thy servant| strong="H5650" \w* \w Uriah| strong="H223" \w* \w the Hittite| strong="H2850" \w* [is dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”} also. 
\v 25 \w Then David| strong="H1732" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the messenger| strong="H4397" \w*, [Thus shalt thou say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Joab| strong="H3097" \w*, \w Let not this thing| strong="H1697" \w* [displease]{strong=“H5869 H3415” x-morph=“strongMorph: \sc Th\sc*8799”} [thee, for the sword]{strong=“H2719”} [devoureth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w one as well as another| strong="H2090" \w*: \w make thy battle| strong="H4421" \w* [more strong]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8685”} \w against the city| strong="H5892" \w*, [and overthrow]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8798”} [it: and encourage]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8761”} thou him.\f + \fr 11:25 \ft displease…: Heb. be evil in thine eyes \f* \f + \fr 11:25 \ft one…: Heb. so and such \f* 
\p
