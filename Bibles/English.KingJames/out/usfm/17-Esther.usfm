\v 11 \w And the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Haman| strong="H2001" \w*, \w The silver| strong="H3701" \w* is [given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8803”} [to thee, the people]{strong=“H5971”} [also, to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w with them as it seemeth| strong="H5869" \w* \w good| strong="H2896" \w* to thee. 
\v 12 [Then were the king’s]{strong=“H4428”} [scribes ]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8802”} [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8735”} [on the thirteenth]{strong=“H6240 H7969”} \w day| strong="H3117" \w* \w of the first| strong="H7223" \w* \w month| strong="H2320" \w*, [and there was written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8735”} \w according to all that Haman| strong="H2001" \w* [had commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [unto the king’s]{strong=“H4428”} \w lieutenants| strong="H323" \w*, \w and to the governors| strong="H6346" \w* that were \w over every province| strong="H4082" \w*, \w and to the rulers| strong="H8269" \w* \w of every people| strong="H5971" \w* \w of every province| strong="H4082" \w* \w according to the writing| strong="H3791" \w* thereof, and to \w every people| strong="H5971" \w* \w after their language| strong="H3956" \w*; \w in the name| strong="H8034" \w* \w of king| strong="H4428" \w* \w Ahasuerus| strong="H325" \w* [was it written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8737”}, [and sealed]{strong=“H2856” x-morph=“strongMorph: \sc Th\sc*8738”} [with the king’s]{strong=“H4428”} \w ring| strong="H2885" \w*.\f + \fr 3:12 \ft scribes: or, secretaries \f* 
\v 13 \w And the letters| strong="H5612" \w* [were sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8736”} \w by| strong="H3027" \w* [posts]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8801”} [into all the king’s]{strong=“H4428”} \w provinces| strong="H4082" \w*, [to destroy]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8687”}, [to kill]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8800”}, [and to cause to perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8763”}, \w all Jews| strong="H3064" \w*, \w both young| strong="H5288" \w* \w and old| strong="H2205" \w*, \w little children| strong="H2945" \w* \w and women| strong="H802" \w*, \w in one| strong="H259" \w* \w day| strong="H3117" \w*, even [upon the thirteenth]{strong=“H6240 H7969”} day [of the twelfth]{strong=“H6240 H8147”} \w month| strong="H2320" \w*, \w which is the month| strong="H2320" \w* \w Adar| strong="H143" \w*, and to take \w the spoil| strong="H7998" \w* [of them for a prey]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 14 \w The copy| strong="H6572" \w* \w of the writing| strong="H3791" \w* \w for a commandment| strong="H1881" \w* [to be given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8736”} \w in every province| strong="H4082" \w* [was published]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8803”} \w unto all people| strong="H5971" \w*, \w that they should be ready| strong="H6264" \w* \w against that day| strong="H3117" \w*. 
\v 15 [The posts]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8801”} [went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”}, [being hastened]{strong=“H1765” x-morph=“strongMorph: \sc Th\sc*8803”} [by the king’s]{strong=“H4428”} \w commandment| strong="H1697" \w*, \w and the decree| strong="H1881" \w* [was given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w in Shushan| strong="H7800" \w* \w the palace| strong="H1002" \w*. \w And the king| strong="H4428" \w* \w and Haman| strong="H2001" \w* [sat down]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} [to drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”}; \w but the city| strong="H5892" \w* \w Shushan| strong="H7800" \w* [was perplexed]{strong=“H943” x-morph=“strongMorph: \sc Th\sc*8737”}.
\c 4
\p 
\v 1 \w When Mordecai| strong="H4782" \w* [perceived]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [all that was done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8738”}, \w Mordecai| strong="H4782" \w* [rent]{strong=“H7167” x-morph=“strongMorph: \sc Th\sc*8799”} \w his clothes| strong="H899" \w*, [and put on]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w sackcloth| strong="H8242" \w* \w with ashes| strong="H665" \w*, [and went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the midst| strong="H8432" \w* \w of the city| strong="H5892" \w*, [and cried]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8799”} \w with a loud| strong="H1419" \w* \w and a bitter| strong="H4751" \w* \w cry| strong="H2201" \w*; 
\v 2 [And came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w even before| strong="H6440" \w* [the king’s]{strong=“H4428”} \w gate| strong="H8179" \w*: for none might [enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [into the king’s]{strong=“H4428”} \w gate| strong="H8179" \w* \w clothed| strong="H3830" \w* \w with sackcloth| strong="H8242" \w*. 
\v 3 \w And in every province| strong="H4082" \w*, \w whithersoever| strong="H4725" \w* [the king’s]{strong=“H4428”} \w commandment| strong="H1697" \w* \w and his decree| strong="H1881" \w* [came]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8688”}, there was \w great| strong="H1419" \w* \w mourning| strong="H60" \w* \w among the Jews| strong="H3064" \w*, \w and fasting| strong="H6685" \w*, \w and weeping| strong="H1065" \w*, \w and wailing| strong="H4553" \w*; \w and many| strong="H7227" \w* [lay]{strong=“H3331” x-morph=“strongMorph: \sc Th\sc*8714”} \w in sackcloth| strong="H8242" \w* \w and ashes| strong="H665" \w*.\f + \fr 4:3 \ft many…: Heb. sackcloth and ashes were laid under many \f* 
\p
\v 4 [So Esther’s]{strong=“H635”} \w maids| strong="H5291" \w* \w and her chamberlains| strong="H5631" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} it [her. Then was the queen]{strong=“H4436”} \w exceedingly| strong="H3966" \w* [grieved]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8698”}; [and she sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w raiment| strong="H899" \w* [to clothe]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8687”} \w Mordecai| strong="H4782" \w*, [and to take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8687”} \w his sackcloth| strong="H8242" \w* [from him: but he received]{strong=“H6901” x-morph=“strongMorph: \sc Th\sc*8765”} it not.\f + \fr 4:4 \ft chamberlains: Heb. eunuchs \f* 
\p
\v 5 [Then called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w Esther| strong="H635" \w* \w for Hatach| strong="H2047" \w*, one [of the king’s]{strong=“H4428”} \w chamberlains| strong="H5631" \w*, [whom he had appointed]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8689”} \w to attend| strong="H6440" \w* [upon her, and gave him a commandment]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} \w to Mordecai| strong="H4782" \w*, [to know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} what it was, and why it was.\f + \fr 4:5 \ft appointed…: Heb. set before her \f* 
\v 6 \w So Hatach| strong="H2047" \w* [went forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Mordecai| strong="H4782" \w* \w unto the street| strong="H7339" \w* \w of the city| strong="H5892" \w*, which was \w before| strong="H6440" \w* [the king’s]{strong=“H4428”} \w gate| strong="H8179" \w*. 
\v 7 \w And Mordecai| strong="H4782" \w* [told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} [him of all that had happened]{strong=“H7136” x-morph=“strongMorph: \sc Th\sc*8804”} [unto him, and of the sum]{strong=“H6575”} \w of the money| strong="H3701" \w* \w that Haman| strong="H2001" \w* [had promised]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [to pay]{strong=“H8254” x-morph=“strongMorph: \sc Th\sc*8800”} [to the king’s]{strong=“H4428”} \w treasuries| strong="H1595" \w* \w for the Jews| strong="H3064" \w*, [to destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8763”} them. 
\v 8 [Also he gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w him the copy| strong="H6572" \w* \w of the writing| strong="H3791" \w* \w of the decree| strong="H1881" \w* [that was given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w at Shushan| strong="H7800" \w* [to destroy]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8687”} [them, to shew]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8687”} it \w unto Esther| strong="H635" \w*, [and to declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8687”} it [unto her, and to charge]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8763”} [her that she should go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto the king| strong="H4428" \w*, [to make supplication]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8692”} [unto him, and to make request]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8763”} \w before| strong="H6440" \w* \w him for her people| strong="H5971" \w*. 
\v 9 \w And Hatach| strong="H2047" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w Esther| strong="H635" \w* \w the words| strong="H1697" \w* \w of Mordecai| strong="H4782" \w*. 
\p
\v 10 \w Again Esther| strong="H635" \w* [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Hatach| strong="H2047" \w*, [and gave him commandment]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Mordecai| strong="H4782" \w*; 
\v 11 [All the king’s]{strong=“H4428”} \w servants| strong="H5650" \w*, \w and the people| strong="H5971" \w* [of the king’s]{strong=“H4428”} \w provinces| strong="H4082" \w*, [do know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”}, [that whosoever, whether man]{strong=“H376”} \w or woman| strong="H802" \w*, [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the king| strong="H4428" \w* \w into the inner| strong="H6442" \w* \w court| strong="H2691" \w*, [who is not called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8735”}, there is \w one| strong="H259" \w* \w law| strong="H1881" \w* of his to put him [to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8687”}, \w except| strong="H905" \w* \w such to whom the king| strong="H4428" \w* [shall hold out]{strong=“H3447” x-morph=“strongMorph: \sc Th\sc*8686”} \w the golden| strong="H2091" \w* \w sceptre| strong="H8275" \w*, [that he may live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8804”}: [but I have not been called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8738”} [to come in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto the king| strong="H4428" \w* \w these thirty| strong="H7970" \w* \w days| strong="H3117" \w*. 
\v 12 [And they told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w to Mordecai| strong="H4782" \w* [Esther’s]{strong=“H635”} \w words| strong="H1697" \w*. 
\v 13 \w Then Mordecai| strong="H4782" \w* [commanded]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [to answer]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} \w Esther| strong="H635" \w*, [Think]{strong=“H1819” x-morph=“strongMorph: \sc Th\sc*8762”} \w not with thyself| strong="H5315" \w* [that thou shalt escape]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8736”} [in the king’s]{strong=“H4428”} \w house| strong="H1004" \w*, \w more than all the Jews| strong="H3064" \w*. 
\v 14 [For if thou altogether]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8687”} [holdest thy peace]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8686”} \w at this time| strong="H6256" \w*, then \w shall there enlargement| strong="H7305" \w* \w and deliverance| strong="H2020" \w* [arise]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the Jews| strong="H3064" \w* \w from another| strong="H312" \w* \w place| strong="H4725" \w*; [but thou and thy father’s]{strong=“H1”} \w house| strong="H1004" \w* [shall be destroyed]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}: [and who knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} [whether thou art come]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8689”} \w to the kingdom| strong="H4438" \w* for such \w a time| strong="H6256" \w* as this?\f + \fr 4:14 \ft enlargement: Heb. respiration \f* 
\p
\v 15 \w Then Esther| strong="H635" \w* [bade]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} them [return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} \w Mordecai| strong="H4782" \w* this answer, 
\v 16 [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [gather together]{strong=“H3664” x-morph=“strongMorph: \sc Th\sc*8798”} \w all the Jews| strong="H3064" \w* [that are present]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8737”} \w in Shushan| strong="H7800" \w*, [and fast]{strong=“H6684” x-morph=“strongMorph: \sc Th\sc*8798”} [ye for me, and neither eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [nor drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w three| strong="H7969" \w* \w days| strong="H3117" \w*, \w night| strong="H3915" \w* \w or day| strong="H3117" \w*: \w I also and my maidens| strong="H5291" \w* [will fast]{strong=“H6684” x-morph=“strongMorph: \sc Th\sc*8799”} [likewise; and so]{strong=“H3651”} [will I go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w in unto the king| strong="H4428" \w*, which is \w not according to the law| strong="H1881" \w*: [and if I perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”}, [I perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 4:16 \ft present: Heb. found \f* 
\v 17 \w So Mordecai| strong="H4782" \w* [went his way]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}, [and did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w according to all that Esther| strong="H635" \w* [had commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} him.\f + \fr 4:17 \ft went…: Heb. passed \f*
\c 5
\p 
\v 1 \w Now it came to pass on the third| strong="H7992" \w* \w day| strong="H3117" \w*, \w that Esther| strong="H635" \w* [put on]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} her \w royal| strong="H4438" \w* apparel, [and stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the inner| strong="H6442" \w* \w court| strong="H2691" \w* [of the king’s]{strong=“H4428”} \w house| strong="H1004" \w*, \w over against| strong="H5227" \w* [the king’s]{strong=“H4428”} \w house| strong="H1004" \w*: \w and the king| strong="H4428" \w* [sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon his royal| strong="H4438" \w* \w throne| strong="H3678" \w* \w in the royal| strong="H4438" \w* \w house| strong="H1004" \w*, \w over against| strong="H5227" \w* \w the gate| strong="H6607" \w* \w of the house| strong="H1004" \w*. 
\v 2 [And it was so, when the king]{strong=“H4428”} [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w Esther| strong="H635" \w* \w the queen| strong="H4436" \w* [standing]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the court| strong="H2691" \w*, that [she obtained]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w favour| strong="H2580" \w* \w in his sight| strong="H5869" \w*: \w and the king| strong="H4428" \w* [held out]{strong=“H3447” x-morph=“strongMorph: \sc Th\sc*8686”} \w to Esther| strong="H635" \w* \w the golden| strong="H2091" \w* \w sceptre| strong="H8275" \w* that was \w in his hand| strong="H3027" \w*. \w So Esther| strong="H635" \w* [drew near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”}, [and touched]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8799”} \w the top| strong="H7218" \w* \w of the sceptre| strong="H8275" \w*. 
\v 3 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w the king| strong="H4428" \w* [unto her, What wilt thou, queen]{strong=“H4436”} \w Esther| strong="H635" \w*? and what is \w thy request| strong="H1246" \w*? [it shall be even given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8735”} \w thee to the half| strong="H2677" \w* \w of the kingdom| strong="H4438" \w*. 
\v 4 \w And Esther| strong="H635" \w* [answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, If it seem [good]{strong=“H2895” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the king| strong="H4428" \w*, \w let the king| strong="H4428" \w* \w and Haman| strong="H2001" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w this day| strong="H3117" \w* \w unto the banquet| strong="H4960" \w* [that I have prepared]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} for him. 
\v 5 \w Then the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Cause Haman| strong="H2001" \w* [to make haste]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8761”}, [that he may do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w as Esther| strong="H635" \w* \w hath said| strong="H1697" \w*. \w So the king| strong="H4428" \w* \w and Haman| strong="H2001" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the banquet| strong="H4960" \w* \w that Esther| strong="H635" \w* [had prepared]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\p
\v 6 \w And the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Esther| strong="H635" \w* \w at the banquet| strong="H4960" \w* \w of wine| strong="H3196" \w*, What is \w thy petition| strong="H7596" \w*? [and it shall be granted]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8735”} thee: and what is \w thy request| strong="H1246" \w*? \w even to the half| strong="H2677" \w* \w of the kingdom| strong="H4438" \w* [it shall be performed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 7 [Then answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w Esther| strong="H635" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w My petition| strong="H7596" \w* \w and my request| strong="H1246" \w* is; 
\v 8 [If I have found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w favour| strong="H2580" \w* \w in the sight| strong="H5869" \w* \w of the king| strong="H4428" \w*, [and if it please]{strong=“H2895” x-morph=“strongMorph: \sc Th\sc*8804”} \w the king| strong="H4428" \w* [to grant]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w my petition| strong="H7596" \w*, [and to perform]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w my request| strong="H1246" \w*, \w let the king| strong="H4428" \w* \w and Haman| strong="H2001" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the banquet| strong="H4960" \w* [that I shall prepare]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [for them, and I will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w to morrow| strong="H4279" \w* \w as the king| strong="H4428" \w* \w hath said| strong="H1697" \w*.\f + \fr 5:8 \ft perform: Heb. do \f* 
\p
\v 9 \w Then went| strong="H3318" \w* \w Haman| strong="H2001" \w* [forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w that day| strong="H3117" \w* \w joyful| strong="H8056" \w* \w and with a glad| strong="H2896" \w* \w heart| strong="H3820" \w*: \w but when Haman| strong="H2001" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w Mordecai| strong="H4782" \w* [in the king’s]{strong=“H4428”} \w gate| strong="H8179" \w*, [that he stood not up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”}, [nor moved]{strong=“H2111” x-morph=“strongMorph: \sc Th\sc*8804”} [for him, he]{strong=“H2001”} [was full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”} \w of indignation| strong="H2534" \w* \w against Mordecai| strong="H4782" \w*. 
\v 10 \w Nevertheless Haman| strong="H2001" \w* [refrained]{strong=“H662” x-morph=“strongMorph: \sc Th\sc*8691”} [himself: and when he came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w home| strong="H1004" \w*, [he sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} [and called]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} [for his friends]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and Zeresh| strong="H2238" \w* \w his wife| strong="H802" \w*.\f + \fr 5:10 \ft called…: Heb. caused to come \f* 
\v 11 \w And Haman| strong="H2001" \w* [told]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} \w them of the glory| strong="H3519" \w* \w of his riches| strong="H6239" \w*, \w and the multitude| strong="H7230" \w* \w of his children| strong="H1121" \w*, and all the things \w wherein the king| strong="H4428" \w* [had promoted]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8765”} [him, and how he had advanced]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8765”} \w him above the princes| strong="H8269" \w* \w and servants| strong="H5650" \w* \w of the king| strong="H4428" \w*. 
\v 12 \w Haman| strong="H2001" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [moreover, Yea, Esther]{strong=“H635”} \w the queen| strong="H4436" \w* [did let no man come in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w with the king| strong="H4428" \w* \w unto the banquet| strong="H4960" \w* [that she had prepared]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [but myself; and to morrow]{strong=“H4279”} [am I invited]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8803”} \w unto her also with the king| strong="H4428" \w*. 
\v 13 [Yet all this availeth]{strong=“H7737” x-morph=“strongMorph: \sc Th\sc*8802”} [me nothing, so long as]{strong=“H6256”} [I see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} \w Mordecai| strong="H4782" \w* \w the Jew| strong="H3064" \w* [sitting]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} [at the king’s]{strong=“H4428”} \w gate| strong="H8179" \w*. 
\p
\v 14 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Zeresh| strong="H2238" \w* \w his wife| strong="H802" \w* [and all his friends]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} [unto him, Let a gallows]{strong=“H6086”} [be made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w of fifty| strong="H2572" \w* \w cubits| strong="H520" \w* \w high| strong="H1364" \w*, \w and to morrow| strong="H1242" \w* [speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou unto the king| strong="H4428" \w* \w that Mordecai| strong="H4782" \w* [may be hanged]{strong=“H8518” x-morph=“strongMorph: \sc Th\sc*8799”} [thereon: then go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou in merrily| strong="H8056" \w* \w with the king| strong="H4428" \w* \w unto the banquet| strong="H4960" \w*. \w And the thing| strong="H1697" \w* [pleased]{strong=“H6440 H3190” x-morph=“strongMorph: \sc Th\sc*8799”} \w Haman| strong="H2001" \w*; \w and he caused| strong="H6213" \w* \w the gallows| strong="H6086" \w* [to be made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 5:14 \ft gallows: Heb. tree \f*
\c 6
\p 
\v 1 \w On that night| strong="H3915" \w* [could not]{strong=“H5074” x-morph=“strongMorph: \sc Th\sc*8804”} \w the king| strong="H4428" \w* \w sleep| strong="H8142" \w*, [and he commanded]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [to bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} \w the book| strong="H5612" \w* \w of records| strong="H2146" \w* [of the chronicles]{strong=“H3117 H1697”}; [and they were read]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8737”} \w before| strong="H6440" \w* \w the king| strong="H4428" \w*.\f + \fr 6:1 \ft could…: Heb. the king’s sleep fled away \f* 
\v 2 [And it was found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”} [written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8803”}, \w that Mordecai| strong="H4782" \w* [had told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} \w of Bigthana| strong="H904" \w* \w and Teresh| strong="H8657" \w*, \w two| strong="H8147" \w* [of the king’s]{strong=“H4428”} \w chamberlains| strong="H5631" \w*, [the keepers]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the door| strong="H5592" \w*, [who sought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8765”} [to lay]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8800”} \w hand| strong="H3027" \w* \w on the king| strong="H4428" \w* \w Ahasuerus| strong="H325" \w*.\f + \fr 6:2 \ft Bigthana: also called, Bigthan \f* \f + \fr 6:2 \ft door: Heb. threshold \f* 
\v 3 \w And the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w What honour| strong="H3366" \w* \w and dignity| strong="H1420" \w* [hath been done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8738”} \w to Mordecai| strong="H4782" \w* [for this? Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [the king’s]{strong=“H4428”} \w servants| strong="H5288" \w* [that ministered]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8764”} [unto him, There is nothing]{strong=“H1697”} [done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8738”} for him. 
\p
\v 4 \w And the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Who is \w in the court| strong="H2691" \w*? \w Now Haman| strong="H2001" \w* [was come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the outward| strong="H2435" \w* \w court| strong="H2691" \w* [of the king’s]{strong=“H4428”} \w house| strong="H1004" \w*, [to speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto the king| strong="H4428" \w* [to hang]{strong=“H8518” x-morph=“strongMorph: \sc Th\sc*8800”} \w Mordecai| strong="H4782" \w* \w on the gallows| strong="H6086" \w* [that he had prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8689”} for him. 
\v 5 [And the king’s]{strong=“H4428”} \w servants| strong="H5288" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Behold, Haman]{strong=“H2001”} [standeth]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the court| strong="H2691" \w*. \w And the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Let him come in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 6 \w So Haman| strong="H2001" \w* [came in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}. \w And the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, What shall be done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto the man| strong="H376" \w* \w whom the king| strong="H4428" \w* [delighteth]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} \w to honour| strong="H3366" \w*? \w Now Haman| strong="H2001" \w* [thought]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his heart| strong="H3820" \w*, \w To whom would the king| strong="H4428" \w* [delight]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8799”} [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w honour| strong="H3366" \w* \w more| strong="H3148" \w* than to myself?\f + \fr 6:6 \ft whom the king…: Heb. in whose honour the king delighteth \f* 
\v 7 \w And Haman| strong="H2001" \w* [answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w the king| strong="H4428" \w*, \w For the man| strong="H376" \w* \w whom the king| strong="H4428" \w* [delighteth ]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} \w to honour| strong="H3366" \w*,\f + \fr 6:7 \ft whom the king…: Heb. in whose honour the king delighteth \f* 
\v 8 \w Let the royal| strong="H4438" \w* \w apparel| strong="H3830" \w* [be brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w which the king| strong="H4428" \w* useth [to wear]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and the horse| strong="H5483" \w* \w that the king| strong="H4428" \w* [rideth]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8804”} [upon, and the crown]{strong=“H3804”} \w royal| strong="H4438" \w* [which is set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w upon his head| strong="H7218" \w*:\f + \fr 6:8 \ft Let…: Heb. Let them bring the royal apparel \f* \f + \fr 6:8 \ft which the king…: Heb. wherewith the king clotheth himself \f* 
\v 9 \w And let this apparel| strong="H3830" \w* \w and horse| strong="H5483" \w* [be delivered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w to the hand| strong="H3027" \w* \w of one| strong="H376" \w* [of the king’s]{strong=“H4428”} \w most noble| strong="H6579" \w* \w princes| strong="H8269" \w*, [that they may array]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8689”} \w the man| strong="H376" \w* withal \w whom the king| strong="H4428" \w* [delighteth]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} \w to honour| strong="H3366" \w*, [and bring]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8689”} \w him on horseback| strong="H5483" \w* \w through the street| strong="H7339" \w* \w of the city| strong="H5892" \w*, [and proclaim]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* [him, Thus shall it be done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8735”} \w to the man| strong="H376" \w* \w whom the king| strong="H4428" \w* [delighteth]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} \w to honour| strong="H3366" \w*.\f + \fr 6:9 \ft bring…: Heb. cause him to ride \f* 
\v 10 \w Then the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Haman| strong="H2001" \w*, [Make haste]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8761”}, and [take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w the apparel| strong="H3830" \w* \w and the horse| strong="H5483" \w*, [as thou hast said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} \w even so to Mordecai| strong="H4782" \w* \w the Jew| strong="H3064" \w*, [that sitteth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} [at the king’s]{strong=“H4428”} \w gate| strong="H8179" \w*: \w let nothing| strong="H1697" \w* [fail]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8686”} [of all that thou hast spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}.\f + \fr 6:10 \ft let…: Heb. suffer not a whit to fall \f* 
\v 11 [Then took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w Haman| strong="H2001" \w* \w the apparel| strong="H3830" \w* \w and the horse| strong="H5483" \w*, [and arrayed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8686”} \w Mordecai| strong="H4782" \w*, [and brought him on horseback]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8686”} \w through the street| strong="H7339" \w* \w of the city| strong="H5892" \w*, [and proclaimed]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* [him, Thus shall it be done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8735”} \w unto the man| strong="H376" \w* \w whom the king| strong="H4428" \w* [delighteth ]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} \w to honour| strong="H3366" \w*. 
\p
\v 12 \w And Mordecai| strong="H4782" \w* [came again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [to the king’s]{strong=“H4428”} \w gate| strong="H8179" \w*. \w But Haman| strong="H2001" \w* [hasted]{strong=“H1765” x-morph=“strongMorph: \sc Th\sc*8738”} \w to his house| strong="H1004" \w* \w mourning| strong="H57" \w*, \w and having his head| strong="H7218" \w* [covered]{strong=“H2645” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 13 \w And Haman| strong="H2001" \w* [told]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} \w Zeresh| strong="H2238" \w* \w his wife| strong="H802" \w* [and all his friends]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} every thing [that had befallen]{strong=“H7136” x-morph=“strongMorph: \sc Th\sc*8804”} [him. Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w his wise men| strong="H2450" \w* \w and Zeresh| strong="H2238" \w* \w his wife| strong="H802" \w* [unto him, If Mordecai]{strong=“H4782”} be \w of the seed| strong="H2233" \w* \w of the Jews| strong="H3064" \w*, \w before| strong="H6440" \w* [whom thou hast begun]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8689”} [to fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8800”}, [thou shalt not prevail]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [against him, but shalt surely]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8800”} [fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* him. 
\v 14 And while they were [yet talking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8764”} [with him, came]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8689”} [the king’s]{strong=“H4428”} \w chamberlains| strong="H5631" \w*, [and hasted]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8686”} [to bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} \w Haman| strong="H2001" \w* \w unto the banquet| strong="H4960" \w* \w that Esther| strong="H635" \w* [had prepared]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\c 7
\p 
\v 1 \w So the king| strong="H4428" \w* \w and Haman| strong="H2001" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [to banquet]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”} \w with Esther| strong="H635" \w* \w the queen| strong="H4436" \w*.\f + \fr 7:1 \ft to banquet: Heb. to drink \f* 
\v 2 \w And the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w again unto Esther| strong="H635" \w* \w on the second| strong="H8145" \w* \w day| strong="H3117" \w* \w at the banquet| strong="H4960" \w* \w of wine| strong="H3196" \w*, What is \w thy petition| strong="H7596" \w*, \w queen| strong="H4436" \w* \w Esther| strong="H635" \w*? [and it shall be granted]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8735”} thee: and what is \w thy request| strong="H1246" \w*? [and it shall be performed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8735”}, even \w to the half| strong="H2677" \w* \w of the kingdom| strong="H4438" \w*. 
\v 3 \w Then Esther| strong="H635" \w* \w the queen| strong="H4436" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [If I have found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w favour| strong="H2580" \w* \w in thy sight| strong="H5869" \w*, \w O king| strong="H4428" \w*, [and if it please]{strong=“H2895” x-morph=“strongMorph: \sc Th\sc*8804”} \w the king| strong="H4428" \w*, \w let my life| strong="H5315" \w* [be given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8735”} \w me at my petition| strong="H7596" \w*, \w and my people| strong="H5971" \w* \w at my request| strong="H1246" \w*: 
\v 4 [For we are sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8738”}, \w I and my people| strong="H5971" \w*, [to be destroyed]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8687”}, [to be slain]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8800”}, [and to perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8763”}. \w But if| strong="H432" \w* [we had been sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8738”} \w for bondmen| strong="H5650" \w* \w and bondwomen| strong="H8198" \w*, [I had held my tongue]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8689”}, \w although the enemy| strong="H6862" \w* [could not countervail]{strong=“H7737” x-morph=“strongMorph: \sc Th\sc*8802”} [the king’s]{strong=“H4428”} \w damage| strong="H5143" \w*.\f + \fr 7:4 \ft to be destroyed…: Heb. that they should destroy, and kill, and cause to perish \f* 
\p
