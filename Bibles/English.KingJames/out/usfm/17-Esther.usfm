\p 
\v 1 \w And the king| strong="H4428" \w* \w Ahasuerus| strong="H325" \w* [laid]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w a tribute| strong="H4522" \w* \w upon the land| strong="H776" \w*, and upon \w the isles| strong="H339" \w* \w of the sea| strong="H3220" \w*. 
\v 2 \w And all the acts| strong="H4639" \w* \w of his power| strong="H8633" \w* \w and of his might| strong="H1369" \w*, \w and the declaration| strong="H6575" \w* \w of the greatness| strong="H1420" \w* \w of Mordecai| strong="H4782" \w*, \w whereunto the king| strong="H4428" \w* [advanced]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8765”} him, are [they not written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8803”} \w in the book| strong="H5612" \w* [of the chronicles]{strong=“H3117 H1697”} \w of the kings| strong="H4428" \w* \w of Media| strong="H4074" \w* \w and Persia| strong="H6539" \w*?\f + \fr 10:2 \ft advanced…: Heb. made him great \f* 
\v 3 \w For Mordecai| strong="H4782" \w* \w the Jew| strong="H3064" \w* was \w next| strong="H4932" \w* \w unto king| strong="H4428" \w* \w Ahasuerus| strong="H325" \w*, \w and great| strong="H1419" \w* \w among the Jews| strong="H3064" \w*, [and accepted]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8803”} \w of the multitude| strong="H7230" \w* \w of his brethren| strong="H251" \w*, [seeking]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8802”} \w the wealth| strong="H2896" \w* \w of his people| strong="H5971" \w*, [and speaking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} \w peace| strong="H7965" \w* \w to all his seed| strong="H2233" \w*. 
