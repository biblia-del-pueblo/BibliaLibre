\c 9
\p 
\v 1 [Now in the twelfth]{strong=“H6240 H8147”} \w month| strong="H2320" \w*, that is, \w the month| strong="H2320" \w* \w Adar| strong="H143" \w*, [on the thirteenth]{strong=“H6240 H7969”} \w day| strong="H3117" \w* [of the same, when the king’s]{strong=“H4428”} \w commandment| strong="H1697" \w* \w and his decree| strong="H1881" \w* [drew near]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8689”} [to be put in execution]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8736”}, \w in the day| strong="H3117" \w* [that the enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the Jews| strong="H3064" \w* [hoped]{strong=“H7663” x-morph=“strongMorph: \sc Th\sc*8765”} [to have power]{strong=“H7980” x-morph=“strongMorph: \sc Th\sc*8800”} [over them, (though it was turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8736”} [to the contrary, that the Jews]{strong=“H3064”} [had rule]{strong=“H7980” x-morph=“strongMorph: \sc Th\sc*8799”} [over them that hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} them;) 
