\c 1
\p 
\v 1 \w Now it came to pass in the days| strong="H3117" \w* \w of Ahasuerus| strong="H325" \w*, (this is \w Ahasuerus| strong="H325" \w* [which reigned]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8802”}, \w from India| strong="H1912" \w* \w even unto Ethiopia| strong="H3568" \w*, over \w an hundred| strong="H3967" \w* \w and seven| strong="H7651" \w* \w and twenty| strong="H6242" \w* \w provinces| strong="H4082" \w*:) 
\v 2 That \w in those days| strong="H3117" \w*, \w when the king| strong="H4428" \w* \w Ahasuerus| strong="H325" \w* [sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} \w on the throne| strong="H3678" \w* \w of his kingdom| strong="H4438" \w*, which was \w in Shushan| strong="H7800" \w* \w the palace| strong="H1002" \w*, 
\v 3 \w In the third| strong="H7969" \w* \w year| strong="H8141" \w* [of his reign]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8800”}, [he made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w a feast| strong="H4960" \w* \w unto all his princes| strong="H8269" \w* \w and his servants| strong="H5650" \w*; \w the power| strong="H2428" \w* \w of Persia| strong="H6539" \w* \w and Media| strong="H4074" \w*, \w the nobles| strong="H6579" \w* \w and princes| strong="H8269" \w* \w of the provinces| strong="H4082" \w*, being \w before| strong="H6440" \w* him: 
\v 4 [When he shewed]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8687”} \w the riches| strong="H6239" \w* \w of his glorious| strong="H3519" \w* \w kingdom| strong="H4438" \w* \w and the honour| strong="H3366" \w* \w of his excellent| strong="H8597" \w* \w majesty| strong="H1420" \w* \w many| strong="H7227" \w* \w days| strong="H3117" \w*, even \w an hundred| strong="H3967" \w* \w and fourscore| strong="H8084" \w* \w days| strong="H3117" \w*. 
\v 5 \w And when these days| strong="H3117" \w* [were expired]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8800”}, \w the king| strong="H4428" \w* [made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w a feast| strong="H4960" \w* \w unto all the people| strong="H5971" \w* [that were present]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8737”} \w in Shushan| strong="H7800" \w* \w the palace| strong="H1002" \w*, \w both unto great| strong="H1419" \w* \w and small| strong="H6996" \w*, \w seven| strong="H7651" \w* \w days| strong="H3117" \w*, \w in the court| strong="H2691" \w* \w of the garden| strong="H1594" \w* [of the king’s]{strong=“H4428”} \w palace| strong="H1055" \w*;\f + \fr 1:5 \ft present: Heb. found \f* 
\v 6 Where were \w white| strong="H2353" \w*, \w green| strong="H3768" \w*, \w and blue| strong="H8504" \w*, hangings, [fastened]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8803”} \w with cords| strong="H2256" \w* \w of fine linen| strong="H948" \w* \w and purple| strong="H713" \w* \w to silver| strong="H3701" \w* \w rings| strong="H1550" \w* \w and pillars| strong="H5982" \w* \w of marble| strong="H8336" \w*: \w the beds| strong="H4296" \w* were of \w gold| strong="H2091" \w* \w and silver| strong="H3701" \w*, \w upon a pavement| strong="H7531" \w* \w of red| strong="H923" \w*, \w and blue| strong="H8504" \w*, \w and white| strong="H1858" \w*, \w and black| strong="H5508" \w*, \w marble| strong="H8336" \w*.\f + \fr 1:6 \ft blue, hangings: or, violet, etc \f* \f + \fr 1:6 \ft of red…: or, of porphyre, and marble and alabaster, and stone of blue colour \f* 
\v 7 And they gave them [drink]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8687”} \w in vessels| strong="H3627" \w* \w of gold| strong="H2091" \w*, (\w the vessels| strong="H3627" \w* [being diverse]{strong=“H8138” x-morph=“strongMorph: \sc Th\sc*8802”} \w one from another| strong="H3627" \w*,) \w and royal| strong="H4438" \w* \w wine| strong="H3196" \w* \w in abundance| strong="H7227" \w*, \w according to the state| strong="H3027" \w* \w of the king| strong="H4428" \w*.\f + \fr 1:7 \ft royal…: Heb. wine of the kingdom \f* \f + \fr 1:7 \ft state: Heb. hand \f* 
\v 8 \w And the drinking| strong="H8360" \w* was \w according to the law| strong="H1881" \w*; [none did compel]{strong=“H597” x-morph=“strongMorph: \sc Th\sc*8802”}: \w for so the king| strong="H4428" \w* [had appointed]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8765”} \w to all the officers| strong="H7227" \w* \w of his house| strong="H1004" \w*, [that they should do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [according to every man’s]{strong=“H376”} \w pleasure| strong="H7522" \w*. 
\v 9 \w Also Vashti| strong="H2060" \w* \w the queen| strong="H4436" \w* [made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w a feast| strong="H4960" \w* \w for the women| strong="H802" \w* in \w the royal| strong="H4438" \w* \w house| strong="H1004" \w* which belonged \w to king| strong="H4428" \w* \w Ahasuerus| strong="H325" \w*. 
\p
\v 10 \w On the seventh| strong="H7637" \w* \w day| strong="H3117" \w*, \w when the heart| strong="H3820" \w* \w of the king| strong="H4428" \w* \w was merry| strong="H2896" \w* \w with wine| strong="H3196" \w*, [he commanded]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w Mehuman| strong="H4104" \w*, \w Biztha| strong="H968" \w*, \w Harbona| strong="H2726" \w*, \w Bigtha| strong="H903" \w*, \w and Abagtha| strong="H5" \w*, \w Zethar| strong="H2242" \w*, \w and Carcas| strong="H3752" \w*, \w the seven| strong="H7651" \w* \w chamberlains| strong="H5631" \w* [that served]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8764”} \w in the presence| strong="H6440" \w* \w of Ahasuerus| strong="H325" \w* \w the king| strong="H4428" \w*,\f + \fr 1:10 \ft chamberlains: or, eunuchs \f* 
\v 11 [To bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} \w Vashti| strong="H2060" \w* \w the queen| strong="H4436" \w* \w before| strong="H6440" \w* \w the king| strong="H4428" \w* \w with the crown| strong="H3804" \w* \w royal| strong="H4438" \w*, [to shew]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8687”} \w the people| strong="H5971" \w* \w and the princes| strong="H8269" \w* \w her beauty| strong="H3308" \w*: for she was \w fair| strong="H2896" \w* \w to look on| strong="H4758" \w*.\f + \fr 1:11 \ft fair…: Heb. good of countenance \f* 
\v 12 \w But the queen| strong="H4436" \w* \w Vashti| strong="H2060" \w* [refused]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8762”} [to come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [at the king’s]{strong=“H4428”} \w commandment| strong="H1697" \w* \w by| strong="H3027" \w* his \w chamberlains| strong="H5631" \w*: \w therefore was the king| strong="H4428" \w* \w very| strong="H3966" \w* [wroth]{strong=“H7107” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and his anger| strong="H2534" \w* [burned]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8804”} in him.\f + \fr 1:12 \ft by his…: Heb. which was by the hand of his eunuchs \f* 
\p
\v 13 \w Then the king| strong="H4428" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the wise men| strong="H2450" \w*, [which knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w the times| strong="H6256" \w*, (for so was [the king’s]{strong=“H4428”} \w manner| strong="H1697" \w* \w toward| strong="H6440" \w* [all that knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w law| strong="H1881" \w* \w and judgment| strong="H1779" \w*: 
\v 14 \w And the next| strong="H7138" \w* unto him was \w Carshena| strong="H3771" \w*, \w Shethar| strong="H8369" \w*, \w Admatha| strong="H133" \w*, \w Tarshish| strong="H8659" \w*, \w Meres| strong="H4825" \w*, \w Marsena| strong="H4826" \w*, and \w Memucan| strong="H4462" \w*, \w the seven| strong="H7651" \w* \w princes| strong="H8269" \w* \w of Persia| strong="H6539" \w* \w and Media| strong="H4074" \w*, [which saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} [the king’s]{strong=“H4428”} \w face| strong="H6440" \w*, and [which sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w the first| strong="H7223" \w* \w in the kingdom| strong="H4438" \w*;) 
\v 15 [What shall we do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto the queen| strong="H4436" \w* \w Vashti| strong="H2060" \w* \w according to law| strong="H1881" \w*, [because she hath not performed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w the commandment| strong="H3982" \w* \w of the king| strong="H4428" \w* \w Ahasuerus| strong="H325" \w* \w by| strong="H3027" \w* \w the chamberlains| strong="H5631" \w*?\f + \fr 1:15 \ft What…: Heb. What to do \f* 
\v 16 \w And Memucan| strong="H4462" \w* [answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* \w the king| strong="H4428" \w* \w and the princes| strong="H8269" \w*, \w Vashti| strong="H2060" \w* \w the queen| strong="H4436" \w* [hath not done wrong]{strong=“H5753” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the king| strong="H4428" \w* [only, but also to all the princes]{strong=“H8269”}, \w and to all the people| strong="H5971" \w* that are \w in all the provinces| strong="H4082" \w* \w of the king| strong="H4428" \w* \w Ahasuerus| strong="H325" \w*. 
\v 17 For this \w deed| strong="H1697" \w* \w of the queen| strong="H4436" \w* [shall come abroad]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto all women| strong="H802" \w*, [so that they shall despise]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8687”} \w their husbands| strong="H1167" \w* \w in their eyes| strong="H5869" \w*, [when it shall be reported]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w The king| strong="H4428" \w* \w Ahasuerus| strong="H325" \w* [commanded]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w Vashti| strong="H2060" \w* \w the queen| strong="H4436" \w* [to be brought in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} \w before| strong="H6440" \w* [him, but she came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} not. 
\v 18 Likewise \w shall the ladies| strong="H8282" \w* \w of Persia| strong="H6539" \w* \w and Media| strong="H4074" \w* [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w this day| strong="H3117" \w* [unto all the king’s]{strong=“H4428”} \w princes| strong="H8269" \w*, [which have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the deed| strong="H1697" \w* \w of the queen| strong="H4436" \w*. Thus shall there arise \w too much| strong="H1767" \w* \w contempt| strong="H963" \w* \w and wrath| strong="H7110" \w*. 
\v 19 [If it please]{strong=“H2895” x-morph=“strongMorph: \sc Th\sc*8804”} \w the king| strong="H4428" \w*, [let there go]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w a royal| strong="H4438" \w* \w commandment| strong="H1697" \w* \w from him| strong="H6440" \w*, [and let it be written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8735”} \w among the laws| strong="H1881" \w* \w of the Persians| strong="H6539" \w* \w and the Medes| strong="H4074" \w*, [that it be not altered]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}, \w That Vashti| strong="H2060" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w no more before| strong="H6440" \w* \w king| strong="H4428" \w* \w Ahasuerus| strong="H325" \w*; \w and let the king| strong="H4428" \w* [give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w her royal estate| strong="H4438" \w* \w unto another| strong="H7468" \w* \w that is better| strong="H2896" \w* than she.\f + \fr 1:19 \ft If it…: Heb. If it be good with the king \f* \f + \fr 1:19 \ft unto…: Heb. unto her companion \f* \f + \fr 1:19 \ft from him: Heb. from before him \f* \f + \fr 1:19 \ft be not…: Heb. pass not away \f* 
\v 20 [And when the king’s]{strong=“H4428”} \w decree| strong="H6599" \w* [which he shall make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [shall be published]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8738”} \w throughout all his empire| strong="H4438" \w*, (\w for it is great| strong="H7227" \w*,) \w all the wives| strong="H802" \w* [shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w to their husbands| strong="H1167" \w* \w honour| strong="H3366" \w*, \w both to great| strong="H1419" \w* \w and small| strong="H6996" \w*. 
\v 21 \w And the saying| strong="H1697" \w* [pleased ]{strong=“H5869 H3190” x-morph=“strongMorph: \sc Th\sc*8799”} \w the king| strong="H4428" \w* \w and the princes| strong="H8269" \w*; \w and the king| strong="H4428" \w* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w according to the word| strong="H1697" \w* \w of Memucan| strong="H4462" \w*:\f + \fr 1:21 \ft pleased…: Heb. was good in the eyes of the king \f* 
\v 22 [For he sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w letters| strong="H5612" \w* [into all the king’s]{strong=“H4428”} \w provinces| strong="H4082" \w*, \w into every province| strong="H4082" \w* \w according to the writing| strong="H3791" \w* [thereof, and to every people]{strong=“H5971”} \w after their language| strong="H3956" \w*, \w that every man| strong="H376" \w* [should bear rule]{strong=“H8323” x-morph=“strongMorph: \sc Th\sc*8802”} \w in his own house| strong="H1004" \w*, and that it [should be published]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8764”} \w according to the language| strong="H3956" \w* \w of every people| strong="H5971" \w*.\f + \fr 1:22 \ft that it…: Heb. that one should publish it according to the language of his people \f*
\c 2
\p 
\v 1 \w After| strong="H310" \w* \w these things| strong="H1697" \w*, \w when the wrath| strong="H2534" \w* \w of king| strong="H4428" \w* \w Ahasuerus| strong="H325" \w* [was appeased]{strong=“H7918” x-morph=“strongMorph: \sc Th\sc*8800”}, [he remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w Vashti| strong="H2060" \w*, [and what she had done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [and what was decreed]{strong=“H1504” x-morph=“strongMorph: \sc Th\sc*8738”} against her. 
\v 2 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [the king’s]{strong=“H4428”} \w servants| strong="H5288" \w* [that ministered]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8764”} [unto him, Let there be fair]{strong=“H4758 H2896”} \w young| strong="H5291" \w* \w virgins| strong="H1330" \w* [sought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w for the king| strong="H4428" \w*: 
\v 3 \w And let the king| strong="H4428" \w* [appoint]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8686”} \w officers| strong="H6496" \w* \w in all the provinces| strong="H4082" \w* \w of his kingdom| strong="H4438" \w*, [that they may gather together]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8799”} [all the fair]{strong=“H4758 H2896”} \w young| strong="H5291" \w* \w virgins| strong="H1330" \w* \w unto Shushan| strong="H7800" \w* \w the palace| strong="H1002" \w*, \w to the house| strong="H1004" \w* \w of the women| strong="H802" \w*, \w unto the custody| strong="H3027" \w* \w of Hege| strong="H1896" \w* [the king’s]{strong=“H4428”} \w chamberlain| strong="H5631" \w*, [keeper ]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the women| strong="H802" \w*; \w and let their things for purification| strong="H8562" \w* [be given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} them:\f + \fr 2:3 \ft unto the…: Heb. unto the hand \f* \f + \fr 2:3 \ft Hege: also called, Hegai \f* 
\v 4 \w And let the maiden| strong="H5291" \w* [which pleaseth]{strong=“H5869 H3190” x-morph=“strongMorph: \sc Th\sc*8799”} \w the king| strong="H4428" \w* [be queen]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8799”} \w instead of Vashti| strong="H2060" \w*. \w And the thing| strong="H1697" \w* [pleased]{strong=“H5869 H3190” x-morph=“strongMorph: \sc Th\sc*8799”} \w the king| strong="H4428" \w*; [and he did so]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 5 Now \w in Shushan| strong="H7800" \w* \w the palace| strong="H1002" \w* \w there was a certain| strong="H376" \w* \w Jew| strong="H3064" \w*, \w whose name| strong="H8034" \w* was \w Mordecai| strong="H4782" \w*, \w the son| strong="H1121" \w* \w of Jair| strong="H2971" \w*, \w the son| strong="H1121" \w* \w of Shimei| strong="H8096" \w*, \w the son| strong="H1121" \w* \w of Kish| strong="H7027" \w*, \w a Benjamite| strong="H1145" \w*; 
\v 6 [Who had been carried away]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8717”} \w from Jerusalem| strong="H3389" \w* \w with the captivity| strong="H1473" \w* [which had been carried away]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8717”} \w with Jeconiah| strong="H3204" \w* \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w*, \w whom Nebuchadnezzar| strong="H5019" \w* \w the king| strong="H4428" \w* \w of Babylon| strong="H894" \w* [had carried away]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8689”}.\f + \fr 2:6 \ft Jeconiah: also called, Jehoiachin \f* 
\v 7 [And he brought up]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8802”} \w Hadassah| strong="H1919" \w*, that is, \w Esther| strong="H635" \w*, [his uncle’s]{strong=“H1730”} \w daughter| strong="H1323" \w*: \w for she had neither father| strong="H1" \w* \w nor mother| strong="H517" \w*, \w and the maid| strong="H5291" \w* was [fair]{strong=“H8389 H3303”} [and beautiful]{strong=“H4758 H2896”}; \w whom Mordecai| strong="H4782" \w*, \w when her father| strong="H1" \w* \w and mother| strong="H517" \w* \w were dead| strong="H4194" \w*, [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w for his own daughter| strong="H1323" \w*.\f + \fr 2:7 \ft brought…: Heb. nourished \f* \f + \fr 2:7 \ft fair…: Heb. fair of form, and good of countenance \f* 
\p
