\v 5 [I will break]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8804”} \w also the bar| strong="H1280" \w* \w of Damascus| strong="H1834" \w*, [and cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} [the inhabitant]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w from the plain| strong="H1237" \w* \w of Aven| strong="H206" \w*, [and him that holdeth]{strong=“H8551” x-morph=“strongMorph: \sc Th\sc*8802”} \w the sceptre| strong="H7626" \w* \w from the house| strong="H1004" \w* [of Eden]{strong=“H1040 H5731” x-morph=“strongMorph: \sc Th\sc*8677”}: \w and the people| strong="H5971" \w* \w of Syria| strong="H758" \w* [shall go into captivity]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto Kir| strong="H7024" \w*, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*.\f + \fr 1:5 \ft the plain…: or, Bikathaven \f* \f + \fr 1:5 \ft the house…: or, Beth-eden \f* 
\p
\v 6 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; \w For three| strong="H7969" \w* \w transgressions| strong="H6588" \w* \w of Gaza| strong="H5804" \w*, \w and for four| strong="H702" \w*, [I will not turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} the punishment [thereof; because they carried away captive]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8687”} \w the whole| strong="H8003" \w* \w captivity| strong="H1546" \w*, to deliver them [up]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8687”} \w to Edom| strong="H123" \w*:\f + \fr 1:6 \ft away captive…: or, them away with an entire \f* 
\v 7 [But I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w a fire| strong="H784" \w* \w on the wall| strong="H2346" \w* \w of Gaza| strong="H5804" \w*, [which shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w the palaces| strong="H759" \w* thereof: 
\v 8 [And I will cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} [the inhabitant]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w from Ashdod| strong="H795" \w*, [and him that holdeth]{strong=“H8551” x-morph=“strongMorph: \sc Th\sc*8802”} \w the sceptre| strong="H7626" \w* \w from Ashkelon| strong="H831" \w*, [and I will turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} \w mine hand| strong="H3027" \w* \w against Ekron| strong="H6138" \w*: \w and the remnant| strong="H7611" \w* \w of the Philistines| strong="H6430" \w* [shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”}, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\p
\v 9 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; \w For three| strong="H7969" \w* \w transgressions| strong="H6588" \w* \w of Tyrus| strong="H6865" \w*, \w and for four| strong="H702" \w*, [I will not turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} the punishment [thereof; because they delivered up]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8687”} \w the whole| strong="H8003" \w* \w captivity| strong="H1546" \w* \w to Edom| strong="H123" \w*, [and remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the brotherly| strong="H251" \w* \w covenant| strong="H1285" \w*:\f + \fr 1:9 \ft the brotherly…: Heb. the covenant of brethren \f* 
