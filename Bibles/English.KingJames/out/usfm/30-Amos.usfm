\c 1
\p 
\v 1 \w The words| strong="H1697" \w* \w of Amos| strong="H5986" \w*, \w who was among the herdmen| strong="H5349" \w* \w of Tekoa| strong="H8620" \w*, [which he saw]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8804”} \w concerning Israel| strong="H3478" \w* \w in the days| strong="H3117" \w* \w of Uzziah| strong="H5818" \w* \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w*, \w and in the days| strong="H3117" \w* \w of Jeroboam| strong="H3379" \w* \w the son| strong="H1121" \w* \w of Joash| strong="H3101" \w* \w king| strong="H4428" \w* \w of Israel| strong="H3478" \w*, \w two years| strong="H8141" \w* \w before| strong="H6440" \w* \w the earthquake| strong="H7494" \w*. 
\v 2 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, The \sc Lord\sc* [will roar]{strong=“H7580” x-morph=“strongMorph: \sc Th\sc*8799”} \w from Zion| strong="H6726" \w*, [and utter]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w his voice| strong="H6963" \w* \w from Jerusalem| strong="H3389" \w*; \w and the habitations| strong="H4999" \w* [of the shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [shall mourn]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and the top| strong="H7218" \w* \w of Carmel| strong="H3760" \w* [shall wither]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\p
\v 3 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; \w For three| strong="H7969" \w* \w transgressions| strong="H6588" \w* \w of Damascus| strong="H1834" \w*, \w and for four| strong="H702" \w*, [I will not turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} the punishment [thereof; because they have threshed]{strong=“H1758” x-morph=“strongMorph: \sc Th\sc*8800”} \w Gilead| strong="H1568" \w* \w with threshing instruments| strong="H2742" \w* \w of iron| strong="H1270" \w*:\f + \fr 1:3 \ft and…: or, yea, for four \f* \f + \fr 1:3 \ft turn…: or, convert it, or, let it be quiet \f* 
