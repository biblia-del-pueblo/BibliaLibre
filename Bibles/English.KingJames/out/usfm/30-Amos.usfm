\v 8 \w The lion| strong="H738" \w* [hath roared]{strong=“H7580” x-morph=“strongMorph: \sc Th\sc*8804”}, \w who will not| strong="H3808" \w* [fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}? \w the Lord| strong="H136" \w* \sc God\sc* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}, [who can but prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8735”}? 
\p
\v 9 [Publish]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8685”} \w in the palaces| strong="H759" \w* \w at Ashdod| strong="H795" \w*, \w and in the palaces| strong="H759" \w* \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”}, [Assemble]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8734”} \w yourselves upon the mountains| strong="H2022" \w* \w of Samaria| strong="H8111" \w*, [and behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w the great| strong="H7227" \w* \w tumults| strong="H4103" \w* \w in the midst| strong="H7130" \w* [thereof, and the oppressed]{strong=“H6217”} \w in the midst| strong="H8432" \w* thereof.\f + \fr 3:9 \ft oppressed: or, oppressions \f* 
\v 10 [For they know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [not to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w right| strong="H5229" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [who store]{strong=“H686” x-morph=“strongMorph: \sc Th\sc*8802”} \w up violence| strong="H2555" \w* \w and robbery| strong="H7701" \w* \w in their palaces| strong="H759" \w*.\f + \fr 3:10 \ft robbery: or, spoil \f* 
\v 11 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w An adversary| strong="H6862" \w* there shall be \w even round about| strong="H5439" \w* \w the land| strong="H776" \w*; [and he shall bring down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy strength| strong="H5797" \w* [from thee, and thy palaces]{strong=“H759”} [shall be spoiled]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8738”}. 
