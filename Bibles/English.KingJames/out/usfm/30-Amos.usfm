\v 13 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [ye, and testify]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8685”} \w in the house| strong="H1004" \w* \w of Jacob| strong="H3290" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, \w the God| strong="H430" \w* \w of hosts| strong="H6635" \w*, 
\v 14 \w That in the day| strong="H3117" \w* [that I shall visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8800”} \w the transgressions| strong="H6588" \w* \w of Israel| strong="H3478" \w* [upon him I will also visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} \w the altars| strong="H4196" \w* [of Beth-el]{strong=“H1008”}: \w and the horns| strong="H7161" \w* \w of the altar| strong="H4196" \w* [shall be cut off]{strong=“H1438” x-morph=“strongMorph: \sc Th\sc*8738”}, [and fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the ground| strong="H776" \w*.\f + \fr 3:14 \ft visit: or, punish Israel for \f* 
\v 15 [And I will smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w the winter| strong="H2779" \w* \w house| strong="H1004" \w* \w with the summer| strong="H7019" \w* \w house| strong="H1004" \w*; \w and the houses| strong="H1004" \w* \w of ivory| strong="H8127" \w* [shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and the great| strong="H7227" \w* \w houses| strong="H1004" \w* [shall have an end]{strong=“H5486” x-morph=“strongMorph: \sc Th\sc*8804”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*.
\c 4
\p 
\v 1 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w this word| strong="H1697" \w*, \w ye kine| strong="H6510" \w* \w of Bashan| strong="H1316" \w*, that are \w in the mountain| strong="H2022" \w* \w of Samaria| strong="H8111" \w*, [which oppress]{strong=“H6231” x-morph=“strongMorph: \sc Th\sc*8802”} \w the poor| strong="H1800" \w*, [which crush]{strong=“H7533” x-morph=“strongMorph: \sc Th\sc*8802”} \w the needy| strong="H34" \w*, [which say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} \w to their masters| strong="H113" \w*, [Bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8685”}, [and let us drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 2 \w The Lord| strong="H136" \w* \sc God\sc* [hath sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w by his holiness| strong="H6944" \w*, [that, lo, the days]{strong=“H3117”} [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [upon you, that he will take you away]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8765”} \w with hooks| strong="H6793" \w*, \w and your posterity| strong="H319" \w* [with fishhooks]{strong=“H5518 H1729”}. 
\v 3 [And ye shall go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w at the breaches| strong="H6556" \w*, \w every| strong="H802" \w* cow at that which is [before her; and ye shall cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8689”} them \w into the palace| strong="H2038" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*.\f + \fr 4:3 \ft cast…: or, cast away the things of the palace \f* 
\p
\v 4 [Come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} [to Beth-el]{strong=“H1008”}, [and transgress]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8798”}; \w at Gilgal| strong="H1537" \w* [multiply]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8685”} [transgression]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8800”}; [and bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8685”} \w your sacrifices| strong="H2077" \w* \w every morning| strong="H1242" \w*, and \w your tithes| strong="H4643" \w* \w after three| strong="H7969" \w* \w years| strong="H3117" \w*:\f + \fr 4:4 \ft three…: Heb. three years of days \f* 
\v 5 [And offer]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8763”} \w a sacrifice of thanksgiving| strong="H8426" \w* \w with leaven| strong="H2557" \w*, [and proclaim]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} and [publish]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8685”} \w the free offerings| strong="H5071" \w*: \w for this| strong="H3651" \w* [liketh]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} [you, O ye children]{strong=“H1121”} \w of Israel| strong="H3478" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*.\f + \fr 4:5 \ft offer: Heb. offer by burning \f* \f + \fr 4:5 \ft this…: Heb. so ye love \f* 
\p
\v 6 [And I also have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w you cleanness| strong="H5356" \w* \w of teeth| strong="H8127" \w* \w in all your cities| strong="H5892" \w*, \w and want| strong="H2640" \w* \w of bread| strong="H3899" \w* \w in all your places| strong="H4725" \w*: [yet have ye not returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 7 [And also I have withholden]{strong=“H4513” x-morph=“strongMorph: \sc Th\sc*8804”} \w the rain| strong="H1653" \w* from you, when there were \w yet three| strong="H7969" \w* \w months| strong="H2320" \w* \w to the harvest| strong="H7105" \w*: [and I caused it to rain]{strong=“H4305” x-morph=“strongMorph: \sc Th\sc*8689”} \w upon one| strong="H259" \w* \w city| strong="H5892" \w*, [and caused it not to rain]{strong=“H4305” x-morph=“strongMorph: \sc Th\sc*8686”} \w upon another| strong="H259" \w* \w city| strong="H5892" \w*: \w one| strong="H259" \w* \w piece| strong="H2513" \w* [was rained]{strong=“H4305” x-morph=“strongMorph: \sc Th\sc*8735”} [upon, and the piece]{strong=“H2513”} [whereupon it rained]{strong=“H4305” x-morph=“strongMorph: \sc Th\sc*8686”} [not withered]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 8 \w So two| strong="H8147" \w* or \w three| strong="H7969" \w* \w cities| strong="H5892" \w* [wandered]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto one| strong="H259" \w* \w city| strong="H5892" \w*, [to drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”} \w water| strong="H4325" \w*; [but they were not satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”}: [yet have ye not returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 9 [I have smitten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w you with blasting| strong="H7711" \w* \w and mildew| strong="H3420" \w*: \w when your gardens| strong="H1593" \w* \w and your vineyards| strong="H3754" \w* \w and your fig trees| strong="H8384" \w* \w and your olive trees| strong="H2132" \w* [increased]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8687”}, \w the palmerworm| strong="H1501" \w* [devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} them: [yet have ye not returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*.\f + \fr 4:9 \ft when…: or, the multitude of your gardens, etc. did the palmerworm \f* 
\v 10 [I have sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w among you the pestilence| strong="H1698" \w* \w after the manner| strong="H1870" \w* \w of Egypt| strong="H4714" \w*: \w your young men| strong="H970" \w* [have I slain]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”} \w with the sword| strong="H2719" \w*, \w and have taken away| strong="H7628" \w* \w your horses| strong="H5483" \w*; \w and I have made the stink| strong="H889" \w* \w of your camps| strong="H4264" \w* [to come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto your nostrils| strong="H639" \w*: [yet have ye not returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*.\f + \fr 4:10 \ft after…: or, in the way \f* \f + \fr 4:10 \ft and have…: Heb. with the captivity of your horses \f* 
\v 11 [I have overthrown]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8804”} some [of you, as God]{strong=“H430”} \w overthrew| strong="H4114" \w* \w Sodom| strong="H5467" \w* \w and Gomorrah| strong="H6017" \w*, \w and ye were as a firebrand| strong="H181" \w* [plucked out]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8716”} \w of the burning| strong="H8316" \w*: [yet have ye not returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 12 [Therefore thus will I do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee, O Israel]{strong=“H3478”}: and \w because| strong="H6118" \w* [I will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [this unto thee, prepare]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8734”} [to meet]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy God| strong="H430" \w*, \w O Israel| strong="H3478" \w*. 
\v 13 [For, lo, he that formeth]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w the mountains| strong="H2022" \w*, [and createth]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8802”} \w the wind| strong="H7307" \w*, [and declareth]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8688”} \w unto man| strong="H120" \w* what is \w his thought| strong="H7808" \w*, [that maketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w the morning| strong="H7837" \w* \w darkness| strong="H5890" \w*, [and treadeth]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the high places| strong="H1116" \w* \w of the earth| strong="H776" \w*, The \sc Lord\sc*, \w The God| strong="H430" \w* \w of hosts| strong="H6635" \w*, is \w his name| strong="H8034" \w*.\f + \fr 4:13 \ft wind: or, spirit \f*
\c 5
\p 
\v 1 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye this word| strong="H1697" \w* [which I take up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8802”} against you, even \w a lamentation| strong="H7015" \w*, \w O house| strong="H1004" \w* \w of Israel| strong="H3478" \w*. 
\v 2 \w The virgin| strong="H1330" \w* \w of Israel| strong="H3478" \w* [is fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”}; [she shall no more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [rise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8800”}: [she is forsaken]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8738”} \w upon her land| strong="H127" \w*; there is [none to raise her up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 3 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*; \w The city| strong="H5892" \w* [that went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} by \w a thousand| strong="H505" \w* [shall leave]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8686”} \w an hundred| strong="H3967" \w*, [and that which went forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} by \w an hundred| strong="H3967" \w* [shall leave]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8686”} \w ten| strong="H6235" \w*, \w to the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*. 
\p
\v 4 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w unto the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, [Seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8798”} [ye me, and ye shall live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8798”}: 
\v 5 [But seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”} [not Beth-el]{strong=“H1008”}, [nor enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into Gilgal| strong="H1537" \w*, [and pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} [not to Beer-sheba]{strong=“H884”}: \w for Gilgal| strong="H1537" \w* [shall surely]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8800”} [go into captivity]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8799”}, [and Beth-el]{strong=“H1008”} \w shall come to nought| strong="H205" \w*. 
\v 6 [Seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8798”} the \sc Lord\sc*, [and ye shall live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8798”}; [lest he break out]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8799”} \w like fire| strong="H784" \w* \w in the house| strong="H1004" \w* \w of Joseph| strong="H3130" \w*, [and devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} it, and there be [none to quench]{strong=“H3518” x-morph=“strongMorph: \sc Th\sc*8764”} it [in Beth-el]{strong=“H1008”}. 
\v 7 [Ye who turn]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8802”} \w judgment| strong="H4941" \w* \w to wormwood| strong="H3939" \w*, [and leave off]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8689”} \w righteousness| strong="H6666" \w* \w in the earth| strong="H776" \w*, 
