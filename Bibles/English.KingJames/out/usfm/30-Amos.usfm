\p
\v 12 \w Shall horses| strong="H5483" \w* [run]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the rock| strong="H5553" \w*? will one [plow]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8799”} there \w with oxen| strong="H1241" \w*? [for ye have turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8804”} \w judgment| strong="H4941" \w* \w into gall| strong="H7219" \w*, \w and the fruit| strong="H6529" \w* \w of righteousness| strong="H6666" \w* \w into hemlock| strong="H3939" \w*: 
