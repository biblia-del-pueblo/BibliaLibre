\c 2
\p 
\v 1 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; \w For three| strong="H7969" \w* \w transgressions| strong="H6588" \w* \w of Moab| strong="H4124" \w*, \w and for four| strong="H702" \w*, [I will not turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} the punishment [thereof; because he burned]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8800”} \w the bones| strong="H6106" \w* \w of the king| strong="H4428" \w* \w of Edom| strong="H123" \w* \w into lime| strong="H7875" \w*: 
\v 2 [But I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w a fire| strong="H784" \w* \w upon Moab| strong="H4124" \w*, [and it shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w the palaces| strong="H759" \w* \w of Kerioth| strong="H7152" \w*: \w and Moab| strong="H4124" \w* [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”} \w with tumult| strong="H7588" \w*, \w with shouting| strong="H8643" \w*, and \w with the sound| strong="H6963" \w* \w of the trumpet| strong="H7782" \w*: 
\v 3 [And I will cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} [the judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} \w from the midst| strong="H7130" \w* [thereof, and will slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the princes| strong="H8269" \w* [thereof with him, saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*. 
\p
\v 4 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; \w For three| strong="H7969" \w* \w transgressions| strong="H6588" \w* \w of Judah| strong="H3063" \w*, \w and for four| strong="H702" \w*, [I will not turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} the punishment [thereof; because they have despised]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8800”} \w the law| strong="H8451" \w* of the \sc Lord\sc*, [and have not kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w his commandments| strong="H2706" \w*, \w and their lies| strong="H3577" \w* [caused them to err]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8686”}, \w after| strong="H310" \w* \w the which their fathers| strong="H1" \w* [have walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”}: 
\v 5 [But I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w a fire| strong="H784" \w* \w upon Judah| strong="H3063" \w*, [and it shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w the palaces| strong="H759" \w* \w of Jerusalem| strong="H3389" \w*. 
\p
\v 6 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; \w For three| strong="H7969" \w* \w transgressions| strong="H6588" \w* \w of Israel| strong="H3478" \w*, \w and for four| strong="H702" \w*, [I will not turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} the punishment [thereof; because they sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8800”} \w the righteous| strong="H6662" \w* \w for silver| strong="H3701" \w*, \w and the poor| strong="H34" \w* \w for a pair of shoes| strong="H5275" \w*; 
\v 7 [That pant]{strong=“H7602” x-morph=“strongMorph: \sc Th\sc*8802”} \w after the dust| strong="H6083" \w* \w of the earth| strong="H776" \w* \w on the head| strong="H7218" \w* \w of the poor| strong="H1800" \w*, [and turn aside]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w the way| strong="H1870" \w* \w of the meek| strong="H6035" \w*: \w and a man| strong="H376" \w* \w and his father| strong="H1" \w* [will go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} in unto the same \w maid| strong="H5291" \w*, [to profane]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8763”} \w my holy| strong="H6944" \w* \w name| strong="H8034" \w*:\f + \fr 2:7 \ft maid: or, young woman \f* 
\v 8 And they lay themselves [down]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w upon clothes| strong="H899" \w* [laid to pledge]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8803”} \w by| strong="H681" \w* \w every altar| strong="H4196" \w*, [and they drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w the wine| strong="H3196" \w* [of the condemned]{strong=“H6064” x-morph=“strongMorph: \sc Th\sc*8803”} in \w the house| strong="H1004" \w* \w of their god| strong="H430" \w*.\f + \fr 2:8 \ft the condemned: or, such as have fined, or, mulcted \f* 
\p
\v 9 [Yet destroyed]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8689”} \w I the Amorite| strong="H567" \w* \w before| strong="H6440" \w* [them, whose height]{strong=“H1363”} was \w like the height| strong="H1363" \w* \w of the cedars| strong="H730" \w*, and he was \w strong| strong="H2634" \w* \w as the oaks| strong="H437" \w*; [yet I destroyed]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8686”} \w his fruit| strong="H6529" \w* \w from above| strong="H4605" \w*, \w and his roots| strong="H8328" \w* from beneath. 
\v 10 [Also I brought you up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} \w from the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, [and led]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8686”} \w you forty| strong="H705" \w* \w years| strong="H8141" \w* \w through the wilderness| strong="H4057" \w*, [to possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} \w the land| strong="H776" \w* \w of the Amorite| strong="H567" \w*. 
\v 11 [And I raised up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8686”} \w of your sons| strong="H1121" \w* \w for prophets| strong="H5030" \w*, \w and of your young men| strong="H970" \w* \w for Nazarites| strong="H5139" \w*. Is it [not even thus, O ye children]{strong=“H1121”} \w of Israel| strong="H3478" \w*? [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 12 \w But ye gave the Nazarites| strong="H5139" \w* \w wine| strong="H3196" \w* [to drink]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8686”}; [and commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w the prophets| strong="H5030" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8735”} not. 
\v 13 [Behold, I am pressed]{strong=“H5781” x-morph=“strongMorph: \sc Th\sc*8688”} [under you, as a cart]{strong=“H5699”} [is pressed]{strong=“H5781” x-morph=“strongMorph: \sc Th\sc*8686”} that is \w full| strong="H4392" \w* \w of sheaves| strong="H5995" \w*.\f + \fr 2:13 \ft I am…: or, I will press your place, as a cart full of sheaves presseth \f* 
\v 14 \w Therefore the flight| strong="H4498" \w* [shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”} \w from the swift| strong="H7031" \w*, \w and the strong| strong="H2389" \w* [shall not strengthen]{strong=“H553” x-morph=“strongMorph: \sc Th\sc*8762”} \w his force| strong="H3581" \w*, \w neither shall the mighty| strong="H1368" \w* [deliver]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8762”} \w himself| strong="H5315" \w*:\f + \fr 2:14 \ft himself: Heb. his soul, or, life \f* 
\v 15 [Neither shall he stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} [that handleth]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8802”} \w the bow| strong="H7198" \w*; and he that is \w swift| strong="H7031" \w* \w of foot| strong="H7272" \w* [shall not deliver]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8762”} himself: [neither shall he that rideth]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8802”} \w the horse| strong="H5483" \w* [deliver]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8762”} \w himself| strong="H5315" \w*. 
\v 16 And he that is [courageous]{strong=“H3820 H533”} \w among the mighty| strong="H1368" \w* [shall flee away]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”} \w naked| strong="H6174" \w* \w in that day| strong="H3117" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*.\f + \fr 2:16 \ft courageous: Heb. strong of his heart \f*
\c 3
\p 
\v 1 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w this word| strong="H1697" \w* that the \sc Lord\sc* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [against you, O children]{strong=“H1121”} \w of Israel| strong="H3478" \w*, \w against the whole family| strong="H4940" \w* [which I brought up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} \w from the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [You only have I known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w of all the families| strong="H4940" \w* \w of the earth| strong="H127" \w*: [therefore I will punish]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} \w you for all your iniquities| strong="H5771" \w*.\f + \fr 3:2 \ft punish: Heb. visit upon \f* 
\v 3 \w Can two| strong="H8147" \w* [walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w together| strong="H3162" \w*, \w except| strong="H1115" \w* [they be agreed]{strong=“H3259” x-morph=“strongMorph: \sc Th\sc*8738”}? 
\v 4 \w Will a lion| strong="H738" \w* [roar]{strong=“H7580” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the forest| strong="H3293" \w*, \w when he hath no prey| strong="H2964" \w*? \w will a young lion| strong="H3715" \w* [cry out]{strong=“H6963 H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w of his den| strong="H4585" \w*, [if he have taken]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8804”} \w nothing| strong="H1115" \w*?\f + \fr 3:4 \ft cry: Heb. give forth his voice \f* 
\v 5 \w Can a bird| strong="H6833" \w* [fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w in a snare| strong="H6341" \w* \w upon the earth| strong="H776" \w*, \w where no gin| strong="H4170" \w* is for him? shall one [take up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w a snare| strong="H6341" \w* \w from the earth| strong="H127" \w*, [and have taken]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8799”} [nothing at all]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8800”}? 
\v 6 \w Shall a trumpet| strong="H7782" \w* [be blown]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the city| strong="H5892" \w*, \w and the people| strong="H5971" \w* [not be afraid]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8799”}? \w shall there be evil| strong="H7451" \w* \w in a city| strong="H5892" \w*, and the \sc Lord\sc* [hath not done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} it?\f + \fr 3:6 \ft be afraid: or, run together? \f* ^\sc 3:6 the [Lord\sc*…: or, shall not the \sc Lord\sc* do somewhat?] 
