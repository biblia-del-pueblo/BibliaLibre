\c 7
\p 
\v 1 \w Thus hath the Lord| strong="H136" \w* \sc God\sc* [shewed]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8689”} [unto me; and, behold, he formed]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w grasshoppers| strong="H1462" \w* \w in the beginning| strong="H8462" \w* [of the shooting up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8800”} \w of the latter growth| strong="H3954" \w*; and, lo, it was \w the latter growth| strong="H3954" \w* \w after| strong="H310" \w* [the king’s]{strong=“H4428”} \w mowings| strong="H1488" \w*.\f + \fr 7:1 \ft grasshoppers: or, green worms \f* 
\v 2 And it came to pass, that [when they had made an end]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8765”} [of eating]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} \w the grass| strong="H6212" \w* \w of the land| strong="H776" \w*, [then I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w O Lord| strong="H136" \w* \sc God\sc*, [forgive]{strong=“H5545” x-morph=“strongMorph: \sc Th\sc*8798”}, [I beseech thee: by whom shall Jacob]{strong=“H3290”} [arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}? for he is \w small| strong="H6996" \w*.\f + \fr 7:2 \ft by…: or, who of (or, for,) Jacob shall stand? \f* 
\v 3 The \sc Lord\sc* [repented]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8738”} [for this: It shall not be, saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*. 
\p
\v 4 \w Thus hath the Lord| strong="H136" \w* \sc God\sc* [shewed]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8689”} [unto me: and, behold, the Lord]{strong=“H136”} \sc God\sc* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8802”} [to contend]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8800”} \w by fire| strong="H784" \w*, [and it devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the great| strong="H7227" \w* \w deep| strong="H8415" \w*, [and did eat up]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w a part| strong="H2506" \w*. 
\v 5 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [I, O Lord]{strong=“H136”} \sc God\sc*, [cease]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8798”}, [I beseech thee: by whom shall Jacob]{strong=“H3290”} [arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}? for he is \w small| strong="H6996" \w*.\f + \fr 7:5 \ft by…: or, who of (or, for,) Jacob shall stand? \f* 
\v 6 The \sc Lord\sc* [repented]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8738”} [for this: This also shall not be, saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*. 
\p
\v 7 [Thus he shewed]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8689”} [me: and, behold, the Lord]{strong=“H136”} [stood]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8737”} \w upon a wall| strong="H2346" \w* made \w by a plumbline| strong="H594" \w*, \w with a plumbline| strong="H594" \w* \w in his hand| strong="H3027" \w*. 
\v 8 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Amos]{strong=“H5986”}, [what seest]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} [thou? And I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w A plumbline| strong="H594" \w*. [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w the Lord| strong="H136" \w*, [Behold, I will set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8802”} \w a plumbline| strong="H594" \w* \w in the midst| strong="H7130" \w* \w of my people| strong="H5971" \w* \w Israel| strong="H3478" \w*: [I will not again]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [pass by]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8800”} them any more: 
\v 9 \w And the high places| strong="H1116" \w* \w of Isaac| strong="H3446" \w* [shall be desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and the sanctuaries| strong="H4720" \w* \w of Israel| strong="H3478" \w* [shall be laid waste]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8799”}; [and I will rise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”} \w against the house| strong="H1004" \w* \w of Jeroboam| strong="H3379" \w* \w with the sword| strong="H2719" \w*. 
\p
\v 10 \w Then Amaziah| strong="H558" \w* \w the priest| strong="H3548" \w* [of Beth-el]{strong=“H1008”} [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Jeroboam| strong="H3379" \w* \w king| strong="H4428" \w* \w of Israel| strong="H3478" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Amos| strong="H5986" \w* [hath conspired]{strong=“H7194” x-morph=“strongMorph: \sc Th\sc*8804”} \w against thee in the midst| strong="H7130" \w* \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*: \w the land| strong="H776" \w* [is not able]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [to bear]{strong=“H3557” x-morph=“strongMorph: \sc Th\sc*8687”} \w all his words| strong="H1697" \w*. 
\v 11 \w For thus Amos| strong="H5986" \w* [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Jeroboam| strong="H3379" \w* [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w*, \w and Israel| strong="H3478" \w* [shall surely]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8800”} [be led away captive]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of their own land| strong="H127" \w*. 
\v 12 \w Also Amaziah| strong="H558" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Amos| strong="H5986" \w*, \w O thou seer| strong="H2374" \w*, [go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [flee thee away]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8798”} \w into the land| strong="H776" \w* \w of Judah| strong="H3063" \w*, [and there eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8798”} \w bread| strong="H3899" \w*, [and prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8735”} there: 
\v 13 [But prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8736”} [not again]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [any more at Beth-el]{strong=“H1008”}: for it is [the king’s]{strong=“H4428”} \w chapel| strong="H4720" \w*, and it is [the king’s]{strong=“H4467”} \w court| strong="H1004" \w*.\f + \fr 7:13 \ft chapel: or, sanctuary \f* \f + \fr 7:13 \ft king’s court: Heb. house of the kingdom \f* 
\p
\v 14 [Then answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w Amos| strong="H5986" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Amaziah| strong="H558" \w*, I was \w no prophet| strong="H5030" \w*, neither was [I a prophet’s]{strong=“H5030”} \w son| strong="H1121" \w*; but I was \w an herdman| strong="H951" \w*, [and a gatherer]{strong=“H1103” x-morph=“strongMorph: \sc Th\sc*8802”} \w of sycomore fruit| strong="H8256" \w*:\f + \fr 7:14 \ft sycomore…: or, wild figs \f* 
\v 15 And the \sc Lord\sc* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w me as I followed| strong="H310" \w* \w the flock| strong="H6629" \w*, and the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8734”} \w unto my people| strong="H5971" \w* \w Israel| strong="H3478" \w*.\f + \fr 7:15 \ft as…: Heb. from behind \f* 
\p
\v 16 [Now therefore hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou the word| strong="H1697" \w* of the \sc Lord\sc*: [Thou sayest]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, [Prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8735”} \w not against Israel| strong="H3478" \w*, [and drop]{strong=“H5197” x-morph=“strongMorph: \sc Th\sc*8686”} not thy word \w against the house| strong="H1004" \w* \w of Isaac| strong="H3446" \w*. 
\v 17 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; \w Thy wife| strong="H802" \w* [shall be an harlot]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the city| strong="H5892" \w*, \w and thy sons| strong="H1121" \w* \w and thy daughters| strong="H1323" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w*, \w and thy land| strong="H127" \w* [shall be divided]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8792”} \w by line| strong="H2256" \w*; [and thou shalt die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w in| strong="H5921" \w* \w a polluted| strong="H2931" \w* \w land| strong="H127" \w*: \w and Israel| strong="H3478" \w* [shall surely]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8800”} [go into captivity]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8799”} \w forth of his land| strong="H127" \w*. 
\c 8
\p 
\v 1 \w Thus hath the Lord| strong="H136" \w* \sc God\sc* [shewed]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8689”} [unto me: and behold a basket]{strong=“H3619”} \w of summer fruit| strong="H7019" \w*. 
\v 2 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Amos| strong="H5986" \w*, [what seest]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} [thou? And I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w A basket| strong="H3619" \w* \w of summer fruit| strong="H7019" \w*. [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc* [unto me, The end]{strong=“H7093”} [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon my people| strong="H5971" \w* \w of Israel| strong="H3478" \w*; [I will not again]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8800”} by them any more. 
\v 3 \w And the songs| strong="H7892" \w* \w of the temple| strong="H1964" \w* [shall be howlings]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8689”} \w in that day| strong="H3117" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*: there shall be \w many| strong="H7227" \w* \w dead bodies| strong="H6297" \w* \w in every place| strong="H4725" \w*; they shall cast them [forth]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8689”} [with silence]{strong=“H2013” x-morph=“strongMorph: \sc Th\sc*8761”}.\f + \fr 8:3 \ft shall be howlings: Heb. shall howl \f* \f + \fr 8:3 \ft with…: Heb. be silent \f* 
\p
\v 4 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [this, O ye that swallow up]{strong=“H7602” x-morph=“strongMorph: \sc Th\sc*8802”} \w the needy| strong="H34" \w*, \w even to make| strong="H7673" \w* [the poor]{strong=“H6035 H6041” x-morph=“strongMorph: \sc Th\sc*8675”} \w of the land| strong="H776" \w* [to fail]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8687”}, 
\v 5 [Saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w When will the new moon| strong="H2320" \w* [be gone]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}, [that we may sell]{strong=“H7666” x-morph=“strongMorph: \sc Th\sc*8686”} \w corn| strong="H7668" \w*? \w and the sabbath| strong="H7676" \w*, [that we may set forth]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} \w wheat| strong="H1250" \w*, \w making the ephah| strong="H374" \w* [small]{strong=“H6994” x-morph=“strongMorph: \sc Th\sc*8687”}, \w and the shekel| strong="H8255" \w* [great]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8687”}, [and falsifying]{strong=“H5791” x-morph=“strongMorph: \sc Th\sc*8763”} \w the balances| strong="H3976" \w* \w by deceit| strong="H4820" \w*?\f + \fr 8:5 \ft new…: or, month \f* \f + \fr 8:5 \ft set…: Heb. open \f* \f + \fr 8:5 \ft falsifying…: Heb. perverting the balances of deceit \f* 
\v 6 [That we may buy]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8800”} \w the poor| strong="H1800" \w* \w for silver| strong="H3701" \w*, \w and the needy| strong="H34" \w* \w for a pair of shoes| strong="H5275" \w*; yea, [and sell]{strong=“H7666” x-morph=“strongMorph: \sc Th\sc*8686”} \w the refuse| strong="H4651" \w* \w of the wheat| strong="H1250" \w*? 
\v 7 The \sc Lord\sc* [hath sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w by the excellency| strong="H1347" \w* \w of Jacob| strong="H3290" \w*, \w Surely I will never| strong="H5331" \w* [forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} \w any of their works| strong="H4639" \w*. 
\v 8 \w Shall not the land| strong="H776" \w* [tremble]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8799”} [for this, and every one mourn]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8804”} [that dwelleth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} [therein? and it shall rise up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w wholly as a flood| strong="H2975" \w*; [and it shall be cast out]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8738”} [and drowned]{strong=“H8248 H8257” x-morph=“strongMorph: \sc Th\sc*8738 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8738”}, as by \w the flood| strong="H216" \w* \w of Egypt| strong="H4714" \w*. 
\v 9 \w And it shall come to pass in that day| strong="H3117" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, \w that I will cause the sun| strong="H8121" \w* [to go down]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w at noon| strong="H6672" \w*, [and I will darken]{strong=“H2821” x-morph=“strongMorph: \sc Th\sc*8689”} \w the earth| strong="H776" \w* \w in the clear| strong="H216" \w* \w day| strong="H3117" \w*: 
\v 10 [And I will turn]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8804”} \w your feasts| strong="H2282" \w* \w into mourning| strong="H60" \w*, \w and all your songs| strong="H7892" \w* \w into lamentation| strong="H7015" \w*; [and I will bring up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} \w sackcloth| strong="H8242" \w* \w upon all loins| strong="H4975" \w*, \w and baldness| strong="H7144" \w* \w upon every head| strong="H7218" \w*; [and I will make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w it as the mourning| strong="H60" \w* \w of an only| strong="H3173" \w* son, \w and the end| strong="H319" \w* \w thereof as a bitter| strong="H4751" \w* \w day| strong="H3117" \w*. 
\p
\v 11 [Behold, the days]{strong=“H3117”} [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc*, [that I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8689”} \w a famine| strong="H7458" \w* \w in the land| strong="H776" \w*, \w not a famine| strong="H7458" \w* \w of bread| strong="H3899" \w*, \w nor a thirst| strong="H6772" \w* \w for water| strong="H4325" \w*, [but of hearing]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w the words| strong="H1697" \w* of the \sc Lord\sc*: 
\v 12 [And they shall wander]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8804”} \w from sea| strong="H3220" \w* \w to sea| strong="H3220" \w*, \w and from the north| strong="H6828" \w* \w even to the east| strong="H4217" \w*, [they shall run to and fro]{strong=“H7751” x-morph=“strongMorph: \sc Th\sc*8787”} [to seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8763”} \w the word| strong="H1697" \w* of the \sc Lord\sc*, [and shall not find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\v 13 \w In that day| strong="H3117" \w* \w shall the fair| strong="H3303" \w* \w virgins| strong="H1330" \w* \w and young men| strong="H970" \w* [faint]{strong=“H5968” x-morph=“strongMorph: \sc Th\sc*8691”} \w for thirst| strong="H6772" \w*. 
\v 14 [They that swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8737”} \w by the sin| strong="H819" \w* \w of Samaria| strong="H8111" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Thy god| strong="H430" \w*, \w O Dan| strong="H1835" \w*, \w liveth| strong="H2416" \w*; [and, The manner]{strong=“H1870”} [of Beer-sheba]{strong=“H884”} \w liveth| strong="H2416" \w*; [even they shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”}, [and never rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} again.\f + \fr 8:14 \ft manner: Heb. way \f*
\c 9
\p 
\v 1 [I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* [standing]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8737”} \w upon the altar| strong="H4196" \w*: [and he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8685”} \w the lintel of the door| strong="H3730" \w*, \w that the posts| strong="H5592" \w* [may shake]{strong=“H7493” x-morph=“strongMorph: \sc Th\sc*8799”}: [and cut]{strong=“H1214” x-morph=“strongMorph: \sc Th\sc*8798”} \w them in the head| strong="H7218" \w*, [all of them; and I will slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} \w the last| strong="H319" \w* \w of them with the sword| strong="H2719" \w*: [he that fleeth]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8801”} [of them shall not flee away]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and he that escapeth| strong="H6412" \w* [of them shall not be delivered]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 9:1 \ft lintel: or, chapiter, or, knop \f* \f + \fr 9:1 \ft cut…: or, wound them \f* 
\v 2 [Though they dig]{strong=“H2864” x-morph=“strongMorph: \sc Th\sc*8799”} \w into hell| strong="H7585" \w*, \w thence shall mine hand| strong="H3027" \w* [take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [them; though they climb up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w to heaven| strong="H8064" \w*, [thence will I bring them down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8686”}: 
\v 3 [And though they hide]{strong=“H2244” x-morph=“strongMorph: \sc Th\sc*8735”} \w themselves in the top| strong="H7218" \w* \w of Carmel| strong="H3760" \w*, [I will search]{strong=“H2664” x-morph=“strongMorph: \sc Th\sc*8762”} [and take them out]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} [thence; and though they be hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8735”} \w from my sight| strong="H5869" \w* \w in the bottom| strong="H7172" \w* \w of the sea| strong="H3220" \w*, [thence will I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} \w the serpent| strong="H5175" \w*, [and he shall bite]{strong=“H5391” x-morph=“strongMorph: \sc Th\sc*8804”} them: 
\v 4 [And though they go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w into captivity| strong="H7628" \w* \w before| strong="H6440" \w* [their enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, [thence will I command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} \w the sword| strong="H2719" \w*, [and it shall slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”} [them: and I will set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine eyes| strong="H5869" \w* \w upon them for evil| strong="H7451" \w*, \w and not for good| strong="H2896" \w*. 
