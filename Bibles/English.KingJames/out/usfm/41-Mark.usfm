\v 19 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Judas]{strong=“G2455” x-morph=“robinson: N-\sc Asm\sc* 2”} [Iscariot]{strong=“G2469” x-morph=“robinson: N-\sc Asm\sc* 3”}, [which]{strong=“G3739” x-morph=“robinson: R-\sc Nsm\sc* 4”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [betrayed]{strong=“G3860” x-morph=“robinson: V-\sc Aai\sc*-3S 6”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 7”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [they went]{strong=“G2064” x-morph=“robinson: V-\sc Pni\sc*-3P 9”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 10”} [an house]{strong=“G3624” x-morph=“robinson: N-\sc Asm\sc* 11”}. 
\v 20 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [the multitude]{strong=“G3793” x-morph=“robinson: N-\sc Nsm\sc* 4”} [cometh together]{strong=“G4905” x-morph=“robinson: V-\sc Pni\sc*-3S 2”} [again]{strong=“G3825” x-morph=“robinson: \sc Adv\sc* 3”}, [so that]{strong=“G5620” x-morph=“robinson: \sc Conj\sc* 5”} [they]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 8”} [could]{strong=“G1410” x-morph=“robinson: V-\sc Pnn\sc* 7”} [not]{strong=“G3361” x-morph=“robinson: \sc Prt\sc*-N 6”} [so much as]{strong=“G3383” x-morph=“robinson: \sc Conj\sc* 9”} [eat]{strong=“G5315” x-morph=“robinson: V-2\sc Aan\sc* 11”} [bread]{strong=“G740” x-morph=“robinson: N-\sc Asm\sc* 10”}. 
\v 21 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 2”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 5”} [friends]{strong=“G3844” x-morph=“robinson: \sc Prep\sc* 4”} [heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 2”} of it, [they went out]{strong=“G1831” x-morph=“robinson: V-2\sc Aai\sc*-3P 6”} [to lay hold]{strong=“G2902” x-morph=“robinson: V-\sc Aan\sc* 7”} [on him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 8”}: [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 10”} [they said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3P 9”}, [He is beside himself]{strong=“G1839” x-morph=“robinson: V-2\sc Aai\sc*-3S 12”}. 
\p
\v 22 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [the scribes]{strong=“G3588 G1122” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 2 3”} [which]{strong=“G3588” x-morph=“robinson: T-\sc Npm\sc* 4”} [came down]{strong=“G2597” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 7”} [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 5”} [Jerusalem]{strong=“G2414” x-morph=“robinson: N-\sc Gpn\sc* 6”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3P 8”}, [He hath]{strong=“G2192” x-morph=“robinson: V-\sc Pai\sc*-3S 11”} [Beelzebub]{strong=“G954” x-morph=“robinson: N-\sc Pri\sc* 10”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”} [by]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 14”} [the prince]{strong=“G3588 G758” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 15 16”} [of the devils]{strong=“G3588 G1140” x-morph=“robinson: T-\sc Gpn\sc* robinson: N-\sc Gpn\sc* 17 18”} [casteth he out]{strong=“G1544” x-morph=“robinson: V-\sc Pai\sc*-3S 19”} [devils]{strong=“G3588 G1140” x-morph=“robinson: T-\sc Apn\sc* robinson: N-\sc Apn\sc* 20 21”}. 
\v 23 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he called]{strong=“G4341” x-morph=“robinson: V-\sc Adp\sc*-\sc Nsm\sc* 2”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 3”} unto him, and [said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 6”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 7”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 4”} [parables]{strong=“G3850” x-morph=“robinson: N-\sc Dpf\sc* 5”}, \wj How can Satan cast out Satan?\wj* 
\v 24 \wj And if a kingdom be divided against itself, that kingdom cannot stand.\wj* 
\v 25 \wj And if a house be divided against itself, that house cannot stand.\wj* 
\v 26 \wj And if Satan rise up against himself, and be divided, he cannot stand, but hath an end.\wj* 
\v 27 \wj No man can enter into a strong man’s house, and spoil his goods, except he will first bind the strong man; and then he will spoil his house.\wj* 
\v 28 \wj Verily I say unto you, All sins shall be forgiven unto the sons of men, and blasphemies wherewith soever they shall blaspheme:\wj* 
\v 29 \wj But he that shall blaspheme against the Holy Ghost hath never forgiveness, but is in danger of eternal damnation:\wj* 
\v 30 [Because]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 1”} [they said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3P 2”}, [He hath]{strong=“G2192” x-morph=“robinson: V-\sc Pai\sc*-3S 5”} [an unclean]{strong=“G169” x-morph=“robinson: A-\sc Asn\sc* 4”} [spirit]{strong=“G4151” x-morph=“robinson: N-\sc Asn\sc* 3”}. 
\p
\v 31 [There came]{strong=“G2064” x-morph=“robinson: V-\sc Pni\sc*-3P 1”} [then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 8”} [brethren]{strong=“G3588 G80” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 8”} [mother]{strong=“G3588 G3384” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 6 7”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”}, [standing]{strong=“G2476” x-morph=“robinson: V-\sc Rap\sc*-\sc Npm\sc* 11”} [without]{strong=“G1854” x-morph=“robinson: \sc Adv\sc* 10”}, [sent]{strong=“G649” x-morph=“robinson: V-\sc Aai\sc*-3P 12”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 13”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 14”}, [calling]{strong=“G5455” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 15”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 16”}. 
\v 32 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [the multitude]{strong=“G3793” x-morph=“robinson: N-\sc Nsm\sc* 3”} [sat]{strong=“G2521” x-morph=“robinson: V-\sc Ini\sc*-3S 2”} [about]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 4”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 5”}, [and]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 7”} [they said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 6”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 8”}, [Behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 9”}, [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 12”} [mother]{strong=“G3588 G3384” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 10 11”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 13”} [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 16”} [brethren]{strong=“G3588 G80” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 14 15”} [without]{strong=“G1854” x-morph=“robinson: \sc Adv\sc* 17”} [seek]{strong=“G2212” x-morph=“robinson: V-\sc Pai\sc*-3P 18”} [for thee]{strong=“G4571” x-morph=“robinson: P-2\sc As\sc* 19”}. 
\v 33 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 2”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 4”}, \wj Who is my mother, or my brethren?\wj* 
\v 34 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he looked]{strong=“G4017” x-morph=“robinson: V-\sc Amp\sc*-\sc Nsm\sc* 2”} [round about]{strong=“G2945” x-morph=“robinson: N-\sc Dsm\sc* 3”} [on them which sat]{strong=“G2521” x-morph=“robinson: V-\sc Pnp\sc*-\sc Apm\sc* 7”} [about]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 5”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 6”}, [and said]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 8”}, \wj Behold my mother and my brethren!\wj* 
\v 35 \wj For whosoever shall do the will of God, the same is my brother, and my sister, and mother.\wj* 
\c 4
\p 
\v 1 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he began]{strong=“G756” x-morph=“robinson: V-\sc Adi\sc*-3S 3”} [again]{strong=“G3825” x-morph=“robinson: \sc Adv\sc* 2”} [to teach]{strong=“G1321” x-morph=“robinson: V-\sc Pan\sc* 4”} [by]{strong=“G3844” x-morph=“robinson: \sc Prep\sc* 5”} [the sea side]{strong=“G3588 G2281” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 6 7”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [there was gathered]{strong=“G4863” x-morph=“robinson: V-\sc Api\sc*-3S 9”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 10”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 11”} [a]{strong=“G3793” x-morph=“robinson: N-\sc Nsm\sc* 12”} [great]{strong=“G4183” x-morph=“robinson: A-\sc Nsm\sc* 13”} [multitude]{strong=“G3793” x-morph=“robinson: N-\sc Nsm\sc* 12”}, [so that]{strong=“G5620” x-morph=“robinson: \sc Conj\sc* 14”} [he]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 15”} [entered]{strong=“G1684” x-morph=“robinson: V-2\sc Aap\sc*-\sc Asm\sc* 16”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 17”} [a ship]{strong=“G3588 G4143” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 18 19”}, [and sat]{strong=“G2521” x-morph=“robinson: V-\sc Pnn\sc* 20”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 21”} [the sea]{strong=“G3588 G2281” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 22 23”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 24”} [the]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 26 27”} [whole]{strong=“G3956” x-morph=“robinson: A-\sc Nsm\sc* 25”} [multitude]{strong=“G3793” x-morph=“robinson: N-\sc Nsm\sc* 27”} [was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 34”} [by]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 28”} [the sea]{strong=“G3588 G2281” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 29 30”} [on]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 31”} [the land]{strong=“G3588 G1093” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 32 33”}. 
\v 2 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he taught]{strong=“G1321” x-morph=“robinson: V-\sc Iai\sc*-3S 2”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 3”} [many things]{strong=“G4183” x-morph=“robinson: A-\sc Apn\sc* 6”} [by]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 4”} [parables]{strong=“G3850” x-morph=“robinson: N-\sc Dpf\sc* 5”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 8”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 9”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 10”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 13”} [doctrine]{strong=“G3588 G1322” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 11 12”}, 
\v 3 \wj Hearken; Behold, there went out a sower to sow:\wj* 
\v 4 \wj And it came to pass, as he sowed, some fell by the way side, and the fowls of the air came and devoured it up.\wj* 
\v 5 \wj And some fell on stony ground, where it had not much earth; and immediately it sprang up, because it had no depth of earth:\wj* 
\v 6 \wj But when the sun was up, it was scorched; and because it had no root, it withered away.\wj* 
\v 7 \wj And some fell among thorns, and the thorns grew up, and choked it, and it yielded no fruit.\wj* 
\v 8 \wj And other fell on good ground, and did yield fruit that sprang up and increased; and brought forth, some thirty, and some sixty, and some an hundred.\wj* 
\v 9 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj He that hath ears to hear, let him hear.\wj* 
\v 10 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [when]{strong=“G3753” x-morph=“robinson: \sc Adv\sc* 1”} [he was]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 3”} [alone]{strong=“G2651” x-morph=“robinson: \sc Adv\sc* 4”}, [they that were about]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 8”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 9”} [with]{strong=“G4862” x-morph=“robinson: \sc Prep\sc* 10”} [the twelve]{strong=“G1427” x-morph=“robinson: A-\sc Nui\sc* 12”} [asked]{strong=“G2065” x-morph=“robinson: V-\sc Aai\sc*-3P 5”} [of him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 6”} [the parable]{strong=“G3588 G3850” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 13 14”}. 
\v 11 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj Unto you it is given to know the mystery of the kingdom of God: but unto them that are without, all these things are done in parables:\wj* 
\v 12 \wj That seeing they may see, and not perceive; and hearing they may hear, and not understand; lest at any time they should be converted, and their sins should be forgiven them.\wj* 
\v 13 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj Know ye not this parable? and how then will ye know all parables?\wj* 
\p
\v 14 \wj The sower soweth the word.\wj* 
\v 15 \wj And these are they by the way side, where the word is sown; but when they have heard, Satan cometh immediately, and taketh away the word that was sown in their hearts.\wj* 
\v 16 \wj And these are they likewise which are sown on stony ground; who, when they have heard the word, immediately receive it with gladness;\wj* 
\v 17 \wj And have no root in themselves, and so endure but for a time: afterward, when affliction or persecution ariseth for the word’s sake, immediately they are offended.\wj* 
\v 18 \wj And these are they which are sown among thorns; such as hear the word,\wj* 
\v 19 \wj And the cares of this world, and the deceitfulness of riches, and the lusts of other things entering in, choke the word, and it becometh unfruitful.\wj* 
\v 20 \wj And these are they which are sown on good ground; such as hear the word, and receive it, and bring forth fruit, some thirtyfold, some sixty, and some an hundred.\wj* 
\p
\v 21 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj Is a candle brought to be put under a bushel, or under a bed? and not to be set on a candlestick?\wj* 
\v 22 \wj For there is nothing hid, which shall not be manifested; neither was any thing kept secret, but that it should come abroad.\wj* 
\v 23 \wj If any man have ears to hear, let him hear.\wj* 
\v 24 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj Take heed what ye hear: with what measure ye mete, it shall be measured to you: and unto you that hear shall more be given.\wj* 
\v 25 \wj For he that hath, to him shall be given: and he that hath not, from him shall be taken even that which he hath.\wj* 
\p
\v 26 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 2”}, \wj So is the kingdom of God, as if a man should cast seed into the ground;\wj* 
\v 27 \wj And should sleep, and rise night and day, and the seed should spring and grow up, he knoweth not how.\wj* 
\v 28 \wj For the earth bringeth forth fruit of herself; first the blade, then the ear, after that the full corn in the ear.\wj* 
\v 29 \wj But when the fruit is brought forth, immediately he putteth in the sickle, because the harvest is come.\wj* 
\p
\v 30 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 2”}, \wj Whereunto shall we liken the kingdom of God? or with what comparison shall we compare it?\wj* 
\v 31 \wj It is like a grain of mustard seed, which, when it is sown in the earth, is less than all the seeds that be in the earth:\wj* 
\v 32 \wj But when it is sown, it groweth up, and becometh greater than all herbs, and shooteth out great branches; so that the fowls of the air may lodge under the shadow of it.\wj* 
