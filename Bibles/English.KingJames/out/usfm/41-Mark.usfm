\c 11
\p 
\v 1 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when]{strong=“G3753” x-morph=“robinson: \sc Adv\sc* 2”} [they came nigh]{strong=“G1448” x-morph=“robinson: V-\sc Pai\sc*-3P 3”} [to]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 4”} [Jerusalem]{strong=“G2419” x-morph=“robinson: N-\sc Pri\sc* 5”}, [unto]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 6”} [Bethphage]{strong=“G967” x-morph=“robinson: N-\sc Pri\sc* 7”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [Bethany]{strong=“G963” x-morph=“robinson: N-\sc Asf\sc* 9”}, [at]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 10”} [the mount]{strong=“G3588 G3735” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 11 12”} [of Olives]{strong=“G3588 G1636” x-morph=“robinson: T-\sc Gpf\sc* robinson: N-\sc Gpf\sc* 13 14”}, [he sendeth forth]{strong=“G649” x-morph=“robinson: V-\sc Pai\sc*-3S 15”} [two]{strong=“G1417” x-morph=“robinson: A-\sc Nui\sc* 16”} [of his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 19”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 17 18”}, 
