\p
\v 12 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [the first]{strong=“G4413” x-morph=“robinson: A-\sc Dsf\sc* 3”} [day]{strong=“G2250” x-morph=“robinson: N-\sc Dsf\sc* 4”} [of unleavened bread]{strong=“G106” x-morph=“robinson: A-\sc Gpn\sc* 6”}, [when]{strong=“G3753” x-morph=“robinson: \sc Adv\sc* 7”} [they killed]{strong=“G2380” x-morph=“robinson: V-\sc Iai\sc*-3P 10”} [the passover]{strong=“G3957” x-morph=“robinson: \sc Aram\sc* 9”}, [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 15”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 13 14”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3P 11”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 12”}, [Where]{strong=“G4226” x-morph=“robinson: \sc Prt\sc*-I 16”} [wilt thou]{strong=“G2309” x-morph=“robinson: V-\sc Pai\sc*-2S 17”} [that we go]{strong=“G565” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 18”} [and prepare]{strong=“G2090” x-morph=“robinson: V-\sc Aas\sc*-1P 19”} [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 20”} [thou mayest eat]{strong=“G5315” x-morph=“robinson: V-2\sc Aas\sc*-2S 21”} [the passover]{strong=“G3957” x-morph=“robinson: \sc Aram\sc* 23”}? 
\v 13 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he sendeth forth]{strong=“G649” x-morph=“robinson: V-\sc Pai\sc*-3S 2”} [two]{strong=“G1417” x-morph=“robinson: A-\sc Nui\sc* 3”} [of his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 6”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 4 5”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 8”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 9”}, \wj Go ye into the city, and there shall meet you a man bearing a pitcher of water: follow him.\wj* 
\v 14 \wj And wheresoever he shall go in, say ye to the goodman of the house, The Master saith, Where is the guestchamber, where I shall eat the passover with my disciples?\wj* 
\v 15 \wj And he will shew you a large upper room furnished and prepared: there make ready for us.\wj* 
\v 16 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 5”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [went forth]{strong=“G1831” x-morph=“robinson: V-2\sc Aai\sc*-3P 2”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [came]{strong=“G2064” x-morph=“robinson: V-2\sc Aai\sc*-3P 7”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 8”} [the city]{strong=“G3588 G4172” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 9 10”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [found]{strong=“G2147” x-morph=“robinson: V-2\sc Aai\sc*-3P 12”} [as]{strong=“G2531” x-morph=“robinson: \sc Adv\sc* 13”} [he had said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 14”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 15”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 16”} [they made ready]{strong=“G2090” x-morph=“robinson: V-\sc Aai\sc*-3P 17”} [the passover]{strong=“G3957” x-morph=“robinson: \sc Aram\sc* 19”}. 
