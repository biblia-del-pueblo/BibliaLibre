\v 5 [For]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 2”} [it]{strong=“G5124” x-morph=“robinson: D-\sc Nsn\sc* 3”} [might]{strong=“G1410” x-morph=“robinson: V-\sc Ini\sc*-3S-\sc Att\sc* 1”} [have been sold]{strong=“G4097” x-morph=“robinson: V-\sc Apn\sc* 4”} [for more than]{strong=“G1883” x-morph=“robinson: \sc Adv\sc* 5”} [three hundred]{strong=“G5145” x-morph=“robinson: A-\sc Gpm\sc* 6”} [pence]{strong=“G1220” x-morph=“robinson: N-\sc Gpn\sc* 7”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [have been given]{strong=“G1325” x-morph=“robinson: V-\sc Apn\sc* 9”} [to the poor]{strong=“G4434” x-morph=“robinson: A-\sc Dpm\sc* 11”}. [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”} [they murmured against]{strong=“G1690” x-morph=“robinson: V-\sc Ini\sc*-3P 13”} [her]{strong=“G846” x-morph=“robinson: P-\sc Dsf\sc* 14”}. 
\v 6 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 3”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”}, \wj Let her alone; why trouble ye her? she hath wrought a good work on me.\wj* 
\v 7 \wj For ye have the poor with you always, and whensoever ye will ye may do them good: but me ye have not always.\wj* 
\v 8 \wj She hath done what she could: she is come aforehand to anoint my body to the burying.\wj* 
\v 9 \wj Verily I say unto you, Wheresoever this gospel shall be preached throughout the whole world, this also that she hath done shall be spoken of for a memorial of her.\wj* 
\p
\v 10 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Judas]{strong=“G3588 G2455” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 2 3”} [Iscariot]{strong=“G3588 G2469” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”}, [one]{strong=“G1520” x-morph=“robinson: A-\sc Nsm\sc* 6”} [of the twelve]{strong=“G1427” x-morph=“robinson: A-\sc Nui\sc* 8”}, [went]{strong=“G565” x-morph=“robinson: V-2\sc Aai\sc*-3S 9”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 10”} [the chief priests]{strong=“G3588 G749” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 11 12”}, [to]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 13”} [betray]{strong=“G3860” x-morph=“robinson: V-2\sc Aas\sc*-3S 14”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 15”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 16”}. 
