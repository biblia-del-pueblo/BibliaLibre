\v 26 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he sent]{strong=“G649” x-morph=“robinson: V-\sc Aai\sc*-3S 2”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 3”} [away]{strong=“G649” x-morph=“robinson: V-\sc Aai\sc*-3S 2”} [to]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 4”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 7”} [house]{strong=“G3588 G3624” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 5 6”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 8”}, \wj Neither go into the town, nor tell it to any in the town.\wj* 
\p
\v 27 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [went out]{strong=“G1831” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 8”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 6 7”}, [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 9”} [the towns]{strong=“G3588 G2968” x-morph=“robinson: T-\sc Apf\sc* robinson: N-\sc Apf\sc* 10 11”} [of Cæsarea]{strong=“G2542” x-morph=“robinson: N-\sc Gsf\sc* 12”} [Philippi]{strong=“G5376” x-morph=“robinson: N-\sc Gsm\sc* 14”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 15”} [by]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 16”} [the way]{strong=“G3588 G3598” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 17 18”} [he asked]{strong=“G1905” x-morph=“robinson: V-\sc Iai\sc*-3S 19”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 22”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 20 21”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 23”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 24”}, \wj Whom do men say that I am?\wj* 
\v 28 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [they answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3P 3”}, [John]{strong=“G2491” x-morph=“robinson: N-\sc Asm\sc* 4”} [the Baptist]{strong=“G3588 G910” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 5 6”}: [but]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [some]{strong=“G243” x-morph=“robinson: A-\sc Npm\sc* 8”} say, [Elias]{strong=“G2243” x-morph=“robinson: N-\sc Asm\sc* 9”}; [and]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 11”} [others]{strong=“G243” x-morph=“robinson: A-\sc Npm\sc* 10”}, [One]{strong=“G1520” x-morph=“robinson: A-\sc Asm\sc* 12”} [of the prophets]{strong=“G3588 G4396” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 13 14”}. 
\v 29 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he]{strong=“G846” x-morph=“robinson: P-\sc Nsm\sc* 2”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 3”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 4”}, \wj But whom say ye that I am?\wj* [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 12”} [Peter]{strong=“G3588 G4074” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 13 14”} [answereth]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 11”} [and saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 15”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 16”}, [Thou]{strong=“G4771” x-morph=“robinson: P-2\sc Ns\sc* 17”} [art]{strong=“G1488” x-morph=“robinson: V-\sc Pxi\sc*-2S 18”} [the Christ]{strong=“G3588 G5547” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 19 20”}. 
\v 30 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he charged]{strong=“G2008” x-morph=“robinson: V-\sc Aai\sc*-3S 2”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”} [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 4”} [they should tell]{strong=“G3004” x-morph=“robinson: V-\sc Pas\sc*-3P 6”} [no man]{strong=“G3367” x-morph=“robinson: A-\sc Dsm\sc* 5”} [of]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 7”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 8”}. 
\v 31 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he began]{strong=“G756” x-morph=“robinson: V-\sc Adi\sc*-3S 2”} [to teach]{strong=“G1321” x-morph=“robinson: V-\sc Pan\sc* 3”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 4”}, [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 5”} [the Son]{strong=“G3588 G5207” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 7 8”} [of man]{strong=“G3588 G444” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 9 10”} [must]{strong=“G1163” x-morph=“robinson: V-\sc Pqi\sc*-3S 6”} [suffer]{strong=“G3958” x-morph=“robinson: V-2\sc Aan\sc* 12”} [many things]{strong=“G4183” x-morph=“robinson: A-\sc Apn\sc* 11”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 13”} [be rejected]{strong=“G593” x-morph=“robinson: V-\sc Apn\sc* 14”} [of]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 15”} [the elders]{strong=“G4245” x-morph=“robinson: A-\sc Gpm\sc* 17”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 18”} of [the chief priests]{strong=“G749” x-morph=“robinson: N-\sc Gpm\sc* 19”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 20”} [scribes]{strong=“G1122” x-morph=“robinson: N-\sc Gpm\sc* 21”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 22”} [be killed]{strong=“G615” x-morph=“robinson: V-\sc Apn\sc* 23”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 24”} [after]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 25”} [three]{strong=“G5140” x-morph=“robinson: A-\sc Apf\sc* 26”} [days]{strong=“G2250” x-morph=“robinson: N-\sc Apf\sc* 27”} [rise again]{strong=“G450” x-morph=“robinson: V-2\sc Aan\sc* 28”}. 
\v 32 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he spake]{strong=“G2980” x-morph=“robinson: V-\sc Iai\sc*-3S 5”} [that saying]{strong=“G3588 G3056” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 3 4”} [openly]{strong=“G3954” x-morph=“robinson: N-\sc Dsf\sc* 2”}. [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [Peter]{strong=“G3588 G4074” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 9 10”} [took]{strong=“G4355” x-morph=“robinson: V-2\sc Amp\sc*-\sc Nsm\sc* 7”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 8”}, [and began]{strong=“G756” x-morph=“robinson: V-\sc Adi\sc*-3S 11”} [to rebuke]{strong=“G2008” x-morph=“robinson: V-\sc Pan\sc* 12”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 13”}. 
\v 33 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [when he had turned about]{strong=“G1994” x-morph=“robinson: V-2\sc App\sc*-\sc Nsm\sc* 3”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 4”} [looked on]{strong=“G1492” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 5”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 8”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 6 7”}, [he rebuked]{strong=“G2008” x-morph=“robinson: V-\sc Aai\sc*-3S 9”} [Peter]{strong=“G3588 G4074” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 10 11”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 12”}, \wj Get thee behind me, Satan: for thou savourest not the things that be of God, but the things that be of men.\wj* 
\p
\v 34 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when he had called]{strong=“G4341” x-morph=“robinson: V-\sc Adp\sc*-\sc Nsm\sc* 2”} [the people]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 3 4”} unto him [with]{strong=“G4862” x-morph=“robinson: \sc Prep\sc* 5”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 8”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 6 7”} [also]{strong=“G4862” x-morph=“robinson: \sc Prep\sc* 5”}, [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 9”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 10”}, \wj Whosoever will come after me, let him deny himself, and take up his cross, and follow me.\wj* 
\v 35 \wj For whosoever will save his life shall lose it; but whosoever shall lose his life for my sake and the gospel’s, the same shall save it.\wj* 
\v 36 \wj For what shall it profit a man, if he shall gain the whole world, and lose his own soul?\wj* 
\v 37 \wj Or what shall a man give in exchange for his soul?\wj* 
\v 38 \wj Whosoever therefore shall be ashamed of me and of my words in this adulterous and sinful generation; of him also shall the Son of man be ashamed, when he cometh in the glory of his Father with the holy angels.\wj* 
\c 9
\p 
\v 1 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj Verily I say unto you, That there be some of them that stand here, which shall not taste of death, till they have seen the kingdom of God come with power.\wj* 
\p
