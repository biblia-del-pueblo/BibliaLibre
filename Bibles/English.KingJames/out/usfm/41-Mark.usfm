\v 17 [When]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 2”} it, [he saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 5”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 6”}, \wj They that are whole have no need of the physician, but they that are sick: I came not to call the righteous, but sinners to repentance.\wj* 
\v 18 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [the disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [of John]{strong=“G2491” x-morph=“robinson: N-\sc Gsm\sc* 5”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [of the Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 8 9”} [used]{strong=“G2258” x-morph=“robinson: V-IXI-3P 2”} [to fast]{strong=“G3522” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 10”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [they come]{strong=“G2064” x-morph=“robinson: V-\sc Pni\sc*-3P 12”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 13”} [say]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3P 14”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 15”}, [Why]{strong=“G1223 G5101” x-morph=“robinson: \sc Prep\sc* robinson: I-\sc Asn\sc* 16 17”} do [the disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 18 19”} [of John]{strong=“G2491” x-morph=“robinson: N-\sc Gsm\sc* 20”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 21”} [of the Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 23 24”} [fast]{strong=“G3522” x-morph=“robinson: V-\sc Pai\sc*-3P 25”}, [but]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 27”} [thy]{strong=“G4674” x-morph=“robinson: S-2\sc Npm\sc* 28”} [disciples]{strong=“G3101” x-morph=“robinson: N-\sc Npm\sc* 29”} [fast]{strong=“G3522” x-morph=“robinson: V-\sc Pai\sc*-3P 31”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 30”}? 
\v 19 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj Can the children of the bridechamber fast, while the bridegroom is with them? as long as they have the bridegroom with them, they cannot fast.\wj* 
\v 20 \wj But the days will come, when the bridegroom shall be taken away from them, and then shall they fast in those days.\wj* 
\v 21 \wj No man also seweth a piece of new cloth on an old garment: else the new piece that filled it up taketh away from the old, and the rent is made worse.\wj* 
\v 22 \wj And no man putteth new wine into old bottles: else the new wine doth burst the bottles, and the wine is spilled, and the bottles will be marred: but new wine must be put into new bottles.\wj* 
\v 23 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [it came to pass]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 2”}, [that]{strong=“G3899” x-morph=“robinson: V-\sc Pnn\sc* 3”} [he]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 4”} [went]{strong=“G3899” x-morph=“robinson: V-\sc Pnn\sc* 3”} [through]{strong=“G1223” x-morph=“robinson: \sc Prep\sc* 8”} [the corn fields]{strong=“G4702” x-morph=“robinson: A-\sc Gpm\sc* 10”} [on]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 5”} [the sabbath day]{strong=“G3588 G4521” x-morph=“robinson: T-\sc Dpn\sc* robinson: N-\sc Dpn\sc* 6 7”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 15”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 13 14”} [began]{strong=“G756” x-morph=“robinson: V-\sc Adi\sc*-3P 12”}, [as they went]{strong=“G3598” x-morph=“robinson: N-\sc Asf\sc* 16”}, [to pluck]{strong=“G4160 G5089” x-morph=“robinson: V-\sc Pan\sc* robinson: V-\sc Pap\sc*-\sc Npm\sc* 17 18”} [the ears of corn]{strong=“G3588 G4719” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 19 20”}. 
\v 24 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [the Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 2 3”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3P 4”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 5”}, [Behold]{strong=“G1492” x-morph=“robinson: V-\sc Aam\sc*-2S 6”}, [why]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 7”} [do they]{strong=“G4160” x-morph=“robinson: V-\sc Pai\sc*-3P 8”} [on]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 9”} [the sabbath day]{strong=“G3588 G4521” x-morph=“robinson: T-\sc Dpn\sc* robinson: N-\sc Dpn\sc* 10 11”} [that which]{strong=“G3739” x-morph=“robinson: R-\sc Asn\sc* 12”} [is]{strong=“G1832” x-morph=“robinson: V-\sc Pqi\sc*-3S 14”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 13”} [lawful]{strong=“G1832” x-morph=“robinson: V-\sc Pqi\sc*-3S 14”}? 
\v 25 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he]{strong=“G846” x-morph=“robinson: P-\sc Nsm\sc* 2”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 3”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 4”}, \wj Have ye never read what David did, when he had need, and was an hungred, he, and they that were with him?\wj* 
\v 26 \wj How he went into the house of God in the days of Abiathar the high priest, and did eat the shewbread, which is not lawful to eat but for the priests, and gave also to them which were with him?\wj* 
\v 27 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj The sabbath was made for man, and not man for the sabbath:\wj* 
\v 28 \wj Therefore the Son of man is Lord also of the sabbath.\wj* 
\c 3
