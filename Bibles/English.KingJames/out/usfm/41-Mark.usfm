\v 18 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [as they]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 3”} [sat]{strong=“G345” x-morph=“robinson: V-\sc Pnp\sc*-\sc Gpm\sc* 2”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 4”} [did eat]{strong=“G2068” x-morph=“robinson: V-\sc Pap\sc*-\sc Gpm\sc* 5”}, [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 7 8”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 6”}, \wj Verily I say unto you, One of you which eateth with me shall betray me.\wj* 
\v 19 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [they began]{strong=“G756” x-morph=“robinson: V-\sc Adi\sc*-3P 3”} [to be sorrowful]{strong=“G3076” x-morph=“robinson: V-\sc Ppn\sc* 4”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [to say]{strong=“G3004” x-morph=“robinson: V-\sc Pan\sc* 6”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 7”} [one]{strong=“G1520” x-morph=“robinson: A-\sc Nsm\sc* 8”} [by]{strong=“G2596” x-morph=“robinson: \sc Prep\sc* 9”} [one]{strong=“G1520” x-morph=“robinson: A-\sc Nsm\sc* 10”}, Is [it]{strong=“G3385” x-morph=“robinson: \sc Prt\sc*-I 11”} [I]{strong=“G1473” x-morph=“robinson: P-1\sc Ns\sc* 12”}? [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 13”} [another]{strong=“G243” x-morph=“robinson: A-\sc Nsm\sc* 14”} said, Is [it]{strong=“G3385” x-morph=“robinson: \sc Prt\sc*-I 15”} [I]{strong=“G1473” x-morph=“robinson: P-1\sc Ns\sc* 16”}? 
\v 20 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 3”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}, \wj It is one of the twelve, that dippeth with me in the dish.\wj* 
\v 21 \wj The Son of man indeed goeth, as it is written of him: but woe to that man by whom the Son of man is betrayed! good were it for that man if he had never been born.\wj* 
\p
\v 22 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [as they]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 3”} [did eat]{strong=“G2068” x-morph=“robinson: V-\sc Pap\sc*-\sc Gpm\sc* 2”}, [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [took]{strong=“G2983” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 4”} [bread]{strong=“G740” x-morph=“robinson: N-\sc Asm\sc* 7”}, [and blessed]{strong=“G2127” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 8”}, [and brake]{strong=“G2806” x-morph=“robinson: V-\sc Aai\sc*-3S 9”} it, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [gave]{strong=“G1325” x-morph=“robinson: V-\sc Aai\sc*-3S 11”} [to them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 12”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 13”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 14”}, \wj Take, eat: this is my body.\wj* 
\v 23 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he took]{strong=“G2983” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”} [the cup]{strong=“G3588 G4221” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 3 4”}, [and when he had given thanks]{strong=“G2168” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 5”}, [he gave]{strong=“G1325” x-morph=“robinson: V-\sc Aai\sc*-3S 6”} it [to them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 7”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [they]{strong=“G4095” x-morph=“robinson: V-2\sc Aai\sc*-3P 9”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Npm\sc* 12”} [drank]{strong=“G4095” x-morph=“robinson: V-2\sc Aai\sc*-3P 9”} [of]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 10”} [it]{strong=“G846” x-morph=“robinson: P-\sc Gsn\sc* 11”}. 
\v 24 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj This is my blood of the new testament, which is shed for many.\wj* 
\v 25 \wj Verily I say unto you, I will drink no more of the fruit of the vine, until that day that I drink it new in the kingdom of God.\wj* 
\p
\v 26 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when they had sung an hymn]{strong=“G5214” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 2”}, [they went out]{strong=“G1831” x-morph=“robinson: V-2\sc Aai\sc*-3P 3”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 4”} [the mount]{strong=“G3588 G3735” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 5 6”} [of Olives]{strong=“G3588 G1636” x-morph=“robinson: T-\sc Gpf\sc* robinson: N-\sc Gpf\sc* 7 8”}. 
\v 27 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj All ye shall be offended because of me this night: for it is written, I will smite the shepherd, and the sheep shall be scattered.\wj* 
\v 28 \wj But after that I am risen, I will go before you into Galilee.\wj* 
\v 29 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Peter]{strong=“G4074” x-morph=“robinson: N-\sc Nsm\sc* 3”} [said]{strong=“G5346” x-morph=“robinson: V-IXI-3S 4”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 5”}, [Although]{strong=“G1487” x-morph=“robinson: \sc Cond\sc* 7”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Npm\sc* 8”} [shall be offended]{strong=“G4624” x-morph=“robinson: V-\sc Fpi\sc*-3P 9”}, [yet]{strong=“G235” x-morph=“robinson: \sc Conj\sc* 10”} will [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 11”} [I]{strong=“G1473” x-morph=“robinson: P-1\sc Ns\sc* 12”}. 
