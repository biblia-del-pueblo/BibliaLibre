\v 19 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when]{strong=“G3753” x-morph=“robinson: \sc Adv\sc* 2”} [even]{strong=“G3796” x-morph=“robinson: \sc Adv\sc* 3”} [was come]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 4”}, [he went]{strong=“G1607” x-morph=“robinson: V-\sc Ini\sc*-3S 5”} [out of]{strong=“G1854” x-morph=“robinson: \sc Adv\sc* 6”} [the city]{strong=“G3588 G4172” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 7 8”}. 
\p
\v 20 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [in the morning]{strong=“G4404” x-morph=“robinson: \sc Adv\sc* 2”}, [as they passed by]{strong=“G3899” x-morph=“robinson: V-\sc Pnp\sc*-\sc Npm\sc* 3”}, [they saw]{strong=“G1492” x-morph=“robinson: V-2\sc Aai\sc*-3P 4”} [the fig tree]{strong=“G3588 G4808” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 5 6”} [dried up]{strong=“G3583” x-morph=“robinson: V-\sc Rpp\sc*-\sc Asf\sc* 7”} [from]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 8”} [the roots]{strong=“G4491” x-morph=“robinson: N-\sc Gpf\sc* 9”}. 
\v 21 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Peter]{strong=“G3588 G4074” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [calling to remembrance]{strong=“G363” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 2”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 5”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 6”}, [Master]{strong=“G4461” x-morph=“robinson: \sc Heb\sc* 7”}, [behold]{strong=“G1492” x-morph=“robinson: V-\sc Aam\sc*-2S 8”}, [the fig tree]{strong=“G3588 G4808” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 9 10”} [which]{strong=“G3739” x-morph=“robinson: R-\sc Asf\sc* 11”} [thou cursedst]{strong=“G2672” x-morph=“robinson: V-\sc Adi\sc*-2S 12”} [is withered away]{strong=“G3583” x-morph=“robinson: V-\sc Rpi\sc*-3S 13”}. 
\v 22 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 3”} [answering]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 2”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 4”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}, \wj Have faith in God.\wj* 
\v 23 \wj For verily I say unto you, That whosoever shall say unto this mountain, Be thou removed, and be thou cast into the sea; and shall not doubt in his heart, but shall believe that those things which he saith shall come to pass; he shall have whatsoever he saith.\wj* 
\v 24 \wj Therefore I say unto you, What things soever ye desire, when ye pray, believe that ye receive them, and ye shall have them.\wj* 
\v 25 \wj And when ye stand praying, forgive, if ye have ought against any: that your Father also which is in heaven may forgive you your trespasses.\wj* 
\v 26 \wj But if ye do not forgive, neither will your Father which is in heaven forgive your trespasses.\wj* 
\p
\v 27 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they come]{strong=“G2064” x-morph=“robinson: V-\sc Pni\sc*-3P 2”} [again]{strong=“G3825” x-morph=“robinson: \sc Adv\sc* 3”} [to]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 4”} [Jerusalem]{strong=“G2414” x-morph=“robinson: N-\sc Asf\sc* 5”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [as he]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 11”} [was walking]{strong=“G4043” x-morph=“robinson: V-\sc Pap\sc*-\sc Gsm\sc* 10”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 7”} [the temple]{strong=“G3588 G2411” x-morph=“robinson: T-\sc Dsn\sc* robinson: N-\sc Dsn\sc* 8 9”}, [there come]{strong=“G2064” x-morph=“robinson: V-\sc Pni\sc*-3P 12”} [to]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 13”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 14”} [the chief priests]{strong=“G3588 G749” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 15 16”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 17”} [the scribes]{strong=“G3588 G1122” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 18 19”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 20”} [the elders]{strong=“G4245” x-morph=“robinson: A-\sc Npm\sc* 22”}, 
\v 28 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [say]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3P 2”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”}, [By]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 4”} [what]{strong=“G4169” x-morph=“robinson: I-\sc Dsf\sc* 5”} [authority]{strong=“G1849” x-morph=“robinson: N-\sc Dsf\sc* 6”} [doest thou]{strong=“G4160” x-morph=“robinson: V-\sc Pai\sc*-2S 8”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 7”}? [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [who]{strong=“G5101” x-morph=“robinson: I-\sc Nsm\sc* 10”} [gave]{strong=“G1325” x-morph=“robinson: V-\sc Aai\sc*-3S 15”} [thee]{strong=“G4671” x-morph=“robinson: P-2\sc Ds\sc* 11”} [this]{strong=“G3778” x-morph=“robinson: D-\sc Asf\sc* 14”} [authority]{strong=“G3588 G1849” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 12 13”} [to]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 16”} [do]{strong=“G4160” x-morph=“robinson: V-\sc Pas\sc*-2S 18”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 17”}? 
\v 29 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 3”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 4”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 6”}, \wj I will also ask of you one question, and answer me, and I will tell you by what authority I do these things.\wj* 
\v 30 \wj The baptism of John, was it from heaven, or of men? answer me.\wj* 
\v 31 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they reasoned]{strong=“G3049” x-morph=“robinson: V-\sc Ini\sc*-3P 2”} [with]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [themselves]{strong=“G1438” x-morph=“robinson: F-3\sc Apm\sc* 4”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 5”}, [If]{strong=“G1437” x-morph=“robinson: \sc Cond\sc* 6”} [we shall say]{strong=“G2036” x-morph=“robinson: V-2\sc Aas\sc*-1P 7”}, [From]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 8”} [heaven]{strong=“G3772” x-morph=“robinson: N-\sc Gsm\sc* 9”}; [he will say]{strong=“G2046” x-morph=“robinson: V-\sc Fai\sc*-3S 10”}, [Why]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 12”} [then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 13”} [did ye]{strong=“G4100” x-morph=“robinson: V-\sc Aai\sc*-2P 15”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 14”} [believe]{strong=“G4100” x-morph=“robinson: V-\sc Aai\sc*-2P 15”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 16”}? 
\v 32 [But]{strong=“G235” x-morph=“robinson: \sc Conj\sc* 1”} [if]{strong=“G1437” x-morph=“robinson: \sc Cond\sc* 2”} [we shall say]{strong=“G2036” x-morph=“robinson: V-2\sc Aas\sc*-1P 3”}, [Of]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 4”} [men]{strong=“G444” x-morph=“robinson: N-\sc Gpm\sc* 5”}; [they feared]{strong=“G5399” x-morph=“robinson: V-\sc Ini\sc*-3P 6”} [the people]{strong=“G3588 G2992” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 7 8”}: [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 10”} [all]{strong=“G537” x-morph=“robinson: A-\sc Npm\sc* 9”} men [counted]{strong=“G2192” x-morph=“robinson: V-\sc Iai\sc*-3P 11”} [John]{strong=“G3588 G2491” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 12 13”}, [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 14”} [he was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 17”} [a prophet]{strong=“G4396” x-morph=“robinson: N-\sc Nsm\sc* 16”} [indeed]{strong=“G3689” x-morph=“robinson: \sc Adv\sc* 15”}. 
\v 33 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Npm\sc* 2”} [and said]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3P 3”} [unto Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 4 5”}, [We]{strong=“G1492” x-morph=“robinson: V-\sc Rai\sc*-1P 7”} [cannot]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 6”} [tell]{strong=“G1492” x-morph=“robinson: V-\sc Rai\sc*-1P 7”}. [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 9 10”} [answering]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 11”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 12”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 13”}, \wj Neither do I tell you by what authority I do these things.\wj* 
\c 12
\p 
\v 1 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he began]{strong=“G756” x-morph=“robinson: V-\sc Adi\sc*-3S 2”} [to speak]{strong=“G3004” x-morph=“robinson: V-\sc Pan\sc* 6”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”} [by]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 4”} [parables]{strong=“G3850” x-morph=“robinson: N-\sc Dpf\sc* 5”}. \wj A certain man planted a vineyard, and set an hedge about it, and digged a place for the winefat, and built a tower, and let it out to husbandmen, and went into a far country.\wj* 
\v 2 \wj And at the season he sent to the husbandmen a servant, that he might receive from the husbandmen of the fruit of the vineyard.\wj* 
\v 3 \wj And they caught him, and beat him, and sent him away empty.\wj* 
\v 4 \wj And again he sent unto them another servant; and at him they cast stones, and wounded him in the head, and sent him away shamefully handled.\wj* 
\v 5 \wj And again he sent another; and him they killed, and many others; beating some, and killing some.\wj* 
\v 6 \wj Having yet therefore one son, his wellbeloved, he sent him also last unto them, saying, They will reverence my son.\wj* 
\v 7 \wj But those husbandmen said among themselves, This is the heir; come, let us kill him, and the inheritance shall be ours.\wj* 
\v 8 \wj And they took him, and killed him, and cast him out of the vineyard.\wj* 
\v 9 \wj What shall therefore the lord of the vineyard do? he will come and destroy the husbandmen, and will give the vineyard unto others.\wj* 
\v 10 \wj And have ye not read this scripture; The stone which the builders rejected is become the head of the corner:\wj* 
\v 11 \wj This was the Lord’s doing, and it is marvellous in our eyes?\wj* 
\v 12 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they sought]{strong=“G2212” x-morph=“robinson: V-\sc Iai\sc*-3P 2”} [to lay hold]{strong=“G2902” x-morph=“robinson: V-\sc Aan\sc* 4”} [on him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 3”}, [but]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [feared]{strong=“G5399” x-morph=“robinson: V-\sc Aoi\sc*-3P 6”} [the people]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 7 8”}: [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 10”} [they knew]{strong=“G1097” x-morph=“robinson: V-2\sc Aai\sc*-3P 9”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 11”} [he had spoken]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 16”} [the parable]{strong=“G3588 G3850” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 14 15”} [against]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 12”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 13”}: [and they left]{strong=“G863” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 18”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 19”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 17”} [went their way]{strong=“G565” x-morph=“robinson: V-2\sc Aai\sc*-3P 20”}. 
\p
\v 13 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they send]{strong=“G649” x-morph=“robinson: V-\sc Pai\sc*-3P 2”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 4”} [certain]{strong=“G5100” x-morph=“robinson: X-\sc Apm\sc* 5”} [of the Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 6 7”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [of the Herodians]{strong=“G3588 G2265” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 9 10”}, [to]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 11”} [catch]{strong=“G64” x-morph=“robinson: V-\sc Aas\sc*-3P 13”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 12”} [in]{strong=“G3056” x-morph=“robinson: N-\sc Dsm\sc* 14”} his [words]{strong=“G3056” x-morph=“robinson: N-\sc Dsm\sc* 14”}. 
\v 14 [And when]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [they were come]{strong=“G2064” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 3”}, [they say]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3P 4”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 5”}, [Master]{strong=“G1320” x-morph=“robinson: N-\sc Vsm\sc* 6”}, [we know]{strong=“G1492” x-morph=“robinson: V-\sc Rai\sc*-1P 7”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 8”} [thou art]{strong=“G1488” x-morph=“robinson: V-\sc Pxi\sc*-2S 10”} [true]{strong=“G227” x-morph=“robinson: A-\sc Nsm\sc* 9”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [carest]{strong=“G3199” x-morph=“robinson: V-\sc Pqi\sc*-3S 13”} [for]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 15”} [no man]{strong=“G3762” x-morph=“robinson: A-\sc Gsm\sc* 16”}: [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 18”} [thou regardest]{strong=“G991” x-morph=“robinson: V-\sc Pai\sc*-2S 19”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 17”} [the person]{strong=“G4383” x-morph=“robinson: N-\sc Asn\sc* 21”} [of men]{strong=“G444” x-morph=“robinson: N-\sc Gpm\sc* 22”}, [but]{strong=“G235” x-morph=“robinson: \sc Conj\sc* 23”} [teachest]{strong=“G1321” x-morph=“robinson: V-\sc Pai\sc*-2S 30”} [the way]{strong=“G3588 G3598” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 26 27”} [of God]{strong=“G3588 G2316” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 28 29”} [in]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 24”} [truth]{strong=“G225” x-morph=“robinson: N-\sc Gsf\sc* 25”}: [Is it lawful]{strong=“G1832” x-morph=“robinson: V-\sc Pqi\sc*-3S 31”} [to give]{strong=“G1325” x-morph=“robinson: V-2\sc Aan\sc* 34”} [tribute]{strong=“G2778” x-morph=“robinson: N-\sc Asm\sc* 32”} [to Cæsar]{strong=“G2541” x-morph=“robinson: N-\sc Dsm\sc* 33”}, [or]{strong=“G2228” x-morph=“robinson: \sc Prt\sc* 35”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 36”}? 
\v 15 [Shall we give]{strong=“G1325” x-morph=“robinson: V-2\sc Aas\sc*-1P 1”}, [or]{strong=“G2228” x-morph=“robinson: \sc Prt\sc* 2”} [shall we]{strong=“G1325” x-morph=“robinson: V-2\sc Aas\sc*-1P 4”} [not]{strong=“G3361” x-morph=“robinson: \sc Prt\sc*-N 3”} [give]{strong=“G1325” x-morph=“robinson: V-2\sc Aas\sc*-1P 4”}? [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 6”} [he]{strong=“G3588” x-morph=“robinson: T-\sc Nsm\sc* 5”}, [knowing]{strong=“G1492” x-morph=“robinson: V-\sc Rap\sc*-\sc Nsm\sc* 7”} [their]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 8”} [hypocrisy]{strong=“G3588 G5272” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 9 10”}, [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 11”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 12”}, \wj Why tempt ye me? bring me a penny, that I may see it.\wj* 
