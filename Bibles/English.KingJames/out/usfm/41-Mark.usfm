\v 7 [But]{strong=“G235” x-morph=“robinson: \sc Conj\sc* 1”} [go your way]{strong=“G5217” x-morph=“robinson: V-\sc Pam\sc*-2P 2”}, [tell]{strong=“G2036” x-morph=“robinson: V-2\sc Aam\sc*-2P 3”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 6”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 4 5”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [Peter]{strong=“G3588 G4074” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 8 9”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 10”} [he goeth before]{strong=“G4254” x-morph=“robinson: V-\sc Pai\sc*-3S 11”} [you]{strong=“G5209” x-morph=“robinson: P-2\sc Ap\sc* 12”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 13”} [Galilee]{strong=“G3588 G1056” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 14 15”}: [there]{strong=“G1563” x-morph=“robinson: \sc Adv\sc* 16”} [shall ye see]{strong=“G3700” x-morph=“robinson: V-\sc Fdi\sc*-2P 18”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 17”}, [as]{strong=“G2531” x-morph=“robinson: \sc Adv\sc* 19”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 20”} [unto you]{strong=“G5213” x-morph=“robinson: P-2\sc Dp\sc* 21”}. 
\v 8 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they went out]{strong=“G1831” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npf\sc* 2”} [quickly]{strong=“G5035” x-morph=“robinson: \sc Adv\sc* 3”}, [and fled]{strong=“G5343” x-morph=“robinson: V-2\sc Aai\sc*-3P 4”} [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 5”} [the sepulchre]{strong=“G3588 G3419” x-morph=“robinson: T-\sc Gsn\sc* robinson: N-\sc Gsn\sc* 6 7”}; [for]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 9”} [they]{strong=“G846” x-morph=“robinson: P-\sc Apf\sc* 10”} [trembled]{strong=“G5156” x-morph=“robinson: N-\sc Nsm\sc* 11”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”} [were amazed]{strong=“G1611” x-morph=“robinson: N-\sc Nsf\sc* 13”}: [neither]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [said they]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 17”} [any thing]{strong=“G3762” x-morph=“robinson: A-\sc Asn\sc* 16”} [to any]{strong=“G3762” x-morph=“robinson: A-\sc Dsm\sc* 15”} man; [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 19”} [they were afraid]{strong=“G5399” x-morph=“robinson: V-\sc Ini\sc*-3P 18”}. 
