\v 1 [Then]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [came together]{strong=“G4863” x-morph=“robinson: V-\sc Ppi\sc*-3P 2”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 4”} [the Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 5 6”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [certain]{strong=“G5100” x-morph=“robinson: X-\sc Npm\sc* 8”} [of the scribes]{strong=“G3588 G1122” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 9 10”}, [which came]{strong=“G2064” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 11”} [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 12”} [Jerusalem]{strong=“G2414” x-morph=“robinson: N-\sc Gpn\sc* 13”}. 
\v 2 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when they saw]{strong=“G1492” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 2”} [some]{strong=“G5100” x-morph=“robinson: X-\sc Apm\sc* 3”} [of]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 4 5”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 6”} [disciples]{strong=“G3101” x-morph=“robinson: N-\sc Gpm\sc* 5”} [eat]{strong=“G2068” x-morph=“robinson: V-\sc Pap\sc*-\sc Apm\sc* 12”} [bread]{strong=“G740” x-morph=“robinson: N-\sc Apm\sc* 13”} [with]{strong=“G5495” x-morph=“robinson: N-\sc Dpf\sc* 8”} [defiled]{strong=“G2839” x-morph=“robinson: A-\sc Dpf\sc* 7”}, [that]{strong=“G5124” x-morph=“robinson: D-\sc Nsn\sc* 9”} [is to say]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 10”}, [with unwashen]{strong=“G449” x-morph=“robinson: A-\sc Dpm\sc* 11”}, [hands]{strong=“G5495” x-morph=“robinson: N-\sc Dpf\sc* 8”}, [they found fault]{strong=“G3201” x-morph=“robinson: V-\sc Adi\sc*-3P 14”}. 
\v 3 [For]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 2”} [the Pharisees]{strong=“G5330” x-morph=“robinson: N-\sc Npm\sc* 3”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 4”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Npm\sc* 5”} [the Jews]{strong=“G2453” x-morph=“robinson: A-\sc Npm\sc* 7”}, [except]{strong=“G1437” x-morph=“robinson: \sc Cond\sc* 8”} [they wash]{strong=“G3538” x-morph=“robinson: V-\sc Ams\sc*-3P 11”} their [hands]{strong=“G3588 G5495” x-morph=“robinson: T-\sc Apf\sc* robinson: N-\sc Apf\sc* 12 13”} [oft]{strong=“G4435” x-morph=“robinson: N-\sc Dsf\sc* 10”}, [eat]{strong=“G2068” x-morph=“robinson: V-\sc Pai\sc*-3P 15”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 14”}, [holding]{strong=“G2902” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 16”} [the tradition]{strong=“G3588 G3862” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 17 18”} [of the elders]{strong=“G4245” x-morph=“robinson: A-\sc Gpm\sc* 20”}. 
\v 4 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} when they come [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 2”} [the market]{strong=“G58” x-morph=“robinson: N-\sc Gsf\sc* 3”}, [except]{strong=“G1437” x-morph=“robinson: \sc Cond\sc* 4”} [they wash]{strong=“G907” x-morph=“robinson: V-\sc Ams\sc*-3P 6”}, [they eat]{strong=“G2068” x-morph=“robinson: V-\sc Pai\sc*-3P 8”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 7”}. [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [many]{strong=“G4183” x-morph=“robinson: A-\sc Npn\sc* 11”} [other things]{strong=“G243” x-morph=“robinson: A-\sc Npn\sc* 10”} [there be]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 12”}, [which]{strong=“G3739” x-morph=“robinson: R-\sc Apn\sc* 13”} [they have received]{strong=“G3880” x-morph=“robinson: V-2\sc Aai\sc*-3P 14”} [to hold]{strong=“G2902” x-morph=“robinson: V-\sc Pan\sc* 15”}, as [the washing]{strong=“G909” x-morph=“robinson: N-\sc Apm\sc* 16”} [of cups]{strong=“G4221” x-morph=“robinson: N-\sc Gpn\sc* 17”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 18”} [pots]{strong=“G3582” x-morph=“robinson: N-\sc Gpm\sc* 19”}, [brasen vessels]{strong=“G5473” x-morph=“robinson: N-\sc Gpn\sc* 21”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 22”} [of tables]{strong=“G2825” x-morph=“robinson: N-\sc Gpf\sc* 23”}. 
\v 5 [Then]{strong=“G1899” x-morph=“robinson: \sc Adv\sc* 1”} [the Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 4 5”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [scribes]{strong=“G3588 G1122” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 7 8”} [asked]{strong=“G1905” x-morph=“robinson: V-\sc Pai\sc*-3P 2”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 3”}, [Why]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 10”} [walk]{strong=“G4043” x-morph=“robinson: V-\sc Pai\sc*-3P 15”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 14”} [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 13”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 11 12”} [according to]{strong=“G2596” x-morph=“robinson: \sc Prep\sc* 16”} [the tradition]{strong=“G3588 G3862” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 17 18”} [of the elders]{strong=“G4245” x-morph=“robinson: A-\sc Gpm\sc* 20”}, [but]{strong=“G235” x-morph=“robinson: \sc Conj\sc* 21”} [eat]{strong=“G2068” x-morph=“robinson: V-\sc Pai\sc*-3P 24”} [bread]{strong=“G3588 G740” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 25 26”} [with]{strong=“G5495” x-morph=“robinson: N-\sc Dpf\sc* 23”} [unwashen]{strong=“G449” x-morph=“robinson: A-\sc Dpm\sc* 22”} [hands]{strong=“G5495” x-morph=“robinson: N-\sc Dpf\sc* 23”}? 
\v 6 [He answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 3”} [and]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}, \wj Well hath Esaias prophesied of you hypocrites, as it is written, This people honoureth me with their lips, but their heart is far from me.\wj* 
\v 7 \wj Howbeit in vain do they worship me, teaching for doctrines the commandments of men.\wj* 
\v 8 \wj For laying aside the commandment of God, ye hold the tradition of men, as the washing of pots and cups: and many other such like things ye do.\wj* 
\v 9 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj Full well ye reject the commandment of God, that ye may keep your own tradition.\wj* 
\v 10 \wj For Moses said, Honour thy father and thy mother; and, Whoso curseth father or mother, let him die the death:\wj* 
\v 11 \wj But ye say, If a man shall say to his father or mother, It is Corban, that is to say, a gift, by whatsoever thou mightest be profited by me; he shall be free.\wj* 
\v 12 \wj And ye suffer him no more to do ought for his father or his mother;\wj* 
\v 13 \wj Making the word of God of none effect through your tradition, which ye have delivered: and many such like things do ye.\wj* 
\p
\v 14 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when he had called]{strong=“G4341” x-morph=“robinson: V-\sc Adp\sc*-\sc Nsm\sc* 2”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Asm\sc* 3”} [the people]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 4 5”} unto him, [he said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 6”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 7”}, \wj Hearken unto me every one of you, and understand:\wj* 
\v 15 \wj There is nothing from without a man, that entering into him can defile him: but the things which come out of him, those are they that defile the man.\wj* 
\v 16 \wj If any man have ears to hear, let him hear.\wj* 
\v 17 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when]{strong=“G3753” x-morph=“robinson: \sc Adv\sc* 2”} [he was entered]{strong=“G1525” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 4”} [the house]{strong=“G3624” x-morph=“robinson: N-\sc Asm\sc* 5”} [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 6”} [the people]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 7 8”}, [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 13”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 11 12”} [asked]{strong=“G1905” x-morph=“robinson: V-\sc Iai\sc*-3P 9”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 10”} [concerning]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 14”} [the parable]{strong=“G3588 G3850” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 15 16”}. 
\v 18 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj Are ye so without understanding also? Do ye not perceive, that whatsoever thing from without entereth into the man, it cannot defile him;\wj* 
\v 19 \wj Because it entereth not into his heart, but into the belly, and goeth out into the draught, purging all meats?\wj* 
\v 20 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3S 1”}, \wj That which cometh out of the man, that defileth the man.\wj* 
\v 21 \wj For from within, out of the heart of men, proceed evil thoughts, adulteries, fornications, murders,\wj* 
\v 22 \wj Thefts, covetousness, wickedness, deceit, lasciviousness, an evil eye, blasphemy, pride, foolishness:\wj* 
\v 23 \wj All these evil things come from within, and defile the man.\wj* 
\p
\v 24 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [from thence]{strong=“G1564” x-morph=“robinson: \sc Adv\sc* 2”} [he arose]{strong=“G450” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 3”}, [and went]{strong=“G565” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 5”} [the borders]{strong=“G3588 G3181” x-morph=“robinson: T-\sc Apn\sc* robinson: N-\sc Apn\sc* 6 7”} [of Tyre]{strong=“G5184” x-morph=“robinson: N-\sc Gsf\sc* 8”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [Sidon]{strong=“G4605” x-morph=“robinson: N-\sc Gsf\sc* 10”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [entered]{strong=“G1525” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 12”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 13”} [an house]{strong=“G3588 G3614” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 14 15”}, [and would have]{strong=“G2309” x-morph=“robinson: V-\sc Iai\sc*-3S 17”} [no man]{strong=“G3762” x-morph=“robinson: A-\sc Asm\sc* 16”} [know]{strong=“G1097” x-morph=“robinson: V-2\sc Aan\sc* 18”} it: [but]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 19”} [he could]{strong=“G1410” x-morph=“robinson: V-\sc Aoi\sc*-3S-\sc Att\sc* 21”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 20”} [be hid]{strong=“G2990” x-morph=“robinson: V-2\sc Aan\sc* 22”}. 
\v 25 [For]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 2”} [a]{strong=“G1135” x-morph=“robinson: N-\sc Nsf\sc* 3”} certain [woman]{strong=“G1135” x-morph=“robinson: N-\sc Nsf\sc* 3”}, [whose]{strong=“G3739” x-morph=“robinson: R-\sc Gsf\sc* 6”} [young daughter]{strong=“G3588 G2365” x-morph=“robinson: T-\sc Nsn\sc* robinson: N-\sc Nsn\sc* 8 9”} [had]{strong=“G2192” x-morph=“robinson: V-\sc Iai\sc*-3S 7”} [an]{strong=“G4151” x-morph=“robinson: N-\sc Asn\sc* 11”} [unclean]{strong=“G169” x-morph=“robinson: A-\sc Asn\sc* 12”} [spirit]{strong=“G4151” x-morph=“robinson: N-\sc Asn\sc* 11”}, [heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsf\sc* 1”} [of]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 4”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 5”}, [and came]{strong=“G2064” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsf\sc* 13”} [and fell]{strong=“G4363” x-morph=“robinson: V-2\sc Aai\sc*-3S 14”} [at]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 15”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 18”} [feet]{strong=“G3588 G4228” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 16 17”}: 
\v 26 [The woman]{strong=“G3588 G1135” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 3 4”} [was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 1”} [a Greek]{strong=“G1674” x-morph=“robinson: N-\sc Nsf\sc* 5”}, [a Syrophenician]{strong=“G4949” x-morph=“robinson: N-\sc Nsf\sc* 6”} [by nation]{strong=“G3588 G1085” x-morph=“robinson: T-\sc Dsn\sc* robinson: N-\sc Dsn\sc* 7 8”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [she besought]{strong=“G2065” x-morph=“robinson: V-\sc Iai\sc*-3S 10”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 11”} [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 12”} [he would cast forth]{strong=“G1544” x-morph=“robinson: V-\sc Pas\sc*-3S 15”} [the devil]{strong=“G3588 G1140” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 13 14”} [out]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 16”} [of]{strong=“G3588 G2364” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 17 18”} [her]{strong=“G846” x-morph=“robinson: P-\sc Gsf\sc* 19”} [daughter]{strong=“G2364” x-morph=“robinson: N-\sc Gsf\sc* 18”}. 
\v 27 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 3”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto her]{strong=“G846” x-morph=“robinson: P-\sc Dsf\sc* 5”}, \wj Let the children first be filled: for it is not meet to take the children’s bread, and to cast it unto the dogs.\wj* 
\v 28 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [she answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3S 3”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 4”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 5”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 6”}, [Yes]{strong=“G3483” x-morph=“robinson: \sc Prt\sc* 7”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 8”}: [yet]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 10”} [the dogs]{strong=“G3588 G2952” x-morph=“robinson: T-\sc Npn\sc* robinson: N-\sc Npn\sc* 11 12”} [under]{strong=“G5270” x-morph=“robinson: \sc Adv\sc* 13”} [the table]{strong=“G3588 G5132” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 14 15”} [eat]{strong=“G2068” x-morph=“robinson: V-\sc Pai\sc*-3S 16”} [of]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 17”} [the children’s]{strong=“G3588 G3813” x-morph=“robinson: T-\sc Gpn\sc* robinson: N-\sc Gpn\sc* 20 21”} [crumbs]{strong=“G3588 G5589” x-morph=“robinson: T-\sc Gpn\sc* robinson: N-\sc Gpn\sc* 18 19”}. 
\v 29 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”} [unto her]{strong=“G846” x-morph=“robinson: P-\sc Dsf\sc* 3”}, \wj For this saying go thy way; the devil is gone out of thy daughter.\wj* 
\v 30 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when she was come]{strong=“G565” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsf\sc* 2”} [to]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 3”} [her]{strong=“G846” x-morph=“robinson: P-\sc Gsf\sc* 6”} [house]{strong=“G3588 G3624” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 4 5”}, [she found]{strong=“G2147” x-morph=“robinson: V-2\sc Aai\sc*-3S 7”} [the devil]{strong=“G3588 G1140” x-morph=“robinson: T-\sc Nsn\sc* robinson: N-\sc Nsn\sc* 8 9”} [gone out]{strong=“G1831” x-morph=“robinson: V-\sc Rap\sc*-\sc Asn\sc* 10”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [her daughter]{strong=“G3588 G2364” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 12 13”} [laid]{strong=“G906” x-morph=“robinson: V-\sc Rpp\sc*-\sc Asf\sc* 14”} [upon]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 15”} [the bed]{strong=“G3588 G2825” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 16 17”}. 
\p
\v 31 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [again]{strong=“G3825” x-morph=“robinson: \sc Adv\sc* 2”}, [departing]{strong=“G1831” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 3”} [from]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 4”} [the coasts]{strong=“G3588 G3725” x-morph=“robinson: T-\sc Gpn\sc* robinson: N-\sc Gpn\sc* 5 6”} [of Tyre]{strong=“G5184” x-morph=“robinson: N-\sc Gsf\sc* 7”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [Sidon]{strong=“G4605” x-morph=“robinson: N-\sc Gsf\sc* 9”}, [he came]{strong=“G2064” x-morph=“robinson: V-2\sc Aai\sc*-3S 10”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 11”} [the sea]{strong=“G3588 G2281” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 12 13”} [of Galilee]{strong=“G3588 G1056” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 14 15”}, [through]{strong=“G303” x-morph=“robinson: \sc Prep\sc* 16”} [the midst]{strong=“G3319” x-morph=“robinson: A-\sc Asn\sc* 17”} [of the coasts]{strong=“G3588 G3725” x-morph=“robinson: T-\sc Gpn\sc* robinson: N-\sc Gpn\sc* 18 19”} [of Decapolis]{strong=“G1179” x-morph=“robinson: N-\sc Gsf\sc* 20”}. 
