\v 48 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [many]{strong=“G4183” x-morph=“robinson: A-\sc Npm\sc* 4”} [charged]{strong=“G2008” x-morph=“robinson: V-\sc Iai\sc*-3P 2”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”} [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 5”} [he should hold his peace]{strong=“G4623” x-morph=“robinson: V-\sc Aas\sc*-3S 6”}: [but]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 8”} [he cried]{strong=“G2896” x-morph=“robinson: V-\sc Iai\sc*-3S 11”} [the more]{strong=“G3123” x-morph=“robinson: \sc Adv\sc* 10”} [a great deal]{strong=“G4183” x-morph=“robinson: A-\sc Dsn\sc* 9”}, Thou [Son]{strong=“G5207” x-morph=“robinson: N-\sc Vsm\sc* 12”} [of David]{strong=“G1138” x-morph=“robinson: N-\sc Pri\sc* 13”}, [have mercy on]{strong=“G1653” x-morph=“robinson: V-\sc Aam\sc*-2S 14”} [me]{strong=“G3165” x-morph=“robinson: P-1\sc As\sc* 15”}. 
\v 49 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [stood still]{strong=“G2476” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”}, [and commanded]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 6”} [to be called]{strong=“G5455” x-morph=“robinson: V-\sc Apn\sc* 7”}. [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [they call]{strong=“G5455” x-morph=“robinson: V-\sc Pai\sc*-3P 9”} [the blind man]{strong=“G5185” x-morph=“robinson: A-\sc Asm\sc* 11”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 12”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 13”}, [Be of good comfort]{strong=“G2293” x-morph=“robinson: V-\sc Pam\sc*-2S 14”}, [rise]{strong=“G1453” x-morph=“robinson: V-\sc Amm\sc*-2S 15”}; [he calleth]{strong=“G5455” x-morph=“robinson: V-\sc Pai\sc*-3S 16”} [thee]{strong=“G4571” x-morph=“robinson: P-2\sc As\sc* 17”}. 
