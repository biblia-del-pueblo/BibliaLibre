\v 14 [Now]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} the disciples [had forgotten]{strong=“G1950” x-morph=“robinson: V-2\sc Adi\sc*-3P 2”} [to take]{strong=“G2983” x-morph=“robinson: V-2\sc Aan\sc* 3”} [bread]{strong=“G740” x-morph=“robinson: N-\sc Apm\sc* 4”}, [neither ]{strong=“G3756 G3361 G1487 G2532” x-morph=“robinson: \sc Prt\sc*-N robinson: \sc Prt\sc*-N robinson: \sc Cond\sc* robinson: \sc Conj\sc* 10 7 6 5”} [had they]{strong=“G2192” x-morph=“robinson: V-\sc Iai\sc*-3P 11”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 14”} [the ship]{strong=“G3588 G4143” x-morph=“robinson: T-\sc Dsn\sc* robinson: N-\sc Dsn\sc* 15 16”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 12”} [them]{strong=“G1438” x-morph=“robinson: F-3\sc Gpm\sc* 13”} more than [one]{strong=“G1520” x-morph=“robinson: A-\sc Asm\sc* 8”} [loaf]{strong=“G740” x-morph=“robinson: N-\sc Asm\sc* 9”}. 
