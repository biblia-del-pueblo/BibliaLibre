\v 40 \w And at the time| strong="H6256" \w* \w of the end| strong="H7093" \w* \w shall the king| strong="H4428" \w* \w of the south| strong="H5045" \w* [push]{strong=“H5055” x-morph=“strongMorph: \sc Th\sc*8691”} [at him: and the king]{strong=“H4428”} \w of the north| strong="H6828" \w* [shall come against him like a whirlwind]{strong=“H8175” x-morph=“strongMorph: \sc Th\sc*8691”}, \w with chariots| strong="H7393" \w*, \w and with horsemen| strong="H6571" \w*, \w and with many| strong="H7227" \w* \w ships| strong="H591" \w*; [and he shall enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the countries| strong="H776" \w*, [and shall overflow]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8804”} [and pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 41 [He shall enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w also into the glorious| strong="H6643" \w* \w land| strong="H776" \w*, \w and many| strong="H7227" \w* countries [shall be overthrown]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8735”}: [but these shall escape]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8735”} \w out of his hand| strong="H3027" \w*, even \w Edom| strong="H123" \w*, \w and Moab| strong="H4124" \w*, \w and the chief| strong="H7225" \w* \w of the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w*.\f + \fr 11:41 \ft glorious…: or, goodly, etc.: Heb. land of delight, or, ornament \f* 
\v 42 [He shall stretch forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w his hand| strong="H3027" \w* \w also upon the countries| strong="H776" \w*: \w and the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* \w shall not escape| strong="H6413" \w*.\f + \fr 11:42 \ft stretch…: Heb. send forth \f* 
\v 43 [But he shall have power]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8804”} \w over the treasures| strong="H4362" \w* \w of gold| strong="H2091" \w* \w and of silver| strong="H3701" \w*, \w and over all the precious| strong="H2532" \w* \w things of Egypt| strong="H4714" \w*: \w and the Libyans| strong="H3864" \w* \w and the Ethiopians| strong="H3569" \w* shall be \w at his steps| strong="H4703" \w*. 
\v 44 \w But tidings| strong="H8052" \w* \w out of the east| strong="H4217" \w* \w and out of the north| strong="H6828" \w* [shall trouble]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8762”} [him: therefore he shall go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w with great| strong="H1419" \w* \w fury| strong="H2534" \w* [to destroy]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8687”}, [and utterly to make away]{strong=“H2763” x-morph=“strongMorph: \sc Th\sc*8687”} \w many| strong="H7227" \w*. 
\v 45 [And he shall plant]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8799”} \w the tabernacles| strong="H168" \w* \w of his palace| strong="H643" \w* \w between the seas| strong="H3220" \w* \w in the glorious| strong="H6643" \w* \w holy| strong="H6944" \w* \w mountain| strong="H2022" \w*; [yet he shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w to his end| strong="H7093" \w*, [and none shall help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8802”} him.\f + \fr 11:45 \ft glorious…: or, goodly, etc.: Heb. mountain of delight of holiness \f*
\c 12
\p 
\v 1 \w And at that time| strong="H6256" \w* \w shall Michael| strong="H4317" \w* [stand up]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”}, \w the great| strong="H1419" \w* \w prince| strong="H8269" \w* [which standeth]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w for the children| strong="H1121" \w* \w of thy people| strong="H5971" \w*: [and there shall be]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8738”} \w a time| strong="H6256" \w* \w of trouble| strong="H6869" \w*, \w such as never was since there was a nation| strong="H1471" \w* even \w to that same time| strong="H6256" \w*: \w and at that time| strong="H6256" \w* \w thy people| strong="H5971" \w* [shall be delivered]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8735”}, [every one that shall be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8737”} [written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8803”} \w in the book| strong="H5612" \w*. 
\v 2 \w And many| strong="H7227" \w* \w of them that sleep| strong="H3463" \w* \w in the dust| strong="H6083" \w* \w of the earth| strong="H127" \w* [shall awake]{strong=“H6974” x-morph=“strongMorph: \sc Th\sc*8686”}, \w some to everlasting| strong="H5769" \w* \w life| strong="H2416" \w*, \w and some to shame| strong="H2781" \w* and \w everlasting| strong="H5769" \w* \w contempt| strong="H1860" \w*. 
\v 3 [And they that be wise]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8688”} [shall shine]{strong=“H2094” x-morph=“strongMorph: \sc Th\sc*8686”} \w as the brightness| strong="H2096" \w* \w of the firmament| strong="H7549" \w*; \w and they that turn many| strong="H7227" \w* [to righteousness]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8688”} \w as the stars| strong="H3556" \w* \w for ever| strong="H5769" \w* \w and ever| strong="H5703" \w*.\f + \fr 12:3 \ft wise: or, teachers \f* 
\v 4 [But thou, O Daniel]{strong=“H1840”}, [shut up]{strong=“H5640” x-morph=“strongMorph: \sc Th\sc*8798”} \w the words| strong="H1697" \w*, [and seal]{strong=“H2856” x-morph=“strongMorph: \sc Th\sc*8798”} \w the book| strong="H5612" \w*, even \w to the time| strong="H6256" \w* \w of the end| strong="H7093" \w*: \w many| strong="H7227" \w* [shall run to and fro]{strong=“H7751” x-morph=“strongMorph: \sc Th\sc*8787”}, \w and knowledge| strong="H1847" \w* [shall be increased]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 5 \w Then I Daniel| strong="H1840" \w* [looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”}, [and, behold, there stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w other| strong="H312" \w* \w two| strong="H8147" \w*, \w the one| strong="H259" \w* \w on this side| strong="H2008" \w* \w of the bank| strong="H8193" \w* \w of the river| strong="H2975" \w*, \w and the other| strong="H259" \w* \w on that side of the bank| strong="H8193" \w* \w of the river| strong="H2975" \w*.\f + \fr 12:5 \ft bank: Heb. lip \f* \f + \fr 12:5 \ft bank: Heb. lip \f* 
\v 6 And one [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the man| strong="H376" \w* [clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8803”} \w in linen| strong="H906" \w*, which was \w upon| strong="H4605" \w* \w the waters| strong="H4325" \w* \w of the river| strong="H2975" \w*, How long shall it be to \w the end| strong="H7093" \w* \w of these wonders| strong="H6382" \w*?\f + \fr 12:6 \ft upon…: or, from above \f* 
\v 7 [And I heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w the man| strong="H376" \w* [clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8803”} \w in linen| strong="H906" \w*, which was \w upon| strong="H4605" \w* \w the waters| strong="H4325" \w* \w of the river| strong="H2975" \w*, [when he held up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} \w his right hand| strong="H3225" \w* \w and his left hand| strong="H8040" \w* \w unto heaven| strong="H8064" \w*, [and sware]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8735”} \w by him that liveth| strong="H2416" \w* \w for ever| strong="H5769" \w* that it shall be \w for a time| strong="H4150" \w*, \w times| strong="H4150" \w*, \w and an half| strong="H2677" \w*; [and when he shall have accomplished]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8763”} [to scatter]{strong=“H5310” x-morph=“strongMorph: \sc Th\sc*8763”} \w the power| strong="H3027" \w* \w of the holy| strong="H6944" \w* \w people| strong="H5971" \w*, all these things [shall be finished]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 12:7 \ft a time…: or, part \f* 
\v 8 [And I heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}, [but I understood]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} [not: then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [I, O my Lord]{strong=“H113”}, what shall be \w the end| strong="H319" \w* of these things? 
\v 9 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Go thy way]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, \w Daniel| strong="H1840" \w*: \w for the words| strong="H1697" \w* are [closed up]{strong=“H5640” x-morph=“strongMorph: \sc Th\sc*8803”} [and sealed]{strong=“H2856” x-morph=“strongMorph: \sc Th\sc*8803”} \w till the time| strong="H6256" \w* \w of the end| strong="H7093" \w*. 
\v 10 \w Many| strong="H7227" \w* [shall be purified]{strong=“H1305” x-morph=“strongMorph: \sc Th\sc*8691”}, [and made white]{strong=“H3835” x-morph=“strongMorph: \sc Th\sc*8691”}, [and tried]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8735”}; \w but the wicked| strong="H7563" \w* [shall do wickedly]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8689”}: \w and none of the wicked| strong="H7563" \w* [shall understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”}; [but the wise]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8688”} [shall understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 11 \w And from the time| strong="H6256" \w* that \w the daily| strong="H8548" \w* sacrifice [shall be taken away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8717”}, \w and the abomination| strong="H8251" \w* [that maketh desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8802”} [set up]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”}, there shall be \w a thousand| strong="H505" \w* \w two hundred| strong="H3967" \w* \w and ninety| strong="H8673" \w* \w days| strong="H3117" \w*.\f + \fr 12:11 \ft the abomination: Heb. to set up the abomination \f* \f + \fr 12:11 \ft maketh…: or, astonisheth \f* 
\v 12 \w Blessed| strong="H835" \w* is [he that waiteth]{strong=“H2442” x-morph=“strongMorph: \sc Th\sc*8764”}, [and cometh]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8686”} \w to the thousand| strong="H505" \w* \w three| strong="H7969" \w* \w hundred| strong="H3967" \w* \w and five| strong="H2568" \w* \w and thirty| strong="H7970" \w* \w days| strong="H3117" \w*. 
\v 13 [But go thou thy way]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} \w till the end| strong="H7093" \w* be: [for thou shalt rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8799”}, [and stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy lot| strong="H1486" \w* \w at the end| strong="H7093" \w* \w of the days| strong="H3117" \w*.\f + \fr 12:13 \ft for thou: or, and thou, etc \f* 
