\c 11
\p 
\v 1 \w Also I in the first| strong="H259" \w* \w year| strong="H8141" \w* \w of Darius| strong="H1867" \w* \w the Mede| strong="H4075" \w*, even [I, stood]{strong=“H5977”} [to confirm]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8688”} \w and to strengthen| strong="H4581" \w* him. 
\v 2 [And now will I shew]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee the truth| strong="H571" \w*. [Behold, there shall stand up]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w yet three| strong="H7969" \w* \w kings| strong="H4428" \w* \w in Persia| strong="H6539" \w*; \w and the fourth| strong="H7243" \w* \w shall be far| strong="H6239" \w* [richer]{strong=“H6238” x-morph=“strongMorph: \sc Th\sc*8686”} than they \w all| strong="H1419" \w*: \w and by his strength| strong="H2393" \w* \w through his riches| strong="H6239" \w* [he shall stir up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8686”} \w all against the realm| strong="H4438" \w* \w of Grecia| strong="H3120" \w*. 
\v 3 \w And a mighty| strong="H1368" \w* \w king| strong="H4428" \w* [shall stand up]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”}, [that shall rule]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8804”} \w with great| strong="H7227" \w* \w dominion| strong="H4474" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w according to his will| strong="H7522" \w*. 
\v 4 [And when he shall stand up]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8800”}, \w his kingdom| strong="H4438" \w* [shall be broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8735”}, [and shall be divided]{strong=“H2673” x-morph=“strongMorph: \sc Th\sc*8735”} \w toward the four| strong="H702" \w* \w winds| strong="H7307" \w* \w of heaven| strong="H8064" \w*; \w and not to his posterity| strong="H319" \w*, \w nor according to his dominion| strong="H4915" \w* [which he ruled]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8804”}: \w for his kingdom| strong="H4438" \w* [shall be plucked up]{strong=“H5428” x-morph=“strongMorph: \sc Th\sc*8735”}, \w even for others| strong="H312" \w* beside those. 
\p
\v 5 \w And the king| strong="H4428" \w* \w of the south| strong="H5045" \w* [shall be strong]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8799”}, and one \w of his princes| strong="H8269" \w*; [and he shall be strong]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8799”} [above him, and have dominion]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8804”}; \w his dominion| strong="H4475" \w* shall be \w a great| strong="H7227" \w* \w dominion| strong="H4474" \w*. 
\v 6 \w And in the end| strong="H7093" \w* \w of years| strong="H8141" \w* [they shall join themselves together]{strong=“H2266” x-morph=“strongMorph: \sc Th\sc*8691”}; [for the king’s]{strong=“H4428”} \w daughter| strong="H1323" \w* \w of the south| strong="H5045" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the king| strong="H4428" \w* \w of the north| strong="H6828" \w* [to make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w an agreement| strong="H4339" \w*: [but she shall not retain]{strong=“H6113” x-morph=“strongMorph: \sc Th\sc*8799”} \w the power| strong="H3581" \w* \w of the arm| strong="H2220" \w*; [neither shall he stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”}, \w nor his arm| strong="H2220" \w*: [but she shall be given up]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8735”}, [and they that brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} [her, and he that begat]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”} [her, and he that strengthened]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8688”} her in these \w times| strong="H6256" \w*.\f + \fr 11:6 \ft join…: Heb. associate themselves \f* \f + \fr 11:6 \ft an…: Heb. rights \f* \f + \fr 11:6 \ft he that begat…: or, whom she brought forth \f* 
\v 7 \w But out of a branch| strong="H5342" \w* \w of her roots| strong="H8328" \w* shall one [stand up]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his estate| strong="H3653" \w*, [which shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w with an army| strong="H2428" \w*, [and shall enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the fortress| strong="H4581" \w* \w of the king| strong="H4428" \w* \w of the north| strong="H6828" \w*, [and shall deal]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [against them, and shall prevail]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8689”}:\f + \fr 11:7 \ft in…: or, in his place, or, office \f* 
\v 8 [And shall also carry]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w captives| strong="H7628" \w* \w into Egypt| strong="H4714" \w* \w their gods| strong="H430" \w*, \w with their princes| strong="H5257" \w*, and \w with their precious| strong="H2532" \w* \w vessels| strong="H3627" \w* \w of silver| strong="H3701" \w* \w and of gold| strong="H2091" \w*; [and he shall continue]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} more \w years| strong="H8141" \w* \w than the king| strong="H4428" \w* \w of the north| strong="H6828" \w*.\f + \fr 11:8 \ft their precious…: Heb. vessels of their desire \f* 
\v 9 \w So the king| strong="H4428" \w* \w of the south| strong="H5045" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} into his \w kingdom| strong="H4438" \w*, [and shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w into his own land| strong="H127" \w*. 
\v 10 \w But his sons| strong="H1121" \w* [shall be stirred up]{strong=“H1624” x-morph=“strongMorph: \sc Th\sc*8691”}, [and shall assemble]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8804”} \w a multitude| strong="H1995" \w* \w of great| strong="H7227" \w* \w forces| strong="H2428" \w*: and one [shall certainly]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, [and overflow]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8804”}, [and pass through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”}: [then shall he return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [and be stirred up]{strong=“H1624” x-morph=“strongMorph: \sc Th\sc*8691”}, even \w to his fortress| strong="H4581" \w*.\f + \fr 11:10 \ft shall be…: or, shall war \f* \f + \fr 11:10 \ft return…: or, be stirred up again \f* 
\v 11 \w And the king| strong="H4428" \w* \w of the south| strong="H5045" \w* [shall be moved with choler]{strong=“H4843” x-morph=“strongMorph: \sc Th\sc*8698”}, [and shall come forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} [and fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8738”} with him, even \w with the king| strong="H4428" \w* \w of the north| strong="H6828" \w*: [and he shall set forth]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8689”} \w a great| strong="H7227" \w* \w multitude| strong="H1995" \w*; \w but the multitude| strong="H1995" \w* [shall be given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w into his hand| strong="H3027" \w*. 
