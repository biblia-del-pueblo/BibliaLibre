\v 1 \w In the third| strong="H7969" \w* \w year| strong="H8141" \w* \w of the reign| strong="H4438" \w* \w of king| strong="H4428" \w* \w Belshazzar| strong="H1112" \w* \w a vision| strong="H2377" \w* [appeared]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8738”} unto me, even unto \w me Daniel| strong="H1840" \w*, \w after| strong="H310" \w* [that which appeared]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto me at the first| strong="H8462" \w*. 
\v 2 [And I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w in a vision| strong="H2377" \w*; [and it came to pass, when I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”}, that I was \w at Shushan| strong="H7800" \w* in \w the palace| strong="H1002" \w*, which is \w in the province| strong="H4082" \w* \w of Elam| strong="H5867" \w*; [and I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w in a vision| strong="H2377" \w*, \w and I was by the river| strong="H180" \w* \w of Ulai| strong="H195" \w*. 
\v 3 [Then I lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w mine eyes| strong="H5869" \w*, [and saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, [and, behold, there stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w before| strong="H6440" \w* \w the river| strong="H180" \w* \w a| strong="H259" \w* \w ram| strong="H352" \w* which had two \w horns| strong="H7161" \w*: and the two \w horns| strong="H7161" \w* were \w high| strong="H1364" \w*; \w but one| strong="H259" \w* was \w higher| strong="H1364" \w* \w than the other| strong="H8145" \w*, \w and the higher| strong="H1364" \w* [came up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8802”} \w last| strong="H314" \w*.\f + \fr 8:3 \ft the other: Heb. the second \f* 
\v 4 [I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the ram| strong="H352" \w* [pushing]{strong=“H5055” x-morph=“strongMorph: \sc Th\sc*8764”} \w westward| strong="H3220" \w*, \w and northward| strong="H6828" \w*, \w and southward| strong="H5045" \w*; \w so that no beasts| strong="H2416" \w* [might stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* him, neither was there any [that could deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8688”} \w out of his hand| strong="H3027" \w*; [but he did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w according to his will| strong="H7522" \w*, [and became great]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\v 5 [And as I was considering]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8688”}, [behold, an he]{strong=“H5795”} \w goat| strong="H6842" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w from the west| strong="H4628" \w* \w on the face| strong="H6440" \w* \w of the whole earth| strong="H776" \w*, [and touched]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8802”} \w not the ground| strong="H776" \w*: \w and the goat| strong="H6842" \w* had \w a notable| strong="H2380" \w* \w horn| strong="H7161" \w* \w between his eyes| strong="H5869" \w*.\f + \fr 8:5 \ft touched…: or, none touched him in the earth \f* \f + \fr 8:5 \ft a notable…: Heb. a horn of sight \f* 
\v 6 [And he came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the ram| strong="H352" \w* \w that had| strong="H1167" \w* two \w horns| strong="H7161" \w*, [which I had seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} [standing]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w before| strong="H6440" \w* \w the river| strong="H180" \w*, [and ran]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto him in the fury| strong="H2534" \w* \w of his power| strong="H3581" \w*. 
\v 7 [And I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} [him come]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8688”} \w close unto| strong="H681" \w* \w the ram| strong="H352" \w*, [and he was moved with choler]{strong=“H4843” x-morph=“strongMorph: \sc Th\sc*8698”} [against him, and smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w the ram| strong="H352" \w*, [and brake]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8762”} \w his two| strong="H8147" \w* \w horns| strong="H7161" \w*: \w and there was no power| strong="H3581" \w* \w in the ram| strong="H352" \w* [to stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8800”} \w before| strong="H6440" \w* [him, but he cast him down]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w to the ground| strong="H776" \w*, [and stamped]{strong=“H7429” x-morph=“strongMorph: \sc Th\sc*8799”} [upon him: and there was none that could deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8688”} \w the ram| strong="H352" \w* \w out of his hand| strong="H3027" \w*. 
\v 8 \w Therefore the he| strong="H6842" \w* \w goat| strong="H5795" \w* \w waxed very| strong="H3966" \w* [great]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8689”}: [and when he was strong]{strong=“H6105” x-morph=“strongMorph: \sc Th\sc*8800”}, \w the great| strong="H1419" \w* \w horn| strong="H7161" \w* [was broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8738”}; [and for it came up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w four| strong="H702" \w* \w notable ones| strong="H2380" \w* \w toward the four| strong="H702" \w* \w winds| strong="H7307" \w* \w of heaven| strong="H8064" \w*. 
\v 9 \w And out of one| strong="H259" \w* [of them came forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w a little| strong="H4704" \w* \w horn| strong="H7161" \w*, \w which waxed exceeding| strong="H3499" \w* [great]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8799”}, \w toward the south| strong="H5045" \w*, \w and toward the east| strong="H4217" \w*, \w and toward the pleasant| strong="H6643" \w* land. 
\v 10 [And it waxed great]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8799”}, even \w to the host| strong="H6635" \w* \w of heaven| strong="H8064" \w*; [and it cast down]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8686”} some \w of the host| strong="H6635" \w* \w and of the stars| strong="H3556" \w* \w to the ground| strong="H776" \w*, [and stamped]{strong=“H7429” x-morph=“strongMorph: \sc Th\sc*8799”} upon them.\f + \fr 8:10 \ft to the host: or, against the host \f* 
\v 11 [Yea, he magnified]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8689”} himself \w even to the prince| strong="H8269" \w* \w of the host| strong="H6635" \w*, \w and by him the daily| strong="H8548" \w* sacrifice [was taken away]{strong=“H7311 H7311” x-morph=“strongMorph: \sc Th\sc*8689 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8717”}, \w and the place| strong="H4349" \w* \w of his sanctuary| strong="H4720" \w* [was cast down]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8717”}.\f + \fr 8:11 \ft to: or, against \f* \f + \fr 8:11 \ft by him: or, from him \f* 
\v 12 \w And an host| strong="H6635" \w* [was given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8735”} him \w against the daily| strong="H8548" \w* sacrifice \w by reason of transgression| strong="H6588" \w*, [and it cast down]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w the truth| strong="H571" \w* \w to the ground| strong="H776" \w*; [and it practised]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [and prospered]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8689”}.\f + \fr 8:12 \ft an host…: or, the host was given over for the transgression against the daily sacrifice \f* 
\p
\v 13 [Then I heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w one| strong="H259" \w* \w saint| strong="H6918" \w* [speaking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8764”}, \w and another| strong="H259" \w* \w saint| strong="H6918" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto that certain| strong="H6422" \w* saint [which spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8764”}, How long shall be \w the vision| strong="H2377" \w* concerning \w the daily| strong="H8548" \w* sacrifice, \w and the transgression| strong="H6588" \w* [of desolation]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8802”}, [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w both the sanctuary| strong="H6944" \w* \w and the host| strong="H6635" \w* \w to be trodden under foot| strong="H4823" \w*?\f + \fr 8:13 \ft that…: or, the numberer of secrets, or, the wonderful numberer: Heb. Palmoni \f* \f + \fr 8:13 \ft of…: or, making desolate \f* 
\v 14 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Unto two thousand]{strong=“H505”} \w and three| strong="H7969" \w* \w hundred| strong="H3967" \w* [days]{strong=“H1242 H6153”}; \w then shall the sanctuary| strong="H6944" \w* [be cleansed]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8738”}.\f + \fr 8:14 \ft days: Heb. evening morning \f* \f + \fr 8:14 \ft cleansed: Heb. justified \f* 
\p
\v 15 And it came to pass, when I, even \w I Daniel| strong="H1840" \w*, [had seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w the vision| strong="H2377" \w*, [and sought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w for the meaning| strong="H998" \w*, [then, behold, there stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w before me as the appearance| strong="H4758" \w* \w of a man| strong="H1397" \w*. 
\v 16 [And I heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [a man’s]{strong=“H120”} \w voice| strong="H6963" \w* between the banks of \w Ulai| strong="H195" \w*, [which called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Gabriel| strong="H1403" \w*, \w make this| strong="H1975" \w* man [to understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8685”} \w the vision| strong="H4758" \w*. 
\v 17 [So he came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w near| strong="H681" \w* \w where I stood| strong="H5977" \w*: [and when he came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}, [I was afraid]{strong=“H1204” x-morph=“strongMorph: \sc Th\sc*8738”}, [and fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon my face| strong="H6440" \w*: [but he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8685”}, \w O son| strong="H1121" \w* \w of man| strong="H120" \w*: \w for at the time| strong="H6256" \w* \w of the end| strong="H7093" \w* shall be \w the vision| strong="H2377" \w*. 
\v 18 [Now as he was speaking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} [with me, I was in a deep sleep]{strong=“H7290” x-morph=“strongMorph: \sc Th\sc*8738”} \w on my face| strong="H6440" \w* \w toward the ground| strong="H776" \w*: [but he touched]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8799”} [me, and set]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8686”} \w me upright| strong="H5977" \w*.\f + \fr 8:18 \ft set…: Heb. made me stand upon my standing \f* 
\v 19 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Behold, I will make thee know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8688”} \w what shall be in the last end| strong="H319" \w* \w of the indignation| strong="H2195" \w*: \w for at the time appointed| strong="H4150" \w* \w the end| strong="H7093" \w* shall be. 
\v 20 \w The ram| strong="H352" \w* [which thou sawest]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w having| strong="H1167" \w* two \w horns| strong="H7161" \w* are \w the kings| strong="H4428" \w* \w of Media| strong="H4074" \w* \w and Persia| strong="H6539" \w*. 
\v 21 \w And the rough| strong="H8163" \w* \w goat| strong="H6842" \w* is \w the king| strong="H4428" \w* \w of Grecia| strong="H3120" \w*: \w and the great| strong="H1419" \w* \w horn| strong="H7161" \w* that is \w between his eyes| strong="H5869" \w* is \w the first| strong="H7223" \w* \w king| strong="H4428" \w*. 
\v 22 [Now that being broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8737”}, \w whereas four| strong="H702" \w* [stood up]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} [for it, four]{strong=“H702”} \w kingdoms| strong="H4438" \w* [shall stand up]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of the nation| strong="H1471" \w*, \w but not in his power| strong="H3581" \w*. 
\v 23 \w And in the latter time| strong="H319" \w* \w of their kingdom| strong="H4438" \w*, [when the transgressors]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8802”} [are come to the full]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8687”}, \w a king| strong="H4428" \w* \w of fierce| strong="H5794" \w* \w countenance| strong="H6440" \w*, [and understanding]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8688”} \w dark sentences| strong="H2420" \w*, [shall stand up]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 8:23 \ft are…: Heb. are accomplished \f* 
\v 24 \w And his power| strong="H3581" \w* [shall be mighty]{strong=“H6105” x-morph=“strongMorph: \sc Th\sc*8804”}, \w but not by his own power| strong="H3581" \w*: [and he shall destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8686”} [wonderfully]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”}, [and shall prosper]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8689”}, [and practise]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [and shall destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8689”} \w the mighty| strong="H6099" \w* \w and the holy| strong="H6918" \w* \w people| strong="H5971" \w*.\f + \fr 8:24 \ft holy…: Heb. people of the holy ones \f* 
\v 25 \w And through his policy| strong="H7922" \w* \w also he shall cause craft| strong="H4820" \w* [to prosper]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8689”} \w in his hand| strong="H3027" \w*; [and he shall magnify]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8686”} himself \w in his heart| strong="H3824" \w*, \w and by peace| strong="H7962" \w* [shall destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8686”} \w many| strong="H7227" \w*: [he shall also stand up]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w against the Prince| strong="H8269" \w* \w of princes| strong="H8269" \w*; [but he shall be broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8735”} \w without| strong="H657" \w* \w hand| strong="H3027" \w*.\f + \fr 8:25 \ft peace: or, prosperity \f* 
\v 26 \w And the vision| strong="H4758" \w* \w of the evening| strong="H6153" \w* \w and the morning| strong="H1242" \w* [which was told]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8738”} is \w true| strong="H571" \w*: [wherefore shut thou up]{strong=“H5640” x-morph=“strongMorph: \sc Th\sc*8798”} \w the vision| strong="H2377" \w*; for it shall be \w for many| strong="H7227" \w* \w days| strong="H3117" \w*. 
\v 27 \w And I Daniel| strong="H1840" \w* [fainted]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8738”}, [and was sick]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8738”} certain \w days| strong="H3117" \w*; [afterward I rose up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [the king’s]{strong=“H4428”} \w business| strong="H4399" \w*; [and I was astonished]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8709”} \w at the vision| strong="H4758" \w*, [but none understood]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8688”} it.
\c 9
\p 
\v 1 \w In the first| strong="H259" \w* \w year| strong="H8141" \w* \w of Darius| strong="H1867" \w* \w the son| strong="H1121" \w* \w of Ahasuerus| strong="H325" \w*, \w of the seed| strong="H2233" \w* \w of the Medes| strong="H4074" \w*, [which was made king]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8717”} \w over the realm| strong="H4438" \w* \w of the Chaldeans| strong="H3778" \w*;\f + \fr 9:1 \ft which: or, in which he \f* 
\v 2 \w In the first| strong="H259" \w* \w year| strong="H8141" \w* [of his reign]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8800”} \w I Daniel| strong="H1840" \w* [understood]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8804”} \w by books| strong="H5612" \w* \w the number| strong="H4557" \w* \w of the years| strong="H8141" \w*, \w whereof the word| strong="H1697" \w* of the \sc Lord\sc* \w came to Jeremiah| strong="H3414" \w* \w the prophet| strong="H5030" \w*, [that he would accomplish]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8763”} \w seventy| strong="H7657" \w* \w years| strong="H8141" \w* \w in the desolations| strong="H2723" \w* \w of Jerusalem| strong="H3389" \w*. 
\p
\v 3 [And I set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w my face| strong="H6440" \w* \w unto the Lord| strong="H136" \w* \w God| strong="H430" \w*, [to seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8763”} \w by prayer| strong="H8605" \w* \w and supplications| strong="H8469" \w*, \w with fasting| strong="H6685" \w*, \w and sackcloth| strong="H8242" \w*, \w and ashes| strong="H665" \w*: 
\p
\v 4 [And I prayed]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8691”} unto the \sc Lord\sc* \w my God| strong="H430" \w*, [and made my confession]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8691”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w O| strong="H577" \w* \w Lord| strong="H136" \w*, \w the great| strong="H1419" \w* [and dreadful]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”} \w God| strong="H410" \w*, [keeping]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w the covenant| strong="H1285" \w* \w and mercy| strong="H2617" \w* [to them that love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} [him, and to them that keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w his commandments| strong="H4687" \w*; 
\v 5 [We have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}, [and have committed iniquity]{strong=“H5753” x-morph=“strongMorph: \sc Th\sc*8804”}, [and have done wickedly]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8689”}, [and have rebelled]{strong=“H4775” x-morph=“strongMorph: \sc Th\sc*8804”}, [even by departing]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8800”} \w from thy precepts| strong="H4687" \w* \w and from thy judgments| strong="H4941" \w*: 
