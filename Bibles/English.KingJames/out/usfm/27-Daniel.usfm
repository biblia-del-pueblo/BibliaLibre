\v 6 \w But if| strong="H2006" \w* [ye shew]{strong=“H2324” x-morph=“strongMorph: \sc Th\sc*8681”} \w the dream| strong="H2493" \w*, \w and the interpretation| strong="H6591" \w* [thereof, ye shall receive]{strong=“H6902” x-morph=“strongMorph: \sc Th\sc*8741”} \w of| strong="H4481" \w* \w me| strong="H6925" \w* \w gifts| strong="H4978" \w* \w and rewards| strong="H5023" \w* \w and great| strong="H7690" \w* \w honour| strong="H3367" \w*: \w therefore| strong="H3861" \w* [shew]{strong=“H2324” x-morph=“strongMorph: \sc Th\sc*8680”} \w me the dream| strong="H2493" \w*, \w and the interpretation| strong="H6591" \w* thereof.\f + \fr 2:6 \ft rewards: or, fee \f* 
