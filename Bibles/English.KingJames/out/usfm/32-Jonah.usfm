\v 4 \w And Jonah| strong="H3124" \w* [began]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8686”} [to enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w into the city| strong="H5892" \w* \w a| strong="H259" \w* [day’s]{strong=“H3117”} \w journey| strong="H4109" \w*, [and he cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Yet forty| strong="H705" \w* \w days| strong="H3117" \w*, \w and Nineveh| strong="H5210" \w* [shall be overthrown]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8737”}. 
\p
\v 5 \w So the people| strong="H582" \w* \w of Nineveh| strong="H5210" \w* [believed]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”} \w God| strong="H430" \w*, [and proclaimed]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w a fast| strong="H6685" \w*, [and put]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w on sackcloth| strong="H8242" \w*, \w from the greatest| strong="H1419" \w* \w of them even to the least| strong="H6996" \w* of them. 
