\v 7 And he caused it [to be proclaimed]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8686”} [and published]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w through Nineveh| strong="H5210" \w* \w by the decree| strong="H2940" \w* \w of the king| strong="H4428" \w* \w and his nobles| strong="H1419" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Let neither man| strong="H120" \w* \w nor beast| strong="H929" \w*, \w herd| strong="H1241" \w* \w nor flock| strong="H6629" \w*, [taste]{strong=“H2938” x-morph=“strongMorph: \sc Th\sc*8799”} \w any thing| strong="H3972" \w*: [let them not feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”}, [nor drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w water| strong="H4325" \w*:\f + \fr 3:7 \ft published: Heb. said \f* \f + \fr 3:7 \ft nobles: Heb. great men \f* 
\v 8 \w But let man| strong="H120" \w* \w and beast| strong="H929" \w* [be covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8691”} \w with sackcloth| strong="H8242" \w*, [and cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w mightily| strong="H2394" \w* \w unto God| strong="H430" \w*: [yea, let them turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w every one| strong="H376" \w* \w from his evil| strong="H7451" \w* \w way| strong="H1870" \w*, \w and from the violence| strong="H2555" \w* that is \w in their hands| strong="H3709" \w*. 
\v 9 [Who can tell]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} if \w God| strong="H430" \w* [will turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [and repent]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8738”}, [and turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w from his fierce| strong="H2740" \w* \w anger| strong="H639" \w*, [that we perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”} not? 
\p
\v 10 \w And God| strong="H430" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w their works| strong="H4639" \w*, [that they turned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w from their evil| strong="H7451" \w* \w way| strong="H1870" \w*; \w and God| strong="H430" \w* [repented]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8735”} \w of the evil| strong="H7451" \w*, [that he had said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [that he would do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [unto them; and he did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} it not. 
\c 4
\p 
\v 1 [But it displeased]{strong=“H3415” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jonah| strong="H3124" \w* [exceedingly]{strong=“H7451 H1419”}, [and he was very angry]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 2 [And he prayed]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8691”} unto the \sc Lord\sc*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w I pray| strong="H577" \w* thee, O \sc Lord\sc*, was \w not this my saying| strong="H1697" \w*, \w when I was yet in my country| strong="H127" \w*? [Therefore I fled]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8800”} [before]{strong=“H6923” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto Tarshish| strong="H8659" \w*: [for I knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that thou art \w a gracious| strong="H2587" \w* \w God| strong="H410" \w*, \w and merciful| strong="H7349" \w*, \w slow| strong="H750" \w* \w to anger| strong="H639" \w*, \w and of great| strong="H7227" \w* \w kindness| strong="H2617" \w*, [and repentest]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8737”} \w thee of the evil| strong="H7451" \w*. 
\v 3 Therefore now, O \sc Lord\sc*, [take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”}, [I beseech thee, my life]{strong=“H5315”} from me; for it is \w better| strong="H2896" \w* \w for me to die| strong="H4194" \w* \w than to live| strong="H2416" \w*. 
\p
\v 4 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc*, [Doest thou well]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8687”} [to be angry]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8804”}?\f + \fr 4:4 \ft Doest…: or, Art thou greatly angry? \f* 
\p
\v 5 \w So Jonah| strong="H3124" \w* [went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the city| strong="H5892" \w*, [and sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w on the east side| strong="H6924" \w* \w of the city| strong="H5892" \w*, [and there made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w him a booth| strong="H5521" \w*, [and sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w under it in the shadow| strong="H6738" \w*, [till he might see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w what would become of the city| strong="H5892" \w*. 
\v 6 And the \sc Lord\sc* \w God| strong="H430" \w* [prepared]{strong=“H4487” x-morph=“strongMorph: \sc Th\sc*8762”} \w a gourd| strong="H7021" \w*, and made it [to come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w over Jonah| strong="H3124" \w*, \w that it might be a shadow| strong="H6738" \w* \w over his head| strong="H7218" \w*, [to deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8687”} \w him from his grief| strong="H7451" \w*. \w So Jonah| strong="H3124" \w* [was exceeding]{strong=“H8057 H1419”} [glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the gourd| strong="H7021" \w*.\f + \fr 4:6 \ft gourd: or, palmcrist: Heb. Kikajon \f* \f + \fr 4:6 \ft was…: Heb. rejoiced with great joy \f* 
\v 7 \w But God| strong="H430" \w* [prepared]{strong=“H4487” x-morph=“strongMorph: \sc Th\sc*8762”} \w a worm| strong="H8438" \w* \w when the morning| strong="H7837" \w* [rose]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8800”} \w the next day| strong="H4283" \w*, [and it smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w the gourd| strong="H7021" \w* [that it withered]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 8 [And it came to pass, when the sun]{strong=“H8121”} [did arise]{strong=“H2224” x-morph=“strongMorph: \sc Th\sc*8800”}, \w that God| strong="H430" \w* [prepared]{strong=“H4487” x-morph=“strongMorph: \sc Th\sc*8762”} \w a vehement| strong="H2759" \w* \w east| strong="H6921" \w* \w wind| strong="H7307" \w*; \w and the sun| strong="H8121" \w* [beat]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w upon the head| strong="H7218" \w* \w of Jonah| strong="H3124" \w*, [that he fainted]{strong=“H5968” x-morph=“strongMorph: \sc Th\sc*8691”}, [and wished]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} \w in himself| strong="H5315" \w* [to die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, It is \w better| strong="H2896" \w* \w for me to die| strong="H4194" \w* \w than to live| strong="H2416" \w*.\f + \fr 4:8 \ft vehement: or, silent \f* 
\v 9 \w And God| strong="H430" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Jonah| strong="H3124" \w*, [Doest thou well]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8687”} [to be angry]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8804”} \w for the gourd| strong="H7021" \w*? [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I do well]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8687”} [to be angry]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8804”}, even \w unto death| strong="H4194" \w*.\f + \fr 4:9 \ft Doest…: or, Art thou greatly angry? \f* \f + \fr 4:9 \ft I do well…: or, I am greatly angry \f* 
\v 10 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc*, [Thou hast had pity]{strong=“H2347” x-morph=“strongMorph: \sc Th\sc*8804”} \w on the gourd| strong="H7021" \w*, [for the which thou hast not laboured]{strong=“H5998” x-morph=“strongMorph: \sc Th\sc*8804”}, [neither madest it grow]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8765”}; [which came up in a night]{strong=“H3915 H1121”}, [and perished]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”} [in a night]{strong=“H3915 H1121”}:\f + \fr 4:10 \ft had pity: or, spared \f* \f + \fr 4:10 \ft came…: Heb. was the son of the night \f* 
\v 11 [And should not I spare]{strong=“H2347” x-morph=“strongMorph: \sc Th\sc*8799”} \w Nineveh| strong="H5210" \w*, \w that great| strong="H1419" \w* \w city| strong="H5892" \w*, \w wherein are| strong="H3426" \w* [more]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8687”} [than sixscore]{strong=“H6240 H8147”} \w thousand| strong="H7239" \w* \w persons| strong="H120" \w* [that cannot discern]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w between their right hand| strong="H3225" \w* \w and their left hand| strong="H8040" \w*; and also \w much| strong="H7227" \w* \w cattle| strong="H929" \w*? 
