\v 4 [And I have also established]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} \w my covenant| strong="H1285" \w* [with them, to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w them the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*, \w the land| strong="H776" \w* \w of their pilgrimage| strong="H4033" \w*, [wherein they were strangers]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 5 [And I have also heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the groaning| strong="H5009" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, \w whom| strong="H834" \w* \w the Egyptians| strong="H4714" \w* [keep in bondage]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8688”}; [and I have remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w my covenant| strong="H1285" \w*. 
\v 6 \w Wherefore| strong="H3651" \w* [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, I am the \sc Lord\sc*, [and I will bring]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w you out from under the burdens| strong="H5450" \w* \w of the Egyptians| strong="H4714" \w*, [and I will rid]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w you out of their bondage| strong="H5656" \w*, [and I will redeem]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8804”} [you with a stretched]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8803”} \w out arm| strong="H2220" \w*, \w and with great| strong="H1419" \w* \w judgments| strong="H8201" \w*: 
\v 7 [And I will take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w you to me for a people| strong="H5971" \w*, \w and I will be to you a God| strong="H430" \w*: [and ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc* \w your God| strong="H430" \w*, [which bringeth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8688”} \w you out from under the burdens| strong="H5450" \w* \w of the Egyptians| strong="H4714" \w*. 
\v 8 [And I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w you in unto the land| strong="H776" \w*, [concerning the which I did swear]{strong=“H3027 H5375” x-morph=“strongMorph: \sc Th\sc*8804”} [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w it to Abraham| strong="H85" \w*, \w to Isaac| strong="H3327" \w*, \w and to Jacob| strong="H3290" \w*; [and I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w it you for an heritage| strong="H4181" \w*: I am the \sc Lord\sc*.\f + \fr 6:8 \ft swear: Heb. lift up my hand \f* 
\p
\v 9 \w And Moses| strong="H4872" \w* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w so unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*: [but they hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w not unto Moses| strong="H4872" \w* \w for anguish| strong="H7115" \w* \w of spirit| strong="H7307" \w*, \w and for cruel| strong="H7186" \w* \w bondage| strong="H5656" \w*.\f + \fr 6:9 \ft anguish: Heb. shortness, or, straitness \f* 
\p
\v 10 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
