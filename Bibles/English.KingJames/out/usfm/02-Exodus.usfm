\c 6
\p 
\v 1 Then the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w*, [Now shalt thou see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [what I will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Pharaoh| strong="H6547" \w*: \w for with a strong| strong="H2389" \w* \w hand| strong="H3027" \w* [shall he let them go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”}, \w and with a strong| strong="H2389" \w* \w hand| strong="H3027" \w* [shall he drive them out]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8762”} \w of his land| strong="H776" \w*. 
\v 2 \w And God| strong="H430" \w* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, I am the \sc Lord\sc*:^\sc 6:2 the [Lord\sc*: or, \sc Jehovah\sc*] 
