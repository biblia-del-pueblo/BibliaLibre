\c 10
\p 
\v 1 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w*, [Go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} \w in unto Pharaoh| strong="H6547" \w*: [for I have hardened]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8689”} \w his heart| strong="H3820" \w*, \w and the heart| strong="H3820" \w* \w of his servants| strong="H5650" \w*, [that I might shew]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8800”} \w these my signs| strong="H226" \w* \w before| strong="H7130" \w* him: 
\v 2 [And that thou mayest tell]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} \w in the ears| strong="H241" \w* \w of thy son| strong="H1121" \w*, [and of thy son’s]{strong=“H1121”} \w son| strong="H1121" \w*, [what things I have wrought]{strong=“H5953” x-morph=“strongMorph: \sc Th\sc*8694”} \w in Egypt| strong="H4714" \w*, \w and my signs| strong="H226" \w* [which I have done]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} [among them; that ye may know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} how that I am the \sc Lord\sc*. 
