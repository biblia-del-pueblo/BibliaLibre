\v 16 \w And the feast| strong="H2282" \w* \w of harvest| strong="H7105" \w*, \w the firstfruits| strong="H1061" \w* \w of thy labours| strong="H4639" \w*, [which thou hast sown]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the field| strong="H7704" \w*: \w and the feast| strong="H2282" \w* \w of ingathering| strong="H614" \w*, which is [in the end]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”} \w of the year| strong="H8141" \w*, [when thou hast gathered]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8800”} \w in thy labours| strong="H4639" \w* \w out of the field| strong="H7704" \w*. 
\v 17 \w Three| strong="H7969" \w* \w times| strong="H6471" \w* \w in the year| strong="H8141" \w* \w all thy males| strong="H2138" \w* [shall appear]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8735”} \w before| strong="H6440" \w* \w the Lord| strong="H113" \w* \sc God\sc*. 
\v 18 [Thou shalt not offer]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} \w the blood| strong="H1818" \w* \w of my sacrifice| strong="H2077" \w* \w with leavened bread| strong="H2557" \w*; \w neither shall the fat| strong="H2459" \w* \w of my sacrifice| strong="H2282" \w* [remain]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} \w until the morning| strong="H1242" \w*.\f + \fr 23:18 \ft sacrifice: or, feast \f* 
\v 19 \w The first| strong="H7225" \w* \w of the firstfruits| strong="H1061" \w* \w of thy land| strong="H127" \w* [thou shalt bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w into the house| strong="H1004" \w* of the \sc Lord\sc* \w thy God| strong="H430" \w*. [Thou shalt not seethe]{strong=“H1310” x-morph=“strongMorph: \sc Th\sc*8762”} \w a kid| strong="H1423" \w* [in his mother’s]{strong=“H517”} \w milk| strong="H2461" \w*. 
\p
\v 20 [Behold, I send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8802”} \w an Angel| strong="H4397" \w* \w before| strong="H6440" \w* [thee, to keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”} \w thee in the way| strong="H1870" \w*, [and to bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} \w thee into the place| strong="H4725" \w* [which I have prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\v 21 [Beware]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8734”} \w of| strong="H6440" \w* [him, and obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w his voice| strong="H6963" \w*, [provoke]{strong=“H4843” x-morph=“strongMorph: \sc Th\sc*8686”} [him not; for he will not pardon]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w your transgressions| strong="H6588" \w*: \w for my name| strong="H8034" \w* is \w in him| strong="H7130" \w*. 
\v 22 [But if thou shalt indeed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} [obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w his voice| strong="H6963" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [all that I speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}; [then I will be an enemy]{strong=“H340” x-morph=“strongMorph: \sc Th\sc*8804”} [unto thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, [and an adversary]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8802”} [unto thine adversaries]{strong=“H6696” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 23:22 \ft an adversary…: or, I will afflict them that afflict thee \f* 
\v 23 \w For mine Angel| strong="H4397" \w* [shall go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* [thee, and bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee in unto the Amorites| strong="H567" \w*, \w and the Hittites| strong="H2850" \w*, \w and the Perizzites| strong="H6522" \w*, \w and the Canaanites| strong="H3669" \w*, \w the Hivites| strong="H2340" \w*, \w and the Jebusites| strong="H2983" \w*: [and I will cut them off]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\v 24 [Thou shalt not bow down]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} \w to their gods| strong="H430" \w*, [nor serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8714”} [them, nor do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w after their works| strong="H4639" \w*: [but thou shalt utterly]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8763”} [overthrow]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8762”} [them, and quite]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8763”} [break down]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8762”} \w their images| strong="H4676" \w*. 
\v 25 [And ye shall serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w your God| strong="H430" \w*, [and he shall bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy bread| strong="H3899" \w*, \w and thy water| strong="H4325" \w*; \w and I will take| strong="H5493" \w* \w sickness| strong="H4245" \w* [away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8689”} \w from the midst| strong="H7130" \w* of thee. 
\p
\v 26 [There shall nothing cast their young]{strong=“H7921” x-morph=“strongMorph: \sc Th\sc*8764”}, \w nor be barren| strong="H6135" \w*, \w in thy land| strong="H776" \w*: \w the number| strong="H4557" \w* \w of thy days| strong="H3117" \w* [I will fulfil]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8762”}. 
