\c 29
\p 
\v 1 And this is \w the thing| strong="H1697" \w* [that thou shalt do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them to hallow]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8763”} [them, to minister unto me in the priest’s office]{strong=“H3547” x-morph=“strongMorph: \sc Th\sc*8763”}: [Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w one| strong="H259" \w* [young]{strong=“H1241 H1121”} \w bullock| strong="H6499" \w*, \w and two| strong="H8147" \w* \w rams| strong="H352" \w* \w without blemish| strong="H8549" \w*, 
\v 2 \w And unleavened| strong="H4682" \w* \w bread| strong="H3899" \w*, \w and cakes| strong="H2471" \w* \w unleavened| strong="H4682" \w* [tempered]{strong=“H1101” x-morph=“strongMorph: \sc Th\sc*8803”} \w with oil| strong="H8081" \w*, \w and wafers| strong="H7550" \w* \w unleavened| strong="H4682" \w* [anointed ]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8803”} \w with oil| strong="H8081" \w*: of \w wheaten| strong="H2406" \w* \w flour| strong="H5560" \w* [shalt thou make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} them. 
\v 3 [And thou shalt put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w them into one| strong="H259" \w* \w basket| strong="H5536" \w*, [and bring]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8689”} \w them in the basket| strong="H5536" \w*, \w with the bullock| strong="H6499" \w* \w and the two| strong="H8147" \w* \w rams| strong="H352" \w*. 
\v 4 \w And Aaron| strong="H175" \w* \w and his sons| strong="H1121" \w* [thou shalt bring]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto the door| strong="H6607" \w* \w of the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*, [and shalt wash]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} \w them with water| strong="H4325" \w*. 
\v 5 [And thou shalt take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w the garments| strong="H899" \w*, [and put]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8689”} \w upon Aaron| strong="H175" \w* \w the coat| strong="H3801" \w*, \w and the robe| strong="H4598" \w* \w of the ephod| strong="H646" \w*, \w and the ephod| strong="H646" \w*, \w and the breastplate| strong="H2833" \w*, [and gird]{strong=“H640” x-morph=“strongMorph: \sc Th\sc*8804”} \w him with the curious girdle| strong="H2805" \w* \w of the ephod| strong="H646" \w*: 
\v 6 [And thou shalt put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w the mitre| strong="H4701" \w* \w upon his head| strong="H7218" \w*, [and put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w the holy| strong="H6944" \w* \w crown| strong="H5145" \w* \w upon the mitre| strong="H4701" \w*. 
\v 7 [Then shalt thou take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w the anointing| strong="H4888" \w* \w oil| strong="H8081" \w*, [and pour]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8804”} it \w upon his head| strong="H7218" \w*, [and anoint]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8804”} him. 
\v 8 [And thou shalt bring]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”} \w his sons| strong="H1121" \w*, [and put]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8689”} \w coats| strong="H3801" \w* upon them. 
\v 9 [And thou shalt gird]{strong=“H2296” x-morph=“strongMorph: \sc Th\sc*8804”} \w them with girdles| strong="H73" \w*, \w Aaron| strong="H175" \w* \w and his sons| strong="H1121" \w*, [and put]{strong=“H2280” x-morph=“strongMorph: \sc Th\sc*8804”} \w the bonnets| strong="H4021" \w* [on them: and the priest’s office]{strong=“H3550”} \w shall be theirs for a perpetual| strong="H5769" \w* \w statute| strong="H2708" \w*: [and thou shalt consecrate]{strong=“H3027 H4390” x-morph=“strongMorph: \sc Th\sc*8765”} \w Aaron| strong="H175" \w* \w and his sons| strong="H1121" \w*.\f + \fr 29:9 \ft put: Heb. bind \f* \f + \fr 29:9 \ft consecrate: Heb. fill the hand of \f* 
\v 10 \w And thou shalt cause a bullock| strong="H6499" \w* [to be brought]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8689”} \w before| strong="H6440" \w* \w the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*: \w and Aaron| strong="H175" \w* \w and his sons| strong="H1121" \w* [shall put]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8804”} \w their hands| strong="H3027" \w* \w upon the head| strong="H7218" \w* \w of the bullock| strong="H6499" \w*. 
\v 11 [And thou shalt kill]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8804”} \w the bullock| strong="H6499" \w* \w before| strong="H6440" \w* the \sc Lord\sc*, by \w the door| strong="H6607" \w* \w of the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*. 
\v 12 [And thou shalt take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the blood| strong="H1818" \w* \w of the bullock| strong="H6499" \w*, [and put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} it \w upon the horns| strong="H7161" \w* \w of the altar| strong="H4196" \w* \w with thy finger| strong="H676" \w*, [and pour]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the blood| strong="H1818" \w* \w beside| strong="H413" \w* \w the bottom| strong="H3247" \w* \w of the altar| strong="H4196" \w*. 
\v 13 [And thou shalt take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w all the fat| strong="H2459" \w* [that covereth]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8764”} \w the inwards| strong="H7130" \w*, \w and the caul| strong="H3508" \w* that is \w above the liver| strong="H3516" \w*, \w and the two| strong="H8147" \w* \w kidneys| strong="H3629" \w*, \w and the fat| strong="H2459" \w* that is [upon them, and burn]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8689”} them \w upon the altar| strong="H4196" \w*.\f + \fr 29:13 \ft the caul: it seemeth by anatomy, and the Hebrew doctors, to be the midriff \f* 
\v 14 \w But the flesh| strong="H1320" \w* \w of the bullock| strong="H6499" \w*, \w and his skin| strong="H5785" \w*, \w and his dung| strong="H6569" \w*, [shalt thou burn]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8799”} \w with fire| strong="H784" \w* \w without| strong="H2351" \w* \w the camp| strong="H4264" \w*: it is \w a sin offering| strong="H2403" \w*. 
\p
\v 15 [Thou shalt also take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w one| strong="H259" \w* \w ram| strong="H352" \w*; \w and Aaron| strong="H175" \w* \w and his sons| strong="H1121" \w* [shall put]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8804”} \w their hands| strong="H3027" \w* \w upon the head| strong="H7218" \w* \w of the ram| strong="H352" \w*. 
\v 16 [And thou shalt slay]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8804”} \w the ram| strong="H352" \w*, [and thou shalt take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w his blood| strong="H1818" \w*, [and sprinkle]{strong=“H2236” x-morph=“strongMorph: \sc Th\sc*8804”} it \w round about| strong="H5439" \w* \w upon the altar| strong="H4196" \w*. 
\v 17 [And thou shalt cut]{strong=“H5408” x-morph=“strongMorph: \sc Th\sc*8762”} \w the ram| strong="H352" \w* \w in pieces| strong="H5409" \w*, [and wash]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} \w the inwards| strong="H7130" \w* [of him, and his legs]{strong=“H3767”}, [and put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} them \w unto his pieces| strong="H5409" \w*, \w and unto his head| strong="H7218" \w*.\f + \fr 29:17 \ft unto: or, upon \f* 
\v 18 [And thou shalt burn]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8689”} \w the whole ram| strong="H352" \w* \w upon the altar| strong="H4196" \w*: it is \w a burnt offering| strong="H5930" \w* unto the \sc Lord\sc*: it is \w a sweet| strong="H5207" \w* \w savour| strong="H7381" \w*, \w an offering made by fire| strong="H801" \w* unto the \sc Lord\sc*. 
\p
\v 19 [And thou shalt take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w the other| strong="H8145" \w* \w ram| strong="H352" \w*; \w and Aaron| strong="H175" \w* \w and his sons| strong="H1121" \w* [shall put]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8804”} \w their hands| strong="H3027" \w* \w upon the head| strong="H7218" \w* \w of the ram| strong="H352" \w*. 
\v 20 [Then shalt thou kill]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8804”} \w the ram| strong="H352" \w*, [and take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w of his blood| strong="H1818" \w*, [and put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} it \w upon the tip| strong="H8571" \w* \w of the right ear| strong="H241" \w* \w of Aaron| strong="H175" \w*, \w and upon the tip| strong="H8571" \w* \w of the right| strong="H3233" \w* \w ear| strong="H241" \w* \w of his sons| strong="H1121" \w*, \w and upon the thumb| strong="H931" \w* \w of their right| strong="H3233" \w* \w hand| strong="H3027" \w*, \w and upon the great toe| strong="H931" \w* \w of their right| strong="H3233" \w* \w foot| strong="H7272" \w*, [and sprinkle]{strong=“H2236” x-morph=“strongMorph: \sc Th\sc*8804”} \w the blood| strong="H1818" \w* \w upon the altar| strong="H4196" \w* \w round about| strong="H5439" \w*. 
\v 21 [And thou shalt take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the blood| strong="H1818" \w* that is \w upon the altar| strong="H4196" \w*, \w and of the anointing| strong="H4888" \w* \w oil| strong="H8081" \w*, [and sprinkle]{strong=“H5137” x-morph=“strongMorph: \sc Th\sc*8689”} it \w upon Aaron| strong="H175" \w*, \w and upon his garments| strong="H899" \w*, \w and upon his sons| strong="H1121" \w*, \w and upon the garments| strong="H899" \w* \w of his sons| strong="H1121" \w* [with him: and he shall be hallowed]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and his garments| strong="H899" \w*, \w and his sons| strong="H1121" \w*, [and his sons’]{strong=“H1121”} \w garments| strong="H899" \w* with him. 
\v 22 [Also thou shalt take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the ram| strong="H352" \w* \w the fat| strong="H2459" \w* \w and the rump| strong="H451" \w*, \w and the fat| strong="H2459" \w* [that covereth]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8764”} \w the inwards| strong="H7130" \w*, \w and the caul| strong="H3508" \w* above \w the liver| strong="H3516" \w*, \w and the two| strong="H8147" \w* \w kidneys| strong="H3629" \w*, \w and the fat| strong="H2459" \w* that is [upon them, and the right]{strong=“H3225”} \w shoulder| strong="H7785" \w*; for it is \w a ram| strong="H352" \w* \w of consecration| strong="H4394" \w*: 
\v 23 \w And one| strong="H259" \w* \w loaf| strong="H3603" \w* \w of bread| strong="H3899" \w*, \w and one| strong="H259" \w* \w cake| strong="H2471" \w* \w of oiled| strong="H8081" \w* [bread, and one]{strong=“H259”} \w wafer| strong="H7550" \w* \w out of the basket| strong="H5536" \w* \w of the unleavened bread| strong="H4682" \w* that is \w before| strong="H6440" \w* the \sc Lord\sc*: 
\v 24 [And thou shalt put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w all in the hands| strong="H3709" \w* \w of Aaron| strong="H175" \w*, \w and in the hands| strong="H3709" \w* \w of his sons| strong="H1121" \w*; [and shalt wave]{strong=“H5130” x-morph=“strongMorph: \sc Th\sc*8689”} them for \w a wave offering| strong="H8573" \w* \w before| strong="H6440" \w* the \sc Lord\sc*.\f + \fr 29:24 \ft shalt wave: or, shalt shake to and fro \f* 
\v 25 [And thou shalt receive]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w them of their hands| strong="H3027" \w*, [and burn]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8689”} them \w upon the altar| strong="H4196" \w* \w for a burnt offering| strong="H5930" \w*, \w for a sweet| strong="H5207" \w* \w savour| strong="H7381" \w* \w before| strong="H6440" \w* the \sc Lord\sc*: it is \w an offering made by fire| strong="H801" \w* unto the \sc Lord\sc*. 
\v 26 [And thou shalt take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w the breast| strong="H2373" \w* \w of the ram| strong="H352" \w* [of Aaron’s]{strong=“H175”} \w consecration| strong="H4394" \w*, [and wave]{strong=“H5130” x-morph=“strongMorph: \sc Th\sc*8689”} it for \w a wave offering| strong="H8573" \w* \w before| strong="H6440" \w* the \sc Lord\sc*: \w and it shall be thy part| strong="H4490" \w*. 
\v 27 [And thou shalt sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8765”} \w the breast| strong="H2373" \w* \w of the wave offering| strong="H8573" \w*, \w and the shoulder| strong="H7785" \w* \w of the heave offering| strong="H8641" \w*, [which is waved]{strong=“H5130” x-morph=“strongMorph: \sc Th\sc*8717”}, [and which is heaved up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8717”}, \w of the ram| strong="H352" \w* \w of the consecration| strong="H4394" \w*, even of that \w which| strong="H834" \w* is \w for Aaron| strong="H175" \w*, and of that \w which is for his sons| strong="H1121" \w*: 
\v 28 [And it shall be Aaron’s]{strong=“H175”} [and his sons’]{strong=“H1121”} \w by a statute| strong="H2706" \w* \w for ever| strong="H5769" \w* \w from the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*: for it is \w an heave offering| strong="H8641" \w*: \w and it shall be an heave offering| strong="H8641" \w* \w from the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* \w of the sacrifice| strong="H2077" \w* \w of their peace offerings| strong="H8002" \w*, even \w their heave offering| strong="H8641" \w* unto the \sc Lord\sc*. 
\p
\v 29 \w And the holy| strong="H6944" \w* \w garments| strong="H899" \w* \w of Aaron| strong="H175" \w* [shall be his sons’]{strong=“H1121”} \w after| strong="H310" \w* [him, to be anointed]{strong=“H4888”} [therein, and to be consecrated]{strong=“H3027 H4390” x-morph=“strongMorph: \sc Th\sc*8763”} in them. 
\v 30 And \w that son| strong="H1121" \w* \w that is priest| strong="H3548" \w* [in his stead shall put]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w them on seven| strong="H7651" \w* \w days| strong="H3117" \w*, [when he cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w* [to minister]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8763”} \w in the holy| strong="H6944" \w* place.\f + \fr 29:30 \ft that son: Heb. he of his sons \f* 
\p
\v 31 [And thou shalt take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the ram| strong="H352" \w* \w of the consecration| strong="H4394" \w*, [and seethe]{strong=“H1310” x-morph=“strongMorph: \sc Th\sc*8765”} \w his flesh| strong="H1320" \w* \w in the holy| strong="H6918" \w* \w place| strong="H4725" \w*. 
\v 32 \w And Aaron| strong="H175" \w* \w and his sons| strong="H1121" \w* [shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w the flesh| strong="H1320" \w* \w of the ram| strong="H352" \w*, \w and the bread| strong="H3899" \w* that is \w in the basket| strong="H5536" \w*, by \w the door| strong="H6607" \w* \w of the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*. 
\v 33 [And they shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} [those things wherewith the atonement was made]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8795”}, [to consecrate]{strong=“H3027 H4390” x-morph=“strongMorph: \sc Th\sc*8763”} and [to sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8763”} [them: but a stranger]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} [shall not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} thereof, because they are \w holy| strong="H6944" \w*. 
\v 34 \w And if ought of the flesh| strong="H1320" \w* \w of the consecrations| strong="H4394" \w*, \w or of the bread| strong="H3899" \w*, [remain]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8735”} \w unto the morning| strong="H1242" \w*, [then thou shalt burn]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8804”} [the remainder]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8737”} \w with fire| strong="H784" \w*: [it shall not be eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8735”}, because it is \w holy| strong="H6944" \w*. 
\v 35 [And thus shalt thou do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto Aaron| strong="H175" \w*, \w and to his sons| strong="H1121" \w*, according to all things [which I have commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [thee: seven]{strong=“H7651”} \w days| strong="H3117" \w* [shalt thou consecrate]{strong=“H3027 H4390” x-morph=“strongMorph: \sc Th\sc*8762”} them. 
\v 36 [And thou shalt offer]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w every day| strong="H3117" \w* \w a bullock| strong="H6499" \w* for \w a sin offering| strong="H2403" \w* \w for atonement| strong="H3725" \w*: [and thou shalt cleanse]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8765”} \w the altar| strong="H4196" \w*, [when thou hast made an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8763”} [for it, and thou shalt anoint]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8804”} [it, to sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8763”} it. 
\v 37 \w Seven| strong="H7651" \w* \w days| strong="H3117" \w* [thou shalt make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8762”} \w for the altar| strong="H4196" \w*, [and sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8765”} [it; and it shall be an altar]{strong=“H4196”} [most holy]{strong=“H6944 H6944”}: [whatsoever toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8802”} \w the altar| strong="H4196" \w* [shall be holy]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 38 Now this is that [which thou shalt offer]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the altar| strong="H4196" \w*; \w two| strong="H8147" \w* \w lambs| strong="H3532" \w* \w of the first| strong="H1121" \w* \w year| strong="H8141" \w* \w day| strong="H3117" \w* \w by day| strong="H3117" \w* \w continually| strong="H8548" \w*. 
