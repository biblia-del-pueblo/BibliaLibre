\v 28 [And I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w hornets| strong="H6880" \w* \w before| strong="H6440" \w* [thee, which shall drive out]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8765”} \w the Hivite| strong="H2340" \w*, \w the Canaanite| strong="H3669" \w*, \w and the Hittite| strong="H2850" \w*, \w from before| strong="H6440" \w* thee. 
\v 29 [I will not drive them out]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8762”} \w from before| strong="H6440" \w* \w thee in one| strong="H259" \w* \w year| strong="H8141" \w*; \w lest the land| strong="H776" \w* \w become desolate| strong="H8077" \w*, \w and the beast| strong="H2416" \w* \w of the field| strong="H7704" \w* \w multiply| strong="H7227" \w* against thee. 
\v 30 \w By little| strong="H4592" \w* \w and little| strong="H4592" \w* [I will drive them out]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8762”} \w from before| strong="H6440" \w* [thee, until thou be increased]{strong=“H6509” x-morph=“strongMorph: \sc Th\sc*8799”}, [and inherit]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8804”} \w the land| strong="H776" \w*. 
