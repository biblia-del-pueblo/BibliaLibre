\v 11 \w And Moses| strong="H4872" \w* [besought]{strong=“H6440 H2470” x-morph=“strongMorph: \sc Th\sc*8762”} the \sc Lord\sc* \w his God| strong="H430" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \sc Lord\sc*, \w why doth thy wrath| strong="H639" \w* [wax hot]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8799”} \w against thy people| strong="H5971" \w*, [which thou hast brought forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w out of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* \w with great| strong="H1419" \w* \w power| strong="H3581" \w*, \w and with a mighty| strong="H2389" \w* \w hand| strong="H3027" \w*?^\sc 32:11 the [Lord\sc*: Heb. the face of the \sc Lord\sc*] 
\v 12 \w Wherefore should the Egyptians| strong="H4714" \w* [speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w For mischief| strong="H7451" \w* [did he bring]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} [them out, to slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8800”} \w them in the mountains| strong="H2022" \w*, [and to consume]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8763”} \w them from the face| strong="H6440" \w* \w of the earth| strong="H127" \w*? [Turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} \w from thy fierce| strong="H2740" \w* \w wrath| strong="H639" \w*, [and repent]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8734”} \w of this evil| strong="H7451" \w* \w against thy people| strong="H5971" \w*. 
\v 13 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”} \w Abraham| strong="H85" \w*, \w Isaac| strong="H3327" \w*, \w and Israel| strong="H3478" \w*, \w thy servants| strong="H5650" \w*, [to whom thou swarest]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} [by thine own self, and saidst]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [unto them, I will multiply]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} \w your seed| strong="H2233" \w* \w as the stars| strong="H3556" \w* \w of heaven| strong="H8064" \w*, \w and all this land| strong="H776" \w* [that I have spoken]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [of will I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto your seed| strong="H2233" \w*, [and they shall inherit]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8804”} it \w for ever| strong="H5769" \w*. 
