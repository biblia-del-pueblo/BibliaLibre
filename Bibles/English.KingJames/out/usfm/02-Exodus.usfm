\c 28
\p 
\v 1 [And take]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8685”} \w thou unto thee Aaron| strong="H175" \w* \w thy brother| strong="H251" \w*, \w and his sons| strong="H1121" \w* [with him, from among]{strong=“H8432”} \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [that he may minister unto me in the priest’s office]{strong=“H3547” x-morph=“strongMorph: \sc Th\sc*8763”}, even \w Aaron| strong="H175" \w*, \w Nadab| strong="H5070" \w* \w and Abihu| strong="H30" \w*, \w Eleazar| strong="H499" \w* \w and Ithamar| strong="H385" \w*, [Aaron’s]{strong=“H175”} \w sons| strong="H1121" \w*. 
