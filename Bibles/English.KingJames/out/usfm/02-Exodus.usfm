\c 17
\p 
\v 1 \w And all the congregation| strong="H5712" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [journeyed]{strong=“H5265” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the wilderness| strong="H4057" \w* \w of Sin| strong="H5512" \w*, \w after their journeys| strong="H4550" \w*, \w according to the commandment| strong="H6310" \w* of the \sc Lord\sc*, [and pitched]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8799”} \w in Rephidim| strong="H7508" \w*: and there was \w no water| strong="H4325" \w* \w for the people| strong="H5971" \w* [to drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 2 \w Wherefore the people| strong="H5971" \w* [did chide]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”} \w with Moses| strong="H4872" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”} \w us water| strong="H4325" \w* [that we may drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”}. \w And Moses| strong="H4872" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Why chide]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”} [ye with me? wherefore do ye tempt]{strong=“H5254” x-morph=“strongMorph: \sc Th\sc*8762”} the \sc Lord\sc*? 
\v 3 \w And the people| strong="H5971" \w* [thirsted]{strong=“H6770” x-morph=“strongMorph: \sc Th\sc*8799”} \w there for water| strong="H4325" \w*; \w and the people| strong="H5971" \w* [murmured]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8686”} \w against Moses| strong="H4872" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Wherefore is this that [thou hast brought]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} \w us up out of Egypt| strong="H4714" \w*, [to kill]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8687”} \w us and our children| strong="H1121" \w* \w and our cattle| strong="H4735" \w* \w with thirst| strong="H6772" \w*? 
\v 4 \w And Moses| strong="H4872" \w* [cried]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [What shall I do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto this people| strong="H5971" \w*? \w they be almost| strong="H4592" \w* [ready to stone]{strong=“H5619” x-morph=“strongMorph: \sc Th\sc*8804”} me. 
\v 5 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w*, [Go on]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8798”} \w before| strong="H6440" \w* \w the people| strong="H5971" \w*, [and take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w with thee of the elders| strong="H2205" \w* \w of Israel| strong="H3478" \w*; \w and thy rod| strong="H4294" \w*, [wherewith thou smotest]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w the river| strong="H2975" \w*, [take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w in thine hand| strong="H3027" \w*, [and go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 6 [Behold, I will stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w before| strong="H6440" \w* \w thee there upon the rock| strong="H6697" \w* \w in Horeb| strong="H2722" \w*; [and thou shalt smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w the rock| strong="H6697" \w*, [and there shall come]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w water| strong="H4325" \w* [out of it, that the people]{strong=“H5971”} [may drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8804”}. \w And Moses| strong="H4872" \w* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w so in the sight| strong="H5869" \w* \w of the elders| strong="H2205" \w* \w of Israel| strong="H3478" \w*. 
\v 7 [And he called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w the name| strong="H8034" \w* \w of the place| strong="H4725" \w* \w Massah| strong="H4532" \w*, \w and Meribah| strong="H4809" \w*, \w because of the chiding| strong="H7379" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [and because they tempted]{strong=“H5254” x-morph=“strongMorph: \sc Th\sc*8763”} the \sc Lord\sc*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Is| strong="H3426" \w* the \sc Lord\sc* \w among| strong="H7130" \w* us, or not?\f + \fr 17:7 \ft Massah: that is, Temptation \f* \f + \fr 17:7 \ft Meribah: that is, Chiding, or, Strife \f* 
\p
\v 8 [Then came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w Amalek| strong="H6002" \w*, [and fought]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8735”} \w with Israel| strong="H3478" \w* \w in Rephidim| strong="H7508" \w*. 
\v 9 \w And Moses| strong="H4872" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Joshua| strong="H3091" \w*, [Choose us out]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8798”} \w men| strong="H582" \w*, [and go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8798”}, [fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8734”} \w with Amalek| strong="H6002" \w*: \w to morrow| strong="H4279" \w* [I will stand]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8737”} \w on the top| strong="H7218" \w* \w of the hill| strong="H1389" \w* \w with the rod| strong="H4294" \w* \w of God| strong="H430" \w* \w in mine hand| strong="H3027" \w*.\f + \fr 17:9 \ft Joshua: called Jesus \f* 
\v 10 \w So Joshua| strong="H3091" \w* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w as Moses| strong="H4872" \w* [had said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [to him, and fought]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8736”} \w with Amalek| strong="H6002" \w*: \w and Moses| strong="H4872" \w*, \w Aaron| strong="H175" \w*, \w and Hur| strong="H2354" \w* [went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the top| strong="H7218" \w* \w of the hill| strong="H1389" \w*. 
\v 11 [And it came to pass, when Moses]{strong=“H4872”} [held up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} \w his hand| strong="H3027" \w*, \w that Israel| strong="H3478" \w* [prevailed]{strong=“H1396” x-morph=“strongMorph: \sc Th\sc*8804”}: [and when he let down]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8686”} \w his hand| strong="H3027" \w*, \w Amalek| strong="H6002" \w* [prevailed]{strong=“H1396” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 12 [But Moses’]{strong=“H4872”} \w hands| strong="H3027" \w* were \w heavy| strong="H3515" \w*; [and they took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a stone| strong="H68" \w*, [and put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} it [under him, and he sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} [thereon; and Aaron]{strong=“H175”} \w and Hur| strong="H2354" \w* [stayed up]{strong=“H8551” x-morph=“strongMorph: \sc Th\sc*8804”} \w his hands| strong="H3027" \w*, \w the one on the one side| strong="H259" \w*, \w and the other on the other side| strong="H259" \w*; \w and his hands| strong="H3027" \w* \w were steady| strong="H530" \w* [until the going down]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w of the sun| strong="H8121" \w*. 
\v 13 \w And Joshua| strong="H3091" \w* [discomfited]{strong=“H2522” x-morph=“strongMorph: \sc Th\sc*8799”} \w Amalek| strong="H6002" \w* \w and his people| strong="H5971" \w* \w with the edge| strong="H6310" \w* \w of the sword| strong="H2719" \w*. 
\v 14 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w*, [Write]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8798”} this for \w a memorial| strong="H2146" \w* \w in a book| strong="H5612" \w*, [and rehearse]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} it \w in the ears| strong="H241" \w* \w of Joshua| strong="H3091" \w*: [for I will utterly]{strong=“H4229” x-morph=“strongMorph: \sc Th\sc*8800”} [put out]{strong=“H4229” x-morph=“strongMorph: \sc Th\sc*8799”} \w the remembrance| strong="H2143" \w* \w of Amalek| strong="H6002" \w* \w from under heaven| strong="H8064" \w*. 
\v 15 \w And Moses| strong="H4872" \w* [built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w an altar| strong="H4196" \w*, [and called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w the name| strong="H8034" \w* [of it Jehovah-nissi]{strong=“H3071”}:^\sc 17:15 Jehovah-nissi: that is, The [Lord\sc* my banner] 
\v 16 [For he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Because the \sc Lord\sc* [hath sworn]{strong=“H3676 H3027”} that the \sc Lord\sc* will have \w war| strong="H4421" \w* \w with Amalek| strong="H6002" \w* \w from generation| strong="H1755" \w* \w to generation| strong="H1755" \w*.^\sc 17:16 Because…: or, Because the hand of Amalek is against the throne of the [Lord\sc*, therefore, etc] ^\sc 17:16 the [Lord\sc* hath…: Heb. the hand upon the throne of the \sc Lord\sc*]
\c 18
\p 
\v 1 \w When Jethro| strong="H3503" \w*, \w the priest| strong="H3548" \w* \w of Midian| strong="H4080" \w*, [Moses’]{strong=“H4872”} [father in law]{strong=“H2859” x-morph=“strongMorph: \sc Th\sc*8802”}, [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w of all that God| strong="H430" \w* [had done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w for Moses| strong="H4872" \w*, \w and for Israel| strong="H3478" \w* \w his people| strong="H5971" \w*, and that the \sc Lord\sc* [had brought]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w Israel| strong="H3478" \w* \w out of Egypt| strong="H4714" \w*; 
\v 2 \w Then Jethro| strong="H3503" \w*, [Moses’]{strong=“H4872”} [father in law]{strong=“H2859” x-morph=“strongMorph: \sc Th\sc*8802”}, [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w Zipporah| strong="H6855" \w*, [Moses’]{strong=“H4872”} \w wife| strong="H802" \w*, \w after| strong="H310" \w* \w he had sent her back| strong="H7964" \w*, 
\v 3 \w And her two| strong="H8147" \w* \w sons| strong="H1121" \w*; \w of which the name| strong="H8034" \w* \w of the one| strong="H259" \w* was \w Gershom| strong="H1647" \w*; [for he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w I have been an alien| strong="H1616" \w* \w in a strange| strong="H5237" \w* \w land| strong="H776" \w*:\f + \fr 18:3 \ft Gershom: that is A stranger there \f* 
\v 4 \w And the name| strong="H8034" \w* \w of the other| strong="H259" \w* was \w Eliezer| strong="H461" \w*; \w for the God| strong="H430" \w* \w of my father| strong="H1" \w*, said he, was \w mine help| strong="H5828" \w*, [and delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w me from the sword| strong="H2719" \w* \w of Pharaoh| strong="H6547" \w*:\f + \fr 18:4 \ft Eliezer: that is, My God is an help \f* 
\v 5 \w And Jethro| strong="H3503" \w*, [Moses’]{strong=“H4872”} [father in law]{strong=“H2859” x-morph=“strongMorph: \sc Th\sc*8802”}, [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w with his sons| strong="H1121" \w* \w and his wife| strong="H802" \w* \w unto Moses| strong="H4872" \w* \w into the wilderness| strong="H4057" \w*, [where he encamped]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8802”} \w at the mount| strong="H2022" \w* \w of God| strong="H430" \w*: 
\v 6 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w*, [I thy father in law]{strong=“H2859” x-morph=“strongMorph: \sc Th\sc*8802”} \w Jethro| strong="H3503" \w* [am come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [unto thee, and thy wife]{strong=“H802”}, \w and her two| strong="H8147" \w* \w sons| strong="H1121" \w* with her. 
\p
\v 7 \w And Moses| strong="H4872" \w* [went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} [to meet]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} [his father in law]{strong=“H2859” x-morph=“strongMorph: \sc Th\sc*8802”}, [and did obeisance]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”}, [and kissed]{strong=“H5401” x-morph=“strongMorph: \sc Th\sc*8799”} [him; and they asked]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} \w each| strong="H376" \w* \w other| strong="H7453" \w* of their \w welfare| strong="H7965" \w*; [and they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the tent| strong="H168" \w*.\f + \fr 18:7 \ft welfare: Heb. peace \f* 
\v 8 \w And Moses| strong="H4872" \w* [told]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} [his father in law]{strong=“H2859” x-morph=“strongMorph: \sc Th\sc*8802”} all that the \sc Lord\sc* [had done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto Pharaoh| strong="H6547" \w* \w and to the Egyptians| strong="H4714" \w* [for Israel’s]{strong=“H3478”} \w sake| strong="H182" \w*, and \w all the travail| strong="H8513" \w* [that had come]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon them by the way| strong="H1870" \w*, and how the \sc Lord\sc* [delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} them.\f + \fr 18:8 \ft come…: Heb. found them \f* 
\v 9 \w And Jethro| strong="H3503" \w* [rejoiced]{strong=“H2302” x-morph=“strongMorph: \sc Th\sc*8799”} \w for all the goodness| strong="H2896" \w* which the \sc Lord\sc* [had done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w to Israel| strong="H3478" \w*, [whom he had delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w out of the hand| strong="H3027" \w* \w of the Egyptians| strong="H4714" \w*. 
\v 10 \w And Jethro| strong="H3503" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} be the \sc Lord\sc*, [who hath delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w you out of the hand| strong="H3027" \w* \w of the Egyptians| strong="H4714" \w*, \w and out of the hand| strong="H3027" \w* \w of Pharaoh| strong="H6547" \w*, [who hath delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w the people| strong="H5971" \w* \w from under the hand| strong="H3027" \w* \w of the Egyptians| strong="H4714" \w*. 
\v 11 [Now I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that the \sc Lord\sc* is \w greater| strong="H1419" \w* \w than all gods| strong="H430" \w*: \w for in the thing| strong="H1697" \w* [wherein they dealt proudly]{strong=“H2102” x-morph=“strongMorph: \sc Th\sc*8804”} he was above them. 
\v 12 \w And Jethro| strong="H3503" \w*, [Moses’]{strong=“H4872”} [father in law]{strong=“H2859” x-morph=“strongMorph: \sc Th\sc*8802”}, [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a burnt offering| strong="H5930" \w* \w and sacrifices| strong="H2077" \w* \w for God| strong="H430" \w*: \w and Aaron| strong="H175" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and all the elders| strong="H2205" \w* \w of Israel| strong="H3478" \w*, [to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} \w bread| strong="H3899" \w* [with Moses’]{strong=“H4872”} [father in law]{strong=“H2859” x-morph=“strongMorph: \sc Th\sc*8802”} \w before| strong="H6440" \w* \w God| strong="H430" \w*. 
\p
\v 13 \w And it came to pass on the morrow| strong="H4283" \w*, \w that Moses| strong="H4872" \w* [sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} [to judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8800”} \w the people| strong="H5971" \w*: \w and the people| strong="H5971" \w* [stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w by Moses| strong="H4872" \w* \w from the morning| strong="H1242" \w* \w unto the evening| strong="H6153" \w*. 
\v 14 [And when Moses’]{strong=“H4872”} [father in law]{strong=“H2859” x-morph=“strongMorph: \sc Th\sc*8802”} [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [all that he did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the people| strong="H5971" \w*, [he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, What is \w this thing| strong="H1697" \w* [that thou doest]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the people| strong="H5971" \w*? [why sittest]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} [thou thyself alone, and all the people]{strong=“H5971”} [stand]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8737”} \w by thee from morning| strong="H1242" \w* \w unto even| strong="H6153" \w*? 
\v 15 \w And Moses| strong="H4872" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto his father in law]{strong=“H2859” x-morph=“strongMorph: \sc Th\sc*8802”}, \w Because the people| strong="H5971" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me to enquire]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8800”} \w of God| strong="H430" \w*: 
\v 16 \w When they have a matter| strong="H1697" \w*, [they come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [unto me; and I judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8804”} \w between one| strong="H376" \w* \w and another| strong="H7453" \w*, and I do make them [know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8689”} \w the statutes| strong="H2706" \w* \w of God| strong="H430" \w*, \w and his laws| strong="H8451" \w*.\f + \fr 18:16 \ft one…: Heb. a man and his fellow \f* 
