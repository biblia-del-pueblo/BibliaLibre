\v 23 \w And Moses| strong="H4872" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc*, \w The people| strong="H5971" \w* [cannot]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8800”} \w to mount| strong="H2022" \w* \w Sinai| strong="H5514" \w*: [for thou chargedst]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8689”} [us, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Set bounds]{strong=“H1379” x-morph=“strongMorph: \sc Th\sc*8685”} \w about the mount| strong="H2022" \w*, [and sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8765”} it. 
\v 24 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Away]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [get thee down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8798”}, [and thou shalt come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”}, [thou, and Aaron]{strong=“H175”} [with thee: but let not the priests]{strong=“H3548”} \w and the people| strong="H5971" \w* [break through]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8799”} [to come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8800”} unto the \sc Lord\sc*, [lest he break forth]{strong=“H6555” x-morph=“strongMorph: \sc Th\sc*8799”} upon them. 
\v 25 \w So Moses| strong="H4872" \w* [went down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the people| strong="H5971" \w*, [and spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto them.
\c 20
\p 
\v 1 \w And God| strong="H430" \w* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w all these words| strong="H1697" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 I am the \sc Lord\sc* \w thy God| strong="H430" \w*, [which have brought]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee out of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, \w out of the house| strong="H1004" \w* \w of bondage| strong="H5650" \w*.\f + \fr 20:2 \ft bondage: Heb. servants \f* 
\v 3 \w Thou shalt have no other| strong="H312" \w* \w gods| strong="H430" \w* \w before me| strong="H6440" \w*. 
\v 4 [Thou shalt not make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto thee any graven image| strong="H6459" \w*, \w or any likeness| strong="H8544" \w* of any thing \w that| strong="H834" \w* is \w in heaven| strong="H8064" \w* \w above| strong="H4605" \w*, or that is \w in the earth| strong="H776" \w* beneath, or that is \w in the water| strong="H4325" \w* \w under the earth| strong="H776" \w*: 
\v 5 [Thou shalt not bow down]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} [thyself to them, nor serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8714”} them: for I the \sc Lord\sc* \w thy God| strong="H430" \w* am \w a jealous| strong="H7067" \w* \w God| strong="H410" \w*, [visiting]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8802”} \w the iniquity| strong="H5771" \w* \w of the fathers| strong="H1" \w* \w upon the children| strong="H1121" \w* \w unto the third| strong="H8029" \w* \w and fourth| strong="H7256" \w* generation [of them that hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} me; 
\v 6 [And shewing]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w mercy| strong="H2617" \w* \w unto thousands| strong="H505" \w* [of them that love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} [me, and keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w my commandments| strong="H4687" \w*. 
\v 7 [Thou shalt not take]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w the name| strong="H8034" \w* of the \sc Lord\sc* \w thy God| strong="H430" \w* \w in vain| strong="H7723" \w*; for the \sc Lord\sc* [will not hold him guiltless]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8762”} [that taketh]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w his name| strong="H8034" \w* \w in vain| strong="H7723" \w*. 
\v 8 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8800”} \w the sabbath| strong="H7676" \w* \w day| strong="H3117" \w*, [to keep it holy]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8763”}. 
\v 9 \w Six| strong="H8337" \w* \w days| strong="H3117" \w* [shalt thou labour]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”}, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w all thy work| strong="H4399" \w*: 
\v 10 \w But the seventh| strong="H7637" \w* \w day| strong="H3117" \w* is \w the sabbath| strong="H7676" \w* of the \sc Lord\sc* \w thy God| strong="H430" \w*: in it [thou shalt not do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w any work| strong="H4399" \w*, [thou, nor thy son]{strong=“H1121”}, \w nor thy daughter| strong="H1323" \w*, \w thy manservant| strong="H5650" \w*, \w nor thy maidservant| strong="H519" \w*, \w nor thy cattle| strong="H929" \w*, \w nor thy stranger| strong="H1616" \w* that is \w within thy gates| strong="H8179" \w*: 
\v 11 For in \w six| strong="H8337" \w* \w days| strong="H3117" \w* the \sc Lord\sc* [made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w heaven| strong="H8064" \w* \w and earth| strong="H776" \w*, \w the sea| strong="H3220" \w*, and all that in them is, [and rested]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8799”} \w the seventh| strong="H7637" \w* \w day| strong="H3117" \w*: wherefore the \sc Lord\sc* [blessed ]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} \w the sabbath| strong="H7676" \w* \w day| strong="H3117" \w*, [and hallowed]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8762”} it. 
\p
\v 12 [Honour]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8761”} \w thy father| strong="H1" \w* \w and thy mother| strong="H517" \w*: \w that thy days| strong="H3117" \w* [may be long]{strong=“H748” x-morph=“strongMorph: \sc Th\sc*8686”} \w upon the land| strong="H127" \w* which the \sc Lord\sc* \w thy God| strong="H430" \w* [giveth ]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} thee. 
\v 13 [Thou shalt not kill]{strong=“H7523” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 14 [Thou shalt not commit adultery]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 15 [Thou shalt not steal]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 16 [Thou shalt not bear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w false| strong="H8267" \w* \w witness| strong="H5707" \w* \w against thy neighbour| strong="H7453" \w*. 
\v 17 [Thou shalt not covet]{strong=“H2530” x-morph=“strongMorph: \sc Th\sc*8799”} [thy neighbour’s]{strong=“H7453”} \w house| strong="H1004" \w*, [thou shalt not covet]{strong=“H2530” x-morph=“strongMorph: \sc Th\sc*8799”} [thy neighbour’s]{strong=“H7453”} \w wife| strong="H802" \w*, \w nor his manservant| strong="H5650" \w*, \w nor his maidservant| strong="H519" \w*, \w nor his ox| strong="H7794" \w*, \w nor his ass| strong="H2543" \w*, nor any thing that is [thy neighbour’s]{strong=“H7453”}. 
\p
\v 18 \w And all the people| strong="H5971" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} \w the thunderings| strong="H6963" \w*, \w and the lightnings| strong="H3940" \w*, \w and the noise| strong="H6963" \w* \w of the trumpet| strong="H7782" \w*, \w and the mountain| strong="H2022" \w* \w smoking| strong="H6226" \w*: \w and when the people| strong="H5971" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} it, [they removed]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8799”}, [and stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w afar off| strong="H7350" \w*. 
\v 19 [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w*, [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} [thou with us, and we will hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}: \w but let not God| strong="H430" \w* [speak ]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [with us, lest we die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 20 \w And Moses| strong="H4872" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the people| strong="H5971" \w*, [Fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [not: for God]{strong=“H430”} [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w to| strong="H5668" \w* [prove]{strong=“H5254” x-morph=“strongMorph: \sc Th\sc*8763”} [you, and that his fear]{strong=“H3374”} \w may be before your faces| strong="H6440" \w*, [that ye sin]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8799”} not. 
\v 21 \w And the people| strong="H5971" \w* [stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w afar off| strong="H7350" \w*, \w and Moses| strong="H4872" \w* [drew near]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto the thick darkness| strong="H6205" \w* \w where God| strong="H430" \w* was. 
\p
\v 22 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w*, [Thus thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [Ye have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} [that I have talked]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w with you from heaven| strong="H8064" \w*. 
\v 23 [Ye shall not make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w with me gods| strong="H430" \w* \w of silver| strong="H3701" \w*, [neither shall ye make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto you gods| strong="H430" \w* \w of gold| strong="H2091" \w*. 
\p
\v 24 \w An altar| strong="H4196" \w* \w of earth| strong="H127" \w* [thou shalt make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, and shalt sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8804”} \w thereon thy burnt offerings| strong="H5930" \w*, \w and thy peace offerings| strong="H8002" \w*, \w thy sheep| strong="H6629" \w*, \w and thine oxen| strong="H1241" \w*: \w in all places| strong="H4725" \w* [where I record]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8686”} \w my name| strong="H8034" \w* [I will come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee, and I will bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”} thee. 
\v 25 [And if thou wilt make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w me an altar| strong="H4196" \w* \w of stone| strong="H68" \w*, [thou shalt not build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w it of hewn stone| strong="H1496" \w*: [for if thou lift up]{strong=“H5130” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy tool| strong="H2719" \w* [upon it, thou hast polluted]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8762”} it.\f + \fr 20:25 \ft build…: Heb. build them with hewing \f* 
\v 26 [Neither shalt thou go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w by steps| strong="H4609" \w* \w unto mine altar| strong="H4196" \w*, \w that thy nakedness| strong="H6172" \w* [be not discovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8735”} thereon.
\c 21
\p 
\v 1 Now these are \w the judgments| strong="H4941" \w* [which thou shalt set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* them. 
\v 2 [If thou buy]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8799”} \w an Hebrew| strong="H5680" \w* \w servant| strong="H5650" \w*, \w six| strong="H8337" \w* \w years| strong="H8141" \w* [he shall serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”}: \w and in the seventh| strong="H7637" \w* [he shall go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w free| strong="H2670" \w* \w for nothing| strong="H2600" \w*. 
\v 3 [If he came in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w by himself| strong="H1610" \w*, [he shall go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w by himself| strong="H1610" \w*: [if he were married]{strong=“H802 H1167”}, \w then his wife| strong="H802" \w* [shall go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} with him.\f + \fr 21:3 \ft by himself: Heb. with his body \f* 
\v 4 \w If his master| strong="H113" \w* [have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w him a wife| strong="H802" \w*, [and she have born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} \w him sons| strong="H1121" \w* \w or daughters| strong="H1323" \w*; \w the wife| strong="H802" \w* \w and her children| strong="H3206" \w* [shall be her master’s]{strong=“H113”}, [and he shall go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w by himself| strong="H1610" \w*. 
\v 5 \w And if the servant| strong="H5650" \w* [shall plainly]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} \w my master| strong="H113" \w*, \w my wife| strong="H802" \w*, \w and my children| strong="H1121" \w*; [I will not go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w free| strong="H2670" \w*:\f + \fr 21:5 \ft shall…: Heb. saying shall say \f* 
\v 6 \w Then his master| strong="H113" \w* [shall bring]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8689”} \w him unto the judges| strong="H430" \w*; [he shall also bring]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8689”} \w him to the door| strong="H1817" \w*, \w or unto the door post| strong="H4201" \w*; \w and his master| strong="H113" \w* [shall bore]{strong=“H7527” x-morph=“strongMorph: \sc Th\sc*8804”} \w his ear| strong="H241" \w* \w through with an aul| strong="H4836" \w*; [and he shall serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} \w him for ever| strong="H5769" \w*. 
\p
\v 7 \w And if a man| strong="H376" \w* [sell]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8799”} \w his daughter| strong="H1323" \w* \w to be a maidservant| strong="H519" \w*, [she shall not go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w as the menservants| strong="H5650" \w* [do]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 8 [If she please]{strong=“H5869 H7451”} \w not her master| strong="H113" \w*, [who hath betrothed]{strong=“H3259” x-morph=“strongMorph: \sc Th\sc*8804”} [her to himself, then shall he let her be redeemed]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8689”}: [to sell]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8800”} \w her unto a strange| strong="H5237" \w* \w nation| strong="H5971" \w* [he shall have no power]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8799”}, [seeing he hath dealt deceitfully]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8800”} with her.\f + \fr 21:8 \ft please…: Heb. be evil in the eyes of, etc \f* 
\v 9 [And if he have betrothed]{strong=“H3259” x-morph=“strongMorph: \sc Th\sc*8799”} \w her unto his son| strong="H1121" \w*, [he shall deal]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w with her after the manner| strong="H4941" \w* \w of daughters| strong="H1323" \w*. 
\v 10 [If he take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w him another| strong="H312" \w* wife; \w her food| strong="H7607" \w*, \w her raiment| strong="H3682" \w*, \w and her duty of marriage| strong="H5772" \w*, [shall he not diminish]{strong=“H1639” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 11 [And if he do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w not these three| strong="H7969" \w* [unto her, then shall she go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w free| strong="H2600" \w* \w without money| strong="H3701" \w*. 
\p
\v 12 [He that smiteth]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8688”} \w a man| strong="H376" \w*, [so that he die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}, [shall be surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}. 
\v 13 [And if a man lie not in wait]{strong=“H6658” x-morph=“strongMorph: \sc Th\sc*8804”}, \w but God| strong="H430" \w* [deliver]{strong=“H579” x-morph=“strongMorph: \sc Th\sc*8765”} him \w into his hand| strong="H3027" \w*; [then I will appoint]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee a place| strong="H4725" \w* [whither he shall flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 14 \w But if a man| strong="H376" \w* [come presumptuously]{strong=“H2102” x-morph=“strongMorph: \sc Th\sc*8686”} \w upon his neighbour| strong="H7453" \w*, [to slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8800”} \w him with guile| strong="H6195" \w*; [thou shalt take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w him from mine altar| strong="H4196" \w*, [that he may die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\p
\v 15 [And he that smiteth]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8688”} \w his father| strong="H1" \w*, \w or his mother| strong="H517" \w*, [shall be surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}. 
\p
\v 16 [And he that stealeth]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8802”} \w a man| strong="H376" \w*, [and selleth]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8804”} [him, or if he be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8738”} \w in his hand| strong="H3027" \w*, [he shall surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}. 
\p
\v 17 [And he that curseth]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8764”} \w his father| strong="H1" \w*, \w or his mother| strong="H517" \w*, [shall surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}.\f + \fr 21:17 \ft curseth: or, revileth \f* 
\p
\v 18 \w And if men| strong="H582" \w* [strive]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”} [together, and one]{strong=“H376”} [smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w another| strong="H7453" \w* \w with a stone| strong="H68" \w*, \w or| strong="H176" \w* with his \w fist| strong="H106" \w*, [and he die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} [not, but keepeth]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} his \w bed| strong="H4904" \w*:\f + \fr 21:18 \ft another: or, his neighbour \f* 
\v 19 [If he rise again]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8694”} \w abroad| strong="H2351" \w* \w upon his staff| strong="H4938" \w*, [then shall he that smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8688”} him [be quit]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8738”}: [only he shall pay]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} for \w the loss of his time| strong="H7674" \w*, and shall cause him [to be thoroughly]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8763”} [healed]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8762”}.\f + \fr 21:19 \ft the loss…: Heb. his ceasing \f* 
\p
\v 20 \w And if a man| strong="H376" \w* [smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w his servant| strong="H5650" \w*, \w or his maid| strong="H519" \w*, \w with a rod| strong="H7626" \w*, [and he die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”} \w under his hand| strong="H3027" \w*; [he shall be surely]{strong=“H5358” x-morph=“strongMorph: \sc Th\sc*8800”} [punished]{strong=“H5358” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 21:20 \ft punished: Heb. avenged \f* 
\v 21 \w Notwithstanding| strong="H389" \w*, [if he continue]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w a day| strong="H3117" \w* \w or two| strong="H8147" \w*, [he shall not be punished]{strong=“H5358” x-morph=“strongMorph: \sc Th\sc*8714”}: for he is \w his money| strong="H3701" \w*. 
\p
\v 22 \w If men| strong="H582" \w* [strive]{strong=“H5327” x-morph=“strongMorph: \sc Th\sc*8735”}, [and hurt]{strong=“H5062” x-morph=“strongMorph: \sc Th\sc*8804”} \w a woman| strong="H802" \w* \w with child| strong="H2030" \w*, \w so that her fruit| strong="H3206" \w* [depart]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} from her, \w and yet no mischief follow| strong="H611" \w*: [he shall be surely]{strong=“H6064” x-morph=“strongMorph: \sc Th\sc*8800”} [punished]{strong=“H6064” x-morph=“strongMorph: \sc Th\sc*8735”}, [according as the woman’s]{strong=“H802”} \w husband| strong="H1167" \w* [will lay]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} [upon him; and he shall pay]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w as the judges| strong="H6414" \w* determine. 
\v 23 And if any \w mischief follow| strong="H611" \w*, [then thou shalt give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w life| strong="H5315" \w* \w for life| strong="H5315" \w*, 
\v 24 \w Eye| strong="H5869" \w* \w for eye| strong="H5869" \w*, \w tooth| strong="H8127" \w* \w for tooth| strong="H8127" \w*, \w hand| strong="H3027" \w* \w for hand| strong="H3027" \w*, \w foot| strong="H7272" \w* \w for foot| strong="H7272" \w*, 
\v 25 \w Burning| strong="H3555" \w* \w for burning| strong="H3555" \w*, \w wound| strong="H6482" \w* \w for wound| strong="H6482" \w*, \w stripe| strong="H2250" \w* \w for stripe| strong="H2250" \w*. 
\p
\v 26 \w And if a man| strong="H376" \w* [smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w the eye| strong="H5869" \w* \w of his servant| strong="H5650" \w*, \w or the eye| strong="H5869" \w* \w of his maid| strong="H519" \w*, [that it perish]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8765”}; [he shall let him go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w free| strong="H2670" \w* \w for| strong="H8478" \w* [his eye’s]{strong=“H5869”} sake. 
\v 27 [And if he smite]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8686”} [out his manservant’s]{strong=“H5650”} \w tooth| strong="H8127" \w*, [or his maidservant’s]{strong=“H519”} \w tooth| strong="H8127" \w*; [he shall let him go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w free| strong="H2670" \w* [for his tooth’s]{strong=“H8127”} sake. 
\p
\v 28 \w If an ox| strong="H7794" \w* [gore]{strong=“H5055” x-morph=“strongMorph: \sc Th\sc*8799”} \w a man| strong="H376" \w* \w or a woman| strong="H802" \w*, [that they die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}: \w then the ox| strong="H7794" \w* [shall be surely]{strong=“H5619” x-morph=“strongMorph: \sc Th\sc*8800”} [stoned]{strong=“H5619” x-morph=“strongMorph: \sc Th\sc*8735”}, \w and his flesh| strong="H1320" \w* [shall not be eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8735”}; \w but the owner| strong="H1167" \w* \w of the ox| strong="H7794" \w* shall be \w quit| strong="H5355" \w*. 
\v 29 \w But if the ox| strong="H7794" \w* \w were wont to push with his horn| strong="H5056" \w* [in time past]{strong=“H8032 H8543”}, [and it hath been testified]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8717”} \w to his owner| strong="H1167" \w*, [and he hath not kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} [him in, but that he hath killed]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8689”} \w a man| strong="H376" \w* \w or a woman| strong="H802" \w*; \w the ox| strong="H7794" \w* [shall be stoned]{strong=“H5619” x-morph=“strongMorph: \sc Th\sc*8735”}, \w and his owner| strong="H1167" \w* [also shall be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}. 
\v 30 [If there be laid]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8714”} \w on him a sum of money| strong="H3724" \w*, [then he shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w for the ransom| strong="H6306" \w* \w of his life| strong="H5315" \w* [whatsoever is laid]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8714”} upon him. 
\v 31 [Whether he have gored]{strong=“H5055” x-morph=“strongMorph: \sc Th\sc*8799”} \w a son| strong="H1121" \w*, \w or| strong="H176" \w* [have gored]{strong=“H5055” x-morph=“strongMorph: \sc Th\sc*8799”} \w a daughter| strong="H1323" \w*, \w according to this judgment| strong="H4941" \w* [shall it be done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8735”} unto him. 
\v 32 \w If the ox| strong="H7794" \w* [shall push]{strong=“H5055” x-morph=“strongMorph: \sc Th\sc*8799”} \w a manservant| strong="H5650" \w* \w or a maidservant| strong="H519" \w*; [he shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto their master| strong="H113" \w* \w thirty| strong="H7970" \w* \w shekels| strong="H8255" \w* \w of silver| strong="H3701" \w*, \w and the ox| strong="H7794" \w* [shall be stoned]{strong=“H5619” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\p
\v 33 \w And if a man| strong="H376" \w* [shall open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} \w a pit| strong="H953" \w*, \w or if a man| strong="H376" \w* [shall dig]{strong=“H3738” x-morph=“strongMorph: \sc Th\sc*8799”} \w a pit| strong="H953" \w*, [and not cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} [it, and an ox]{strong=“H7794”} \w or an ass| strong="H2543" \w* [fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} therein; 
\v 34 \w The owner| strong="H1167" \w* \w of the pit| strong="H953" \w* shall make it [good]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”}, and [give]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w money| strong="H3701" \w* \w unto the owner| strong="H1167" \w* [of them; and the dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”} beast shall be his. 
\p
\v 35 [And if one man’s]{strong=“H376”} \w ox| strong="H7794" \w* [hurt]{strong=“H5062” x-morph=“strongMorph: \sc Th\sc*8799”} [another’s]{strong=“H7453”}, [that he die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}; [then they shall sell]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8804”} \w the live| strong="H2416" \w* \w ox| strong="H7794" \w*, [and divide]{strong=“H2673” x-morph=“strongMorph: \sc Th\sc*8804”} \w the money| strong="H3701" \w* [of it; and the dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”} ox [also they shall divide]{strong=“H2673” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 36 [Or if it be known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8738”} \w that the ox| strong="H7794" \w* \w hath used to push| strong="H5056" \w* [in time past]{strong=“H8032 H8543”}, \w and his owner| strong="H1167" \w* [hath not kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} [him in; he shall surely]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8763”} [pay]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w ox| strong="H7794" \w* \w for ox| strong="H7794" \w*; [and the dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”} shall be his own. 
\c 22
\p 
\v 1 \w If a man| strong="H376" \w* [shall steal]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8799”} \w an ox| strong="H7794" \w*, \w or a sheep| strong="H7716" \w*, [and kill]{strong=“H2873” x-morph=“strongMorph: \sc Th\sc*8804”} [it, or sell]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8804”} [it; he shall restore]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w five| strong="H2568" \w* \w oxen| strong="H1241" \w* \w for an ox| strong="H7794" \w*, \w and four| strong="H702" \w* \w sheep| strong="H6629" \w* \w for a sheep| strong="H7716" \w*.\f + \fr 22:1 \ft or a sheep: or, or a goat \f* 
\p
\v 2 \w If a thief| strong="H1590" \w* [be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”} \w breaking up| strong="H4290" \w*, [and be smitten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8717”} [that he die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}, there shall \w no blood| strong="H1818" \w* be shed for him. 
\v 3 \w If the sun| strong="H8121" \w* [be risen]{strong=“H2224” x-morph=“strongMorph: \sc Th\sc*8804”} upon him, there shall be \w blood| strong="H1818" \w* shed for him; for [he should make full]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8763”} [restitution]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”}; [if he have nothing, then he shall be sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8738”} \w for his theft| strong="H1591" \w*. 
\v 4 \w If the theft| strong="H1591" \w* [be certainly]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8736”} [found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”} \w in his hand| strong="H3027" \w* \w alive| strong="H2416" \w*, \w whether it be ox| strong="H7794" \w*, \w or ass| strong="H2543" \w*, \w or sheep| strong="H7716" \w*; [he shall restore]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w double| strong="H8147" \w*. 
\p
\v 5 \w If a man| strong="H376" \w* \w shall cause a field| strong="H7704" \w* \w or vineyard| strong="H3754" \w* [to be eaten]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8686”}, [and shall put]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w in his beast| strong="H1165" \w*, [and shall feed]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8765”} [in another man’s]{strong=“H312”} \w field| strong="H7704" \w*; \w of the best| strong="H4315" \w* \w of his own field| strong="H7704" \w*, \w and of the best| strong="H4315" \w* \w of his own vineyard| strong="H3754" \w*, [shall he make restitution]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\p
\v 6 \w If fire| strong="H784" \w* [break out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”}, [and catch]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thorns| strong="H6975" \w*, \w so that the stacks of corn| strong="H1430" \w*, \w or the standing corn| strong="H7054" \w*, \w or the field| strong="H7704" \w*, [be consumed]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8738”} therewith; [he that kindled]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8686”} \w the fire| strong="H1200" \w* [shall surely]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8763”} [make restitution]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\p
\v 7 \w If a man| strong="H376" \w* [shall deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his neighbour| strong="H7453" \w* \w money| strong="H3701" \w* \w or stuff| strong="H3627" \w* [to keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”}, [and it be stolen]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8795”} [out of the man’s]{strong=“H376”} \w house| strong="H1004" \w*; \w if the thief| strong="H1590" \w* [be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”}, [let him pay]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w double| strong="H8147" \w*. 
\v 8 \w If the thief| strong="H1590" \w* \w be not| strong="H3808" \w* [found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”}, \w then the master| strong="H1167" \w* \w of the house| strong="H1004" \w* [shall be brought]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto the judges| strong="H430" \w*, to see [whether he have put]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w his hand| strong="H3027" \w* [unto his neighbour’s]{strong=“H7453”} \w goods| strong="H4399" \w*. 
\v 9 \w For all manner| strong="H1697" \w* \w of trespass| strong="H6588" \w*, whether it be \w for ox| strong="H7794" \w*, \w for ass| strong="H2543" \w*, \w for sheep| strong="H7716" \w*, \w for raiment| strong="H8008" \w*, or \w for any manner of lost thing| strong="H9" \w*, which another [challengeth]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [to be his, the cause]{strong=“H1697”} \w of both parties| strong="H8147" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w before the judges| strong="H430" \w*; and \w whom the judges| strong="H430" \w* [shall condemn]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8686”}, [he shall pay]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w double| strong="H8147" \w* \w unto his neighbour| strong="H7453" \w*. 
\v 10 \w If a man| strong="H376" \w* [deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his neighbour| strong="H7453" \w* \w an ass| strong="H2543" \w*, \w or an ox| strong="H7794" \w*, \w or a sheep| strong="H7716" \w*, \w or any beast| strong="H929" \w*, [to keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8800”}; [and it die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}, [or be hurt]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8738”}, [or driven away]{strong=“H7617” x-morph=“strongMorph: \sc Th\sc*8738”}, [no man seeing]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} it: 
\v 11 Then \w shall an oath| strong="H7621" \w* of the \sc Lord\sc* \w be between them both| strong="H8147" \w*, [that he hath not put]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w his hand| strong="H3027" \w* [unto his neighbour’s]{strong=“H7453”} \w goods| strong="H4399" \w*; \w and the owner| strong="H1167" \w* [of it shall accept]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} thereof, and he shall not make it [good]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 12 [And if it be stolen]{strong=“H1589 H1589” x-morph=“strongMorph: \sc Th\sc*8735 strongMorph: \sc Th\sc*8800”} [from him, he shall make restitution]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto the owner| strong="H1167" \w* thereof. 
\v 13 [If it be torn in pieces]{strong=“H2963 H2963” x-morph=“strongMorph: \sc Th\sc*8735 strongMorph: \sc Th\sc*8800”}, then [let him bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} it for \w witness| strong="H5707" \w*, and [he shall not make good]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w that which was torn| strong="H2966" \w*. 
\p
\v 14 \w And if a man| strong="H376" \w* [borrow]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} ought \w of his neighbour| strong="H7453" \w*, [and it be hurt]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8738”}, [or die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the owner| strong="H1167" \w* thereof being \w not with it| strong="H5973" \w*, [he shall surely]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8763”} make it [good]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 15 But \w if the owner| strong="H1167" \w* thereof be with it, he shall not make it [good]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”}: if it be \w an hired| strong="H7916" \w* thing, [it came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w for his hire| strong="H7939" \w*. 
\p
\v 16 \w And if a man| strong="H376" \w* [entice]{strong=“H6601” x-morph=“strongMorph: \sc Th\sc*8762”} \w a maid| strong="H1330" \w* [that is not betrothed]{strong=“H781” x-morph=“strongMorph: \sc Th\sc*8795”}, [and lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8804”} [with her, he shall surely]{strong=“H4117” x-morph=“strongMorph: \sc Th\sc*8800”} [endow]{strong=“H4117” x-morph=“strongMorph: \sc Th\sc*8799”} \w her to be his wife| strong="H802" \w*. 
\v 17 \w If her father| strong="H1" \w* [utterly]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8763”} [refuse]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8762”} [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} [her unto him, he shall pay]{strong=“H8254” x-morph=“strongMorph: \sc Th\sc*8799”} \w money| strong="H3701" \w* \w according to the dowry| strong="H4119" \w* \w of virgins| strong="H1330" \w*.\f + \fr 22:17 \ft pay: Heb. weigh \f* 
\p
\v 18 [Thou shalt not suffer a witch]{strong=“H3784” x-morph=“strongMorph: \sc Th\sc*8764”} [to live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\p
\v 19 [Whosoever lieth]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8802”} \w with a beast| strong="H929" \w* [shall surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}. 
\p
\v 20 [He that sacrificeth]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8802”} unto any \w god| strong="H430" \w*, \w save| strong="H1115" \w* unto the \sc Lord\sc* [only, he shall be utterly destroyed]{strong=“H2763” x-morph=“strongMorph: \sc Th\sc*8714”}. 
\p
\v 21 [Thou shalt neither vex]{strong=“H3238” x-morph=“strongMorph: \sc Th\sc*8686”} \w a stranger| strong="H1616" \w*, [nor oppress]{strong=“H3905” x-morph=“strongMorph: \sc Th\sc*8799”} [him: for ye were strangers]{strong=“H1616”} \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*. 
\p
\v 22 [Ye shall not afflict]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8762”} \w any widow| strong="H490" \w*, \w or fatherless child| strong="H3490" \w*. 
\v 23 \w If| strong="H518" \w* [thou afflict]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8762”} [them in any wise]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8763”}, [and they cry]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8799”} [at all]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8800”} [unto me, I will surely]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w their cry| strong="H6818" \w*; 
\v 24 \w And my wrath| strong="H639" \w* [shall wax hot]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8804”}, [and I will kill]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”} \w you with the sword| strong="H2719" \w*; \w and your wives| strong="H802" \w* \w shall be widows| strong="H490" \w*, \w and your children| strong="H1121" \w* \w fatherless| strong="H3490" \w*. 
\p
\v 25 [If thou lend]{strong=“H3867” x-morph=“strongMorph: \sc Th\sc*8686”} \w money| strong="H3701" \w* to any of \w my people| strong="H5971" \w* that is \w poor| strong="H6041" \w* [by thee, thou shalt not be to him as an usurer]{strong=“H5383” x-morph=“strongMorph: \sc Th\sc*8802”}, [neither shalt thou lay]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon him usury| strong="H5392" \w*. 
\v 26 [If thou at all]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8800”} \w take| strong="H2254" \w* [thy neighbour’s]{strong=“H7453”} \w raiment| strong="H8008" \w* [to pledge]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8799”}, [thou shalt deliver]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w it unto him by| strong="H5704" \w* \w that the sun| strong="H8121" \w* [goeth down]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}: 
\v 27 For that is \w his covering| strong="H3682" \w* only, it is \w his raiment| strong="H8071" \w* \w for his skin| strong="H5785" \w*: [wherein shall he sleep]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”}? [and it shall come to pass, when he crieth]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, that I will hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}; for I am \w gracious| strong="H2587" \w*. 
\p
\v 28 [Thou shalt not revile]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8762”} \w the gods| strong="H430" \w*, [nor curse]{strong=“H779” x-morph=“strongMorph: \sc Th\sc*8799”} \w the ruler| strong="H5387" \w* \w of thy people| strong="H5971" \w*.\f + \fr 22:28 \ft gods: or, judges \f* 
\p
\v 29 [Thou shalt not delay]{strong=“H309” x-morph=“strongMorph: \sc Th\sc*8762”} to offer \w the first of thy ripe fruits| strong="H4395" \w*, \w and of thy liquors| strong="H1831" \w*: \w the firstborn| strong="H1060" \w* \w of thy sons| strong="H1121" \w* [shalt thou give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} unto me.\f + \fr 22:29 \ft the first…: Heb. thy fulness \f* \f + \fr 22:29 \ft liquors: Heb. tear \f* 
\v 30 \w Likewise| strong="H3651" \w* [shalt thou do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w with thine oxen| strong="H7794" \w*, and \w with thy sheep| strong="H6629" \w*: \w seven| strong="H7651" \w* \w days| strong="H3117" \w* \w it shall be with his dam| strong="H517" \w*; \w on the eighth| strong="H8066" \w* \w day| strong="H3117" \w* [thou shalt give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} it me. 
\p
\v 31 \w And ye shall be holy| strong="H6944" \w* \w men| strong="H582" \w* [unto me: neither shall ye eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} any \w flesh| strong="H1320" \w* that is \w torn of beasts| strong="H2966" \w* \w in the field| strong="H7704" \w*; [ye shall cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w it to the dogs| strong="H3611" \w*. 
\c 23
\p 
\v 1 [Thou shalt not raise]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w a false| strong="H7723" \w* \w report| strong="H8088" \w*: [put]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w not thine hand| strong="H3027" \w* \w with the wicked| strong="H7563" \w* \w to be an unrighteous| strong="H2555" \w* \w witness| strong="H5707" \w*.\f + \fr 23:1 \ft raise: or, receive \f* 
\p
\v 2 \w Thou shalt not follow| strong="H310" \w* \w a multitude| strong="H7227" \w* to do \w evil| strong="H7451" \w*; [neither shalt thou speak]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w in a cause| strong="H7379" \w* [to decline]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8800”} \w after| strong="H310" \w* \w many| strong="H7227" \w* [to wrest]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8687”} judgment:\f + \fr 23:2 \ft speak: Heb. answer \f* 
\p
\v 3 [Neither shalt thou countenance]{strong=“H1921” x-morph=“strongMorph: \sc Th\sc*8799”} \w a poor| strong="H1800" \w* \w man in his cause| strong="H7379" \w*. 
\p
\v 4 [If thou meet]{strong=“H6293” x-morph=“strongMorph: \sc Th\sc*8799”} [thine enemy’s]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w ox| strong="H7794" \w* \w or his ass| strong="H2543" \w* [going astray]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8802”}, [thou shalt surely]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} \w bring it back| strong="H7725" \w* [to him again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 5 [If thou see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the ass| strong="H2543" \w* [of him that hateth]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} [thee lying]{strong=“H7257” x-morph=“strongMorph: \sc Th\sc*8802”} \w under his burden| strong="H4853" \w*, [and wouldest forbear]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8804”} [to help]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8800”} [him, thou shalt surely]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8800”} [help]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} with him.\f + \fr 23:5 \ft and…: or, wilt thou cease to help him? or, and wouldest cease to leave thy business for him: thou shalt surely leave it to join with him \f* 
\v 6 [Thou shalt not wrest]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w the judgment| strong="H4941" \w* \w of thy poor| strong="H34" \w* \w in his cause| strong="H7379" \w*. 
\v 7 [Keep thee far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8799”} \w from a false| strong="H8267" \w* \w matter| strong="H1697" \w*; \w and the innocent| strong="H5355" \w* \w and righteous| strong="H6662" \w* [slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} [thou not: for I will not justify]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8686”} \w the wicked| strong="H7563" \w*. 
\p
\v 8 [And thou shalt take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w no gift| strong="H7810" \w*: \w for the gift| strong="H7810" \w* [blindeth]{strong=“H5786” x-morph=“strongMorph: \sc Th\sc*8762”} \w the wise| strong="H6493" \w*, [and perverteth]{strong=“H5557” x-morph=“strongMorph: \sc Th\sc*8762”} \w the words| strong="H1697" \w* \w of the righteous| strong="H6662" \w*.\f + \fr 23:8 \ft the wise: Heb. the seeing \f* 
\p
\v 9 [Also thou shalt not oppress]{strong=“H3905” x-morph=“strongMorph: \sc Th\sc*8799”} \w a stranger| strong="H1616" \w*: [for ye know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w the heart| strong="H5315" \w* \w of a stranger| strong="H1616" \w*, \w seeing| strong="H3588" \w* \w ye were strangers| strong="H1616" \w* \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*.\f + \fr 23:9 \ft heart: Heb. soul \f* 
\p
\v 10 \w And six| strong="H8337" \w* \w years| strong="H8141" \w* [thou shalt sow]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy land| strong="H776" \w*, [and shalt gather]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the fruits| strong="H8393" \w* thereof: 
\v 11 \w But the seventh| strong="H7637" \w* year [thou shalt let it rest]{strong=“H8058” x-morph=“strongMorph: \sc Th\sc*8799”} [and lie]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8804”} [still; that the poor]{strong=“H34”} \w of thy people| strong="H5971" \w* [may eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”}: \w and what they leave| strong="H3499" \w* \w the beasts| strong="H2416" \w* \w of the field| strong="H7704" \w* [shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}. [In like manner thou shalt deal]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w with thy vineyard| strong="H3754" \w*, and \w with thy oliveyard| strong="H2132" \w*.\f + \fr 23:11 \ft oliveyard: or, olive trees \f* 
\v 12 \w Six| strong="H8337" \w* \w days| strong="H3117" \w* [thou shalt do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy work| strong="H4639" \w*, \w and on the seventh| strong="H7637" \w* \w day| strong="H3117" \w* [thou shalt rest]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8799”}: \w that thine ox| strong="H7794" \w* \w and thine ass| strong="H2543" \w* [may rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the son| strong="H1121" \w* \w of thy handmaid| strong="H519" \w*, \w and the stranger| strong="H1616" \w*, [may be refreshed]{strong=“H5314” x-morph=“strongMorph: \sc Th\sc*8735”}. 
