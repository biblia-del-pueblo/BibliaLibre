\v 12 \w And Moses| strong="H4872" \w* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w before| strong="H6440" \w* the \sc Lord\sc*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Behold, the children]{strong=“H1121”} \w of Israel| strong="H3478" \w* [have not hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me; how then shall Pharaoh]{strong=“H6547”} [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w me| strong="H589" \w*, who am \w of uncircumcised| strong="H6189" \w* \w lips| strong="H8193" \w*? 
\v 13 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w* \w and unto Aaron| strong="H175" \w*, [and gave them a charge]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, \w and unto Pharaoh| strong="H6547" \w* \w king| strong="H4428" \w* \w of Egypt| strong="H4714" \w*, [to bring]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8687”} \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* \w out of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*. 
\p
\v 14 These be \w the heads| strong="H7218" \w* [of their fathers’]{strong=“H1”} \w houses| strong="H1004" \w*: \w The sons| strong="H1121" \w* \w of Reuben| strong="H7205" \w* \w the firstborn| strong="H1060" \w* \w of Israel| strong="H3478" \w*; \w Hanoch| strong="H2585" \w*, \w and Pallu| strong="H6396" \w*, \w Hezron| strong="H2696" \w*, \w and Carmi| strong="H3756" \w*: these be \w the families| strong="H4940" \w* \w of Reuben| strong="H7205" \w*. 
