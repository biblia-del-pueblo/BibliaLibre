\p
\v 16 \w Now the priest| strong="H3548" \w* \w of Midian| strong="H4080" \w* \w had seven| strong="H7651" \w* \w daughters| strong="H1323" \w*: [and they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and drew]{strong=“H1802” x-morph=“strongMorph: \sc Th\sc*8799”} water, [and filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8762”} \w the troughs| strong="H7298" \w* [to water]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8687”} [their father’s]{strong=“H1”} \w flock| strong="H6629" \w*.\f + \fr 2:16 \ft priest: or, prince \f* 
\v 17 [And the shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and drove them away]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8762”}: \w but Moses| strong="H4872" \w* [stood up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} [and helped]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} [them, and watered]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8686”} \w their flock| strong="H6629" \w*. 
\v 18 [And when they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Reuel| strong="H7467" \w* \w their father| strong="H1" \w*, [he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w How| strong="H4069" \w* is it that [ye are come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [so soon]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8765”} \w to day| strong="H3117" \w*?\f + \fr 2:18 \ft Reuel: called also Jethro, or, Jether \f* 
\v 19 [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [An Egyptian]{strong=“H376 H4713”} [delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} \w us out of the hand| strong="H3027" \w* [of the shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}, [and also drew]{strong=“H1802” x-morph=“strongMorph: \sc Th\sc*8804”} water [enough]{strong=“H1802” x-morph=“strongMorph: \sc Th\sc*8800”} [for us, and watered]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8686”} \w the flock| strong="H6629" \w*. 
\v 20 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his daughters| strong="H1323" \w*, And where is he? why is it that [ye have left]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} \w the man| strong="H376" \w*? [call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} [him, that he may eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w bread| strong="H3899" \w*. 
\v 21 \w And Moses| strong="H4872" \w* [was content]{strong=“H2974” x-morph=“strongMorph: \sc Th\sc*8686”} [to dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} \w with the man| strong="H376" \w*: [and he gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w Moses| strong="H4872" \w* \w Zipporah| strong="H6855" \w* \w his daughter| strong="H1323" \w*. 
\v 22 [And she bare]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8799”} him \w a son| strong="H1121" \w*, [and he called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w his name| strong="H8034" \w* \w Gershom| strong="H1647" \w*: [for he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w I have been a stranger| strong="H1616" \w* \w in a strange| strong="H5237" \w* \w land| strong="H776" \w*.\f + \fr 2:22 \ft Gershom: that is, A stranger here \f* 
\p
\v 23 [And it came to pass in process]{strong=“H7227 H1992”} \w of time| strong="H3117" \w*, \w that the king| strong="H4428" \w* \w of Egypt| strong="H4714" \w* [died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}: \w and the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [sighed]{strong=“H584” x-morph=“strongMorph: \sc Th\sc*8735”} \w by reason of| strong="H4480" \w* \w the bondage| strong="H5656" \w*, [and they cried]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and their cry| strong="H7775" \w* [came up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto God| strong="H430" \w* \w by reason of the bondage| strong="H5656" \w*. 
\v 24 \w And God| strong="H430" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w their groaning| strong="H5009" \w*, \w and God| strong="H430" \w* [remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w his covenant| strong="H1285" \w* \w with Abraham| strong="H85" \w*, \w with Isaac| strong="H3327" \w*, \w and with Jacob| strong="H3290" \w*. 
\v 25 \w And God| strong="H430" \w* [looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, \w and God| strong="H430" \w* [had respect]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} unto them.\f + \fr 2:25 \ft had…: Heb. knew \f*
\c 3
\p 
\v 1 \w Now Moses| strong="H4872" \w* [kept]{strong=“H7462 H1961” x-morph=“strongMorph: \sc Th\sc*8802 strongMorph: \sc Th\sc*8804”} \w the flock| strong="H6629" \w* \w of Jethro| strong="H3503" \w* [his father in law]{strong=“H2859” x-morph=“strongMorph: \sc Th\sc*8802”}, \w the priest| strong="H3548" \w* \w of Midian| strong="H4080" \w*: [and he led]{strong=“H5090” x-morph=“strongMorph: \sc Th\sc*8799”} \w the flock| strong="H6629" \w* \w to the backside| strong="H310" \w* \w of the desert| strong="H4057" \w*, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the mountain| strong="H2022" \w* \w of God| strong="H430" \w*, even \w to Horeb| strong="H2722" \w*. 
\v 2 \w And the angel| strong="H4397" \w* of the \sc Lord\sc* [appeared]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8735”} \w unto him in a flame| strong="H3827" \w* \w of fire| strong="H784" \w* \w out of the midst| strong="H8432" \w* \w of a bush| strong="H5572" \w*: [and he looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, [and, behold, the bush]{strong=“H5572”} [burned]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8802”} \w with fire| strong="H784" \w*, \w and the bush| strong="H5572" \w* was [not consumed]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8794”}. 
\v 3 \w And Moses| strong="H4872" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will now turn aside]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8799”}, [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w this great| strong="H1419" \w* \w sight| strong="H4758" \w*, \w why| strong="H4069" \w* \w the bush| strong="H5572" \w* [is not burnt]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 4 And when the \sc Lord\sc* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [that he turned aside]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8804”} [to see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”}, \w God| strong="H430" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto him out of the midst| strong="H8432" \w* \w of the bush| strong="H5572" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Moses| strong="H4872" \w*, \w Moses| strong="H4872" \w*. [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Here am I. 
\v 5 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Draw not nigh]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} \w hither| strong="H1988" \w*: [put off]{strong=“H5394” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy shoes| strong="H5275" \w* \w from off thy feet| strong="H7272" \w*, \w for the place| strong="H4725" \w* \w whereon| strong="H834" \w* [thou standest]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} is \w holy| strong="H6944" \w* \w ground| strong="H127" \w*. 
\v 6 [Moreover he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, I am \w the God| strong="H430" \w* \w of thy father| strong="H1" \w*, \w the God| strong="H430" \w* \w of Abraham| strong="H85" \w*, \w the God| strong="H430" \w* \w of Isaac| strong="H3327" \w*, \w and the God| strong="H430" \w* \w of Jacob| strong="H3290" \w*. \w And Moses| strong="H4872" \w* [hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8686”} \w his face| strong="H6440" \w*; [for he was afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8804”} [to look]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8687”} \w upon God| strong="H430" \w*. 
\p
\v 7 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I have surely]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} [seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the affliction| strong="H6040" \w* \w of my people| strong="H5971" \w* which are \w in Egypt| strong="H4714" \w*, [and have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w their cry| strong="H6818" \w* \w by reason| strong="H6440" \w* [of their taskmasters]{strong=“H5065” x-morph=“strongMorph: \sc Th\sc*8802”}; [for I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w their sorrows| strong="H4341" \w*; 
\v 8 [And I am come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} [to deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8687”} \w them out of the hand| strong="H3027" \w* \w of the Egyptians| strong="H4714" \w*, [and to bring]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8687”} \w them up out of that land| strong="H776" \w* \w unto a good| strong="H2896" \w* \w land| strong="H776" \w* \w and a large| strong="H7342" \w*, \w unto a land| strong="H776" \w* [flowing]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”} \w with milk| strong="H2461" \w* \w and honey| strong="H1706" \w*; \w unto the place| strong="H4725" \w* \w of the Canaanites| strong="H3669" \w*, \w and the Hittites| strong="H2850" \w*, \w and the Amorites| strong="H567" \w*, \w and the Perizzites| strong="H6522" \w*, \w and the Hivites| strong="H2340" \w*, \w and the Jebusites| strong="H2983" \w*. 
\v 9 [Now therefore, behold, the cry]{strong=“H6818”} \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me: and I have also seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the oppression| strong="H3906" \w* \w wherewith the Egyptians| strong="H4714" \w* [oppress]{strong=“H3905” x-morph=“strongMorph: \sc Th\sc*8801”} them. 
\v 10 [Come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} [now therefore, and I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee unto Pharaoh| strong="H6547" \w*, [that thou mayest bring forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8685”} \w my people| strong="H5971" \w* \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* \w out of Egypt| strong="H4714" \w*. 
\p
\v 11 \w And Moses| strong="H4872" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto God| strong="H430" \w*, Who am [I, that I should go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Pharaoh| strong="H6547" \w*, [and that I should bring forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* \w out of Egypt| strong="H4714" \w*? 
\v 12 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Certainly I will be with thee; and this shall be \w a token| strong="H226" \w* [unto thee, that]{strong=“H3588”} [I have sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [thee: When thou hast brought forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8687”} \w the people| strong="H5971" \w* \w out of Egypt| strong="H4714" \w*, [ye shall serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} \w God| strong="H430" \w* \w upon this mountain| strong="H2022" \w*. 
\v 13 \w And Moses| strong="H4872" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto God| strong="H430" \w*, Behold, when [I come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [and shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, The God]{strong=“H430”} \w of your fathers| strong="H1" \w* [hath sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [me unto you; and they shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} to me, What is \w his name| strong="H8034" \w*? [what shall I say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto them? 
\v 14 \w And God| strong="H430" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w*, \sc I [Am\sc*]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8799”} \sc [That\sc* I \sc Am\sc*]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8799”}: [and he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Thus shalt thou say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, \sc I [Am\sc* hath sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} me unto you. 
\v 15 \w And God| strong="H430" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w moreover| strong="H5750" \w* \w unto Moses| strong="H4872" \w*, [Thus shalt thou say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, The \sc Lord\sc* \w God| strong="H430" \w* \w of your fathers| strong="H1" \w*, \w the God| strong="H430" \w* \w of Abraham| strong="H85" \w*, \w the God| strong="H430" \w* \w of Isaac| strong="H3327" \w*, \w and the God| strong="H430" \w* \w of Jacob| strong="H3290" \w*, [hath sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} me unto you: this is \w my name| strong="H8034" \w* \w for ever| strong="H5769" \w*, and this is \w my memorial| strong="H2143" \w* \w unto all| strong="H1755" \w* \w generations| strong="H1755" \w*. 
\p
\v 16 [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, \w and gather| strong="H622" \w* \w the elders| strong="H2205" \w* \w of Israel| strong="H3478" \w* [together]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8804”}, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} unto them, The \sc Lord\sc* \w God| strong="H430" \w* \w of your fathers| strong="H1" \w*, \w the God| strong="H430" \w* \w of Abraham| strong="H85" \w*, \w of Isaac| strong="H3327" \w*, \w and of Jacob| strong="H3290" \w*, [appeared]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8738”} [unto me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [I have surely]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8800”} [visited]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} you, and seen [that which is done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8803”} \w to you in Egypt| strong="H4714" \w*: 
\v 17 [And I have said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will bring]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w you up out of the affliction| strong="H6040" \w* \w of Egypt| strong="H4714" \w* \w unto the land| strong="H776" \w* \w of the Canaanites| strong="H3669" \w*, \w and the Hittites| strong="H2850" \w*, \w and the Amorites| strong="H567" \w*, \w and the Perizzites| strong="H6522" \w*, \w and the Hivites| strong="H2340" \w*, \w and the Jebusites| strong="H2983" \w*, \w unto a land| strong="H776" \w* [flowing]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”} \w with milk| strong="H2461" \w* \w and honey| strong="H1706" \w*. 
\v 18 [And they shall hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w to thy voice| strong="H6963" \w*: [and thou shalt come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, \w thou and the elders| strong="H2205" \w* \w of Israel| strong="H3478" \w*, \w unto the king| strong="H4428" \w* \w of Egypt| strong="H4714" \w*, [and ye shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} unto him, The \sc Lord\sc* \w God| strong="H430" \w* \w of the Hebrews| strong="H5680" \w* [hath met]{strong=“H7136” x-morph=“strongMorph: \sc Th\sc*8738”} [with us: and now let us go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [we beseech thee, three]{strong=“H7969”} [days’]{strong=“H3117”} \w journey| strong="H1870" \w* \w into the wilderness| strong="H4057" \w*, [that we may sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} to the \sc Lord\sc* \w our God| strong="H430" \w*. 
\p
\v 19 [And I am sure]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w that the king| strong="H4428" \w* \w of Egypt| strong="H4714" \w* [will not let]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [you go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”}, [no, not by a mighty]{strong=“H2389”} \w hand| strong="H3027" \w*.\f + \fr 3:19 \ft no…: or, but by strong hand \f* 
\v 20 [And I will stretch out]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w my hand| strong="H3027" \w*, [and smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w Egypt| strong="H4714" \w* [with all my wonders]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} [which I will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the midst| strong="H7130" \w* [thereof: and after]{strong=“H310”} [that he will let you go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 21 [And I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w this people| strong="H5971" \w* \w favour| strong="H2580" \w* \w in the sight| strong="H5869" \w* \w of the Egyptians| strong="H4714" \w*: [and it shall come to pass, that, when ye go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [ye shall not go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w empty| strong="H7387" \w*: 
\v 22 \w But every woman| strong="H802" \w* [shall borrow]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8804”} \w of her neighbour| strong="H7934" \w*, [and of her that sojourneth]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8802”} \w in her house| strong="H1004" \w*, \w jewels| strong="H3627" \w* \w of silver| strong="H3701" \w*, \w and jewels| strong="H3627" \w* \w of gold| strong="H2091" \w*, \w and raiment| strong="H8071" \w*: [and ye shall put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} them \w upon your sons| strong="H1121" \w*, \w and upon your daughters| strong="H1323" \w*; [and ye shall spoil]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8765”} \w the Egyptians| strong="H4714" \w*.\f + \fr 3:22 \ft the Egyptians: or, Egypt \f*
\c 4
\p 
\v 1 \w And Moses| strong="H4872" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [But, behold, they will not believe]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”} [me, nor hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto my voice| strong="H6963" \w*: [for they will say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, The \sc Lord\sc* [hath not appeared]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8738”} unto thee. 
\v 2 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, What is \w that in thine hand| strong="H3027" \w*? [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w A rod| strong="H4294" \w*. 
\v 3 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8685”} \w it on the ground| strong="H776" \w*. [And he cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w it on the ground| strong="H776" \w*, \w and it became a serpent| strong="H5175" \w*; \w and Moses| strong="H4872" \w* [fled]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”} \w from before| strong="H6440" \w* it. 
\v 4 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w*, [Put forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8798”} \w thine hand| strong="H3027" \w*, [and take]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8798”} \w it by the tail| strong="H2180" \w*. [And he put forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w his hand| strong="H3027" \w*, [and caught]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8686”} [it, and it became a rod]{strong=“H4294”} \w in his hand| strong="H3709" \w*: 
\v 5 [That they may believe]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”} that the \sc Lord\sc* \w God| strong="H430" \w* \w of their fathers| strong="H1" \w*, \w the God| strong="H430" \w* \w of Abraham| strong="H85" \w*, \w the God| strong="H430" \w* \w of Isaac| strong="H3327" \w*, \w and the God| strong="H430" \w* \w of Jacob| strong="H3290" \w*, [hath appeared]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8738”} unto thee. 
\p
\v 6 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w furthermore| strong="H5750" \w* [unto him, Put]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8685”} \w now thine hand| strong="H3027" \w* \w into thy bosom| strong="H2436" \w*. [And he put]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w his hand| strong="H3027" \w* \w into his bosom| strong="H2436" \w*: [and when he took]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} [it out, behold, his hand]{strong=“H3027”} was [leprous]{strong=“H6879” x-morph=“strongMorph: \sc Th\sc*8794”} \w as snow| strong="H7950" \w*. 
\v 7 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Put| strong="H7725" \w* \w thine hand| strong="H3027" \w* \w into thy bosom| strong="H2436" \w* [again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”}. \w And he put| strong="H7725" \w* \w his hand| strong="H3027" \w* \w into his bosom| strong="H2436" \w* [again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”}; [and plucked]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w it out of his bosom| strong="H2436" \w*, [and, behold, it was turned again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} as his other \w flesh| strong="H1320" \w*. 
\v 8 [And it shall come to pass, if they will not believe]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”} [thee, neither hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the voice| strong="H6963" \w* \w of the first| strong="H7223" \w* \w sign| strong="H226" \w*, [that they will believe]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8689”} \w the voice| strong="H6963" \w* \w of the latter| strong="H314" \w* \w sign| strong="H226" \w*. 
\v 9 [And it shall come to pass, if they will not believe]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”} \w also these two| strong="H8147" \w* \w signs| strong="H226" \w*, [neither hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto thy voice| strong="H6963" \w*, [that thou shalt take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the water| strong="H4325" \w* \w of the river| strong="H2975" \w*, [and pour]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8804”} it \w upon the dry| strong="H3004" \w* land: \w and the water| strong="H4325" \w* [which thou takest]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of the river| strong="H2975" \w* \w shall become blood| strong="H1818" \w* \w upon the dry| strong="H3006" \w* land.\f + \fr 4:9 \ft shall become: Heb. shall be and shall be \f* 
\p
\v 10 \w And Moses| strong="H4872" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc*, \w O| strong="H994" \w* \w my Lord| strong="H136" \w*, \w I| strong="H376" \w* am \w not eloquent| strong="H1697" \w*, [neither heretofore]{strong=“H8543 H8032”}, \w nor since| strong="H227" \w* [thou hast spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w unto thy servant| strong="H5650" \w*: but I am \w slow| strong="H3515" \w* \w of speech| strong="H6310" \w*, \w and of a slow| strong="H3515" \w* \w tongue| strong="H3956" \w*.\f + \fr 4:10 \ft eloquent: Heb. a man of words \f* \f + \fr 4:10 \ft heretofore: Heb. since yesterday, nor since the third day \f* 
\v 11 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Who hath made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} [man’s]{strong=“H120”} \w mouth| strong="H6310" \w*? [or who maketh]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w the dumb| strong="H483" \w*, \w or deaf| strong="H2795" \w*, \w or the seeing| strong="H6493" \w*, \w or the blind| strong="H5787" \w*? have not I the \sc Lord\sc*? 
\v 12 [Now therefore go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, \w and I will be with thy mouth| strong="H6310" \w*, [and teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8689”} [thee what thou shalt say]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 13 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w O| strong="H994" \w* \w my Lord| strong="H136" \w*, [send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8798”}, [I pray thee, by the hand]{strong=“H3027”} of him whom [thou wilt send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 4:13 \ft wilt: or, shouldest \f* 
\v 14 \w And the anger| strong="H639" \w* of the \sc Lord\sc* [was kindled]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8799”} \w against Moses| strong="H4872" \w*, [and he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Is \w not Aaron| strong="H175" \w* \w the Levite| strong="H3881" \w* \w thy brother| strong="H251" \w*? [I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [that he can speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [well]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”}. [And also, behold, he cometh forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} [to meet]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} [thee: and when he seeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, he will be glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his heart| strong="H3820" \w*. 
\v 15 [And thou shalt speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [unto him, and put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w words| strong="H1697" \w* \w in his mouth| strong="H6310" \w*: \w and I will be with thy mouth| strong="H6310" \w*, \w and with his mouth| strong="H6310" \w*, [and will teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8689”} [you what ye shall do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 16 [And he shall be thy spokesman]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto the people| strong="H5971" \w*: and he shall be, even \w he shall be to thee instead of a mouth| strong="H6310" \w*, \w and thou shalt be to him instead of God| strong="H430" \w*. 
\v 17 [And thou shalt take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w this rod| strong="H4294" \w* \w in thine hand| strong="H3027" \w*, [wherewith thou shalt do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w signs| strong="H226" \w*. 
\p
\v 18 \w And Moses| strong="H4872" \w* [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [and returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Jethro| strong="H3500" \w* [his father in law]{strong=“H2859” x-morph=“strongMorph: \sc Th\sc*8802”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Let me go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [I pray thee, and return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto my brethren| strong="H251" \w* which are \w in Egypt| strong="H4714" \w*, [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w whether they be yet| strong="H5750" \w* \w alive| strong="H2416" \w*. \w And Jethro| strong="H3503" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Moses| strong="H4872" \w*, [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} \w in peace| strong="H7965" \w*.\f + \fr 4:18 \ft Jethro: Heb. Jether \f* 
\v 19 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w* \w in Midian| strong="H4080" \w*, [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} \w into Egypt| strong="H4714" \w*: \w for all the men| strong="H582" \w* [are dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”} [which sought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w thy life| strong="H5315" \w*. 
\v 20 \w And Moses| strong="H4872" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w his wife| strong="H802" \w* \w and his sons| strong="H1121" \w*, [and set]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8686”} \w them upon an ass| strong="H2543" \w*, [and he returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*: \w and Moses| strong="H4872" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the rod| strong="H4294" \w* \w of God| strong="H430" \w* \w in his hand| strong="H3027" \w*. 
\v 21 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w*, [When thou goest]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} [to return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w into Egypt| strong="H4714" \w*, [see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} [that thou do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w all those wonders| strong="H4159" \w* \w before| strong="H6440" \w* \w Pharaoh| strong="H6547" \w*, [which I have put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thine hand| strong="H3027" \w*: [but I will harden]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8762”} \w his heart| strong="H3820" \w*, \w that he shall not let the people| strong="H5971" \w* [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 22 [And thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto Pharaoh| strong="H6547" \w*, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w Israel| strong="H3478" \w* is \w my son| strong="H1121" \w*, even \w my firstborn| strong="H1060" \w*: 
\v 23 [And I say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee, Let my son]{strong=“H1121”} [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8761”}, [that he may serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} [me: and if thou refuse]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8762”} [to let him go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8763”}, [behold, I will slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8802”} \w thy son| strong="H1121" \w*, even \w thy firstborn| strong="H1060" \w*. 
\p
\v 24 \w And it came to pass by the way| strong="H1870" \w* \w in the inn| strong="H4411" \w*, that the \sc Lord\sc* [met]{strong=“H6298” x-morph=“strongMorph: \sc Th\sc*8799”} [him, and sought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} [to kill]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8687”} him. 
\v 25 \w Then Zipporah| strong="H6855" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a sharp stone| strong="H6864" \w*, [and cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} \w the foreskin| strong="H6190" \w* \w of her son| strong="H1121" \w*, [and cast]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8686”} it \w at his feet| strong="H7272" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Surely a bloody| strong="H1818" \w* \w husband| strong="H2860" \w* art thou to me.\f + \fr 4:25 \ft sharp…: or, knife \f* \f + \fr 4:25 \ft cast…: Heb. made it touch \f* 
\v 26 [So he let him go]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8799”}: [then she said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w A bloody| strong="H1818" \w* \w husband| strong="H2860" \w* thou art, \w because of the circumcision| strong="H4139" \w*. 
\p
\v 27 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Aaron| strong="H175" \w*, [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} \w into the wilderness| strong="H4057" \w* [to meet]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} \w Moses| strong="H4872" \w*. [And he went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [and met]{strong=“H6298” x-morph=“strongMorph: \sc Th\sc*8799”} \w him in the mount| strong="H2022" \w* \w of God| strong="H430" \w*, [and kissed]{strong=“H5401” x-morph=“strongMorph: \sc Th\sc*8799”} him. 
\v 28 \w And Moses| strong="H4872" \w* [told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w Aaron| strong="H175" \w* \w all the words| strong="H1697" \w* of the \sc Lord\sc* [who had sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [him, and all the signs]{strong=“H226”} [which he had commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} him. 
\p
\v 29 \w And Moses| strong="H4872" \w* \w and Aaron| strong="H175" \w* [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [and gathered together]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the elders| strong="H2205" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*: 
\v 30 \w And Aaron| strong="H175" \w* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w all the words| strong="H1697" \w* which the \sc Lord\sc* [had spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto Moses| strong="H4872" \w*, [and did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w the signs| strong="H226" \w* \w in the sight| strong="H5869" \w* \w of the people| strong="H5971" \w*. 
\v 31 \w And the people| strong="H5971" \w* [believed]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”}: [and when they heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} that the \sc Lord\sc* [had visited]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [and that he had looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon their affliction| strong="H6040" \w*, [then they bowed their heads]{strong=“H6915” x-morph=“strongMorph: \sc Th\sc*8799”} [and worshipped]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”}. 
\c 5
\p 
\v 1 \w And afterward| strong="H310" \w* \w Moses| strong="H4872" \w* \w and Aaron| strong="H175" \w* [went in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, [and told]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Pharaoh| strong="H6547" \w*, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w*, \w Let my people| strong="H5971" \w* [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8761”}, [that they may hold a feast]{strong=“H2287” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto me in the wilderness| strong="H4057" \w*. 
\v 2 \w And Pharaoh| strong="H6547" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Who is the \sc Lord\sc*, [that I should obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w his voice| strong="H6963" \w* \w to let Israel| strong="H3478" \w* [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8763”}? [I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} not the \sc Lord\sc*, \w neither will I let Israel| strong="H3478" \w* [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\p
\v 3 [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w The God| strong="H430" \w* \w of the Hebrews| strong="H5680" \w* [hath met]{strong=“H7122” x-morph=“strongMorph: \sc Th\sc*8738”} [with us: let us go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [we pray thee, three]{strong=“H7969”} [days’]{strong=“H3117”} \w journey| strong="H1870" \w* \w into the desert| strong="H4057" \w*, [and sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc* \w our God| strong="H430" \w*; [lest he fall]{strong=“H6293” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon us with pestilence| strong="H1698" \w*, \w or with the sword| strong="H2719" \w*. 
\v 4 \w And the king| strong="H4428" \w* \w of Egypt| strong="H4714" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Wherefore do ye, Moses]{strong=“H4872”} \w and Aaron| strong="H175" \w*, [let]{strong=“H6544” x-morph=“strongMorph: \sc Th\sc*8686”} \w the people| strong="H5971" \w* \w from their works| strong="H4639" \w*? [get]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} \w you unto your burdens| strong="H5450" \w*. 
