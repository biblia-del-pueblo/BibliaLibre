\v 4 And these are \w the garments| strong="H899" \w* [which they shall make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}; \w a breastplate| strong="H2833" \w*, \w and an ephod| strong="H646" \w*, \w and a robe| strong="H4598" \w*, \w and a broidered| strong="H8665" \w* \w coat| strong="H3801" \w*, \w a mitre| strong="H4701" \w*, \w and a girdle| strong="H73" \w*: [and they shall make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w holy| strong="H6944" \w* \w garments| strong="H899" \w* \w for Aaron| strong="H175" \w* \w thy brother| strong="H251" \w*, \w and his sons| strong="H1121" \w*, [that he may minister unto me in the priest’s office]{strong=“H3547” x-morph=“strongMorph: \sc Th\sc*8763”}. 
