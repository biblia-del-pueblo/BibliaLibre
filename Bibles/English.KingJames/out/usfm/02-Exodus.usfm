\v 23 \w And Pharaoh| strong="H6547" \w* [turned]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8799”} [and went]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into his house| strong="H1004" \w*, [neither did he set]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8804”} \w his heart| strong="H3820" \w* \w to this| strong="H2063" \w* also. 
\v 24 \w And all the Egyptians| strong="H4714" \w* [digged ]{strong=“H2658” x-morph=“strongMorph: \sc Th\sc*8799”} \w round about| strong="H5439" \w* \w the river| strong="H2975" \w* \w for water| strong="H4325" \w* [to drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”}; [for they could]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8804”} [not drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”} \w of the water| strong="H4325" \w* \w of the river| strong="H2975" \w*. 
\v 25 \w And seven| strong="H7651" \w* \w days| strong="H3117" \w* [were fulfilled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”}, \w after| strong="H310" \w* that the \sc Lord\sc* [had smitten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8687”} \w the river| strong="H2975" \w*.
\c 8
\p 
\v 1 And the \sc Lord\sc* [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w*, [Go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto Pharaoh| strong="H6547" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto him, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w Let my people| strong="H5971" \w* [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8761”}, [that they may serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} me. 
\v 2 \w And if thou refuse| strong="H3986" \w* to let them [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8763”}, [behold, I will smite]{strong=“H5062” x-morph=“strongMorph: \sc Th\sc*8802”} \w all thy borders| strong="H1366" \w* \w with frogs| strong="H6854" \w*: 
\v 3 \w And the river| strong="H2975" \w* \w shall bring forth| strong="H8317" \w* \w frogs| strong="H6854" \w* [abundantly]{strong=“H8317” x-morph=“strongMorph: \sc Th\sc*8804”}, [which shall go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} [and come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into thine house| strong="H1004" \w*, [and into thy bedchamber]{strong=“H4904 H2315”}, \w and upon thy bed| strong="H4296" \w*, \w and into the house| strong="H1004" \w* \w of thy servants| strong="H5650" \w*, \w and upon thy people| strong="H5971" \w*, \w and into thine ovens| strong="H8574" \w*, \w and into thy kneadingtroughs| strong="H4863" \w*:\f + \fr 8:3 \ft kneadingtroughs: or, dough \f* 
\v 4 \w And the frogs| strong="H6854" \w* [shall come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} [both on thee, and upon thy people]{strong=“H5971”}, \w and upon all thy servants| strong="H5650" \w*. 
\p
\v 5 And the \sc Lord\sc* [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w*, [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto Aaron| strong="H175" \w*, [Stretch forth]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8798”} \w thine hand| strong="H3027" \w* \w with thy rod| strong="H4294" \w* \w over the streams| strong="H5104" \w*, \w over the rivers| strong="H2975" \w*, \w and over the ponds| strong="H98" \w*, \w and cause frogs| strong="H6854" \w* [to come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8685”} \w upon the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*. 
\v 6 \w And Aaron| strong="H175" \w* [stretched out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8799”} \w his hand| strong="H3027" \w* \w over the waters| strong="H4325" \w* \w of Egypt| strong="H4714" \w*; \w and the frogs| strong="H6854" \w* [came up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”}, [and covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*. 
\v 7 \w And the magicians| strong="H2748" \w* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w so with their enchantments| strong="H3909" \w*, [and brought up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w frogs| strong="H6854" \w* \w upon the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*. 
\p
\v 8 \w Then Pharaoh| strong="H6547" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w for Moses| strong="H4872" \w* \w and Aaron| strong="H175" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Intreat]{strong=“H6279” x-morph=“strongMorph: \sc Th\sc*8685”} the \sc Lord\sc*, [that he may take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8686”} \w the frogs| strong="H6854" \w* [from me, and from my people]{strong=“H5971”}; \w and I will let the people| strong="H5971" \w* [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”}, [that they may do sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc*. 
\v 9 \w And Moses| strong="H4872" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Pharaoh| strong="H6547" \w*, [Glory]{strong=“H6286” x-morph=“strongMorph: \sc Th\sc*8690”} [over me: when]{strong=“H4970”} [shall I intreat]{strong=“H6279” x-morph=“strongMorph: \sc Th\sc*8686”} [for thee, and for thy servants]{strong=“H5650”}, \w and for thy people| strong="H5971" \w*, [to destroy]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8687”} \w the frogs| strong="H6854" \w* \w from thee and thy houses| strong="H1004" \w*, that [they may remain]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the river| strong="H2975" \w* only?\f + \fr 8:9 \ft Glory…: or, Have this honour over me, etc \f* \f + \fr 8:9 \ft when: or, against when \f* \f + \fr 8:9 \ft to destroy: Heb. to cut off \f* 
\v 10 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w To morrow| strong="H4279" \w*. [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Be it \w according to thy word| strong="H1697" \w*: [that thou mayest know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} that there is none like unto the \sc Lord\sc* \w our God| strong="H430" \w*.\f + \fr 8:10 \ft To morrow: or, Against to morrow \f* 
\v 11 \w And the frogs| strong="H6854" \w* [shall depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8804”} [from thee, and from thy houses]{strong=“H1004”}, \w and from thy servants| strong="H5650" \w*, \w and from thy people| strong="H5971" \w*; [they shall remain]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the river| strong="H2975" \w* only. 
\v 12 \w And Moses| strong="H4872" \w* \w and Aaron| strong="H175" \w* [went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w from Pharaoh| strong="H6547" \w*: \w and Moses| strong="H4872" \w* [cried]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc* \w because of| strong="H1697" \w* \w the frogs| strong="H6854" \w* [which he had brought]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w against Pharaoh| strong="H6547" \w*. 
\v 13 And the \sc Lord\sc* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w according to the word| strong="H1697" \w* \w of Moses| strong="H4872" \w*; \w and the frogs| strong="H6854" \w* [died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of the houses| strong="H1004" \w*, \w out of the villages| strong="H2691" \w*, \w and out of the fields| strong="H7704" \w*. 
\v 14 [And they gathered them together]{strong=“H6651” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon heaps| strong="H2563" \w*: \w and the land| strong="H776" \w* [stank]{strong=“H887” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 15 \w But when Pharaoh| strong="H6547" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w that there was respite| strong="H7309" \w*, [he hardened]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8687”} \w his heart| strong="H3820" \w*, [and hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} not unto them; as the \sc Lord\sc* [had said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\p
\v 16 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w*, [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto Aaron| strong="H175" \w*, [Stretch out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy rod| strong="H4294" \w*, [and smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8685”} \w the dust| strong="H6083" \w* \w of the land| strong="H776" \w*, \w that it may become lice| strong="H3654" \w* \w throughout all the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*. 
\v 17 [And they did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [so; for Aaron]{strong=“H175”} [stretched out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8799”} \w his hand| strong="H3027" \w* \w with his rod| strong="H4294" \w*, [and smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w the dust| strong="H6083" \w* \w of the earth| strong="H776" \w*, \w and it became lice| strong="H3654" \w* \w in man| strong="H120" \w*, \w and in beast| strong="H929" \w*; \w all the dust| strong="H6083" \w* \w of the land| strong="H776" \w* \w became lice| strong="H3654" \w* \w throughout all the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*. 
\v 18 \w And the magicians| strong="H2748" \w* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w so with their enchantments| strong="H3909" \w* [to bring forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8687”} \w lice| strong="H3654" \w*, [but they could]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8804”} [not: so there were lice]{strong=“H3654”} \w upon man| strong="H120" \w*, \w and upon beast| strong="H929" \w*. 
\v 19 \w Then the magicians| strong="H2748" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Pharaoh| strong="H6547" \w*, This is \w the finger| strong="H676" \w* \w of God| strong="H430" \w*: [and Pharaoh’s]{strong=“H6547”} \w heart| strong="H3820" \w* [was hardened]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8799”}, [and he hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} not unto them; as the \sc Lord\sc* [had said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\p
\v 20 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w*, [Rise up early]{strong=“H7925” x-morph=“strongMorph: \sc Th\sc*8685”} \w in the morning| strong="H1242" \w*, [and stand]{strong=“H3320” x-morph=“strongMorph: \sc Th\sc*8690”} \w before| strong="H6440" \w* \w Pharaoh| strong="H6547" \w*; [lo, he cometh forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the water| strong="H4325" \w*; [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto him, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w Let my people| strong="H5971" \w* [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8761”}, [that they may serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} me. 
\v 21 [Else, if thou wilt not let my people]{strong=“H5971”} [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8764”}, [behold, I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8688”} \w swarms| strong="H6157" \w* of flies [upon thee, and upon thy servants]{strong=“H5650”}, \w and upon thy people| strong="H5971" \w*, \w and into thy houses| strong="H1004" \w*: \w and the houses| strong="H1004" \w* \w of the Egyptians| strong="H4714" \w* [shall be full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of swarms| strong="H6157" \w* of flies, \w and also the ground| strong="H127" \w* whereon they are.\f + \fr 8:21 \ft swarms…: or, a mixture of noisome beasts, etc \f* 
\v 22 [And I will sever]{strong=“H6395” x-morph=“strongMorph: \sc Th\sc*8689”} \w in that day| strong="H3117" \w* \w the land| strong="H776" \w* \w of Goshen| strong="H1657" \w*, \w in which my people| strong="H5971" \w* [dwell]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”}, \w that no| strong="H1115" \w* \w swarms| strong="H6157" \w* of flies [shall be]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8800”} [there; to the end]{strong=“H4616”} [thou mayest know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} that I am the \sc Lord\sc* \w in the midst| strong="H7130" \w* \w of the earth| strong="H776" \w*. 
\v 23 [And I will put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w a division| strong="H6304" \w* \w between my people| strong="H5971" \w* \w and thy people| strong="H5971" \w*: \w to morrow| strong="H4279" \w* \w shall this sign| strong="H226" \w* be.\f + \fr 8:23 \ft a division: Heb. a redemption \f* \f + \fr 8:23 \ft to morrow: or, by to morrow \f* 
\v 24 And the \sc Lord\sc* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [so; and there came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w a grievous| strong="H3515" \w* \w swarm| strong="H6157" \w* of flies \w into the house| strong="H1004" \w* \w of Pharaoh| strong="H6547" \w*, and into [his servants’]{strong=“H5650”} \w houses| strong="H1004" \w*, \w and into all the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*: \w the land| strong="H776" \w* [was corrupted]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8735”} \w by reason| strong="H6440" \w* \w of the swarm| strong="H6157" \w* of flies.\f + \fr 8:24 \ft corrupted: or, destroyed \f* 
\p
\v 25 \w And Pharaoh| strong="H6547" \w* [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w for| strong="H413" \w* \w Moses| strong="H4872" \w* \w and for Aaron| strong="H175" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} [ye, sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8798”} \w to your God| strong="H430" \w* \w in the land| strong="H776" \w*. 
\v 26 \w And Moses| strong="H4872" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [It is not meet]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8737”} [so to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”}; \w for| strong="H2005" \w* [we shall sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} \w the abomination| strong="H8441" \w* \w of the Egyptians| strong="H4714" \w* to the \sc Lord\sc* \w our God| strong="H430" \w*: [lo, shall we sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} \w the abomination| strong="H8441" \w* \w of the Egyptians| strong="H4714" \w* \w before their eyes| strong="H5869" \w*, [and will they not stone]{strong=“H5619” x-morph=“strongMorph: \sc Th\sc*8799”} us? 
\v 27 [We will go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w three| strong="H7969" \w* [days’]{strong=“H3117”} \w journey| strong="H1870" \w* \w into the wilderness| strong="H4057" \w*, [and sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8804”} to the \sc Lord\sc* \w our God| strong="H430" \w*, [as he shall command]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} us. 
\v 28 \w And Pharaoh| strong="H6547" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will let you go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”}, [that ye may sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8804”} to the \sc Lord\sc* \w your God| strong="H430" \w* \w in the wilderness| strong="H4057" \w*; [only ye shall not go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} [very]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8687”} [far away]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8686”}: [intreat]{strong=“H6279” x-morph=“strongMorph: \sc Th\sc*8685”} \w for me| strong="H1157" \w*. 
\v 29 \w And Moses| strong="H4872" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Behold, I go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} [from thee, and I will intreat]{strong=“H6279” x-morph=“strongMorph: \sc Th\sc*8689”} the \sc Lord\sc* \w that the swarms| strong="H6157" \w* of flies [may depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8804”} \w from Pharaoh| strong="H6547" \w*, \w from his servants| strong="H5650" \w*, \w and from his people| strong="H5971" \w*, \w to morrow| strong="H4279" \w*: \w but| strong="H7535" \w* \w let not Pharaoh| strong="H6547" \w* [deal deceitfully]{strong=“H2048” x-morph=“strongMorph: \sc Th\sc*8763”} [any more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w in not| strong="H1115" \w* \w letting the people| strong="H5971" \w* [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8763”} [to sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8800”} to the \sc Lord\sc*. 
\v 30 \w And Moses| strong="H4872" \w* [went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w from Pharaoh| strong="H6547" \w*, [and intreated]{strong=“H6279” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc*. 
\v 31 And the \sc Lord\sc* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w according to the word| strong="H1697" \w* \w of Moses| strong="H4872" \w*; [and he removed]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8686”} \w the swarms| strong="H6157" \w* of flies \w from Pharaoh| strong="H6547" \w*, \w from his servants| strong="H5650" \w*, \w and from his people| strong="H5971" \w*; [there remained]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8738”} \w not one| strong="H259" \w*. 
\v 32 \w And Pharaoh| strong="H6547" \w* [hardened]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8686”} \w his heart| strong="H3820" \w* \w at this time| strong="H6471" \w* [also, neither would he let the people]{strong=“H5971”} [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\c 9
\p 
\v 1 Then the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w*, [Go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} \w in unto Pharaoh| strong="H6547" \w*, [and tell]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} [him, Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w God| strong="H430" \w* \w of the Hebrews| strong="H5680" \w*, \w Let my people| strong="H5971" \w* [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8761”}, [that they may serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} me. 
\v 2 \w For if thou refuse| strong="H3986" \w* to let them [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8763”}, [and wilt hold]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8688”} them still, 
