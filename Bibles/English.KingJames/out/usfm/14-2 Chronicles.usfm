\v 4 [Wherefore he did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w evil| strong="H7451" \w* \w in the sight| strong="H5869" \w* of the \sc Lord\sc* \w like the house| strong="H1004" \w* \w of Ahab| strong="H256" \w*: [for they were his counsellors]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8802”} \w after| strong="H310" \w* \w the death| strong="H4194" \w* \w of his father| strong="H1" \w* \w to his destruction| strong="H4889" \w*. 
\p
