\v 4 This is \w the thing| strong="H1697" \w* [that ye shall do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}; \w A third part| strong="H7992" \w* [of you entering]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w on the sabbath| strong="H7676" \w*, \w of the priests| strong="H3548" \w* \w and of the Levites| strong="H3881" \w*, shall be \w porters| strong="H7778" \w* \w of the doors| strong="H5592" \w*;\f + \fr 23:4 \ft doors: Heb. thresholds \f* 
\v 5 \w And a third part| strong="H7992" \w* shall be [at the king’s]{strong=“H4428”} \w house| strong="H1004" \w*; \w and a third part| strong="H7992" \w* \w at the gate| strong="H8179" \w* \w of the foundation| strong="H3247" \w*: \w and all the people| strong="H5971" \w* shall be \w in the courts| strong="H2691" \w* \w of the house| strong="H1004" \w* of the \sc Lord\sc*. 
\v 6 [But let none come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the house| strong="H1004" \w* of the \sc Lord\sc*, \w save the priests| strong="H3548" \w*, [and they that minister]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8764”} \w of the Levites| strong="H3881" \w*; [they shall go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, for they are \w holy| strong="H6944" \w*: \w but all the people| strong="H5971" \w* [shall keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w the watch| strong="H4931" \w* of the \sc Lord\sc*. 
\v 7 \w And the Levites| strong="H3881" \w* [shall compass]{strong=“H5362” x-morph=“strongMorph: \sc Th\sc*8689”} \w the king| strong="H4428" \w* \w round about| strong="H5439" \w*, \w every man| strong="H376" \w* \w with his weapons| strong="H3627" \w* \w in his hand| strong="H3027" \w*; and whosoever else [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w into the house| strong="H1004" \w*, [he shall be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}: \w but be ye with the king| strong="H4428" \w* [when he cometh in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}, [and when he goeth out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 8 \w So the Levites| strong="H3881" \w* \w and all Judah| strong="H3063" \w* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w according to all things that Jehoiada| strong="H3077" \w* \w the priest| strong="H3548" \w* [had commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”}, [and took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w every man| strong="H376" \w* \w his men| strong="H582" \w* [that were to come in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w on the sabbath| strong="H7676" \w*, [with them that were to go]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8802”} out \w on the sabbath| strong="H7676" \w*: \w for Jehoiada| strong="H3077" \w* \w the priest| strong="H3548" \w* [dismissed]{strong=“H6358” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the courses| strong="H4256" \w*. 
\v 9 \w Moreover Jehoiada| strong="H3077" \w* \w the priest| strong="H3548" \w* [delivered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the captains| strong="H8269" \w* \w of hundreds| strong="H3967" \w* \w spears| strong="H2595" \w*, \w and bucklers| strong="H4043" \w*, \w and shields| strong="H7982" \w*, that had been \w king| strong="H4428" \w* [David’s]{strong=“H1732”}, which were \w in the house| strong="H1004" \w* \w of God| strong="H430" \w*. 
\v 10 [And he set]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8686”} \w all the people| strong="H5971" \w*, \w every man| strong="H376" \w* \w having his weapon| strong="H7973" \w* \w in his hand| strong="H3027" \w*, \w from the right| strong="H3233" \w* \w side| strong="H3802" \w* \w of the temple| strong="H1004" \w* \w to the left| strong="H8042" \w* \w side| strong="H3802" \w* \w of the temple| strong="H1004" \w*, \w along by the altar| strong="H4196" \w* \w and the temple| strong="H1004" \w*, \w by the king| strong="H4428" \w* \w round about| strong="H5439" \w*.\f + \fr 23:10 \ft side: Heb. shoulder \f* \f + \fr 23:10 \ft temple: Heb. house \f* 
