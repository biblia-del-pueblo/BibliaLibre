\v 17 [And they came up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w into Judah| strong="H3063" \w*, [and brake]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8799”} [into it, and carried away]{strong=“H7617” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the substance| strong="H7399" \w* [that was found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8737”} [in the king’s]{strong=“H4428”} \w house| strong="H1004" \w*, \w and his sons| strong="H1121" \w* [also, and his wives]{strong=“H802”}; \w so that there was never a son| strong="H1121" \w* [left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8738”} [him, save Jehoahaz]{strong=“H3059”}, \w the youngest| strong="H6996" \w* \w of his sons| strong="H1121" \w*.\f + \fr 21:17 \ft carried…: Heb. carried captive \f* \f + \fr 21:17 \ft Jehoahaz: also called, Ahaziah, or, Azariah \f* 
\p
\v 18 \w And after| strong="H310" \w* all this the \sc Lord\sc* [smote]{strong=“H5062” x-morph=“strongMorph: \sc Th\sc*8804”} \w him in his bowels| strong="H4578" \w* [with an incurable]{strong=“H4832 H369”} \w disease| strong="H2483" \w*. 
\v 19 [And it came to pass, that in process of time]{strong=“H3117”}, [after]{strong=“H6256 H3318” x-morph=“strongMorph: \sc Th\sc*8800”} \w the end| strong="H7093" \w* \w of two| strong="H8147" \w* \w years| strong="H3117" \w*, \w his bowels| strong="H4578" \w* [fell out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w by reason| strong="H5973" \w* \w of his sickness| strong="H2483" \w*: [so he died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w of sore| strong="H7451" \w* \w diseases| strong="H8463" \w*. \w And his people| strong="H5971" \w* [made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w no burning| strong="H8316" \w* [for him, like the burning]{strong=“H8316”} \w of his fathers| strong="H1" \w*. 
\v 20 \w Thirty| strong="H7970" \w* \w and two| strong="H8147" \w* \w years old| strong="H1121" \w* [was he when he began to reign]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8800”}, [and he reigned]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8804”} \w in Jerusalem| strong="H3389" \w* \w eight| strong="H8083" \w* \w years| strong="H8141" \w*, [and departed]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w without being desired| strong="H2532" \w*. [Howbeit they buried]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8799”} \w him in the city| strong="H5892" \w* \w of David| strong="H1732" \w*, \w but not in the sepulchres| strong="H6913" \w* \w of the kings| strong="H4428" \w*.\f + \fr 21:20 \ft without…: Heb. without desire \f*
