\v 8 [Send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8798”} \w me also cedar| strong="H730" \w* \w trees| strong="H6086" \w*, \w fir trees| strong="H1265" \w*, \w and algum trees| strong="H418" \w*, \w out of Lebanon| strong="H3844" \w*: [for I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w that thy servants| strong="H5650" \w* [can skill]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} [to cut]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8800”} \w timber| strong="H6086" \w* \w in Lebanon| strong="H3844" \w*; [and, behold, my servants]{strong=“H5650”} shall be \w with thy servants| strong="H5650" \w*,\f + \fr 2:8 \ft algum: also called, almuggim \f* 
\v 9 [Even to prepare]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8687”} \w me timber| strong="H6086" \w* \w in abundance| strong="H7230" \w*: \w for the house| strong="H1004" \w* [which I am about to build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8802”} shall be [wonderful]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8687”} \w great| strong="H1419" \w*.\f + \fr 2:9 \ft wonderful…: Heb. great and wonderful \f* 
