\p 
\v 1 [And the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w* \w made| strong="H4427" \w* \w Ahaziah| strong="H274" \w* \w his youngest| strong="H6996" \w* \w son| strong="H1121" \w* [king]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8686”} [in his stead: for the band of men]{strong=“H1416”} [that came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w with the Arabians| strong="H6163" \w* \w to the camp| strong="H4264" \w* [had slain]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”} \w all the eldest| strong="H7223" \w*. \w So Ahaziah| strong="H274" \w* \w the son| strong="H1121" \w* \w of Jehoram| strong="H3088" \w* \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w* [reigned]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8799”}. 
