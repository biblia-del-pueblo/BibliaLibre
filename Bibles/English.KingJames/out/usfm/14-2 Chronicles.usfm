\c 2
\p 
\v 1 \w And Solomon| strong="H8010" \w* [determined]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [to build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8800”} \w an house| strong="H1004" \w* \w for the name| strong="H8034" \w* of the \sc Lord\sc*, \w and an house| strong="H1004" \w* \w for his kingdom| strong="H4438" \w*. 
