\v 2 \w Then Solomon| strong="H8010" \w* [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto all Israel| strong="H3478" \w*, \w to the captains| strong="H8269" \w* \w of thousands| strong="H505" \w* \w and of hundreds| strong="H3967" \w*, [and to the judges]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and to every governor| strong="H5387" \w* \w in all Israel| strong="H3478" \w*, \w the chief| strong="H7218" \w* \w of the fathers| strong="H1" \w*. 
\v 3 \w So Solomon| strong="H8010" \w*, \w and all the congregation| strong="H6951" \w* [with him, went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the high place| strong="H1116" \w* that was \w at Gibeon| strong="H1391" \w*; \w for there was the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w* \w of God| strong="H430" \w*, \w which Moses| strong="H4872" \w* \w the servant| strong="H5650" \w* of the \sc Lord\sc* [had made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the wilderness| strong="H4057" \w*. 
\v 4 \w But| strong="H61" \w* \w the ark| strong="H727" \w* \w of God| strong="H430" \w* \w had David| strong="H1732" \w* [brought up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} [from Kirjath-jearim]{strong=“H7157”} to the place which \w David| strong="H1732" \w* [had prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8687”} [for it: for he had pitched]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} \w a tent| strong="H168" \w* \w for it at Jerusalem| strong="H3389" \w*. 
\v 5 \w Moreover the brasen| strong="H5178" \w* \w altar| strong="H4196" \w*, \w that Bezaleel| strong="H1212" \w* \w the son| strong="H1121" \w* \w of Uri| strong="H221" \w*, \w the son| strong="H1121" \w* \w of Hur| strong="H2354" \w*, [had made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [he put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* \w the tabernacle| strong="H4908" \w* of the \sc Lord\sc*: \w and Solomon| strong="H8010" \w* \w and the congregation| strong="H6951" \w* [sought]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”} unto it.\f + \fr 1:5 \ft he put: or, was there \f* 
\v 6 \w And Solomon| strong="H8010" \w* [went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w thither to the brasen| strong="H5178" \w* \w altar| strong="H4196" \w* \w before| strong="H6440" \w* the \sc Lord\sc*, which was \w at the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*, [and offered]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w a thousand| strong="H505" \w* \w burnt offerings| strong="H5930" \w* upon it. 
\p
\v 7 \w In that night| strong="H3915" \w* \w did God| strong="H430" \w* [appear]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto Solomon| strong="H8010" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8798”} [what I shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} thee. 
