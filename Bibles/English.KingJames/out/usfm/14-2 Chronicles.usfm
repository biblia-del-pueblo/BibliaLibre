\p
\v 11 \w And Amaziah| strong="H558" \w* [strengthened]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8694”} [himself, and led forth]{strong=“H5090” x-morph=“strongMorph: \sc Th\sc*8799”} \w his people| strong="H5971" \w*, [and went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the valley| strong="H1516" \w* \w of salt| strong="H4417" \w*, [and smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w of the children| strong="H1121" \w* \w of Seir| strong="H8165" \w* \w ten| strong="H6235" \w* \w thousand| strong="H505" \w*. 
