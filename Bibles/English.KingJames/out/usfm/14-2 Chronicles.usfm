\v 12 \w Wisdom| strong="H2451" \w* \w and knowledge| strong="H4093" \w* is [granted]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8803”} [unto thee; and I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee riches| strong="H6239" \w*, \w and wealth| strong="H5233" \w*, \w and honour| strong="H3519" \w*, \w such as none of the kings| strong="H4428" \w* have had that have been \w before| strong="H6440" \w* [thee, neither shall there any after]{strong=“H310”} thee have the like. 
\p
\v 13 \w Then Solomon| strong="H8010" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} from his journey \w to the high place| strong="H1116" \w* that was \w at Gibeon| strong="H1391" \w* \w to Jerusalem| strong="H3389" \w*, \w from before| strong="H6440" \w* \w the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*, [and reigned]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8799”} \w over Israel| strong="H3478" \w*. 
