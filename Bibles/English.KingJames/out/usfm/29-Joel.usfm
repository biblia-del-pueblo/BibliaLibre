\v 32 And it shall come to pass, that [whosoever shall call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w on the name| strong="H8034" \w* of the \sc Lord\sc* [shall be delivered]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8735”}: \w for in mount| strong="H2022" \w* \w Zion| strong="H6726" \w* \w and in Jerusalem| strong="H3389" \w* \w shall be deliverance| strong="H6413" \w*, as the \sc Lord\sc* [hath said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and in the remnant| strong="H8300" \w* whom the \sc Lord\sc* [shall call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\c 3
\p 
\v 1 [For, behold, in those days]{strong=“H3117”}, \w and in that time| strong="H6256" \w*, [when I shall bring again]{strong=“H7725 H7725” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8686”} \w the captivity| strong="H7622" \w* \w of Judah| strong="H3063" \w* \w and Jerusalem| strong="H3389" \w*, 
\v 2 [I will also gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8765”} \w all nations| strong="H1471" \w*, [and will bring them down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8689”} \w into the valley| strong="H6010" \w* \w of Jehoshaphat| strong="H3092" \w*, [and will plead]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8738”} \w with them there for my people| strong="H5971" \w* and for \w my heritage| strong="H5159" \w* \w Israel| strong="H3478" \w*, [whom they have scattered]{strong=“H6340” x-morph=“strongMorph: \sc Th\sc*8765”} \w among the nations| strong="H1471" \w*, [and parted]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8765”} \w my land| strong="H776" \w*. 
\v 3 [And they have cast]{strong=“H3032” x-morph=“strongMorph: \sc Th\sc*8804”} \w lots| strong="H1486" \w* \w for my people| strong="H5971" \w*; [and have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w a boy| strong="H3206" \w* [for an harlot]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”}, [and sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8804”} \w a girl| strong="H3207" \w* \w for wine| strong="H3196" \w*, [that they might drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 4 [Yea, and what have ye to do with me, O Tyre]{strong=“H6865”}, \w and Zidon| strong="H6721" \w*, \w and all the coasts| strong="H1552" \w* \w of Palestine| strong="H6429" \w*? [will ye render]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8764”} \w me a recompence| strong="H1576" \w*? [and if ye recompense]{strong=“H1580” x-morph=“strongMorph: \sc Th\sc*8802”} [me, swiftly]{strong=“H7031”} and \w speedily| strong="H4120" \w* [will I return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w your recompence| strong="H1576" \w* \w upon your own head| strong="H7218" \w*; 
\v 5 [Because ye have taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w my silver| strong="H3701" \w* \w and my gold| strong="H2091" \w*, [and have carried]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w into your temples| strong="H1964" \w* \w my goodly| strong="H2896" \w* \w pleasant things| strong="H4261" \w*:\f + \fr 3:5 \ft pleasant: Heb. desirable \f* 
\v 6 \w The children| strong="H1121" \w* \w also of Judah| strong="H3063" \w* \w and the children| strong="H1121" \w* \w of Jerusalem| strong="H3389" \w* [have ye sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8804”} [unto the Grecians]{strong=“H1121 H3125”}, [that ye might remove them far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8687”} \w from their border| strong="H1366" \w*.\f + \fr 3:6 \ft the Grecians: Heb. the sons of the Grecians \f* 
\v 7 [Behold, I will raise]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8688”} \w them out of the place| strong="H4725" \w* [whither ye have sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8804”} [them, and will return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} \w your recompence| strong="H1576" \w* \w upon your own head| strong="H7218" \w*: 
\v 8 [And I will sell]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8804”} \w your sons| strong="H1121" \w* \w and your daughters| strong="H1323" \w* \w into the hand| strong="H3027" \w* \w of the children| strong="H1121" \w* \w of Judah| strong="H3063" \w*, [and they shall sell]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8804”} \w them to the Sabeans| strong="H7615" \w*, \w to a people| strong="H1471" \w* \w far off| strong="H7350" \w*: for the \sc Lord\sc* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it. 
\p
\v 9 [Proclaim]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye this among the Gentiles| strong="H1471" \w*; [Prepare ]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8761”} \w war| strong="H4421" \w*, [wake up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8685”} \w the mighty men| strong="H1368" \w*, \w let all the men| strong="H582" \w* \w of war| strong="H4421" \w* [draw near]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8799”}; [let them come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”}:\f + \fr 3:9 \ft Prepare: Heb. Sanctify \f* 
\v 10 [Beat]{strong=“H3807” x-morph=“strongMorph: \sc Th\sc*8798”} \w your plowshares| strong="H855" \w* \w into swords| strong="H2719" \w*, \w and your pruninghooks| strong="H4211" \w* \w into spears| strong="H7420" \w*: \w let the weak| strong="H2523" \w* [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, I am \w strong| strong="H1368" \w*.\f + \fr 3:10 \ft pruninghooks: or, scythes \f* 
\v 11 [Assemble]{strong=“H5789” x-morph=“strongMorph: \sc Th\sc*8798”} [yourselves, and come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”}, \w all ye heathen| strong="H1471" \w*, [and gather yourselves together]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8738”} \w round about| strong="H5439" \w*: \w thither cause thy mighty ones| strong="H1368" \w* [to come down]{strong=“H5181” x-morph=“strongMorph: \sc Th\sc*8685”}, O \sc Lord\sc*.^\sc 3:11 cause…: or, the [Lord\sc* shall bring down] 
\v 12 \w Let the heathen| strong="H1471" \w* [be wakened]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8735”}, [and come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the valley| strong="H6010" \w* \w of Jehoshaphat| strong="H3092" \w*: [for there will I sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} [to judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8800”} \w all the heathen| strong="H1471" \w* \w round about| strong="H5439" \w*. 
\v 13 [Put]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye in the sickle| strong="H4038" \w*, \w for the harvest| strong="H7105" \w* [is ripe]{strong=“H1310” x-morph=“strongMorph: \sc Th\sc*8804”}: [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”}, [get you down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8798”}; \w for the press| strong="H1660" \w* [is full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the fats| strong="H3342" \w* [overflow]{strong=“H7783” x-morph=“strongMorph: \sc Th\sc*8689”}; \w for their wickedness| strong="H7451" \w* is \w great| strong="H7227" \w*. 
\v 14 \w Multitudes| strong="H1995" \w*, \w multitudes| strong="H1995" \w* \w in the valley| strong="H6010" \w* \w of decision| strong="H2742" \w*: \w for the day| strong="H3117" \w* of the \sc Lord\sc* is \w near| strong="H7138" \w* \w in the valley| strong="H6010" \w* \w of decision| strong="H2742" \w*.\f + \fr 3:14 \ft decision: or, concision, or, threshing \f* 
\v 15 \w The sun| strong="H8121" \w* \w and the moon| strong="H3394" \w* [shall be darkened]{strong=“H6937” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and the stars| strong="H3556" \w* [shall withdraw]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8804”} \w their shining| strong="H5051" \w*. 
\v 16 The \sc Lord\sc* [also shall roar]{strong=“H7580” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of Zion| strong="H6726" \w*, [and utter]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w his voice| strong="H6963" \w* \w from Jerusalem| strong="H3389" \w*; \w and the heavens| strong="H8064" \w* \w and the earth| strong="H776" \w* [shall shake]{strong=“H7493” x-morph=“strongMorph: \sc Th\sc*8804”}: but the \sc Lord\sc* will be \w the hope| strong="H4268" \w* \w of his people| strong="H5971" \w*, \w and the strength| strong="H4581" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*.\f + \fr 3:16 \ft hope: Heb. place of repair, or, harbour \f* 
