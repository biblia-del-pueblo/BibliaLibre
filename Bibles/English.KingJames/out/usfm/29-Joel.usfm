\c 1
\p 
\v 1 \w The word| strong="H1697" \w* of the \sc Lord\sc* \w that came to Joel| strong="H3100" \w* \w the son| strong="H1121" \w* \w of Pethuel| strong="H6602" \w*. 
\v 2 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [this, ye old men]{strong=“H2205”}, [and give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”}, [all ye inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the land| strong="H776" \w*. \w Hath this been in your days| strong="H3117" \w*, \w or even| strong="H518" \w* \w in the days| strong="H3117" \w* \w of your fathers| strong="H1" \w*? 
\v 3 [Tell]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8761”} \w ye your children| strong="H1121" \w* of it, and let \w your children| strong="H1121" \w* tell \w their children| strong="H1121" \w*, \w and their children| strong="H1121" \w* \w another| strong="H312" \w* \w generation| strong="H1755" \w*. 
\v 4 \w That which the palmerworm| strong="H1501" \w* \w hath left| strong="H3499" \w* \w hath the locust| strong="H697" \w* [eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”}; \w and that which the locust| strong="H697" \w* \w hath left| strong="H3499" \w* \w hath the cankerworm| strong="H3218" \w* [eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”}; \w and that which the cankerworm| strong="H3218" \w* \w hath left| strong="H3499" \w* \w hath the caterpiller| strong="H2625" \w* [eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 1:4 \ft That which the palmerworm…: Heb. The residue of the palmerworm \f* 
\v 5 [Awake]{strong=“H6974” x-morph=“strongMorph: \sc Th\sc*8685”}, \w ye drunkards| strong="H7910" \w*, [and weep]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8798”}; [and howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8685”}, [all ye drinkers]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8802”} \w of wine| strong="H3196" \w*, \w because of the new wine| strong="H6071" \w*; [for it is cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8738”} \w from your mouth| strong="H6310" \w*. 
\v 6 \w For a nation| strong="H1471" \w* [is come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon my land| strong="H776" \w*, \w strong| strong="H6099" \w*, \w and without number| strong="H4557" \w*, \w whose teeth| strong="H8127" \w* are \w the teeth| strong="H8127" \w* \w of a lion| strong="H738" \w*, \w and he hath the cheek teeth| strong="H4973" \w* \w of a great lion| strong="H3833" \w*. 
\v 7 [He hath laid]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w my vine| strong="H1612" \w* \w waste| strong="H8047" \w*, \w and barked| strong="H7111" \w* \w my fig tree| strong="H8384" \w*: [he hath made it clean]{strong=“H2834” x-morph=“strongMorph: \sc Th\sc*8800”} [bare]{strong=“H2834” x-morph=“strongMorph: \sc Th\sc*8804”}, and cast it [away]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8689”}; \w the branches| strong="H8299" \w* [thereof are made white]{strong=“H3835” x-morph=“strongMorph: \sc Th\sc*8689”}.\f + \fr 1:7 \ft barked…: Heb. laid my fig tree for a barking \f* 
\p
\v 8 [Lament]{strong=“H421” x-morph=“strongMorph: \sc Th\sc*8798”} \w like a virgin| strong="H1330" \w* [girded]{strong=“H2296” x-morph=“strongMorph: \sc Th\sc*8803”} \w with sackcloth| strong="H8242" \w* \w for the husband| strong="H1167" \w* \w of her youth| strong="H5271" \w*. 
\v 9 \w The meat offering| strong="H4503" \w* \w and the drink offering| strong="H5262" \w* [is cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8717”} \w from the house| strong="H1004" \w* of the \sc Lord\sc*; \w the priests| strong="H3548" \w*, the \sc Lord\sc*’S [ministers]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8764”}, [mourn]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 10 \w The field| strong="H7704" \w* [is wasted]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8795”}, \w the land| strong="H127" \w* [mourneth]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8804”}; \w for the corn| strong="H1715" \w* [is wasted]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8795”}: \w the new wine| strong="H8492" \w* [is dried up]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”}, \w the oil| strong="H3323" \w* [languisheth]{strong=“H535” x-morph=“strongMorph: \sc Th\sc*8797”}. 
\v 11 [Be ye ashamed]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8685”}, \w O ye husbandmen| strong="H406" \w*; [howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8685”}, \w O ye vinedressers| strong="H3755" \w*, \w for the wheat| strong="H2406" \w* \w and for the barley| strong="H8184" \w*; \w because the harvest| strong="H7105" \w* \w of the field| strong="H7704" \w* [is perished]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 12 \w The vine| strong="H1612" \w* [is dried up]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”}, \w and the fig tree| strong="H8384" \w* [languisheth]{strong=“H535” x-morph=“strongMorph: \sc Th\sc*8797”}; \w the pomegranate| strong="H7416" \w* [tree, the palm tree]{strong=“H8558”} [also, and the apple tree]{strong=“H8598”}, even \w all the trees| strong="H6086" \w* \w of the field| strong="H7704" \w*, [are withered]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8804”}: \w because joy| strong="H8342" \w* [is withered away]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”} \w from the sons| strong="H1121" \w* \w of men| strong="H120" \w*. 
\v 13 [Gird]{strong=“H2296” x-morph=“strongMorph: \sc Th\sc*8798”} [yourselves, and lament]{strong=“H5594” x-morph=“strongMorph: \sc Th\sc*8798”}, \w ye priests| strong="H3548" \w*: [howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8685”}, [ye ministers]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8764”} \w of the altar| strong="H4196" \w*: [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”}, [lie all night]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8798”} \w in sackcloth| strong="H8242" \w*, [ye ministers]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8764”} \w of my God| strong="H430" \w*: \w for the meat offering| strong="H4503" \w* \w and the drink offering| strong="H5262" \w* [is withholden]{strong=“H4513” x-morph=“strongMorph: \sc Th\sc*8738”} \w from the house| strong="H1004" \w* \w of your God| strong="H430" \w*. 
\p
\v 14 [Sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8761”} \w ye a fast| strong="H6685" \w*, [call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} \w a solemn assembly| strong="H6116" \w*, [gather]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8798”} \w the elders| strong="H2205" \w* and [all the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the land| strong="H776" \w* into \w the house| strong="H1004" \w* of the \sc Lord\sc* \w your God| strong="H430" \w*, [and cry]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8798”} unto the \sc Lord\sc*,\f + \fr 1:14 \ft solemn…: or, day of restraint \f* 
\v 15 \w Alas| strong="H162" \w* \w for the day| strong="H3117" \w*! \w for the day| strong="H3117" \w* of the \sc Lord\sc* is \w at hand| strong="H7138" \w*, \w and as a destruction| strong="H7701" \w* \w from the Almighty| strong="H7706" \w* [shall it come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 16 \w Is not the meat| strong="H400" \w* [cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8738”} \w before our eyes| strong="H5869" \w*, yea, \w joy| strong="H8057" \w* \w and gladness| strong="H1524" \w* \w from the house| strong="H1004" \w* \w of our God| strong="H430" \w*? 
\v 17 \w The seed| strong="H6507" \w* [is rotten]{strong=“H5685” x-morph=“strongMorph: \sc Th\sc*8804”} \w under their clods| strong="H4053" \w*, \w the garners| strong="H214" \w* [are laid desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8738”}, \w the barns| strong="H4460" \w* [are broken down]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8738”}; \w for the corn| strong="H1715" \w* [is withered]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”}.\f + \fr 1:17 \ft seed: Heb. grains \f* 
\v 18 \w How do the beasts| strong="H929" \w* [groan]{strong=“H584” x-morph=“strongMorph: \sc Th\sc*8737”}! \w the herds| strong="H5739" \w* \w of cattle| strong="H1241" \w* [are perplexed]{strong=“H943” x-morph=“strongMorph: \sc Th\sc*8738”}, \w because they have no pasture| strong="H4829" \w*; [yea, the flocks]{strong=“H5739”} \w of sheep| strong="H6629" \w* [are made desolate]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 19 O \sc Lord\sc*, [to thee will I cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”}: \w for the fire| strong="H784" \w* [hath devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w the pastures| strong="H4999" \w* \w of the wilderness| strong="H4057" \w*, \w and the flame| strong="H3852" \w* [hath burned]{strong=“H3857” x-morph=“strongMorph: \sc Th\sc*8765”} \w all the trees| strong="H6086" \w* \w of the field| strong="H7704" \w*.\f + \fr 1:19 \ft pastures: or, habitations \f* 
\v 20 \w The beasts| strong="H929" \w* \w of the field| strong="H7704" \w* [cry]{strong=“H6165” x-morph=“strongMorph: \sc Th\sc*8799”} [also unto thee: for the rivers]{strong=“H650”} \w of waters| strong="H4325" \w* [are dried up]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and the fire| strong="H784" \w* [hath devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w the pastures| strong="H4999" \w* \w of the wilderness| strong="H4057" \w*.
\c 2
\p 
\v 1 [Blow]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye the trumpet| strong="H7782" \w* \w in Zion| strong="H6726" \w*, [and sound an alarm]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8685”} \w in my holy| strong="H6944" \w* \w mountain| strong="H2022" \w*: [let all the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the land| strong="H776" \w* [tremble]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8799”}: \w for the day| strong="H3117" \w* of the \sc Lord\sc* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, for it is \w nigh at hand| strong="H7138" \w*;\f + \fr 2:1 \ft trumpet: or, cornet \f* 
\v 2 \w A day| strong="H3117" \w* \w of darkness| strong="H2822" \w* \w and of gloominess| strong="H653" \w*, \w a day| strong="H3117" \w* \w of clouds| strong="H6051" \w* \w and of thick darkness| strong="H6205" \w*, \w as the morning| strong="H7837" \w* [spread]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8803”} \w upon the mountains| strong="H2022" \w*: \w a great| strong="H7227" \w* \w people| strong="H5971" \w* \w and a strong| strong="H6099" \w*; [there hath not been]{strong=“H1961” x-morph=“strongMorph: \sc Th\sc*8738”} \w ever| strong="H5769" \w* [the like, neither shall be any more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w after| strong="H310" \w* it, even \w to the years| strong="H8141" \w* \w of many| strong="H1755" \w* \w generations| strong="H1755" \w*.\f + \fr 2:2 \ft of many…: Heb. of generation and generation \f* 
\v 3 \w A fire| strong="H784" \w* [devoureth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* [them; and behind]{strong=“H310”} \w them a flame| strong="H3852" \w* [burneth]{strong=“H3857” x-morph=“strongMorph: \sc Th\sc*8762”}: \w the land| strong="H776" \w* is \w as the garden| strong="H1588" \w* \w of Eden| strong="H5731" \w* \w before| strong="H6440" \w* [them, and behind]{strong=“H310”} \w them a desolate| strong="H8077" \w* \w wilderness| strong="H4057" \w*; [yea, and nothing shall escape]{strong=“H6413”} them. 
\v 4 \w The appearance| strong="H4758" \w* of them is \w as the appearance| strong="H4758" \w* \w of horses| strong="H5483" \w*; \w and as horsemen| strong="H6571" \w*, [so shall they run]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 5 \w Like the noise| strong="H6963" \w* \w of chariots| strong="H4818" \w* \w on the tops| strong="H7218" \w* \w of mountains| strong="H2022" \w* [shall they leap]{strong=“H7540” x-morph=“strongMorph: \sc Th\sc*8762”}, \w like the noise| strong="H6963" \w* \w of a flame| strong="H3851" \w* \w of fire| strong="H784" \w* [that devoureth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} \w the stubble| strong="H7179" \w*, \w as a strong| strong="H6099" \w* \w people| strong="H5971" \w* \w set in battle| strong="H4421" \w* [array]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8803”}. 
\v 6 \w Before their face| strong="H6440" \w* \w the people| strong="H5971" \w* [shall be much pained]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8799”}: \w all faces| strong="H6440" \w* [shall gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8765”} \w blackness| strong="H6289" \w*.\f + \fr 2:6 \ft blackness: Heb. pot \f* 
\v 7 [They shall run]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”} \w like mighty men| strong="H1368" \w*; [they shall climb]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w the wall| strong="H2346" \w* \w like men| strong="H582" \w* \w of war| strong="H4421" \w*; [and they shall march]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w every one| strong="H376" \w* \w on his ways| strong="H1870" \w*, [and they shall not break]{strong=“H5670” x-morph=“strongMorph: \sc Th\sc*8762”} \w their ranks| strong="H734" \w*: 
\v 8 \w Neither shall one| strong="H376" \w* [thrust]{strong=“H1766” x-morph=“strongMorph: \sc Th\sc*8799”} \w another| strong="H251" \w*; [they shall walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w every one| strong="H1397" \w* \w in his path| strong="H4546" \w*: and when [they fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the sword| strong="H7973" \w*, [they shall not be wounded]{strong=“H1214” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 2:8 \ft sword: or, dart \f* 
\v 9 [They shall run to and fro]{strong=“H8264” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the city| strong="H5892" \w*; [they shall run]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the wall| strong="H2346" \w*, [they shall climb up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the houses| strong="H1004" \w*; [they shall enter in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w at the windows| strong="H2474" \w* \w like a thief| strong="H1590" \w*. 
\v 10 \w The earth| strong="H776" \w* [shall quake]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* [them; the heavens]{strong=“H8064”} [shall tremble]{strong=“H7493” x-morph=“strongMorph: \sc Th\sc*8804”}: \w the sun| strong="H8121" \w* \w and the moon| strong="H3394" \w* [shall be dark]{strong=“H6937” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and the stars| strong="H3556" \w* [shall withdraw]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8804”} \w their shining| strong="H5051" \w*: 
\v 11 And the \sc Lord\sc* [shall utter]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w his voice| strong="H6963" \w* \w before| strong="H6440" \w* \w his army| strong="H2428" \w*: \w for his camp| strong="H4264" \w* is \w very| strong="H3966" \w* \w great| strong="H7227" \w*: for he is \w strong| strong="H6099" \w* [that executeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w his word| strong="H1697" \w*: \w for the day| strong="H3117" \w* of the \sc Lord\sc* is \w great| strong="H1419" \w* \w and very| strong="H3966" \w* [terrible]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”}; [and who can abide]{strong=“H3557” x-morph=“strongMorph: \sc Th\sc*8686”} it? 
\p
\v 12 [Therefore also now, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} ye even \w to me with all your heart| strong="H3824" \w*, \w and with fasting| strong="H6685" \w*, \w and with weeping| strong="H1065" \w*, \w and with mourning| strong="H4553" \w*: 
\v 13 [And rend]{strong=“H7167” x-morph=“strongMorph: \sc Th\sc*8798”} \w your heart| strong="H3824" \w*, \w and not your garments| strong="H899" \w*, [and turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} unto the \sc Lord\sc* \w your God| strong="H430" \w*: for he is \w gracious| strong="H2587" \w* \w and merciful| strong="H7349" \w*, \w slow| strong="H750" \w* \w to anger| strong="H639" \w*, \w and of great| strong="H7227" \w* \w kindness| strong="H2617" \w*, [and repenteth]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8737”} \w him of the evil| strong="H7451" \w*. 
\v 14 [Who knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} if [he will return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [and repent]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8738”}, [and leave]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8689”} \w a blessing| strong="H1293" \w* \w behind| strong="H310" \w* him; even \w a meat offering| strong="H4503" \w* \w and a drink offering| strong="H5262" \w* unto the \sc Lord\sc* \w your God| strong="H430" \w*? 
\p
\v 15 [Blow]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8798”} \w the trumpet| strong="H7782" \w* \w in Zion| strong="H6726" \w*, [sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8761”} \w a fast| strong="H6685" \w*, [call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} \w a solemn assembly| strong="H6116" \w*: 
\v 16 [Gather]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8798”} \w the people| strong="H5971" \w*, [sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8761”} \w the congregation| strong="H6951" \w*, [assemble]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8798”} \w the elders| strong="H2205" \w*, [gather]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8798”} \w the children| strong="H5768" \w*, [and those that suck]{strong=“H3243” x-morph=“strongMorph: \sc Th\sc*8802”} \w the breasts| strong="H7699" \w*: \w let the bridegroom| strong="H2860" \w* [go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w of his chamber| strong="H2315" \w*, \w and the bride| strong="H3618" \w* \w out of her closet| strong="H2646" \w*. 
\v 17 \w Let the priests| strong="H3548" \w*, [the ministers]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8764”} of the \sc Lord\sc*, [weep]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8799”} \w between the porch| strong="H197" \w* \w and the altar| strong="H4196" \w*, [and let them say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Spare]{strong=“H2347” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy people| strong="H5971" \w*, O \sc Lord\sc*, [and give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w not thine heritage| strong="H5159" \w* \w to reproach| strong="H2781" \w*, \w that the heathen| strong="H1471" \w* [should rule over]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8800”} [them: wherefore should they say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w among the people| strong="H5971" \w*, Where is \w their God| strong="H430" \w*?\f + \fr 2:17 \ft rule over: or, use a byword against \f* 
\p
\v 18 Then will the \sc Lord\sc* [be jealous]{strong=“H7065” x-morph=“strongMorph: \sc Th\sc*8762”} \w for his land| strong="H776" \w*, [and pity]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”} \w his people| strong="H5971" \w*. 
\v 19 Yea, the \sc Lord\sc* [will answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his people| strong="H5971" \w*, [Behold, I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8802”} \w you corn| strong="H1715" \w*, \w and wine| strong="H8492" \w*, \w and oil| strong="H3323" \w*, [and ye shall be satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8804”} [therewith: and I will no more make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w you a reproach| strong="H2781" \w* \w among the heathen| strong="H1471" \w*: 
\v 20 [But I will remove far off]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8686”} \w from you the northern| strong="H6830" \w* army, [and will drive]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8689”} \w him into a land| strong="H776" \w* \w barren| strong="H6723" \w* \w and desolate| strong="H8077" \w*, \w with his face| strong="H6440" \w* \w toward the east| strong="H6931" \w* \w sea| strong="H3220" \w*, \w and his hinder part| strong="H5490" \w* \w toward the utmost| strong="H314" \w* \w sea| strong="H3220" \w*, \w and his stink| strong="H889" \w* [shall come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and his ill savour| strong="H6709" \w* [shall come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”}, [because he hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [great things]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8689”}.\f + \fr 2:20 \ft hath…: Heb. hath magnified to do \f* 
\p
\v 21 [Fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [not, O land]{strong=“H127”}; [be glad]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8798”} [and rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8798”}: for the \sc Lord\sc* [will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [great things]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8689”}.\f + \fr 2:21 \ft will…: Heb. hath magnified to do \f* 
\v 22 [Be not afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}, \w ye beasts| strong="H929" \w* \w of the field| strong="H7704" \w*: \w for the pastures| strong="H4999" \w* \w of the wilderness| strong="H4057" \w* [do spring]{strong=“H1876” x-morph=“strongMorph: \sc Th\sc*8804”}, \w for the tree| strong="H6086" \w* [beareth ]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w her fruit| strong="H6529" \w*, \w the fig tree| strong="H8384" \w* \w and the vine| strong="H1612" \w* [do yield]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w their strength| strong="H2428" \w*. 
\v 23 [Be glad]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8798”} [then, ye children]{strong=“H1121”} \w of Zion| strong="H6726" \w*, [and rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8798”} in the \sc Lord\sc* \w your God| strong="H430" \w*: [for he hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w you the former rain| strong="H4175" \w* \w moderately| strong="H6666" \w*, [and he will cause to come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8686”} \w for you the rain| strong="H1653" \w*, \w the former rain| strong="H4175" \w*, \w and the latter rain| strong="H4456" \w* \w in the first| strong="H7223" \w* month.\f + \fr 2:23 \ft the former rain moderately: or, a teacher of righteousness \f* \f + \fr 2:23 \ft moderately: Heb. according to righteousness \f* 
\v 24 \w And the floors| strong="H1637" \w* [shall be full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of wheat| strong="H1250" \w*, \w and the fats| strong="H3342" \w* [shall overflow]{strong=“H7783” x-morph=“strongMorph: \sc Th\sc*8689”} \w with wine| strong="H8492" \w* \w and oil| strong="H3323" \w*. 
\v 25 [And I will restore]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8765”} \w to you the years| strong="H8141" \w* \w that the locust| strong="H697" \w* [hath eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the cankerworm| strong="H3218" \w*, \w and the caterpiller| strong="H2625" \w*, \w and the palmerworm| strong="H1501" \w*, \w my great| strong="H1419" \w* \w army| strong="H2428" \w* [which I sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} among you. 
\v 26 [And ye shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} [in plenty]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”}, [and be satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8800”}, [and praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8765”} \w the name| strong="H8034" \w* of the \sc Lord\sc* \w your God| strong="H430" \w*, [that hath dealt]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [wondrously]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8687”} [with you: and my people]{strong=“H5971”} \w shall never| strong="H5769" \w* [be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 27 [And ye shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am \w in the midst| strong="H7130" \w* \w of Israel| strong="H3478" \w*, and that I am the \sc Lord\sc* \w your God| strong="H430" \w*, [and none else: and my people]{strong=“H5971”} \w shall never| strong="H5769" \w* [be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 28 \w And it shall come to pass afterward| strong="H310" \w*, that [I will pour out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8799”} \w my spirit| strong="H7307" \w* \w upon all flesh| strong="H1320" \w*; \w and your sons| strong="H1121" \w* \w and your daughters| strong="H1323" \w* [shall prophesy]{strong=“H5012” x-morph=“strongMorph: \sc Th\sc*8738”}, \w your old men| strong="H2205" \w* [shall dream]{strong=“H2492” x-morph=“strongMorph: \sc Th\sc*8799”} \w dreams| strong="H2472" \w*, \w your young men| strong="H970" \w* [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w visions| strong="H2384" \w*: 
