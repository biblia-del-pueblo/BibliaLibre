\v 30 [And I will shew]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w wonders| strong="H4159" \w* \w in the heavens| strong="H8064" \w* \w and in the earth| strong="H776" \w*, \w blood| strong="H1818" \w*, \w and fire| strong="H784" \w*, \w and pillars| strong="H8490" \w* \w of smoke| strong="H6227" \w*. 
