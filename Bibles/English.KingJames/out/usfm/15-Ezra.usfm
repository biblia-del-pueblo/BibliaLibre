\v 27 \w Also twenty| strong="H6242" \w* \w basons| strong="H3713" \w* \w of gold| strong="H2091" \w*, \w of a thousand| strong="H505" \w* \w drams| strong="H150" \w*; \w and two| strong="H8147" \w* \w vessels| strong="H3627" \w* [of fine]{strong=“H6668 H2896” x-morph=“strongMorph: \sc Th\sc*8716”} \w copper| strong="H5178" \w*, \w precious| strong="H2532" \w* \w as gold| strong="H2091" \w*.\f + \fr 8:27 \ft fine…: Heb. yellow, or, shining brass \f* \f + \fr 8:27 \ft precious: Heb. desirable \f* 
\v 28 [And I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto them, Ye are \w holy| strong="H6944" \w* unto the \sc Lord\sc*; \w the vessels| strong="H3627" \w* are \w holy| strong="H6944" \w* [also; and the silver]{strong=“H3701”} \w and the gold| strong="H2091" \w* are \w a freewill offering| strong="H5071" \w* unto the \sc Lord\sc* \w God| strong="H430" \w* \w of your fathers| strong="H1" \w*. 
\v 29 [Watch]{strong=“H8245” x-morph=“strongMorph: \sc Th\sc*8798”} [ye, and keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8798”} them, [until ye weigh]{strong=“H8254” x-morph=“strongMorph: \sc Th\sc*8799”} them \w before| strong="H6440" \w* \w the chief| strong="H8269" \w* \w of the priests| strong="H3548" \w* \w and the Levites| strong="H3881" \w*, \w and chief| strong="H8269" \w* \w of the fathers| strong="H1" \w* \w of Israel| strong="H3478" \w*, \w at Jerusalem| strong="H3389" \w*, \w in the chambers| strong="H3957" \w* \w of the house| strong="H1004" \w* of the \sc Lord\sc*. 
\v 30 [So took]{strong=“H6901” x-morph=“strongMorph: \sc Th\sc*8765”} \w the priests| strong="H3548" \w* \w and the Levites| strong="H3881" \w* \w the weight| strong="H4948" \w* \w of the silver| strong="H3701" \w*, \w and the gold| strong="H2091" \w*, \w and the vessels| strong="H3627" \w*, [to bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} them \w to Jerusalem| strong="H3389" \w* \w unto the house| strong="H1004" \w* \w of our God| strong="H430" \w*. 
\p
\v 31 [Then we departed]{strong=“H5265” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the river| strong="H5104" \w* \w of Ahava| strong="H163" \w* [on the twelfth]{strong=“H6240 H8147”} day \w of the first| strong="H7223" \w* \w month| strong="H2320" \w*, [to go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto Jerusalem| strong="H3389" \w*: \w and the hand| strong="H3027" \w* \w of our God| strong="H430" \w* [was upon us, and he delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w us from the hand| strong="H3709" \w* [of the enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, [and of such as lay in wait]{strong=“H693” x-morph=“strongMorph: \sc Th\sc*8802”} \w by the way| strong="H1870" \w*. 
\v 32 [And we came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Jerusalem| strong="H3389" \w*, [and abode]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w there three| strong="H7969" \w* \w days| strong="H3117" \w*. 
\p
\v 33 \w Now on the fourth| strong="H7243" \w* \w day| strong="H3117" \w* \w was the silver| strong="H3701" \w* \w and the gold| strong="H2091" \w* \w and the vessels| strong="H3627" \w* [weighed ]{strong=“H8254” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the house| strong="H1004" \w* \w of our God| strong="H430" \w* \w by the hand| strong="H3027" \w* \w of Meremoth| strong="H4822" \w* \w the son| strong="H1121" \w* \w of Uriah| strong="H223" \w* \w the priest| strong="H3548" \w*; and with him was \w Eleazar| strong="H499" \w* \w the son| strong="H1121" \w* \w of Phinehas| strong="H6372" \w*; and with them was \w Jozabad| strong="H3107" \w* \w the son| strong="H1121" \w* \w of Jeshua| strong="H3442" \w*, \w and Noadiah| strong="H5129" \w* \w the son| strong="H1121" \w* \w of Binnui| strong="H1131" \w*, \w Levites| strong="H3881" \w*; 
\v 34 \w By number| strong="H4557" \w* and \w by weight| strong="H4948" \w* [of every one: and all the weight]{strong=“H4948”} [was written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8735”} \w at that time| strong="H6256" \w*. 
\v 35 Also \w the children| strong="H1121" \w* \w of those that had been carried away| strong="H1473" \w*, [which were come out]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the captivity| strong="H7628" \w*, [offered]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8689”} \w burnt offerings| strong="H5930" \w* \w unto the God| strong="H430" \w* \w of Israel| strong="H3478" \w*, [twelve]{strong=“H6240 H8147”} \w bullocks| strong="H6499" \w* \w for all Israel| strong="H3478" \w*, \w ninety| strong="H8673" \w* \w and six| strong="H8337" \w* \w rams| strong="H352" \w*, \w seventy| strong="H7657" \w* \w and seven| strong="H7651" \w* \w lambs| strong="H3532" \w*, [twelve]{strong=“H6240 H8147”} \w he goats| strong="H6842" \w* for \w a sin offering| strong="H2403" \w*: all this was \w a burnt offering| strong="H5930" \w* unto the \sc Lord\sc*. 
\p
\v 36 [And they delivered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [the king’s]{strong=“H4428”} \w commissions| strong="H1881" \w* [unto the king’s]{strong=“H4428”} \w lieutenants| strong="H323" \w*, \w and to the governors| strong="H6346" \w* \w on this side| strong="H5676" \w* \w the river| strong="H5104" \w*: [and they furthered]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8765”} \w the people| strong="H5971" \w*, \w and the house| strong="H1004" \w* \w of God| strong="H430" \w*. 
\c 9
\p 
\v 1 [Now when these things were done]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8763”}, \w the princes| strong="H8269" \w* [came]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8738”} [to me, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w The people| strong="H5971" \w* \w of Israel| strong="H3478" \w*, \w and the priests| strong="H3548" \w*, \w and the Levites| strong="H3881" \w*, [have not separated]{strong=“H914” x-morph=“strongMorph: \sc Th\sc*8738”} \w themselves from the people| strong="H5971" \w* \w of the lands| strong="H776" \w*, doing \w according to their abominations| strong="H8441" \w*, even \w of the Canaanites| strong="H3669" \w*, \w the Hittites| strong="H2850" \w*, \w the Perizzites| strong="H6522" \w*, \w the Jebusites| strong="H2983" \w*, \w the Ammonites| strong="H5984" \w*, \w the Moabites| strong="H4125" \w*, \w the Egyptians| strong="H4713" \w*, \w and the Amorites| strong="H567" \w*. 
\v 2 [For they have taken]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w of their daughters| strong="H1323" \w* [for themselves, and for their sons]{strong=“H1121”}: \w so that the holy| strong="H6944" \w* \w seed| strong="H2233" \w* [have mingled]{strong=“H6148” x-morph=“strongMorph: \sc Th\sc*8694”} \w themselves with the people| strong="H5971" \w* of those \w lands| strong="H776" \w*: [yea, the hand]{strong=“H3027”} \w of the princes| strong="H8269" \w* \w and rulers| strong="H5461" \w* \w hath been chief| strong="H7223" \w* \w in this trespass| strong="H4604" \w*. 
\v 3 [And when I heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w this thing| strong="H1697" \w*, [I rent]{strong=“H7167” x-morph=“strongMorph: \sc Th\sc*8804”} \w my garment| strong="H899" \w* \w and my mantle| strong="H4598" \w*, [and plucked off]{strong=“H4803” x-morph=“strongMorph: \sc Th\sc*8799”} \w the hair| strong="H8181" \w* \w of my head| strong="H7218" \w* \w and of my beard| strong="H2206" \w*, [and sat down]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} [astonied]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8789”}. 
\v 4 [Then were assembled]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8735”} \w unto me every one that trembled| strong="H2730" \w* \w at the words| strong="H1697" \w* \w of the God| strong="H430" \w* \w of Israel| strong="H3478" \w*, \w because of the transgression| strong="H4604" \w* \w of those that had been carried away| strong="H1473" \w*; [and I sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} [astonied]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8789”} \w until the evening| strong="H6153" \w* \w sacrifice| strong="H4503" \w*. 
\p
\v 5 \w And at the evening| strong="H6153" \w* \w sacrifice| strong="H4503" \w* [I arose up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”} \w from my heaviness| strong="H8589" \w*; [and having rent]{strong=“H7167” x-morph=“strongMorph: \sc Th\sc*8800”} \w my garment| strong="H899" \w* \w and my mantle| strong="H4598" \w*, [I fell]{strong=“H3766” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon my knees| strong="H1290" \w*, [and spread out]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8799”} \w my hands| strong="H3709" \w* unto the \sc Lord\sc* \w my God| strong="H430" \w*,\f + \fr 9:5 \ft heaviness: or, affliction \f* 
\v 6 [And said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w O my God| strong="H430" \w*, [I am ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8804”} [and blush]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8738”} [to lift up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8687”} \w my face| strong="H6440" \w* [to thee, my God]{strong=“H430”}: \w for our iniquities| strong="H5771" \w* [are increased]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8804”} \w over| strong="H4605" \w* our \w head| strong="H7218" \w*, \w and our trespass| strong="H819" \w* [is grown up]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the heavens| strong="H8064" \w*.\f + \fr 9:6 \ft trespass: or, guiltiness \f* 
\v 7 \w Since the days| strong="H3117" \w* \w of our fathers| strong="H1" \w* have we been \w in a great| strong="H1419" \w* \w trespass| strong="H819" \w* \w unto this day| strong="H3117" \w*; \w and for our iniquities| strong="H5771" \w* [have we, our kings]{strong=“H4428”}, and \w our priests| strong="H3548" \w*, [been delivered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w into the hand| strong="H3027" \w* \w of the kings| strong="H4428" \w* \w of the lands| strong="H776" \w*, \w to the sword| strong="H2719" \w*, \w to captivity| strong="H7628" \w*, \w and to a spoil| strong="H961" \w*, \w and to confusion| strong="H1322" \w* \w of face| strong="H6440" \w*, as it is \w this day| strong="H3117" \w*. 
\v 8 \w And now for a little| strong="H4592" \w* \w space| strong="H7281" \w* \w grace| strong="H8467" \w* hath been shewed from the \sc Lord\sc* \w our God| strong="H430" \w*, [to leave]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8687”} \w us a remnant to escape| strong="H6413" \w*, [and to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w us a nail| strong="H3489" \w* \w in his holy| strong="H6944" \w* \w place| strong="H4725" \w*, \w that our God| strong="H430" \w* [may lighten]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8687”} \w our eyes| strong="H5869" \w*, [and give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w us a little| strong="H4592" \w* \w reviving| strong="H4241" \w* \w in our bondage| strong="H5659" \w*.\f + \fr 9:8 \ft space: Heb. moment \f* \f + \fr 9:8 \ft a nail: or, a pin: that is, a constant and sure abode \f* 
\v 9 For we were \w bondmen| strong="H5650" \w*; \w yet our God| strong="H430" \w* [hath not forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} \w us in our bondage| strong="H5659" \w*, [but hath extended]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w mercy| strong="H2617" \w* \w unto us in the sight| strong="H6440" \w* \w of the kings| strong="H4428" \w* \w of Persia| strong="H6539" \w*, [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w us a reviving| strong="H4241" \w*, [to set up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8788”} \w the house| strong="H1004" \w* \w of our God| strong="H430" \w*, [and to repair]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8687”} \w the desolations| strong="H2723" \w* [thereof, and to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w us a wall| strong="H1447" \w* \w in Judah| strong="H3063" \w* \w and in Jerusalem| strong="H3389" \w*.\f + \fr 9:9 \ft to repair: Heb. to set up \f* 
\v 10 [And now, O our God]{strong=“H430”}, [what shall we say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* [this? for we have forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy commandments| strong="H4687" \w*, 
\v 11 [Which thou hast commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w by| strong="H3027" \w* \w thy servants| strong="H5650" \w* \w the prophets| strong="H5030" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w The land| strong="H776" \w*, [unto which ye go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} [to possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} [it, is an unclean]{strong=“H5079”} \w land| strong="H776" \w* \w with the filthiness| strong="H5079" \w* \w of the people| strong="H5971" \w* \w of the lands| strong="H776" \w*, \w with their abominations| strong="H8441" \w*, [which have filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8765”} \w it from one end| strong="H6310" \w* \w to another| strong="H6310" \w* \w with their uncleanness| strong="H2932" \w*.\f + \fr 9:11 \ft by: Heb. by the hand of \f* \f + \fr 9:11 \ft from…: Heb. from mouth to mouth \f* 
\v 12 [Now therefore give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w not your daughters| strong="H1323" \w* \w unto their sons| strong="H1121" \w*, [neither take]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their daughters| strong="H1323" \w* \w unto your sons| strong="H1121" \w*, [nor seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”} \w their peace| strong="H7965" \w* \w or their wealth| strong="H2896" \w* \w for| strong="H5704" \w* \w ever| strong="H5769" \w*: [that ye may be strong]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8799”}, [and eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w the good| strong="H2898" \w* \w of the land| strong="H776" \w*, and leave it [for an inheritance]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8689”} \w to your children| strong="H1121" \w* \w for ever| strong="H5769" \w*. 
\v 13 \w And after| strong="H310" \w* [all that is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon us for our evil| strong="H7451" \w* \w deeds| strong="H4639" \w*, \w and for our great| strong="H1419" \w* \w trespass| strong="H819" \w*, \w seeing that thou our God| strong="H430" \w* [hast punished]{strong=“H2820” x-morph=“strongMorph: \sc Th\sc*8804”} \w us less| strong="H4295" \w* \w than our iniquities| strong="H5771" \w* deserve, [and hast given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} us such \w deliverance| strong="H6413" \w* as this;\f + \fr 9:13 \ft hast punished…: Heb. hast withheld beneath our iniquities \f* 
\v 14 [Should we again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [break]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8687”} \w thy commandments| strong="H4687" \w*, [and join in affinity]{strong=“H2859” x-morph=“strongMorph: \sc Th\sc*8692”} \w with the people| strong="H5971" \w* \w of these abominations| strong="H8441" \w*? [wouldest not thou be angry]{strong=“H599” x-morph=“strongMorph: \sc Th\sc*8799”} [with us till thou hadst consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8763”} us, so that there should be \w no remnant| strong="H7611" \w* \w nor escaping| strong="H6413" \w*? 
\v 15 O \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w*, thou art \w righteous| strong="H6662" \w*: [for we remain]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8738”} \w yet escaped| strong="H6413" \w*, as it is \w this day| strong="H3117" \w*: behold, we are \w before| strong="H6440" \w* \w thee in our trespasses| strong="H819" \w*: [for we cannot stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8800”} \w before| strong="H6440" \w* thee because of this.
\c 10
\p 
\v 1 \w Now when Ezra| strong="H5830" \w* [had prayed]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8692”}, [and when he had confessed]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8692”}, [weeping]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8802”} [and casting himself down]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8693”} \w before| strong="H6440" \w* \w the house| strong="H1004" \w* \w of God| strong="H430" \w*, [there assembled]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto him out of Israel| strong="H3478" \w* \w a very| strong="H3966" \w* \w great| strong="H7227" \w* \w congregation| strong="H6951" \w* \w of men| strong="H582" \w* \w and women| strong="H802" \w* \w and children| strong="H3206" \w*: \w for the people| strong="H5971" \w* [wept]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8804”} [very]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8687”} \w sore| strong="H1059" \w*.\f + \fr 10:1 \ft wept…: Heb. wept a great weeping \f* 
