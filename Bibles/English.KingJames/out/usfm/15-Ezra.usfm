\c 1
\p 
\v 1 \w Now in the first| strong="H259" \w* \w year| strong="H8141" \w* \w of Cyrus| strong="H3566" \w* \w king| strong="H4428" \w* \w of Persia| strong="H6539" \w*, \w that the word| strong="H1697" \w* of the \sc Lord\sc* \w by the mouth| strong="H6310" \w* \w of Jeremiah| strong="H3414" \w* [might be fulfilled]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8800”}, the \sc Lord\sc* [stirred up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8689”} \w the spirit| strong="H7307" \w* \w of Cyrus| strong="H3566" \w* \w king| strong="H4428" \w* \w of Persia| strong="H6539" \w*, [that he made a proclamation]{strong=“H6963 H5674” x-morph=“strongMorph: \sc Th\sc*8686”} \w throughout all his kingdom| strong="H4438" \w*, and put it \w also in writing| strong="H4385" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”},\f + \fr 1:1 \ft made…: Heb. caused a voice to pass \f* 
\v 2 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w Cyrus| strong="H3566" \w* \w king| strong="H4428" \w* \w of Persia| strong="H6539" \w*, The \sc Lord\sc* \w God| strong="H430" \w* \w of heaven| strong="H8064" \w* [hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w me all the kingdoms| strong="H4467" \w* \w of the earth| strong="H776" \w*; [and he hath charged]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} [me to build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8800”} \w him an house| strong="H1004" \w* \w at Jerusalem| strong="H3389" \w*, which is \w in Judah| strong="H3063" \w*. 
\v 3 Who is there \w among you of all his people| strong="H5971" \w*? \w his God| strong="H430" \w* [be with him, and let him go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Jerusalem| strong="H3389" \w*, which is \w in Judah| strong="H3063" \w*, [and build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w the house| strong="H1004" \w* of the \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w*, (he is \w the God| strong="H430" \w*,) which is \w in Jerusalem| strong="H3389" \w*. 
\v 4 [And whosoever remaineth]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”} \w in any place| strong="H4725" \w* [where he sojourneth]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8802”}, \w let the men| strong="H582" \w* \w of his place| strong="H4725" \w* [help]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8762”} \w him with silver| strong="H3701" \w*, \w and with gold| strong="H2091" \w*, \w and with goods| strong="H7399" \w*, \w and with beasts| strong="H929" \w*, \w beside the freewill offering| strong="H5071" \w* \w for the house| strong="H1004" \w* \w of God| strong="H430" \w* that is \w in Jerusalem| strong="H3389" \w*.\f + \fr 1:4 \ft help…: Heb. lift him up \f* 
\p
\v 5 [Then rose up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w the chief| strong="H7218" \w* \w of the fathers| strong="H1" \w* \w of Judah| strong="H3063" \w* \w and Benjamin| strong="H1144" \w*, \w and the priests| strong="H3548" \w*, \w and the Levites| strong="H3881" \w*, with all them \w whose spirit| strong="H7307" \w* \w God| strong="H430" \w* [had raised]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8689”}, [to go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8800”} [to build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8800”} \w the house| strong="H1004" \w* of the \sc Lord\sc* which is \w in Jerusalem| strong="H3389" \w*. 
\v 6 And all they that were \w about| strong="H5439" \w* [them strengthened]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8765”} \w their hands| strong="H3027" \w* \w with vessels| strong="H3627" \w* \w of silver| strong="H3701" \w*, \w with gold| strong="H2091" \w*, \w with goods| strong="H7399" \w*, \w and with beasts| strong="H929" \w*, \w and with precious things| strong="H4030" \w*, beside all that [was willingly offered]{strong=“H5068” x-morph=“strongMorph: \sc Th\sc*8692”}.\f + \fr 1:6 \ft strengthened…: that is, helped them \f* 
\p
