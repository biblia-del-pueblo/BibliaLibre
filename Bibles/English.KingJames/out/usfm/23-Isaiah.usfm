\v 17 \w And the light| strong="H216" \w* \w of Israel| strong="H3478" \w* \w shall be for a fire| strong="H784" \w*, \w and his Holy One| strong="H6918" \w* \w for a flame| strong="H3852" \w*: [and it shall burn]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8804”} [and devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w his thorns| strong="H7898" \w* \w and his briers| strong="H8068" \w* \w in one| strong="H259" \w* \w day| strong="H3117" \w*; 
\v 18 [And shall consume]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8762”} \w the glory| strong="H3519" \w* \w of his forest| strong="H3293" \w*, \w and of his fruitful field| strong="H3759" \w*, \w both soul| strong="H5315" \w* \w and body| strong="H1320" \w*: [and they shall be as when a standardbearer]{strong=“H5263” x-morph=“strongMorph: \sc Th\sc*8802”} [fainteth]{strong=“H4549” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 10:18 \ft both…: Heb. from the soul, and even to the flesh \f* 
\v 19 \w And the rest| strong="H7605" \w* \w of the trees| strong="H6086" \w* \w of his forest| strong="H3293" \w* \w shall be few| strong="H4557" \w*, \w that a child| strong="H5288" \w* [may write]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8799”} them.\f + \fr 10:19 \ft few: Heb. number \f* 
\p
\v 20 \w And it shall come to pass in that day| strong="H3117" \w*, that \w the remnant| strong="H7605" \w* \w of Israel| strong="H3478" \w*, \w and such as are escaped| strong="H6413" \w* \w of the house| strong="H1004" \w* \w of Jacob| strong="H3290" \w*, [shall no more again]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [stay]{strong=“H8172” x-morph=“strongMorph: \sc Th\sc*8736”} [upon him that smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8688”} [them; but shall stay]{strong=“H8172” x-morph=“strongMorph: \sc Th\sc*8738”} upon the \sc Lord\sc*, \w the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w*, \w in truth| strong="H571" \w*. 
