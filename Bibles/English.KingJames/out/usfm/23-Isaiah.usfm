\v 17 [Behold, for peace]{strong=“H7965”} [I had great bitterness]{strong=“H4843 H4751” x-morph=“strongMorph: \sc Th\sc*8804”}: [but thou hast in love]{strong=“H2836” x-morph=“strongMorph: \sc Th\sc*8804”} \w to my soul| strong="H5315" \w* delivered it \w from the pit| strong="H7845" \w* \w of corruption| strong="H1097" \w*: [for thou hast cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8689”} \w all my sins| strong="H2399" \w* \w behind| strong="H310" \w* \w thy back| strong="H1460" \w*.\f + \fr 38:17 \ft for peace…: or, on my peace came great bitterness \f* \f + \fr 38:17 \ft thou hast in…: Heb. thou hast loved my soul from the pit \f* 
\v 18 \w For the grave| strong="H7585" \w* [cannot praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} [thee, death]{strong=“H4194”} can not [celebrate]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8762”} [thee: they that go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w into the pit| strong="H953" \w* [cannot hope]{strong=“H7663” x-morph=“strongMorph: \sc Th\sc*8762”} \w for thy truth| strong="H571" \w*. 
\v 19 \w The living| strong="H2416" \w*, \w the living| strong="H2416" \w*, [he shall praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} thee, as I do \w this day| strong="H3117" \w*: \w the father| strong="H1" \w* \w to the children| strong="H1121" \w* [shall make known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy truth| strong="H571" \w*. 
\v 20 The \sc Lord\sc* was ready [to save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8687”} [me: therefore we will sing my songs]{strong=“H5058”} [to the stringed instruments]{strong=“H5059” x-morph=“strongMorph: \sc Th\sc*8762”} \w all the days| strong="H3117" \w* \w of our life| strong="H2416" \w* \w in the house| strong="H1004" \w* of the \sc Lord\sc*. 
\v 21 \w For Isaiah| strong="H3470" \w* [had said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Let them take]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w a lump| strong="H1690" \w* \w of figs| strong="H8384" \w*, and lay it [for a plaister]{strong=“H4799” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the boil| strong="H7822" \w*, [and he shall recover]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 22 \w Hezekiah| strong="H2396" \w* [also had said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, What is \w the sign| strong="H226" \w* [that I shall go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the house| strong="H1004" \w* of the \sc Lord\sc*?
\c 39
\p 
\v 1 \w At that time| strong="H6256" \w* [Merodach-baladan]{strong=“H4757”}, \w the son| strong="H1121" \w* \w of Baladan| strong="H1081" \w*, \w king| strong="H4428" \w* \w of Babylon| strong="H894" \w*, [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w letters| strong="H5612" \w* \w and a present| strong="H4503" \w* \w to Hezekiah| strong="H2396" \w*: [for he had heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [that he had been sick]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8804”}, [and was recovered]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 2 \w And Hezekiah| strong="H2396" \w* [was glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} [of them, and shewed]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8686”} \w them the house| strong="H1004" \w* \w of his precious things| strong="H5238" \w*, \w the silver| strong="H3701" \w*, \w and the gold| strong="H2091" \w*, \w and the spices| strong="H1314" \w*, \w and the precious| strong="H2896" \w* \w ointment| strong="H8081" \w*, \w and all the house| strong="H1004" \w* \w of his armour| strong="H3627" \w*, [and all that was found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8738”} \w in his treasures| strong="H214" \w*: \w there was nothing| strong="H1697" \w* \w in his house| strong="H1004" \w*, \w nor in all his dominion| strong="H4475" \w*, \w that Hezekiah| strong="H2396" \w* [shewed]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8689”} them not.\f + \fr 39:2 \ft precious things: or, spicery \f* \f + \fr 39:2 \ft armour: or, jewels: Heb. vessels, or, instruments \f* 
\p
\v 3 [Then came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w Isaiah| strong="H3470" \w* \w the prophet| strong="H5030" \w* \w unto king| strong="H4428" \w* \w Hezekiah| strong="H2396" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, What said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w these men| strong="H582" \w*? \w and from whence| strong="H370" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [they unto thee? And Hezekiah]{strong=“H2396”} [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [They are come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w from a far| strong="H7350" \w* \w country| strong="H776" \w* unto me, even \w from Babylon| strong="H894" \w*. 
\v 4 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [he, What have they seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thine house| strong="H1004" \w*? \w And Hezekiah| strong="H2396" \w* [answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, All that is \w in mine house| strong="H1004" \w* [have they seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”}: \w there is nothing| strong="H1697" \w* \w among my treasures| strong="H214" \w* [that I have not shewed]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8689”} them. 
\p
\v 5 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Isaiah| strong="H3470" \w* \w to Hezekiah| strong="H2396" \w*, [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* of the \sc Lord\sc* \w of hosts| strong="H6635" \w*: 
\v 6 [Behold, the days]{strong=“H3117”} [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}, that all that is \w in thine house| strong="H1004" \w*, and that \w which thy fathers| strong="H1" \w* [have laid up in store]{strong=“H686” x-morph=“strongMorph: \sc Th\sc*8804”} \w until this day| strong="H3117" \w*, [shall be carried]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8738”} \w to Babylon| strong="H894" \w*: \w nothing| strong="H1697" \w* [shall be left]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8735”}, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*. 
\v 7 \w And of thy sons| strong="H1121" \w* [that shall issue]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} [from thee, which thou shalt beget]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8686”}, [shall they take away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”}; \w and they shall be eunuchs| strong="H5631" \w* \w in the palace| strong="H1964" \w* \w of the king| strong="H4428" \w* \w of Babylon| strong="H894" \w*. 
\v 8 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Hezekiah| strong="H2396" \w* \w to Isaiah| strong="H3470" \w*, \w Good| strong="H2896" \w* is \w the word| strong="H1697" \w* of the \sc Lord\sc* [which thou hast spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}. [He said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [moreover, For there shall be peace]{strong=“H7965”} \w and truth| strong="H571" \w* \w in my days| strong="H3117" \w*. 
\c 40
\p 
\v 1 [Comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8761”} [ye, comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8761”} \w ye my people| strong="H5971" \w*, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w your God| strong="H430" \w*. 
\v 2 [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w ye comfortably| strong="H3820" \w* \w to Jerusalem| strong="H3389" \w*, [and cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} [unto her, that her warfare]{strong=“H6635”} [is accomplished]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”}, \w that her iniquity| strong="H5771" \w* [is pardoned]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8738”}: [for she hath received]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} of the \sc Lord\sc*’S \w hand| strong="H3027" \w* \w double| strong="H3718" \w* \w for all her sins| strong="H2403" \w*.\f + \fr 40:2 \ft comfortably: Heb. to the heart \f* \f + \fr 40:2 \ft warfare: or, appointed time \f* 
\p
\v 3 \w The voice| strong="H6963" \w* [of him that crieth]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the wilderness| strong="H4057" \w*, [Prepare]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8761”} \w ye the way| strong="H1870" \w* of the \sc Lord\sc*, [make straight]{strong=“H3474” x-morph=“strongMorph: \sc Th\sc*8761”} \w in the desert| strong="H6160" \w* \w a highway| strong="H4546" \w* \w for our God| strong="H430" \w*. 
\v 4 \w Every valley| strong="H1516" \w* [shall be exalted]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8735”}, \w and every mountain| strong="H2022" \w* \w and hill| strong="H1389" \w* [shall be made low]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8799”}: \w and the crooked| strong="H6121" \w* \w shall be made straight| strong="H4334" \w*, \w and the rough places| strong="H7406" \w* \w plain| strong="H1237" \w*:\f + \fr 40:4 \ft straight: or, a straight place \f* \f + \fr 40:4 \ft plain: or, a plain place \f* 
\v 5 \w And the glory| strong="H3519" \w* of the \sc Lord\sc* [shall be revealed]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and all flesh| strong="H1320" \w* [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} it \w together| strong="H3162" \w*: \w for the mouth| strong="H6310" \w* of the \sc Lord\sc* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it. 
\v 6 \w The voice| strong="H6963" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, [Cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”}. [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [What shall I cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”}? \w All flesh| strong="H1320" \w* is \w grass| strong="H2682" \w*, \w and all the goodliness| strong="H2617" \w* thereof is \w as the flower| strong="H6731" \w* \w of the field| strong="H7704" \w*: 
\v 7 \w The grass| strong="H2682" \w* [withereth]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the flower| strong="H6731" \w* [fadeth]{strong=“H5034” x-morph=“strongMorph: \sc Th\sc*8804”}: \w because the spirit| strong="H7307" \w* of the \sc Lord\sc* [bloweth]{strong=“H5380” x-morph=“strongMorph: \sc Th\sc*8804”} [upon it: surely]{strong=“H403”} \w the people| strong="H5971" \w* is \w grass| strong="H2682" \w*. 
\v 8 \w The grass| strong="H2682" \w* [withereth]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the flower| strong="H6731" \w* [fadeth]{strong=“H5034” x-morph=“strongMorph: \sc Th\sc*8804”}: \w but the word| strong="H1697" \w* \w of our God| strong="H430" \w* [shall stand]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w for ever| strong="H5769" \w*. 
\p
\v 9 \w O Zion| strong="H6726" \w*, [that bringest good tidings]{strong=“H1319” x-morph=“strongMorph: \sc Th\sc*8764”}, [get thee up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”} \w into the high| strong="H1364" \w* \w mountain| strong="H2022" \w*; \w O Jerusalem| strong="H3389" \w*, [that bringest good tidings]{strong=“H1319” x-morph=“strongMorph: \sc Th\sc*8764”}, [lift up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8685”} \w thy voice| strong="H6963" \w* \w with strength| strong="H3581" \w*; lift it [up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8685”}, [be not afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}; [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto the cities| strong="H5892" \w* \w of Judah| strong="H3063" \w*, \w Behold your God| strong="H430" \w*!\f + \fr 40:9 \ft O Zion…: or, O thou that tellest good tidings to Zion \f* \f + \fr 40:9 \ft O Jerusalem…: or, O thou that tellest good tidings to Jerusalem \f* 
\v 10 [Behold, the Lord]{strong=“H136”} \sc God\sc* [will come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w with strong| strong="H2389" \w* hand, \w and his arm| strong="H2220" \w* [shall rule]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8802”} [for him: behold, his reward]{strong=“H7939”} is [with him, and his work]{strong=“H6468”} \w before| strong="H6440" \w* him.\f + \fr 40:10 \ft with strong…: or, against the strong \f* \f + \fr 40:10 \ft his work: or, recompence for his work \f* 
\v 11 [He shall feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} \w his flock| strong="H5739" \w* [like a shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}: [he shall gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8762”} \w the lambs| strong="H2922" \w* \w with his arm| strong="H2220" \w*, [and carry]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} them \w in his bosom| strong="H2436" \w*, and [shall gently lead]{strong=“H5095” x-morph=“strongMorph: \sc Th\sc*8762”} [those that are with young]{strong=“H5763” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 40:11 \ft that…: or, that give suck \f* 
\p
\v 12 [Who hath measured]{strong=“H4058” x-morph=“strongMorph: \sc Th\sc*8804”} \w the waters| strong="H4325" \w* \w in the hollow of his hand| strong="H8168" \w*, [and meted out]{strong=“H8505” x-morph=“strongMorph: \sc Th\sc*8765”} \w heaven| strong="H8064" \w* \w with the span| strong="H2239" \w*, [and comprehended]{strong=“H3557” x-morph=“strongMorph: \sc Th\sc*8804”} \w the dust| strong="H6083" \w* \w of the earth| strong="H776" \w* \w in a measure| strong="H7991" \w*, [and weighed]{strong=“H8254” x-morph=“strongMorph: \sc Th\sc*8804”} \w the mountains| strong="H2022" \w* \w in scales| strong="H6425" \w*, \w and the hills| strong="H1389" \w* \w in a balance| strong="H3976" \w*?\f + \fr 40:12 \ft a measure: Heb. a tierce \f* 
\v 13 [Who hath directed]{strong=“H8505” x-morph=“strongMorph: \sc Th\sc*8765”} \w the Spirit| strong="H7307" \w* of the \sc Lord\sc*, or being [his counsellor]{strong=“H6098 H376”} [hath taught]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8686”} him?\f + \fr 40:13 \ft his…: Heb. man of his counsel \f* 
\v 14 [With whom took he counsel]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8738”}, and who [instructed]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} [him, and taught]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8762”} \w him in the path| strong="H734" \w* \w of judgment| strong="H4941" \w*, [and taught]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8762”} \w him knowledge| strong="H1847" \w*, [and shewed]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8686”} \w to him the way| strong="H1870" \w* \w of understanding| strong="H8394" \w*?\f + \fr 40:14 \ft instructed…: Heb. made him understand \f* \f + \fr 40:14 \ft understanding: Heb. understandings? \f* 
\v 15 [Behold, the nations]{strong=“H1471”} are \w as a drop| strong="H4752" \w* \w of a bucket| strong="H1805" \w*, [and are counted]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8738”} \w as the small dust| strong="H7834" \w* \w of the balance| strong="H3976" \w*: [behold, he taketh up]{strong=“H5190” x-morph=“strongMorph: \sc Th\sc*8799”} \w the isles| strong="H339" \w* \w as a very little thing| strong="H1851" \w*. 
\v 16 \w And Lebanon| strong="H3844" \w* is \w not| strong="H369" \w* \w sufficient| strong="H1767" \w* [to burn]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8763”}, \w nor the beasts| strong="H2416" \w* \w thereof sufficient| strong="H1767" \w* \w for a burnt offering| strong="H5930" \w*. 
\v 17 \w All nations| strong="H1471" \w* before him are [as nothing; and they are counted]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8738”} \w to him less than nothing| strong="H657" \w*, \w and vanity| strong="H8414" \w*. 
\p
\v 18 [To whom then will ye liken]{strong=“H1819” x-morph=“strongMorph: \sc Th\sc*8762”} \w God| strong="H410" \w*? \w or what likeness| strong="H1823" \w* [will ye compare]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8799”} unto him? 
\v 19 \w The workman| strong="H2796" \w* [melteth]{strong=“H5258” x-morph=“strongMorph: \sc Th\sc*8804”} \w a graven image| strong="H6459" \w*, [and the goldsmith]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8802”} [spreadeth]{strong=“H7554” x-morph=“strongMorph: \sc Th\sc*8762”} \w it over with gold| strong="H2091" \w*, [and casteth]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8802”} \w silver| strong="H3701" \w* \w chains| strong="H7577" \w*. 
\v 20 He that is [so impoverished]{strong=“H5534 H5533” x-morph=“strongMorph: \sc Th\sc*8765 strongMorph: \sc Th\sc*8676 strongMorph: \sc Th\sc*8794”} \w that he hath no oblation| strong="H8641" \w* [chooseth]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} \w a tree| strong="H6086" \w* that [will not rot]{strong=“H7537” x-morph=“strongMorph: \sc Th\sc*8799”}; [he seeketh]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto him a cunning| strong="H2450" \w* \w workman| strong="H2796" \w* [to prepare]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8687”} \w a graven image| strong="H6459" \w*, that [shall not be moved]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 40:20 \ft is so…: Heb. is poor of oblation \f* 
\v 21 [Have ye not known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”}? [have ye not heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}? [hath it not been told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8717”} \w you from the beginning| strong="H7218" \w*? [have ye not understood]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8689”} \w from the foundations| strong="H4146" \w* \w of the earth| strong="H776" \w*? 
\v 22 It is [he that sitteth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the circle| strong="H2329" \w* \w of the earth| strong="H776" \w*, [and the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} thereof are \w as grasshoppers| strong="H2284" \w*; [that stretcheth out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8802”} \w the heavens| strong="H8064" \w* \w as a curtain| strong="H1852" \w*, [and spreadeth them out]{strong=“H4969” x-morph=“strongMorph: \sc Th\sc*8799”} \w as a tent| strong="H168" \w* [to dwell in]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”}:\f + \fr 40:22 \ft It is…: or, Him that \f* 
\v 23 [That bringeth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} [the princes]{strong=“H7336” x-morph=“strongMorph: \sc Th\sc*8802”} [to nothing; he maketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [the judges]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the earth| strong="H776" \w* \w as vanity| strong="H8414" \w*. 
\v 24 [Yea, they shall not be planted]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8738”}; [yea, they shall not be sown]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8795”}: [yea, their stock]{strong=“H1503”} [shall not take root]{strong=“H8327” x-morph=“strongMorph: \sc Th\sc*8782”} \w in the earth| strong="H776" \w*: [and he shall also blow]{strong=“H5398” x-morph=“strongMorph: \sc Th\sc*8804”} [upon them, and they shall wither]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the whirlwind| strong="H5591" \w* [shall take]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w them away as stubble| strong="H7179" \w*. 
\v 25 [To whom then will ye liken]{strong=“H1819” x-morph=“strongMorph: \sc Th\sc*8762”} [me, or shall I be equal]{strong=“H7737” x-morph=“strongMorph: \sc Th\sc*8799”}? [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w the Holy One| strong="H6918" \w*. 
\v 26 [Lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w your eyes| strong="H5869" \w* \w on high| strong="H4791" \w*, [and behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} [who hath created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8804”} these things, [that bringeth out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8688”} \w their host| strong="H6635" \w* \w by number| strong="H4557" \w*: [he calleth]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w them all by names| strong="H8034" \w* \w by the greatness| strong="H7230" \w* \w of his might| strong="H202" \w*, for that he is \w strong| strong="H533" \w* \w in power| strong="H3581" \w*; \w not one| strong="H376" \w* [faileth]{strong=“H5737” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\p
\v 27 [Why sayest]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [thou, O Jacob]{strong=“H3290”}, [and speakest]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}, \w O Israel| strong="H3478" \w*, \w My way| strong="H1870" \w* [is hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8738”} from the \sc Lord\sc*, \w and my judgment| strong="H4941" \w* [is passed over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w from my God| strong="H430" \w*? 
\p
\v 28 [Hast thou not known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}? [hast thou not heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}, that \w the everlasting| strong="H5769" \w* \w God| strong="H430" \w*, the \sc Lord\sc*, [the Creator]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the ends| strong="H7098" \w* \w of the earth| strong="H776" \w*, [fainteth]{strong=“H3286” x-morph=“strongMorph: \sc Th\sc*8799”} [not, neither is weary]{strong=“H3021” x-morph=“strongMorph: \sc Th\sc*8799”}? there is \w no searching| strong="H2714" \w* \w of his understanding| strong="H8394" \w*. 
\v 29 [He giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w power| strong="H3581" \w* \w to the faint| strong="H3287" \w*; and to them that have \w no might| strong="H202" \w* [he increaseth]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} \w strength| strong="H6109" \w*. 
\v 30 \w Even the youths| strong="H5288" \w* [shall faint]{strong=“H3286” x-morph=“strongMorph: \sc Th\sc*8799”} [and be weary]{strong=“H3021” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the young men| strong="H970" \w* [shall utterly]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8800”} [fall]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8735”}: 
