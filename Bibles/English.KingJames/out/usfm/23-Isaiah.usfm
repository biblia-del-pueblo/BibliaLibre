\p
\v 25 [And I will turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w my hand| strong="H3027" \w* [upon thee, and purely]{strong=“H1253”} [purge away]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy dross| strong="H5509" \w*, [and take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8686”} \w all thy tin| strong="H913" \w*:\f + \fr 1:25 \ft purely: Heb. according to pureness \f* 
\v 26 [And I will restore]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} [thy judges]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} \w as at the first| strong="H7223" \w*, [and thy counsellors]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8802”} \w as at the beginning| strong="H8462" \w*: \w afterward| strong="H310" \w* [thou shalt be called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8735”}, \w The city| strong="H5892" \w* \w of righteousness| strong="H6664" \w*, [the faithful]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8737”} \w city| strong="H7151" \w*. 
\v 27 \w Zion| strong="H6726" \w* [shall be redeemed]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8735”} \w with judgment| strong="H4941" \w*, [and her converts]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8802”} \w with righteousness| strong="H6666" \w*.\f + \fr 1:27 \ft her…: or, they that return of her \f* 
\p
\v 28 \w And the destruction| strong="H7667" \w* [of the transgressors]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8802”} \w and of the sinners| strong="H2400" \w* shall be \w together| strong="H3162" \w*, [and they that forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8802”} the \sc Lord\sc* [shall be consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 1:28 \ft destruction: Heb. breaking \f* 
\v 29 [For they shall be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the oaks| strong="H352" \w* [which ye have desired]{strong=“H2530” x-morph=“strongMorph: \sc Th\sc*8804”}, [and ye shall be confounded]{strong=“H2659” x-morph=“strongMorph: \sc Th\sc*8799”} \w for the gardens| strong="H1593" \w* [that ye have chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 30 \w For ye shall be as an oak| strong="H424" \w* \w whose leaf| strong="H5929" \w* [fadeth]{strong=“H5034” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and as a garden| strong="H1593" \w* \w that hath no water| strong="H4325" \w*. 
\v 31 \w And the strong| strong="H2634" \w* \w shall be as tow| strong="H5296" \w*, \w and the maker| strong="H6467" \w* \w of it as a spark| strong="H5213" \w*, \w and they shall both| strong="H8147" \w* [burn]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8804”} \w together| strong="H3162" \w*, [and none shall quench]{strong=“H3518” x-morph=“strongMorph: \sc Th\sc*8764”} them.\f + \fr 1:31 \ft maker…: or, and his work \f*
\c 2
\p 
\v 1 \w The word| strong="H1697" \w* \w that Isaiah| strong="H3470" \w* \w the son| strong="H1121" \w* \w of Amoz| strong="H531" \w* [saw]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8804”} \w concerning Judah| strong="H3063" \w* \w and Jerusalem| strong="H3389" \w*. 
\v 2 \w And it shall come to pass in the last| strong="H319" \w* \w days| strong="H3117" \w*, that \w the mountain| strong="H2022" \w* of the \sc Lord\sc*’S \w house| strong="H1004" \w* [shall be established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8737”} \w in the top| strong="H7218" \w* \w of the mountains| strong="H2022" \w*, [and shall be exalted]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8737”} \w above the hills| strong="H1389" \w*; \w and all nations| strong="H1471" \w* [shall flow]{strong=“H5102” x-morph=“strongMorph: \sc Th\sc*8804”} unto it.\f + \fr 2:2 \ft established: or, prepared \f* 
\v 3 \w And many| strong="H7227" \w* \w people| strong="H5971" \w* [shall go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} [ye, and let us go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the mountain| strong="H2022" \w* of the \sc Lord\sc*, \w to the house| strong="H1004" \w* \w of the God| strong="H430" \w* \w of Jacob| strong="H3290" \w*; [and he will teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”} \w us of his ways| strong="H1870" \w*, [and we will walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his paths| strong="H734" \w*: \w for out of Zion| strong="H6726" \w* [shall go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w the law| strong="H8451" \w*, \w and the word| strong="H1697" \w* of the \sc Lord\sc* \w from Jerusalem| strong="H3389" \w*. 
\v 4 [And he shall judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8804”} \w among the nations| strong="H1471" \w*, [and shall rebuke]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8689”} \w many| strong="H7227" \w* \w people| strong="H5971" \w*: [and they shall beat]{strong=“H3807” x-morph=“strongMorph: \sc Th\sc*8765”} \w their swords| strong="H2719" \w* \w into plowshares| strong="H855" \w*, \w and their spears| strong="H2595" \w* \w into pruninghooks| strong="H4211" \w*: \w nation| strong="H1471" \w* [shall not lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w sword| strong="H2719" \w* \w against nation| strong="H1471" \w*, [neither shall they learn]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8799”} \w war| strong="H4421" \w* any more.\f + \fr 2:4 \ft pruninghooks: or, scythes \f* 
\v 5 \w O house| strong="H1004" \w* \w of Jacob| strong="H3290" \w*, [come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} [ye, and let us walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the light| strong="H216" \w* of the \sc Lord\sc*. 
\p
\v 6 [Therefore thou hast forsaken]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy people| strong="H5971" \w* \w the house| strong="H1004" \w* \w of Jacob| strong="H3290" \w*, [because they be replenished]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w from the east| strong="H6924" \w*, and are [soothsayers]{strong=“H6049” x-morph=“strongMorph: \sc Th\sc*8781”} \w like the Philistines| strong="H6430" \w*, [and they please]{strong=“H5606” x-morph=“strongMorph: \sc Th\sc*8686”} \w themselves in the children| strong="H3206" \w* \w of strangers| strong="H5237" \w*.\f + \fr 2:6 \ft from…: or, more than the \f* \f + \fr 2:6 \ft please…: or, abound with the \f* 
\v 7 \w Their land| strong="H776" \w* [also is full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”} \w of silver| strong="H3701" \w* \w and gold| strong="H2091" \w*, neither is there any \w end| strong="H7097" \w* \w of their treasures| strong="H214" \w*; \w their land| strong="H776" \w* [is also full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”} \w of horses| strong="H5483" \w*, neither is there any \w end| strong="H7097" \w* \w of their chariots| strong="H4818" \w*: 
\v 8 \w Their land| strong="H776" \w* [also is full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”} \w of idols| strong="H457" \w*; [they worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} \w the work| strong="H4639" \w* \w of their own hands| strong="H3027" \w*, \w that which their own fingers| strong="H676" \w* [have made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}: 
\v 9 \w And the mean man| strong="H120" \w* [boweth down]{strong=“H7817” x-morph=“strongMorph: \sc Th\sc*8735”}, \w and the great man| strong="H376" \w* [humbleth]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8799”} [himself: therefore forgive]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} them not. 
\p
\v 10 [Enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} \w into the rock| strong="H6697" \w*, [and hide]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8734”} \w thee in the dust| strong="H6083" \w*, \w for| strong="H6440" \w* \w fear| strong="H6343" \w* of the \sc Lord\sc*, \w and for the glory| strong="H1926" \w* \w of his majesty| strong="H1347" \w*. 
\v 11 \w The lofty| strong="H1365" \w* \w looks| strong="H5869" \w* \w of man| strong="H120" \w* [shall be humbled]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and the haughtiness| strong="H7312" \w* \w of men| strong="H582" \w* [shall be bowed down]{strong=“H7817” x-morph=“strongMorph: \sc Th\sc*8804”}, and the \sc Lord\sc* [alone shall be exalted]{strong=“H7682” x-morph=“strongMorph: \sc Th\sc*8738”} \w in that day| strong="H3117" \w*. 
\v 12 \w For the day| strong="H3117" \w* of the \sc Lord\sc* \w of hosts| strong="H6635" \w* shall be upon every one that is \w proud| strong="H1343" \w* [and lofty]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8802”}, and upon every one that is [lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8737”}; [and he shall be brought low]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8804”}: 
\v 13 \w And upon all the cedars| strong="H730" \w* \w of Lebanon| strong="H3844" \w*, that are [high]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8802”} [and lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8737”}, \w and upon all the oaks| strong="H437" \w* \w of Bashan| strong="H1316" \w*, 
\v 14 [And upon all the high]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8802”} \w mountains| strong="H2022" \w*, \w and upon all the hills| strong="H1389" \w* that are [lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8737”}, 
\v 15 \w And upon every high| strong="H1364" \w* \w tower| strong="H4026" \w*, [and upon every fenced]{strong=“H1219” x-morph=“strongMorph: \sc Th\sc*8803”} \w wall| strong="H2346" \w*, 
\v 16 \w And upon all the ships| strong="H591" \w* \w of Tarshish| strong="H8659" \w*, \w and upon all pleasant| strong="H2532" \w* \w pictures| strong="H7914" \w*.\f + \fr 2:16 \ft pleasant…: Heb. pictures of desire \f* 
\v 17 \w And the loftiness| strong="H1365" \w* \w of man| strong="H120" \w* [shall be bowed down]{strong=“H7817” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and the haughtiness| strong="H7312" \w* \w of men| strong="H582" \w* [shall be made low]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8804”}: and the \sc Lord\sc* [alone shall be exalted]{strong=“H7682” x-morph=“strongMorph: \sc Th\sc*8738”} \w in that day| strong="H3117" \w*. 
\v 18 \w And the idols| strong="H457" \w* \w he shall utterly| strong="H3632" \w* [abolish]{strong=“H2498” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 2:18 \ft he…: or, shall utterly pass away \f* 
\v 19 [And they shall go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the holes| strong="H4631" \w* \w of the rocks| strong="H6697" \w*, \w and into the caves| strong="H4247" \w* \w of the earth| strong="H6083" \w*, \w for| strong="H6440" \w* \w fear| strong="H6343" \w* of the \sc Lord\sc*, \w and for the glory| strong="H1926" \w* \w of his majesty| strong="H1347" \w*, [when he ariseth]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8800”} [to shake terribly]{strong=“H6206” x-morph=“strongMorph: \sc Th\sc*8800”} \w the earth| strong="H776" \w*.\f + \fr 2:19 \ft of the earth: Heb. of the dust \f* 
\v 20 \w In that day| strong="H3117" \w* \w a man| strong="H120" \w* [shall cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w his idols| strong="H457" \w* \w of silver| strong="H3701" \w*, \w and his idols| strong="H457" \w* \w of gold| strong="H2091" \w*, which they made each one [for himself]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [to worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8692”}, [to the moles]{strong=“H6512 H2661”} \w and to the bats| strong="H5847" \w*;\f + \fr 2:20 \ft his idols of silver…: Heb. the idols of his silver, etc \f* \f + \fr 2:20 \ft each…: or, for him \f* 
\v 21 [To go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w into the clefts| strong="H5366" \w* \w of the rocks| strong="H6697" \w*, \w and into the tops| strong="H5585" \w* \w of the ragged rocks| strong="H5553" \w*, \w for| strong="H6440" \w* \w fear| strong="H6343" \w* of the \sc Lord\sc*, \w and for the glory| strong="H1926" \w* \w of his majesty| strong="H1347" \w*, [when he ariseth]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8800”} [to shake terribly]{strong=“H6206” x-morph=“strongMorph: \sc Th\sc*8800”} \w the earth| strong="H776" \w*. 
\v 22 [Cease]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye from man| strong="H120" \w*, \w whose breath| strong="H5397" \w* is \w in his nostrils| strong="H639" \w*: [for wherein is he to be accounted of]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8737”}?
\c 3
\p 
\v 1 [For, behold, the Lord]{strong=“H113”}, the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [doth take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8688”} \w from Jerusalem| strong="H3389" \w* \w and from Judah| strong="H3063" \w* \w the stay| strong="H4937" \w* \w and the staff| strong="H4938" \w*, \w the whole stay| strong="H4937" \w* \w of bread| strong="H3899" \w*, \w and the whole| strong="H3605" \w* \w stay| strong="H4937" \w* \w of water| strong="H4325" \w*, 
\v 2 \w The mighty man| strong="H1368" \w*, \w and the man| strong="H376" \w* \w of war| strong="H4421" \w*, [the judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and the prophet| strong="H5030" \w*, [and the prudent]{strong=“H7080” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and the ancient| strong="H2205" \w*, 
\v 3 \w The captain| strong="H8269" \w* \w of fifty| strong="H2572" \w*, [and the honourable]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8803”} \w man| strong="H6440" \w*, [and the counsellor]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and the cunning| strong="H2450" \w* \w artificer| strong="H2791" \w*, [and the eloquent]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8737”} \w orator| strong="H3908" \w*.\f + \fr 3:3 \ft the honourable…: Heb. a man eminent in countenance \f* \f + \fr 3:3 \ft eloquent…: or, skilful of speech \f* 
\v 4 [And I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w children| strong="H5288" \w* to be \w their princes| strong="H8269" \w*, \w and babes| strong="H8586" \w* [shall rule]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8799”} over them. 
\v 5 \w And the people| strong="H5971" \w* [shall be oppressed]{strong=“H5065” x-morph=“strongMorph: \sc Th\sc*8738”}, \w every one| strong="H376" \w* \w by another| strong="H376" \w*, \w and every one| strong="H376" \w* \w by his neighbour| strong="H7453" \w*: \w the child| strong="H5288" \w* [shall behave himself proudly]{strong=“H7292” x-morph=“strongMorph: \sc Th\sc*8799”} \w against the ancient| strong="H2205" \w*, [and the base]{strong=“H7034” x-morph=“strongMorph: \sc Th\sc*8737”} [against the honourable]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8737”}. 
\v 6 \w When a man| strong="H376" \w* [shall take hold]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8799”} \w of his brother| strong="H251" \w* \w of the house| strong="H1004" \w* \w of his father| strong="H1" \w*, saying, \w Thou hast clothing| strong="H8071" \w*, \w be thou our ruler| strong="H7101" \w*, and let \w this ruin| strong="H4384" \w* be \w under thy hand| strong="H3027" \w*: 
\v 7 \w In that day| strong="H3117" \w* [shall he swear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [I will not be an healer]{strong=“H2280” x-morph=“strongMorph: \sc Th\sc*8802”}; \w for in my house| strong="H1004" \w* is \w neither bread| strong="H3899" \w* \w nor clothing| strong="H8071" \w*: [make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w me not a ruler| strong="H7101" \w* \w of the people| strong="H5971" \w*.\f + \fr 3:7 \ft swear: Heb. lift up the hand \f* \f + \fr 3:7 \ft healer: Heb. binder up \f* 
\v 8 \w For Jerusalem| strong="H3389" \w* [is ruined]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and Judah| strong="H3063" \w* [is fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”}: \w because their tongue| strong="H3956" \w* \w and their doings| strong="H4611" \w* are against the \sc Lord\sc*, [to provoke]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8687”} \w the eyes| strong="H5869" \w* \w of his glory| strong="H3519" \w*. 
\p
\v 9 \w The shew| strong="H1971" \w* \w of their countenance| strong="H6440" \w* [doth witness against them]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”}; [and they declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} \w their sin| strong="H2403" \w* \w as Sodom| strong="H5467" \w*, [they hide]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8765”} it [not. Woe]{strong=“H188”} \w unto their soul| strong="H5315" \w*! [for they have rewarded]{strong=“H1580” x-morph=“strongMorph: \sc Th\sc*8804”} \w evil| strong="H7451" \w* unto themselves. 
\v 10 [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye to the righteous| strong="H6662" \w*, that it shall be \w well| strong="H2896" \w* with him: [for they shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the fruit| strong="H6529" \w* \w of their doings| strong="H4611" \w*. 
\v 11 \w Woe| strong="H188" \w* \w unto the wicked| strong="H7563" \w*! it shall be \w ill| strong="H7451" \w* with him: \w for the reward| strong="H1576" \w* \w of his hands| strong="H3027" \w* [shall be given]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8735”} him.\f + \fr 3:11 \ft given…: Heb. done to him \f* 
\p
\v 12 As for \w my people| strong="H5971" \w*, [children]{strong=“H5953” x-morph=“strongMorph: \sc Th\sc*8781”} are [their oppressors]{strong=“H5065” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and women| strong="H802" \w* [rule]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8804”} [over them. O my people]{strong=“H5971”}, [they which lead]{strong=“H833” x-morph=“strongMorph: \sc Th\sc*8764”} thee cause thee [to err]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8688”}, [and destroy]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8765”} \w the way| strong="H1870" \w* \w of thy paths| strong="H734" \w*.\f + \fr 3:12 \ft lead…: or, call thee blessed \f* \f + \fr 3:12 \ft destroy: Heb. swallow up \f* 
\v 13 The \sc Lord\sc* [standeth up]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8737”} [to plead]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8800”}, [and standeth]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} [to judge]{strong=“H1777” x-morph=“strongMorph: \sc Th\sc*8800”} \w the people| strong="H5971" \w*. 
\v 14 The \sc Lord\sc* [will enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into judgment| strong="H4941" \w* \w with the ancients| strong="H2205" \w* \w of his people| strong="H5971" \w*, \w and the princes| strong="H8269" \w* [thereof: for ye have eaten up]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8765”} \w the vineyard| strong="H3754" \w*; \w the spoil| strong="H1500" \w* \w of the poor| strong="H6041" \w* is \w in your houses| strong="H1004" \w*.\f + \fr 3:14 \ft eaten: or, burnt \f* 
\v 15 What mean ye that \w ye beat| strong="H1792" \w* \w my people| strong="H5971" \w* [to pieces]{strong=“H1792” x-morph=“strongMorph: \sc Th\sc*8762”}, [and grind]{strong=“H2912” x-morph=“strongMorph: \sc Th\sc*8799”} \w the faces| strong="H6440" \w* \w of the poor| strong="H6041" \w*? [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H136" \w* \sc God\sc* \w of hosts| strong="H6635" \w*. 
\p
\v 16 Moreover the \sc Lord\sc* [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Because| strong="H3282" \w* \w the daughters| strong="H1323" \w* \w of Zion| strong="H6726" \w* [are haughty]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8804”}, [and walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [with stretched forth]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8803”} \w necks| strong="H1627" \w* [and wanton]{strong=“H8265” x-morph=“strongMorph: \sc Th\sc*8764”} \w eyes| strong="H5869" \w*, [walking]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”} [and mincing]{strong=“H2952” x-morph=“strongMorph: \sc Th\sc*8800”} as [they go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [and making a tinkling]{strong=“H5913” x-morph=“strongMorph: \sc Th\sc*8762”} \w with their feet| strong="H7272" \w*:\f + \fr 3:16 \ft wanton…: Heb. deceiving with their eyes \f* \f + \fr 3:16 \ft mincing: or, tripping nicely \f* 
\v 17 \w Therefore the Lord| strong="H136" \w* [will smite with a scab]{strong=“H5596” x-morph=“strongMorph: \sc Th\sc*8765”} \w the crown of the head| strong="H6936" \w* \w of the daughters| strong="H1323" \w* \w of Zion| strong="H6726" \w*, and the \sc Lord\sc* [will discover]{strong=“H6168” x-morph=“strongMorph: \sc Th\sc*8762”} \w their secret parts| strong="H6596" \w*.\f + \fr 3:17 \ft discover: Heb. make naked \f* 
\v 18 \w In that day| strong="H3117" \w* \w the Lord| strong="H136" \w* [will take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8686”} \w the bravery| strong="H8597" \w* of their \w tinkling ornaments| strong="H5914" \w* about their feet, and their \w cauls| strong="H7636" \w*, and their \w round tires like the moon| strong="H7720" \w*,\f + \fr 3:18 \ft cauls: or, networks \f* 
\v 19 \w The chains| strong="H5188" \w*, \w and the bracelets| strong="H8285" \w*, \w and the mufflers| strong="H7479" \w*,\f + \fr 3:19 \ft chains: or, sweet balls \f* \f + \fr 3:19 \ft mufflers: or, spangled ornaments \f* 
\v 20 \w The bonnets| strong="H6287" \w*, \w and the ornaments of the legs| strong="H6807" \w*, \w and the headbands| strong="H7196" \w*, [and the tablets]{strong=“H1004 H5315”}, \w and the earrings| strong="H3908" \w*,\f + \fr 3:20 \ft tablets: Heb. houses of the soul \f* 
\v 21 \w The rings| strong="H2885" \w*, \w and nose| strong="H639" \w* \w jewels| strong="H5141" \w*, 
\v 22 \w The changeable suits of apparel| strong="H4254" \w*, \w and the mantles| strong="H4595" \w*, \w and the wimples| strong="H4304" \w*, \w and the crisping pins| strong="H2754" \w*, 
\v 23 \w The glasses| strong="H1549" \w*, \w and the fine linen| strong="H5466" \w*, \w and the hoods| strong="H6797" \w*, \w and the vails| strong="H7289" \w*. 
\v 24 And it shall come to pass, that \w instead of sweet smell| strong="H1314" \w* \w there shall be stink| strong="H4716" \w*; \w and instead of a girdle| strong="H2290" \w* \w a rent| strong="H5364" \w*; \w and instead of well set| strong="H4639" \w* \w hair| strong="H4748" \w* \w baldness| strong="H7144" \w*; \w and instead of a stomacher| strong="H6614" \w* \w a girding| strong="H4228" \w* \w of sackcloth| strong="H8242" \w*; and \w burning| strong="H3587" \w* \w instead of beauty| strong="H3308" \w*. 
\v 25 \w Thy men| strong="H4962" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w*, \w and thy mighty| strong="H1369" \w* \w in the war| strong="H4421" \w*.\f + \fr 3:25 \ft mighty: Heb. might \f* 
\v 26 \w And her gates| strong="H6607" \w* [shall lament]{strong=“H578” x-morph=“strongMorph: \sc Th\sc*8804”} [and mourn]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8804”}; and she being [desolate]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8738”} [shall sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the ground| strong="H776" \w*.\f + \fr 3:26 \ft desolate: or, emptied: Heb. cleansed \f*
\c 4
\p 
\v 1 \w And in that day| strong="H3117" \w* \w seven| strong="H7651" \w* \w women| strong="H802" \w* [shall take hold]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8689”} \w of one| strong="H259" \w* \w man| strong="H376" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [We will eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w our own bread| strong="H3899" \w*, [and wear]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w our own apparel| strong="H8071" \w*: [only let us be called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8735”} \w by thy name| strong="H8034" \w*, [to take away]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8798”} \w our reproach| strong="H2781" \w*.\f + \fr 4:1 \ft let…: Heb. let thy name be called upon us \f* \f + \fr 4:1 \ft to take…: or, take thou away \f* 
\p
\v 2 \w In that day| strong="H3117" \w* \w shall the branch| strong="H6780" \w* of the \sc Lord\sc* \w be beautiful| strong="H6643" \w* \w and glorious| strong="H3519" \w*, \w and the fruit| strong="H6529" \w* \w of the earth| strong="H776" \w* shall be \w excellent| strong="H1347" \w* \w and comely for| strong="H8597" \w* \w them that are escaped| strong="H6413" \w* \w of Israel| strong="H3478" \w*.\f + \fr 4:2 \ft beautiful…: Heb. beauty and glory \f* \f + \fr 4:2 \ft them…: Heb. the escaping \f* 
\v 3 And it shall come to pass, that he that is [left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”} \w in Zion| strong="H6726" \w*, and he that [remaineth]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8737”} \w in Jerusalem| strong="H3389" \w*, [shall be called]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8735”} \w holy| strong="H6918" \w*, even [every one that is written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8803”} \w among the living| strong="H2416" \w* \w in Jerusalem| strong="H3389" \w*:\f + \fr 4:3 \ft among…: or, to life \f* 
\v 4 \w When the Lord| strong="H136" \w* [shall have washed away]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} \w the filth| strong="H6675" \w* \w of the daughters| strong="H1323" \w* \w of Zion| strong="H6726" \w*, [and shall have purged]{strong=“H1740” x-morph=“strongMorph: \sc Th\sc*8686”} \w the blood| strong="H1818" \w* \w of Jerusalem| strong="H3389" \w* \w from the midst| strong="H7130" \w* \w thereof by the spirit| strong="H7307" \w* \w of judgment| strong="H4941" \w*, \w and by the spirit| strong="H7307" \w* [of burning]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8763”}. 
\v 5 And the \sc Lord\sc* [will create]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon every dwelling place| strong="H4349" \w* \w of mount| strong="H2022" \w* \w Zion| strong="H6726" \w*, \w and upon her assemblies| strong="H4744" \w*, \w a cloud| strong="H6051" \w* \w and smoke| strong="H6227" \w* \w by day| strong="H3119" \w*, \w and the shining| strong="H5051" \w* \w of a flaming| strong="H3852" \w* \w fire| strong="H784" \w* \w by night| strong="H3915" \w*: \w for upon all the glory| strong="H3519" \w* shall be \w a defence| strong="H2646" \w*.\f + \fr 4:5 \ft upon all: or, above all \f* \f + \fr 4:5 \ft defence: Heb. covering \f* 
\v 6 \w And there shall be a tabernacle| strong="H5521" \w* \w for a shadow| strong="H6738" \w* \w in the daytime| strong="H3119" \w* \w from the heat| strong="H2721" \w*, \w and for a place of refuge| strong="H4268" \w*, \w and for a covert| strong="H4563" \w* \w from storm| strong="H2230" \w* \w and from rain| strong="H4306" \w*.
\c 5
\p 
\v 1 [Now will I sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8799”} \w to my wellbeloved| strong="H3039" \w* \w a song| strong="H7892" \w* \w of my beloved| strong="H1730" \w* \w touching his vineyard| strong="H3754" \w*. \w My wellbeloved| strong="H3039" \w* \w hath a vineyard| strong="H3754" \w* [in a very fruitful]{strong=“H8081 H1121”} \w hill| strong="H7161" \w*:\f + \fr 5:1 \ft a very…: Heb. the horn of the son of oil \f* 
\v 2 [And he fenced]{strong=“H5823” x-morph=“strongMorph: \sc Th\sc*8762”} [it, and gathered out the stones]{strong=“H5619” x-morph=“strongMorph: \sc Th\sc*8762”} [thereof, and planted]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8799”} \w it with the choicest vine| strong="H8321" \w*, [and built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w a tower| strong="H4026" \w* \w in the midst| strong="H8432" \w* [of it, and also made]{strong=“H2672” x-morph=“strongMorph: \sc Th\sc*8804”} \w a winepress| strong="H3342" \w* [therein: and he looked]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8762”} [that it should bring forth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w grapes| strong="H6025" \w*, [and it brought forth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w wild grapes| strong="H891" \w*.\f + \fr 5:2 \ft fenced: or, made a wall about \f* \f + \fr 5:2 \ft made: Heb. hewed \f* 
\v 3 [And now, O inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w*, \w and men| strong="H376" \w* \w of Judah| strong="H3063" \w*, [judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8798”}, [I pray you, betwixt me and my vineyard]{strong=“H3754”}. 
\v 4 [What could have been done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w more to my vineyard| strong="H3754" \w*, [that I have not done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [in it? wherefore]{strong=“H4069”}, [when I looked]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8765”} [that it should bring forth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w grapes| strong="H6025" \w*, [brought it forth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w wild grapes| strong="H891" \w*? 
\v 5 [And now go to; I will tell]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8686”} [you what I will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w to my vineyard| strong="H3754" \w*: [I will take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8687”} \w the hedge| strong="H4881" \w* [thereof, and it shall be eaten up]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8763”}; and [break down]{strong=“H6555” x-morph=“strongMorph: \sc Th\sc*8800”} \w the wall| strong="H1447" \w* [thereof, and it shall be trodden down]{strong=“H4823”}:\f + \fr 5:5 \ft trodden…: Heb. for a treading \f* 
\v 6 [And I will lay]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w it waste| strong="H1326" \w*: [it shall not be pruned]{strong=“H2168” x-morph=“strongMorph: \sc Th\sc*8735”}, [nor digged]{strong=“H5737” x-morph=“strongMorph: \sc Th\sc*8735”}; [but there shall come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w briers| strong="H8068" \w* \w and thorns| strong="H7898" \w*: [I will also command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} \w the clouds| strong="H5645" \w* [that they rain]{strong=“H4305” x-morph=“strongMorph: \sc Th\sc*8687”} \w no rain| strong="H4306" \w* upon it. 
\v 7 \w For the vineyard| strong="H3754" \w* of the \sc Lord\sc* \w of hosts| strong="H6635" \w* is \w the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, \w and the men| strong="H376" \w* \w of Judah| strong="H3063" \w* \w his pleasant| strong="H8191" \w* \w plant| strong="H5194" \w*: [and he looked]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8762”} \w for judgment| strong="H4941" \w*, \w but behold oppression| strong="H4939" \w*; \w for righteousness| strong="H6666" \w*, \w but behold a cry| strong="H6818" \w*.\f + \fr 5:7 \ft his…: Heb. plant of his pleasures \f* \f + \fr 5:7 \ft oppression: Heb. a scab \f* 
\p
\v 8 \w Woe| strong="H1945" \w* [unto them that join]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8688”} \w house| strong="H1004" \w* \w to house| strong="H1004" \w*, that [lay]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”} \w field| strong="H7704" \w* \w to field| strong="H7704" \w*, till there be \w no| strong="H657" \w* \w place| strong="H4725" \w*, [that they may be placed]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8717”} \w alone in the midst| strong="H7130" \w* \w of the earth| strong="H776" \w*!\f + \fr 5:8 \ft they: Heb. ye \f* 
\v 9 \w In mine ears| strong="H241" \w* said the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w Of a truth| strong="H3808" \w* \w many| strong="H7227" \w* \w houses| strong="H1004" \w* \w shall be desolate| strong="H8047" \w*, even \w great| strong="H1419" \w* \w and fair| strong="H2896" \w*, [without inhabitant]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”}.^\sc 5:9 In…: or, This is in mine ears, saith the [Lord\sc*, etc] \f + \fr 5:9 \ft Of a…: Heb. If not, etc \f* 
