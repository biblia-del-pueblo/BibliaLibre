\c 27
\p 
\v 1 \w In that day| strong="H3117" \w* the \sc Lord\sc* \w with his sore| strong="H7186" \w* \w and great| strong="H1419" \w* \w and strong| strong="H2389" \w* \w sword| strong="H2719" \w* [shall punish]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} \w leviathan| strong="H3882" \w* \w the piercing| strong="H1281" \w* \w serpent| strong="H5175" \w*, \w even leviathan| strong="H3882" \w* \w that crooked| strong="H6129" \w* \w serpent| strong="H5175" \w*; [and he shall slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”} \w the dragon| strong="H8577" \w* that is \w in the sea| strong="H3220" \w*.\f + \fr 27:1 \ft piercing: or, crossing like a bar \f* 
