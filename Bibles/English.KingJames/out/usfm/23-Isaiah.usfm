\v 17 [Incline]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8685”} \w thine ear| strong="H241" \w*, O \sc Lord\sc*, [and hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}; [open]{strong=“H6491” x-morph=“strongMorph: \sc Th\sc*8798”} \w thine eyes| strong="H5869" \w*, O \sc Lord\sc*, [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}: [and hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w all the words| strong="H1697" \w* \w of Sennacherib| strong="H5576" \w*, [which hath sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [to reproach]{strong=“H2778” x-morph=“strongMorph: \sc Th\sc*8763”} \w the living| strong="H2416" \w* \w God| strong="H430" \w*. 
\v 18 \w Of a truth| strong="H551" \w*, \sc Lord\sc*, \w the kings| strong="H4428" \w* \w of Assyria| strong="H804" \w* [have laid waste]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8689”} \w all the nations| strong="H776" \w*, \w and their countries| strong="H776" \w*,\f + \fr 37:18 \ft nations: Heb. lands \f* 
\v 19 [And have cast]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w their gods| strong="H430" \w* \w into the fire| strong="H784" \w*: for they were \w no gods| strong="H430" \w*, \w but the work| strong="H4639" \w* [of men’s]{strong=“H120”} \w hands| strong="H3027" \w*, \w wood| strong="H6086" \w* \w and stone| strong="H68" \w*: [therefore they have destroyed]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8762”} them.\f + \fr 37:19 \ft cast: Heb. given \f* 
\v 20 Now therefore, O \sc Lord\sc* \w our God| strong="H430" \w*, [save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8685”} \w us from his hand| strong="H3027" \w*, \w that all the kingdoms| strong="H4467" \w* \w of the earth| strong="H776" \w* [may know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} that thou art the \sc Lord\sc*, even thou only. 
\p
\v 21 \w Then Isaiah| strong="H3470" \w* \w the son| strong="H1121" \w* \w of Amoz| strong="H531" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Hezekiah| strong="H2396" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w*, [Whereas thou hast prayed]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8694”} \w to me against Sennacherib| strong="H5576" \w* \w king| strong="H4428" \w* \w of Assyria| strong="H804" \w*: 
