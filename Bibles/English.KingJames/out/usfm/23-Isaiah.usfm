\v 22 \w And the wild beasts of the islands| strong="H338" \w* [shall cry]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”} \w in their desolate houses| strong="H490" \w*, \w and dragons| strong="H8577" \w* in their \w pleasant| strong="H6027" \w* \w palaces| strong="H1964" \w*: \w and her time| strong="H6256" \w* is \w near| strong="H7138" \w* [to come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}, \w and her days| strong="H3117" \w* [shall not be prolonged]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 13:22 \ft the wild…: Heb. Iim \f* \f + \fr 13:22 \ft desolate…: or, palaces \f*
\c 14
\p 
\v 1 For the \sc Lord\sc* [will have mercy]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8762”} \w on Jacob| strong="H3290" \w*, [and will yet choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} \w Israel| strong="H3478" \w*, [and set]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8689”} \w them in their own land| strong="H127" \w*: \w and the strangers| strong="H1616" \w* [shall be joined]{strong=“H3867” x-morph=“strongMorph: \sc Th\sc*8738”} [with them, and they shall cleave]{strong=“H5596” x-morph=“strongMorph: \sc Th\sc*8738”} \w to the house| strong="H1004" \w* \w of Jacob| strong="H3290" \w*. 
\v 2 \w And the people| strong="H5971" \w* [shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} [them, and bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w them to their place| strong="H4725" \w*: \w and the house| strong="H1004" \w* \w of Israel| strong="H3478" \w* [shall possess]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8694”} \w them in the land| strong="H127" \w* of the \sc Lord\sc* \w for servants| strong="H5650" \w* \w and handmaids| strong="H8198" \w*: [and they shall take them captives]{strong=“H7617” x-morph=“strongMorph: \sc Th\sc*8802”}, [whose captives]{strong=“H7617” x-morph=“strongMorph: \sc Th\sc*8802”} [they were; and they shall rule]{strong=“H7287” x-morph=“strongMorph: \sc Th\sc*8804”} [over their oppressors]{strong=“H5065” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 14:2 \ft whose…: Heb. that had taken them captives \f* 
\v 3 \w And it shall come to pass in the day| strong="H3117" \w* that the \sc Lord\sc* [shall give thee rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8687”} \w from thy sorrow| strong="H6090" \w*, \w and from thy fear| strong="H7267" \w*, \w and from the hard| strong="H7186" \w* \w bondage| strong="H5656" \w* [wherein thou wast made to serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8795”}, 
\p
\v 4 [That thou shalt take up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w this proverb| strong="H4912" \w* \w against the king| strong="H4428" \w* \w of Babylon| strong="H894" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [How hath the oppressor]{strong=“H5065” x-morph=“strongMorph: \sc Th\sc*8802”} [ceased]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8804”}! \w the golden city| strong="H4062" \w* [ceased]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8804”}!\f + \fr 14:4 \ft proverb: or, taunting speech \f* \f + \fr 14:4 \ft golden…: or, exactress of gold \f* 
\v 5 The \sc Lord\sc* [hath broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8804”} \w the staff| strong="H4294" \w* \w of the wicked| strong="H7563" \w*, and \w the sceptre| strong="H7626" \w* [of the rulers]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 6 [He who smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8688”} \w the people| strong="H5971" \w* \w in wrath| strong="H5678" \w* [with a continual]{strong=“H5627 H1115”} \w stroke| strong="H4347" \w*, [he that ruled]{strong=“H7287” x-morph=“strongMorph: \sc Th\sc*8802”} \w the nations| strong="H1471" \w* \w in anger| strong="H639" \w*, \w is persecuted| strong="H4783" \w*, and \w none| strong="H1097" \w* [hindereth]{strong=“H2820” x-morph=“strongMorph: \sc Th\sc*8804”}. \f + \fr 14:6 \ft a continual…: Heb. a stroke without removing \f* 
\v 7 \w The whole earth| strong="H776" \w* [is at rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8804”}, and [is quiet]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8804”}: [they break forth]{strong=“H6476” x-morph=“strongMorph: \sc Th\sc*8804”} \w into singing| strong="H7440" \w*. 
\v 8 [Yea, the fir trees]{strong=“H1265”} [rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8804”} at thee, and \w the cedars| strong="H730" \w* \w of Lebanon| strong="H3844" \w*, saying, [Since thou art laid down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8804”}, [no feller]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8802”} [is come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} against us. 
\v 9 \w Hell| strong="H7585" \w* [from beneath is moved]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8804”} [for thee to meet]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} thee [at thy coming]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}: [it stirreth up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8790”} \w the dead| strong="H7496" \w* for thee, even \w all the chief ones| strong="H6260" \w* \w of the earth| strong="H776" \w*; [it hath raised up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} \w from their thrones| strong="H3678" \w* \w all the kings| strong="H4428" \w* \w of the nations| strong="H1471" \w*.\f + \fr 14:9 \ft Hell: or, The grave \f* \f + \fr 14:9 \ft chief…: Heb. leaders, or, great goats \f* 
\v 10 [All they shall speak]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee, Art thou also become weak]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8795”} [as we? art thou become like]{strong=“H4911” x-morph=“strongMorph: \sc Th\sc*8738”} unto us? 
\v 11 \w Thy pomp| strong="H1347" \w* [is brought down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8717”} \w to the grave| strong="H7585" \w*, and \w the noise| strong="H1998" \w* \w of thy viols| strong="H5035" \w*: \w the worm| strong="H7415" \w* [is spread]{strong=“H3331” x-morph=“strongMorph: \sc Th\sc*8714”} [under thee, and the worms]{strong=“H8438”} \w cover| strong="H4374" \w* thee. 
\v 12 [How art thou fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} \w from heaven| strong="H8064" \w*, \w O Lucifer| strong="H1966" \w*, \w son| strong="H1121" \w* [of the morning]{strong=“H3213 H7837” x-morph=“strongMorph: \sc Th\sc*8685 strongMorph: \sc Th\sc*8676”}! how [art thou cut down]{strong=“H1438” x-morph=“strongMorph: \sc Th\sc*8738”} \w to the ground| strong="H776" \w*, [which didst weaken]{strong=“H2522” x-morph=“strongMorph: \sc Th\sc*8802”} \w the nations| strong="H1471" \w*!\f + \fr 14:12 \ft O Lucifer: or, O day star \f* 
\v 13 [For thou hast said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thine heart| strong="H3824" \w*, [I will ascend]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w into heaven| strong="H8064" \w*, [I will exalt]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} \w my throne| strong="H3678" \w* \w above| strong="H4605" \w* \w the stars| strong="H3556" \w* \w of God| strong="H410" \w*: [I will sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w also upon the mount| strong="H2022" \w* \w of the congregation| strong="H4150" \w*, \w in the sides| strong="H3411" \w* \w of the north| strong="H6828" \w*: 
\v 14 [I will ascend]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w above the heights| strong="H1116" \w* \w of the clouds| strong="H5645" \w*; [I will be like]{strong=“H1819” x-morph=“strongMorph: \sc Th\sc*8691”} \w the most High| strong="H5945" \w*. 
\v 15 [Yet thou shalt be brought down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8714”} \w to hell| strong="H7585" \w*, \w to the sides| strong="H3411" \w* \w of the pit| strong="H953" \w*. 
\v 16 [They that see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} [thee shall narrowly look]{strong=“H7688” x-morph=“strongMorph: \sc Th\sc*8686”} upon thee, and [consider]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8709”} thee, saying, Is \w this the man| strong="H376" \w* \w that made the earth| strong="H776" \w* [to tremble]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8688”}, [that did shake]{strong=“H7493” x-morph=“strongMorph: \sc Th\sc*8688”} \w kingdoms| strong="H4467" \w*; 
\v 17 That [made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w the world| strong="H8398" \w* \w as a wilderness| strong="H4057" \w*, [and destroyed]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8804”} \w the cities| strong="H5892" \w* thereof; that [opened]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the house| strong="H1004" \w* \w of his prisoners| strong="H615" \w*?\f + \fr 14:17 \ft opened…: or, did not let his prisoners loose homeward? \f* 
\v 18 \w All the kings| strong="H4428" \w* \w of the nations| strong="H1471" \w*, even [all of them, lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8804”} \w in glory| strong="H3519" \w*, \w every one| strong="H376" \w* \w in his own house| strong="H1004" \w*. 
\v 19 [But thou art cast out]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8717”} \w of thy grave| strong="H6913" \w* [like an abominable]{strong=“H8581” x-morph=“strongMorph: \sc Th\sc*8737”} \w branch| strong="H5342" \w*, and as \w the raiment| strong="H3830" \w* [of those that are slain]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8803”}, [thrust through]{strong=“H2944” x-morph=“strongMorph: \sc Th\sc*8794”} \w with a sword| strong="H2719" \w*, [that go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the stones| strong="H68" \w* \w of the pit| strong="H953" \w*; \w as a carcase| strong="H6297" \w* [trodden under feet]{strong=“H947” x-morph=“strongMorph: \sc Th\sc*8716”}. 
\v 20 [Thou shalt not be joined]{strong=“H3161” x-morph=“strongMorph: \sc Th\sc*8799”} \w with them in burial| strong="H6900" \w*, [because thou hast destroyed]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy land| strong="H776" \w*, and [slain]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy people| strong="H5971" \w*: \w the seed| strong="H2233" \w* [of evildoers]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8688”} \w shall never| strong="H5769" \w* [be renowned]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 21 [Prepare]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8685”} \w slaughter| strong="H4293" \w* \w for his children| strong="H1121" \w* \w for the iniquity| strong="H5771" \w* \w of their fathers| strong="H1" \w*; \w that they do not| strong="H1077" \w* [rise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [nor possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8804”} \w the land| strong="H776" \w*, [nor fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w the face| strong="H6440" \w* \w of the world| strong="H8398" \w* [with cities]{strong=“H5892 H6145” x-morph=“strongMorph: \sc Th\sc*8676”}. 
\v 22 [For I will rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”} [against them, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [and cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w from Babylon| strong="H894" \w* \w the name| strong="H8034" \w*, \w and remnant| strong="H7605" \w*, \w and son| strong="H5209" \w*, \w and nephew| strong="H5220" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 23 [I will also make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w it a possession| strong="H4180" \w* \w for the bittern| strong="H7090" \w*, \w and pools| strong="H98" \w* \w of water| strong="H4325" \w*: [and I will sweep]{strong=“H2894” x-morph=“strongMorph: \sc Th\sc*8773”} \w it with the besom| strong="H4292" \w* [of destruction]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8687”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*. 
\p
\v 24 The \sc Lord\sc* \w of hosts| strong="H6635" \w* [hath sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Surely as I have thought]{strong=“H1819” x-morph=“strongMorph: \sc Th\sc*8765”}, [so shall it come to pass; and as I have purposed]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8804”}, so [shall it stand]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}: 
\v 25 [That I will break]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8800”} \w the Assyrian| strong="H804" \w* \w in my land| strong="H776" \w*, \w and upon my mountains| strong="H2022" \w* [tread him under foot]{strong=“H947” x-morph=“strongMorph: \sc Th\sc*8799”}: \w then shall his yoke| strong="H5923" \w* [depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8804”} [from off them, and his burden]{strong=“H5448”} [depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8799”} \w from off their shoulders| strong="H7926" \w*. 
\v 26 This is \w the purpose| strong="H6098" \w* [that is purposed]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8803”} \w upon the whole earth| strong="H776" \w*: and this is \w the hand| strong="H3027" \w* [that is stretched out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8803”} \w upon all the nations| strong="H1471" \w*. 
\v 27 For the \sc Lord\sc* \w of hosts| strong="H6635" \w* [hath purposed]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8804”}, [and who shall disannul]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8686”} it? \w and his hand| strong="H3027" \w* is [stretched out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8803”}, [and who shall turn it back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”}? 
\v 28 \w In the year| strong="H8141" \w* \w that king| strong="H4428" \w* \w Ahaz| strong="H271" \w* \w died| strong="H4194" \w* \w was this burden| strong="H4853" \w*. 
\p
\v 29 [Rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} [not thou, whole Palestina]{strong=“H6429”}, \w because the rod| strong="H7626" \w* [of him that smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8688”} [thee is broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8738”}: [for out of the serpent’s]{strong=“H5175”} \w root| strong="H8328" \w* [shall come forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w a cockatrice| strong="H6848" \w*, \w and his fruit| strong="H6529" \w* shall be \w a fiery| strong="H8314" \w* [flying]{strong=“H5774” x-morph=“strongMorph: \sc Th\sc*8789”} \w serpent| strong="H8314" \w*.\f + \fr 14:29 \ft cockatrice: or, adder \f* 
\v 30 \w And the firstborn| strong="H1060" \w* \w of the poor| strong="H1800" \w* [shall feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and the needy| strong="H34" \w* [shall lie down]{strong=“H7257” x-morph=“strongMorph: \sc Th\sc*8799”} \w in safety| strong="H983" \w*: [and I will kill]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy root| strong="H8328" \w* \w with famine| strong="H7458" \w*, [and he shall slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy remnant| strong="H7611" \w*. 
\v 31 [Howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8685”}, \w O gate| strong="H8179" \w*; [cry]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O city| strong="H5892" \w*; [thou, whole Palestina]{strong=“H6429”}, art [dissolved]{strong=“H4127” x-morph=“strongMorph: \sc Th\sc*8738”}: [for there shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w from the north| strong="H6828" \w* \w a smoke| strong="H6227" \w*, and none shall be [alone]{strong=“H909” x-morph=“strongMorph: \sc Th\sc*8802”} \w in his appointed times| strong="H4151" \w*.\f + \fr 14:31 \ft none…: or, he shall not be alone \f* \f + \fr 14:31 \ft appointed…: or, assemblies \f* 
\v 32 What shall one [then answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w the messengers| strong="H4397" \w* \w of the nation| strong="H1471" \w*? That the \sc Lord\sc* [hath founded]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8765”} \w Zion| strong="H6726" \w*, \w and the poor| strong="H6041" \w* \w of his people| strong="H5971" \w* [shall trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8799”} in it.\f + \fr 14:32 \ft trust…: or, betake themselves unto it \f*
\c 15
\p 
\v 1 \w The burden| strong="H4853" \w* \w of Moab| strong="H4124" \w*. \w Because in the night| strong="H3915" \w* \w Ar| strong="H6144" \w* \w of Moab| strong="H4124" \w* [is laid waste]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8795”}, and [brought to silence]{strong=“H1820” x-morph=“strongMorph: \sc Th\sc*8738”}; \w because in the night| strong="H3915" \w* \w Kir| strong="H7024" \w* \w of Moab| strong="H4124" \w* [is laid waste]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8795”}, and [brought to silence]{strong=“H1820” x-morph=“strongMorph: \sc Th\sc*8738”};\f + \fr 15:1 \ft brought…: or, cut off \f* 
\v 2 [He is gone up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w to Bajith| strong="H1006" \w*, \w and to Dibon| strong="H1769" \w*, \w the high places| strong="H1116" \w*, \w to weep| strong="H1065" \w*: \w Moab| strong="H4124" \w* [shall howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8686”} \w over Nebo| strong="H5015" \w*, \w and over Medeba| strong="H4311" \w*: \w on all their heads| strong="H7218" \w* shall be \w baldness| strong="H7144" \w*, and \w every beard| strong="H2206" \w* [cut off]{strong=“H1438” x-morph=“strongMorph: \sc Th\sc*8803”}. 
\v 3 \w In their streets| strong="H2351" \w* [they shall gird]{strong=“H2296” x-morph=“strongMorph: \sc Th\sc*8804”} \w themselves with sackcloth| strong="H8242" \w*: \w on the tops| strong="H1406" \w* [of their houses, and in their streets]{strong=“H7339”}, [every one shall howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8686”}, \w weeping| strong="H1065" \w* [abundantly]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 15:3 \ft weeping…: Heb. descending into weeping, or, coming down with weeping \f* 
\v 4 \w And Heshbon| strong="H2809" \w* [shall cry]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and Elealeh| strong="H500" \w*: \w their voice| strong="H6963" \w* [shall be heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8738”} even \w unto Jahaz| strong="H3096" \w*: [therefore the armed soldiers]{strong=“H2502” x-morph=“strongMorph: \sc Th\sc*8803”} \w of Moab| strong="H4124" \w* [shall cry out]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8686”}; \w his life| strong="H5315" \w* [shall be grievous]{strong=“H3415” x-morph=“strongMorph: \sc Th\sc*8804”} unto him. 
\v 5 \w My heart| strong="H3820" \w* [shall cry out]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8799”} \w for Moab| strong="H4124" \w*; \w his fugitives| strong="H1280" \w* shall flee \w unto Zoar| strong="H6820" \w*, \w an heifer| strong="H5697" \w* \w of three years old| strong="H7992" \w*: \w for by the mounting up| strong="H4608" \w* \w of Luhith| strong="H3872" \w* \w with weeping| strong="H1065" \w* [shall they go it up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”}; \w for in the way| strong="H1870" \w* \w of Horonaim| strong="H2773" \w* [they shall raise up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8787”} \w a cry| strong="H2201" \w* \w of destruction| strong="H7667" \w*.\f + \fr 15:5 \ft his…: or, to the borders thereof, even to Zoar, as an heifer \f* \f + \fr 15:5 \ft destruction: Heb. breaking \f* 
\p
\v 6 \w For the waters| strong="H4325" \w* \w of Nimrim| strong="H5249" \w* \w shall be desolate| strong="H4923" \w*: \w for the hay| strong="H2682" \w* [is withered away]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the grass| strong="H1877" \w* [faileth]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”}, \w there is no green thing| strong="H3418" \w*.\f + \fr 15:6 \ft desolate: Heb. desolations \f* 
\v 7 \w Therefore the abundance| strong="H3502" \w* [they have gotten]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and that which they have laid up| strong="H6486" \w*, [shall they carry away]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the brook| strong="H5158" \w* \w of the willows| strong="H6155" \w*.\f + \fr 15:7 \ft brook…: or, valley of the Arabians \f* 
\v 8 \w For the cry| strong="H2201" \w* [is gone round about]{strong=“H5362” x-morph=“strongMorph: \sc Th\sc*8689”} \w the borders| strong="H1366" \w* \w of Moab| strong="H4124" \w*; \w the howling| strong="H3215" \w* \w thereof unto Eglaim| strong="H97" \w*, \w and the howling| strong="H3215" \w* [thereof unto Beer-elim]{strong=“H879”}. 
\v 9 \w For the waters| strong="H4325" \w* \w of Dimon| strong="H1775" \w* [shall be full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of blood| strong="H1818" \w*: [for I will bring]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} [more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8737”} \w upon Dimon| strong="H1775" \w*, \w lions| strong="H738" \w* \w upon him that escapeth| strong="H6413" \w* \w of Moab| strong="H4124" \w*, \w and upon the remnant| strong="H7611" \w* \w of the land| strong="H127" \w*.\f + \fr 15:9 \ft more: Heb. additions \f*
\c 16
\p 
\v 1 [Send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye the lamb| strong="H3733" \w* [to the ruler]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the land| strong="H776" \w* \w from Sela| strong="H5554" \w* \w to the wilderness| strong="H4057" \w*, \w unto the mount| strong="H2022" \w* \w of the daughter| strong="H1323" \w* \w of Zion| strong="H6726" \w*.\f + \fr 16:1 \ft Sela: or, Petra: Heb. A rock \f* 
\v 2 For it shall be, that, [as a wandering]{strong=“H5074” x-morph=“strongMorph: \sc Th\sc*8802”} \w bird| strong="H5775" \w* [cast out]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8794”} \w of the nest| strong="H7064" \w*, so \w the daughters| strong="H1323" \w* \w of Moab| strong="H4124" \w* \w shall be at the fords| strong="H4569" \w* \w of Arnon| strong="H769" \w*.\f + \fr 16:2 \ft cast…: or, a nest forsaken \f* 
\v 3 [Take]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8685”} \w counsel| strong="H6098" \w*, [execute]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} \w judgment| strong="H6415" \w*; [make]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy shadow| strong="H6738" \w* \w as the night| strong="H3915" \w* \w in the midst| strong="H8432" \w* \w of the noonday| strong="H6672" \w*; [hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8761”} [the outcasts]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8737”}; [bewray]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”} [not him that wandereth]{strong=“H5074” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 16:3 \ft Take: Heb. Bring \f* 
\v 4 [Let mine outcasts]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8737”} [dwell]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”} [with thee, Moab]{strong=“H4124”}; [be]{strong=“H1933” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou a covert| strong="H5643" \w* \w to them from the face| strong="H6440" \w* [of the spoiler]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8802”}: [for the extortioner]{strong=“H4160” x-morph=“strongMorph: \sc Th\sc*8801”} [is at an end]{strong=“H656” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the spoiler| strong="H7701" \w* [ceaseth]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”}, [the oppressors]{strong=“H7429” x-morph=“strongMorph: \sc Th\sc*8802”} [are consumed]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8804”} \w out of the land| strong="H776" \w*.\f + \fr 16:4 \ft extortioner: Heb. wringer \f* \f + \fr 16:4 \ft the oppressors: Heb. the treaders down \f* 
\v 5 \w And in mercy| strong="H2617" \w* \w shall the throne| strong="H3678" \w* [be established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8717”}: [and he shall sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon it in truth| strong="H571" \w* \w in the tabernacle| strong="H168" \w* \w of David| strong="H1732" \w*, [judging]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”}, [and seeking]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8802”} \w judgment| strong="H4941" \w*, \w and hasting| strong="H4106" \w* \w righteousness| strong="H6664" \w*.\f + \fr 16:5 \ft established: or, prepared \f* 
\p
\v 6 [We have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the pride| strong="H1347" \w* \w of Moab| strong="H4124" \w*; he is \w very| strong="H3966" \w* \w proud| strong="H1341" \w*: even \w of his haughtiness| strong="H1346" \w*, \w and his pride| strong="H1347" \w*, \w and his wrath| strong="H5678" \w*: but \w his lies| strong="H907" \w* shall not be so. 
\v 7 \w Therefore shall Moab| strong="H4124" \w* [howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8686”} \w for Moab| strong="H4124" \w*, [every one shall howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8686”}: \w for the foundations| strong="H808" \w* [of Kir-hareseth]{strong=“H7025”} [shall ye mourn]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8799”}; surely they are \w stricken| strong="H5218" \w*.\f + \fr 16:7 \ft mourn: or, mutter \f* 
\v 8 \w For the fields| strong="H7709" \w* \w of Heshbon| strong="H2809" \w* [languish]{strong=“H535” x-morph=“strongMorph: \sc Th\sc*8797”}, and \w the vine| strong="H1612" \w* \w of Sibmah| strong="H7643" \w*: \w the lords| strong="H1167" \w* \w of the heathen| strong="H1471" \w* [have broken down]{strong=“H1986” x-morph=“strongMorph: \sc Th\sc*8804”} \w the principal plants| strong="H8291" \w* [thereof, they are come]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8804”} even \w unto Jazer| strong="H3270" \w*, [they wandered]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8804”} through \w the wilderness| strong="H4057" \w*: \w her branches| strong="H7976" \w* [are stretched out]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8738”}, [they are gone over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w the sea| strong="H3220" \w*.\f + \fr 16:8 \ft stretched…: or, plucked up \f* 
\p
\v 9 [Therefore I will bewail]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the weeping| strong="H1065" \w* \w of Jazer| strong="H3270" \w* \w the vine| strong="H1612" \w* \w of Sibmah| strong="H7643" \w*: [I will water]{strong=“H7301” x-morph=“strongMorph: \sc Th\sc*8762”} \w thee with my tears| strong="H1832" \w*, \w O Heshbon| strong="H2809" \w*, \w and Elealeh| strong="H500" \w*: \w for the shouting| strong="H1959" \w* \w for thy summer fruits| strong="H7019" \w* \w and for thy harvest| strong="H7105" \w* [is fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 16:9 \ft the shouting…: or, the alarm is fallen upon, etc \f* 
\v 10 \w And gladness| strong="H8057" \w* [is taken away]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and joy| strong="H1524" \w* \w out of the plentiful field| strong="H3759" \w*; \w and in the vineyards| strong="H3754" \w* [there shall be no singing]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8792”}, [neither shall there be shouting]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8783”}: [the treaders]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8802”} [shall tread out]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8799”} \w no wine| strong="H3196" \w* in their \w presses| strong="H3342" \w*; I have made their vintage \w shouting| strong="H1959" \w* [to cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\v 11 \w Wherefore my bowels| strong="H4578" \w* [shall sound]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8799”} \w like an harp| strong="H3658" \w* \w for Moab| strong="H4124" \w*, \w and mine inward parts| strong="H7130" \w* [for Kir-haresh]{strong=“H7025”}. 
\p
\v 12 [And it shall come to pass, when it is seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8738”} \w that Moab| strong="H4124" \w* [is weary]{strong=“H3811” x-morph=“strongMorph: \sc Th\sc*8738”} \w on the high place| strong="H1116" \w*, [that he shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w to his sanctuary| strong="H4720" \w* [to pray]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8692”}; [but he shall not prevail]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 13 This is \w the word| strong="H1697" \w* that the \sc Lord\sc* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w concerning Moab| strong="H4124" \w* \w since that time| strong="H227" \w*. 
\v 14 But now the \sc Lord\sc* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Within three| strong="H7969" \w* \w years| strong="H8141" \w*, \w as the years| strong="H8141" \w* \w of an hireling| strong="H7916" \w*, \w and the glory| strong="H3519" \w* \w of Moab| strong="H4124" \w* [shall be contemned]{strong=“H7034” x-morph=“strongMorph: \sc Th\sc*8738”}, \w with all that great| strong="H7227" \w* \w multitude| strong="H1995" \w*; \w and the remnant| strong="H7605" \w* shall be \w very| strong="H4592" \w* \w small| strong="H4213" \w* and [feeble]{strong=“H3524 H3808”}.\f + \fr 16:14 \ft feeble: or, not many \f*
\c 17
\p 
\v 1 \w The burden| strong="H4853" \w* \w of Damascus| strong="H1834" \w*. [Behold, Damascus]{strong=“H1834”} [is taken away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8716”} from being \w a city| strong="H5892" \w*, \w and it shall be a ruinous| strong="H4654" \w* \w heap| strong="H4596" \w*. 
\v 2 \w The cities| strong="H5892" \w* \w of Aroer| strong="H6177" \w* are [forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8803”}: \w they shall be for flocks| strong="H5739" \w*, [which shall lie down]{strong=“H7257” x-morph=“strongMorph: \sc Th\sc*8804”}, and none shall make them [afraid]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 3 \w The fortress| strong="H4013" \w* [also shall cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8738”} \w from Ephraim| strong="H669" \w*, \w and the kingdom| strong="H4467" \w* \w from Damascus| strong="H1834" \w*, \w and the remnant| strong="H7605" \w* \w of Syria| strong="H758" \w*: \w they shall be as the glory| strong="H3519" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*. 
\v 4 \w And in that day| strong="H3117" \w* it shall come to pass, that \w the glory| strong="H3519" \w* \w of Jacob| strong="H3290" \w* [shall be made thin]{strong=“H1809” x-morph=“strongMorph: \sc Th\sc*8735”}, \w and the fatness| strong="H4924" \w* \w of his flesh| strong="H1320" \w* [shall wax lean]{strong=“H7329” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 5 \w And it shall be as when the harvestman| strong="H7105" \w* [gathereth]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8800”} \w the corn| strong="H7054" \w*, [and reapeth]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8799”} \w the ears| strong="H7641" \w* \w with his arm| strong="H2220" \w*; [and it shall be as he that gathereth]{strong=“H3950” x-morph=“strongMorph: \sc Th\sc*8764”} \w ears| strong="H7641" \w* \w in the valley| strong="H6010" \w* \w of Rephaim| strong="H7497" \w*. 
\p
\v 6 \w Yet gleaning grapes| strong="H5955" \w* [shall be left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8738”} [in it, as the shaking]{strong=“H5363”} \w of an olive tree| strong="H2132" \w*, \w two| strong="H8147" \w* or \w three| strong="H7969" \w* \w berries| strong="H1620" \w* \w in the top| strong="H7218" \w* \w of the uppermost bough| strong="H534" \w*, \w four| strong="H702" \w* or \w five| strong="H2568" \w* [in the outmost fruitful]{strong=“H6509” x-morph=“strongMorph: \sc Th\sc*8802”} \w branches| strong="H5585" \w* [thereof, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w*. 
\v 7 \w At that day| strong="H3117" \w* \w shall a man| strong="H120" \w* [look]{strong=“H8159” x-morph=“strongMorph: \sc Th\sc*8799”} [to his Maker]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and his eyes| strong="H5869" \w* [shall have respect]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the Holy| strong="H6918" \w* \w One of Israel| strong="H3478" \w*. 
\v 8 [And he shall not look]{strong=“H8159” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the altars| strong="H4196" \w*, \w the work| strong="H4639" \w* \w of his hands| strong="H3027" \w*, [neither shall respect]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} that \w which his fingers| strong="H676" \w* [have made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, \w either the groves| strong="H842" \w*, \w or the images| strong="H2553" \w*.\f + \fr 17:8 \ft images: or, sun images \f* 
\p
\v 9 \w In that day| strong="H3117" \w* \w shall his strong| strong="H4581" \w* \w cities| strong="H5892" \w* [be as a forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8803”} \w bough| strong="H2793" \w*, \w and an uppermost branch| strong="H534" \w*, [which they left]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} \w because| strong="H6440" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*: \w and there shall be desolation| strong="H8077" \w*. 
\v 10 [Because thou hast forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} \w the God| strong="H430" \w* \w of thy salvation| strong="H3468" \w*, [and hast not been mindful]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the rock| strong="H6697" \w* \w of thy strength| strong="H4581" \w*, [therefore shalt thou plant]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8799”} \w pleasant| strong="H5282" \w* \w plants| strong="H5194" \w*, [and shalt set]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8799”} [it with strange]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} \w slips| strong="H2156" \w*: 
\v 11 \w In the day| strong="H3117" \w* \w shalt thou make thy plant| strong="H5194" \w* [to grow]{strong=“H7735” x-morph=“strongMorph: \sc Th\sc*8770”}, \w and in the morning| strong="H1242" \w* \w shalt thou make thy seed| strong="H2233" \w* [to flourish]{strong=“H6524” x-morph=“strongMorph: \sc Th\sc*8686”}: but \w the harvest| strong="H7105" \w* shall be \w a heap| strong="H5067" \w* \w in the day| strong="H3117" \w* [of grief]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8737”} [and of desperate]{strong=“H605” x-morph=“strongMorph: \sc Th\sc*8803”} \w sorrow| strong="H3511" \w*.\f + \fr 17:11 \ft a heap…: or, removed in the day of inheritance, and there shall be deadly sorrow \f* 
\p
\v 12 \w Woe| strong="H1945" \w* \w to the multitude| strong="H1995" \w* \w of many| strong="H7227" \w* \w people| strong="H5971" \w*, which [make a noise]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8799”} [like the noise]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8800”} \w of the seas| strong="H3220" \w*; \w and to the rushing| strong="H7588" \w* \w of nations| strong="H3816" \w*, that [make a rushing like the rushing]{strong=“H7582” x-morph=“strongMorph: \sc Th\sc*8735”} \w of mighty| strong="H3524" \w* \w waters| strong="H4325" \w*!\f + \fr 17:12 \ft multitude: or, noise \f* \f + \fr 17:12 \ft mighty: or, many \f* 
\v 13 \w The nations| strong="H3816" \w* [shall rush]{strong=“H7582” x-morph=“strongMorph: \sc Th\sc*8735”} \w like the rushing| strong="H7588" \w* \w of many| strong="H7227" \w* \w waters| strong="H4325" \w*: but God [shall rebuke]{strong=“H1605” x-morph=“strongMorph: \sc Th\sc*8804”} [them, and they shall flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8804”} \w far off| strong="H4801" \w*, [and shall be chased]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8795”} \w as the chaff| strong="H4671" \w* \w of the mountains| strong="H2022" \w* \w before| strong="H6440" \w* \w the wind| strong="H7307" \w*, \w and like a rolling thing| strong="H1534" \w* \w before| strong="H6440" \w* \w the whirlwind| strong="H5492" \w*.\f + \fr 17:13 \ft a rolling…: or, thistledown \f* 
\v 14 [And behold at eveningtide]{strong=“H6153 H6256”} \w trouble| strong="H1091" \w*; and \w before the morning| strong="H1242" \w* he is not. This is \w the portion| strong="H2506" \w* [of them that spoil]{strong=“H8154” x-morph=“strongMorph: \sc Th\sc*8802”} [us, and the lot]{strong=“H1486”} [of them that rob]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8802”} us.
\c 18
\p 
\v 1 \w Woe| strong="H1945" \w* \w to the land| strong="H776" \w* \w shadowing| strong="H6767" \w* \w with wings| strong="H3671" \w*, which is \w beyond| strong="H5676" \w* \w the rivers| strong="H5104" \w* \w of Ethiopia| strong="H3568" \w*: 
\v 2 [That sendeth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8802”} \w ambassadors| strong="H6735" \w* \w by the sea| strong="H3220" \w*, \w even in vessels| strong="H3627" \w* \w of bulrushes| strong="H1573" \w* \w upon| strong="H6440" \w* \w the waters| strong="H4325" \w*, saying, [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, \w ye swift| strong="H7031" \w* \w messengers| strong="H4397" \w*, \w to a nation| strong="H1471" \w* [scattered]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8794”} [and peeled]{strong=“H4178” x-morph=“strongMorph: \sc Th\sc*8794”}, \w to a people| strong="H5971" \w* [terrible]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”} \w from their beginning hitherto| strong="H1973" \w*; \w a nation| strong="H1471" \w* \w meted out| strong="H6978" \w* \w and trodden down| strong="H4001" \w*, \w whose land| strong="H776" \w* \w the rivers| strong="H5104" \w* [have spoiled]{strong=“H958” x-morph=“strongMorph: \sc Th\sc*8804”}!\f + \fr 18:2 \ft scattered…: or, outspread and polished \f* \f + \fr 18:2 \ft meted…: or, that meteth out and treadeth down: Heb. of line, line, and treading under foot \f* \f + \fr 18:2 \ft have…: or, despise \f* 
\v 3 [All ye inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the world| strong="H8398" \w*, [and dwellers]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8802”} \w on the earth| strong="H776" \w*, [see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [ye, when he lifteth up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8800”} \w an ensign| strong="H5251" \w* \w on the mountains| strong="H2022" \w*; [and when he bloweth]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8800”} \w a trumpet| strong="H7782" \w*, [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} ye. 
\v 4 \w For so| strong="H3541" \w* the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me, I will take my rest]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8799”}, [and I will consider]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”} \w in my dwelling place| strong="H4349" \w* \w like a clear| strong="H6703" \w* \w heat| strong="H2527" \w* \w upon herbs| strong="H216" \w*, and \w like a cloud| strong="H5645" \w* \w of dew| strong="H2919" \w* \w in the heat| strong="H2527" \w* \w of harvest| strong="H7105" \w*.\f + \fr 18:4 \ft consider…: or, regard my set dwelling \f* \f + \fr 18:4 \ft upon…: or, after rain \f* 
\v 5 \w For afore| strong="H6440" \w* \w the harvest| strong="H7105" \w*, \w when the bud| strong="H6525" \w* [is perfect]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8800”}, \w and the sour grape| strong="H1155" \w* [is ripening]{strong=“H1580” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the flower| strong="H5328" \w*, [he shall both cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8804”} \w the sprigs| strong="H2150" \w* \w with pruning hooks| strong="H4211" \w*, [and take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8689”} and [cut down]{strong=“H8456” x-morph=“strongMorph: \sc Th\sc*8689”} \w the branches| strong="H5189" \w*. 
\v 6 [They shall be left]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8735”} \w together| strong="H3162" \w* \w unto the fowls| strong="H5861" \w* \w of the mountains| strong="H2022" \w*, \w and to the beasts| strong="H929" \w* \w of the earth| strong="H776" \w*: \w and the fowls| strong="H5861" \w* [shall summer]{strong=“H6972” x-morph=“strongMorph: \sc Th\sc*8804”} [upon them, and all the beasts]{strong=“H929”} \w of the earth| strong="H776" \w* [shall winter]{strong=“H2778” x-morph=“strongMorph: \sc Th\sc*8799”} upon them. 
\p
\v 7 \w In that time| strong="H6256" \w* \w shall the present| strong="H7862" \w* [be brought]{strong=“H2986” x-morph=“strongMorph: \sc Th\sc*8714”} unto the \sc Lord\sc* \w of hosts| strong="H6635" \w* \w of a people| strong="H5971" \w* [scattered]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8794”} [and peeled]{strong=“H4178” x-morph=“strongMorph: \sc Th\sc*8794”}, \w and from a people| strong="H5971" \w* [terrible]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”} \w from their beginning hitherto| strong="H1973" \w*; \w a nation| strong="H1471" \w* \w meted out| strong="H6978" \w* \w and trodden under foot| strong="H4001" \w*, \w whose land| strong="H776" \w* \w the rivers| strong="H5104" \w* [have spoiled]{strong=“H958” x-morph=“strongMorph: \sc Th\sc*8804”}, \w to the place| strong="H4725" \w* \w of the name| strong="H8034" \w* of the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the mount| strong="H2022" \w* \w Zion| strong="H6726" \w*.\f + \fr 18:7 \ft scattered…: or, outspread and polished \f*
\c 19
\p 
\v 1 \w The burden| strong="H4853" \w* \w of Egypt| strong="H4714" \w*. Behold, the \sc Lord\sc* [rideth]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon a swift| strong="H7031" \w* \w cloud| strong="H5645" \w*, [and shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into Egypt| strong="H4714" \w*: \w and the idols| strong="H457" \w* \w of Egypt| strong="H4714" \w* [shall be moved]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8804”} \w at his presence| strong="H6440" \w*, \w and the heart| strong="H3824" \w* \w of Egypt| strong="H4714" \w* [shall melt]{strong=“H4549” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the midst| strong="H7130" \w* of it. 
\v 2 [And I will set]{strong=“H5526” x-morph=“strongMorph: \sc Th\sc*8773”} \w the Egyptians| strong="H4714" \w* \w against the Egyptians| strong="H4714" \w*: [and they shall fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8738”} \w every one| strong="H376" \w* \w against his brother| strong="H251" \w*, \w and every one| strong="H376" \w* \w against his neighbour| strong="H7453" \w*; \w city| strong="H5892" \w* \w against city| strong="H5892" \w*, and \w kingdom| strong="H4467" \w* \w against kingdom| strong="H4467" \w*.\f + \fr 19:2 \ft set: Heb. mingle \f* 
\v 3 \w And the spirit| strong="H7307" \w* \w of Egypt| strong="H4714" \w* [shall fail]{strong=“H1238” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the midst| strong="H7130" \w* [thereof; and I will destroy]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8762”} \w the counsel| strong="H6098" \w* [thereof: and they shall seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the idols| strong="H457" \w*, \w and to the charmers| strong="H328" \w*, \w and to them that have familiar spirits| strong="H178" \w*, \w and to the wizards| strong="H3049" \w*.\f + \fr 19:3 \ft fail: Heb. be emptied \f* \f + \fr 19:3 \ft destroy: Heb. swallow up \f* 
\v 4 \w And| strong="H853" \w* \w the Egyptians| strong="H4714" \w* [will I give over]{strong=“H5534” x-morph=“strongMorph: \sc Th\sc*8765”} \w into the hand| strong="H3027" \w* \w of a cruel| strong="H7186" \w* \w lord| strong="H113" \w*; \w and a fierce| strong="H5794" \w* \w king| strong="H4428" \w* [shall rule]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8799”} [over them, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} \w the Lord| strong="H113" \w*, the \sc Lord\sc* \w of hosts| strong="H6635" \w*.\f + \fr 19:4 \ft give…: or, shut up \f* 
\v 5 \w And the waters| strong="H4325" \w* [shall fail]{strong=“H5405” x-morph=“strongMorph: \sc Th\sc*8738”} \w from the sea| strong="H3220" \w*, \w and the river| strong="H5104" \w* [shall be wasted]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8799”} [and dried up]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 6 \w And they shall turn| strong="H2186" \w* \w the rivers| strong="H5104" \w* [far away]{strong=“H2186” x-morph=“strongMorph: \sc Th\sc*8689”}; and \w the brooks| strong="H2975" \w* \w of defence| strong="H4693" \w* [shall be emptied]{strong=“H1809” x-morph=“strongMorph: \sc Th\sc*8804”} [and dried up]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8804”}: \w the reeds| strong="H7070" \w* \w and flags| strong="H5488" \w* [shall wither]{strong=“H7060” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 7 \w The paper reeds| strong="H6169" \w* \w by the brooks| strong="H2975" \w*, \w by the mouth| strong="H6310" \w* \w of the brooks| strong="H2975" \w*, \w and every thing sown| strong="H4218" \w* \w by the brooks| strong="H2975" \w*, [shall wither]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8799”}, [be driven away]{strong=“H5086” x-morph=“strongMorph: \sc Th\sc*8738”}, and be no more.\f + \fr 19:7 \ft and be…: Heb. and shall not be \f* 
\v 8 \w The fishers| strong="H1771" \w* [also shall mourn]{strong=“H578” x-morph=“strongMorph: \sc Th\sc*8804”}, [and all they that cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8688”} \w angle| strong="H2443" \w* \w into the brooks| strong="H2975" \w* [shall lament]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8804”}, [and they that spread]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8802”} \w nets| strong="H4365" \w* \w upon| strong="H6440" \w* \w the waters| strong="H4325" \w* [shall languish]{strong=“H535” x-morph=“strongMorph: \sc Th\sc*8797”}. 
\v 9 [Moreover they that work]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8802”} \w in fine| strong="H8305" \w* \w flax| strong="H6593" \w*, [and they that weave]{strong=“H707” x-morph=“strongMorph: \sc Th\sc*8802”} \w networks| strong="H2355" \w*, [shall be confounded]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 19:9 \ft networks: or, white works \f* 
\v 10 [And they shall be broken]{strong=“H1792” x-morph=“strongMorph: \sc Th\sc*8794”} \w in the purposes| strong="H8356" \w* [thereof, all that make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w sluices| strong="H7938" \w* and \w ponds| strong="H99" \w* \w for fish| strong="H5315" \w*.\f + \fr 19:10 \ft purposes: Heb. foundations \f* \f + \fr 19:10 \ft for fish: Heb. of living things \f* 
\p
\v 11 \w Surely the princes| strong="H8269" \w* \w of Zoan| strong="H6814" \w* are \w fools| strong="H191" \w*, \w the counsel| strong="H6098" \w* \w of the wise| strong="H2450" \w* [counsellors]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Pharaoh| strong="H6547" \w* [is become brutish]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8737”}: [how say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w ye unto Pharaoh| strong="H6547" \w*, I am \w the son| strong="H1121" \w* \w of the wise| strong="H2450" \w*, \w the son| strong="H1121" \w* \w of ancient| strong="H6924" \w* \w kings| strong="H4428" \w*? 
\v 12 \w Where| strong="H335" \w* are [they? where]{strong=“H645”} are \w thy wise| strong="H2450" \w* men? [and let them tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} [thee now, and let them know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} what the \sc Lord\sc* \w of hosts| strong="H6635" \w* [hath purposed]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon Egypt| strong="H4714" \w*. 
\v 13 \w The princes| strong="H8269" \w* \w of Zoan| strong="H6814" \w* [are become fools]{strong=“H2973” x-morph=“strongMorph: \sc Th\sc*8738”}, \w the princes| strong="H8269" \w* \w of Noph| strong="H5297" \w* [are deceived]{strong=“H5377” x-morph=“strongMorph: \sc Th\sc*8738”}; [they have also seduced]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8689”} \w Egypt| strong="H4714" \w*, even they that are \w the stay| strong="H6438" \w* \w of the tribes| strong="H7626" \w* thereof.\f + \fr 19:13 \ft they that…: or, governors: Heb. corners \f* 
\v 14 The \sc Lord\sc* [hath mingled]{strong=“H4537” x-morph=“strongMorph: \sc Th\sc*8804”} \w a perverse| strong="H5773" \w* \w spirit| strong="H7307" \w* \w in the midst| strong="H7130" \w* [thereof: and they have caused Egypt]{strong=“H4714”} [to err]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8689”} \w in every work| strong="H4639" \w* [thereof, as a drunken]{strong=“H7910”} man [staggereth]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8736”} \w in his vomit| strong="H6892" \w*.\f + \fr 19:14 \ft a perverse…: Heb. a spirit of perversities \f* 
\v 15 Neither shall there be any \w work| strong="H4639" \w* \w for Egypt| strong="H4714" \w*, \w which the head| strong="H7218" \w* \w or tail| strong="H2180" \w*, \w branch| strong="H3712" \w* \w or rush| strong="H100" \w*, [may do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 16 \w In that day| strong="H3117" \w* \w shall Egypt| strong="H4714" \w* \w be like unto women| strong="H802" \w*: [and it shall be afraid]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8804”} [and fear]{strong=“H6342” x-morph=“strongMorph: \sc Th\sc*8804”} \w because| strong="H6440" \w* \w of the shaking| strong="H8573" \w* \w of the hand| strong="H3027" \w* of the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [which he shaketh]{strong=“H5130” x-morph=“strongMorph: \sc Th\sc*8688”} over it. 
\v 17 \w And the land| strong="H127" \w* \w of Judah| strong="H3063" \w* \w shall be a terror| strong="H2283" \w* \w unto Egypt| strong="H4714" \w*, [every one that maketh mention]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8686”} [thereof shall be afraid]{strong=“H6342” x-morph=“strongMorph: \sc Th\sc*8799”} [in himself, because]{strong=“H6440”} \w of the counsel| strong="H6098" \w* of the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [which he hath determined]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8802”} against it. 
\p
\v 18 \w In that day| strong="H3117" \w* \w shall five| strong="H2568" \w* \w cities| strong="H5892" \w* \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* [speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8764”} \w the language| strong="H8193" \w* \w of Canaan| strong="H3667" \w*, [and swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8737”} to the \sc Lord\sc* \w of hosts| strong="H6635" \w*; \w one| strong="H259" \w* [shall be called]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8735”}, \w The city| strong="H5892" \w* \w of destruction| strong="H2041" \w*.\f + \fr 19:18 \ft the language: Heb. the lip \f* \f + \fr 19:18 \ft of destruction: or, of Heres, or, of the sun \f* 
\v 19 \w In that day| strong="H3117" \w* \w shall there be an altar| strong="H4196" \w* to the \sc Lord\sc* \w in the midst| strong="H8432" \w* \w of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, \w and a pillar| strong="H4676" \w* \w at| strong="H681" \w* \w the border| strong="H1366" \w* thereof to the \sc Lord\sc*. 
\v 20 \w And it shall be for a sign| strong="H226" \w* \w and for a witness| strong="H5707" \w* unto the \sc Lord\sc* \w of hosts| strong="H6635" \w* \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*: [for they shall cry]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc* \w because| strong="H6440" \w* [of the oppressors]{strong=“H3905” x-morph=“strongMorph: \sc Th\sc*8801”}, [and he shall send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} [them a saviour]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8688”}, \w and a great one| strong="H7227" \w*, [and he shall deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} them. 
\v 21 And the \sc Lord\sc* [shall be known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8738”} \w to Egypt| strong="H4714" \w*, \w and the Egyptians| strong="H4714" \w* [shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w in that day| strong="H3117" \w*, [and shall do]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} \w sacrifice| strong="H2077" \w* \w and oblation| strong="H4503" \w*; [yea, they shall vow]{strong=“H5087” x-morph=“strongMorph: \sc Th\sc*8804”} \w a vow| strong="H5088" \w* unto the \sc Lord\sc*, [and perform]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8765”} it. 
\v 22 And the \sc Lord\sc* [shall smite]{strong=“H5062” x-morph=“strongMorph: \sc Th\sc*8804”} \w Egypt| strong="H4714" \w*: [he shall smite]{strong=“H5062” x-morph=“strongMorph: \sc Th\sc*8800”} [and heal]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8800”} it: [and they shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} even to the \sc Lord\sc*, [and he shall be intreated]{strong=“H6279” x-morph=“strongMorph: \sc Th\sc*8738”} [of them, and shall heal]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8804”} them. 
\p
\v 23 \w In that day| strong="H3117" \w* \w shall there be a highway| strong="H4546" \w* \w out of Egypt| strong="H4714" \w* \w to Assyria| strong="H804" \w*, \w and the Assyrian| strong="H804" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into Egypt| strong="H4714" \w*, \w and the Egyptian| strong="H4714" \w* \w into Assyria| strong="H804" \w*, \w and the Egyptians| strong="H4714" \w* [shall serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} \w with the Assyrians| strong="H804" \w*. 
\v 24 \w In that day| strong="H3117" \w* \w shall Israel| strong="H3478" \w* \w be the third| strong="H7992" \w* \w with Egypt| strong="H4714" \w* \w and with Assyria| strong="H804" \w*, even \w a blessing| strong="H1293" \w* \w in the midst| strong="H7130" \w* \w of the land| strong="H776" \w*: 
\v 25 Whom the \sc Lord\sc* \w of hosts| strong="H6635" \w* [shall bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} be \w Egypt| strong="H4714" \w* \w my people| strong="H5971" \w*, \w and Assyria| strong="H804" \w* \w the work| strong="H4639" \w* \w of my hands| strong="H3027" \w*, \w and Israel| strong="H3478" \w* \w mine inheritance| strong="H5159" \w*. 
\c 20
\p 
\v 1 \w In the year| strong="H8141" \w* \w that Tartan| strong="H8661" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto Ashdod| strong="H795" \w*, (\w when Sargon| strong="H5623" \w* \w the king| strong="H4428" \w* \w of Assyria| strong="H804" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8800”} [him,) and fought]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8735”} \w against Ashdod| strong="H795" \w*, [and took]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8799”} it; 
\v 2 \w At the same time| strong="H6256" \w* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} the \sc Lord\sc* \w by| strong="H3027" \w* \w Isaiah| strong="H3470" \w* \w the son| strong="H1121" \w* \w of Amoz| strong="H531" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} [and loose]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8765”} \w the sackcloth| strong="H8242" \w* \w from off thy loins| strong="H4975" \w*, [and put off]{strong=“H2502” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy shoe| strong="H5275" \w* \w from thy foot| strong="H7272" \w*. [And he did so]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}, [walking]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”} \w naked| strong="H6174" \w* \w and barefoot| strong="H3182" \w*.\f + \fr 20:2 \ft by: Heb. by the hand of \f* 
\v 3 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Like as my servant| strong="H5650" \w* \w Isaiah| strong="H3470" \w* [hath walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w naked| strong="H6174" \w* \w and barefoot| strong="H3182" \w* \w three| strong="H7969" \w* \w years| strong="H8141" \w* for \w a sign| strong="H226" \w* \w and wonder| strong="H4159" \w* \w upon Egypt| strong="H4714" \w* \w and upon Ethiopia| strong="H3568" \w*; 
\v 4 \w So shall the king| strong="H4428" \w* \w of Assyria| strong="H804" \w* [lead away]{strong=“H5090” x-morph=“strongMorph: \sc Th\sc*8799”} \w the Egyptians| strong="H4714" \w* \w prisoners| strong="H7628" \w*, \w and the Ethiopians| strong="H3568" \w* \w captives| strong="H1546" \w*, \w young| strong="H5288" \w* \w and old| strong="H2205" \w*, \w naked| strong="H6174" \w* \w and barefoot| strong="H3182" \w*, even with their \w buttocks| strong="H8357" \w* [uncovered]{strong=“H2834” x-morph=“strongMorph: \sc Th\sc*8803”}, \w to the shame| strong="H6172" \w* \w of Egypt| strong="H4714" \w*.\f + \fr 20:4 \ft the Egyptians…: Heb. the captivity of Egypt \f* \f + \fr 20:4 \ft shame: Heb. nakedness \f* 
\v 5 [And they shall be afraid]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8804”} [and ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8804”} \w of Ethiopia| strong="H3568" \w* \w their expectation| strong="H4007" \w*, \w and of Egypt| strong="H4714" \w* \w their glory| strong="H8597" \w*. 
\v 6 [And the inhabitant]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of this isle| strong="H339" \w* [shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w in that day| strong="H3117" \w*, [Behold, such]{strong=“H3541”} is \w our expectation| strong="H4007" \w*, [whither we flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8804”} \w for help| strong="H5833" \w* [to be delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8736”} \w from| strong="H6440" \w* \w the king| strong="H4428" \w* \w of Assyria| strong="H804" \w*: [and how shall we escape]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8735”}?\f + \fr 20:6 \ft isle: or, country \f*
\c 21
\p 
\v 1 \w The burden| strong="H4853" \w* \w of the desert| strong="H4057" \w* \w of the sea| strong="H3220" \w*. \w As whirlwinds| strong="H5492" \w* \w in the south| strong="H5045" \w* [pass]{strong=“H2498” x-morph=“strongMorph: \sc Th\sc*8800”} through; so [it cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w from the desert| strong="H4057" \w*, [from a terrible]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”} \w land| strong="H776" \w*. 
\v 2 \w A grievous| strong="H7186" \w* \w vision| strong="H2380" \w* [is declared]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8717”} [unto me; the treacherous dealer]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”} [dealeth treacherously]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”}, [and the spoiler]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8802”} [spoileth]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8802”}. [Go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O Elam| strong="H5867" \w*: [besiege]{strong=“H6696” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O Media| strong="H4074" \w*; \w all the sighing| strong="H585" \w* [thereof have I made to cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8689”}.\f + \fr 21:2 \ft grievous: Heb. hard \f* 
\v 3 \w Therefore are my loins| strong="H4975" \w* [filled ]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w with pain| strong="H2479" \w*: \w pangs| strong="H6735" \w* [have taken hold]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8804”} [upon me, as the pangs]{strong=“H6735”} [of a woman that travaileth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”}: [I was bowed down]{strong=“H5753” x-morph=“strongMorph: \sc Th\sc*8738”} [at the hearing]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} of it; [I was dismayed]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8738”} [at the seeing]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} of it. 
\v 4 \w My heart| strong="H3824" \w* [panted]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8804”}, \w fearfulness| strong="H6427" \w* [affrighted]{strong=“H1204” x-morph=“strongMorph: \sc Th\sc*8765”} [me: the night]{strong=“H5399”} \w of my pleasure| strong="H2837" \w* [hath he turned]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w into fear| strong="H2731" \w* unto me.\f + \fr 21:4 \ft heart…: or, mind wandered \f* \f + \fr 21:4 \ft turned: Heb. put \f* 
\v 5 [Prepare]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8800”} \w the table| strong="H7979" \w*, [watch]{strong=“H6822” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the watchtower| strong="H6844" \w*, [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”}, [drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”}: [arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, \w ye princes| strong="H8269" \w*, and [anoint]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8798”} \w the shield| strong="H4043" \w*. 
\v 6 \w For thus hath the Lord| strong="H136" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me, Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [set]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8685”} [a watchman]{strong=“H6822” x-morph=“strongMorph: \sc Th\sc*8764”}, [let him declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} [what he seeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 7 [And he saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w a chariot| strong="H7393" \w* with \w a couple| strong="H6776" \w* \w of horsemen| strong="H6571" \w*, \w a chariot| strong="H7393" \w* \w of asses| strong="H2543" \w*, and \w a chariot| strong="H7393" \w* \w of camels| strong="H1581" \w*; [and he hearkened]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8689”} \w diligently| strong="H7182" \w* \w with much| strong="H7227" \w* \w heed| strong="H7182" \w*: 
\v 8 [And he cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”}, \w A lion| strong="H738" \w*: \w My lord| strong="H136" \w*, [I stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w continually| strong="H8548" \w* \w upon the watchtower| strong="H4707" \w* \w in the daytime| strong="H3119" \w*, [and I am set]{strong=“H5324” x-morph=“strongMorph: \sc Th\sc*8737”} \w in my ward| strong="H4931" \w* \w whole nights| strong="H3915" \w*:\f + \fr 21:8 \ft he…: or, cried as a lion \f* \f + \fr 21:8 \ft whole…: or, every night \f* 
