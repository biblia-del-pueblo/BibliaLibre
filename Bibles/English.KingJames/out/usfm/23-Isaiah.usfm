\p
\v 10 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* of the \sc Lord\sc*, \w ye rulers| strong="H7101" \w* \w of Sodom| strong="H5467" \w*; [give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto the law| strong="H8451" \w* \w of our God| strong="H430" \w*, \w ye people| strong="H5971" \w* \w of Gomorrah| strong="H6017" \w*. 
\v 11 \w To what| strong="H4100" \w* purpose is \w the multitude| strong="H7230" \w* \w of your sacrifices| strong="H2077" \w* [unto me? saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc*: [I am full]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the burnt offerings| strong="H5930" \w* \w of rams| strong="H352" \w*, \w and the fat| strong="H2459" \w* \w of fed beasts| strong="H4806" \w*; [and I delight]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} \w not in the blood| strong="H1818" \w* \w of bullocks| strong="H6499" \w*, \w or of lambs| strong="H3532" \w*, \w or of he goats| strong="H6260" \w*.\f + \fr 1:11 \ft he goats: Heb. great he goats \f* 
\v 12 [When ye come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [to appear]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8736”} \w before| strong="H6440" \w* [me, who hath required]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8765”} \w this at your hand| strong="H3027" \w*, [to tread]{strong=“H7429” x-morph=“strongMorph: \sc Th\sc*8800”} \w my courts| strong="H2691" \w*?\f + \fr 1:12 \ft to appear: Heb. to be seen \f* 
