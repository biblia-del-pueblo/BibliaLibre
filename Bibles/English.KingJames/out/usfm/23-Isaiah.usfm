\p
\v 21 [How is the faithful]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8737”} \w city| strong="H7151" \w* [become an harlot]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”}! \w it was full| strong="H4392" \w* \w of judgment| strong="H4941" \w*; \w righteousness| strong="H6664" \w* [lodged]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} [in it; but now murderers]{strong=“H7523” x-morph=“strongMorph: \sc Th\sc*8764”}. 
