\v 14 \w Your new moons| strong="H2320" \w* \w and your appointed feasts| strong="H4150" \w* \w my soul| strong="H5315" \w* [hateth]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”}: \w they are a trouble| strong="H2960" \w* [unto me; I am weary]{strong=“H3811” x-morph=“strongMorph: \sc Th\sc*8738”} [to bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8800”} them. 
\v 15 [And when ye spread forth]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8763”} \w your hands| strong="H3709" \w*, [I will hide]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8686”} \w mine eyes| strong="H5869" \w* [from you: yea, when ye make many]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} \w prayers| strong="H8605" \w*, [I will not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”}: \w your hands| strong="H3027" \w* [are full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of blood| strong="H1818" \w*.\f + \fr 1:15 \ft make…: Heb. multiply prayer \f* \f + \fr 1:15 \ft blood: Heb. bloods \f* 
\p
\v 16 [Wash]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8798”} [you, make you clean]{strong=“H2135” x-morph=“strongMorph: \sc Th\sc*8690”}; [put away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8685”} \w the evil| strong="H7455" \w* \w of your doings| strong="H4611" \w* \w from before| strong="H5048" \w* \w mine eyes| strong="H5869" \w*; [cease]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8798”} [to do evil]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8687”}; 
\v 17 [Learn]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8798”} [to do well]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8687”}; [seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8798”} \w judgment| strong="H4941" \w*, [relieve]{strong=“H833” x-morph=“strongMorph: \sc Th\sc*8761”} \w the oppressed| strong="H2541" \w*, [judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8798”} \w the fatherless| strong="H3490" \w*, [plead]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8798”} \w for the widow| strong="H490" \w*.\f + \fr 1:17 \ft relieve: or, righten \f* 
\v 18 [Come now]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [and let us reason together]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8735”}, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc*: \w though your sins| strong="H2399" \w* \w be as scarlet| strong="H8144" \w*, [they shall be as white]{strong=“H3835” x-morph=“strongMorph: \sc Th\sc*8686”} \w as snow| strong="H7950" \w*; [though they be red]{strong=“H119” x-morph=“strongMorph: \sc Th\sc*8686”} \w like crimson| strong="H8438" \w*, \w they shall be as wool| strong="H6785" \w*. 
\v 19 [If ye be willing]{strong=“H14” x-morph=“strongMorph: \sc Th\sc*8799”} [and obedient]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}, [ye shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the good| strong="H2898" \w* \w of the land| strong="H776" \w*: 
