\c 22
\p 
\v 1 \w The burden| strong="H4853" \w* \w of the valley| strong="H1516" \w* \w of vision| strong="H2384" \w*. \w What aileth thee now| strong="H645" \w*, [that thou art wholly gone up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the housetops| strong="H1406" \w*? 
\v 2 \w Thou that art full| strong="H4392" \w* \w of stirs| strong="H8663" \w*, [a tumultuous]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8802”} \w city| strong="H5892" \w*, \w a joyous| strong="H5947" \w* \w city| strong="H7151" \w*: \w thy slain| strong="H2491" \w* men are \w not slain| strong="H2491" \w* \w with the sword| strong="H2719" \w*, [nor dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”} \w in battle| strong="H4421" \w*. 
\v 3 \w All thy rulers| strong="H7101" \w* [are fled]{strong=“H5074” x-morph=“strongMorph: \sc Th\sc*8804”} \w together| strong="H3162" \w*, [they are bound]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8795”} \w by the archers| strong="H7198" \w*: [all that are found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8737”} [in thee are bound]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8795”} \w together| strong="H3162" \w*, which [have fled]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8804”} \w from far| strong="H7350" \w*.\f + \fr 22:3 \ft by…: Heb. of the bow \f* 
\v 4 [Therefore said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [I, Look away]{strong=“H8159” x-morph=“strongMorph: \sc Th\sc*8798”} [from me; I will weep]{strong=“H1065”} [bitterly]{strong=“H4843” x-morph=“strongMorph: \sc Th\sc*8762”}, [labour]{strong=“H213” x-morph=“strongMorph: \sc Th\sc*8686”} [not to comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8763”} [me, because of the spoiling]{strong=“H7701”} \w of the daughter| strong="H1323" \w* \w of my people| strong="H5971" \w*.\f + \fr 22:4 \ft weep…: Heb. be bitter in weeping \f* 
\v 5 For it is \w a day| strong="H3117" \w* \w of trouble| strong="H4103" \w*, \w and of treading down| strong="H4001" \w*, \w and of perplexity| strong="H3998" \w* \w by the Lord| strong="H136" \w* \sc God\sc* \w of hosts| strong="H6635" \w* \w in the valley| strong="H1516" \w* \w of vision| strong="H2384" \w*, [breaking ]{strong=“H6979” x-morph=“strongMorph: \sc Th\sc*8772”} \w down the walls| strong="H7023" \w*, \w and of crying| strong="H7771" \w* \w to the mountains| strong="H2022" \w*. 
\v 6 \w And Elam| strong="H5867" \w* [bare]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w the quiver| strong="H827" \w* \w with chariots| strong="H7393" \w* \w of men| strong="H120" \w* and \w horsemen| strong="H6571" \w*, \w and Kir| strong="H7024" \w* [uncovered]{strong=“H6168” x-morph=“strongMorph: \sc Th\sc*8765”} \w the shield| strong="H4043" \w*.\f + \fr 22:6 \ft uncovered: Heb. made naked \f* 
\v 7 And it shall come to pass, that \w thy choicest| strong="H4005" \w* \w valleys| strong="H6010" \w* [shall be full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of chariots| strong="H7393" \w*, \w and the horsemen| strong="H6571" \w* [shall set]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8804”} [themselves in array]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8800”} \w at the gate| strong="H8179" \w*.\f + \fr 22:7 \ft thy…: Heb. the choice of thy valleys \f* \f + \fr 22:7 \ft at: or, toward \f* 
\p
\v 8 [And he discovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”} \w the covering| strong="H4539" \w* \w of Judah| strong="H3063" \w*, [and thou didst look]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”} \w in that day| strong="H3117" \w* \w to the armour| strong="H5402" \w* \w of the house| strong="H1004" \w* \w of the forest| strong="H3293" \w*. 
\v 9 [Ye have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w also the breaches| strong="H1233" \w* \w of the city| strong="H5892" \w* \w of David| strong="H1732" \w*, [that they are many]{strong=“H7231” x-morph=“strongMorph: \sc Th\sc*8804”}: [and ye gathered together]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8762”} \w the waters| strong="H4325" \w* \w of the lower| strong="H8481" \w* \w pool| strong="H1295" \w*. 
\v 10 [And ye have numbered]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8804”} \w the houses| strong="H1004" \w* \w of Jerusalem| strong="H3389" \w*, \w and the houses| strong="H1004" \w* [have ye broken down]{strong=“H5422” x-morph=“strongMorph: \sc Th\sc*8799”} [to fortify]{strong=“H1219” x-morph=“strongMorph: \sc Th\sc*8763”} \w the wall| strong="H2346" \w*. 
\v 11 [Ye made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w also a ditch| strong="H4724" \w* \w between the two walls| strong="H2346" \w* \w for the water| strong="H4325" \w* \w of the old| strong="H3465" \w* \w pool| strong="H1295" \w*: [but ye have not looked]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8689”} [unto the maker]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} [thereof, neither had respect]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} [unto him that fashioned]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w it long ago| strong="H7350" \w*. 
\v 12 \w And in that day| strong="H3117" \w* \w did the Lord| strong="H136" \w* \sc God\sc* \w of hosts| strong="H6635" \w* [call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w to weeping| strong="H1065" \w*, \w and to mourning| strong="H4553" \w*, \w and to baldness| strong="H7144" \w*, [and to girding]{strong=“H2296” x-morph=“strongMorph: \sc Th\sc*8800”} \w with sackcloth| strong="H8242" \w*: 
\v 13 \w And behold joy| strong="H8342" \w* \w and gladness| strong="H8057" \w*, [slaying]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8800”} \w oxen| strong="H1241" \w*, [and killing]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8800”} \w sheep| strong="H6629" \w*, [eating]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} \w flesh| strong="H1320" \w*, [and drinking]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”} \w wine| strong="H3196" \w*: [let us eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} [and drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”}; \w for to morrow| strong="H4279" \w* [we shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 14 [And it was revealed]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8738”} \w in mine ears| strong="H241" \w* by the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w Surely this iniquity| strong="H5771" \w* [shall not be purged]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8792”} [from you till ye die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc* \w of hosts| strong="H6635" \w*. 
\p
\v 15 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc* \w of hosts| strong="H6635" \w*, [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [get]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} [thee unto this treasurer]{strong=“H5532” x-morph=“strongMorph: \sc Th\sc*8802”}, even \w unto Shebna| strong="H7644" \w*, which is \w over the house| strong="H1004" \w*, and say, 
\v 16 [What hast thou here? and whom hast thou here, that thou hast hewed thee out]{strong=“H2672” x-morph=“strongMorph: \sc Th\sc*8804”} \w a sepulchre| strong="H6913" \w* \w here| strong="H6311" \w*, as [he that heweth him out]{strong=“H2672” x-morph=“strongMorph: \sc Th\sc*8802”} \w a sepulchre| strong="H6913" \w* \w on high| strong="H4791" \w*, and [that graveth]{strong=“H2710” x-morph=“strongMorph: \sc Th\sc*8802”} \w an habitation| strong="H4908" \w* \w for himself in a rock| strong="H5553" \w*?\f + \fr 22:16 \ft as…: or, O he \f* 
\v 17 Behold, the \sc Lord\sc* [will carry thee away]{strong=“H2904” x-morph=“strongMorph: \sc Th\sc*8772”} \w with a mighty| strong="H1397" \w* \w captivity| strong="H2925" \w*, [and will surely]{strong=“H5844” x-morph=“strongMorph: \sc Th\sc*8800”} [cover]{strong=“H5844” x-morph=“strongMorph: \sc Th\sc*8802”} thee.\f + \fr 22:17 \ft will carry…: or, who covered thee with an excellent covering, and clothed thee gorgeously, (next verse) shall surely, etc \f* \f + \fr 22:17 \ft a mighty…: Heb. the captivity of a man \f* 
\v 18 [He will surely]{strong=“H6801” x-morph=“strongMorph: \sc Th\sc*8800”} [violently turn]{strong=“H6801” x-morph=“strongMorph: \sc Th\sc*8799”} \w and toss| strong="H6802" \w* thee like \w a ball| strong="H1754" \w* [into a large]{strong=“H3027 H7342”} \w country| strong="H776" \w*: [there shalt thou die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and there the chariots| strong="H4818" \w* \w of thy glory| strong="H3519" \w* shall be \w the shame| strong="H7036" \w* [of thy lord’s]{strong=“H113”} \w house| strong="H1004" \w*.\f + \fr 22:18 \ft large: Heb. large of spaces \f* 
\v 19 [And I will drive]{strong=“H1920” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee from thy station| strong="H4673" \w*, \w and from thy state| strong="H4612" \w* [shall he pull thee down]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 20 \w And it shall come to pass in that day| strong="H3117" \w*, [that I will call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w my servant| strong="H5650" \w* \w Eliakim| strong="H471" \w* \w the son| strong="H1121" \w* \w of Hilkiah| strong="H2518" \w*: 
\v 21 [And I will clothe]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8689”} \w him with thy robe| strong="H3801" \w*, [and strengthen]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8762”} \w him with thy girdle| strong="H73" \w*, [and I will commit]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy government| strong="H4475" \w* \w into his hand| strong="H3027" \w*: \w and he shall be a father| strong="H1" \w* [to the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w*, \w and to the house| strong="H1004" \w* \w of Judah| strong="H3063" \w*. 
\v 22 \w And the key| strong="H4668" \w* \w of the house| strong="H1004" \w* \w of David| strong="H1732" \w* [will I lay]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon his shoulder| strong="H7926" \w*; [so he shall open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8804”}, [and none shall shut]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8802”}; [and he shall shut]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8804”}, [and none shall open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 23 [And I will fasten]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8804”} him as \w a nail| strong="H3489" \w* [in a sure]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8737”} \w place| strong="H4725" \w*; \w and he shall be for a glorious| strong="H3519" \w* \w throne| strong="H3678" \w* [to his father’s]{strong=“H1”} \w house| strong="H1004" \w*. 
\v 24 [And they shall hang]{strong=“H8518” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon him all the glory| strong="H3519" \w* [of his father’s]{strong=“H1”} \w house| strong="H1004" \w*, \w the offspring| strong="H6631" \w* \w and the issue| strong="H6849" \w*, \w all vessels| strong="H3627" \w* \w of small| strong="H6996" \w* [quantity, from the vessels]{strong=“H3627”} \w of cups| strong="H101" \w*, \w even to all the vessels| strong="H3627" \w* \w of flagons| strong="H5035" \w*.\f + \fr 22:24 \ft vessels of flagons: or, instruments of viols \f* 
\v 25 \w In that day| strong="H3117" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w shall the nail| strong="H3489" \w* [that is fastened]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8803”} [in the sure]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8737”} \w place| strong="H4725" \w* [be removed]{strong=“H4185” x-morph=“strongMorph: \sc Th\sc*8799”}, [and be cut down]{strong=“H1438” x-morph=“strongMorph: \sc Th\sc*8738”}, [and fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”}; \w and the burden| strong="H4853" \w* that was [upon it shall be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8738”}: for the \sc Lord\sc* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it.
\c 23
\p 
\v 1 \w The burden| strong="H4853" \w* \w of Tyre| strong="H6865" \w*. [Howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8685”}, \w ye ships| strong="H591" \w* \w of Tarshish| strong="H8659" \w*; [for it is laid waste]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8795”}, \w so that there is no house| strong="H1004" \w*, [no entering in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}: \w from the land| strong="H776" \w* \w of Chittim| strong="H3794" \w* [it is revealed]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8738”} to them. 
\v 2 [Be still]{strong=“H1826” x-morph=“strongMorph: \sc Th\sc*8798”}, [ye inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the isle| strong="H339" \w*; [thou whom the merchants]{strong=“H5503” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Zidon| strong="H6721" \w*, [that pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} \w the sea| strong="H3220" \w*, [have replenished]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8765”}.\f + \fr 23:2 \ft still: Heb. silent \f* 
\v 3 \w And by great| strong="H7227" \w* \w waters| strong="H4325" \w* \w the seed| strong="H2233" \w* \w of Sihor| strong="H7883" \w*, \w the harvest| strong="H7105" \w* \w of the river| strong="H2975" \w*, is \w her revenue| strong="H8393" \w*; \w and she is a mart| strong="H5505" \w* \w of nations| strong="H1471" \w*. 
\v 4 [Be thou ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O Zidon| strong="H6721" \w*: \w for the sea| strong="H3220" \w* [hath spoken]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, even \w the strength| strong="H4581" \w* \w of the sea| strong="H3220" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [I travail]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8804”} [not, nor bring forth children]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”}, [neither do I nourish up]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8765”} \w young men| strong="H970" \w*, nor [bring up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8790”} \w virgins| strong="H1330" \w*. 
\v 5 \w As at the report| strong="H8088" \w* \w concerning Egypt| strong="H4714" \w*, so [shall they be sorely pained]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8799”} \w at the report| strong="H8088" \w* \w of Tyre| strong="H6865" \w*. 
\v 6 [Pass ye over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8798”} \w to Tarshish| strong="H8659" \w*; [howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8685”}, [ye inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the isle| strong="H339" \w*. 
\v 7 Is \w this your joyous| strong="H5947" \w* city, \w whose antiquity| strong="H6927" \w* is \w of ancient| strong="H6924" \w* \w days| strong="H3117" \w*? \w her own feet| strong="H7272" \w* [shall carry]{strong=“H2986” x-morph=“strongMorph: \sc Th\sc*8686”} \w her afar off| strong="H7350" \w* [to sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 23:7 \ft afar…: Heb. from afar off \f* 
\v 8 [Who hath taken this counsel]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8804”} \w against Tyre| strong="H6865" \w*, [the crowning]{strong=“H5849” x-morph=“strongMorph: \sc Th\sc*8688”} city, [whose merchants]{strong=“H5503” x-morph=“strongMorph: \sc Th\sc*8802”} are \w princes| strong="H8269" \w*, \w whose traffickers| strong="H3667" \w* are [the honourable]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8737”} \w of the earth| strong="H776" \w*? 
\v 9 The \sc Lord\sc* \w of hosts| strong="H6635" \w* [hath purposed]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8804”} [it, to stain]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8763”} \w the pride| strong="H1347" \w* \w of all glory| strong="H6643" \w*, and [to bring into contempt]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8687”} [all the honourable]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8737”} \w of the earth| strong="H776" \w*.\f + \fr 23:9 \ft to stain: Heb. to pollute \f* 
\v 10 [Pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8798”} \w through thy land| strong="H776" \w* \w as a river| strong="H2975" \w*, \w O daughter| strong="H1323" \w* \w of Tarshish| strong="H8659" \w*: there is \w no more strength| strong="H4206" \w*.\f + \fr 23:10 \ft strength: Heb. girdle \f* 
\v 11 [He stretched out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} \w his hand| strong="H3027" \w* \w over the sea| strong="H3220" \w*, [he shook]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8689”} \w the kingdoms| strong="H4467" \w*: the \sc Lord\sc* [hath given a commandment]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w against the merchant| strong="H3667" \w* city, [to destroy]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8687”} \w the strong| strong="H4581" \w* \w holds| strong="H4581" \w* thereof.\f + \fr 23:11 \ft against…: or, concerning a merchantman \f* \f + \fr 23:11 \ft the merchant city: Heb. Canaan \f* \f + \fr 23:11 \ft strong…: or, strengths \f* 
\v 12 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Thou shalt no more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [rejoice]{strong=“H5937” x-morph=“strongMorph: \sc Th\sc*8800”}, [O thou oppressed]{strong=“H6231” x-morph=“strongMorph: \sc Th\sc*8794”} \w virgin| strong="H1330" \w*, \w daughter| strong="H1323" \w* \w of Zidon| strong="H6721" \w*: [arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8798”} \w to Chittim| strong="H3794" \w*; [there also shalt thou have no rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 13 \w Behold the land| strong="H776" \w* \w of the Chaldeans| strong="H3778" \w*; \w this people| strong="H5971" \w* was not, till \w the Assyrian| strong="H804" \w* [founded ]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8804”} \w it for them that dwell in the wilderness| strong="H6728" \w*: [they set up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} \w the towers| strong="H971" \w* [thereof, they raised up]{strong=“H6209” x-morph=“strongMorph: \sc Th\sc*8782”} \w the palaces| strong="H759" \w* thereof; and [he brought]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w it to ruin| strong="H4654" \w*. 
\v 14 [Howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8685”}, \w ye ships| strong="H591" \w* \w of Tarshish| strong="H8659" \w*: \w for your strength| strong="H4581" \w* [is laid waste]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8795”}. 
\p
\v 15 \w And it shall come to pass in that day| strong="H3117" \w*, \w that Tyre| strong="H6865" \w* [shall be forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8737”} \w seventy| strong="H7657" \w* \w years| strong="H8141" \w*, \w according to the days| strong="H3117" \w* \w of one| strong="H259" \w* \w king| strong="H4428" \w*: \w after the end| strong="H7093" \w* \w of seventy| strong="H7657" \w* \w years| strong="H8141" \w* \w shall Tyre| strong="H6865" \w* \w sing| strong="H7892" \w* [as an harlot]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 23:15 \ft shall Tyre…: Heb. it shall be unto Tyre as the song of an harlot \f* 
\v 16 [Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w an harp| strong="H3658" \w*, [go about]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8798”} \w the city| strong="H5892" \w*, [thou harlot]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”} [that hast been forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8737”}; [make sweet]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8685”} [melody]{strong=“H5059” x-morph=“strongMorph: \sc Th\sc*8763”}, [sing many]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8685”} \w songs| strong="H7892" \w*, [that thou mayest be remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\p
\v 17 \w And it shall come to pass after the end| strong="H7093" \w* \w of seventy| strong="H7657" \w* \w years| strong="H8141" \w*, that the \sc Lord\sc* [will visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} \w Tyre| strong="H6865" \w*, [and she shall turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w to her hire| strong="H868" \w*, [and shall commit fornication]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8804”} \w with all the kingdoms| strong="H4467" \w* \w of the world| strong="H776" \w* \w upon the face| strong="H6440" \w* \w of the earth| strong="H127" \w*. 
\v 18 \w And her merchandise| strong="H5504" \w* \w and her hire| strong="H868" \w* \w shall be holiness| strong="H6944" \w* to the \sc Lord\sc*: [it shall not be treasured]{strong=“H686” x-morph=“strongMorph: \sc Th\sc*8735”} [nor laid up]{strong=“H2630” x-morph=“strongMorph: \sc Th\sc*8735”}; \w for her merchandise| strong="H5504" \w* [shall be for them that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w before| strong="H6440" \w* the \sc Lord\sc*, [to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} \w sufficiently| strong="H7654" \w*, \w and for durable| strong="H6266" \w* \w clothing| strong="H4374" \w*.\f + \fr 23:18 \ft durable: Heb. old \f*
\c 24
\p 
\v 1 Behold, the \sc Lord\sc* \w maketh the earth| strong="H776" \w* [empty]{strong=“H1238” x-morph=“strongMorph: \sc Th\sc*8802”}, [and maketh it waste]{strong=“H1110” x-morph=“strongMorph: \sc Th\sc*8802”}, [and turneth]{strong=“H5753” x-morph=“strongMorph: \sc Th\sc*8765”} \w it upside down| strong="H6440" \w*, [and scattereth abroad]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8689”} [the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} thereof.\f + \fr 24:1 \ft turneth…: Heb. perverteth the face thereof \f* 
\v 2 [And it shall be, as with the people]{strong=“H5971”}, \w so with the priest| strong="H3548" \w*; \w as with the servant| strong="H5650" \w*, \w so with his master| strong="H113" \w*; \w as with the maid| strong="H8198" \w*, \w so with her mistress| strong="H1404" \w*; [as with the buyer]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8802”}, [so with the seller]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8802”}; [as with the lender]{strong=“H3867” x-morph=“strongMorph: \sc Th\sc*8688”}, [so with the borrower]{strong=“H3867” x-morph=“strongMorph: \sc Th\sc*8801”}; [as with the taker of usury]{strong=“H5383” x-morph=“strongMorph: \sc Th\sc*8802”}, \w so| strong="H834" \w* [with the giver of usury]{strong=“H5378” x-morph=“strongMorph: \sc Th\sc*8801”} to him.\f + \fr 24:2 \ft priest: or, prince \f* 
\v 3 \w The land| strong="H776" \w* [shall be utterly]{strong=“H1238” x-morph=“strongMorph: \sc Th\sc*8736”} [emptied]{strong=“H1238” x-morph=“strongMorph: \sc Th\sc*8735”}, [and utterly]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8736”} [spoiled]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8735”}: for the \sc Lord\sc* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w this word| strong="H1697" \w*. 
\v 4 \w The earth| strong="H776" \w* [mourneth]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8804”} and [fadeth away]{strong=“H5034” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the world| strong="H8398" \w* [languisheth ]{strong=“H535” x-morph=“strongMorph: \sc Th\sc*8797”} and [fadeth away]{strong=“H5034” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the haughty| strong="H4791" \w* \w people| strong="H5971" \w* \w of the earth| strong="H776" \w* [do languish]{strong=“H535” x-morph=“strongMorph: \sc Th\sc*8797”}.\f + \fr 24:4 \ft the haughty…: Heb. the height of the people \f* 
\v 5 \w The earth| strong="H776" \w* [also is defiled]{strong=“H2610” x-morph=“strongMorph: \sc Th\sc*8804”} [under the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} [thereof; because they have transgressed]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w the laws| strong="H8451" \w*, [changed]{strong=“H2498” x-morph=“strongMorph: \sc Th\sc*8804”} \w the ordinance| strong="H2706" \w*, [broken]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8689”} \w the everlasting| strong="H5769" \w* \w covenant| strong="H1285" \w*. 
\v 6 \w Therefore hath the curse| strong="H423" \w* [devoured ]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w the earth| strong="H776" \w*, [and they that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} [therein are desolate]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8799”}: [therefore the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the earth| strong="H776" \w* [are burned]{strong=“H2787” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and few| strong="H4213" \w* \w men| strong="H582" \w* [left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 7 \w The new wine| strong="H8492" \w* [mourneth]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the vine| strong="H1612" \w* [languisheth]{strong=“H535” x-morph=“strongMorph: \sc Th\sc*8797”}, [all the merryhearted]{strong=“H3820 H8056”} [do sigh]{strong=“H584” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 8 \w The mirth| strong="H4885" \w* \w of tabrets| strong="H8596" \w* [ceaseth]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the noise| strong="H7588" \w* \w of them that rejoice| strong="H5947" \w* [endeth]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the joy| strong="H4885" \w* \w of the harp| strong="H3658" \w* [ceaseth]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 9 [They shall not drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w wine| strong="H3196" \w* \w with a song| strong="H7892" \w*; \w strong drink| strong="H7941" \w* [shall be bitter]{strong=“H4843” x-morph=“strongMorph: \sc Th\sc*8799”} [to them that drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8802”} it. 
\v 10 \w The city| strong="H7151" \w* \w of confusion| strong="H8414" \w* [is broken down]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8738”}: \w every house| strong="H1004" \w* [is shut up]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8795”}, [that no man may come in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 11 There is \w a crying| strong="H6682" \w* \w for wine| strong="H3196" \w* \w in the streets| strong="H2351" \w*; \w all joy| strong="H8057" \w* [is darkened]{strong=“H6150” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the mirth| strong="H4885" \w* \w of the land| strong="H776" \w* [is gone]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 12 \w In the city| strong="H5892" \w* [is left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8738”} \w desolation| strong="H8047" \w*, \w and the gate| strong="H8179" \w* [is smitten]{strong=“H3807” x-morph=“strongMorph: \sc Th\sc*8714”} \w with destruction| strong="H7591" \w*. 
\p
\v 13 \w When thus it shall be in the midst| strong="H7130" \w* \w of the land| strong="H776" \w* \w among| strong="H8432" \w* \w the people| strong="H5971" \w*, there shall be \w as the shaking| strong="H5363" \w* \w of an olive tree| strong="H2132" \w*, and \w as the gleaning grapes| strong="H5955" \w* \w when the vintage| strong="H1210" \w* [is done]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 14 [They shall lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their voice| strong="H6963" \w*, [they shall sing]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8799”} \w for the majesty| strong="H1347" \w* of the \sc Lord\sc*, [they shall cry aloud]{strong=“H6670” x-morph=“strongMorph: \sc Th\sc*8804”} \w from the sea| strong="H3220" \w*. 
\v 15 [Wherefore glorify]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc* \w in the fires| strong="H217" \w*, even \w the name| strong="H8034" \w* of the \sc Lord\sc* \w God| strong="H430" \w* \w of Israel| strong="H3478" \w* \w in the isles| strong="H339" \w* \w of the sea| strong="H3220" \w*.\f + \fr 24:15 \ft fires: or, valleys \f* 
\p
\v 16 \w From the uttermost part| strong="H3671" \w* \w of the earth| strong="H776" \w* [have we heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w songs| strong="H2158" \w*, even \w glory| strong="H6643" \w* \w to the righteous| strong="H6662" \w*. [But I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w My leanness| strong="H7334" \w*, \w my leanness| strong="H7334" \w*, \w woe| strong="H188" \w* [unto me! the treacherous dealers]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”} [have dealt treacherously]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8804”}; [yea, the treacherous dealers]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”} \w have dealt very| strong="H899" \w* [treacherously]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 24:16 \ft uttermost…: Heb. wing \f* \f + \fr 24:16 \ft My leanness: Heb. Leanness to me, or, My secret to me \f* 
\v 17 \w Fear| strong="H6343" \w*, \w and the pit| strong="H6354" \w*, \w and the snare| strong="H6341" \w*, are [upon thee, O inhabitant]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the earth| strong="H776" \w*. 
\v 18 And it shall come to pass, that [he who fleeth]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8801”} \w from the noise| strong="H6963" \w* \w of the fear| strong="H6343" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the pit| strong="H6354" \w*; [and he that cometh up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8802”} \w out of the midst| strong="H8432" \w* \w of the pit| strong="H6354" \w* [shall be taken]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the snare| strong="H6341" \w*: \w for the windows| strong="H699" \w* \w from on high| strong="H4791" \w* [are open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and the foundations| strong="H4146" \w* \w of the earth| strong="H776" \w* [do shake]{strong=“H7493” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 19 \w The earth| strong="H776" \w* [is utterly]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8800”} [broken down]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8712”}, \w the earth| strong="H776" \w* [is clean]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8800”} [dissolved]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8707”}, \w the earth| strong="H776" \w* [is moved]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8694”} [exceedingly]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 20 \w The earth| strong="H776" \w* [shall reel]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8799”} [to and fro]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8800”} \w like a drunkard| strong="H7910" \w*, [and shall be removed]{strong=“H5110” x-morph=“strongMorph: \sc Th\sc*8712”} \w like a cottage| strong="H4412" \w*; \w and the transgression| strong="H6588" \w* [thereof shall be heavy]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8804”} [upon it; and it shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”}, [and not rise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8800”} [again]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 21 \w And it shall come to pass in that day| strong="H3117" \w*, that the \sc Lord\sc* [shall punish]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} \w the host| strong="H6635" \w* \w of the high ones| strong="H4791" \w* that are \w on high| strong="H4791" \w*, \w and the kings| strong="H4428" \w* \w of the earth| strong="H127" \w* \w upon the earth| strong="H127" \w*.\f + \fr 24:21 \ft punish: Heb. visit upon \f* 
\v 22 [And they shall be gathered together]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8795”}, as \w prisoners| strong="H616" \w* \w are gathered| strong="H626" \w* \w in the pit| strong="H953" \w*, [and shall be shut up]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8795”} \w in the prison| strong="H4525" \w*, \w and after many| strong="H7230" \w* \w days| strong="H3117" \w* [shall they be visited]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 24:22 \ft as prisoners…: Heb. with the gathering of prisoners \f* \f + \fr 24:22 \ft pit: or, dungeon \f* \f + \fr 24:22 \ft visited: or, found wanting \f* 
\v 23 \w Then the moon| strong="H3842" \w* [shall be confounded]{strong=“H2659” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and the sun| strong="H2535" \w* [ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8804”}, when the \sc Lord\sc* \w of hosts| strong="H6635" \w* [shall reign]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8804”} \w in mount| strong="H2022" \w* \w Zion| strong="H6726" \w*, \w and in Jerusalem| strong="H3389" \w*, \w and before his ancients| strong="H2205" \w* \w gloriously| strong="H3519" \w*.\f + \fr 24:23 \ft before…: or, there shall be glory before his ancients \f*
\c 25
\p 
\v 1 O \sc Lord\sc*, thou art \w my God| strong="H430" \w*; [I will exalt]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8787”} [thee, I will praise]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy name| strong="H8034" \w*; [for thou hast done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w wonderful| strong="H6382" \w* things; thy \w counsels| strong="H6098" \w* \w of old| strong="H7350" \w* are \w faithfulness| strong="H530" \w* and \w truth| strong="H544" \w*. 
\v 2 [For thou hast made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w of a city| strong="H5892" \w* \w an heap| strong="H1530" \w*; of [a defenced]{strong=“H1219” x-morph=“strongMorph: \sc Th\sc*8803”} \w city| strong="H7151" \w* \w a ruin| strong="H4654" \w*: \w a palace| strong="H759" \w* [of strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} \w to be no city| strong="H5892" \w*; \w it shall never| strong="H5769" \w* [be built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 3 \w Therefore shall the strong| strong="H5794" \w* \w people| strong="H5971" \w* [glorify]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8762”} [thee, the city]{strong=“H7151”} \w of the terrible| strong="H6184" \w* \w nations| strong="H1471" \w* [shall fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} thee. 
\v 4 \w For thou hast been a strength| strong="H4581" \w* \w to the poor| strong="H1800" \w*, \w a strength| strong="H4581" \w* \w to the needy| strong="H34" \w* \w in his distress| strong="H6862" \w*, \w a refuge| strong="H4268" \w* \w from the storm| strong="H2230" \w*, \w a shadow| strong="H6738" \w* \w from the heat| strong="H2721" \w*, \w when the blast| strong="H7307" \w* \w of the terrible ones| strong="H6184" \w* is \w as a storm| strong="H2230" \w* against \w the wall| strong="H7023" \w*. 
\v 5 [Thou shalt bring down]{strong=“H3665” x-morph=“strongMorph: \sc Th\sc*8686”} \w the noise| strong="H7588" \w* [of strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”}, \w as the heat| strong="H2721" \w* \w in a dry place| strong="H6724" \w*; even \w the heat| strong="H2721" \w* \w with the shadow| strong="H6738" \w* \w of a cloud| strong="H5645" \w*: \w the branch| strong="H2159" \w* \w of the terrible ones| strong="H6184" \w* [shall be brought low]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 6 \w And in this mountain| strong="H2022" \w* shall the \sc Lord\sc* \w of hosts| strong="H6635" \w* [make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto all people| strong="H5971" \w* \w a feast| strong="H4960" \w* \w of fat things| strong="H8081" \w*, \w a feast| strong="H4960" \w* \w of wines on the lees| strong="H8105" \w*, \w of fat things| strong="H8081" \w* [full of marrow]{strong=“H4229” x-morph=“strongMorph: \sc Th\sc*8794”}, \w of wines on the lees| strong="H8105" \w* [well refined]{strong=“H2212” x-morph=“strongMorph: \sc Th\sc*8794”}. 
\v 7 [And he will destroy]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8765”} \w in this mountain| strong="H2022" \w* \w the face| strong="H6440" \w* \w of the covering| strong="H3875" \w* [cast over]{strong=“H3874” x-morph=“strongMorph: \sc Th\sc*8802”} \w all people| strong="H5971" \w*, \w and the vail| strong="H4541" \w* [that is spread]{strong=“H5259” x-morph=“strongMorph: \sc Th\sc*8803”} \w over all nations| strong="H1471" \w*.\f + \fr 25:7 \ft destroy: Heb. swallow up \f* \f + \fr 25:7 \ft cast: Heb. covered \f* 
\v 8 [He will swallow up]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8765”} \w death| strong="H4194" \w* \w in victory| strong="H5331" \w*; \w and the Lord| strong="H136" \w* \sc God\sc* [will wipe away]{strong=“H4229” x-morph=“strongMorph: \sc Th\sc*8804”} \w tears| strong="H1832" \w* \w from off all faces| strong="H6440" \w*; \w and the rebuke| strong="H2781" \w* \w of his people| strong="H5971" \w* [shall he take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8686”} \w from off all the earth| strong="H776" \w*: for the \sc Lord\sc* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it. 
\p
\v 9 [And it shall be said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w in that day| strong="H3117" \w*, Lo, this is \w our God| strong="H430" \w*; [we have waited]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8765”} [for him, and he will save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} us: this is the \sc Lord\sc*; [we have waited]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8765”} [for him, we will be glad]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”} [and rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his salvation| strong="H3444" \w*. 
\v 10 \w For in this mountain| strong="H2022" \w* \w shall the hand| strong="H3027" \w* of the \sc Lord\sc* [rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and Moab| strong="H4124" \w* [shall be trodden down]{strong=“H1758” x-morph=“strongMorph: \sc Th\sc*8736”} [under him, even as straw]{strong=“H4963”} [is trodden down]{strong=“H1758” x-morph=“strongMorph: \sc Th\sc*8738”} [for the dunghill]{strong=“H4325 H4087 H1119” x-morph=“strongMorph: \sc Th\sc*8675”}.\f + \fr 25:10 \ft trodden down under: or, threshed, etc \f* \f + \fr 25:10 \ft trodden down for…: or, threshed in Madmenah \f* 
\v 11 [And he shall spread forth]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8765”} \w his hands| strong="H3027" \w* \w in the midst| strong="H7130" \w* [of them, as he that swimmeth]{strong=“H7811” x-morph=“strongMorph: \sc Th\sc*8802”} [spreadeth forth]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8762”} his hands [to swim]{strong=“H7811” x-morph=“strongMorph: \sc Th\sc*8800”}: [and he shall bring down]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8689”} \w their pride| strong="H1346" \w* \w together with the spoils| strong="H698" \w* \w of their hands| strong="H3027" \w*. 
\v 12 \w And the fortress| strong="H4013" \w* \w of the high fort| strong="H4869" \w* \w of thy walls| strong="H2346" \w* [shall he bring down]{strong=“H7817” x-morph=“strongMorph: \sc Th\sc*8689”}, [lay low]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8689”}, and [bring]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8689”} \w to the ground| strong="H776" \w*, even \w to the dust| strong="H6083" \w*.
\c 26
\p 
\v 1 \w In that day| strong="H3117" \w* \w shall this song| strong="H7892" \w* [be sung]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8714”} \w in the land| strong="H776" \w* \w of Judah| strong="H3063" \w*; \w We have a strong| strong="H5797" \w* \w city| strong="H5892" \w*; \w salvation| strong="H3444" \w* will God [appoint]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} for \w walls| strong="H2346" \w* \w and bulwarks| strong="H2426" \w*. 
\v 2 [Open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye the gates| strong="H8179" \w*, \w that the righteous| strong="H6662" \w* \w nation| strong="H1471" \w* [which keepeth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w the truth| strong="H529" \w* [may enter in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 26:2 \ft truth: Heb. truths \f* 
\v 3 [Thou wilt keep]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8799”} him \w in perfect| strong="H7965" \w* \w peace| strong="H7965" \w*, whose \w mind| strong="H3336" \w* is [stayed]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8803”} on thee: [because he trusteth]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8803”} in thee.\f + \fr 26:3 \ft perfect…: Heb. peace, peace \f* \f + \fr 26:3 \ft mind: or, thought, or, imagination \f* 
\v 4 [Trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8798”} ye in the \sc Lord\sc* \w for ever| strong="H5703" \w*: for in the \sc Lord\sc* \sc Jehovah\sc* is \w everlasting| strong="H5769" \w* \w strength| strong="H6697" \w*:\f + \fr 26:4 \ft everlasting…: Heb. the rock of ages \f* 
\p
\v 5 [For he bringeth down]{strong=“H7817” x-morph=“strongMorph: \sc Th\sc*8689”} [them that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w on high| strong="H4791" \w*; [the lofty]{strong=“H7682” x-morph=“strongMorph: \sc Th\sc*8737”} \w city| strong="H7151" \w*, [he layeth it low]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8686”}; [he layeth it low]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8686”}, even \w to the ground| strong="H776" \w*; [he bringeth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8686”} it even \w to the dust| strong="H6083" \w*. 
\v 6 \w The foot| strong="H7272" \w* [shall tread it down]{strong=“H7429” x-morph=“strongMorph: \sc Th\sc*8799”}, even \w the feet| strong="H7272" \w* \w of the poor| strong="H6041" \w*, and \w the steps| strong="H6471" \w* \w of the needy| strong="H1800" \w*. 
\v 7 \w The way| strong="H734" \w* \w of the just| strong="H6662" \w* is \w uprightness| strong="H4339" \w*: [thou, most upright]{strong=“H3477”}, [dost weigh]{strong=“H6424” x-morph=“strongMorph: \sc Th\sc*8762”} \w the path| strong="H4570" \w* \w of the just| strong="H6662" \w*. 
\v 8 [Yea, in the way]{strong=“H734”} \w of thy judgments| strong="H4941" \w*, O \sc Lord\sc*, [have we waited]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8765”} [for thee; the desire]{strong=“H8378”} of our \w soul| strong="H5315" \w* is \w to thy name| strong="H8034" \w*, \w and to the remembrance| strong="H2143" \w* of thee. 
\v 9 \w With my soul| strong="H5315" \w* [have I desired]{strong=“H183” x-morph=“strongMorph: \sc Th\sc*8765”} \w thee in the night| strong="H3915" \w*; [yea, with my spirit]{strong=“H7307”} \w within| strong="H7130" \w* [me will I seek thee early]{strong=“H7836” x-morph=“strongMorph: \sc Th\sc*8762”}: \w for when thy judgments| strong="H4941" \w* are \w in the earth| strong="H776" \w*, [the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the world| strong="H8398" \w* [will learn]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8804”} \w righteousness| strong="H6664" \w*. 
\v 10 [Let favour be shewed]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8717”} \w to the wicked| strong="H7563" \w*, yet \w will he not| strong="H1077" \w* [learn]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8804”} \w righteousness| strong="H6664" \w*: \w in the land| strong="H776" \w* \w of uprightness| strong="H5229" \w* [will he deal unjustly]{strong=“H5765” x-morph=“strongMorph: \sc Th\sc*8762”}, \w and will not| strong="H1077" \w* [behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the majesty| strong="H1348" \w* of the \sc Lord\sc*. 
\v 11 \sc Lord\sc*, when \w thy hand| strong="H3027" \w* [is lifted up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8804”}, [they will not see]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8799”}: but [they shall see]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8799”}, [and be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} for their \w envy| strong="H7068" \w* \w at the people| strong="H5971" \w*; [yea, the fire]{strong=“H784”} \w of thine enemies| strong="H6862" \w* [shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} them.\f + \fr 26:11 \ft at…: or, toward thy people \f* 
\p
\v 12 \sc Lord\sc*, [thou wilt ordain]{strong=“H8239” x-morph=“strongMorph: \sc Th\sc*8799”} \w peace| strong="H7965" \w* [for us: for thou also hast wrought]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8804”} \w all our works| strong="H4639" \w* in us.\f + \fr 26:12 \ft in us: or, for us \f* 
\v 13 O \sc Lord\sc* \w our God| strong="H430" \w*, other \w lords| strong="H113" \w* \w beside| strong="H2108" \w* [thee have had dominion]{strong=“H1166” x-morph=“strongMorph: \sc Th\sc*8804”} over us: but [by thee only will we make mention]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8686”} \w of thy name| strong="H8034" \w*. 
\v 14 They are [dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”}, [they shall not live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}; they are \w deceased| strong="H7496" \w*, [they shall not rise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}: [therefore hast thou visited]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} [and destroyed]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8686”} [them, and made all their memory]{strong=“H2143”} [to perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 15 [Thou hast increased]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8804”} \w the nation| strong="H1471" \w*, O \sc Lord\sc*, [thou hast increased]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8804”} \w the nation| strong="H1471" \w*: [thou art glorified]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8738”}: thou hadst removed it [far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8765”} unto \w all the ends| strong="H7099" \w* \w of the earth| strong="H776" \w*. 
\v 16 \sc Lord\sc*, \w in trouble| strong="H6862" \w* [have they visited]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, they poured out]{strong=“H6694” x-morph=“strongMorph: \sc Th\sc*8804”} \w a prayer| strong="H3908" \w* when \w thy chastening| strong="H4148" \w* was upon them.\f + \fr 26:16 \ft prayer: Heb. secret speech \f* 
\v 17 \w Like| strong="H3644" \w* \w as a woman with child| strong="H2030" \w*, that [draweth near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”} [the time of her delivery]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8800”}, [is in pain]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8799”}, and [crieth out]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8799”} \w in her pangs| strong="H2256" \w*; \w so have we been in thy sight| strong="H6440" \w*, O \sc Lord\sc*. 
\v 18 [We have been with child]{strong=“H2029” x-morph=“strongMorph: \sc Th\sc*8804”}, [we have been in pain]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8804”}, \w we have as it were| strong="H3644" \w* [brought forth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} \w wind| strong="H7307" \w*; [we have not wrought]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w any deliverance| strong="H3444" \w* \w in the earth| strong="H776" \w*; \w neither| strong="H1077" \w* [have the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the world| strong="H8398" \w* [fallen]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 19 [Thy dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”} men [shall live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}, together with \w my dead body| strong="H5038" \w* [shall they arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}. [Awake]{strong=“H6974” x-morph=“strongMorph: \sc Th\sc*8685”} [and sing]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8761”}, [ye that dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8802”} \w in dust| strong="H6083" \w*: \w for thy dew| strong="H2919" \w* is as \w the dew| strong="H2919" \w* \w of herbs| strong="H219" \w*, \w and the earth| strong="H776" \w* [shall cast out]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8686”} \w the dead| strong="H7496" \w*. 
\p
\v 20 [Come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, \w my people| strong="H5971" \w*, [enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou into thy chambers| strong="H2315" \w*, [and shut]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy doors| strong="H1817" \w* [about thee: hide]{strong=“H2247” x-morph=“strongMorph: \sc Th\sc*8798”} \w thyself as it were for a little| strong="H4592" \w* \w moment| strong="H7281" \w*, \w until the indignation| strong="H2195" \w* [be overpast]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}. 
