\c 41
\p 
\v 1 [Keep silence]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8685”} [before me, O islands]{strong=“H339”}; \w and let the people| strong="H3816" \w* [renew]{strong=“H2498” x-morph=“strongMorph: \sc Th\sc*8686”} their \w strength| strong="H3581" \w*: [let them come near]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8799”}; [then let them speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}: [let us come near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} \w together| strong="H3162" \w* \w to judgment| strong="H4941" \w*. 
\v 2 [Who raised up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8689”} \w the righteous| strong="H6664" \w* man \w from the east| strong="H4217" \w*, [called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w him to his foot| strong="H7272" \w*, [gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w the nations| strong="H1471" \w* \w before| strong="H6440" \w* him, and made him [rule]{strong=“H7287” x-morph=“strongMorph: \sc Th\sc*8686”} \w over kings| strong="H4428" \w*? [he gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} them \w as the dust| strong="H6083" \w* \w to his sword| strong="H2719" \w*, and [as driven]{strong=“H5086” x-morph=“strongMorph: \sc Th\sc*8737”} \w stubble| strong="H7179" \w* \w to his bow| strong="H7198" \w*.\f + \fr 41:2 \ft the righteous…: Heb. righteousness \f* 
\v 3 [He pursued]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} them, and [passed]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w safely| strong="H7965" \w*; even \w by the way| strong="H734" \w* that [he had not gone]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w with his feet| strong="H7272" \w*.\f + \fr 41:3 \ft safely: Heb. in peace \f* 
\v 4 [Who hath wrought]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8804”} [and done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} it, [calling]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8802”} \w the generations| strong="H1755" \w* \w from the beginning| strong="H7218" \w*? I the \sc Lord\sc*, \w the first| strong="H7223" \w*, \w and with the last| strong="H314" \w*; I am he. 
\v 5 \w The isles| strong="H339" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} it, [and feared]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}; \w the ends| strong="H7098" \w* \w of the earth| strong="H776" \w* [were afraid]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8799”}, [drew near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8804”}, [and came]{strong=“H857” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 6 [They helped]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8799”} \w every one| strong="H376" \w* \w his neighbour| strong="H7453" \w*; and every one [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to his brother| strong="H251" \w*, [Be of good courage]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8798”}.\f + \fr 41:6 \ft Be…: Heb. Be strong \f* 
\v 7 \w So the carpenter| strong="H2796" \w* [encouraged]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8762”} [the goldsmith]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8802”}, and [he that smootheth]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8688”} with \w the hammer| strong="H6360" \w* [him that smote]{strong=“H1986” x-morph=“strongMorph: \sc Th\sc*8802”} \w the anvil| strong="H6471" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, It is \w ready| strong="H2896" \w* \w for the sodering| strong="H1694" \w*: [and he fastened]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8762”} \w it with nails| strong="H4548" \w*, that [it should not be moved]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 41:7 \ft goldsmith: or, founder \f* \f + \fr 41:7 \ft him…: or, the smiting \f* \f + \fr 41:7 \ft saying…: or, saying of the soder, It is good \f* 
\v 8 [But thou, Israel]{strong=“H3478”}, art \w my servant| strong="H5650" \w*, \w Jacob| strong="H3290" \w* [whom I have chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the seed| strong="H2233" \w* \w of Abraham| strong="H85" \w* [my friend]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 9 Thou [whom I have taken]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8689”} \w from the ends| strong="H7098" \w* \w of the earth| strong="H776" \w*, [and called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee from the chief men| strong="H678" \w* [thereof, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto thee, Thou art \w my servant| strong="H5650" \w*; [I have chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, and not cast thee away]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\p
\v 10 [Fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} thou not; for I am [with thee: be not dismayed]{strong=“H8159” x-morph=“strongMorph: \sc Th\sc*8691”}; for I am \w thy God| strong="H430" \w*: [I will strengthen]{strong=“H553” x-morph=“strongMorph: \sc Th\sc*8765”} [thee; yea, I will help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8804”} [thee; yea, I will uphold]{strong=“H8551” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee with the right hand| strong="H3225" \w* \w of my righteousness| strong="H6664" \w*. 
\v 11 [Behold, all they that were incensed]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8737”} [against thee shall be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} [and confounded]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8735”}: [they shall be as nothing; and they]{strong=“H582”} \w that strive| strong="H7379" \w* [with thee shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 41:11 \ft they that strive…: Heb. the men of thy strife \f* 
\v 12 [Thou shalt seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} [them, and shalt not find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} them, even \w them| strong="H582" \w* \w that contended| strong="H4695" \w* [with thee: they that war]{strong=“H4421”} [against thee shall be as nothing, and as a thing of nought]{strong=“H657”}.\f + \fr 41:12 \ft them that…: Heb. the men of thy contention \f* \f + \fr 41:12 \ft they…: Heb. the men of thy war \f* 
\v 13 For I the \sc Lord\sc* \w thy God| strong="H430" \w* [will hold]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8688”} \w thy right hand| strong="H3225" \w*, [saying ]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} [unto thee, Fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [not; I will help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8804”} thee. 
\v 14 [Fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [not, thou worm]{strong=“H8438”} \w Jacob| strong="H3290" \w*, and \w ye men| strong="H4962" \w* \w of Israel| strong="H3478" \w*; [I will help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [and thy redeemer]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”}, \w the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w*.\f + \fr 41:14 \ft men: or, few men \f* 
\v 15 [Behold, I will make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee a new| strong="H2319" \w* \w sharp| strong="H2742" \w* \w threshing| strong="H4173" \w* \w instrument having| strong="H1167" \w* \w teeth| strong="H6374" \w*: [thou shalt thresh]{strong=“H1758” x-morph=“strongMorph: \sc Th\sc*8799”} \w the mountains| strong="H2022" \w*, and beat them [small]{strong=“H1854” x-morph=“strongMorph: \sc Th\sc*8799”}, [and shalt make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w the hills| strong="H1389" \w* \w as chaff| strong="H4671" \w*.\f + \fr 41:15 \ft teeth: Heb. mouths \f* 
\v 16 [Thou shalt fan]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and the wind]{strong=“H7307”} [shall carry them away]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the whirlwind| strong="H5591" \w* [shall scatter]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8686”} [them: and thou shalt rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”} in the \sc Lord\sc*, and [shalt glory]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8691”} \w in the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w*. 
\v 17 When \w the poor| strong="H6041" \w* \w and needy| strong="H34" \w* [seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w water| strong="H4325" \w*, and there is none, and \w their tongue| strong="H3956" \w* [faileth ]{strong=“H5405” x-morph=“strongMorph: \sc Th\sc*8804”} \w for thirst| strong="H6772" \w*, I the \sc Lord\sc* [will hear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [them, I the God]{strong=“H430”} \w of Israel| strong="H3478" \w* [will not forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} them. 
\v 18 [I will open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} \w rivers| strong="H5104" \w* \w in high places| strong="H8205" \w*, \w and fountains| strong="H4599" \w* \w in the midst| strong="H8432" \w* \w of the valleys| strong="H1237" \w*: [I will make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w the wilderness| strong="H4057" \w* \w a pool| strong="H98" \w* \w of water| strong="H4325" \w*, \w and the dry| strong="H6723" \w* \w land| strong="H776" \w* \w springs| strong="H4161" \w* \w of water| strong="H4325" \w*. 
\v 19 [I will plant]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the wilderness| strong="H4057" \w* \w the cedar| strong="H730" \w*, \w the shittah tree| strong="H7848" \w*, \w and the myrtle| strong="H1918" \w*, \w and the oil| strong="H8081" \w* \w tree| strong="H6086" \w*; [I will set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the desert| strong="H6160" \w* \w the fir tree| strong="H1265" \w*, and \w the pine| strong="H8410" \w*, \w and the box tree| strong="H8391" \w* \w together| strong="H3162" \w*: 
\v 20 [That they may see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, [and know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”}, [and consider]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”}, [and understand]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8686”} \w together| strong="H3162" \w*, \w that the hand| strong="H3027" \w* of the \sc Lord\sc* [hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [this, and the Holy One]{strong=“H6918”} \w of Israel| strong="H3478" \w* [hath created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8804”} it. 
\p
\v 21 [Produce]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8761”} \w your cause| strong="H7379" \w*, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc*; [bring forth]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8685”} \w your strong| strong="H6110" \w* reasons, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w the King| strong="H4428" \w* \w of Jacob| strong="H3290" \w*.\f + \fr 41:21 \ft Produce: Heb. Cause to come near \f* 
\v 22 Let them bring them [forth]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8686”}, [and shew]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} [us what shall happen]{strong=“H7136” x-morph=“strongMorph: \sc Th\sc*8799”}: [let them shew]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”} \w the former things| strong="H7223" \w*, what they be, [that we may consider]{strong=“H3820 H7760” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w the latter end| strong="H319" \w* [of them; or declare]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8685”} [us things for to come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 41:22 \ft consider…: Heb. set our heart upon them \f* 
\v 23 [Shew]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”} [the things that are to come]{strong=“H857” x-morph=“strongMorph: \sc Th\sc*8802”} \w hereafter| strong="H268" \w*, [that we may know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} that ye are \w gods| strong="H430" \w*: [yea, do good]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8686”}, [or do evil]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8686”}, [that we may be dismayed]{strong=“H8159” x-morph=“strongMorph: \sc Th\sc*8691”}, [and behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} it \w together| strong="H3162" \w*. 
\v 24 Behold, ye are \w of nothing| strong="H369" \w*, \w and your work| strong="H6467" \w* \w of nought| strong="H659" \w*: \w an abomination| strong="H8441" \w* is he that [chooseth]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} you.\f + \fr 41:24 \ft of nothing: or, worse than nothing \f* \f + \fr 41:24 \ft of nought: or, worse than of a viper \f* 
\v 25 [I have raised up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8689”} one \w from the north| strong="H6828" \w*, [and he shall come]{strong=“H857” x-morph=“strongMorph: \sc Th\sc*8799”}: \w from the rising| strong="H4217" \w* \w of the sun| strong="H8121" \w* [shall he call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon my name| strong="H8034" \w*: [and he shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon princes| strong="H5461" \w* as upon \w morter| strong="H2563" \w*, [and as the potter]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} [treadeth]{strong=“H7429” x-morph=“strongMorph: \sc Th\sc*8799”} \w clay| strong="H2916" \w*. 
\v 26 [Who hath declared]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} \w from the beginning| strong="H7218" \w*, [that we may know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”}? \w and beforetime| strong="H6440" \w*, [that we may say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, He is \w righteous| strong="H6662" \w*? yea, there is [none that sheweth]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8688”}, yea, there is [none that declareth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8688”}, yea, there is [none that heareth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} \w your words| strong="H561" \w*. 
\v 27 \w The first| strong="H7223" \w* shall say \w to Zion| strong="H6726" \w*, \w Behold| strong="H2009" \w*, \w behold| strong="H2009" \w* [them: and I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Jerusalem| strong="H3389" \w* [one that bringeth good tidings]{strong=“H1319” x-morph=“strongMorph: \sc Th\sc*8764”}. 
\v 28 [For I beheld]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, and there was \w no man| strong="H376" \w*; even among them, and there was [no counsellor]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8802”}, [that, when I asked]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} [of them, could answer]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w a word| strong="H1697" \w*.\f + \fr 41:28 \ft answer: Heb. return \f* 
\v 29 Behold, they are \w all vanity| strong="H205" \w*; \w their works| strong="H4639" \w* are \w nothing| strong="H657" \w*: \w their molten images| strong="H5262" \w* are \w wind| strong="H7307" \w* \w and confusion| strong="H8414" \w*.
\c 42
\p 
\v 1 \w Behold my servant| strong="H5650" \w*, [whom I uphold]{strong=“H8551” x-morph=“strongMorph: \sc Th\sc*8799”}; \w mine elect| strong="H972" \w*, in whom \w my soul| strong="H5315" \w* [delighteth]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8804”}; [I have put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w my spirit| strong="H7307" \w* [upon him: he shall bring forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w judgment| strong="H4941" \w* \w to the Gentiles| strong="H1471" \w*. 
\v 2 [He shall not cry]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8799”}, [nor lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”}, \w nor cause his voice| strong="H6963" \w* [to be heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8686”} \w in the street| strong="H2351" \w*. 
\v 3 [A bruised]{strong=“H7533” x-morph=“strongMorph: \sc Th\sc*8803”} \w reed| strong="H7070" \w* [shall he not break]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the smoking| strong="H3544" \w* \w flax| strong="H6594" \w* [shall he not quench]{strong=“H3518” x-morph=“strongMorph: \sc Th\sc*8762”}: [he shall bring forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w judgment| strong="H4941" \w* \w unto truth| strong="H571" \w*.\f + \fr 42:3 \ft smoking: or, dimly burning \f* \f + \fr 42:3 \ft quench: Heb. quench it \f* 
\v 4 [He shall not fail]{strong=“H3543” x-morph=“strongMorph: \sc Th\sc*8799”} [nor be discouraged]{strong=“H7533” x-morph=“strongMorph: \sc Th\sc*8799”}, [till he have set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w judgment| strong="H4941" \w* \w in the earth| strong="H776" \w*: \w and the isles| strong="H339" \w* [shall wait]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8762”} \w for his law| strong="H8451" \w*.\f + \fr 42:4 \ft discouraged: Heb. broken \f* 
\p
\v 5 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w God| strong="H410" \w* the \sc Lord\sc*, [he that created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8802”} \w the heavens| strong="H8064" \w*, [and stretched them out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8802”}; [he that spread forth]{strong=“H7554” x-morph=“strongMorph: \sc Th\sc*8802”} \w the earth| strong="H776" \w*, \w and that which cometh out| strong="H6631" \w* [of it; he that giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w breath| strong="H5397" \w* \w unto the people| strong="H5971" \w* [upon it, and spirit]{strong=“H7307”} [to them that walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} therein: 
\v 6 I the \sc Lord\sc* [have called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee in righteousness| strong="H6664" \w*, [and will hold]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8686”} \w thine hand| strong="H3027" \w*, [and will keep]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8799”} [thee, and give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee for a covenant| strong="H1285" \w* \w of the people| strong="H5971" \w*, \w for a light| strong="H216" \w* \w of the Gentiles| strong="H1471" \w*; 
\v 7 [To open]{strong=“H6491” x-morph=“strongMorph: \sc Th\sc*8800”} \w the blind| strong="H5787" \w* \w eyes| strong="H5869" \w*, [to bring out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8687”} \w the prisoners| strong="H616" \w* \w from the prison| strong="H4525" \w*, and [them that sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in darkness| strong="H2822" \w* \w out of the prison| strong="H3608" \w* \w house| strong="H1004" \w*. 
\v 8 I am the \sc Lord\sc*: that is \w my name| strong="H8034" \w*: \w and my glory| strong="H3519" \w* [will I not give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w to another| strong="H312" \w*, \w neither my praise| strong="H8416" \w* \w to graven images| strong="H6456" \w*. 
\v 9 [Behold, the former things]{strong=“H7223”} [are come to pass]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and new things| strong="H2319" \w* [do I declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8688”}: [before they spring forth]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8799”} [I tell]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8686”} you of them. 
\v 10 [Sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8798”} unto the \sc Lord\sc* \w a new| strong="H2319" \w* \w song| strong="H7892" \w*, and \w his praise| strong="H8416" \w* \w from the end| strong="H7097" \w* \w of the earth| strong="H776" \w*, [ye that go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the sea| strong="H3220" \w*, \w and all that is therein| strong="H4393" \w*; \w the isles| strong="H339" \w*, [and the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} thereof.\f + \fr 42:10 \ft all…: Heb. the fulness thereof \f* 
\v 11 \w Let the wilderness| strong="H4057" \w* \w and the cities| strong="H5892" \w* [thereof lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} their voice, \w the villages| strong="H2691" \w* that \w Kedar| strong="H6938" \w* [doth inhabit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”}: [let the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the rock| strong="H5553" \w* [sing]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8799”}, [let them shout]{strong=“H6681” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the top| strong="H7218" \w* \w of the mountains| strong="H2022" \w*. 
\v 12 [Let them give]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w glory| strong="H3519" \w* unto the \sc Lord\sc*, [and declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w his praise| strong="H8416" \w* \w in the islands| strong="H339" \w*. 
\p
\v 13 The \sc Lord\sc* [shall go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w as a mighty man| strong="H1368" \w*, [he shall stir up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8686”} \w jealousy| strong="H7068" \w* \w like a man| strong="H376" \w* \w of war| strong="H4421" \w*: [he shall cry]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8686”}, [yea, roar]{strong=“H6873” x-morph=“strongMorph: \sc Th\sc*8686”}; [he shall prevail]{strong=“H1396” x-morph=“strongMorph: \sc Th\sc*8691”} [against his enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 42:13 \ft prevail: or, behave himself mightily \f* 
\v 14 \w I have long time| strong="H5769" \w* [holden my peace]{strong=“H2814” x-morph=“strongMorph: \sc Th\sc*8689”}; [I have been still]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8686”}, and [refrained]{strong=“H662” x-morph=“strongMorph: \sc Th\sc*8691”} myself: now [will I cry]{strong=“H6463” x-morph=“strongMorph: \sc Th\sc*8799”} [like a travailing woman]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”}; [I will destroy]{strong=“H8074 H5395” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8676 strongMorph: \sc Th\sc*8799”} [and devour]{strong=“H7602” x-morph=“strongMorph: \sc Th\sc*8799”} \w at once| strong="H3162" \w*.\f + \fr 42:14 \ft devour: Heb. swallow, or, sup up \f* 
\v 15 [I will make waste]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8686”} \w mountains| strong="H2022" \w* \w and hills| strong="H1389" \w*, [and dry up]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8686”} \w all their herbs| strong="H6212" \w*; [and I will make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w the rivers| strong="H5104" \w* \w islands| strong="H339" \w*, [and I will dry up]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8686”} \w the pools| strong="H98" \w*. 
\v 16 [And I will bring]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8689”} \w the blind| strong="H5787" \w* \w by a way| strong="H1870" \w* that [they knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [not; I will lead]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8686”} \w them in paths| strong="H5410" \w* that [they have not known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}: [I will make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w darkness| strong="H4285" \w* \w light| strong="H216" \w* \w before| strong="H6440" \w* [them, and crooked things]{strong=“H4625”} \w straight| strong="H4334" \w*. \w These things| strong="H1697" \w* [will I do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, and not forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} them.\f + \fr 42:16 \ft straight: Heb. into straightness \f* 
\p
\v 17 [They shall be turned]{strong=“H5472” x-morph=“strongMorph: \sc Th\sc*8738”} \w back| strong="H268" \w*, \w they shall be greatly| strong="H1322" \w* [ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}, [that trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”} \w in graven images| strong="H6459" \w*, [that say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the molten images| strong="H4541" \w*, Ye are \w our gods| strong="H430" \w*. 
\p
\v 18 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, \w ye deaf| strong="H2795" \w*; [and look]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8685”}, \w ye blind| strong="H5787" \w*, [that ye may see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 19 Who is \w blind| strong="H5787" \w*, \w but my servant| strong="H5650" \w*? \w or deaf| strong="H2795" \w*, \w as my messenger| strong="H4397" \w* that [I sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”}? who is \w blind| strong="H5787" \w* as he that is [perfect]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8794”}, \w and blind| strong="H5787" \w* as the \sc Lord\sc*’S \w servant| strong="H5650" \w*? 
\v 20 [Seeing]{strong=“H7200 H7200” x-morph=“strongMorph: \sc Th\sc*8804 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8800”} \w many things| strong="H7227" \w*, [but thou observest]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} [not; opening]{strong=“H6491” x-morph=“strongMorph: \sc Th\sc*8800”} \w the ears| strong="H241" \w*, [but he heareth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} not. 
\v 21 The \sc Lord\sc* [is well pleased]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} [for his righteousness’]{strong=“H6664”} [sake; he will magnify]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8686”} \w the law| strong="H8451" \w*, and make it [honourable]{strong=“H142” x-morph=“strongMorph: \sc Th\sc*8686”}.\f + \fr 42:21 \ft it: or, him \f* 
\v 22 But this is \w a people| strong="H5971" \w* [robbed]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8803”} [and spoiled]{strong=“H8154” x-morph=“strongMorph: \sc Th\sc*8803”}; they are [all of them snared]{strong=“H6351” x-morph=“strongMorph: \sc Th\sc*8687”} [in holes]{strong=“H970 H2352” x-morph=“strongMorph: \sc Th\sc*8676”}, [and they are hid]{strong=“H2244” x-morph=“strongMorph: \sc Th\sc*8717”} \w in prison| strong="H3608" \w* \w houses| strong="H1004" \w*: \w they are for a prey| strong="H957" \w*, [and none delivereth]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8688”}; \w for a spoil| strong="H4933" \w*, [and none saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, [Restore]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”}.\f + \fr 42:22 \ft they are all…: or, in snaring all the young men of them \f* \f + \fr 42:22 \ft for a spoil: Heb. a treading \f* 
\v 23 [Who among you will give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8686”} to this? who [will hearken]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8686”} [and hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w for the time to come| strong="H268" \w*?\f + \fr 42:23 \ft for…: Heb. for the after time? \f* 
\v 24 [Who gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w Jacob| strong="H3290" \w* [for a spoil]{strong=“H4882 H4933” x-morph=“strongMorph: \sc Th\sc*8675”}, \w and Israel| strong="H3478" \w* [to the robbers]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8802”}? did not the \sc Lord\sc*, \w he against whom| strong="H2098" \w* [we have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}? [for they would]{strong=“H14” x-morph=“strongMorph: \sc Th\sc*8804”} [not walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”} \w in his ways| strong="H1870" \w*, [neither were they obedient]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto his law| strong="H8451" \w*. 
\v 25 [Therefore he hath poured]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon him the fury| strong="H2534" \w* \w of his anger| strong="H639" \w*, \w and the strength| strong="H5807" \w* \w of battle| strong="H4421" \w*: [and it hath set him on fire]{strong=“H3857” x-morph=“strongMorph: \sc Th\sc*8762”} \w round about| strong="H5439" \w*, [yet he knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [not; and it burned]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8799”} [him, yet he laid]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} it \w not to heart| strong="H3820" \w*.
\c 43
\p 
\v 1 [But now thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* [that created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8802”} [thee, O Jacob]{strong=“H3290”}, [and he that formed]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} [thee, O Israel]{strong=“H3478”}, [Fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [not: for I have redeemed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, I have called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} thee \w by thy name| strong="H8034" \w*; thou art mine. 
\v 2 [When thou passest through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w the waters| strong="H4325" \w*, I will be [with thee; and through the rivers]{strong=“H5104”}, [they shall not overflow]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8799”} [thee: when thou walkest]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w through| strong="H1119" \w* \w the fire| strong="H784" \w*, [thou shalt not be burned]{strong=“H3554” x-morph=“strongMorph: \sc Th\sc*8735”}; \w neither shall the flame| strong="H3852" \w* [kindle]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8799”} upon thee. 
\v 3 For I am the \sc Lord\sc* \w thy God| strong="H430" \w*, \w the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w*, [thy Saviour]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8688”}: [I gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w Egypt| strong="H4714" \w* for \w thy ransom| strong="H3724" \w*, \w Ethiopia| strong="H3568" \w* \w and Seba| strong="H5434" \w* for thee. 
\v 4 [Since thou wast precious]{strong=“H3365” x-morph=“strongMorph: \sc Th\sc*8804”} \w in my sight| strong="H5869" \w*, [thou hast been honourable]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8738”}, [and I have loved]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} [thee: therefore will I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w men| strong="H120" \w* [for thee, and people]{strong=“H3816”} \w for thy life| strong="H5315" \w*.\f + \fr 43:4 \ft life: or, person \f* 
\v 5 [Fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} not: for I am [with thee: I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy seed| strong="H2233" \w* \w from the east| strong="H4217" \w*, [and gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8762”} \w thee from the west| strong="H4628" \w*; 
\v 6 [I will say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the north| strong="H6828" \w*, [Give up]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8798”}; \w and to the south| strong="H8486" \w*, [Keep not back]{strong=“H3607” x-morph=“strongMorph: \sc Th\sc*8799”}: [bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8685”} \w my sons| strong="H1121" \w* \w from far| strong="H7350" \w*, \w and my daughters| strong="H1323" \w* \w from the ends| strong="H7097" \w* \w of the earth| strong="H776" \w*; 
\v 7 Even \w every one| strong="H3605" \w* [that is called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8737”} \w by my name| strong="H8034" \w*: [for I have created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8804”} \w him for my glory| strong="H3519" \w*, [I have formed]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8804”} [him; yea, I have made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} him. 
\p
\v 8 [Bring forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8685”} \w the blind| strong="H5787" \w* \w people| strong="H5971" \w* \w that have| strong="H3426" \w* \w eyes| strong="H5869" \w*, \w and the deaf| strong="H2795" \w* \w that have ears| strong="H241" \w*. 
\v 9 \w Let all the nations| strong="H1471" \w* [be gathered]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8738”} \w together| strong="H3162" \w*, \w and let the people| strong="H3816" \w* [be assembled]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8735”}: [who among them can declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} [this, and shew]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8686”} \w us former things| strong="H7223" \w*? [let them bring forth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w their witnesses| strong="H5707" \w*, [that they may be justified]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8799”}: [or let them hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, It is \w truth| strong="H571" \w*. 
\v 10 Ye are \w my witnesses| strong="H5707" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, \w and my servant| strong="H5650" \w* [whom I have chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”}: [that ye may know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [and believe]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”} [me, and understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} that I am [he: before]{strong=“H6440”} \w me there was no God| strong="H410" \w* [formed]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8738”}, \w neither shall there be after| strong="H310" \w* me.\f + \fr 43:10 \ft no…: or, nothing formed of God \f* 
\v 11 I, even I, am the \sc Lord\sc*; \w and beside| strong="H1107" \w* me there is [no saviour]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 12 [I have declared]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”}, [and have saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8689”}, [and I have shewed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8689”}, when there was [no strange]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} god among you: therefore ye are \w my witnesses| strong="H5707" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, that I am \w God| strong="H410" \w*. 
\v 13 [Yea, before the day]{strong=“H3117”} was I am he; and there is [none that can deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8688”} \w out of my hand| strong="H3027" \w*: [I will work]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8799”}, [and who shall let]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} it?\f + \fr 43:13 \ft let it: Heb. turn it back? \f* 
\p
\v 14 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [your redeemer]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”}, \w the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w*; [For your sake I have sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w to Babylon| strong="H894" \w*, [and have brought down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8689”} \w all their nobles| strong="H1281" \w*, \w and the Chaldeans| strong="H3778" \w*, \w whose cry| strong="H7440" \w* is \w in the ships| strong="H591" \w*.\f + \fr 43:14 \ft nobles: Heb. bars \f* 
\v 15 I am the \sc Lord\sc*, \w your Holy One| strong="H6918" \w*, [the creator]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Israel| strong="H3478" \w*, \w your King| strong="H4428" \w*. 
\v 16 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [which maketh]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w a way| strong="H1870" \w* \w in the sea| strong="H3220" \w*, \w and a path| strong="H5410" \w* \w in the mighty| strong="H5794" \w* \w waters| strong="H4325" \w*; 
\v 17 [Which bringeth forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8688”} \w the chariot| strong="H7393" \w* \w and horse| strong="H5483" \w*, \w the army| strong="H2428" \w* \w and the power| strong="H5808" \w*; [they shall lie down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w together| strong="H3162" \w*, [they shall not rise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}: [they are extinct]{strong=“H1846” x-morph=“strongMorph: \sc Th\sc*8804”}, [they are quenched]{strong=“H3518” x-morph=“strongMorph: \sc Th\sc*8804”} \w as tow| strong="H6594" \w*. 
\p
\v 18 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w ye not the former things| strong="H7223" \w*, [neither consider]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8709”} \w the things of old| strong="H6931" \w*. 
\v 19 [Behold, I will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w a new thing| strong="H2319" \w*; [now it shall spring forth]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8799”}; [shall ye not know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [it? I will even make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w a way| strong="H1870" \w* \w in the wilderness| strong="H4057" \w*, and \w rivers| strong="H5104" \w* \w in the desert| strong="H3452" \w*. 
\v 20 \w The beast| strong="H2416" \w* \w of the field| strong="H7704" \w* [shall honour]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8762”} [me, the dragons]{strong=“H8577”} [and the owls]{strong=“H3284 H1323”}: [because I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w waters| strong="H4325" \w* \w in the wilderness| strong="H4057" \w*, and \w rivers| strong="H5104" \w* \w in the desert| strong="H3452" \w*, [to give drink]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8687”} \w to my people| strong="H5971" \w*, \w my chosen| strong="H972" \w*.\f + \fr 43:20 \ft owls: or, ostriches: Heb. daughters of the owl \f* 
\v 21 \w This| strong="H2098" \w* \w people| strong="H5971" \w* [have I formed]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8804”} [for myself; they shall shew forth]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} \w my praise| strong="H8416" \w*. 
\p
\v 22 [But thou hast not called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [upon me, O Jacob]{strong=“H3290”}; [but thou hast been weary]{strong=“H3021” x-morph=“strongMorph: \sc Th\sc*8804”} [of me, O Israel]{strong=“H3478”}. 
\v 23 [Thou hast not brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w me the small cattle| strong="H7716" \w* \w of thy burnt offerings| strong="H5930" \w*; [neither hast thou honoured]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8765”} \w me with thy sacrifices| strong="H2077" \w*. [I have not caused thee to serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8689”} \w with an offering| strong="H4503" \w*, [nor wearied]{strong=“H3021” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee with incense| strong="H3828" \w*.\f + \fr 43:23 \ft small…: Heb. lambs, or, kids \f* 
\v 24 [Thou hast bought]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8804”} \w me no sweet cane| strong="H7070" \w* \w with money| strong="H3701" \w*, [neither hast thou filled]{strong=“H7301” x-morph=“strongMorph: \sc Th\sc*8689”} \w me with the fat| strong="H2459" \w* \w of thy sacrifices| strong="H2077" \w*: [but thou hast made me to serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8689”} \w with thy sins| strong="H2403" \w*, [thou hast wearied]{strong=“H3021” x-morph=“strongMorph: \sc Th\sc*8689”} \w me with thine iniquities| strong="H5771" \w*.\f + \fr 43:24 \ft filled…: Heb. made me drunk, or, abundantly moistened \f* 
\v 25 I, even I, am [he that blotteth out]{strong=“H4229” x-morph=“strongMorph: \sc Th\sc*8802”} \w thy transgressions| strong="H6588" \w* [for mine own sake, and will not remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy sins| strong="H2403" \w*. 
\v 26 [Put me in remembrance]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8685”}: [let us plead]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8735”} \w together| strong="H3162" \w*: [declare]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8761”} [thou, that thou mayest be justified]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 27 \w Thy first| strong="H7223" \w* \w father| strong="H1" \w* [hath sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}, [and thy teachers]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8688”} [have transgressed]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8804”} against me.\f + \fr 43:27 \ft teachers: Heb. interpreters \f* 
\v 28 [Therefore I have profaned]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8762”} \w the princes| strong="H8269" \w* \w of the sanctuary| strong="H6944" \w*, [and have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jacob| strong="H3290" \w* \w to the curse| strong="H2764" \w*, \w and Israel| strong="H3478" \w* \w to reproaches| strong="H1421" \w*.\f + \fr 43:28 \ft princes…: or, holy princes \f*
\c 44
\p 
\v 1 [Yet now hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O Jacob| strong="H3290" \w* \w my servant| strong="H5650" \w*; \w and Israel| strong="H3478" \w*, [whom I have chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”}: 
\v 2 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* [that made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} [thee, and formed]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w thee from the womb| strong="H990" \w*, which [will help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8799”} [thee; Fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [not, O Jacob]{strong=“H3290”}, \w my servant| strong="H5650" \w*; [and thou, Jesurun]{strong=“H3484”}, [whom I have chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 3 [For I will pour]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8799”} \w water| strong="H4325" \w* \w upon him that is thirsty| strong="H6771" \w*, [and floods]{strong=“H5140” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the dry ground| strong="H3004" \w*: [I will pour]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8799”} \w my spirit| strong="H7307" \w* \w upon thy seed| strong="H2233" \w*, \w and my blessing| strong="H1293" \w* \w upon thine offspring| strong="H6631" \w*: 
\v 4 [And they shall spring up]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8804”} as \w among| strong="H996" \w* \w the grass| strong="H2682" \w*, \w as willows| strong="H6155" \w* \w by the water| strong="H4325" \w* \w courses| strong="H2988" \w*. 
\v 5 [One shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, I am the \sc Lord\sc*’S; [and another shall call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} himself \w by the name| strong="H8034" \w* \w of Jacob| strong="H3290" \w*; [and another shall subscribe]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8799”} with \w his hand| strong="H3027" \w* unto the \sc Lord\sc*, [and surname]{strong=“H3655” x-morph=“strongMorph: \sc Th\sc*8762”} himself \w by the name| strong="H8034" \w* \w of Israel| strong="H3478" \w*. 
\v 6 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w the King| strong="H4428" \w* \w of Israel| strong="H3478" \w*, [and his redeemer]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*; I am \w the first| strong="H7223" \w*, and I am \w the last| strong="H314" \w*; \w and beside| strong="H1107" \w* me there is \w no God| strong="H430" \w*. 
\v 7 [And who, as I, shall call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”}, [and shall declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} [it, and set it in order]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8799”} [for me, since I appointed]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w the ancient| strong="H5769" \w* \w people| strong="H5971" \w*? [and the things that are coming]{strong=“H857” x-morph=“strongMorph: \sc Th\sc*8802”}, [and shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [let them shew]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} unto them. 
\v 8 [Fear]{strong=“H6342” x-morph=“strongMorph: \sc Th\sc*8799”} [ye not, neither be afraid]{strong=“H7297 H7297” x-morph=“strongMorph: \sc Th\sc*8804 strongMorph: \sc Th\sc*8676 strongMorph: \sc Th\sc*8799”}: [have not I told]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee from that time| strong="H227" \w*, [and have declared]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} it? ye are \w even my witnesses| strong="H5707" \w*. \w Is there| strong="H3426" \w* \w a God| strong="H433" \w* \w beside| strong="H1107" \w* me? yea, there is \w no God| strong="H6697" \w*; [I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} not any.\f + \fr 44:8 \ft God; I: Heb. rock, etc \f* 
\p
\v 9 [They that make]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w a graven image| strong="H6459" \w* are \w all of them vanity| strong="H8414" \w*; [and their delectable things]{strong=“H2530” x-morph=“strongMorph: \sc Th\sc*8803”} [shall not profit]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8686”}; and they are \w their own witnesses| strong="H5707" \w*; [they see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [not, nor know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”}; [that they may be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 44:9 \ft delectable: Heb. desirable \f* 
\v 10 [Who hath formed]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8804”} \w a god| strong="H410" \w*, [or molten]{strong=“H5258” x-morph=“strongMorph: \sc Th\sc*8804”} \w a graven image| strong="H6459" \w* that [is profitable]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8687”} \w for nothing| strong="H1115" \w*? 
\v 11 [Behold, all his fellows]{strong=“H2270”} [shall be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}: \w and the workmen| strong="H2796" \w*, they are \w of men| strong="H120" \w*: [let them all be gathered together]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8691”}, [let them stand up]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”}; yet [they shall fear]{strong=“H6342” x-morph=“strongMorph: \sc Th\sc*8799”}, and [they shall be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} \w together| strong="H3162" \w*. 
\v 12 [The smith]{strong=“H2796 H1270”} \w with the tongs| strong="H4621" \w* [both worketh]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the coals| strong="H6352" \w*, [and fashioneth]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8799”} \w it with hammers| strong="H4717" \w*, [and worketh]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8799”} \w it with the strength| strong="H3581" \w* \w of his arms| strong="H2220" \w*: [yea, he is hungry]{strong=“H7457”}, \w and his strength| strong="H3581" \w* \w faileth| strong="H369" \w*: [he drinketh]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8804”} \w no water| strong="H4325" \w*, [and is faint]{strong=“H3286” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 44:12 \ft with the tongs: or, with an axe \f* 
\v 13 [The carpenter]{strong=“H6086 H2796”} [stretcheth out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} his \w rule| strong="H6957" \w*; [he marketh it out]{strong=“H8388” x-morph=“strongMorph: \sc Th\sc*8762”} \w with a line| strong="H8279" \w*; [he fitteth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w it with planes| strong="H4741" \w*, [and he marketh it out]{strong=“H8388” x-morph=“strongMorph: \sc Th\sc*8762”} \w with the compass| strong="H4230" \w*, [and maketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w it after the figure| strong="H8403" \w* \w of a man| strong="H376" \w*, \w according to the beauty| strong="H8597" \w* \w of a man| strong="H120" \w*; [that it may remain]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the house| strong="H1004" \w*. 
\v 14 [He heweth him down]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8800”} \w cedars| strong="H730" \w*, [and taketh]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the cypress| strong="H8645" \w* \w and the oak| strong="H437" \w*, [which he strengtheneth]{strong=“H553” x-morph=“strongMorph: \sc Th\sc*8762”} \w for himself among the trees| strong="H6086" \w* \w of the forest| strong="H3293" \w*: [he planteth]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8804”} \w an ash| strong="H766" \w*, \w and the rain| strong="H1653" \w* [doth nourish]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8762”} it.\f + \fr 44:14 \ft strengtheneth: or, taketh courage \f* 
\v 15 \w Then shall it be for a man| strong="H120" \w* [to burn]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8763”}: [for he will take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [thereof, and warm]{strong=“H2552” x-morph=“strongMorph: \sc Th\sc*8799”} [himself; yea, he kindleth]{strong=“H5400” x-morph=“strongMorph: \sc Th\sc*8686”} it, [and baketh]{strong=“H644” x-morph=“strongMorph: \sc Th\sc*8804”} \w bread| strong="H3899" \w*; [yea, he maketh]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8799”} \w a god| strong="H410" \w*, [and worshippeth]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} it; [he maketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w it a graven image| strong="H6459" \w*, [and falleth down]{strong=“H5456” x-morph=“strongMorph: \sc Th\sc*8799”} thereto. 
\v 16 [He burneth]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8804”} \w part| strong="H2677" \w* \w thereof in| strong="H1119" \w* \w the fire| strong="H784" \w*; \w with part| strong="H2677" \w* [thereof he eateth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w flesh| strong="H1320" \w*; [he roasteth]{strong=“H6740” x-morph=“strongMorph: \sc Th\sc*8799”} \w roast| strong="H6748" \w*, [and is satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”}: [yea, he warmeth]{strong=“H2552” x-morph=“strongMorph: \sc Th\sc*8799”} himself, [and saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Aha| strong="H1889" \w*, [I am warm]{strong=“H2552” x-morph=“strongMorph: \sc Th\sc*8804”}, [I have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the fire| strong="H217" \w*: 
\v 17 \w And the residue| strong="H7611" \w* [thereof he maketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w a god| strong="H410" \w*, even \w his graven image| strong="H6459" \w*: [he falleth down]{strong=“H5456” x-morph=“strongMorph: \sc Th\sc*8799”} [unto it, and worshippeth]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} it, [and prayeth]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8691”} [unto it, and saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8685”} me; for thou art \w my god| strong="H410" \w*. 
\v 18 [They have not known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [nor understood]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”}: [for he hath shut]{strong=“H2902” x-morph=“strongMorph: \sc Th\sc*8804”} \w their eyes| strong="H5869" \w*, [that they cannot see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”}; and \w their hearts| strong="H3826" \w*, [that they cannot understand]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8687”}.\f + \fr 44:18 \ft shut: Heb. daubed \f* 
\v 19 [And none considereth]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w in his heart| strong="H3820" \w*, neither is there \w knowledge| strong="H1847" \w* \w nor understanding| strong="H8394" \w* [to say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [I have burned]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8804”} \w part| strong="H2677" \w* \w of it in| strong="H1119" \w* \w the fire| strong="H784" \w*; [yea, also I have baked]{strong=“H644” x-morph=“strongMorph: \sc Th\sc*8804”} \w bread| strong="H3899" \w* \w upon the coals| strong="H1513" \w* [thereof; I have roasted]{strong=“H6740” x-morph=“strongMorph: \sc Th\sc*8799”} \w flesh| strong="H1320" \w*, [and eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} it: [and shall I make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w the residue| strong="H3499" \w* \w thereof an abomination| strong="H8441" \w*? [shall I fall down]{strong=“H5456” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the stock| strong="H944" \w* \w of a tree| strong="H6086" \w*?\f + \fr 44:19 \ft considereth…: Heb. setteth to his heart \f* \f + \fr 44:19 \ft the stock…: Heb. that which comes of a tree? \f* 
\v 20 [He feedeth]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} \w on ashes| strong="H665" \w*: [a deceived]{strong=“H2048” x-morph=“strongMorph: \sc Th\sc*8795”} \w heart| strong="H3820" \w* [hath turned him aside]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8689”}, [that he cannot deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w his soul| strong="H5315" \w*, [nor say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Is there \w not a lie| strong="H8267" \w* \w in my right hand| strong="H3225" \w*? 
\p
\v 21 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”} [these, O Jacob]{strong=“H3290”} \w and Israel| strong="H3478" \w*; for thou art \w my servant| strong="H5650" \w*: [I have formed]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8804”} thee; thou art \w my servant| strong="H5650" \w*: \w O Israel| strong="H3478" \w*, [thou shalt not be forgotten]{strong=“H5382” x-morph=“strongMorph: \sc Th\sc*8735”} of me. 
\v 22 [I have blotted out]{strong=“H4229” x-morph=“strongMorph: \sc Th\sc*8804”}, \w as a thick cloud| strong="H5645" \w*, \w thy transgressions| strong="H6588" \w*, [and, as a cloud]{strong=“H6051”}, \w thy sins| strong="H2403" \w*: [return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me; for I have redeemed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8804”} thee. 
\v 23 [Sing]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O ye heavens| strong="H8064" \w*; for the \sc Lord\sc* [hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} it: [shout]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8685”}, \w ye lower parts| strong="H8482" \w* \w of the earth| strong="H776" \w*: [break forth]{strong=“H6476” x-morph=“strongMorph: \sc Th\sc*8798”} \w into singing| strong="H7440" \w*, \w ye mountains| strong="H2022" \w*, \w O forest| strong="H3293" \w*, \w and every tree| strong="H6086" \w* therein: for the \sc Lord\sc* [hath redeemed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8804”} \w Jacob| strong="H3290" \w*, [and glorified]{strong=“H6286” x-morph=“strongMorph: \sc Th\sc*8691”} \w himself in Israel| strong="H3478" \w*. 
\v 24 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [thy redeemer]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”}, [and he that formed]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w thee from the womb| strong="H990" \w*, I am the \sc Lord\sc* [that maketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} all things; [that stretcheth forth]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8802”} \w the heavens| strong="H8064" \w* [alone; that spreadeth abroad]{strong=“H7554” x-morph=“strongMorph: \sc Th\sc*8802”} \w the earth| strong="H776" \w* by myself; 
\v 25 [That frustrateth]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8688”} \w the tokens| strong="H226" \w* \w of the liars| strong="H907" \w*, [and maketh diviners]{strong=“H7080” x-morph=“strongMorph: \sc Th\sc*8802”} [mad]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8779”}; [that turneth]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8688”} \w wise| strong="H2450" \w* men \w backward| strong="H268" \w*, \w and maketh their knowledge| strong="H1847" \w* [foolish]{strong=“H5528” x-morph=“strongMorph: \sc Th\sc*8762”}; 
\v 26 [That confirmeth]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8688”} \w the word| strong="H1697" \w* \w of his servant| strong="H5650" \w*, [and performeth]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8686”} \w the counsel| strong="H6098" \w* \w of his messengers| strong="H4397" \w*; [that saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} \w to Jerusalem| strong="H3389" \w*, [Thou shalt be inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8714”}; \w and to the cities| strong="H5892" \w* \w of Judah| strong="H3063" \w*, [Ye shall be built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8735”}, [and I will raise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8787”} \w the decayed places| strong="H2723" \w* thereof:\f + \fr 44:26 \ft decayed…: Heb. wastes \f* 
\v 27 [That saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the deep| strong="H6683" \w*, [Be dry]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8798”}, [and I will dry up]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy rivers| strong="H5104" \w*: 
\v 28 [That saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Cyrus| strong="H3566" \w*, He is [my shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}, [and shall perform]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8686”} \w all my pleasure| strong="H2656" \w*: [even saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} \w to Jerusalem| strong="H3389" \w*, [Thou shalt be built]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8735”}; \w and to the temple| strong="H1964" \w*, [Thy foundation shall be laid]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8735”}.
\c 45
\p 
\v 1 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w to his anointed| strong="H4899" \w*, \w to Cyrus| strong="H3566" \w*, \w whose right hand| strong="H3225" \w* [I have holden]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8689”}, [to subdue]{strong=“H7286” x-morph=“strongMorph: \sc Th\sc*8800”} \w nations| strong="H1471" \w* \w before| strong="H6440" \w* [him; and I will loose]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8762”} \w the loins| strong="H4975" \w* \w of kings| strong="H4428" \w*, [to open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8800”} \w before| strong="H6440" \w* \w him the two leaved gates| strong="H1817" \w*; \w and the gates| strong="H8179" \w* [shall not be shut]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8735”};\f + \fr 45:1 \ft have…: or, strengthened \f* 
\v 2 [I will go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* [thee, and make]{strong=“H3474”} [the crooked places]{strong=“H1921” x-morph=“strongMorph: \sc Th\sc*8803”} [straight]{strong=“H3474 H3474” x-morph=“strongMorph: \sc Th\sc*8686 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8762”}: [I will break in pieces]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8762”} \w the gates| strong="H1817" \w* \w of brass| strong="H5154" \w*, [and cut in sunder]{strong=“H1438” x-morph=“strongMorph: \sc Th\sc*8762”} \w the bars| strong="H1280" \w* \w of iron| strong="H1270" \w*: 
\v 3 [And I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee the treasures| strong="H214" \w* \w of darkness| strong="H2822" \w*, \w and hidden riches| strong="H4301" \w* \w of secret places| strong="H4565" \w*, [that thou mayest know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} that I, the \sc Lord\sc*, [which call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8802”} thee \w by thy name| strong="H8034" \w*, am \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*. 
\v 4 \w For Jacob| strong="H3290" \w* [my servant’s]{strong=“H5650”} [sake, and Israel]{strong=“H3478”} \w mine elect| strong="H972" \w*, [I have even called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee by thy name| strong="H8034" \w*: [I have surnamed]{strong=“H3655” x-morph=“strongMorph: \sc Th\sc*8762”} [thee, though thou hast not known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} me. 
\p
\v 5 I am the \sc Lord\sc*, and there is none else, there is \w no God| strong="H430" \w* \w beside| strong="H2108" \w* [me: I girded]{strong=“H247” x-morph=“strongMorph: \sc Th\sc*8762”} [thee, though thou hast not known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} me: 
\v 6 [That they may know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the rising| strong="H4217" \w* \w of the sun| strong="H8121" \w*, \w and from the west| strong="H4628" \w*, that there is \w none| strong="H657" \w* \w beside| strong="H1107" \w* me. I am the \sc Lord\sc*, and there is none else. 
\v 7 [I form]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w the light| strong="H216" \w*, [and create]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8802”} \w darkness| strong="H2822" \w*: [I make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w peace| strong="H7965" \w*, [and create]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8802”} \w evil| strong="H7451" \w*: I the \sc Lord\sc* [do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} all these things. 
\v 8 [Drop down]{strong=“H7491” x-morph=“strongMorph: \sc Th\sc*8685”}, \w ye heavens| strong="H8064" \w*, \w from above| strong="H4605" \w*, \w and let the skies| strong="H7834" \w* [pour down]{strong=“H5140” x-morph=“strongMorph: \sc Th\sc*8799”} \w righteousness| strong="H6664" \w*: \w let the earth| strong="H776" \w* [open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”}, [and let them bring forth]{strong=“H6509” x-morph=“strongMorph: \sc Th\sc*8799”} \w salvation| strong="H3468" \w*, \w and let righteousness| strong="H6666" \w* [spring up]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8686”} \w together| strong="H3162" \w*; I the \sc Lord\sc* [have created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8804”} it. 
\v 9 \w Woe| strong="H1945" \w* [unto him that striveth]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8801”} [with his Maker]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”}! Let \w the potsherd| strong="H2789" \w* strive \w with the potsherds| strong="H2789" \w* \w of the earth| strong="H127" \w*. \w Shall the clay| strong="H2563" \w* [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [to him that fashioneth]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} [it, What makest]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [thou? or thy work]{strong=“H6467”}, \w He hath no hands| strong="H3027" \w*? 
\v 10 \w Woe| strong="H1945" \w* [unto him that saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} unto his \w father| strong="H1" \w*, [What begettest]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8686”} [thou? or to the woman]{strong=“H802”}, [What hast thou brought forth]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8799”}? 
\p
\v 11 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w*, [and his Maker]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”}, [Ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8798”} [me of things to come]{strong=“H857” x-morph=“strongMorph: \sc Th\sc*8802”} \w concerning my sons| strong="H1121" \w*, \w and concerning the work| strong="H6467" \w* \w of my hands| strong="H3027" \w* [command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} ye me. 
\v 12 [I have made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w the earth| strong="H776" \w*, [and created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8804”} \w man| strong="H120" \w* upon it: I, even \w my hands| strong="H3027" \w*, [have stretched out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} \w the heavens| strong="H8064" \w*, \w and all their host| strong="H6635" \w* [have I commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 13 [I have raised him up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8689”} \w in righteousness| strong="H6664" \w*, [and I will direct]{strong=“H3474” x-morph=“strongMorph: \sc Th\sc*8762”} \w all his ways| strong="H1870" \w*: [he shall build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} \w my city| strong="H5892" \w*, [and he shall let go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w my captives| strong="H1546" \w*, \w not for price| strong="H4242" \w* \w nor reward| strong="H7810" \w*, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*.\f + \fr 45:13 \ft direct: or, make straight \f* 
\v 14 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w The labour| strong="H3018" \w* \w of Egypt| strong="H4714" \w*, \w and merchandise| strong="H5505" \w* \w of Ethiopia| strong="H3568" \w* \w and of the Sabeans| strong="H5436" \w*, \w men| strong="H582" \w* \w of stature| strong="H4060" \w*, [shall come over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee, and they shall be thine: they shall come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* [thee; in chains]{strong=“H2131”} [they shall come over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}, [and they shall fall down]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} [unto thee, they shall make supplication]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8691”} unto thee, saying, \w Surely God| strong="H410" \w* is in thee; and there is none else, there is \w no| strong="H657" \w* \w God| strong="H430" \w*. 
\v 15 \w Verily| strong="H403" \w* thou art \w a God| strong="H410" \w* [that hidest]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8693”} [thyself, O God]{strong=“H430”} \w of Israel| strong="H3478" \w*, [the Saviour]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 16 [They shall be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8804”}, [and also confounded]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8738”}, [all of them: they shall go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w to confusion| strong="H3639" \w* \w together| strong="H3162" \w* that are \w makers| strong="H2796" \w* \w of idols| strong="H6736" \w*. 
\v 17 But \w Israel| strong="H3478" \w* [shall be saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8738”} in the \sc Lord\sc* \w with an everlasting| strong="H5769" \w* \w salvation| strong="H8668" \w*: [ye shall not be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} [nor confounded]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8735”} \w world| strong="H5769" \w* \w without end| strong="H5703" \w*. 
\v 18 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* [that created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8802”} \w the heavens| strong="H8064" \w*; \w God| strong="H430" \w* [himself that formed]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w the earth| strong="H776" \w* [and made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} [it; he hath established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8790”} [it, he created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8804”} \w it not in vain| strong="H8414" \w*, [he formed]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8804”} [it to be inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”}: I am the \sc Lord\sc*; and there is none else. 
\v 19 [I have not spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w in secret| strong="H5643" \w*, \w in a dark| strong="H2822" \w* \w place| strong="H4725" \w* \w of the earth| strong="H776" \w*: [I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w not unto the seed| strong="H2233" \w* \w of Jacob| strong="H3290" \w*, [Seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8761”} \w ye me in vain| strong="H8414" \w*: I the \sc Lord\sc* [speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} \w righteousness| strong="H6664" \w*, [I declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8688”} \w things that are right| strong="H4339" \w*. 
\p
\v 20 [Assemble]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8734”} [yourselves and come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”}; [draw near]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8690”} \w together| strong="H3162" \w*, ye that are \w escaped| strong="H6412" \w* \w of the nations| strong="H1471" \w*: [they have no knowledge]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [that set up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8802”} \w the wood| strong="H6086" \w* \w of their graven image| strong="H6459" \w*, [and pray]{strong=“H6419” x-morph=“strongMorph: \sc Th\sc*8693”} \w unto a god| strong="H410" \w* that [cannot save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 21 [Tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”} ye, and bring them [near]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8685”}; [yea, let them take counsel]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8735”} \w together| strong="H3162" \w*: [who hath declared]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8689”} \w this from ancient time| strong="H6924" \w*? who [hath told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} it from that time? have not I the \sc Lord\sc*? and there is \w no God| strong="H430" \w* \w else beside| strong="H1107" \w* [me; a just]{strong=“H6662”} \w God| strong="H410" \w* [and a Saviour]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8688”}; there is \w none| strong="H369" \w* \w beside| strong="H2108" \w* me. 
\v 22 [Look]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me, and be ye saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8734”}, \w all the ends| strong="H657" \w* \w of the earth| strong="H776" \w*: for I am \w God| strong="H410" \w*, and there is none else. 
\v 23 [I have sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} [by myself, the word]{strong=“H1697”} [is gone out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w of my mouth| strong="H6310" \w* in \w righteousness| strong="H6666" \w*, [and shall not return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, \w That unto me every knee| strong="H1290" \w* [shall bow]{strong=“H3766” x-morph=“strongMorph: \sc Th\sc*8799”}, \w every tongue| strong="H3956" \w* [shall swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 24 Surely, shall one [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, in the \sc Lord\sc* \w have I righteousness| strong="H6666" \w* \w and strength| strong="H5797" \w*: even to him shall men [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}; [and all that are incensed]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8737”} [against him shall be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}.^\sc 45:24 Surely…: or, Surely he shall say of me, In the [Lord\sc* is all righteousness and strength] \f + \fr 45:24 \ft righteousness: Heb. righteousnesses \f* 
\v 25 In the \sc Lord\sc* \w shall all the seed| strong="H2233" \w* \w of Israel| strong="H3478" \w* [be justified]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8799”}, [and shall glory]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8691”}.
\c 46
\p 
\v 1 \w Bel| strong="H1078" \w* [boweth down]{strong=“H3766” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Nebo| strong="H5015" \w* [stoopeth]{strong=“H7164” x-morph=“strongMorph: \sc Th\sc*8802”}, \w their idols| strong="H6091" \w* \w were upon the beasts| strong="H2416" \w*, \w and upon the cattle| strong="H929" \w*: \w your carriages| strong="H5385" \w* were [heavy loaden]{strong=“H6006” x-morph=“strongMorph: \sc Th\sc*8803”}; they are \w a burden| strong="H4853" \w* \w to the weary| strong="H5889" \w* beast. 
\v 2 [They stoop]{strong=“H7164” x-morph=“strongMorph: \sc Th\sc*8804”}, [they bow down]{strong=“H3766” x-morph=“strongMorph: \sc Th\sc*8804”} \w together| strong="H3162" \w*; [they could]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8804”} [not deliver]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8763”} \w the burden| strong="H4853" \w*, \w but themselves| strong="H5315" \w* [are gone]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w into captivity| strong="H7628" \w*.\f + \fr 46:2 \ft themselves: Heb. their soul \f* 
\p
\v 3 [Hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me, O house]{strong=“H1004”} \w of Jacob| strong="H3290" \w*, \w and all the remnant| strong="H7611" \w* \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, [which are borne]{strong=“H6006” x-morph=“strongMorph: \sc Th\sc*8803”} by me \w from the belly| strong="H990" \w*, [which are carried]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8803”} \w from the womb| strong="H7356" \w*: 
\v 4 And even to your \w old age| strong="H2209" \w* I am he; and even \w to hoar hairs| strong="H7872" \w* [will I carry]{strong=“H5445” x-morph=“strongMorph: \sc Th\sc*8799”} you: [I have made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [and I will bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”}; [even I will carry]{strong=“H5445” x-morph=“strongMorph: \sc Th\sc*8799”}, [and will deliver]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8762”} you. 
\p
\v 5 [To whom will ye liken]{strong=“H1819” x-morph=“strongMorph: \sc Th\sc*8762”} me, and make me [equal]{strong=“H7737” x-morph=“strongMorph: \sc Th\sc*8686”}, [and compare]{strong=“H4911” x-morph=“strongMorph: \sc Th\sc*8686”} [me, that we may be like]{strong=“H1819” x-morph=“strongMorph: \sc Th\sc*8799”}? 
\v 6 [They lavish]{strong=“H2107” x-morph=“strongMorph: \sc Th\sc*8801”} \w gold| strong="H2091" \w* \w out of the bag| strong="H3599" \w*, [and weigh]{strong=“H8254” x-morph=“strongMorph: \sc Th\sc*8799”} \w silver| strong="H3701" \w* \w in the balance| strong="H7070" \w*, and [hire]{strong=“H7936” x-morph=“strongMorph: \sc Th\sc*8799”} [a goldsmith]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8802”}; [and he maketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w it a god| strong="H410" \w*: [they fall down]{strong=“H5456” x-morph=“strongMorph: \sc Th\sc*8799”}, [yea, they worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”}. 
\v 7 [They bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w him upon the shoulder| strong="H3802" \w*, [they carry]{strong=“H5445” x-morph=“strongMorph: \sc Th\sc*8799”} [him, and set him in his place]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8686”}, [and he standeth]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”}; \w from his place| strong="H4725" \w* [shall he not remove]{strong=“H4185” x-morph=“strongMorph: \sc Th\sc*8686”}: yea, one [shall cry]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, yet can he not answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”}, [nor save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} \w him out of his trouble| strong="H6869" \w*. 
\v 8 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”} [this, and shew yourselves men]{strong=“H377” x-morph=“strongMorph: \sc Th\sc*8695”}: bring it [again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”} \w to mind| strong="H3820" \w*, [O ye transgressors]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 9 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”} \w the former things| strong="H7223" \w* \w of old| strong="H5769" \w*: for I am \w God| strong="H410" \w*, and there is none else; I am \w God| strong="H430" \w*, and there is \w none| strong="H657" \w* \w like| strong="H3644" \w* me, 
\v 10 [Declaring]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8688”} \w the end| strong="H319" \w* \w from the beginning| strong="H7225" \w*, \w and from ancient times| strong="H6924" \w* the things that are not yet [done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8738”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, \w My counsel| strong="H6098" \w* [shall stand]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and I will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w all my pleasure| strong="H2656" \w*: 
\v 11 [Calling]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8802”} \w a ravenous bird| strong="H5861" \w* \w from the east| strong="H4217" \w*, \w the man| strong="H376" \w* \w that executeth my counsel| strong="H6098" \w* \w from a far| strong="H4801" \w* \w country| strong="H776" \w*: [yea, I have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it, [I will also bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} [it to pass; I have purposed]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8804”} it, [I will also do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} it.\f + \fr 46:11 \ft that…: Heb. of my counsel \f* 
\p
\v 12 [Hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me, ye stouthearted]{strong=“H3820 H47”}, that are \w far from| strong="H7350" \w* \w righteousness| strong="H6666" \w*: 
\v 13 [I bring near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8765”} \w my righteousness| strong="H6666" \w*; [it shall not be far off]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and my salvation| strong="H8668" \w* [shall not tarry]{strong=“H309” x-morph=“strongMorph: \sc Th\sc*8762”}: [and I will place]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w salvation| strong="H8668" \w* \w in Zion| strong="H6726" \w* \w for Israel| strong="H3478" \w* \w my glory| strong="H8597" \w*. 
\c 47
\p 
\v 1 [Come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8798”}, [and sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8798”} \w in the dust| strong="H6083" \w*, \w O virgin| strong="H1330" \w* \w daughter| strong="H1323" \w* \w of Babylon| strong="H894" \w*, [sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8798”} \w on the ground| strong="H776" \w*: there is \w no throne| strong="H3678" \w*, \w O daughter| strong="H1323" \w* \w of the Chaldeans| strong="H3778" \w*: [for thou shalt no more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [be called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w tender| strong="H7390" \w* \w and delicate| strong="H6028" \w*. 
\v 2 [Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w the millstones| strong="H7347" \w*, [and grind]{strong=“H2912” x-morph=“strongMorph: \sc Th\sc*8798”} \w meal| strong="H7058" \w*: [uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8761”} \w thy locks| strong="H6777" \w*, [make bare]{strong=“H2834” x-morph=“strongMorph: \sc Th\sc*8798”} \w the leg| strong="H7640" \w*, [uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8761”} \w the thigh| strong="H7785" \w*, [pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8798”} \w the rivers| strong="H5104" \w*. 
\v 3 \w Thy nakedness| strong="H6172" \w* [shall be uncovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8735”}, [yea, thy shame]{strong=“H2781”} [shall be seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8735”}: [I will take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w vengeance| strong="H5359" \w*, [and I will not meet]{strong=“H6293” x-morph=“strongMorph: \sc Th\sc*8799”} thee as \w a man| strong="H120" \w*. 
\v 4 As for [our redeemer]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”}, the \sc Lord\sc* \w of hosts| strong="H6635" \w* is \w his name| strong="H8034" \w*, \w the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w*. 
\v 5 [Sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8798”} \w thou silent| strong="H1748" \w*, [and get]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee into darkness| strong="H2822" \w*, \w O daughter| strong="H1323" \w* \w of the Chaldeans| strong="H3778" \w*: [for thou shalt no more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [be called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”}, \w The lady| strong="H1404" \w* \w of kingdoms| strong="H4467" \w*. 
\p
\v 6 [I was wroth]{strong=“H7107” x-morph=“strongMorph: \sc Th\sc*8804”} \w with my people| strong="H5971" \w*, [I have polluted]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8765”} \w mine inheritance| strong="H5159" \w*, [and given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w them into thine hand| strong="H3027" \w*: [thou didst shew]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w them no mercy| strong="H7356" \w*; \w upon the ancient| strong="H2205" \w* \w hast thou very| strong="H3966" \w* [heavily]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8689”} \w laid thy yoke| strong="H5923" \w*. 
\p
\v 7 [And thou saidst]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w I shall be a lady| strong="H1404" \w* \w for ever| strong="H5769" \w*: so [that thou didst not lay]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} these things \w to thy heart| strong="H3820" \w*, [neither didst remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w the latter end| strong="H319" \w* of it. 
\v 8 [Therefore hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} now this, thou that art \w given to pleasures| strong="H5719" \w*, [that dwellest]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w carelessly| strong="H983" \w*, [that sayest]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} \w in thine heart| strong="H3824" \w*, I am, \w and none else| strong="H657" \w* [beside me; I shall not sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} as \w a widow| strong="H490" \w*, [neither shall I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w the loss of children| strong="H7908" \w*: 
\v 9 \w But these two| strong="H8147" \w* things [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to thee in a moment| strong="H7281" \w* \w in one| strong="H259" \w* \w day| strong="H3117" \w*, \w the loss of children| strong="H7908" \w*, \w and widowhood| strong="H489" \w*: [they shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon thee in their perfection| strong="H8537" \w* \w for the multitude| strong="H7230" \w* \w of thy sorceries| strong="H3785" \w*, and \w for the great| strong="H3966" \w* \w abundance| strong="H6109" \w* \w of thine enchantments| strong="H2267" \w*. 
\p
\v 10 [For thou hast trusted]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thy wickedness| strong="H7451" \w*: [thou hast said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [None seeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} [me. Thy wisdom]{strong=“H2451”} \w and thy knowledge| strong="H1847" \w*, [it hath perverted]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8790”} [thee; and thou hast said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w in thine heart| strong="H3820" \w*, I am, \w and none else| strong="H657" \w* beside me.\f + \fr 47:10 \ft perverted…: or, caused thee to turn away \f* 
\p
\v 11 \w Therefore shall evil| strong="H7451" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [upon thee; thou shalt not know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w from whence it riseth| strong="H7837" \w*: \w and mischief| strong="H1943" \w* [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} [upon thee; thou shalt not be able]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [to put it off]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8763”}: \w and desolation| strong="H7722" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon thee suddenly| strong="H6597" \w*, which [thou shalt not know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 47:11 \ft from…: Heb. the morning thereof \f* \f + \fr 47:11 \ft put: Heb. expiate \f* 
\v 12 [Stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8798”} \w now with thine enchantments| strong="H2267" \w*, \w and with the multitude| strong="H7230" \w* \w of thy sorceries| strong="H3785" \w*, \w wherein| strong="H834" \w* [thou hast laboured]{strong=“H3021” x-morph=“strongMorph: \sc Th\sc*8804”} \w from thy youth| strong="H5271" \w*; [if so be thou shalt be able]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [to profit]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8687”}, [if so be thou mayest prevail]{strong=“H6206” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 13 [Thou art wearied]{strong=“H3811” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the multitude| strong="H7230" \w* \w of thy counsels| strong="H6098" \w*. [Let now the astrologers]{strong=“H8064 H1895” x-morph=“strongMorph: \sc Th\sc*8802”}, [the stargazers]{strong=“H3556 H2374”}, \w the monthly| strong="H2320" \w* [prognosticators]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8688”}, [stand up]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”}, [and save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} thee from these things [that shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} upon thee.\f + \fr 47:13 \ft astrologers: Heb. viewers of the heavens \f* \f + \fr 47:13 \ft the monthly…: Heb. that give knowledge concerning the months \f* 
\v 14 [Behold, they shall be as stubble]{strong=“H7179”}; \w the fire| strong="H784" \w* [shall burn]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8804”} [them; they shall not deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w themselves| strong="H5315" \w* \w from the power| strong="H3027" \w* \w of the flame| strong="H3852" \w*: there shall not be \w a coal| strong="H1513" \w* [to warm]{strong=“H2552” x-morph=“strongMorph: \sc Th\sc*8800”} at, nor \w fire| strong="H217" \w* [to sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} before it.\f + \fr 47:14 \ft themselves: Heb. their souls \f* 
\v 15 [Thus shall they be unto thee with whom thou hast laboured]{strong=“H3021” x-morph=“strongMorph: \sc Th\sc*8804”}, even [thy merchants]{strong=“H5503” x-morph=“strongMorph: \sc Th\sc*8802”}, \w from thy youth| strong="H5271" \w*: [they shall wander]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8804”} \w every one| strong="H376" \w* \w to his quarter| strong="H5676" \w*; [none shall save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8688”} thee.
\c 48
\p 
\v 1 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [ye this, O house]{strong=“H1004”} \w of Jacob| strong="H3290" \w*, [which are called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8737”} \w by the name| strong="H8034" \w* \w of Israel| strong="H3478" \w*, [and are come forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w out of the waters| strong="H4325" \w* \w of Judah| strong="H3063" \w*, [which swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8737”} \w by the name| strong="H8034" \w* of the \sc Lord\sc*, [and make mention]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8686”} \w of the God| strong="H430" \w* \w of Israel| strong="H3478" \w*, but \w not in truth| strong="H571" \w*, \w nor in righteousness| strong="H6666" \w*. 
\v 2 [For they call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8738”} \w themselves of the holy| strong="H6944" \w* \w city| strong="H5892" \w*, [and stay]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8738”} \w themselves upon the God| strong="H430" \w* \w of Israel| strong="H3478" \w*; The \sc Lord\sc* \w of hosts| strong="H6635" \w* is \w his name| strong="H8034" \w*. 
\v 3 [I have declared]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} \w the former things| strong="H7223" \w* \w from the beginning| strong="H227" \w*; [and they went forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w out of my mouth| strong="H6310" \w*, [and I shewed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8686”} [them; I did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} them \w suddenly| strong="H6597" \w*, [and they came to pass]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 4 \w Because I knew| strong="H1847" \w* that thou art \w obstinate| strong="H7186" \w*, \w and thy neck| strong="H6203" \w* is \w an iron| strong="H1270" \w* \w sinew| strong="H1517" \w*, \w and thy brow| strong="H4696" \w* \w brass| strong="H5154" \w*;\f + \fr 48:4 \ft obstinate: Heb. hard \f* 
\v 5 \w I have even from the beginning| strong="H227" \w* [declared]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} it [to thee; before it came to pass]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [I shewed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8689”} it [thee: lest thou shouldest say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Mine idol| strong="H6090" \w* [hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [them, and my graven image]{strong=“H6459”}, \w and my molten image| strong="H5262" \w*, [hath commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} them. 
\v 6 [Thou hast heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}, [see]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8798”} [all this; and will not ye declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} it? [I have shewed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee new things| strong="H2319" \w* \w from this time| strong="H6258" \w*, [even hidden things]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8803”}, [and thou didst not know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} them. 
\v 7 [They are created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8738”} [now, and not from the beginning; even before]{strong=“H6440”} \w the day| strong="H3117" \w* [when thou heardest]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [them not; lest thou shouldest say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Behold, I knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} them. 
\v 8 [Yea, thou heardest]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [not; yea, thou knewest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} not; yea, from that time that \w thine ear| strong="H241" \w* [was not opened]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8765”}: [for I knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [that thou wouldest deal very]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8800”} [treacherously]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8799”}, [and wast called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8795”} [a transgressor]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8802”} \w from the womb| strong="H990" \w*. 
\p
\v 9 [For my name’s]{strong=“H8034”} [sake will I defer]{strong=“H748” x-morph=“strongMorph: \sc Th\sc*8686”} \w mine anger| strong="H639" \w*, \w and for my praise| strong="H8416" \w* [will I refrain]{strong=“H2413” x-morph=“strongMorph: \sc Th\sc*8799”} [for thee, that I cut thee not off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8687”}. 
\v 10 [Behold, I have refined]{strong=“H6884” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, but not with silver]{strong=“H3701”}; [I have chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee in the furnace| strong="H3564" \w* \w of affliction| strong="H6040" \w*.\f + \fr 48:10 \ft with…: or, for silver \f* 
\v 11 For mine own sake, even [for mine own sake, will I do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} it: for how should my name [be polluted]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8735”}? [and I will not give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w my glory| strong="H3519" \w* \w unto another| strong="H312" \w*. 
\p
\v 12 [Hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me, O Jacob]{strong=“H3290”} \w and Israel| strong="H3478" \w*, [my called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8794”}; I am he; I am \w the first| strong="H7223" \w*, I also am \w the last| strong="H314" \w*. 
\v 13 \w Mine hand| strong="H3027" \w* [also hath laid the foundation]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the earth| strong="H776" \w*, \w and my right hand| strong="H3225" \w* [hath spanned]{strong=“H2946” x-morph=“strongMorph: \sc Th\sc*8765”} \w the heavens| strong="H8064" \w*: when [I call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8802”} [unto them, they stand up]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w together| strong="H3162" \w*.\f + \fr 48:13 \ft my…: or, the palm of my right hand hath spread out \f* 
\v 14 [All ye, assemble]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8734”} [yourselves, and hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}; [which among them hath declared]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} these things? The \sc Lord\sc* [hath loved]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} [him: he will do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w his pleasure| strong="H2656" \w* \w on Babylon| strong="H894" \w*, \w and his arm| strong="H2220" \w* shall be on \w the Chaldeans| strong="H3778" \w*. 
\v 15 I, even [I, have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}; [yea, I have called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [him: I have brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} [him, and he shall make his way]{strong=“H1870”} [prosperous]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\p
\v 16 [Come]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8798”} [ye near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me, hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [ye this; I have not spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w in secret| strong="H5643" \w* \w from the beginning| strong="H7218" \w*; \w from the time| strong="H6256" \w* that it was, there am [I: and now the Lord]{strong=“H136”} \sc God\sc*, \w and his Spirit| strong="H7307" \w*, [hath sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} me. 
\v 17 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [thy Redeemer]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”}, \w the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w*; I am the \sc Lord\sc* \w thy God| strong="H430" \w* [which teacheth]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8764”} [thee to profit]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8687”}, [which leadeth]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8688”} \w thee by the way| strong="H1870" \w* that [thou shouldest go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 18 \w O that| strong="H3863" \w* [thou hadst hearkened]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8689”} \w to my commandments| strong="H4687" \w*! \w then had thy peace| strong="H7965" \w* \w been as a river| strong="H5104" \w*, \w and thy righteousness| strong="H6666" \w* \w as the waves| strong="H1530" \w* \w of the sea| strong="H3220" \w*: 
\v 19 \w Thy seed| strong="H2233" \w* \w also had been as the sand| strong="H2344" \w*, \w and the offspring| strong="H6631" \w* \w of thy bowels| strong="H4578" \w* \w like the gravel| strong="H4579" \w* [thereof; his name]{strong=“H8034”} [should not have been cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8735”} [nor destroyed]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8735”} \w from before| strong="H6440" \w* me. 
\p
\v 20 [Go ye forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8798”} \w of Babylon| strong="H894" \w*, [flee]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye from the Chaldeans| strong="H3778" \w*, \w with a voice| strong="H6963" \w* \w of singing| strong="H7440" \w* [declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”} [ye, tell]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8685”} [this, utter]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8685”} it even \w to the end| strong="H7097" \w* \w of the earth| strong="H776" \w*; [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} ye, The \sc Lord\sc* [hath redeemed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8804”} \w his servant| strong="H5650" \w* \w Jacob| strong="H3290" \w*. 
\v 21 [And they thirsted]{strong=“H6770” x-morph=“strongMorph: \sc Th\sc*8804”} not when [he led]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8689”} \w them through the deserts| strong="H2723" \w*: \w he caused the waters| strong="H4325" \w* [to flow]{strong=“H5140” x-morph=“strongMorph: \sc Th\sc*8689”} \w out of the rock| strong="H6697" \w* [for them: he clave]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8799”} \w the rock| strong="H6697" \w* [also, and the waters]{strong=“H4325”} [gushed out]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 22 There is \w no peace| strong="H7965" \w*, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w unto the wicked| strong="H7563" \w*. 
\c 49
\p 
\v 1 [Listen]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O isles| strong="H339" \w*, [unto me; and hearken]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8685”}, \w ye people| strong="H3816" \w*, \w from far| strong="H7350" \w*; The \sc Lord\sc* [hath called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w me from the womb| strong="H990" \w*; \w from the bowels| strong="H4578" \w* \w of my mother| strong="H517" \w* [hath he made mention]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8689”} \w of my name| strong="H8034" \w*. 
\v 2 [And he hath made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w my mouth| strong="H6310" \w* \w like a sharp| strong="H2299" \w* \w sword| strong="H2719" \w*; \w in the shadow| strong="H6738" \w* \w of his hand| strong="H3027" \w* [hath he hid]{strong=“H2244” x-morph=“strongMorph: \sc Th\sc*8689”} [me, and made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} [me a polished]{strong=“H1305” x-morph=“strongMorph: \sc Th\sc*8803”} \w shaft| strong="H2671" \w*; \w in his quiver| strong="H827" \w* [hath he hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8689”} me; 
\v 3 [And said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto me, Thou art \w my servant| strong="H5650" \w*, \w O Israel| strong="H3478" \w*, [in whom I will be glorified]{strong=“H6286” x-morph=“strongMorph: \sc Th\sc*8691”}. 
\v 4 [Then I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [I have laboured]{strong=“H3021” x-morph=“strongMorph: \sc Th\sc*8804”} \w in vain| strong="H7385" \w*, [I have spent]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8765”} \w my strength| strong="H3581" \w* \w for nought| strong="H8414" \w*, \w and in vain| strong="H1892" \w*: yet \w surely| strong="H403" \w* \w my judgment| strong="H4941" \w* is with the \sc Lord\sc*, \w and my work| strong="H6468" \w* \w with my God| strong="H430" \w*.\f + \fr 49:4 \ft my work: or, my reward \f* 
\p
\v 5 [And now, saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* [that formed]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w me from the womb| strong="H990" \w* to be \w his servant| strong="H5650" \w*, \w to bring| strong="H7725" \w* \w Jacob| strong="H3290" \w* [again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8788”} [to him, Though Israel]{strong=“H3478”} [be not gathered]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8735”}, [yet shall I be glorious]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the eyes| strong="H5869" \w* of the \sc Lord\sc*, \w and my God| strong="H430" \w* \w shall be my strength| strong="H5797" \w*.\f + \fr 49:5 \ft Though…: or, That Israel may be gathered to him, and I may, etc \f* 
\v 6 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [It is a light thing]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8738”} \w that thou shouldest be my servant| strong="H5650" \w* [to raise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8687”} \w the tribes| strong="H7626" \w* \w of Jacob| strong="H3290" \w*, [and to restore]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} [the preserved]{strong=“H5336 H5341” x-morph=“strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8803”} \w of Israel| strong="H3478" \w*: [I will also give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee for a light| strong="H216" \w* \w to the Gentiles| strong="H1471" \w*, \w that thou mayest be my salvation| strong="H3444" \w* \w unto the end| strong="H7097" \w* \w of the earth| strong="H776" \w*.\f + \fr 49:6 \ft It is…: or, Art thou lighter than that thou shouldest, etc \f* \f + \fr 49:6 \ft preserved: or, desolations \f* 
\p
\v 7 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [the Redeemer]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Israel| strong="H3478" \w*, and \w his Holy One| strong="H6918" \w*, \w to him whom man| strong="H5315" \w* \w despiseth| strong="H960" \w*, \w to him whom the nation| strong="H1471" \w* [abhorreth]{strong=“H8581” x-morph=“strongMorph: \sc Th\sc*8764”}, \w to a servant| strong="H5650" \w* [of rulers]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8802”}, \w Kings| strong="H4428" \w* [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [and arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”}, \w princes| strong="H8269" \w* [also shall worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”}, because of the \sc Lord\sc* [that is faithful]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8737”}, and \w the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w*, [and he shall choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} thee.\f + \fr 49:7 \ft whom man…: or, that is despised in soul \f* 
\v 8 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w In an acceptable| strong="H7522" \w* \w time| strong="H6256" \w* [have I heard]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, and in a day]{strong=“H3117”} \w of salvation| strong="H3444" \w* [have I helped]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8804”} [thee: and I will preserve]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8799”} [thee, and give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee for a covenant| strong="H1285" \w* \w of the people| strong="H5971" \w*, [to establish]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8687”} \w the earth| strong="H776" \w*, [to cause to inherit]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8687”} [the desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8802”} \w heritages| strong="H5159" \w*;\f + \fr 49:8 \ft establish: or, raise up \f* 
\v 9 [That thou mayest say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} [to the prisoners]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8803”}, [Go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8798”}; to them that are \w in darkness| strong="H2822" \w*, [Shew]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8734”} [yourselves. They shall feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the ways| strong="H1870" \w*, \w and their pastures| strong="H4830" \w* shall be \w in all high places| strong="H8205" \w*. 
\v 10 [They shall not hunger]{strong=“H7456” x-morph=“strongMorph: \sc Th\sc*8799”} [nor thirst]{strong=“H6770” x-morph=“strongMorph: \sc Th\sc*8799”}; \w neither shall the heat| strong="H8273" \w* \w nor sun| strong="H8121" \w* [smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} [them: for he that hath mercy]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8764”} [on them shall lead]{strong=“H5090” x-morph=“strongMorph: \sc Th\sc*8762”} [them, even by the springs]{strong=“H4002”} \w of water| strong="H4325" \w* [shall he guide]{strong=“H5095” x-morph=“strongMorph: \sc Th\sc*8762”} them. 
\v 11 [And I will make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w all my mountains| strong="H2022" \w* \w a way| strong="H1870" \w*, \w and my highways| strong="H4546" \w* [shall be exalted]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 12 [Behold, these shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w from far| strong="H7350" \w*: [and, lo, these from the north]{strong=“H6828”} \w and from the west| strong="H3220" \w*; \w and these from the land| strong="H776" \w* \w of Sinim| strong="H5515" \w*. 
\p
\v 13 [Sing]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O heavens| strong="H8064" \w*; [and be joyful]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O earth| strong="H776" \w*; [and break forth]{strong=“H6476” x-morph=“strongMorph: \sc Th\sc*8798”} \w into singing| strong="H7440" \w*, \w O mountains| strong="H2022" \w*: for the \sc Lord\sc* [hath comforted]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8765”} \w his people| strong="H5971" \w*, [and will have mercy]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8762”} \w upon his afflicted| strong="H6041" \w*. 
\v 14 \w But Zion| strong="H6726" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, The \sc Lord\sc* [hath forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and my Lord]{strong=“H136”} [hath forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} me. 
\v 15 \w Can a woman| strong="H802" \w* [forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} \w her sucking child| strong="H5764" \w*, [that she should not have compassion]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8763”} \w on the son| strong="H1121" \w* \w of her womb| strong="H990" \w*? [yea, they may forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”}, [yet will I not forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} thee.\f + \fr 49:15 \ft that…: Heb. from having compassion \f* 
\v 16 [Behold, I have graven]{strong=“H2710” x-morph=“strongMorph: \sc Th\sc*8804”} thee upon the palms of my \w hands| strong="H3709" \w*; \w thy walls| strong="H2346" \w* are \w continually| strong="H8548" \w* before me. 
\v 17 \w Thy children| strong="H1121" \w* [shall make haste]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8765”}; [thy destroyers]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8764”} [and they that made thee waste]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8688”} [shall go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} of thee. 
\p
\v 18 [Lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w thine eyes| strong="H5869" \w* \w round about| strong="H5439" \w*, [and behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}: [all these gather themselves together]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8738”}, and [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} to thee. As \w I live| strong="H2416" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [thou shalt surely clothe]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} [thee with them all, as with an ornament]{strong=“H5716”}, [and bind]{strong=“H7194” x-morph=“strongMorph: \sc Th\sc*8762”} them on thee, \w as a bride| strong="H3618" \w* doeth. 
\v 19 \w For thy waste| strong="H2723" \w* [and thy desolate places]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and the land| strong="H776" \w* \w of thy destruction| strong="H2035" \w*, [shall even now be too narrow]{strong=“H3334” x-morph=“strongMorph: \sc Th\sc*8799”} [by reason of the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”}, [and they that swallowed thee up]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8764”} [shall be far away]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 20 \w The children| strong="H1121" \w* [which thou shalt have, after thou hast lost]{strong=“H7923”} [the other, shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w again in thine ears| strong="H241" \w*, \w The place| strong="H4725" \w* is \w too strait| strong="H6862" \w* [for me: give]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8798”} \w place| strong="H4725" \w* [to me that I may dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 21 [Then shalt thou say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thine heart| strong="H3824" \w*, [Who hath begotten]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} [me these, seeing I have lost my children]{strong=“H7921” x-morph=“strongMorph: \sc Th\sc*8803”}, \w and am desolate| strong="H1565" \w*, [a captive]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8802”}, [and removing to and fro]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8803”}? [and who hath brought up]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8765”} [these? Behold, I was left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8738”} [alone; these, where]{strong=“H375”} had they been? 
\v 22 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*, [Behold, I will lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w mine hand| strong="H3027" \w* \w to the Gentiles| strong="H1471" \w*, [and set up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} \w my standard| strong="H5251" \w* \w to the people| strong="H5971" \w*: [and they shall bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy sons| strong="H1121" \w* in their \w arms| strong="H2684" \w*, \w and thy daughters| strong="H1323" \w* [shall be carried]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8735”} upon their \w shoulders| strong="H3802" \w*.\f + \fr 49:22 \ft arms: Heb. bosom \f* 
\v 23 \w And kings| strong="H4428" \w* [shall be thy nursing fathers]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and their queens| strong="H8282" \w* [thy nursing mothers]{strong=“H3243” x-morph=“strongMorph: \sc Th\sc*8688”}: [they shall bow down]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} to thee with their \w face| strong="H639" \w* \w toward the earth| strong="H776" \w*, [and lick up]{strong=“H3897” x-morph=“strongMorph: \sc Th\sc*8762”} \w the dust| strong="H6083" \w* \w of thy feet| strong="H7272" \w*; [and thou shalt know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I am the \sc Lord\sc*: [for they shall not be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} [that wait]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8802”} for me.\f + \fr 49:23 \ft nursing fathers: Heb. nourishers \f* \f + \fr 49:23 \ft queens: Heb. princesses \f* 
\p
\v 24 \w Shall the prey| strong="H4455" \w* [be taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8714”} \w from the mighty| strong="H1368" \w*, \w or the lawful| strong="H6662" \w* \w captive| strong="H7628" \w* [delivered]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8735”}?\f + \fr 49:24 \ft lawful…: Heb. captivity of the just \f* 
\v 25 [But thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w Even the captives| strong="H7628" \w* \w of the mighty| strong="H1368" \w* [shall be taken away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8714”}, \w and the prey| strong="H4455" \w* \w of the terrible| strong="H6184" \w* [shall be delivered]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8735”}: [for I will contend]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”} \w with him that contendeth| strong="H3401" \w* [with thee, and I will save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy children| strong="H1121" \w*.\f + \fr 49:25 \ft captives: Heb. captivity \f* 
\v 26 [And I will feed]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8689”} [them that oppress]{strong=“H3238” x-morph=“strongMorph: \sc Th\sc*8688”} \w thee with their own flesh| strong="H1320" \w*; [and they shall be drunken]{strong=“H7937” x-morph=“strongMorph: \sc Th\sc*8799”} \w with their own blood| strong="H1818" \w*, \w as with sweet wine| strong="H6071" \w*: \w and all flesh| strong="H1320" \w* [shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I the \sc Lord\sc* am [thy Saviour]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8688”} [and thy Redeemer]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”}, \w the mighty One| strong="H46" \w* \w of Jacob| strong="H3290" \w*.\f + \fr 49:26 \ft sweet: or, new \f*
\c 50
\p 
\v 1 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, Where is \w the bill| strong="H5612" \w* [of your mother’s]{strong=“H517”} \w divorcement| strong="H3748" \w*, [whom I have put away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”}? [or which of my creditors]{strong=“H5383” x-morph=“strongMorph: \sc Th\sc*8802”} is it [to whom I have sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8804”} [you? Behold, for your iniquities]{strong=“H5771”} [have ye sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8738”} [yourselves, and for your transgressions]{strong=“H6588”} \w is your mother| strong="H517" \w* [put away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8795”}. 
\v 2 [Wherefore, when I came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, was there \w no man| strong="H376" \w*? [when I called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”}, was there [none to answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8802”}? \w Is my hand| strong="H3027" \w* [shortened ]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8804”} [at all]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8800”}, \w that it cannot redeem| strong="H6304" \w*? \w or have I no power| strong="H3581" \w* [to deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8687”}? [behold, at my rebuke]{strong=“H1606”} [I dry up]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8686”} \w the sea| strong="H3220" \w*, [I make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w the rivers| strong="H5104" \w* \w a wilderness| strong="H4057" \w*: \w their fish| strong="H1710" \w* [stinketh]{strong=“H887” x-morph=“strongMorph: \sc Th\sc*8799”}, because there is \w no water| strong="H4325" \w*, [and dieth]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w for thirst| strong="H6772" \w*. 
\v 3 [I clothe]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8686”} \w the heavens| strong="H8064" \w* \w with blackness| strong="H6940" \w*, [and I make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w sackcloth| strong="H8242" \w* \w their covering| strong="H3682" \w*. 
\p
\v 4 \w The Lord| strong="H136" \w* \sc God\sc* [hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w me the tongue| strong="H3956" \w* \w of the learned| strong="H3928" \w*, [that I should know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} [how to speak]{strong=“H5790” x-morph=“strongMorph: \sc Th\sc*8800”} \w a word| strong="H1697" \w* in season to him that is \w weary| strong="H3287" \w*: [he wakeneth]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8686”} \w morning| strong="H1242" \w* \w by morning| strong="H1242" \w*, [he wakeneth]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8686”} \w mine ear| strong="H241" \w* [to hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w as the learned| strong="H3928" \w*. 
\p
\v 5 \w The Lord| strong="H136" \w* \sc God\sc* [hath opened]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine ear| strong="H241" \w*, [and I was not rebellious]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8804”}, [neither turned away]{strong=“H5472” x-morph=“strongMorph: \sc Th\sc*8738”} \w back| strong="H268" \w*. 
\v 6 [I gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w my back| strong="H1460" \w* [to the smiters]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8688”}, \w and my cheeks| strong="H3895" \w* [to them that plucked off]{strong=“H4803” x-morph=“strongMorph: \sc Th\sc*8802”} [the hair: I hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8689”} \w not my face| strong="H6440" \w* \w from shame| strong="H3639" \w* \w and spitting| strong="H7536" \w*. 
\p
\v 7 \w For the Lord| strong="H136" \w* \sc God\sc* [will help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8799”} [me; therefore shall I not be confounded]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8738”}: [therefore have I set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w my face| strong="H6440" \w* \w like a flint| strong="H2496" \w*, [and I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [that I shall not be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 8 He is \w near| strong="H7138" \w* [that justifieth]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8688”} [me; who will contend]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”} [with me? let us stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w together| strong="H3162" \w*: who is [mine adversary]{strong=“H4941 H1167”}? [let him come near]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8799”} to me.\f + \fr 50:8 \ft mine…: Heb. the master of my cause? \f* 
\v 9 [Behold, the Lord]{strong=“H136”} \sc God\sc* [will help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8799”} me; who is he that [shall condemn]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8686”} [me? lo, they all shall wax old]{strong=“H1086” x-morph=“strongMorph: \sc Th\sc*8799”} \w as a garment| strong="H899" \w*; \w the moth| strong="H6211" \w* [shall eat them up]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 10 Who is \w among you that feareth| strong="H3373" \w* the \sc Lord\sc*, [that obeyeth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} \w the voice| strong="H6963" \w* \w of his servant| strong="H5650" \w*, [that walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} in \w darkness| strong="H2825" \w*, \w and hath no light| strong="H5051" \w*? [let him trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the name| strong="H8034" \w* of the \sc Lord\sc*, [and stay]{strong=“H8172” x-morph=“strongMorph: \sc Th\sc*8735”} \w upon his God| strong="H430" \w*. 
\v 11 [Behold, all ye that kindle]{strong=“H6919” x-morph=“strongMorph: \sc Th\sc*8802”} \w a fire| strong="H784" \w*, that compass yourselves [about]{strong=“H247” x-morph=“strongMorph: \sc Th\sc*8764”} \w with sparks| strong="H2131" \w*: [walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} \w in the light| strong="H217" \w* \w of your fire| strong="H784" \w*, \w and in the sparks| strong="H2131" \w* that [ye have kindled]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8765”}. \w This shall ye have of mine hand| strong="H3027" \w*; [ye shall lie down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w in sorrow| strong="H4620" \w*. 
\c 51
\p 
\v 1 [Hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [to me, ye that follow after]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8802”} \w righteousness| strong="H6664" \w*, [ye that seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} the \sc Lord\sc*: [look]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto the rock| strong="H6697" \w* whence [ye are hewn]{strong=“H2672” x-morph=“strongMorph: \sc Th\sc*8795”}, \w and to the hole| strong="H4718" \w* \w of the pit| strong="H953" \w* whence [ye are digged]{strong=“H5365” x-morph=“strongMorph: \sc Th\sc*8795”}. 
\v 2 [Look]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto Abraham| strong="H85" \w* \w your father| strong="H1" \w*, \w and unto Sarah| strong="H8283" \w* that [bare]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8787”} [you: for I called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w him alone| strong="H259" \w*, [and blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} [him, and increased]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} him. 
\v 3 For the \sc Lord\sc* [shall comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8765”} \w Zion| strong="H6726" \w*: [he will comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8765”} \w all her waste places| strong="H2723" \w*; [and he will make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w her wilderness| strong="H4057" \w* \w like Eden| strong="H5731" \w*, \w and her desert| strong="H6160" \w* \w like the garden| strong="H1588" \w* of the \sc Lord\sc*; \w joy| strong="H8342" \w* \w and gladness| strong="H8057" \w* [shall be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”} [therein, thanksgiving]{strong=“H8426”}, \w and the voice| strong="H6963" \w* \w of melody| strong="H2172" \w*. 
\p
\v 4 [Hearken]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8685”} [unto me, my people]{strong=“H5971”}; [and give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”} [unto me, O my nation]{strong=“H3816”}: \w for a law| strong="H8451" \w* [shall proceed]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} [from me, and I will make my judgment]{strong=“H4941”} [to rest]{strong=“H7280” x-morph=“strongMorph: \sc Th\sc*8686”} \w for a light| strong="H216" \w* \w of the people| strong="H5971" \w*. 
\v 5 \w My righteousness| strong="H6664" \w* is \w near| strong="H7138" \w*; \w my salvation| strong="H3468" \w* [is gone forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and mine arms| strong="H2220" \w* [shall judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w the people| strong="H5971" \w*; \w the isles| strong="H339" \w* [shall wait]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8762”} [upon me, and on mine arm]{strong=“H2220”} [shall they trust]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 6 [Lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w your eyes| strong="H5869" \w* \w to the heavens| strong="H8064" \w*, [and look]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8685”} \w upon the earth| strong="H776" \w* [beneath: for the heavens]{strong=“H8064”} [shall vanish away]{strong=“H4414” x-morph=“strongMorph: \sc Th\sc*8738”} \w like smoke| strong="H6227" \w*, \w and the earth| strong="H776" \w* [shall wax old]{strong=“H1086” x-morph=“strongMorph: \sc Th\sc*8799”} \w like a garment| strong="H899" \w*, [and they that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} [therein shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w in like| strong="H3644" \w* \w manner| strong="H3654" \w*: \w but my salvation| strong="H3444" \w* \w shall be for ever| strong="H5769" \w*, \w and my righteousness| strong="H6666" \w* [shall not be abolished]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\p
\v 7 [Hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me, ye that know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} \w righteousness| strong="H6664" \w*, \w the people| strong="H5971" \w* \w in whose heart| strong="H3820" \w* is \w my law| strong="H8451" \w*; [fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w ye not the reproach| strong="H2781" \w* \w of men| strong="H582" \w*, [neither be ye afraid]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8735”} \w of their revilings| strong="H1421" \w*. 
\v 8 \w For the moth| strong="H6211" \w* [shall eat them up]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w like a garment| strong="H899" \w*, \w and the worm| strong="H5580" \w* [shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w them like wool| strong="H6785" \w*: \w but my righteousness| strong="H6666" \w* \w shall be for ever| strong="H5769" \w*, \w and my salvation| strong="H3444" \w* \w from generation| strong="H1755" \w* \w to generation| strong="H1755" \w*. 
\p
\v 9 [Awake]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8798”}, [awake]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8798”}, [put on]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8798”} \w strength| strong="H5797" \w*, \w O arm| strong="H2220" \w* of the \sc Lord\sc*; [awake]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8798”}, \w as in the ancient| strong="H6924" \w* \w days| strong="H3117" \w*, \w in the generations| strong="H1755" \w* \w of old| strong="H5769" \w*. Art [thou not it that hath cut]{strong=“H2672” x-morph=“strongMorph: \sc Th\sc*8688”} \w Rahab| strong="H7294" \w*, and [wounded]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8781”} \w the dragon| strong="H8577" \w*? 
\v 10 Art [thou not it which hath dried]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8688”} \w the sea| strong="H3220" \w*, \w the waters| strong="H4325" \w* \w of the great| strong="H7227" \w* \w deep| strong="H8415" \w*; [that hath made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w the depths| strong="H4615" \w* \w of the sea| strong="H3220" \w* \w a way| strong="H1870" \w* [for the ransomed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8803”} [to pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8800”}? 
\v 11 [Therefore the redeemed]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8803”} of the \sc Lord\sc* [shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [and come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w with singing| strong="H7440" \w* \w unto Zion| strong="H6726" \w*; \w and everlasting| strong="H5769" \w* \w joy| strong="H8057" \w* shall be \w upon their head| strong="H7218" \w*: [they shall obtain]{strong=“H5381” x-morph=“strongMorph: \sc Th\sc*8686”} \w gladness| strong="H8342" \w* \w and joy| strong="H8057" \w*; and \w sorrow| strong="H3015" \w* \w and mourning| strong="H585" \w* [shall flee away]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 12 I, even I, am [he that comforteth]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8764”} you: who art [thou, that thou shouldest be afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w of a man| strong="H582" \w* that [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and of the son| strong="H1121" \w* \w of man| strong="H120" \w* which [shall be made]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8735”} as \w grass| strong="H2682" \w*; 
\v 13 [And forgettest]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc* [thy maker]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”}, [that hath stretched forth]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8802”} \w the heavens| strong="H8064" \w*, [and laid the foundations]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8801”} \w of the earth| strong="H776" \w*; [and hast feared]{strong=“H6342” x-morph=“strongMorph: \sc Th\sc*8762”} \w continually| strong="H8548" \w* \w every day| strong="H3117" \w* \w because| strong="H6440" \w* \w of the fury| strong="H2534" \w* [of the oppressor]{strong=“H6693” x-morph=“strongMorph: \sc Th\sc*8688”}, \w as if| strong="H834" \w* [he were ready]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8790”} [to destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8687”}? and where is \w the fury| strong="H2534" \w* [of the oppressor]{strong=“H6693” x-morph=“strongMorph: \sc Th\sc*8688”}?\f + \fr 51:13 \ft were…: or, made himself ready \f* 
\v 14 [The captive exile]{strong=“H6808” x-morph=“strongMorph: \sc Th\sc*8802”} [hasteneth]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8765”} [that he may be loosed]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8736”}, [and that he should not die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the pit| strong="H7845" \w*, \w nor that his bread| strong="H3899" \w* [should fail]{strong=“H2637” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 15 But I am the \sc Lord\sc* \w thy God| strong="H430" \w*, [that divided]{strong=“H7280” x-morph=“strongMorph: \sc Th\sc*8802”} \w the sea| strong="H3220" \w*, \w whose waves| strong="H1530" \w* [roared]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8799”}: The \sc Lord\sc* \w of hosts| strong="H6635" \w* is \w his name| strong="H8034" \w*. 
\v 16 [And I have put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w my words| strong="H1697" \w* \w in thy mouth| strong="H6310" \w*, [and I have covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”} \w thee in the shadow| strong="H6738" \w* \w of mine hand| strong="H3027" \w*, [that I may plant]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8800”} \w the heavens| strong="H8064" \w*, [and lay the foundations]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8800”} \w of the earth| strong="H776" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto Zion| strong="H6726" \w*, Thou art \w my people| strong="H5971" \w*. 
\p
\v 17 [Awake]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8708”}, [awake]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8708”}, [stand up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O Jerusalem| strong="H3389" \w*, [which hast drunk]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8804”} \w at the hand| strong="H3027" \w* of the \sc Lord\sc* \w the cup| strong="H3563" \w* \w of his fury| strong="H2534" \w*; [thou hast drunken]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8804”} \w the dregs| strong="H6907" \w* \w of the cup| strong="H3563" \w* \w of trembling| strong="H8653" \w*, and wrung them [out]{strong=“H4680” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 18 There is [none to guide]{strong=“H5095” x-morph=“strongMorph: \sc Th\sc*8764”} \w her among all the sons| strong="H1121" \w* whom [she hath brought forth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”}; neither is there any [that taketh]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8688”} \w her by the hand| strong="H3027" \w* \w of all the sons| strong="H1121" \w* that [she hath brought up]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 19 \w These two| strong="H8147" \w* things [are come]{strong=“H7122” x-morph=“strongMorph: \sc Th\sc*8802”} [unto thee; who shall be sorry]{strong=“H5110” x-morph=“strongMorph: \sc Th\sc*8799”} [for thee? desolation]{strong=“H7701”}, \w and destruction| strong="H7667" \w*, \w and the famine| strong="H7458" \w*, \w and the sword| strong="H2719" \w*: [by whom shall I comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8762”} thee?\f + \fr 51:19 \ft are…: Heb. happened \f* \f + \fr 51:19 \ft destruction: Heb. breaking \f* 
\v 20 \w Thy sons| strong="H1121" \w* [have fainted]{strong=“H5968” x-morph=“strongMorph: \sc Th\sc*8795”}, [they lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8804”} \w at the head| strong="H7218" \w* \w of all the streets| strong="H2351" \w*, \w as a wild bull| strong="H8377" \w* \w in a net| strong="H4364" \w*: \w they are full| strong="H4392" \w* \w of the fury| strong="H2534" \w* of the \sc Lord\sc*, \w the rebuke| strong="H1606" \w* \w of thy God| strong="H430" \w*. 
\p
\v 21 [Therefore hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [now this, thou afflicted]{strong=“H6041”}, [and drunken]{strong=“H7937” x-morph=“strongMorph: \sc Th\sc*8803”}, \w but not with wine| strong="H3196" \w*: 
\v 22 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy Lord| strong="H113" \w* the \sc Lord\sc*, \w and thy God| strong="H430" \w* that [pleadeth]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”} \w the cause of his people| strong="H5971" \w*, [Behold, I have taken out]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w of thine hand| strong="H3027" \w* \w the cup| strong="H3563" \w* \w of trembling| strong="H8653" \w*, even \w the dregs| strong="H6907" \w* \w of the cup| strong="H3563" \w* \w of my fury| strong="H2534" \w*; [thou shalt no more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [drink it again]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”}: 
\v 23 [But I will put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w it into the hand| strong="H3027" \w* [of them that afflict]{strong=“H3013” x-morph=“strongMorph: \sc Th\sc*8688”} [thee; which have said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w to thy soul| strong="H5315" \w*, [Bow down]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8798”}, [that we may go over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}: [and thou hast laid]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy body| strong="H1460" \w* \w as the ground| strong="H776" \w*, \w and as the street| strong="H2351" \w*, [to them that went over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\c 52
\p 
\v 1 [Awake]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8798”}, [awake]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8798”}; [put on]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy strength| strong="H5797" \w*, \w O Zion| strong="H6726" \w*; [put on]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy beautiful| strong="H8597" \w* \w garments| strong="H899" \w*, \w O Jerusalem| strong="H3389" \w*, \w the holy| strong="H6944" \w* \w city| strong="H5892" \w*: [for henceforth there shall no more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into thee the uncircumcised| strong="H6189" \w* \w and the unclean| strong="H2931" \w*. 
\v 2 [Shake]{strong=“H5287” x-morph=“strongMorph: \sc Th\sc*8690”} \w thyself from the dust| strong="H6083" \w*; [arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, and [sit down]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O Jerusalem| strong="H3389" \w*: [loose]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8690”} \w thyself from the bands| strong="H4147" \w* \w of thy neck| strong="H6677" \w*, \w O captive| strong="H7628" \w* \w daughter| strong="H1323" \w* \w of Zion| strong="H6726" \w*. 
\v 3 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [Ye have sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8738”} \w yourselves for nought| strong="H2600" \w*; [and ye shall be redeemed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8735”} \w without money| strong="H3701" \w*. 
\v 4 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*, \w My people| strong="H5971" \w* [went down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} \w aforetime| strong="H7223" \w* \w into Egypt| strong="H4714" \w* [to sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8800”} [there; and the Assyrian]{strong=“H804”} [oppressed]{strong=“H6231” x-morph=“strongMorph: \sc Th\sc*8804”} \w them without cause| strong="H657" \w*. 
\v 5 [Now therefore, what have I here, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, \w that my people| strong="H5971" \w* [is taken away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8795”} \w for nought| strong="H2600" \w*? [they that rule]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8802”} [over them make them to howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8686”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*; \w and my name| strong="H8034" \w* \w continually| strong="H8548" \w* \w every day| strong="H3117" \w* is [blasphemed]{strong=“H5006” x-morph=“strongMorph: \sc Th\sc*8711”}. 
\v 6 \w Therefore my people| strong="H5971" \w* [shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w my name| strong="H8034" \w*: therefore they shall know \w in that day| strong="H3117" \w* that I am [he that doth speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8764”}: behold, it is I. 
\p
\v 7 [How beautiful]{strong=“H4998” x-morph=“strongMorph: \sc Th\sc*8773”} \w upon the mountains| strong="H2022" \w* \w are the feet| strong="H7272" \w* [of him that bringeth good tidings]{strong=“H1319” x-morph=“strongMorph: \sc Th\sc*8764”}, [that publisheth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8688”} \w peace| strong="H7965" \w*; [that bringeth good tidings]{strong=“H1319” x-morph=“strongMorph: \sc Th\sc*8764”} \w of good| strong="H2896" \w*, [that publisheth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8688”} \w salvation| strong="H3444" \w*; [that saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} \w unto Zion| strong="H6726" \w*, \w Thy God| strong="H430" \w* [reigneth]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8804”}! 
\v 8 [Thy watchmen]{strong=“H6822” x-morph=“strongMorph: \sc Th\sc*8802”} [shall lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w the voice| strong="H6963" \w*; \w with the voice| strong="H6963" \w* \w together| strong="H3162" \w* [shall they sing]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8762”}: [for they shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w eye| strong="H5869" \w* \w to eye| strong="H5869" \w*, when the \sc Lord\sc* [shall bring again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w Zion| strong="H6726" \w*. 
\p
\v 9 [Break forth into joy]{strong=“H6476” x-morph=“strongMorph: \sc Th\sc*8798”}, [sing]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8761”} \w together| strong="H3162" \w*, \w ye waste places| strong="H2723" \w* \w of Jerusalem| strong="H3389" \w*: for the \sc Lord\sc* [hath comforted]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8765”} \w his people| strong="H5971" \w*, [he hath redeemed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8804”} \w Jerusalem| strong="H3389" \w*. 
\v 10 The \sc Lord\sc* [hath made bare]{strong=“H2834” x-morph=“strongMorph: \sc Th\sc*8804”} \w his holy| strong="H6944" \w* \w arm| strong="H2220" \w* \w in the eyes| strong="H5869" \w* \w of all the nations| strong="H1471" \w*; \w and all the ends| strong="H657" \w* \w of the earth| strong="H776" \w* [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the salvation| strong="H3444" \w* \w of our God| strong="H430" \w*. 
\p
\v 11 [Depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8798”} [ye, depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8798”} [ye, go ye out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8798”} [from thence, touch]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8799”} \w no unclean| strong="H2931" \w* thing; [go ye out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8798”} \w of the midst| strong="H8432" \w* [of her; be ye clean]{strong=“H1305” x-morph=“strongMorph: \sc Th\sc*8734”}, [that bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8802”} \w the vessels| strong="H3627" \w* of the \sc Lord\sc*. 
\v 12 [For ye shall not go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w with haste| strong="H2649" \w*, [nor go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w by flight| strong="H4499" \w*: for the \sc Lord\sc* [will go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w before| strong="H6440" \w* [you; and the God]{strong=“H430”} \w of Israel| strong="H3478" \w* will be [your rereward]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8764”}.\f + \fr 52:12 \ft be…: Heb. gather you up \f* 
\p
\v 13 [Behold, my servant]{strong=“H5650”} [shall deal prudently]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8686”}, [he shall be exalted]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8799”} [and extolled]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and be very| strong="H3966" \w* [high]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 52:13 \ft deal…: or, prosper \f* 
\v 14 \w As many| strong="H7227" \w* [were astonied]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8804”} [at thee; his visage]{strong=“H4758”} \w was so marred| strong="H4893" \w* \w more than any man| strong="H376" \w*, \w and his form| strong="H8389" \w* \w more than the sons| strong="H1121" \w* \w of men| strong="H120" \w*: 
\v 15 [So shall he sprinkle]{strong=“H5137” x-morph=“strongMorph: \sc Th\sc*8686”} \w many| strong="H7227" \w* \w nations| strong="H1471" \w*; \w the kings| strong="H4428" \w* [shall shut]{strong=“H7092” x-morph=“strongMorph: \sc Th\sc*8799”} \w their mouths| strong="H6310" \w* at him: for that [which had not been told]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8795”} [them shall they see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”}; and that [which they had not heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [shall they consider]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8712”}.
\c 53
\p 
\v 1 [Who hath believed]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8689”} \w our report| strong="H8052" \w*? \w and to whom is the arm| strong="H2220" \w* of the \sc Lord\sc* [revealed]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8738”}?\f + \fr 53:1 \ft report: or, doctrine?: Heb. hearing? \f* 
\v 2 [For he shall grow up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* \w him as a tender plant| strong="H3126" \w*, \w and as a root| strong="H8328" \w* \w out of a dry| strong="H6723" \w* \w ground| strong="H776" \w*: \w he hath no form| strong="H8389" \w* \w nor comeliness| strong="H1926" \w*; [and when we shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} him, there is \w no beauty| strong="H4758" \w* [that we should desire]{strong=“H2530” x-morph=“strongMorph: \sc Th\sc*8799”} him. 
\v 3 [He is despised]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8737”} \w and rejected| strong="H2310" \w* \w of men| strong="H376" \w*; \w a man| strong="H376" \w* \w of sorrows| strong="H4341" \w*, [and acquainted]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8803”} \w with grief| strong="H2483" \w*: [and we hid as it were]{strong=“H4564” x-morph=“strongMorph: \sc Th\sc*8688”} our \w faces| strong="H6440" \w* [from him; he was despised]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8737”}, [and we esteemed]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8804”} him not.\f + \fr 53:3 \ft we hid…: or, he hid as it were his face from us: Heb. as an hiding of faces from him, or, from us \f* 
\p
\v 4 \w Surely| strong="H403" \w* [he hath borne]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w our griefs| strong="H2483" \w*, [and carried]{strong=“H5445” x-morph=“strongMorph: \sc Th\sc*8804”} \w our sorrows| strong="H4341" \w*: [yet we did esteem]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8804”} [him stricken]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8803”}, [smitten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8716”} \w of God| strong="H430" \w*, [and afflicted]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8794”}. 
\v 5 But he was [wounded]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8775”} \w for our transgressions| strong="H6588" \w*, he was [bruised]{strong=“H1792” x-morph=“strongMorph: \sc Th\sc*8794”} \w for our iniquities| strong="H5771" \w*: \w the chastisement| strong="H4148" \w* \w of our peace| strong="H7965" \w* was [upon him; and with his stripes]{strong=“H2250”} [we are healed]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8738”}.\f + \fr 53:5 \ft wounded: or, tormented \f* \f + \fr 53:5 \ft stripes: Heb. bruise \f* 
\v 6 \w All we like sheep| strong="H6629" \w* [have gone astray]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8804”}; [we have turned]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8804”} \w every one| strong="H376" \w* \w to his own way| strong="H1870" \w*; and the \sc Lord\sc* [hath laid]{strong=“H6293” x-morph=“strongMorph: \sc Th\sc*8689”} \w on him the iniquity| strong="H5771" \w* of us all.\f + \fr 53:6 \ft laid…: Heb. made the iniquity of us all to meet on him \f* 
\v 7 [He was oppressed]{strong=“H5065” x-morph=“strongMorph: \sc Th\sc*8738”}, [and he was afflicted]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8737”}, [yet he opened]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} \w not his mouth| strong="H6310" \w*: [he is brought]{strong=“H2986” x-morph=“strongMorph: \sc Th\sc*8714”} \w as a lamb| strong="H7716" \w* \w to the slaughter| strong="H2874" \w*, \w and as a sheep| strong="H7353" \w* \w before| strong="H6440" \w* [her shearers]{strong=“H1494” x-morph=“strongMorph: \sc Th\sc*8802”} [is dumb]{strong=“H481” x-morph=“strongMorph: \sc Th\sc*8738”}, [so he openeth]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} \w not his mouth| strong="H6310" \w*. 
\v 8 [He was taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8795”} \w from prison| strong="H6115" \w* \w and from judgment| strong="H4941" \w*: [and who shall declare]{strong=“H7878” x-morph=“strongMorph: \sc Th\sc*8787”} \w his generation| strong="H1755" \w*? [for he was cut off]{strong=“H1504” x-morph=“strongMorph: \sc Th\sc*8738”} \w out of the land| strong="H776" \w* \w of the living| strong="H2416" \w*: \w for the transgression| strong="H6588" \w* \w of my people| strong="H5971" \w* \w was he stricken| strong="H5061" \w*.\f + \fr 53:8 \ft from prison…: or, away by distress and judgment: but, etc \f* \f + \fr 53:8 \ft was he…: Heb. was the stroke upon him \f* 
\v 9 [And he made]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w his grave| strong="H6913" \w* \w with the wicked| strong="H7563" \w*, \w and with the rich| strong="H6223" \w* \w in his death| strong="H4194" \w*; [because he had done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w no violence| strong="H2555" \w*, neither was any \w deceit| strong="H4820" \w* \w in his mouth| strong="H6310" \w*.\f + \fr 53:9 \ft death: Heb. deaths \f* 
\p
\v 10 [Yet it pleased]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* [to bruise]{strong=“H1792” x-morph=“strongMorph: \sc Th\sc*8763”} him; he hath put him [to grief]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8689”}: [when thou shalt make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w his soul| strong="H5315" \w* \w an offering for sin| strong="H817" \w*, [he shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} his \w seed| strong="H2233" \w*, [he shall prolong]{strong=“H748” x-morph=“strongMorph: \sc Th\sc*8686”} his \w days| strong="H3117" \w*, \w and the pleasure| strong="H2656" \w* of the \sc Lord\sc* [shall prosper]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his hand| strong="H3027" \w*.\f + \fr 53:10 \ft thou…: or, his soul shall make an offering \f* 
\v 11 [He shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the travail| strong="H5999" \w* \w of his soul| strong="H5315" \w*, and [shall be satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”}: \w by his knowledge| strong="H1847" \w* \w shall my righteous| strong="H6662" \w* \w servant| strong="H5650" \w* [justify]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8686”} \w many| strong="H7227" \w*; [for he shall bear]{strong=“H5445” x-morph=“strongMorph: \sc Th\sc*8799”} \w their iniquities| strong="H5771" \w*. 
\v 12 [Therefore will I divide]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8762”} him a portion \w with the great| strong="H7227" \w*, [and he shall divide]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8762”} \w the spoil| strong="H7998" \w* \w with the strong| strong="H6099" \w*; [because he hath poured out]{strong=“H6168” x-morph=“strongMorph: \sc Th\sc*8689”} \w his soul| strong="H5315" \w* \w unto death| strong="H4194" \w*: [and he was numbered]{strong=“H4487” x-morph=“strongMorph: \sc Th\sc*8738”} [with the transgressors]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8802”}; [and he bare]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w the sin| strong="H2399" \w* \w of many| strong="H7227" \w*, [and made intercession]{strong=“H6293” x-morph=“strongMorph: \sc Th\sc*8686”} [for the transgressors]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8802”}.
\c 54
\p 
\v 1 [Sing]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O barren| strong="H6135" \w*, thou that [didst not bear]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”}; [break forth]{strong=“H6476” x-morph=“strongMorph: \sc Th\sc*8798”} \w into singing| strong="H7440" \w*, [and cry aloud]{strong=“H6670” x-morph=“strongMorph: \sc Th\sc*8761”}, thou that [didst not travail with child]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8804”}: \w for more| strong="H7227" \w* are \w the children| strong="H1121" \w* [of the desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8802”} \w than the children| strong="H1121" \w* [of the married wife]{strong=“H1166” x-morph=“strongMorph: \sc Th\sc*8803”}, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*. 
\v 2 [Enlarge]{strong=“H7337” x-morph=“strongMorph: \sc Th\sc*8685”} \w the place| strong="H4725" \w* \w of thy tent| strong="H168" \w*, [and let them stretch forth]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w the curtains| strong="H3407" \w* \w of thine habitations| strong="H4908" \w*: [spare]{strong=“H2820” x-morph=“strongMorph: \sc Th\sc*8799”} [not, lengthen]{strong=“H748” x-morph=“strongMorph: \sc Th\sc*8685”} \w thy cords| strong="H4340" \w*, [and strengthen]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8761”} \w thy stakes| strong="H3489" \w*; 
\v 3 [For thou shalt break forth]{strong=“H6555” x-morph=“strongMorph: \sc Th\sc*8799”} \w on the right hand| strong="H3225" \w* \w and on the left| strong="H8040" \w*; \w and thy seed| strong="H2233" \w* [shall inherit]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8799”} \w the Gentiles| strong="H1471" \w*, [and make the desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8737”} \w cities| strong="H5892" \w* [to be inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 4 [Fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [not; for thou shalt not be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}: [neither be thou confounded]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8735”}; [for thou shalt not be put to shame]{strong=“H2659” x-morph=“strongMorph: \sc Th\sc*8686”}: [for thou shalt forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} \w the shame| strong="H1322" \w* \w of thy youth| strong="H5934" \w*, [and shalt not remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w the reproach| strong="H2781" \w* \w of thy widowhood| strong="H491" \w* any more. 
\v 5 [For thy Maker]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} is [thine husband]{strong=“H1166” x-morph=“strongMorph: \sc Th\sc*8802”}; the \sc Lord\sc* \w of hosts| strong="H6635" \w* is \w his name| strong="H8034" \w*; [and thy Redeemer]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”} \w the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w*; \w The God| strong="H430" \w* \w of the whole earth| strong="H776" \w* [shall he be called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 54:5 \ft Maker: Heb. Makers \f* 
\p
\v 6 For the \sc Lord\sc* [hath called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee as a woman| strong="H802" \w* [forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8803”} [and grieved]{strong=“H6087” x-morph=“strongMorph: \sc Th\sc*8803”} \w in spirit| strong="H7307" \w*, \w and a wife| strong="H802" \w* \w of youth| strong="H5271" \w*, [when thou wast refused]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8735”}, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy God| strong="H430" \w*. 
\v 7 \w For a small| strong="H6996" \w* \w moment| strong="H7281" \w* [have I forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} [thee; but with great]{strong=“H1419”} \w mercies| strong="H7356" \w* [will I gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8762”} thee. 
\v 8 \w In a little| strong="H8241" \w* \w wrath| strong="H7110" \w* [I hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8689”} \w my face| strong="H6440" \w* \w from thee for a moment| strong="H7281" \w*; \w but with everlasting| strong="H5769" \w* \w kindness| strong="H2617" \w* [will I have mercy]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8765”} [on thee, saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* [thy Redeemer]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 9 For this is as \w the waters| strong="H4325" \w* \w of Noah| strong="H5146" \w* unto me: for as [I have sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w that the waters| strong="H4325" \w* \w of Noah| strong="H5146" \w* [should no more go over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8800”} \w the earth| strong="H776" \w*; [so have I sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} [that I would not be wroth]{strong=“H7107” x-morph=“strongMorph: \sc Th\sc*8800”} [with thee, nor rebuke]{strong=“H1605” x-morph=“strongMorph: \sc Th\sc*8800”} thee. 
\v 10 \w For the mountains| strong="H2022" \w* [shall depart]{strong=“H4185” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the hills| strong="H1389" \w* [be removed]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8799”}; \w but my kindness| strong="H2617" \w* [shall not depart]{strong=“H4185” x-morph=“strongMorph: \sc Th\sc*8799”} [from thee, neither shall the covenant]{strong=“H1285”} \w of my peace| strong="H7965" \w* [be removed]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8799”}, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* [that hath mercy]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8764”} on thee. 
\p
\v 11 \w O thou afflicted| strong="H6041" \w*, [tossed with tempest]{strong=“H5590” x-morph=“strongMorph: \sc Th\sc*8802”}, and [not comforted]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8794”}, [behold, I will lay]{strong=“H7257” x-morph=“strongMorph: \sc Th\sc*8688”} \w thy stones| strong="H68" \w* \w with fair colours| strong="H6320" \w*, [and lay thy foundations]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8804”} \w with sapphires| strong="H5601" \w*. 
\v 12 [And I will make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy windows| strong="H8121" \w* \w of agates| strong="H3539" \w*, \w and thy gates| strong="H8179" \w* [of carbuncles]{strong=“H688 H68”}, \w and all thy borders| strong="H1366" \w* \w of pleasant| strong="H2656" \w* \w stones| strong="H68" \w*. 
\v 13 \w And all thy children| strong="H1121" \w* shall be \w taught| strong="H3928" \w* of the \sc Lord\sc*; \w and great| strong="H7227" \w* shall be \w the peace| strong="H7965" \w* \w of thy children| strong="H1121" \w*. 
\v 14 \w In righteousness| strong="H6666" \w* [shalt thou be established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8709”}: [thou shalt be far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8798”} \w from oppression| strong="H6233" \w*; [for thou shalt not fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}: \w and from terror| strong="H4288" \w*; [for it shall not come near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} thee. 
\v 15 [Behold, they shall surely]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8800”} [gather together]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”}, but \w not| strong="H657" \w* [by me: whosoever]{strong=“H4310”} [shall gather together]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8804”} [against thee shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} for thy sake. 
\v 16 [Behold, I have created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8804”} \w the smith| strong="H2796" \w* [that bloweth]{strong=“H5301” x-morph=“strongMorph: \sc Th\sc*8802”} \w the coals| strong="H6352" \w* \w in the fire| strong="H784" \w*, [and that bringeth forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8688”} \w an instrument| strong="H3627" \w* \w for his work| strong="H4639" \w*; [and I have created]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8804”} [the waster]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8688”} [to destroy]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8763”}. 
\p
\v 17 \w No weapon| strong="H3627" \w* [that is formed]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8714”} [against thee shall prosper]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8799”}; \w and every tongue| strong="H3956" \w* that [shall rise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w against thee in judgment| strong="H4941" \w* [thou shalt condemn]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8686”}. This is \w the heritage| strong="H5159" \w* \w of the servants| strong="H5650" \w* of the \sc Lord\sc*, \w and their righteousness| strong="H6666" \w* is [of me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\c 55
\p 
\v 1 \w Ho| strong="H1945" \w*, \w every one that thirsteth| strong="H6771" \w*, [come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye to the waters| strong="H4325" \w*, \w and he that hath no money| strong="H3701" \w*; [come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} [ye, buy]{strong=“H7666” x-morph=“strongMorph: \sc Th\sc*8798”}, [and eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8798”}; [yea, come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [buy]{strong=“H7666” x-morph=“strongMorph: \sc Th\sc*8798”} \w wine| strong="H3196" \w* \w and milk| strong="H2461" \w* \w without money| strong="H3701" \w* \w and without price| strong="H4242" \w*. 
\v 2 [Wherefore do ye spend]{strong=“H8254” x-morph=“strongMorph: \sc Th\sc*8799”} \w money| strong="H3701" \w* for that which is \w not bread| strong="H3899" \w*? \w and your labour| strong="H3018" \w* for that which \w satisfieth| strong="H7654" \w* \w not| strong="H3808" \w*? [hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [diligently]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} [unto me, and eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8798”} ye that which is \w good| strong="H2896" \w*, \w and let your soul| strong="H5315" \w* [delight]{strong=“H6026” x-morph=“strongMorph: \sc Th\sc*8691”} \w itself in fatness| strong="H1880" \w*.\f + \fr 55:2 \ft spend: Heb. weigh \f* 
\v 3 [Incline]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8685”} \w your ear| strong="H241" \w*, [and come]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me: hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, \w and your soul| strong="H5315" \w* [shall live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}; [and I will make]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} \w an everlasting| strong="H5769" \w* \w covenant| strong="H1285" \w* with you, even [the sure]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8737”} \w mercies| strong="H2617" \w* \w of David| strong="H1732" \w*. 
\v 4 [Behold, I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} him for \w a witness| strong="H5707" \w* \w to the people| strong="H3816" \w*, \w a leader| strong="H5057" \w* [and commander]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8764”} \w to the people| strong="H3816" \w*. 
\v 5 [Behold, thou shalt call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w a nation| strong="H1471" \w* that [thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [not, and nations]{strong=“H1471”} that [knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [not thee shall run]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”} unto thee because of the \sc Lord\sc* \w thy God| strong="H430" \w*, \w and for the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w*; [for he hath glorified]{strong=“H6286” x-morph=“strongMorph: \sc Th\sc*8765”} thee. 
\p
\v 6 [Seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8798”} ye the \sc Lord\sc* [while he may be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8736”}, [call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye upon him while he is near| strong="H7138" \w*: 
\v 7 \w Let the wicked| strong="H7563" \w* [forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w his way| strong="H1870" \w*, \w and the unrighteous| strong="H205" \w* \w man| strong="H376" \w* \w his thoughts| strong="H4284" \w*: [and let him return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc*, [and he will have mercy]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8762”} [upon him; and to our God]{strong=“H430”}, [for he will abundantly]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} [pardon]{strong=“H5545” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 55:7 \ft the unrighteous…: Heb. the man of iniquity \f* \f + \fr 55:7 \ft abundantly…: Heb. multiply to pardon \f* 
\p
\v 8 \w For my thoughts| strong="H4284" \w* are \w not your thoughts| strong="H4284" \w*, neither are \w your ways| strong="H1870" \w* \w my ways| strong="H1870" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 9 For as \w the heavens| strong="H8064" \w* [are higher]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8804”} \w than the earth| strong="H776" \w*, \w so are my ways| strong="H1870" \w* [higher]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8804”} \w than your ways| strong="H1870" \w*, \w and my thoughts| strong="H4284" \w* \w than your thoughts| strong="H4284" \w*. 
\v 10 \w For as the rain| strong="H1653" \w* [cometh down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the snow| strong="H7950" \w* \w from heaven| strong="H8064" \w*, [and returneth]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [not thither, but watereth]{strong=“H7301” x-morph=“strongMorph: \sc Th\sc*8689”} \w the earth| strong="H776" \w*, [and maketh it bring forth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8689”} [and bud]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8689”}, [that it may give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w seed| strong="H2233" \w* [to the sower]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and bread| strong="H3899" \w* [to the eater]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”}: 
\v 11 \w So shall my word| strong="H1697" \w* [be that goeth forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of my mouth| strong="H6310" \w*: [it shall not return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto me void| strong="H7387" \w*, [but it shall accomplish]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [that which I please]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”}, [and it shall prosper]{strong=“H6743” x-morph=“strongMorph: \sc Th\sc*8689”} in the thing [whereto I sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} it. 
\v 12 [For ye shall go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w with joy| strong="H8057" \w*, [and be led forth]{strong=“H2986” x-morph=“strongMorph: \sc Th\sc*8714”} \w with peace| strong="H7965" \w*: \w the mountains| strong="H2022" \w* \w and the hills| strong="H1389" \w* [shall break forth]{strong=“H6476” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* \w you into singing| strong="H7440" \w*, \w and all the trees| strong="H6086" \w* \w of the field| strong="H7704" \w* [shall clap]{strong=“H4222” x-morph=“strongMorph: \sc Th\sc*8799”} their \w hands| strong="H3709" \w*. 
\v 13 \w Instead of the thorn| strong="H5285" \w* [shall come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w the fir tree| strong="H1265" \w*, \w and instead of the brier| strong="H5636" \w* [shall come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w the myrtle tree| strong="H1918" \w*: and it shall be to the \sc Lord\sc* \w for a name| strong="H8034" \w*, \w for an everlasting| strong="H5769" \w* \w sign| strong="H226" \w* that [shall not be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\c 56
\p 
\v 1 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [Keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye judgment| strong="H4941" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} \w justice| strong="H6666" \w*: \w for my salvation| strong="H3444" \w* is \w near| strong="H7138" \w* [to come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}, \w and my righteousness| strong="H6666" \w* [to be revealed]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8736”}.\f + \fr 56:1 \ft judgment: or, equity \f* 
\v 2 \w Blessed| strong="H835" \w* is \w the man| strong="H582" \w* that [doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [this, and the son]{strong=“H1121”} \w of man| strong="H120" \w* that [layeth hold]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8686”} [on it; that keepeth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w the sabbath| strong="H7676" \w* [from polluting]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8763”} [it, and keepeth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w his hand| strong="H3027" \w* [from doing]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w any evil| strong="H7451" \w*. 
\p
\v 3 \w Neither let the son| strong="H1121" \w* \w of the stranger| strong="H5236" \w*, [that hath joined]{strong=“H3867” x-morph=“strongMorph: \sc Th\sc*8738”} himself to the \sc Lord\sc*, [speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, The \sc Lord\sc* [hath utterly]{strong=“H914” x-morph=“strongMorph: \sc Th\sc*8687”} [separated]{strong=“H914” x-morph=“strongMorph: \sc Th\sc*8686”} \w me from his people| strong="H5971" \w*: \w neither let the eunuch| strong="H5631" \w* [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Behold, I am \w a dry| strong="H3002" \w* \w tree| strong="H6086" \w*. 
\v 4 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc* \w unto the eunuchs| strong="H5631" \w* [that keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w my sabbaths| strong="H7676" \w*, [and choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} the things [that please]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and take hold]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8688”} \w of my covenant| strong="H1285" \w*; 
\v 5 [Even unto them will I give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w in mine house| strong="H1004" \w* \w and within my walls| strong="H2346" \w* \w a place| strong="H3027" \w* \w and a name| strong="H8034" \w* \w better| strong="H2896" \w* \w than of sons| strong="H1121" \w* \w and of daughters| strong="H1323" \w*: [I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w them an everlasting| strong="H5769" \w* \w name| strong="H8034" \w*, [that shall not be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 6 \w Also the sons| strong="H1121" \w* \w of the stranger| strong="H5236" \w*, [that join]{strong=“H3867” x-morph=“strongMorph: \sc Th\sc*8737”} themselves to the \sc Lord\sc*, [to serve]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8763”} [him, and to love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8800”} \w the name| strong="H8034" \w* of the \sc Lord\sc*, \w to be his servants| strong="H5650" \w*, [every one that keepeth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w the sabbath| strong="H7676" \w* [from polluting]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8763”} [it, and taketh hold]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8688”} \w of my covenant| strong="H1285" \w*; 
\v 7 [Even them will I bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w to my holy| strong="H6944" \w* \w mountain| strong="H2022" \w*, [and make them joyful]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8765”} \w in my house| strong="H1004" \w* \w of prayer| strong="H8605" \w*: \w their burnt offerings| strong="H5930" \w* \w and their sacrifices| strong="H2077" \w* shall be \w accepted| strong="H7522" \w* \w upon mine altar| strong="H4196" \w*; \w for mine house| strong="H1004" \w* [shall be called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8735”} \w an house| strong="H1004" \w* \w of prayer| strong="H8605" \w* \w for all people| strong="H5971" \w*. 
\v 8 \w The Lord| strong="H136" \w* \sc God\sc* [which gathereth]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8764”} [the outcasts]{strong=“H1760” x-morph=“strongMorph: \sc Th\sc*8737”} \w of Israel| strong="H3478" \w* [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”}, [Yet will I gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8762”} others [to him, beside those that are gathered]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8737”} unto him.\f + \fr 56:8 \ft beside…: Heb. to his gathered \f* 
\p
\v 9 \w All ye beasts| strong="H2416" \w* \w of the field| strong="H7704" \w*, [come]{strong=“H857” x-morph=“strongMorph: \sc Th\sc*8798”} [to devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”}, yea, \w all ye beasts| strong="H2416" \w* \w in the forest| strong="H3293" \w*. 
\v 10 [His watchmen]{strong=“H6822” x-morph=“strongMorph: \sc Th\sc*8802”} are \w blind| strong="H5787" \w*: [they are all ignorant]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}, they are \w all dumb| strong="H483" \w* \w dogs| strong="H3611" \w*, [they cannot]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [bark]{strong=“H5024” x-morph=“strongMorph: \sc Th\sc*8800”}; [sleeping]{strong=“H1957” x-morph=“strongMorph: \sc Th\sc*8802”}, [lying down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8802”}, [loving]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} [to slumber]{strong=“H5123” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 56:10 \ft sleeping: or, dreaming, or, talking in their sleep \f* 
\v 11 Yea, they are [greedy]{strong=“H5315 H5794”} \w dogs| strong="H3611" \w* which [can]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [never have]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w enough| strong="H7654" \w*, and they are [shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} that [cannot understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8687”}: [they all look]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8804”} \w to their own way| strong="H1870" \w*, \w every one| strong="H376" \w* \w for his gain| strong="H1215" \w*, \w from his quarter| strong="H7097" \w*.\f + \fr 56:11 \ft greedy: Heb. strong of appetite \f* \f + \fr 56:11 \ft can…: Heb. know not to be satisfied \f* 
\v 12 [Come]{strong=“H857” x-morph=“strongMorph: \sc Th\sc*8798”} ye, say they, [I will fetch]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w wine| strong="H3196" \w*, [and we will fill]{strong=“H5433” x-morph=“strongMorph: \sc Th\sc*8799”} \w ourselves with strong drink| strong="H7941" \w*; \w and to morrow| strong="H4279" \w* \w shall be as this day| strong="H3117" \w*, and \w much| strong="H3966" \w* \w more| strong="H3499" \w* \w abundant| strong="H1419" \w*.
\c 57
\p 
\v 1 \w The righteous| strong="H6662" \w* [perisheth]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and no man| strong="H376" \w* [layeth]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8802”} it \w to heart| strong="H3820" \w*: \w and merciful| strong="H2617" \w* \w men| strong="H582" \w* are [taken away]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8737”}, [none considering]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8688”} \w that the righteous| strong="H6662" \w* [is taken away]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8738”} \w from| strong="H6440" \w* \w the evil| strong="H7451" \w* to come.\f + \fr 57:1 \ft merciful…: Heb. men of kindness, or, godliness \f* \f + \fr 57:1 \ft from…: or, from that which is evil \f* 
\v 2 [He shall enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into peace| strong="H7965" \w*: [they shall rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8799”} \w in their beds| strong="H4904" \w*, each one [walking]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} in \w his uprightness| strong="H5228" \w*.\f + \fr 57:2 \ft enter into: or, go in \f* \f + \fr 57:2 \ft in his…: or, before him \f* 
\p
\v 3 [But draw near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8798”} [hither, ye sons]{strong=“H1121”} [of the sorceress]{strong=“H6049” x-morph=“strongMorph: \sc Th\sc*8781”}, \w the seed| strong="H2233" \w* [of the adulterer]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8764”} [and the whore]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 4 [Against whom do ye sport]{strong=“H6026” x-morph=“strongMorph: \sc Th\sc*8691”} [yourselves? against whom make ye a wide]{strong=“H7337” x-morph=“strongMorph: \sc Th\sc*8686”} \w mouth| strong="H6310" \w*, and [draw out]{strong=“H748” x-morph=“strongMorph: \sc Th\sc*8686”} \w the tongue| strong="H3956" \w*? are \w ye not children| strong="H3206" \w* \w of transgression| strong="H6588" \w*, \w a seed| strong="H2233" \w* \w of falsehood| strong="H8267" \w*, 
\v 5 [Enflaming]{strong=“H2552” x-morph=“strongMorph: \sc Th\sc*8737”} \w yourselves with idols| strong="H410" \w* \w under every green| strong="H7488" \w* \w tree| strong="H6086" \w*, [slaying]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8802”} \w the children| strong="H3206" \w* \w in the valleys| strong="H5158" \w* \w under the clifts| strong="H5585" \w* \w of the rocks| strong="H5553" \w*?\f + \fr 57:5 \ft with…: or, among the oaks \f* 
\v 6 \w Among the smooth| strong="H2511" \w* stones \w of the stream| strong="H5158" \w* is \w thy portion| strong="H2506" \w*; they, they are \w thy lot| strong="H1486" \w*: [even to them hast thou poured]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8804”} \w a drink offering| strong="H5262" \w*, [thou hast offered]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} \w a meat offering| strong="H4503" \w*. [Should I receive comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8735”} in these? 
\v 7 \w Upon a lofty| strong="H1364" \w* [and high]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8737”} \w mountain| strong="H2022" \w* [hast thou set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy bed| strong="H4904" \w*: [even thither wentest thou up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} [to offer]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8800”} \w sacrifice| strong="H2077" \w*. 
\v 8 \w Behind| strong="H310" \w* \w the doors| strong="H1817" \w* \w also and the posts| strong="H4201" \w* [hast thou set up]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy remembrance| strong="H2146" \w*: [for thou hast discovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8765”} thyself to another [than me, and art gone up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”}; [thou hast enlarged]{strong=“H7337” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy bed| strong="H4904" \w*, [and made]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} thee a covenant [with them; thou lovedst]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} \w their bed| strong="H4904" \w* \w where| strong="H3027" \w* [thou sawest]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8804”} it.\f + \fr 57:8 \ft made…: or, hewed it for thyself larger than theirs \f* \f + \fr 57:8 \ft where…: or, thou providedst room \f* 
\v 9 [And thou wentest]{strong=“H7788” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the king| strong="H4428" \w* \w with ointment| strong="H8081" \w*, [and didst increase]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy perfumes| strong="H7547" \w*, [and didst send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy messengers| strong="H6735" \w* \w far off| strong="H7350" \w*, [and didst debase]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8686”} thyself even \w unto hell| strong="H7585" \w*.\f + \fr 57:9 \ft thou…: or, thou respectedst \f* 
\v 10 [Thou art wearied]{strong=“H3021” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the greatness| strong="H7230" \w* \w of thy way| strong="H1870" \w*; yet [saidst]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [thou not, There is no hope]{strong=“H2976” x-morph=“strongMorph: \sc Th\sc*8737”}: [thou hast found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w the life| strong="H2416" \w* \w of thine hand| strong="H3027" \w*; [therefore thou wast not grieved]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 57:10 \ft life: or, living \f* 
\v 11 [And of whom hast thou been afraid]{strong=“H1672” x-morph=“strongMorph: \sc Th\sc*8804”} [or feared]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}, [that thou hast lied]{strong=“H3576” x-morph=“strongMorph: \sc Th\sc*8762”}, [and hast not remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} [me, nor laid]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} it \w to thy heart| strong="H3820" \w*? [have not I held my peace]{strong=“H2814” x-morph=“strongMorph: \sc Th\sc*8688”} \w even of old| strong="H5769" \w*, [and thou fearest]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} me not? 
\v 12 [I will declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy righteousness| strong="H6666" \w*, \w and thy works| strong="H4639" \w*; [for they shall not profit]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8686”} thee. 
\p
\v 13 [When thou criest]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8800”}, \w let thy companies| strong="H6899" \w* [deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} [thee; but the wind]{strong=“H7307”} [shall carry them all away]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”}; \w vanity| strong="H1892" \w* [shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} them: [but he that putteth his trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8802”} [in me shall possess]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8799”} \w the land| strong="H776" \w*, [and shall inherit]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8799”} \w my holy| strong="H6944" \w* \w mountain| strong="H2022" \w*; 
\v 14 [And shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Cast ye up]{strong=“H5549” x-morph=“strongMorph: \sc Th\sc*8798”}, [cast ye up]{strong=“H5549” x-morph=“strongMorph: \sc Th\sc*8798”}, [prepare]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8761”} \w the way| strong="H1870" \w*, [take up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8685”} \w the stumblingblock| strong="H4383" \w* \w out of the way| strong="H1870" \w* \w of my people| strong="H5971" \w*. 
\v 15 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [the high]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8802”} [and lofty One]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8737”} [that inhabiteth]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8802”} \w eternity| strong="H5703" \w*, \w whose name| strong="H8034" \w* is \w Holy| strong="H6918" \w*; [I dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the high| strong="H4791" \w* \w and holy| strong="H6918" \w* place, with him also that is \w of a contrite| strong="H1793" \w* \w and humble| strong="H8217" \w* \w spirit| strong="H7307" \w*, [to revive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8687”} \w the spirit| strong="H7307" \w* \w of the humble| strong="H8217" \w*, [and to revive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8687”} \w the heart| strong="H3820" \w* [of the contrite ones]{strong=“H1792” x-morph=“strongMorph: \sc Th\sc*8737”}. 
\v 16 [For I will not contend]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”} \w for ever| strong="H5769" \w*, \w neither will I be always| strong="H5331" \w* [wroth]{strong=“H7107” x-morph=“strongMorph: \sc Th\sc*8799”}: \w for the spirit| strong="H7307" \w* [should fail]{strong=“H5848” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* [me, and the souls]{strong=“H5397”} which [I have made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\p
\v 17 \w For the iniquity| strong="H5771" \w* \w of his covetousness| strong="H1215" \w* [was I wroth]{strong=“H7107” x-morph=“strongMorph: \sc Th\sc*8804”}, [and smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} [him: I hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8687”} [me, and was wroth]{strong=“H7107” x-morph=“strongMorph: \sc Th\sc*8799”}, [and he went on]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w frowardly| strong="H7726" \w* \w in the way| strong="H1870" \w* \w of his heart| strong="H3820" \w*.\f + \fr 57:17 \ft frowardly: Heb. turning away \f* 
\v 18 [I have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w his ways| strong="H1870" \w*, [and will heal]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8799”} [him: I will lead]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8686”} [him also, and restore]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w comforts| strong="H5150" \w* \w unto him and to his mourners| strong="H57" \w*. 
\v 19 [I create]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8802”} \w the fruit| strong="H5108" \w* \w of the lips| strong="H8193" \w*; \w Peace| strong="H7965" \w*, \w peace| strong="H7965" \w* to him that is \w far off| strong="H7350" \w*, and to him that is \w near| strong="H7138" \w*, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; [and I will heal]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8804”} him. 
\v 20 \w But the wicked| strong="H7563" \w* are [like the troubled]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8737”} \w sea| strong="H3220" \w*, [when it cannot]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [rest]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8687”}, \w whose waters| strong="H4325" \w* [cast up]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8799”} \w mire| strong="H7516" \w* \w and dirt| strong="H2916" \w*. 
\v 21 There is \w no peace| strong="H7965" \w*, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w my God| strong="H430" \w*, \w to the wicked| strong="H7563" \w*.
\c 58
\p 
\v 1 [Cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} \w aloud| strong="H1627" \w*, [spare]{strong=“H2820” x-morph=“strongMorph: \sc Th\sc*8799”} [not, lift]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8685”} \w up thy voice| strong="H6963" \w* \w like a trumpet| strong="H7782" \w*, [and shew]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”} \w my people| strong="H5971" \w* \w their transgression| strong="H6588" \w*, \w and the house| strong="H1004" \w* \w of Jacob| strong="H3290" \w* \w their sins| strong="H2403" \w*.\f + \fr 58:1 \ft aloud: Heb. with the throat \f* 
\v 2 [Yet they seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”} [me daily]{strong=“H3117 H3117”}, [and delight]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8799”} \w to know| strong="H1847" \w* \w my ways| strong="H1870" \w*, \w as a nation| strong="H1471" \w* [that did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w righteousness| strong="H6666" \w*, [and forsook]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the ordinance| strong="H4941" \w* \w of their God| strong="H430" \w*: [they ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} \w of me the ordinances| strong="H4941" \w* \w of justice| strong="H6664" \w*; [they take delight]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8799”} \w in approaching| strong="H7132" \w* \w to God| strong="H430" \w*. 
\p
\v 3 [Wherefore have we fasted]{strong=“H6684” x-morph=“strongMorph: \sc Th\sc*8804”}, say they, [and thou seest]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} not? wherefore [have we afflicted]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8765”} \w our soul| strong="H5315" \w*, [and thou takest no knowledge]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”}? [Behold, in the day]{strong=“H3117”} \w of your fast| strong="H6685" \w* [ye find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w pleasure| strong="H2656" \w*, [and exact]{strong=“H5065” x-morph=“strongMorph: \sc Th\sc*8799”} \w all your labours| strong="H6092" \w*.\f + \fr 58:3 \ft labours: or, things wherewith ye grieve others: Heb. griefs \f* 
\v 4 [Behold, ye fast]{strong=“H6684” x-morph=“strongMorph: \sc Th\sc*8799”} \w for strife| strong="H7379" \w* \w and debate| strong="H4683" \w*, [and to smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8687”} \w with the fist| strong="H106" \w* \w of wickedness| strong="H7562" \w*: [ye shall not fast]{strong=“H6684” x-morph=“strongMorph: \sc Th\sc*8799”} as ye do this \w day| strong="H3117" \w*, \w to make your voice| strong="H6963" \w* [to be heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8687”} \w on high| strong="H4791" \w*.\f + \fr 58:4 \ft ye shall…: or, ye fast not as this day \f* 
\v 5 \w Is it such a fast| strong="H6685" \w* [that I have chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”}? \w a day| strong="H3117" \w* \w for a man| strong="H120" \w* [to afflict]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8763”} \w his soul| strong="H5315" \w*? is it [to bow down]{strong=“H3721” x-morph=“strongMorph: \sc Th\sc*8800”} \w his head| strong="H7218" \w* \w as a bulrush| strong="H100" \w*, [and to spread]{strong=“H3331” x-morph=“strongMorph: \sc Th\sc*8686”} \w sackcloth| strong="H8242" \w* \w and ashes| strong="H665" \w* under him? [wilt thou call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w this| strong="H2088" \w* \w a fast| strong="H6685" \w*, \w and an acceptable| strong="H7522" \w* \w day| strong="H3117" \w* to the \sc Lord\sc*?\f + \fr 58:5 \ft a day…: or, to afflict his soul for a day? \f* 
\v 6 Is \w not this the fast| strong="H6685" \w* [that I have chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”}? [to loose]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8763”} \w the bands| strong="H2784" \w* \w of wickedness| strong="H7562" \w*, [to undo]{strong=“H5425” x-morph=“strongMorph: \sc Th\sc*8687”} \w the heavy| strong="H4133" \w* \w burdens| strong="H92" \w*, [and to let the oppressed]{strong=“H7533” x-morph=“strongMorph: \sc Th\sc*8803”} [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8763”} \w free| strong="H2670" \w*, [and that ye break]{strong=“H5423” x-morph=“strongMorph: \sc Th\sc*8762”} \w every yoke| strong="H4133" \w*?\f + \fr 58:6 \ft the heavy…: Heb. the bundles of the yoke \f* \f + \fr 58:6 \ft oppressed: Heb. broken \f* 
\v 7 Is it [not to deal]{strong=“H6536” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy bread| strong="H3899" \w* \w to the hungry| strong="H7457" \w*, [and that thou bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w the poor| strong="H6041" \w* \w that are cast out| strong="H4788" \w* \w to thy house| strong="H1004" \w*? [when thou seest]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the naked| strong="H6174" \w*, [that thou cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”} [him; and that thou hide]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8691”} \w not thyself from thine own flesh| strong="H1320" \w*?\f + \fr 58:7 \ft cast…: or, afflicted \f* 
\p
\v 8 \w Then shall thy light| strong="H216" \w* [break forth]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8735”} \w as the morning| strong="H7837" \w*, \w and thine health| strong="H724" \w* [shall spring forth]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8799”} \w speedily| strong="H4120" \w*: \w and thy righteousness| strong="H6664" \w* [shall go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* [thee; the glory]{strong=“H3519”} of the \sc Lord\sc* [shall be thy rereward]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 58:8 \ft be…: Heb. gather thee up \f* 
\v 9 [Then shalt thou call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”}, and the \sc Lord\sc* [shall answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”}; [thou shalt cry]{strong=“H7768” x-morph=“strongMorph: \sc Th\sc*8762”}, [and he shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Here I am. [If thou take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8686”} \w from the midst| strong="H8432" \w* \w of thee the yoke| strong="H4133" \w*, [the putting forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8800”} \w of the finger| strong="H676" \w*, [and speaking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w vanity| strong="H205" \w*; 
\v 10 And if [thou draw out]{strong=“H6329” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy soul| strong="H5315" \w* \w to the hungry| strong="H7457" \w*, [and satisfy]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8686”} [the afflicted]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8737”} \w soul| strong="H5315" \w*; \w then shall thy light| strong="H216" \w* [rise]{strong=“H2224” x-morph=“strongMorph: \sc Th\sc*8804”} \w in obscurity| strong="H2822" \w*, \w and thy darkness| strong="H653" \w* be \w as the noonday| strong="H6672" \w*: 
\v 11 And the \sc Lord\sc* [shall guide]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee continually| strong="H8548" \w*, [and satisfy]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy soul| strong="H5315" \w* \w in drought| strong="H6710" \w*, [and make fat]{strong=“H2502” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy bones| strong="H6106" \w*: \w and thou shalt be like a watered| strong="H7302" \w* \w garden| strong="H1588" \w*, \w and like a spring| strong="H4161" \w* \w of water| strong="H4325" \w*, \w whose waters| strong="H4325" \w* [fail]{strong=“H3576” x-morph=“strongMorph: \sc Th\sc*8762”} not.\f + \fr 58:11 \ft drought: Heb. droughts \f* \f + \fr 58:11 \ft fail: Heb. lie, or, deceive \f* 
\v 12 And they that shall be [of thee shall build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w the old| strong="H5769" \w* \w waste places| strong="H2723" \w*: [thou shalt raise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8787”} \w the foundations| strong="H4146" \w* \w of many| strong="H1755" \w* \w generations| strong="H1755" \w*; [and thou shalt be called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8795”}, [The repairer]{strong=“H1443” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the breach| strong="H6556" \w*, [The restorer]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8789”} \w of paths| strong="H5410" \w* [to dwell in]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\p
\v 13 [If thou turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy foot| strong="H7272" \w* \w from the sabbath| strong="H7676" \w*, from [doing]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy pleasure| strong="H2656" \w* \w on my holy| strong="H6944" \w* \w day| strong="H3117" \w*; [and call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w the sabbath| strong="H7676" \w* \w a delight| strong="H6027" \w*, \w the holy| strong="H6918" \w* of the \sc Lord\sc*, [honourable]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8794”}; [and shalt honour]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8765”} [him, not doing]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w thine own ways| strong="H1870" \w*, [nor finding]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8800”} \w thine own pleasure| strong="H2656" \w*, [nor speaking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} thine own \w words| strong="H1697" \w*: 
\v 14 [Then shalt thou delight]{strong=“H6026” x-morph=“strongMorph: \sc Th\sc*8691”} thyself in the \sc Lord\sc*; [and I will cause thee to ride]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8689”} \w upon the high places| strong="H1116" \w* \w of the earth| strong="H776" \w*, [and feed]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8689”} \w thee with the heritage| strong="H5159" \w* \w of Jacob| strong="H3290" \w* \w thy father| strong="H1" \w*: \w for the mouth| strong="H6310" \w* of the \sc Lord\sc* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} it. 
\c 59
\p 
\v 1 \w Behold| strong="H2005" \w*, the \sc Lord\sc*’S \w hand| strong="H3027" \w* [is not shortened]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8804”}, [that it cannot save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8687”}; \w neither his ear| strong="H241" \w* [heavy]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8804”}, [that it cannot hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”}: 
\v 2 \w But your iniquities| strong="H5771" \w* [have separated]{strong=“H914” x-morph=“strongMorph: \sc Th\sc*8688”} \w between| strong="H996" \w* \w you and your God| strong="H430" \w*, \w and your sins| strong="H2403" \w* [have hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8689”} his \w face| strong="H6440" \w* [from you, that he will not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 59:2 \ft have hid: or, have made him hide \f* 
\v 3 \w For your hands| strong="H3709" \w* [are defiled]{strong=“H1351” x-morph=“strongMorph: \sc Th\sc*8738”} \w with blood| strong="H1818" \w*, \w and your fingers| strong="H676" \w* \w with iniquity| strong="H5771" \w*; \w your lips| strong="H8193" \w* [have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w lies| strong="H8267" \w*, \w your tongue| strong="H3956" \w* [hath muttered]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8799”} \w perverseness| strong="H5766" \w*. 
\v 4 [None calleth]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8802”} \w for justice| strong="H6664" \w*, nor any [pleadeth]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8737”} \w for truth| strong="H530" \w*: [they trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8800”} \w in vanity| strong="H8414" \w*, [and speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w lies| strong="H7723" \w*; [they conceive]{strong=“H2029” x-morph=“strongMorph: \sc Th\sc*8800”} \w mischief| strong="H5999" \w*, [and bring forth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8687”} \w iniquity| strong="H205" \w*. 
\v 5 [They hatch]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8765”} [cockatrice’]{strong=“H6848”} \w eggs| strong="H1000" \w*, [and weave]{strong=“H707” x-morph=“strongMorph: \sc Th\sc*8799”} [the spider’s]{strong=“H5908”} \w web| strong="H6980" \w*: [he that eateth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} \w of their eggs| strong="H1000" \w* [dieth]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and that which is crushed| strong="H2116" \w* [breaketh out]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8735”} \w into a viper| strong="H660" \w*.\f + \fr 59:5 \ft cockatrice’: or, adder’s \f* \f + \fr 59:5 \ft crushed…: or, sprinkled is as if there brake out a viper \f* 
\v 6 \w Their webs| strong="H6980" \w* \w shall not become garments| strong="H899" \w*, [neither shall they cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8691”} \w themselves with their works| strong="H4639" \w*: \w their works| strong="H4639" \w* are \w works| strong="H4639" \w* \w of iniquity| strong="H205" \w*, \w and the act| strong="H6467" \w* \w of violence| strong="H2555" \w* is \w in their hands| strong="H3709" \w*. 
\v 7 \w Their feet| strong="H7272" \w* [run]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”} \w to evil| strong="H7451" \w*, [and they make haste]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8762”} [to shed]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8800”} \w innocent| strong="H5355" \w* \w blood| strong="H1818" \w*: \w their thoughts| strong="H4284" \w* are \w thoughts| strong="H4284" \w* \w of iniquity| strong="H205" \w*; \w wasting| strong="H7701" \w* \w and destruction| strong="H7667" \w* are \w in their paths| strong="H4546" \w*.\f + \fr 59:7 \ft destruction: Heb. breaking \f* 
\v 8 \w The way| strong="H1870" \w* \w of peace| strong="H7965" \w* [they know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} not; and there is \w no judgment| strong="H4941" \w* \w in their goings| strong="H4570" \w*: [they have made them crooked]{strong=“H6140” x-morph=“strongMorph: \sc Th\sc*8765”} \w paths| strong="H5410" \w*: [whosoever goeth]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8802”} [therein shall not know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w peace| strong="H7965" \w*.\f + \fr 59:8 \ft judgment: or, right \f* 
\p
\v 9 \w Therefore is judgment| strong="H4941" \w* [far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8804”} [from us, neither doth justice]{strong=“H6666”} [overtake]{strong=“H5381” x-morph=“strongMorph: \sc Th\sc*8686”} [us: we wait]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8762”} \w for light| strong="H216" \w*, \w but behold obscurity| strong="H2822" \w*; \w for brightness| strong="H5054" \w*, but [we walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8762”} \w in darkness| strong="H653" \w*. 
\v 10 [We grope]{strong=“H1659” x-morph=“strongMorph: \sc Th\sc*8762”} \w for the wall| strong="H7023" \w* \w like the blind| strong="H5787" \w*, [and we grope]{strong=“H1659” x-morph=“strongMorph: \sc Th\sc*8762”} as if we had \w no eyes| strong="H5869" \w*: [we stumble]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8804”} \w at noonday| strong="H6672" \w* \w as in the night| strong="H5399" \w*; we are \w in desolate| strong="H820" \w* [places as dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”} men. 
\v 11 [We roar]{strong=“H1993” x-morph=“strongMorph: \sc Th\sc*8799”} \w all like bears| strong="H1677" \w*, [and mourn]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8799”} [sore]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8800”} \w like doves| strong="H3123" \w*: [we look]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8762”} \w for judgment| strong="H4941" \w*, but there is [none; for salvation]{strong=“H3444”}, but [it is far off]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8804”} from us. 
\v 12 \w For our transgressions| strong="H6588" \w* [are multiplied]{strong=“H7231” x-morph=“strongMorph: \sc Th\sc*8804”} [before thee, and our sins]{strong=“H2403”} [testify]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”} [against us: for our transgressions]{strong=“H6588”} are with us; and as for \w our iniquities| strong="H5771" \w*, [we know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} them; 
\v 13 [In transgressing]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8800”} [and lying]{strong=“H3584” x-morph=“strongMorph: \sc Th\sc*8763”} against the \sc Lord\sc*, [and departing away]{strong=“H5253” x-morph=“strongMorph: \sc Th\sc*8800”} \w from| strong="H310" \w* \w our God| strong="H430" \w*, [speaking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w oppression| strong="H6233" \w* \w and revolt| strong="H5627" \w*, [conceiving]{strong=“H2029” x-morph=“strongMorph: \sc Th\sc*8780”} [and uttering]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8774”} \w from the heart| strong="H3820" \w* \w words| strong="H1697" \w* \w of falsehood| strong="H8267" \w*. 
\v 14 \w And judgment| strong="H4941" \w* [is turned away]{strong=“H5253” x-morph=“strongMorph: \sc Th\sc*8717”} \w backward| strong="H268" \w*, \w and justice| strong="H6666" \w* [standeth]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w afar off| strong="H7350" \w*: \w for truth| strong="H571" \w* [is fallen]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the street| strong="H7339" \w*, \w and equity| strong="H5229" \w* [cannot]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 15 [Yea, truth]{strong=“H571”} [faileth]{strong=“H5737” x-morph=“strongMorph: \sc Th\sc*8737”}; and he that [departeth]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8804”} \w from evil| strong="H7451" \w* [maketh himself a prey]{strong=“H7997” x-morph=“strongMorph: \sc Th\sc*8711”}: and the \sc Lord\sc* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} it, [and it displeased]{strong=“H5869 H3415” x-morph=“strongMorph: \sc Th\sc*8799”} him that there was \w no judgment| strong="H4941" \w*.\f + \fr 59:15 \ft maketh…: or, is accounted mad \f* \f + \fr 59:15 \ft it displeased…: Heb. it was evil in his eyes \f* 
\p
\v 16 [And he saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} that there was \w no man| strong="H376" \w*, [and wondered]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8709”} that there was [no intercessor]{strong=“H6293” x-morph=“strongMorph: \sc Th\sc*8688”}: \w therefore his arm| strong="H2220" \w* [brought salvation]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} [unto him; and his righteousness]{strong=“H6666”}, [it sustained]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8804”} him. 
\v 17 [For he put on]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w righteousness| strong="H6666" \w* \w as a breastplate| strong="H8302" \w*, \w and an helmet| strong="H3553" \w* \w of salvation| strong="H3444" \w* \w upon his head| strong="H7218" \w*; [and he put on]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w the garments| strong="H899" \w* \w of vengeance| strong="H5359" \w* for \w clothing| strong="H8516" \w*, [and was clad]{strong=“H5844” x-morph=“strongMorph: \sc Th\sc*8799”} \w with zeal| strong="H7068" \w* \w as a cloke| strong="H4598" \w*. 
\v 18 \w According to| strong="H5921" \w* their \w deeds| strong="H1578" \w*, [accordingly he will repay]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”}, \w fury| strong="H2534" \w* \w to his adversaries| strong="H6862" \w*, \w recompence| strong="H1576" \w* [to his enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}; \w to the islands| strong="H339" \w* [he will repay]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w recompence| strong="H1576" \w*.\f + \fr 59:18 \ft deeds: Heb. recompences \f* 
\v 19 [So shall they fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w the name| strong="H8034" \w* of the \sc Lord\sc* \w from the west| strong="H4628" \w*, \w and his glory| strong="H3519" \w* \w from the rising| strong="H4217" \w* \w of the sun| strong="H8121" \w*. \w When the enemy| strong="H6862" \w* [shall come in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w like a flood| strong="H5104" \w*, \w the Spirit| strong="H7307" \w* of the \sc Lord\sc* [shall lift up a standard]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8790”} against him.\f + \fr 59:19 \ft lift…: or, put him to flight \f* 
\p
\v 20 [And the Redeemer]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”} [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w to Zion| strong="H6726" \w*, [and unto them that turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8802”} \w from transgression| strong="H6588" \w* \w in Jacob| strong="H3290" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 21 As for me, this is \w my covenant| strong="H1285" \w* [with them, saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*; \w My spirit| strong="H7307" \w* that is [upon thee, and my words]{strong=“H1697”} [which I have put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thy mouth| strong="H6310" \w*, [shall not depart]{strong=“H4185” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of thy mouth| strong="H6310" \w*, \w nor out of the mouth| strong="H6310" \w* \w of thy seed| strong="H2233" \w*, \w nor out of the mouth| strong="H6310" \w* [of thy seed’s]{strong=“H2233”} \w seed| strong="H2233" \w*, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w from henceforth and for| strong="H5704" \w* \w ever| strong="H5769" \w*. 
\c 60
\p 
\v 1 [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, [shine]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8798”}; \w for thy light| strong="H216" \w* [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and the glory| strong="H3519" \w* of the \sc Lord\sc* [is risen]{strong=“H2224” x-morph=“strongMorph: \sc Th\sc*8804”} upon thee.\f + \fr 60:1 \ft shine…: or, be enlightened; for thy light cometh \f* 
\v 2 [For, behold, the darkness]{strong=“H2822”} [shall cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w the earth| strong="H776" \w*, \w and gross darkness| strong="H6205" \w* \w the people| strong="H3816" \w*: but the \sc Lord\sc* [shall arise]{strong=“H2224” x-morph=“strongMorph: \sc Th\sc*8799”} [upon thee, and his glory]{strong=“H3519”} [shall be seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8735”} upon thee. 
\v 3 \w And the Gentiles| strong="H1471" \w* [shall come]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w to thy light| strong="H216" \w*, \w and kings| strong="H4428" \w* \w to the brightness| strong="H5051" \w* \w of thy rising| strong="H2225" \w*. 
\v 4 [Lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} \w thine eyes| strong="H5869" \w* \w round about| strong="H5439" \w*, [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}: [all they gather themselves together]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8738”}, [they come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to thee: thy sons]{strong=“H1121”} [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w from far| strong="H7350" \w*, \w and thy daughters| strong="H1323" \w* [shall be nursed]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8735”} at thy \w side| strong="H6654" \w*. 
\v 5 [Then thou shalt see]{strong=“H3372 H7200” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8799”}, [and flow together]{strong=“H5102” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and thine heart| strong="H3824" \w* [shall fear]{strong=“H6342” x-morph=“strongMorph: \sc Th\sc*8804”}, [and be enlarged]{strong=“H7337” x-morph=“strongMorph: \sc Th\sc*8804”}; \w because the abundance| strong="H1995" \w* \w of the sea| strong="H3220" \w* [shall be converted]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8735”} [unto thee, the forces]{strong=“H2428”} \w of the Gentiles| strong="H1471" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} unto thee.\f + \fr 60:5 \ft abundance…: or, noise of the sea shall be turned toward thee \f* \f + \fr 60:5 \ft forces: or, wealth \f* 
\v 6 \w The multitude| strong="H8229" \w* \w of camels| strong="H1581" \w* [shall cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} [thee, the dromedaries]{strong=“H1070”} \w of Midian| strong="H4080" \w* \w and Ephah| strong="H5891" \w*; \w all they from Sheba| strong="H7614" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}: [they shall bring]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w gold| strong="H2091" \w* \w and incense| strong="H3828" \w*; [and they shall shew forth]{strong=“H1319” x-morph=“strongMorph: \sc Th\sc*8762”} \w the praises| strong="H8416" \w* of the \sc Lord\sc*. 
\v 7 \w All the flocks| strong="H6629" \w* \w of Kedar| strong="H6938" \w* [shall be gathered together]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8735”} [unto thee, the rams]{strong=“H352”} \w of Nebaioth| strong="H5032" \w* [shall minister]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8762”} [unto thee: they shall come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w with acceptance| strong="H7522" \w* \w on mine altar| strong="H4196" \w*, [and I will glorify]{strong=“H6286” x-morph=“strongMorph: \sc Th\sc*8762”} \w the house| strong="H1004" \w* \w of my glory| strong="H8597" \w*. 
\v 8 Who are these that [fly]{strong=“H5774” x-morph=“strongMorph: \sc Th\sc*8799”} \w as a cloud| strong="H5645" \w*, \w and as the doves| strong="H3123" \w* \w to their windows| strong="H699" \w*? 
\p
\v 9 \w Surely the isles| strong="H339" \w* [shall wait]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8762”} [for me, and the ships]{strong=“H591”} \w of Tarshish| strong="H8659" \w* \w first| strong="H7223" \w*, [to bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} \w thy sons| strong="H1121" \w* \w from far| strong="H7350" \w*, \w their silver| strong="H3701" \w* \w and their gold| strong="H2091" \w* [with them, unto the name]{strong=“H8034”} of the \sc Lord\sc* \w thy God| strong="H430" \w*, \w and to the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w*, [because he hath glorified]{strong=“H6286” x-morph=“strongMorph: \sc Th\sc*8765”} thee. 
\v 10 \w And the sons| strong="H1121" \w* \w of strangers| strong="H5236" \w* [shall build up]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy walls| strong="H2346" \w*, \w and their kings| strong="H4428" \w* [shall minister]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8762”} [unto thee: for in my wrath]{strong=“H7110”} [I smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} [thee, but in my favour]{strong=“H7522”} [have I had mercy]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8765”} on thee. 
\v 11 \w Therefore thy gates| strong="H8179" \w* [shall be open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8765”} \w continually| strong="H8548" \w*; [they shall not be shut]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8735”} \w day| strong="H3119" \w* \w nor night| strong="H3915" \w*; that men [may bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} \w unto thee the forces| strong="H2428" \w* \w of the Gentiles| strong="H1471" \w*, and that \w their kings| strong="H4428" \w* may be [brought]{strong=“H5090” x-morph=“strongMorph: \sc Th\sc*8803”}.\f + \fr 60:11 \ft forces: or, wealth \f* 
\v 12 \w For the nation| strong="H1471" \w* \w and kingdom| strong="H4467" \w* [that will not serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} [thee shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}; yea, those \w nations| strong="H1471" \w* [shall be utterly]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8800”} [wasted]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 13 \w The glory| strong="H3519" \w* \w of Lebanon| strong="H3844" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee, the fir tree]{strong=“H1265”}, \w the pine tree| strong="H8410" \w*, \w and the box| strong="H8391" \w* \w together| strong="H3162" \w*, [to beautify]{strong=“H6286” x-morph=“strongMorph: \sc Th\sc*8763”} \w the place| strong="H4725" \w* \w of my sanctuary| strong="H4720" \w*; \w and I will make the place| strong="H4725" \w* \w of my feet| strong="H7272" \w* [glorious]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 14 \w The sons| strong="H1121" \w* [also of them that afflicted]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8764”} [thee shall come]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} [bending]{strong=“H7817” x-morph=“strongMorph: \sc Th\sc*8800”} [unto thee; and all they that despised]{strong=“H5006” x-morph=“strongMorph: \sc Th\sc*8764”} [thee shall bow themselves down]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8694”} \w at the soles| strong="H3709" \w* \w of thy feet| strong="H7272" \w*; [and they shall call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, The city]{strong=“H5892”} of the \sc Lord\sc*, \w The Zion| strong="H6726" \w* \w of the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w*. 
\p
\v 15 \w Whereas| strong="H8478" \w* [thou hast been forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8803”} [and hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8803”}, [so that no man went through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} thee, [I will make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee an eternal| strong="H5769" \w* \w excellency| strong="H1347" \w*, \w a joy| strong="H4885" \w* \w of many| strong="H1755" \w* \w generations| strong="H1755" \w*. 
\v 16 [Thou shalt also suck]{strong=“H3243” x-morph=“strongMorph: \sc Th\sc*8804”} \w the milk| strong="H2461" \w* \w of the Gentiles| strong="H1471" \w*, [and shalt suck]{strong=“H3243” x-morph=“strongMorph: \sc Th\sc*8799”} \w the breast| strong="H7699" \w* \w of kings| strong="H4428" \w*: [and thou shalt know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that I the \sc Lord\sc* am [thy Saviour]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8688”} [and thy Redeemer]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”}, \w the mighty One| strong="H46" \w* \w of Jacob| strong="H3290" \w*. 
\v 17 \w For brass| strong="H5178" \w* [I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w gold| strong="H2091" \w*, \w and for iron| strong="H1270" \w* [I will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w silver| strong="H3701" \w*, \w and for wood| strong="H6086" \w* \w brass| strong="H5178" \w*, \w and for stones| strong="H68" \w* \w iron| strong="H1270" \w*: [I will also make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy officers| strong="H6486" \w* \w peace| strong="H7965" \w*, [and thine exactors]{strong=“H5065” x-morph=“strongMorph: \sc Th\sc*8802”} \w righteousness| strong="H6666" \w*. 
\v 18 \w Violence| strong="H2555" \w* [shall no more be heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8735”} \w in thy land| strong="H776" \w*, \w wasting| strong="H7701" \w* \w nor destruction| strong="H7667" \w* \w within thy borders| strong="H1366" \w*; [but thou shalt call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy walls| strong="H2346" \w* \w Salvation| strong="H3444" \w*, \w and thy gates| strong="H8179" \w* \w Praise| strong="H8416" \w*. 
\v 19 \w The sun| strong="H8121" \w* \w shall be no more thy light| strong="H216" \w* \w by day| strong="H3119" \w*; \w neither for brightness| strong="H5051" \w* \w shall the moon| strong="H3394" \w* \w give light| strong="H216" \w* unto thee: but the \sc Lord\sc* \w shall be unto thee an everlasting| strong="H5769" \w* [light]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8686”}, \w and thy God| strong="H430" \w* \w thy glory| strong="H8597" \w*. 
\v 20 \w Thy sun| strong="H8121" \w* [shall no more go down]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}; \w neither shall thy moon| strong="H3391" \w* [withdraw]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8735”} itself: for the \sc Lord\sc* \w shall be thine everlasting| strong="H5769" \w* \w light| strong="H216" \w*, \w and the days| strong="H3117" \w* \w of thy mourning| strong="H60" \w* [shall be ended]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 21 \w Thy people| strong="H5971" \w* also shall be \w all righteous| strong="H6662" \w*: [they shall inherit]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8799”} \w the land| strong="H776" \w* \w for ever| strong="H5769" \w*, \w the branch| strong="H5342" \w* \w of my planting| strong="H4302" \w*, \w the work| strong="H4639" \w* \w of my hands| strong="H3027" \w*, [that I may be glorified]{strong=“H6286” x-morph=“strongMorph: \sc Th\sc*8692”}. 
\v 22 \w A little one| strong="H6996" \w* \w shall become a thousand| strong="H505" \w*, \w and a small one| strong="H6810" \w* \w a strong| strong="H6099" \w* \w nation| strong="H1471" \w*: I the \sc Lord\sc* [will hasten]{strong=“H2363” x-morph=“strongMorph: \sc Th\sc*8686”} \w it in his time| strong="H6256" \w*. 
\c 61
\p 
\v 1 \w The Spirit| strong="H7307" \w* \w of the Lord| strong="H136" \w* \sc God\sc* is upon me; because the \sc Lord\sc* [hath anointed]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8804”} [me to preach good tidings]{strong=“H1319” x-morph=“strongMorph: \sc Th\sc*8763”} \w unto the meek| strong="H6035" \w*; [he hath sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [me to bind up]{strong=“H2280” x-morph=“strongMorph: \sc Th\sc*8800”} [the brokenhearted]{strong=“H3820 H7665” x-morph=“strongMorph: \sc Th\sc*8737”}, [to proclaim]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8800”} \w liberty| strong="H1865" \w* [to the captives]{strong=“H7617” x-morph=“strongMorph: \sc Th\sc*8803”}, \w and the opening of the prison| strong="H6495" \w* to them that are [bound]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8803”}; 
\v 2 [To proclaim]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8800”} \w the acceptable| strong="H7522" \w* \w year| strong="H8141" \w* of the \sc Lord\sc*, \w and the day| strong="H3117" \w* \w of vengeance| strong="H5359" \w* \w of our God| strong="H430" \w*; [to comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8763”} \w all that mourn| strong="H57" \w*; 
\v 3 [To appoint]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto them that mourn| strong="H57" \w* \w in Zion| strong="H6726" \w*, [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto them beauty| strong="H6287" \w* \w for ashes| strong="H665" \w*, \w the oil| strong="H8081" \w* \w of joy| strong="H8342" \w* \w for mourning| strong="H60" \w*, \w the garment| strong="H4594" \w* \w of praise| strong="H8416" \w* \w for the spirit| strong="H7307" \w* \w of heaviness| strong="H3544" \w*; [that they might be called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8795”} \w trees| strong="H352" \w* \w of righteousness| strong="H6664" \w*, \w the planting| strong="H4302" \w* of the \sc Lord\sc*, [that he might be glorified]{strong=“H6286” x-morph=“strongMorph: \sc Th\sc*8692”}. 
\p
\v 4 [And they shall build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w the old| strong="H5769" \w* \w wastes| strong="H2723" \w*, [they shall raise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8787”} \w the former| strong="H7223" \w* [desolations]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8802”}, [and they shall repair]{strong=“H2318” x-morph=“strongMorph: \sc Th\sc*8765”} \w the waste| strong="H2721" \w* \w cities| strong="H5892" \w*, [the desolations]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8802”} \w of many| strong="H1755" \w* \w generations| strong="H1755" \w*. 
\v 5 [And strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} [shall stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} [and feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8804”} \w your flocks| strong="H6629" \w*, \w and the sons| strong="H1121" \w* \w of the alien| strong="H5236" \w* shall be \w your plowmen| strong="H406" \w* \w and your vinedressers| strong="H3755" \w*. 
\v 6 [But ye shall be named]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8735”} \w the Priests| strong="H3548" \w* of the \sc Lord\sc*: men [shall call]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8735”} [you the Ministers]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8764”} \w of our God| strong="H430" \w*: [ye shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the riches| strong="H2428" \w* \w of the Gentiles| strong="H1471" \w*, \w and in their glory| strong="H3519" \w* [shall ye boast]{strong=“H3235” x-morph=“strongMorph: \sc Th\sc*8691”} yourselves. 
\p
\v 7 \w For your shame| strong="H1322" \w* ye shall have \w double| strong="H4932" \w*; and for \w confusion| strong="H3639" \w* [they shall rejoice]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8799”} \w in their portion| strong="H2506" \w*: \w therefore in their land| strong="H776" \w* [they shall possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8799”} \w the double| strong="H4932" \w*: \w everlasting| strong="H5769" \w* \w joy| strong="H8057" \w* shall be unto them. 
\v 8 For I the \sc Lord\sc* [love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} \w judgment| strong="H4941" \w*, [I hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} \w robbery| strong="H1498" \w* \w for burnt offering| strong="H5930" \w*; [and I will direct]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w their work| strong="H6468" \w* \w in truth| strong="H571" \w*, [and I will make]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} \w an everlasting| strong="H5769" \w* \w covenant| strong="H1285" \w* with them. 
\v 9 \w And their seed| strong="H2233" \w* [shall be known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8738”} \w among the Gentiles| strong="H1471" \w*, \w and their offspring| strong="H6631" \w* \w among| strong="H8432" \w* \w the people| strong="H5971" \w*: [all that see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} [them shall acknowledge]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8686”} them, that they are \w the seed| strong="H2233" \w* which the \sc Lord\sc* [hath blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\p
\v 10 [I will greatly]{strong=“H7797” x-morph=“strongMorph: \sc Th\sc*8800”} [rejoice]{strong=“H7797” x-morph=“strongMorph: \sc Th\sc*8799”} in the \sc Lord\sc*, \w my soul| strong="H5315" \w* [shall be joyful]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”} \w in my God| strong="H430" \w*; [for he hath clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8689”} \w me with the garments| strong="H899" \w* \w of salvation| strong="H3468" \w*, [he hath covered]{strong=“H3271” x-morph=“strongMorph: \sc Th\sc*8804”} \w me with the robe| strong="H4598" \w* \w of righteousness| strong="H6666" \w*, \w as a bridegroom| strong="H2860" \w* [decketh]{strong=“H3547” x-morph=“strongMorph: \sc Th\sc*8762”} himself \w with ornaments| strong="H6287" \w*, \w and as a bride| strong="H3618" \w* [adorneth]{strong=“H5710” x-morph=“strongMorph: \sc Th\sc*8799”} herself \w with her jewels| strong="H3627" \w*.\f + \fr 61:10 \ft decketh: Heb. decketh as a priest \f* 
\v 11 \w For as the earth| strong="H776" \w* [bringeth forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w her bud| strong="H6780" \w*, \w and as the garden| strong="H1593" \w* \w causeth the things that are sown| strong="H2221" \w* [in it to spring forth]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8686”}; \w so the Lord| strong="H136" \w* \sc God\sc* \w will cause righteousness| strong="H6666" \w* \w and praise| strong="H8416" \w* [to spring forth]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8686”} \w before all the nations| strong="H1471" \w*.
\c 62
\p 
\v 1 [For Zion’s]{strong=“H6726”} [sake will I not hold my peace]{strong=“H2814” x-morph=“strongMorph: \sc Th\sc*8799”}, [and for Jerusalem’s]{strong=“H3389”} [sake I will not rest]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8799”}, \w until the righteousness| strong="H6664" \w* [thereof go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w as brightness| strong="H5051" \w*, \w and the salvation| strong="H3444" \w* \w thereof as a lamp| strong="H3940" \w* that [burneth]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 2 \w And the Gentiles| strong="H1471" \w* [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy righteousness| strong="H6664" \w*, \w and all kings| strong="H4428" \w* \w thy glory| strong="H3519" \w*: [and thou shalt be called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8795”} \w by a new| strong="H2319" \w* [name]{strong=“H5344” x-morph=“strongMorph: \sc Th\sc*8799”}, \w which the mouth| strong="H6310" \w* of the \sc Lord\sc* \w shall name| strong="H8034" \w*. 
\v 3 \w Thou shalt also be a crown| strong="H5850" \w* \w of glory| strong="H8597" \w* \w in the hand| strong="H3027" \w* of the \sc Lord\sc*, \w and a royal| strong="H4410" \w* [diadem]{strong=“H6797 H6797” x-morph=“strongMorph: \sc Th\sc*8675”} \w in the hand| strong="H3709" \w* \w of thy God| strong="H430" \w*. 
\v 4 [Thou shalt no more be termed]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8735”} [Forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8803”}; \w neither shall thy land| strong="H776" \w* [any more be termed]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8735”} \w Desolate| strong="H8077" \w*: [but thou shalt be called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8735”} [Hephzi-bah]{strong=“H2657”}, \w and thy land| strong="H776" \w* [Beulah]{strong=“H1166” x-morph=“strongMorph: \sc Th\sc*8803”}: for the \sc Lord\sc* [delighteth]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} [in thee, and thy land]{strong=“H776”} [shall be married]{strong=“H1166” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 62:4 \ft Hephzi-bah: that is, My delight is in her \f* \f + \fr 62:4 \ft Beulah: that is, Married \f* 
\p
\v 5 For as \w a young man| strong="H970" \w* [marrieth]{strong=“H1166” x-morph=“strongMorph: \sc Th\sc*8799”} \w a virgin| strong="H1330" \w*, so \w shall thy sons| strong="H1121" \w* [marry]{strong=“H1166” x-morph=“strongMorph: \sc Th\sc*8799”} thee: and as \w the bridegroom| strong="H2860" \w* \w rejoiceth| strong="H4885" \w* \w over the bride| strong="H3618" \w*, so \w shall thy God| strong="H430" \w* [rejoice]{strong=“H7797” x-morph=“strongMorph: \sc Th\sc*8799”} over thee.\f + \fr 62:5 \ft as the…: Heb. with the joy of the bridegroom \f* 
\p
\v 6 [I have set]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8689”} [watchmen]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon thy walls| strong="H2346" \w*, \w O Jerusalem| strong="H3389" \w*, which \w shall never| strong="H8548" \w* [hold their peace]{strong=“H2814” x-morph=“strongMorph: \sc Th\sc*8799”} \w day| strong="H3117" \w* \w nor night| strong="H3915" \w*: [ye that make mention]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8688”} of the \sc Lord\sc*, \w keep not silence| strong="H1824" \w*,^\sc 62:6 make…: or, are the [Lord\sc*’s remembrancers] 
\v 7 [And give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w him no rest| strong="H1824" \w*, [till he establish]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8787”}, [and till he make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jerusalem| strong="H3389" \w* \w a praise| strong="H8416" \w* \w in the earth| strong="H776" \w*.\f + \fr 62:7 \ft rest: Heb. silence \f* 
\v 8 The \sc Lord\sc* [hath sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w by his right hand| strong="H3225" \w*, \w and by the arm| strong="H2220" \w* \w of his strength| strong="H5797" \w*, \w Surely I will| strong="H518" \w* [no more give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy corn| strong="H1715" \w* to be \w meat| strong="H3978" \w* [for thine enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}; \w and the sons| strong="H1121" \w* \w of the stranger| strong="H5236" \w* [shall not drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy wine| strong="H8492" \w*, [for the which thou hast laboured]{strong=“H3021” x-morph=“strongMorph: \sc Th\sc*8804”}:\f + \fr 62:8 \ft Surely…: Heb. If I give, etc \f* 
\v 9 [But they that have gathered]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8764”} [it shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [it, and praise]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8765”} the \sc Lord\sc*; [and they that have brought it together]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8764”} [shall drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w it in the courts| strong="H2691" \w* \w of my holiness| strong="H6944" \w*. 
\p
\v 10 [Go through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8798”}, [go through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8798”} \w the gates| strong="H8179" \w*; [prepare ]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8761”} \w ye the way| strong="H1870" \w* \w of the people| strong="H5971" \w*; [cast up]{strong=“H5549” x-morph=“strongMorph: \sc Th\sc*8798”}, [cast up]{strong=“H5549” x-morph=“strongMorph: \sc Th\sc*8798”} \w the highway| strong="H4546" \w*; [gather out]{strong=“H5619” x-morph=“strongMorph: \sc Th\sc*8761”} \w the stones| strong="H68" \w*; [lift up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8685”} \w a standard| strong="H5251" \w* \w for the people| strong="H5971" \w*. 
\v 11 Behold, the \sc Lord\sc* [hath proclaimed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8689”} \w unto the end| strong="H7097" \w* \w of the world| strong="H776" \w*, [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye to the daughter| strong="H1323" \w* \w of Zion| strong="H6726" \w*, [Behold, thy salvation]{strong=“H3468”} [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}; [behold, his reward]{strong=“H7939”} is [with him, and his work]{strong=“H6468”} \w before| strong="H6440" \w* him.\f + \fr 62:11 \ft work: or, recompence \f* 
\v 12 [And they shall call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [them, The holy]{strong=“H6944”} \w people| strong="H5971" \w*, [The redeemed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8803”} of the \sc Lord\sc*: [and thou shalt be called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8735”}, [Sought out]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8803”}, \w A city| strong="H5892" \w* [not forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8737”}.
\c 63
\p 
\v 1 Who is [this that cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w from Edom| strong="H123" \w*, [with dyed]{strong=“H2556” x-morph=“strongMorph: \sc Th\sc*8803”} \w garments| strong="H899" \w* \w from Bozrah| strong="H1224" \w*? this that is [glorious]{strong=“H1921” x-morph=“strongMorph: \sc Th\sc*8803”} \w in his apparel| strong="H3830" \w*, [travelling]{strong=“H6808” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the greatness| strong="H7230" \w* \w of his strength| strong="H3581" \w*? [I that speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8764”} \w in righteousness| strong="H6666" \w*, \w mighty| strong="H7227" \w* [to save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8687”}.\f + \fr 63:1 \ft glorious: Heb. decked \f* 
\v 2 Wherefore art thou \w red| strong="H122" \w* \w in thine apparel| strong="H3830" \w*, \w and thy garments| strong="H899" \w* [like him that treadeth]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the winefat| strong="H1660" \w*? 
\v 3 [I have trodden]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8804”} \w the winepress| strong="H6333" \w* [alone; and of the people]{strong=“H5971”} there was \w none| strong="H376" \w* [with me: for I will tread]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8799”} \w them in mine anger| strong="H639" \w*, [and trample]{strong=“H7429” x-morph=“strongMorph: \sc Th\sc*8799”} \w them in my fury| strong="H2534" \w*; \w and their blood| strong="H5332" \w* [shall be sprinkled]{strong=“H5137” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon my garments| strong="H899" \w*, [and I will stain]{strong=“H1351” x-morph=“strongMorph: \sc Th\sc*8689”} \w all my raiment| strong="H4403" \w*. 
\v 4 \w For the day| strong="H3117" \w* \w of vengeance| strong="H5359" \w* is \w in mine heart| strong="H3820" \w*, \w and the year| strong="H8141" \w* [of my redeemed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8803”} [is come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 5 [And I looked]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”}, and there was [none to help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8802”}; [and I wondered]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8709”} that there was [none to uphold]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8802”}: \w therefore mine own arm| strong="H2220" \w* [brought salvation]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} [unto me; and my fury]{strong=“H2534”}, [it upheld]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8804”} me. 
\v 6 [And I will tread down]{strong=“H947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the people| strong="H5971" \w* \w in mine anger| strong="H639" \w*, [and make them drunk]{strong=“H7937” x-morph=“strongMorph: \sc Th\sc*8762”} \w in my fury| strong="H2534" \w*, [and I will bring down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8686”} \w their strength| strong="H5332" \w* \w to the earth| strong="H776" \w*. 
\p
\v 7 [I will mention]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8686”} \w the lovingkindnesses| strong="H2617" \w* of the \sc Lord\sc*, and \w the praises| strong="H8416" \w* of the \sc Lord\sc*, according to all that the \sc Lord\sc* [hath bestowed]{strong=“H1580” x-morph=“strongMorph: \sc Th\sc*8804”} [on us, and the great]{strong=“H7227”} \w goodness| strong="H2898" \w* \w toward the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, [which he hath bestowed]{strong=“H1580” x-morph=“strongMorph: \sc Th\sc*8804”} \w on them according to his mercies| strong="H7356" \w*, \w and according to the multitude| strong="H7230" \w* \w of his lovingkindnesses| strong="H2617" \w*. 
\v 8 [For he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Surely they are \w my people| strong="H5971" \w*, \w children| strong="H1121" \w* that [will not lie]{strong=“H8266” x-morph=“strongMorph: \sc Th\sc*8762”}: [so he was their Saviour]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 9 \w In all their affliction| strong="H6869" \w* \w he was afflicted| strong="H6862" \w*, \w and the angel| strong="H4397" \w* \w of his presence| strong="H6440" \w* [saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8689”} [them: in his love]{strong=“H160”} \w and in his pity| strong="H2551" \w* [he redeemed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8804”} [them; and he bare]{strong=“H5190” x-morph=“strongMorph: \sc Th\sc*8762”} [them, and carried]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8762”} \w them all the days| strong="H3117" \w* \w of old| strong="H5769" \w*. 
\p
\v 10 [But they rebelled]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8804”}, [and vexed]{strong=“H6087” x-morph=“strongMorph: \sc Th\sc*8765”} \w his holy| strong="H6944" \w* \w Spirit| strong="H7307" \w*: [therefore he was turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8735”} [to be their enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, and [he fought]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8738”} against them. 
\v 11 [Then he remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w the days| strong="H3117" \w* \w of old| strong="H5769" \w*, \w Moses| strong="H4872" \w*, and \w his people| strong="H5971" \w*, saying, Where is [he that brought them up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8688”} \w out of the sea| strong="H3220" \w* [with the shepherd]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} \w of his flock| strong="H6629" \w*? where is [he that put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8802”} \w his holy| strong="H6944" \w* \w Spirit| strong="H7307" \w* \w within| strong="H7130" \w* him?\f + \fr 63:11 \ft shepherd: or, shepherds \f* 
\v 12 [That led]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8688”} them \w by the right hand| strong="H3225" \w* \w of Moses| strong="H4872" \w* \w with his glorious| strong="H8597" \w* \w arm| strong="H2220" \w*, [dividing]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8802”} \w the water| strong="H4325" \w* \w before| strong="H6440" \w* [them, to make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w himself an everlasting| strong="H5769" \w* \w name| strong="H8034" \w*? 
\v 13 [That led]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8688”} \w them through the deep| strong="H8415" \w*, \w as an horse| strong="H5483" \w* \w in the wilderness| strong="H4057" \w*, that [they should not stumble]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8735”}? 
\v 14 \w As a beast| strong="H929" \w* [goeth down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the valley| strong="H1237" \w*, \w the Spirit| strong="H7307" \w* of the \sc Lord\sc* [caused him to rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8686”}: [so didst thou lead]{strong=“H5090” x-morph=“strongMorph: \sc Th\sc*8765”} \w thy people| strong="H5971" \w*, [to make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w thyself a glorious| strong="H8597" \w* \w name| strong="H8034" \w*. 
\p
\v 15 [Look down]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8685”} \w from heaven| strong="H8064" \w*, [and behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w from the habitation| strong="H2073" \w* \w of thy holiness| strong="H6944" \w* \w and of thy glory| strong="H8597" \w*: where is \w thy zeal| strong="H7068" \w* \w and thy strength| strong="H1369" \w*, \w the sounding| strong="H1995" \w* \w of thy bowels| strong="H4578" \w* \w and of thy mercies| strong="H7356" \w* [toward me? are they restrained]{strong=“H662” x-morph=“strongMorph: \sc Th\sc*8694”}?\f + \fr 63:15 \ft the sounding: or, the multitude \f* 
\v 16 \w Doubtless| strong="H3588" \w* thou art \w our father| strong="H1" \w*, \w though Abraham| strong="H85" \w* [be ignorant]{strong=“H3045 H3808” x-morph=“strongMorph: \sc Th\sc*8804”} [of us, and Israel]{strong=“H3478”} [acknowledge]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8686”} us not: thou, O \sc Lord\sc*, art \w our father| strong="H1" \w*, [our redeemer]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”}; \w thy name| strong="H8034" \w* is \w from everlasting| strong="H5769" \w*.\f + \fr 63:16 \ft our redeemer…: or, our redeemer from everlasting is thy name \f* 
\p
\v 17 O \sc Lord\sc*, [why hast thou made us to err]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8686”} \w from thy ways| strong="H1870" \w*, and [hardened]{strong=“H7188” x-morph=“strongMorph: \sc Th\sc*8686”} \w our heart| strong="H3820" \w* \w from thy fear| strong="H3374" \w*? [Return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} [for thy servants’]{strong=“H5650”} [sake, the tribes]{strong=“H7626”} \w of thine inheritance| strong="H5159" \w*. 
\v 18 \w The people| strong="H5971" \w* \w of thy holiness| strong="H6944" \w* [have possessed]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8804”} it \w but a little while| strong="H4705" \w*: \w our adversaries| strong="H6862" \w* [have trodden down]{strong=“H947” x-morph=“strongMorph: \sc Th\sc*8790”} \w thy sanctuary| strong="H4720" \w*. 
\v 19 We are thine: \w thou never| strong="H5769" \w* [barest rule]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8804”} [over them; they were not called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8738”} \w by thy name| strong="H8034" \w*.\f + \fr 63:19 \ft they…: Heb. thy name was not called upon them \f*
\c 64
\p 
\v 1 \w Oh| strong="H3863" \w* [that thou wouldest rend]{strong=“H7167” x-morph=“strongMorph: \sc Th\sc*8804”} \w the heavens| strong="H8064" \w*, [that thou wouldest come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”}, \w that the mountains| strong="H2022" \w* [might flow down]{strong=“H2151” x-morph=“strongMorph: \sc Th\sc*8738”} \w at thy presence| strong="H6440" \w*, 
\v 2 As when \w the melting| strong="H2003" \w* \w fire| strong="H784" \w* [burneth]{strong=“H6919” x-morph=“strongMorph: \sc Th\sc*8800”}, \w the fire| strong="H784" \w* \w causeth the waters| strong="H4325" \w* [to boil]{strong=“H1158” x-morph=“strongMorph: \sc Th\sc*8799”}, \w to make thy name| strong="H8034" \w* [known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8687”} \w to thine adversaries| strong="H6862" \w*, that \w the nations| strong="H1471" \w* [may tremble]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8799”} \w at thy presence| strong="H6440" \w*!\f + \fr 64:2 \ft the melting…: Heb. the fire of meltings \f* 
\v 3 [When thou didst]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [terrible things]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”} which [we looked]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8762”} [not for, thou camest down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the mountains| strong="H2022" \w* [flowed down]{strong=“H2151” x-morph=“strongMorph: \sc Th\sc*8738”} \w at thy presence| strong="H6440" \w*. 
\v 4 \w For since the beginning of the world| strong="H5769" \w* men [have not heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}, [nor perceived by the ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8689”}, \w neither hath the eye| strong="H5869" \w* [seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”}, \w O God| strong="H430" \w*, \w beside| strong="H2108" \w* thee, what [he hath prepared]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [for him that waiteth]{strong=“H2442” x-morph=“strongMorph: \sc Th\sc*8764”} for him.\f + \fr 64:4 \ft seen…: or, seen a God beside thee, which doeth so for him, etc \f* 
\v 5 [Thou meetest]{strong=“H6293” x-morph=“strongMorph: \sc Th\sc*8804”} [him that rejoiceth]{strong=“H7797” x-morph=“strongMorph: \sc Th\sc*8801”} [and worketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w righteousness| strong="H6664" \w*, those that [remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee in thy ways| strong="H1870" \w*: [behold, thou art wroth]{strong=“H7107” x-morph=“strongMorph: \sc Th\sc*8804”}; [for we have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8799”}: \w in those is continuance| strong="H5769" \w*, [and we shall be saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\p
\v 6 \w But we are all as an unclean| strong="H2931" \w* thing, \w and all our righteousnesses| strong="H6666" \w* are \w as filthy| strong="H5708" \w* \w rags| strong="H899" \w*; [and we all do fade]{strong=“H1101 H5034” x-morph=“strongMorph: \sc Th\sc*8686 strongMorph: \sc Th\sc*8676 strongMorph: \sc Th\sc*8799”} \w as a leaf| strong="H5929" \w*; \w and our iniquities| strong="H5771" \w*, \w like the wind| strong="H7307" \w*, [have taken us away]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 7 And there is [none that calleth]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon thy name| strong="H8034" \w*, [that stirreth up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8711”} [himself to take hold]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8687”} [of thee: for thou hast hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8689”} \w thy face| strong="H6440" \w* [from us, and hast consumed]{strong=“H4127” x-morph=“strongMorph: \sc Th\sc*8799”} [us, because]{strong=“H3027”} \w of our iniquities| strong="H5771" \w*.\f + \fr 64:7 \ft consumed: Heb. melted \f* \f + \fr 64:7 \ft because: Heb. by the hand \f* 
\v 8 But now, O \sc Lord\sc*, thou art \w our father| strong="H1" \w*; we are \w the clay| strong="H2563" \w*, [and thou our potter]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”}; and we all are \w the work| strong="H4639" \w* \w of thy hand| strong="H3027" \w*. 
\p
\v 9 [Be not wroth]{strong=“H7107” x-morph=“strongMorph: \sc Th\sc*8799”} \w very sore| strong="H3966" \w*, O \sc Lord\sc*, [neither remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w iniquity| strong="H5771" \w* \w for ever| strong="H5703" \w*: [behold, see]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8685”}, we beseech thee, we are \w all thy people| strong="H5971" \w*. 
\v 10 \w Thy holy| strong="H6944" \w* \w cities| strong="H5892" \w* \w are a wilderness| strong="H4057" \w*, \w Zion| strong="H6726" \w* \w is a wilderness| strong="H4057" \w*, \w Jerusalem| strong="H3389" \w* \w a desolation| strong="H8077" \w*. 
\v 11 \w Our holy| strong="H6944" \w* \w and our beautiful| strong="H8597" \w* \w house| strong="H1004" \w*, \w where our fathers| strong="H1" \w* [praised]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8765”} [thee, is burned up]{strong=“H8316”} \w with fire| strong="H784" \w*: \w and all our pleasant things| strong="H4261" \w* \w are laid waste| strong="H2723" \w*. 
\v 12 [Wilt thou refrain]{strong=“H662” x-morph=“strongMorph: \sc Th\sc*8691”} thyself for these things, O \sc Lord\sc*? [wilt thou hold thy peace]{strong=“H2814” x-morph=“strongMorph: \sc Th\sc*8799”}, [and afflict]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8762”} \w us very sore| strong="H3966" \w*? 
\c 65
\p 
\v 1 [I am sought]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8738”} of them that [asked]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8804”} \w not| strong="H3808" \w* for me; [I am found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8738”} of them that [sought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8765”} \w me not| strong="H3808" \w*: [I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Behold me, behold me, unto a nation]{strong=“H1471”} that [was not called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8795”} \w by my name| strong="H8034" \w*. 
\v 2 [I have spread out]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8765”} \w my hands| strong="H3027" \w* \w all the day| strong="H3117" \w* [unto a rebellious]{strong=“H5637” x-morph=“strongMorph: \sc Th\sc*8802”} \w people| strong="H5971" \w*, [which walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w in a way| strong="H1870" \w* that was \w not good| strong="H2896" \w*, \w after| strong="H310" \w* \w their own thoughts| strong="H4284" \w*; 
\v 3 \w A people| strong="H5971" \w* [that provoketh me to anger]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8688”} \w continually| strong="H8548" \w* \w to my face| strong="H6440" \w*; [that sacrificeth]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8802”} \w in gardens| strong="H1593" \w*, [and burneth incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8764”} \w upon altars of brick| strong="H3843" \w*;\f + \fr 65:3 \ft upon…: Heb. upon bricks \f* 
\v 4 [Which remain]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w among the graves| strong="H6913" \w*, [and lodge]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} [in the monuments]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8803”}, [which eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} [swine’s]{strong=“H2386”} \w flesh| strong="H1320" \w*, [and broth]{strong=“H6564 H4839” x-morph=“strongMorph: \sc Th\sc*8675”} \w of abominable| strong="H6292" \w* things is in \w their vessels| strong="H3627" \w*;\f + \fr 65:4 \ft broth: or, pieces \f* 
\v 5 [Which say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, [Stand]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8798”} [by thyself, come not near]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8799”} [to me; for I am holier]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8804”} than thou. These are \w a smoke| strong="H6227" \w* \w in my nose| strong="H639" \w*, \w a fire| strong="H784" \w* [that burneth]{strong=“H3344” x-morph=“strongMorph: \sc Th\sc*8802”} \w all the day| strong="H3117" \w*.\f + \fr 65:5 \ft nose: or, anger \f* 
\v 6 Behold, it is [written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8803”} \w before| strong="H6440" \w* [me: I will not keep silence]{strong=“H2814” x-morph=“strongMorph: \sc Th\sc*8799”}, [but will recompense]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8765”}, [even recompense]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8765”} \w into their bosom| strong="H2436" \w*, 
\v 7 \w Your iniquities| strong="H5771" \w*, \w and the iniquities| strong="H5771" \w* \w of your fathers| strong="H1" \w* \w together| strong="H3162" \w*, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [which have burned incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8765”} \w upon the mountains| strong="H2022" \w*, [and blasphemed]{strong=“H2778” x-morph=“strongMorph: \sc Th\sc*8765”} \w me upon the hills| strong="H1389" \w*: [therefore will I measure]{strong=“H4058” x-morph=“strongMorph: \sc Th\sc*8804”} \w their former| strong="H7223" \w* \w work| strong="H6468" \w* \w into their bosom| strong="H2436" \w*. 
\p
\v 8 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w As the new wine| strong="H8492" \w* [is found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the cluster| strong="H811" \w*, and one [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8686”} [it not; for a blessing]{strong=“H1293”} is [in it: so will I do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [for my servants’]{strong=“H5650”} [sakes, that I may not destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8687”} them all. 
\v 9 [And I will bring forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w a seed| strong="H2233" \w* \w out of Jacob| strong="H3290" \w*, \w and out of Judah| strong="H3063" \w* [an inheritor]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8802”} \w of my mountains| strong="H2022" \w*: \w and mine elect| strong="H972" \w* [shall inherit]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8804”} [it, and my servants]{strong=“H5650”} [shall dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} there. 
\v 10 \w And Sharon| strong="H8289" \w* \w shall be a fold| strong="H5116" \w* \w of flocks| strong="H6629" \w*, \w and the valley| strong="H6010" \w* \w of Achor| strong="H5911" \w* \w a place for the herds| strong="H1241" \w* \w to lie down in| strong="H7258" \w*, \w for my people| strong="H5971" \w* [that have sought]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8804”} me. 
\p
\v 11 But ye are [they that forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8802”} the \sc Lord\sc*, \w that forget| strong="H7913" \w* \w my holy| strong="H6944" \w* \w mountain| strong="H2022" \w*, [that prepare]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8802”} \w a table| strong="H7979" \w* [for that troop]{strong=“H1408 H1409” x-morph=“strongMorph: \sc Th\sc*8677”}, [and that furnish]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8764”} \w the drink offering| strong="H4469" \w* \w unto that number| strong="H4507" \w*.\f + \fr 65:11 \ft troop: or, Gad \f* \f + \fr 65:11 \ft number: or, Meni, a pagan god \f* 
\v 12 [Therefore will I number]{strong=“H4487” x-morph=“strongMorph: \sc Th\sc*8804”} \w you to the sword| strong="H2719" \w*, [and ye shall all bow down]{strong=“H3766” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the slaughter| strong="H2874" \w*: [because when I called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”}, [ye did not answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”}; [when I spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}, [ye did not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}; [but did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w evil| strong="H7451" \w* \w before mine eyes| strong="H5869" \w*, [and did choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} that [wherein I delighted]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} not. 
\v 13 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*, [Behold, my servants]{strong=“H5650”} [shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}, [but ye shall be hungry]{strong=“H7456” x-morph=“strongMorph: \sc Th\sc*8799”}: [behold, my servants]{strong=“H5650”} [shall drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”}, [but ye shall be thirsty]{strong=“H6770” x-morph=“strongMorph: \sc Th\sc*8799”}: [behold, my servants]{strong=“H5650”} [shall rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”}, [but ye shall be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}: 
\v 14 [Behold, my servants]{strong=“H5650”} [shall sing]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8799”} \w for joy| strong="H2898" \w* \w of heart| strong="H3820" \w*, [but ye shall cry]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8799”} \w for sorrow| strong="H3511" \w* \w of heart| strong="H3820" \w*, [and shall howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8686”} \w for vexation| strong="H7667" \w* \w of spirit| strong="H7307" \w*.\f + \fr 65:14 \ft vexation: Heb. breaking \f* 
\v 15 [And ye shall leave]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8689”} \w your name| strong="H8034" \w* \w for a curse| strong="H7621" \w* \w unto my chosen| strong="H972" \w*: \w for the Lord| strong="H136" \w* \sc God\sc* [shall slay]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8689”} [thee, and call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w his servants| strong="H5650" \w* \w by another| strong="H312" \w* \w name| strong="H8034" \w*: 
\v 16 [That he who blesseth]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8693”} \w himself in the earth| strong="H776" \w* [shall bless]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8691”} \w himself in the God| strong="H430" \w* \w of truth| strong="H543" \w*; [and he that sweareth]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8737”} \w in the earth| strong="H776" \w* [shall swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8735”} \w by the God| strong="H430" \w* \w of truth| strong="H543" \w*; \w because the former| strong="H7223" \w* \w troubles| strong="H6869" \w* [are forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8738”}, [and because they are hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8738”} \w from mine eyes| strong="H5869" \w*. 
\p
\v 17 [For, behold, I create]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8802”} \w new| strong="H2319" \w* \w heavens| strong="H8064" \w* \w and a new| strong="H2319" \w* \w earth| strong="H776" \w*: \w and the former| strong="H7223" \w* [shall not be remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8735”}, [nor come]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w into mind| strong="H3820" \w*.\f + \fr 65:17 \ft come…: Heb. come upon the heart \f* 
\v 18 [But be ye glad]{strong=“H7797” x-morph=“strongMorph: \sc Th\sc*8798”} [and rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8798”} \w for ever| strong="H5703" \w* in that [which I create]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8802”}: [for, behold, I create]{strong=“H1254” x-morph=“strongMorph: \sc Th\sc*8802”} \w Jerusalem| strong="H3389" \w* \w a rejoicing| strong="H1525" \w*, \w and her people| strong="H5971" \w* \w a joy| strong="H4885" \w*. 
\v 19 [And I will rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8804”} \w in Jerusalem| strong="H3389" \w*, [and joy]{strong=“H7797” x-morph=“strongMorph: \sc Th\sc*8804”} \w in my people| strong="H5971" \w*: \w and the voice| strong="H6963" \w* \w of weeping| strong="H1065" \w* [shall be no more heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8735”} [in her, nor the voice]{strong=“H6963”} \w of crying| strong="H2201" \w*. 
\v 20 \w There shall be no more thence an infant| strong="H5764" \w* \w of days| strong="H3117" \w*, \w nor an old man| strong="H2205" \w* [that hath not filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8762”} \w his days| strong="H3117" \w*: \w for the child| strong="H5288" \w* [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w an hundred| strong="H3967" \w* \w years| strong="H8141" \w* \w old| strong="H1121" \w*; [but the sinner]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8802”} being \w an hundred| strong="H3967" \w* \w years| strong="H8141" \w* \w old| strong="H1121" \w* [shall be accursed]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8792”}. 
\v 21 [And they shall build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w houses| strong="H1004" \w*, [and inhabit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} them; [and they shall plant]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8804”} \w vineyards| strong="H3754" \w*, [and eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w the fruit| strong="H6529" \w* of them. 
\v 22 [They shall not build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and another| strong="H312" \w* [inhabit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”}; [they shall not plant]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and another| strong="H312" \w* [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}: \w for as the days| strong="H3117" \w* \w of a tree| strong="H6086" \w* are \w the days| strong="H3117" \w* \w of my people| strong="H5971" \w*, \w and mine elect| strong="H972" \w* [shall long enjoy]{strong=“H1086” x-morph=“strongMorph: \sc Th\sc*8762”} \w the work| strong="H4639" \w* \w of their hands| strong="H3027" \w*.\f + \fr 65:22 \ft shall long…: Heb. shall make them continue long, or, shall wear out \f* 
\v 23 [They shall not labour]{strong=“H3021” x-morph=“strongMorph: \sc Th\sc*8799”} \w in vain| strong="H7385" \w*, [nor bring forth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8799”} \w for trouble| strong="H928" \w*; for they are \w the seed| strong="H2233" \w* [of the blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8803”} of the \sc Lord\sc*, \w and their offspring| strong="H6631" \w* with them. 
\v 24 [And it shall come to pass, that before they call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”}; [and while they are yet speaking]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8764”}, [I will hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 25 \w The wolf| strong="H2061" \w* \w and the lamb| strong="H2924" \w* [shall feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} \w together| strong="H259" \w*, \w and the lion| strong="H738" \w* [shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w straw| strong="H8401" \w* \w like the bullock| strong="H1241" \w*: \w and dust| strong="H6083" \w* shall be [the serpent’s]{strong=“H5175”} \w meat| strong="H3899" \w*. [They shall not hurt]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8686”} [nor destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8686”} \w in all my holy| strong="H6944" \w* \w mountain| strong="H2022" \w*, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*.
\c 66
\p 
\v 1 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w The heaven| strong="H8064" \w* is \w my throne| strong="H3678" \w*, \w and the earth| strong="H776" \w* is [my footstool]{strong=“H1916 H7272”}: where is \w the house| strong="H1004" \w* [that ye build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} unto me? and where is \w the place| strong="H4725" \w* \w of my rest| strong="H4496" \w*? 
\v 2 For all those things \w hath mine hand| strong="H3027" \w* [made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, and all those things [have been, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*: but to this man [will I look]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”}, even to him that is \w poor| strong="H6041" \w* \w and of a contrite| strong="H5223" \w* \w spirit| strong="H7307" \w*, \w and trembleth| strong="H2730" \w* \w at my word| strong="H1697" \w*. 
\v 3 [He that killeth]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8802”} \w an ox| strong="H7794" \w* is as if [he slew]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8688”} \w a man| strong="H376" \w*; [he that sacrificeth]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8802”} \w a lamb| strong="H7716" \w*, as if \w he cut off| strong="H6202" \w* [a dog’s]{strong=“H3611”} [neck]{strong=“H6202” x-morph=“strongMorph: \sc Th\sc*8802”}; [he that offereth]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8688”} \w an oblation| strong="H4503" \w*, as if he offered [swine’s]{strong=“H2386”} \w blood| strong="H1818" \w*; [he that burneth]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8688”} \w incense| strong="H3828" \w*, as if [he blessed]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8764”} \w an idol| strong="H205" \w*. [Yea, they have chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} \w their own ways| strong="H1870" \w*, \w and their soul| strong="H5315" \w* [delighteth]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} \w in their abominations| strong="H8251" \w*.\f + \fr 66:3 \ft lamb: or, kid \f* \f + \fr 66:3 \ft burneth: Heb. maketh a memorial of \f* 
\v 4 [I also will choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} \w their delusions| strong="H8586" \w*, [and will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w their fears| strong="H4035" \w* [upon them; because when I called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”}, [none did answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8802”}; [when I spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}, [they did not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}: [but they did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w evil| strong="H7451" \w* \w before mine eyes| strong="H5869" \w*, [and chose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} that [in which I delighted]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} not.\f + \fr 66:4 \ft delusions: or, devices \f* 
\p
\v 5 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* of the \sc Lord\sc*, \w ye that tremble| strong="H2730" \w* \w at his word| strong="H1697" \w*; \w Your brethren| strong="H251" \w* [that hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} [you, that cast you out]{strong=“H5077” x-morph=“strongMorph: \sc Th\sc*8764”} [for my name’s]{strong=“H8034”} [sake, said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, Let the \sc Lord\sc* [be glorified]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8799”}: [but he shall appear]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8737”} \w to your joy| strong="H8057" \w*, [and they shall be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 6 \w A voice| strong="H6963" \w* \w of noise| strong="H7588" \w* \w from the city| strong="H5892" \w*, \w a voice| strong="H6963" \w* \w from the temple| strong="H1964" \w*, \w a voice| strong="H6963" \w* of the \sc Lord\sc* [that rendereth]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8764”} \w recompence| strong="H1576" \w* [to his enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 7 [Before she travailed]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8799”}, [she brought forth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”}; \w before her pain| strong="H2256" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [she was delivered]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8689”} \w of a man child| strong="H2145" \w*. 
\v 8 [Who hath heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [such a thing? who hath seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} [such things? Shall the earth]{strong=“H776”} [be made to bring forth]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8714”} \w in one| strong="H259" \w* \w day| strong="H3117" \w*? or \w shall a nation| strong="H1471" \w* [be born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8735”} \w at once| strong="H6471" \w*? \w for as soon as| strong="H1571" \w* \w Zion| strong="H6726" \w* [travailed]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8804”}, [she brought forth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} \w her children| strong="H1121" \w*. 
\v 9 [Shall I bring to the birth]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8686”}, [and not cause to bring forth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8686”}? [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc*: \w shall I| strong="H589" \w* [cause to bring forth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8688”}, [and shut]{strong=“H6113” x-morph=“strongMorph: \sc Th\sc*8804”} the womb? [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy God| strong="H430" \w*.\f + \fr 66:9 \ft not…: or, not beget? \f* 
\v 10 [Rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye with Jerusalem| strong="H3389" \w*, [and be glad]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8798”} [with her, all ye that love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8802”} [her: rejoice]{strong=“H7797” x-morph=“strongMorph: \sc Th\sc*8798”} \w for joy| strong="H4885" \w* [with her, all ye that mourn]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8693”} for her: 
\v 11 [That ye may suck]{strong=“H3243” x-morph=“strongMorph: \sc Th\sc*8799”}, [and be satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8804”} \w with the breasts| strong="H7699" \w* \w of her consolations| strong="H8575" \w*; [that ye may milk out]{strong=“H4711” x-morph=“strongMorph: \sc Th\sc*8799”}, [and be delighted]{strong=“H6026” x-morph=“strongMorph: \sc Th\sc*8694”} \w with the abundance| strong="H2123" \w* \w of her glory| strong="H3519" \w*.\f + \fr 66:11 \ft abundance: or, brightness \f* 
\v 12 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [Behold, I will extend]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8802”} \w peace| strong="H7965" \w* \w to her like a river| strong="H5104" \w*, \w and the glory| strong="H3519" \w* \w of the Gentiles| strong="H1471" \w* [like a flowing]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8802”} \w stream| strong="H5158" \w*: [then shall ye suck]{strong=“H3243” x-morph=“strongMorph: \sc Th\sc*8804”}, [ye shall be borne]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8735”} upon her \w sides| strong="H6654" \w*, [and be dandled]{strong=“H8173” x-morph=“strongMorph: \sc Th\sc*8746”} upon her \w knees| strong="H1290" \w*. 
\v 13 \w As one| strong="H376" \w* \w whom his mother| strong="H517" \w* [comforteth]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8762”}, [so will I comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8762”} [you; and ye shall be comforted]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8792”} \w in Jerusalem| strong="H3389" \w*. 
\v 14 [And when ye see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} this, \w your heart| strong="H3820" \w* [shall rejoice]{strong=“H7797” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and your bones| strong="H6106" \w* [shall flourish]{strong=“H6524” x-morph=“strongMorph: \sc Th\sc*8799”} \w like an herb| strong="H1877" \w*: \w and the hand| strong="H3027" \w* of the \sc Lord\sc* [shall be known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8738”} \w toward his servants| strong="H5650" \w*, and his [indignation]{strong=“H2194” x-morph=“strongMorph: \sc Th\sc*8804”} [toward his enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\p
\v 15 For, behold, the \sc Lord\sc* [will come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w with fire| strong="H784" \w*, \w and with his chariots| strong="H4818" \w* \w like a whirlwind| strong="H5492" \w*, [to render]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} \w his anger| strong="H639" \w* \w with fury| strong="H2534" \w*, \w and his rebuke| strong="H1606" \w* \w with flames| strong="H3851" \w* \w of fire| strong="H784" \w*. 
\v 16 \w For by fire| strong="H784" \w* \w and by his sword| strong="H2719" \w* will the \sc Lord\sc* [plead]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8737”} \w with all flesh| strong="H1320" \w*: \w and the slain| strong="H2491" \w* of the \sc Lord\sc* [shall be many]{strong=“H7231” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 17 [They that sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8693”} [themselves, and purify]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8693”} \w themselves in the gardens| strong="H1593" \w* \w behind| strong="H310" \w* \w one| strong="H259" \w* tree \w in the midst| strong="H8432" \w*, [eating ]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} [swine’s]{strong=“H2386”} \w flesh| strong="H1320" \w*, \w and the abomination| strong="H8263" \w*, \w and the mouse| strong="H5909" \w*, [shall be consumed]{strong=“H5486” x-morph=“strongMorph: \sc Th\sc*8799”} \w together| strong="H3162" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*.\f + \fr 66:17 \ft behind…: or, one after another \f* 
\v 18 For I know \w their works| strong="H4639" \w* \w and their thoughts| strong="H4284" \w*: [it shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”}, [that I will gather]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8763”} \w all nations| strong="H1471" \w* \w and tongues| strong="H3956" \w*; [and they shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w my glory| strong="H3519" \w*. 
\v 19 [And I will set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w a sign| strong="H226" \w* [among them, and I will send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w those that escape| strong="H6412" \w* \w of them unto the nations| strong="H1471" \w*, to \w Tarshish| strong="H8659" \w*, \w Pul| strong="H6322" \w*, \w and Lud| strong="H3865" \w*, [that draw]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8802”} \w the bow| strong="H7198" \w*, to \w Tubal| strong="H8422" \w*, \w and Javan| strong="H3120" \w*, to \w the isles| strong="H339" \w* \w afar off| strong="H7350" \w*, [that have not heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w my fame| strong="H8088" \w*, [neither have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w my glory| strong="H3519" \w*; [and they shall declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} \w my glory| strong="H3519" \w* \w among the Gentiles| strong="H1471" \w*. 
\v 20 [And they shall bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w all your brethren| strong="H251" \w* for \w an offering| strong="H4503" \w* unto the \sc Lord\sc* \w out of all nations| strong="H1471" \w* \w upon horses| strong="H5483" \w*, \w and in chariots| strong="H7393" \w*, \w and in litters| strong="H6632" \w*, \w and upon mules| strong="H6505" \w*, \w and upon swift beasts| strong="H3753" \w*, \w to my holy| strong="H6944" \w* \w mountain| strong="H2022" \w* \w Jerusalem| strong="H3389" \w*, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, \w as the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w an offering| strong="H4503" \w* \w in a clean| strong="H2889" \w* \w vessel| strong="H3627" \w* \w into the house| strong="H1004" \w* of the \sc Lord\sc*.\f + \fr 66:20 \ft litters: or, coaches \f* 
\v 21 [And I will also take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w of them for priests| strong="H3548" \w* and \w for Levites| strong="H3881" \w*, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*. 
\v 22 \w For as the new| strong="H2319" \w* \w heavens| strong="H8064" \w* \w and the new| strong="H2319" \w* \w earth| strong="H776" \w*, [which I will make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”}, [shall remain]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w before| strong="H6440" \w* [me, saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, \w so shall your seed| strong="H2233" \w* \w and your name| strong="H8034" \w* [remain]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 23 And it shall come to pass, that \w from| strong="H1767" \w* \w one new moon| strong="H2320" \w* \w to another| strong="H2320" \w*, \w and from| strong="H1767" \w* \w one sabbath| strong="H7676" \w* \w to another| strong="H7676" \w*, \w shall all flesh| strong="H1320" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [to worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8692”} \w before| strong="H6440" \w* [me, saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*.\f + \fr 66:23 \ft from one new…: Heb. from new moon to his new moon, and from sabbath to his sabbath \f* 
\v 24 [And they shall go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”}, [and look]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon the carcases| strong="H6297" \w* \w of the men| strong="H582" \w* [that have transgressed]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8802”} [against me: for their worm]{strong=“H8438”} [shall not die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, \w neither shall their fire| strong="H784" \w* [be quenched]{strong=“H3518” x-morph=“strongMorph: \sc Th\sc*8799”}; \w and they shall be an abhorring| strong="H1860" \w* \w unto all flesh| strong="H1320" \w*. 
