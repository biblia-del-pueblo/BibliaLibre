\v 3 [I have commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [my sanctified ones]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8794”}, [I have also called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w my mighty ones| strong="H1368" \w* \w for mine anger| strong="H639" \w*, even \w them that rejoice| strong="H5947" \w* \w in my highness| strong="H1346" \w*. 
\v 4 \w The noise| strong="H6963" \w* \w of a multitude| strong="H1995" \w* \w in the mountains| strong="H2022" \w*, \w like as| strong="H1823" \w* \w of a great| strong="H7227" \w* \w people| strong="H5971" \w*; \w a tumultuous| strong="H7588" \w* \w noise| strong="H6963" \w* \w of the kingdoms| strong="H4467" \w* \w of nations| strong="H1471" \w* [gathered together]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8737”}: the \sc Lord\sc* \w of hosts| strong="H6635" \w* [mustereth]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8764”} \w the host| strong="H6635" \w* \w of the battle| strong="H4421" \w*.\f + \fr 13:4 \ft like…: Heb. the likeness of \f* 
\v 5 [They come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w from a far| strong="H4801" \w* \w country| strong="H776" \w*, \w from the end| strong="H7097" \w* \w of heaven| strong="H8064" \w*, even the \sc Lord\sc*, \w and the weapons| strong="H3627" \w* \w of his indignation| strong="H2195" \w*, [to destroy]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8763”} \w the whole land| strong="H776" \w*. 
\p
\v 6 [Howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8685”} [ye; for the day]{strong=“H3117”} of the \sc Lord\sc* is \w at hand| strong="H7138" \w*; [it shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w as a destruction| strong="H7701" \w* \w from the Almighty| strong="H7706" \w*. 
\v 7 \w Therefore shall all hands| strong="H3027" \w* [be faint]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8799”}, [and every man’s]{strong=“H582”} \w heart| strong="H3824" \w* [shall melt]{strong=“H4549” x-morph=“strongMorph: \sc Th\sc*8735”}:\f + \fr 13:7 \ft be faint: or, fall down \f* 
\v 8 [And they shall be afraid]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8738”}: \w pangs| strong="H6735" \w* \w and sorrows| strong="H2256" \w* [shall take hold]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8799”} [of them; they shall be in pain]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8799”} [as a woman that travaileth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”}: [they shall be amazed]{strong=“H8539” x-morph=“strongMorph: \sc Th\sc*8799”} \w one| strong="H376" \w* \w at another| strong="H7453" \w*; \w their faces| strong="H6440" \w* shall be as \w flames| strong="H3851" \w*.\f + \fr 13:8 \ft be amazed: Heb. wonder \f* \f + \fr 13:8 \ft one…: Heb. every man at his neighbour \f* \f + \fr 13:8 \ft flames: Heb. faces of the flames \f* 
\v 9 [Behold, the day]{strong=“H3117”} of the \sc Lord\sc* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, \w cruel| strong="H394" \w* \w both with wrath| strong="H5678" \w* \w and fierce| strong="H2740" \w* \w anger| strong="H639" \w*, [to lay]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w the land| strong="H776" \w* \w desolate| strong="H8047" \w*: [and he shall destroy]{strong=“H8045” x-morph=“strongMorph: \sc Th\sc*8686”} \w the sinners| strong="H2400" \w* thereof out of it. 
\v 10 \w For the stars| strong="H3556" \w* \w of heaven| strong="H8064" \w* \w and the constellations| strong="H3685" \w* [thereof shall not give]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8686”} \w their light| strong="H216" \w*: \w the sun| strong="H8121" \w* [shall be darkened]{strong=“H2821” x-morph=“strongMorph: \sc Th\sc*8804”} [in his going forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”}, \w and the moon| strong="H3394" \w* \w shall not cause her light| strong="H216" \w* [to shine]{strong=“H5050” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 11 [And I will punish]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} \w the world| strong="H8398" \w* for their \w evil| strong="H7451" \w*, \w and the wicked| strong="H7563" \w* \w for their iniquity| strong="H5771" \w*; \w and I will cause the arrogancy| strong="H1347" \w* \w of the proud| strong="H2086" \w* [to cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8689”}, [and will lay low]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8686”} \w the haughtiness| strong="H1346" \w* \w of the terrible| strong="H6184" \w*. 
\v 12 \w I will make a man| strong="H582" \w* [more precious]{strong=“H3365” x-morph=“strongMorph: \sc Th\sc*8686”} \w than fine gold| strong="H6337" \w*; \w even a man| strong="H120" \w* \w than the golden wedge| strong="H3800" \w* \w of Ophir| strong="H211" \w*. 
\v 13 [Therefore I will shake]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8686”} \w the heavens| strong="H8064" \w*, \w and the earth| strong="H776" \w* [shall remove]{strong=“H7493” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of her place| strong="H4725" \w*, \w in the wrath| strong="H5678" \w* of the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w and in the day| strong="H3117" \w* \w of his fierce| strong="H2740" \w* \w anger| strong="H639" \w*. 
\v 14 [And it shall be as the chased]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8716”} \w roe| strong="H6643" \w*, \w and as a sheep| strong="H6629" \w* [that no man taketh up]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8764”}: \w they shall every man| strong="H376" \w* [turn]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8799”} \w to his own people| strong="H5971" \w*, [and flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”} \w every one| strong="H376" \w* \w into his own land| strong="H776" \w*. 
\v 15 [Every one that is found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8737”} [shall be thrust through]{strong=“H1856” x-morph=“strongMorph: \sc Th\sc*8735”}; [and every one that is joined]{strong=“H5595” x-morph=“strongMorph: \sc Th\sc*8737”} unto them [shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H2719" \w*. 
\v 16 \w Their children| strong="H5768" \w* [also shall be dashed to pieces]{strong=“H7376” x-morph=“strongMorph: \sc Th\sc*8792”} \w before their eyes| strong="H5869" \w*; \w their houses| strong="H1004" \w* [shall be spoiled]{strong=“H8155” x-morph=“strongMorph: \sc Th\sc*8735”}, \w and their wives| strong="H802" \w* [ravished]{strong=“H7693 H7901” x-morph=“strongMorph: \sc Th\sc*8735 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8735”}. 
\v 17 [Behold, I will stir up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8688”} \w the Medes| strong="H4074" \w* [against them, which shall not regard]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8799”} \w silver| strong="H3701" \w*; and as for \w gold| strong="H2091" \w*, [they shall not delight]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8799”} in it. 
\v 18 Their \w bows| strong="H7198" \w* \w also shall dash| strong="H7376" \w* \w the young men| strong="H5288" \w* [to pieces]{strong=“H7376” x-morph=“strongMorph: \sc Th\sc*8762”}; [and they shall have no pity]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8762”} \w on the fruit| strong="H6529" \w* \w of the womb| strong="H990" \w*; \w their eye| strong="H5869" \w* [shall not spare]{strong=“H2347” x-morph=“strongMorph: \sc Th\sc*8799”} \w children| strong="H1121" \w*. 
\p
\v 19 \w And Babylon| strong="H894" \w*, \w the glory| strong="H6643" \w* \w of kingdoms| strong="H4467" \w*, \w the beauty| strong="H8597" \w* [of the Chaldees’]{strong=“H3778”} \w excellency| strong="H1347" \w*, \w shall be as when God| strong="H430" \w* \w overthrew| strong="H4114" \w* \w Sodom| strong="H5467" \w* \w and Gomorrah| strong="H6017" \w*.\f + \fr 13:19 \ft as…: Heb. as the overthrowing \f* 
\v 20 \w It shall never| strong="H5331" \w* [be inhabited]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”}, [neither shall it be dwelt]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} \w in from generation| strong="H1755" \w* \w to generation| strong="H1755" \w*: \w neither shall the Arabian| strong="H6163" \w* [pitch tent]{strong=“H167” x-morph=“strongMorph: \sc Th\sc*8762”} [there; neither shall the shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [make their fold]{strong=“H7257” x-morph=“strongMorph: \sc Th\sc*8686”} there. 
