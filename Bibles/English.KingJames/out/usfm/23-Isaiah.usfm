\v 2 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O heavens| strong="H8064" \w*, [and give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”}, \w O earth| strong="H776" \w*: for the \sc Lord\sc* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}, [I have nourished]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8765”} [and brought up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8790”} \w children| strong="H1121" \w*, [and they have rebelled]{strong=“H6586” x-morph=“strongMorph: \sc Th\sc*8804”} against me. 
\v 3 \w The ox| strong="H7794" \w* [knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [his owner]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and the ass| strong="H2543" \w* [his master’s]{strong=“H1167”} \w crib| strong="H18" \w*: but \w Israel| strong="H3478" \w* [doth not know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}, \w my people| strong="H5971" \w* [doth not consider]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8712”}. 
\v 4 \w Ah| strong="H1945" \w* [sinful]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8802”} \w nation| strong="H1471" \w*, \w a people| strong="H5971" \w* \w laden| strong="H3515" \w* \w with iniquity| strong="H5771" \w*, \w a seed| strong="H2233" \w* [of evildoers]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8688”}, \w children| strong="H1121" \w* [that are corrupters]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8688”}: [they have forsaken]{strong=“H853 H5800” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [they have provoked]{strong=“H853 H5006”} \w the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w* [unto anger]{strong=“H5006” x-morph=“strongMorph: \sc Th\sc*8765”}, [they are gone away]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8738”} \w backward| strong="H268" \w*.\f + \fr 1:4 \ft laden: Heb. of heaviness \f* \f + \fr 1:4 \ft gone…: Heb. alienated, or, separated \f* 
\p
\v 5 [Why should ye be stricken]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8714”} [any more? ye will revolt]{strong=“H5627”} [more and more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”}: \w the whole head| strong="H7218" \w* \w is sick| strong="H2483" \w*, \w and the whole heart| strong="H3824" \w* \w faint| strong="H1742" \w*.\f + \fr 1:5 \ft revolt…: Heb. increase revolt \f* 
\v 6 \w From the sole| strong="H3709" \w* \w of the foot| strong="H7272" \w* \w even unto the head| strong="H7218" \w* there is \w no soundness| strong="H4974" \w* in it; but \w wounds| strong="H6482" \w*, \w and bruises| strong="H2250" \w*, \w and putrifying| strong="H2961" \w* \w sores| strong="H4347" \w*: [they have not been closed]{strong=“H2115” x-morph=“strongMorph: \sc Th\sc*8804”}, [neither bound up]{strong=“H2280” x-morph=“strongMorph: \sc Th\sc*8795”}, [neither mollified]{strong=“H7401” x-morph=“strongMorph: \sc Th\sc*8795”} \w with ointment| strong="H8081" \w*.\f + \fr 1:6 \ft ointment: or, oil \f* 
\v 7 \w Your country| strong="H776" \w* is \w desolate| strong="H8077" \w*, \w your cities| strong="H5892" \w* are [burned]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8803”} \w with fire| strong="H784" \w*: \w your land| strong="H127" \w*, [strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} [devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} it in your presence, and it is \w desolate| strong="H8077" \w*, \w as overthrown| strong="H4114" \w* [by strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”}.\f + \fr 1:7 \ft overthrown…: Heb. the overthrow of \f* 
