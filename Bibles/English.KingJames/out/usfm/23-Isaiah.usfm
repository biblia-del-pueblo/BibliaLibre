\p
\v 11 \w Woe| strong="H1945" \w* [unto them that rise up early]{strong=“H7925” x-morph=“strongMorph: \sc Th\sc*8688”} \w in the morning| strong="H1242" \w*, that [they may follow]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} \w strong drink| strong="H7941" \w*; [that continue]{strong=“H309” x-morph=“strongMorph: \sc Th\sc*8764”} \w until night| strong="H5399" \w*, till \w wine| strong="H3196" \w* [inflame]{strong=“H1814” x-morph=“strongMorph: \sc Th\sc*8686”} them!\f + \fr 5:11 \ft inflame: of, pursue \f* 
\v 12 \w And the harp| strong="H3658" \w*, \w and the viol| strong="H5035" \w*, \w the tabret| strong="H8596" \w*, \w and pipe| strong="H2485" \w*, \w and wine| strong="H3196" \w*, \w are in their feasts| strong="H4960" \w*: [but they regard]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”} \w not the work| strong="H6467" \w* of the \sc Lord\sc*, [neither consider]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the operation| strong="H4639" \w* \w of his hands| strong="H3027" \w*. 
\p
\v 13 \w Therefore my people| strong="H5971" \w* [are gone into captivity]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8804”}, because they have \w no knowledge| strong="H1847" \w*: \w and their honourable| strong="H3519" \w* \w men| strong="H4962" \w* are \w famished| strong="H7458" \w*, \w and their multitude| strong="H1995" \w* \w dried up| strong="H6704" \w* \w with thirst| strong="H6772" \w*.\f + \fr 5:13 \ft honourable…: Heb. glory are men of famine \f* 
\v 14 \w Therefore hell| strong="H7585" \w* [hath enlarged]{strong=“H7337” x-morph=“strongMorph: \sc Th\sc*8689”} \w herself| strong="H5315" \w*, [and opened]{strong=“H6473” x-morph=“strongMorph: \sc Th\sc*8804”} \w her mouth| strong="H6310" \w* \w without measure| strong="H2706" \w*: \w and their glory| strong="H1926" \w*, \w and their multitude| strong="H1995" \w*, \w and their pomp| strong="H7588" \w*, \w and he that rejoiceth| strong="H5938" \w*, [shall descend]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} into it. 
\v 15 \w And the mean man| strong="H120" \w* [shall be brought down]{strong=“H7817” x-morph=“strongMorph: \sc Th\sc*8735”}, \w and the mighty man| strong="H376" \w* [shall be humbled]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the eyes| strong="H5869" \w* \w of the lofty| strong="H1364" \w* [shall be humbled]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8799”}: 
\v 16 But the \sc Lord\sc* \w of hosts| strong="H6635" \w* [shall be exalted]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8799”} \w in judgment| strong="H4941" \w*, \w and God| strong="H410" \w* \w that is holy| strong="H6918" \w* [shall be sanctified]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8738”} \w in righteousness| strong="H6666" \w*.\f + \fr 5:16 \ft God…: or, the holy God: Heb. the God the holy \f* 
\v 17 \w Then shall the lambs| strong="H3532" \w* [feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8804”} \w after their manner| strong="H1699" \w*, \w and the waste places| strong="H2723" \w* \w of the fat ones| strong="H4220" \w* [shall strangers]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8802”} [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 18 \w Woe| strong="H1945" \w* [unto them that draw]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8802”} \w iniquity| strong="H5771" \w* \w with cords| strong="H2256" \w* \w of vanity| strong="H7723" \w*, \w and sin| strong="H2403" \w* \w as it were with a cart| strong="H5699" \w* \w rope| strong="H5688" \w*: 
\v 19 [That say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, [Let him make speed]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8762”}, and [hasten]{strong=“H2363” x-morph=“strongMorph: \sc Th\sc*8686”} \w his work| strong="H4639" \w*, [that we may see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} it: \w and let the counsel| strong="H6098" \w* \w of the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w* [draw nigh]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} [and come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [that we may know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} it! 
\p
\v 20 \w Woe| strong="H1945" \w* [unto them that call]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} \w evil| strong="H7451" \w* \w good| strong="H2896" \w*, \w and good| strong="H2896" \w* \w evil| strong="H7451" \w*; [that put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8802”} \w darkness| strong="H2822" \w* \w for light| strong="H216" \w*, \w and light| strong="H216" \w* \w for darkness| strong="H2822" \w*; [that put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8802”} \w bitter| strong="H4751" \w* \w for sweet| strong="H4966" \w*, \w and sweet| strong="H4966" \w* \w for bitter| strong="H4751" \w*!\f + \fr 5:20 \ft call…: Heb. say concerning evil, It is good, etc \f* 
\v 21 \w Woe| strong="H1945" \w* unto them that are \w wise| strong="H2450" \w* \w in their own eyes| strong="H5869" \w*, [and prudent]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8737”} \w in their own sight| strong="H6440" \w*!\f + \fr 5:21 \ft in their own sight: Heb. before their face \f* 
\v 22 \w Woe| strong="H1945" \w* unto them that are \w mighty| strong="H1368" \w* [to drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”} \w wine| strong="H3196" \w*, \w and men| strong="H582" \w* \w of strength| strong="H2428" \w* [to mingle]{strong=“H4537” x-morph=“strongMorph: \sc Th\sc*8800”} \w strong drink| strong="H7941" \w*: 
\v 23 [Which justify]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8688”} \w the wicked| strong="H7563" \w* \w for| strong="H6118" \w* \w reward| strong="H7810" \w*, [and take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8686”} \w the righteousness| strong="H6666" \w* \w of the righteous| strong="H6662" \w* from him! 
\v 24 \w Therefore as the fire| strong="H784" \w* [devoureth ]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} \w the stubble| strong="H7179" \w*, [and the flame]{strong=“H3852 H3956”} [consumeth]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8799”} \w the chaff| strong="H2842" \w*, so \w their root| strong="H8328" \w* \w shall be as rottenness| strong="H4716" \w*, \w and their blossom| strong="H6525" \w* [shall go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w as dust| strong="H80" \w*: [because they have cast away]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} \w the law| strong="H8451" \w* of the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [and despised]{strong=“H5006” x-morph=“strongMorph: \sc Th\sc*8765”} \w the word| strong="H565" \w* \w of the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w*.\f + \fr 5:24 \ft fire: Heb. tongue of fire \f* 
\v 25 \w Therefore is the anger| strong="H639" \w* of the \sc Lord\sc* [kindled]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8804”} \w against his people| strong="H5971" \w*, [and he hath stretched forth]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8799”} \w his hand| strong="H3027" \w* [against them, and hath smitten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} [them: and the hills]{strong=“H2022”} [did tremble]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and their carcases| strong="H5038" \w* were \w torn| strong="H5478" \w* \w in the midst| strong="H7130" \w* \w of the streets| strong="H2351" \w*. \w For all this his anger| strong="H639" \w* [is not turned away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”}, \w but his hand| strong="H3027" \w* is [stretched out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8803”} still.\f + \fr 5:25 \ft torn: or, as dung \f* 
\p
\v 26 [And he will lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w an ensign| strong="H5251" \w* \w to the nations| strong="H1471" \w* \w from far| strong="H7350" \w*, [and will hiss]{strong=“H8319” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto them from the end| strong="H7097" \w* \w of the earth| strong="H776" \w*: [and, behold, they shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w with speed| strong="H4120" \w* \w swiftly| strong="H7031" \w*: 
\v 27 \w None shall be weary| strong="H5889" \w* [nor stumble]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8802”} [among them; none shall slumber]{strong=“H5123” x-morph=“strongMorph: \sc Th\sc*8799”} [nor sleep]{strong=“H3462” x-morph=“strongMorph: \sc Th\sc*8799”}; \w neither shall the girdle| strong="H232" \w* \w of their loins| strong="H2504" \w* [be loosed]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8738”}, \w nor the latchet| strong="H8288" \w* \w of their shoes| strong="H5275" \w* [be broken]{strong=“H5423” x-morph=“strongMorph: \sc Th\sc*8738”}: 
\v 28 \w Whose arrows| strong="H2671" \w* are [sharp]{strong=“H8150” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and all their bows| strong="H7198" \w* [bent]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8803”}, [their horses’]{strong=“H5483”} \w hoofs| strong="H6541" \w* [shall be counted]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8738”} \w like flint| strong="H6862" \w*, \w and their wheels| strong="H1534" \w* \w like a whirlwind| strong="H5492" \w*: 
\v 29 \w Their roaring| strong="H7581" \w* shall be \w like a lion| strong="H3833" \w*, [they shall roar]{strong=“H7580 H7580” x-morph=“strongMorph: \sc Th\sc*8804 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8799”} \w like young lions| strong="H3715" \w*: [yea, they shall roar]{strong=“H5098” x-morph=“strongMorph: \sc Th\sc*8799”}, [and lay hold]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the prey| strong="H2964" \w*, and shall carry it [away safe]{strong=“H6403” x-morph=“strongMorph: \sc Th\sc*8686”}, [and none shall deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8688”} it. 
\v 30 \w And in that day| strong="H3117" \w* [they shall roar]{strong=“H5098” x-morph=“strongMorph: \sc Th\sc*8799”} \w against them like the roaring| strong="H5100" \w* \w of the sea| strong="H3220" \w*: and if one [look]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto the land| strong="H776" \w*, \w behold darkness| strong="H2822" \w* and \w sorrow| strong="H6862" \w*, \w and the light| strong="H216" \w* [is darkened]{strong=“H2821” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the heavens| strong="H6183" \w* thereof.\f + \fr 5:30 \ft sorrow: or, distress \f* \f + \fr 5:30 \ft and the light…: or, when it is light, it shall be dark in the destructions thereof \f*
\c 6
\p 
\v 1 \w In the year| strong="H8141" \w* \w that king| strong="H4428" \w* \w Uzziah| strong="H5818" \w* \w died| strong="H4194" \w* [I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w also| strong="H853" \w* \w the Lord| strong="H136" \w* [sitting]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon a throne| strong="H3678" \w*, [high]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8802”} [and lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8737”}, \w and his train| strong="H7757" \w* [filled]{strong=“H853 H4392”} \w the temple| strong="H1964" \w*.\f + \fr 6:1 \ft his…: or, the skirts thereof \f* 
\v 2 \w Above| strong="H4605" \w* [it stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8802”} \w the seraphims| strong="H8314" \w*: \w each one| strong="H259" \w* \w had six| strong="H8337" \w* \w wings| strong="H3671" \w*; \w with twain| strong="H8147" \w* [he covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w his face| strong="H6440" \w*, \w and with twain| strong="H8147" \w* [he covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w his feet| strong="H7272" \w*, \w and with twain| strong="H8147" \w* [he did fly]{strong=“H5774” x-morph=“strongMorph: \sc Th\sc*8787”}. 
\v 3 [And one cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} [unto another, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Holy| strong="H6918" \w*, \w holy| strong="H6918" \w*, \w holy| strong="H6918" \w*, is the \sc Lord\sc* \w of hosts| strong="H6635" \w*: \w the whole earth| strong="H776" \w* is \w full| strong="H4393" \w* \w of his glory| strong="H3519" \w*.\f + \fr 6:3 \ft one…: Heb. this cried to this \f* \f + \fr 6:3 \ft the whole…: Heb. his glory is the fulness of the whole earth \f* 
\v 4 \w And the posts| strong="H520" \w* \w of the door| strong="H5592" \w* [moved]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8799”} \w at the voice| strong="H6963" \w* [of him that cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and the house| strong="H1004" \w* [was filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”} \w with smoke| strong="H6227" \w*.\f + \fr 6:4 \ft door: Heb. thresholds \f* 
\p
\v 5 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [I, Woe]{strong=“H188”} is [me! for I am undone]{strong=“H1820” x-morph=“strongMorph: \sc Th\sc*8738”}; because I am \w a man| strong="H376" \w* \w of unclean| strong="H2931" \w* \w lips| strong="H8193" \w*, [and I dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the midst| strong="H8432" \w* \w of a people| strong="H5971" \w* \w of unclean| strong="H2931" \w* \w lips| strong="H8193" \w*: \w for mine eyes| strong="H5869" \w* [have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the King| strong="H4428" \w*, the \sc Lord\sc* \w of hosts| strong="H6635" \w*.\f + \fr 6:5 \ft undone: Heb. cut off \f* 
\v 6 [Then flew]{strong=“H5774” x-morph=“strongMorph: \sc Th\sc*8799”} \w one| strong="H259" \w* \w of the seraphims| strong="H8314" \w* [unto me, having a live coal]{strong=“H7531”} \w in his hand| strong="H3027" \w*, which [he had taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w with the tongs| strong="H4457" \w* \w from off the altar| strong="H4196" \w*:\f + \fr 6:6 \ft having…: Heb. and in his hand a live coal \f* 
\v 7 [And he laid]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8686”} it \w upon my mouth| strong="H6310" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Lo, this hath touched]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy lips| strong="H8193" \w*; \w and thine iniquity| strong="H5771" \w* [is taken away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and thy sin| strong="H2403" \w* [purged]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8792”}.\f + \fr 6:7 \ft laid…: Heb. caused it to touch \f* 
\v 8 [Also I heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w the voice| strong="H6963" \w* \w of the Lord| strong="H136" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”}, [Whom shall I send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”}, [and who will go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [for us? Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} I, Here am [I; send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8798”} me.\f + \fr 6:8 \ft Here…: Heb. behold me \f* 
\p
\v 9 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [and tell]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w this people| strong="H5971" \w*, [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [ye indeed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”}, [but understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} [not; and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} [ye indeed]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”}, [but perceive]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} not.\f + \fr 6:9 \ft indeed, but understand: or, without ceasing, etc: Heb. in hearing, etc \f* 
\v 10 \w Make the heart| strong="H3820" \w* \w of this people| strong="H5971" \w* [fat]{strong=“H8080” x-morph=“strongMorph: \sc Th\sc*8685”}, \w and make their ears| strong="H241" \w* [heavy]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8685”}, [and shut]{strong=“H8173” x-morph=“strongMorph: \sc Th\sc*8685”} \w their eyes| strong="H5869" \w*; [lest they see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w with their eyes| strong="H5869" \w*, [and hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w with their ears| strong="H241" \w*, [and understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} \w with their heart| strong="H3824" \w*, [and convert]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8802”}, [and be healed]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 11 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [I, Lord]{strong=“H136”}, [how long? And he answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Until the cities| strong="H5892" \w* [be wasted]{strong=“H7582” x-morph=“strongMorph: \sc Th\sc*8804”} [without inhabitant]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and the houses| strong="H1004" \w* \w without man| strong="H120" \w*, \w and the land| strong="H127" \w* \w be utterly| strong="H8077" \w* [desolate]{strong=“H7582” x-morph=“strongMorph: \sc Th\sc*8735”},\f + \fr 6:11 \ft utterly…: Heb. desolate with desolation \f* 
\v 12 And the \sc Lord\sc* \w have removed| strong="H7368" \w* \w men| strong="H120" \w* [far away]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8765”}, and there be \w a great| strong="H7227" \w* \w forsaking| strong="H5805" \w* \w in the midst| strong="H7130" \w* \w of the land| strong="H776" \w*. 
\p
\v 13 But yet in it shall be \w a tenth| strong="H6224" \w*, and it [shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”}, [and shall be eaten]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8763”}: \w as a teil tree| strong="H424" \w*, \w and as an oak| strong="H437" \w*, \w whose substance| strong="H4678" \w* is [in them, when they cast]{strong=“H7995”} their leaves: so \w the holy| strong="H6944" \w* \w seed| strong="H2233" \w* shall be \w the substance| strong="H4678" \w* thereof.\f + \fr 6:13 \ft and it…: or, when it is returned, and hath been broused \f* \f + \fr 6:13 \ft substance: or, stock, or, stem \f*
\c 7
\p 
\v 1 \w And it came to pass in the days| strong="H3117" \w* \w of Ahaz| strong="H271" \w* \w the son| strong="H1121" \w* \w of Jotham| strong="H3147" \w*, \w the son| strong="H1121" \w* \w of Uzziah| strong="H5818" \w*, \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w*, that \w Rezin| strong="H7526" \w* \w the king| strong="H4428" \w* \w of Syria| strong="H758" \w*, \w and Pekah| strong="H6492" \w* \w the son| strong="H1121" \w* \w of Remaliah| strong="H7425" \w*, \w king| strong="H4428" \w* \w of Israel| strong="H3478" \w*, [went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w toward Jerusalem| strong="H3389" \w* \w to war| strong="H4421" \w* [against it, but could]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8804”} [not prevail]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8736”} against it. 
\v 2 [And it was told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8714”} \w the house| strong="H1004" \w* \w of David| strong="H1732" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Syria| strong="H758" \w* [is confederate]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8804”} \w with Ephraim| strong="H669" \w*. \w And his heart| strong="H3824" \w* [was moved]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the heart| strong="H3824" \w* \w of his people| strong="H5971" \w*, \w as the trees| strong="H6086" \w* \w of the wood| strong="H3293" \w* [are moved]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8800”} \w with| strong="H6440" \w* \w the wind| strong="H7307" \w*.\f + \fr 7:2 \ft is confederate…: Heb. resteth on \f* 
\v 3 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc* \w unto Isaiah| strong="H3470" \w*, [Go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8798”} [now to meet]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} \w Ahaz| strong="H271" \w*, [thou, and Shear-jashub]{strong=“H7610”} \w thy son| strong="H1121" \w*, \w at the end| strong="H7097" \w* \w of the conduit| strong="H8585" \w* \w of the upper| strong="H5945" \w* \w pool| strong="H1295" \w* \w in the highway| strong="H4546" \w* [of the fuller’s]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8801”} \w field| strong="H7704" \w*;\f + \fr 7:3 \ft Shear-jashub: that is, The remnant shall return \f* \f + \fr 7:3 \ft highway: or, causeway \f* 
\v 4 [And say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto him, Take heed]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8734”}, [and be quiet]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8685”}; [fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [not, neither be fainthearted]{strong=“H3824 H7401” x-morph=“strongMorph: \sc Th\sc*8735”} \w for the two| strong="H8147" \w* \w tails| strong="H2180" \w* \w of these smoking| strong="H6226" \w* \w firebrands| strong="H181" \w*, \w for the fierce| strong="H2750" \w* \w anger| strong="H639" \w* \w of Rezin| strong="H7526" \w* \w with Syria| strong="H758" \w*, \w and of the son| strong="H1121" \w* \w of Remaliah| strong="H7425" \w*.\f + \fr 7:4 \ft neither…: Heb. let not thy heart be tender \f* 
\v 5 \w Because Syria| strong="H758" \w*, \w Ephraim| strong="H669" \w*, \w and the son| strong="H1121" \w* \w of Remaliah| strong="H7425" \w*, \w have taken evil| strong="H7451" \w* [counsel]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8804”} [against thee, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 6 [Let us go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w against Judah| strong="H3063" \w*, [and vex]{strong=“H6973” x-morph=“strongMorph: \sc Th\sc*8686”} [it, and let us make a breach]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8686”} [therein for us, and set]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8686”} \w a king| strong="H4428" \w* \w in the midst| strong="H8432" \w* of it, even \w the son| strong="H1121" \w* \w of Tabeal| strong="H2870" \w*:\f + \fr 7:6 \ft vex: or, waken \f* 
\v 7 \w Thus| strong="H3541" \w* [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*, [It shall not stand]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, neither shall it come to pass. 
\v 8 \w For the head| strong="H7218" \w* \w of Syria| strong="H758" \w* is \w Damascus| strong="H1834" \w*, \w and the head| strong="H7218" \w* \w of Damascus| strong="H1834" \w* is \w Rezin| strong="H7526" \w*; \w and within threescore| strong="H8346" \w* \w and five| strong="H2568" \w* \w years| strong="H8141" \w* \w shall Ephraim| strong="H669" \w* [be broken]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8735”}, \w that it be not a people| strong="H5971" \w*.\f + \fr 7:8 \ft that…: Heb. from a people \f* 
\v 9 \w And the head| strong="H7218" \w* \w of Ephraim| strong="H669" \w* is \w Samaria| strong="H8111" \w*, \w and the head| strong="H7218" \w* \w of Samaria| strong="H8111" \w* is [Remaliah’s]{strong=“H7425”} \w son| strong="H1121" \w*. [If ye will not believe]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”}, [surely ye shall not be established]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 7:9 \ft If…: or, Do ye not believe? it is because ye are not stable \f* 
\p
\v 10 Moreover the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} [again]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto Ahaz| strong="H271" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”},^\sc 7:10 Moreover…: Heb. And the [Lord\sc* added to speak] 
\v 11 [Ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee a sign| strong="H226" \w* of the \sc Lord\sc* \w thy God| strong="H430" \w*; [ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8800”} [it either in the depth]{strong=“H6009” x-morph=“strongMorph: \sc Th\sc*8685”}, [or in the height]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8687”} \w above| strong="H4605" \w*.\f + \fr 7:11 \ft ask it…: or, make thy petition deep \f* 
\v 12 \w But Ahaz| strong="H271" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will not ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”}, [neither will I tempt]{strong=“H853 H5254” x-morph=“strongMorph: \sc Th\sc*8762”} the \sc Lord\sc*. 
\v 13 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [ye now, O house]{strong=“H1004”} \w of David| strong="H1732" \w*; Is it \w a small thing| strong="H4592" \w* [for you to weary]{strong=“H3811” x-morph=“strongMorph: \sc Th\sc*8687”} \w men| strong="H582" \w*, [but will ye weary]{strong=“H3811” x-morph=“strongMorph: \sc Th\sc*8686”} \w my God| strong="H430" \w* also? 
\v 14 \w Therefore the Lord| strong="H136" \w* [himself shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w you a sign| strong="H226" \w*; [Behold, a virgin]{strong=“H5959”} \w shall conceive| strong="H2030" \w*, [and bear]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”} \w a son| strong="H1121" \w*, [and shall call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w his name| strong="H8034" \w* [Immanuel]{strong=“H410 H6005”}.\f + \fr 7:14 \ft shall call: or, thou, O virgin, shalt call \f* 
\v 15 \w Butter| strong="H2529" \w* \w and honey| strong="H1706" \w* [shall he eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}, [that he may know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} [to refuse]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8800”} \w the evil| strong="H7451" \w*, [and choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8800”} \w the good| strong="H2896" \w*. 
\v 16 \w For before the child| strong="H5288" \w* [shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [to refuse]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8800”} \w the evil| strong="H7451" \w*, [and choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8800”} \w the good| strong="H2896" \w*, \w the land| strong="H127" \w* [that thou abhorrest]{strong=“H6973” x-morph=“strongMorph: \sc Th\sc*8801”} \w shall be| strong="H6440" \w* [forsaken ]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8735”} \w of both| strong="H8147" \w* \w her kings| strong="H4428" \w*. 
\p
\v 17 The \sc Lord\sc* [shall bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} [upon thee, and upon thy people]{strong=“H5971”}, [and upon thy father’s]{strong=“H1”} \w house| strong="H1004" \w*, \w days| strong="H3117" \w* [that have not come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, \w from the day| strong="H3117" \w* \w that Ephraim| strong="H669" \w* [departed]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8800”} \w from Judah| strong="H3063" \w*; even \w the king| strong="H4428" \w* \w of Assyria| strong="H804" \w*. 
\v 18 \w And it shall come to pass in that day| strong="H3117" \w*, that the \sc Lord\sc* [shall hiss]{strong=“H8319” x-morph=“strongMorph: \sc Th\sc*8799”} \w for the fly| strong="H2070" \w* that is \w in the uttermost part| strong="H7097" \w* \w of the rivers| strong="H2975" \w* \w of Egypt| strong="H4714" \w*, \w and for the bee| strong="H1682" \w* that is \w in the land| strong="H776" \w* \w of Assyria| strong="H804" \w*. 
\v 19 [And they shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, [and shall rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8804”} \w all of them in the desolate| strong="H1327" \w* \w valleys| strong="H5158" \w*, \w and in the holes| strong="H5357" \w* \w of the rocks| strong="H5553" \w*, \w and upon all thorns| strong="H5285" \w*, \w and upon all bushes| strong="H5097" \w*.\f + \fr 7:19 \ft bushes: or, commendable trees \f* 
\v 20 \w In the same day| strong="H3117" \w* \w shall the Lord| strong="H136" \w* [shave]{strong=“H1548” x-morph=“strongMorph: \sc Th\sc*8762”} \w with a razor| strong="H8593" \w* \w that is hired| strong="H7917" \w*, namely, \w by them beyond| strong="H5676" \w* \w the river| strong="H5104" \w*, \w by the king| strong="H4428" \w* \w of Assyria| strong="H804" \w*, \w the head| strong="H7218" \w*, \w and the hair| strong="H8181" \w* \w of the feet| strong="H7272" \w*: [and it shall also consume]{strong=“H5595” x-morph=“strongMorph: \sc Th\sc*8799”} \w the beard| strong="H2206" \w*. 
\v 21 \w And it shall come to pass in that day| strong="H3117" \w*, that \w a man| strong="H376" \w* [shall nourish]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8762”} \w a young| strong="H1241" \w* \w cow| strong="H5697" \w*, \w and two| strong="H8147" \w* \w sheep| strong="H6629" \w*; 
\v 22 [And it shall come to pass, for the abundance]{strong=“H7230”} \w of milk| strong="H2461" \w* that [they shall give]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [he shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w butter| strong="H2529" \w*: \w for butter| strong="H2529" \w* \w and honey| strong="H1706" \w* [shall every one eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [that is left]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8737”} \w in| strong="H7130" \w* \w the land| strong="H776" \w*.\f + \fr 7:22 \ft the land: Heb. the midst of the land \f* 
\v 23 \w And it shall come to pass in that day| strong="H3117" \w*, that \w every place| strong="H4725" \w* [shall be, where there were a thousand]{strong=“H505”} \w vines| strong="H1612" \w* \w at a thousand| strong="H505" \w* \w silverlings| strong="H3701" \w*, it shall even \w be for briers| strong="H8068" \w* \w and thorns| strong="H7898" \w*. 
\v 24 \w With arrows| strong="H2671" \w* \w and with bows| strong="H7198" \w* shall men [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [thither; because all the land]{strong=“H776”} \w shall become briers| strong="H8068" \w* \w and thorns| strong="H7898" \w*. 
\v 25 And on \w all hills| strong="H2022" \w* [that shall be digged]{strong=“H5737” x-morph=“strongMorph: \sc Th\sc*8735”} \w with the mattock| strong="H4576" \w*, [there shall not come thither]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w the fear| strong="H3374" \w* \w of briers| strong="H8068" \w* \w and thorns| strong="H7898" \w*: \w but it shall be for the sending forth| strong="H4916" \w* \w of oxen| strong="H7794" \w*, \w and for the treading| strong="H4823" \w* \w of lesser cattle| strong="H7716" \w*.
\c 8
\p 
\v 1 Moreover the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w thee a great| strong="H1419" \w* \w roll| strong="H1549" \w*, [and write]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8798”} [in it with a man’s]{strong=“H582”} \w pen| strong="H2747" \w* [concerning Maher-shalal-hash-baz]{strong=“H4122”}.\f + \fr 8:1 \ft Maher-shalal-hash-baz: Heb. In making speed to the spoil he hasteneth the prey, or, Make speed, etc \f* 
\v 2 \w And I took| strong="H5749" \w* [unto me faithful]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8737”} \w witnesses| strong="H5707" \w* [to record]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8686”}, \w Uriah| strong="H223" \w* \w the priest| strong="H3548" \w*, \w and Zechariah| strong="H2148" \w* \w the son| strong="H1121" \w* \w of Jeberechiah| strong="H3000" \w*. 
\v 3 [And I went]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the prophetess| strong="H5031" \w*; [and she conceived]{strong=“H2029” x-morph=“strongMorph: \sc Th\sc*8799”}, [and bare]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8799”} \w a son| strong="H1121" \w*. [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc* [to me, Call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} \w his name| strong="H8034" \w* [Maher-shalal-hash-baz]{strong=“H4122”}.\f + \fr 8:3 \ft went: Heb. approached \f* 
\v 4 \w For before the child| strong="H5288" \w* [shall have knowledge]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [to cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8800”}, \w My father| strong="H1" \w*, \w and my mother| strong="H517" \w*, \w the riches| strong="H2428" \w* \w of Damascus| strong="H1834" \w* \w and the spoil| strong="H7998" \w* \w of Samaria| strong="H8111" \w* [shall be taken away]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* \w the king| strong="H4428" \w* \w of Assyria| strong="H804" \w*.\f + \fr 8:4 \ft the riches…: or, he that is before the king of Assyria shall take away the riches, etc \f* 
\p
\v 5 The \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} [also unto me again]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 6 \w Forasmuch| strong="H3282" \w* \w as this people| strong="H5971" \w* [refuseth]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} \w the waters| strong="H4325" \w* \w of Shiloah| strong="H7975" \w* [that go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w softly| strong="H328" \w*, \w and rejoice| strong="H4885" \w* \w in Rezin| strong="H7526" \w* [and Remaliah’s]{strong=“H7425”} \w son| strong="H1121" \w*; 
\v 7 [Now therefore, behold, the Lord]{strong=“H136”} [bringeth up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8688”} \w upon them the waters| strong="H4325" \w* \w of the river| strong="H5104" \w*, \w strong| strong="H6099" \w* \w and many| strong="H7227" \w*, even \w the king| strong="H4428" \w* \w of Assyria| strong="H804" \w*, \w and all his glory| strong="H3519" \w*: [and he shall come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w over all his channels| strong="H650" \w*, [and go over]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w all his banks| strong="H1415" \w*: 
\v 8 [And he shall pass]{strong=“H2498” x-morph=“strongMorph: \sc Th\sc*8804”} \w through Judah| strong="H3063" \w*; [he shall overflow]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8804”} [and go over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”}, [he shall reach]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8686”} even \w to the neck| strong="H6677" \w*; \w and the stretching out| strong="H4298" \w* \w of his wings| strong="H3671" \w* \w shall fill| strong="H4393" \w* \w the breadth| strong="H7341" \w* \w of thy land| strong="H776" \w*, [O Immanuel]{strong=“H410 H6005”}.\f + \fr 8:8 \ft stretching…: Heb. fulness of the breadth of thy land shall be the stretchings out of his wings \f* 
\p
\v 9 [Associate]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8798”} [yourselves, O ye people]{strong=“H5971”}, [and ye shall be broken in pieces]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8798”}; [and give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”}, \w all| strong="H3605" \w* \w ye of far| strong="H4801" \w* \w countries| strong="H776" \w*: [gird]{strong=“H247” x-morph=“strongMorph: \sc Th\sc*8690”} [yourselves, and ye shall be broken in pieces]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8798”}; [gird]{strong=“H247” x-morph=“strongMorph: \sc Th\sc*8690”} [yourselves, and ye shall be broken in pieces]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8798”}.\f + \fr 8:9 \ft people, and: or, people, yet \f* 
\v 10 \w Take| strong="H5779" \w* \w counsel| strong="H6098" \w* [together]{strong=“H5779” x-morph=“strongMorph: \sc Th\sc*8798”}, [and it shall come to nought]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8714”}; [speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w the word| strong="H1697" \w*, [and it shall not stand]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}: \w for God| strong="H410" \w* is with us. 
\p
\v 11 For the \sc Lord\sc* [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w thus to me with a strong| strong="H2393" \w* \w hand| strong="H3027" \w*, [and instructed]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8765”} [me that I should not walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the way| strong="H1870" \w* \w of this people| strong="H5971" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”},\f + \fr 8:11 \ft with…: Heb. in strength of hand \f* 
\v 12 [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [ye not, A confederacy]{strong=“H7195”}, to all them to \w whom this people| strong="H5971" \w* [shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w A confederacy| strong="H7195" \w*; [neither fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w ye their fear| strong="H4172" \w*, [nor be afraid]{strong=“H6206” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 13 [Sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8686”} the \sc Lord\sc* \w of hosts| strong="H6635" \w* himself; and let him be \w your fear| strong="H4172" \w*, and let him be [your dread]{strong=“H6206” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 14 \w And he shall be for a sanctuary| strong="H4720" \w*; \w but for a stone| strong="H68" \w* \w of stumbling| strong="H5063" \w* \w and for a rock| strong="H6697" \w* \w of offence| strong="H4383" \w* \w to both| strong="H8147" \w* \w the houses| strong="H1004" \w* \w of Israel| strong="H3478" \w*, \w for a gin| strong="H6341" \w* \w and for a snare| strong="H4170" \w* [to the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w*. 
\v 15 \w And many| strong="H7227" \w* [among them shall stumble]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8804”}, [and fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”}, [and be broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8738”}, [and be snared]{strong=“H3369” x-morph=“strongMorph: \sc Th\sc*8738”}, [and be taken]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\p
\v 16 [Bind up]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8798”} \w the testimony| strong="H8584" \w*, [seal]{strong=“H2856” x-morph=“strongMorph: \sc Th\sc*8798”} \w the law| strong="H8451" \w* \w among my disciples| strong="H3928" \w*. 
\v 17 [And I will wait]{strong=“H2442” x-morph=“strongMorph: \sc Th\sc*8765”} upon the \sc Lord\sc*, [that hideth]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8688”} \w his face| strong="H6440" \w* \w from the house| strong="H1004" \w* \w of Jacob| strong="H3290" \w*, [and I will look]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8765”} for him. 
\v 18 [Behold, I and the children]{strong=“H3206”} whom the \sc Lord\sc* [hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} me are \w for signs| strong="H226" \w* \w and for wonders| strong="H4159" \w* \w in Israel| strong="H3478" \w* from the \sc Lord\sc* \w of hosts| strong="H6635" \w*, [which dwelleth]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8802”} \w in mount| strong="H2022" \w* \w Zion| strong="H6726" \w*. 
\p
\v 19 [And when they shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto you, Seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto them that have familiar spirits| strong="H178" \w*, \w and unto wizards| strong="H3049" \w* [that peep]{strong=“H6850” x-morph=“strongMorph: \sc Th\sc*8772”}, [and that mutter]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8688”}: \w should not a people| strong="H5971" \w* [seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto their God| strong="H430" \w*? \w for the living| strong="H2416" \w* [to the dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”}? 
\v 20 \w To the law| strong="H8451" \w* \w and to the testimony| strong="H8584" \w*: [if they speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w not according to this word| strong="H1697" \w*, it is because there is \w no light| strong="H7837" \w* in them.\f + \fr 8:20 \ft no…: Heb. no morning \f* 
\v 21 [And they shall pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} [through it, hardly bestead]{strong=“H7185” x-morph=“strongMorph: \sc Th\sc*8737”} \w and hungry| strong="H7457" \w*: [and it shall come to pass, that when they shall be hungry]{strong=“H7456” x-morph=“strongMorph: \sc Th\sc*8799”}, [they shall fret]{strong=“H7107” x-morph=“strongMorph: \sc Th\sc*8694”} [themselves, and curse]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8765”} \w their king| strong="H4428" \w* \w and their God| strong="H430" \w*, [and look]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8804”} \w upward| strong="H4605" \w*. 
\v 22 [And they shall look]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto the earth| strong="H776" \w*; \w and behold trouble| strong="H6869" \w* \w and darkness| strong="H2825" \w*, \w dimness| strong="H4588" \w* \w of anguish| strong="H6695" \w*; and they shall be [driven]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8794”} \w to darkness| strong="H653" \w*.
\c 9
\p 
\v 1 \w Nevertheless the dimness| strong="H4155" \w* shall not be such as was \w in her vexation| strong="H4164" \w*, \w when| strong="H6256" \w* \w at the first| strong="H7223" \w* [he lightly afflicted]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8689”} \w the land| strong="H776" \w* \w of Zebulun| strong="H2074" \w* \w and the land| strong="H776" \w* \w of Naphtali| strong="H5321" \w*, \w and afterward| strong="H314" \w* [did more grievously afflict]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8689”} her by \w the way| strong="H1870" \w* \w of the sea| strong="H3220" \w*, \w beyond| strong="H5676" \w* \w Jordan| strong="H3383" \w*, \w in Galilee| strong="H1551" \w* \w of the nations| strong="H1471" \w*.\f + \fr 9:1 \ft of the nations: or, populous \f* 
\v 2 \w The people| strong="H5971" \w* [that walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w in darkness| strong="H2822" \w* [have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w a great| strong="H1419" \w* \w light| strong="H216" \w*: [they that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the land| strong="H776" \w* \w of the shadow of death| strong="H6757" \w*, \w upon them hath the light| strong="H216" \w* [shined]{strong=“H5050” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 3 [Thou hast multiplied]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8689”} \w the nation| strong="H1471" \w*, and [not increased]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8689”} \w the joy| strong="H8057" \w*: [they joy]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* \w thee according to the joy| strong="H8057" \w* \w in harvest| strong="H7105" \w*, and as men [rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”} [when they divide]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8763”} \w the spoil| strong="H7998" \w*.\f + \fr 9:3 \ft not: or, to him \f* 
\v 4 [For thou hast broken]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8689”} \w the yoke| strong="H5923" \w* \w of his burden| strong="H5448" \w*, \w and the staff| strong="H4294" \w* \w of his shoulder| strong="H7926" \w*, \w the rod| strong="H7626" \w* [of his oppressor]{strong=“H5065” x-morph=“strongMorph: \sc Th\sc*8802”}, \w as in the day| strong="H3117" \w* \w of Midian| strong="H4080" \w*.\f + \fr 9:4 \ft For…: or, When thou brakest \f* 
\v 5 \w For every battle| strong="H5430" \w* [of the warrior]{strong=“H5431” x-morph=“strongMorph: \sc Th\sc*8802”} is \w with confused noise| strong="H7494" \w*, \w and garments| strong="H8071" \w* [rolled ]{strong=“H1556” x-morph=“strongMorph: \sc Th\sc*8775”} \w in blood| strong="H1818" \w*; but this \w shall be with burning| strong="H8316" \w* and \w fuel| strong="H3980" \w* \w of fire| strong="H784" \w*.\f + \fr 9:5 \ft For…: or, When the whole battle of the warrior was, etc \f* \f + \fr 9:5 \ft but…: or, and it was, etc \f* \f + \fr 9:5 \ft fuel: Heb. meat \f* 
\v 6 \w For unto us a child| strong="H3206" \w* [is born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8795”}, \w unto us a son| strong="H1121" \w* [is given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”}: \w and the government| strong="H4951" \w* \w shall be upon his shoulder| strong="H7926" \w*: \w and his name| strong="H8034" \w* [shall be called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w Wonderful| strong="H6382" \w*, [Counsellor]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8802”}, \w The mighty| strong="H1368" \w* \w God| strong="H410" \w*, \w The everlasting| strong="H5703" \w* \w Father| strong="H1" \w*, \w The Prince| strong="H8269" \w* \w of Peace| strong="H7965" \w*. 
\v 7 \w Of the increase| strong="H4766" \w* of his \w government| strong="H4951" \w* \w and peace| strong="H7965" \w* there shall be \w no end| strong="H7093" \w*, \w upon the throne| strong="H3678" \w* \w of David| strong="H1732" \w*, \w and upon his kingdom| strong="H4467" \w*, [to order]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8687”} [it, and to establish]{strong=“H5582” x-morph=“strongMorph: \sc Th\sc*8800”} \w it with judgment| strong="H4941" \w* \w and with justice| strong="H6666" \w* \w from henceforth even for| strong="H5704" \w* \w ever| strong="H5769" \w*. \w The zeal| strong="H7068" \w* of the \sc Lord\sc* \w of hosts| strong="H6635" \w* [will perform]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} this. 
\p
