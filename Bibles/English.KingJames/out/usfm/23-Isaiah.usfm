\p
\v 9 [Whom shall he teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”} \w knowledge| strong="H1844" \w*? [and whom shall he make to understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} \w doctrine| strong="H8052" \w*? them that are [weaned]{strong=“H1580” x-morph=“strongMorph: \sc Th\sc*8803”} \w from the milk| strong="H2461" \w*, and \w drawn| strong="H6267" \w* \w from the breasts| strong="H7699" \w*.\f + \fr 28:9 \ft doctrine: Heb. the hearing? \f* 
\v 10 \w For precept| strong="H6673" \w* must be \w upon precept| strong="H6673" \w*, \w precept| strong="H6673" \w* \w upon precept| strong="H6673" \w*; \w line| strong="H6957" \w* \w upon line| strong="H6957" \w*, \w line| strong="H6957" \w* \w upon line| strong="H6957" \w*; \w here a little| strong="H2191" \w*, and \w there a little| strong="H2191" \w*:\f + \fr 28:10 \ft must be: or, hath been \f* 
\v 11 \w For with stammering| strong="H3934" \w* \w lips| strong="H8193" \w* \w and another| strong="H312" \w* \w tongue| strong="H3956" \w* [will he speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w to this people| strong="H5971" \w*.\f + \fr 28:11 \ft stammering…: Heb. stammerings of lip \f* \f + \fr 28:11 \ft will…: or, he hath spoken \f* 
\v 12 [To whom he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, This is \w the rest| strong="H4496" \w* wherewith \w ye may cause the weary| strong="H5889" \w* [to rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8685”}; and this is \w the refreshing| strong="H4774" \w*: [yet they would]{strong=“H14” x-morph=“strongMorph: \sc Th\sc*8804”} [not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 13 \w But the word| strong="H1697" \w* of the \sc Lord\sc* \w was unto them precept| strong="H6673" \w* \w upon precept| strong="H6673" \w*, \w precept| strong="H6673" \w* \w upon precept| strong="H6673" \w*; \w line| strong="H6957" \w* \w upon line| strong="H6957" \w*, \w line| strong="H6957" \w* \w upon line| strong="H6957" \w*; \w here a little| strong="H2191" \w*, and \w there a little| strong="H2191" \w*; [that they might go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}, [and fall]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8804”} \w backward| strong="H268" \w*, [and be broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8738”}, [and snared]{strong=“H3369” x-morph=“strongMorph: \sc Th\sc*8738”}, [and taken]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\p
\v 14 [Wherefore hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w the word| strong="H1697" \w* of the \sc Lord\sc*, \w ye scornful| strong="H3944" \w* \w men| strong="H582" \w*, [that rule]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8802”} \w this people| strong="H5971" \w* which is \w in Jerusalem| strong="H3389" \w*. 
\v 15 [Because ye have said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [We have made]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8804”} \w a covenant| strong="H1285" \w* \w with death| strong="H4194" \w*, \w and with hell| strong="H7585" \w* [are we]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w at agreement| strong="H2374" \w*; [when the overflowing]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8802”} [scourge]{strong=“H7885 H7752” x-morph=“strongMorph: \sc Th\sc*8675”} [shall pass through]{strong=“H5674 H5674” x-morph=“strongMorph: \sc Th\sc*8804 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8799”}, [it shall not come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [unto us: for we have made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w lies| strong="H3577" \w* \w our refuge| strong="H4268" \w*, \w and under falsehood| strong="H8267" \w* [have we hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8738”} ourselves: 
\p
\v 16 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*, [Behold, I lay]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8765”} \w in Zion| strong="H6726" \w* \w for a foundation a stone| strong="H68" \w*, \w a tried| strong="H976" \w* \w stone| strong="H68" \w*, \w a precious| strong="H3368" \w* \w corner| strong="H6438" \w* stone, [a sure]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8716”} \w foundation| strong="H4143" \w*: [he that believeth]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8688”} [shall not make haste]{strong=“H2363” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 17 \w Judgment| strong="H4941" \w* [also will I lay]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the line| strong="H6957" \w*, \w and righteousness| strong="H6666" \w* \w to the plummet| strong="H4949" \w*: \w and the hail| strong="H1259" \w* [shall sweep away]{strong=“H3261” x-morph=“strongMorph: \sc Th\sc*8804”} \w the refuge| strong="H4268" \w* \w of lies| strong="H3577" \w*, \w and the waters| strong="H4325" \w* [shall overflow]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8799”} \w the hiding place| strong="H5643" \w*. 
\p
\v 18 \w And your covenant| strong="H1285" \w* \w with death| strong="H4194" \w* [shall be disannulled]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8795”}, \w and your agreement| strong="H2380" \w* \w with hell| strong="H7585" \w* [shall not stand]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}; [when the overflowing]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8802”} \w scourge| strong="H7752" \w* [shall pass through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}, \w then ye shall be trodden down| strong="H4823" \w* by it.\f + \fr 28:18 \ft trodden…: Heb. a treading down to it \f* 
\v 19 \w From the time| strong="H1767" \w* [that it goeth forth]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8800”} [it shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [you: for morning]{strong=“H1242”} \w by morning| strong="H1242" \w* [shall it pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}, \w by day| strong="H3117" \w* \w and by night| strong="H3915" \w*: \w and it shall be a vexation| strong="H2113" \w* only to [understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8687”} \w the report| strong="H8052" \w*.\f + \fr 28:19 \ft to…: or, when he shall make you to understand doctrine \f* 
\v 20 \w For the bed| strong="H4702" \w* [is shorter]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8804”} than that a man [can stretch]{strong=“H8311” x-morph=“strongMorph: \sc Th\sc*8692”} himself on it: \w and the covering| strong="H4541" \w* [narrower]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8804”} [than that he can wrap]{strong=“H3664” x-morph=“strongMorph: \sc Th\sc*8692”} himself in it. 
\v 21 For the \sc Lord\sc* [shall rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} as in \w mount| strong="H2022" \w* \w Perazim| strong="H6559" \w*, [he shall be wroth]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8799”} as in \w the valley| strong="H6010" \w* \w of Gibeon| strong="H1391" \w*, [that he may do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w his work| strong="H4639" \w*, [his strange]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} \w work| strong="H4639" \w*; [and bring to pass]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8800”} \w his act| strong="H5656" \w*, \w his strange| strong="H5237" \w* \w act| strong="H5656" \w*. 
\v 22 [Now therefore be ye not mockers]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8698”}, \w lest your bands| strong="H4147" \w* [be made strong]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8799”}: [for I have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w from the Lord| strong="H136" \w* \sc God\sc* \w of hosts| strong="H6635" \w* \w a consumption| strong="H3617" \w*, [even determined]{strong=“H2782” x-morph=“strongMorph: \sc Th\sc*8737”} \w upon the whole earth| strong="H776" \w*. 
\p
\v 23 [Give ye ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”}, [and hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w my voice| strong="H6963" \w*; [hearken]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8685”}, [and hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w my speech| strong="H565" \w*. 
\v 24 [Doth the plowman]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8802”} [plow]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8799”} \w all day| strong="H3117" \w* [to sow]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8800”}? [doth he open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8762”} [and break the clods]{strong=“H7702” x-morph=“strongMorph: \sc Th\sc*8762”} \w of his ground| strong="H127" \w*? 
\v 25 [When he hath made plain]{strong=“H7737” x-morph=“strongMorph: \sc Th\sc*8765”} \w the face| strong="H6440" \w* [thereof, doth he not cast abroad]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8689”} \w the fitches| strong="H7100" \w*, [and scatter]{strong=“H2236” x-morph=“strongMorph: \sc Th\sc*8799”} \w the cummin| strong="H3646" \w*, [and cast]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the principal| strong="H7795" \w* \w wheat| strong="H2406" \w* [and the appointed]{strong=“H5567” x-morph=“strongMorph: \sc Th\sc*8737”} \w barley| strong="H8184" \w* \w and the rie| strong="H3698" \w* \w in their place| strong="H1367" \w*?\f + \fr 28:25 \ft the principal…: or, the wheat in the principal place, and barley in the appointed place \f* \f + \fr 28:25 \ft rie: or, spelt \f* \f + \fr 28:25 \ft place: Heb. border? \f* 
\v 26 \w For his God| strong="H430" \w* [doth instruct]{strong=“H3256” x-morph=“strongMorph: \sc Th\sc*8765”} \w him to discretion| strong="H4941" \w*, and [doth teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”} him.\f + \fr 28:26 \ft For…: or, And he bindeth it in such sort as his God doth teach him \f* 
\v 27 \w For the fitches| strong="H7100" \w* [are not threshed]{strong=“H1758” x-morph=“strongMorph: \sc Th\sc*8714”} \w with a threshing instrument| strong="H2742" \w*, \w neither is a cart| strong="H5699" \w* \w wheel| strong="H212" \w* [turned about]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8714”} \w upon the cummin| strong="H3646" \w*; \w but the fitches| strong="H7100" \w* [are beaten out]{strong=“H2251” x-morph=“strongMorph: \sc Th\sc*8735”} \w with a staff| strong="H4294" \w*, \w and the cummin| strong="H3646" \w* \w with a rod| strong="H7626" \w*. 
\v 28 \w Bread| strong="H3899" \w* corn [is bruised]{strong=“H1854” x-morph=“strongMorph: \sc Th\sc*8714”}; \w because he will not ever| strong="H5331" \w* [be threshing]{strong=“H1758 H156” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8800”} [it, nor break]{strong=“H2000” x-morph=“strongMorph: \sc Th\sc*8804”} it with \w the wheel| strong="H1536" \w* \w of his cart| strong="H5699" \w*, [nor bruise]{strong=“H1854” x-morph=“strongMorph: \sc Th\sc*8799”} it with \w his horsemen| strong="H6571" \w*. 
\v 29 [This also cometh forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} from the \sc Lord\sc* \w of hosts| strong="H6635" \w*, which [is wonderful]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8689”} \w in counsel| strong="H6098" \w*, and [excellent]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8689”} \w in working| strong="H8454" \w*.
\c 29
\p 
\v 1 \w Woe| strong="H1945" \w* \w to Ariel| strong="H740" \w*, \w to Ariel| strong="H740" \w*, \w the city| strong="H7151" \w* where \w David| strong="H1732" \w* [dwelt]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8804”}! [add]{strong=“H5595” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye year| strong="H8141" \w* \w to year| strong="H8141" \w*; [let them kill]{strong=“H5362” x-morph=“strongMorph: \sc Th\sc*8799”} \w sacrifices| strong="H2282" \w*.\f + \fr 29:1 \ft Woe…: or, O Ariel, that is, the lion of God \f* \f + \fr 29:1 \ft the city: or, of the city \f* \f + \fr 29:1 \ft kill: Heb. cut off the heads of \f* 
\v 2 [Yet I will distress]{strong=“H6693” x-morph=“strongMorph: \sc Th\sc*8689”} \w Ariel| strong="H740" \w*, \w and there shall be heaviness| strong="H8386" \w* \w and sorrow| strong="H592" \w*: \w and it shall be unto me as Ariel| strong="H740" \w*. 
\v 3 [And I will camp]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8804”} \w against thee round about| strong="H1754" \w*, [and will lay siege]{strong=“H6696” x-morph=“strongMorph: \sc Th\sc*8804”} \w against thee with a mount| strong="H4674" \w*, [and I will raise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} \w forts| strong="H4694" \w* against thee. 
\v 4 [And thou shalt be brought down]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8804”}, and [shalt speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w out of the ground| strong="H776" \w*, \w and thy speech| strong="H565" \w* [shall be low]{strong=“H7817” x-morph=“strongMorph: \sc Th\sc*8735”} \w out of the dust| strong="H6083" \w*, \w and thy voice| strong="H6963" \w* [shall be, as of one that hath a familiar spirit]{strong=“H178”}, \w out of the ground| strong="H776" \w*, \w and thy speech| strong="H565" \w* [shall whisper]{strong=“H6850” x-morph=“strongMorph: \sc Th\sc*8770”} \w out of the dust| strong="H6083" \w*.\f + \fr 29:4 \ft whisper: Heb. peep, or, chirp \f* 
\v 5 \w Moreover the multitude| strong="H1995" \w* [of thy strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} \w shall be like small| strong="H1851" \w* \w dust| strong="H80" \w*, \w and the multitude| strong="H1995" \w* \w of the terrible ones| strong="H6184" \w* shall be \w as chaff| strong="H4671" \w* [that passeth away]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”}: [yea, it shall be at an instant]{strong=“H6621”} \w suddenly| strong="H6597" \w*. 
\v 6 [Thou shalt be visited]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8735”} of the \sc Lord\sc* \w of hosts| strong="H6635" \w* \w with thunder| strong="H7482" \w*, \w and with earthquake| strong="H7494" \w*, \w and great| strong="H1419" \w* \w noise| strong="H6963" \w*, \w with storm| strong="H5492" \w* \w and tempest| strong="H5591" \w*, \w and the flame| strong="H3851" \w* [of devouring]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} \w fire| strong="H784" \w*. 
\p
\v 7 \w And the multitude| strong="H1995" \w* \w of all the nations| strong="H1471" \w* [that fight]{strong=“H6633” x-morph=“strongMorph: \sc Th\sc*8802”} \w against Ariel| strong="H740" \w*, [even all that fight]{strong=“H6638” x-morph=“strongMorph: \sc Th\sc*8802”} \w against her and her munition| strong="H4685" \w*, [and that distress]{strong=“H6693” x-morph=“strongMorph: \sc Th\sc*8688”} [her, shall be as a dream]{strong=“H2472”} \w of a night| strong="H3915" \w* \w vision| strong="H2377" \w*. 
\v 8 \w It shall even be as when an hungry| strong="H7457" \w* man [dreameth]{strong=“H2492” x-morph=“strongMorph: \sc Th\sc*8799”}, [and, behold, he eateth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”}; [but he awaketh]{strong=“H6974” x-morph=“strongMorph: \sc Th\sc*8689”}, \w and his soul| strong="H5315" \w* \w is empty| strong="H7386" \w*: \w or as when| strong="H834" \w* \w a thirsty man| strong="H6771" \w* [dreameth]{strong=“H2492” x-morph=“strongMorph: \sc Th\sc*8799”}, [and, behold, he drinketh]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8802”}; [but he awaketh]{strong=“H6974” x-morph=“strongMorph: \sc Th\sc*8689”}, and, behold, he is \w faint| strong="H5889" \w*, \w and his soul| strong="H5315" \w* [hath appetite]{strong=“H8264” x-morph=“strongMorph: \sc Th\sc*8802”}: \w so shall the multitude| strong="H1995" \w* \w of all the nations| strong="H1471" \w* [be, that fight]{strong=“H6633” x-morph=“strongMorph: \sc Th\sc*8802”} \w against mount| strong="H2022" \w* \w Zion| strong="H6726" \w*. 
\p
\v 9 [Stay]{strong=“H4102” x-morph=“strongMorph: \sc Th\sc*8697”} [yourselves, and wonder]{strong=“H8539” x-morph=“strongMorph: \sc Th\sc*8798”}; [cry ye out]{strong=“H8173” x-morph=“strongMorph: \sc Th\sc*8697”}, [and cry]{strong=“H8173” x-morph=“strongMorph: \sc Th\sc*8798”}: [they are drunken]{strong=“H7937” x-morph=“strongMorph: \sc Th\sc*8804”}, \w but not with wine| strong="H3196" \w*; [they stagger]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8804”}, \w but not with strong drink| strong="H7941" \w*.\f + \fr 29:9 \ft cry ye…: or, take your pleasure, and riot \f* 
\v 10 For the \sc Lord\sc* [hath poured out]{strong=“H5258” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon you the spirit| strong="H7307" \w* \w of deep sleep| strong="H8639" \w*, [and hath closed]{strong=“H6105” x-morph=“strongMorph: \sc Th\sc*8762”} \w your eyes| strong="H5869" \w*: \w the prophets| strong="H5030" \w* \w and your rulers| strong="H7218" \w*, \w the seers| strong="H2374" \w* [hath he covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”}.\f + \fr 29:10 \ft rulers: Heb. heads \f* 
\v 11 \w And the vision| strong="H2380" \w* \w of all is become unto you as the words| strong="H1697" \w* \w of a book| strong="H5612" \w* [that is sealed]{strong=“H2856” x-morph=“strongMorph: \sc Th\sc*8803”}, which men [deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [to one that is learned]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Read]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} [this, I pray thee: and he saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [I cannot]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”}; for it is [sealed]{strong=“H2856” x-morph=“strongMorph: \sc Th\sc*8803”}:\f + \fr 29:11 \ft book: or, letter \f* 
\v 12 \w And the book| strong="H5612" \w* [is delivered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} [to him that is not learned]{strong=“H5612 H3045” x-morph=“strongMorph: \sc Th\sc*8804”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Read]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} [this, I pray thee: and he saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [I am not learned]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\p
\v 13 \w Wherefore the Lord| strong="H136" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Forasmuch| strong="H3282" \w* \w as this people| strong="H5971" \w* [draw near]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8738”} me \w with their mouth| strong="H6310" \w*, \w and with their lips| strong="H8193" \w* [do honour]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8765”} [me, but have removed]{strong=“H7368”} \w their heart| strong="H3820" \w* [far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8765”} [from me, and their fear]{strong=“H3374”} [toward me is taught]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8794”} \w by the precept| strong="H4687" \w* \w of men| strong="H582" \w*: 
\v 14 [Therefore, behold, I will proceed]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8802”} [to do a marvellous work]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8687”} \w among this people| strong="H5971" \w*, even [a marvellous work]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8687”} \w and a wonder| strong="H6382" \w*: \w for the wisdom| strong="H2451" \w* \w of their wise| strong="H2450" \w* men [shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and the understanding| strong="H998" \w* [of their prudent]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8737”} men [shall be hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8691”}.\f + \fr 29:14 \ft proceed: Heb. add \f* 
\v 15 \w Woe| strong="H1945" \w* [unto them that seek deep]{strong=“H6009” x-morph=“strongMorph: \sc Th\sc*8688”} [to hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8687”} \w their counsel| strong="H6098" \w* from the \sc Lord\sc*, \w and their works| strong="H4639" \w* \w are in the dark| strong="H4285" \w*, [and they say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Who seeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} [us? and who knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} us? 
\v 16 [Surely your turning of things upside down]{strong=“H2017” x-morph=“strongMorph: \sc Th\sc*8800”} [shall be esteemed]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8735”} [as the potter’s]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w clay| strong="H2563" \w*: \w for shall the work| strong="H4639" \w* [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [of him that made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} [it, He made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [me not? or shall the thing framed]{strong=“H3336”} [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [of him that framed]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} [it, He had no understanding]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8689”}? 
\p
\v 17 Is \w it not yet a very| strong="H4213" \w* \w little while| strong="H4592" \w*, \w and Lebanon| strong="H3844" \w* [shall be turned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w into a fruitful field| strong="H3759" \w*, \w and the fruitful field| strong="H3759" \w* [shall be esteemed]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8735”} \w as a forest| strong="H3293" \w*? 
\p
\v 18 \w And in that day| strong="H3117" \w* \w shall the deaf| strong="H2795" \w* [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the words| strong="H1697" \w* \w of the book| strong="H5612" \w*, \w and the eyes| strong="H5869" \w* \w of the blind| strong="H5787" \w* [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of obscurity| strong="H652" \w*, \w and out of darkness| strong="H2822" \w*. 
\v 19 \w The meek| strong="H6035" \w* [also shall increase]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8804”} their \w joy| strong="H8057" \w* in the \sc Lord\sc*, \w and the poor| strong="H34" \w* \w among men| strong="H120" \w* [shall rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w*.\f + \fr 29:19 \ft increase: Heb. add \f* 
\v 20 \w For the terrible one| strong="H6184" \w* [is brought to nought]{strong=“H656” x-morph=“strongMorph: \sc Th\sc*8804”}, [and the scorner]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8801”} [is consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”}, [and all that watch]{strong=“H8245” x-morph=“strongMorph: \sc Th\sc*8802”} \w for iniquity| strong="H205" \w* [are cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8738”}: 
\v 21 \w That make a man| strong="H120" \w* [an offender]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8688”} \w for a word| strong="H1697" \w*, [and lay a snare]{strong=“H6983” x-morph=“strongMorph: \sc Th\sc*8799”} [for him that reproveth]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8688”} \w in the gate| strong="H8179" \w*, [and turn aside]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w the just| strong="H6662" \w* \w for a thing of nought| strong="H8414" \w*. 
\v 22 [Therefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*, [who redeemed]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8804”} \w Abraham| strong="H85" \w*, \w concerning the house| strong="H1004" \w* \w of Jacob| strong="H3290" \w*, \w Jacob| strong="H3290" \w* [shall not now be ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”}, \w neither shall his face| strong="H6440" \w* [now wax pale]{strong=“H2357” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 23 [But when he seeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w his children| strong="H3206" \w*, \w the work| strong="H4639" \w* \w of mine hands| strong="H3027" \w*, \w in the midst| strong="H7130" \w* [of him, they shall sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8686”} \w my name| strong="H8034" \w*, [and sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8689”} \w the Holy One| strong="H6918" \w* \w of Jacob| strong="H3290" \w*, [and shall fear]{strong=“H6206” x-morph=“strongMorph: \sc Th\sc*8686”} \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*. 
\v 24 [They also that erred]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8802”} \w in spirit| strong="H7307" \w* [shall come]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w to understanding| strong="H998" \w*, [and they that murmured]{strong=“H7279” x-morph=“strongMorph: \sc Th\sc*8803”} [shall learn]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8799”} \w doctrine| strong="H3948" \w*.\f + \fr 29:24 \ft come…: Heb. know understanding \f*
\c 30
\p 
\v 1 \w Woe| strong="H1945" \w* [to the rebellious]{strong=“H5637” x-morph=“strongMorph: \sc Th\sc*8802”} \w children| strong="H1121" \w*, [saith ]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [that take]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w counsel| strong="H6098" \w*, [but not of me; and that cover]{strong=“H5258” x-morph=“strongMorph: \sc Th\sc*8800”} \w with a covering| strong="H4541" \w*, \w but not of my spirit| strong="H7307" \w*, [that they may add]{strong=“H5595” x-morph=“strongMorph: \sc Th\sc*8800”} \w sin| strong="H2403" \w* \w to sin| strong="H2403" \w*: 
\v 2 [That walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} [to go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8800”} \w into Egypt| strong="H4714" \w*, [and have not asked]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8804”} \w at my mouth| strong="H6310" \w*; [to strengthen]{strong=“H5810” x-morph=“strongMorph: \sc Th\sc*8800”} \w themselves in the strength| strong="H4581" \w* \w of Pharaoh| strong="H6547" \w*, [and to trust]{strong=“H2620” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the shadow| strong="H6738" \w* \w of Egypt| strong="H4714" \w*! 
\v 3 \w Therefore shall the strength| strong="H4581" \w* \w of Pharaoh| strong="H6547" \w* \w be your shame| strong="H1322" \w*, \w and the trust| strong="H2622" \w* \w in the shadow| strong="H6738" \w* \w of Egypt| strong="H4714" \w* your \w confusion| strong="H3639" \w*. 
\v 4 \w For his princes| strong="H8269" \w* \w were at Zoan| strong="H6814" \w*, \w and his ambassadors| strong="H4397" \w* [came]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8686”} \w to Hanes| strong="H2609" \w*. 
\v 5 [They were all ashamed]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8689”} \w of a people| strong="H5971" \w* that [could not profit]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8686”} [them, nor be an help]{strong=“H5828”} [nor profit]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8687”}, \w but a shame| strong="H1322" \w*, \w and also a reproach| strong="H2781" \w*. 
\v 6 \w The burden| strong="H4853" \w* \w of the beasts| strong="H929" \w* \w of the south| strong="H5045" \w*: \w into the land| strong="H776" \w* \w of trouble| strong="H6869" \w* \w and anguish| strong="H6695" \w*, from whence come \w the young| strong="H3833" \w* \w and old lion| strong="H3918" \w*, \w the viper| strong="H660" \w* \w and fiery| strong="H8314" \w* [flying]{strong=“H5774” x-morph=“strongMorph: \sc Th\sc*8789”} \w serpent| strong="H8314" \w*, [they will carry]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their riches| strong="H2428" \w* \w upon the shoulders| strong="H3802" \w* \w of young asses| strong="H5895" \w*, \w and their treasures| strong="H214" \w* \w upon the bunches| strong="H1707" \w* \w of camels| strong="H1581" \w*, \w to a people| strong="H5971" \w* that [shall not profit]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8686”} them. 
\v 7 \w For the Egyptians| strong="H4714" \w* [shall help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8799”} \w in vain| strong="H1892" \w*, \w and to no purpose| strong="H7385" \w*: [therefore have I cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w concerning this| strong="H2063" \w*, \w Their| strong="H1992" \w* \w strength| strong="H7293" \w* is \w to sit still| strong="H7674" \w*.\f + \fr 30:7 \ft concerning…: or, to her \f* 
\p
\v 8 [Now go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”}, [write]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8798”} \w it before them in a table| strong="H3871" \w*, [and note]{strong=“H2710” x-morph=“strongMorph: \sc Th\sc*8798”} \w it in a book| strong="H5612" \w*, \w that it may be for the time| strong="H3117" \w* \w to come| strong="H314" \w* \w for| strong="H5704" \w* \w ever| strong="H5703" \w* \w and ever| strong="H5769" \w*:\f + \fr 30:8 \ft the…: Heb. the latter day \f* 
\v 9 That this is \w a rebellious| strong="H4805" \w* \w people| strong="H5971" \w*, \w lying| strong="H3586" \w* \w children| strong="H1121" \w*, \w children| strong="H1121" \w* that [will]{strong=“H14” x-morph=“strongMorph: \sc Th\sc*8804”} [not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w the law| strong="H8451" \w* of the \sc Lord\sc*: 
\v 10 [Which say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [to the seers]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”}, [See]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [not; and to the prophets]{strong=“H2374”}, [Prophesy ]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8799”} \w not unto us right things| strong="H5229" \w*, [speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w unto us smooth things| strong="H2513" \w*, [prophesy]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8798”} \w deceits| strong="H4123" \w*: 
\v 11 [Get you out]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8798”} \w of the way| strong="H1870" \w*, [turn aside]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8685”} \w out of the path| strong="H734" \w*, \w cause the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w* [to cease]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8685”} \w from before| strong="H6440" \w* us. 
\v 12 [Wherefore thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w*, [Because ye despise]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8800”} \w this word| strong="H1697" \w*, [and trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} \w in oppression| strong="H6233" \w* [and perverseness]{strong=“H3868” x-morph=“strongMorph: \sc Th\sc*8737”}, [and stay]{strong=“H8172” x-morph=“strongMorph: \sc Th\sc*8735”} thereon:\f + \fr 30:12 \ft oppression: or, fraud \f* 
\v 13 \w Therefore this iniquity| strong="H5771" \w* \w shall be to you as a breach| strong="H6556" \w* [ready to fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8802”}, [swelling out]{strong=“H1158” x-morph=“strongMorph: \sc Th\sc*8737”} [in a high]{strong=“H7682” x-morph=“strongMorph: \sc Th\sc*8737”} \w wall| strong="H2346" \w*, \w whose breaking| strong="H7667" \w* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w suddenly| strong="H6597" \w* \w at an instant| strong="H6621" \w*. 
\v 14 [And he shall break]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8804”} \w it as the breaking| strong="H7667" \w* [of the potters’]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w vessel| strong="H5035" \w* [that is broken in pieces]{strong=“H3807” x-morph=“strongMorph: \sc Th\sc*8800”}; [he shall not spare]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”}: [so that there shall not be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the bursting| strong="H4386" \w* \w of it a sherd| strong="H2789" \w* [to take]{strong=“H2846” x-morph=“strongMorph: \sc Th\sc*8800”} \w fire| strong="H784" \w* [from the hearth]{strong=“H3344” x-morph=“strongMorph: \sc Th\sc*8803”}, [or to take]{strong=“H2834” x-morph=“strongMorph: \sc Th\sc*8800”} \w water| strong="H4325" \w* withal \w out of the pit| strong="H1360" \w*.\f + \fr 30:14 \ft the potters’…: Heb. the bottle of potters \f* 
\v 15 [For thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc*, \w the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w*; \w In returning| strong="H7729" \w* \w and rest| strong="H5183" \w* [shall ye be saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8735”}; [in quietness]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8687”} \w and in confidence| strong="H985" \w* \w shall be your strength| strong="H1369" \w*: [and ye would]{strong=“H14” x-morph=“strongMorph: \sc Th\sc*8804”} not. 
\v 16 [But ye said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [No; for we will flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon horses| strong="H5483" \w*; [therefore shall ye flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”}: [and, We will ride]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon the swift| strong="H7031" \w*; [therefore shall they that pursue]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8802”} [you be swift]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 17 \w One| strong="H259" \w* \w thousand| strong="H505" \w* shall flee \w at| strong="H6440" \w* \w the rebuke| strong="H1606" \w* \w of one| strong="H259" \w*; \w at| strong="H6440" \w* \w the rebuke| strong="H1606" \w* \w of five| strong="H2568" \w* [shall ye flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8799”}: [till ye be left]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8738”} \w as a beacon| strong="H8650" \w* \w upon the top| strong="H7218" \w* \w of a mountain| strong="H2022" \w*, \w and as an ensign| strong="H5251" \w* \w on an hill| strong="H1389" \w*.\f + \fr 30:17 \ft a beacon: or, a tree bereft of branches, or, boughs: or, a mast \f* 
\p
\v 18 And therefore will the \sc Lord\sc* [wait]{strong=“H2442” x-morph=“strongMorph: \sc Th\sc*8762”}, [that he may be gracious]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8800”} [unto you, and therefore will he be exalted]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8799”}, [that he may have mercy]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8763”} upon you: for the \sc Lord\sc* is \w a God| strong="H430" \w* \w of judgment| strong="H4941" \w*: \w blessed| strong="H835" \w* are [all they that wait]{strong=“H2442” x-morph=“strongMorph: \sc Th\sc*8802”} for him. 
\v 19 \w For the people| strong="H5971" \w* [shall dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in Zion| strong="H6726" \w* \w at Jerusalem| strong="H3389" \w*: [thou shalt weep]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8799”} [no more]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8800”}: [he will be very]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8800”} [gracious]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto thee at the voice| strong="H6963" \w* [of thy cry]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8800”}; [when he shall hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} [it, he will answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”} thee. 
\v 20 And though \w the Lord| strong="H136" \w* [give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w you the bread| strong="H3899" \w* \w of adversity| strong="H6862" \w*, \w and the water| strong="H4325" \w* \w of affliction| strong="H3906" \w*, [yet shall not thy teachers]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8688”} [be removed into a corner]{strong=“H3670” x-morph=“strongMorph: \sc Th\sc*8735”} [any more, but thine eyes]{strong=“H5869”} [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} [thy teachers]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8688”}:\f + \fr 30:20 \ft affliction: or, oppression \f* 
\v 21 \w And thine ears| strong="H241" \w* [shall hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w a word| strong="H1697" \w* \w behind| strong="H310" \w* [thee, saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, This is \w the way| strong="H1870" \w*, [walk ye in it]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8798”}, [when ye turn to the right hand]{strong=“H541” x-morph=“strongMorph: \sc Th\sc*8686”}, [and when ye turn to the left]{strong=“H8041” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 22 [Ye shall defile]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8765”} \w also the covering| strong="H6826" \w* \w of thy graven images| strong="H6456" \w* \w of silver| strong="H3701" \w*, \w and the ornament| strong="H642" \w* \w of thy molten images| strong="H4541" \w* \w of gold| strong="H2091" \w*: [thou shalt cast them away]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8799”} \w as a menstruous cloth| strong="H1739" \w*; [thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto it, Get thee hence]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8798”}.\f + \fr 30:22 \ft thy graven…: Heb. the graven images of thy silver \f* \f + \fr 30:22 \ft cast: Heb. scatter \f* 
\v 23 [Then shall he give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w the rain| strong="H4306" \w* \w of thy seed| strong="H2233" \w*, [that thou shalt sow]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8799”} \w the ground| strong="H127" \w* [withal; and bread]{strong=“H3899”} \w of the increase| strong="H8393" \w* \w of the earth| strong="H127" \w*, \w and it shall be fat| strong="H1879" \w* \w and plenteous| strong="H8082" \w*: \w in that day| strong="H3117" \w* \w shall thy cattle| strong="H4735" \w* [feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} [in large]{strong=“H7337” x-morph=“strongMorph: \sc Th\sc*8737”} \w pastures| strong="H3733" \w*. 
\v 24 \w The oxen| strong="H504" \w* \w likewise and the young asses| strong="H5895" \w* [that ear]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8802”} \w the ground| strong="H127" \w* [shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w clean| strong="H2548" \w* \w provender| strong="H1098" \w*, [which hath been winnowed]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8802”} \w with the shovel| strong="H7371" \w* \w and with the fan| strong="H4214" \w*.\f + \fr 30:24 \ft clean: or, savoury: Heb. leavened \f* 
\v 25 \w And there shall be upon every high| strong="H1364" \w* \w mountain| strong="H2022" \w*, [and upon every high]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8737”} \w hill| strong="H1389" \w*, \w rivers| strong="H6388" \w* and \w streams| strong="H2988" \w* \w of waters| strong="H4325" \w* \w in the day| strong="H3117" \w* \w of the great| strong="H7227" \w* \w slaughter| strong="H2027" \w*, \w when the towers| strong="H4026" \w* [fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 30:25 \ft high hill: Heb. lifted up, etc \f* 
\v 26 \w Moreover the light| strong="H216" \w* \w of the moon| strong="H3842" \w* \w shall be as the light| strong="H216" \w* \w of the sun| strong="H2535" \w*, \w and the light| strong="H216" \w* \w of the sun| strong="H2535" \w* \w shall be sevenfold| strong="H7659" \w*, \w as the light| strong="H216" \w* \w of seven| strong="H7651" \w* \w days| strong="H3117" \w*, \w in the day| strong="H3117" \w* that the \sc Lord\sc* [bindeth up]{strong=“H2280” x-morph=“strongMorph: \sc Th\sc*8800”} \w the breach| strong="H7667" \w* \w of his people| strong="H5971" \w*, [and healeth]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8799”} \w the stroke| strong="H4273" \w* \w of their wound| strong="H4347" \w*. 
\p
\v 27 [Behold, the name]{strong=“H8034”} of the \sc Lord\sc* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w from far| strong="H4801" \w*, [burning]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8802”} with \w his anger| strong="H639" \w*, \w and the burden| strong="H4858" \w* thereof is \w heavy| strong="H3514" \w*: \w his lips| strong="H8193" \w* [are full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of indignation| strong="H2195" \w*, \w and his tongue| strong="H3956" \w* [as a devouring]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} \w fire| strong="H784" \w*:\f + \fr 30:27 \ft burden…: or, grievousness of flame \f* \f + \fr 30:27 \ft heavy: Heb. heaviness \f* 
\v 28 \w And his breath| strong="H7307" \w*, [as an overflowing]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8802”} \w stream| strong="H5158" \w*, [shall reach to the midst]{strong=“H2673” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the neck| strong="H6677" \w*, [to sift]{strong=“H5130” x-morph=“strongMorph: \sc Th\sc*8687”} \w the nations| strong="H1471" \w* \w with the sieve| strong="H5299" \w* \w of vanity| strong="H7723" \w*: and there shall be \w a bridle| strong="H7448" \w* \w in the jaws| strong="H3895" \w* \w of the people| strong="H5971" \w*, causing them [to err]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 29 \w Ye shall have a song| strong="H7892" \w*, \w as in the night| strong="H3915" \w* when \w a holy| strong="H6942" \w* \w solemnity| strong="H2282" \w* [is kept]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8692”}; \w and gladness| strong="H8057" \w* \w of heart| strong="H3824" \w*, [as when one goeth]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w with a pipe| strong="H2485" \w* [to come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w into the mountain| strong="H2022" \w* of the \sc Lord\sc*, \w to the mighty One| strong="H6697" \w* \w of Israel| strong="H3478" \w*.\f + \fr 30:29 \ft mighty…: Heb. Rock \f* 
\v 30 And the \sc Lord\sc* \w shall cause his glorious| strong="H1935" \w* \w voice| strong="H6963" \w* [to be heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8689”}, [and shall shew]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8686”} \w the lighting down| strong="H5183" \w* \w of his arm| strong="H2220" \w*, \w with the indignation| strong="H2197" \w* of his \w anger| strong="H639" \w*, and with \w the flame| strong="H3851" \w* [of a devouring]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} \w fire| strong="H784" \w*, with \w scattering| strong="H5311" \w*, \w and tempest| strong="H2230" \w*, [and hailstones]{strong=“H1259 H68”}.\f + \fr 30:30 \ft his glorious…: Heb. the glory of his voice \f* 
\v 31 \w For through the voice| strong="H6963" \w* of the \sc Lord\sc* \w shall the Assyrian| strong="H804" \w* [be beaten down]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8735”}, which [smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w with a rod| strong="H7626" \w*. 
\v 32 And in \w every place| strong="H3605" \w* \w where the grounded| strong="H4145" \w* \w staff| strong="H4294" \w* \w shall pass| strong="H4569" \w*, which the \sc Lord\sc* [shall lay]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8686”} upon him, it \w shall be with tabrets| strong="H8596" \w* \w and harps| strong="H3658" \w*: \w and in battles| strong="H4421" \w* \w of shaking| strong="H8573" \w* [will he fight]{strong=“H3898” x-morph=“strongMorph: \sc Th\sc*8738”} with it.\f + \fr 30:32 \ft in every…: Heb. every passing of the rod founded \f* \f + \fr 30:32 \ft lay…: Heb. cause to rest upon \f* \f + \fr 30:32 \ft with it: or, against them \f* 
\v 33 \w For Tophet| strong="H8613" \w* is [ordained]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8803”} \w of old| strong="H865" \w*; [yea, for the king]{strong=“H4428”} [it is prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8717”}; he hath made it [deep]{strong=“H6009” x-morph=“strongMorph: \sc Th\sc*8689”} and [large]{strong=“H7337” x-morph=“strongMorph: \sc Th\sc*8689”}: \w the pile| strong="H4071" \w* thereof is \w fire| strong="H784" \w* [and much]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8687”} \w wood| strong="H6086" \w*; \w the breath| strong="H5397" \w* of the \sc Lord\sc*, \w like a stream| strong="H5158" \w* \w of brimstone| strong="H1614" \w*, [doth kindle]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8802”} it.\f + \fr 30:33 \ft of old: Heb. from yesterday \f*
\c 31
\p 
\v 1 \w Woe| strong="H1945" \w* [to them that go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w to Egypt| strong="H4714" \w* \w for help| strong="H5833" \w*; [and stay]{strong=“H8172” x-morph=“strongMorph: \sc Th\sc*8735”} \w on horses| strong="H5483" \w*, [and trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} \w in chariots| strong="H7393" \w*, because they are \w many| strong="H7227" \w*; \w and in horsemen| strong="H6571" \w*, \w because they are very| strong="H3966" \w* [strong]{strong=“H6105” x-morph=“strongMorph: \sc Th\sc*8804”}; [but they look]{strong=“H8159” x-morph=“strongMorph: \sc Th\sc*8804”} \w not unto the Holy One| strong="H6918" \w* \w of Israel| strong="H3478" \w*, [neither seek]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8804”} the \sc Lord\sc*! 
\v 2 Yet he also is \w wise| strong="H2450" \w*, [and will bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w evil| strong="H7451" \w*, [and will not call back]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8689”} \w his words| strong="H1697" \w*: [but will arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”} \w against the house| strong="H1004" \w* [of the evildoers]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8688”}, \w and against the help| strong="H5833" \w* [of them that work]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w iniquity| strong="H205" \w*.\f + \fr 31:2 \ft call…: Heb. remove \f* 
\v 3 \w Now the Egyptians| strong="H4714" \w* are \w men| strong="H120" \w*, \w and not God| strong="H410" \w*; \w and their horses| strong="H5483" \w* \w flesh| strong="H1320" \w*, \w and not spirit| strong="H7307" \w*. When the \sc Lord\sc* [shall stretch out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w his hand| strong="H3027" \w*, [both he that helpeth]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8802”} [shall fall]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8804”}, [and he that is holpen]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8803”} [shall fall down]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”}, [and they all shall fail]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8799”} \w together| strong="H3162" \w*. 
\v 4 For thus hath the \sc Lord\sc* [spoken]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me, Like as the lion]{strong=“H738”} \w and the young lion| strong="H3715" \w* [roaring]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8799”} \w on his prey| strong="H2964" \w*, \w when a multitude| strong="H4393" \w* [of shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} [is called forth]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8735”} against him, he [will not be afraid]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8735”} \w of their voice| strong="H6963" \w*, [nor abase]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8799”} \w himself for the noise| strong="H1995" \w* of them: so shall the \sc Lord\sc* \w of hosts| strong="H6635" \w* [come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} [to fight]{strong=“H6633” x-morph=“strongMorph: \sc Th\sc*8800”} \w for mount| strong="H2022" \w* \w Zion| strong="H6726" \w*, \w and for the hill| strong="H1389" \w* thereof.\f + \fr 31:4 \ft noise: or, multitude \f* 
\v 5 \w As birds| strong="H6833" \w* [flying]{strong=“H5774” x-morph=“strongMorph: \sc Th\sc*8802”}, so will the \sc Lord\sc* \w of hosts| strong="H6635" \w* [defend]{strong=“H1598” x-morph=“strongMorph: \sc Th\sc*8686”} \w Jerusalem| strong="H3389" \w*; [defending]{strong=“H1598” x-morph=“strongMorph: \sc Th\sc*8800”} [also he will deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8689”} it; and [passing over]{strong=“H6452” x-morph=“strongMorph: \sc Th\sc*8800”} [he will preserve]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8689”} it. 
\p
\v 6 [Turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”} ye unto him from \w whom the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [have deeply]{strong=“H6009” x-morph=“strongMorph: \sc Th\sc*8689”} \w revolted| strong="H5627" \w*. 
\v 7 \w For in that day| strong="H3117" \w* \w every man| strong="H376" \w* [shall cast away]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8799”} \w his idols| strong="H457" \w* \w of silver| strong="H3701" \w*, \w and his idols| strong="H457" \w* \w of gold| strong="H2091" \w*, \w which your own hands| strong="H3027" \w* [have made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} unto you for \w a sin| strong="H2399" \w*.\f + \fr 31:7 \ft his idols of gold: Heb. the idols of his gold \f* 
\p
\v 8 \w Then shall the Assyrian| strong="H804" \w* [fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} \w with the sword| strong="H2719" \w*, \w not of a mighty man| strong="H376" \w*; \w and the sword| strong="H2719" \w*, \w not of a mean man| strong="H120" \w*, [shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [him: but he shall flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8804”} \w from| strong="H6440" \w* \w the sword| strong="H2719" \w*, \w and his young men| strong="H970" \w* \w shall be discomfited| strong="H4522" \w*.\f + \fr 31:8 \ft from: or, for fear of \f* \f + \fr 31:8 \ft discomfited: or, tributary: Heb. for melting, or, tribute \f* 
\v 9 [And he shall pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w to his strong hold| strong="H5553" \w* \w for fear| strong="H4032" \w*, \w and his princes| strong="H8269" \w* [shall be afraid]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the ensign| strong="H5251" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, \w whose fire| strong="H217" \w* is \w in Zion| strong="H6726" \w*, \w and his furnace| strong="H8574" \w* \w in Jerusalem| strong="H3389" \w*.\f + \fr 31:9 \ft he…: Heb. his rock shall pass away for fear \f* \f + \fr 31:9 \ft his strong hold: or, his strength \f*
\c 32
\p 
\v 1 [Behold, a king]{strong=“H4428”} [shall reign]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in righteousness| strong="H6664" \w*, \w and princes| strong="H8269" \w* [shall rule]{strong=“H8323” x-morph=“strongMorph: \sc Th\sc*8799”} \w in judgment| strong="H4941" \w*. 
\v 2 \w And a man| strong="H376" \w* \w shall be as an hiding place| strong="H4224" \w* \w from the wind| strong="H7307" \w*, \w and a covert| strong="H5643" \w* \w from the tempest| strong="H2230" \w*; \w as rivers| strong="H6388" \w* \w of water| strong="H4325" \w* \w in a dry place| strong="H6724" \w*, \w as the shadow| strong="H6738" \w* \w of a great| strong="H3515" \w* \w rock| strong="H5553" \w* \w in a weary| strong="H5889" \w* \w land| strong="H776" \w*.\f + \fr 32:2 \ft great: Heb. heavy \f* 
\v 3 \w And the eyes| strong="H5869" \w* [of them that see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} [shall not be dim]{strong=“H8159” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the ears| strong="H241" \w* [of them that hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} [shall hearken]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 4 \w The heart| strong="H3824" \w* [also of the rash]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8737”} [shall understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} \w knowledge| strong="H1847" \w*, \w and the tongue| strong="H3956" \w* \w of the stammerers| strong="H5926" \w* [shall be ready]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8762”} [to speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w plainly| strong="H6703" \w*.\f + \fr 32:4 \ft rash: Heb. hasty \f* \f + \fr 32:4 \ft plainly: or, elegantly \f* 
\v 5 \w The vile person| strong="H5036" \w* [shall be no more called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8735”} \w liberal| strong="H5081" \w*, \w nor the churl| strong="H3596" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8735”} to be \w bountiful| strong="H7771" \w*. 
\v 6 \w For the vile person| strong="H5036" \w* [will speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w villany| strong="H5039" \w*, \w and his heart| strong="H3820" \w* [will work]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w iniquity| strong="H205" \w*, [to practise]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w hypocrisy| strong="H2612" \w*, [and to utter]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w error| strong="H8442" \w* against the \sc Lord\sc*, [to make empty]{strong=“H7324” x-morph=“strongMorph: \sc Th\sc*8687”} \w the soul| strong="H5315" \w* \w of the hungry| strong="H7457" \w*, \w and he will cause the drink| strong="H4945" \w* \w of the thirsty| strong="H6771" \w* [to fail]{strong=“H2637” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 7 \w The instruments| strong="H3627" \w* \w also of the churl| strong="H3596" \w* are \w evil| strong="H7451" \w*: [he deviseth]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8804”} \w wicked devices| strong="H2154" \w* [to destroy]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8763”} [the poor]{strong=“H6035 H6041” x-morph=“strongMorph: \sc Th\sc*8675”} \w with lying| strong="H8267" \w* \w words| strong="H561" \w*, \w even when the needy| strong="H34" \w* [speaketh]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w right| strong="H4941" \w*.\f + \fr 32:7 \ft the needy…: or, he speaketh against the poor in judgment \f* 
\v 8 \w But the liberal| strong="H5081" \w* [deviseth]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8804”} \w liberal things| strong="H5081" \w*; \w and by liberal things| strong="H5081" \w* [shall he stand]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 32:8 \ft stand: or, be established \f* 
\p
\v 9 [Rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”}, \w ye women| strong="H802" \w* \w that are at ease| strong="H7600" \w*; [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w my voice| strong="H6963" \w*, [ye careless]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”} \w daughters| strong="H1323" \w*; [give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto my speech| strong="H565" \w*. 
\v 10 \w Many days| strong="H3117" \w* \w and years| strong="H8141" \w* [shall ye be troubled]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8799”}, [ye careless women]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”}: \w for the vintage| strong="H1210" \w* [shall fail]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the gathering| strong="H625" \w* [shall not come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 32:10 \ft Many…: Heb. Days above a year \f* 
\v 11 [Tremble]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8798”}, \w ye women that are at ease| strong="H7600" \w*; [be troubled]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8798”}, [ye careless ones]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”}: [strip]{strong=“H6584” x-morph=“strongMorph: \sc Th\sc*8800”} [you, and make you bare]{strong=“H6209” x-morph=“strongMorph: \sc Th\sc*8798”}, \w and gird| strong="H2290" \w* sackcloth upon your \w loins| strong="H2504" \w*. 
\v 12 [They shall lament]{strong=“H5594” x-morph=“strongMorph: \sc Th\sc*8802”} \w for the teats| strong="H7699" \w*, \w for the pleasant| strong="H2531" \w* \w fields| strong="H7704" \w*, [for the fruitful]{strong=“H6509” x-morph=“strongMorph: \sc Th\sc*8802”} \w vine| strong="H1612" \w*.\f + \fr 32:12 \ft pleasant…: Heb. fields of desire \f* 
\v 13 \w Upon the land| strong="H127" \w* \w of my people| strong="H5971" \w* [shall come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w thorns| strong="H6975" \w* and \w briers| strong="H8068" \w*; [yea, upon all the houses]{strong=“H1004”} \w of joy| strong="H4885" \w* in \w the joyous| strong="H5947" \w* \w city| strong="H7151" \w*:\f + \fr 32:13 \ft yea…: or, burning upon \f* 
\v 14 \w Because the palaces| strong="H759" \w* [shall be forsaken]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8795”}; \w the multitude| strong="H1995" \w* \w of the city| strong="H5892" \w* [shall be left]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8795”}; \w the forts| strong="H6076" \w* \w and towers| strong="H975" \w* \w shall be for dens| strong="H4631" \w* \w for| strong="H5704" \w* \w ever| strong="H5769" \w*, \w a joy| strong="H4885" \w* \w of wild asses| strong="H6501" \w*, \w a pasture| strong="H4829" \w* \w of flocks| strong="H5739" \w*;\f + \fr 32:14 \ft forts…: or, clifts and watchtowers \f* 
\v 15 \w Until the spirit| strong="H7307" \w* [be poured]{strong=“H6168” x-morph=“strongMorph: \sc Th\sc*8735”} \w upon us from on high| strong="H4791" \w*, \w and the wilderness| strong="H4057" \w* \w be a fruitful field| strong="H3759" \w*, \w and the fruitful field| strong="H3759" \w* [be counted]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8735”} \w for a forest| strong="H3293" \w*. 
\v 16 \w Then judgment| strong="H4941" \w* [shall dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the wilderness| strong="H4057" \w*, \w and righteousness| strong="H6666" \w* [remain]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the fruitful field| strong="H3759" \w*. 
\v 17 \w And the work| strong="H4639" \w* \w of righteousness| strong="H6666" \w* \w shall be peace| strong="H7965" \w*; \w and the effect| strong="H5656" \w* \w of righteousness| strong="H6666" \w* [quietness]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8687”} \w and assurance| strong="H983" \w* \w for| strong="H5704" \w* \w ever| strong="H5769" \w*. 
\v 18 \w And my people| strong="H5971" \w* [shall dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w in a peaceable| strong="H7965" \w* \w habitation| strong="H5116" \w*, \w and in sure| strong="H4009" \w* \w dwellings| strong="H4908" \w*, \w and in quiet| strong="H7600" \w* \w resting places| strong="H4496" \w*; 
\v 19 [When it shall hail]{strong=“H1258” x-morph=“strongMorph: \sc Th\sc*8804”}, [coming down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8800”} \w on the forest| strong="H3293" \w*; \w and the city| strong="H5892" \w* [shall be low]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8799”} \w in a low place| strong="H8218" \w*.\f + \fr 32:19 \ft low in…: or, utterly abased \f* 
\v 20 \w Blessed| strong="H835" \w* are [ye that sow]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8802”} \w beside all waters| strong="H4325" \w*, [that send forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8764”} thither \w the feet| strong="H7272" \w* \w of the ox| strong="H7794" \w* \w and the ass| strong="H2543" \w*.
\c 33
\p 
\v 1 \w Woe| strong="H1945" \w* [to thee that spoilest]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8802”}, and thou wast [not spoiled]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8803”}; [and dealest treacherously]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”}, [and they dealt not treacherously]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8804”} [with thee! when thou shalt cease]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8687”} [to spoil]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8802”}, [thou shalt be spoiled]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8714”}; and [when thou shalt make an end]{strong=“H5239” x-morph=“strongMorph: \sc Th\sc*8687”} [to deal treacherously]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8800”}, [they shall deal treacherously]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8799”} with thee. 
\v 2 O \sc Lord\sc*, [be gracious]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} [unto us; we have waited]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8765”} [for thee: be thou their arm]{strong=“H2220”} \w every morning| strong="H1242" \w*, \w our salvation| strong="H3444" \w* \w also in the time| strong="H6256" \w* \w of trouble| strong="H6869" \w*. 
\v 3 \w At the noise| strong="H6963" \w* \w of the tumult| strong="H1995" \w* \w the people| strong="H5971" \w* [fled]{strong=“H5074” x-morph=“strongMorph: \sc Th\sc*8804”}; \w at the lifting up| strong="H7427" \w* \w of thyself the nations| strong="H1471" \w* [were scattered]{strong=“H5310” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 4 \w And your spoil| strong="H7998" \w* [shall be gathered]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8795”} like \w the gathering| strong="H625" \w* \w of the caterpiller| strong="H2625" \w*: \w as the running to and fro| strong="H4944" \w* \w of locusts| strong="H1357" \w* [shall he run]{strong=“H8264” x-morph=“strongMorph: \sc Th\sc*8802”} upon them. 
\v 5 The \sc Lord\sc* [is exalted]{strong=“H7682” x-morph=“strongMorph: \sc Th\sc*8737”}; [for he dwelleth]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8802”} \w on high| strong="H4791" \w*: [he hath filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8765”} \w Zion| strong="H6726" \w* \w with judgment| strong="H4941" \w* \w and righteousness| strong="H6666" \w*. 
\v 6 \w And wisdom| strong="H2451" \w* \w and knowledge| strong="H1847" \w* \w shall be the stability| strong="H530" \w* \w of thy times| strong="H6256" \w*, and \w strength| strong="H2633" \w* \w of salvation| strong="H3444" \w*: \w the fear| strong="H3374" \w* of the \sc Lord\sc* is \w his treasure| strong="H214" \w*.\f + \fr 33:6 \ft salvation: Heb. salvations \f* 
\v 7 [Behold, their valiant ones]{strong=“H691”} [shall cry]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8804”} \w without| strong="H2351" \w*: \w the ambassadors| strong="H4397" \w* \w of peace| strong="H7965" \w* [shall weep]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8799”} \w bitterly| strong="H4751" \w*.\f + \fr 33:7 \ft valiant…: or, messengers \f* 
\v 8 \w The highways| strong="H4546" \w* [lie waste]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8738”}, [the wayfaring man]{strong=“H734 H5674” x-morph=“strongMorph: \sc Th\sc*8802”} [ceaseth]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8804”}: [he hath broken]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8689”} \w the covenant| strong="H1285" \w*, [he hath despised]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} \w the cities| strong="H5892" \w*, [he regardeth]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8804”} \w no man| strong="H582" \w*. 
\v 9 \w The earth| strong="H776" \w* [mourneth]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8804”} and [languisheth]{strong=“H535” x-morph=“strongMorph: \sc Th\sc*8797”}: \w Lebanon| strong="H3844" \w* [is ashamed]{strong=“H2659” x-morph=“strongMorph: \sc Th\sc*8689”} and [hewn down]{strong=“H7060” x-morph=“strongMorph: \sc Th\sc*8804”}: \w Sharon| strong="H8289" \w* \w is like a wilderness| strong="H6160" \w*; \w and Bashan| strong="H1316" \w* \w and Carmel| strong="H3760" \w* [shake off]{strong=“H5287” x-morph=“strongMorph: \sc Th\sc*8802”} their fruits.\f + \fr 33:9 \ft hewn…: or, withered away \f* 
\v 10 [Now will I rise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc*; [now will I be exalted]{strong=“H7426” x-morph=“strongMorph: \sc Th\sc*8735”}; [now will I lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8735”} myself. 
\v 11 [Ye shall conceive]{strong=“H2029” x-morph=“strongMorph: \sc Th\sc*8799”} \w chaff| strong="H2842" \w*, [ye shall bring forth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8799”} \w stubble| strong="H7179" \w*: \w your breath| strong="H7307" \w*, as \w fire| strong="H784" \w*, [shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} you. 
\v 12 \w And the people| strong="H5971" \w* shall be as \w the burnings| strong="H4955" \w* \w of lime| strong="H7875" \w*: as \w thorns| strong="H6975" \w* [cut up]{strong=“H3683” x-morph=“strongMorph: \sc Th\sc*8803”} [shall they be burned]{strong=“H3341” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the fire| strong="H784" \w*. 
\p
\v 13 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”}, ye that are \w far off| strong="H7350" \w*, [what I have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}; and, ye that are \w near| strong="H7138" \w*, [acknowledge]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”} \w my might| strong="H1369" \w*. 
\v 14 \w The sinners| strong="H2400" \w* \w in Zion| strong="H6726" \w* [are afraid]{strong=“H6342” x-morph=“strongMorph: \sc Th\sc*8804”}; \w fearfulness| strong="H7461" \w* [hath surprised]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8804”} \w the hypocrites| strong="H2611" \w*. [Who among us shall dwell]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”} [with the devouring]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} \w fire| strong="H784" \w*? [who among us shall dwell]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”} \w with everlasting| strong="H5769" \w* \w burnings| strong="H4168" \w*? 
\v 15 [He that walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w righteously| strong="H6666" \w*, [and speaketh]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8802”} \w uprightly| strong="H4339" \w*; [he that despiseth]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8802”} \w the gain| strong="H1215" \w* \w of oppressions| strong="H4642" \w*, [that shaketh]{strong=“H5287” x-morph=“strongMorph: \sc Th\sc*8802”} \w his hands| strong="H3709" \w* [from holding]{strong=“H8551” x-morph=“strongMorph: \sc Th\sc*8800”} \w of bribes| strong="H7810" \w*, [that stoppeth]{strong=“H331” x-morph=“strongMorph: \sc Th\sc*8801”} \w his ears| strong="H241" \w* [from hearing]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w of blood| strong="H1818" \w*, [and shutteth]{strong=“H6105” x-morph=“strongMorph: \sc Th\sc*8802”} \w his eyes| strong="H5869" \w* [from seeing]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w evil| strong="H7451" \w*;\f + \fr 33:15 \ft righteously: Heb. in righteousnesses \f* \f + \fr 33:15 \ft uprightly: Heb. uprightnesses \f* \f + \fr 33:15 \ft oppressions: or, deceits \f* \f + \fr 33:15 \ft blood: Heb. bloods \f* 
\v 16 [He shall dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} \w on high| strong="H4791" \w*: \w his place of defence| strong="H4869" \w* shall be \w the munitions| strong="H4679" \w* \w of rocks| strong="H5553" \w*: \w bread| strong="H3899" \w* [shall be given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8737”} [him; his waters]{strong=“H4325”} shall be [sure]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8737”}.\f + \fr 33:16 \ft high: Heb. heights, or, high places \f* 
\v 17 \w Thine eyes| strong="H5869" \w* [shall see]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8799”} \w the king| strong="H4428" \w* \w in his beauty| strong="H3308" \w*: [they shall behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the land| strong="H776" \w* \w that is very far off| strong="H4801" \w*.\f + \fr 33:17 \ft that…: Heb. of far distances \f* 
\v 18 \w Thine heart| strong="H3820" \w* [shall meditate]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8799”} \w terror| strong="H367" \w*. Where is [the scribe]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8802”}? where is [the receiver]{strong=“H8254” x-morph=“strongMorph: \sc Th\sc*8802”}? where is [he that counted]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8802”} \w the towers| strong="H4026" \w*?\f + \fr 33:18 \ft receiver: Heb. weigher? \f* 
\v 19 [Thou shalt not see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [a fierce]{strong=“H3267” x-morph=“strongMorph: \sc Th\sc*8737”} \w people| strong="H5971" \w*, \w a people| strong="H5971" \w* \w of a deeper| strong="H6012" \w* \w speech| strong="H8193" \w* [than thou canst perceive]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”}; [of a stammering]{strong=“H3932” x-morph=“strongMorph: \sc Th\sc*8737”} \w tongue| strong="H3956" \w*, that thou canst \w not understand| strong="H998" \w*.\f + \fr 33:19 \ft stammering: or, ridiculous \f* 
\v 20 [Look]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8798”} \w upon Zion| strong="H6726" \w*, \w the city| strong="H7151" \w* \w of our solemnities| strong="H4150" \w*: \w thine eyes| strong="H5869" \w* [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jerusalem| strong="H3389" \w* \w a quiet| strong="H7600" \w* \w habitation| strong="H5116" \w*, \w a tabernacle| strong="H168" \w* that [shall not be taken down]{strong=“H6813” x-morph=“strongMorph: \sc Th\sc*8799”}; \w not one of the stakes| strong="H3489" \w* \w thereof shall ever| strong="H5331" \w* [be removed]{strong=“H5265” x-morph=“strongMorph: \sc Th\sc*8799”}, \w neither shall any of the cords| strong="H2256" \w* [thereof be broken]{strong=“H5423” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 21 \w But there the glorious| strong="H117" \w* \sc Lord\sc* will be \w unto us a place| strong="H4725" \w* [of broad]{strong=“H3027 H7342”} \w rivers| strong="H5104" \w* and \w streams| strong="H2975" \w*; [wherein shall go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w no| strong="H1077" \w* \w galley| strong="H590" \w* \w with oars| strong="H7885" \w*, \w neither shall gallant| strong="H117" \w* \w ship| strong="H6716" \w* [pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} thereby.\f + \fr 33:21 \ft of…: Heb. broad of spaces, or, hands \f* 
\v 22 For the \sc Lord\sc* is [our judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”}, the \sc Lord\sc* is [our lawgiver]{strong=“H2710” x-morph=“strongMorph: \sc Th\sc*8781”}, the \sc Lord\sc* is \w our king| strong="H4428" \w*; [he will save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} us.\f + \fr 33:22 \ft lawgiver: Heb. statutemaker \f* 
\v 23 \w Thy tacklings| strong="H2256" \w* [are loosed]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8738”}; \w they could not well| strong="H3653" \w* [strengthen]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8762”} \w their mast| strong="H8650" \w*, [they could not spread]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8804”} \w the sail| strong="H5251" \w*: \w then is the prey| strong="H5706" \w* \w of a great| strong="H4766" \w* \w spoil| strong="H7998" \w* [divided]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8795”}; \w the lame| strong="H6455" \w* [take]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8804”} \w the prey| strong="H957" \w*.\f + \fr 33:23 \ft Thy…: or, They have forsaken thy tacklings \f* 
\v 24 \w And the inhabitant| strong="H7934" \w* [shall not say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I am sick]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8804”}: \w the people| strong="H5971" \w* [that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} therein shall be [forgiven]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8803”} their \w iniquity| strong="H5771" \w*.
\c 34
\p 
\v 1 [Come near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8798”}, \w ye nations| strong="H1471" \w*, [to hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”}; [and hearken]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8685”}, \w ye people| strong="H3816" \w*: \w let the earth| strong="H776" \w* [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and all that is therein| strong="H4393" \w*; \w the world| strong="H8398" \w*, \w and all things that come forth| strong="H6631" \w* of it.\f + \fr 34:1 \ft all that…: Heb. the fulness thereof \f* 
\v 2 \w For the indignation| strong="H7110" \w* of the \sc Lord\sc* is \w upon all nations| strong="H1471" \w*, and his \w fury| strong="H2534" \w* \w upon all their armies| strong="H6635" \w*: [he hath utterly destroyed]{strong=“H2763” x-morph=“strongMorph: \sc Th\sc*8689”} [them, he hath delivered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w them to the slaughter| strong="H2874" \w*. 
\v 3 \w Their slain| strong="H2491" \w* [also shall be cast out]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8714”}, \w and their stink| strong="H889" \w* [shall come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of their carcases| strong="H6297" \w*, \w and the mountains| strong="H2022" \w* [shall be melted]{strong=“H4549” x-morph=“strongMorph: \sc Th\sc*8738”} \w with their blood| strong="H1818" \w*. 
\v 4 \w And all the host| strong="H6635" \w* \w of heaven| strong="H8064" \w* [shall be dissolved]{strong=“H4743” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and the heavens| strong="H8064" \w* [shall be rolled together]{strong=“H1556” x-morph=“strongMorph: \sc Th\sc*8738”} \w as a scroll| strong="H5612" \w*: \w and all their host| strong="H6635" \w* [shall fall down]{strong=“H5034” x-morph=“strongMorph: \sc Th\sc*8799”}, \w as the leaf| strong="H5929" \w* [falleth off]{strong=“H5034” x-morph=“strongMorph: \sc Th\sc*8800”} \w from the vine| strong="H1612" \w*, [and as a falling]{strong=“H5034” x-morph=“strongMorph: \sc Th\sc*8802”} fig \w from the fig tree| strong="H8384" \w*. 
\v 5 \w For my sword| strong="H2719" \w* [shall be bathed]{strong=“H7301” x-morph=“strongMorph: \sc Th\sc*8765”} \w in heaven| strong="H8064" \w*: [behold, it shall come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon Idumea| strong="H123" \w*, \w and upon the people| strong="H5971" \w* \w of my curse| strong="H2764" \w*, \w to judgment| strong="H4941" \w*. 
\v 6 \w The sword| strong="H2719" \w* of the \sc Lord\sc* [is filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w with blood| strong="H1818" \w*, [it is made fat]{strong=“H1878” x-morph=“strongMorph: \sc Th\sc*8719”} \w with fatness| strong="H2459" \w*, and \w with the blood| strong="H1818" \w* \w of lambs| strong="H3733" \w* \w and goats| strong="H6260" \w*, \w with the fat| strong="H2459" \w* \w of the kidneys| strong="H3629" \w* \w of rams| strong="H352" \w*: for the \sc Lord\sc* \w hath a sacrifice| strong="H2077" \w* \w in Bozrah| strong="H1224" \w*, \w and a great| strong="H1419" \w* \w slaughter| strong="H2874" \w* \w in the land| strong="H776" \w* \w of Idumea| strong="H123" \w*. 
\v 7 \w And the unicorns| strong="H7214" \w* [shall come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} [with them, and the bullocks]{strong=“H6499”} \w with the bulls| strong="H47" \w*; \w and their land| strong="H776" \w* [shall be soaked]{strong=“H7301” x-morph=“strongMorph: \sc Th\sc*8765”} \w with blood| strong="H1818" \w*, \w and their dust| strong="H6083" \w* [made fat]{strong=“H1878” x-morph=“strongMorph: \sc Th\sc*8792”} \w with fatness| strong="H2459" \w*.\f + \fr 34:7 \ft unicorns: or, rhinocerots \f* \f + \fr 34:7 \ft soaked: or, drunken \f* 
\v 8 For it is \w the day| strong="H3117" \w* of the \sc Lord\sc*’S \w vengeance| strong="H5359" \w*, and \w the year| strong="H8141" \w* \w of recompences| strong="H7966" \w* \w for the controversy| strong="H7379" \w* \w of Zion| strong="H6726" \w*. 
\p
\v 9 \w And the streams| strong="H5158" \w* [thereof shall be turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8738”} \w into pitch| strong="H2203" \w*, \w and the dust| strong="H6083" \w* \w thereof into brimstone| strong="H1614" \w*, \w and the land| strong="H776" \w* [thereof shall become burning]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8802”} \w pitch| strong="H2203" \w*. 
\v 10 [It shall not be quenched]{strong=“H3518” x-morph=“strongMorph: \sc Th\sc*8799”} \w night| strong="H3915" \w* \w nor day| strong="H3119" \w*; \w the smoke| strong="H6227" \w* [thereof shall go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w for ever| strong="H5769" \w*: \w from generation| strong="H1755" \w* \w to generation| strong="H1755" \w* [it shall lie waste]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8799”}; [none shall pass through]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} \w it for ever| strong="H5331" \w* \w and ever| strong="H5331" \w*. 
\p
\v 11 \w But the cormorant| strong="H6893" \w* \w and the bittern| strong="H7090" \w* [shall possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8804”} [it; the owl]{strong=“H3244”} \w also and the raven| strong="H6158" \w* [shall dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} [in it: and he shall stretch out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon it the line| strong="H6957" \w* \w of confusion| strong="H8414" \w*, \w and the stones| strong="H68" \w* \w of emptiness| strong="H922" \w*.\f + \fr 34:11 \ft cormorant: or, pelican \f* 
\v 12 [They shall call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w the nobles| strong="H2715" \w* \w thereof to the kingdom| strong="H4410" \w*, but none shall be [there, and all her princes]{strong=“H8269”} \w shall be nothing| strong="H657" \w*. 
\v 13 \w And thorns| strong="H5518" \w* [shall come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w in her palaces| strong="H759" \w*, \w nettles| strong="H7057" \w* \w and brambles| strong="H2336" \w* \w in the fortresses| strong="H4013" \w* [thereof: and it shall be an habitation]{strong=“H5116”} \w of dragons| strong="H8577" \w*, and \w a court| strong="H2681" \w* [for owls]{strong=“H3284 H1323”}.\f + \fr 34:13 \ft owls: or, ostriches: Heb. daughters of the owl \f* 
\v 14 \w The wild beasts of the desert| strong="H6728" \w* [shall also meet]{strong=“H6298” x-morph=“strongMorph: \sc Th\sc*8804”} \w with the wild beasts of the island| strong="H338" \w*, \w and the satyr| strong="H8163" \w* [shall cry]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w to his fellow| strong="H7453" \w*; \w the screech owl| strong="H3917" \w* [also shall rest]{strong=“H7280” x-morph=“strongMorph: \sc Th\sc*8689”} [there, and find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w for herself a place of rest| strong="H4494" \w*.\f + \fr 34:14 \ft The wild beasts of the desert: Heb. Ziim \f* \f + \fr 34:14 \ft the wild beasts of the island: Heb. Ijim \f* \f + \fr 34:14 \ft screech…: or, night monster \f* 
\v 15 \w There shall the great owl| strong="H7091" \w* [make her nest]{strong=“H7077” x-morph=“strongMorph: \sc Th\sc*8765”}, [and lay]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8762”}, [and hatch]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8804”}, [and gather]{strong=“H1716” x-morph=“strongMorph: \sc Th\sc*8804”} \w under her shadow| strong="H6738" \w*: \w there shall the vultures| strong="H1772" \w* [also be gathered]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8738”}, \w every one| strong="H802" \w* \w with her mate| strong="H7468" \w*. 
\p
\v 16 [Seek ye out]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8798”} \w of the book| strong="H5612" \w* of the \sc Lord\sc*, [and read]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”}: \w no one| strong="H259" \w* \w of these| strong="H2007" \w* [shall fail]{strong=“H5737” x-morph=“strongMorph: \sc Th\sc*8738”}, \w none| strong="H802" \w* [shall want]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} \w her mate| strong="H7468" \w*: \w for my mouth| strong="H6310" \w* [it hath commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”}, \w and his spirit| strong="H7307" \w* [it hath gathered]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8765”} them. 
\v 17 [And he hath cast]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8689”} \w the lot| strong="H1486" \w* [for them, and his hand]{strong=“H3027”} [hath divided]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8765”} \w it unto them by line| strong="H6957" \w*: [they shall possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8799”} \w it for| strong="H5704" \w* \w ever| strong="H5769" \w*, \w from generation| strong="H1755" \w* \w to generation| strong="H1755" \w* [shall they dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} therein. 
\c 35
\p 
\v 1 \w The wilderness| strong="H4057" \w* \w and the solitary place| strong="H6723" \w* [shall be glad]{strong=“H7797” x-morph=“strongMorph: \sc Th\sc*8799”} [for them; and the desert]{strong=“H6160”} [shall rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”}, [and blossom]{strong=“H6524” x-morph=“strongMorph: \sc Th\sc*8799”} \w as the rose| strong="H2261" \w*. 
\v 2 [It shall blossom]{strong=“H6524” x-morph=“strongMorph: \sc Th\sc*8799”} [abundantly]{strong=“H6524” x-morph=“strongMorph: \sc Th\sc*8800”}, [and rejoice]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”} \w even with joy| strong="H1525" \w* [and singing]{strong=“H7444” x-morph=“strongMorph: \sc Th\sc*8763”}: \w the glory| strong="H3519" \w* \w of Lebanon| strong="H3844" \w* [shall be given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} [unto it, the excellency]{strong=“H1926”} \w of Carmel| strong="H3760" \w* \w and Sharon| strong="H8289" \w*, [they shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the glory| strong="H3519" \w* of the \sc Lord\sc*, and \w the excellency| strong="H1926" \w* \w of our God| strong="H430" \w*. 
\p
\v 3 [Strengthen]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8761”} \w ye the weak| strong="H7504" \w* \w hands| strong="H3027" \w*, [and confirm]{strong=“H553” x-morph=“strongMorph: \sc Th\sc*8761”} [the feeble]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8802”} \w knees| strong="H1290" \w*. 
\v 4 [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} to them that are [of a fearful]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8737”} \w heart| strong="H3820" \w*, [Be strong]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8798”}, [fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} [not: behold, your God]{strong=“H430”} [will come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} with \w vengeance| strong="H5359" \w*, even \w God| strong="H430" \w* with \w a recompence| strong="H1576" \w*; [he will come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} you.\f + \fr 35:4 \ft fearful: Heb. hasty \f* 
\p
\v 5 \w Then the eyes| strong="H5869" \w* \w of the blind| strong="H5787" \w* [shall be opened]{strong=“H6491” x-morph=“strongMorph: \sc Th\sc*8735”}, \w and the ears| strong="H241" \w* \w of the deaf| strong="H2795" \w* [shall be unstopped]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 6 \w Then shall the lame| strong="H6455" \w* man [leap]{strong=“H1801” x-morph=“strongMorph: \sc Th\sc*8762”} \w as an hart| strong="H354" \w*, \w and the tongue| strong="H3956" \w* \w of the dumb| strong="H483" \w* [sing]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8799”}: \w for in the wilderness| strong="H4057" \w* \w shall waters| strong="H4325" \w* [break out]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and streams| strong="H5158" \w* \w in the desert| strong="H6160" \w*. 
\v 7 \w And the parched ground| strong="H8273" \w* \w shall become a pool| strong="H98" \w*, \w and the thirsty land| strong="H6774" \w* \w springs| strong="H4002" \w* \w of water| strong="H4325" \w*: \w in the habitation| strong="H5116" \w* \w of dragons| strong="H8577" \w*, \w where each lay| strong="H7258" \w*, shall be \w grass| strong="H2682" \w* \w with reeds| strong="H7070" \w* \w and rushes| strong="H1573" \w*.\f + \fr 35:7 \ft grass…: or, a court for reeds, etc \f* 
\v 8 \w And an highway| strong="H4547" \w* [shall be there, and a way]{strong=“H1870”}, [and it shall be called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8735”} \w The way| strong="H1870" \w* \w of holiness| strong="H6944" \w*; \w the unclean| strong="H2931" \w* [shall not pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} it; but it shall be [for those: the wayfaring men]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”}, \w though fools| strong="H191" \w*, [shall not err]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8799”} therein.\f + \fr 35:8 \ft but…: or, for he shall be with them \f* 
\v 9 \w No lion| strong="H738" \w* shall be there, nor any \w ravenous| strong="H6530" \w* \w beast| strong="H2416" \w* [shall go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} [thereon, it shall not be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”} [there; but the redeemed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8803”} [shall walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} there: 
\v 10 [And the ransomed]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8803”} of the \sc Lord\sc* [shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [and come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w to Zion| strong="H6726" \w* \w with songs| strong="H7440" \w* \w and everlasting| strong="H5769" \w* \w joy| strong="H8057" \w* \w upon their heads| strong="H7218" \w*: [they shall obtain]{strong=“H5381” x-morph=“strongMorph: \sc Th\sc*8686”} \w joy| strong="H8057" \w* \w and gladness| strong="H8342" \w*, \w and sorrow| strong="H3015" \w* \w and sighing| strong="H585" \w* [shall flee away]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8804”}.
\c 36
\p 
\v 1 [Now it came to pass in the fourteenth]{strong=“H6240 H702”} \w year| strong="H8141" \w* \w of king| strong="H4428" \w* \w Hezekiah| strong="H2396" \w*, that \w Sennacherib| strong="H5576" \w* \w king| strong="H4428" \w* \w of Assyria| strong="H804" \w* [came up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} [against all the defenced]{strong=“H1219” x-morph=“strongMorph: \sc Th\sc*8803”} \w cities| strong="H5892" \w* \w of Judah| strong="H3063" \w*, [and took]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8799”} them. 
\v 2 \w And the king| strong="H4428" \w* \w of Assyria| strong="H804" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w Rabshakeh| strong="H7262" \w* \w from Lachish| strong="H3923" \w* \w to Jerusalem| strong="H3389" \w* \w unto king| strong="H4428" \w* \w Hezekiah| strong="H2396" \w* \w with a great| strong="H3515" \w* \w army| strong="H2426" \w*. [And he stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the conduit| strong="H8585" \w* \w of the upper| strong="H5945" \w* \w pool| strong="H1295" \w* \w in the highway| strong="H4546" \w* [of the fuller’s]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8801”} \w field| strong="H7704" \w*. 
\v 3 [Then came forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto him Eliakim| strong="H471" \w*, [Hilkiah’s]{strong=“H2518”} \w son| strong="H1121" \w*, \w which was over the house| strong="H1004" \w*, \w and Shebna| strong="H7644" \w* [the scribe]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and Joah| strong="H3098" \w*, [Asaph’s]{strong=“H623”} \w son| strong="H1121" \w*, [the recorder]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8688”}.\f + \fr 36:3 \ft scribe: or, secretary \f* 
\p
\v 4 \w And Rabshakeh| strong="H7262" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye now to Hezekiah| strong="H2396" \w*, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the great| strong="H1419" \w* \w king| strong="H4428" \w*, \w the king| strong="H4428" \w* \w of Assyria| strong="H804" \w*, \w What confidence| strong="H986" \w* is [this wherein thou trustest]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”}? 
\v 5 [I say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, sayest thou, (but they are but \w vain| strong="H8193" \w* \w words| strong="H1697" \w*) I have \w counsel| strong="H6098" \w* \w and strength| strong="H1369" \w* \w for war| strong="H4421" \w*: [now on whom dost thou trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”}, [that thou rebellest]{strong=“H4775” x-morph=“strongMorph: \sc Th\sc*8804”} against me?\f + \fr 36:5 \ft vain…: Heb. a word of lips \f* \f + \fr 36:5 \ft I have…: or, but counsel and strength are for the war \f* 
\v 6 [Lo, thou trustest]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the staff| strong="H4938" \w* [of this broken]{strong=“H7533” x-morph=“strongMorph: \sc Th\sc*8803”} \w reed| strong="H7070" \w*, \w on Egypt| strong="H4714" \w*; \w whereon if a man| strong="H376" \w* [lean]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8735”}, [it will go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into his hand| strong="H3709" \w*, [and pierce]{strong=“H5344” x-morph=“strongMorph: \sc Th\sc*8804”} it: so is \w Pharaoh| strong="H6547" \w* \w king| strong="H4428" \w* \w of Egypt| strong="H4714" \w* [to all that trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8802”} in him. 
\v 7 [But if thou say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [to me, We trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”} in the \sc Lord\sc* \w our God| strong="H430" \w*: is it [not he, whose high places]{strong=“H1116”} \w and whose altars| strong="H4196" \w* \w Hezekiah| strong="H2396" \w* [hath taken away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8689”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Judah| strong="H3063" \w* \w and to Jerusalem| strong="H3389" \w*, [Ye shall worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} \w before| strong="H6440" \w* \w this altar| strong="H4196" \w*? 
\v 8 [Now therefore give pledges]{strong=“H6148” x-morph=“strongMorph: \sc Th\sc*8690”}, [I pray thee, to my master]{strong=“H113”} \w the king| strong="H4428" \w* \w of Assyria| strong="H804" \w*, [and I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee two thousand| strong="H505" \w* \w horses| strong="H5483" \w*, [if thou be able]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [on thy part to set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} [riders]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8802”} upon them.\f + \fr 36:8 \ft pledges: or, hostages \f* 
\v 9 [How then wilt thou turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w the face| strong="H6440" \w* \w of one| strong="H259" \w* \w captain| strong="H6346" \w* \w of the least| strong="H6996" \w* [of my master’s]{strong=“H113”} \w servants| strong="H5650" \w*, [and put thy trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} \w on Egypt| strong="H4714" \w* \w for chariots| strong="H7393" \w* \w and for horsemen| strong="H6571" \w*? 
\v 10 [And am I now come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w without| strong="H1107" \w* the \sc Lord\sc* \w against this land| strong="H776" \w* [to destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8687”} it? the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me, Go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”} \w against this land| strong="H776" \w*, [and destroy]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8685”} it. 
\p
\v 11 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w Eliakim| strong="H471" \w* \w and Shebna| strong="H7644" \w* \w and Joah| strong="H3098" \w* \w unto Rabshakeh| strong="H7262" \w*, [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”}, [I pray thee, unto thy servants]{strong=“H5650”} \w in the Syrian language| strong="H762" \w*; [for we understand]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} it: [and speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [not to us in the Jews’ language]{strong=“H3066”}, \w in the ears| strong="H241" \w* \w of the people| strong="H5971" \w* that are \w on the wall| strong="H2346" \w*. 
\p
\v 12 \w But Rabshakeh| strong="H7262" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Hath my master| strong="H113" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w me to thy master| strong="H113" \w* [and to thee to speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w these words| strong="H1697" \w*? hath he not sent me \w to the men| strong="H582" \w* [that sit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the wall| strong="H2346" \w*, [that they may eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} [their own dung]{strong=“H6675 H2716” x-morph=“strongMorph: \sc Th\sc*8676”}, [and drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”} [their own piss]{strong=“H7890 H7272 H4325” x-morph=“strongMorph: \sc Th\sc*8675”} with you? 
\v 13 \w Then Rabshakeh| strong="H7262" \w* [stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”}, [and cried]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w with a loud| strong="H1419" \w* \w voice| strong="H6963" \w* [in the Jews’ language]{strong=“H3066”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye the words| strong="H1697" \w* \w of the great| strong="H1419" \w* \w king| strong="H4428" \w*, \w the king| strong="H4428" \w* \w of Assyria| strong="H804" \w*. 
\v 14 [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the king| strong="H4428" \w*, \w Let not Hezekiah| strong="H2396" \w* [deceive]{strong=“H5377” x-morph=“strongMorph: \sc Th\sc*8686”} [you: for he shall not be able]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [to deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8687”} you. 
\v 15 \w Neither let Hezekiah| strong="H2396" \w* [make you trust]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8686”} in the \sc Lord\sc*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, The \sc Lord\sc* [will surely]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8687”} [deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} [us: this city]{strong=“H5892”} [shall not be delivered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8735”} \w into the hand| strong="H3027" \w* \w of the king| strong="H4428" \w* \w of Assyria| strong="H804" \w*. 
\v 16 [Hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w not to Hezekiah| strong="H2396" \w*: [for thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the king| strong="H4428" \w* \w of Assyria| strong="H804" \w*, [Make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8798”} an agreement with me by \w a present| strong="H1293" \w*, [and come out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8798”} [to me: and eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye every one| strong="H376" \w* \w of his vine| strong="H1612" \w*, \w and every one| strong="H376" \w* \w of his fig tree| strong="H8384" \w*, [and drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye every one| strong="H376" \w* \w the waters| strong="H4325" \w* \w of his own cistern| strong="H953" \w*;\f + \fr 36:16 \ft Make…: or, Seek my favour by a present: Heb. Make with me a blessing \f* 
\v 17 [Until I come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [and take you away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w to a land| strong="H776" \w* \w like your own land| strong="H776" \w*, \w a land| strong="H776" \w* \w of corn| strong="H1715" \w* \w and wine| strong="H8492" \w*, \w a land| strong="H776" \w* \w of bread| strong="H3899" \w* \w and vineyards| strong="H3754" \w*. 
