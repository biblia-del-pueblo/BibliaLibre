\p
\v 8 [And thou shalt number]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8804”} \w seven| strong="H7651" \w* \w sabbaths| strong="H7676" \w* \w of years| strong="H8141" \w* [unto thee, seven]{strong=“H7651”} \w times| strong="H6471" \w* \w seven| strong="H7651" \w* \w years| strong="H8141" \w*; \w and the space| strong="H3117" \w* \w of the seven| strong="H7651" \w* \w sabbaths| strong="H7676" \w* \w of years| strong="H8141" \w* \w shall be unto thee forty| strong="H705" \w* \w and nine| strong="H8672" \w* \w years| strong="H8141" \w*. 
\v 9 \w Then shalt thou cause the trumpet| strong="H7782" \w* \w of the jubile| strong="H8643" \w* [to sound]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8689”} \w on the tenth| strong="H6218" \w* day \w of the seventh| strong="H7637" \w* \w month| strong="H2320" \w*, \w in the day| strong="H3117" \w* \w of atonement| strong="H3725" \w* \w shall ye make the trumpet| strong="H7782" \w* [sound]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8686”} \w throughout all your land| strong="H776" \w*.\f + \fr 25:9 \ft of the jubile: Heb. loud of sound \f* 
\v 10 [And ye shall hallow]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8765”} [the fiftieth]{strong=“H8141 H2572”} \w year| strong="H8141" \w*, [and proclaim]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w liberty| strong="H1865" \w* throughout all \w the land| strong="H776" \w* [unto all the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} [thereof: it shall be a jubile]{strong=“H3104”} [unto you; and ye shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w every man| strong="H376" \w* \w unto his possession| strong="H272" \w*, [and ye shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w every man| strong="H376" \w* \w unto his family| strong="H4940" \w*. 
\v 11 \w A jubile| strong="H3104" \w* [shall that fiftieth]{strong=“H8141 H2572”} \w year| strong="H8141" \w* [be unto you: ye shall not sow]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8799”}, [neither reap]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8799”} \w that which groweth| strong="H5599" \w* [of itself in it, nor gather]{strong=“H1219” x-morph=“strongMorph: \sc Th\sc*8799”} the grapes \w in it of thy vine undressed| strong="H5139" \w*. 
\v 12 For it is \w the jubile| strong="H3104" \w*; \w it shall be holy| strong="H6944" \w* [unto you: ye shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the increase| strong="H8393" \w* \w thereof out of the field| strong="H7704" \w*. 
\v 13 \w In the year| strong="H8141" \w* \w of this jubile| strong="H3104" \w* [ye shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w every man| strong="H376" \w* \w unto his possession| strong="H272" \w*. 
\v 14 [And if thou sell]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8799”} \w ought| strong="H4465" \w* \w unto thy neighbour| strong="H5997" \w*, [or buyest]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8800”} ought [of thy neighbour’s]{strong=“H5997”} \w hand| strong="H3027" \w*, [ye shall not oppress]{strong=“H3238” x-morph=“strongMorph: \sc Th\sc*8686”} \w one| strong="H376" \w* \w another| strong="H251" \w*: 
\v 15 \w According to the number| strong="H4557" \w* \w of years| strong="H8141" \w* \w after| strong="H310" \w* \w the jubile| strong="H3104" \w* [thou shalt buy]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8799”} \w of thy neighbour| strong="H5997" \w*, and \w according unto the number| strong="H4557" \w* \w of years| strong="H8141" \w* \w of the fruits| strong="H8393" \w* [he shall sell]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8799”} unto thee: 
\v 16 \w According| strong="H6310" \w* \w to the multitude| strong="H7230" \w* \w of years| strong="H8141" \w* [thou shalt increase]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} \w the price| strong="H4736" \w* [thereof, and according]{strong=“H6310”} [to the fewness]{strong=“H4591” x-morph=“strongMorph: \sc Th\sc*8800”} \w of years| strong="H8141" \w* [thou shalt diminish]{strong=“H4591” x-morph=“strongMorph: \sc Th\sc*8686”} \w the price| strong="H4736" \w* of it: for according \w to the number| strong="H4557" \w* of the years \w of the fruits| strong="H8393" \w* [doth he sell]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8802”} unto thee. 
\v 17 [Ye shall not therefore oppress]{strong=“H3238” x-morph=“strongMorph: \sc Th\sc*8686”} \w one| strong="H376" \w* \w another| strong="H5997" \w*; [but thou shalt fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy God| strong="H430" \w*: for I am the \sc Lord\sc* \w your God| strong="H430" \w*. 
\p
\v 18 [Wherefore ye shall do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w my statutes| strong="H2708" \w*, [and keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w my judgments| strong="H4941" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [them; and ye shall dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the land| strong="H776" \w* \w in safety| strong="H983" \w*. 
\v 19 \w And the land| strong="H776" \w* [shall yield]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w her fruit| strong="H6529" \w*, [and ye shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w your fill| strong="H7648" \w*, [and dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w therein in safety| strong="H983" \w*. 
\v 20 [And if ye shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [What shall we eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the seventh| strong="H7637" \w* \w year| strong="H8141" \w*? [behold, we shall not sow]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8799”}, [nor gather]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8799”} \w in our increase| strong="H8393" \w*: 
\v 21 [Then I will command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w my blessing| strong="H1293" \w* \w upon you in the sixth| strong="H8345" \w* \w year| strong="H8141" \w*, [and it shall bring forth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w fruit| strong="H8393" \w* \w for three| strong="H7969" \w* \w years| strong="H8141" \w*. 
\v 22 [And ye shall sow]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8804”} \w the eighth| strong="H8066" \w* \w year| strong="H8141" \w*, [and eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} yet \w of old| strong="H3465" \w* \w fruit| strong="H8393" \w* \w until the ninth| strong="H8671" \w* \w year| strong="H8141" \w*; \w until her fruits| strong="H8393" \w* [come in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [ye shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} of \w the old| strong="H3465" \w* store. 
\p
\v 23 \w The land| strong="H776" \w* [shall not be sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8735”} \w for ever| strong="H6783" \w*: \w for the land| strong="H776" \w* is mine; for ye are \w strangers| strong="H1616" \w* \w and sojourners| strong="H8453" \w* with me.\f + \fr 25:23 \ft for ever: or, to be quite cut off: Heb. for cutting off \f* 
\v 24 \w And in all the land| strong="H776" \w* \w of your possession| strong="H272" \w* [ye shall grant]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w a redemption| strong="H1353" \w* \w for the land| strong="H776" \w*. 
\p
\v 25 \w If thy brother| strong="H251" \w* [be waxen poor]{strong=“H4134” x-morph=“strongMorph: \sc Th\sc*8799”}, [and hath sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8804”} away some \w of his possession| strong="H272" \w*, \w and if any of his kin| strong="H7138" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to redeem]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”} [it, then shall he redeem]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8804”} \w that which his brother| strong="H251" \w* \w sold| strong="H4465" \w*. 
\v 26 \w And if the man| strong="H376" \w* [have none to redeem]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”} [it, and himself]{strong=“H3027”} [be able]{strong=“H5381 H1767” x-morph=“strongMorph: \sc Th\sc*8689”} [to redeem]{strong=“H1353 H4672” x-morph=“strongMorph: \sc Th\sc*8804”} it;\f + \fr 25:26 \ft himself…: Heb. his hand hath attained and found sufficiency \f* 
\v 27 [Then let him count]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8765”} \w the years| strong="H8141" \w* \w of the sale| strong="H4465" \w* [thereof, and restore]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} [the overplus]{strong=“H5736” x-morph=“strongMorph: \sc Th\sc*8802”} \w unto the man| strong="H376" \w* [to whom he sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8804”} [it; that he may return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto his possession| strong="H272" \w*. 
\v 28 \w But if he| strong="H3027" \w* \w be not able| strong="H1767" \w* [to restore]{strong=“H7725 H4672” x-morph=“strongMorph: \sc Th\sc*8687 strongMorph: \sc Th\sc*8804”} it [to him, then that which is sold]{strong=“H4465”} \w shall remain in the hand| strong="H3027" \w* [of him that hath bought]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8802”} \w it until the year| strong="H8141" \w* \w of jubile| strong="H3104" \w*: \w and in the jubile| strong="H3104" \w* [it shall go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”}, [and he shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto his possession| strong="H272" \w*. 
\v 29 \w And if a man| strong="H376" \w* [sell]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8799”} \w a dwelling| strong="H4186" \w* \w house| strong="H1004" \w* \w in a walled| strong="H2346" \w* \w city| strong="H5892" \w*, \w then he may redeem| strong="H1353" \w* [it within a whole]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8800”} \w year| strong="H8141" \w* \w after it is sold| strong="H4465" \w*; within \w a full year| strong="H3117" \w* \w may he redeem| strong="H1353" \w* it. 
\v 30 [And if it be not redeemed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8735”} [within the space]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8800”} \w of a full| strong="H8549" \w* \w year| strong="H8141" \w*, \w then the house| strong="H1004" \w* that is \w in the walled| strong="H2346" \w* \w city| strong="H5892" \w* [shall be established]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”} \w for ever| strong="H6783" \w* [to him that bought]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8802”} \w it throughout his generations| strong="H1755" \w*: [it shall not go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the jubile| strong="H3104" \w*. 
\v 31 \w But the houses| strong="H1004" \w* \w of the villages| strong="H2691" \w* \w which have no wall| strong="H2346" \w* \w round about| strong="H5439" \w* [them shall be counted]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8735”} \w as the fields| strong="H7704" \w* \w of the country| strong="H776" \w*: \w they may be redeemed| strong="H1353" \w*, [and they shall go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the jubile| strong="H3104" \w*.\f + \fr 25:31 \ft they may…: Heb. redemption belongeth unto it \f* 
\v 32 \w Notwithstanding the cities| strong="H5892" \w* \w of the Levites| strong="H3881" \w*, and \w the houses| strong="H1004" \w* \w of the cities| strong="H5892" \w* \w of their possession| strong="H272" \w*, \w may the Levites| strong="H3881" \w* \w redeem| strong="H1353" \w* \w at any time| strong="H5769" \w*. 
\v 33 [And if a man purchase]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the Levites| strong="H3881" \w*, \w then the house| strong="H1004" \w* \w that was sold| strong="H4465" \w*, \w and the city| strong="H5892" \w* \w of his possession| strong="H272" \w*, [shall go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} in the year of \w jubile| strong="H3104" \w*: \w for the houses| strong="H1004" \w* \w of the cities| strong="H5892" \w* \w of the Levites| strong="H3881" \w* are \w their possession| strong="H272" \w* \w among| strong="H8432" \w* \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*.\f + \fr 25:33 \ft a man…: or, one of the Levites redeem them \f* 
\v 34 \w But the field| strong="H7704" \w* \w of the suburbs| strong="H4054" \w* \w of their cities| strong="H5892" \w* [may not be sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8735”}; for it is \w their perpetual| strong="H5769" \w* \w possession| strong="H272" \w*. 
\p
\v 35 \w And if thy brother| strong="H251" \w* [be waxen poor]{strong=“H4134” x-morph=“strongMorph: \sc Th\sc*8799”}, [and fallen in decay]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8804”} \w with thee| strong="H3027" \w*; [then thou shalt relieve]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8689”} him: yea, though he be \w a stranger| strong="H1616" \w*, \w or a sojourner| strong="H8453" \w*; \w that he may live| strong="H2416" \w* with thee.\f + \fr 25:35 \ft fallen…: Heb. his hand faileth \f* \f + \fr 25:35 \ft relieve: Heb. strengthen \f* 
\v 36 [Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w thou no usury| strong="H5392" \w* [of him, or increase]{strong=“H8636”}: [but fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy God| strong="H430" \w*; \w that thy brother| strong="H251" \w* \w may live| strong="H2416" \w* with thee. 
\v 37 [Thou shalt not give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w him thy money| strong="H3701" \w* \w upon usury| strong="H5392" \w*, [nor lend]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w him thy victuals| strong="H400" \w* \w for increase| strong="H4768" \w*. 
\v 38 I am the \sc Lord\sc* \w your God| strong="H430" \w*, [which brought you forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w out of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w you the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*, and \w to be your God| strong="H430" \w*. 
\p
\v 39 \w And if thy brother| strong="H251" \w* that dwelleth [by thee be waxen poor]{strong=“H4134” x-morph=“strongMorph: \sc Th\sc*8799”}, [and be sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8738”} [unto thee; thou shalt not compel]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} \w him to serve| strong="H5656" \w* \w as a bondservant| strong="H5650" \w*:\f + \fr 25:39 \ft compel…: Heb. serve thyself with him with the service, etc \f* 
\v 40 But \w as an hired servant| strong="H7916" \w*, and \w as a sojourner| strong="H8453" \w*, he shall be with thee, and [shall serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee unto the year| strong="H8141" \w* \w of jubile| strong="H3104" \w*: 
\v 41 And then [shall he depart]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} from thee, both \w he and his children| strong="H1121" \w* [with him, and shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto his own family| strong="H4940" \w*, \w and unto the possession| strong="H272" \w* \w of his fathers| strong="H1" \w* [shall he return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 42 For they are \w my servants| strong="H5650" \w*, [which I brought forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w out of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*: [they shall not be sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8735”} \w as| strong="H4466" \w* \w bondmen| strong="H5650" \w*.\f + \fr 25:42 \ft as…: Heb. with the sale of a bondman \f* 
\v 43 [Thou shalt not rule]{strong=“H7287” x-morph=“strongMorph: \sc Th\sc*8799”} \w over him with rigour| strong="H6531" \w*; [but shalt fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy God| strong="H430" \w*. 
\v 44 \w Both thy bondmen| strong="H5650" \w*, \w and thy bondmaids| strong="H519" \w*, which thou shalt have, shall be \w of the heathen| strong="H1471" \w* \w that are round about| strong="H5439" \w* [you; of them shall ye buy]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8799”} \w bondmen| strong="H5650" \w* \w and bondmaids| strong="H519" \w*. 
\v 45 \w Moreover of the children| strong="H1121" \w* \w of the strangers| strong="H8453" \w* [that do sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8802”} [among you, of them shall ye buy]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and of their families| strong="H4940" \w* that are [with you, which they begat]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8689”} \w in your land| strong="H776" \w*: \w and they shall be your possession| strong="H272" \w*. 
\v 46 [And ye shall take them as an inheritance]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8694”} \w for your children| strong="H1121" \w* \w after| strong="H310" \w* [you, to inherit]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} them for \w a possession| strong="H272" \w*; [they shall be your bondmen]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} \w for ever| strong="H5769" \w*: \w but over your brethren| strong="H251" \w* \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [ye shall not rule]{strong=“H7287” x-morph=“strongMorph: \sc Th\sc*8799”} \w one| strong="H376" \w* \w over another| strong="H251" \w* \w with rigour| strong="H6531" \w*.\f + \fr 25:46 \ft they…: Heb. ye shall serve yourselves with them \f* 
\p
\v 47 \w And if a sojourner| strong="H1616" \w* \w or stranger| strong="H8453" \w* [wax rich]{strong=“H5381” x-morph=“strongMorph: \sc Th\sc*8686”} \w by thee| strong="H3027" \w*, \w and thy brother| strong="H251" \w* that dwelleth [by him wax poor]{strong=“H4134” x-morph=“strongMorph: \sc Th\sc*8802”}, [and sell]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8738”} \w himself unto the stranger| strong="H1616" \w* or \w sojourner| strong="H8453" \w* [by thee, or to the stock]{strong=“H6133”} [of the stranger’s]{strong=“H1616”} \w family| strong="H4940" \w*:\f + \fr 25:47 \ft wax rich…: Heb. his hand obtain, etc \f* 
\v 48 \w After| strong="H310" \w* [that he is sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8738”} \w he may be redeemed again| strong="H1353" \w*; \w one| strong="H259" \w* \w of his brethren| strong="H251" \w* [may redeem]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8799”} him: 
\v 49 \w Either his uncle| strong="H1730" \w*, [or his uncle’s]{strong=“H1730”} \w son| strong="H1121" \w*, [may redeem]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8799”} him, or any \w that is nigh| strong="H7607" \w* \w of kin| strong="H1320" \w* \w unto him of his family| strong="H4940" \w* [may redeem]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8799”} [him; or if he be able]{strong=“H5381” x-morph=“strongMorph: \sc Th\sc*8689”}, [he may redeem]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8738”} \w himself| strong="H3027" \w*. 
\v 50 [And he shall reckon]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8765”} [with him that bought]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8802”} \w him from the year| strong="H8141" \w* [that he was sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8736”} \w to him unto the year| strong="H8141" \w* \w of jubile| strong="H3104" \w*: \w and the price| strong="H3701" \w* \w of his sale| strong="H4465" \w* \w shall be according unto the number| strong="H4557" \w* \w of years| strong="H8141" \w*, \w according to the time| strong="H3117" \w* \w of an hired servant| strong="H7916" \w* shall it be with him. 
