\c 11
\p 
\v 1 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w* \w and to Aaron| strong="H175" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} unto them, 
\v 2 [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w These| strong="H2063" \w* are \w the beasts| strong="H2416" \w* [which ye shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w among all the beasts| strong="H929" \w* that are \w on the earth| strong="H776" \w*. 
