\v 59 This is \w the law| strong="H8451" \w* \w of the plague| strong="H5061" \w* \w of leprosy| strong="H6883" \w* \w in a garment| strong="H899" \w* \w of woollen| strong="H6785" \w* \w or linen| strong="H6593" \w*, \w either in the warp| strong="H8359" \w*, \w or woof| strong="H6154" \w*, \w or any thing| strong="H3627" \w* \w of skins| strong="H5785" \w*, [to pronounce it clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8763”}, [or to pronounce it unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8763”}.
\c 14
\p 
\v 1 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w This shall be the law| strong="H8451" \w* [of the leper]{strong=“H6879” x-morph=“strongMorph: \sc Th\sc*8794”} \w in the day| strong="H3117" \w* \w of his cleansing| strong="H2893" \w*: [He shall be brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8717”} \w unto the priest| strong="H3548" \w*: 
