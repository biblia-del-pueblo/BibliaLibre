\v 14 [And if thou offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”} \w a meat offering| strong="H4503" \w* \w of thy firstfruits| strong="H1061" \w* unto the \sc Lord\sc*, [thou shalt offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”} \w for the meat offering| strong="H4503" \w* \w of thy firstfruits| strong="H1061" \w* \w green ears| strong="H24" \w* [of corn dried]{strong=“H7033” x-morph=“strongMorph: \sc Th\sc*8803”} \w by the fire| strong="H784" \w*, even \w corn beaten| strong="H1643" \w* \w out of full ears| strong="H3759" \w*. 
\v 15 [And thou shalt put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w oil| strong="H8081" \w* [upon it, and lay]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w frankincense| strong="H3828" \w* thereon: it is \w a meat offering| strong="H4503" \w*. 
