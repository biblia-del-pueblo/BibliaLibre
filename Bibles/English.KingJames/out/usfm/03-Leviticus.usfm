\v 30 \w For on that day| strong="H3117" \w* shall the priest [make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8762”} [for you, to cleanse]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8763”} you, that [ye may be clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8799”} \w from all your sins| strong="H2403" \w* \w before| strong="H6440" \w* the \sc Lord\sc*. 
\v 31 It shall be \w a sabbath| strong="H7676" \w* \w of rest| strong="H7677" \w* [unto you, and ye shall afflict]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8765”} \w your souls| strong="H5315" \w*, \w by a statute| strong="H2708" \w* \w for ever| strong="H5769" \w*. 
\v 32 \w And the priest| strong="H3548" \w*, [whom he shall anoint]{strong=“H4886” x-morph=“strongMorph: \sc Th\sc*8799”}, [and whom he shall consecrate]{strong=“H3027 H4390” x-morph=“strongMorph: \sc Th\sc*8762”} [to minister in the priest’s office]{strong=“H3547” x-morph=“strongMorph: \sc Th\sc*8763”} [in his father’s]{strong=“H1”} [stead, shall make the atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8765”}, [and shall put on]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8804”} \w the linen| strong="H906" \w* \w clothes| strong="H899" \w*, even \w the holy| strong="H6944" \w* \w garments| strong="H899" \w*:\f + \fr 16:32 \ft consecrate: Heb. fill his hand \f* 
\v 33 [And he shall make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8765”} \w for the holy| strong="H6944" \w* \w sanctuary| strong="H4720" \w*, [and he shall make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8762”} \w for the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*, \w and for the altar| strong="H4196" \w*, [and he shall make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8762”} \w for the priests| strong="H3548" \w*, \w and for all the people| strong="H5971" \w* \w of the congregation| strong="H6951" \w*. 
\v 34 \w And this shall be an everlasting| strong="H5769" \w* \w statute| strong="H2708" \w* [unto you, to make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8763”} \w for the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* \w for all their sins| strong="H2403" \w* \w once| strong="H259" \w* \w a year| strong="H8141" \w*. [And he did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} as the \sc Lord\sc* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w Moses| strong="H4872" \w*.
\c 17
\p 
\v 1 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w unto Aaron| strong="H175" \w*, \w and unto his sons| strong="H1121" \w*, \w and unto all the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} unto them; This is \w the thing| strong="H1697" \w* which the \sc Lord\sc* [hath commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 3 \w What| strong="H376" \w* \w man| strong="H376" \w* soever there be \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, [that killeth]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8799”} \w an ox| strong="H7794" \w*, \w or lamb| strong="H3775" \w*, \w or goat| strong="H5795" \w*, \w in the camp| strong="H4264" \w*, [or that killeth]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8799”} it \w out| strong="H2351" \w* \w of the camp| strong="H4264" \w*, 
\v 4 [And bringeth]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w it not unto the door| strong="H6607" \w* \w of the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*, [to offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8687”} \w an offering| strong="H7133" \w* unto the \sc Lord\sc* \w before| strong="H6440" \w* \w the tabernacle| strong="H4908" \w* of the \sc Lord\sc*; \w blood| strong="H1818" \w* [shall be imputed]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8735”} \w unto that man| strong="H376" \w*; [he hath shed]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8804”} \w blood| strong="H1818" \w*; \w and that man| strong="H376" \w* [shall be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8738”} \w from among| strong="H7130" \w* \w his people| strong="H5971" \w*: 
\v 5 \w To the end that the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [may bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w their sacrifices| strong="H2077" \w*, [which they offer]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the open| strong="H6440" \w* \w field| strong="H7704" \w*, [even that they may bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} them unto the \sc Lord\sc*, \w unto the door| strong="H6607" \w* \w of the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*, \w unto the priest| strong="H3548" \w*, [and offer]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8804”} them for \w peace| strong="H8002" \w* \w offerings| strong="H2077" \w* unto the \sc Lord\sc*. 
\v 6 \w And the priest| strong="H3548" \w* [shall sprinkle]{strong=“H2236” x-morph=“strongMorph: \sc Th\sc*8804”} \w the blood| strong="H1818" \w* \w upon the altar| strong="H4196" \w* of the \sc Lord\sc* at \w the door| strong="H6607" \w* \w of the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*, [and burn]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8689”} \w the fat| strong="H2459" \w* \w for a sweet| strong="H5207" \w* \w savour| strong="H7381" \w* unto the \sc Lord\sc*. 
\v 7 [And they shall no more offer]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} \w their sacrifices| strong="H2077" \w* \w unto devils| strong="H8163" \w*, \w after| strong="H310" \w* [whom they have gone a whoring]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”}. \w This shall be a statute| strong="H2708" \w* \w for ever| strong="H5769" \w* \w unto them throughout their generations| strong="H1755" \w*. 
\p
\v 8 [And thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Whatsoever man]{strong=“H376”} there be \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, \w or of the strangers| strong="H1616" \w* [which sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”} \w among| strong="H8432" \w* [you, that offereth]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w a burnt offering| strong="H5930" \w* \w or sacrifice| strong="H2077" \w*, 
\v 9 [And bringeth]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w it not unto the door| strong="H6607" \w* \w of the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*, [to offer]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} it unto the \sc Lord\sc*; \w even that man| strong="H376" \w* [shall be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8738”} \w from among his people| strong="H5971" \w*. 
\p
\v 10 \w And whatsoever man| strong="H376" \w* there be \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, \w or of the strangers| strong="H1616" \w* [that sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8802”} \w among| strong="H8432" \w* [you, that eateth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w any manner of blood| strong="H1818" \w*; [I will even set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w my face| strong="H6440" \w* \w against that soul| strong="H5315" \w* [that eateth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} \w blood| strong="H1818" \w*, [and will cut him off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w from among| strong="H7130" \w* \w his people| strong="H5971" \w*. 
\v 11 \w For the life| strong="H5315" \w* \w of the flesh| strong="H1320" \w* is \w in the blood| strong="H1818" \w*: [and I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w it to you upon the altar| strong="H4196" \w* [to make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8763”} \w for your souls| strong="H5315" \w*: for it is \w the blood| strong="H1818" \w* that [maketh an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8762”} \w for the soul| strong="H5315" \w*. 
\v 12 [Therefore I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, \w No soul| strong="H5315" \w* [of you shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w blood| strong="H1818" \w*, \w neither shall any stranger| strong="H1616" \w* [that sojourneth]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8802”} \w among| strong="H8432" \w* [you eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w blood| strong="H1818" \w*. 
\v 13 \w And whatsoever man| strong="H376" \w* there be \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, \w or of the strangers| strong="H1616" \w* [that sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8802”} \w among| strong="H8432" \w* [you, which hunteth]{strong=“H6679” x-morph=“strongMorph: \sc Th\sc*8799”} \w and catcheth| strong="H6718" \w* \w any beast| strong="H2416" \w* \w or fowl| strong="H5775" \w* [that may be eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8735”}; [he shall even pour]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8804”} \w out the blood| strong="H1818" \w* [thereof, and cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”} \w it with dust| strong="H6083" \w*.\f + \fr 17:13 \ft which…: Heb. that hunteth any hunting \f* 
\v 14 For it is \w the life| strong="H5315" \w* \w of all flesh| strong="H1320" \w*; \w the blood| strong="H1818" \w* of it is \w for the life| strong="H5315" \w* [thereof: therefore I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [Ye shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the blood| strong="H1818" \w* \w of no manner of flesh| strong="H1320" \w*: \w for the life| strong="H5315" \w* \w of all flesh| strong="H1320" \w* is \w the blood| strong="H1818" \w* [thereof: whosoever eateth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} [it shall be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 15 \w And every soul| strong="H5315" \w* [that eateth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w that which died| strong="H5038" \w* of itself, \w or that which was torn| strong="H2966" \w* with beasts, whether it be \w one of your own country| strong="H249" \w*, \w or a stranger| strong="H1616" \w*, [he shall both wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8765”} \w his clothes| strong="H899" \w*, [and bathe]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} himself \w in water| strong="H4325" \w*, [and be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w until the even| strong="H6153" \w*: [then shall he be clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 17:15 \ft that which died…: Heb. a carcase \f* 
\v 16 [But if he wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8762”} them [not, nor bathe]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8799”} \w his flesh| strong="H1320" \w*; [then he shall bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w his iniquity| strong="H5771" \w*.
\c 18
\p 
\v 1 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} unto them, I am the \sc Lord\sc* \w your God| strong="H430" \w*. 
\v 3 \w After the doings| strong="H4639" \w* \w of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, [wherein ye dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”}, [shall ye not do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}: \w and after the doings| strong="H4639" \w* \w of the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*, [whither I bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} [you, shall ye not do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}: [neither shall ye walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w in their ordinances| strong="H2708" \w*. 
\v 4 [Ye shall do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w my judgments| strong="H4941" \w*, [and keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w mine ordinances| strong="H2708" \w*, [to walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} therein: I am the \sc Lord\sc* \w your God| strong="H430" \w*. 
\v 5 [Ye shall therefore keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w my statutes| strong="H2708" \w*, \w and my judgments| strong="H4941" \w*: \w which| strong="H834" \w* \w if a man| strong="H120" \w* [do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}, [he shall live]{strong=“H2425” x-morph=“strongMorph: \sc Th\sc*8804”} in them: I am the \sc Lord\sc*. 
\p
\v 6 [None of you shall approach]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} \w to any| strong="H376" \w* \w that is near| strong="H7607" \w* \w of kin| strong="H1320" \w* [to him, to uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8763”} their \w nakedness| strong="H6172" \w*: I am the \sc Lord\sc*.\f + \fr 18:6 \ft near…: Heb. remainder of his flesh \f* 
\v 7 \w The nakedness| strong="H6172" \w* \w of thy father| strong="H1" \w*, \w or the nakedness| strong="H6172" \w* \w of thy mother| strong="H517" \w*, [shalt thou not uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”}: she is \w thy mother| strong="H517" \w*; [thou shalt not uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”} \w her nakedness| strong="H6172" \w*. 
\v 8 \w The nakedness| strong="H6172" \w* [of thy father’s]{strong=“H1”} \w wife| strong="H802" \w* [shalt thou not uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”}: it is [thy father’s]{strong=“H1”} \w nakedness| strong="H6172" \w*. 
\v 9 \w The nakedness| strong="H6172" \w* \w of thy sister| strong="H269" \w*, \w the daughter| strong="H1323" \w* \w of thy father| strong="H1" \w*, \w or daughter| strong="H1323" \w* \w of thy mother| strong="H517" \w*, whether she be \w born| strong="H4138" \w* \w at home| strong="H1004" \w*, \w or born| strong="H4138" \w* \w abroad| strong="H2351" \w*, even \w their nakedness| strong="H6172" \w* [thou shalt not uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 10 \w The nakedness| strong="H6172" \w* [of thy son’s]{strong=“H1121”} \w daughter| strong="H1323" \w*, [or of thy daughter’s]{strong=“H1323”} \w daughter| strong="H1323" \w*, even \w their nakedness| strong="H6172" \w* [thou shalt not uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”}: \w for theirs| strong="H2007" \w* is \w thine own nakedness| strong="H6172" \w*. 
\v 11 \w The nakedness| strong="H6172" \w* [of thy father’s]{strong=“H1”} [wife’s]{strong=“H802”} \w daughter| strong="H1323" \w*, \w begotten| strong="H4138" \w* \w of thy father| strong="H1" \w*, she is \w thy sister| strong="H269" \w*, [thou shalt not uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”} \w her nakedness| strong="H6172" \w*. 
\v 12 [Thou shalt not uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”} \w the nakedness| strong="H6172" \w* [of thy father’s]{strong=“H1”} \w sister| strong="H269" \w*: she is [thy father’s]{strong=“H1”} \w near kinswoman| strong="H7607" \w*. 
\v 13 [Thou shalt not uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”} \w the nakedness| strong="H6172" \w* [of thy mother’s]{strong=“H517”} \w sister| strong="H269" \w*: for she is [thy mother’s]{strong=“H517”} \w near kinswoman| strong="H7607" \w*. 
\v 14 [Thou shalt not uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”} \w the nakedness| strong="H6172" \w* [of thy father’s]{strong=“H1”} \w brother| strong="H251" \w*, [thou shalt not approach]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} \w to his wife| strong="H802" \w*: she is \w thine aunt| strong="H1733" \w*. 
\v 15 [Thou shalt not uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”} \w the nakedness| strong="H6172" \w* \w of thy daughter in law| strong="H3618" \w*: she is [thy son’s]{strong=“H1121”} \w wife| strong="H802" \w*; [thou shalt not uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”} \w her nakedness| strong="H6172" \w*. 
\v 16 [Thou shalt not uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”} \w the nakedness| strong="H6172" \w* [of thy brother’s]{strong=“H251”} \w wife| strong="H802" \w*: it is [thy brother’s]{strong=“H251”} \w nakedness| strong="H6172" \w*. 
\v 17 [Thou shalt not uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”} \w the nakedness| strong="H6172" \w* \w of a woman| strong="H802" \w* \w and her daughter| strong="H1323" \w*, [neither shalt thou take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [her son’s]{strong=“H1121”} \w daughter| strong="H1323" \w*, [or her daughter’s]{strong=“H1323”} \w daughter| strong="H1323" \w*, [to uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8763”} \w her nakedness| strong="H6172" \w*; for they are \w her near kinswomen| strong="H7608" \w*: it is \w wickedness| strong="H2154" \w*. 
\v 18 [Neither shalt thou take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a wife| strong="H802" \w* \w to her sister| strong="H269" \w*, [to vex]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8800”} her, [to uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8763”} \w her nakedness| strong="H6172" \w*, \w beside the other in her life| strong="H2416" \w* time.\f + \fr 18:18 \ft a wife…: or, one wife to another \f* 
\p
\v 19 [Also thou shalt not approach]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto a woman| strong="H802" \w* [to uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8763”} \w her nakedness| strong="H6172" \w*, \w as long as she is put apart| strong="H5079" \w* \w for her uncleanness| strong="H2932" \w*. 
\v 20 [Moreover thou shalt not]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w lie| strong="H7903" \w* \w carnally| strong="H2233" \w* [with thy neighbour’s]{strong=“H5997”} \w wife| strong="H802" \w*, [to defile]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8800”} thyself with her. 
\v 21 [And thou shalt not]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w let any of thy seed| strong="H2233" \w* [pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8687”} through the fire \w to Molech| strong="H4432" \w*, [neither shalt thou profane]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8762”} \w the name| strong="H8034" \w* \w of thy God| strong="H430" \w*: I am the \sc Lord\sc*.\f + \fr 18:21 \ft Molech: Gr. Moloch \f* 
\v 22 [Thou shalt not lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w with mankind| strong="H2145" \w*, \w as with| strong="H4904" \w* \w womankind| strong="H802" \w*: it is \w abomination| strong="H8441" \w*. 
\v 23 [Neither shalt thou]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w lie| strong="H7903" \w* \w with any beast| strong="H929" \w* [to defile]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8800”} [thyself therewith: neither shall any woman]{strong=“H802”} [stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* \w a beast| strong="H929" \w* [to lie down]{strong=“H7250” x-morph=“strongMorph: \sc Th\sc*8800”} thereto: it is \w confusion| strong="H8397" \w*. 
\v 24 [Defile]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8691”} \w not ye yourselves in any of these things| strong="H428" \w*: \w for in all these the nations| strong="H1471" \w* [are defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8738”} [which I cast out]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8764”} \w before| strong="H6440" \w* you: 
\v 25 \w And the land| strong="H776" \w* [is defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”}: [therefore I do visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} \w the iniquity| strong="H5771" \w* [thereof upon it, and the land]{strong=“H776”} [itself vomiteth out]{strong=“H6958” x-morph=“strongMorph: \sc Th\sc*8686”} [her inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 26 [Ye shall therefore keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w my statutes| strong="H2708" \w* \w and my judgments| strong="H4941" \w*, [and shall not commit]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} any \w of these abominations| strong="H8441" \w*; neither \w any of your own nation| strong="H249" \w*, \w nor any stranger| strong="H1616" \w* [that sojourneth]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8802”} \w among| strong="H8432" \w* you: 
\v 27 (\w For all these| strong="H411" \w* \w abominations| strong="H8441" \w* \w have the men| strong="H582" \w* \w of the land| strong="H776" \w* [done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, which were \w before| strong="H6440" \w* [you, and the land]{strong=“H776”} [is defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”};) 
\v 28 \w That the land| strong="H776" \w* [spue not you out]{strong=“H6958” x-morph=“strongMorph: \sc Th\sc*8686”} [also, when ye defile]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8763”} [it, as it spued out]{strong=“H6958” x-morph=“strongMorph: \sc Th\sc*8804”} \w the nations| strong="H1471" \w* that were \w before| strong="H6440" \w* you. 
