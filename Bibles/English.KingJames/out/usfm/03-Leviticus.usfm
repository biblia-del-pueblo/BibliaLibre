\v 30 [Therefore shall ye keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine ordinance| strong="H4931" \w*, that ye [commit]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} not any one \w of these abominable| strong="H8441" \w* \w customs| strong="H2708" \w*, [which were committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8738”} \w before| strong="H6440" \w* [you, and that ye defile]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8691”} not yourselves therein: I am the \sc Lord\sc* \w your God| strong="H430" \w*.
\c 19
\p 
\v 1 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w unto all the congregation| strong="H5712" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Ye shall be holy]{strong=“H6918”}: for I the \sc Lord\sc* \w your God| strong="H430" \w* am \w holy| strong="H6918" \w*. 
\p
\v 3 [Ye shall fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w every man| strong="H376" \w* \w his mother| strong="H517" \w*, \w and his father| strong="H1" \w*, [and keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w my sabbaths| strong="H7676" \w*: I am the \sc Lord\sc* \w your God| strong="H430" \w*. 
\p
\v 4 [Turn]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8799”} \w ye not unto idols| strong="H457" \w*, [nor make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w to yourselves molten| strong="H4541" \w* \w gods| strong="H430" \w*: I am the \sc Lord\sc* \w your God| strong="H430" \w*. 
\p
\v 5 [And if ye offer]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} \w a sacrifice| strong="H2077" \w* \w of peace offerings| strong="H8002" \w* unto the \sc Lord\sc*, [ye shall offer]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} \w it at your own will| strong="H7522" \w*. 
\v 6 [It shall be eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8735”} \w the same day| strong="H3117" \w* \w ye offer| strong="H2077" \w* [it, and on the morrow]{strong=“H4283”}: [and if ought remain]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8737”} \w until the third| strong="H7992" \w* \w day| strong="H3117" \w*, [it shall be burnt]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the fire| strong="H784" \w*. 
\v 7 [And if it be eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8735”} [at all]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8736”} \w on the third| strong="H7992" \w* \w day| strong="H3117" \w*, it is \w abominable| strong="H6292" \w*; [it shall not be accepted]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 8 Therefore every one [that eateth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} [it shall bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w his iniquity| strong="H5771" \w*, [because he hath profaned]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8765”} \w the hallowed thing| strong="H6944" \w* of the \sc Lord\sc*: \w and that soul| strong="H5315" \w* [shall be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8738”} \w from among his people| strong="H5971" \w*. 
\p
\v 9 [And when ye reap]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8800”} \w the harvest| strong="H7105" \w* \w of your land| strong="H776" \w*, [thou shalt not wholly reap]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8762”} \w the corners| strong="H6285" \w* \w of thy field| strong="H7704" \w*, [neither shalt thou gather]{strong=“H3950” x-morph=“strongMorph: \sc Th\sc*8762”} \w the gleanings| strong="H3951" \w* \w of thy harvest| strong="H7105" \w*. 
\v 10 [And thou shalt not glean]{strong=“H5953” x-morph=“strongMorph: \sc Th\sc*8779”} \w thy vineyard| strong="H3754" \w*, [neither shalt thou gather]{strong=“H3950” x-morph=“strongMorph: \sc Th\sc*8762”} every \w grape| strong="H6528" \w* \w of thy vineyard| strong="H3754" \w*; [thou shalt leave]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w them for the poor| strong="H6041" \w* \w and stranger| strong="H1616" \w*: I am the \sc Lord\sc* \w your God| strong="H430" \w*. 
\p
\v 11 [Ye shall not steal]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8799”}, [neither deal falsely]{strong=“H3584” x-morph=“strongMorph: \sc Th\sc*8762”}, [neither lie]{strong=“H8266” x-morph=“strongMorph: \sc Th\sc*8762”} \w one| strong="H376" \w* \w to another| strong="H5997" \w*. 
\p
\v 12 [And ye shall not swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8735”} \w by my name| strong="H8034" \w* \w falsely| strong="H8267" \w*, [neither shalt thou profane]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8765”} \w the name| strong="H8034" \w* \w of thy God| strong="H430" \w*: I am the \sc Lord\sc*. 
\p
\v 13 [Thou shalt not defraud]{strong=“H6231” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy neighbour| strong="H7453" \w*, [neither rob]{strong=“H1497” x-morph=“strongMorph: \sc Th\sc*8799”} him: \w the wages| strong="H6468" \w* \w of him that is hired| strong="H7916" \w* [shall not abide]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} \w with thee all night until the morning| strong="H1242" \w*. 
\p
\v 14 [Thou shalt not curse]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8762”} \w the deaf| strong="H2795" \w*, [nor put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w a stumblingblock| strong="H4383" \w* \w before| strong="H6440" \w* \w the blind| strong="H5787" \w*, [but shalt fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy God| strong="H430" \w*: I am the \sc Lord\sc*. 
\p
\v 15 [Ye shall do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w no unrighteousness| strong="H5766" \w* \w in judgment| strong="H4941" \w*: [thou shalt not respect]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w the person| strong="H6440" \w* \w of the poor| strong="H1800" \w*, [nor honour]{strong=“H1921” x-morph=“strongMorph: \sc Th\sc*8799”} \w the person| strong="H6440" \w* \w of the mighty| strong="H1419" \w*: but \w in righteousness| strong="H6664" \w* [shalt thou judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy neighbour| strong="H5997" \w*. 
\p
\v 16 [Thou shalt not go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} up and down as \w a talebearer| strong="H7400" \w* \w among thy people| strong="H5971" \w*: [neither shalt thou stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w against the blood| strong="H1818" \w* \w of thy neighbour| strong="H7453" \w*: I am the \sc Lord\sc*. 
\p
\v 17 [Thou shalt not hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy brother| strong="H251" \w* \w in thine heart| strong="H3824" \w*: [thou shalt in any wise]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8687”} [rebuke]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy neighbour| strong="H5997" \w*, [and not suffer]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w sin| strong="H2399" \w* upon him.\f + \fr 19:17 \ft and…: or, that thou bear not sin for him \f* 
\p
\v 18 [Thou shalt not avenge]{strong=“H5358” x-morph=“strongMorph: \sc Th\sc*8799”}, [nor bear any grudge]{strong=“H5201” x-morph=“strongMorph: \sc Th\sc*8799”} \w against the children| strong="H1121" \w* \w of thy people| strong="H5971" \w*, [but thou shalt love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy neighbour| strong="H7453" \w* \w as thyself| strong="H3644" \w*: I am the \sc Lord\sc*. 
\p
\v 19 [Ye shall keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w my statutes| strong="H2708" \w*. \w Thou shalt not let thy cattle| strong="H929" \w* [gender]{strong=“H7250” x-morph=“strongMorph: \sc Th\sc*8686”} \w with a diverse kind| strong="H3610" \w*: [thou shalt not sow]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy field| strong="H7704" \w* \w with mingled seed| strong="H3610" \w*: \w neither shall a garment| strong="H899" \w* \w mingled| strong="H3610" \w* \w of linen and woollen| strong="H8162" \w* [come]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} upon thee. 
\p
\v 20 \w And whosoever| strong="H376" \w* [lieth]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} [carnally]{strong=“H7902 H2233”} \w with a woman| strong="H802" \w*, that is \w a bondmaid| strong="H8198" \w*, [betrothed]{strong=“H2778” x-morph=“strongMorph: \sc Th\sc*8737”} \w to an husband| strong="H376" \w*, [and not at all]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8715”} [redeemed]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8738”}, \w nor freedom| strong="H2668" \w* [given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} [her; she shall be scourged]{strong=“H1244”}; [they shall not be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}, [because she was not free]{strong=“H2666” x-morph=“strongMorph: \sc Th\sc*8795”}.\f + \fr 19:20 \ft betrothed…: or, abused by any: Heb. reproached by (or, for) man \f* \f + \fr 19:20 \ft she shall…: or, they, etc: Heb. there shall be a scourging \f* 
\v 21 [And he shall bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w his trespass offering| strong="H817" \w* unto the \sc Lord\sc*, \w unto the door| strong="H6607" \w* \w of the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*, even \w a ram| strong="H352" \w* \w for a trespass offering| strong="H817" \w*. 
\v 22 \w And the priest| strong="H3548" \w* [shall make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8765”} \w for him with the ram| strong="H352" \w* \w of the trespass offering| strong="H817" \w* \w before| strong="H6440" \w* the \sc Lord\sc* \w for his sin| strong="H2403" \w* [which he hath done]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}: \w and the sin| strong="H2403" \w* [which he hath done]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} [shall be forgiven]{strong=“H5545” x-morph=“strongMorph: \sc Th\sc*8738”} him. 
\p
\v 23 [And when ye shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the land| strong="H776" \w*, [and shall have planted]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8804”} \w all manner of trees| strong="H6086" \w* \w for food| strong="H3978" \w*, \w then ye shall count| strong="H6188" \w* \w the fruit| strong="H6529" \w* [thereof as uncircumcised]{strong=“H6190 H6188” x-morph=“strongMorph: \sc Th\sc*8804”}: \w three| strong="H7969" \w* \w years| strong="H8141" \w* \w shall it be as uncircumcised| strong="H6189" \w* [unto you: it shall not be eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8735”} of. 
\v 24 \w But in the fourth| strong="H7243" \w* \w year| strong="H8141" \w* \w all the fruit| strong="H6529" \w* \w thereof shall be holy| strong="H6944" \w* \w to praise| strong="H1974" \w* the \sc Lord\sc* withal.^\sc 19:24 holy…: Heb. holiness of praises to the [Lord\sc*] 
\v 25 \w And in the fifth| strong="H2549" \w* \w year| strong="H8141" \w* [shall ye eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the fruit| strong="H6529" \w* [thereof, that it may yield]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8687”} \w unto you the increase| strong="H8393" \w* thereof: I am the \sc Lord\sc* \w your God| strong="H430" \w*. 
\p
\v 26 [Ye shall not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} any thing \w with the blood| strong="H1818" \w*: [neither shall ye use enchantment]{strong=“H5172” x-morph=“strongMorph: \sc Th\sc*8762”}, [nor observe times]{strong=“H6049” x-morph=“strongMorph: \sc Th\sc*8779”}. 
\v 27 [Ye shall not round]{strong=“H5362” x-morph=“strongMorph: \sc Th\sc*8686”} \w the corners| strong="H6285" \w* \w of your heads| strong="H7218" \w*, [neither shalt thou mar]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8686”} \w the corners| strong="H6285" \w* \w of thy beard| strong="H2206" \w*. 
\v 28 [Ye shall not make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w any| strong="H3793" \w* \w cuttings| strong="H8296" \w* \w in your flesh| strong="H1320" \w* \w for the dead| strong="H5315" \w*, [nor print]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w any marks| strong="H7085" \w* upon you: I am the \sc Lord\sc*. 
\p
\v 29 [Do not prostitute]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy daughter| strong="H1323" \w*, [to cause her to be a whore]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8687”}; \w lest the land| strong="H776" \w* [fall to whoredom]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the land| strong="H776" \w* [become full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of wickedness| strong="H2154" \w*.\f + \fr 19:29 \ft prostitute: Heb. profane \f* 
\p
\v 30 [Ye shall keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w my sabbaths| strong="H7676" \w*, [and reverence]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w my sanctuary| strong="H4720" \w*: I am the \sc Lord\sc*. 
\p
\v 31 [Regard]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8799”} \w not them that have familiar spirits| strong="H178" \w*, [neither seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w after wizards| strong="H3049" \w*, [to be defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8800”} by them: I am the \sc Lord\sc* \w your God| strong="H430" \w*. 
\p
\v 32 [Thou shalt rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* \w the hoary head| strong="H7872" \w*, [and honour]{strong=“H1921” x-morph=“strongMorph: \sc Th\sc*8804”} \w the face| strong="H6440" \w* \w of the old man| strong="H2205" \w*, [and fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy God| strong="H430" \w*: I am the \sc Lord\sc*. 
\p
\v 33 \w And if a stranger| strong="H1616" \w* [sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”} \w with thee in your land| strong="H776" \w*, [ye shall not vex]{strong=“H3238” x-morph=“strongMorph: \sc Th\sc*8686”} him.\f + \fr 19:33 \ft vex: or, oppress \f* 
\v 34 But \w the stranger| strong="H1616" \w* [that dwelleth]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8802”} \w with you shall be unto you as one born| strong="H249" \w* [among you, and thou shalt love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} [him as thyself; for ye were strangers]{strong=“H1616”} \w in the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*: I am the \sc Lord\sc* \w your God| strong="H430" \w*. 
\p
\v 35 [Ye shall do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w no unrighteousness| strong="H5766" \w* \w in judgment| strong="H4941" \w*, \w in meteyard| strong="H4060" \w*, \w in weight| strong="H4948" \w*, \w or in measure| strong="H4884" \w*. 
\v 36 \w Just| strong="H6664" \w* \w balances| strong="H3976" \w*, \w just| strong="H6664" \w* \w weights| strong="H68" \w*, \w a just| strong="H6664" \w* \w ephah| strong="H374" \w*, \w and a just| strong="H6664" \w* \w hin| strong="H1969" \w*, shall ye have: I am the \sc Lord\sc* \w your God| strong="H430" \w*, [which brought you out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*.\f + \fr 19:36 \ft weights: Heb. stones \f* 
\v 37 [Therefore shall ye observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w all my statutes| strong="H2708" \w*, \w and all my judgments| strong="H4941" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} them: I am the \sc Lord\sc*.
\c 20
\p 
\v 1 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Again, thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, \w Whosoever| strong="H376" \w* he be \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, \w or of the strangers| strong="H1616" \w* [that sojourn]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8802”} \w in Israel| strong="H3478" \w*, [that giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} any \w of his seed| strong="H2233" \w* \w unto Molech| strong="H4432" \w*; [he shall surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}: \w the people| strong="H5971" \w* \w of the land| strong="H776" \w* [shall stone]{strong=“H7275” x-morph=“strongMorph: \sc Th\sc*8799”} \w him with stones| strong="H68" \w*. 
\v 3 [And I will set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w my face| strong="H6440" \w* \w against that man| strong="H376" \w*, [and will cut him off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w from among| strong="H7130" \w* \w his people| strong="H5971" \w*; [because he hath given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w of his seed| strong="H2233" \w* \w unto Molech| strong="H4432" \w*, [to defile]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8763”} \w my sanctuary| strong="H4720" \w*, [and to profane]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8763”} \w my holy| strong="H6944" \w* \w name| strong="H8034" \w*. 
\v 4 \w And if the people| strong="H5971" \w* \w of the land| strong="H776" \w* [do any ways]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8687”} [hide]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8686”} \w their eyes| strong="H5869" \w* \w from the man| strong="H376" \w*, [when he giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w of his seed| strong="H2233" \w* \w unto Molech| strong="H4432" \w*, [and kill]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8687”} \w him not| strong="H1115" \w*: 
\v 5 [Then I will set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w my face| strong="H6440" \w* \w against that man| strong="H376" \w*, \w and against his family| strong="H4940" \w*, [and will cut him off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”}, [and all that go a whoring]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”} \w after| strong="H310" \w* [him, to commit whoredom]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8800”} \w with Molech| strong="H4432" \w*, \w from among| strong="H7130" \w* \w their people| strong="H5971" \w*. 
\p
\v 6 \w And the soul| strong="H5315" \w* [that turneth]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H413" \w* \w such as have familiar spirits| strong="H178" \w*, \w and after| strong="H310" \w* \w wizards| strong="H3049" \w*, [to go a whoring]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8800”} \w after| strong="H310" \w* [them, I will even set]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w my face| strong="H6440" \w* \w against that soul| strong="H5315" \w*, [and will cut him off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w from among| strong="H7130" \w* \w his people| strong="H5971" \w*. 
\p
\v 7 [Sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8694”} [yourselves therefore, and be ye holy]{strong=“H6918”}: for I am the \sc Lord\sc* \w your God| strong="H430" \w*. 
\v 8 [And ye shall keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w my statutes| strong="H2708" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} them: I am the \sc Lord\sc* [which sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8764”} you. 
\p
\v 9 \w For every| strong="H376" \w* \w one| strong="H376" \w* [that curseth]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8762”} \w his father| strong="H1" \w* \w or his mother| strong="H517" \w* [shall be surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}: [he hath cursed]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8765”} \w his father| strong="H1" \w* \w or his mother| strong="H517" \w*; \w his blood| strong="H1818" \w* shall be upon him. 
\p
\v 10 \w And the man| strong="H376" \w* [that committeth adultery]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8799”} with another [man’s]{strong=“H376”} \w wife| strong="H802" \w*, even he [that committeth adultery]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8799”} [with his neighbour’s]{strong=“H7453”} \w wife| strong="H802" \w*, [the adulterer]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8802”} [and the adulteress]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8802”} [shall surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}. 
\v 11 \w And the man| strong="H376" \w* [that lieth]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} [with his father’s]{strong=“H1”} \w wife| strong="H802" \w* [hath uncovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8765”} [his father’s]{strong=“H1”} \w nakedness| strong="H6172" \w*: \w both| strong="H8147" \w* [of them shall surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}; \w their blood| strong="H1818" \w* shall be upon them. 
\v 12 \w And if a man| strong="H376" \w* [lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w with his daughter in law| strong="H3618" \w*, \w both| strong="H8147" \w* [of them shall surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}: [they have wrought]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w confusion| strong="H8397" \w*; \w their blood| strong="H1818" \w* shall be upon them. 
\v 13 \w If a man| strong="H376" \w* [also lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w with mankind| strong="H2145" \w*, \w as he lieth| strong="H4904" \w* \w with a woman| strong="H802" \w*, \w both| strong="H8147" \w* [of them have committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w an abomination| strong="H8441" \w*: [they shall surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}; \w their blood| strong="H1818" \w* shall be upon them. 
\v 14 \w And if a man| strong="H376" \w* [take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a wife| strong="H802" \w* \w and her mother| strong="H517" \w*, it is \w wickedness| strong="H2154" \w*: [they shall be burnt]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8799”} \w with fire| strong="H784" \w*, [both he and they; that there be no wickedness]{strong=“H2154”} \w among| strong="H8432" \w* you. 
\v 15 \w And if a man| strong="H376" \w* [lie]{strong=“H7903 H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w with a beast| strong="H929" \w*, [he shall surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}: [and ye shall slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} \w the beast| strong="H929" \w*. 
\v 16 \w And if a woman| strong="H802" \w* [approach]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto any beast| strong="H929" \w*, [and lie down]{strong=“H7250” x-morph=“strongMorph: \sc Th\sc*8800”} [thereto, thou shalt kill]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8804”} \w the woman| strong="H802" \w*, \w and the beast| strong="H929" \w*: [they shall surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}; \w their blood| strong="H1818" \w* shall be upon them. 
\v 17 \w And if a man| strong="H376" \w* [shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w his sister| strong="H269" \w*, [his father’s]{strong=“H1”} \w daughter| strong="H1323" \w*, \w or| strong="H176" \w* [his mother’s]{strong=“H517”} \w daughter| strong="H1323" \w*, [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w her nakedness| strong="H6172" \w*, [and she see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w his nakedness| strong="H6172" \w*; it is \w a wicked thing| strong="H2617" \w*; [and they shall be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8738”} \w in the sight| strong="H5869" \w* [of their people]{strong=“H1121 H5971”}: [he hath uncovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8765”} [his sister’s]{strong=“H269”} \w nakedness| strong="H6172" \w*; [he shall bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w his iniquity| strong="H5771" \w*. 
\v 18 \w And if a man| strong="H376" \w* [shall lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w with a woman| strong="H802" \w* \w having her sickness| strong="H1739" \w*, [and shall uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8765”} \w her nakedness| strong="H6172" \w*; [he hath discovered]{strong=“H6168” x-morph=“strongMorph: \sc Th\sc*8689”} \w her fountain| strong="H4726" \w*, [and she hath uncovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8765”} \w the fountain| strong="H4726" \w* \w of her blood| strong="H1818" \w*: \w and both| strong="H8147" \w* [of them shall be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8738”} \w from among| strong="H7130" \w* \w their people| strong="H5971" \w*.\f + \fr 20:18 \ft discovered: Heb. made naked \f* 
\v 19 [And thou shalt not uncover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”} \w the nakedness| strong="H6172" \w* [of thy mother’s]{strong=“H517”} \w sister| strong="H269" \w*, [nor of thy father’s]{strong=“H1”} \w sister| strong="H269" \w*: [for he uncovereth]{strong=“H6168” x-morph=“strongMorph: \sc Th\sc*8689”} \w his near kin| strong="H7607" \w*: [they shall bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their iniquity| strong="H5771" \w*.\f + \fr 20:19 \ft uncovereth: Heb. hath made naked \f* 
\v 20 \w And if a man| strong="H376" \w* [shall lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} [with his uncle’s wife]{strong=“H1733”}, [he hath uncovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8765”} [his uncle’s]{strong=“H1730”} \w nakedness| strong="H6172" \w*: [they shall bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their sin| strong="H2399" \w*; [they shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w childless| strong="H6185" \w*. 
\v 21 \w And if a man| strong="H376" \w* [shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [his brother’s]{strong=“H251”} \w wife| strong="H802" \w*, it is \w an unclean thing| strong="H5079" \w*: [he hath uncovered]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8765”} [his brother’s]{strong=“H251”} \w nakedness| strong="H6172" \w*; \w they shall be childless| strong="H6185" \w*.\f + \fr 20:21 \ft an…: Heb. a separation \f* 
\p
\v 22 [Ye shall therefore keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w all my statutes| strong="H2708" \w*, \w and all my judgments| strong="H4941" \w*, [and do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [them: that the land]{strong=“H776”}, [whither I bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8688”} [you to dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} [therein, spue you not out]{strong=“H6958” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 23 [And ye shall not walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the manners| strong="H2708" \w* \w of the nation| strong="H1471" \w*, [which I cast out]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8764”} \w before| strong="H6440" \w* [you: for they committed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [all these things, and therefore I abhorred]{strong=“H6973” x-morph=“strongMorph: \sc Th\sc*8799”} them. 
\v 24 [But I have said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto you, Ye shall inherit]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8799”} \w their land| strong="H127" \w*, [and I will give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [it unto you to possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} [it, a land]{strong=“H776”} [that floweth]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”} \w with milk| strong="H2461" \w* \w and honey| strong="H1706" \w*: I am the \sc Lord\sc* \w your God| strong="H430" \w*, [which have separated]{strong=“H914” x-morph=“strongMorph: \sc Th\sc*8689”} you from other \w people| strong="H5971" \w*. 
\v 25 [Ye shall therefore put difference]{strong=“H914” x-morph=“strongMorph: \sc Th\sc*8689”} \w between clean| strong="H2889" \w* \w beasts| strong="H929" \w* \w and unclean| strong="H2931" \w*, \w and between unclean| strong="H2931" \w* \w fowls| strong="H5775" \w* \w and clean| strong="H2889" \w*: \w and ye shall not make your souls| strong="H5315" \w* [abominable]{strong=“H8262” x-morph=“strongMorph: \sc Th\sc*8762”} \w by beast| strong="H929" \w*, \w or by fowl| strong="H5775" \w*, [or by any manner of living thing that creepeth]{strong=“H7430” x-morph=“strongMorph: \sc Th\sc*8799”} \w on the ground| strong="H127" \w*, [which I have separated]{strong=“H914” x-morph=“strongMorph: \sc Th\sc*8689”} [from you as unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8763”}.\f + \fr 20:25 \ft creepeth: or, moveth \f* 
\v 26 \w And ye shall be holy| strong="H6918" \w* unto me: for I the \sc Lord\sc* am \w holy| strong="H6918" \w*, [and have severed]{strong=“H914” x-morph=“strongMorph: \sc Th\sc*8686”} you from other \w people| strong="H5971" \w*, that ye should be mine. 
\p
\v 27 \w A man| strong="H376" \w* \w also or woman| strong="H802" \w* \w that hath| strong="H3588" \w* \w a familiar spirit| strong="H178" \w*, \w or that is a wizard| strong="H3049" \w*, [shall surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}: [they shall stone]{strong=“H7275” x-morph=“strongMorph: \sc Th\sc*8799”} \w them with stones| strong="H68" \w*: \w their blood| strong="H1818" \w* shall be upon them. 
\c 21
\p 
\v 1 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w*, [Speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} \w unto the priests| strong="H3548" \w* \w the sons| strong="H1121" \w* \w of Aaron| strong="H175" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, There shall none be defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8691”} \w for the dead| strong="H5315" \w* \w among his people| strong="H5971" \w*: 
\v 2 \w But for his kin| strong="H7607" \w*, \w that is near| strong="H7138" \w* unto him, that is, \w for his mother| strong="H517" \w*, \w and for his father| strong="H1" \w*, \w and for his son| strong="H1121" \w*, \w and for his daughter| strong="H1323" \w*, \w and for his brother| strong="H251" \w*, 
\v 3 \w And for his sister| strong="H269" \w* \w a virgin| strong="H1330" \w*, \w that is nigh| strong="H7138" \w* [unto him, which hath had no husband]{strong=“H376”}; [for her may he be defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8691”}. 
\v 4 But [he shall not defile]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8691”} himself, being \w a chief man| strong="H1167" \w* \w among his people| strong="H5971" \w*, [to profane]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8736”} himself.\f + \fr 21:4 \ft he…: or, being an husband among his people, he shall not defile himself for his wife, etc \f* 
\v 5 [They shall not make]{strong=“H7139” x-morph=“strongMorph: \sc Th\sc*8799”} \w baldness| strong="H7144" \w* \w upon their head| strong="H7218" \w*, [neither shall they shave off]{strong=“H1548” x-morph=“strongMorph: \sc Th\sc*8762”} \w the corner| strong="H6285" \w* \w of their beard| strong="H2206" \w*, [nor make]{strong=“H8295” x-morph=“strongMorph: \sc Th\sc*8799”} \w any cuttings| strong="H8296" \w* \w in their flesh| strong="H1320" \w*. 
\v 6 \w They shall be holy| strong="H6944" \w* \w unto their God| strong="H430" \w*, [and not profane]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8762”} \w the name| strong="H8034" \w* \w of their God| strong="H430" \w*: \w for the offerings| strong="H801" \w* of the \sc Lord\sc* \w made by fire| strong="H801" \w*, and \w the bread| strong="H3899" \w* \w of their God| strong="H430" \w*, [they do offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8688”}: \w therefore they shall be holy| strong="H6918" \w*. 
\v 7 [They shall not take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a wife| strong="H802" \w* that is [a whore]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”}, \w or profane| strong="H2491" \w*; [neither shall they take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a woman| strong="H802" \w* [put away]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8803”} \w from her husband| strong="H376" \w*: for he is \w holy| strong="H6918" \w* \w unto his God| strong="H430" \w*. 
\v 8 [Thou shalt sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8765”} [him therefore; for he offereth]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8688”} \w the bread| strong="H3899" \w* \w of thy God| strong="H430" \w*: \w he shall be holy| strong="H6918" \w* unto thee: for I the \sc Lord\sc*, [which sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8764”} you, am \w holy| strong="H6918" \w*. 
\p
\v 9 \w And the daughter| strong="H1323" \w* \w of any| strong="H376" \w* \w priest| strong="H3548" \w*, [if she profane]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8735”} [herself by playing the whore]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8800”}, [she profaneth]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8764”} \w her father| strong="H1" \w*: [she shall be burnt]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8735”} \w with fire| strong="H784" \w*. 
\p
\v 10 And he that is \w the high| strong="H1419" \w* \w priest| strong="H3548" \w* \w among his brethren| strong="H251" \w*, \w upon whose head| strong="H7218" \w* \w the anointing| strong="H4888" \w* \w oil| strong="H8081" \w* [was poured]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8714”}, [and that is consecrated]{strong=“H3027 H4390” x-morph=“strongMorph: \sc Th\sc*8765”} [to put]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8800”} \w on the garments| strong="H899" \w*, [shall not uncover]{strong=“H6544” x-morph=“strongMorph: \sc Th\sc*8799”} \w his head| strong="H7218" \w*, [nor rend]{strong=“H6533” x-morph=“strongMorph: \sc Th\sc*8799”} \w his clothes| strong="H899" \w*; 
\v 11 [Neither shall he go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [to any dead]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8801”} \w body| strong="H5315" \w*, [nor defile]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8691”} \w himself for his father| strong="H1" \w*, \w or for his mother| strong="H517" \w*; 
\v 12 [Neither shall he go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the sanctuary| strong="H4720" \w*, [nor profane]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8762”} \w the sanctuary| strong="H4720" \w* \w of his God| strong="H430" \w*; \w for the crown| strong="H5145" \w* \w of the anointing| strong="H4888" \w* \w oil| strong="H8081" \w* \w of his God| strong="H430" \w* is upon him: I am the \sc Lord\sc*. 
\v 13 [And he shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a wife| strong="H802" \w* \w in her virginity| strong="H1331" \w*. 
\v 14 \w A widow| strong="H490" \w*, [or a divorced woman]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8803”}, \w or profane| strong="H2491" \w*, or [an harlot]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8802”}, [these shall he not take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”}: [but he shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w a virgin| strong="H1330" \w* \w of his own people| strong="H5971" \w* \w to wife| strong="H802" \w*. 
\v 15 [Neither shall he profane]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8762”} \w his seed| strong="H2233" \w* \w among his people| strong="H5971" \w*: for I the \sc Lord\sc* [do sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8764”} him. 
\p
\v 16 And the \sc Lord\sc* [spake ]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 17 [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w unto Aaron| strong="H175" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w Whosoever| strong="H376" \w* he be \w of thy seed| strong="H2233" \w* \w in their generations| strong="H1755" \w* that hath any \w blemish| strong="H3971" \w*, [let him not approach]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} [to offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8687”} \w the bread| strong="H3899" \w* \w of his God| strong="H430" \w*.\f + \fr 21:17 \ft bread: or, food \f* 
\v 18 \w For whatsoever man| strong="H376" \w* he be \w that hath a blemish| strong="H3971" \w*, [he shall not approach]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”}: \w a blind| strong="H5787" \w* \w man| strong="H376" \w*, \w or a lame| strong="H6455" \w*, [or he that hath a flat nose]{strong=“H2763” x-morph=“strongMorph: \sc Th\sc*8803”}, [or any thing superfluous]{strong=“H8311” x-morph=“strongMorph: \sc Th\sc*8803”}, 
\v 19 \w Or a man| strong="H376" \w* [that is brokenfooted]{strong=“H7272 H7667”}, [or brokenhanded]{strong=“H3027 H7667”}, 
\v 20 \w Or crookbackt| strong="H1384" \w*, \w or a dwarf| strong="H1851" \w*, \w or that hath a blemish| strong="H8400" \w* \w in his eye| strong="H5869" \w*, \w or be scurvy| strong="H1618" \w*, \w or scabbed| strong="H3217" \w*, \w or hath his stones| strong="H810" \w* \w broken| strong="H4790" \w*;\f + \fr 21:20 \ft a dwarf: or, too slender \f* 
\v 21 \w No man| strong="H376" \w* \w that hath a blemish| strong="H3971" \w* \w of the seed| strong="H2233" \w* \w of Aaron| strong="H175" \w* \w the priest| strong="H3548" \w* [shall come nigh]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8799”} [to offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8687”} \w the offerings| strong="H801" \w* of the \sc Lord\sc* \w made by fire| strong="H801" \w*: \w he hath a blemish| strong="H3971" \w*; [he shall not come nigh]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8799”} [to offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8687”} \w the bread| strong="H3899" \w* \w of his God| strong="H430" \w*. 
\v 22 [He shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the bread| strong="H3899" \w* \w of his God| strong="H430" \w*, both \w of the most| strong="H6944" \w* \w holy| strong="H6944" \w*, \w and of the holy| strong="H6944" \w*. 
\v 23 [Only he shall not go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the vail| strong="H6532" \w*, [nor come nigh]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the altar| strong="H4196" \w*, \w because he hath a blemish| strong="H3971" \w*; [that he profane]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8762”} \w not my sanctuaries| strong="H4720" \w*: for I the \sc Lord\sc* [do sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8764”} them. 
\v 24 \w And Moses| strong="H4872" \w* [told]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} it \w unto Aaron| strong="H175" \w*, \w and to his sons| strong="H1121" \w*, \w and unto all the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*.
\c 22
\p 
\v 1 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w unto Aaron| strong="H175" \w* \w and to his sons| strong="H1121" \w*, [that they separate]{strong=“H5144” x-morph=“strongMorph: \sc Th\sc*8735”} \w themselves from the holy things| strong="H6944" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [and that they profane]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8762”} \w not my holy| strong="H6944" \w* \w name| strong="H8034" \w* in those things [which they hallow]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8688”} unto me: I am the \sc Lord\sc*. 
\v 3 [Say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8798”} [unto them, Whosoever]{strong=“H376”} he be \w of all your seed| strong="H2233" \w* \w among your generations| strong="H1755" \w*, [that goeth]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the holy things| strong="H6944" \w*, \w which the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [hallow]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8686”} unto the \sc Lord\sc*, \w having his uncleanness| strong="H2932" \w* [upon him, that soul]{strong=“H5315”} [shall be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8738”} \w from my presence| strong="H6440" \w*: I am the \sc Lord\sc*. 
\v 4 \w What man soever| strong="H376" \w* \w of the seed| strong="H2233" \w* \w of Aaron| strong="H175" \w* is [a leper]{strong=“H6879” x-morph=“strongMorph: \sc Th\sc*8803”}, [or hath a running issue]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”}; [he shall not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the holy things| strong="H6944" \w*, [until he be clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8799”}. [And whoso toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8802”} any thing that is \w unclean| strong="H2931" \w* by \w the dead| strong="H5315" \w*, \w or a man| strong="H376" \w* [whose seed]{strong=“H7902 H2233”} [goeth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} from him;\f + \fr 22:4 \ft running…: Heb. running of the reins \f* 
\v 5 \w Or whosoever| strong="H376" \w* [toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8799”} \w any creeping thing| strong="H8318" \w*, [whereby he may be made unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”}, \w or a man| strong="H120" \w* [of whom he may take uncleanness]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”}, \w whatsoever uncleanness| strong="H2932" \w* he hath; 
\v 6 \w The soul| strong="H5315" \w* [which hath touched]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8799”} [any such shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w until even| strong="H6153" \w*, [and shall not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the holy things| strong="H6944" \w*, \w unless| strong="H518" \w* [he wash]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} \w his flesh| strong="H1320" \w* \w with water| strong="H4325" \w*. 
\v 7 \w And when the sun| strong="H8121" \w* [is down]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”}, [he shall be clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and shall afterward| strong="H310" \w* [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the holy things| strong="H6944" \w*; because it is \w his food| strong="H3899" \w*. 
\v 8 \w That which dieth of itself| strong="H5038" \w*, \w or is torn| strong="H2966" \w* with beasts, [he shall not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [to defile]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8800”} himself therewith: I am the \sc Lord\sc*. 
\v 9 [They shall therefore keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine ordinance| strong="H4931" \w*, [lest they bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w sin| strong="H2399" \w* [for it, and die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8804”} [therefore, if they profane]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8762”} it: I the \sc Lord\sc* [do sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8764”} them. 
\p
\v 10 [There shall no stranger]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} of \w the holy thing| strong="H6944" \w*: \w a sojourner| strong="H8453" \w* \w of the priest| strong="H3548" \w*, \w or an hired servant| strong="H7916" \w*, [shall not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} of \w the holy thing| strong="H6944" \w*. 
\v 11 \w But if the priest| strong="H3548" \w* [buy]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8799”} any \w soul| strong="H5315" \w* \w with| strong="H7075" \w* \w his money| strong="H3701" \w*, [he shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [of it, and he that is born]{strong=“H3211”} \w in his house| strong="H1004" \w*: [they shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w of his meat| strong="H3899" \w*.\f + \fr 22:11 \ft with…: Heb. with the purchase of his money \f* 
\v 12 [If the priest’s]{strong=“H3548”} \w daughter| strong="H1323" \w* also be married [unto a stranger]{strong=“H2114 H376” x-morph=“strongMorph: \sc Th\sc*8801”}, [she may not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w of an offering| strong="H8641" \w* \w of the holy things| strong="H6944" \w*.\f + \fr 22:12 \ft a stranger: Heb. a man a stranger \f* 
\v 13 [But if the priest’s]{strong=“H3548”} \w daughter| strong="H1323" \w* \w be a widow| strong="H490" \w*, [or divorced]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8803”}, \w and have no child| strong="H2233" \w*, [and is returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} [unto her father’s]{strong=“H1”} \w house| strong="H1004" \w*, \w as in her youth| strong="H5271" \w*, [she shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [of her father’s]{strong=“H1”} \w meat| strong="H3899" \w*: [but there shall no stranger]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} thereof. 
\p
\v 14 \w And if a man| strong="H376" \w* [eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} of \w the holy thing| strong="H6944" \w* \w unwittingly| strong="H7684" \w*, [then he shall put]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8804”} \w the fifth| strong="H2549" \w* part [thereof unto it, and shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} it \w unto the priest| strong="H3548" \w* \w with the holy thing| strong="H6944" \w*. 
\v 15 [And they shall not profane]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8762”} \w the holy things| strong="H6944" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [which they offer]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} unto the \sc Lord\sc*; 
\v 16 [Or suffer them to bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8689”} \w the iniquity| strong="H5771" \w* \w of trespass| strong="H819" \w*, [when they eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} \w their holy things| strong="H6944" \w*: for I the \sc Lord\sc* [do sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8764”} them.\f + \fr 22:16 \ft suffer…: or, lade themselves with the iniquity of trespass in their eating \f* 
\p
\v 17 And the \sc Lord\sc* [spake ]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 18 [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w unto Aaron| strong="H175" \w*, \w and to his sons| strong="H1121" \w*, \w and unto all the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Whatsoever]{strong=“H376”} he be \w of the house| strong="H1004" \w* \w of Israel| strong="H3478" \w*, \w or of the strangers| strong="H1616" \w* \w in Israel| strong="H3478" \w*, [that will offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”} \w his oblation| strong="H7133" \w* \w for all his vows| strong="H5088" \w*, \w and for all his freewill offerings| strong="H5071" \w*, [which they will offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”} unto the \sc Lord\sc* \w for a burnt offering| strong="H5930" \w*; 
\v 19 Ye shall offer \w at your own will| strong="H7522" \w* \w a male| strong="H2145" \w* \w without blemish| strong="H8549" \w*, \w of the beeves| strong="H1241" \w*, \w of the sheep| strong="H3775" \w*, \w or of the goats| strong="H5795" \w*. 
\v 20 But \w whatsoever hath a blemish| strong="H3971" \w*, that [shall ye not offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”}: \w for it shall not be acceptable| strong="H7522" \w* for you. 
\v 21 \w And whosoever| strong="H376" \w* [offereth]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”} \w a sacrifice| strong="H2077" \w* \w of peace offerings| strong="H8002" \w* unto the \sc Lord\sc* [to accomplish]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8763”} his \w vow| strong="H5088" \w*, \w or a freewill offering| strong="H5071" \w* \w in beeves| strong="H1241" \w* \w or sheep| strong="H6629" \w*, \w it shall be perfect| strong="H8549" \w* \w to be accepted| strong="H7522" \w*; \w there shall be no blemish| strong="H3971" \w* therein.\f + \fr 22:21 \ft sheep: or, goats \f* 
\v 22 \w Blind| strong="H5788" \w*, [or broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8803”}, [or maimed]{strong=“H2782” x-morph=“strongMorph: \sc Th\sc*8803”}, \w or having a wen| strong="H2990" \w*, \w or scurvy| strong="H1618" \w*, \w or scabbed| strong="H3217" \w*, [ye shall not offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”} these unto the \sc Lord\sc*, [nor make]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w an offering by fire| strong="H801" \w* \w of them upon the altar| strong="H4196" \w* unto the \sc Lord\sc*. 
\v 23 \w Either a bullock| strong="H7794" \w* \w or a lamb| strong="H7716" \w* [that hath any thing superfluous]{strong=“H8311” x-morph=“strongMorph: \sc Th\sc*8803”} [or lacking in his parts]{strong=“H7038” x-morph=“strongMorph: \sc Th\sc*8803”}, [that mayest thou offer]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} for \w a freewill offering| strong="H5071" \w*; \w but for a vow| strong="H5088" \w* [it shall not be accepted]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 22:23 \ft lamb: or, kid \f* 
\v 24 [Ye shall not offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”} unto the \sc Lord\sc* [that which is bruised]{strong=“H4600” x-morph=“strongMorph: \sc Th\sc*8803”}, [or crushed]{strong=“H3807” x-morph=“strongMorph: \sc Th\sc*8803”}, [or broken]{strong=“H5423” x-morph=“strongMorph: \sc Th\sc*8803”}, [or cut]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8803”}; [neither shall ye make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} any offering thereof \w in your land| strong="H776" \w*. 
