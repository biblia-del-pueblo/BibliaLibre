\p
\v 10 \w And on the eighth| strong="H8066" \w* \w day| strong="H3117" \w* [he shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w two| strong="H8147" \w* \w he lambs| strong="H3532" \w* \w without blemish| strong="H8549" \w*, \w and one| strong="H259" \w* \w ewe lamb| strong="H3535" \w* \w of the first| strong="H1323" \w* \w year| strong="H8141" \w* \w without blemish| strong="H8549" \w*, \w and three| strong="H7969" \w* \w tenth deals| strong="H6241" \w* \w of fine flour| strong="H5560" \w* for \w a meat offering| strong="H4503" \w*, [mingled]{strong=“H1101” x-morph=“strongMorph: \sc Th\sc*8803”} \w with oil| strong="H8081" \w*, \w and one| strong="H259" \w* \w log| strong="H3849" \w* \w of oil| strong="H8081" \w*.\f + \fr 14:10 \ft of the…: Heb. the daughter of her year \f* 
\v 11 \w And the priest| strong="H3548" \w* that maketh him [clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8764”} [shall present]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8689”} \w the man| strong="H376" \w* [that is to be made clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8693”}, [and those things, before]{strong=“H6440”} the \sc Lord\sc*, at \w the door| strong="H6607" \w* \w of the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*: 
