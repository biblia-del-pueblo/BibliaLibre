\c 25
\p 
\v 1 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w* \w in mount| strong="H2022" \w* \w Sinai| strong="H5514" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
