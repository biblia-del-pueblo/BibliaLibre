\v 28 \w Or if his sin| strong="H2403" \w*, [which he hath sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}, [come to his knowledge]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8717”}: [then he shall bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w his offering| strong="H7133" \w*, \w a kid| strong="H8166" \w* \w of the goats| strong="H5795" \w*, \w a female| strong="H5347" \w* \w without blemish| strong="H8549" \w*, \w for his sin| strong="H2403" \w* [which he hath sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 29 [And he shall lay]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8804”} \w his hand| strong="H3027" \w* \w upon the head| strong="H7218" \w* \w of the sin offering| strong="H2403" \w*, [and slay]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8804”} \w the sin offering| strong="H2403" \w* \w in the place| strong="H4725" \w* \w of the burnt offering| strong="H5930" \w*. 
\v 30 \w And the priest| strong="H3548" \w* [shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the blood| strong="H1818" \w* \w thereof with his finger| strong="H676" \w*, [and put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} it \w upon the horns| strong="H7161" \w* \w of the altar| strong="H4196" \w* \w of burnt offering| strong="H5930" \w*, [and shall pour out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the blood| strong="H1818" \w* \w thereof at the bottom| strong="H3247" \w* \w of the altar| strong="H4196" \w*. 
\v 31 [And he shall take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8686”} \w all the fat| strong="H2459" \w* [thereof, as the fat]{strong=“H2459”} [is taken away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8717”} \w from off the sacrifice| strong="H2077" \w* \w of peace offerings| strong="H8002" \w*; \w and the priest| strong="H3548" \w* [shall burn]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8689”} it \w upon the altar| strong="H4196" \w* \w for a sweet| strong="H5207" \w* \w savour| strong="H7381" \w* unto the \sc Lord\sc*; \w and the priest| strong="H3548" \w* [shall make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8765”} [for him, and it shall be forgiven]{strong=“H5545” x-morph=“strongMorph: \sc Th\sc*8738”} him. 
\v 32 [And if he bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w a lamb| strong="H3532" \w* \w for a sin| strong="H2403" \w* \w offering| strong="H7133" \w*, [he shall bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w it a female| strong="H5347" \w* \w without blemish| strong="H8549" \w*. 
\v 33 [And he shall lay]{strong=“H5564” x-morph=“strongMorph: \sc Th\sc*8804”} \w his hand| strong="H3027" \w* \w upon the head| strong="H7218" \w* \w of the sin offering| strong="H2403" \w*, [and slay]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8804”} \w it for a sin offering| strong="H2403" \w* \w in the place| strong="H4725" \w* [where they kill]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8799”} \w the burnt offering| strong="H5930" \w*. 
\v 34 \w And the priest| strong="H3548" \w* [shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w of the blood| strong="H1818" \w* \w of the sin offering| strong="H2403" \w* \w with his finger| strong="H676" \w*, [and put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} it \w upon the horns| strong="H7161" \w* \w of the altar| strong="H4196" \w* \w of burnt offering| strong="H5930" \w*, [and shall pour out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the blood| strong="H1818" \w* \w thereof at the bottom| strong="H3247" \w* \w of the altar| strong="H4196" \w*: 
\v 35 [And he shall take away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8686”} \w all the fat| strong="H2459" \w* [thereof, as the fat]{strong=“H2459”} \w of the lamb| strong="H3775" \w* [is taken away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8714”} \w from the sacrifice| strong="H2077" \w* \w of the peace offerings| strong="H8002" \w*; \w and the priest| strong="H3548" \w* [shall burn]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8689”} \w them upon the altar| strong="H4196" \w*, \w according to the offerings made by fire| strong="H801" \w* unto the \sc Lord\sc*: \w and the priest| strong="H3548" \w* [shall make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8765”} \w for his sin| strong="H2403" \w* [that he hath committed]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}, [and it shall be forgiven]{strong=“H5545” x-morph=“strongMorph: \sc Th\sc*8738”} him.
\c 5
\p 
\v 1 \w And if a soul| strong="H5315" \w* [sin]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8799”}, [and hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the voice| strong="H6963" \w* \w of swearing| strong="H423" \w*, and is \w a witness| strong="H5707" \w*, \w whether| strong="H176" \w* [he hath seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} [or known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} of it; [if he do not utter]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} it, [then he shall bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w his iniquity| strong="H5771" \w*. 
\v 2 \w Or if a soul| strong="H5315" \w* [touch]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8799”} \w any unclean| strong="H2931" \w* \w thing| strong="H1697" \w*, whether it be \w a carcase| strong="H5038" \w* \w of an unclean| strong="H2931" \w* \w beast| strong="H2416" \w*, \w or a carcase| strong="H5038" \w* \w of unclean| strong="H2931" \w* \w cattle| strong="H929" \w*, \w or the carcase| strong="H5038" \w* \w of unclean| strong="H2931" \w* \w creeping things| strong="H8318" \w*, and if [it be hidden]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8738”} [from him; he also shall be unclean]{strong=“H2931”}, [and guilty]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 3 [Or if he touch]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8799”} \w the uncleanness| strong="H2932" \w* \w of man| strong="H120" \w*, \w whatsoever uncleanness| strong="H2932" \w* it be [that a man shall be defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”} [withal, and it be hid]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8738”} [from him; when he knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} of it, [then he shall be guilty]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 4 \w Or if a soul| strong="H5315" \w* [swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8735”}, [pronouncing]{strong=“H981” x-morph=“strongMorph: \sc Th\sc*8763”} with his \w lips| strong="H8193" \w* [to do evil]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8687”}, [or to do good]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8687”}, whatsoever it be \w that a man| strong="H120" \w* [shall pronounce]{strong=“H981” x-morph=“strongMorph: \sc Th\sc*8762”} \w with an oath| strong="H7621" \w*, [and it be hid]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8738”} [from him; when he knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} of it, [then he shall be guilty]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8804”} \w in one| strong="H259" \w* of these. 
\v 5 [And it shall be, when he shall be guilty]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8799”} \w in one| strong="H259" \w* of these things, [that he shall confess]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8694”} [that he hath sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} in that thing: 
\v 6 [And he shall bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w his trespass offering| strong="H817" \w* unto the \sc Lord\sc* \w for his sin| strong="H2403" \w* [which he hath sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}, \w a female| strong="H5347" \w* \w from the flock| strong="H6629" \w*, \w a lamb| strong="H3776" \w* \w or a kid| strong="H8166" \w* \w of the goats| strong="H5795" \w*, \w for a sin offering| strong="H2403" \w*; \w and the priest| strong="H3548" \w* [shall make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8765”} \w for him concerning his sin| strong="H2403" \w*. 
\p
\v 7 \w And if he| strong="H3027" \w* \w be not able| strong="H1767" \w* [to bring]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8686”} \w a lamb| strong="H7716" \w*, [then he shall bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w for| strong="H854" \w* \w his trespass| strong="H817" \w*, [which he hath committed]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}, \w two| strong="H8147" \w* \w turtledoves| strong="H8449" \w*, \w or two| strong="H8147" \w* \w young| strong="H1121" \w* \w pigeons| strong="H3123" \w*, unto the \sc Lord\sc*; \w one| strong="H259" \w* \w for a sin offering| strong="H2403" \w*, \w and the other| strong="H259" \w* \w for a burnt offering| strong="H5930" \w*.\f + \fr 5:7 \ft he be…: Heb. his hand cannot reach to the sufficiency of a lamb \f* 
\v 8 [And he shall bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w them unto the priest| strong="H3548" \w*, [who shall offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8689”} that which is \w for the sin offering| strong="H2403" \w* \w first| strong="H7223" \w*, [and wring off]{strong=“H4454” x-morph=“strongMorph: \sc Th\sc*8804”} \w his head| strong="H7218" \w* \w from| strong="H4136" \w* \w his neck| strong="H6203" \w*, but shall not divide it [asunder]{strong=“H914” x-morph=“strongMorph: \sc Th\sc*8686”}: 
\v 9 [And he shall sprinkle]{strong=“H5137” x-morph=“strongMorph: \sc Th\sc*8689”} \w of the blood| strong="H1818" \w* \w of the sin offering| strong="H2403" \w* \w upon the side| strong="H7023" \w* \w of the altar| strong="H4196" \w*; [and the rest]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”} \w of the blood| strong="H1818" \w* [shall be wrung out]{strong=“H4680” x-morph=“strongMorph: \sc Th\sc*8735”} \w at the bottom| strong="H3247" \w* \w of the altar| strong="H4196" \w*: it is \w a sin offering| strong="H2403" \w*. 
\v 10 [And he shall offer]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w the second| strong="H8145" \w* for \w a burnt offering| strong="H5930" \w*, \w according to the manner| strong="H4941" \w*: \w and the priest| strong="H3548" \w* [shall make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8765”} \w for him for his sin| strong="H2403" \w* [which he hath sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}, [and it shall be forgiven]{strong=“H5545” x-morph=“strongMorph: \sc Th\sc*8738”} him.\f + \fr 5:10 \ft manner: or, ordinance \f* 
\p
\v 11 \w But if he| strong="H3027" \w* [be not able to bring]{strong=“H5381” x-morph=“strongMorph: \sc Th\sc*8686”} \w two| strong="H8147" \w* \w turtledoves| strong="H8449" \w*, \w or two| strong="H8147" \w* \w young| strong="H1121" \w* \w pigeons| strong="H3123" \w*, [then he that sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} [shall bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w for his offering| strong="H7133" \w* \w the tenth| strong="H6224" \w* \w part of an ephah| strong="H374" \w* \w of fine flour| strong="H5560" \w* \w for a sin offering| strong="H2403" \w*; [he shall put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w no oil| strong="H8081" \w* [upon it, neither shall he put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} any \w frankincense| strong="H3828" \w* thereon: for it is \w a sin offering| strong="H2403" \w*. 
\v 12 [Then shall he bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w it to the priest| strong="H3548" \w*, \w and the priest| strong="H3548" \w* [shall take]{strong=“H7061” x-morph=“strongMorph: \sc Th\sc*8804”} [his handful]{strong=“H7062 H4393”} of it, even \w a memorial| strong="H234" \w* [thereof, and burn]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8689”} it \w on the altar| strong="H4196" \w*, \w according to the offerings made by fire| strong="H801" \w* unto the \sc Lord\sc*: it is \w a sin offering| strong="H2403" \w*. 
\v 13 \w And the priest| strong="H3548" \w* [shall make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8765”} \w for him as touching his sin| strong="H2403" \w* [that he hath sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} \w in one| strong="H259" \w* [of these, and it shall be forgiven]{strong=“H5545” x-morph=“strongMorph: \sc Th\sc*8738”} him: and the remnant [shall be the priest’s]{strong=“H3548”}, \w as a meat offering| strong="H4503" \w*. 
\p
\v 14 And the \sc Lord\sc* [spake ]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 15 \w If a soul| strong="H5315" \w* [commit]{strong=“H4603” x-morph=“strongMorph: \sc Th\sc*8799”} \w a trespass| strong="H4604" \w*, [and sin]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} \w through ignorance| strong="H7684" \w*, \w in the holy things| strong="H6944" \w* of the \sc Lord\sc*; [then he shall bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w for his trespass| strong="H817" \w* unto the \sc Lord\sc* \w a ram| strong="H352" \w* \w without blemish| strong="H8549" \w* \w out of the flocks| strong="H6629" \w*, \w with thy estimation| strong="H6187" \w* \w by shekels| strong="H8255" \w* \w of silver| strong="H3701" \w*, \w after the shekel| strong="H8255" \w* \w of the sanctuary| strong="H6944" \w*, \w for a trespass offering| strong="H817" \w*: 
\v 16 [And he shall make amends]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} [for the harm]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} \w that he hath done in the holy thing| strong="H6944" \w*, [and shall add]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w the fifth part| strong="H2549" \w* [thereto, and give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w it unto the priest| strong="H3548" \w*: \w and the priest| strong="H3548" \w* [shall make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8762”} \w for him with the ram| strong="H352" \w* \w of the trespass offering| strong="H817" \w*, [and it shall be forgiven]{strong=“H5545” x-morph=“strongMorph: \sc Th\sc*8738”} him. 
\p
\v 17 \w And if a soul| strong="H5315" \w* [sin]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8799”}, [and commit]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w any| strong="H259" \w* [of these things which are forbidden to be done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8735”} \w by the commandments| strong="H4687" \w* of the \sc Lord\sc*; [though he wist]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} it [not, yet is he guilty]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8804”}, [and shall bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w his iniquity| strong="H5771" \w*. 
\v 18 [And he shall bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w a ram| strong="H352" \w* \w without blemish| strong="H8549" \w* \w out of the flock| strong="H6629" \w*, \w with thy estimation| strong="H6187" \w*, \w for a trespass offering| strong="H817" \w*, \w unto the priest| strong="H3548" \w*: \w and the priest| strong="H3548" \w* [shall make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8765”} \w for him concerning his ignorance| strong="H7684" \w* [wherein he erred]{strong=“H7683” x-morph=“strongMorph: \sc Th\sc*8804”} [and wist]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} it [not, and it shall be forgiven]{strong=“H5545” x-morph=“strongMorph: \sc Th\sc*8738”} him. 
\v 19 It is \w a trespass offering| strong="H817" \w*: [he hath certainly]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8800”} [trespassed]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8804”} against the \sc Lord\sc*. 
\c 6
\p 
\v 1 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w If a soul| strong="H5315" \w* [sin]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8799”}, [and commit]{strong=“H4603” x-morph=“strongMorph: \sc Th\sc*8804”} \w a trespass| strong="H4604" \w* against the \sc Lord\sc*, [and lie]{strong=“H3584” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto his neighbour| strong="H5997" \w* \w in that which was delivered| strong="H6487" \w* [him to keep, or in fellowship]{strong=“H3027 H8667”}, \w or in a thing taken away by violence| strong="H1498" \w*, [or hath deceived]{strong=“H6231” x-morph=“strongMorph: \sc Th\sc*8804”} \w his neighbour| strong="H5997" \w*;\f + \fr 6:2 \ft in fellowship: or, in dealing \f* \f + \fr 6:2 \ft fellowship: Heb. putting of the hand \f* 
\v 3 [Or have found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w that which was lost| strong="H9" \w*, [and lieth]{strong=“H3584” x-morph=“strongMorph: \sc Th\sc*8765”} [concerning it, and sweareth]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w falsely| strong="H8267" \w*; \w in any| strong="H259" \w* \w of all these that a man| strong="H120" \w* [doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}, [sinning]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8800”} \w therein| strong="H2007" \w*: 
\v 4 [Then it shall be, because he hath sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8799”}, [and is guilty]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8804”}, [that he shall restore]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8689”} \w that| strong="H1500" \w* [which he took violently away]{strong=“H1497” x-morph=“strongMorph: \sc Th\sc*8804”}, \w or the thing| strong="H6233" \w* [which he hath deceitfully gotten]{strong=“H6231” x-morph=“strongMorph: \sc Th\sc*8804”}, [or that which was delivered]{strong=“H853 H6487”} [him to keep]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8717”}, \w or the lost thing| strong="H9" \w* [which he found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”}, 
\v 5 [Or all that about which he hath sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8735”} \w falsely| strong="H8267" \w*; [he shall even restore]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8765”} \w it in the principal| strong="H7218" \w*, \w and shall add| strong="H3254" \w* \w the fifth part| strong="H2549" \w* [more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} thereto, and [give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [it unto him to whom it appertaineth, in the day]{strong=“H3117”} \w of his trespass offering| strong="H819" \w*.\f + \fr 6:5 \ft in the day…: or, in the day of his being found guilty: Heb. in the day of his trespass \f* 
\v 6 [And he shall bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w his trespass offering| strong="H817" \w* unto the \sc Lord\sc*, \w a ram| strong="H352" \w* \w without blemish| strong="H8549" \w* \w out of the flock| strong="H6629" \w*, \w with thy estimation| strong="H6187" \w*, \w for a trespass offering| strong="H817" \w*, \w unto the priest| strong="H3548" \w*: 
