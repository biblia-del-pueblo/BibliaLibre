\v 4 \w Then shall the priest| strong="H3548" \w* [command ]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [to take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} [for him that is to be cleansed]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8693”} \w two| strong="H8147" \w* \w birds| strong="H6833" \w* \w alive| strong="H2416" \w* and \w clean| strong="H2889" \w*, \w and cedar| strong="H730" \w* \w wood| strong="H6086" \w*, [and scarlet]{strong=“H8438 H8144”}, \w and hyssop| strong="H231" \w*:\f + \fr 14:4 \ft birds: or, sparrows \f* 
\v 5 \w And the priest| strong="H3548" \w* [shall command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w that one| strong="H259" \w* \w of the birds| strong="H6833" \w* [be killed]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8804”} \w in an earthen| strong="H2789" \w* \w vessel| strong="H3627" \w* \w over running| strong="H2416" \w* \w water| strong="H4325" \w*: 
\v 6 \w As for the living| strong="H2416" \w* \w bird| strong="H6833" \w*, [he shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [it, and the cedar]{strong=“H730”} \w wood| strong="H6086" \w*, [and the scarlet]{strong=“H8438 H8144”}, \w and the hyssop| strong="H231" \w*, [and shall dip]{strong=“H2881” x-morph=“strongMorph: \sc Th\sc*8804”} \w them and the living| strong="H2416" \w* \w bird| strong="H6833" \w* \w in the blood| strong="H1818" \w* \w of the bird| strong="H6833" \w* that was [killed]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8803”} \w over the running| strong="H2416" \w* \w water| strong="H4325" \w*: 
\v 7 [And he shall sprinkle]{strong=“H5137” x-morph=“strongMorph: \sc Th\sc*8689”} [upon him that is to be cleansed]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8693”} \w from the leprosy| strong="H6883" \w* \w seven| strong="H7651" \w* \w times| strong="H6471" \w*, [and shall pronounce him clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8765”}, \w and shall let the living| strong="H2416" \w* \w bird| strong="H6833" \w* [loose]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w into the open| strong="H6440" \w* \w field| strong="H7704" \w*.\f + \fr 14:7 \ft into…: Heb. upon the face of the field \f* 
\v 8 [And he that is to be cleansed]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8693”} [shall wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8765”} \w his clothes| strong="H899" \w*, [and shave]{strong=“H1548” x-morph=“strongMorph: \sc Th\sc*8765”} \w off all his hair| strong="H8181" \w*, [and wash]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} \w himself in water| strong="H4325" \w*, [that he may be clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8804”}: \w and after| strong="H310" \w* [that he shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the camp| strong="H4264" \w*, [and shall tarry]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w abroad| strong="H2351" \w* \w out of his tent| strong="H168" \w* \w seven| strong="H7651" \w* \w days| strong="H3117" \w*. 
