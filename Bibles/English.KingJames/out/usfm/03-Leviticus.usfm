\v 4 \w Nevertheless| strong="H389" \w* [these shall ye not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [of them that chew]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8688”} \w the cud| strong="H1625" \w*, [or of them that divide]{strong=“H6536” x-morph=“strongMorph: \sc Th\sc*8688”} \w the hoof| strong="H6541" \w*: as \w the camel| strong="H1581" \w*, [because he cheweth]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8688”} \w the cud| strong="H1625" \w*, [but divideth]{strong=“H6536” x-morph=“strongMorph: \sc Th\sc*8688”} \w not the hoof| strong="H6541" \w*; he is \w unclean| strong="H2931" \w* unto you. 
\v 5 \w And the coney| strong="H8227" \w*, [because he cheweth]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8688”} \w the cud| strong="H1625" \w*, [but divideth]{strong=“H6536” x-morph=“strongMorph: \sc Th\sc*8686”} \w not the hoof| strong="H6541" \w*; he is \w unclean| strong="H2931" \w* unto you. 
\v 6 \w And the hare| strong="H768" \w*, [because he cheweth]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8688”} \w the cud| strong="H1625" \w*, [but divideth]{strong=“H6536” x-morph=“strongMorph: \sc Th\sc*8689”} \w not the hoof| strong="H6541" \w*; he is \w unclean| strong="H2931" \w* unto you. 
\v 7 \w And the swine| strong="H2386" \w*, [though he divide]{strong=“H6536” x-morph=“strongMorph: \sc Th\sc*8688”} \w the hoof| strong="H6541" \w*, [and be clovenfooted]{strong=“H8157 H8156” x-morph=“strongMorph: \sc Th\sc*8802”}, [yet he cheweth]{strong=“H1641” x-morph=“strongMorph: \sc Th\sc*8735”} \w not the cud| strong="H1625" \w*; he is \w unclean| strong="H2931" \w* to you. 
\v 8 \w Of their flesh| strong="H1320" \w* [shall ye not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and their carcase| strong="H5038" \w* [shall ye not touch]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8799”}; they are \w unclean| strong="H2931" \w* to you. 
\p
\v 9 [These shall ye eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} of all that are \w in the waters| strong="H4325" \w*: \w whatsoever hath fins| strong="H5579" \w* \w and scales| strong="H7193" \w* \w in the waters| strong="H4325" \w*, \w in the seas| strong="H3220" \w*, \w and in the rivers| strong="H5158" \w*, [them shall ye eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 10 \w And all that have not fins| strong="H5579" \w* \w and scales| strong="H7193" \w* \w in the seas| strong="H3220" \w*, \w and in the rivers| strong="H5158" \w*, \w of all that move| strong="H8318" \w* \w in the waters| strong="H4325" \w*, \w and of any living| strong="H2416" \w* \w thing| strong="H5315" \w* which is \w in the waters| strong="H4325" \w*, they shall be \w an abomination| strong="H8263" \w* unto you: 
\v 11 \w They shall be even an abomination| strong="H8263" \w* [unto you; ye shall not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w of their flesh| strong="H1320" \w*, \w but ye shall have their carcases| strong="H5038" \w* [in abomination]{strong=“H8262” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 12 \w Whatsoever hath no fins| strong="H5579" \w* \w nor scales| strong="H7193" \w* \w in the waters| strong="H4325" \w*, that shall be \w an abomination| strong="H8263" \w* unto you. 
\p
\v 13 And these are they which [ye shall have in abomination]{strong=“H8262” x-morph=“strongMorph: \sc Th\sc*8762”} \w among| strong="H4480" \w* \w the fowls| strong="H5775" \w*; [they shall not be eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8735”}, they are \w an abomination| strong="H8263" \w*: \w the eagle| strong="H5404" \w*, \w and the ossifrage| strong="H6538" \w*, \w and the ospray| strong="H5822" \w*, 
\v 14 \w And the vulture| strong="H1676" \w*, \w and the kite| strong="H344" \w* \w after his kind| strong="H4327" \w*; 
\v 15 \w Every raven| strong="H6158" \w* \w after his kind| strong="H4327" \w*; 
\v 16 [And the owl]{strong=“H3284 H1323”}, \w and the night hawk| strong="H8464" \w*, \w and the cuckow| strong="H7828" \w*, \w and the hawk| strong="H5322" \w* \w after his kind| strong="H4327" \w*, 
\v 17 \w And the little owl| strong="H3563" \w*, \w and the cormorant| strong="H7994" \w*, \w and the great owl| strong="H3244" \w*, 
\v 18 \w And the swan| strong="H8580" \w*, \w and the pelican| strong="H6893" \w*, \w and the gier eagle| strong="H7360" \w*, 
\v 19 \w And the stork| strong="H2624" \w*, \w the heron| strong="H601" \w* \w after her kind| strong="H4327" \w*, \w and the lapwing| strong="H1744" \w*, \w and the bat| strong="H5847" \w*. 
\p
\v 20 \w All fowls| strong="H5775" \w* \w that creep| strong="H8318" \w*, [going]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} upon all \w four| strong="H702" \w*, shall be \w an abomination| strong="H8263" \w* unto you. 
\v 21 [Yet these may ye eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w of every flying| strong="H5775" \w* \w creeping| strong="H8318" \w* [thing that goeth]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} upon all \w four| strong="H702" \w*, \w which have legs| strong="H3767" \w* \w above| strong="H4605" \w* \w their feet| strong="H7272" \w*, [to leap]{strong=“H5425” x-morph=“strongMorph: \sc Th\sc*8763”} \w withal| strong="H2004" \w* \w upon the earth| strong="H776" \w*; 
\v 22 Even [these of them ye may eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}; \w the locust| strong="H697" \w* \w after his kind| strong="H4327" \w*, \w and the bald locust| strong="H5556" \w* \w after his kind| strong="H4327" \w*, \w and the beetle| strong="H2728" \w* \w after his kind| strong="H4327" \w*, \w and the grasshopper| strong="H2284" \w* \w after his kind| strong="H4327" \w*. 
\v 23 But all other \w flying| strong="H5775" \w* \w creeping things| strong="H8318" \w*, \w which have four| strong="H702" \w* \w feet| strong="H7272" \w*, shall be \w an abomination| strong="H8263" \w* unto you. 
\v 24 [And for these ye shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8691”}: [whosoever toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8802”} \w the carcase| strong="H5038" \w* [of them shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”} \w until the even| strong="H6153" \w*. 
\v 25 [And whosoever beareth]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8802”} ought \w of the carcase| strong="H5038" \w* [of them shall wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8762”} \w his clothes| strong="H899" \w*, [and be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w until the even| strong="H6153" \w*. 
\v 26 The carcases \w of every beast| strong="H929" \w* [which divideth]{strong=“H6536” x-morph=“strongMorph: \sc Th\sc*8688”} \w the hoof| strong="H6541" \w*, and is [not clovenfooted]{strong=“H8156 H8157” x-morph=“strongMorph: \sc Th\sc*8802”}, [nor cheweth]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8688”} \w the cud| strong="H1625" \w*, are \w unclean| strong="H2931" \w* [unto you: every one that toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8802”} [them shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 27 [And whatsoever]{strong=“H1992 H3605”} [goeth]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon his paws| strong="H3709" \w*, \w among all manner of beasts| strong="H2416" \w* [that go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} on all \w four| strong="H702" \w*, those are \w unclean| strong="H2931" \w* [unto you: whoso toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8802”} \w their carcase| strong="H5038" \w* [shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”} \w until the even| strong="H6153" \w*. 
\v 28 [And he that beareth]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8802”} \w the carcase| strong="H5038" \w* [of them shall wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8762”} \w his clothes| strong="H899" \w*, [and be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w until the even| strong="H6153" \w*: they are \w unclean| strong="H2931" \w* unto you. 
\p
\v 29 These also shall be \w unclean| strong="H2931" \w* \w unto you among the creeping things| strong="H8318" \w* [that creep]{strong=“H8317” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the earth| strong="H776" \w*; \w the weasel| strong="H2467" \w*, \w and the mouse| strong="H5909" \w*, \w and the tortoise| strong="H6632" \w* \w after his kind| strong="H4327" \w*, 
\v 30 \w And the ferret| strong="H604" \w*, \w and the chameleon| strong="H3581" \w*, \w and the lizard| strong="H3911" \w*, \w and the snail| strong="H2546" \w*, \w and the mole| strong="H8580" \w*. 
\v 31 These are \w unclean| strong="H2931" \w* \w to you among all that creep| strong="H8318" \w*: [whosoever doth touch]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8802”} [them, when they be dead]{strong=“H4194”}, [shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”} \w until the even| strong="H6153" \w*. 
\v 32 And upon whatsoever any [of them, when they are dead]{strong=“H4194”}, [doth fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”}, [it shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”}; whether it be \w any vessel| strong="H3627" \w* \w of wood| strong="H6086" \w*, \w or raiment| strong="H899" \w*, \w or skin| strong="H5785" \w*, \w or sack| strong="H8242" \w*, \w whatsoever vessel| strong="H3627" \w* it be, wherein any \w work| strong="H4399" \w* [is done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8735”}, [it must be put]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8714”} \w into water| strong="H4325" \w*, [and it shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w until the even| strong="H6153" \w*; [so it shall be cleansed]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 33 \w And every earthen| strong="H2789" \w* \w vessel| strong="H3627" \w*, whereinto any [of them falleth]{strong=“H8432 H5307” x-morph=“strongMorph: \sc Th\sc*8799”}, whatsoever is [in it shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”}; [and ye shall break]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\v 34 \w Of all meat| strong="H400" \w* [which may be eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8735”}, that on which such \w water| strong="H4325" \w* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”}: \w and all drink| strong="H4945" \w* [that may be drunk]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8735”} in every such \w vessel| strong="H3627" \w* [shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 35 And every thing whereupon any part \w of their carcase| strong="H5038" \w* [falleth]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} [shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”}; whether it be \w oven| strong="H8574" \w*, \w or ranges| strong="H3600" \w* [for pots, they shall be broken down]{strong=“H5422” x-morph=“strongMorph: \sc Th\sc*8714”}: for they are \w unclean| strong="H2931" \w*, \w and shall be unclean| strong="H2931" \w* unto you. 
\v 36 \w Nevertheless a fountain| strong="H4599" \w* \w or pit| strong="H953" \w*, wherein there is \w plenty| strong="H4723" \w* \w of water| strong="H4325" \w*, \w shall be clean| strong="H2889" \w*: [but that which toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8802”} \w their carcase| strong="H5038" \w* [shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 11:36 \ft wherein…: Heb. a gathering together of waters \f* 
\v 37 And if any part \w of their carcase| strong="H5038" \w* [fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon any sowing| strong="H2221" \w* \w seed| strong="H2233" \w* [which is to be sown]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8735”}, it shall be \w clean| strong="H2889" \w*. 
\v 38 But if any \w water| strong="H4325" \w* [be put]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8714”} \w upon the seed| strong="H2233" \w*, and any part \w of their carcase| strong="H5038" \w* [fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} thereon, it shall be \w unclean| strong="H2931" \w* unto you. 
\v 39 \w And if any beast| strong="H929" \w*, \w of which ye may eat| strong="H402" \w*, [die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}; [he that toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8802”} \w the carcase| strong="H5038" \w* [thereof shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”} \w until the even| strong="H6153" \w*. 
\v 40 [And he that eateth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the carcase| strong="H5038" \w* [of it shall wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8762”} \w his clothes| strong="H899" \w*, [and be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w until the even| strong="H6153" \w*: [he also that beareth]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8802”} \w the carcase| strong="H5038" \w* [of it shall wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8762”} \w his clothes| strong="H899" \w*, [and be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w until the even| strong="H6153" \w*. 
\v 41 \w And every creeping thing| strong="H8318" \w* [that creepeth]{strong=“H8317” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the earth| strong="H776" \w* shall be \w an abomination| strong="H8263" \w*; [it shall not be eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 42 [Whatsoever goeth]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the belly| strong="H1512" \w*, [and whatsoever goeth]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} upon all \w four| strong="H702" \w*, [or whatsoever hath more]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8688”} \w feet| strong="H7272" \w* \w among all creeping things| strong="H8318" \w* [that creep]{strong=“H8317” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the earth| strong="H776" \w*, [them ye shall not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}; for they are \w an abomination| strong="H8263" \w*.\f + \fr 11:42 \ft hath…: Heb. doth multiply feet \f* 
\p
\v 43 \w Ye shall not make| strong="H8262" \w* \w yourselves| strong="H5315" \w* [abominable]{strong=“H8262” x-morph=“strongMorph: \sc Th\sc*8762”} \w with any creeping thing| strong="H8318" \w* [that creepeth]{strong=“H8317” x-morph=“strongMorph: \sc Th\sc*8802”}, [neither shall ye make yourselves unclean]{strong=“H2933” x-morph=“strongMorph: \sc Th\sc*8738”} [with them, that ye should be defiled]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8691”} thereby.\f + \fr 11:43 \ft yourselves abominable: Heb. your souls, etc \f* 
\v 44 For I am the \sc Lord\sc* \w your God| strong="H430" \w*: [ye shall therefore sanctify yourselves]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8694”}, \w and ye shall be holy| strong="H6918" \w*; for I am \w holy| strong="H6918" \w*: [neither shall ye defile]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8762”} \w yourselves| strong="H5315" \w* \w with any manner of creeping thing| strong="H8318" \w* [that creepeth]{strong=“H7430” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the earth| strong="H776" \w*. 
\v 45 For I am the \sc Lord\sc* [that bringeth]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8688”} \w you up out of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, \w to be your God| strong="H430" \w*: \w ye shall therefore be holy| strong="H6918" \w*, for I am \w holy| strong="H6918" \w*. 
\v 46 This is \w the law| strong="H8451" \w* \w of the beasts| strong="H929" \w*, \w and of the fowl| strong="H5775" \w*, \w and of every living| strong="H2416" \w* \w creature| strong="H5315" \w* [that moveth]{strong=“H7430” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the waters| strong="H4325" \w*, \w and of every creature| strong="H5315" \w* [that creepeth]{strong=“H8317” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the earth| strong="H776" \w*: 
\v 47 [To make a difference]{strong=“H914” x-morph=“strongMorph: \sc Th\sc*8687”} \w between the unclean| strong="H2931" \w* \w and the clean| strong="H2889" \w*, \w and between the beast| strong="H2416" \w* [that may be eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8737”} \w and the beast| strong="H2416" \w* [that may not be eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8735”}.
\c 12
\p 
\v 1 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w If a woman| strong="H802" \w* [have conceived seed]{strong=“H2232” x-morph=“strongMorph: \sc Th\sc*8686”}, [and born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} \w a man child| strong="H2145" \w*: [then she shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w seven| strong="H7651" \w* \w days| strong="H3117" \w*; \w according to the days| strong="H3117" \w* \w of the separation| strong="H5079" \w* [for her infirmity]{strong=“H1738” x-morph=“strongMorph: \sc Th\sc*8800”} [shall she be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 3 \w And in the eighth| strong="H8066" \w* \w day| strong="H3117" \w* \w the flesh| strong="H1320" \w* \w of his foreskin| strong="H6190" \w* [shall be circumcised]{strong=“H4135” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 4 [And she shall then continue]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the blood| strong="H1818" \w* \w of her purifying| strong="H2893" \w* \w three| strong="H7969" \w* \w and thirty| strong="H7970" \w* \w days| strong="H3117" \w*; [she shall touch]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8799”} \w no hallowed| strong="H6944" \w* [thing, nor come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the sanctuary| strong="H4720" \w*, [until the days]{strong=“H3117 H3117”} \w of her purifying| strong="H2892" \w* [be fulfilled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 5 [But if she bear]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8799”} \w a maid child| strong="H5347" \w*, [then she shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w two weeks| strong="H7620" \w*, \w as in her separation| strong="H5079" \w*: [and she shall continue]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the blood| strong="H1818" \w* \w of her purifying| strong="H2893" \w* \w threescore| strong="H8346" \w* \w and six| strong="H8337" \w* \w days| strong="H3117" \w*. 
\p
\v 6 \w And when the days| strong="H3117" \w* \w of her purifying| strong="H2892" \w* [are fulfilled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8800”}, \w for a son| strong="H1121" \w*, \w or for a daughter| strong="H1323" \w*, [she shall bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w a lamb| strong="H3532" \w* \w of the first| strong="H1121" \w* \w year| strong="H8141" \w* \w for a burnt offering| strong="H5930" \w*, \w and a young| strong="H1121" \w* \w pigeon| strong="H3123" \w*, \w or a turtledove| strong="H8449" \w*, \w for a sin offering| strong="H2403" \w*, \w unto the door| strong="H6607" \w* \w of the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*, \w unto the priest| strong="H3548" \w*:\f + \fr 12:6 \ft of the first…: Heb. a son of his year \f* 
\v 7 [Who shall offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8689”} \w it before| strong="H6440" \w* the \sc Lord\sc*, [and make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8765”} [for her; and she shall be cleansed]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8804”} \w from the issue| strong="H4726" \w* \w of her blood| strong="H1818" \w*. This is \w the law| strong="H8451" \w* [for her that hath born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”} \w a male| strong="H2145" \w* \w or a female| strong="H5347" \w*. 
\v 8 [And if she be not able to bring]{strong=“H3027 H1767 H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w a lamb| strong="H7716" \w*, [then she shall bring]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w two| strong="H8147" \w* \w turtles| strong="H8449" \w*, \w or two young| strong="H1121" \w* \w pigeons| strong="H3123" \w*; \w the one| strong="H259" \w* \w for the burnt offering| strong="H5930" \w*, \w and the other| strong="H259" \w* \w for a sin offering| strong="H2403" \w*: \w and the priest| strong="H3548" \w* [shall make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8765”} [for her, and she shall be clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 12:8 \ft she be…: Heb. her hand find not sufficiency of \f*
\c 13
\p 
\v 1 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w* \w and Aaron| strong="H175" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 \w When a man| strong="H120" \w* \w shall have in the skin| strong="H5785" \w* \w of his flesh| strong="H1320" \w* \w a rising| strong="H7613" \w*, \w a scab| strong="H5597" \w*, \w or bright spot| strong="H934" \w*, \w and it be in the skin| strong="H5785" \w* \w of his flesh| strong="H1320" \w* like \w the plague| strong="H5061" \w* \w of leprosy| strong="H6883" \w*; [then he shall be brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8717”} \w unto Aaron| strong="H175" \w* \w the priest| strong="H3548" \w*, \w or unto one| strong="H259" \w* \w of his sons| strong="H1121" \w* \w the priests| strong="H3548" \w*:\f + \fr 13:2 \ft rising: or, swelling \f* 
\v 3 \w And the priest| strong="H3548" \w* [shall look]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w on the plague| strong="H5061" \w* \w in the skin| strong="H5785" \w* \w of the flesh| strong="H1320" \w*: and when \w the hair| strong="H8181" \w* \w in the plague| strong="H5061" \w* [is turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8804”} \w white| strong="H3836" \w*, \w and the plague| strong="H5061" \w* \w in sight| strong="H4758" \w* be \w deeper| strong="H6013" \w* \w than the skin| strong="H5785" \w* \w of his flesh| strong="H1320" \w*, it is \w a plague| strong="H5061" \w* \w of leprosy| strong="H6883" \w*: \w and the priest| strong="H3548" \w* [shall look]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} [on him, and pronounce him unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8765”}. 
