\v 34 \w Then shall the land| strong="H776" \w* [enjoy]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8799”} \w her sabbaths| strong="H7676" \w*, \w as long| strong="H3117" \w* [as it lieth desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8715”}, and ye be [in your enemies’]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w land| strong="H776" \w*; even \w then shall the land| strong="H776" \w* [rest]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8799”}, [and enjoy]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8689”} \w her sabbaths| strong="H7676" \w*. 
\v 35 \w As long as| strong="H3117" \w* [it lieth desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8715”} [it shall rest]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8799”}; [because it did not rest]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8804”} \w in your sabbaths| strong="H7676" \w*, [when ye dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} upon it. 
\v 36 [And upon them that are left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”} alive [of you I will send]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w a faintness| strong="H4816" \w* \w into their hearts| strong="H3824" \w* \w in the lands| strong="H776" \w* [of their enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}; \w and the sound| strong="H6963" \w* [of a shaken]{strong=“H5086” x-morph=“strongMorph: \sc Th\sc*8737”} \w leaf| strong="H5929" \w* [shall chase]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8804”} [them; and they shall flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8804”}, \w as fleeing| strong="H4499" \w* \w from a sword| strong="H2719" \w*; [and they shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8804”} [when none pursueth]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 26:36 \ft shaken: Heb. driven \f* 
\v 37 [And they shall fall]{strong=“H3782” x-morph=“strongMorph: \sc Th\sc*8804”} \w one| strong="H376" \w* \w upon another| strong="H251" \w*, \w as it were before| strong="H6440" \w* \w a sword| strong="H2719" \w*, [when none pursueth]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8802”}: \w and ye shall have no power to stand| strong="H8617" \w* \w before| strong="H6440" \w* [your enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 38 [And ye shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”} \w among the heathen| strong="H1471" \w*, \w and the land| strong="H776" \w* [of your enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} [shall eat you up]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 39 [And they that are left]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8737”} [of you shall pine away]{strong=“H4743” x-morph=“strongMorph: \sc Th\sc*8735”} \w in their iniquity| strong="H5771" \w* [in your enemies’]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w lands| strong="H776" \w*; \w and also in the iniquities| strong="H5771" \w* \w of their fathers| strong="H1" \w* [shall they pine away]{strong=“H4743” x-morph=“strongMorph: \sc Th\sc*8735”} with them. 
\p
\v 40 [If they shall confess]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8694”} \w their iniquity| strong="H5771" \w*, \w and the iniquity| strong="H5771" \w* \w of their fathers| strong="H1" \w*, \w with their trespass| strong="H4604" \w* [which they trespassed]{strong=“H4603” x-morph=“strongMorph: \sc Th\sc*8804”} [against me, and that also they have walked]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w contrary| strong="H7147" \w* unto me; 
\v 41 And that [I also have walked]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w contrary| strong="H7147" \w* [unto them, and have brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w them into the land| strong="H776" \w* [of their enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}; \w if then| strong="H176" \w* \w their uncircumcised| strong="H6189" \w* \w hearts| strong="H3824" \w* [be humbled]{strong=“H3665” x-morph=“strongMorph: \sc Th\sc*8735”}, [and they then accept]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the punishment of their iniquity| strong="H5771" \w*: 
\v 42 [Then will I remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w my covenant| strong="H1285" \w* \w with Jacob| strong="H3290" \w*, \w and also my covenant| strong="H1285" \w* \w with Isaac| strong="H3327" \w*, \w and also my covenant| strong="H1285" \w* \w with Abraham| strong="H85" \w* [will I remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”}; [and I will remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} \w the land| strong="H776" \w*. 
\v 43 \w The land| strong="H776" \w* [also shall be left]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8735”} [of them, and shall enjoy]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8799”} \w her sabbaths| strong="H7676" \w*, [while she lieth desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8715”} [without them: and they shall accept]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the punishment of their iniquity| strong="H5771" \w*: \w because| strong="H3282" \w*, \w even because| strong="H3282" \w* [they despised]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} \w my judgments| strong="H4941" \w*, \w and because their soul| strong="H5315" \w* [abhorred]{strong=“H1602” x-morph=“strongMorph: \sc Th\sc*8804”} \w my statutes| strong="H2708" \w*. 
\v 44 \w And yet| strong="H637" \w* \w for all that| strong="H2063" \w*, \w when they be| strong="H1571" \w* \w in the land| strong="H776" \w* [of their enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, [I will not cast them away]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”}, [neither will I abhor]{strong=“H1602” x-morph=“strongMorph: \sc Th\sc*8804”} [them, to destroy them utterly]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8763”}, [and to break]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8687”} \w my covenant| strong="H1285" \w* with them: for I am the \sc Lord\sc* \w their God| strong="H430" \w*. 
\v 45 [But I will for their sakes remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} \w the covenant| strong="H1285" \w* \w of their ancestors| strong="H7223" \w*, [whom I brought forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w out of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w* \w in the sight| strong="H5869" \w* \w of the heathen| strong="H1471" \w*, \w that I might be their God| strong="H430" \w*: I am the \sc Lord\sc*. 
\v 46 These are \w the statutes| strong="H2706" \w* \w and judgments| strong="H4941" \w* \w and laws| strong="H8451" \w*, which the \sc Lord\sc* [made]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w between him and the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* \w in mount| strong="H2022" \w* \w Sinai| strong="H5514" \w* \w by the hand| strong="H3027" \w* \w of Moses| strong="H4872" \w*. 
\c 27
\p 
\v 1 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, When a man]{strong=“H376”} [shall make a singular]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8686”} \w vow| strong="H5088" \w*, \w the persons| strong="H5315" \w* shall be for the \sc Lord\sc* \w by thy estimation| strong="H6187" \w*. 
\v 3 \w And thy estimation| strong="H6187" \w* \w shall be of the male| strong="H2145" \w* \w from twenty| strong="H6242" \w* \w years| strong="H8141" \w* \w old| strong="H1121" \w* \w even unto sixty| strong="H8346" \w* \w years| strong="H8141" \w* \w old| strong="H1121" \w*, \w even thy estimation| strong="H6187" \w* \w shall be fifty| strong="H2572" \w* \w shekels| strong="H8255" \w* \w of silver| strong="H3701" \w*, \w after the shekel| strong="H8255" \w* \w of the sanctuary| strong="H6944" \w*. 
\v 4 And if it be \w a female| strong="H5347" \w*, \w then thy estimation| strong="H6187" \w* \w shall be thirty| strong="H7970" \w* \w shekels| strong="H8255" \w*. 
\v 5 And if it be \w from five| strong="H2568" \w* \w years| strong="H8141" \w* \w old| strong="H1121" \w* \w even unto twenty| strong="H6242" \w* \w years| strong="H8141" \w* \w old| strong="H1121" \w*, \w then thy estimation| strong="H6187" \w* \w shall be of the male| strong="H2145" \w* \w twenty| strong="H6242" \w* \w shekels| strong="H8255" \w*, \w and for the female| strong="H5347" \w* \w ten| strong="H6235" \w* \w shekels| strong="H8255" \w*. 
\v 6 And if it be \w from a month| strong="H2320" \w* \w old| strong="H1121" \w* \w even unto five| strong="H2568" \w* \w years| strong="H8141" \w* \w old| strong="H1121" \w*, \w then thy estimation| strong="H6187" \w* \w shall be of the male| strong="H2145" \w* \w five| strong="H2568" \w* \w shekels| strong="H8255" \w* \w of silver| strong="H3701" \w*, \w and for the female| strong="H5347" \w* \w thy estimation| strong="H6187" \w* shall be \w three| strong="H7969" \w* \w shekels| strong="H8255" \w* \w of silver| strong="H3701" \w*. 
\v 7 And if it be \w from sixty| strong="H8346" \w* \w years| strong="H8141" \w* \w old| strong="H1121" \w* \w and above| strong="H4605" \w*; if it be \w a male| strong="H2145" \w*, \w then thy estimation| strong="H6187" \w* [shall be fifteen]{strong=“H6240 H2568”} \w shekels| strong="H8255" \w*, \w and for the female| strong="H5347" \w* \w ten| strong="H6235" \w* \w shekels| strong="H8255" \w*. 
\v 8 [But if he be poorer]{strong=“H4134” x-morph=“strongMorph: \sc Th\sc*8802”} \w than thy estimation| strong="H6187" \w*, [then he shall present]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8689”} \w himself before| strong="H6440" \w* \w the priest| strong="H3548" \w*, \w and the priest| strong="H3548" \w* [shall value]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8689”} [him; according to]{strong=“H6310”} [his ability]{strong=“H5381 H3027” x-morph=“strongMorph: \sc Th\sc*8686”} [that vowed]{strong=“H5087” x-morph=“strongMorph: \sc Th\sc*8802”} \w shall the priest| strong="H3548" \w* [value]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8686”} him. 
\v 9 And if it be \w a beast| strong="H929" \w*, [whereof men bring]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”} \w an offering| strong="H7133" \w* unto the \sc Lord\sc*, all that any man [giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} of such unto the \sc Lord\sc* \w shall be holy| strong="H6944" \w*. 
\v 10 [He shall not alter]{strong=“H2498” x-morph=“strongMorph: \sc Th\sc*8686”} [it, nor change]{strong=“H4171” x-morph=“strongMorph: \sc Th\sc*8686”} [it, a good]{strong=“H2896”} \w for a bad| strong="H7451" \w*, \w or a bad| strong="H7451" \w* \w for a good| strong="H2896" \w*: [and if he shall at all]{strong=“H4171” x-morph=“strongMorph: \sc Th\sc*8687”} [change]{strong=“H4171” x-morph=“strongMorph: \sc Th\sc*8686”} \w beast| strong="H929" \w* \w for beast| strong="H929" \w*, \w then it and the exchange| strong="H8545" \w* \w thereof shall be holy| strong="H6944" \w*. 
\v 11 And if it be \w any unclean| strong="H2931" \w* \w beast| strong="H929" \w*, [of which they do not offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”} \w a sacrifice| strong="H7133" \w* unto the \sc Lord\sc*, [then he shall present]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8689”} \w the beast| strong="H929" \w* \w before| strong="H6440" \w* \w the priest| strong="H3548" \w*: 
\v 12 \w And the priest| strong="H3548" \w* [shall value]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8689”} [it, whether]{strong=“H996”} \w it be good| strong="H2896" \w* \w or| strong="H996" \w* \w bad| strong="H7451" \w*: \w as thou valuest| strong="H6187" \w* it, who art \w the priest| strong="H3548" \w*, so shall it be.\f + \fr 27:12 \ft as…: Heb. according to thy estimation, O priest, etc \f* 
\v 13 [But if he will at all]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8800”} [redeem]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8799”} [it, then he shall add]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8804”} \w a fifth| strong="H2549" \w* part \w thereof unto thy estimation| strong="H6187" \w*. 
\p
\v 14 \w And when a man| strong="H376" \w* [shall sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8686”} \w his house| strong="H1004" \w* to be \w holy| strong="H6944" \w* unto the \sc Lord\sc*, \w then the priest| strong="H3548" \w* [shall estimate]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8689”} [it, whether it be good]{strong=“H2896”} \w or bad| strong="H7451" \w*: \w as the priest| strong="H3548" \w* [shall estimate]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8686”} [it, so shall it stand]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 15 [And if he that sanctified]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8688”} [it will redeem]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8799”} \w his house| strong="H1004" \w*, [then he shall add]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8804”} \w the fifth| strong="H2549" \w* part \w of the money| strong="H3701" \w* \w of thy estimation| strong="H6187" \w* unto it, and it shall be his. 
\v 16 \w And if a man| strong="H376" \w* [shall sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8686”} unto the \sc Lord\sc* some part \w of a field| strong="H7704" \w* \w of his possession| strong="H272" \w*, \w then thy estimation| strong="H6187" \w* \w shall be according| strong="H6310" \w* \w to the seed| strong="H2233" \w* [thereof: an homer]{strong=“H2563”} \w of barley| strong="H8184" \w* \w seed| strong="H2233" \w* shall be valued \w at fifty| strong="H2572" \w* \w shekels| strong="H8255" \w* \w of silver| strong="H3701" \w*.\f + \fr 27:16 \ft an…: or, the land of an homer, etc \f* 
\v 17 [If he sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8686”} \w his field| strong="H7704" \w* \w from the year| strong="H8141" \w* \w of jubile| strong="H3104" \w*, \w according to thy estimation| strong="H6187" \w* [it shall stand]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 18 [But if he sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8686”} \w his field| strong="H7704" \w* \w after| strong="H310" \w* \w the jubile| strong="H3104" \w*, \w then the priest| strong="H3548" \w* [shall reckon]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto him the money| strong="H3701" \w* \w according to| strong="H6310" \w* \w the years| strong="H8141" \w* [that remain]{strong=“H3498” x-morph=“strongMorph: \sc Th\sc*8737”}, \w even unto the year| strong="H8141" \w* \w of the jubile| strong="H3104" \w*, [and it shall be abated]{strong=“H1639” x-morph=“strongMorph: \sc Th\sc*8738”} \w from thy estimation| strong="H6187" \w*. 
\v 19 [And if he that sanctified]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8688”} \w the field| strong="H7704" \w* [will in any wise]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8800”} [redeem]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8799”} [it, then he shall add]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8804”} \w the fifth| strong="H2549" \w* part \w of the money| strong="H3701" \w* \w of thy estimation| strong="H6187" \w* [unto it, and it shall be assured]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”} to him. 
\v 20 [And if he will not redeem]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8799”} \w the field| strong="H7704" \w*, [or if he have sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8804”} \w the field| strong="H7704" \w* \w to another| strong="H312" \w* \w man| strong="H376" \w*, [it shall not be redeemed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8735”} any more. 
\v 21 \w But the field| strong="H7704" \w*, [when it goeth out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the jubile| strong="H3104" \w*, \w shall be holy| strong="H6944" \w* unto the \sc Lord\sc*, \w as a field| strong="H7704" \w* \w devoted| strong="H2764" \w*; \w the possession| strong="H272" \w* [thereof shall be the priest’s]{strong=“H3548”}. 
\v 22 And if a man [sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8686”} unto the \sc Lord\sc* \w a field| strong="H7704" \w* \w which he hath bought| strong="H4736" \w*, which is \w not of the fields| strong="H7704" \w* \w of his possession| strong="H272" \w*; 
\v 23 \w Then the priest| strong="H3548" \w* [shall reckon]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto him the worth| strong="H4373" \w* \w of thy estimation| strong="H6187" \w*, even \w unto the year| strong="H8141" \w* \w of the jubile| strong="H3104" \w*: [and he shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thine estimation| strong="H6187" \w* \w in that day| strong="H3117" \w*, as \w a holy thing| strong="H6944" \w* unto the \sc Lord\sc*. 
\v 24 \w In the year| strong="H8141" \w* \w of the jubile| strong="H3104" \w* \w the field| strong="H7704" \w* [shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him of whom it was bought]{strong=“H7069” x-morph=“strongMorph: \sc Th\sc*8804”}, even \w to him to whom the possession| strong="H272" \w* \w of the land| strong="H776" \w* did belong. 
\v 25 \w And all thy estimations| strong="H6187" \w* \w shall be according to the shekel| strong="H8255" \w* \w of the sanctuary| strong="H6944" \w*: \w twenty| strong="H6242" \w* \w gerahs| strong="H1626" \w* \w shall be the shekel| strong="H8255" \w*. 
\p
\v 26 \w Only the firstling| strong="H1060" \w* \w of the beasts| strong="H929" \w*, which should be the \sc Lord\sc*’S [firstling]{strong=“H1069” x-morph=“strongMorph: \sc Th\sc*8792”}, \w no man| strong="H376" \w* [shall sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8686”} it; whether it be \w ox| strong="H7794" \w*, \w or sheep| strong="H7716" \w*: it is the \sc Lord\sc*’S.\f + \fr 27:26 \ft firstling of: Heb. firstborn, etc \f* 
\v 27 And if it be \w of an unclean| strong="H2931" \w* \w beast| strong="H929" \w*, [then he shall redeem]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8804”} it \w according to thine estimation| strong="H6187" \w*, [and shall add]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8804”} \w a fifth| strong="H2549" \w* part [of it thereto: or if it be not redeemed]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8735”}, [then it shall be sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8738”} \w according to thy estimation| strong="H6187" \w*. 
