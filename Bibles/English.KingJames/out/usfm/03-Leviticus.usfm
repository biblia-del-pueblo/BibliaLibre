\p
\v 11 \w No meat offering| strong="H4503" \w*, [which ye shall bring]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”} unto the \sc Lord\sc*, [shall be made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8735”} \w with leaven| strong="H2557" \w*: [for ye shall burn]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8686”} \w no leaven| strong="H7603" \w*, \w nor any honey| strong="H1706" \w*, \w in any offering| strong="H801" \w* of the \sc Lord\sc* \w made by fire| strong="H801" \w*. 
