\v 51 [And he shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w the cedar| strong="H730" \w* \w wood| strong="H6086" \w*, \w and the hyssop| strong="H231" \w*, [and the scarlet]{strong=“H8438 H8144”}, \w and the living| strong="H2416" \w* \w bird| strong="H6833" \w*, [and dip]{strong=“H2881” x-morph=“strongMorph: \sc Th\sc*8804”} \w them in the blood| strong="H1818" \w* [of the slain]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8803”} \w bird| strong="H6833" \w*, \w and in the running| strong="H2416" \w* \w water| strong="H4325" \w*, [and sprinkle]{strong=“H5137” x-morph=“strongMorph: \sc Th\sc*8689”} \w the house| strong="H1004" \w* \w seven| strong="H7651" \w* \w times| strong="H6471" \w*: 
\v 52 [And he shall cleanse]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8765”} \w the house| strong="H1004" \w* \w with the blood| strong="H1818" \w* \w of the bird| strong="H6833" \w*, \w and with the running| strong="H2416" \w* \w water| strong="H4325" \w*, \w and with the living| strong="H2416" \w* \w bird| strong="H6833" \w*, \w and with the cedar| strong="H730" \w* \w wood| strong="H6086" \w*, \w and with the hyssop| strong="H231" \w*, [and with the scarlet]{strong=“H8438 H8144”}: 
\v 53 [But he shall let go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w the living| strong="H2416" \w* \w bird| strong="H6833" \w* \w out| strong="H2351" \w* \w of the city| strong="H5892" \w* \w into the open| strong="H6440" \w* \w fields| strong="H7704" \w*, [and make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8765”} \w for the house| strong="H1004" \w*: [and it shall be clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\p
\v 54 This is \w the law| strong="H8451" \w* \w for all manner of plague| strong="H5061" \w* \w of leprosy| strong="H6883" \w*, \w and scall| strong="H5424" \w*, 
\v 55 \w And for the leprosy| strong="H6883" \w* \w of a garment| strong="H899" \w*, \w and of a house| strong="H1004" \w*, 
\v 56 \w And for a rising| strong="H7613" \w*, \w and for a scab| strong="H5597" \w*, \w and for a bright spot| strong="H934" \w*: 
\v 57 [To teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8687”} \w when| strong="H3117" \w* it is \w unclean| strong="H2931" \w*, \w and when| strong="H3117" \w* it is \w clean| strong="H2889" \w*: this is \w the law| strong="H8451" \w* \w of leprosy| strong="H6883" \w*.\f + \fr 14:57 \ft when it is unclean…: Heb. in the day of the unclean, and in the day of the clean \f*
\c 15
\p 
\v 1 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w* \w and to Aaron| strong="H175" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, When any]{strong=“H376”} \w man| strong="H376" \w* [hath a running issue]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”} \w out of his flesh| strong="H1320" \w*, because of \w his issue| strong="H2101" \w* he is \w unclean| strong="H2931" \w*.\f + \fr 15:2 \ft running…: or, running of the reins \f* 
\v 3 \w And this shall be his uncleanness| strong="H2932" \w* \w in his issue| strong="H2101" \w*: \w whether his flesh| strong="H1320" \w* [run]{strong=“H7325” x-morph=“strongMorph: \sc Th\sc*8804”} \w with his issue| strong="H2101" \w*, \w or his flesh| strong="H1320" \w* [be stopped]{strong=“H2856” x-morph=“strongMorph: \sc Th\sc*8689”} \w from his issue| strong="H2101" \w*, it is \w his uncleanness| strong="H2932" \w*. 
\v 4 \w Every bed| strong="H4904" \w*, [whereon he lieth]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} [that hath the issue]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”}, [is unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”}: \w and every thing| strong="H3627" \w*, [whereon he sitteth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”}, [shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 15:4 \ft thing: Heb. vessel \f* 
\v 5 \w And whosoever| strong="H376" \w* [toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8799”} \w his bed| strong="H4904" \w* [shall wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8762”} \w his clothes| strong="H899" \w*, [and bathe]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} himself \w in water| strong="H4325" \w*, [and be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w until the even| strong="H6153" \w*. 
\v 6 [And he that sitteth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} on any \w thing| strong="H3627" \w* [whereon he sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} [that hath the issue]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”} [shall wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8762”} \w his clothes| strong="H899" \w*, [and bathe]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} himself \w in water| strong="H4325" \w*, [and be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w until the even| strong="H6153" \w*. 
\v 7 [And he that toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8802”} \w the flesh| strong="H1320" \w* [of him that hath the issue]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”} [shall wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8762”} \w his clothes| strong="H899" \w*, [and bathe]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} himself \w in water| strong="H4325" \w*, [and be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w until the even| strong="H6153" \w*. 
\v 8 [And if he that hath the issue]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”} [spit]{strong=“H7556” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon him that is clean| strong="H2889" \w*; [then he shall wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8765”} \w his clothes| strong="H899" \w*, [and bathe]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} himself \w in water| strong="H4325" \w*, [and be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w until the even| strong="H6153" \w*. 
\v 9 \w And what saddle| strong="H4817" \w* [soever he rideth]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8799”} [upon that hath the issue]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”} [shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 10 [And whosoever toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8802”} [any thing that was under him shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”} \w until the even| strong="H6153" \w*: [and he that beareth]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8802”} any of [those things shall wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8762”} \w his clothes| strong="H899" \w*, [and bathe]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} himself \w in water| strong="H4325" \w*, [and be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w until the even| strong="H6153" \w*. 
\v 11 [And whomsoever he toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8799”} [that hath the issue]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”}, [and hath not rinsed]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8804”} \w his hands| strong="H3027" \w* \w in water| strong="H4325" \w*, [he shall wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8765”} \w his clothes| strong="H899" \w*, [and bathe]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} himself \w in water| strong="H4325" \w*, [and be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w until the even| strong="H6153" \w*. 
\v 12 \w And the vessel| strong="H3627" \w* \w of earth| strong="H2789" \w*, [that he toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8799”} [which hath the issue]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”}, [shall be broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8735”}: \w and every vessel| strong="H3627" \w* \w of wood| strong="H6086" \w* [shall be rinsed]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8735”} \w in water| strong="H4325" \w*. 
\v 13 [And when he that hath an issue]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”} [is cleansed]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8799”} \w of his issue| strong="H2101" \w*; [then he shall number]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8804”} \w to himself seven| strong="H7651" \w* \w days| strong="H3117" \w* \w for his cleansing| strong="H2893" \w*, [and wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8765”} \w his clothes| strong="H899" \w*, [and bathe]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} \w his flesh| strong="H1320" \w* \w in running| strong="H2416" \w* \w water| strong="H4325" \w*, [and shall be clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 14 \w And on the eighth| strong="H8066" \w* \w day| strong="H3117" \w* [he shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w to him two| strong="H8147" \w* \w turtledoves| strong="H8449" \w*, \w or two| strong="H8147" \w* \w young| strong="H1121" \w* \w pigeons| strong="H3123" \w*, [and come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w before| strong="H6440" \w* the \sc Lord\sc* \w unto the door| strong="H6607" \w* \w of the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*, [and give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w them unto the priest| strong="H3548" \w*: 
\v 15 \w And the priest| strong="H3548" \w* [shall offer]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [them, the one]{strong=“H259”} for \w a sin offering| strong="H2403" \w*, \w and the other| strong="H259" \w* for \w a burnt offering| strong="H5930" \w*; \w and the priest| strong="H3548" \w* [shall make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8765”} \w for him before| strong="H6440" \w* the \sc Lord\sc* \w for his issue| strong="H2101" \w*. 
\v 16 [And if any man’s]{strong=“H376”} \w seed| strong="H2233" \w* \w of copulation| strong="H7902" \w* [go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} [from him, then he shall wash]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} \w all his flesh| strong="H1320" \w* \w in water| strong="H4325" \w*, [and be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w until the even| strong="H6153" \w*. 
\v 17 \w And every garment| strong="H899" \w*, \w and every skin| strong="H5785" \w*, \w whereon is the seed| strong="H2233" \w* \w of copulation| strong="H7902" \w*, [shall be washed]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8795”} \w with water| strong="H4325" \w*, [and be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w until the even| strong="H6153" \w*. 
\v 18 \w The woman| strong="H802" \w* \w also with whom man| strong="H376" \w* [shall lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} with \w seed| strong="H2233" \w* \w of copulation| strong="H7902" \w*, they shall both [bathe]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} themselves \w in water| strong="H4325" \w*, [and be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w until the even| strong="H6153" \w*. 
\p
\v 19 \w And if a woman| strong="H802" \w* [have an issue]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8802”}, and \w her issue| strong="H2101" \w* \w in her flesh| strong="H1320" \w* \w be blood| strong="H1818" \w*, \w she shall be put apart| strong="H5079" \w* \w seven| strong="H7651" \w* \w days| strong="H3117" \w*: [and whosoever toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8802”} [her shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”} \w until the even| strong="H6153" \w*.\f + \fr 15:19 \ft put…: Heb. in her separation \f* 
\v 20 [And every thing that she lieth]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon in her separation| strong="H5079" \w* [shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”}: [every thing also that she sitteth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} [upon shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 21 [And whosoever toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8802”} \w her bed| strong="H4904" \w* [shall wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8762”} \w his clothes| strong="H899" \w*, [and bathe]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} himself \w in water| strong="H4325" \w*, [and be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w until the even| strong="H6153" \w*. 
\v 22 [And whosoever toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8802”} \w any thing| strong="H3627" \w* [that she sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} [upon shall wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8762”} \w his clothes| strong="H899" \w*, [and bathe]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} himself \w in water| strong="H4325" \w*, [and be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w until the even| strong="H6153" \w*. 
\v 23 And if it be on her \w bed| strong="H4904" \w*, \w or on any thing| strong="H3627" \w* [whereon she sitteth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”}, [when he toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8800”} [it, he shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”} \w until the even| strong="H6153" \w*. 
\v 24 \w And if any man| strong="H376" \w* [lie]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} [with her at all]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8800”}, \w and her flowers| strong="H5079" \w* [be upon him, he shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w seven| strong="H7651" \w* \w days| strong="H3117" \w*; \w and all the bed| strong="H4904" \w* [whereon he lieth]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} [shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 25 \w And if a woman| strong="H802" \w* [have]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8799”} \w an issue| strong="H2101" \w* \w of her blood| strong="H1818" \w* \w many| strong="H7227" \w* \w days| strong="H3117" \w* \w out| strong="H3808" \w* \w of the time| strong="H6256" \w* \w of her separation| strong="H5079" \w*, [or if it run]{strong=“H2100” x-morph=“strongMorph: \sc Th\sc*8799”} \w beyond the time| strong="H5921" \w* \w of her separation| strong="H5079" \w*; \w all the days| strong="H3117" \w* \w of the issue| strong="H2101" \w* \w of her uncleanness| strong="H2932" \w* \w shall be as the days| strong="H3117" \w* \w of her separation| strong="H5079" \w*: she shall be \w unclean| strong="H2931" \w*. 
\v 26 \w Every bed| strong="H4904" \w* [whereon she lieth]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w all the days| strong="H3117" \w* \w of her issue| strong="H2101" \w* \w shall be unto her as the bed| strong="H4904" \w* \w of her separation| strong="H5079" \w*: \w and whatsoever| strong="H3627" \w* [she sitteth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon shall be unclean| strong="H2931" \w*, \w as the uncleanness| strong="H2932" \w* \w of her separation| strong="H5079" \w*. 
\v 27 [And whosoever toucheth]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8802”} [those things shall be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8799”}, [and shall wash]{strong=“H3526” x-morph=“strongMorph: \sc Th\sc*8765”} \w his clothes| strong="H899" \w*, [and bathe]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8804”} himself \w in water| strong="H4325" \w*, [and be unclean]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8804”} \w until the even| strong="H6153" \w*. 
\v 28 [But if she be cleansed]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8804”} \w of her issue| strong="H2101" \w*, [then she shall number]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8804”} \w to herself seven| strong="H7651" \w* \w days| strong="H3117" \w*, \w and after| strong="H310" \w* [that she shall be clean]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 29 \w And on the eighth| strong="H8066" \w* \w day| strong="H3117" \w* [she shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto her two| strong="H8147" \w* \w turtles| strong="H8449" \w*, \w or two| strong="H8147" \w* \w young| strong="H1121" \w* \w pigeons| strong="H3123" \w*, [and bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w them unto the priest| strong="H3548" \w*, \w to the door| strong="H6607" \w* \w of the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*. 
\v 30 \w And the priest| strong="H3548" \w* [shall offer]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w the one| strong="H259" \w* for \w a sin offering| strong="H2403" \w*, \w and the other| strong="H259" \w* for \w a burnt offering| strong="H5930" \w*; \w and the priest| strong="H3548" \w* [shall make an atonement]{strong=“H3722” x-morph=“strongMorph: \sc Th\sc*8765”} \w for her before| strong="H6440" \w* the \sc Lord\sc* \w for the issue| strong="H2101" \w* \w of her uncleanness| strong="H2932" \w*. 
\v 31 [Thus shall ye separate]{strong=“H5144” x-morph=“strongMorph: \sc Th\sc*8689”} \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* \w from their uncleanness| strong="H2932" \w*; [that they die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w not in their uncleanness| strong="H2932" \w*, [when they defile]{strong=“H2930” x-morph=“strongMorph: \sc Th\sc*8763”} \w my tabernacle| strong="H4908" \w* that is \w among| strong="H8432" \w* them. 
