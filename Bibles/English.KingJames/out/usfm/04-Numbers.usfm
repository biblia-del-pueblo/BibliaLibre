\c 20
\p 
\v 1 [Then came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, even \w the whole congregation| strong="H5712" \w*, \w into the desert| strong="H4057" \w* \w of Zin| strong="H6790" \w* \w in the first| strong="H7223" \w* \w month| strong="H2320" \w*: \w and the people| strong="H5971" \w* [abode]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in Kadesh| strong="H6946" \w*; \w and Miriam| strong="H4813" \w* [died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} [there, and was buried]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8735”} there. 
\v 2 \w And there was no water| strong="H4325" \w* \w for the congregation| strong="H5712" \w*: [and they gathered]{strong=“H6950” x-morph=“strongMorph: \sc Th\sc*8735”} \w themselves together against Moses| strong="H4872" \w* \w and against Aaron| strong="H175" \w*. 
