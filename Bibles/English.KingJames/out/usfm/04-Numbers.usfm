\p 
\v 1 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8761”} \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, When ye come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8802”} \w into the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*; (this is \w the land| strong="H776" \w* [that shall fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto you for an inheritance| strong="H5159" \w*, even \w the land| strong="H776" \w* \w of Canaan| strong="H3667" \w* \w with the coasts| strong="H1367" \w* thereof:) 
\v 3 \w Then your south| strong="H5045" \w* \w quarter| strong="H6285" \w* \w shall be from the wilderness| strong="H4057" \w* \w of Zin| strong="H6790" \w* \w along by the coast| strong="H3027" \w* \w of Edom| strong="H123" \w*, \w and your south| strong="H5045" \w* \w border| strong="H1366" \w* \w shall be the outmost coast| strong="H7097" \w* \w of the salt| strong="H4417" \w* \w sea| strong="H3220" \w* \w eastward| strong="H6924" \w*: 
\v 4 \w And your border| strong="H1366" \w* [shall turn]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8738”} \w from the south| strong="H5045" \w* \w to the ascent| strong="H4608" \w* \w of Akrabbim| strong="H4610" \w*, [and pass on]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w to Zin| strong="H6790" \w*: \w and the going forth| strong="H8444" \w* \w thereof shall be from the south| strong="H5045" \w* [to Kadesh-barnea]{strong=“H6947”}, [and shall go on]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} [to Hazar-addar]{strong=“H2692”}, [and pass on]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w to Azmon| strong="H6111" \w*: 
\v 5 \w And the border| strong="H1366" \w* [shall fetch a compass]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8738”} \w from Azmon| strong="H6111" \w* \w unto the river| strong="H5158" \w* \w of Egypt| strong="H4714" \w*, \w and the goings out| strong="H8444" \w* \w of it shall be at the sea| strong="H3220" \w*. 
\v 6 And as for \w the western| strong="H3220" \w* \w border| strong="H1366" \w*, \w ye shall even have the great| strong="H1419" \w* \w sea| strong="H3220" \w* \w for a border| strong="H1366" \w*: \w this shall be your west| strong="H3220" \w* \w border| strong="H1366" \w*. 
\v 7 \w And this shall be your north| strong="H6828" \w* \w border| strong="H1366" \w*: \w from the great| strong="H1419" \w* \w sea| strong="H3220" \w* [ye shall point out]{strong=“H8376” x-morph=“strongMorph: \sc Th\sc*8762”} \w for you mount| strong="H2022" \w* \w Hor| strong="H2023" \w*: 
\v 8 \w From mount| strong="H2022" \w* \w Hor| strong="H2023" \w* [ye shall point out]{strong=“H8376” x-morph=“strongMorph: \sc Th\sc*8762”} your border [unto the entrance]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w of Hamath| strong="H2574" \w*; \w and the goings forth| strong="H8444" \w* \w of the border| strong="H1366" \w* \w shall be to Zedad| strong="H6657" \w*: 
\p
\v 9 \w And the border| strong="H1366" \w* [shall go on]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w to Ziphron| strong="H2202" \w*, \w and the goings out| strong="H8444" \w* [of it shall be at Hazar-enan]{strong=“H2704”}: \w this shall be your north| strong="H6828" \w* \w border| strong="H1366" \w*. 
\v 10 [And ye shall point out]{strong=“H184” x-morph=“strongMorph: \sc Th\sc*8694”} \w your east| strong="H6924" \w* \w border| strong="H1366" \w* [from Hazar-enan]{strong=“H2704”} \w to Shepham| strong="H8221" \w*: 
\v 11 \w And the coast| strong="H1366" \w* [shall go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} \w from Shepham| strong="H8221" \w* \w to Riblah| strong="H7247" \w*, \w on the east side| strong="H6924" \w* \w of Ain| strong="H5871" \w*; \w and the border| strong="H1366" \w* [shall descend]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”}, [and shall reach]{strong=“H4229” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the side| strong="H3802" \w* \w of the sea| strong="H3220" \w* \w of Chinnereth| strong="H3672" \w* \w eastward| strong="H6924" \w*:\f + \fr 34:11 \ft side of the sea: Heb. shoulder of the sea \f* 
\v 12 \w And the border| strong="H1366" \w* [shall go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} \w to Jordan| strong="H3383" \w*, \w and the goings out| strong="H8444" \w* \w of it shall be at the salt| strong="H4417" \w* \w sea| strong="H3220" \w*: \w this shall be your land| strong="H776" \w* \w with the coasts| strong="H1367" \w* \w thereof round about| strong="H5439" \w*. 
\v 13 \w And Moses| strong="H4872" \w* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, This is \w the land| strong="H776" \w* [which ye shall inherit]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8691”} \w by lot| strong="H1486" \w*, which the \sc Lord\sc* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [to give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto the nine| strong="H8672" \w* \w tribes| strong="H4294" \w*, \w and to the half| strong="H2677" \w* \w tribe| strong="H4294" \w*: 
\v 14 \w For the tribe| strong="H4294" \w* \w of the children| strong="H1121" \w* \w of Reuben| strong="H7206" \w* \w according to the house| strong="H1004" \w* \w of their fathers| strong="H1" \w*, \w and the tribe| strong="H4294" \w* \w of the children| strong="H1121" \w* \w of Gad| strong="H1425" \w* \w according to the house| strong="H1004" \w* \w of their fathers| strong="H1" \w*, [have received]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} their inheritance; \w and half| strong="H2677" \w* \w the tribe| strong="H4294" \w* \w of Manasseh| strong="H4519" \w* [have received]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w their inheritance| strong="H5159" \w*: 
\v 15 \w The two| strong="H8147" \w* \w tribes| strong="H4294" \w* \w and the half| strong="H2677" \w* \w tribe| strong="H4294" \w* [have received]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w their inheritance| strong="H5159" \w* \w on this side| strong="H5676" \w* \w Jordan| strong="H3383" \w* near \w Jericho| strong="H3405" \w* \w eastward| strong="H6924" \w*, \w toward the sunrising| strong="H4217" \w*. 
\p
\v 16 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
