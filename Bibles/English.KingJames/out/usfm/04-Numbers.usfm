\c 28
\p 
\v 1 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8761”} \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, My offering]{strong=“H7133”}, and \w my bread| strong="H3899" \w* \w for my sacrifices made by fire| strong="H801" \w*, for \w a sweet| strong="H5207" \w* \w savour| strong="H7381" \w* [unto me, shall ye observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} [to offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8687”} \w unto me in their due season| strong="H4150" \w*.\f + \fr 28:2 \ft a sweet…: Heb. a savour of my rest \f* 
\v 3 [And thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} unto them, This is \w the offering made by fire| strong="H801" \w* [which ye shall offer]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”} unto the \sc Lord\sc*; \w two| strong="H8147" \w* \w lambs| strong="H3532" \w* \w of the first| strong="H1121" \w* \w year| strong="H8141" \w* \w without spot| strong="H8549" \w* \w day by day| strong="H3117" \w*, for \w a continual| strong="H8548" \w* \w burnt offering| strong="H5930" \w*.\f + \fr 28:3 \ft day by day: Heb. in a day \f* 
\v 4 \w The one| strong="H259" \w* \w lamb| strong="H3532" \w* [shalt thou offer]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the morning| strong="H1242" \w*, \w and the other| strong="H8145" \w* \w lamb| strong="H3532" \w* [shalt thou offer]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w at even| strong="H6153" \w*;\f + \fr 28:4 \ft at even: Heb. between the two evenings \f* 
\v 5 \w And a tenth| strong="H6224" \w* part \w of an ephah| strong="H374" \w* \w of flour| strong="H5560" \w* \w for a meat offering| strong="H4503" \w*, [mingled]{strong=“H1101” x-morph=“strongMorph: \sc Th\sc*8803”} \w with the fourth| strong="H7243" \w* part \w of an hin| strong="H1969" \w* \w of beaten| strong="H3795" \w* \w oil| strong="H8081" \w*. 
\v 6 It is \w a continual| strong="H8548" \w* \w burnt offering| strong="H5930" \w*, [which was ordained]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8803”} \w in mount| strong="H2022" \w* \w Sinai| strong="H5514" \w* \w for a sweet| strong="H5207" \w* \w savour| strong="H7381" \w*, \w a sacrifice made by fire| strong="H801" \w* unto the \sc Lord\sc*. 
\v 7 \w And the drink offering| strong="H5262" \w* thereof shall be \w the fourth| strong="H7243" \w* part \w of an hin| strong="H1969" \w* \w for the one| strong="H259" \w* \w lamb| strong="H3532" \w*: \w in the holy| strong="H6944" \w* place \w shalt thou cause the strong wine| strong="H7941" \w* [to be poured]{strong=“H5258” x-morph=“strongMorph: \sc Th\sc*8685”} unto the \sc Lord\sc* for \w a drink offering| strong="H5262" \w*. 
\v 8 \w And the other| strong="H8145" \w* \w lamb| strong="H3532" \w* [shalt thou offer]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w at even| strong="H6153" \w*: \w as the meat offering| strong="H4503" \w* \w of the morning| strong="H1242" \w*, \w and as the drink offering| strong="H5262" \w* [thereof, thou shalt offer]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} it, \w a sacrifice made by fire| strong="H801" \w*, \w of a sweet| strong="H5207" \w* \w savour| strong="H7381" \w* unto the \sc Lord\sc*. 
