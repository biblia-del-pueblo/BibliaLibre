\v 13 \w Every vow| strong="H5088" \w*, \w and every binding| strong="H632" \w* \w oath| strong="H7621" \w* [to afflict]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8763”} \w the soul| strong="H5315" \w*, \w her husband| strong="H376" \w* [may establish]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8686”} [it, or her husband]{strong=“H376”} [may make it void]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 14 \w But if her husband| strong="H376" \w* [altogether ]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8687”} [hold his peace]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8686”} \w at her from day| strong="H3117" \w* \w to day| strong="H3117" \w*; [then he establisheth]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} \w all her vows| strong="H5088" \w*, \w or all her bonds| strong="H632" \w*, which are [upon her: he confirmeth]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} [them, because he held his peace]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8689”} \w at her in the day| strong="H3117" \w* [that he heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} them. 
