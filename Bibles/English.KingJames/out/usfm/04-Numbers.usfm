\v 4 [And if they blow]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8799”} but \w with one| strong="H259" \w* trumpet, \w then the princes| strong="H5387" \w*, which are \w heads| strong="H7218" \w* \w of the thousands| strong="H505" \w* \w of Israel| strong="H3478" \w*, [shall gather]{strong=“H3259” x-morph=“strongMorph: \sc Th\sc*8738”} themselves unto thee. 
\v 5 [When ye blow]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8804”} \w an alarm| strong="H8643" \w*, \w then the camps| strong="H4264" \w* [that lie]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8802”} \w on the east parts| strong="H6924" \w* [shall go forward]{strong=“H5265” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 6 [When ye blow]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8804”} \w an alarm| strong="H8643" \w* \w the second time| strong="H8145" \w*, \w then the camps| strong="H4264" \w* [that lie]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8802”} \w on the south side| strong="H8486" \w* [shall take their journey]{strong=“H5265” x-morph=“strongMorph: \sc Th\sc*8804”}: [they shall blow]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8799”} \w an alarm| strong="H8643" \w* \w for their journeys| strong="H4550" \w*. 
\v 7 \w But when the congregation| strong="H6951" \w* [is to be gathered together]{strong=“H6950” x-morph=“strongMorph: \sc Th\sc*8687”}, [ye shall blow]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8799”}, [but ye shall not sound an alarm]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 8 \w And the sons| strong="H1121" \w* \w of Aaron| strong="H175" \w*, \w the priests| strong="H3548" \w*, [shall blow]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the trumpets| strong="H2689" \w*; \w and they shall be to you for an ordinance| strong="H2708" \w* \w for ever| strong="H5769" \w* \w throughout your generations| strong="H1755" \w*. 
\v 9 [And if ye go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to war| strong="H4421" \w* \w in your land| strong="H776" \w* \w against| strong="H6862" \w* [the enemy that oppresseth]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8802”} [you, then ye shall blow an alarm]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8689”} \w with the trumpets| strong="H2689" \w*; [and ye shall be remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8738”} \w before| strong="H6440" \w* the \sc Lord\sc* \w your God| strong="H430" \w*, [and ye shall be saved]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8738”} [from your enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 10 \w Also in the day| strong="H3117" \w* \w of your gladness| strong="H8057" \w*, \w and in your solemn days| strong="H4150" \w*, \w and in the beginnings| strong="H7218" \w* \w of your months| strong="H2320" \w*, [ye shall blow]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8804”} \w with the trumpets| strong="H2689" \w* \w over your burnt offerings| strong="H5930" \w*, \w and over the sacrifices| strong="H2077" \w* \w of your peace offerings| strong="H8002" \w*; \w that they may be to you for a memorial| strong="H2146" \w* \w before| strong="H6440" \w* \w your God| strong="H430" \w*: I am the \sc Lord\sc* \w your God| strong="H430" \w*. 
\p
