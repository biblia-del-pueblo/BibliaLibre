\p
\v 35 [And there came out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w a fire| strong="H784" \w* from the \sc Lord\sc*, [and consumed]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the two hundred| strong="H3967" \w* \w and fifty| strong="H2572" \w* \w men| strong="H376" \w* [that offered]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8688”} \w incense| strong="H7004" \w*. 
\p
