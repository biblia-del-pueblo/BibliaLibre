\c 17
\p 
\v 1 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [and take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} [of every one of them a rod]{strong=“H4294 H4294”} \w according to the house| strong="H1004" \w* of their \w fathers| strong="H1" \w*, \w of all their princes| strong="H5387" \w* \w according to the house| strong="H1004" \w* \w of their fathers| strong="H1" \w* [twelve]{strong=“H6240 H8147”} \w rods| strong="H4294" \w*: [write]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8799”} [thou every man’s]{strong=“H376”} \w name| strong="H8034" \w* \w upon his rod| strong="H4294" \w*. 
\v 3 [And thou shalt write]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8799”} [Aaron’s]{strong=“H175”} \w name| strong="H8034" \w* \w upon the rod| strong="H4294" \w* \w of Levi| strong="H3878" \w*: \w for one| strong="H259" \w* \w rod| strong="H4294" \w* shall be \w for the head| strong="H7218" \w* \w of the house| strong="H1004" \w* \w of their fathers| strong="H1" \w*. 
\v 4 [And thou shalt lay them up]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8689”} \w in the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w* \w before| strong="H6440" \w* \w the testimony| strong="H5715" \w*, [where I will meet]{strong=“H3259” x-morph=“strongMorph: \sc Th\sc*8735”} with you. 
\v 5 And it shall come to pass, that [the man’s]{strong=“H376”} \w rod| strong="H4294" \w*, [whom I shall choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”}, [shall blossom]{strong=“H6524” x-morph=“strongMorph: \sc Th\sc*8799”}: [and I will make to cease]{strong=“H7918” x-morph=“strongMorph: \sc Th\sc*8689”} \w from me the murmurings| strong="H8519" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [whereby they murmur]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8688”} against you. 
\p
\v 6 \w And Moses| strong="H4872" \w* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, \w and every one of their princes| strong="H5387" \w* [gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [him a rod]{strong=“H4294 H4294”} [apiece, for each prince]{strong=“H5387 H5387”} [one]{strong=“H259 H259”}, [according to their fathers’]{strong=“H1”} \w houses| strong="H1004" \w*, even [twelve]{strong=“H8147 H6240”} \w rods| strong="H4294" \w*: \w and the rod| strong="H4294" \w* \w of Aaron| strong="H175" \w* was \w among| strong="H8432" \w* \w their rods| strong="H4294" \w*.\f + \fr 17:6 \ft a rod…: Heb. a rod for one prince, a rod for one prince \f* 
\v 7 \w And Moses| strong="H4872" \w* [laid up]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8686”} \w the rods| strong="H4294" \w* \w before| strong="H6440" \w* the \sc Lord\sc* \w in the tabernacle| strong="H168" \w* \w of witness| strong="H5715" \w*. 
\p
\v 8 [And it came to pass, that on the morrow]{strong=“H4283”} \w Moses| strong="H4872" \w* [went]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the tabernacle| strong="H168" \w* \w of witness| strong="H5715" \w*; [and, behold, the rod]{strong=“H4294”} \w of Aaron| strong="H175" \w* \w for the house| strong="H1004" \w* \w of Levi| strong="H3878" \w* [was budded]{strong=“H6524” x-morph=“strongMorph: \sc Th\sc*8804”}, [and brought forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w buds| strong="H6525" \w*, [and bloomed]{strong=“H6692” x-morph=“strongMorph: \sc Th\sc*8686”} \w blossoms| strong="H6731" \w*, [and yielded]{strong=“H1580” x-morph=“strongMorph: \sc Th\sc*8799”} \w almonds| strong="H8247" \w*. 
\v 9 \w And Moses| strong="H4872" \w* [brought out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w all the rods| strong="H4294" \w* \w from before| strong="H6440" \w* the \sc Lord\sc* \w unto all the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*: [and they looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}, [and took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w every man| strong="H376" \w* \w his rod| strong="H4294" \w*. 
\p
\v 10 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w*, \w Bring| strong="H7725" \w* [Aaron’s]{strong=“H175”} \w rod| strong="H4294" \w* [again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”} \w before| strong="H6440" \w* \w the testimony| strong="H5715" \w*, \w to be kept| strong="H4931" \w* \w for a token| strong="H226" \w* [against the rebels]{strong=“H1121 H4805”}; [and thou shalt quite take away]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8762”} \w their murmurings| strong="H8519" \w* [from me, that they die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} not.\f + \fr 17:10 \ft rebels: Heb. children of rebellion \f* 
\v 11 \w And Moses| strong="H4872" \w* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} so: as the \sc Lord\sc* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [him, so did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} he. 
\v 12 \w And the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Behold, we die]{strong=“H1478” x-morph=“strongMorph: \sc Th\sc*8804”}, [we perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”}, [we all perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 13 \w Whosoever cometh any thing near| strong="H7131" \w* \w unto the tabernacle| strong="H4908" \w* of the \sc Lord\sc* [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}: [shall we be consumed]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8804”} [with dying]{strong=“H1478” x-morph=“strongMorph: \sc Th\sc*8800”}?
\c 18
\p 
\v 1 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Aaron| strong="H175" \w*, \w Thou and thy sons| strong="H1121" \w* [and thy father’s]{strong=“H1”} \w house| strong="H1004" \w* [with thee shall bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w the iniquity| strong="H5771" \w* \w of the sanctuary| strong="H4720" \w*: \w and thou and thy sons| strong="H1121" \w* [with thee shall bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w the iniquity| strong="H5771" \w* \w of your priesthood| strong="H3550" \w*. 
\v 2 \w And thy brethren| strong="H251" \w* \w also of the tribe| strong="H4294" \w* \w of Levi| strong="H3878" \w*, \w the tribe| strong="H7626" \w* \w of thy father| strong="H1" \w*, [bring]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8685”} [thou with thee, that they may be joined]{strong=“H3867” x-morph=“strongMorph: \sc Th\sc*8735”} [unto thee, and minister]{strong=“H8334” x-morph=“strongMorph: \sc Th\sc*8762”} [unto thee: but thou and thy sons]{strong=“H1121”} with thee shall minister \w before| strong="H6440" \w* \w the tabernacle| strong="H168" \w* \w of witness| strong="H5715" \w*. 
\v 3 [And they shall keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy charge| strong="H4931" \w*, \w and the charge| strong="H4931" \w* \w of all the tabernacle| strong="H168" \w*: [only they shall not come nigh]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} \w the vessels| strong="H3627" \w* \w of the sanctuary| strong="H6944" \w* \w and the altar| strong="H4196" \w*, [that neither they, nor ye also, die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 4 [And they shall be joined]{strong=“H3867” x-morph=“strongMorph: \sc Th\sc*8738”} [unto thee, and keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w the charge| strong="H4931" \w* \w of the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*, \w for all the service| strong="H5656" \w* \w of the tabernacle| strong="H168" \w*: [and a stranger]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} [shall not come nigh]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} unto you. 
\v 5 [And ye shall keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w the charge| strong="H4931" \w* \w of the sanctuary| strong="H6944" \w*, \w and the charge| strong="H4931" \w* \w of the altar| strong="H4196" \w*: \w that there be no wrath| strong="H7110" \w* \w any more upon the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*. 
\v 6 [And I, behold, I have taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w your brethren| strong="H251" \w* \w the Levites| strong="H3881" \w* \w from among| strong="H8432" \w* \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*: to you they are [given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8803”} as \w a gift| strong="H4979" \w* for the \sc Lord\sc*, [to do]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8800”} \w the service| strong="H5656" \w* \w of the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*. 
\v 7 \w Therefore thou and thy sons| strong="H1121" \w* [with thee shall keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} [your priest’s office]{strong=“H3550”} \w for every thing| strong="H1697" \w* \w of the altar| strong="H4196" \w*, \w and within| strong="H1004" \w* \w the vail| strong="H6532" \w*; [and ye shall serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”}: [I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [your priest’s office]{strong=“H3550”} unto you \w as a service| strong="H5656" \w* \w of gift| strong="H4979" \w*: [and the stranger]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} \w that cometh nigh| strong="H7131" \w* [shall be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}. 
\p
\v 8 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Aaron| strong="H175" \w*, [Behold, I also have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee the charge| strong="H4931" \w* \w of mine heave offerings| strong="H8641" \w* \w of all the hallowed things| strong="H6944" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*; [unto thee have I given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w them by reason of the anointing| strong="H4888" \w*, \w and to thy sons| strong="H1121" \w*, \w by an ordinance| strong="H2706" \w* \w for ever| strong="H5769" \w*. 
\v 9 \w This shall be thine of the most| strong="H6944" \w* \w holy things| strong="H6944" \w*, reserved \w from the fire| strong="H784" \w*: \w every oblation| strong="H7133" \w* [of theirs, every meat offering]{strong=“H4503”} [of theirs, and every sin offering]{strong=“H2403”} [of theirs, and every trespass offering]{strong=“H817”} [of theirs, which they shall render]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} unto me, shall be \w most| strong="H6944" \w* \w holy| strong="H6944" \w* \w for thee and for thy sons| strong="H1121" \w*. 
\v 10 \w In the most| strong="H6944" \w* \w holy| strong="H6944" \w* place [shalt thou eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [it; every male]{strong=“H2145”} [shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} [it: it shall be holy]{strong=“H6944”} unto thee. 
\v 11 And this is [thine; the heave offering]{strong=“H8641”} \w of their gift| strong="H4976" \w*, \w with all the wave offerings| strong="H8573" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*: [I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [them unto thee, and to thy sons]{strong=“H1121”} \w and to thy daughters| strong="H1323" \w* [with thee, by a statute]{strong=“H2706”} \w for ever| strong="H5769" \w*: \w every one that is clean| strong="H2889" \w* \w in thy house| strong="H1004" \w* [shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} of it. 
\v 12 \w All the best| strong="H2459" \w* \w of the oil| strong="H3323" \w*, \w and all the best| strong="H2459" \w* \w of the wine| strong="H8492" \w*, \w and of the wheat| strong="H1715" \w*, \w the firstfruits| strong="H7225" \w* [of them which they shall offer]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} unto the \sc Lord\sc*, [them have I given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} thee.\f + \fr 18:12 \ft best: Heb. fat \f* 
\v 13 And \w whatsoever is first ripe| strong="H1061" \w* \w in the land| strong="H776" \w*, [which they shall bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} unto the \sc Lord\sc*, [shall be thine; every one that is clean]{strong=“H2889”} \w in thine house| strong="H1004" \w* [shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} of it. 
\v 14 \w Every thing devoted| strong="H2764" \w* \w in Israel| strong="H3478" \w* shall be thine. 
\v 15 \w Every thing that openeth| strong="H6363" \w* \w the matrix| strong="H7358" \w* \w in all flesh| strong="H1320" \w*, [which they bring]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8686”} unto the \sc Lord\sc*, whether it be \w of men| strong="H120" \w* \w or beasts| strong="H929" \w*, [shall be thine: nevertheless the firstborn]{strong=“H1060”} \w of man| strong="H120" \w* [shalt thou surely]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8800”} [redeem]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the firstling| strong="H1060" \w* \w of unclean| strong="H2931" \w* \w beasts| strong="H929" \w* [shalt thou redeem]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 16 [And those that are to be redeemed]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8803”} \w from a month| strong="H2320" \w* \w old| strong="H1121" \w* [shalt thou redeem]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8799”}, \w according to thine estimation| strong="H6187" \w*, \w for the money| strong="H3701" \w* \w of five| strong="H2568" \w* \w shekels| strong="H8255" \w*, \w after the shekel| strong="H8255" \w* \w of the sanctuary| strong="H6944" \w*, which is \w twenty| strong="H6242" \w* \w gerahs| strong="H1626" \w*. 
\v 17 \w But the firstling| strong="H1060" \w* \w of a cow| strong="H7794" \w*, \w or the firstling| strong="H1060" \w* \w of a sheep| strong="H3775" \w*, \w or the firstling| strong="H1060" \w* \w of a goat| strong="H5795" \w*, [thou shalt not redeem]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8799”}; they are \w holy| strong="H6944" \w*: [thou shalt sprinkle]{strong=“H2236” x-morph=“strongMorph: \sc Th\sc*8799”} \w their blood| strong="H1818" \w* \w upon the altar| strong="H4196" \w*, [and shalt burn]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8686”} \w their fat| strong="H2459" \w* for \w an offering made by fire| strong="H801" \w*, \w for a sweet| strong="H5207" \w* \w savour| strong="H7381" \w* unto the \sc Lord\sc*. 
\v 18 \w And the flesh| strong="H1320" \w* [of them shall be thine, as the wave]{strong=“H8573”} \w breast| strong="H2373" \w* \w and as the right| strong="H3225" \w* \w shoulder| strong="H7785" \w* are thine. 
\v 19 \w All the heave offerings| strong="H8641" \w* \w of the holy things| strong="H6944" \w*, \w which the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [offer]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} unto the \sc Lord\sc*, [have I given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, and thy sons]{strong=“H1121”} \w and thy daughters| strong="H1323" \w* [with thee, by a statute]{strong=“H2706”} \w for ever| strong="H5769" \w*: it is \w a covenant| strong="H1285" \w* \w of salt| strong="H4417" \w* \w for ever| strong="H5769" \w* \w before| strong="H6440" \w* the \sc Lord\sc* \w unto thee and to thy seed| strong="H2233" \w* with thee. 
\p
\v 20 And the \sc Lord\sc* [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Aaron| strong="H175" \w*, [Thou shalt have no inheritance]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8799”} \w in their land| strong="H776" \w*, \w neither shalt thou have any part| strong="H2506" \w* \w among| strong="H8432" \w* them: I am \w thy part| strong="H2506" \w* \w and thine inheritance| strong="H5159" \w* \w among| strong="H8432" \w* \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*. 
\v 21 [And, behold, I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w the children| strong="H1121" \w* \w of Levi| strong="H3878" \w* \w all the tenth| strong="H4643" \w* \w in Israel| strong="H3478" \w* \w for an inheritance| strong="H5159" \w*, \w for| strong="H2500" \w* \w their service| strong="H5656" \w* [which they serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8802”}, even \w the service| strong="H5656" \w* \w of the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*. 
\v 22 \w Neither must the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* \w henceforth| strong="H5750" \w* [come nigh]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} \w the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*, [lest they bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8800”} \w sin| strong="H2399" \w*, [and die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 18:22 \ft and die: Heb. to die \f* 
\v 23 \w But the Levites| strong="H3881" \w* [shall do]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8804”} \w the service| strong="H5656" \w* \w of the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*, [and they shall bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their iniquity| strong="H5771" \w*: it shall be \w a statute| strong="H2708" \w* \w for ever| strong="H5769" \w* \w throughout your generations| strong="H1755" \w*, \w that among| strong="H8432" \w* \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [they have]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8799”} \w no inheritance| strong="H5159" \w*. 
\v 24 \w But the tithes| strong="H4643" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [which they offer]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} as \w an heave offering| strong="H8641" \w* unto the \sc Lord\sc*, [I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the Levites| strong="H3881" \w* \w to inherit| strong="H5159" \w*: [therefore I have said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, Among]{strong=“H8432”} \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [they shall have]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8799”} \w no inheritance| strong="H5159" \w*. 
\p
\v 25 And the \sc Lord\sc* [spake ]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 26 [Thus speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto the Levites| strong="H3881" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, When ye take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* \w the tithes| strong="H4643" \w* [which I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w you from them for your inheritance| strong="H5159" \w*, [then ye shall offer]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8689”} \w up an heave offering| strong="H8641" \w* of it for the \sc Lord\sc*, even \w a tenth| strong="H4643" \w* part \w of the tithe| strong="H4643" \w*. 
\v 27 And this \w your heave offering| strong="H8641" \w* [shall be reckoned]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8738”} unto you, as though it were \w the corn| strong="H1715" \w* \w of the threshingfloor| strong="H1637" \w*, \w and as the fulness| strong="H4395" \w* \w of the winepress| strong="H3342" \w*. 
\v 28 [Thus ye also shall offer]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} \w an heave offering| strong="H8641" \w* unto the \sc Lord\sc* \w of all your tithes| strong="H4643" \w*, [which ye receive]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*; [and ye shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} thereof the \sc Lord\sc*’S \w heave offering| strong="H8641" \w* \w to Aaron| strong="H175" \w* \w the priest| strong="H3548" \w*. 
\v 29 \w Out of all your gifts| strong="H4979" \w* [ye shall offer]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} \w every heave offering| strong="H8641" \w* of the \sc Lord\sc*, \w of all the best| strong="H2459" \w* thereof, even \w the hallowed part| strong="H4720" \w* thereof out of it.\f + \fr 18:29 \ft best: Heb. fat \f* 
\v 30 [Therefore thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, When ye have heaved]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8687”} \w the best| strong="H2459" \w* [thereof from it, then it shall be counted]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto the Levites| strong="H3881" \w* \w as the increase| strong="H8393" \w* \w of the threshingfloor| strong="H1637" \w*, \w and as the increase| strong="H8393" \w* \w of the winepress| strong="H3342" \w*.\f + \fr 18:30 \ft best: Heb. fat \f* 
\v 31 [And ye shall eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w it in every place| strong="H4725" \w*, \w ye and your households| strong="H1004" \w*: for it is \w your reward| strong="H7939" \w* \w for| strong="H2500" \w* \w your service| strong="H5656" \w* \w in the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*. 
\v 32 [And ye shall bear]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w no sin| strong="H2399" \w* [by reason of it, when ye have heaved]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8687”} \w from it the best| strong="H2459" \w* [of it: neither shall ye pollute]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8762”} \w the holy things| strong="H6944" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [lest ye die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}.
\c 19
\p 
\v 1 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w* \w and unto Aaron| strong="H175" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 This is \w the ordinance| strong="H2708" \w* \w of the law| strong="H8451" \w* which the \sc Lord\sc* [hath commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”}, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [that they bring]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w thee a red| strong="H122" \w* \w heifer| strong="H6510" \w* \w without spot| strong="H8549" \w*, wherein is \w no blemish| strong="H3971" \w*, and \w upon which never| strong="H3808" \w* [came]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w yoke| strong="H5923" \w*: 
\v 3 [And ye shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w her unto Eleazar| strong="H499" \w* \w the priest| strong="H3548" \w*, [that he may bring her forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w without| strong="H2351" \w* \w the camp| strong="H4264" \w*, and one [shall slay]{strong=“H7819” x-morph=“strongMorph: \sc Th\sc*8804”} \w her before| strong="H6440" \w* his face: 
\v 4 \w And Eleazar| strong="H499" \w* \w the priest| strong="H3548" \w* [shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w of her blood| strong="H1818" \w* \w with his finger| strong="H676" \w*, [and sprinkle]{strong=“H5137” x-morph=“strongMorph: \sc Th\sc*8689”} \w of her blood| strong="H1818" \w* \w directly| strong="H5227" \w* \w before| strong="H6440" \w* \w the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w* \w seven| strong="H7651" \w* \w times| strong="H6471" \w*: 
\v 5 And one [shall burn]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8804”} \w the heifer| strong="H6510" \w* \w in his sight| strong="H5869" \w*; \w her skin| strong="H5785" \w*, \w and her flesh| strong="H1320" \w*, \w and her blood| strong="H1818" \w*, \w with her dung| strong="H6569" \w*, [shall he burn]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8799”}: 
\v 6 \w And the priest| strong="H3548" \w* [shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w cedar| strong="H730" \w* \w wood| strong="H6086" \w*, \w and hyssop| strong="H231" \w*, [and scarlet]{strong=“H8144 H8438”}, [and cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8689”} it \w into the midst| strong="H8432" \w* \w of the burning| strong="H8316" \w* \w of the heifer| strong="H6510" \w*. 
