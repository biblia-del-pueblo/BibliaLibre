\v 4 [And why have ye brought up]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} \w the congregation| strong="H6951" \w* of the \sc Lord\sc* \w into this wilderness| strong="H4057" \w*, \w that we and our cattle| strong="H1165" \w* [should die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} there? 
\v 5 [And wherefore have ye made us to come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} \w out of Egypt| strong="H4714" \w*, [to bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} \w us in unto this evil| strong="H7451" \w* \w place| strong="H4725" \w*? it is \w no place| strong="H4725" \w* \w of seed| strong="H2233" \w*, \w or of figs| strong="H8384" \w*, \w or of vines| strong="H1612" \w*, \w or of pomegranates| strong="H7416" \w*; neither is \w there any water| strong="H4325" \w* [to drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 6 \w And Moses| strong="H4872" \w* \w and Aaron| strong="H175" \w* [went]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the presence| strong="H6440" \w* \w of the assembly| strong="H6951" \w* \w unto the door| strong="H6607" \w* \w of the tabernacle| strong="H168" \w* \w of the congregation| strong="H4150" \w*, [and they fell]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon their faces| strong="H6440" \w*: \w and the glory| strong="H3519" \w* of the \sc Lord\sc* [appeared]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8735”} unto them. 
\p
\v 7 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 8 [Take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w the rod| strong="H4294" \w*, [and gather]{strong=“H6950” x-morph=“strongMorph: \sc Th\sc*8685”} \w thou the assembly| strong="H5712" \w* [together, thou, and Aaron]{strong=“H175”} \w thy brother| strong="H251" \w*, [and speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w ye unto the rock| strong="H5553" \w* \w before their eyes| strong="H5869" \w*; [and it shall give forth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w his water| strong="H4325" \w*, [and thou shalt bring forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w to them water| strong="H4325" \w* \w out of the rock| strong="H5553" \w*: \w so thou shalt give| strong="H8248" \w* \w the congregation| strong="H5712" \w* \w and their beasts| strong="H1165" \w* [drink]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8689”}. 
\v 9 \w And Moses| strong="H4872" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the rod| strong="H4294" \w* \w from before| strong="H6440" \w* the \sc Lord\sc*, [as he commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} him. 
\v 10 \w And Moses| strong="H4872" \w* \w and Aaron| strong="H175" \w* [gathered]{strong=“H6950” x-morph=“strongMorph: \sc Th\sc*8686”} \w the congregation| strong="H6951" \w* \w together before| strong="H6440" \w* \w the rock| strong="H5553" \w*, [and he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [now, ye rebels]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8802”}; [must we fetch]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w you water| strong="H4325" \w* \w out of this rock| strong="H5553" \w*? 
\v 11 \w And Moses| strong="H4872" \w* [lifted up]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8686”} \w his hand| strong="H3027" \w*, \w and with his rod| strong="H4294" \w* [he smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w the rock| strong="H5553" \w* \w twice| strong="H6471" \w*: \w and the water| strong="H4325" \w* [came out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w abundantly| strong="H7227" \w*, \w and the congregation| strong="H5712" \w* [drank]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and their beasts| strong="H1165" \w* also. 
\p
\v 12 And the \sc Lord\sc* [spake]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Moses| strong="H4872" \w* \w and Aaron| strong="H175" \w*, [Because ye believed]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8689”} [me not, to sanctify]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8687”} \w me in the eyes| strong="H5869" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [therefore ye shall not bring]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w this congregation| strong="H6951" \w* \w into the land| strong="H776" \w* [which I have given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} them. 
\v 13 This is \w the water| strong="H4325" \w* \w of Meribah| strong="H4809" \w*; \w because the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [strove]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8804”} with the \sc Lord\sc*, [and he was sanctified]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8735”} in them.\f + \fr 20:13 \ft Meribah: that is, Strife \f* 
\p
\v 14 \w And Moses| strong="H4872" \w* [sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} \w messengers| strong="H4397" \w* \w from Kadesh| strong="H6946" \w* \w unto the king| strong="H4428" \w* \w of Edom| strong="H123" \w*, [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy brother| strong="H251" \w* \w Israel| strong="H3478" \w*, [Thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w all the travail| strong="H8513" \w* [that hath befallen]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} us:\f + \fr 20:14 \ft befallen…: Heb. found us \f* 
