\v 18 [And ye shall take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w one| strong="H259" \w* \w prince| strong="H5387" \w* \w of every tribe| strong="H4294" \w*, \w to divide| strong="H5157" \w* \w the land| strong="H776" \w* [by inheritance]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 19 \w And the names| strong="H8034" \w* \w of the men| strong="H582" \w* are [these: Of the tribe]{strong=“H4294”} \w of Judah| strong="H3063" \w*, \w Caleb| strong="H3612" \w* \w the son| strong="H1121" \w* \w of Jephunneh| strong="H3312" \w*. 
\v 20 \w And of the tribe| strong="H4294" \w* \w of the children| strong="H1121" \w* \w of Simeon| strong="H8095" \w*, \w Shemuel| strong="H8050" \w* \w the son| strong="H1121" \w* \w of Ammihud| strong="H5989" \w*. 
\v 21 \w Of the tribe| strong="H4294" \w* \w of Benjamin| strong="H1144" \w*, \w Elidad| strong="H449" \w* \w the son| strong="H1121" \w* \w of Chislon| strong="H3692" \w*. 
\v 22 \w And the prince| strong="H5387" \w* \w of the tribe| strong="H4294" \w* \w of the children| strong="H1121" \w* \w of Dan| strong="H1835" \w*, \w Bukki| strong="H1231" \w* \w the son| strong="H1121" \w* \w of Jogli| strong="H3020" \w*. 
\v 23 \w The prince| strong="H5387" \w* \w of the children| strong="H1121" \w* \w of Joseph| strong="H3130" \w*, \w for the tribe| strong="H4294" \w* \w of the children| strong="H1121" \w* \w of Manasseh| strong="H4519" \w*, \w Hanniel| strong="H2592" \w* \w the son| strong="H1121" \w* \w of Ephod| strong="H641" \w*. 
\v 24 \w And the prince| strong="H5387" \w* \w of the tribe| strong="H4294" \w* \w of the children| strong="H1121" \w* \w of Ephraim| strong="H669" \w*, \w Kemuel| strong="H7055" \w* \w the son| strong="H1121" \w* \w of Shiphtan| strong="H8204" \w*. 
\v 25 \w And the prince| strong="H5387" \w* \w of the tribe| strong="H4294" \w* \w of the children| strong="H1121" \w* \w of Zebulun| strong="H2074" \w*, \w Elizaphan| strong="H469" \w* \w the son| strong="H1121" \w* \w of Parnach| strong="H6535" \w*. 
\v 26 \w And the prince| strong="H5387" \w* \w of the tribe| strong="H4294" \w* \w of the children| strong="H1121" \w* \w of Issachar| strong="H3485" \w*, \w Paltiel| strong="H6409" \w* \w the son| strong="H1121" \w* \w of Azzan| strong="H5821" \w*. 
\v 27 \w And the prince| strong="H5387" \w* \w of the tribe| strong="H4294" \w* \w of the children| strong="H1121" \w* \w of Asher| strong="H836" \w*, \w Ahihud| strong="H282" \w* \w the son| strong="H1121" \w* \w of Shelomi| strong="H8015" \w*. 
\v 28 \w And the prince| strong="H5387" \w* \w of the tribe| strong="H4294" \w* \w of the children| strong="H1121" \w* \w of Naphtali| strong="H5321" \w*, \w Pedahel| strong="H6300" \w* \w the son| strong="H1121" \w* \w of Ammihud| strong="H5989" \w*. 
\v 29 These are they whom the \sc Lord\sc* [commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [to divide the inheritance]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8763”} \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* \w in the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*. 
\c 35
\p 
\v 1 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w* \w in the plains| strong="H6160" \w* \w of Moab| strong="H4124" \w* \w by Jordan| strong="H3383" \w* near \w Jericho| strong="H3405" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 2 [Command]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8761”} \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [that they give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the Levites| strong="H3881" \w* \w of the inheritance| strong="H5159" \w* \w of their possession| strong="H272" \w* \w cities| strong="H5892" \w* [to dwell in]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”}; [and ye shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} also \w unto the Levites| strong="H3881" \w* \w suburbs| strong="H4054" \w* \w for the cities| strong="H5892" \w* \w round about| strong="H5439" \w* them. 
\v 3 \w And the cities| strong="H5892" \w* [shall they have to dwell in]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”}; \w and the suburbs| strong="H4054" \w* \w of them shall be for their cattle| strong="H929" \w*, \w and for their goods| strong="H7399" \w*, \w and for all their beasts| strong="H2416" \w*. 
\v 4 \w And the suburbs| strong="H4054" \w* \w of the cities| strong="H5892" \w*, [which ye shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the Levites| strong="H3881" \w*, shall reach \w from the wall| strong="H7023" \w* \w of the city| strong="H5892" \w* \w and outward| strong="H2351" \w* \w a thousand| strong="H505" \w* \w cubits| strong="H520" \w* \w round about| strong="H5439" \w*. 
\v 5 [And ye shall measure]{strong=“H4058” x-morph=“strongMorph: \sc Th\sc*8804”} \w from without| strong="H2351" \w* \w the city| strong="H5892" \w* \w on the east| strong="H6924" \w* \w side| strong="H6285" \w* \w two thousand| strong="H505" \w* \w cubits| strong="H520" \w*, \w and on the south| strong="H5045" \w* \w side| strong="H6285" \w* \w two thousand| strong="H505" \w* \w cubits| strong="H520" \w*, \w and on the west| strong="H3220" \w* \w side| strong="H6285" \w* \w two thousand| strong="H505" \w* \w cubits| strong="H520" \w*, \w and on the north| strong="H6828" \w* \w side| strong="H6285" \w* \w two thousand| strong="H505" \w* \w cubits| strong="H520" \w*; \w and the city| strong="H5892" \w* shall be \w in the midst| strong="H8432" \w*: \w this shall be to them the suburbs| strong="H4054" \w* \w of the cities| strong="H5892" \w*. 
\v 6 \w And among the cities| strong="H5892" \w* [which ye shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the Levites| strong="H3881" \w* there shall be \w six| strong="H8337" \w* \w cities| strong="H5892" \w* \w for refuge| strong="H4733" \w*, [which ye shall appoint]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [for the manslayer]{strong=“H7523” x-morph=“strongMorph: \sc Th\sc*8802”}, [that he may flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8800”} [thither: and to them ye shall add]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w forty| strong="H705" \w* \w and two| strong="H8147" \w* \w cities| strong="H5892" \w*.\f + \fr 35:6 \ft to them…: Heb. above them ye shall give \f* 
\v 7 So \w all the cities| strong="H5892" \w* [which ye shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the Levites| strong="H3881" \w* shall be \w forty| strong="H705" \w* \w and eight| strong="H8083" \w* \w cities| strong="H5892" \w*: them shall ye give \w with their suburbs| strong="H4054" \w*. 
\v 8 \w And the cities| strong="H5892" \w* [which ye shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} shall be \w of the possession| strong="H272" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*: from them that have \w many| strong="H7227" \w* [ye shall give many]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”}; but from them that have \w few| strong="H4592" \w* [ye shall give few]{strong=“H4591” x-morph=“strongMorph: \sc Th\sc*8686”}: \w every one| strong="H376" \w* [shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w of his cities| strong="H5892" \w* \w unto the Levites| strong="H3881" \w* \w according| strong="H6310" \w* \w to his inheritance| strong="H5159" \w* [which he inheriteth]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 35:8 \ft he…: Heb. they inherit \f* 
\p
\v 9 And the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto Moses| strong="H4872" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, 
\v 10 [Speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} \w unto the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, [and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [unto them, When ye be come over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} \w Jordan| strong="H3383" \w* \w into the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*; 
\v 11 [Then ye shall appoint]{strong=“H7136” x-morph=“strongMorph: \sc Th\sc*8689”} \w you cities| strong="H5892" \w* \w to be cities| strong="H5892" \w* \w of refuge| strong="H4733" \w* [for you; that the slayer]{strong=“H7523” x-morph=“strongMorph: \sc Th\sc*8802”} [may flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8804”} [thither, which killeth]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8688”} \w any person| strong="H5315" \w* \w at unawares| strong="H7684" \w*.\f + \fr 35:11 \ft at…: Heb. by error \f* 
\v 12 \w And they shall be unto you cities| strong="H5892" \w* \w for refuge| strong="H4733" \w* [from the avenger]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”}; [that the manslayer]{strong=“H7523” x-morph=“strongMorph: \sc Th\sc*8802”} [die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} [not, until he stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8800”} \w before| strong="H6440" \w* \w the congregation| strong="H5712" \w* \w in judgment| strong="H4941" \w*. 
\v 13 \w And of these cities| strong="H5892" \w* [which ye shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w six| strong="H8337" \w* \w cities| strong="H5892" \w* \w shall ye have for refuge| strong="H4733" \w*. 
\v 14 [Ye shall give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w three| strong="H7969" \w* \w cities| strong="H5892" \w* \w on this side| strong="H5676" \w* \w Jordan| strong="H3383" \w*, \w and three| strong="H7969" \w* \w cities| strong="H5892" \w* [shall ye give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the land| strong="H776" \w* \w of Canaan| strong="H3667" \w*, which \w shall be cities| strong="H5892" \w* \w of refuge| strong="H4733" \w*. 
\v 15 \w These six| strong="H8337" \w* \w cities| strong="H5892" \w* \w shall be a refuge| strong="H4733" \w*, both \w for the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, \w and for the stranger| strong="H1616" \w*, \w and for the sojourner| strong="H8453" \w* \w among| strong="H8432" \w* [them: that every one that killeth]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8688”} \w any person| strong="H5315" \w* \w unawares| strong="H7684" \w* [may flee]{strong=“H5127” x-morph=“strongMorph: \sc Th\sc*8800”} thither. 
\v 16 [And if he smite]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w him with an instrument| strong="H3627" \w* \w of iron| strong="H1270" \w*, [so that he die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, he is [a murderer]{strong=“H7523” x-morph=“strongMorph: \sc Th\sc*8802”}: [the murderer]{strong=“H7523” x-morph=“strongMorph: \sc Th\sc*8802”} [shall surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [be put to death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8714”}. 
