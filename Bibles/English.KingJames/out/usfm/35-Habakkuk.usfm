\h Habakkuk
\toc1 Habakkuk
\p
\rem From here on, this file is autogenerated by bibmark. You may edit the header section, as it will not be changed by bibmark.

\c 1
\p 
\v 1 \w The burden| strong="H4853" \w* \w which Habakkuk| strong="H2265" \w* \w the prophet| strong="H5030" \w* [did see]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 2 O \sc Lord\sc*, [how long shall I cry]{strong=“H7768” x-morph=“strongMorph: \sc Th\sc*8765”}, [and thou wilt not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”}! even [cry out]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8799”} unto thee of \w violence| strong="H2555" \w*, [and thou wilt not save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”}! 
\v 3 [Why dost thou shew]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8686”} \w me iniquity| strong="H205" \w*, and cause me [to behold]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”} \w grievance| strong="H5999" \w*? \w for spoiling| strong="H7701" \w* \w and violence| strong="H2555" \w* are before me: and there are that [raise up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w strife| strong="H7379" \w* \w and contention| strong="H4066" \w*. 
\v 4 \w Therefore the law| strong="H8451" \w* [is slacked]{strong=“H6313” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and judgment| strong="H4941" \w* \w doth never| strong="H5331" \w* [go forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”}: \w for the wicked| strong="H7563" \w* [doth compass]{strong=“H3803” x-morph=“strongMorph: \sc Th\sc*8688”} \w about the righteous| strong="H6662" \w*; [therefore wrong]{strong=“H6127” x-morph=“strongMorph: \sc Th\sc*8794”} \w judgment| strong="H4941" \w* [proceedeth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 1:4 \ft wrong: or, wrested \f* 
\p
\v 5 [Behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w ye among the heathen| strong="H1471" \w*, [and regard]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8685”}, [and wonder]{strong=“H8539” x-morph=“strongMorph: \sc Th\sc*8690”} [marvellously]{strong=“H8539” x-morph=“strongMorph: \sc Th\sc*8798”}: for I [will work]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w a work| strong="H6467" \w* \w in your days| strong="H3117" \w*, which [ye will not believe]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”}, [though it be told]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8792”} you. 
\v 6 [For, lo, I raise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8688”} \w the Chaldeans| strong="H3778" \w*, that \w bitter| strong="H4751" \w* [and hasty]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8737”} \w nation| strong="H1471" \w*, [which shall march]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} \w through the breadth| strong="H4800" \w* \w of the land| strong="H776" \w*, [to possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} \w the dwellingplaces| strong="H4908" \w* that are not theirs.\f + \fr 1:6 \ft breadth: Heb. breadths \f* 
\v 7 They are \w terrible| strong="H366" \w* [and dreadful]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”}: \w their judgment| strong="H4941" \w* \w and their dignity| strong="H7613" \w* [shall proceed]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} of themselves.\f + \fr 1:7 \ft their judgment…: or, from them shall proceed the judgment of these, and the captivity of these \f* 
\v 8 \w Their horses| strong="H5483" \w* [also are swifter]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8804”} \w than the leopards| strong="H5246" \w*, [and are more fierce]{strong=“H2300” x-morph=“strongMorph: \sc Th\sc*8804”} \w than the evening| strong="H6153" \w* \w wolves| strong="H2061" \w*: \w and their horsemen| strong="H6571" \w* [shall spread]{strong=“H6335” x-morph=“strongMorph: \sc Th\sc*8804”} [themselves, and their horsemen]{strong=“H6571”} [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w from far| strong="H7350" \w*; [they shall fly]{strong=“H5774” x-morph=“strongMorph: \sc Th\sc*8799”} \w as the eagle| strong="H5404" \w* that [hasteth]{strong=“H2363” x-morph=“strongMorph: \sc Th\sc*8804”} [to eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 1:8 \ft fierce: Heb. sharp \f* 
\v 9 [They shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w all for violence| strong="H2555" \w*: \w their faces| strong="H6440" \w* \w shall sup up| strong="H4041" \w* as \w the east wind| strong="H6921" \w*, [and they shall gather]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8799”} \w the captivity| strong="H7628" \w* \w as the sand| strong="H2344" \w*.\f + \fr 1:9 \ft their…: or, the supping up of their faces, etc: or, their faces shall look (Heb. the opposition of their faces) toward the east \f* 
\v 10 [And they shall scoff]{strong=“H7046” x-morph=“strongMorph: \sc Th\sc*8691”} \w at the kings| strong="H4428" \w*, [and the princes]{strong=“H7336” x-morph=“strongMorph: \sc Th\sc*8802”} \w shall be a scorn| strong="H4890" \w* [unto them: they shall deride]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8799”} \w every strong hold| strong="H4013" \w*; [for they shall heap]{strong=“H6651” x-morph=“strongMorph: \sc Th\sc*8799”} \w dust| strong="H6083" \w*, [and take]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\v 11 Then shall his \w mind| strong="H7307" \w* [change]{strong=“H2498” x-morph=“strongMorph: \sc Th\sc*8804”}, [and he shall pass over]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}, [and offend]{strong=“H816” x-morph=“strongMorph: \sc Th\sc*8804”}, imputing \w this| strong="H2098" \w* \w his power| strong="H3581" \w* \w unto his god| strong="H433" \w*. 
\p
\v 12 Art \w thou not from everlasting| strong="H6924" \w*, O \sc Lord\sc* \w my God| strong="H430" \w*, \w mine Holy One| strong="H6918" \w*? [we shall not die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}. O \sc Lord\sc*, [thou hast ordained]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w them for judgment| strong="H4941" \w*; [and, O mighty God]{strong=“H6697”}, [thou hast established]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8804”} [them for correction]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8687”}.\f + \fr 1:12 \ft mighty…: Heb. rock \f* \f + \fr 1:12 \ft established: Heb. founded \f* 
\v 13 Thou art \w of purer| strong="H2889" \w* \w eyes| strong="H5869" \w* [than to behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w evil| strong="H7451" \w*, [and canst]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [not look]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8687”} \w on iniquity| strong="H5999" \w*: [wherefore lookest]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”} [thou upon them that deal treacherously]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”}, and [holdest thy tongue]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8686”} \w when the wicked| strong="H7563" \w* [devoureth]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8763”} the man that is \w more righteous| strong="H6662" \w* than he?\f + \fr 1:13 \ft iniquity: or, grievance \f* 
\v 14 [And makest]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w men| strong="H120" \w* \w as the fishes| strong="H1709" \w* \w of the sea| strong="H3220" \w*, \w as the creeping things| strong="H7431" \w*, that have [no ruler]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8802”} over them?\f + \fr 1:14 \ft creeping: or, moving \f* 
\v 15 [They take up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8689”} \w all of them with the angle| strong="H2443" \w*, [they catch]{strong=“H1641” x-morph=“strongMorph: \sc Th\sc*8799”} \w them in their net| strong="H2764" \w*, [and gather]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8799”} \w them in their drag| strong="H4365" \w*: [therefore they rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} [and are glad]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 1:15 \ft drag: or, flue net \f* 
\v 16 [Therefore they sacrifice]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto their net| strong="H2764" \w*, [and burn incense]{strong=“H6999” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto their drag| strong="H4365" \w*; \w because by them| strong="H1992" \w* \w their portion| strong="H2506" \w* is \w fat| strong="H8082" \w*, \w and their meat| strong="H3978" \w* \w plenteous| strong="H1277" \w*.\f + \fr 1:16 \ft plenteous: or, dainty: Heb. fat \f* 
\v 17 [Shall they therefore empty]{strong=“H7324” x-morph=“strongMorph: \sc Th\sc*8686”} \w their net| strong="H2764" \w*, [and not spare]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”} \w continually| strong="H8548" \w* [to slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8800”} \w the nations| strong="H1471" \w*?
\c 2
\p 
\v 1 [I will stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon my watch| strong="H4931" \w*, [and set]{strong=“H3320” x-morph=“strongMorph: \sc Th\sc*8691”} \w me upon the tower| strong="H4692" \w*, [and will watch]{strong=“H6822” x-morph=“strongMorph: \sc Th\sc*8762”} [to see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} [what he will say]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [unto me, and what I shall answer]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w when I am reproved| strong="H8433" \w*.\f + \fr 2:1 \ft tower: Heb. fenced place \f* \f + \fr 2:1 \ft unto me: or, in me \f* \f + \fr 2:1 \ft when…: or, when I am argued with: Heb. upon my reproof, or, arguing \f* 
\v 2 And the \sc Lord\sc* [answered ]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [me, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Write]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8798”} \w the vision| strong="H2377" \w*, and make it [plain]{strong=“H874” x-morph=“strongMorph: \sc Th\sc*8761”} \w upon tables| strong="H3871" \w*, [that he may run]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”} [that readeth]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8802”} it. 
\v 3 \w For the vision| strong="H2377" \w* is \w yet for an appointed time| strong="H4150" \w*, \w but at the end| strong="H7093" \w* [it shall speak]{strong=“H6315” x-morph=“strongMorph: \sc Th\sc*8686”}, [and not lie]{strong=“H3576” x-morph=“strongMorph: \sc Th\sc*8762”}: [though it tarry]{strong=“H4102” x-morph=“strongMorph: \sc Th\sc*8698”}, [wait]{strong=“H2442” x-morph=“strongMorph: \sc Th\sc*8761”} [for it; because it will surely]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [it will not tarry]{strong=“H309” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 4 [Behold, his soul]{strong=“H5315”} which [is lifted up]{strong=“H6075” x-morph=“strongMorph: \sc Th\sc*8795”} [is not upright]{strong=“H3474” x-morph=“strongMorph: \sc Th\sc*8804”} [in him: but the just]{strong=“H6662”} [shall live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”} \w by his faith| strong="H530" \w*. 
\p
\v 5 [Yea also, because he transgresseth]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8802”} \w by wine| strong="H3196" \w*, he is \w a proud| strong="H3093" \w* \w man| strong="H1397" \w*, [neither keepeth at home]{strong=“H5115” x-morph=“strongMorph: \sc Th\sc*8799”}, [who enlargeth]{strong=“H7337” x-morph=“strongMorph: \sc Th\sc*8689”} \w his desire| strong="H5315" \w* \w as hell| strong="H7585" \w*, and is \w as death| strong="H4194" \w*, [and cannot be satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”}, [but gathereth]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto him all nations| strong="H1471" \w*, [and heapeth]{strong=“H6908” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto him all people| strong="H5971" \w*:\f + \fr 2:5 \ft Yea…: or, How much more \f* 
\v 6 [Shall not all these take up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w a parable| strong="H4912" \w* [against him, and a taunting]{strong=“H4426”} \w proverb| strong="H2420" \w* [against him, and say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Woe| strong="H1945" \w* [to him that increaseth]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8688”} that which is [not his! how long? and to him that ladeth]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8688”} \w himself with thick clay| strong="H5671" \w*!\f + \fr 2:6 \ft Woe…: or, Ho, he \f* 
\v 7 [Shall they not rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w suddenly| strong="H6621" \w* [that shall bite]{strong=“H5391” x-morph=“strongMorph: \sc Th\sc*8802”} [thee, and awake]{strong=“H3364” x-morph=“strongMorph: \sc Th\sc*8799”} [that shall vex]{strong=“H2111” x-morph=“strongMorph: \sc Th\sc*8772”} [thee, and thou shalt be for booties]{strong=“H4933”} unto them? 
\v 8 [Because thou hast spoiled]{strong=“H7997” x-morph=“strongMorph: \sc Th\sc*8804”} \w many| strong="H7227" \w* \w nations| strong="H1471" \w*, \w all the remnant| strong="H3499" \w* \w of the people| strong="H5971" \w* [shall spoil]{strong=“H7997” x-morph=“strongMorph: \sc Th\sc*8799”} [thee; because of men’s]{strong=“H120”} \w blood| strong="H1818" \w*, and for \w the violence| strong="H2555" \w* \w of the land| strong="H776" \w*, \w of the city| strong="H7151" \w*, [and of all that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} therein.\f + \fr 2:8 \ft blood: Heb. bloods \f* 
\p
\v 9 \w Woe| strong="H1945" \w* [to him that coveteth]{strong=“H1214” x-morph=“strongMorph: \sc Th\sc*8802”} \w an evil| strong="H7451" \w* \w covetousness| strong="H1215" \w* \w to his house| strong="H1004" \w*, [that he may set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w his nest| strong="H7064" \w* \w on high| strong="H4791" \w*, [that he may be delivered]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8736”} \w from the power| strong="H3709" \w* \w of evil| strong="H7451" \w*!\f + \fr 2:9 \ft coveteth…: or, gaineth and evil gain \f* \f + \fr 2:9 \ft power…: Heb. palm of the hand \f* 
\v 10 [Thou hast consulted]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8804”} \w shame| strong="H1322" \w* \w to thy house| strong="H1004" \w* [by cutting off]{strong=“H7096” x-morph=“strongMorph: \sc Th\sc*8800”} \w many| strong="H7227" \w* \w people| strong="H5971" \w*, [and hast sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8802”} against \w thy soul| strong="H5315" \w*. 
\v 11 \w For the stone| strong="H68" \w* [shall cry out]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the wall| strong="H7023" \w*, \w and the beam out| strong="H3714" \w* \w of the timber| strong="H6086" \w* [shall answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} it.\f + \fr 2:11 \ft beam: or, piece, or, fastening \f* \f + \fr 2:11 \ft answer it: or, witness against it \f* 
\p
\v 12 \w Woe| strong="H1945" \w* [to him that buildeth]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8802”} \w a town| strong="H5892" \w* \w with blood| strong="H1818" \w*, [and stablisheth]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8790”} \w a city| strong="H7151" \w* \w by iniquity| strong="H5766" \w*!\f + \fr 2:12 \ft blood: Heb. bloods \f* 
\v 13 Behold, is it not of the \sc Lord\sc* \w of hosts| strong="H6635" \w* \w that the people| strong="H5971" \w* [shall labour]{strong=“H3021” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the very| strong="H1767" \w* \w fire| strong="H784" \w*, \w and the people| strong="H3816" \w* [shall weary]{strong=“H3286” x-morph=“strongMorph: \sc Th\sc*8799”} \w themselves for very| strong="H1767" \w* \w vanity| strong="H7385" \w*?\f + \fr 2:13 \ft for…: or, in vain? \f* 
\v 14 \w For the earth| strong="H776" \w* [shall be filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”} [with the knowledge]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} \w of the glory| strong="H3519" \w* of the \sc Lord\sc*, \w as the waters| strong="H4325" \w* [cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w the sea| strong="H3220" \w*.\f + \fr 2:14 \ft with…: or, by knowing the glory \f* 
\p
\v 15 \w Woe| strong="H1945" \w* \w unto him that giveth his neighbour| strong="H7453" \w* [drink]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8688”}, [that puttest]{strong=“H5596” x-morph=“strongMorph: \sc Th\sc*8764”} \w thy bottle| strong="H2573" \w* to him, and makest him [drunken]{strong=“H7937” x-morph=“strongMorph: \sc Th\sc*8763”} [also, that thou mayest look]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8687”} \w on their nakedness| strong="H4589" \w*! 
\v 16 [Thou art filled]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8804”} \w with shame| strong="H7036" \w* \w for glory| strong="H3519" \w*: [drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8798”} [thou also, and let thy foreskin be uncovered]{strong=“H6188” x-morph=“strongMorph: \sc Th\sc*8734”}: \w the cup| strong="H3563" \w* of the \sc Lord\sc*’S \w right hand| strong="H3225" \w* [shall be turned]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8735”} [unto thee, and shameful spewing]{strong=“H7022”} shall be \w on thy glory| strong="H3519" \w*.\f + \fr 2:16 \ft with…: or, more with shame than with glory \f* 
\v 17 \w For the violence| strong="H2555" \w* \w of Lebanon| strong="H3844" \w* [shall cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} [thee, and the spoil]{strong=“H7701”} \w of beasts| strong="H929" \w*, which [made them afraid]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8686”}, [because of men’s]{strong=“H120”} \w blood| strong="H1818" \w*, \w and for the violence| strong="H2555" \w* \w of the land| strong="H776" \w*, \w of the city| strong="H7151" \w*, [and of all that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} therein. 
\p
\v 18 [What profiteth]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8689”} \w the graven image| strong="H6459" \w* [that the maker]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} [thereof hath graven]{strong=“H6458” x-morph=“strongMorph: \sc Th\sc*8804”} [it; the molten image]{strong=“H4541”}, [and a teacher]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8688”} \w of lies| strong="H8267" \w*, [that the maker]{strong=“H3335” x-morph=“strongMorph: \sc Th\sc*8802”} \w of his work| strong="H3336" \w* [trusteth]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”} [therein, to make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w dumb| strong="H483" \w* \w idols| strong="H457" \w*?\f + \fr 2:18 \ft maker of…: Heb. fashioner of his fashion \f* 
\v 19 \w Woe| strong="H1945" \w* [unto him that saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the wood| strong="H6086" \w*, [Awake]{strong=“H6974” x-morph=“strongMorph: \sc Th\sc*8685”}; \w to the dumb| strong="H1748" \w* \w stone| strong="H68" \w*, [Arise]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8798”}, [it shall teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”}! Behold, it is [laid]{strong=“H8610” x-morph=“strongMorph: \sc Th\sc*8803”} \w over with gold| strong="H2091" \w* \w and silver| strong="H3701" \w*, and there is \w no breath| strong="H7307" \w* \w at all in the midst| strong="H7130" \w* of it. 
\v 20 But the \sc Lord\sc* is \w in his holy| strong="H6944" \w* \w temple| strong="H1964" \w*: \w let all the earth| strong="H776" \w* [keep silence]{strong=“H2013” x-morph=“strongMorph: \sc Th\sc*8761”} \w before| strong="H6440" \w* him.\f + \fr 2:20 \ft let…: Heb. be silent all the earth before him \f*
\c 3
\p 
\v 1 \w A prayer| strong="H8605" \w* \w of Habakkuk| strong="H2265" \w* \w the prophet| strong="H5030" \w* \w upon Shigionoth| strong="H7692" \w*.\f + \fr 3:1 \ft upon…: or, according to variable songs, or, tunes, called in Hebrew, Shigionoth \f* 
\v 2 O \sc Lord\sc*, [I have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy speech| strong="H8088" \w*, and [was afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8804”}: O \sc Lord\sc*, [revive]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8761”} \w thy work| strong="H6467" \w* \w in the midst| strong="H7130" \w* \w of the years| strong="H8141" \w*, \w in the midst| strong="H7130" \w* \w of the years| strong="H8141" \w* [make known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8686”}; \w in wrath| strong="H7267" \w* [remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} [mercy]{strong=“H7355” x-morph=“strongMorph: \sc Th\sc*8763”}.\f + \fr 3:2 \ft speech: Heb. report, or, hearing \f* \f + \fr 3:2 \ft revive: or, preserve alive \f* 
\p
\v 3 \w God| strong="H433" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w from Teman| strong="H8487" \w*, \w and the Holy One| strong="H6918" \w* \w from mount| strong="H2022" \w* \w Paran| strong="H6290" \w*. \w Selah| strong="H5542" \w*. \w His glory| strong="H1935" \w* [covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”} \w the heavens| strong="H8064" \w*, \w and the earth| strong="H776" \w* [was full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of his praise| strong="H8416" \w*.\f + \fr 3:3 \ft Teman: or, the south \f* 
\v 4 And his \w brightness| strong="H5051" \w* \w was as the light| strong="H216" \w*; \w he had horns| strong="H7161" \w* coming \w out of his hand| strong="H3027" \w*: and there was \w the hiding| strong="H2253" \w* \w of his power| strong="H5797" \w*.\f + \fr 3:4 \ft horns…: or, bright beams out of his side \f* 
\v 5 \w Before| strong="H6440" \w* [him went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w the pestilence| strong="H1698" \w*, \w and burning coals| strong="H7565" \w* [went forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w at his feet| strong="H7272" \w*.\f + \fr 3:5 \ft coals: or, diseases \f* 
\v 6 [He stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”}, [and measured]{strong=“H4128” x-morph=“strongMorph: \sc Th\sc*8787”} \w the earth| strong="H776" \w*: [he beheld]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”}, [and drove asunder]{strong=“H5425” x-morph=“strongMorph: \sc Th\sc*8686”} \w the nations| strong="H1471" \w*; \w and the everlasting| strong="H5703" \w* \w mountains| strong="H2042" \w* [were scattered]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8691”}, \w the perpetual| strong="H5769" \w* \w hills| strong="H1389" \w* [did bow]{strong=“H7817” x-morph=“strongMorph: \sc Th\sc*8804”}: \w his ways| strong="H1979" \w* are \w everlasting| strong="H5769" \w*. 
\v 7 [I saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the tents| strong="H168" \w* \w of Cushan| strong="H3572" \w* \w in affliction| strong="H205" \w*: and \w the curtains| strong="H3407" \w* \w of the land| strong="H776" \w* \w of Midian| strong="H4080" \w* [did tremble]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 3:7 \ft Cushan: or, Ethiopia \f* \f + \fr 3:7 \ft in…: or, under affliction, or, vanity \f* 
\v 8 Was the \sc Lord\sc* [displeased ]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8804”} \w against the rivers| strong="H5104" \w*? was \w thine anger| strong="H639" \w* \w against the rivers| strong="H5104" \w*? was \w thy wrath| strong="H5678" \w* \w against the sea| strong="H3220" \w*, [that thou didst ride]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon thine horses| strong="H5483" \w* and \w thy chariots| strong="H4818" \w* \w of salvation| strong="H3444" \w*?\f + \fr 3:8 \ft of…: or, were salvation? \f* 
\v 9 \w Thy bow| strong="H7198" \w* \w was made quite| strong="H6181" \w* [naked]{strong=“H5783” x-morph=“strongMorph: \sc Th\sc*8735”}, according \w to the oaths| strong="H7621" \w* \w of the tribes| strong="H4294" \w*, even thy \w word| strong="H562" \w*. \w Selah| strong="H5542" \w*. [Thou didst cleave]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8762”} \w the earth| strong="H776" \w* \w with rivers| strong="H5104" \w*.\f + \fr 3:9 \ft earth…: or, rivers of the earth \f* 
\v 10 \w The mountains| strong="H2022" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} thee, and [they trembled]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8799”}: \w the overflowing| strong="H2230" \w* \w of the water| strong="H4325" \w* [passed by]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”}: \w the deep| strong="H8415" \w* [uttered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w his voice| strong="H6963" \w*, and [lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w his hands| strong="H3027" \w* \w on high| strong="H7315" \w*. 
\v 11 \w The sun| strong="H8121" \w* and \w moon| strong="H3394" \w* [stood still]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”} \w in their habitation| strong="H2073" \w*: \w at the light| strong="H216" \w* \w of thine arrows| strong="H2671" \w* [they went]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8762”}, and \w at the shining| strong="H5051" \w* \w of thy glittering| strong="H1300" \w* \w spear| strong="H2595" \w*.\f + \fr 3:11 \ft at the light…: or, thine arrows walked in the light \f* 
\v 12 [Thou didst march through]{strong=“H6805” x-morph=“strongMorph: \sc Th\sc*8799”} \w the land| strong="H776" \w* \w in indignation| strong="H2195" \w*, [thou didst thresh]{strong=“H1758” x-morph=“strongMorph: \sc Th\sc*8799”} \w the heathen| strong="H1471" \w* \w in anger| strong="H639" \w*. 
\v 13 [Thou wentest forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w for the salvation| strong="H3468" \w* \w of thy people| strong="H5971" \w*, even \w for salvation| strong="H3468" \w* \w with thine anointed| strong="H4899" \w*; [thou woundedst]{strong=“H4272” x-morph=“strongMorph: \sc Th\sc*8804”} \w the head| strong="H7218" \w* \w out of the house| strong="H1004" \w* \w of the wicked| strong="H7563" \w*, [by discovering]{strong=“H6168” x-morph=“strongMorph: \sc Th\sc*8763”} \w the foundation| strong="H3247" \w* \w unto the neck| strong="H6677" \w*. \w Selah| strong="H5542" \w*.\f + \fr 3:13 \ft by…: Heb. making naked \f* 
\v 14 [Thou didst strike through]{strong=“H5344” x-morph=“strongMorph: \sc Th\sc*8804”} \w with his staves| strong="H4294" \w* \w the head| strong="H7218" \w* \w of his villages| strong="H6518" \w*: [they came out as a whirlwind]{strong=“H5590” x-morph=“strongMorph: \sc Th\sc*8799”} [to scatter]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8687”} [me: their rejoicing]{strong=“H5951”} was [as to devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”} \w the poor| strong="H6041" \w* \w secretly| strong="H4565" \w*.\f + \fr 3:14 \ft came…: Heb. were tempestuous \f* 
\v 15 [Thou didst walk]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8804”} \w through the sea| strong="H3220" \w* \w with thine horses| strong="H5483" \w*, through \w the heap| strong="H2563" \w* \w of great| strong="H7227" \w* \w waters| strong="H4325" \w*.\f + \fr 3:15 \ft heap: or, mud \f* 
\p
\v 16 [When I heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}, \w my belly| strong="H990" \w* [trembled]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8799”}; \w my lips| strong="H8193" \w* [quivered]{strong=“H6750” x-morph=“strongMorph: \sc Th\sc*8804”} \w at the voice| strong="H6963" \w*: \w rottenness| strong="H7538" \w* [entered]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into my bones| strong="H6106" \w*, [and I trembled]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8799”} [in myself, that I might rest]{strong=“H5117” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the day| strong="H3117" \w* \w of trouble| strong="H6869" \w*: [when he cometh up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8800”} \w unto the people| strong="H5971" \w*, [he will invade them with his troops]{strong=“H1464” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 3:16 \ft invade…: or, cut them in pieces \f* 
\p
\v 17 \w Although the fig tree| strong="H8384" \w* [shall not blossom]{strong=“H6524” x-morph=“strongMorph: \sc Th\sc*8799”}, neither shall \w fruit| strong="H2981" \w* be \w in the vines| strong="H1612" \w*; \w the labour| strong="H4639" \w* \w of the olive| strong="H2132" \w* [shall fail]{strong=“H3584” x-morph=“strongMorph: \sc Th\sc*8765”}, \w and the fields| strong="H7709" \w* [shall yield]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w no meat| strong="H400" \w*; \w the flock| strong="H6629" \w* [shall be cut off]{strong=“H1504” x-morph=“strongMorph: \sc Th\sc*8804”} \w from the fold| strong="H4356" \w*, and there shall be \w no herd| strong="H1241" \w* \w in the stalls| strong="H7517" \w*:\f + \fr 3:17 \ft fail: Heb. lie \f* 
\v 18 [Yet I will rejoice]{strong=“H5937” x-morph=“strongMorph: \sc Th\sc*8799”} in the \sc Lord\sc*, [I will joy]{strong=“H1523” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the God| strong="H430" \w* \w of my salvation| strong="H3468" \w*. 
\v 19 The \sc Lord\sc* \w God| strong="H136" \w* is \w my strength| strong="H2428" \w*, [and he will make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w my feet| strong="H7272" \w* [like hinds’]{strong=“H355”} feet, [and he will make me to walk]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8686”} \w upon mine high places| strong="H1116" \w*. [To the chief singer]{strong=“H5329” x-morph=“strongMorph: \sc Th\sc*8764”} \w on my stringed instruments| strong="H5058" \w*.\f + \fr 3:19 \ft chief…: or, overseer \f* \f + \fr 3:19 \ft stringed…: Heb. Neginoth \f* 
