\c 1
\p 
\v 1 \w The word| strong="H1697" \w* of the \sc Lord\sc* \w which came unto Zephaniah| strong="H6846" \w* \w the son| strong="H1121" \w* \w of Cushi| strong="H3570" \w*, \w the son| strong="H1121" \w* \w of Gedaliah| strong="H1436" \w*, \w the son| strong="H1121" \w* \w of Amariah| strong="H568" \w*, \w the son| strong="H1121" \w* \w of Hizkiah| strong="H2396" \w*, \w in the days| strong="H3117" \w* \w of Josiah| strong="H2977" \w* \w the son| strong="H1121" \w* \w of Amon| strong="H526" \w*, \w king| strong="H4428" \w* \w of Judah| strong="H3063" \w*. 
\v 2 [I will utterly]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8800”} [consume]{strong=“H5486” x-morph=“strongMorph: \sc Th\sc*8686”} all things [from off the land]{strong=“H127 H6440”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*.\f + \fr 1:2 \ft I will…: Heb. By taking away I will make an end \f* \f + \fr 1:2 \ft the land: Heb. the face of the land \f* 
\v 3 [I will consume]{strong=“H5486” x-morph=“strongMorph: \sc Th\sc*8686”} \w man| strong="H120" \w* \w and beast| strong="H929" \w*; [I will consume]{strong=“H5486” x-morph=“strongMorph: \sc Th\sc*8686”} \w the fowls| strong="H5775" \w* \w of the heaven| strong="H8064" \w*, \w and the fishes| strong="H1709" \w* \w of the sea| strong="H3220" \w*, \w and the stumblingblocks| strong="H4384" \w* \w with the wicked| strong="H7563" \w*; [and I will cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w man| strong="H120" \w* \w from off| strong="H6440" \w* \w the land| strong="H127" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*.\f + \fr 1:3 \ft stumblingblocks: or, idols \f* 
\v 4 [I will also stretch out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine hand| strong="H3027" \w* \w upon Judah| strong="H3063" \w*, [and upon all the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Jerusalem| strong="H3389" \w*; [and I will cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8689”} \w the remnant| strong="H7605" \w* \w of Baal| strong="H1168" \w* \w from this place| strong="H4725" \w*, and \w the name| strong="H8034" \w* \w of the Chemarims| strong="H3649" \w* \w with the priests| strong="H3548" \w*; 
\v 5 [And them that worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8693”} \w the host| strong="H6635" \w* \w of heaven| strong="H8064" \w* \w upon the housetops| strong="H1406" \w*; [and them that worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8693”} and [that swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8737”} by the \sc Lord\sc*, [and that swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8737”} \w by Malcham| strong="H4428" \w*;^\sc 1:5 by the…: or, to the [Lord\sc*] 
\v 6 [And them that are turned back]{strong=“H5472” x-morph=“strongMorph: \sc Th\sc*8737”} \w from| strong="H310" \w* the \sc Lord\sc*; and those [that have not sought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8765”} the \sc Lord\sc*, [nor enquired]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8804”} for him. 
\p
\v 7 [Hold thy peace]{strong=“H2013” x-morph=“strongMorph: \sc Th\sc*8761”} \w at the presence| strong="H6440" \w* \w of the Lord| strong="H136" \w* \sc God\sc*: \w for the day| strong="H3117" \w* of the \sc Lord\sc* is \w at hand| strong="H7138" \w*: for the \sc Lord\sc* [hath prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8689”} \w a sacrifice| strong="H2077" \w*, [he hath bid]{strong=“H6942” x-morph=“strongMorph: \sc Th\sc*8689”} [his guests]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8803”}.\f + \fr 1:7 \ft bid: Heb. sanctified, or, prepared \f* 
\v 8 \w And it shall come to pass in the day| strong="H3117" \w* of the \sc Lord\sc*’S \w sacrifice| strong="H2077" \w*, [that I will punish]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} \w the princes| strong="H8269" \w*, [and the king’s]{strong=“H4428”} \w children| strong="H1121" \w*, [and all such as are clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8802”} \w with strange| strong="H5237" \w* \w apparel| strong="H4403" \w*.\f + \fr 1:8 \ft punish: Heb. visit upon \f* 
\v 9 \w In the same day| strong="H3117" \w* [also will I punish]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} [all those that leap]{strong=“H1801” x-morph=“strongMorph: \sc Th\sc*8802”} \w on the threshold| strong="H4670" \w*, [which fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8764”} [their masters’]{strong=“H113”} \w houses| strong="H1004" \w* \w with violence| strong="H2555" \w* \w and deceit| strong="H4820" \w*. 
\v 10 \w And it shall come to pass in that day| strong="H3117" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, that there shall be \w the noise| strong="H6963" \w* \w of a cry| strong="H6818" \w* \w from the fish| strong="H1709" \w* \w gate| strong="H8179" \w*, \w and an howling| strong="H3215" \w* \w from the second| strong="H4932" \w*, \w and a great| strong="H1419" \w* \w crashing| strong="H7667" \w* \w from the hills| strong="H1389" \w*. 
\v 11 [Howl]{strong=“H3213” x-morph=“strongMorph: \sc Th\sc*8685”}, [ye inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of Maktesh| strong="H4389" \w*, \w for all the merchant| strong="H3667" \w* \w people| strong="H5971" \w* [are cut down]{strong=“H1820” x-morph=“strongMorph: \sc Th\sc*8738”}; \w all they that bear| strong="H5187" \w* \w silver| strong="H3701" \w* [are cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8738”}. 
\v 12 \w And it shall come to pass at that time| strong="H6256" \w*, that [I will search]{strong=“H2664” x-morph=“strongMorph: \sc Th\sc*8762”} \w Jerusalem| strong="H3389" \w* \w with candles| strong="H5216" \w*, [and punish]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} \w the men| strong="H582" \w* [that are settled]{strong=“H7087” x-morph=“strongMorph: \sc Th\sc*8802”} \w on their lees| strong="H8105" \w*: [that say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} \w in their heart| strong="H3824" \w*, The \sc Lord\sc* [will not do good]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8686”}, [neither will he do evil]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8686”}.\f + \fr 1:12 \ft settled: Heb. curded, or, thickened \f* 
\v 13 \w Therefore their goods| strong="H2428" \w* \w shall become a booty| strong="H4933" \w*, \w and their houses| strong="H1004" \w* \w a desolation| strong="H8077" \w*: [they shall also build]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w houses| strong="H1004" \w*, [but not inhabit]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} them; [and they shall plant]{strong=“H5193” x-morph=“strongMorph: \sc Th\sc*8804”} \w vineyards| strong="H3754" \w*, [but not drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w the wine| strong="H3196" \w* thereof. 
\p
\v 14 \w The great| strong="H1419" \w* \w day| strong="H3117" \w* of the \sc Lord\sc* is \w near| strong="H7138" \w*, it is \w near| strong="H7138" \w*, \w and hasteth| strong="H4118" \w* \w greatly| strong="H3966" \w*, even \w the voice| strong="H6963" \w* \w of the day| strong="H3117" \w* of the \sc Lord\sc*: \w the mighty man| strong="H1368" \w* [shall cry]{strong=“H6873” x-morph=“strongMorph: \sc Th\sc*8802”} \w there bitterly| strong="H4751" \w*. 
\v 15 \w That day| strong="H3117" \w* is \w a day| strong="H3117" \w* \w of wrath| strong="H5678" \w*, \w a day| strong="H3117" \w* \w of trouble| strong="H6869" \w* \w and distress| strong="H4691" \w*, \w a day| strong="H3117" \w* \w of wasteness| strong="H7722" \w* \w and desolation| strong="H4875" \w*, \w a day| strong="H3117" \w* \w of darkness| strong="H2822" \w* \w and gloominess| strong="H653" \w*, \w a day| strong="H3117" \w* \w of clouds| strong="H6051" \w* \w and thick darkness| strong="H6205" \w*, 
\v 16 \w A day| strong="H3117" \w* \w of the trumpet| strong="H7782" \w* \w and alarm| strong="H8643" \w* [against the fenced]{strong=“H1219” x-morph=“strongMorph: \sc Th\sc*8803”} \w cities| strong="H5892" \w*, \w and against the high| strong="H1364" \w* \w towers| strong="H6438" \w*. 
\v 17 [And I will bring distress]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8689”} \w upon men| strong="H120" \w*, [that they shall walk]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”} \w like blind men| strong="H5787" \w*, [because they have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} against the \sc Lord\sc*: \w and their blood| strong="H1818" \w* [shall be poured out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8795”} \w as dust| strong="H6083" \w*, \w and their flesh| strong="H3894" \w* \w as the dung| strong="H1561" \w*. 
\v 18 \w Neither their silver| strong="H3701" \w* \w nor their gold| strong="H2091" \w* [shall be able]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [to deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8687”} \w them in the day| strong="H3117" \w* of the \sc Lord\sc*’S \w wrath| strong="H5678" \w*; \w but the whole land| strong="H776" \w* [shall be devoured]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8735”} \w by the fire| strong="H784" \w* \w of his jealousy| strong="H7068" \w*: [for he shall make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [even a speedy]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8737”} \w riddance| strong="H3617" \w* [of all them that dwell]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the land| strong="H776" \w*. 
\c 2
\p 
\v 1 [Gather yourselves together]{strong=“H7197” x-morph=“strongMorph: \sc Th\sc*8703”}, [yea, gather together]{strong=“H7197” x-morph=“strongMorph: \sc Th\sc*8798”}, \w O nation| strong="H1471" \w* [not desired]{strong=“H3700” x-morph=“strongMorph: \sc Th\sc*8737”};\f + \fr 2:1 \ft not…: or, not desirous \f* 
\v 2 \w Before the decree| strong="H2706" \w* [bring forth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8800”}, before \w the day| strong="H3117" \w* [pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w as the chaff| strong="H4671" \w*, \w before| strong="H3808" \w* \w the fierce| strong="H2740" \w* \w anger| strong="H639" \w* of the \sc Lord\sc* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [upon you, before the day]{strong=“H3117”} of the \sc Lord\sc*’S \w anger| strong="H639" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} upon you. 
\v 3 [Seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8761”} ye the \sc Lord\sc*, \w all ye meek| strong="H6035" \w* \w of the earth| strong="H776" \w*, [which have wrought]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8804”} \w his judgment| strong="H4941" \w*; [seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8761”} \w righteousness| strong="H6664" \w*, [seek]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8761”} \w meekness| strong="H6038" \w*: \w it may be| strong="H194" \w* [ye shall be hid]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the day| strong="H3117" \w* of the \sc Lord\sc*’S \w anger| strong="H639" \w*. 
\p
\v 4 \w For Gaza| strong="H5804" \w* [shall be forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8803”}, \w and Ashkelon| strong="H831" \w* \w a desolation| strong="H8077" \w*: [they shall drive out]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8762”} \w Ashdod| strong="H795" \w* \w at the noon day| strong="H6672" \w*, \w and Ekron| strong="H6138" \w* [shall be rooted up]{strong=“H6131” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 5 \w Woe| strong="H1945" \w* [unto the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of the sea| strong="H3220" \w* \w coast| strong="H2256" \w*, \w the nation| strong="H1471" \w* \w of the Cherethites| strong="H3774" \w*! \w the word| strong="H1697" \w* of the \sc Lord\sc* is [against you; O Canaan]{strong=“H3667”}, \w the land| strong="H776" \w* \w of the Philistines| strong="H6430" \w*, [I will even destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8689”} [thee, that there shall be no inhabitant]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 6 \w And the sea| strong="H3220" \w* \w coast| strong="H2256" \w* \w shall be dwellings| strong="H5116" \w* and \w cottages| strong="H3741" \w* [for shepherds]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”}, \w and folds| strong="H1448" \w* \w for flocks| strong="H6629" \w*. 
\v 7 \w And the coast| strong="H2256" \w* \w shall be for the remnant| strong="H7611" \w* \w of the house| strong="H1004" \w* \w of Judah| strong="H3063" \w*; [they shall feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} [thereupon: in the houses]{strong=“H1004”} \w of Ashkelon| strong="H831" \w* [shall they lie down]{strong=“H7257” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the evening| strong="H6153" \w*: for the \sc Lord\sc* \w their God| strong="H430" \w* [shall visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and turn away]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8804”} [their captivity]{strong=“H7622 H7622” x-morph=“strongMorph: \sc Th\sc*8675”}.^\sc 2:7 for the [Lord\sc*: or, when, etc] 
\p
\v 8 [I have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the reproach| strong="H2781" \w* \w of Moab| strong="H4124" \w*, \w and the revilings| strong="H1421" \w* \w of the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w*, [whereby they have reproached]{strong=“H2778” x-morph=“strongMorph: \sc Th\sc*8765”} \w my people| strong="H5971" \w*, [and magnified]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8686”} themselves \w against their border| strong="H1366" \w*. 
\v 9 Therefore as \w I live| strong="H2416" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc* \w of hosts| strong="H6635" \w*, \w the God| strong="H430" \w* \w of Israel| strong="H3478" \w*, \w Surely Moab| strong="H4124" \w* \w shall be as Sodom| strong="H5467" \w*, \w and the children| strong="H1121" \w* \w of Ammon| strong="H5983" \w* \w as Gomorrah| strong="H6017" \w*, even \w the breeding| strong="H4476" \w* \w of nettles| strong="H2738" \w*, [and saltpits]{strong=“H4417 H4379”}, [and a perpetual]{strong=“H5769 H5704”} \w desolation| strong="H8077" \w*: \w the residue| strong="H7611" \w* \w of my people| strong="H5971" \w* [shall spoil]{strong=“H962” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and the remnant]{strong=“H3499”} \w of my people| strong="H1471" \w* [shall possess]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8799”} them. 
\v 10 \w This shall they have for their pride| strong="H1347" \w*, [because they have reproached]{strong=“H2778” x-morph=“strongMorph: \sc Th\sc*8765”} [and magnified]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8686”} themselves \w against the people| strong="H5971" \w* of the \sc Lord\sc* \w of hosts| strong="H6635" \w*. 
\v 11 The \sc Lord\sc* will be [terrible]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”} [unto them: for he will famish]{strong=“H7329” x-morph=“strongMorph: \sc Th\sc*8804”} \w all the gods| strong="H430" \w* \w of the earth| strong="H776" \w*; and men [shall worship]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} [him, every one]{strong=“H376”} \w from his place| strong="H4725" \w*, even \w all the isles| strong="H339" \w* \w of the heathen| strong="H1471" \w*.\f + \fr 2:11 \ft famish: Heb. make lean \f* 
\p
\v 12 \w Ye Ethiopians| strong="H3569" \w* [also, ye]{strong=“H1992”} shall be \w slain| strong="H2491" \w* \w by my sword| strong="H2719" \w*. 
\v 13 [And he will stretch out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8799”} \w his hand| strong="H3027" \w* \w against the north| strong="H6828" \w*, [and destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8762”} \w Assyria| strong="H804" \w*; [and will make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w Nineveh| strong="H5210" \w* \w a desolation| strong="H8077" \w*, and \w dry| strong="H6723" \w* \w like a wilderness| strong="H4057" \w*. 
\v 14 \w And flocks| strong="H5739" \w* [shall lie down]{strong=“H7257” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the midst| strong="H8432" \w* [of her, all the beasts]{strong=“H2416”} \w of the nations| strong="H1471" \w*: \w both the cormorant| strong="H6893" \w* \w and the bittern| strong="H7090" \w* [shall lodge]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the upper lintels| strong="H3730" \w* of it; their \w voice| strong="H6963" \w* [shall sing]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8787”} \w in the windows| strong="H2474" \w*; \w desolation| strong="H2721" \w* shall be \w in the thresholds| strong="H5592" \w*: [for he shall uncover]{strong=“H6168” x-morph=“strongMorph: \sc Th\sc*8765”} \w the cedar work| strong="H731" \w*.\f + \fr 2:14 \ft cormorant: or, pelican \f* \f + \fr 2:14 \ft upper…: or, knops, or, chapiters \f* \f + \fr 2:14 \ft for…: or, when he hath uncovered \f* 
\v 15 This is \w the rejoicing| strong="H5947" \w* \w city| strong="H5892" \w* [that dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w carelessly| strong="H983" \w*, [that said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} \w in her heart| strong="H3824" \w*, I am, and there is \w none beside| strong="H657" \w* [me: how is she become a desolation]{strong=“H8047”}, \w a place for beasts| strong="H2416" \w* \w to lie down in| strong="H4769" \w*! [every one that passeth by]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} [her shall hiss]{strong=“H8319” x-morph=“strongMorph: \sc Th\sc*8799”}, and [wag]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8686”} \w his hand| strong="H3027" \w*.
\c 3
\p 
\v 1 \w Woe| strong="H1945" \w* [to her that is filthy]{strong=“H4754” x-morph=“strongMorph: \sc Th\sc*8802”} [and polluted]{strong=“H1351” x-morph=“strongMorph: \sc Th\sc*8737”}, [to the oppressing]{strong=“H3238” x-morph=“strongMorph: \sc Th\sc*8802”} \w city| strong="H5892" \w*!\f + \fr 3:1 \ft her…: or, gluttonous: Heb. craw \f* 
\v 2 [She obeyed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the voice| strong="H6963" \w*; [she received]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w not correction| strong="H4148" \w*; [she trusted]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”} not in the \sc Lord\sc*; [she drew not near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8804”} \w to her God| strong="H430" \w*.\f + \fr 3:2 \ft correction: or, instruction \f* 
