\c 1
\p 
\v 1 \w The vision| strong="H2377" \w* \w of Obadiah| strong="H5662" \w*. [Thus saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w the Lord| strong="H136" \w* \sc God\sc* \w concerning Edom| strong="H123" \w*; [We have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w a rumour| strong="H8052" \w* from the \sc Lord\sc*, \w and an ambassador| strong="H6735" \w* [is sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8795”} \w among the heathen| strong="H1471" \w*, [Arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8798”} [ye, and let us rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w against her in battle| strong="H4421" \w*. 
\v 2 [Behold, I have made]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee small| strong="H6996" \w* \w among the heathen| strong="H1471" \w*: \w thou art greatly| strong="H3966" \w* [despised]{strong=“H959” x-morph=“strongMorph: \sc Th\sc*8803”}. 
\p
\v 3 \w The pride| strong="H2087" \w* \w of thine heart| strong="H3820" \w* [hath deceived]{strong=“H5377” x-morph=“strongMorph: \sc Th\sc*8689”} [thee, thou that dwellest]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the clefts| strong="H2288" \w* \w of the rock| strong="H5553" \w*, [whose habitation]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8800”} is \w high| strong="H4791" \w*; [that saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} \w in his heart| strong="H3820" \w*, [Who shall bring me down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8686”} \w to the ground| strong="H776" \w*? 
\v 4 [Though thou exalt]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8686”} thyself \w as the eagle| strong="H5404" \w*, [and though thou set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w thy nest| strong="H7064" \w* \w among the stars| strong="H3556" \w*, [thence will I bring thee down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8686”}, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*. 
\v 5 \w If thieves| strong="H1590" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to thee, if robbers]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8802”} \w by night| strong="H3915" \w*, ([how art thou cut off]{strong=“H1820” x-morph=“strongMorph: \sc Th\sc*8738”}!) [would they not have stolen]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8799”} \w till they had enough| strong="H1767" \w*? [if the grapegatherers]{strong=“H1219” x-morph=“strongMorph: \sc Th\sc*8802”} [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [to thee, would they not leave]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8686”} some \w grapes| strong="H5955" \w*?\f + \fr 1:5 \ft some…: or, gleanings? \f* 
\v 6 How are the things \w of Esau| strong="H6215" \w* [searched out]{strong=“H2664” x-morph=“strongMorph: \sc Th\sc*8738”}! how \w are his hidden| strong="H4710" \w* [things sought up]{strong=“H1158” x-morph=“strongMorph: \sc Th\sc*8738”}! 
\v 7 \w All the men| strong="H582" \w* \w of thy confederacy| strong="H1285" \w* [have brought]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} thee even \w to the border| strong="H1366" \w*: \w the men| strong="H582" \w* \w that were at peace| strong="H7965" \w* [with thee have deceived]{strong=“H5377” x-morph=“strongMorph: \sc Th\sc*8689”} thee, and [prevailed]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8804”} against thee; they that eat \w thy bread| strong="H3899" \w* [have laid]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w a wound| strong="H4204" \w* under thee: there is \w none understanding| strong="H8394" \w* in him.\f + \fr 1:7 \ft that were…: Heb. of thy peace \f* \f + \fr 1:7 \ft they…: Heb. the men of thy bread \f* \f + \fr 1:7 \ft in him: or, of it \f* 
\v 8 \w Shall I not in that day| strong="H3117" \w*, [saith]{strong=“H5002” x-morph=“strongMorph: \sc Th\sc*8803”} the \sc Lord\sc*, [even destroy]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8689”} \w the wise| strong="H2450" \w* men \w out of Edom| strong="H123" \w*, \w and understanding| strong="H8394" \w* \w out of the mount| strong="H2022" \w* \w of Esau| strong="H6215" \w*? 
\v 9 \w And thy mighty| strong="H1368" \w* men, \w O Teman| strong="H8487" \w*, [shall be dismayed]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8804”}, \w to the end that every one| strong="H376" \w* \w of the mount| strong="H2022" \w* \w of Esau| strong="H6215" \w* [may be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8735”} \w by slaughter| strong="H6993" \w*. 
\p
\v 10 For thy \w violence| strong="H2555" \w* \w against thy brother| strong="H251" \w* \w Jacob| strong="H3290" \w* \w shame| strong="H955" \w* [shall cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} [thee, and thou shalt be cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8738”} \w for ever| strong="H5769" \w*. 
\v 11 \w In the day| strong="H3117" \w* [that thou stoodest]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8800”} [on the other side, in the day]{strong=“H3117”} [that the strangers]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} [carried away captive]{strong=“H7617” x-morph=“strongMorph: \sc Th\sc*8800”} \w his forces| strong="H2428" \w*, \w and foreigners| strong="H5237" \w* [entered]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} \w into his gates| strong="H8179" \w*, [and cast]{strong=“H3032” x-morph=“strongMorph: \sc Th\sc*8804”} \w lots| strong="H1486" \w* \w upon Jerusalem| strong="H3389" \w*, even thou wast \w as one| strong="H259" \w* of them.\f + \fr 1:11 \ft captive…: or, his substance \f* 
\v 12 [But thou shouldest not have looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w on the day| strong="H3117" \w* \w of thy brother| strong="H251" \w* \w in the day| strong="H3117" \w* \w that he became a stranger| strong="H5235" \w*; [neither shouldest thou have rejoiced]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} \w over the children| strong="H1121" \w* \w of Judah| strong="H3063" \w* \w in the day| strong="H3117" \w* [of their destruction]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8800”}; \w neither shouldest thou have spoken| strong="H6310" \w* [proudly]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8686”} \w in the day| strong="H3117" \w* \w of distress| strong="H6869" \w*.\f + \fr 1:12 \ft spoken…: Heb. magnified thy mouth \f* 
\v 13 [Thou shouldest not have entered]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into the gate| strong="H8179" \w* \w of my people| strong="H5971" \w* \w in the day| strong="H3117" \w* \w of their calamity| strong="H343" \w*; [yea, thou shouldest not have looked]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w on their affliction| strong="H7451" \w* \w in the day| strong="H3117" \w* \w of their calamity| strong="H343" \w*, [nor have laid]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} hands \w on their substance| strong="H2428" \w* \w in the day| strong="H3117" \w* \w of their calamity| strong="H343" \w*;\f + \fr 1:13 \ft substance: or, forces \f* 
\v 14 [Neither shouldest thou have stood]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the crossway| strong="H6563" \w*, [to cut off]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8687”} \w those of his that did escape| strong="H6412" \w*; [neither shouldest thou have delivered up]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8686”} \w those of his that did remain| strong="H8300" \w* \w in the day| strong="H3117" \w* \w of distress| strong="H6869" \w*.\f + \fr 1:14 \ft delivered up: or, shut up \f* 
\v 15 \w For the day| strong="H3117" \w* of the \sc Lord\sc* is \w near| strong="H7138" \w* \w upon all the heathen| strong="H1471" \w*: [as thou hast done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}, [it shall be done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8735”} [unto thee: thy reward]{strong=“H1576”} [shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon thine own head| strong="H7218" \w*. 
\v 16 [For as ye have drunk]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon my holy| strong="H6944" \w* \w mountain| strong="H2022" \w*, so \w shall all the heathen| strong="H1471" \w* [drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w continually| strong="H8548" \w*, [yea, they shall drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8804”}, [and they shall swallow down]{strong=“H3886” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and they shall be as though they had not| strong="H3808" \w* been.\f + \fr 1:16 \ft swallow…: or, sup up \f* 
\p
