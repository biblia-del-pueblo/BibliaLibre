\c 8
\p 
\v 1 [When]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”} [was come down]{strong=“G2597” x-morph=“robinson: V-2\sc Aap\sc*-\sc Dsm\sc* 1”} [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 4”} [the mountain]{strong=“G3588 G3735” x-morph=“robinson: T-\sc Gsn\sc* robinson: N-\sc Gsn\sc* 5 6”}, [great]{strong=“G4183” x-morph=“robinson: A-\sc Npm\sc* 10”} [multitudes]{strong=“G3793” x-morph=“robinson: N-\sc Npm\sc* 9”} [followed]{strong=“G190” x-morph=“robinson: V-\sc Aai\sc*-3P 7”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 8”}. 
