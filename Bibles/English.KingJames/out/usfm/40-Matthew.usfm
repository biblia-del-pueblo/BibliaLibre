\p
\v 36 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [cometh]{strong=“G2064” x-morph=“robinson: V-\sc Pni\sc*-3S 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 3”} [them]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 4”} [unto]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 7”} [a place]{strong=“G5564” x-morph=“robinson: N-\sc Asn\sc* 8”} [called]{strong=“G3004” x-morph=“robinson: V-\sc Ppp\sc*-\sc Asn\sc* 9”} [Gethsemane]{strong=“G1068” x-morph=“robinson: N-\sc Pri\sc* 10”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 12”} [unto the disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 13 14”}, \wj Sit ye here, while I go and pray yonder.\wj* 
\v 37 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he took with him]{strong=“G3880” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”} [Peter]{strong=“G3588 G4074” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 3 4”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [the]{strong=“G5207” x-morph=“robinson: N-\sc Apm\sc* 8”} [two]{strong=“G1417” x-morph=“robinson: A-\sc Nui\sc* 7”} [sons]{strong=“G5207” x-morph=“robinson: N-\sc Apm\sc* 8”} [of Zebedee]{strong=“G2199” x-morph=“robinson: N-\sc Gsm\sc* 9”}, [and began]{strong=“G756” x-morph=“robinson: V-\sc Adi\sc*-3S 10”} [to be sorrowful]{strong=“G3076” x-morph=“robinson: V-\sc Ppn\sc* 11”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”} [very heavy]{strong=“G85” x-morph=“robinson: V-\sc Pan\sc* 13”}. 
\v 38 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [saith he]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj My soul is exceeding sorrowful, even unto death: tarry ye here, and watch with me.\wj* 
\v 39 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he went]{strong=“G4281” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”} [a little further]{strong=“G3397” x-morph=“robinson: A-\sc Asm\sc* 3”}, [and fell]{strong=“G4098” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [on]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 5”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 7”} [face]{strong=“G4383” x-morph=“robinson: N-\sc Asn\sc* 6”}, [and prayed]{strong=“G4336” x-morph=“robinson: V-\sc Pnp\sc*-\sc Nsm\sc* 8”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 10”}, \wj O my Father, if it be possible, let this cup pass from me: nevertheless not as I will, but as thou wilt.\wj* 
\v 40 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he cometh]{strong=“G2064” x-morph=“robinson: V-\sc Pni\sc*-3S 2”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [the disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 4 5”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [findeth]{strong=“G2147” x-morph=“robinson: V-\sc Pai\sc*-3S 7”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 8”} [asleep]{strong=“G2518” x-morph=“robinson: V-\sc Pap\sc*-\sc Apm\sc* 9”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 11”} [unto Peter]{strong=“G3588 G4074” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 12 13”}, \wj What, could ye not watch with me one hour?\wj* 
\v 41 \wj Watch and pray, that ye enter not into temptation: the spirit indeed is willing, but the flesh is weak.\wj* 
\v 42 [He went away]{strong=“G565” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 4”} [again]{strong=“G3825” x-morph=“robinson: \sc Adv\sc* 1”} [the second time]{strong=“G1208” x-morph=“robinson: A-\sc Gsn\sc* 3”}, [and prayed]{strong=“G4336” x-morph=“robinson: V-\sc Adi\sc*-3S 5”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 6”}, \wj O my Father, if this cup may not pass away from me, except I drink it, thy will be done.\wj* 
\v 43 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he came]{strong=“G2064” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”} [and found]{strong=“G2147” x-morph=“robinson: V-\sc Pai\sc*-3S 3”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 4”} [asleep]{strong=“G2518” x-morph=“robinson: V-\sc Pap\sc*-\sc Apm\sc* 6”} [again]{strong=“G3825” x-morph=“robinson: \sc Adv\sc* 5”}: [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 8”} [their]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 9”} [eyes]{strong=“G3588 G3788” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 10 11”} [were]{strong=“G2258” x-morph=“robinson: V-IXI-3P 7”} [heavy]{strong=“G916” x-morph=“robinson: V-\sc Rpp\sc*-\sc Npm\sc* 12”}. 
\v 44 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he left]{strong=“G863” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 3”}, [and went away]{strong=“G565” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 4”} [again]{strong=“G3825” x-morph=“robinson: \sc Adv\sc* 5”}, [and prayed]{strong=“G4336” x-morph=“robinson: V-\sc Adi\sc*-3S 6”} [the third time]{strong=“G5154” x-morph=“robinson: A-\sc Gsn\sc* 8”}, [saying]{strong=“G2036” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 12”} [the]{strong=“G3056” x-morph=“robinson: N-\sc Asm\sc* 11”} [same]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 10”} [words]{strong=“G3056” x-morph=“robinson: N-\sc Asm\sc* 11”}. 
\v 45 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [cometh he]{strong=“G2064” x-morph=“robinson: V-\sc Pni\sc*-3S 2”} [to]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 6”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 4 5”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 8”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 9”}, \wj Sleep on now, and take your rest: behold, the hour is at hand, and the Son of man is betrayed into the hands of sinners.\wj* 
\v 46 \wj Rise, let us be going: behold, he is at hand that doth betray me.\wj* 
\p
\v 47 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [while]{strong=“G2980” x-morph=“robinson: V-\sc Pap\sc*-\sc Gsm\sc* 4”} [he]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 3”} [yet]{strong=“G2089” x-morph=“robinson: \sc Adv\sc* 2”} [spake]{strong=“G2980” x-morph=“robinson: V-\sc Pap\sc*-\sc Gsm\sc* 4”}, [lo]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 5”}, [Judas]{strong=“G2455” x-morph=“robinson: N-\sc Nsm\sc* 6”}, [one]{strong=“G1520” x-morph=“robinson: A-\sc Nsm\sc* 7”} [of the twelve]{strong=“G1427” x-morph=“robinson: A-\sc Nui\sc* 9”}, [came]{strong=“G2064” x-morph=“robinson: V-2\sc Aai\sc*-3S 10”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 12”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 13”} [a]{strong=“G3793” x-morph=“robinson: N-\sc Nsm\sc* 14”} [great]{strong=“G4183” x-morph=“robinson: A-\sc Nsm\sc* 15”} [multitude]{strong=“G3793” x-morph=“robinson: N-\sc Nsm\sc* 14”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 16”} [swords]{strong=“G3162” x-morph=“robinson: N-\sc Gpf\sc* 17”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 18”} [staves]{strong=“G3586” x-morph=“robinson: N-\sc Gpn\sc* 19”}, [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 20”} [the chief priests]{strong=“G3588 G749” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 21 22”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 23”} [elders]{strong=“G4245” x-morph=“robinson: A-\sc Gpm\sc* 24”} [of the people]{strong=“G3588 G2992” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 25 26”}. 
\v 48 [Now]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he that betrayed]{strong=“G3860” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 3”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 4”} [gave]{strong=“G1325” x-morph=“robinson: V-\sc Aai\sc*-3S 5”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 6”} [a sign]{strong=“G4592” x-morph=“robinson: N-\sc Asn\sc* 7”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 8”}, [Whomsoever]{strong=“G3739” x-morph=“robinson: R-\sc Asm\sc* 9”} [I shall kiss]{strong=“G5368” x-morph=“robinson: V-\sc Aas\sc*-1S 11”}, [that same]{strong=“G846” x-morph=“robinson: P-\sc Nsm\sc* 12”} [is he]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 13”}: [hold]{strong=“G2902” x-morph=“robinson: V-\sc Aam\sc*-2P 14”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 15”} [fast]{strong=“G2902” x-morph=“robinson: V-\sc Aam\sc*-2P 14”}. 
\v 49 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [forthwith]{strong=“G2112” x-morph=“robinson: \sc Adv\sc* 2”} [he came to]{strong=“G4334” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 3”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 4 5”}, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 6”}, [Hail]{strong=“G5463” x-morph=“robinson: V-\sc Pam\sc*-2S 7”}, [master]{strong=“G4461” x-morph=“robinson: \sc Heb\sc* 8”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [kissed]{strong=“G2705” x-morph=“robinson: V-\sc Aai\sc*-3S 10”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 11”}. 
\v 50 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 3”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 5”}, \wj Friend, wherefore art thou come?\wj* [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 10”} came they, [and laid]{strong=“G1911” x-morph=“robinson: V-2\sc Aai\sc*-3P 12”} [hands]{strong=“G3588 G5495” x-morph=“robinson: T-\sc Apf\sc* robinson: N-\sc Apf\sc* 13 14”} [on]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 15”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 16 17”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 18”} [took]{strong=“G2902” x-morph=“robinson: V-\sc Aai\sc*-3P 19”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 20”}. 
\v 51 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”}, [behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 2”}, [one]{strong=“G1520” x-morph=“robinson: A-\sc Nsm\sc* 3”} [of them which were]{strong=“G3588” x-morph=“robinson: T-\sc Gpm\sc* 4”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 5”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Gsm\sc* 6”} [stretched out]{strong=“G1614” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsf\sc* 7”} his [hand]{strong=“G3588 G5495” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 8 9”}, [and drew]{strong=“G645” x-morph=“robinson: V-\sc Aai\sc*-3S 10”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 13”} [sword]{strong=“G3588 G3162” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 11 12”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [struck]{strong=“G3960” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 15”} [a servant]{strong=“G3588 G1401” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 16 17”} [of the high priest’s]{strong=“G3588 G749” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 18 19”}, [and smote off]{strong=“G851” x-morph=“robinson: V-2\sc Aai\sc*-3S 20”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 21”} [ear]{strong=“G3588 G5621” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 22 23”}. 
\v 52 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”}, \wj Put up again thy sword into his place: for all they that take the sword shall perish with the sword.\wj* 
\v 53 \wj Thinkest thou that I cannot now pray to my Father, and he shall presently give me more than twelve legions of angels?\wj* 
\v 54 \wj But how then shall the scriptures be fulfilled, that thus it must be?\wj* 
\v 55 [In]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 1”} [that same]{strong=“G1565” x-morph=“robinson: D-\sc Dsf\sc* 2”} [hour]{strong=“G3588 G5610” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 3 4”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 6 7”} [to the multitudes]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 8 9”}, \wj Are ye come out as against a thief with swords and staves for to take me? I sat daily with you teaching in the temple, and ye laid no hold on me.\wj* 
\v 56 \wj But all this was done, that the scriptures of the prophets might be fulfilled.\wj* [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 11”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Npm\sc* 14”} [the disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 12 13”} [forsook]{strong=“G863” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 15”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 16”}, [and fled]{strong=“G5343” x-morph=“robinson: V-2\sc Aai\sc*-3P 17”}. 
\p
\v 57 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [they that had laid hold on]{strong=“G2902” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 3”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 4 5”} [led]{strong=“G520” x-morph=“robinson: V-2\sc Aai\sc*-3P 6”} him [away]{strong=“G520” x-morph=“robinson: V-2\sc Aai\sc*-3P 6”} [to]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 7”} [Caiaphas]{strong=“G2533” x-morph=“robinson: N-\sc Asm\sc* 8”} [the high priest]{strong=“G3588 G749” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 9 10”}, [where]{strong=“G3699” x-morph=“robinson: \sc Adv\sc* 11”} [the scribes]{strong=“G3588 G1122” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 12 13”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [the elders]{strong=“G4245” x-morph=“robinson: A-\sc Npm\sc* 16”} [were assembled]{strong=“G4863” x-morph=“robinson: V-\sc Api\sc*-3P 17”}. 
