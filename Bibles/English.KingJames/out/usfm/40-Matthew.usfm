\v 1 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he entered]{strong=“G1684” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 3”} [a ship]{strong=“G3588 G4143” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 4 5”}, [and passed over]{strong=“G1276” x-morph=“robinson: V-\sc Aai\sc*-3S 6”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [came]{strong=“G2064” x-morph=“robinson: V-2\sc Aai\sc*-3S 8”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 9”} [his own]{strong=“G2398” x-morph=“robinson: A-\sc Asf\sc* 11”} [city]{strong=“G4172” x-morph=“robinson: N-\sc Asf\sc* 12”}. 
\v 2 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”}, [behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 2”}, [they brought]{strong=“G4374” x-morph=“robinson: V-\sc Iai\sc*-3P 3”} [to him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 4”} [a man sick of the palsy]{strong=“G3885” x-morph=“robinson: A-\sc Asm\sc* 5”}, [lying]{strong=“G906” x-morph=“robinson: V-\sc Rpp\sc*-\sc Asm\sc* 8”} [on]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 6”} [a bed]{strong=“G2825” x-morph=“robinson: N-\sc Gsf\sc* 7”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 11 12”} [seeing]{strong=“G1492” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 10”} [their]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 15”} [faith]{strong=“G3588 G4102” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 13 14”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 16”} [unto the sick of the palsy]{strong=“G3885” x-morph=“robinson: A-\sc Dsm\sc* 18”}; \wj Son, be of good cheer; thy sins be forgiven thee.\wj* 
\v 3 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”}, [behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 2”}, [certain]{strong=“G5100” x-morph=“robinson: X-\sc Npm\sc* 3”} [of the scribes]{strong=“G3588 G1122” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 4 5”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 6”} [within]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 7”} [themselves]{strong=“G1438” x-morph=“robinson: F-3\sc Dpm\sc* 8”}, [This]{strong=“G3778” x-morph=“robinson: D-\sc Nsm\sc* 9”} man [blasphemeth]{strong=“G987” x-morph=“robinson: V-\sc Pai\sc*-3S 10”}. 
\v 4 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [knowing]{strong=“G1492” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”} [their]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 7”} [thoughts]{strong=“G3588 G1761” x-morph=“robinson: T-\sc Apf\sc* robinson: N-\sc Apf\sc* 5 6”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 8”}, \wj Wherefore think ye evil in your hearts?\wj* 
\v 5 \wj For whether is easier, to say, Thy sins be forgiven thee; or to say, Arise, and walk?\wj* 
\v 6 \wj But that ye may know that the Son of man hath power on earth to forgive sins,\wj* ([then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 16”} [saith he]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 17”} [to the sick of the palsy]{strong=“G3885” x-morph=“robinson: A-\sc Dsm\sc* 19”},) \wj Arise, take up thy bed, and go unto thine house.\wj* 
\v 7 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he arose]{strong=“G1453” x-morph=“robinson: V-\sc App\sc*-\sc Nsm\sc* 2”}, [and departed]{strong=“G565” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [to]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 4”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 7”} [house]{strong=“G3588 G3624” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 5 6”}. 
\v 8 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [when]{strong=“G1492” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 1”} [the multitudes]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [saw]{strong=“G1492” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 1”} it, [they marvelled]{strong=“G2296” x-morph=“robinson: V-\sc Aai\sc*-3P 5”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [glorified]{strong=“G1392” x-morph=“robinson: V-\sc Aai\sc*-3P 7”} [God]{strong=“G3588 G2316” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 8 9”}, [which had given]{strong=“G1325” x-morph=“robinson: V-2\sc Aap\sc*-\sc Asm\sc* 11”} [such]{strong=“G5108” x-morph=“robinson: D-\sc Asf\sc* 13”} [power]{strong=“G1849” x-morph=“robinson: N-\sc Asf\sc* 12”} [unto men]{strong=“G3588 G444” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 14 15”}. 
\p
\v 9 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [as]{strong=“G3855” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [passed forth]{strong=“G3855” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 2”} [from thence]{strong=“G1564” x-morph=“robinson: \sc Adv\sc* 5”}, [he saw]{strong=“G1492” x-morph=“robinson: V-2\sc Aai\sc*-3S 6”} [a man]{strong=“G444” x-morph=“robinson: N-\sc Asm\sc* 7”}, [named]{strong=“G3004” x-morph=“robinson: V-\sc Ppp\sc*-\sc Asm\sc* 13”} [Matthew]{strong=“G3156” x-morph=“robinson: N-\sc Asm\sc* 12”}, [sitting]{strong=“G2521” x-morph=“robinson: V-\sc Pnp\sc*-\sc Asm\sc* 8”} [at]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 9”} [the receipt of custom]{strong=“G3588 G5058” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 10 11”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [he saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 15”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 16”}, \wj Follow me.\wj* [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 19”} [he arose, and]{strong=“G450” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 20”} [followed]{strong=“G190” x-morph=“robinson: V-\sc Aai\sc*-3S 21”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 22”}. 
\p
\v 10 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [it came to pass]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 2”}, [as]{strong=“G345” x-morph=“robinson: V-\sc Pnp\sc*-\sc Gsm\sc* 4”} [Jesus]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 3”} [sat at meat]{strong=“G345” x-morph=“robinson: V-\sc Pnp\sc*-\sc Gsm\sc* 4”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 5”} [the house]{strong=“G3588 G3614” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 6 7”}, [behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 9”}, [many]{strong=“G4183” x-morph=“robinson: A-\sc Npm\sc* 10”} [publicans]{strong=“G5057” x-morph=“robinson: N-\sc Npm\sc* 11”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”} [sinners]{strong=“G268” x-morph=“robinson: A-\sc Npm\sc* 13”} [came and]{strong=“G2064” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 14”} [sat down with]{strong=“G4873” x-morph=“robinson: V-\sc Ini\sc*-3P 15”} [him]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 16 17”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 18”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 21”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 19 20”}. 
\v 11 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when]{strong=“G1492” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 2”} [the Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [saw]{strong=“G1492” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 2”} it, [they said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 5”} [unto]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 6 7”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 8”} [disciples]{strong=“G3101” x-morph=“robinson: N-\sc Dpm\sc* 7”}, [Why]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 10”} [eateth]{strong=“G2068” x-morph=“robinson: V-\sc Pai\sc*-3S 16”} [your]{strong=“G5216” x-morph=“robinson: P-2\sc Gp\sc* 19”} [Master]{strong=“G3588 G1320” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 17 18”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 11”} [publicans]{strong=“G3588 G5057” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 12 13”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [sinners]{strong=“G268” x-morph=“robinson: A-\sc Gpm\sc* 15”}? 
\v 12 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [when]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 4”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 3”} [heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 4”} that, [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 6”}, \wj They that be whole need not a physician, but they that are sick.\wj* 
\v 13 \wj But go ye and learn what that meaneth, I will have mercy, and not sacrifice: for I am not come to call the righteous, but sinners to repentance.\wj* 
\p
\v 14 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [came to]{strong=“G4334” x-morph=“robinson: V-\sc Pni\sc*-3P 2”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”} [the disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 4 5”} [of John]{strong=“G2491” x-morph=“robinson: N-\sc Gsm\sc* 6”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 7”}, [Why]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 9”} [do]{strong=“G3522” x-morph=“robinson: V-\sc Pai\sc*-1P 14”} [we]{strong=“G2249” x-morph=“robinson: P-1\sc Np\sc* 10”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [the Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 12 13”} [fast]{strong=“G3522” x-morph=“robinson: V-\sc Pai\sc*-1P 14”} [oft]{strong=“G4183” x-morph=“robinson: A-\sc Apn\sc* 15”}, [but]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 17”} [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 19”} [disciples]{strong=“G3101” x-morph=“robinson: N-\sc Npm\sc* 18”} [fast]{strong=“G3522” x-morph=“robinson: V-\sc Pai\sc*-3P 21”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 20”}? 
\v 15 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj Can the children of the bridechamber mourn, as long as the bridegroom is with them? but the days will come, when the bridegroom shall be taken from them, and then shall they fast.\wj* 
\v 16 \wj No man putteth a piece of new cloth unto an old garment, for that which is put in to fill it up taketh from the garment, and the rent is made worse.\wj* 
\v 17 \wj Neither do men put new wine into old bottles: else the bottles break, and the wine runneth out, and the bottles perish: but they put new wine into new bottles, and both are preserved.\wj* 
\p
\v 18 [While]{strong=“G2980” x-morph=“robinson: V-\sc Pap\sc*-\sc Gsm\sc* 3”} [he]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 2”} [spake]{strong=“G2980” x-morph=“robinson: V-\sc Pap\sc*-\sc Gsm\sc* 3”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 1”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 4”}, [behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 5”}, [there came]{strong=“G2064” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 7”} [a certain ruler]{strong=“G758” x-morph=“robinson: N-\sc Nsm\sc* 6”}, [and]{strong=“G2064” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 7”} [worshipped]{strong=“G4352” x-morph=“robinson: V-\sc Iai\sc*-3S 8”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 9”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 10”}, [My]{strong=“G3450” x-morph=“robinson: P-1\sc Gs\sc* 14”} [daughter]{strong=“G3588 G2364” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 12 13”} [is]{strong=“G5053” x-morph=“robinson: V-\sc Aai\sc*-3S 16”} [even now]{strong=“G737” x-morph=“robinson: \sc Adv\sc* 15”} [dead]{strong=“G5053” x-morph=“robinson: V-\sc Aai\sc*-3S 16”}: [but]{strong=“G235” x-morph=“robinson: \sc Conj\sc* 17”} [come and]{strong=“G2064” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 18”} [lay]{strong=“G2007” x-morph=“robinson: V-2\sc Aam\sc*-2S 19”} [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 22”} [hand]{strong=“G3588 G5495” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 20 21”} [upon]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 23”} [her]{strong=“G846” x-morph=“robinson: P-\sc Asf\sc* 24”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 25”} [she shall live]{strong=“G2198” x-morph=“robinson: V-\sc Fdi\sc*-3S 26”}. 
\v 19 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [arose, and]{strong=“G1453” x-morph=“robinson: V-\sc App\sc*-\sc Nsm\sc* 2”} [followed]{strong=“G190” x-morph=“robinson: V-\sc Aai\sc*-3S 5”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 6”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} so did [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 10”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 8 9”}. 
\p
\v 20 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”}, [behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 2”}, [a woman]{strong=“G1135” x-morph=“robinson: N-\sc Nsf\sc* 3”}, [which was diseased with an issue of blood]{strong=“G131” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsf\sc* 4”} [twelve]{strong=“G1427” x-morph=“robinson: A-\sc Nui\sc* 5”} [years]{strong=“G2094” x-morph=“robinson: N-\sc Npn\sc* 6”}, [came]{strong=“G4334” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsf\sc* 7”} [behind]{strong=“G3693” x-morph=“robinson: \sc Adv\sc* 8”} him, [and touched]{strong=“G680” x-morph=“robinson: V-\sc Adi\sc*-3S 9”} [the hem]{strong=“G3588 G2899” x-morph=“robinson: T-\sc Gsn\sc* robinson: N-\sc Gsn\sc* 10 11”} [of]{strong=“G3588 G2440” x-morph=“robinson: T-\sc Gsn\sc* robinson: N-\sc Gsn\sc* 12 13”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 14”} [garment]{strong=“G2440” x-morph=“robinson: N-\sc Gsn\sc* 13”}: 
