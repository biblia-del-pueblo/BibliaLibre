\v 14 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [if]{strong=“G1437” x-morph=“robinson: \sc Cond\sc* 2”} [this]{strong=“G5124” x-morph=“robinson: D-\sc Nsn\sc* 4”} [come]{strong=“G191” x-morph=“robinson: V-\sc Aps\sc*-3S 3”} [to]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 5”} [the governor’s]{strong=“G3588 G2232” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 6 7”} [ears]{strong=“G191” x-morph=“robinson: V-\sc Aps\sc*-3S 3”}, [we]{strong=“G2249” x-morph=“robinson: P-1\sc Np\sc* 8”} [will persuade]{strong=“G3982” x-morph=“robinson: V-\sc Fai\sc*-1P 9”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 10”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [secure]{strong=“G275” x-morph=“robinson: A-\sc Apm\sc* 13”} [you]{strong=“G5209” x-morph=“robinson: P-2\sc Ap\sc* 12”}. 
\v 15 [So]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [they]{strong=“G3588” x-morph=“robinson: T-\sc Npm\sc* 1”} [took]{strong=“G2983” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 3”} [the money]{strong=“G3588 G694” x-morph=“robinson: T-\sc Apn\sc* robinson: N-\sc Apn\sc* 4 5”}, [and did]{strong=“G4160” x-morph=“robinson: V-\sc Aai\sc*-3P 6”} [as]{strong=“G5613” x-morph=“robinson: \sc Adv\sc* 7”} [they were taught]{strong=“G1321” x-morph=“robinson: V-\sc Api\sc*-3P 8”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [this]{strong=“G3778” x-morph=“robinson: D-\sc Nsm\sc* 13”} [saying]{strong=“G3588 G3056” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 11 12”} [is commonly reported]{strong=“G1310” x-morph=“robinson: V-\sc Api\sc*-3S 10”} [among]{strong=“G3844” x-morph=“robinson: \sc Prep\sc* 14”} [the Jews]{strong=“G2453” x-morph=“robinson: A-\sc Dpm\sc* 15”} [until]{strong=“G3360” x-morph=“robinson: \sc Adv\sc* 16”} [this day]{strong=“G4594” x-morph=“robinson: \sc Adv\sc* 18”}. 
\p
\v 16 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [the]{strong=“G3101” x-morph=“robinson: N-\sc Npm\sc* 4”} [eleven]{strong=“G1733” x-morph=“robinson: A-\sc Nui\sc* 3”} [disciples]{strong=“G3101” x-morph=“robinson: N-\sc Npm\sc* 4”} [went away]{strong=“G4198” x-morph=“robinson: V-\sc Aoi\sc*-3P 5”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 6”} [Galilee]{strong=“G3588 G1056” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 7 8”}, [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 9”} [a mountain]{strong=“G3588 G3735” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 10 11”} [where]{strong=“G3757” x-morph=“robinson: \sc Adv\sc* 12”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 15 16”} [had appointed]{strong=“G5021” x-morph=“robinson: V-\sc Ami\sc*-3S 13”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 14”}. 
\v 17 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when they saw]{strong=“G1492” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 2”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 3”}, [they worshipped]{strong=“G4352” x-morph=“robinson: V-\sc Aai\sc*-3P 4”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 5”}: [but]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 7”} [some]{strong=“G3588” x-morph=“robinson: T-\sc Npm\sc* 6”} [doubted]{strong=“G1365” x-morph=“robinson: V-\sc Aai\sc*-3P 8”}. 
\v 18 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [came]{strong=“G4334” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”} [and spake]{strong=“G2980” x-morph=“robinson: V-\sc Aai\sc*-3S 5”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 6”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 7”}, \wj All power is given unto me in heaven and in earth.\wj* 
\p
\v 19 \wj Go ye therefore, and teach all nations, baptizing them in the name of the Father, and of the Son, and of the Holy Ghost:\wj* 
\v 20 \wj Teaching them to observe all things whatsoever I have commanded you: and, lo, I am with you alway, even unto the end of the world.\wj* [Amen]{strong=“G281” x-morph=“robinson: \sc Heb\sc* 22”}. 