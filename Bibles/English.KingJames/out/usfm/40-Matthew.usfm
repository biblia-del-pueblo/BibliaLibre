\v 19 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [came]{strong=“G4334” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 2”} [the disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [to Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 5 6”} [apart]{strong=“G2398” x-morph=“robinson: A-\sc Asf\sc* 8”}, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 9”}, [Why]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 11”} [could]{strong=“G1410” x-morph=“robinson: V-\sc Aoi\sc*-1P-\sc Att\sc* 14”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 13”} [we]{strong=“G2249” x-morph=“robinson: P-1\sc Np\sc* 12”} [cast]{strong=“G1544” x-morph=“robinson: V-2\sc Aan\sc* 15”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asn\sc* 16”} [out]{strong=“G1544” x-morph=“robinson: V-2\sc Aan\sc* 15”}? 
\v 20 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 3”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}, \wj Because of your unbelief: for verily I say unto you, If ye have faith as a grain of mustard seed, ye shall say unto this mountain, Remove hence to yonder place; and it shall remove; and nothing shall be impossible unto you.\wj* 
\v 21 \wj Howbeit this kind goeth not out but by prayer and fasting.\wj* 
\p
\v 22 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [while]{strong=“G390” x-morph=“robinson: V-\sc Ppp\sc*-\sc Gpm\sc* 1”} [they]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 3”} [abode]{strong=“G390” x-morph=“robinson: V-\sc Ppp\sc*-\sc Gpm\sc* 1”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 4”} [Galilee]{strong=“G3588 G1056” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 5 6”}, [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 9 10”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 7”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 8”}, \wj The Son of man shall be betrayed into the hands of men:\wj* 
\v 23 \wj And they shall kill him, and the third day he shall be raised again.\wj* [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [they were]{strong=“G3076” x-morph=“robinson: V-\sc Api\sc*-3P 10”} [exceeding]{strong=“G4970” x-morph=“robinson: \sc Adv\sc* 11”} [sorry]{strong=“G3076” x-morph=“robinson: V-\sc Api\sc*-3P 10”}. 
\p
\v 24 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [when]{strong=“G2064” x-morph=“robinson: V-2\sc Aap\sc*-\sc Gpm\sc* 1”} [they]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 3”} [were come]{strong=“G2064” x-morph=“robinson: V-2\sc Aap\sc*-\sc Gpm\sc* 1”} [to]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 4”} [Capernaum]{strong=“G2584” x-morph=“robinson: N-\sc Pri\sc* 5”}, [they that received]{strong=“G2983” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 10”} [tribute]{strong=“G3588 G1323” x-morph=“robinson: T-\sc Apn\sc* robinson: N-\sc Apn\sc* 8 9”} money [came]{strong=“G4334” x-morph=“robinson: V-\sc Aai\sc*-3P 6”} [to Peter]{strong=“G3588 G4074” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 11 12”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 13”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 14”}, [Doth]{strong=“G5055” x-morph=“robinson: V-\sc Pai\sc*-3S 19”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 18”} [your]{strong=“G5216” x-morph=“robinson: P-2\sc Gp\sc* 17”} [master]{strong=“G3588 G1320” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 15 16”} [pay]{strong=“G5055” x-morph=“robinson: V-\sc Pai\sc*-3S 19”} [tribute]{strong=“G3588 G1323” x-morph=“robinson: T-\sc Apn\sc* robinson: N-\sc Apn\sc* 20 21”}? 
\v 25 [He saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 1”}, [Yes]{strong=“G3483” x-morph=“robinson: \sc Prt\sc* 2”}. [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 3”} [when]{strong=“G3753” x-morph=“robinson: \sc Adv\sc* 4”} [he was come]{strong=“G1525” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 6”} [the house]{strong=“G3588 G3614” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 7 8”}, [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 11 12”} [prevented]{strong=“G4399” x-morph=“robinson: V-\sc Aai\sc*-3S 9”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 10”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 13”}, \wj What thinkest thou, Simon? of whom do the kings of the earth take custom or tribute? of their own children, or of strangers?\wj* 
\v 26 [Peter]{strong=“G3588 G4074” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, [Of]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 5”} [strangers]{strong=“G245” x-morph=“robinson: A-\sc Gpm\sc* 7”}. [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 10 11”} [saith]{strong=“G5346” x-morph=“robinson: V-IXI-3S 8”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 9”}, \wj Then are the children free.\wj* 
\v 27 \wj Notwithstanding, lest we should offend them, go thou to the sea, and cast an hook, and take up the fish that first cometh up; and when thou hast opened his mouth, thou shalt find a piece of money: that take, and give unto them for me and thee.\wj* 
\c 18
\p 
\v 1 [At]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 1”} [the same]{strong=“G1565” x-morph=“robinson: D-\sc Dsf\sc* 2”} [time]{strong=“G3588 G5610” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 3 4”} [came]{strong=“G4334” x-morph=“robinson: V-\sc Aai\sc*-3P 5”} [the disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 6 7”} [unto Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 8 9”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 10”}, [Who]{strong=“G5101” x-morph=“robinson: I-\sc Nsm\sc* 11”} [is]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 14”} [the greatest]{strong=“G3187” x-morph=“robinson: A-\sc Nsm\sc*-C 13”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 15”} [the kingdom]{strong=“G3588 G932” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 16 17”} [of heaven]{strong=“G3588 G3772” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 18 19”}? 
\v 2 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [called]{strong=“G4341” x-morph=“robinson: V-\sc Adp\sc*-\sc Nsm\sc* 2”} [a little child]{strong=“G3813” x-morph=“robinson: N-\sc Asn\sc* 5”} [unto him]{strong=“G4341” x-morph=“robinson: V-\sc Adp\sc*-\sc Nsm\sc* 2”}, [and set]{strong=“G2476” x-morph=“robinson: V-\sc Aai\sc*-3S 6”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asn\sc* 7”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 8”} [the midst]{strong=“G3319” x-morph=“robinson: A-\sc Dsn\sc* 9”} [of them]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 10”}, 
\v 3 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”}, \wj Verily I say unto you, Except ye be converted, and become as little children, ye shall not enter into the kingdom of heaven.\wj* 
\v 4 \wj Whosoever therefore shall humble himself as this little child, the same is greatest in the kingdom of heaven.\wj* 
\v 5 \wj And whoso shall receive one such little child in my name receiveth me.\wj* 
\v 6 \wj But whoso shall offend one of these little ones which believe in me, it were better for him that a millstone were hanged about his neck, and that he were drowned in the depth of the sea.\wj* 
\p
\v 7 \wj Woe unto the world because of offences! for it must needs be that offences come; but woe to that man by whom the offence cometh!\wj* 
\v 8 \wj Wherefore if thy hand or thy foot offend thee, cut them off, and cast them from thee: it is better for thee to enter into life halt or maimed, rather than having two hands or two feet to be cast into everlasting fire.\wj* 
\v 9 \wj And if thine eye offend thee, pluck it out, and cast it from thee: it is better for thee to enter into life with one eye, rather than having two eyes to be cast into hell fire.\wj* 
\v 10 \wj Take heed that ye despise not one of these little ones; for I say unto you, That in heaven their angels do always behold the face of my Father which is in heaven.\wj* 
\v 11 \wj For the Son of man is come to save that which was lost.\wj* 
\v 12 \wj How think ye? if a man have an hundred sheep, and one of them be gone astray, doth he not leave the ninety and nine, and goeth into the mountains, and seeketh that which is gone astray?\wj* 
\v 13 \wj And if so be that he find it, verily I say unto you, he rejoiceth more of that sheep, than of the ninety and nine which went not astray.\wj* 
\v 14 \wj Even so it is not the will of your Father which is in heaven, that one of these little ones should perish.\wj* 
\p
\v 15 \wj Moreover if thy brother shall trespass against thee, go and tell him his fault between thee and him alone: if he shall hear thee, thou hast gained thy brother.\wj* 
\v 16 \wj But if he will not hear thee, then take with thee one or two more, that in the mouth of two or three witnesses every word may be established.\wj* 
\v 17 \wj And if he shall neglect to hear them, tell it unto the church: but if he neglect to hear the church, let him be unto thee as an heathen man and a publican.\wj* 
\v 18 \wj Verily I say unto you, Whatsoever ye shall bind on earth shall be bound in heaven: and whatsoever ye shall loose on earth shall be loosed in heaven.\wj* 
\v 19 \wj Again I say unto you, That if two of you shall agree on earth as touching any thing that they shall ask, it shall be done for them of my Father which is in heaven.\wj* 
\v 20 \wj For where two or three are gathered together in my name, there am I in the midst of them.\wj* 
\p
\v 21 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [came]{strong=“G4334” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”} [Peter]{strong=“G3588 G4074” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [to him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”}, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 6”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 7”}, [how oft]{strong=“G4212” x-morph=“robinson: \sc Adv\sc* 8”} [shall]{strong=“G264” x-morph=“robinson: V-\sc Fai\sc*-3S 9”} [my]{strong=“G3450” x-morph=“robinson: P-1\sc Gs\sc* 14”} [brother]{strong=“G3588 G80” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 12 13”} [sin]{strong=“G264” x-morph=“robinson: V-\sc Fai\sc*-3S 9”} [against]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 10”} [me]{strong=“G1691” x-morph=“robinson: P-1\sc As\sc* 11”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 15”} [I forgive]{strong=“G863” x-morph=“robinson: V-\sc Fai\sc*-1S 16”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 17”}? [till]{strong=“G2193” x-morph=“robinson: \sc Conj\sc* 18”} [seven times]{strong=“G2034” x-morph=“robinson: \sc Adv\sc* 19”}? 
\v 22 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, \wj I say not unto thee, Until seven times: but, Until seventy times seven.\wj* 
\p
\v 23 \wj Therefore is the kingdom of heaven likened unto a certain king, which would take account of his servants.\wj* 
\v 24 \wj And when he had begun to reckon, one was brought unto him, which owed him ten thousand talents.\wj* 
\v 25 \wj But forasmuch as he had not to pay, his lord commanded him to be sold, and his wife, and children, and all that he had, and payment to be made.\wj* 
\v 26 \wj The servant therefore fell down, and worshipped him, saying, Lord, have patience with me, and I will pay thee all.\wj* 
\v 27 \wj Then the lord of that servant was moved with compassion, and loosed him, and forgave him the debt.\wj* 
\v 28 \wj But the same servant went out, and found one of his fellowservants, which owed him an hundred pence: and he laid hands on him, and took him by the throat, saying, Pay me that thou owest.\wj* 
\v 29 \wj And his fellowservant fell down at his feet, and besought him, saying, Have patience with me, and I will pay thee all.\wj* 
\v 30 \wj And he would not: but went and cast him into prison, till he should pay the debt.\wj* 
\v 31 \wj So when his fellowservants saw what was done, they were very sorry, and came and told unto their lord all that was done.\wj* 
\v 32 \wj Then his lord, after that he had called him, said unto him, O thou wicked servant, I forgave thee all that debt, because thou desiredst me:\wj* 
\v 33 \wj Shouldest not thou also have had compassion on thy fellowservant, even as I had pity on thee?\wj* 
\v 34 \wj And his lord was wroth, and delivered him to the tormentors, till he should pay all that was due unto him.\wj* 
\v 35 \wj So likewise shall my heavenly Father do also unto you, if ye from your hearts forgive not every one his brother their trespasses.\wj* 
\c 19
\p 
\v 1 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [it came to pass]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 2”}, that [when]{strong=“G3753” x-morph=“robinson: \sc Adv\sc* 3”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [had finished]{strong=“G5055” x-morph=“robinson: V-\sc Aai\sc*-3S 4”} [these]{strong=“G5128” x-morph=“robinson: D-\sc Apm\sc* 9”} [sayings]{strong=“G3588 G3056” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 7 8”}, [he departed]{strong=“G3332” x-morph=“robinson: V-\sc Aai\sc*-3S 10”} [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 11”} [Galilee]{strong=“G3588 G1056” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 12 13”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [came]{strong=“G2064” x-morph=“robinson: V-2\sc Aai\sc*-3S 15”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 16”} [the coasts]{strong=“G3588 G3725” x-morph=“robinson: T-\sc Apn\sc* robinson: N-\sc Apn\sc* 17 18”} [of Judaea]{strong=“G3588 G2449” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 19 20”} [beyond]{strong=“G4008” x-morph=“robinson: \sc Adv\sc* 21”} [Jordan]{strong=“G3588 G2446” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 22 23”}; 
\v 2 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [great]{strong=“G4183” x-morph=“robinson: A-\sc Npm\sc* 5”} [multitudes]{strong=“G3793” x-morph=“robinson: N-\sc Npm\sc* 4”} [followed]{strong=“G190” x-morph=“robinson: V-\sc Aai\sc*-3P 2”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [he healed]{strong=“G2323” x-morph=“robinson: V-\sc Aai\sc*-3S 7”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 8”} [there]{strong=“G1563” x-morph=“robinson: \sc Adv\sc* 9”}. 
\p
\v 3 [The Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 4 5”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [came]{strong=“G4334” x-morph=“robinson: V-\sc Aai\sc*-3P 2”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”}, [tempting]{strong=“G3985” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 6”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 7”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 9”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 10”}, [Is it]{strong=“G1487” x-morph=“robinson: \sc Cond\sc* 11”} [lawful]{strong=“G1832” x-morph=“robinson: V-\sc Pqi\sc*-3S 12”} [for a man]{strong=“G444” x-morph=“robinson: N-\sc Dsm\sc* 13”} [to put away]{strong=“G630” x-morph=“robinson: V-\sc Aan\sc* 14”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 17”} [wife]{strong=“G3588 G1135” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 15 16”} [for]{strong=“G2596” x-morph=“robinson: \sc Prep\sc* 18”} [every]{strong=“G3956” x-morph=“robinson: A-\sc Asf\sc* 19”} [cause]{strong=“G156” x-morph=“robinson: N-\sc Asf\sc* 20”}? 
\v 4 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 3”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}, \wj Have ye not read, that he which made them at the beginning made them male and female,\wj* 
\v 5 \wj And said, For this cause shall a man leave father and mother, and shall cleave to his wife: and they twain shall be one flesh?\wj* 
\v 6 \wj Wherefore they are no more twain, but one flesh. What therefore God hath joined together, let not man put asunder.\wj* 
\v 7 [They say]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3P 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, [Why]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 3”} [did]{strong=“G1781” x-morph=“robinson: V-\sc Adi\sc*-3S 6”} [Moses]{strong=“G3475” x-morph=“robinson: N-\sc Nsm\sc* 5”} [then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 4”} [command]{strong=“G1781” x-morph=“robinson: V-\sc Adi\sc*-3S 6”} [to give]{strong=“G1325” x-morph=“robinson: V-2\sc Aan\sc* 7”} [a writing]{strong=“G975” x-morph=“robinson: N-\sc Asn\sc* 8”} [of divorcement]{strong=“G647” x-morph=“robinson: N-\sc Gsn\sc* 9”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [to put]{strong=“G630” x-morph=“robinson: V-\sc Aan\sc* 11”} [her]{strong=“G846” x-morph=“robinson: P-\sc Asf\sc* 12”} [away]{strong=“G630” x-morph=“robinson: V-\sc Aan\sc* 11”}? 
\v 8 [He saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 1”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 2”}, \wj Moses because of the hardness of your hearts suffered you to put away your wives: but from the beginning it was not so.\wj* 
\v 9 \wj And I say unto you, Whosoever shall put away his wife, except it be for fornication, and shall marry another, committeth adultery: and whoso marrieth her which is put away doth commit adultery.\wj* 
\p
\v 10 [His]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 5”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [say]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3P 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, [If]{strong=“G1487” x-morph=“robinson: \sc Cond\sc* 6”} [the case]{strong=“G3588 G156” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 9 10”} [of the man]{strong=“G3588 G444” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 11 12”} [be]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 8”} [so]{strong=“G3779” x-morph=“robinson: \sc Adv\sc* 7”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 13”} his [wife]{strong=“G3588 G1135” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 14 15”}, [it is]{strong=“G4851” x-morph=“robinson: V-\sc Pai\sc*-3S 17”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 16”} [good]{strong=“G4851” x-morph=“robinson: V-\sc Pai\sc*-3S 17”} [to marry]{strong=“G1060” x-morph=“robinson: V-\sc Aan\sc* 18”}. 
\v 11 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 4”}, \wj All men cannot receive this saying, save they to whom it is given.\wj* 
\v 12 \wj For there are some eunuchs, which were so born from their mother’s womb: and there are some eunuchs, which were made eunuchs of men: and there be eunuchs, which have made themselves eunuchs for the kingdom of heaven’s sake. He that is able to receive it, let him receive it.\wj* 
\p
\v 13 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [were there brought]{strong=“G4374” x-morph=“robinson: V-\sc Api\sc*-3S 2”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”} [little children]{strong=“G3813” x-morph=“robinson: N-\sc Npn\sc* 4”}, [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 5”} [he should put]{strong=“G2007” x-morph=“robinson: V-2\sc Aas\sc*-3S 8”} his [hands]{strong=“G3588 G5495” x-morph=“robinson: T-\sc Apf\sc* robinson: N-\sc Apf\sc* 6 7”} [on them]{strong=“G846” x-morph=“robinson: P-\sc Dpn\sc* 9”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [pray]{strong=“G4336” x-morph=“robinson: V-\sc Ads\sc*-3S 11”}: [and]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 13”} [the disciples]{strong=“G3101” x-morph=“robinson: N-\sc Npm\sc* 14”} [rebuked]{strong=“G2008” x-morph=“robinson: V-\sc Aai\sc*-3P 15”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 16”}. 
\v 14 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 3”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”}, \wj Suffer little children, and forbid them not, to come unto me: for of such is the kingdom of heaven.\wj* 
\v 15 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he laid]{strong=“G2007” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”} his [hands]{strong=“G3588 G5495” x-morph=“robinson: T-\sc Apf\sc* robinson: N-\sc Apf\sc* 4 5”} [on them]{strong=“G846” x-morph=“robinson: P-\sc Dpn\sc* 3”}, [and departed]{strong=“G4198” x-morph=“robinson: V-\sc Aoi\sc*-3S 6”} [thence]{strong=“G1564” x-morph=“robinson: \sc Adv\sc* 7”}. 
\p
\v 16 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”}, [behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 2”}, [one]{strong=“G1520” x-morph=“robinson: A-\sc Nsm\sc* 3”} [came]{strong=“G4334” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 4”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 6”}, [Good]{strong=“G18” x-morph=“robinson: A-\sc Vsm\sc* 8”} [Master]{strong=“G1320” x-morph=“robinson: N-\sc Vsm\sc* 7”}, [what]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 9”} [good thing]{strong=“G18” x-morph=“robinson: A-\sc Asn\sc* 10”} [shall I do]{strong=“G4160” x-morph=“robinson: V-\sc Aas\sc*-1S 11”}, [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 12”} [I may have]{strong=“G2192” x-morph=“robinson: V-\sc Pas\sc*-1S 13”} [eternal]{strong=“G166” x-morph=“robinson: A-\sc Asf\sc* 15”} [life]{strong=“G2222” x-morph=“robinson: N-\sc Asf\sc* 14”}? 
\v 17 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 4”}, \wj Why callest thou me good? there is none good but one, that is, God: but if thou wilt enter into life, keep the commandments.\wj* 
\v 18 [He saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, [Which]{strong=“G4169” x-morph=“robinson: I-\sc Apf\sc* 3”}? [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 6”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 7”}, [Thou shalt do]{strong=“G5407” x-morph=“robinson: V-\sc Fai\sc*-2S 10”} [no]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 9”} [murder]{strong=“G5407” x-morph=“robinson: V-\sc Fai\sc*-2S 10”}, [Thou shalt]{strong=“G3431” x-morph=“robinson: V-\sc Fai\sc*-2S 12”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 11”} [commit adultery]{strong=“G3431” x-morph=“robinson: V-\sc Fai\sc*-2S 12”}, [Thou shalt]{strong=“G2813” x-morph=“robinson: V-\sc Fai\sc*-2S 14”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 13”} [steal]{strong=“G2813” x-morph=“robinson: V-\sc Fai\sc*-2S 14”}, [Thou shalt]{strong=“G5576” x-morph=“robinson: V-\sc Fai\sc*-2S 16”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 15”} [bear false witness]{strong=“G5576” x-morph=“robinson: V-\sc Fai\sc*-2S 16”}, 
\v 19 \wj Honour thy father and thy mother: and, Thou shalt love thy neighbour as thyself.\wj* 
\v 20 [The young man]{strong=“G3588 G3495” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, [All]{strong=“G3956” x-morph=“robinson: A-\sc Apn\sc* 5”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 6”} [have I kept]{strong=“G5442” x-morph=“robinson: V-\sc Ami\sc*-1S 7”} [from]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 8”} [my]{strong=“G3450” x-morph=“robinson: P-1\sc Gs\sc* 10”} [youth]{strong=“G3503” x-morph=“robinson: N-\sc Gsf\sc* 9”} [up]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 8”}: [what]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 11”} [lack I]{strong=“G5302” x-morph=“robinson: V-\sc Pai\sc*-1S-C 13”} [yet]{strong=“G2089” x-morph=“robinson: \sc Adv\sc* 12”}? 
\v 21 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [said]{strong=“G5346” x-morph=“robinson: V-IXI-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, \wj If thou wilt be perfect, go and sell that thou hast, and give to the poor, and thou shalt have treasure in heaven: and come and follow me.\wj* 
\v 22 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [when]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 1”} [the young man]{strong=“G3588 G3495” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 1”} [that saying]{strong=“G3588 G3056” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 5 6”}, [he went away]{strong=“G565” x-morph=“robinson: V-2\sc Aai\sc*-3S 7”} [sorrowful]{strong=“G3076” x-morph=“robinson: V-\sc Ppp\sc*-\sc Nsm\sc* 8”}: [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 10”} [he had]{strong=“G2192” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 11”} [great]{strong=“G4183” x-morph=“robinson: A-\sc Apn\sc* 13”} [possessions]{strong=“G2933” x-morph=“robinson: N-\sc Apn\sc* 12”}. 
\p
\v 23 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 3”} [unto]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 5 6”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 7”} [disciples]{strong=“G3101” x-morph=“robinson: N-\sc Dpm\sc* 6”}, \wj Verily I say unto you, That a rich man shall hardly enter into the kingdom of heaven.\wj* 
\v 24 \wj And again I say unto you, It is easier for a camel to go through the eye of a needle, than for a rich man to enter into the kingdom of God.\wj* 
\v 25 [When]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 5”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 1”} it, [they were]{strong=“G1605” x-morph=“robinson: V-\sc Ipi\sc*-3P 6”} [exceedingly]{strong=“G4970” x-morph=“robinson: \sc Adv\sc* 7”} [amazed]{strong=“G1605” x-morph=“robinson: V-\sc Ipi\sc*-3P 6”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 8”}, [Who]{strong=“G5101” x-morph=“robinson: I-\sc Nsm\sc* 9”} [then]{strong=“G687” x-morph=“robinson: \sc Prt\sc*-I 10”} [can]{strong=“G1410” x-morph=“robinson: V-\sc Pni\sc*-3S 11”} [be saved]{strong=“G4982” x-morph=“robinson: V-\sc Apn\sc* 12”}? 
\v 26 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [beheld]{strong=“G1689” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 1”} them, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 6”}, \wj With men this is impossible; but with God all things are possible.\wj* 
\p
\v 27 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 2”} [Peter]{strong=“G3588 G4074” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 6”}, [Behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 7”}, [we]{strong=“G2249” x-morph=“robinson: P-1\sc Np\sc* 8”} [have forsaken]{strong=“G863” x-morph=“robinson: V-\sc Aai\sc*-1S 9”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Apn\sc* 10”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [followed]{strong=“G190” x-morph=“robinson: V-\sc Aai\sc*-1P 12”} [thee]{strong=“G4671” x-morph=“robinson: P-2\sc Ds\sc* 13”}; [what]{strong=“G5101” x-morph=“robinson: I-\sc Nsn\sc* 14”} [shall]{strong=“G2071” x-morph=“robinson: V-\sc Fxi\sc*-3S 16”} [we]{strong=“G2254” x-morph=“robinson: P-1\sc Dp\sc* 17”} [have]{strong=“G2071” x-morph=“robinson: V-\sc Fxi\sc*-3S 16”} [therefore]{strong=“G687” x-morph=“robinson: \sc Prt\sc*-I 15”}? 
\v 28 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 3”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}, \wj Verily I say unto you, That ye which have followed me, in the regeneration when the Son of man shall sit in the throne of his glory, ye also shall sit upon twelve thrones, judging the twelve tribes of Israel.\wj* 
\v 29 \wj And every one that hath forsaken houses, or brethren, or sisters, or father, or mother, or wife, or children, or lands, for my name’s sake, shall receive an hundredfold, and shall inherit everlasting life.\wj* 
\v 30 \wj But many that are first shall be last; and the last shall be first.\wj* 
\c 20
\p 
\v 1 \wj For the kingdom of heaven is like unto a man that is an householder, which went out early in the morning to hire labourers into his vineyard.\wj* 
\v 2 \wj And when he had agreed with the labourers for a penny a day, he sent them into his vineyard.\wj* 
\v 3 \wj And he went out about the third hour, and saw others standing idle in the marketplace,\wj* 
\v 4 \wj And said unto them; Go ye also into the vineyard, and whatsoever is right I will give you. And they went their way.\wj* 
\v 5 \wj Again he went out about the sixth and ninth hour, and did likewise.\wj* 
\v 6 \wj And about the eleventh hour he went out, and found others standing idle, and saith unto them, Why stand ye here all the day idle?\wj* 
\v 7 \wj They say unto him, Because no man hath hired us. He saith unto them, Go ye also into the vineyard; and whatsoever is right, that shall ye receive.\wj* 
\v 8 \wj So when even was come, the lord of the vineyard saith unto his steward, Call the labourers, and give them their hire, beginning from the last unto the first.\wj* 
\v 9 \wj And when they came that were hired about the eleventh hour, they received every man a penny.\wj* 
\v 10 \wj But when the first came, they supposed that they should have received more; and they likewise received every man a penny.\wj* 
\v 11 \wj And when they had received it, they murmured against the goodman of the house,\wj* 
\v 12 \wj Saying, These last have wrought but one hour, and thou hast made them equal unto us, which have borne the burden and heat of the day.\wj* 
\v 13 \wj But he answered one of them, and said, Friend, I do thee no wrong: didst not thou agree with me for a penny?\wj* 
\v 14 \wj Take that thine is, and go thy way: I will give unto this last, even as unto thee.\wj* 
\v 15 \wj Is it not lawful for me to do what I will with mine own? Is thine eye evil, because I am good?\wj* 
\v 16 \wj So the last shall be first, and the first last: for many be called, but few chosen.\wj* 
\p
\v 17 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [going up]{strong=“G305” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 2”} [to]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 5”} [Jerusalem]{strong=“G2414” x-morph=“robinson: N-\sc Asf\sc* 6”} [took]{strong=“G3880” x-morph=“robinson: V-2\sc Aai\sc*-3S 7”} [the twelve]{strong=“G1427” x-morph=“robinson: A-\sc Nui\sc* 9”} [disciples]{strong=“G3101” x-morph=“robinson: N-\sc Apm\sc* 10”} [apart]{strong=“G2398” x-morph=“robinson: A-\sc Asf\sc* 12”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 13”} [the way]{strong=“G3588 G3598” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 14 15”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 16”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 17”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 18”}, 
\v 18 \wj Behold, we go up to Jerusalem; and the Son of man shall be betrayed unto the chief priests and unto the scribes, and they shall condemn him to death,\wj* 
\v 19 \wj And shall deliver him to the Gentiles to mock, and to scourge, and to crucify him: and the third day he shall rise again.\wj* 
\p
\v 20 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [came]{strong=“G4334” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”} [to him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”} [the mother]{strong=“G3588 G3384” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 4 5”} [of]{strong=“G3588 G5207” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 6 7”} [Zebedee’s]{strong=“G2199” x-morph=“robinson: N-\sc Gsm\sc* 8”} [children]{strong=“G5207” x-morph=“robinson: N-\sc Gpm\sc* 7”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 9”} [her]{strong=“G846” x-morph=“robinson: P-\sc Gsf\sc* 12”} [sons]{strong=“G3588 G5207” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 10 11”}, [worshipping]{strong=“G4352” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsf\sc* 13”} him, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [desiring]{strong=“G154” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsf\sc* 15”} [a certain thing]{strong=“G5100” x-morph=“robinson: X-\sc Asn\sc* 16”} [of]{strong=“G3844” x-morph=“robinson: \sc Prep\sc* 17”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 18”}. 
\v 21 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [unto her]{strong=“G846” x-morph=“robinson: P-\sc Dsf\sc* 4”}, \wj What wilt thou?\wj* [She saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 7”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 8”}, [Grant]{strong=“G2036” x-morph=“robinson: V-2\sc Aam\sc*-2S 9”} [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 10”} [these]{strong=“G3778” x-morph=“robinson: D-\sc Npm\sc* 12”} [my]{strong=“G3450” x-morph=“robinson: P-1\sc Gs\sc* 16”} [two]{strong=“G1417” x-morph=“robinson: A-\sc Nui\sc* 14”} [sons]{strong=“G5207” x-morph=“robinson: N-\sc Npm\sc* 15”} [may sit]{strong=“G2523” x-morph=“robinson: V-\sc Aas\sc*-3P 11”}, [the one]{strong=“G1520” x-morph=“robinson: A-\sc Nsm\sc* 17”} [on]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 18”} [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 20”} [right hand]{strong=“G1188” x-morph=“robinson: A-\sc Gpm\sc* 19”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 21”} [the other]{strong=“G1520” x-morph=“robinson: A-\sc Nsm\sc* 22”} [on]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 23”} [the left]{strong=“G2176” x-morph=“robinson: A-\sc Gpm\sc* 24”}, [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 25”} [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 28”} [kingdom]{strong=“G3588 G932” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 26 27”}. 
\v 22 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 1”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”}, \wj Ye know not what ye ask. Are ye able to drink of the cup that I shall drink of, and to be baptized with the baptism that I am baptized with?\wj* [They say]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3P 25”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 26”}, [We are able]{strong=“G1410” x-morph=“robinson: V-\sc Pni\sc*-1P 27”}. 
\v 23 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj Ye shall drink indeed of my cup, and be baptized with the baptism that I am baptized with: but to sit on my right hand, and on my left, is not mine to give, but it shall be given to them for whom it is prepared of my Father.\wj* 
\v 24 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 2”} [the ten]{strong=“G1176” x-morph=“robinson: A-\sc Nui\sc* 4”} [heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 2”} it, [they were moved with indignation]{strong=“G23” x-morph=“robinson: V-\sc Aai\sc*-3P 5”} [against]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 6”} [the two]{strong=“G1417” x-morph=“robinson: A-\sc Nui\sc* 8”} [brethren]{strong=“G80” x-morph=“robinson: N-\sc Gpm\sc* 9”}. 
\v 25 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 3”} [called]{strong=“G4341” x-morph=“robinson: V-\sc Adp\sc*-\sc Nsm\sc* 4”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 5”} unto him, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 6”}, \wj Ye know that the princes of the Gentiles exercise dominion over them, and they that are great exercise authority upon them.\wj* 
\v 26 \wj But it shall not be so among you: but whosoever will be great among you, let him be your minister;\wj* 
\v 27 \wj And whosoever will be chief among you, let him be your servant:\wj* 
\v 28 \wj Even as the Son of man came not to be ministered unto, but to minister, and to give his life a ransom for many.\wj* 
\v 29 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [as]{strong=“G1607” x-morph=“robinson: V-\sc Pnp\sc*-\sc Gpm\sc* 2”} [they]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 3”} [departed]{strong=“G1607” x-morph=“robinson: V-\sc Pnp\sc*-\sc Gpm\sc* 2”} [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 4”} [Jericho]{strong=“G2410” x-morph=“robinson: N-\sc Pri\sc* 5”}, [a]{strong=“G3793” x-morph=“robinson: N-\sc Nsm\sc* 8”} [great]{strong=“G4183” x-morph=“robinson: A-\sc Nsm\sc* 9”} [multitude]{strong=“G3793” x-morph=“robinson: N-\sc Nsm\sc* 8”} [followed]{strong=“G190” x-morph=“robinson: V-\sc Aai\sc*-3S 6”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 7”}. 
\p
\v 30 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”}, [behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 2”}, [two]{strong=“G1417” x-morph=“robinson: A-\sc Nui\sc* 3”} [blind men]{strong=“G5185” x-morph=“robinson: A-\sc Npm\sc* 4”} [sitting]{strong=“G2521” x-morph=“robinson: V-\sc Pnp\sc*-\sc Npm\sc* 5”} [by]{strong=“G3844” x-morph=“robinson: \sc Prep\sc* 6”} [the way side]{strong=“G3588 G3598” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 7 8”}, [when they heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 9”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 10”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 11”} [passed by]{strong=“G3855” x-morph=“robinson: V-\sc Pai\sc*-3S 12”}, [cried out]{strong=“G2896” x-morph=“robinson: V-\sc Aai\sc*-3P 13”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 14”}, [Have mercy on]{strong=“G1653” x-morph=“robinson: V-\sc Aam\sc*-2S 15”} [us]{strong=“G2248” x-morph=“robinson: P-1\sc Ap\sc* 16”}, [O Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 17”}, thou [Son]{strong=“G5207” x-morph=“robinson: N-\sc Nsm\sc* 18”} [of David]{strong=“G1138” x-morph=“robinson: N-\sc Pri\sc* 19”}. 
\v 31 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [the multitude]{strong=“G3793” x-morph=“robinson: N-\sc Nsm\sc* 3”} [rebuked]{strong=“G2008” x-morph=“robinson: V-\sc Aai\sc*-3S 4”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}, [because]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 6”} [they should hold their peace]{strong=“G4623” x-morph=“robinson: V-\sc Aas\sc*-3P 7”}: [but]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 9”} [they cried]{strong=“G2896” x-morph=“robinson: V-\sc Iai\sc*-3P 11”} [the more]{strong=“G3185” x-morph=“robinson: \sc Adv\sc* 10”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 12”}, [Have mercy on]{strong=“G1653” x-morph=“robinson: V-\sc Aam\sc*-2S 13”} [us]{strong=“G2248” x-morph=“robinson: P-1\sc Ap\sc* 14”}, [O Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 15”}, thou [Son]{strong=“G5207” x-morph=“robinson: N-\sc Nsm\sc* 16”} [of David]{strong=“G1138” x-morph=“robinson: N-\sc Pri\sc* 17”}. 
\v 32 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [stood still]{strong=“G2476” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”}, [and called]{strong=“G5455” x-morph=“robinson: V-\sc Aai\sc*-3S 5”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 6”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 8”}, \wj What will ye that I shall do unto you?\wj* 
\v 33 [They say]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3P 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 3”}, [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 4”} [our]{strong=“G2257” x-morph=“robinson: P-1\sc Gp\sc* 6”} [eyes]{strong=“G3588 G3788” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 7 8”} [may be opened]{strong=“G455” x-morph=“robinson: V-\sc Aps\sc*-3P 5”}. 
\v 34 [So]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [had compassion]{strong=“G4697” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 1”} on them, [and touched]{strong=“G680” x-morph=“robinson: V-\sc Adi\sc*-3S 5”} [their]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 8”} [eyes]{strong=“G3588 G3788” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 6 7”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [immediately]{strong=“G2112” x-morph=“robinson: \sc Adv\sc* 10”} [their]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 12”} [eyes]{strong=“G3588 G3788” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 13 14”} [received sight]{strong=“G308” x-morph=“robinson: V-\sc Aai\sc*-3P 11”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 15”} [they followed]{strong=“G190” x-morph=“robinson: V-\sc Aai\sc*-3P 16”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 17”}. 
\c 21
\p 
\v 1 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when]{strong=“G3753” x-morph=“robinson: \sc Adv\sc* 2”} [they drew nigh]{strong=“G1448” x-morph=“robinson: V-\sc Aai\sc*-3P 3”} [unto]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 4”} [Jerusalem]{strong=“G2414” x-morph=“robinson: N-\sc Asf\sc* 5”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [were come]{strong=“G2064” x-morph=“robinson: V-2\sc Aai\sc*-3P 7”} [to]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 8”} [Bethphage]{strong=“G967” x-morph=“robinson: N-\sc Pri\sc* 9”}, [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 10”} [the mount]{strong=“G3588 G3735” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 11 12”} [of Olives]{strong=“G3588 G1636” x-morph=“robinson: T-\sc Gpf\sc* robinson: N-\sc Gpf\sc* 13 14”}, [then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 15”} [sent]{strong=“G649” x-morph=“robinson: V-\sc Aai\sc*-3S 18”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 16 17”} [two]{strong=“G1417” x-morph=“robinson: A-\sc Nui\sc* 19”} [disciples]{strong=“G3101” x-morph=“robinson: N-\sc Apm\sc* 20”}, 
\v 2 [Saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 1”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 2”}, \wj Go into the village over against you, and straightway ye shall find an ass tied, and a colt with her: loose them, and bring them unto me.\wj* 
\v 3 \wj And if any man say ought unto you, ye shall say, The Lord hath need of them; and straightway he will send them.\wj* 
\v 4 [All]{strong=“G3650” x-morph=“robinson: A-\sc Nsn\sc* 3”} [this]{strong=“G5124” x-morph=“robinson: D-\sc Nsn\sc* 1”} [was done]{strong=“G1096” x-morph=“robinson: V-2\sc Rai\sc*-3S 4”}, [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 5”} [it might be fulfilled]{strong=“G4137” x-morph=“robinson: V-\sc Aps\sc*-3S 6”} [which was spoken]{strong=“G4483” x-morph=“robinson: V-\sc App\sc*-\sc Nsn\sc* 8”} [by]{strong=“G1223” x-morph=“robinson: \sc Prep\sc* 9”} [the prophet]{strong=“G3588 G4396” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 10 11”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Gsn\sc* 12”}, 
\v 5 [Tell ye]{strong=“G2036” x-morph=“robinson: V-2\sc Aam\sc*-2P 1”} [the daughter]{strong=“G3588 G2364” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 2 3”} [of Sion]{strong=“G4622” x-morph=“robinson: N-\sc Pri\sc* 4”}, [Behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 5”}, [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 8”} [King]{strong=“G3588 G935” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 6 7”} [cometh]{strong=“G2064” x-morph=“robinson: V-\sc Pni\sc*-3S 9”} [unto thee]{strong=“G4671” x-morph=“robinson: P-2\sc Ds\sc* 10”}, [meek]{strong=“G4239” x-morph=“robinson: A-\sc Nsm\sc* 11”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”} [sitting]{strong=“G1910” x-morph=“robinson: V-\sc Rap\sc*-\sc Nsm\sc* 13”} [upon]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 14”} [an ass]{strong=“G3688” x-morph=“robinson: N-\sc Asf\sc* 15”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 16”} [a colt]{strong=“G4454” x-morph=“robinson: N-\sc Asm\sc* 17”} [the foal]{strong=“G5207” x-morph=“robinson: N-\sc Asm\sc* 18”} [of an ass]{strong=“G5268” x-morph=“robinson: N-\sc Gsn\sc* 19”}. 
