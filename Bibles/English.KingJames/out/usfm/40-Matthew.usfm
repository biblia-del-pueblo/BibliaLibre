\c 16
\p 
\v 1 [The Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [with]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [the Sadducees]{strong=“G4523” x-morph=“robinson: N-\sc Npm\sc* 6”} [came]{strong=“G4334” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 2”}, [and tempting]{strong=“G3985” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 7”} [desired]{strong=“G1905” x-morph=“robinson: V-\sc Aai\sc*-3P 8”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 9”} [that he would shew]{strong=“G1925” x-morph=“robinson: V-\sc Aan\sc* 14”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 15”} [a sign]{strong=“G4592” x-morph=“robinson: N-\sc Asn\sc* 10”} [from]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 11”} [heaven]{strong=“G3588 G3772” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 12 13”}. 
\v 2 [He answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 3”} [and]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}, \wj When it is evening, ye say, It will be fair weather: for the sky is red.\wj* 
\v 3 \wj And in the morning, It will be foul weather to day: for the sky is red and lowring. O ye hypocrites, ye can discern the face of the sky; but can ye not discern the signs of the times?\wj* 
\v 4 \wj A wicked and adulterous generation seeketh after a sign; and there shall no sign be given unto it, but the sign of the prophet Jonas.\wj* [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 19”} [he left]{strong=“G2641” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 20”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 21”}, [and departed]{strong=“G565” x-morph=“robinson: V-2\sc Aai\sc*-3S 22”}. 
\v 5 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when]{strong=“G2064” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 2”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 5”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [were come]{strong=“G2064” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 2”} [to]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 6”} [the other side]{strong=“G4008” x-morph=“robinson: \sc Adv\sc* 8”}, [they had forgotten]{strong=“G1950” x-morph=“robinson: V-2\sc Adi\sc*-3P 9”} [to take]{strong=“G2983” x-morph=“robinson: V-2\sc Aan\sc* 11”} [bread]{strong=“G740” x-morph=“robinson: N-\sc Apm\sc* 10”}. 
\p
\v 6 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 3”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}, \wj Take heed and beware of the leaven of the Pharisees and of the Sadducees.\wj* 
\v 7 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [they reasoned]{strong=“G1260” x-morph=“robinson: V-\sc Ini\sc*-3P 3”} [among]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 4”} [themselves]{strong=“G1438” x-morph=“robinson: F-3\sc Dpm\sc* 5”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 6”}, It is [because]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 7”} [we have taken]{strong=“G2983” x-morph=“robinson: V-2\sc Aai\sc*-1P 10”} [no]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 9”} [bread]{strong=“G740” x-morph=“robinson: N-\sc Apm\sc* 8”}. 
\v 8 Which [when]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [perceived]{strong=“G1097” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 1”}, [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 6”}, \wj O ye of little faith, why reason ye among yourselves, because ye have brought no bread?\wj* 
\v 9 \wj Do ye not yet understand, neither remember the five loaves of the five thousand, and how many baskets ye took up?\wj* 
\v 10 \wj Neither the seven loaves of the four thousand, and how many baskets ye took up?\wj* 
\v 11 \wj How is it that ye do not understand that I spake it not to you concerning bread, that ye should beware of the leaven of the Pharisees and of the Sadducees?\wj* 
\v 12 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [understood they]{strong=“G4920” x-morph=“robinson: V-\sc Aai\sc*-3P 2”} [how that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 3”} [he bade]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} them [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 4”} [beware]{strong=“G4337” x-morph=“robinson: V-\sc Pan\sc* 6”} [of]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 7”} [the leaven]{strong=“G3588 G2219” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 8 9”} [of bread]{strong=“G3588 G740” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 10 11”}, [but]{strong=“G235” x-morph=“robinson: \sc Conj\sc* 12”} [of]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 13”} [the doctrine]{strong=“G3588 G1322” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 14 15”} [of the Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 16 17”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 18”} [of the Sadducees]{strong=“G4523” x-morph=“robinson: N-\sc Gpm\sc* 19”}. 
\p
\v 13 [When]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [came]{strong=“G2064” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 1”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 5”} [the coasts]{strong=“G3588 G3313” x-morph=“robinson: T-\sc Apn\sc* robinson: N-\sc Apn\sc* 6 7”} [of Caesarea]{strong=“G2542” x-morph=“robinson: N-\sc Gsf\sc* 8”} [Philippi]{strong=“G5376” x-morph=“robinson: N-\sc Gsm\sc* 10”}, [he asked]{strong=“G2065” x-morph=“robinson: V-\sc Iai\sc*-3S 11”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 14”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 12 13”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 15”}, \wj Whom do men say that I the Son of man am?\wj* 
\v 14 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [they said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 3”}, [Some]{strong=“G3303” x-morph=“robinson: \sc Prt\sc* 5”} say that thou art [John]{strong=“G2491” x-morph=“robinson: N-\sc Asm\sc* 6”} [the Baptist]{strong=“G3588 G910” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 7 8”}: [some]{strong=“G243” x-morph=“robinson: A-\sc Npm\sc* 9”}, [Elias]{strong=“G2243” x-morph=“robinson: N-\sc Asm\sc* 11”}; [and]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 13”} [others]{strong=“G2087” x-morph=“robinson: A-\sc Npm\sc* 12”}, [Jeremias]{strong=“G2408” x-morph=“robinson: N-\sc Asm\sc* 14”}, [or]{strong=“G2228” x-morph=“robinson: \sc Prt\sc* 15”} [one]{strong=“G1520” x-morph=“robinson: A-\sc Asm\sc* 16”} [of the prophets]{strong=“G3588 G4396” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 17 18”}. 
\v 15 [He saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 1”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 2”}, \wj But whom say ye that I am?\wj* 
\v 16 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Simon]{strong=“G4613” x-morph=“robinson: N-\sc Nsm\sc* 3”} [Peter]{strong=“G4074” x-morph=“robinson: N-\sc Nsm\sc* 4”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 1”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”}, [Thou]{strong=“G4771” x-morph=“robinson: P-2\sc Ns\sc* 6”} [art]{strong=“G1488” x-morph=“robinson: V-\sc Pxi\sc*-2S 7”} [the Christ]{strong=“G3588 G5547” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 8 9”}, [the Son]{strong=“G3588 G5207” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 10 11”} [of the]{strong=“G3588 G2316” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 12 13”} [living]{strong=“G2198” x-morph=“robinson: V-\sc Pap\sc*-\sc Gsm\sc* 15”} [God]{strong=“G2316” x-morph=“robinson: N-\sc Gsm\sc* 13”}. 
\v 17 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 2”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 6”}, \wj Blessed art thou, Simon Bar-jona: for flesh and blood hath not revealed it unto thee, but my Father which is in heaven.\wj* 
\v 18 \wj And I say also unto thee, That thou art Peter, and upon this rock I will build my church; and the gates of hell shall not prevail against it.\wj* 
\v 19 \wj And I will give unto thee the keys of the kingdom of heaven: and whatsoever thou shalt bind on earth shall be bound in heaven: and whatsoever thou shalt loose on earth shall be loosed in heaven.\wj* 
\v 20 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [charged he]{strong=“G1291” x-morph=“robinson: V-\sc Ami\sc*-3S 2”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 5”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 3 4”} [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 6”} [they should tell]{strong=“G2036” x-morph=“robinson: V-2\sc Aas\sc*-3P 8”} [no man]{strong=“G3367” x-morph=“robinson: A-\sc Dsm\sc* 7”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 9”} [he]{strong=“G846” x-morph=“robinson: P-\sc Nsm\sc* 10”} [was]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 11”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 12”} [the Christ]{strong=“G3588 G5547” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 13 14”}. 
\p
\v 21 [From]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 1”} [that time]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 2”} [forth]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 1”} [began]{strong=“G756” x-morph=“robinson: V-\sc Adi\sc*-3S 3”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [to shew]{strong=“G1166” x-morph=“robinson: V-\sc Pan\sc* 6”} [unto his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 9”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 7 8”}, [how that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 10”} [he]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 12”} [must]{strong=“G1163” x-morph=“robinson: V-\sc Pqi\sc*-3S 11”} [go]{strong=“G565” x-morph=“robinson: V-2\sc Aan\sc* 13”} [unto]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 14”} [Jerusalem]{strong=“G2414” x-morph=“robinson: N-\sc Asf\sc* 15”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 16”} [suffer]{strong=“G3958” x-morph=“robinson: V-2\sc Aan\sc* 18”} [many things]{strong=“G4183” x-morph=“robinson: A-\sc Apn\sc* 17”} [of]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 19”} [the elders]{strong=“G4245” x-morph=“robinson: A-\sc Gpm\sc* 21”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 22”} [chief priests]{strong=“G749” x-morph=“robinson: N-\sc Gpm\sc* 23”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 24”} [scribes]{strong=“G1122” x-morph=“robinson: N-\sc Gpm\sc* 25”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 26”} [be killed]{strong=“G615” x-morph=“robinson: V-\sc Apn\sc* 27”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 28”} [be raised again]{strong=“G1453” x-morph=“robinson: V-\sc Apn\sc* 32”} [the]{strong=“G2250” x-morph=“robinson: N-\sc Dsf\sc* 31”} [third]{strong=“G5154” x-morph=“robinson: A-\sc Dsf\sc* 30”} [day]{strong=“G2250” x-morph=“robinson: N-\sc Dsf\sc* 31”}. 
\v 22 [Then]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Peter]{strong=“G3588 G4074” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [took]{strong=“G4355” x-morph=“robinson: V-2\sc Amp\sc*-\sc Nsm\sc* 2”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 3”}, [and began to]{strong=“G756” x-morph=“robinson: V-\sc Adi\sc*-3S 6”} [rebuke]{strong=“G2008” x-morph=“robinson: V-\sc Pan\sc* 7”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 8”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 9”}, [Be it far]{strong=“G2436” x-morph=“robinson: A-\sc Nsm\sc*-\sc Att\sc* 10”} [from thee]{strong=“G4671” x-morph=“robinson: P-2\sc Ds\sc* 11”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 12”}: [this]{strong=“G5124” x-morph=“robinson: D-\sc Nsn\sc* 17”} [shall]{strong=“G2071” x-morph=“robinson: V-\sc Fxi\sc*-3S 15”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 13”} [be]{strong=“G2071” x-morph=“robinson: V-\sc Fxi\sc*-3S 15”} [unto thee]{strong=“G4671” x-morph=“robinson: P-2\sc Ds\sc* 16”}. 
\v 23 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he turned]{strong=“G4762” x-morph=“robinson: V-2\sc App\sc*-\sc Nsm\sc* 3”}, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto Peter]{strong=“G3588 G4074” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 5 6”}, \wj Get thee behind me, Satan: thou art an offence unto me: for thou savourest not the things that be of God, but those that be of men.\wj* 
\p
\v 24 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 2 3”} [unto]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 5 6”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 7”} [disciples]{strong=“G3101” x-morph=“robinson: N-\sc Dpm\sc* 6”}, \wj If any man will come after me, let him deny himself, and take up his cross, and follow me.\wj* 
\v 25 \wj For whosoever will save his life shall lose it: and whosoever will lose his life for my sake shall find it.\wj* 
\v 26 \wj For what is a man profited, if he shall gain the whole world, and lose his own soul? or what shall a man give in exchange for his soul?\wj* 
\v 27 \wj For the Son of man shall come in the glory of his Father with his angels; and then he shall reward every man according to his works.\wj* 
\v 28 \wj Verily I say unto you, There be some standing here, which shall not taste of death, till they see the Son of man coming in his kingdom.\wj* 
\c 17
\p 
