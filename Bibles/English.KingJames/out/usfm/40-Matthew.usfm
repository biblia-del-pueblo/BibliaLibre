\v 5 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [the angel]{strong=“G3588 G32” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 1”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto the women]{strong=“G3588 G1135” x-morph=“robinson: T-\sc Dpf\sc* robinson: N-\sc Dpf\sc* 6 7”}, [Fear]{strong=“G5399” x-morph=“robinson: V-\sc Pnm\sc*-2P 9”} [not]{strong=“G3361” x-morph=“robinson: \sc Prt\sc*-N 8”} [ye]{strong=“G5210” x-morph=“robinson: P-2\sc Np\sc* 10”}: [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 12”} [I know]{strong=“G1492” x-morph=“robinson: V-\sc Rai\sc*-1S 11”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 13”} [ye seek]{strong=“G2212” x-morph=“robinson: V-\sc Pai\sc*-2P 17”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Asm\sc* 14”}, [which was crucified]{strong=“G4717” x-morph=“robinson: V-\sc Rpp\sc*-\sc Asm\sc* 16”}. 
\v 6 [He is]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 2”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 1”} [here]{strong=“G5602” x-morph=“robinson: \sc Adv\sc* 3”}: [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 5”} [he is risen]{strong=“G1453” x-morph=“robinson: V-\sc Api\sc*-3S 4”}, [as]{strong=“G2531” x-morph=“robinson: \sc Adv\sc* 6”} [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 7”}. [Come]{strong=“G1205” x-morph=“robinson: V-\sc Xxm\sc*-2P 8”}, [see]{strong=“G1492” x-morph=“robinson: V-2\sc Aam\sc*-2P 9”} [the place]{strong=“G3588 G5117” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 10 11”} [where]{strong=“G3699” x-morph=“robinson: \sc Adv\sc* 12”} [the Lord]{strong=“G3588 G2962” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 14 15”} [lay]{strong=“G2749” x-morph=“robinson: V-\sc Ini\sc*-3S 13”}. 
\v 7 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [go]{strong=“G4198” x-morph=“robinson: V-\sc Aop\sc*-\sc Npf\sc* 3”} [quickly]{strong=“G5035” x-morph=“robinson: \sc Adv\sc* 2”}, [and tell]{strong=“G2036” x-morph=“robinson: V-2\sc Aam\sc*-2P 4”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 7”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 5 6”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 8”} [he is risen]{strong=“G1453” x-morph=“robinson: V-\sc Api\sc*-3S 9”} [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 10”} [the dead]{strong=“G3498” x-morph=“robinson: A-\sc Gpm\sc* 12”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 13”}, [behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 14”}, [he goeth before]{strong=“G4254” x-morph=“robinson: V-\sc Pai\sc*-3S 15”} [you]{strong=“G5209” x-morph=“robinson: P-2\sc Ap\sc* 16”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 17”} [Galilee]{strong=“G3588 G1056” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 18 19”}; [there]{strong=“G1563” x-morph=“robinson: \sc Adv\sc* 20”} [shall ye see]{strong=“G3700” x-morph=“robinson: V-\sc Fdi\sc*-2P 22”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 21”}: [lo]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 23”}, [I have told]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-1S 24”} [you]{strong=“G5213” x-morph=“robinson: P-2\sc Dp\sc* 25”}. 
\v 8 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they departed]{strong=“G1831” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npf\sc* 2”} [quickly]{strong=“G5035” x-morph=“robinson: \sc Adv\sc* 3”} [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 4”} [the sepulchre]{strong=“G3588 G3419” x-morph=“robinson: T-\sc Gsn\sc* robinson: N-\sc Gsn\sc* 5 6”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 7”} [fear]{strong=“G5401” x-morph=“robinson: N-\sc Gsm\sc* 8”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [great]{strong=“G3173” x-morph=“robinson: A-\sc Gsf\sc* 11”} [joy]{strong=“G5479” x-morph=“robinson: N-\sc Gsf\sc* 10”}; [and did run]{strong=“G5143” x-morph=“robinson: V-2\sc Aai\sc*-3P 12”} [to bring]{strong=“G518” x-morph=“robinson: V-\sc Aan\sc* 13”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 16”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 14 15”} [word]{strong=“G518” x-morph=“robinson: V-\sc Aan\sc* 13”}. 
\p
\v 9 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [as]{strong=“G5613” x-morph=“robinson: \sc Adv\sc* 1”} [they went]{strong=“G4198” x-morph=“robinson: V-\sc Ini\sc*-3P 3”} [to tell]{strong=“G518” x-morph=“robinson: V-\sc Aan\sc* 4”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 7”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 5 6”}, [behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 9”}, [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 10 11”} [met]{strong=“G528” x-morph=“robinson: V-\sc Aai\sc*-3S 12”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpf\sc* 13”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 14”}, \wj All hail.\wj* [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 17”} [they came]{strong=“G4334” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npf\sc* 18”} [and held]{strong=“G2902” x-morph=“robinson: V-\sc Aai\sc*-3P 19”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 20”} [by the feet]{strong=“G3588 G4228” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 21 22”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 23”} [worshipped]{strong=“G4352” x-morph=“robinson: V-\sc Aai\sc*-3P 24”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 25”}. 
\v 10 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpf\sc* 3”}, \wj Be not afraid: go tell my brethren that they go into Galilee, and there shall they see me.\wj* 
\p
