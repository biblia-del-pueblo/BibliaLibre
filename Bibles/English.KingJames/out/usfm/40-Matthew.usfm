\v 35 [And when]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [the men]{strong=“G3588 G435” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 4 5”} [of that]{strong=“G1565” x-morph=“robinson: D-\sc Gsm\sc* 8”} [place]{strong=“G3588 G5117” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 6 7”} [had knowledge of]{strong=“G1921” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 2”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 3”}, [they sent out]{strong=“G649” x-morph=“robinson: V-\sc Aai\sc*-3P 9”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 10”} [all]{strong=“G3650” x-morph=“robinson: A-\sc Asf\sc* 11”} [that]{strong=“G1565” x-morph=“robinson: D-\sc Asf\sc* 14”} [country round about]{strong=“G4066” x-morph=“robinson: A-\sc Asf\sc* 13”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 15”} [brought]{strong=“G4374” x-morph=“robinson: V-\sc Aai\sc*-3P 16”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 17”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Apm\sc* 18”} [that were]{strong=“G2192” x-morph=“robinson: V-\sc Pap\sc*-\sc Apm\sc* 21”} [diseased]{strong=“G2560” x-morph=“robinson: \sc Adv\sc* 20”}; 
\v 36 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [besought]{strong=“G3870” x-morph=“robinson: V-\sc Iai\sc*-3P 2”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 3”} [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 4”} [they might]{strong=“G680” x-morph=“robinson: V-\sc Ams\sc*-3P 6”} [only]{strong=“G3440” x-morph=“robinson: \sc Adv\sc* 5”} [touch]{strong=“G680” x-morph=“robinson: V-\sc Ams\sc*-3P 6”} [the hem]{strong=“G3588 G2899” x-morph=“robinson: T-\sc Gsn\sc* robinson: N-\sc Gsn\sc* 7 8”} [of his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 11”} [garment]{strong=“G3588 G2440” x-morph=“robinson: T-\sc Gsn\sc* robinson: N-\sc Gsn\sc* 9 10”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”} [as many as]{strong=“G3745” x-morph=“robinson: K-\sc Npm\sc* 13”} [touched]{strong=“G680” x-morph=“robinson: V-\sc Adi\sc*-3P 14”} [were made perfectly whole]{strong=“G1295” x-morph=“robinson: V-\sc Api\sc*-3P 15”}. 
\c 15
\p 
\v 1 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [came]{strong=“G4334” x-morph=“robinson: V-\sc Pni\sc*-3P 2”} [to Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 3 4”} [scribes]{strong=“G1122” x-morph=“robinson: N-\sc Npm\sc* 8”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [Pharisees]{strong=“G5330” x-morph=“robinson: N-\sc Npm\sc* 10”}, [which were of]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 6”} [Jerusalem]{strong=“G2414” x-morph=“robinson: N-\sc Gpn\sc* 7”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 11”}, 
\v 2 [Why]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 2”} [do]{strong=“G3845” x-morph=“robinson: V-\sc Pai\sc*-3P 6”} [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 5”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [transgress]{strong=“G3845” x-morph=“robinson: V-\sc Pai\sc*-3P 6”} [the tradition]{strong=“G3588 G3862” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 7 8”} [of the elders]{strong=“G4245” x-morph=“robinson: A-\sc Gpm\sc* 10”}? [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 12”} [they wash]{strong=“G3538” x-morph=“robinson: V-\sc Pmi\sc*-3P 13”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 11”} [their]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 16”} [hands]{strong=“G3588 G5495” x-morph=“robinson: T-\sc Apf\sc* robinson: N-\sc Apf\sc* 14 15”} [when]{strong=“G3752” x-morph=“robinson: \sc Conj\sc* 17”} [they eat]{strong=“G2068” x-morph=“robinson: V-\sc Pas\sc*-3P 19”} [bread]{strong=“G740” x-morph=“robinson: N-\sc Asm\sc* 18”}. 
\v 3 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 3”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}, \wj Why do ye also transgress the commandment of God by your tradition?\wj* 
\v 4 \wj For God commanded, saying, Honour thy father and mother: and, He that curseth father or mother, let him die the death.\wj* 
\v 5 \wj But ye say, Whosoever shall say to his father or his mother, It is a gift, by whatsoever thou mightest be profited by me;\wj* 
\v 6 \wj And honour not his father or his mother, he shall be free. Thus have ye made the commandment of God of none effect by your tradition.\wj* 
\v 7 \wj Ye hypocrites, well did Esaias prophesy of you, saying,\wj* 
\v 8 \wj This people draweth nigh unto me with their mouth, and honoureth me with their lips; but their heart is far from me.\wj* 
\v 9 \wj But in vain they do worship me, teaching for doctrines the commandments of men.\wj* 
\p
\v 10 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he called]{strong=“G4341” x-morph=“robinson: V-\sc Adp\sc*-\sc Nsm\sc* 2”} [the multitude]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 3 4”}, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 6”}, \wj Hear, and understand:\wj* 
\v 11 \wj Not that which goeth into the mouth defileth a man; but that which cometh out of the mouth, this defileth a man.\wj* 
\v 12 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [came]{strong=“G4334” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 2”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 5”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”}, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 6”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 7”}, [Knowest thou]{strong=“G1492” x-morph=“robinson: V-\sc Rai\sc*-2S 8”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 9”} [the Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 10 11”} [were offended]{strong=“G4624” x-morph=“robinson: V-\sc Api\sc*-3P 15”}, [after they heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 12”} [this saying]{strong=“G3588 G3056” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 13 14”}? 
\v 13 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 3”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”}, \wj Every plant, which my heavenly Father hath not planted, shall be rooted up.\wj* 
\v 14 \wj Let them alone: they be blind leaders of the blind. And if the blind lead the blind, both shall fall into the ditch.\wj* 
\v 15 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 1”} [Peter]{strong=“G3588 G4074” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 6”}, [Declare]{strong=“G5419” x-morph=“robinson: V-\sc Aam\sc*-2S 7”} [unto us]{strong=“G2254” x-morph=“robinson: P-1\sc Dp\sc* 8”} [this]{strong=“G3778” x-morph=“robinson: D-\sc Asf\sc* 11”} [parable]{strong=“G3588 G3850” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 9 10”}. 
\v 16 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 3”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”}, \wj Are ye also yet without understanding?\wj* 
\v 17 \wj Do not ye yet understand, that whatsoever entereth in at the mouth goeth into the belly, and is cast out into the draught?\wj* 
\v 18 \wj But those things which proceed out of the mouth come forth from the heart; and they defile the man.\wj* 
\v 19 \wj For out of the heart proceed evil thoughts, murders, adulteries, fornications, thefts, false witness, blasphemies:\wj* 
\v 20 \wj These are the things which defile a man: but to eat with unwashen hands defileth not a man.\wj* 
\p
\v 21 [Then]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [went]{strong=“G1831” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”} [thence]{strong=“G1564” x-morph=“robinson: \sc Adv\sc* 3”}, [and departed]{strong=“G402” x-morph=“robinson: V-\sc Aai\sc*-3S 6”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 7”} [the coasts]{strong=“G3588 G3313” x-morph=“robinson: T-\sc Apn\sc* robinson: N-\sc Apn\sc* 8 9”} [of Tyre]{strong=“G5184” x-morph=“robinson: N-\sc Gsf\sc* 10”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [Sidon]{strong=“G4605” x-morph=“robinson: N-\sc Gsf\sc* 12”}. 
