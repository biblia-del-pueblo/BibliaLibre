\v 23 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 6 7”} [went about]{strong=“G4013” x-morph=“robinson: V-\sc Iai\sc*-3S 2”} [all]{strong=“G3650” x-morph=“robinson: A-\sc Asf\sc* 3”} [Galilee]{strong=“G3588 G1056” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 4 5”}, [teaching]{strong=“G1321” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 8”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 9”} [their]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 12”} [synagogues]{strong=“G3588 G4864” x-morph=“robinson: T-\sc Dpf\sc* robinson: N-\sc Dpf\sc* 10 11”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 13”} [preaching]{strong=“G2784” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 14”} [the gospel]{strong=“G3588 G2098” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 15 16”} [of the kingdom]{strong=“G3588 G932” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 17 18”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 19”} [healing]{strong=“G2323” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 20”} [all manner of]{strong=“G3956” x-morph=“robinson: A-\sc Asf\sc* 21”} [sickness]{strong=“G3554” x-morph=“robinson: N-\sc Asf\sc* 22”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 23”} [all manner of]{strong=“G3956” x-morph=“robinson: A-\sc Asf\sc* 24”} [disease]{strong=“G3119” x-morph=“robinson: N-\sc Asf\sc* 25”} [among]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 26”} [the people]{strong=“G3588 G2992” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 27 28”}. 
\v 24 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 5”} [fame]{strong=“G3588 G189” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 3 4”} [went]{strong=“G565” x-morph=“robinson: V-2\sc Aai\sc*-3S 2”} [throughout]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 6”} [all]{strong=“G3650” x-morph=“robinson: A-\sc Asf\sc* 7”} [Syria]{strong=“G3588 G4947” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 8 9”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [they brought]{strong=“G4374” x-morph=“robinson: V-\sc Aai\sc*-3P 11”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 12”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Apm\sc* 13”} [sick people]{strong=“G2560” x-morph=“robinson: \sc Adv\sc* 15”} [that were taken]{strong=“G4912” x-morph=“robinson: V-\sc Ppp\sc*-\sc Apm\sc* 21”} [with divers]{strong=“G4164” x-morph=“robinson: A-\sc Dpf\sc* 17”} [diseases]{strong=“G3554” x-morph=“robinson: N-\sc Dpf\sc* 18”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 19”} [torments]{strong=“G931” x-morph=“robinson: N-\sc Dpf\sc* 20”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 22”} [those which were possessed with devils]{strong=“G1139” x-morph=“robinson: V-\sc Pnp\sc*-\sc Apm\sc* 23”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 24”} [those which were lunatick]{strong=“G4583” x-morph=“robinson: V-\sc Pnp\sc*-\sc Apm\sc* 25”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 26”} [those that had the palsy]{strong=“G3885” x-morph=“robinson: A-\sc Apm\sc* 27”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 28”} [he healed]{strong=“G2323” x-morph=“robinson: V-\sc Aai\sc*-3S 29”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 30”}. 
\v 25 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [there followed]{strong=“G190” x-morph=“robinson: V-\sc Aai\sc*-3P 2”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”} [great multitudes]{strong=“G4183” x-morph=“robinson: A-\sc Npm\sc* 5”} [of people]{strong=“G3793” x-morph=“robinson: N-\sc Npm\sc* 4”} [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 6”} [Galilee]{strong=“G3588 G1056” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 7 8”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} from [Decapolis]{strong=“G1179” x-morph=“robinson: N-\sc Gsf\sc* 10”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} from [Jerusalem]{strong=“G2414” x-morph=“robinson: N-\sc Gpn\sc* 12”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 13”} from [Judaea]{strong=“G2449” x-morph=“robinson: N-\sc Gsf\sc* 14”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 15”} from [beyond]{strong=“G4008” x-morph=“robinson: \sc Adv\sc* 16”} [Jordan]{strong=“G3588 G2446” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 17 18”}. 
\c 5
\p 
\v 1 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [seeing]{strong=“G1492” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 1”} [the multitudes]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 3 4”}, [he went up]{strong=“G305” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 6”} [a mountain]{strong=“G3588 G3735” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 7 8”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [when]{strong=“G2523” x-morph=“robinson: V-\sc Aap\sc*-\sc Gsm\sc* 10”} [he]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 11”} [was set]{strong=“G2523” x-morph=“robinson: V-\sc Aap\sc*-\sc Gsm\sc* 10”}, [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 16”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 14 15”} [came unto]{strong=“G4334” x-morph=“robinson: V-\sc Aai\sc*-3P 12”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 13”}: 
\v 2 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he opened]{strong=“G455” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 2”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 5”} [mouth]{strong=“G3588 G4750” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 3 4”}, [and taught]{strong=“G1321” x-morph=“robinson: V-\sc Iai\sc*-3S 6”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 7”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 8”}, 
\v 3 \wj Blessed are the poor in spirit: for theirs is the kingdom of heaven.\wj* 
\v 4 \wj Blessed are they that mourn: for they shall be comforted.\wj* 
\v 5 \wj Blessed are the meek: for they shall inherit the earth.\wj* 
\v 6 \wj Blessed are they which do hunger and thirst after righteousness: for they shall be filled.\wj* 
\v 7 \wj Blessed are the merciful: for they shall obtain mercy.\wj* 
\v 8 \wj Blessed are the pure in heart: for they shall see God.\wj* 
\v 9 \wj Blessed are the peacemakers: for they shall be called the children of God.\wj* 
\v 10 \wj Blessed are they which are persecuted for righteousness’ sake: for theirs is the kingdom of heaven.\wj* 
\v 11 \wj Blessed are ye, when men shall revile you, and persecute you, and shall say all manner of evil against you falsely, for my sake.\wj* 
\v 12 \wj Rejoice, and be exceeding glad: for great is your reward in heaven: for so persecuted they the prophets which were before you.\wj* 
\p
\v 13 \wj Ye are the salt of the earth: but if the salt have lost his savour, wherewith shall it be salted? it is thenceforth good for nothing, but to be cast out, and to be trodden under foot of men.\wj* 
\v 14 \wj Ye are the light of the world. A city that is set on an hill cannot be hid.\wj* 
\v 15 \wj Neither do men light a candle, and put it under a bushel, but on a candlestick; and it giveth light unto all that are in the house.\wj* 
\v 16 \wj Let your light so shine before men, that they may see your good works, and glorify your Father which is in heaven.\wj* 
\p
\v 17 \wj Think not that I am come to destroy the law, or the prophets: I am not come to destroy, but to fulfil.\wj* 
\v 18 \wj For verily I say unto you, Till heaven and earth pass, one jot or one tittle shall in no wise pass from the law, till all be fulfilled.\wj* 
\v 19 \wj Whosoever therefore shall break one of these least commandments, and shall teach men so, he shall be called the least in the kingdom of heaven: but whosoever shall do and teach them, the same shall be called great in the kingdom of heaven.\wj* 
\v 20 \wj For I say unto you, That except your righteousness shall exceed the righteousness of the scribes and Pharisees, ye shall in no case enter into the kingdom of heaven.\wj* 
\p
\v 21 \wj Ye have heard that it was said by them of old time, Thou shalt not kill; and whosoever shall kill shall be in danger of the judgment:\wj* 
\v 22 \wj But I say unto you, That whosoever is angry with his brother without a cause shall be in danger of the judgment: and whosoever shall say to his brother, Raca, shall be in danger of the council: but whosoever shall say, Thou fool, shall be in danger of hell fire.\wj* 
\v 23 \wj Therefore if thou bring thy gift to the altar, and there rememberest that thy brother hath ought against thee;\wj* 
\v 24 \wj Leave there thy gift before the altar, and go thy way; first be reconciled to thy brother, and then come and offer thy gift.\wj* 
\v 25 \wj Agree with thine adversary quickly, whiles thou art in the way with him; lest at any time the adversary deliver thee to the judge, and the judge deliver thee to the officer, and thou be cast into prison.\wj* 
\v 26 \wj Verily I say unto thee, Thou shalt by no means come out thence, till thou hast paid the uttermost farthing.\wj* 
\p
\v 27 \wj Ye have heard that it was said by them of old time, Thou shalt not commit adultery:\wj* 
\v 28 \wj But I say unto you, That whosoever looketh on a woman to lust after her hath committed adultery with her already in his heart.\wj* 
\v 29 \wj And if thy right eye offend thee, pluck it out, and cast it from thee: for it is profitable for thee that one of thy members should perish, and not that thy whole body should be cast into hell.\wj* 
\v 30 \wj And if thy right hand offend thee, cut it off, and cast it from thee: for it is profitable for thee that one of thy members should perish, and not that thy whole body should be cast into hell.\wj* 
\v 31 \wj It hath been said, Whosoever shall put away his wife, let him give her a writing of divorcement:\wj* 
\v 32 \wj But I say unto you, That whosoever shall put away his wife, saving for the cause of fornication, causeth her to commit adultery: and whosoever shall marry her that is divorced committeth adultery.\wj* 
\p
\v 33 \wj Again, ye have heard that it hath been said by them of old time, Thou shalt not forswear thyself, but shalt perform unto the Lord thine oaths:\wj* 
\v 34 \wj But I say unto you, Swear not at all; neither by heaven; for it is God’s throne:\wj* 
\v 35 \wj Nor by the earth; for it is his footstool: neither by Jerusalem; for it is the city of the great King.\wj* 
\v 36 \wj Neither shalt thou swear by thy head, because thou canst not make one hair white or black.\wj* 
\v 37 \wj But let your communication be, Yea, yea; Nay, nay: for whatsoever is more than these cometh of evil.\wj* 
\p
\v 38 \wj Ye have heard that it hath been said, An eye for an eye, and a tooth for a tooth:\wj* 
\v 39 \wj But I say unto you, That ye resist not evil: but whosoever shall smite thee on thy right cheek, turn to him the other also.\wj* 
\v 40 \wj And if any man will sue thee at the law, and take away thy coat, let him have thy cloke also.\wj* 
\v 41 \wj And whosoever shall compel thee to go a mile, go with him twain.\wj* 
\v 42 \wj Give to him that asketh thee, and from him that would borrow of thee turn not thou away.\wj* 
\p
\v 43 \wj Ye have heard that it hath been said, Thou shalt love thy neighbour, and hate thine enemy.\wj* 
\v 44 \wj But I say unto you, Love your enemies, bless them that curse you, do good to them that hate you, and pray for them which despitefully use you, and persecute you;\wj* 
\v 45 \wj That ye may be the children of your Father which is in heaven: for he maketh his sun to rise on the evil and on the good, and sendeth rain on the just and on the unjust.\wj* 
\v 46 \wj For if ye love them which love you, what reward have ye? do not even the publicans the same?\wj* 
\v 47 \wj And if ye salute your brethren only, what do ye more than others? do not even the publicans so?\wj* 
\v 48 \wj Be ye therefore perfect, even as your Father which is in heaven is perfect.\wj* 
\c 6
\p 
\v 1 \wj Take heed that ye do not your alms before men, to be seen of them: otherwise ye have no reward of your Father which is in heaven.\wj* 
\v 2 \wj Therefore when thou doest thine alms, do not sound a trumpet before thee, as the hypocrites do in the synagogues and in the streets, that they may have glory of men. Verily I say unto you, They have their reward.\wj* 
\v 3 \wj But when thou doest alms, let not thy left hand know what thy right hand doeth:\wj* 
\v 4 \wj That thine alms may be in secret: and thy Father which seeth in secret himself shall reward thee openly.\wj* 
\p
\v 5 \wj And when thou prayest, thou shalt not be as the hypocrites are: for they love to pray standing in the synagogues and in the corners of the streets, that they may be seen of men. Verily I say unto you, They have their reward.\wj* 
\v 6 \wj But thou, when thou prayest, enter into thy closet, and when thou hast shut thy door, pray to thy Father which is in secret; and thy Father which seeth in secret shall reward thee openly.\wj* 
\v 7 \wj But when ye pray, use not vain repetitions, as the heathen do: for they think that they shall be heard for their much speaking.\wj* 
\v 8 \wj Be not ye therefore like unto them: for your Father knoweth what things ye have need of, before ye ask him.\wj* 
\v 9 \wj After this manner therefore pray ye: Our Father which art in heaven, Hallowed be thy name.\wj* 
\v 10 \wj Thy kingdom come. Thy will be done in earth, as it is in heaven.\wj* 
\v 11 \wj Give us this day our daily bread.\wj* 
\v 12 \wj And forgive us our debts, as we forgive our debtors.\wj* 
\v 13 \wj And lead us not into temptation, but deliver us from evil: For thine is the kingdom, and the power, and the glory, for ever. Amen.\wj* 
\v 14 \wj For if ye forgive men their trespasses, your heavenly Father will also forgive you:\wj* 
\v 15 \wj But if ye forgive not men their trespasses, neither will your Father forgive your trespasses.\wj* 
\p
\v 16 \wj Moreover when ye fast, be not, as the hypocrites, of a sad countenance: for they disfigure their faces, that they may appear unto men to fast. Verily I say unto you, They have their reward.\wj* 
\v 17 \wj But thou, when thou fastest, anoint thine head, and wash thy face;\wj* 
\v 18 \wj That thou appear not unto men to fast, but unto thy Father which is in secret: and thy Father, which seeth in secret, shall reward thee openly.\wj* 
\p
\v 19 \wj Lay not up for yourselves treasures upon earth, where moth and rust doth corrupt, and where thieves break through and steal:\wj* 
\v 20 \wj But lay up for yourselves treasures in heaven, where neither moth nor rust doth corrupt, and where thieves do not break through nor steal:\wj* 
\v 21 \wj For where your treasure is, there will your heart be also.\wj* 
\v 22 \wj The light of the body is the eye: if therefore thine eye be single, thy whole body shall be full of light.\wj* 
\v 23 \wj But if thine eye be evil, thy whole body shall be full of darkness. If therefore the light that is in thee be darkness, how great is that darkness!\wj* 
\p
\v 24 \wj No man can serve two masters: for either he will hate the one, and love the other; or else he will hold to the one, and despise the other. Ye cannot serve God and mammon.\wj* 
\v 25 \wj Therefore I say unto you, Take no thought for your life, what ye shall eat, or what ye shall drink; nor yet for your body, what ye shall put on. Is not the life more than meat, and the body than raiment?\wj* 
\v 26 \wj Behold the fowls of the air: for they sow not, neither do they reap, nor gather into barns; yet your heavenly Father feedeth them. Are ye not much better than they?\wj* 
\v 27 \wj Which of you by taking thought can add one cubit unto his stature?\wj* 
\v 28 \wj And why take ye thought for raiment? Consider the lilies of the field, how they grow; they toil not, neither do they spin:\wj* 
\v 29 \wj And yet I say unto you, That even Solomon in all his glory was not arrayed like one of these.\wj* 
\v 30 \wj Wherefore, if God so clothe the grass of the field, which to day is, and to morrow is cast into the oven, shall he not much more clothe you, O ye of little faith?\wj* 
\v 31 \wj Therefore take no thought, saying, What shall we eat? or, What shall we drink? or, Wherewithal shall we be clothed?\wj* 
\v 32 \wj (For after all these things do the Gentiles seek:) for your heavenly Father knoweth that ye have need of all these things.\wj* 
\v 33 \wj But seek ye first the kingdom of God, and his righteousness; and all these things shall be added unto you.\wj* 
\v 34 \wj Take therefore no thought for the morrow: for the morrow shall take thought for the things of itself. Sufficient unto the day is the evil thereof.\wj* 
\c 7
\p 
\v 1 \wj Judge not, that ye be not judged.\wj* 
\v 2 \wj For with what judgment ye judge, ye shall be judged: and with what measure ye mete, it shall be measured to you again.\wj* 
\v 3 \wj And why beholdest thou the mote that is in thy brother’s eye, but considerest not the beam that is in thine own eye?\wj* 
\v 4 \wj Or how wilt thou say to thy brother, Let me pull out the mote out of thine eye; and, behold, a beam is in thine own eye?\wj* 
\v 5 \wj Thou hypocrite, first cast out the beam out of thine own eye; and then shalt thou see clearly to cast out the mote out of thy brother’s eye.\wj* 
\p
\v 6 \wj Give not that which is holy unto the dogs, neither cast ye your pearls before swine, lest they trample them under their feet, and turn again and rend you.\wj* 
\p
\v 7 \wj Ask, and it shall be given you; seek, and ye shall find; knock, and it shall be opened unto you:\wj* 
\v 8 \wj For every one that asketh receiveth; and he that seeketh findeth; and to him that knocketh it shall be opened.\wj* 
\v 9 \wj Or what man is there of you, whom if his son ask bread, will he give him a stone?\wj* 
\v 10 \wj Or if he ask a fish, will he give him a serpent?\wj* 
\v 11 \wj If ye then, being evil, know how to give good gifts unto your children, how much more shall your Father which is in heaven give good things to them that ask him?\wj* 
\v 12 \wj Therefore all things whatsoever ye would that men should do to you, do ye even so to them: for this is the law and the prophets.\wj* 
\p
\v 13 \wj Enter ye in at the strait gate: for wide is the gate, and broad is the way, that leadeth to destruction, and many there be which go in thereat:\wj* 
\v 14 \wj Because strait is the gate, and narrow is the way, which leadeth unto life, and few there be that find it.\wj* 
\p
\v 15 \wj Beware of false prophets, which come to you in sheep’s clothing, but inwardly they are ravening wolves.\wj* 
\v 16 \wj Ye shall know them by their fruits. Do men gather grapes of thorns, or figs of thistles?\wj* 
\v 17 \wj Even so every good tree bringeth forth good fruit; but a corrupt tree bringeth forth evil fruit.\wj* 
\v 18 \wj A good tree cannot bring forth evil fruit, neither can a corrupt tree bring forth good fruit.\wj* 
\v 19 \wj Every tree that bringeth not forth good fruit is hewn down, and cast into the fire.\wj* 
\v 20 \wj Wherefore by their fruits ye shall know them.\wj* 
\p
\v 21 \wj Not every one that saith unto me, Lord, Lord, shall enter into the kingdom of heaven; but he that doeth the will of my Father which is in heaven.\wj* 
\v 22 \wj Many will say to me in that day, Lord, Lord, have we not prophesied in thy name? and in thy name have cast out devils? and in thy name done many wonderful works?\wj* 
\v 23 \wj And then will I profess unto them, I never knew you: depart from me, ye that work iniquity.\wj* 
\p
\v 24 \wj Therefore whosoever heareth these sayings of mine, and doeth them, I will liken him unto a wise man, which built his house upon a rock:\wj* 
\v 25 \wj And the rain descended, and the floods came, and the winds blew, and beat upon that house; and it fell not: for it was founded upon a rock.\wj* 
\v 26 \wj And every one that heareth these sayings of mine, and doeth them not, shall be likened unto a foolish man, which built his house upon the sand:\wj* 
\v 27 \wj And the rain descended, and the floods came, and the winds blew, and beat upon that house; and it fell: and great was the fall of it.\wj* 
\v 28 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [it came to pass]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 2”}, [when]{strong=“G3753” x-morph=“robinson: \sc Adv\sc* 3”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [had ended]{strong=“G4931” x-morph=“robinson: V-\sc Aai\sc*-3S 4”} [these]{strong=“G5128” x-morph=“robinson: D-\sc Apm\sc* 9”} [sayings]{strong=“G3588 G3056” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 7 8”}, [the people]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 11 12”} [were astonished]{strong=“G1605” x-morph=“robinson: V-\sc Ipi\sc*-3P 10”} [at]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 13”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 16”} [doctrine]{strong=“G3588 G1322” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 14 15”}: 
