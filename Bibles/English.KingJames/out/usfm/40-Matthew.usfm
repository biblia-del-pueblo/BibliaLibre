\v 1 [In the end]{strong=“G3796” x-morph=“robinson: \sc Adv\sc* 1”} [of the sabbath]{strong=“G4521” x-morph=“robinson: N-\sc Gpn\sc* 3”}, [as it began to dawn]{strong=“G2020” x-morph=“robinson: V-\sc Pap\sc*-\sc Dsf\sc* 5”} [toward]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 6”} [the first]{strong=“G1520” x-morph=“robinson: A-\sc Asf\sc* 7”} day [of the week]{strong=“G4521” x-morph=“robinson: N-\sc Gpn\sc* 8”}, [came]{strong=“G2064” x-morph=“robinson: V-2\sc Aai\sc*-3S 9”} [Mary]{strong=“G3137” x-morph=“robinson: N-\sc Nsf\sc* 10”} [Magdalene]{strong=“G3588 G3094” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 11 12”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 13”} [the other]{strong=“G243” x-morph=“robinson: A-\sc Nsf\sc* 15”} [Mary]{strong=“G3137” x-morph=“robinson: N-\sc Nsf\sc* 16”} [to see]{strong=“G2334” x-morph=“robinson: V-\sc Aan\sc* 17”} [the sepulchre]{strong=“G3588 G5028” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 18 19”}. 
\v 2 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”}, [behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 2”}, [there was]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 4”} [a]{strong=“G4578” x-morph=“robinson: N-\sc Nsm\sc* 3”} [great]{strong=“G3173” x-morph=“robinson: A-\sc Nsm\sc* 5”} [earthquake]{strong=“G4578” x-morph=“robinson: N-\sc Nsm\sc* 3”}: [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 7”} [the angel]{strong=“G32” x-morph=“robinson: N-\sc Nsm\sc* 6”} [of the Lord]{strong=“G2962” x-morph=“robinson: N-\sc Gsm\sc* 8”} [descended]{strong=“G2597” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 9”} [from]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 10”} [heaven]{strong=“G3772” x-morph=“robinson: N-\sc Gsm\sc* 11”}, [and came]{strong=“G4334” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 12”} [and rolled back]{strong=“G617” x-morph=“robinson: V-\sc Aai\sc*-3S 13”} [the stone]{strong=“G3588 G3037” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 14 15”} [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 16”} [the door]{strong=“G3588 G2374” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 17 18”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 19”} [sat]{strong=“G2521” x-morph=“robinson: V-\sc Ini\sc*-3S 20”} [upon]{strong=“G1883” x-morph=“robinson: \sc Adv\sc* 21”} [it]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 22”}. 
\v 3 [His]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 5”} [countenance]{strong=“G3588 G2397” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 3 4”} [was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 1”} [like]{strong=“G5613” x-morph=“robinson: \sc Adv\sc* 6”} [lightning]{strong=“G796” x-morph=“robinson: N-\sc Nsf\sc* 7”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 11”} [raiment]{strong=“G3588 G1742” x-morph=“robinson: T-\sc Nsn\sc* robinson: N-\sc Nsn\sc* 9 10”} [white]{strong=“G3022” x-morph=“robinson: A-\sc Nsn\sc* 12”} [as]{strong=“G5616” x-morph=“robinson: \sc Adv\sc* 13”} [snow]{strong=“G5510” x-morph=“robinson: N-\sc Nsf\sc* 14”}: 
