\v 23 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when]{strong=“G2064” x-morph=“robinson: V-2\sc Aap\sc*-\sc Dsm\sc* 2”} [he]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”} [was come]{strong=“G2064” x-morph=“robinson: V-2\sc Aap\sc*-\sc Dsm\sc* 2”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 4”} [the temple]{strong=“G3588 G2411” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 5 6”}, [the chief priests]{strong=“G3588 G749” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 10 11”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”} [the elders]{strong=“G4245” x-morph=“robinson: A-\sc Npm\sc* 14”} [of the people]{strong=“G3588 G2992” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 15 16”} [came]{strong=“G4334” x-morph=“robinson: V-\sc Aai\sc*-3P 7”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 8”} [as he was teaching]{strong=“G1321” x-morph=“robinson: V-\sc Pap\sc*-\sc Dsm\sc* 9”}, [and said]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 17”}, [By]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 18”} [what]{strong=“G4169” x-morph=“robinson: I-\sc Dsf\sc* 19”} [authority]{strong=“G1849” x-morph=“robinson: N-\sc Dsf\sc* 20”} [doest thou]{strong=“G4160” x-morph=“robinson: V-\sc Pai\sc*-2S 22”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 21”}? [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 23”} [who]{strong=“G5101” x-morph=“robinson: I-\sc Nsm\sc* 24”} [gave]{strong=“G1325” x-morph=“robinson: V-\sc Aai\sc*-3S 26”} [thee]{strong=“G4671” x-morph=“robinson: P-2\sc Ds\sc* 25”} [this]{strong=“G3778” x-morph=“robinson: D-\sc Asf\sc* 29”} [authority]{strong=“G3588 G1849” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 27 28”}? 
\v 24 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 1”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 6”}, \wj I also will ask you one thing, which if ye tell me, I in like wise will tell you by what authority I do these things.\wj* 
\v 25 \wj The baptism of John, whence was it? from heaven, or of men?\wj* [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 12”} [they reasoned]{strong=“G1260” x-morph=“robinson: V-\sc Ini\sc*-3P 13”} [with]{strong=“G3844” x-morph=“robinson: \sc Prep\sc* 14”} [themselves]{strong=“G1438” x-morph=“robinson: F-3\sc Dpm\sc* 15”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 16”}, [If]{strong=“G1437” x-morph=“robinson: \sc Cond\sc* 17”} [we shall say]{strong=“G2036” x-morph=“robinson: V-2\sc Aas\sc*-1P 18”}, [From]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 19”} [heaven]{strong=“G3772” x-morph=“robinson: N-\sc Gsm\sc* 20”}; [he will say]{strong=“G2046” x-morph=“robinson: V-\sc Fai\sc*-3S 21”} [unto us]{strong=“G2254” x-morph=“robinson: P-1\sc Dp\sc* 22”}, [Why]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 24”} [did ye]{strong=“G4100” x-morph=“robinson: V-\sc Aai\sc*-2P 27”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 26”} [then]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 25”} [believe]{strong=“G4100” x-morph=“robinson: V-\sc Aai\sc*-2P 27”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 28”}? 
\v 26 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [if]{strong=“G1437” x-morph=“robinson: \sc Cond\sc* 1”} [we shall say]{strong=“G2036” x-morph=“robinson: V-2\sc Aas\sc*-1P 3”}, [Of]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 4”} [men]{strong=“G444” x-morph=“robinson: N-\sc Gpm\sc* 5”}; [we fear]{strong=“G5399” x-morph=“robinson: V-\sc Pni\sc*-1P 6”} [the people]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 7 8”}; [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 10”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Npm\sc* 9”} [hold]{strong=“G2192” x-morph=“robinson: V-\sc Pai\sc*-3P 11”} [John]{strong=“G3588 G2491” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 12 13”} [as]{strong=“G5613” x-morph=“robinson: \sc Adv\sc* 14”} [a prophet]{strong=“G4396” x-morph=“robinson: N-\sc Asm\sc* 15”}. 
\v 27 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Npm\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 3 4”}, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 5”}, [We]{strong=“G1492” x-morph=“robinson: V-\sc Rai\sc*-1P 7”} [cannot]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 6”} [tell]{strong=“G1492” x-morph=“robinson: V-\sc Rai\sc*-1P 7”}. [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [he]{strong=“G846” x-morph=“robinson: P-\sc Nsm\sc* 11”} [said]{strong=“G5346” x-morph=“robinson: V-IXI-3S 8”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 9”}, \wj Neither tell I you by what authority I do these things.\wj* 
\p
\v 28 \wj But what think ye? A certain man had two sons; and he came to the first, and said, Son, go work to day in my vineyard.\wj* 
\v 29 \wj He answered and said, I will not: but afterward he repented, and went.\wj* 
\v 30 \wj And he came to the second, and said likewise. And he answered and said, I go, sir: and went not.\wj* 
\v 31 \wj Whether of them twain did the will of his father?\wj* [They say]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3P 10”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 11”}, [The first]{strong=“G4413” x-morph=“robinson: A-\sc Nsm\sc* 13”}. [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 16 17”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 14”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 15”}, \wj Verily I say unto you, That the publicans and the harlots go into the kingdom of God before you.\wj* 
\v 32 \wj For John came unto you in the way of righteousness, and ye believed him not: but the publicans and the harlots believed him: and ye, when ye had seen it, repented not afterward, that ye might believe him.\wj* 
\p
\v 33 \wj Hear another parable: There was a certain householder, which planted a vineyard, and hedged it round about, and digged a winepress in it, and built a tower, and let it out to husbandmen, and went into a far country:\wj* 
\v 34 \wj And when the time of the fruit drew near, he sent his servants to the husbandmen, that they might receive the fruits of it.\wj* 
\v 35 \wj And the husbandmen took his servants, and beat one, and killed another, and stoned another.\wj* 
\v 36 \wj Again, he sent other servants more than the first: and they did unto them likewise.\wj* 
\v 37 \wj But last of all he sent unto them his son, saying, They will reverence my son.\wj* 
\v 38 \wj But when the husbandmen saw the son, they said among themselves, This is the heir; come, let us kill him, and let us seize on his inheritance.\wj* 
\v 39 \wj And they caught him, and cast him out of the vineyard, and slew him.\wj* 
\v 40 \wj When the lord therefore of the vineyard cometh, what will he do unto those husbandmen?\wj* 
\v 41 [They say]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3P 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, [He will]{strong=“G622” x-morph=“robinson: V-\sc Fai\sc*-3S 5”} [miserably]{strong=“G2560” x-morph=“robinson: \sc Adv\sc* 4”} [destroy]{strong=“G622” x-morph=“robinson: V-\sc Fai\sc*-3S 5”} [those]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 6”} [wicked men]{strong=“G2556” x-morph=“robinson: A-\sc Apm\sc* 3”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [will let out]{strong=“G1554” x-morph=“robinson: V-\sc Fdi\sc*-3S 10”} his [vineyard]{strong=“G3588 G290” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 8 9”} [unto]{strong=“G1092” x-morph=“robinson: N-\sc Dpm\sc* 12”} [other]{strong=“G243” x-morph=“robinson: A-\sc Dpm\sc* 11”} [husbandmen]{strong=“G1092” x-morph=“robinson: N-\sc Dpm\sc* 12”}, [which]{strong=“G3748” x-morph=“robinson: R-\sc Npm\sc* 13”} [shall render]{strong=“G591” x-morph=“robinson: V-\sc Fai\sc*-3P 14”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 15”} [the fruits]{strong=“G3588 G2590” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 16 17”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 18”} [their]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 21”} [seasons]{strong=“G3588 G2540” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 19 20”}. 
\v 42 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 1”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 2”}, \wj Did ye never read in the scriptures, The stone which the builders rejected, the same is become the head of the corner: this is the Lord’s doing, and it is marvellous in our eyes?\wj* 
\v 43 \wj Therefore say I unto you, The kingdom of God shall be taken from you, and given to a nation bringing forth the fruits thereof.\wj* 
\v 44 \wj And whosoever shall fall on this stone shall be broken: but on whomsoever it shall fall, it will grind him to powder.\wj* 
\v 45 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 2”} [the chief priests]{strong=“G3588 G749” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 6 7”} [had heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 2”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 10”} [parables]{strong=“G3588 G3850” x-morph=“robinson: T-\sc Apf\sc* robinson: N-\sc Apf\sc* 8 9”}, [they perceived]{strong=“G1097” x-morph=“robinson: V-2\sc Aai\sc*-3P 11”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 12”} [he spake]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 15”} [of]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 13”} [them]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 14”}. 
\v 46 [But]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when they sought]{strong=“G2212” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 2”} [to lay hands on]{strong=“G2902” x-morph=“robinson: V-\sc Aan\sc* 4”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 3”}, [they feared]{strong=“G5399” x-morph=“robinson: V-\sc Aoi\sc*-3P 5”} [the multitude]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 6 7”}, [because]{strong=“G1894” x-morph=“robinson: \sc Conj\sc* 8”} [they took]{strong=“G2192” x-morph=“robinson: V-\sc Iai\sc*-3P 12”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 11”} [for]{strong=“G5613” x-morph=“robinson: \sc Adv\sc* 9”} [a prophet]{strong=“G4396” x-morph=“robinson: N-\sc Asm\sc* 10”}. 
\c 22
\p 
\v 1 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 2”} [and spake]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 6”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 7”} [again]{strong=“G3825” x-morph=“robinson: \sc Adv\sc* 5”} [by]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 8”} [parables]{strong=“G3850” x-morph=“robinson: N-\sc Dpf\sc* 9”}, [and said]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 10”}, 
\v 2 \wj The kingdom of heaven is like unto a certain king, which made a marriage for his son,\wj* 
\v 3 \wj And sent forth his servants to call them that were bidden to the wedding: and they would not come.\wj* 
\v 4 \wj Again, he sent forth other servants, saying, Tell them which are bidden, Behold, I have prepared my dinner: my oxen and my fatlings are killed, and all things are ready: come unto the marriage.\wj* 
\v 5 \wj But they made light of it, and went their ways, one to his farm, another to his merchandise:\wj* 
\v 6 \wj And the remnant took his servants, and entreated them spitefully, and slew them.\wj* 
\v 7 \wj But when the king heard thereof, he was wroth: and he sent forth his armies, and destroyed those murderers, and burned up their city.\wj* 
\v 8 \wj Then saith he to his servants, The wedding is ready, but they which were bidden were not worthy.\wj* 
\v 9 \wj Go ye therefore into the highways, and as many as ye shall find, bid to the marriage.\wj* 
\v 10 \wj So those servants went out into the highways, and gathered together all as many as they found, both bad and good: and the wedding was furnished with guests.\wj* 
\p
\v 11 \wj And when the king came in to see the guests, he saw there a man which had not on a wedding garment:\wj* 
\v 12 \wj And he saith unto him, Friend, how camest thou in hither not having a wedding garment? And he was speechless.\wj* 
\v 13 \wj Then said the king to the servants, Bind him hand and foot, and take him away, and cast him into outer darkness; there shall be weeping and gnashing of teeth.\wj* 
\v 14 \wj For many are called, but few are chosen.\wj* 
\p
\v 15 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [went]{strong=“G4198” x-morph=“robinson: V-\sc Aop\sc*-\sc Npm\sc* 2”} [the Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”}, [and took]{strong=“G2983” x-morph=“robinson: V-2\sc Aai\sc*-3P 6”} [counsel]{strong=“G4824” x-morph=“robinson: N-\sc Asn\sc* 5”} [how]{strong=“G3704” x-morph=“robinson: \sc Adv\sc* 7”} [they might entangle]{strong=“G3802” x-morph=“robinson: V-\sc Aas\sc*-3P 9”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 8”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 10”} his [talk]{strong=“G3056” x-morph=“robinson: N-\sc Dsm\sc* 11”}. 
\v 16 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they sent out]{strong=“G649” x-morph=“robinson: V-\sc Pai\sc*-3P 2”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”} [their]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 6”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 4 5”} [with]{strong=“G3326” x-morph=“robinson: \sc Prep\sc* 7”} [the Herodians]{strong=“G3588 G2265” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 8 9”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 10”}, [Master]{strong=“G1320” x-morph=“robinson: N-\sc Vsm\sc* 11”}, [we know]{strong=“G1492” x-morph=“robinson: V-\sc Rai\sc*-1P 12”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 13”} [thou art]{strong=“G1488” x-morph=“robinson: V-\sc Pxi\sc*-2S 15”} [true]{strong=“G227” x-morph=“robinson: A-\sc Nsm\sc* 14”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 16”} [teachest]{strong=“G1321” x-morph=“robinson: V-\sc Pai\sc*-2S 23”} [the way]{strong=“G3588 G3598” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 17 18”} [of God]{strong=“G3588 G2316” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 19 20”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 21”} [truth]{strong=“G225” x-morph=“robinson: N-\sc Dsf\sc* 22”}, [neither]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 25”} [carest]{strong=“G3199” x-morph=“robinson: V-\sc Pqi\sc*-3S 26”} [thou]{strong=“G4671” x-morph=“robinson: P-2\sc Ds\sc* 27”} [for]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 28”} [any]{strong=“G3762” x-morph=“robinson: A-\sc Gsm\sc* 29”} man: [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 31”} [thou regardest]{strong=“G991” x-morph=“robinson: V-\sc Pai\sc*-2S 32”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 30”} [the person]{strong=“G4383” x-morph=“robinson: N-\sc Asn\sc* 34”} [of men]{strong=“G444” x-morph=“robinson: N-\sc Gpm\sc* 35”}. 
\v 17 [Tell]{strong=“G2036” x-morph=“robinson: V-2\sc Aam\sc*-2S 1”} [us]{strong=“G2254” x-morph=“robinson: P-1\sc Dp\sc* 3”} [therefore]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 2”}, [What]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 4”} [thinkest]{strong=“G1380” x-morph=“robinson: V-\sc Pai\sc*-3S 6”} [thou]{strong=“G4671” x-morph=“robinson: P-2\sc Ds\sc* 5”}? [Is it lawful]{strong=“G1832” x-morph=“robinson: V-\sc Pqi\sc*-3S 7”} [to give]{strong=“G1325” x-morph=“robinson: V-2\sc Aan\sc* 8”} [tribute]{strong=“G2778” x-morph=“robinson: N-\sc Asm\sc* 9”} [unto Caesar]{strong=“G2541” x-morph=“robinson: N-\sc Dsm\sc* 10”}, [or]{strong=“G2228” x-morph=“robinson: \sc Prt\sc* 11”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 12”}? 
\v 18 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [perceived]{strong=“G1097” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 1”} [their]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 7”} [wickedness]{strong=“G3588 G4189” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 5 6”}, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 8”}, \wj Why tempt ye me, ye hypocrites?\wj* 
\v 19 \wj Shew me the tribute money.\wj* [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 8”} [they brought]{strong=“G4374” x-morph=“robinson: V-\sc Aai\sc*-3P 9”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 10”} [a penny]{strong=“G1220” x-morph=“robinson: N-\sc Asn\sc* 11”}. 
\v 20 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 2”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”}, \wj Whose is this image and superscription?\wj* 
\v 21 [They say]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3P 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, [Cæsar’s]{strong=“G2541” x-morph=“robinson: N-\sc Gsm\sc* 3”}. [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 4”} [saith he]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 5”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 6”}, \wj Render therefore unto Cæsar the things which are Cæsar’s; and unto God the things that are God’s.\wj* 
\v 22 [When]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [they had heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 2”} these words, [they marvelled]{strong=“G2296” x-morph=“robinson: V-\sc Aai\sc*-3P 3”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 4”} [left]{strong=“G863” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 5”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 6”}, [and went their way]{strong=“G565” x-morph=“robinson: V-2\sc Aai\sc*-3P 7”}. 
\p
\v 23 [The]{strong=“G3588 G2250” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 3 4”} [same]{strong=“G1565” x-morph=“robinson: D-\sc Dsf\sc* 2”} [day]{strong=“G2250” x-morph=“robinson: N-\sc Dsf\sc* 4”} [came]{strong=“G4334” x-morph=“robinson: V-\sc Aai\sc*-3P 5”} [to him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 6”} [the Sadducees]{strong=“G4523” x-morph=“robinson: N-\sc Npm\sc* 7”}, [which say that]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 9”} [there is]{strong=“G1511” x-morph=“robinson: V-\sc Pxn\sc* 11”} [no]{strong=“G3361” x-morph=“robinson: \sc Prt\sc*-N 10”} [resurrection]{strong=“G386” x-morph=“robinson: N-\sc Asf\sc* 12”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 13”} [asked]{strong=“G1905” x-morph=“robinson: V-\sc Aai\sc*-3P 14”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 15”}, 
\v 24 [Saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 1”}, [Master]{strong=“G1320” x-morph=“robinson: N-\sc Vsm\sc* 2”}, [Moses]{strong=“G3475” x-morph=“robinson: N-\sc Nsm\sc* 3”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”}, [If]{strong=“G1437” x-morph=“robinson: \sc Cond\sc* 5”} [a man]{strong=“G5100” x-morph=“robinson: X-\sc Nsm\sc* 6”} [die]{strong=“G599” x-morph=“robinson: V-2\sc Aas\sc*-3S 7”}, [having]{strong=“G2192” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 9”} [no]{strong=“G3361” x-morph=“robinson: \sc Prt\sc*-N 8”} [children]{strong=“G5043” x-morph=“robinson: N-\sc Apn\sc* 10”}, [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 14”} [brother]{strong=“G3588 G80” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 12 13”} [shall marry]{strong=“G1918” x-morph=“robinson: V-\sc Fai\sc*-3S 11”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 17”} [wife]{strong=“G3588 G1135” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 15 16”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 18”} [raise up]{strong=“G450” x-morph=“robinson: V-\sc Fai\sc*-3S 19”} [seed]{strong=“G4690” x-morph=“robinson: N-\sc Asn\sc* 20”} [unto]{strong=“G3588 G80” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 21 22”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 23”} [brother]{strong=“G80” x-morph=“robinson: N-\sc Dsm\sc* 22”}. 
\v 25 [Now]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [there were]{strong=“G2258” x-morph=“robinson: V-IXI-3P 1”} [with]{strong=“G3844” x-morph=“robinson: \sc Prep\sc* 3”} [us]{strong=“G2254” x-morph=“robinson: P-1\sc Dp\sc* 4”} [seven]{strong=“G2033” x-morph=“robinson: A-\sc Nui\sc* 5”} [brethren]{strong=“G80” x-morph=“robinson: N-\sc Npm\sc* 6”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [the first]{strong=“G4413” x-morph=“robinson: A-\sc Nsm\sc* 9”}, [when he had married a wife]{strong=“G1060” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 10”}, [deceased]{strong=“G5053” x-morph=“robinson: V-\sc Aai\sc*-3S 11”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”}, [having]{strong=“G2192” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 14”} [no]{strong=“G3361” x-morph=“robinson: \sc Prt\sc*-N 13”} [issue]{strong=“G4690” x-morph=“robinson: N-\sc Asn\sc* 15”}, [left]{strong=“G863” x-morph=“robinson: V-\sc Aai\sc*-3S 16”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 19”} [wife]{strong=“G3588 G1135” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 17 18”} [unto]{strong=“G3588 G80” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 20 21”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 22”} [brother]{strong=“G80” x-morph=“robinson: N-\sc Dsm\sc* 21”}: 
\v 26 [Likewise]{strong=“G3668” x-morph=“robinson: \sc Adv\sc* 1”} [the second]{strong=“G1208” x-morph=“robinson: A-\sc Nsm\sc* 4”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 2”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [the third]{strong=“G5154” x-morph=“robinson: A-\sc Nsm\sc* 7”}, [unto]{strong=“G2193” x-morph=“robinson: \sc Conj\sc* 8”} [the seventh]{strong=“G2033” x-morph=“robinson: A-\sc Nui\sc* 10”}. 
\v 27 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [last]{strong=“G5305” x-morph=“robinson: \sc Adv\sc* 1”} [of all]{strong=“G3956” x-morph=“robinson: A-\sc Gpm\sc* 3”} [the woman]{strong=“G3588 G1135” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 6 7”} [died]{strong=“G599” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”}. 
\v 28 [Therefore]{strong=“G3767” x-morph=“robinson: \sc Conj\sc* 3”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 1”} [the resurrection]{strong=“G386” x-morph=“robinson: N-\sc Dsf\sc* 4”} [whose]{strong=“G5101” x-morph=“robinson: I-\sc Gsm\sc* 5”} [wife]{strong=“G1135” x-morph=“robinson: N-\sc Nsf\sc* 9”} [shall she be]{strong=“G2071” x-morph=“robinson: V-\sc Fxi\sc*-3S 8”} [of the seven]{strong=“G2033” x-morph=“robinson: A-\sc Nui\sc* 7”}? [for]{strong=“G1063” x-morph=“robinson: \sc Conj\sc* 11”} [they]{strong=“G2192” x-morph=“robinson: V-2\sc Aai\sc*-3P 12”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Npm\sc* 10”} [had]{strong=“G2192” x-morph=“robinson: V-2\sc Aai\sc*-3P 12”} [her]{strong=“G846” x-morph=“robinson: P-\sc Asf\sc* 13”}. 
\v 29 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 1”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 6”}, \wj Ye do err, not knowing the scriptures, nor the power of God.\wj* 
\v 30 \wj For in the resurrection they neither marry, nor are given in marriage, but are as the angels of God in heaven.\wj* 
\v 31 \wj But as touching the resurrection of the dead, have ye not read that which was spoken unto you by God, saying,\wj* 
\v 32 \wj I am the God of Abraham, and the God of Isaac, and the God of Jacob? God is not the God of the dead, but of the living.\wj* 
\v 33 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 2”} [the multitude]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 2”} this, [they were astonished]{strong=“G1605” x-morph=“robinson: V-\sc Ipi\sc*-3P 5”} [at]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 6”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 9”} [doctrine]{strong=“G3588 G1322” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 7 8”}. 
\p
\v 34 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [when]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 4”} [the Pharisees]{strong=“G5330” x-morph=“robinson: N-\sc Npm\sc* 3”} [had heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 4”} [that]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 5”} [he had put]{strong=“G5392” x-morph=“robinson: V-\sc Aai\sc*-3S 6”} [the Sadducees]{strong=“G3588 G4523” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 7 8”} [to silence]{strong=“G5392” x-morph=“robinson: V-\sc Aai\sc*-3S 6”}, [they were gathered]{strong=“G4863” x-morph=“robinson: V-\sc Api\sc*-3P 9”} [together]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 10”}. 
\v 35 [Then]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [one]{strong=“G1520” x-morph=“robinson: A-\sc Nsm\sc* 3”} [of]{strong=“G1537” x-morph=“robinson: \sc Prep\sc* 4”} [them]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 5”}, which was [a lawyer]{strong=“G3544” x-morph=“robinson: A-\sc Nsm\sc* 6”}, [asked]{strong=“G1905” x-morph=“robinson: V-\sc Aai\sc*-3S 2”} him a question, [tempting]{strong=“G3985” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 7”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 8”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 10”}, 
\v 36 [Master]{strong=“G1320” x-morph=“robinson: N-\sc Vsm\sc* 1”}, [which]{strong=“G4169” x-morph=“robinson: I-\sc Nsf\sc* 2”} is [the]{strong=“G1785” x-morph=“robinson: N-\sc Nsf\sc* 3”} [great]{strong=“G3173” x-morph=“robinson: A-\sc Nsf\sc* 4”} [commandment]{strong=“G1785” x-morph=“robinson: N-\sc Nsf\sc* 3”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 5”} [the law]{strong=“G3588 G3551” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 6 7”}? 
\v 37 [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 3”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 5”}, \wj Thou shalt love the Lord thy God with all thy heart, and with all thy soul, and with all thy mind.\wj* 
\v 38 \wj This is the first and great commandment.\wj* 
\v 39 \wj And the second is like unto it, Thou shalt love thy neighbour as thyself.\wj* 
\v 40 \wj On these two commandments hang all the law and the prophets.\wj* 
\p
\v 41 [While]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [the Pharisees]{strong=“G3588 G5330” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 3 4”} [were gathered together]{strong=“G4863” x-morph=“robinson: V-\sc Rpp\sc*-\sc Gpm\sc* 1”}, [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 7 8”} [asked]{strong=“G1905” x-morph=“robinson: V-\sc Aai\sc*-3S 5”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 6”}, 
\v 42 [Saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 1”}, \wj What think ye of Christ? whose son is he?\wj* [They say]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3P 11”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 12”}, The Son [of David]{strong=“G1138” x-morph=“robinson: N-\sc Pri\sc* 14”}. 
\v 43 [He saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 1”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 2”}, \wj How then doth David in spirit call him Lord, saying,\wj* 
\v 44 \sc The \wj Lord\sc* said unto my Lord, Sit thou on my right hand, till I make thine enemies thy footstool?\wj* 
\v 45 \wj If David then call him Lord, how is he his son?\wj* 
\v 46 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [no man]{strong=“G3762” x-morph=“robinson: A-\sc Nsm\sc* 2”} [was able]{strong=“G1410” x-morph=“robinson: V-\sc Ini\sc*-3S 3”} [to answer]{strong=“G611” x-morph=“robinson: V-\sc Aon\sc* 5”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 4”} [a word]{strong=“G3056” x-morph=“robinson: N-\sc Asm\sc* 6”}, [neither]{strong=“G3761” x-morph=“robinson: \sc Adv\sc* 7”} [durst]{strong=“G5111” x-morph=“robinson: V-\sc Aai\sc*-3S 8”} [any]{strong=“G5100” x-morph=“robinson: X-\sc Nsm\sc* 9”} man [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 10”} [that]{strong=“G1565” x-morph=“robinson: D-\sc Gsf\sc* 11”} [day]{strong=“G3588 G2250” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 12 13”} [forth]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 10”} [ask]{strong=“G1905” x-morph=“robinson: V-\sc Aan\sc* 14”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 15”} [any more]{strong=“G3765” x-morph=“robinson: \sc Adv\sc* 16”} questions. 
\c 23
\p 
\v 1 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [spake]{strong=“G2980” x-morph=“robinson: V-\sc Aai\sc*-3S 4”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 2 3”} [to the multitude]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 5 6”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [to]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 8 9”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 10”} [disciples]{strong=“G3101” x-morph=“robinson: N-\sc Dpm\sc* 9”}, 
\v 2 [Saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 1”}, \wj The scribes and the Pharisees sit in Moses’ seat:\wj* 
\v 3 \wj All therefore whatsoever they bid you observe, that observe and do; but do not ye after their works: for they say, and do not.\wj* 
\v 4 \wj For they bind heavy burdens and grievous to be borne, and lay them on men’s shoulders; but they themselves will not move them with one of their fingers.\wj* 
\v 5 \wj But all their works they do for to be seen of men: they make broad their phylacteries, and enlarge the borders of their garments,\wj* 
\v 6 \wj And love the uppermost rooms at feasts, and the chief seats in the synagogues,\wj* 
\v 7 \wj And greetings in the markets, and to be called of men, Rabbi, Rabbi.\wj* 
\v 8 \wj But be not ye called Rabbi: for one is your Master, even Christ; and all ye are brethren.\wj* 
\v 9 \wj And call no man your father upon the earth: for one is your Father, which is in heaven.\wj* 
\v 10 \wj Neither be ye called masters: for one is your Master, even Christ.\wj* 
\v 11 \wj But he that is greatest among you shall be your servant.\wj* 
\v 12 \wj And whosoever shall exalt himself shall be abased; and he that shall humble himself shall be exalted.\wj* 
\p
\v 13 \wj But woe unto you, scribes and Pharisees, hypocrites! for ye shut up the kingdom of heaven against men: for ye neither go in yourselves, neither suffer ye them that are entering to go in.\wj* 
\v 14 \wj Woe unto you, scribes and Pharisees, hypocrites! for ye devour widows’ houses, and for a pretence make long prayer: therefore ye shall receive the greater damnation.\wj* 
\v 15 \wj Woe unto you, scribes and Pharisees, hypocrites! for ye compass sea and land to make one proselyte, and when he is made, ye make him twofold more the child of hell than yourselves.\wj* 
\v 16 \wj Woe unto you, ye blind guides, which say, Whosoever shall swear by the temple, it is nothing; but whosoever shall swear by the gold of the temple, he is a debtor!\wj* 
\v 17 \wj Ye fools and blind: for whether is greater, the gold, or the temple that sanctifieth the gold?\wj* 
\v 18 \wj And, Whosoever shall swear by the altar, it is nothing; but whosoever sweareth by the gift that is upon it, he is guilty.\wj* 
\v 19 \wj Ye fools and blind: for whether is greater, the gift, or the altar that sanctifieth the gift?\wj* 
\v 20 \wj Whoso therefore shall swear by the altar, sweareth by it, and by all things thereon.\wj* 
\v 21 \wj And whoso shall swear by the temple, sweareth by it, and by him that dwelleth therein.\wj* 
\v 22 \wj And he that shall swear by heaven, sweareth by the throne of God, and by him that sitteth thereon.\wj* 
\v 23 \wj Woe unto you, scribes and Pharisees, hypocrites! for ye pay tithe of mint and anise and cummin, and have omitted the weightier matters of the law, judgment, mercy, and faith: these ought ye to have done, and not to leave the other undone.\wj* 
\v 24 \wj Ye blind guides, which strain at a gnat, and swallow a camel.\wj* 
\v 25 \wj Woe unto you, scribes and Pharisees, hypocrites! for ye make clean the outside of the cup and of the platter, but within they are full of extortion and excess.\wj* 
\v 26 \wj Thou blind Pharisee, cleanse first that which is within the cup and platter, that the outside of them may be clean also.\wj* 
\v 27 \wj Woe unto you, scribes and Pharisees, hypocrites! for ye are like unto whited sepulchres, which indeed appear beautiful outward, but are within full of dead men’s bones, and of all uncleanness.\wj* 
\v 28 \wj Even so ye also outwardly appear righteous unto men, but within ye are full of hypocrisy and iniquity.\wj* 
\v 29 \wj Woe unto you, scribes and Pharisees, hypocrites! because ye build the tombs of the prophets, and garnish the sepulchres of the righteous,\wj* 
\v 30 \wj And say, If we had been in the days of our fathers, we would not have been partakers with them in the blood of the prophets.\wj* 
\v 31 \wj Wherefore ye be witnesses unto yourselves, that ye are the children of them which killed the prophets.\wj* 
\v 32 \wj Fill ye up then the measure of your fathers.\wj* 
\v 33 \wj Ye serpents, ye generation of vipers, how can ye escape the damnation of hell?\wj* 
\p
\v 34 \wj Wherefore, behold, I send unto you prophets, and wise men, and scribes: and some of them ye shall kill and crucify; and some of them shall ye scourge in your synagogues, and persecute them from city to city:\wj* 
\v 35 \wj That upon you may come all the righteous blood shed upon the earth, from the blood of righteous Abel unto the blood of Zacharias son of Barachias, whom ye slew between the temple and the altar.\wj* 
\v 36 \wj Verily I say unto you, All these things shall come upon this generation.\wj* 
\v 37 \wj O Jerusalem, Jerusalem, thou that killest the prophets, and stonest them which are sent unto thee, how often would I have gathered thy children together, even as a hen gathereth her chickens under her wings, and ye would not!\wj* 
\v 38 \wj Behold, your house is left unto you desolate.\wj* 
\v 39 \wj For I say unto you, Ye shall not see me henceforth, till ye shall say, Blessed is he that cometh in the name of the Lord.\wj* 
\c 24
\p 
\v 1 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [went out]{strong=“G1831” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”}, [and departed]{strong=“G4198” x-morph=“robinson: V-\sc Ini\sc*-3S 5”} [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 6”} [the temple]{strong=“G3588 G2411” x-morph=“robinson: T-\sc Gsn\sc* robinson: N-\sc Gsn\sc* 7 8”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 13”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 11 12”} [came to]{strong=“G4334” x-morph=“robinson: V-\sc Aai\sc*-3P 10”} him [for to shew]{strong=“G1925” x-morph=“robinson: V-\sc Aan\sc* 14”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 15”} [the buildings]{strong=“G3588 G3619” x-morph=“robinson: T-\sc Apf\sc* robinson: N-\sc Apf\sc* 16 17”} [of the temple]{strong=“G3588 G2411” x-morph=“robinson: T-\sc Gsn\sc* robinson: N-\sc Gsn\sc* 18 19”}. 
\v 2 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 3”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}, \wj See ye not all these things? verily I say unto you, There shall not be left here one stone upon another, that shall not be thrown down.\wj* 
\p
\v 3 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [as]{strong=“G2521” x-morph=“robinson: V-\sc Pnp\sc*-\sc Gsm\sc* 1”} [he]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 3”} [sat]{strong=“G2521” x-morph=“robinson: V-\sc Pnp\sc*-\sc Gsm\sc* 1”} [upon]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 4”} [the mount]{strong=“G3588 G3735” x-morph=“robinson: T-\sc Gsn\sc* robinson: N-\sc Gsn\sc* 5 6”} [of Olives]{strong=“G3588 G1636” x-morph=“robinson: T-\sc Gpf\sc* robinson: N-\sc Gpf\sc* 7 8”}, [the disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 11 12”} [came]{strong=“G4334” x-morph=“robinson: V-\sc Aai\sc*-3P 9”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 10”} [privately]{strong=“G2398” x-morph=“robinson: A-\sc Asf\sc* 14”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 15”}, [Tell]{strong=“G2036” x-morph=“robinson: V-2\sc Aam\sc*-2S 16”} [us]{strong=“G2254” x-morph=“robinson: P-1\sc Dp\sc* 17”}, [when]{strong=“G4219” x-morph=“robinson: \sc Prt\sc*-I 18”} [shall]{strong=“G2071” x-morph=“robinson: V-\sc Fxi\sc*-3S 20”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Npn\sc* 19”} [be]{strong=“G2071” x-morph=“robinson: V-\sc Fxi\sc*-3S 20”}? [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 21”} [what]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 22”} shall be [the sign]{strong=“G3588 G4592” x-morph=“robinson: T-\sc Nsn\sc* robinson: N-\sc Nsn\sc* 23 24”} [of]{strong=“G3952” x-morph=“robinson: N-\sc Gsf\sc* 27”} [thy]{strong=“G4674” x-morph=“robinson: S-2\sc Gsf\sc* 26”} [coming]{strong=“G3952” x-morph=“robinson: N-\sc Gsf\sc* 27”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 28”} [of the end]{strong=“G3588 G4930” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 29 30”} [of the world]{strong=“G3588 G165” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 31 32”}? 
\v 4 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 2”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 6”}, \wj Take heed that no man deceive you.\wj* 
\v 5 \wj For many shall come in my name, saying, I am Christ; and shall deceive many.\wj* 
\v 6 \wj And ye shall hear of wars and rumours of wars: see that ye be not troubled: for all these things must come to pass, but the end is not yet.\wj* 
\v 7 \wj For nation shall rise against nation, and kingdom against kingdom: and there shall be famines, and pestilences, and earthquakes, in divers places.\wj* 
\v 8 \wj All these are the beginning of sorrows.\wj* 
\v 9 \wj Then shall they deliver you up to be afflicted, and shall kill you: and ye shall be hated of all nations for my name’s sake.\wj* 
\v 10 \wj And then shall many be offended, and shall betray one another, and shall hate one another.\wj* 
\v 11 \wj And many false prophets shall rise, and shall deceive many.\wj* 
\v 12 \wj And because iniquity shall abound, the love of many shall wax cold.\wj* 
\v 13 \wj But he that shall endure unto the end, the same shall be saved.\wj* 
\v 14 \wj And this gospel of the kingdom shall be preached in all the world for a witness unto all nations; and then shall the end come.\wj* 
\v 15 \wj When ye therefore shall see the abomination of desolation, spoken of by Daniel the prophet, stand in the holy place, (whoso readeth, let him understand:)\wj* 
\v 16 \wj Then let them which be in Judaea flee into the mountains:\wj* 
\v 17 \wj Let him which is on the housetop not come down to take any thing out of his house:\wj* 
\v 18 \wj Neither let him which is in the field return back to take his clothes.\wj* 
\v 19 \wj And woe unto them that are with child, and to them that give suck in those days!\wj* 
\v 20 \wj But pray ye that your flight be not in the winter, neither on the sabbath day:\wj* 
\v 21 \wj For then shall be great tribulation, such as was not since the beginning of the world to this time, no, nor ever shall be.\wj* 
\v 22 \wj And except those days should be shortened, there should no flesh be saved: but for the elect’s sake those days shall be shortened.\wj* 
\v 23 \wj Then if any man shall say unto you, Lo, here is Christ, or there; believe it not.\wj* 
\v 24 \wj For there shall arise false Christs, and false prophets, and shall shew great signs and wonders; insomuch that, if it were possible, they shall deceive the very elect.\wj* 
\v 25 \wj Behold, I have told you before.\wj* 
\v 26 \wj Wherefore if they shall say unto you, Behold, he is in the desert; go not forth: behold, he is in the secret chambers; believe it not.\wj* 
\v 27 \wj For as the lightning cometh out of the east, and shineth even unto the west; so shall also the coming of the Son of man be.\wj* 
\v 28 \wj For wheresoever the carcase is, there will the eagles be gathered together.\wj* 
\p
\v 29 \wj Immediately after the tribulation of those days shall the sun be darkened, and the moon shall not give her light, and the stars shall fall from heaven, and the powers of the heavens shall be shaken:\wj* 
\v 30 \wj And then shall appear the sign of the Son of man in heaven: and then shall all the tribes of the earth mourn, and they shall see the Son of man coming in the clouds of heaven with power and great glory.\wj* 
\v 31 \wj And he shall send his angels with a great sound of a trumpet, and they shall gather together his elect from the four winds, from one end of heaven to the other.\wj* 
\v 32 \wj Now learn a parable of the fig tree; When his branch is yet tender, and putteth forth leaves, ye know that summer is nigh:\wj* 
\v 33 \wj So likewise ye, when ye shall see all these things, know that it is near, even at the doors.\wj* 
\v 34 \wj Verily I say unto you, This generation shall not pass, till all these things be fulfilled.\wj* 
\v 35 \wj Heaven and earth shall pass away, but my words shall not pass away.\wj* 
\p
\v 36 \wj But of that day and hour knoweth no man, no, not the angels of heaven, but my Father only.\wj* 
\v 37 \wj But as the days of Noe were, so shall also the coming of the Son of man be.\wj* 
\v 38 \wj For as in the days that were before the flood they were eating and drinking, marrying and giving in marriage, until the day that Noe entered into the ark,\wj* 
\v 39 \wj And knew not until the flood came, and took them all away; so shall also the coming of the Son of man be.\wj* 
\v 40 \wj Then shall two be in the field; the one shall be taken, and the other left.\wj* 
\v 41 \wj Two women shall be grinding at the mill; the one shall be taken, and the other left.\wj* 
\p
\v 42 \wj Watch therefore: for ye know not what hour your Lord doth come.\wj* 
\v 43 \wj But know this, that if the goodman of the house had known in what watch the thief would come, he would have watched, and would not have suffered his house to be broken up.\wj* 
\v 44 \wj Therefore be ye also ready: for in such an hour as ye think not the Son of man cometh.\wj* 
\v 45 \wj Who then is a faithful and wise servant, whom his lord hath made ruler over his household, to give them meat in due season?\wj* 
\v 46 \wj Blessed is that servant, whom his lord when he cometh shall find so doing.\wj* 
\v 47 \wj Verily I say unto you, That he shall make him ruler over all his goods.\wj* 
\v 48 \wj But and if that evil servant shall say in his heart, My lord delayeth his coming;\wj* 
\v 49 \wj And shall begin to smite his fellowservants, and to eat and drink with the drunken;\wj* 
\v 50 \wj The lord of that servant shall come in a day when he looketh not for him, and in an hour that he is not aware of,\wj* 
\v 51 \wj And shall cut him asunder, and appoint him his portion with the hypocrites: there shall be weeping and gnashing of teeth.\wj* 
\c 25
\p 
\v 1 \wj Then shall the kingdom of heaven be likened unto ten virgins, which took their lamps, and went forth to meet the bridegroom.\wj* 
\v 2 \wj And five of them were wise, and five were foolish.\wj* 
\v 3 \wj They that were foolish took their lamps, and took no oil with them:\wj* 
\v 4 \wj But the wise took oil in their vessels with their lamps.\wj* 
\v 5 \wj While the bridegroom tarried, they all slumbered and slept.\wj* 
\v 6 \wj And at midnight there was a cry made, Behold, the bridegroom cometh; go ye out to meet him.\wj* 
\v 7 \wj Then all those virgins arose, and trimmed their lamps.\wj* 
\v 8 \wj And the foolish said unto the wise, Give us of your oil; for our lamps are gone out.\wj* 
\v 9 \wj But the wise answered, saying, Not so; lest there be not enough for us and you: but go ye rather to them that sell, and buy for yourselves.\wj* 
\v 10 \wj And while they went to buy, the bridegroom came; and they that were ready went in with him to the marriage: and the door was shut.\wj* 
\v 11 \wj Afterward came also the other virgins, saying, Lord, Lord, open to us.\wj* 
\v 12 \wj But he answered and said, Verily I say unto you, I know you not.\wj* 
\v 13 \wj Watch therefore, for ye know neither the day nor the hour wherein the Son of man cometh.\wj* 
\p
\v 14 \wj For the kingdom of heaven is as a man travelling into a far country, who called his own servants, and delivered unto them his goods.\wj* 
\v 15 \wj And unto one he gave five talents, to another two, and to another one; to every man according to his several ability; and straightway took his journey.\wj* 
\v 16 \wj Then he that had received the five talents went and traded with the same, and made them other five talents.\wj* 
\v 17 \wj And likewise he that had received two, he also gained other two.\wj* 
\v 18 \wj But he that had received one went and digged in the earth, and hid his lord’s money.\wj* 
\v 19 \wj After a long time the lord of those servants cometh, and reckoneth with them.\wj* 
\v 20 \wj And so he that had received five talents came and brought other five talents, saying, Lord, thou deliveredst unto me five talents: behold, I have gained beside them five talents more.\wj* 
\v 21 \wj His lord said unto him, Well done, thou good and faithful servant: thou hast been faithful over a few things, I will make thee ruler over many things: enter thou into the joy of thy lord.\wj* 
\v 22 \wj He also that had received two talents came and said, Lord, thou deliveredst unto me two talents: behold, I have gained two other talents beside them.\wj* 
\v 23 \wj His lord said unto him, Well done, good and faithful servant; thou hast been faithful over a few things, I will make thee ruler over many things: enter thou into the joy of thy lord.\wj* 
\v 24 \wj Then he which had received the one talent came and said, Lord, I knew thee that thou art an hard man, reaping where thou hast not sown, and gathering where thou hast not strawed:\wj* 
\v 25 \wj And I was afraid, and went and hid thy talent in the earth: lo, there thou hast that is thine.\wj* 
\v 26 \wj His lord answered and said unto him, Thou wicked and slothful servant, thou knewest that I reap where I sowed not, and gather where I have not strawed:\wj* 
\v 27 \wj Thou oughtest therefore to have put my money to the exchangers, and then at my coming I should have received mine own with usury.\wj* 
\v 28 \wj Take therefore the talent from him, and give it unto him which hath ten talents.\wj* 
\v 29 \wj For unto every one that hath shall be given, and he shall have abundance: but from him that hath not shall be taken away even that which he hath.\wj* 
\v 30 \wj And cast ye the unprofitable servant into outer darkness: there shall be weeping and gnashing of teeth.\wj* 
\p
\v 31 \wj When the Son of man shall come in his glory, and all the holy angels with him, then shall he sit upon the throne of his glory:\wj* 
\v 32 \wj And before him shall be gathered all nations: and he shall separate them one from another, as a shepherd divideth his sheep from the goats:\wj* 
\v 33 \wj And he shall set the sheep on his right hand, but the goats on the left.\wj* 
\v 34 \wj Then shall the King say unto them on his right hand, Come, ye blessed of my Father, inherit the kingdom prepared for you from the foundation of the world:\wj* 
\v 35 \wj For I was an hungred, and ye gave me meat: I was thirsty, and ye gave me drink: I was a stranger, and ye took me in:\wj* 
\v 36 \wj Naked, and ye clothed me: I was sick, and ye visited me: I was in prison, and ye came unto me.\wj* 
\v 37 \wj Then shall the righteous answer him, saying, Lord, when saw we thee an hungred, and fed thee? or thirsty, and gave thee drink?\wj* 
\v 38 \wj When saw we thee a stranger, and took thee in? or naked, and clothed thee?\wj* 
\v 39 \wj Or when saw we thee sick, or in prison, and came unto thee?\wj* 
\v 40 \wj And the King shall answer and say unto them, Verily I say unto you, Inasmuch as ye have done it unto one of the least of these my brethren, ye have done it unto me.\wj* 
\v 41 \wj Then shall he say also unto them on the left hand, Depart from me, ye cursed, into everlasting fire, prepared for the devil and his angels:\wj* 
\v 42 \wj For I was an hungred, and ye gave me no meat: I was thirsty, and ye gave me no drink:\wj* 
\v 43 \wj I was a stranger, and ye took me not in: naked, and ye clothed me not: sick, and in prison, and ye visited me not.\wj* 
\v 44 \wj Then shall they also answer him, saying, Lord, when saw we thee an hungred, or athirst, or a stranger, or naked, or sick, or in prison, and did not minister unto thee?\wj* 
\v 45 \wj Then shall he answer them, saying, Verily I say unto you, Inasmuch as ye did it not to one of the least of these, ye did it not to me.\wj* 
\v 46 \wj And these shall go away into everlasting punishment: but the righteous into life eternal.\wj* 
\c 26
\p 
\v 1 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [it came to pass]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 2”}, [when]{strong=“G3753” x-morph=“robinson: \sc Adv\sc* 3”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [had finished]{strong=“G5055” x-morph=“robinson: V-\sc Aai\sc*-3S 4”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Apm\sc* 7”} [these]{strong=“G5128” x-morph=“robinson: D-\sc Apm\sc* 10”} [sayings]{strong=“G3588 G3056” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 8 9”}, [he said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 11”} [unto]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 12 13”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 14”} [disciples]{strong=“G3101” x-morph=“robinson: N-\sc Dpm\sc* 13”}, 
\v 2 \wj Ye know that after two days is the feast of the passover, and the Son of man is betrayed to be crucified.\wj* 
\v 3 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [assembled together]{strong=“G4863” x-morph=“robinson: V-\sc Api\sc*-3P 2”} [the chief priests]{strong=“G3588 G749” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [the scribes]{strong=“G3588 G1122” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 6 7”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [the elders]{strong=“G4245” x-morph=“robinson: A-\sc Npm\sc* 10”} [of the people]{strong=“G3588 G2992” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 11 12”}, [unto]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 13”} [the palace]{strong=“G3588 G833” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 14 15”} [of the high priest]{strong=“G3588 G749” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 16 17”}, [who was called]{strong=“G3004” x-morph=“robinson: V-\sc Ppp\sc*-\sc Gsm\sc* 19”} [Caiaphas]{strong=“G2533” x-morph=“robinson: N-\sc Gsm\sc* 20”}, 
\v 4 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [consulted]{strong=“G4823” x-morph=“robinson: V-\sc Ami\sc*-3P 2”} [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 3”} [they might take]{strong=“G2902” x-morph=“robinson: V-\sc Aas\sc*-3P 6”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 4 5”} [by subtilty]{strong=“G1388” x-morph=“robinson: N-\sc Dsm\sc* 7”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [kill]{strong=“G615” x-morph=“robinson: V-\sc Pas\sc*-3P 9”} him. 
\v 5 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [they said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3P 1”}, [Not]{strong=“G3361” x-morph=“robinson: \sc Prt\sc*-N 3”} [on]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 4”} [the feast]{strong=“G3588 G1859” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 5 6”} day, [lest]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 7”} [there be]{strong=“G1096” x-morph=“robinson: V-2\sc Ads\sc*-3S 10”} [an uproar]{strong=“G2351” x-morph=“robinson: N-\sc Nsm\sc* 9”} [among]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 11”} [the people]{strong=“G3588 G2992” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 12 13”}. 
\p
\v 6 [Now]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [when]{strong=“G1096” x-morph=“robinson: V-2\sc Adp\sc*-\sc Gsm\sc* 4”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Gsm\sc* 3”} [was]{strong=“G1096” x-morph=“robinson: V-2\sc Adp\sc*-\sc Gsm\sc* 4”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 5”} [Bethany]{strong=“G963” x-morph=“robinson: N-\sc Dsf\sc* 6”}, [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 7”} [the house]{strong=“G3614” x-morph=“robinson: N-\sc Dsf\sc* 8”} [of Simon]{strong=“G4613” x-morph=“robinson: N-\sc Gsm\sc* 9”} [the leper]{strong=“G3015” x-morph=“robinson: A-\sc Gsm\sc* 11”}, 
\v 7 [There came unto]{strong=“G4334” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”} [a woman]{strong=“G1135” x-morph=“robinson: N-\sc Nsf\sc* 3”} [having]{strong=“G2192” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsf\sc* 6”} [an alabaster box]{strong=“G211” x-morph=“robinson: N-\sc Asn\sc* 4”} [of]{strong=“G3464” x-morph=“robinson: N-\sc Gsn\sc* 5”} [very precious]{strong=“G927” x-morph=“robinson: A-\sc Gsn\sc* 7”} [ointment]{strong=“G3464” x-morph=“robinson: N-\sc Gsn\sc* 5”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [poured it]{strong=“G2708” x-morph=“robinson: V-\sc Aai\sc*-3S 9”} [on]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 10”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 13”} [head]{strong=“G3588 G2776” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 11 12”}, [as he sat]{strong=“G345” x-morph=“robinson: V-\sc Pnp\sc*-\sc Gsm\sc* 14”} at meat. 
\v 8 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [when]{strong=“G1492” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 1”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 5”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [saw]{strong=“G1492” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 1”} it, [they had indignation]{strong=“G23” x-morph=“robinson: V-\sc Aai\sc*-3P 6”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 7”}, [To]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 8”} [what purpose]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 9”} is [this]{strong=“G3778” x-morph=“robinson: D-\sc Nsf\sc* 12”} [waste]{strong=“G3588 G684” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 10 11”}? 
