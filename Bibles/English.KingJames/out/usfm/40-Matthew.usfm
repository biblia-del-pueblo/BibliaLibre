\p 
\v 1 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when he had called unto]{strong=“G4341” x-morph=“robinson: V-\sc Adp\sc*-\sc Nsm\sc* 2”} him [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 6”} [twelve]{strong=“G1427” x-morph=“robinson: A-\sc Nui\sc* 4”} [disciples]{strong=“G3101” x-morph=“robinson: N-\sc Apm\sc* 5”}, [he gave]{strong=“G1325” x-morph=“robinson: V-\sc Aai\sc*-3S 7”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 8”} [power]{strong=“G1849” x-morph=“robinson: N-\sc Asf\sc* 9”} against [unclean]{strong=“G169” x-morph=“robinson: A-\sc Gpn\sc* 11”} [spirits]{strong=“G4151” x-morph=“robinson: N-\sc Gpn\sc* 10”}, [to]{strong=“G5620” x-morph=“robinson: \sc Conj\sc* 12”} [cast]{strong=“G1544” x-morph=“robinson: V-\sc Pan\sc* 13”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apn\sc* 14”} [out]{strong=“G1544” x-morph=“robinson: V-\sc Pan\sc* 13”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 15”} [to heal]{strong=“G2323” x-morph=“robinson: V-\sc Pan\sc* 16”} [all manner of]{strong=“G3956” x-morph=“robinson: A-\sc Asf\sc* 17”} [sickness]{strong=“G3554” x-morph=“robinson: N-\sc Asf\sc* 18”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 19”} [all manner of]{strong=“G3956” x-morph=“robinson: A-\sc Asf\sc* 20”} [disease]{strong=“G3119” x-morph=“robinson: N-\sc Asf\sc* 21”}. 
\v 2 [Now]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [the names]{strong=“G3588 G3686” x-morph=“robinson: T-\sc Npn\sc* robinson: N-\sc Npn\sc* 5 6”} [of the]{strong=“G652” x-morph=“robinson: N-\sc Gpm\sc* 4”} [twelve]{strong=“G1427” x-morph=“robinson: A-\sc Nui\sc* 3”} [apostles]{strong=“G652” x-morph=“robinson: N-\sc Gpm\sc* 4”} [are]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 7”} [these]{strong=“G5023” x-morph=“robinson: D-\sc Npn\sc* 8”}; [The first]{strong=“G4413” x-morph=“robinson: A-\sc Nsm\sc* 9”}, [Simon]{strong=“G4613” x-morph=“robinson: N-\sc Nsm\sc* 10”}, [who is called]{strong=“G3004” x-morph=“robinson: V-\sc Ppp\sc*-\sc Nsm\sc* 12”} [Peter]{strong=“G4074” x-morph=“robinson: N-\sc Nsm\sc* 13”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [Andrew]{strong=“G406” x-morph=“robinson: N-\sc Nsm\sc* 15”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 18”} [brother]{strong=“G3588 G80” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 16 17”}; [James]{strong=“G2385” x-morph=“robinson: N-\sc Nsm\sc* 19”} the son [of Zebedee]{strong=“G3588 G2199” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 21 22”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 23”} [John]{strong=“G2491” x-morph=“robinson: N-\sc Nsm\sc* 24”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 27”} [brother]{strong=“G3588 G80” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 25 26”}; 
\v 3 [Philip]{strong=“G5376” x-morph=“robinson: N-\sc Nsm\sc* 1”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 2”} [Bartholomew]{strong=“G918” x-morph=“robinson: N-\sc Nsm\sc* 3”}; [Thomas]{strong=“G2381” x-morph=“robinson: N-\sc Nsm\sc* 4”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [Matthew]{strong=“G3156” x-morph=“robinson: N-\sc Nsm\sc* 6”} [the publican]{strong=“G3588 G5057” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 7 8”}; [James]{strong=“G2385” x-morph=“robinson: N-\sc Nsm\sc* 9”} the son [of Alphaeus]{strong=“G3588 G256” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 11 12”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 13”} [Lebbaeus]{strong=“G3002” x-morph=“robinson: N-\sc Nsm\sc* 14”}, [whose surname was]{strong=“G1941” x-morph=“robinson: V-\sc App\sc*-\sc Nsm\sc* 16”} [Thaddaeus]{strong=“G2280” x-morph=“robinson: N-\sc Nsm\sc* 17”}; 
\v 4 [Simon]{strong=“G4613” x-morph=“robinson: N-\sc Nsm\sc* 1”} [the Canaanite]{strong=“G3588 G2581” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 2 3”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 4”} [Judas]{strong=“G2455” x-morph=“robinson: N-\sc Nsm\sc* 5”} [Iscariot]{strong=“G2469” x-morph=“robinson: N-\sc Nsm\sc* 6”}, [who]{strong=“G3860” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 9”} [also]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [betrayed]{strong=“G3860” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 9”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 10”}. 
\v 5 [These]{strong=“G5128” x-morph=“robinson: D-\sc Apm\sc* 1”} [twelve]{strong=“G1427” x-morph=“robinson: A-\sc Nui\sc* 3”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [sent forth]{strong=“G649” x-morph=“robinson: V-\sc Aai\sc*-3S 4”}, [and commanded]{strong=“G3853” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 7”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 8”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 9”}, \wj Go not into the way of the Gentiles, and into any city of the Samaritans enter ye not:\wj* 
\v 6 \wj But go rather to the lost sheep of the house of Israel.\wj* 
\v 7 \wj And as ye go, preach, saying, The kingdom of heaven is at hand.\wj* 
\v 8 \wj Heal the sick, cleanse the lepers, raise the dead, cast out devils: freely ye have received, freely give.\wj* 
\v 9 \wj Provide neither gold, nor silver, nor brass in your purses,\wj* 
\v 10 \wj Nor scrip for your journey, neither two coats, neither shoes, nor yet staves: for the workman is worthy of his meat.\wj* 
\v 11 \wj And into whatsoever city or town ye shall enter, enquire who in it is worthy; and there abide till ye go thence.\wj* 
\v 12 \wj And when ye come into an house, salute it.\wj* 
\v 13 \wj And if the house be worthy, let your peace come upon it: but if it be not worthy, let your peace return to you.\wj* 
\v 14 \wj And whosoever shall not receive you, nor hear your words, when ye depart out of that house or city, shake off the dust of your feet.\wj* 
\v 15 \wj Verily I say unto you, It shall be more tolerable for the land of Sodom and Gomorrha in the day of judgment, than for that city.\wj* 
\p
\v 16 \wj Behold, I send you forth as sheep in the midst of wolves: be ye therefore wise as serpents, and harmless as doves.\wj* 
\v 17 \wj But beware of men: for they will deliver you up to the councils, and they will scourge you in their synagogues;\wj* 
\v 18 \wj And ye shall be brought before governors and kings for my sake, for a testimony against them and the Gentiles.\wj* 
\v 19 \wj But when they deliver you up, take no thought how or what ye shall speak: for it shall be given you in that same hour what ye shall speak.\wj* 
\v 20 \wj For it is not ye that speak, but the Spirit of your Father which speaketh in you.\wj* 
\v 21 \wj And the brother shall deliver up the brother to death, and the father the child: and the children shall rise up against their parents, and cause them to be put to death.\wj* 
\v 22 \wj And ye shall be hated of all men for my name’s sake: but he that endureth to the end shall be saved.\wj* 
\v 23 \wj But when they persecute you in this city, flee ye into another: for verily I say unto you, Ye shall not have gone over the cities of Israel, till the Son of man be come.\wj* 
\v 24 \wj The disciple is not above his master, nor the servant above his lord.\wj* 
\v 25 \wj It is enough for the disciple that he be as his master, and the servant as his lord. If they have called the master of the house Beelzebub, how much more shall they call them of his household?\wj* 
\v 26 \wj Fear them not therefore: for there is nothing covered, that shall not be revealed; and hid, that shall not be known.\wj* 
\v 27 \wj What I tell you in darkness, that speak ye in light: and what ye hear in the ear, that preach ye upon the housetops.\wj* 
\v 28 \wj And fear not them which kill the body, but are not able to kill the soul: but rather fear him which is able to destroy both soul and body in hell.\wj* 
\v 29 \wj Are not two sparrows sold for a farthing? and one of them shall not fall on the ground without your Father.\wj* 
\v 30 \wj But the very hairs of your head are all numbered.\wj* 
\v 31 \wj Fear ye not therefore, ye are of more value than many sparrows.\wj* 
\v 32 \wj Whosoever therefore shall confess me before men, him will I confess also before my Father which is in heaven.\wj* 
\v 33 \wj But whosoever shall deny me before men, him will I also deny before my Father which is in heaven.\wj* 
\v 34 \wj Think not that I am come to send peace on earth: I came not to send peace, but a sword.\wj* 
\v 35 \wj For I am come to set a man at variance against his father, and the daughter against her mother, and the daughter in law against her mother in law.\wj* 
\v 36 \wj And a man’s foes shall be they of his own household.\wj* 
\v 37 \wj He that loveth father or mother more than me is not worthy of me: and he that loveth son or daughter more than me is not worthy of me.\wj* 
\v 38 \wj And he that taketh not his cross, and followeth after me, is not worthy of me.\wj* 
\v 39 \wj He that findeth his life shall lose it: and he that loseth his life for my sake shall find it.\wj* 
\p
\v 40 \wj He that receiveth you receiveth me, and he that receiveth me receiveth him that sent me.\wj* 
\v 41 \wj He that receiveth a prophet in the name of a prophet shall receive a prophet’s reward; and he that receiveth a righteous man in the name of a righteous man shall receive a righteous man’s reward.\wj* 
\v 42 \wj And whosoever shall give to drink unto one of these little ones a cup of cold water only in the name of a disciple, verily I say unto you, he shall in no wise lose his reward.\wj* 
\c 11
\p 
\v 1 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [it came to pass]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3S 2”}, [when]{strong=“G3753” x-morph=“robinson: \sc Adv\sc* 3”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [had made an end of]{strong=“G5055” x-morph=“robinson: V-\sc Aai\sc*-3S 4”} [commanding]{strong=“G1299” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 7”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 11”} [twelve]{strong=“G1427” x-morph=“robinson: A-\sc Nui\sc* 9”} [disciples]{strong=“G3101” x-morph=“robinson: N-\sc Dpm\sc* 10”}, [he departed]{strong=“G3327” x-morph=“robinson: V-2\sc Aai\sc*-3S 12”} [thence]{strong=“G1564” x-morph=“robinson: \sc Adv\sc* 13”} [to teach]{strong=“G1321” x-morph=“robinson: V-\sc Pan\sc* 15”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 16”} [to preach]{strong=“G2784” x-morph=“robinson: V-\sc Pan\sc* 17”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 18”} [their]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 21”} [cities]{strong=“G3588 G4172” x-morph=“robinson: T-\sc Dpf\sc* robinson: N-\sc Dpf\sc* 19 20”}. 
\v 2 [Now when]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [John]{strong=“G2491” x-morph=“robinson: N-\sc Nsm\sc* 3”} [had heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 4”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 5”} [the prison]{strong=“G3588 G1201” x-morph=“robinson: T-\sc Dsn\sc* robinson: N-\sc Dsn\sc* 6 7”} [the works]{strong=“G3588 G2041” x-morph=“robinson: T-\sc Apn\sc* robinson: N-\sc Apn\sc* 8 9”} [of Christ]{strong=“G3588 G5547” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 10 11”}, [he sent]{strong=“G3992” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsm\sc* 12”} [two]{strong=“G1417” x-morph=“robinson: A-\sc Nui\sc* 13”} [of]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 14 15”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 16”} [disciples]{strong=“G3101” x-morph=“robinson: N-\sc Gpm\sc* 15”}, 
\v 3 [And said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 2”}, [Art]{strong=“G1488” x-morph=“robinson: V-\sc Pxi\sc*-2S 4”} [thou]{strong=“G4771” x-morph=“robinson: P-2\sc Ns\sc* 3”} [he that should come]{strong=“G2064” x-morph=“robinson: V-\sc Pnp\sc*-\sc Nsm\sc* 6”}, [or]{strong=“G2228” x-morph=“robinson: \sc Prt\sc* 7”} [do we look for]{strong=“G4328” x-morph=“robinson: V-\sc Pai\sc*-1P 9”} [another]{strong=“G2087” x-morph=“robinson: A-\sc Asm\sc* 8”}? 
\v 4 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 2”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 6”}, \wj Go and shew John again those things which ye do hear and see:\wj* 
\v 5 \wj The blind receive their sight, and the lame walk, the lepers are cleansed, and the deaf hear, the dead are raised up, and the poor have the gospel preached to them.\wj* 
\v 6 \wj And blessed is he, whosoever shall not be offended in me.\wj* 
\p
\v 7 [And as]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [they]{strong=“G5130” x-morph=“robinson: D-\sc Gpm\sc* 1”} [departed]{strong=“G4198” x-morph=“robinson: V-\sc Pnp\sc*-\sc Gpm\sc* 3”}, [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 5 6”} [began]{strong=“G756” x-morph=“robinson: V-\sc Adi\sc*-3S 4”} [to say]{strong=“G3004” x-morph=“robinson: V-\sc Pan\sc* 7”} [unto the multitudes]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 8 9”} [concerning]{strong=“G4012” x-morph=“robinson: \sc Prep\sc* 10”} [John]{strong=“G2491” x-morph=“robinson: N-\sc Gsm\sc* 11”}, \wj What went ye out into the wilderness to see? A reed shaken with the wind?\wj* 
\v 8 \wj But what went ye out for to see? A man clothed in soft raiment? behold, they that wear soft clothing are in kings’ houses.\wj* 
\v 9 \wj But what went ye out for to see? A prophet? yea, I say unto you, and more than a prophet.\wj* 
\v 10 \wj For this is he, of whom it is written, Behold, I send my messenger before thy face, which shall prepare thy way before thee.\wj* 
\v 11 \wj Verily I say unto you, Among them that are born of women there hath not risen a greater than John the Baptist: notwithstanding he that is least in the kingdom of heaven is greater than he.\wj* 
\v 12 \wj And from the days of John the Baptist until now the kingdom of heaven suffereth violence, and the violent take it by force.\wj* 
\v 13 \wj For all the prophets and the law prophesied until John.\wj* 
\v 14 \wj And if ye will receive it, this is Elias, which was for to come.\wj* 
\v 15 \wj He that hath ears to hear, let him hear.\wj* 
\p
\v 16 \wj But whereunto shall I liken this generation? It is like unto children sitting in the markets, and calling unto their fellows,\wj* 
\v 17 \wj And saying, We have piped unto you, and ye have not danced; we have mourned unto you, and ye have not lamented.\wj* 
\v 18 \wj For John came neither eating nor drinking, and they say, He hath a devil.\wj* 
\v 19 \wj The Son of man came eating and drinking, and they say, Behold a man gluttonous, and a winebibber, a friend of publicans and sinners. But wisdom is justified of her children.\wj* 
\p
\v 20 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [began he]{strong=“G756” x-morph=“robinson: V-\sc Adi\sc*-3S 2”} [to upbraid]{strong=“G3679” x-morph=“robinson: V-\sc Pan\sc* 3”} [the cities]{strong=“G3588 G4172” x-morph=“robinson: T-\sc Apf\sc* robinson: N-\sc Apf\sc* 4 5”} [where]{strong=“G3739” x-morph=“robinson: R-\sc Dpf\sc* 7”}[in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 6”} [most]{strong=“G4118” x-morph=“robinson: A-\sc Npf\sc* 10”} [of]{strong=“G1411” x-morph=“robinson: N-\sc Npf\sc* 11”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 12”} [mighty works]{strong=“G1411” x-morph=“robinson: N-\sc Npf\sc* 11”} [were done]{strong=“G1096” x-morph=“robinson: V-2\sc Adi\sc*-3P 8”}, [because]{strong=“G3754” x-morph=“robinson: \sc Conj\sc* 13”} [they repented]{strong=“G3340” x-morph=“robinson: V-\sc Aai\sc*-3P 15”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 14”}: 
\v 21 \wj Woe unto thee, Chorazin! woe unto thee, Bethsaida! for if the mighty works, which were done in you, had been done in Tyre and Sidon, they would have repented long ago in sackcloth and ashes.\wj* 
\v 22 \wj But I say unto you, It shall be more tolerable for Tyre and Sidon at the day of judgment, than for you.\wj* 
\v 23 \wj And thou, Capernaum, which art exalted unto heaven, shalt be brought down to hell: for if the mighty works, which have been done in thee, had been done in Sodom, it would have remained until this day.\wj* 
\v 24 \wj But I say unto you, That it shall be more tolerable for the land of Sodom in the day of judgment, than for thee.\wj* 
\p
\v 25 [At]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 1”} [that]{strong=“G1565” x-morph=“robinson: D-\sc Dsm\sc* 2”} [time]{strong=“G3588 G2540” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 3 4”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 6 7”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 5”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 8”}, \wj I thank thee, O Father, Lord of heaven and earth, because thou hast hid these things from the wise and prudent, and hast revealed them unto babes.\wj* 
\v 26 \wj Even so, Father: for so it seemed good in thy sight.\wj* 
\v 27 \wj All things are delivered unto me of my Father: and no man knoweth the Son, but the Father; neither knoweth any man the Father, save the Son, and he to whomsoever the Son will reveal him.\wj* 
\p
\v 28 \wj Come unto me, all ye that labour and are heavy laden, and I will give you rest.\wj* 
\v 29 \wj Take my yoke upon you, and learn of me; for I am meek and lowly in heart: and ye shall find rest unto your souls.\wj* 
\v 30 \wj For my yoke is easy, and my burden is light.\wj* 
\c 12
\p 
\v 1 [At]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 1”} [that]{strong=“G1565” x-morph=“robinson: D-\sc Dsm\sc* 2”} [time]{strong=“G3588 G2540” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 3 4”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 6 7”} [went on]{strong=“G4198” x-morph=“robinson: V-\sc Aoi\sc*-3S 5”} [the sabbath day]{strong=“G3588 G4521” x-morph=“robinson: T-\sc Dpn\sc* robinson: N-\sc Dpn\sc* 8 9”} [through]{strong=“G1223” x-morph=“robinson: \sc Prep\sc* 10”} [the corn]{strong=“G4702” x-morph=“robinson: A-\sc Gpm\sc* 12”}; [and]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 14”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 16”} [disciples]{strong=“G3101” x-morph=“robinson: N-\sc Npm\sc* 15”} [were an hungred]{strong=“G3983” x-morph=“robinson: V-\sc Aai\sc*-3P 17”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 18”} [began]{strong=“G756” x-morph=“robinson: V-\sc Adi\sc*-3P 19”} [to pluck]{strong=“G5089” x-morph=“robinson: V-\sc Pan\sc* 20”} [the ears of corn]{strong=“G4719” x-morph=“robinson: N-\sc Apm\sc* 21”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 22”} [to eat]{strong=“G2068” x-morph=“robinson: V-\sc Pan\sc* 23”}. 
\v 2 [But when]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [the Pharisees]{strong=“G5330” x-morph=“robinson: N-\sc Npm\sc* 3”} [saw]{strong=“G1492” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 4”} it, [they said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 5”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 6”}, [Behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 7”}, [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 10”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 8 9”} [do]{strong=“G4160” x-morph=“robinson: V-\sc Pai\sc*-3P 11”} [that which]{strong=“G3739” x-morph=“robinson: R-\sc Asn\sc* 12”} [is]{strong=“G1832” x-morph=“robinson: V-\sc Pqi\sc*-3S 14”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 13”} [lawful]{strong=“G1832” x-morph=“robinson: V-\sc Pqi\sc*-3S 14”} [to do]{strong=“G4160” x-morph=“robinson: V-\sc Pan\sc* 15”} [upon]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 16”} [the sabbath day]{strong=“G4521” x-morph=“robinson: N-\sc Dsn\sc* 17”}. 
\v 3 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he]{strong=“G3588” x-morph=“robinson: T-\sc Nsm\sc* 1”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 4”}, \wj Have ye not read what David did, when he was an hungred, and they that were with him;\wj* 
\v 4 \wj How he entered into the house of God, and did eat the shewbread, which was not lawful for him to eat, neither for them which were with him, but only for the priests?\wj* 
\v 5 \wj Or have ye not read in the law, how that on the sabbath days the priests in the temple profane the sabbath, and are blameless?\wj* 
\v 6 \wj But I say unto you, That in this place is one greater than the temple.\wj* 
\v 7 \wj But if ye had known what this meaneth, I will have mercy, and not sacrifice, ye would not have condemned the guiltless.\wj* 
\v 8 \wj For the Son of man is Lord even of the sabbath day.\wj* 
\v 9 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [when he was departed]{strong=“G3327” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”} [thence]{strong=“G1564” x-morph=“robinson: \sc Adv\sc* 3”}, [he went]{strong=“G2064” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 5”} [their]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 8”} [synagogue]{strong=“G3588 G4864” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 6 7”}: 
\p
\v 10 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”}, [behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 2”}, [there was]{strong=“G2258” x-morph=“robinson: V-IXI-3S 4”} [a man]{strong=“G444” x-morph=“robinson: N-\sc Nsm\sc* 3”} [which had]{strong=“G2192” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 7”} his [hand]{strong=“G3588 G5495” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 5 6”} [withered]{strong=“G3584” x-morph=“robinson: N-\sc Asf\sc* 8”}. [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [they asked]{strong=“G1905” x-morph=“robinson: V-\sc Aai\sc*-3P 10”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 11”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 12”}, [Is it lawful]{strong=“G1832” x-morph=“robinson: V-\sc Pqi\sc*-3S 14”} [to heal]{strong=“G2323” x-morph=“robinson: V-\sc Pan\sc* 17”} [on the sabbath days]{strong=“G3588 G4521” x-morph=“robinson: T-\sc Dpn\sc* robinson: N-\sc Dpn\sc* 15 16”}? [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 18”} [they might accuse]{strong=“G2723” x-morph=“robinson: V-\sc Aas\sc*-3P 19”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 20”}. 
\v 11 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he]{strong=“G3588” x-morph=“robinson: T-\sc Nsm\sc* 1”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 3”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 4”}, \wj What man shall there be among you, that shall have one sheep, and if it fall into a pit on the sabbath day, will he not lay hold on it, and lift it out?\wj* 
\v 12 \wj How much then is a man better than a sheep? Wherefore it is lawful to do well on the sabbath days.\wj* 
\v 13 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [saith he]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 2”} [to the man]{strong=“G3588 G444” x-morph=“robinson: T-\sc Dsm\sc* robinson: N-\sc Dsm\sc* 3 4”}, \wj Stretch forth thine hand.\wj* [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [he stretched]{strong=“G1614” x-morph=“robinson: V-\sc Aai\sc*-3S 10”} it [forth]{strong=“G1614” x-morph=“robinson: V-\sc Aai\sc*-3S 10”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [it was restored]{strong=“G600” x-morph=“robinson: V-\sc Api\sc*-3S 12”} [whole]{strong=“G5199” x-morph=“robinson: A-\sc Nsf\sc* 13”}, [like as]{strong=“G5613” x-morph=“robinson: \sc Adv\sc* 14”} [the other]{strong=“G243” x-morph=“robinson: A-\sc Nsf\sc* 16”}. 
\p
\v 14 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [the Pharisees]{strong=“G5330” x-morph=“robinson: N-\sc Npm\sc* 3”} [went out]{strong=“G1831” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 8”}, [and held]{strong=“G2983” x-morph=“robinson: V-2\sc Aai\sc*-3P 5”} [a council]{strong=“G4824” x-morph=“robinson: N-\sc Asn\sc* 4”} [against]{strong=“G2596” x-morph=“robinson: \sc Prep\sc* 6”} [him]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 7”}, [how]{strong=“G3704” x-morph=“robinson: \sc Adv\sc* 9”} [they might destroy]{strong=“G622” x-morph=“robinson: V-\sc Aas\sc*-3P 11”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 10”}. 
\v 15 [But when]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G2424” x-morph=“robinson: N-\sc Nsm\sc* 3”} [knew]{strong=“G1097” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 4”} it, [he withdrew himself]{strong=“G402” x-morph=“robinson: V-\sc Aai\sc*-3S 5”} [from thence]{strong=“G1564” x-morph=“robinson: \sc Adv\sc* 6”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 7”} [great]{strong=“G4183” x-morph=“robinson: A-\sc Npm\sc* 11”} [multitudes]{strong=“G3793” x-morph=“robinson: N-\sc Npm\sc* 10”} [followed]{strong=“G190” x-morph=“robinson: V-\sc Aai\sc*-3P 8”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 9”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 12”} [he healed]{strong=“G2323” x-morph=“robinson: V-\sc Aai\sc*-3S 13”} [them]{strong=“G846” x-morph=“robinson: P-\sc Apm\sc* 14”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Apm\sc* 15”}; 
\v 16 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [charged]{strong=“G2008” x-morph=“robinson: V-\sc Aai\sc*-3S 2”} [them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”} [that]{strong=“G2443” x-morph=“robinson: \sc Conj\sc* 4”} [they should]{strong=“G4160” x-morph=“robinson: V-\sc Aas\sc*-3P 8”} [not]{strong=“G3361” x-morph=“robinson: \sc Prt\sc*-N 5”} [make]{strong=“G4160” x-morph=“robinson: V-\sc Aas\sc*-3P 8”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 7”} [known]{strong=“G5318” x-morph=“robinson: A-\sc Asm\sc* 6”}: 
\v 17 [That]{strong=“G3704” x-morph=“robinson: \sc Adv\sc* 1”} [it might be fulfilled]{strong=“G4137” x-morph=“robinson: V-\sc Aps\sc*-3S 2”} [which was spoken]{strong=“G4483” x-morph=“robinson: V-\sc App\sc*-\sc Nsn\sc* 4”} [by]{strong=“G1223” x-morph=“robinson: \sc Prep\sc* 5”} [Esaias]{strong=“G2268” x-morph=“robinson: N-\sc Gsm\sc* 6”} [the prophet]{strong=“G3588 G4396” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 7 8”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Gsn\sc* 9”}, 
\v 18 [Behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 1”} [my]{strong=“G3450” x-morph=“robinson: P-1\sc Gs\sc* 4”} [servant]{strong=“G3588 G3816” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 2 3”}, [whom]{strong=“G3739” x-morph=“robinson: R-\sc Asm\sc* 5”} [I have chosen]{strong=“G140” x-morph=“robinson: V-\sc Aai\sc*-1S 6”}; [my]{strong=“G3450” x-morph=“robinson: P-1\sc Gs\sc* 9”} [beloved]{strong=“G27” x-morph=“robinson: A-\sc Nsm\sc* 8”}, [in]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 10”} [whom]{strong=“G3739” x-morph=“robinson: R-\sc Asm\sc* 11”} [my]{strong=“G3450” x-morph=“robinson: P-1\sc Gs\sc* 15”} [soul]{strong=“G3588 G5590” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 13 14”} [is well pleased]{strong=“G2106” x-morph=“robinson: V-\sc Aai\sc*-3S 12”}: [I will put]{strong=“G5087” x-morph=“robinson: V-\sc Fai\sc*-1S 16”} [my]{strong=“G3450” x-morph=“robinson: P-1\sc Gs\sc* 19”} [spirit]{strong=“G3588 G4151” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 17 18”} [upon]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 20”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 21”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 22”} [he shall shew]{strong=“G518” x-morph=“robinson: V-\sc Fai\sc*-3S 26”} [judgment]{strong=“G2920” x-morph=“robinson: N-\sc Asf\sc* 23”} [to the Gentiles]{strong=“G3588 G1484” x-morph=“robinson: T-\sc Dpn\sc* robinson: N-\sc Dpn\sc* 24 25”}. 
\v 19 [He shall]{strong=“G2051” x-morph=“robinson: V-\sc Fai\sc*-3S 2”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 1”} [strive]{strong=“G2051” x-morph=“robinson: V-\sc Fai\sc*-3S 2”}, [nor]{strong=“G3761” x-morph=“robinson: \sc Adv\sc* 3”} [cry]{strong=“G2905” x-morph=“robinson: V-\sc Fai\sc*-3S 4”}; [neither]{strong=“G3761” x-morph=“robinson: \sc Adv\sc* 5”} [shall]{strong=“G191” x-morph=“robinson: V-\sc Fai\sc*-3S 6”} [any man]{strong=“G5100” x-morph=“robinson: X-\sc Nsm\sc* 7”} [hear]{strong=“G191” x-morph=“robinson: V-\sc Fai\sc*-3S 6”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 13”} [voice]{strong=“G3588 G5456” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 11 12”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 8”} [the streets]{strong=“G3588 G4113” x-morph=“robinson: T-\sc Dpf\sc* robinson: N-\sc Dpf\sc* 9 10”}. 
\v 20 [A bruised]{strong=“G4937” x-morph=“robinson: V-\sc Rpp\sc*-\sc Asm\sc* 2”} [reed]{strong=“G2563” x-morph=“robinson: N-\sc Asm\sc* 1”} [shall he]{strong=“G2608” x-morph=“robinson: V-\sc Aai\sc*-3S 4”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 3”} [break]{strong=“G2608” x-morph=“robinson: V-\sc Aai\sc*-3S 4”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 5”} [smoking]{strong=“G5188” x-morph=“robinson: V-\sc Ppp\sc*-\sc Asn\sc* 7”} [flax]{strong=“G3043” x-morph=“robinson: N-\sc Asn\sc* 6”} [shall he]{strong=“G4570” x-morph=“robinson: V-\sc Fai\sc*-3S 9”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 8”} [quench]{strong=“G4570” x-morph=“robinson: V-\sc Fai\sc*-3S 9”}, [till]{strong=“G2193” x-morph=“robinson: \sc Conj\sc* 10”} [he send forth]{strong=“G1544” x-morph=“robinson: V-2\sc Aas\sc*-3S 12”} [judgment]{strong=“G3588 G2920” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 15 16”} [unto]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 13”} [victory]{strong=“G3534” x-morph=“robinson: N-\sc Asn\sc* 14”}. 
\v 21 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 2”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 5”} [name]{strong=“G3588 G3686” x-morph=“robinson: T-\sc Dsn\sc* robinson: N-\sc Dsn\sc* 3 4”} [shall]{strong=“G1679” x-morph=“robinson: V-\sc Fai\sc*-3P-\sc Att\sc* 7”} [the Gentiles]{strong=“G1484” x-morph=“robinson: N-\sc Npn\sc* 6”} [trust]{strong=“G1679” x-morph=“robinson: V-\sc Fai\sc*-3P-\sc Att\sc* 7”}. 
\p
\v 22 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [was brought]{strong=“G4374” x-morph=“robinson: V-\sc Api\sc*-3S 2”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 3”} [one possessed with a devil]{strong=“G1139” x-morph=“robinson: V-\sc Pnp\sc*-\sc Nsm\sc* 4”}, [blind]{strong=“G5185” x-morph=“robinson: A-\sc Nsm\sc* 5”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [dumb]{strong=“G2974” x-morph=“robinson: A-\sc Nsm\sc* 7”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 8”} [he healed]{strong=“G2323” x-morph=“robinson: V-\sc Aai\sc*-3S 9”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 10”}, [insomuch that]{strong=“G5620” x-morph=“robinson: \sc Conj\sc* 11”} [the blind]{strong=“G5185” x-morph=“robinson: A-\sc Asm\sc* 13”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [dumb]{strong=“G2974” x-morph=“robinson: A-\sc Asm\sc* 15”} [both]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 16”} [spake]{strong=“G2980” x-morph=“robinson: V-\sc Pan\sc* 17”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 18”} [saw]{strong=“G991” x-morph=“robinson: V-\sc Pan\sc* 19”}. 
\v 23 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [all]{strong=“G3956” x-morph=“robinson: A-\sc Npm\sc* 3”} [the people]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 4 5”} [were amazed]{strong=“G1839” x-morph=“robinson: V-\sc Imi\sc*-3P 2”}, [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [said]{strong=“G3004” x-morph=“robinson: V-\sc Iai\sc*-3P 7”}, [Is]{strong=“G2076” x-morph=“robinson: V-\sc Pxi\sc*-3S 10”} [not]{strong=“G3385” x-morph=“robinson: \sc Prt\sc*-I 8”} [this]{strong=“G3778” x-morph=“robinson: D-\sc Nsm\sc* 9”} [the son]{strong=“G3588 G5207” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 11 12”} [of David]{strong=“G1138” x-morph=“robinson: N-\sc Pri\sc* 13”}? 
\v 24 [But when]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [the Pharisees]{strong=“G5330” x-morph=“robinson: N-\sc Npm\sc* 3”} [heard]{strong=“G191” x-morph=“robinson: V-\sc Aap\sc*-\sc Npm\sc* 4”} it, [they said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 5”}, [This]{strong=“G3778” x-morph=“robinson: D-\sc Nsm\sc* 6”} fellow [doth]{strong=“G1544” x-morph=“robinson: V-\sc Pai\sc*-3S 8”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 7”} [cast out]{strong=“G1544” x-morph=“robinson: V-\sc Pai\sc*-3S 8”} [devils]{strong=“G3588 G1140” x-morph=“robinson: T-\sc Apn\sc* robinson: N-\sc Apn\sc* 9 10”}, [but]{strong=“G1487” x-morph=“robinson: \sc Cond\sc* 11”} [by]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 13”} [Beelzebub]{strong=“G954” x-morph=“robinson: N-\sc Pri\sc* 15”} [the prince]{strong=“G758” x-morph=“robinson: N-\sc Dsm\sc* 16”} [of the devils]{strong=“G3588 G1140” x-morph=“robinson: T-\sc Gpn\sc* robinson: N-\sc Gpn\sc* 17 18”}. 
\v 25 [And]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [knew]{strong=“G1492” x-morph=“robinson: V-\sc Rap\sc*-\sc Nsm\sc* 1”} [their]{strong=“G846” x-morph=“robinson: P-\sc Gpm\sc* 7”} [thoughts]{strong=“G3588 G1761” x-morph=“robinson: T-\sc Apf\sc* robinson: N-\sc Apf\sc* 5 6”}, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 8”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 9”}, \wj Every kingdom divided against itself is brought to desolation; and every city or house divided against itself shall not stand:\wj* 
\v 26 \wj And if Satan cast out Satan, he is divided against himself; how shall then his kingdom stand?\wj* 
\v 27 \wj And if I by Beelzebub cast out devils, by whom do your children cast them out? therefore they shall be your judges.\wj* 
\v 28 \wj But if I cast out devils by the Spirit of God, then the kingdom of God is come unto you.\wj* 
\v 29 \wj Or else how can one enter into a strong man’s house, and spoil his goods, except he first bind the strong man? and then he will spoil his house.\wj* 
\v 30 \wj He that is not with me is against me; and he that gathereth not with me scattereth abroad.\wj* 
\p
\v 31 \wj Wherefore I say unto you, All manner of sin and blasphemy shall be forgiven unto men: but the blasphemy against the Holy Ghost shall not be forgiven unto men.\wj* 
\v 32 \wj And whosoever speaketh a word against the Son of man, it shall be forgiven him: but whosoever speaketh against the Holy Ghost, it shall not be forgiven him, neither in this world, neither in the world to come.\wj* 
\v 33 \wj Either make the tree good, and his fruit good; or else make the tree corrupt, and his fruit corrupt: for the tree is known by his fruit.\wj* 
\v 34 \wj O generation of vipers, how can ye, being evil, speak good things? for out of the abundance of the heart the mouth speaketh.\wj* 
\v 35 \wj A good man out of the good treasure of the heart bringeth forth good things: and an evil man out of the evil treasure bringeth forth evil things.\wj* 
\v 36 \wj But I say unto you, That every idle word that men shall speak, they shall give account thereof in the day of judgment.\wj* 
\v 37 \wj For by thy words thou shalt be justified, and by thy words thou shalt be condemned.\wj* 
\p
\v 38 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [certain]{strong=“G5100” x-morph=“robinson: X-\sc Npm\sc* 3”} [of the scribes]{strong=“G3588 G1122” x-morph=“robinson: T-\sc Gpm\sc* robinson: N-\sc Gpm\sc* 4 5”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 6”} [of the Pharisees]{strong=“G5330” x-morph=“robinson: N-\sc Gpm\sc* 7”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Adi\sc*-3P 2”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 8”}, [Master]{strong=“G1320” x-morph=“robinson: N-\sc Vsm\sc* 9”}, [we would]{strong=“G2309” x-morph=“robinson: V-\sc Pai\sc*-1P 10”} [see]{strong=“G1492” x-morph=“robinson: V-2\sc Aan\sc* 14”} [a sign]{strong=“G4592” x-morph=“robinson: N-\sc Asn\sc* 13”} [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 11”} [thee]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 12”}. 
\v 39 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he]{strong=“G3588” x-morph=“robinson: T-\sc Nsm\sc* 1”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 3”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}, \wj An evil and adulterous generation seeketh after a sign; and there shall no sign be given to it, but the sign of the prophet Jonas:\wj* 
\v 40 \wj For as Jonas was three days and three nights in the whale’s belly; so shall the Son of man be three days and three nights in the heart of the earth.\wj* 
\v 41 \wj The men of Nineveh shall rise in judgment with this generation, and shall condemn it: because they repented at the preaching of Jonas; and, behold, a greater than Jonas is here.\wj* 
\v 42 \wj The queen of the south shall rise up in the judgment with this generation, and shall condemn it: for she came from the uttermost parts of the earth to hear the wisdom of Solomon; and, behold, a greater than Solomon is here.\wj* 
\v 43 \wj When the unclean spirit is gone out of a man, he walketh through dry places, seeking rest, and findeth none.\wj* 
\v 44 \wj Then he saith, I will return into my house from whence I came out; and when he is come, he findeth it empty, swept, and garnished.\wj* 
\v 45 \wj Then goeth he, and taketh with himself seven other spirits more wicked than himself, and they enter in and dwell there: and the last state of that man is worse than the first. Even so shall it be also unto this wicked generation.\wj* 
\p
\v 46 [While]{strong=“G2980” x-morph=“robinson: V-\sc Pap\sc*-\sc Gsm\sc* 4”} [he]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 3”} [yet]{strong=“G2089” x-morph=“robinson: \sc Adv\sc* 1”} [talked]{strong=“G2980” x-morph=“robinson: V-\sc Pap\sc*-\sc Gsm\sc* 4”} [to the people]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 5 6”}, [behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 7”}, his [mother]{strong=“G3588 G3384” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 8 9”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 13”} [brethren]{strong=“G3588 G80” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 11 12”} [stood]{strong=“G2476” x-morph=“robinson: V-\sc Lai\sc*-3P 14”} [without]{strong=“G1854” x-morph=“robinson: \sc Adv\sc* 15”}, [desiring]{strong=“G2212” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 16”} [to speak]{strong=“G2980” x-morph=“robinson: V-\sc Aan\sc* 18”} [with him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 17”}. 
\v 47 [Then]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [one]{strong=“G5100” x-morph=“robinson: X-\sc Nsm\sc* 3”} [said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 1”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 4”}, [Behold]{strong=“G2400” x-morph=“robinson: V-2\sc Aam\sc*-2S 5”}, [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 8”} [mother]{strong=“G3588 G3384” x-morph=“robinson: T-\sc Nsf\sc* robinson: N-\sc Nsf\sc* 6 7”} [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 9”} [thy]{strong=“G4675” x-morph=“robinson: P-2\sc Gs\sc* 12”} [brethren]{strong=“G3588 G80” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 10 11”} [stand]{strong=“G2476” x-morph=“robinson: V-\sc Rai\sc*-3P 14”} [without]{strong=“G1854” x-morph=“robinson: \sc Adv\sc* 13”}, [desiring]{strong=“G2212” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 15”} [to speak]{strong=“G2980” x-morph=“robinson: V-\sc Aan\sc* 17”} [with thee]{strong=“G4671” x-morph=“robinson: P-2\sc Ds\sc* 16”}. 
\v 48 [But]{strong=“G1161” x-morph=“robinson: \sc Conj\sc* 2”} [he]{strong=“G3588” x-morph=“robinson: T-\sc Nsm\sc* 1”} [answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 3”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto him that told]{strong=“G2036” x-morph=“robinson: V-2\sc Aap\sc*-\sc Dsm\sc* 6”} [him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 7”}, \wj Who is my mother? and who are my brethren?\wj* 
\v 49 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he stretched forth]{strong=“G1614” x-morph=“robinson: V-\sc Aap\sc*-\sc Nsf\sc* 2”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 5”} [hand]{strong=“G3588 G5495” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 3 4”} [toward]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 6”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 9”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 7 8”}, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 10”}, \wj Behold my mother and my brethren!\wj* 
\v 50 \wj For whosoever shall do the will of my Father which is in heaven, the same is my brother, and sister, and mother.\wj* 
\c 13
\p 
\v 1 [The]{strong=“G3588 G2250” x-morph=“robinson: T-\sc Dsf\sc* robinson: N-\sc Dsf\sc* 3 4”} [same]{strong=“G1565” x-morph=“robinson: D-\sc Dsf\sc* 5”} [day]{strong=“G2250” x-morph=“robinson: N-\sc Dsf\sc* 4”} [went]{strong=“G1831” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 6”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 7 8”} [out of]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 9”} [the house]{strong=“G3588 G3614” x-morph=“robinson: T-\sc Gsf\sc* robinson: N-\sc Gsf\sc* 10 11”}, [and sat]{strong=“G2521” x-morph=“robinson: V-\sc Ini\sc*-3S 12”} [by]{strong=“G3844” x-morph=“robinson: \sc Prep\sc* 13”} [the sea side]{strong=“G3588 G2281” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 14 15”}. 
\v 2 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [great]{strong=“G4183” x-morph=“robinson: A-\sc Npm\sc* 6”} [multitudes]{strong=“G3793” x-morph=“robinson: N-\sc Npm\sc* 5”} [were gathered together]{strong=“G4863” x-morph=“robinson: V-\sc Api\sc*-3P 2”} [unto]{strong=“G4314” x-morph=“robinson: \sc Prep\sc* 3”} [him]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 4”}, [so that]{strong=“G5620” x-morph=“robinson: \sc Conj\sc* 7”} [he]{strong=“G846” x-morph=“robinson: P-\sc Asm\sc* 8”} [went]{strong=“G1684” x-morph=“robinson: V-2\sc Aap\sc*-\sc Asm\sc* 12”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 9”} [a ship]{strong=“G3588 G4143” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 10 11”}, [and sat]{strong=“G2521” x-morph=“robinson: V-\sc Pnn\sc* 13”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 14”} [the]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 16 17”} [whole]{strong=“G3956” x-morph=“robinson: A-\sc Nsm\sc* 15”} [multitude]{strong=“G3793” x-morph=“robinson: N-\sc Nsm\sc* 17”} [stood]{strong=“G2476” x-morph=“robinson: V-\sc Lai\sc*-3S 21”} [on]{strong=“G1909” x-morph=“robinson: \sc Prep\sc* 18”} [the shore]{strong=“G3588 G123” x-morph=“robinson: T-\sc Asm\sc* robinson: N-\sc Asm\sc* 19 20”}. 
\v 3 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [he spake]{strong=“G2980” x-morph=“robinson: V-\sc Aai\sc*-3S 2”} [many things]{strong=“G4183” x-morph=“robinson: A-\sc Apn\sc* 4”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 3”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 5”} [parables]{strong=“G3850” x-morph=“robinson: N-\sc Dpf\sc* 6”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 7”}, \wj Behold, a sower went forth to sow;\wj* 
\v 4 \wj And when he sowed, some seeds fell by the way side, and the fowls came and devoured them up:\wj* 
\v 5 \wj Some fell upon stony places, where they had not much earth: and forthwith they sprung up, because they had no deepness of earth:\wj* 
\v 6 \wj And when the sun was up, they were scorched; and because they had no root, they withered away.\wj* 
\v 7 \wj And some fell among thorns; and the thorns sprung up, and choked them:\wj* 
\v 8 \wj But other fell into good ground, and brought forth fruit, some an hundredfold, some sixtyfold, some thirtyfold.\wj* 
\v 9 \wj Who hath ears to hear, let him hear.\wj* 
\v 10 [And]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 1”} [the disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 3 4”} [came]{strong=“G4334” x-morph=“robinson: V-2\sc Aap\sc*-\sc Npm\sc* 2”}, [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3P 5”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 6”}, [Why]{strong=“G5101” x-morph=“robinson: I-\sc Asn\sc* 8”} [speakest thou]{strong=“G2980” x-morph=“robinson: V-\sc Pai\sc*-2S 11”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 12”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 9”} [parables]{strong=“G3850” x-morph=“robinson: N-\sc Dpf\sc* 10”}? 
\v 11 [He answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 3”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}, \wj Because it is given unto you to know the mysteries of the kingdom of heaven, but to them it is not given.\wj* 
\v 12 \wj For whosoever hath, to him shall be given, and he shall have more abundance: but whosoever hath not, from him shall be taken away even that he hath.\wj* 
\v 13 \wj Therefore speak I to them in parables: because they seeing see not; and hearing they hear not, neither do they understand.\wj* 
\v 14 \wj And in them is fulfilled the prophecy of Esaias, which saith, By hearing ye shall hear, and shall not understand; and seeing ye shall see, and shall not perceive:\wj* 
\v 15 \wj For this people’s heart is waxed gross, and their ears are dull of hearing, and their eyes they have closed; lest at any time they should see with their eyes, and hear with their ears, and should understand with their heart, and should be converted, and I should heal them.\wj* 
\v 16 \wj But blessed are your eyes, for they see: and your ears, for they hear.\wj* 
\v 17 \wj For verily I say unto you, That many prophets and righteous men have desired to see those things which ye see, and have not seen them; and to hear those things which ye hear, and have not heard them.\wj* 
\p
\v 18 \wj Hear ye therefore the parable of the sower.\wj* 
\v 19 \wj When any one heareth the word of the kingdom, and understandeth it not, then cometh the wicked one, and catcheth away that which was sown in his heart. This is he which received seed by the way side.\wj* 
\v 20 \wj But he that received the seed into stony places, the same is he that heareth the word, and anon with joy receiveth it;\wj* 
\v 21 \wj Yet hath he not root in himself, but dureth for a while: for when tribulation or persecution ariseth because of the word, by and by he is offended.\wj* 
\v 22 \wj He also that received seed among the thorns is he that heareth the word; and the care of this world, and the deceitfulness of riches, choke the word, and he becometh unfruitful.\wj* 
\v 23 \wj But he that received seed into the good ground is he that heareth the word, and understandeth it; which also beareth fruit, and bringeth forth, some an hundredfold, some sixty, some thirty.\wj* 
\p
\v 24 [Another]{strong=“G243” x-morph=“robinson: A-\sc Asf\sc* 1”} [parable]{strong=“G3850” x-morph=“robinson: N-\sc Asf\sc* 2”} [put he forth]{strong=“G3908” x-morph=“robinson: V-\sc Aai\sc*-3S 3”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 4”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 5”}, \wj The kingdom of heaven is likened unto a man which sowed good seed in his field:\wj* 
\v 25 \wj But while men slept, his enemy came and sowed tares among the wheat, and went his way.\wj* 
\v 26 \wj But when the blade was sprung up, and brought forth fruit, then appeared the tares also.\wj* 
\v 27 \wj So the servants of the householder came and said unto him, Sir, didst not thou sow good seed in thy field? from whence then hath it tares?\wj* 
\v 28 \wj He said unto them, An enemy hath done this. The servants said unto him, Wilt thou then that we go and gather them up?\wj* 
\v 29 \wj But he said, Nay; lest while ye gather up the tares, ye root up also the wheat with them.\wj* 
\v 30 \wj Let both grow together until the harvest: and in the time of harvest I will say to the reapers, Gather ye together first the tares, and bind them in bundles to burn them: but gather the wheat into my barn.\wj* 
\p
\v 31 [Another]{strong=“G243” x-morph=“robinson: A-\sc Asf\sc* 1”} [parable]{strong=“G3850” x-morph=“robinson: N-\sc Asf\sc* 2”} [put he forth]{strong=“G3908” x-morph=“robinson: V-\sc Aai\sc*-3S 3”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 4”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Nsm\sc* 5”}, \wj The kingdom of heaven is like to a grain of mustard seed, which a man took, and sowed in his field:\wj* 
\v 32 \wj Which indeed is the least of all seeds: but when it is grown, it is the greatest among herbs, and becometh a tree, so that the birds of the air come and lodge in the branches thereof.\wj* 
\p
\v 33 [Another]{strong=“G243” x-morph=“robinson: A-\sc Asf\sc* 1”} [parable]{strong=“G3850” x-morph=“robinson: N-\sc Asf\sc* 2”} [spake he]{strong=“G2980” x-morph=“robinson: V-\sc Aai\sc*-3S 3”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 4”}; \wj The kingdom of heaven is like unto leaven, which a woman took, and hid in three measures of meal, till the whole was leavened.\wj* 
\v 34 [All]{strong=“G3956” x-morph=“robinson: A-\sc Apn\sc* 2”} [these things]{strong=“G5023” x-morph=“robinson: D-\sc Apn\sc* 1”} [spake]{strong=“G2980” x-morph=“robinson: V-\sc Aai\sc*-3S 3”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 4 5”} [unto the multitude]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Dpm\sc* robinson: N-\sc Dpm\sc* 8 9”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 6”} [parables]{strong=“G3850” x-morph=“robinson: N-\sc Dpf\sc* 7”}; [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 10”} [without]{strong=“G5565” x-morph=“robinson: \sc Adv\sc* 11”} [a parable]{strong=“G3850” x-morph=“robinson: N-\sc Gsf\sc* 12”} [spake he]{strong=“G2980” x-morph=“robinson: V-\sc Iai\sc*-3S 14”} [not]{strong=“G3756” x-morph=“robinson: \sc Prt\sc*-N 13”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 15”}: 
\v 35 [That]{strong=“G3704” x-morph=“robinson: \sc Adv\sc* 1”} [it might be fulfilled]{strong=“G4137” x-morph=“robinson: V-\sc Aps\sc*-3S 2”} [which was spoken]{strong=“G4483” x-morph=“robinson: V-\sc App\sc*-\sc Nsn\sc* 4”} [by]{strong=“G1223” x-morph=“robinson: \sc Prep\sc* 5”} [the prophet]{strong=“G3588 G4396” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 6 7”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Gsn\sc* 8”}, [I will open]{strong=“G455” x-morph=“robinson: V-\sc Fai\sc*-1S 9”} [my]{strong=“G3450” x-morph=“robinson: P-1\sc Gs\sc* 14”} [mouth]{strong=“G3588 G4750” x-morph=“robinson: T-\sc Asn\sc* robinson: N-\sc Asn\sc* 12 13”} [in]{strong=“G1722” x-morph=“robinson: \sc Prep\sc* 10”} [parables]{strong=“G3850” x-morph=“robinson: N-\sc Dpf\sc* 11”}; [I will utter]{strong=“G2044” x-morph=“robinson: V-\sc Fdi\sc*-1S 15”} [things which have been kept secret]{strong=“G2928” x-morph=“robinson: V-\sc Rpp\sc*-\sc Apn\sc* 16”} [from]{strong=“G575” x-morph=“robinson: \sc Prep\sc* 17”} [the foundation]{strong=“G2602” x-morph=“robinson: N-\sc Gsf\sc* 18”} [of the world]{strong=“G2889” x-morph=“robinson: N-\sc Gsm\sc* 19”}. 
\v 36 [Then]{strong=“G5119” x-morph=“robinson: \sc Adv\sc* 1”} [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 9 10”} [sent]{strong=“G863” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”} [the multitude]{strong=“G3588 G3793” x-morph=“robinson: T-\sc Apm\sc* robinson: N-\sc Apm\sc* 3 4”} [away]{strong=“G863” x-morph=“robinson: V-2\sc Aap\sc*-\sc Nsm\sc* 2”}, [and went]{strong=“G2064” x-morph=“robinson: V-2\sc Aai\sc*-3S 5”} [into]{strong=“G1519” x-morph=“robinson: \sc Prep\sc* 6”} [the house]{strong=“G3588 G3614” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 7 8”}: [and]{strong=“G2532” x-morph=“robinson: \sc Conj\sc* 11”} [his]{strong=“G846” x-morph=“robinson: P-\sc Gsm\sc* 16”} [disciples]{strong=“G3588 G3101” x-morph=“robinson: T-\sc Npm\sc* robinson: N-\sc Npm\sc* 14 15”} [came]{strong=“G4334” x-morph=“robinson: V-\sc Aai\sc*-3P 12”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 13”}, [saying]{strong=“G3004” x-morph=“robinson: V-\sc Pap\sc*-\sc Npm\sc* 17”}, [Declare]{strong=“G5419” x-morph=“robinson: V-\sc Aam\sc*-2S 18”} [unto us]{strong=“G2254” x-morph=“robinson: P-1\sc Dp\sc* 19”} [the parable]{strong=“G3588 G3850” x-morph=“robinson: T-\sc Asf\sc* robinson: N-\sc Asf\sc* 20 21”} [of the tares]{strong=“G3588 G2215” x-morph=“robinson: T-\sc Gpn\sc* robinson: N-\sc Gpn\sc* 22 23”} [of the field]{strong=“G3588 G68” x-morph=“robinson: T-\sc Gsm\sc* robinson: N-\sc Gsm\sc* 24 25”}. 
\v 37 [He answered]{strong=“G611” x-morph=“robinson: V-\sc Aop\sc*-\sc Nsm\sc* 3”} [and said]{strong=“G2036” x-morph=“robinson: V-2\sc Aai\sc*-3S 4”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 5”}, \wj He that soweth the good seed is the Son of man;\wj* 
\v 38 \wj The field is the world; the good seed are the children of the kingdom; but the tares are the children of the wicked one;\wj* 
\v 39 \wj The enemy that sowed them is the devil; the harvest is the end of the world; and the reapers are the angels.\wj* 
\v 40 \wj As therefore the tares are gathered and burned in the fire; so shall it be in the end of this world.\wj* 
\v 41 \wj The Son of man shall send forth his angels, and they shall gather out of his kingdom all things that offend, and them which do iniquity;\wj* 
\v 42 \wj And shall cast them into a furnace of fire: there shall be wailing and gnashing of teeth.\wj* 
\v 43 \wj Then shall the righteous shine forth as the sun in the kingdom of their Father. Who hath ears to hear, let him hear.\wj* 
\p
\v 44 \wj Again, the kingdom of heaven is like unto treasure hid in a field; the which when a man hath found, he hideth, and for joy thereof goeth and selleth all that he hath, and buyeth that field.\wj* 
\p
\v 45 \wj Again, the kingdom of heaven is like unto a merchant man, seeking goodly pearls:\wj* 
\v 46 \wj Who, when he had found one pearl of great price, went and sold all that he had, and bought it.\wj* 
\p
\v 47 \wj Again, the kingdom of heaven is like unto a net, that was cast into the sea, and gathered of every kind:\wj* 
\v 48 \wj Which, when it was full, they drew to shore, and sat down, and gathered the good into vessels, but cast the bad away.\wj* 
\v 49 \wj So shall it be at the end of the world: the angels shall come forth, and sever the wicked from among the just,\wj* 
\v 50 \wj And shall cast them into the furnace of fire: there shall be wailing and gnashing of teeth.\wj* 
\v 51 [Jesus]{strong=“G3588 G2424” x-morph=“robinson: T-\sc Nsm\sc* robinson: N-\sc Nsm\sc* 3 4”} [saith]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3S 1”} [unto them]{strong=“G846” x-morph=“robinson: P-\sc Dpm\sc* 2”}, \wj Have ye understood all these things?\wj* [They say]{strong=“G3004” x-morph=“robinson: V-\sc Pai\sc*-3P 8”} [unto him]{strong=“G846” x-morph=“robinson: P-\sc Dsm\sc* 9”}, [Yea]{strong=“G3483” x-morph=“robinson: \sc Prt\sc* 10”}, [Lord]{strong=“G2962” x-morph=“robinson: N-\sc Vsm\sc* 11”}. 
