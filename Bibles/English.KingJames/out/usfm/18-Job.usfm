\v 7 [I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w Days| strong="H3117" \w* [should speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}, \w and multitude| strong="H7230" \w* \w of years| strong="H8141" \w* [should teach]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8686”} \w wisdom| strong="H2451" \w*. 
\v 8 \w But| strong="H403" \w* there is \w a spirit| strong="H7307" \w* \w in man| strong="H582" \w*: \w and the inspiration| strong="H5397" \w* \w of the Almighty| strong="H7706" \w* [giveth them understanding]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 9 \w Great men| strong="H7227" \w* are not always [wise]{strong=“H2449” x-morph=“strongMorph: \sc Th\sc*8799”}: \w neither do the aged| strong="H2205" \w* [understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} \w judgment| strong="H4941" \w*. 
\v 10 [Therefore I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [to me; I also will shew]{strong=“H2331” x-morph=“strongMorph: \sc Th\sc*8762”} \w mine opinion| strong="H1843" \w*. 
\v 11 [Behold, I waited]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8689”} \w for your words| strong="H1697" \w*; [I gave ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8686”} \w to your reasons| strong="H8394" \w*, [whilst ye searched out]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8799”} \w what to say| strong="H4405" \w*.\f + \fr 32:11 \ft reasons: Heb. understandings \f* \f + \fr 32:11 \ft what…: Heb. words \f* 
\v 12 [Yea, I attended]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8709”} unto you, and, behold, there was [none of you that convinced]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8688”} \w Job| strong="H347" \w*, or [that answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8802”} \w his words| strong="H561" \w*: 
\v 13 [Lest ye should say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [We have found out]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w wisdom| strong="H2451" \w*: \w God| strong="H410" \w* [thrusteth him down]{strong=“H5086” x-morph=“strongMorph: \sc Th\sc*8799”}, \w not man| strong="H376" \w*. 
\v 14 [Now he hath not directed]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8804”} his \w words| strong="H4405" \w* [against me: neither will I answer]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w him with your speeches| strong="H561" \w*.\f + \fr 32:14 \ft directed: or, ordered \f* 
\p
\v 15 [They were amazed]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8804”}, [they answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”} [no more: they left off]{strong=“H6275” x-morph=“strongMorph: \sc Th\sc*8689”} \w speaking| strong="H4405" \w*.\f + \fr 32:15 \ft left…: Heb. removed speeches from themselves \f* 
\v 16 [When I had waited]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8689”}, ([for they spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} [not, but stood still]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”}, and [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8804”} no more;) 
\v 17 I said, [I will answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w also my part| strong="H2506" \w*, [I also will shew]{strong=“H2331” x-morph=“strongMorph: \sc Th\sc*8762”} \w mine opinion| strong="H1843" \w*. 
\v 18 [For I am full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of matter| strong="H4405" \w*, \w the spirit| strong="H7307" \w* \w within| strong="H990" \w* [me constraineth]{strong=“H6693” x-morph=“strongMorph: \sc Th\sc*8689”} me.\f + \fr 32:18 \ft matter: Heb. words \f* \f + \fr 32:18 \ft spirit…: Heb. spirit of my belly \f* 
\v 19 [Behold, my belly]{strong=“H990”} is \w as wine| strong="H3196" \w* which [hath no vent]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8735”}; [it is ready to burst]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8735”} \w like new| strong="H2319" \w* \w bottles| strong="H178" \w*.\f + \fr 32:19 \ft hath…: Heb. is not opened \f* 
\v 20 [I will speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}, [that I may be refreshed]{strong=“H7304” x-morph=“strongMorph: \sc Th\sc*8799”}: [I will open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} \w my lips| strong="H8193" \w* [and answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 32:20 \ft be…: Heb. breathe \f* 
\v 21 [Let me not, I pray you, accept]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} [any man’s]{strong=“H376”} \w person| strong="H6440" \w*, [neither let me give flattering titles]{strong=“H3655” x-morph=“strongMorph: \sc Th\sc*8762”} \w unto man| strong="H120" \w*. 
\v 22 [For I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [not to give flattering titles]{strong=“H3655” x-morph=“strongMorph: \sc Th\sc*8762”}; in so doing [my maker]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w would soon| strong="H4592" \w* [take me away]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”}.
\c 33
\p 
\v 1 \w Wherefore| strong="H199" \w*, \w Job| strong="H347" \w*, [I pray thee, hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w my speeches| strong="H4405" \w*, [and hearken]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”} \w to all my words| strong="H1697" \w*. 
\v 2 [Behold, now I have opened]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8804”} \w my mouth| strong="H6310" \w*, \w my tongue| strong="H3956" \w* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w in my mouth| strong="H2441" \w*.\f + \fr 33:2 \ft in my mouth: Heb. in my palate \f* 
\v 3 \w My words| strong="H561" \w* shall be of \w the uprightness| strong="H3476" \w* \w of my heart| strong="H3820" \w*: \w and my lips| strong="H8193" \w* [shall utter]{strong=“H4448” x-morph=“strongMorph: \sc Th\sc*8765”} \w knowledge| strong="H1847" \w* [clearly]{strong=“H1305” x-morph=“strongMorph: \sc Th\sc*8803”}. 
\v 4 \w The Spirit| strong="H7307" \w* \w of God| strong="H410" \w* [hath made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and the breath]{strong=“H5397”} \w of the Almighty| strong="H7706" \w* [hath given me life]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 5 [If thou canst]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} [answer]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} me, set thy words [in order]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8798”} \w before| strong="H6440" \w* [me, stand up]{strong=“H3320” x-morph=“strongMorph: \sc Th\sc*8690”}. 
\v 6 Behold, I am \w according to thy wish| strong="H6310" \w* [in God’s]{strong=“H410”} [stead: I also am formed]{strong=“H7169” x-morph=“strongMorph: \sc Th\sc*8795”} \w out of the clay| strong="H2563" \w*.\f + \fr 33:6 \ft wish: Heb. mouth \f* \f + \fr 33:6 \ft formed: Heb. cut \f* 
\v 7 [Behold, my terror]{strong=“H367”} [shall not make thee afraid]{strong=“H1204” x-morph=“strongMorph: \sc Th\sc*8762”}, \w neither shall my hand| strong="H405" \w* [be heavy]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8799”} upon thee. 
\p
\v 8 [Surely thou hast spoken]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w in mine hearing| strong="H241" \w*, [and I have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w the voice| strong="H6963" \w* of thy \w words| strong="H4405" \w*, saying,\f + \fr 33:8 \ft hearing: Heb. ears \f* 
\v 9 \w I am clean| strong="H2134" \w* \w without transgression| strong="H6588" \w*, I am \w innocent| strong="H2643" \w*; neither is there \w iniquity| strong="H5771" \w* in me. 
\v 10 [Behold, he findeth]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w occasions| strong="H8569" \w* [against me, he counteth]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8799”} [me for his enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}, 
\v 11 [He putteth]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w my feet| strong="H7272" \w* \w in the stocks| strong="H5465" \w*, [he marketh]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w all my paths| strong="H734" \w*. 
\v 12 Behold, in [this thou art not just]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8804”}: [I will answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [thee, that God]{strong=“H433”} [is greater]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8799”} \w than man| strong="H582" \w*. 
\v 13 [Why dost thou strive]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8804”} [against him? for he giveth not account]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w of any of his matters| strong="H1697" \w*.\f + \fr 33:13 \ft he giveth…: Heb. he answereth not \f* 
\p
\v 14 \w For God| strong="H410" \w* [speaketh]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w once| strong="H259" \w*, \w yea twice| strong="H8147" \w*, yet man [perceiveth]{strong=“H7789” x-morph=“strongMorph: \sc Th\sc*8799”} it not. 
\v 15 \w In a dream| strong="H2472" \w*, \w in a vision| strong="H2384" \w* \w of the night| strong="H3915" \w*, \w when deep| strong="H8639" \w* [sleep falleth]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8800”} \w upon men| strong="H582" \w*, \w in slumberings| strong="H8572" \w* \w upon the bed| strong="H4904" \w*; 
\v 16 [Then he openeth]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8799”} \w the ears| strong="H241" \w* \w of men| strong="H582" \w*, [and sealeth]{strong=“H2856” x-morph=“strongMorph: \sc Th\sc*8799”} \w their instruction| strong="H4561" \w*,\f + \fr 33:16 \ft he…: Heb. he revealeth, or, uncovereth \f* 
\v 17 [That he may withdraw]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8687”} \w man| strong="H120" \w* from his \w purpose| strong="H4639" \w*, [and hide]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w pride| strong="H1466" \w* \w from man| strong="H1397" \w*.\f + \fr 33:17 \ft purpose: Heb. work \f* 
\v 18 [He keepeth back]{strong=“H2820” x-morph=“strongMorph: \sc Th\sc*8799”} \w his soul| strong="H5315" \w* \w from the pit| strong="H7845" \w*, \w and his life| strong="H2416" \w* [from perishing]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8800”} \w by the sword| strong="H7973" \w*.\f + \fr 33:18 \ft from perishing: Heb. from passing \f* 
\p
\v 19 [He is chastened]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8717”} \w also with pain| strong="H4341" \w* \w upon his bed| strong="H4904" \w*, [and the multitude]{strong=“H7379 H7230” x-morph=“strongMorph: \sc Th\sc*8675”} \w of his bones| strong="H6106" \w* \w with strong| strong="H386" \w* pain: 
\v 20 \w So that his life| strong="H2416" \w* [abhorreth]{strong=“H2092” x-morph=“strongMorph: \sc Th\sc*8765”} \w bread| strong="H3899" \w*, \w and his soul| strong="H5315" \w* \w dainty| strong="H8378" \w* \w meat| strong="H3978" \w*.\f + \fr 33:20 \ft dainty…: Heb. meat of desire \f* 
\v 21 \w His flesh| strong="H1320" \w* [is consumed away]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8799”}, \w that it cannot be seen| strong="H7210" \w*; \w and his bones| strong="H6106" \w* that [were not seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8795”} [stick out]{strong=“H8205 H8192” x-morph=“strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8795”}. 
\v 22 [Yea, his soul]{strong=“H5315”} [draweth near]{strong=“H7126” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the grave| strong="H7845" \w*, \w and his life| strong="H2416" \w* [to the destroyers]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 23 \w If there| strong="H3426" \w* \w be a messenger| strong="H4397" \w* [with him, an interpreter]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8688”}, \w one| strong="H259" \w* \w among a thousand| strong="H505" \w*, [to shew]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8687”} \w unto man| strong="H120" \w* \w his uprightness| strong="H3476" \w*: 
\v 24 [Then he is gracious]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, and saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Deliver]{strong=“H6308” x-morph=“strongMorph: \sc Th\sc*8798”} [him from going down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8800”} \w to the pit| strong="H7845" \w*: [I have found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w a ransom| strong="H3724" \w*.\f + \fr 33:24 \ft a ransom: or, an atonement \f* 
\v 25 \w His flesh| strong="H1320" \w* [shall be fresher]{strong=“H7375” x-morph=“strongMorph: \sc Th\sc*8738”} [than a child’s]{strong=“H5290”}: [he shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the days| strong="H3117" \w* \w of his youth| strong="H5934" \w*:\f + \fr 33:25 \ft a child’s: Heb. childhood \f* 
\v 26 [He shall pray]{strong=“H6279” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto God| strong="H433" \w*, [and he will be favourable]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him: and he shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w his face| strong="H6440" \w* \w with joy| strong="H8643" \w*: [for he will render]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto man| strong="H582" \w* \w his righteousness| strong="H6666" \w*. 
\v 27 [He looketh]{strong=“H7789” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon men| strong="H582" \w*, and if any [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}, [and perverted]{strong=“H5753” x-morph=“strongMorph: \sc Th\sc*8689”} that which was \w right| strong="H3477" \w*, [and it profited]{strong=“H7737” x-morph=“strongMorph: \sc Th\sc*8804”} me not;\f + \fr 33:27 \ft He…: or, He shall look upon men, and say \f* 
\v 28 [He will deliver]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8804”} \w his soul| strong="H5315" \w* [from going]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8800”} \w into the pit| strong="H7845" \w*, \w and his life| strong="H2416" \w* [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the light| strong="H216" \w*.\f + \fr 33:28 \ft He…: or, He hath delivered my soul, etc, and my life \f* 
\p
\v 29 Lo, all these things [worketh]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8799”} \w God| strong="H410" \w* [oftentimes]{strong=“H7969 H6471”} \w with man| strong="H1397" \w*,\f + \fr 33:29 \ft oftentimes: Heb. twice and thrice \f* 
\v 30 [To bring back]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} \w his soul| strong="H5315" \w* \w from the pit| strong="H7845" \w*, [to be enlightened]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8736”} \w with the light| strong="H216" \w* \w of the living| strong="H2416" \w*. 
\v 31 [Mark well]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8685”}, \w O Job| strong="H347" \w*, [hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me: hold thy peace]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8685”}, [and I will speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 32 \w If thou hast| strong="H3426" \w* \w any thing to say| strong="H4405" \w*, [answer]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”} [me: speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”}, [for I desire]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} [to justify]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8763”} thee. 
\v 33 [If not, hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me: hold thy peace]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8685”}, [and I shall teach]{strong=“H502” x-morph=“strongMorph: \sc Th\sc*8762”} \w thee wisdom| strong="H2451" \w*.
\c 34
\p 
\v 1 \w Furthermore Elihu| strong="H453" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w my words| strong="H4405" \w*, \w O ye wise| strong="H2450" \w* men; [and give ear]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”} [unto me, ye that have knowledge]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 3 \w For the ear| strong="H241" \w* [trieth]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8799”} \w words| strong="H4405" \w*, \w as the mouth| strong="H2441" \w* [tasteth]{strong=“H2938” x-morph=“strongMorph: \sc Th\sc*8799”} [meat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 34:3 \ft mouth: Heb. palate \f* 
\v 4 [Let us choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} \w to us judgment| strong="H4941" \w*: [let us know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} among ourselves what is \w good| strong="H2896" \w*. 
\v 5 \w For Job| strong="H347" \w* [hath said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [I am righteous]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8804”}: \w and God| strong="H410" \w* [hath taken away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8689”} \w my judgment| strong="H4941" \w*. 
\v 6 [Should I lie]{strong=“H3576” x-morph=“strongMorph: \sc Th\sc*8762”} \w against my right| strong="H4941" \w*? \w my wound| strong="H2671" \w* is [incurable]{strong=“H605” x-morph=“strongMorph: \sc Th\sc*8803”} \w without transgression| strong="H6588" \w*.\f + \fr 34:6 \ft my wound: Heb. mine arrow \f* 
\v 7 \w What man| strong="H1397" \w* is \w like Job| strong="H347" \w*, who [drinketh up]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w scorning| strong="H3933" \w* \w like water| strong="H4325" \w*? 
\v 8 [Which goeth]{strong=“H732” x-morph=“strongMorph: \sc Th\sc*8804”} \w in company| strong="H2274" \w* [with the workers]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w of iniquity| strong="H205" \w*, [and walketh]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} \w with wicked| strong="H7562" \w* \w men| strong="H582" \w*. 
\v 9 [For he hath said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [It profiteth]{strong=“H5532” x-morph=“strongMorph: \sc Th\sc*8799”} \w a man| strong="H1397" \w* [nothing that he should delight]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8800”} \w himself with God| strong="H430" \w*. 
\p
\v 10 [Therefore hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me, ye men]{strong=“H582”} \w of understanding| strong="H3824" \w*: \w far be it| strong="H2486" \w* \w from God| strong="H410" \w*, that he should do \w wickedness| strong="H7562" \w*; and from \w the Almighty| strong="H7706" \w*, that he should commit \w iniquity| strong="H5766" \w*.\f + \fr 34:10 \ft men…: Heb. men of heart \f* 
\v 11 \w For the work| strong="H6467" \w* \w of a man| strong="H120" \w* [shall he render]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} [unto him, and cause every man]{strong=“H376”} [to find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8686”} according to his \w ways| strong="H734" \w*. 
\v 12 [Yea, surely]{strong=“H551”} \w God| strong="H410" \w* [will not do wickedly]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8686”}, \w neither will the Almighty| strong="H7706" \w* [pervert]{strong=“H5791” x-morph=“strongMorph: \sc Th\sc*8762”} \w judgment| strong="H4941" \w*. 
\v 13 [Who hath given him a charge]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} \w over the earth| strong="H776" \w*? [or who hath disposed]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w the whole world| strong="H8398" \w*?\f + \fr 34:13 \ft the whole: Heb. all of it? \f* 
\v 14 [If he set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w his heart| strong="H3820" \w* upon man, if [he gather]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto himself his spirit| strong="H7307" \w* \w and his breath| strong="H5397" \w*;\f + \fr 34:14 \ft man: Heb. him \f* 
\v 15 \w All flesh| strong="H1320" \w* [shall perish]{strong=“H1478” x-morph=“strongMorph: \sc Th\sc*8799”} \w together| strong="H3162" \w*, \w and man| strong="H120" \w* [shall turn again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto dust| strong="H6083" \w*. 
\p
\v 16 If now thou hast \w understanding| strong="H998" \w*, [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [this: hearken]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”} \w to the voice| strong="H6963" \w* \w of my words| strong="H4405" \w*. 
\v 17 [Shall even he that hateth]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} \w right| strong="H4941" \w* [govern]{strong=“H2280” x-morph=“strongMorph: \sc Th\sc*8799”}? [and wilt thou condemn]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8686”} \w him that is most| strong="H3524" \w* \w just| strong="H6662" \w*?\f + \fr 34:17 \ft govern: Heb. bind? \f* 
\v 18 Is it fit [to say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} \w to a king| strong="H4428" \w*, Thou art \w wicked| strong="H1100" \w*? and \w to princes| strong="H5081" \w*, Ye are \w ungodly| strong="H7563" \w*? 
\v 19 How much less to him [that accepteth]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the persons| strong="H6440" \w* \w of princes| strong="H8269" \w*, [nor regardeth]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8765”} \w the rich| strong="H7771" \w* \w more than| strong="H6440" \w* \w the poor| strong="H1800" \w*? for they all are \w the work| strong="H4639" \w* \w of his hands| strong="H3027" \w*. 
\v 20 \w In a moment| strong="H7281" \w* [shall they die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the people| strong="H5971" \w* [shall be troubled]{strong=“H1607” x-morph=“strongMorph: \sc Th\sc*8792”} [at midnight]{strong=“H3915 H2676”}, [and pass away]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}: \w and the mighty| strong="H47" \w* [shall be taken away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8686”} \w without hand| strong="H3027" \w*.\f + \fr 34:20 \ft the mighty…: Heb. they shall take away the mighty \f* 
\v 21 \w For his eyes| strong="H5869" \w* are \w upon the ways| strong="H1870" \w* \w of man| strong="H376" \w*, [and he seeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w all his goings| strong="H6806" \w*. 
\v 22 There is \w no darkness| strong="H2822" \w*, \w nor shadow of death| strong="H6757" \w*, [where the workers]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”} \w of iniquity| strong="H205" \w* [may hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8736”} themselves. 
\v 23 [For he will not lay]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon man| strong="H376" \w* more than right; [that he should enter]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8800”} \w into judgment| strong="H4941" \w* \w with God| strong="H410" \w*.\f + \fr 34:23 \ft enter: Heb. go \f* 
\v 24 [He shall break in pieces]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8799”} \w mighty men| strong="H3524" \w* \w without number| strong="H2714" \w*, [and set]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8686”} \w others| strong="H312" \w* in their stead.\f + \fr 34:24 \ft number: Heb. searching out \f* 
\v 25 [Therefore he knoweth]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8686”} \w their works| strong="H4566" \w*, [and he overturneth]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8804”} them \w in the night| strong="H3915" \w*, [so that they are destroyed]{strong=“H1792” x-morph=“strongMorph: \sc Th\sc*8691”}.\f + \fr 34:25 \ft destroyed: Heb. crushed \f* 
\v 26 [He striketh]{strong=“H5606” x-morph=“strongMorph: \sc Th\sc*8804”} \w them as| strong="H8478" \w* \w wicked men| strong="H7563" \w* \w in the open| strong="H4725" \w* [sight]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} of others;\f + \fr 34:26 \ft open…: Heb. place of beholders \f* 
\v 27 [Because they turned back]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8804”} \w from him| strong="H310" \w*, [and would not consider]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8689”} \w any of his ways| strong="H1870" \w*:\f + \fr 34:27 \ft him: Heb. after him \f* 
\v 28 \w So that they cause the cry| strong="H6818" \w* \w of the poor| strong="H1800" \w* [to come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8687”} [unto him, and he heareth]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w the cry| strong="H6818" \w* \w of the afflicted| strong="H6041" \w*. 
\v 29 [When he giveth quietness]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8686”}, [who then can make trouble]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8686”}? [and when he hideth]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8686”} his \w face| strong="H6440" \w*, [who then can behold]{strong=“H7789” x-morph=“strongMorph: \sc Th\sc*8799”} him? whether it be done \w against a nation| strong="H1471" \w*, \w or against a man| strong="H120" \w* \w only| strong="H3162" \w*: 
\v 30 [That the hypocrite]{strong=“H2611 H120”} [reign]{strong=“H4427” x-morph=“strongMorph: \sc Th\sc*8800”} [not, lest the people]{strong=“H5971”} \w be ensnared| strong="H4170" \w*. 
\p
\v 31 [Surely it is meet to be said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8736”} \w unto God| strong="H410" \w*, [I have borne]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} chastisement, [I will not offend]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8799”} any more: 
\v 32 That which [I see]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8799”} \w not| strong="H1107" \w* [teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8685”} [thou me: if I have done]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8804”} \w iniquity| strong="H5766" \w*, [I will do]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} no more. 
\v 33 Should it be [according to thy mind? he will recompense]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} [it, whether thou refuse]{strong=“H3988 H3588” x-morph=“strongMorph: \sc Th\sc*8804”}, [or whether thou choose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”}; [and not I: therefore speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8761”} [what thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 34:33 \ft according…: Heb. from with thee? \f* 
\v 34 \w Let men| strong="H582" \w* \w of understanding| strong="H3824" \w* [tell]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [me, and let a wise]{strong=“H2450”} \w man| strong="H1397" \w* [hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8802”} unto me.\f + \fr 34:34 \ft of…: Heb. of heart \f* 
\v 35 \w Job| strong="H347" \w* [hath spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w without knowledge| strong="H1847" \w*, \w and his words| strong="H1697" \w* were [without wisdom]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8687”}. 
\v 36 [My desire]{strong=“H1 H15” x-morph=“strongMorph: \sc Th\sc*8676”} is that \w Job| strong="H347" \w* [may be tried]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8735”} \w unto the end| strong="H5331" \w* because of his \w answers| strong="H8666" \w* \w for wicked| strong="H205" \w* \w men| strong="H582" \w*.\f + \fr 34:36 \ft My…: or, My father, let Job be tried \f* 
\v 37 [For he addeth]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w rebellion| strong="H6588" \w* \w unto his sin| strong="H2403" \w*, [he clappeth]{strong=“H5606” x-morph=“strongMorph: \sc Th\sc*8799”} his hands [among us, and multiplieth]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} \w his words| strong="H561" \w* \w against God| strong="H410" \w*.
\c 35
\p 
\v 1 \w Elihu| strong="H453" \w* [spake]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [moreover, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 [Thinkest]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8804”} \w thou this to be right| strong="H4941" \w*, that [thou saidst]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w My righteousness| strong="H6664" \w* is [more than God’s]{strong=“H410”}? 
\v 3 [For thou saidst]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [What advantage]{strong=“H5532” x-morph=“strongMorph: \sc Th\sc*8799”} will it be unto thee? and, [What profit]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8686”} shall I have, if I be cleansed \w from my sin| strong="H2403" \w*?\f + \fr 35:3 \ft if…: or, by it more than by my sin \f* 
\v 4 [I will answer]{strong=“H4405 H7725” x-morph=“strongMorph: \sc Th\sc*8686”} [thee, and thy companions]{strong=“H7453”} with thee.\f + \fr 35:4 \ft answer…: Heb. return to thee words \f* 
\v 5 [Look]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8685”} \w unto the heavens| strong="H8064" \w*, [and see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”}; [and behold]{strong=“H7789” x-morph=“strongMorph: \sc Th\sc*8798”} \w the clouds| strong="H7834" \w* which [are higher]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8804”} than thou. 
\v 6 [If thou sinnest]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}, [what doest]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8799”} thou against him? or if \w thy transgressions| strong="H6588" \w* [be multiplied]{strong=“H7231” x-morph=“strongMorph: \sc Th\sc*8804”}, [what doest]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} thou unto him? 
\v 7 [If thou be righteous]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8804”}, [what givest]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [thou him? or what receiveth]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w he of thine hand| strong="H3027" \w*? 
\v 8 \w Thy wickedness| strong="H7562" \w* may hurt \w a man| strong="H376" \w* as thou art; \w and thy righteousness| strong="H6666" \w* may profit \w the son| strong="H1121" \w* \w of man| strong="H120" \w*. 
\p
\v 9 \w By reason of the multitude| strong="H7230" \w* \w of oppressions| strong="H6217" \w* they make the oppressed [to cry]{strong=“H2199” x-morph=“strongMorph: \sc Th\sc*8686”}: [they cry out]{strong=“H7768” x-morph=“strongMorph: \sc Th\sc*8762”} \w by reason of the arm| strong="H2220" \w* \w of the mighty| strong="H7227" \w*. 
\v 10 [But none saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, Where is \w God| strong="H433" \w* [my maker]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”}, [who giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w songs| strong="H2158" \w* \w in the night| strong="H3915" \w*; 
\v 11 [Who teacheth]{strong=“H502” x-morph=“strongMorph: \sc Th\sc*8764”} \w us more than the beasts| strong="H929" \w* \w of the earth| strong="H776" \w*, [and maketh us wiser]{strong=“H2449” x-morph=“strongMorph: \sc Th\sc*8762”} \w than the fowls| strong="H5775" \w* \w of heaven| strong="H8064" \w*? 
\v 12 [There they cry]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8799”}, [but none giveth answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”}, \w because| strong="H6440" \w* \w of the pride| strong="H1347" \w* \w of evil men| strong="H7451" \w*. 
\v 13 \w Surely God| strong="H410" \w* [will not hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w vanity| strong="H7723" \w*, \w neither will the Almighty| strong="H7706" \w* [regard]{strong=“H7789” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\p
\v 14 \w Although| strong="H637" \w* [thou sayest]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [thou shalt not see]{strong=“H7789” x-morph=“strongMorph: \sc Th\sc*8799”} him, yet \w judgment| strong="H1779" \w* is \w before| strong="H6440" \w* [him; therefore trust]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8787”} thou in him. 
\v 15 But now, because it is not so, [he hath visited]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his anger| strong="H639" \w*; [yet he knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} it \w not in great| strong="H3966" \w* \w extremity| strong="H6580" \w*:\f + \fr 35:15 \ft he hath: that is, God hath \f* \f + \fr 35:15 \ft he knoweth: that is, Job knoweth \f* 
\v 16 \w Therefore doth Job| strong="H347" \w* [open]{strong=“H6475” x-morph=“strongMorph: \sc Th\sc*8799”} \w his mouth| strong="H6310" \w* \w in vain| strong="H1892" \w*; [he multiplieth]{strong=“H3527” x-morph=“strongMorph: \sc Th\sc*8686”} \w words| strong="H4405" \w* \w without| strong="H1097" \w* \w knowledge| strong="H1847" \w*.
\c 36
\p 
\v 1 \w Elihu| strong="H453" \w* [also proceeded]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”}, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 [Suffer]{strong=“H3803” x-morph=“strongMorph: \sc Th\sc*8761”} \w me a little| strong="H2191" \w*, [and I will shew]{strong=“H2331” x-morph=“strongMorph: \sc Th\sc*8762”} thee that I have \w yet to speak| strong="H4405" \w* [on God’s]{strong=“H433”} behalf.\f + \fr 36:2 \ft I have…: Heb. there are yet words for God \f* 
\v 3 [I will fetch]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w my knowledge| strong="H1843" \w* \w from afar| strong="H7350" \w*, [and will ascribe]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w righteousness| strong="H6664" \w* [to my Maker]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 4 \w For truly| strong="H551" \w* \w my words| strong="H4405" \w* shall not be \w false| strong="H8267" \w*: \w he that is perfect| strong="H8549" \w* \w in knowledge| strong="H1844" \w* is with thee. 
\p
\v 5 [Behold, God]{strong=“H410”} is \w mighty| strong="H3524" \w*, [and despiseth]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8799”} not any: he is \w mighty| strong="H3524" \w* \w in strength| strong="H3581" \w* and \w wisdom| strong="H3820" \w*.\f + \fr 36:5 \ft wisdom: Heb. heart \f* 
\v 6 [He preserveth not the life]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8762”} \w of the wicked| strong="H7563" \w*: [but giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w right| strong="H4941" \w* \w to the poor| strong="H6041" \w*.\f + \fr 36:6 \ft poor: or, afflicted \f* 
\v 7 [He withdraweth]{strong=“H1639” x-morph=“strongMorph: \sc Th\sc*8799”} \w not his eyes| strong="H5869" \w* \w from the righteous| strong="H6662" \w*: \w but with kings| strong="H4428" \w* are they \w on the throne| strong="H3678" \w*; [yea, he doth establish]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8686”} \w them for ever| strong="H5331" \w*, [and they are exalted]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 8 And if they be [bound]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8803”} \w in fetters| strong="H2131" \w*, and [be holden]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8735”} \w in cords| strong="H2256" \w* \w of affliction| strong="H6040" \w*; 
\v 9 [Then he sheweth]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w them their work| strong="H6467" \w*, \w and their transgressions| strong="H6588" \w* [that they have exceeded]{strong=“H1396” x-morph=“strongMorph: \sc Th\sc*8691”}. 
\v 10 [He openeth]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8799”} \w also their ear| strong="H241" \w* \w to discipline| strong="H4148" \w*, [and commandeth]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [that they return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w from iniquity| strong="H205" \w*. 
\v 11 [If they obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [and serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} him, [they shall spend]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8762”} \w their days| strong="H3117" \w* \w in prosperity| strong="H2896" \w*, \w and their years| strong="H8141" \w* \w in pleasures| strong="H5273" \w*. 
\v 12 [But if they obey]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [not, they shall perish]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} \w by the sword| strong="H7973" \w*, [and they shall die]{strong=“H1478” x-morph=“strongMorph: \sc Th\sc*8799”} \w without knowledge| strong="H1847" \w*.\f + \fr 36:12 \ft perish: Heb. pass away \f* 
\v 13 \w But the hypocrites| strong="H2611" \w* \w in heart| strong="H3820" \w* [heap up]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w wrath| strong="H639" \w*: [they cry]{strong=“H7768” x-morph=“strongMorph: \sc Th\sc*8762”} [not when he bindeth]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8804”} them. 
\v 14 \w They| strong="H5315" \w* [die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w in youth| strong="H5290" \w*, \w and their life| strong="H2416" \w* is \w among the unclean| strong="H6945" \w*.\f + \fr 36:14 \ft They…: Heb. Their soul dieth \f* \f + \fr 36:14 \ft unclean: or, sodomites \f* 
\p
\v 15 [He delivereth]{strong=“H2502” x-morph=“strongMorph: \sc Th\sc*8762”} \w the poor| strong="H6041" \w* \w in his affliction| strong="H6040" \w*, [and openeth]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8799”} \w their ears| strong="H241" \w* \w in oppression| strong="H3906" \w*.\f + \fr 36:15 \ft poor: or, afflicted \f* 
\v 16 [Even so would he have removed]{strong=“H5496” x-morph=“strongMorph: \sc Th\sc*8689”} [thee out of the strait]{strong=“H6862 H6310”} into \w a broad place| strong="H7338" \w*, \w where| strong="H8478" \w* there is \w no straitness| strong="H4164" \w*; \w and that which should be set| strong="H5183" \w* \w on thy table| strong="H7979" \w* should be [full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of fatness| strong="H1880" \w*.\f + \fr 36:16 \ft that…: Heb. the rest of thy table \f* 
\v 17 [But thou hast fulfilled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w the judgment| strong="H1779" \w* \w of the wicked| strong="H7563" \w*: \w judgment| strong="H1779" \w* \w and justice| strong="H4941" \w* [take hold]{strong=“H8551” x-morph=“strongMorph: \sc Th\sc*8799”} on thee.\f + \fr 36:17 \ft take…: or, should uphold thee \f* 
\v 18 Because there is \w wrath| strong="H2534" \w*, beware [lest he take thee away]{strong=“H5496” x-morph=“strongMorph: \sc Th\sc*8686”} with his \w stroke| strong="H5607" \w*: \w then a great| strong="H7230" \w* \w ransom| strong="H3724" \w* [cannot deliver]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} thee.\f + \fr 36:18 \ft deliver…: Heb. turn thee aside \f* 
\v 19 [Will he esteem]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy riches| strong="H7769" \w*? no, \w not gold| strong="H1222" \w*, \w nor all the forces| strong="H3981" \w* \w of strength| strong="H3581" \w*. 
\v 20 [Desire]{strong=“H7602” x-morph=“strongMorph: \sc Th\sc*8799”} \w not the night| strong="H3915" \w*, \w when people| strong="H5971" \w* [are cut off]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8800”} in their place. 
\v 21 [Take heed]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8734”}, [regard]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8799”} \w not iniquity| strong="H205" \w*: [for this hast thou chosen]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8804”} \w rather than affliction| strong="H6040" \w*. 
\v 22 [Behold, God]{strong=“H410”} [exalteth]{strong=“H7682” x-morph=“strongMorph: \sc Th\sc*8686”} \w by his power| strong="H3581" \w*: [who teacheth]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8688”} like him? 
\v 23 [Who hath enjoined]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} \w him his way| strong="H1870" \w*? [or who can say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Thou hast wrought]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8804”} \w iniquity| strong="H5766" \w*? 
\p
\v 24 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”} [that thou magnify]{strong=“H7679” x-morph=“strongMorph: \sc Th\sc*8686”} \w his work| strong="H6467" \w*, \w which men| strong="H582" \w* [behold]{strong=“H7891” x-morph=“strongMorph: \sc Th\sc*8790”}. 
\v 25 \w Every man| strong="H120" \w* [may see]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8804”} [it; man]{strong=“H582”} [may behold]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”} it \w afar off| strong="H7350" \w*. 
\v 26 [Behold, God]{strong=“H410”} is \w great| strong="H7689" \w*, [and we know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} him [not, neither can the number]{strong=“H4557”} \w of his years| strong="H8141" \w* \w be searched out| strong="H2714" \w*. 
\v 27 [For he maketh small]{strong=“H1639” x-morph=“strongMorph: \sc Th\sc*8762”} \w the drops| strong="H5198" \w* \w of water| strong="H4325" \w*: [they pour down]{strong=“H2212” x-morph=“strongMorph: \sc Th\sc*8799”} \w rain| strong="H4306" \w* \w according to the vapour| strong="H108" \w* thereof: 
\v 28 \w Which the clouds| strong="H7834" \w* [do drop]{strong=“H5140” x-morph=“strongMorph: \sc Th\sc*8799”} and [distil]{strong=“H7491” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon man| strong="H120" \w* \w abundantly| strong="H7227" \w*. 
\v 29 Also can any [understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} \w the spreadings| strong="H4666" \w* \w of the clouds| strong="H5645" \w*, or \w the noise| strong="H8663" \w* \w of his tabernacle| strong="H5521" \w*? 
\v 30 [Behold, he spreadeth]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8804”} \w his light| strong="H216" \w* [upon it, and covereth]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”} \w the bottom| strong="H8328" \w* \w of the sea| strong="H3220" \w*.\f + \fr 36:30 \ft bottom: Heb. roots \f* 
\v 31 [For by them judgeth]{strong=“H1777” x-morph=“strongMorph: \sc Th\sc*8799”} \w he the people| strong="H5971" \w*; [he giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w meat| strong="H400" \w* [in abundance]{strong=“H4342” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 32 \w With clouds| strong="H3709" \w* [he covereth]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”} \w the light| strong="H216" \w*; [and commandeth]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} it not to shine by the cloud [that cometh betwixt]{strong=“H6293” x-morph=“strongMorph: \sc Th\sc*8688”}. 
\v 33 \w The noise| strong="H7452" \w* [thereof sheweth]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} [concerning it, the cattle]{strong=“H4735”} [also concerning the vapour]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 36:33 \ft the vapour: Heb. that which goeth up \f*
\c 37
\p 
\v 1 \w At this| strong="H2063" \w* \w also my heart| strong="H3820" \w* [trembleth]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8799”}, [and is moved out]{strong=“H5425” x-morph=“strongMorph: \sc Th\sc*8799”} \w of his place| strong="H4725" \w*. 
\v 2 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [attentively]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w the noise| strong="H7267" \w* \w of his voice| strong="H6963" \w*, \w and the sound| strong="H1899" \w* that [goeth out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w of his mouth| strong="H6310" \w*.\f + \fr 37:2 \ft Hear…: Heb. Hear in hearing \f* 
\v 3 [He directeth]{strong=“H3474” x-morph=“strongMorph: \sc Th\sc*8765”} [it]{strong=“H8281” x-morph=“strongMorph: \sc Th\sc*8799”} \w under the whole heaven| strong="H8064" \w*, \w and his lightning| strong="H216" \w* \w unto the ends| strong="H3671" \w* \w of the earth| strong="H776" \w*.\f + \fr 37:3 \ft lightning: Heb. light \f* \f + \fr 37:3 \ft ends: Heb. wings \f* 
\v 4 \w After| strong="H310" \w* \w it a voice| strong="H6963" \w* [roareth]{strong=“H7580” x-morph=“strongMorph: \sc Th\sc*8799”}: [he thundereth]{strong=“H7481” x-morph=“strongMorph: \sc Th\sc*8686”} \w with the voice| strong="H6963" \w* \w of his excellency| strong="H1347" \w*; [and he will not stay]{strong=“H6117” x-morph=“strongMorph: \sc Th\sc*8762”} \w them when his voice| strong="H6963" \w* [is heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 5 \w God| strong="H410" \w* [thundereth]{strong=“H7481” x-morph=“strongMorph: \sc Th\sc*8686”} [marvellously]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} \w with his voice| strong="H6963" \w*; \w great things| strong="H1419" \w* [doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} [he, which we cannot comprehend]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 6 [For he saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the snow| strong="H7950" \w*, [Be thou]{strong=“H1933” x-morph=“strongMorph: \sc Th\sc*8798”} on \w the earth| strong="H776" \w*; \w likewise to the small| strong="H4306" \w* \w rain| strong="H1653" \w*, \w and to the great| strong="H4306" \w* \w rain| strong="H1653" \w* \w of his strength| strong="H5797" \w*.\f + \fr 37:6 \ft likewise…: Heb. and to the shower of rain, and to the showers of rain of his strength \f* 
\v 7 [He sealeth up]{strong=“H2856” x-morph=“strongMorph: \sc Th\sc*8799”} \w the hand| strong="H3027" \w* \w of every man| strong="H120" \w*; \w that all men| strong="H582" \w* [may know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} \w his work| strong="H4639" \w*. 
\v 8 \w Then the beasts| strong="H2416" \w* [go]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w into| strong="H1119" \w* \w dens| strong="H695" \w*, [and remain]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} \w in their places| strong="H4585" \w*. 
\v 9 \w Out of the south| strong="H2315" \w* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w the whirlwind| strong="H5492" \w*: \w and cold| strong="H7135" \w* \w out of the north| strong="H4215" \w*.\f + \fr 37:9 \ft south: Heb. chamber \f* \f + \fr 37:9 \ft north: Heb. scattering winds \f* 
\v 10 \w By the breath| strong="H5397" \w* \w of God| strong="H410" \w* \w frost| strong="H7140" \w* [is given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”}: \w and the breadth| strong="H7341" \w* \w of the waters| strong="H4325" \w* \w is straitened| strong="H4164" \w*. 
\v 11 \w Also by watering| strong="H7377" \w* [he wearieth]{strong=“H2959” x-morph=“strongMorph: \sc Th\sc*8686”} \w the thick cloud| strong="H5645" \w*: [he scattereth]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8686”} \w his bright| strong="H216" \w* \w cloud| strong="H6051" \w*:\f + \fr 37:11 \ft his…: Heb. the cloud of his light \f* 
\v 12 [And it is turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8693”} \w round about| strong="H4524" \w* \w by his counsels| strong="H8458" \w*: \w that they may do| strong="H6467" \w* [whatsoever he commandeth]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8762”} \w them upon the face| strong="H6440" \w* \w of the world| strong="H8398" \w* \w in the earth| strong="H776" \w*. 
\v 13 [He causeth it to come]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8686”}, \w whether for correction| strong="H7626" \w*, \w or for his land| strong="H776" \w*, \w or for mercy| strong="H2617" \w*.\f + \fr 37:13 \ft correction: Heb. a rod \f* 
\p
\v 14 [Hearken]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8685”} [unto this, O Job]{strong=“H347”}: [stand still]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8798”}, [and consider]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8708”} [the wondrous]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} \w works of God| strong="H410" \w*. 
\v 15 [Dost thou know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w when God| strong="H433" \w* [disposed]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} [them, and caused the light]{strong=“H216”} \w of his cloud| strong="H6051" \w* [to shine]{strong=“H3313” x-morph=“strongMorph: \sc Th\sc*8689”}? 
\v 16 [Dost thou know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w the balancings| strong="H4657" \w* \w of the clouds| strong="H5645" \w*, \w the wondrous works| strong="H4652" \w* \w of him which is perfect| strong="H8549" \w* \w in knowledge| strong="H1843" \w*? 
\v 17 \w How thy garments| strong="H899" \w* are \w warm| strong="H2525" \w*, [when he quieteth]{strong=“H8252” x-morph=“strongMorph: \sc Th\sc*8687”} \w the earth| strong="H776" \w* \w by the south| strong="H1864" \w* wind? 
\v 18 [Hast thou with him spread out]{strong=“H7554” x-morph=“strongMorph: \sc Th\sc*8686”} \w the sky| strong="H7834" \w*, which is \w strong| strong="H2389" \w*, and [as a molten]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8716”} \w looking glass| strong="H7209" \w*? 
\v 19 [Teach]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8685”} [us what we shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him; for [we cannot order]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8799”} our speech \w by reason| strong="H6440" \w* \w of darkness| strong="H2822" \w*. 
\v 20 [Shall it be told]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8792”} [him that I speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}? \w if a man| strong="H376" \w* [speak]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [surely he shall be swallowed up]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8792”}. 
\p
\v 21 And now men [see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the bright| strong="H925" \w* \w light| strong="H216" \w* which is \w in the clouds| strong="H7834" \w*: \w but the wind| strong="H7307" \w* [passeth]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”}, [and cleanseth]{strong=“H2891” x-morph=“strongMorph: \sc Th\sc*8762”} them. 
\v 22 \w Fair weather| strong="H2091" \w* [cometh]{strong=“H857” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of the north| strong="H6828" \w*: \w with God| strong="H433" \w* is [terrible]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”} \w majesty| strong="H1935" \w*.\f + \fr 37:22 \ft Fair…: Heb. Gold \f* 
\v 23 Touching \w the Almighty| strong="H7706" \w*, [we cannot find him out]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”}: he is \w excellent| strong="H7689" \w* \w in power| strong="H3581" \w*, \w and in judgment| strong="H4941" \w*, \w and in plenty| strong="H7230" \w* \w of justice| strong="H6666" \w*: [he will not afflict]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 24 \w Men| strong="H582" \w* [do therefore fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8804”} [him: he respecteth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} not any that are \w wise| strong="H2450" \w* \w of heart| strong="H3820" \w*.
\c 38
\p 
\v 1 Then the \sc Lord\sc* [answered ]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w Job| strong="H347" \w* \w out of the whirlwind| strong="H5591" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 Who is [this that darkeneth]{strong=“H2821” x-morph=“strongMorph: \sc Th\sc*8688”} \w counsel| strong="H6098" \w* \w by words| strong="H4405" \w* \w without knowledge| strong="H1847" \w*? 
\v 3 [Gird up]{strong=“H247” x-morph=“strongMorph: \sc Th\sc*8798”} \w now thy loins| strong="H2504" \w* \w like a man| strong="H1397" \w*; [for I will demand]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} [of thee, and answer]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8685”} thou me.\f + \fr 38:3 \ft answer…: Heb. make me know \f* 
\p
\v 4 \w Where| strong="H375" \w* [wast thou when I laid the foundations]{strong=“H3245” x-morph=“strongMorph: \sc Th\sc*8800”} \w of the earth| strong="H776" \w*? [declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”}, [if thou hast]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w understanding| strong="H998" \w*.\f + \fr 38:4 \ft hast…: Heb. knowest understanding \f* 
\v 5 [Who hath laid]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w the measures| strong="H4461" \w* [thereof, if thou knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”}? [or who hath stretched]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} \w the line| strong="H6957" \w* upon it? 
\v 6 \w Whereupon are the foundations| strong="H134" \w* [thereof fastened]{strong=“H2883” x-morph=“strongMorph: \sc Th\sc*8717”}? [or who laid]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8804”} \w the corner| strong="H6438" \w* \w stone| strong="H68" \w* thereof;\f + \fr 38:6 \ft foundations: Heb. sockets \f* \f + \fr 38:6 \ft fastened: Heb. made to sink? \f* 
\v 7 \w When the morning| strong="H1242" \w* \w stars| strong="H3556" \w* [sang]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8800”} \w together| strong="H3162" \w*, \w and all the sons| strong="H1121" \w* \w of God| strong="H430" \w* [shouted]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8686”} for joy? 
\v 8 Or who [shut up]{strong=“H5526” x-morph=“strongMorph: \sc Th\sc*8686”} \w the sea| strong="H3220" \w* \w with doors| strong="H1817" \w*, [when it brake forth]{strong=“H1518” x-morph=“strongMorph: \sc Th\sc*8800”}, as if [it had issued out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the womb| strong="H7358" \w*? 
\v 9 [When I made]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w the cloud| strong="H6051" \w* \w the garment| strong="H3830" \w* [thereof, and thick darkness]{strong=“H6205”} \w a swaddlingband| strong="H2854" \w* for it, 
\v 10 [And brake up]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8799”} \w for it my decreed| strong="H2706" \w* place, [and set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w bars| strong="H1280" \w* \w and doors| strong="H1817" \w*,\f + \fr 38:10 \ft brake…: or, established my decree upon it \f* 
\v 11 [And said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Hitherto]{strong=“H6311 H5704”} [shalt thou come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}, [but no further]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”}: \w and here shall thy proud| strong="H1347" \w* \w waves| strong="H1530" \w* [be stayed]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”}?\f + \fr 38:11 \ft thy…: Heb. the pride of thy waves \f* 
\p
\v 12 [Hast thou commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w the morning| strong="H1242" \w* \w since thy days| strong="H3117" \w*; and \w caused the dayspring| strong="H7837" \w* [to know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8765”} \w his place| strong="H4725" \w*; 
\v 13 [That it might take hold]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8800”} \w of the ends| strong="H3671" \w* \w of the earth| strong="H776" \w*, \w that the wicked| strong="H7563" \w* [might be shaken out]{strong=“H5287” x-morph=“strongMorph: \sc Th\sc*8735”} of it?\f + \fr 38:13 \ft ends: Heb. wings \f* 
\v 14 [It is turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8691”} \w as clay| strong="H2563" \w* to \w the seal| strong="H2368" \w*; [and they stand]{strong=“H3320” x-morph=“strongMorph: \sc Th\sc*8691”} \w as a garment| strong="H3830" \w*. 
