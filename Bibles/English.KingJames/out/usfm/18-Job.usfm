\v 28 [She dwelleth]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} [and abideth]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8698”} \w on the rock| strong="H5553" \w*, \w upon the crag| strong="H8127" \w* \w of the rock| strong="H5553" \w*, \w and the strong place| strong="H4686" \w*. 
\v 29 [From thence she seeketh]{strong=“H2658” x-morph=“strongMorph: \sc Th\sc*8804”} \w the prey| strong="H400" \w*, and \w her eyes| strong="H5869" \w* [behold]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”} \w afar off| strong="H7350" \w*. 
\v 30 \w Her young ones| strong="H667" \w* [also suck up]{strong=“H5966” x-morph=“strongMorph: \sc Th\sc*8762”} \w blood| strong="H1818" \w*: \w and where the slain| strong="H2491" \w* are, there is \w she| strong="H1931" \w*.
\c 40
\p 
\v 1 Moreover the \sc Lord\sc* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w Job| strong="H347" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 [Shall he that contendeth]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8800”} \w with the Almighty| strong="H7706" \w* \w instruct| strong="H3250" \w* him? [he that reproveth]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8688”} \w God| strong="H433" \w*, [let him answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\p
\v 3 \w Then Job| strong="H347" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 4 [Behold, I am vile]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8804”}; [what shall I answer]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} [thee? I will lay]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w mine hand| strong="H3027" \w* \w upon| strong="H3926" \w* \w my mouth| strong="H6310" \w*. 
\v 5 \w Once| strong="H259" \w* [have I spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}; [but I will not answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”}: [yea, twice]{strong=“H8147”}; [but I will proceed no further]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\p
\v 6 [Then answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc* \w unto Job| strong="H347" \w* \w out of the whirlwind| strong="H5591" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 7 [Gird up]{strong=“H247” x-morph=“strongMorph: \sc Th\sc*8798”} \w thy loins| strong="H2504" \w* \w now like a man| strong="H1397" \w*: [I will demand]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} [of thee, and declare]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8685”} thou unto me. 
\v 8 [Wilt thou also disannul]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8686”} \w my judgment| strong="H4941" \w*? [wilt thou condemn]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8686”} [me, that thou mayest be righteous]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8799”}? 
\v 9 \w Hast thou an arm| strong="H2220" \w* \w like God| strong="H410" \w*? [or canst thou thunder]{strong=“H7481” x-morph=“strongMorph: \sc Th\sc*8686”} \w with a voice| strong="H6963" \w* like him? 
\v 10 [Deck]{strong=“H5710” x-morph=“strongMorph: \sc Th\sc*8798”} thyself now with \w majesty| strong="H1347" \w* \w and excellency| strong="H1363" \w*; [and array]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w thyself with glory| strong="H1935" \w* \w and beauty| strong="H1926" \w*. 
\v 11 [Cast abroad]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8685”} \w the rage| strong="H5678" \w* \w of thy wrath| strong="H639" \w*: [and behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} every one that is \w proud| strong="H1343" \w*, [and abase]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8685”} him. 
\v 12 [Look]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} on every one that is \w proud| strong="H1343" \w*, and [bring him low]{strong=“H3665” x-morph=“strongMorph: \sc Th\sc*8685”}; [and tread down]{strong=“H1915” x-morph=“strongMorph: \sc Th\sc*8798”} \w the wicked| strong="H7563" \w* in their place. 
\v 13 [Hide]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8798”} \w them in the dust| strong="H6083" \w* \w together| strong="H3162" \w*; and [bind]{strong=“H2280” x-morph=“strongMorph: \sc Th\sc*8798”} \w their faces| strong="H6440" \w* [in secret]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8803”}. 
\v 14 [Then will I also confess]{strong=“H3034” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto thee that thine own right hand| strong="H3225" \w* [can save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} thee. 
\p
\v 15 \w Behold now behemoth| strong="H930" \w*, [which I made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [with thee; he eateth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w grass| strong="H2682" \w* \w as an ox| strong="H1241" \w*.\f + \fr 40:15 \ft behemoth: probably an extinct animal of some kind \f* 
\v 16 [Lo now, his strength]{strong=“H3581”} is \w in his loins| strong="H4975" \w*, \w and his force| strong="H202" \w* is \w in the navel| strong="H8306" \w* \w of his belly| strong="H990" \w*. 
\v 17 [He moveth]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8799”} \w his tail| strong="H2180" \w* \w like a cedar| strong="H730" \w*: \w the sinews| strong="H1517" \w* \w of his stones| strong="H6344" \w* [are wrapped together]{strong=“H8276” x-morph=“strongMorph: \sc Th\sc*8792”}.\f + \fr 40:17 \ft He…: or, He setteth up \f* 
\v 18 \w His bones| strong="H6106" \w* are as \w strong| strong="H650" \w* \w pieces of brass| strong="H5154" \w*; \w his bones| strong="H1634" \w* are \w like bars| strong="H4300" \w* \w of iron| strong="H1270" \w*. 
\v 19 He is \w the chief| strong="H7225" \w* \w of the ways| strong="H1870" \w* \w of God| strong="H410" \w*: [he that made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w him can make| strong="H5066" \w* \w his sword| strong="H2719" \w* [to approach]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8686”} unto him. 
\v 20 \w Surely the mountains| strong="H2022" \w* [bring him forth]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w food| strong="H944" \w*, \w where all the beasts| strong="H2416" \w* \w of the field| strong="H7704" \w* [play]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 21 [He lieth]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w under the shady trees| strong="H6628" \w*, \w in the covert| strong="H5643" \w* \w of the reed| strong="H7070" \w*, \w and fens| strong="H1207" \w*. 
\v 22 \w The shady trees| strong="H6628" \w* [cover]{strong=“H5526” x-morph=“strongMorph: \sc Th\sc*8799”} him with \w their shadow| strong="H6752" \w*; \w the willows| strong="H6155" \w* \w of the brook| strong="H5158" \w* [compass him about]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 23 [Behold, he drinketh up]{strong=“H6231” x-morph=“strongMorph: \sc Th\sc*8799”} \w a river| strong="H5104" \w*, and [hasteth]{strong=“H2648” x-morph=“strongMorph: \sc Th\sc*8799”} [not: he trusteth]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8799”} [that he can draw up]{strong=“H1518” x-morph=“strongMorph: \sc Th\sc*8799”} \w Jordan| strong="H3383" \w* \w into his mouth| strong="H6310" \w*.\f + \fr 40:23 \ft he drinketh up: Heb. he oppresseth \f* 
\v 24 [He taketh]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w it with his eyes| strong="H5869" \w*: his \w nose| strong="H639" \w* [pierceth through]{strong=“H5344” x-morph=“strongMorph: \sc Th\sc*8799”} \w snares| strong="H4170" \w*.\f + \fr 40:24 \ft He…: or, Will any take him in his sight, or, bore his nose with a gin? \f*
\c 41
\p 
\v 1 [Canst thou draw out]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8799”} \w leviathan| strong="H3882" \w* \w with an hook| strong="H2443" \w*? \w or his tongue| strong="H3956" \w* \w with a cord| strong="H2256" \w* which [thou lettest down]{strong=“H8257” x-morph=“strongMorph: \sc Th\sc*8686”}?\f + \fr 41:1 \ft leviathan: probably an extinct animal of some kind \f* \f + \fr 41:1 \ft which…: Heb. which thou drownest? \f* 
\v 2 [Canst thou put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w an hook| strong="H100" \w* \w into his nose| strong="H639" \w*? [or bore]{strong=“H5344” x-morph=“strongMorph: \sc Th\sc*8799”} \w his jaw| strong="H3895" \w* \w through with a thorn| strong="H2336" \w*? 
\v 3 [Will he make many]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} \w supplications| strong="H8469" \w* [unto thee? will he speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w soft| strong="H7390" \w* words unto thee? 
\v 4 [Will he make]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} \w a covenant| strong="H1285" \w* [with thee? wilt thou take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w him for a servant| strong="H5650" \w* \w for ever| strong="H5769" \w*? 
\v 5 [Wilt thou play]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8762”} with him as with \w a bird| strong="H6833" \w*? [or wilt thou bind]{strong=“H7194” x-morph=“strongMorph: \sc Th\sc*8799”} \w him for thy maidens| strong="H5291" \w*? 
\v 6 \w Shall the companions| strong="H2271" \w* [make a banquet]{strong=“H3739” x-morph=“strongMorph: \sc Th\sc*8799”} [of him? shall they part]{strong=“H2673” x-morph=“strongMorph: \sc Th\sc*8799”} \w him among the merchants| strong="H3669" \w*? 
\v 7 [Canst thou fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8762”} \w his skin| strong="H5785" \w* \w with barbed irons| strong="H7905" \w*? \w or his head| strong="H7218" \w* \w with fish| strong="H1709" \w* \w spears| strong="H6767" \w*? 
\v 8 [Lay]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} \w thine hand| strong="H3709" \w* [upon him, remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”} \w the battle| strong="H4421" \w*, [do no more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 9 [Behold, the hope]{strong=“H8431”} [of him is in vain]{strong=“H3576” x-morph=“strongMorph: \sc Th\sc*8738”}: shall not one [be cast down]{strong=“H2904” x-morph=“strongMorph: \sc Th\sc*8714”} \w even at the sight| strong="H4758" \w* of him? 
\v 10 None is so \w fierce| strong="H393" \w* [that dare stir him up]{strong=“H5782 H5782” x-morph=“strongMorph: \sc Th\sc*8686 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8799”}: [who then is able to stand]{strong=“H3320” x-morph=“strongMorph: \sc Th\sc*8691”} \w before| strong="H6440" \w* me? 
\p
\v 11 [Who hath prevented]{strong=“H6923” x-morph=“strongMorph: \sc Th\sc*8689”} [me, that I should repay]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} him? whatsoever is \w under the whole heaven| strong="H8064" \w* is mine. 
\v 12 [I will not conceal]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8686”} \w his parts| strong="H907" \w*, [nor his power]{strong=“H1697 H1369”}, \w nor his comely| strong="H2433" \w* \w proportion| strong="H6187" \w*. 
\v 13 [Who can discover]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8765”} \w the face| strong="H6440" \w* \w of his garment| strong="H3830" \w*? or [who can come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} to him \w with his double| strong="H3718" \w* \w bridle| strong="H7448" \w*?\f + \fr 41:13 \ft with: or, within \f* 
\v 14 [Who can open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8765”} \w the doors| strong="H1817" \w* \w of his face| strong="H6440" \w*? \w his teeth| strong="H8127" \w* are \w terrible| strong="H367" \w* \w round about| strong="H5439" \w*. 
\v 15 His [scales]{strong=“H650 H4043”} are his \w pride| strong="H1346" \w*, [shut up together]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8803”} as with \w a close| strong="H6862" \w* \w seal| strong="H2368" \w*.\f + \fr 41:15 \ft scales: Heb. strong pieces of shields \f* 
\v 16 \w One| strong="H259" \w* [is so near]{strong=“H5066” x-morph=“strongMorph: \sc Th\sc*8799”} \w to another| strong="H259" \w*, \w that no air| strong="H7307" \w* [can come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} between them. 
\v 17 [They are joined]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8792”} \w one| strong="H376" \w* \w to another| strong="H251" \w*, [they stick together]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8691”}, [that they cannot be sundered]{strong=“H6504” x-morph=“strongMorph: \sc Th\sc*8691”}. 
\v 18 \w By his neesings| strong="H5846" \w* \w a light| strong="H216" \w* [doth shine]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8686”}, \w and his eyes| strong="H5869" \w* are \w like the eyelids| strong="H6079" \w* \w of the morning| strong="H7837" \w*. 
\v 19 \w Out of his mouth| strong="H6310" \w* [go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8799”} \w burning lamps| strong="H3940" \w*, and \w sparks| strong="H3590" \w* \w of fire| strong="H784" \w* [leap out]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8691”}. 
\v 20 \w Out of his nostrils| strong="H5156" \w* [goeth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w smoke| strong="H6227" \w*, as out [of a seething]{strong=“H5301” x-morph=“strongMorph: \sc Th\sc*8803”} \w pot| strong="H1731" \w* \w or caldron| strong="H100" \w*. 
\v 21 \w His breath| strong="H5315" \w* [kindleth]{strong=“H3857” x-morph=“strongMorph: \sc Th\sc*8762”} \w coals| strong="H1513" \w*, \w and a flame| strong="H3851" \w* [goeth out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w of his mouth| strong="H6310" \w*. 
\v 22 \w In his neck| strong="H6677" \w* [remaineth]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} \w strength| strong="H5797" \w*, \w and sorrow| strong="H1670" \w* [is turned into joy]{strong=“H1750” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* him.\f + \fr 41:22 \ft is turned into joy: Heb. rejoiceth \f* 
\v 23 \w The flakes| strong="H4651" \w* \w of his flesh| strong="H1320" \w* [are joined together]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8804”}: [they are firm]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8803”} [in themselves; they cannot be moved]{strong=“H4131” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 41:23 \ft flakes: Heb. fallings \f* 
\v 24 \w His heart| strong="H3820" \w* [is as firm]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8803”} \w as a stone| strong="H68" \w*; [yea, as hard]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8803”} \w as a piece| strong="H6400" \w* \w of the nether| strong="H8482" \w* millstone. 
\v 25 \w When he raiseth up| strong="H7613" \w* [himself, the mighty]{strong=“H352”} [are afraid]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8799”}: \w by reason of breakings| strong="H7667" \w* [they purify]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8691”} themselves. 
\v 26 \w The sword| strong="H2719" \w* [of him that layeth]{strong=“H5381” x-morph=“strongMorph: \sc Th\sc*8688”} [at him cannot hold]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}: \w the spear| strong="H2595" \w*, \w the dart| strong="H4551" \w*, \w nor the habergeon| strong="H8302" \w*.\f + \fr 41:26 \ft habergeon: or, breastplate \f* 
\v 27 [He esteemeth]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8799”} \w iron| strong="H1270" \w* \w as straw| strong="H8401" \w*, and \w brass| strong="H5154" \w* \w as rotten| strong="H7539" \w* \w wood| strong="H6086" \w*. 
\v 28 [The arrow]{strong=“H7198 H1121”} [cannot make him flee]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8686”}: [slingstones]{strong=“H7050 H68”} [are turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8738”} \w with him into stubble| strong="H7179" \w*. 
\v 29 \w Darts| strong="H8455" \w* [are counted]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8738”} \w as stubble| strong="H7179" \w*: [he laugheth]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8799”} \w at the shaking| strong="H7494" \w* \w of a spear| strong="H3591" \w*. 
\v 30 \w Sharp| strong="H2303" \w* \w stones| strong="H2789" \w* are [under him: he spreadeth]{strong=“H7502” x-morph=“strongMorph: \sc Th\sc*8799”} \w sharp pointed things| strong="H2742" \w* \w upon the mire| strong="H2916" \w*.\f + \fr 41:30 \ft Sharp stones: Heb. Sharp pieces of potsherd \f* 
\v 31 \w He maketh the deep| strong="H4688" \w* [to boil]{strong=“H7570” x-morph=“strongMorph: \sc Th\sc*8686”} \w like a pot| strong="H5518" \w*: [he maketh]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w the sea| strong="H3220" \w* \w like a pot of ointment| strong="H4841" \w*. 
\v 32 \w He maketh a path| strong="H5410" \w* [to shine]{strong=“H215” x-morph=“strongMorph: \sc Th\sc*8686”} \w after| strong="H310" \w* him; one [would think]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8799”} \w the deep| strong="H8415" \w* to be \w hoary| strong="H7872" \w*. 
\v 33 \w Upon earth| strong="H6083" \w* \w there is not his like| strong="H4915" \w*, [who is made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8803”} \w without| strong="H1097" \w* \w fear| strong="H2844" \w*.\f + \fr 41:33 \ft is made without fear: or, behave themselves without fear \f* 
\v 34 [He beholdeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w all high| strong="H1364" \w* things: he is \w a king| strong="H4428" \w* \w over all the children| strong="H1121" \w* \w of pride| strong="H7830" \w*.
\c 42
\p 
\v 1 \w Then Job| strong="H347" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 [I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [that thou canst do]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8799”} every thing, and that \w no thought| strong="H4209" \w* [can be withholden]{strong=“H1219” x-morph=“strongMorph: \sc Th\sc*8735”} from thee.\f + \fr 42:2 \ft no thought can be…: or, no thought of thine can be hindered \f* 
\v 3 Who is [he that hideth]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8688”} \w counsel| strong="H6098" \w* \w without knowledge| strong="H1847" \w*? [therefore have I uttered]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} [that I understood]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} [not; things too wonderful]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} [for me, which I knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} not. 
