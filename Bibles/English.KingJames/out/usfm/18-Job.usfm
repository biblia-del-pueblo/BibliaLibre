\v 2 [And there were born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8735”} \w unto him seven| strong="H7651" \w* \w sons| strong="H1121" \w* \w and three| strong="H7969" \w* \w daughters| strong="H1323" \w*. 
\v 3 \w His substance| strong="H4735" \w* \w also was seven| strong="H7651" \w* \w thousand| strong="H505" \w* \w sheep| strong="H6629" \w*, \w and three| strong="H7969" \w* \w thousand| strong="H505" \w* \w camels| strong="H1581" \w*, \w and five| strong="H2568" \w* \w hundred| strong="H3967" \w* \w yoke| strong="H6776" \w* \w of oxen| strong="H1241" \w*, \w and five| strong="H2568" \w* \w hundred| strong="H3967" \w* \w she asses| strong="H860" \w*, \w and a very| strong="H3966" \w* \w great| strong="H7227" \w* \w household| strong="H5657" \w*; \w so that this man| strong="H376" \w* \w was the greatest| strong="H1419" \w* \w of all the men| strong="H1121" \w* \w of the east| strong="H6924" \w*.\f + \fr 1:3 \ft substance: or, cattle \f* \f + \fr 1:3 \ft household: or, husbandry \f* \f + \fr 1:3 \ft men: Heb. sons \f* 
\p
