\c 5
\p 
\v 1 [Call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} [now, if there be]{strong=“H3426”} [any that will answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8802”} [thee; and to which of the saints]{strong=“H6918”} [wilt thou turn]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8799”}?\f + \fr 5:1 \ft turn: or, look? \f* 
\v 2 \w For wrath| strong="H3708" \w* [killeth]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} \w the foolish man| strong="H191" \w*, \w and envy| strong="H7068" \w* [slayeth]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8686”} [the silly one]{strong=“H6601” x-morph=“strongMorph: \sc Th\sc*8802”}.\f + \fr 5:2 \ft envy: or, indignation \f* 
\v 3 [I have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w the foolish| strong="H191" \w* [taking root]{strong=“H8327” x-morph=“strongMorph: \sc Th\sc*8688”}: \w but suddenly| strong="H6597" \w* [I cursed]{strong=“H5344” x-morph=“strongMorph: \sc Th\sc*8799”} \w his habitation| strong="H5116" \w*. 
\v 4 \w His children| strong="H1121" \w* [are far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8799”} \w from safety| strong="H3468" \w*, [and they are crushed]{strong=“H1792” x-morph=“strongMorph: \sc Th\sc*8691”} \w in the gate| strong="H8179" \w*, neither is there [any to deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8688”} them. 
\v 5 \w Whose harvest| strong="H7105" \w* \w the hungry| strong="H7457" \w* [eateth up]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”}, [and taketh]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w it even out| strong="H413" \w* \w of the thorns| strong="H6791" \w*, \w and the robber| strong="H6782" \w* [swalloweth up]{strong=“H7602” x-morph=“strongMorph: \sc Th\sc*8804”} \w their substance| strong="H2428" \w*. 
\p
\v 6 \w Although affliction| strong="H205" \w* [cometh not forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the dust| strong="H6083" \w*, \w neither doth trouble| strong="H5999" \w* [spring out]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the ground| strong="H127" \w*;\f + \fr 5:6 \ft affliction: or, iniquity \f* 
\v 7 \w Yet man| strong="H120" \w* [is born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8795”} \w unto trouble| strong="H5999" \w*, [as the sparks]{strong=“H7565 H1121”} [fly]{strong=“H5774” x-morph=“strongMorph: \sc Th\sc*8800”} [upward]{strong=“H1361” x-morph=“strongMorph: \sc Th\sc*8686”}.\f + \fr 5:7 \ft trouble: or, labour \f* \f + \fr 5:7 \ft sparks…: Heb. the sons of the burning coal lift up to fly \f* 
\v 8 [I would seek]{strong=“H1875 H199” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto God| strong="H410" \w*, \w and unto God| strong="H430" \w* [would I commit]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w my cause| strong="H1700" \w*: 
\v 9 [Which doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w great things| strong="H1419" \w* [and unsearchable]{strong=“H2714 H369”}; [marvellous things]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} \w without number| strong="H4557" \w*:\f + \fr 5:9 \ft unsearchable: Heb. there is no search \f* \f + \fr 5:9 \ft without…: Heb. till there be no number \f* 
\v 10 [Who giveth]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8802”} \w rain| strong="H4306" \w* \w upon| strong="H6440" \w* \w the earth| strong="H776" \w*, [and sendeth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8802”} \w waters| strong="H4325" \w* \w upon| strong="H6440" \w* \w the fields| strong="H2351" \w*:\f + \fr 5:10 \ft fields: Heb. outplaces \f* 
\v 11 [To set up]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w on high| strong="H4791" \w* \w those that be low| strong="H8217" \w*; [that those which mourn]{strong=“H6937” x-morph=“strongMorph: \sc Th\sc*8802”} [may be exalted]{strong=“H7682” x-morph=“strongMorph: \sc Th\sc*8804”} \w to safety| strong="H3468" \w*. 
\v 12 [He disappointeth]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8688”} \w the devices| strong="H4284" \w* \w of the crafty| strong="H6175" \w*, \w so that their hands| strong="H3027" \w* [cannot perform]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} their \w enterprise| strong="H8454" \w*.\f + \fr 5:12 \ft their enterprise: or, any thing \f* 
\v 13 [He taketh]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8802”} \w the wise| strong="H2450" \w* \w in their own craftiness| strong="H6193" \w*: \w and the counsel| strong="H6098" \w* [of the froward]{strong=“H6617” x-morph=“strongMorph: \sc Th\sc*8737”} [is carried headlong]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8737”}. 
\v 14 [They meet]{strong=“H6298” x-morph=“strongMorph: \sc Th\sc*8762”} \w with darkness| strong="H2822" \w* \w in the daytime| strong="H3119" \w*, [and grope]{strong=“H4959” x-morph=“strongMorph: \sc Th\sc*8762”} \w in the noonday| strong="H6672" \w* \w as in the night| strong="H3915" \w*.\f + \fr 5:14 \ft meet…: or, run into \f* 
\v 15 [But he saveth]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} \w the poor| strong="H34" \w* \w from the sword| strong="H2719" \w*, \w from their mouth| strong="H6310" \w*, \w and from the hand| strong="H3027" \w* \w of the mighty| strong="H2389" \w*. 
\v 16 \w So the poor| strong="H1800" \w* \w hath hope| strong="H8615" \w*, \w and iniquity| strong="H5766" \w* [stoppeth ]{strong=“H7092” x-morph=“strongMorph: \sc Th\sc*8804”} \w her mouth| strong="H6310" \w*. 
\p
\v 17 [Behold, happy]{strong=“H835”} is \w the man| strong="H582" \w* \w whom God| strong="H433" \w* [correcteth]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”}: [therefore despise]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8799”} \w not thou the chastening| strong="H4148" \w* \w of the Almighty| strong="H7706" \w*: 
\v 18 [For he maketh sore]{strong=“H3510” x-morph=“strongMorph: \sc Th\sc*8686”}, [and bindeth up]{strong=“H2280” x-morph=“strongMorph: \sc Th\sc*8799”}: [he woundeth]{strong=“H4272” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and his hands| strong="H3027" \w* [make whole]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 19 [He shall deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee in six| strong="H8337" \w* \w troubles| strong="H6869" \w*: [yea, in seven]{strong=“H7651”} \w there shall no evil| strong="H7451" \w* [touch]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8799”} thee. 
\v 20 \w In famine| strong="H7458" \w* [he shall redeem]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8804”} \w thee from death| strong="H4194" \w*: \w and in war| strong="H4421" \w* \w from the power| strong="H3027" \w* \w of the sword| strong="H2719" \w*.\f + \fr 5:20 \ft power: Heb. hands \f* 
\v 21 [Thou shalt be hid]{strong=“H2244” x-morph=“strongMorph: \sc Th\sc*8735”} \w from the scourge| strong="H7752" \w* \w of the tongue| strong="H3956" \w*: [neither shalt thou be afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w of destruction| strong="H7701" \w* [when it cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 5:21 \ft from…: or, when the tongue scourgeth \f* 
\v 22 \w At destruction| strong="H7701" \w* \w and famine| strong="H3720" \w* [thou shalt laugh]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8799”}: [neither shalt thou be afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the beasts| strong="H2416" \w* \w of the earth| strong="H776" \w*. 
\v 23 \w For thou shalt be in league| strong="H1285" \w* \w with the stones| strong="H68" \w* \w of the field| strong="H7704" \w*: \w and the beasts| strong="H2416" \w* \w of the field| strong="H7704" \w* [shall be at peace]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8717”} with thee. 
\v 24 [And thou shalt know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w that thy tabernacle| strong="H168" \w* shall be \w in peace| strong="H7965" \w*; [and thou shalt visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8804”} \w thy habitation| strong="H5116" \w*, [and shalt not sin]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 5:24 \ft thy tabernacle…: or, peace is thy tabernacle \f* \f + \fr 5:24 \ft sin: or, err \f* 
\v 25 [Thou shalt know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w also that thy seed| strong="H2233" \w* shall be \w great| strong="H7227" \w*, \w and thine offspring| strong="H6631" \w* \w as the grass| strong="H6212" \w* \w of the earth| strong="H776" \w*.\f + \fr 5:25 \ft great: or, much \f* 
\v 26 [Thou shalt come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} to thy \w grave| strong="H6913" \w* \w in a full age| strong="H3624" \w*, \w like as a shock of corn| strong="H1430" \w* [cometh in]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8800”} \w in his season| strong="H6256" \w*.\f + \fr 5:26 \ft cometh in: Heb. ascendeth \f* 
\v 27 [Lo this, we have searched]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8804”} it, so it is; [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [it, and know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”} thou it for thy good.\f + \fr 5:27 \ft for…: Heb. for thyself \f*
\c 6
\p 
\v 1 \w But Job| strong="H347" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 \w Oh that| strong="H3863" \w* \w my grief| strong="H3708" \w* [were throughly]{strong=“H8254” x-morph=“strongMorph: \sc Th\sc*8800”} [weighed]{strong=“H8254” x-morph=“strongMorph: \sc Th\sc*8735”}, [and my calamity]{strong=“H1962 H1942” x-morph=“strongMorph: \sc Th\sc*8675”} [laid]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the balances| strong="H3976" \w* \w together| strong="H3162" \w*!\f + \fr 6:2 \ft laid: Heb. lifted up \f* 
\v 3 [For now it would be heavier]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8799”} \w than the sand| strong="H2344" \w* \w of the sea| strong="H3220" \w*: \w therefore my words| strong="H1697" \w* [are swallowed up]{strong=“H3886” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 6:3 \ft my words…: that is, I want words to express my grief \f* 
\v 4 \w For the arrows| strong="H2671" \w* \w of the Almighty| strong="H7706" \w* are \w within| strong="H5978" \w* [me, the poison]{strong=“H2534”} [whereof drinketh up]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8802”} \w my spirit| strong="H7307" \w*: \w the terrors| strong="H1161" \w* \w of God| strong="H433" \w* [do set themselves in array]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8799”} against me. 
\v 5 \w Doth the wild ass| strong="H6501" \w* [bray]{strong=“H5101” x-morph=“strongMorph: \sc Th\sc*8799”} \w when he hath grass| strong="H1877" \w*? [or loweth]{strong=“H1600” x-morph=“strongMorph: \sc Th\sc*8799”} \w the ox| strong="H7794" \w* \w over his fodder| strong="H1098" \w*?\f + \fr 6:5 \ft when he…: Heb. at grass? \f* 
\v 6 \w Can that which is unsavoury| strong="H8602" \w* [be eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8735”} \w without salt| strong="H4417" \w*? \w or is there| strong="H3426" \w* any \w taste| strong="H2940" \w* \w in the white| strong="H7388" \w* \w of an egg| strong="H2495" \w*? 
\v 7 The things that \w my soul| strong="H5315" \w* [refused]{strong=“H3985” x-morph=“strongMorph: \sc Th\sc*8765”} [to touch]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8800”} are \w as my sorrowful| strong="H1741" \w* \w meat| strong="H3899" \w*. 
\p
\v 8 [Oh that I might have]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w my request| strong="H7596" \w*; \w and that God| strong="H433" \w* [would grant]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} me \w the thing that I long for| strong="H8615" \w*!\f + \fr 6:8 \ft the thing…: Heb. my expectation \f* 
\v 9 [Even that it would please]{strong=“H2974” x-morph=“strongMorph: \sc Th\sc*8686”} \w God| strong="H433" \w* [to destroy]{strong=“H1792” x-morph=“strongMorph: \sc Th\sc*8762”} [me; that he would let loose]{strong=“H5425” x-morph=“strongMorph: \sc Th\sc*8686”} \w his hand| strong="H3027" \w*, [and cut me off]{strong=“H1214” x-morph=“strongMorph: \sc Th\sc*8762”}! 
\v 10 \w Then should I yet have comfort| strong="H5165" \w*; [yea, I would harden]{strong=“H5539” x-morph=“strongMorph: \sc Th\sc*8762”} \w myself in sorrow| strong="H2427" \w*: [let him not spare]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”}; [for I have not concealed]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8765”} \w the words| strong="H561" \w* \w of the Holy One| strong="H6918" \w*. 
\v 11 What is \w my strength| strong="H3581" \w*, [that I should hope]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8762”}? and what is \w mine end| strong="H7093" \w*, [that I should prolong]{strong=“H748” x-morph=“strongMorph: \sc Th\sc*8686”} \w my life| strong="H5315" \w*? 
\v 12 Is \w my strength| strong="H3581" \w* \w the strength| strong="H3581" \w* \w of stones| strong="H68" \w*? or is \w my flesh| strong="H1320" \w* \w of brass| strong="H5153" \w*?\f + \fr 6:12 \ft of brass: Heb. brasen? \f* 
\v 13 Is \w not my help| strong="H5833" \w* [in me? and is wisdom]{strong=“H8454”} [driven quite]{strong=“H5080” x-morph=“strongMorph: \sc Th\sc*8738”} from me? 
\p
\v 14 \w To him that is afflicted| strong="H4523" \w* \w pity| strong="H2617" \w* should be shewed \w from his friend| strong="H7453" \w*; [but he forsaketh]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w the fear| strong="H3374" \w* \w of the Almighty| strong="H7706" \w*.\f + \fr 6:14 \ft is afflicted: Heb. melteth \f* 
\v 15 \w My brethren| strong="H251" \w* [have dealt deceitfully]{strong=“H898” x-morph=“strongMorph: \sc Th\sc*8804”} \w as a brook| strong="H5158" \w*, and \w as the stream| strong="H650" \w* \w of brooks| strong="H5158" \w* [they pass away]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}; 
\v 16 [Which are blackish]{strong=“H6937” x-morph=“strongMorph: \sc Th\sc*8802”} \w by reason of the ice| strong="H7140" \w*, and \w wherein the snow| strong="H7950" \w* [is hid]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8691”}: 
\v 17 \w What time| strong="H6256" \w* [they wax warm]{strong=“H2215” x-morph=“strongMorph: \sc Th\sc*8792”}, [they vanish]{strong=“H6789” x-morph=“strongMorph: \sc Th\sc*8738”}: \w when it is hot| strong="H2527" \w*, [they are consumed out]{strong=“H1846” x-morph=“strongMorph: \sc Th\sc*8738”} \w of their place| strong="H4725" \w*.\f + \fr 6:17 \ft vanish: Heb. are cut off \f* \f + \fr 6:17 \ft when…: Heb. in the heat thereof \f* \f + \fr 6:17 \ft consumed: Heb. extinguished \f* 
\v 18 \w The paths| strong="H734" \w* \w of their way| strong="H1870" \w* [are turned aside]{strong=“H3943” x-morph=“strongMorph: \sc Th\sc*8735”}; [they go]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w to nothing| strong="H8414" \w*, [and perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 19 \w The troops| strong="H734" \w* \w of Tema| strong="H8485" \w* [looked]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8689”}, \w the companies| strong="H1979" \w* \w of Sheba| strong="H7614" \w* [waited]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8765”} for them. 
\v 20 [They were confounded]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8804”} [because they had hoped]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”}; [they came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [thither, and were ashamed]{strong=“H2659” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 21 [For now ye are nothing; ye see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} my \w casting down| strong="H2866" \w*, [and are afraid]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 6:21 \ft ye are…: or, ye are like to them: Heb. to it \f* \f + \fr 6:21 \ft nothing: Heb. not \f* 
\p
\v 22 [Did I say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [Bring]{strong=“H3051” x-morph=“strongMorph: \sc Th\sc*8798”} [unto me? or, Give a reward]{strong=“H7809” x-morph=“strongMorph: \sc Th\sc*8798”} \w for me of your substance| strong="H3581" \w*? 
\v 23 [Or, Deliver]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8761”} [me from the enemy’s]{strong=“H6862”} \w hand| strong="H3027" \w*? [or, Redeem]{strong=“H6299” x-morph=“strongMorph: \sc Th\sc*8799”} \w me from the hand| strong="H3027" \w* \w of the mighty| strong="H6184" \w*? 
\v 24 [Teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8685”} [me, and I will hold my tongue]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8686”}: [and cause me to understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8685”} [wherein I have erred]{strong=“H7686” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 25 [How forcible]{strong=“H4834” x-morph=“strongMorph: \sc Th\sc*8738”} \w are right| strong="H3476" \w* \w words| strong="H561" \w*! [but what doth your arguing]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8687”} [reprove]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”}? 
\v 26 [Do ye imagine]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8799”} [to reprove]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8687”} \w words| strong="H4405" \w*, \w and the speeches| strong="H561" \w* [of one that is desperate]{strong=“H2976” x-morph=“strongMorph: \sc Th\sc*8737”}, which are \w as wind| strong="H7307" \w*? 
\v 27 [Yea, ye overwhelm]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8686”} \w the fatherless| strong="H3490" \w*, [and ye dig]{strong=“H3738” x-morph=“strongMorph: \sc Th\sc*8799”} a pit \w for your friend| strong="H7453" \w*.\f + \fr 6:27 \ft ye overwhelm: Heb. ye cause to fall upon \f* 
\v 28 [Now therefore be content]{strong=“H2974” x-morph=“strongMorph: \sc Th\sc*8685”}, [look]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8798”} upon me; for it is \w evident| strong="H6440" \w* [unto you if I lie]{strong=“H3576” x-morph=“strongMorph: \sc Th\sc*8762”}.\f + \fr 6:28 \ft evident…: Heb. before your face \f* 
\v 29 [Return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”}, [I pray you, let it not be iniquity]{strong=“H5766”}; [yea, return again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8798”}, \w my righteousness| strong="H6664" \w* is in it.\f + \fr 6:29 \ft in it: that is, in this matter \f* 
\v 30 \w Is there| strong="H3426" \w* \w iniquity| strong="H5766" \w* \w in my tongue| strong="H3956" \w*? \w cannot my taste| strong="H2441" \w* [discern]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} \w perverse things| strong="H1942" \w*?\f + \fr 6:30 \ft my taste: Heb. my palate \f*
\c 7
\p 
\v 1 Is there \w not an appointed time| strong="H6635" \w* \w to man| strong="H582" \w* \w upon earth| strong="H776" \w*? are not \w his days| strong="H3117" \w* \w also like the days| strong="H3117" \w* \w of an hireling| strong="H7916" \w*?\f + \fr 7:1 \ft an appointed…: or, a warfare \f* 
\v 2 \w As a servant| strong="H5650" \w* [earnestly desireth]{strong=“H7602” x-morph=“strongMorph: \sc Th\sc*8799”} \w the shadow| strong="H6738" \w*, \w and as an hireling| strong="H7916" \w* [looketh]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8762”} for the reward of \w his work| strong="H6467" \w*:\f + \fr 7:2 \ft earnestly…: Heb. gapeth after \f* 
\v 3 [So am I made to possess]{strong=“H5157” x-morph=“strongMorph: \sc Th\sc*8717”} \w months| strong="H3391" \w* \w of vanity| strong="H7723" \w*, \w and wearisome| strong="H5999" \w* \w nights| strong="H3915" \w* [are appointed]{strong=“H4487” x-morph=“strongMorph: \sc Th\sc*8765”} to me. 
\v 4 [When I lie down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8804”}, [I say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [When shall I arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the night| strong="H6153" \w* \w be gone| strong="H4059" \w*? [and I am full]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8804”} \w of tossings to and fro| strong="H5076" \w* \w unto the dawning of the day| strong="H5399" \w*.\f + \fr 7:4 \ft the night…: Heb. the evening be measured? \f* 
\v 5 \w My flesh| strong="H1320" \w* [is clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8804”} \w with worms| strong="H7415" \w* \w and clods| strong="H1487" \w* \w of dust| strong="H6083" \w*; \w my skin| strong="H5785" \w* [is broken]{strong=“H7280” x-morph=“strongMorph: \sc Th\sc*8804”}, [and become loathsome]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 6 \w My days| strong="H3117" \w* [are swifter]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8804”} [than a weaver’s shuttle]{strong=“H708”}, [and are spent]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8799”} \w without| strong="H657" \w* \w hope| strong="H8615" \w*. 
\p
\v 7 [O remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”} \w that my life| strong="H2416" \w* is \w wind| strong="H7307" \w*: \w mine eye| strong="H5869" \w* [shall no more]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”} \w good| strong="H2896" \w*.\f + \fr 7:7 \ft shall…: Heb. shall not return \f* \f + \fr 7:7 \ft see: to see, that is, to enjoy \f* 
\v 8 \w The eye| strong="H5869" \w* \w of him that hath seen| strong="H7210" \w* [me shall see]{strong=“H7789” x-morph=“strongMorph: \sc Th\sc*8799”} me no more: \w thine eyes| strong="H5869" \w* are upon me, and I am not.\f + \fr 7:8 \ft I am…: that is, I can live no longer \f* 
\v 9 As \w the cloud| strong="H6051" \w* [is consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”} [and vanisheth away]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}: [so he that goeth down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8802”} \w to the grave| strong="H7585" \w* [shall come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} no more. 
\v 10 [He shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w no more to his house| strong="H1004" \w*, \w neither shall his place| strong="H4725" \w* [know]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8686”} him any more. 
\v 11 [Therefore I will not refrain]{strong=“H2820” x-morph=“strongMorph: \sc Th\sc*8799”} \w my mouth| strong="H6310" \w*; [I will speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w in the anguish| strong="H6862" \w* \w of my spirit| strong="H7307" \w*; [I will complain]{strong=“H7878” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the bitterness| strong="H4751" \w* \w of my soul| strong="H5315" \w*. 
\v 12 Am \w I a sea| strong="H3220" \w*, \w or a whale| strong="H8577" \w*, [that thou settest]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w a watch| strong="H4929" \w* over me? 
\v 13 [When I say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w My bed| strong="H6210" \w* [shall comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8762”} [me, my couch]{strong=“H4904”} [shall ease]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w my complaint| strong="H7879" \w*; 
\v 14 [Then thou scarest]{strong=“H2865” x-morph=“strongMorph: \sc Th\sc*8765”} \w me with dreams| strong="H2472" \w*, [and terrifiest]{strong=“H1204” x-morph=“strongMorph: \sc Th\sc*8762”} \w me through visions| strong="H2384" \w*: 
\v 15 \w So that my soul| strong="H5315" \w* [chooseth]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} \w strangling| strong="H4267" \w*, and \w death| strong="H4194" \w* \w rather than my life| strong="H6106" \w*.\f + \fr 7:15 \ft life: Heb. bones \f* 
\v 16 [I loathe]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} it; [I would not live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”} \w alway| strong="H5769" \w*: [let me alone]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8798”}; \w for my days| strong="H3117" \w* are \w vanity| strong="H1892" \w*. 
\p
\v 17 What is \w man| strong="H582" \w*, [that thou shouldest magnify]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8762”} [him? and that thou shouldest set]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w thine heart| strong="H3820" \w* upon him? 
\v 18 And that [thou shouldest visit]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} \w him every morning| strong="H1242" \w*, and [try]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8799”} \w him every moment| strong="H7281" \w*? 
\v 19 \w How long| strong="H4100" \w* [wilt thou not depart]{strong=“H8159” x-morph=“strongMorph: \sc Th\sc*8799”} [from me, nor let me alone]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8686”} [till I swallow down]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8800”} \w my spittle| strong="H7536" \w*? 
\v 20 [I have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}; [what shall I do]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee, O thou preserver]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8802”} \w of men| strong="H120" \w*? [why hast thou set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w me as a mark| strong="H4645" \w* [against thee, so that I am a burden]{strong=“H4853”} to myself? 
\v 21 [And why dost thou not pardon]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w my transgression| strong="H6588" \w*, [and take away]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8686”} \w mine iniquity| strong="H5771" \w*? [for now shall I sleep]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the dust| strong="H6083" \w*; [and thou shalt seek me in the morning]{strong=“H7836” x-morph=“strongMorph: \sc Th\sc*8765”}, but I shall not be. 
\c 8
\p 
\v 1 [Then answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w Bildad| strong="H1085" \w* \w the Shuhite| strong="H7747" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 \w How| strong="H575" \w* \w long| strong="H5704" \w* [wilt thou speak]{strong=“H4448” x-morph=“strongMorph: \sc Th\sc*8762”} these things? and how long shall \w the words| strong="H561" \w* \w of thy mouth| strong="H6310" \w* be like \w a strong| strong="H3524" \w* \w wind| strong="H7307" \w*? 
\v 3 \w Doth God| strong="H410" \w* [pervert]{strong=“H5791” x-morph=“strongMorph: \sc Th\sc*8762”} \w judgment| strong="H4941" \w*? \w or doth the Almighty| strong="H7706" \w* [pervert]{strong=“H5791” x-morph=“strongMorph: \sc Th\sc*8762”} \w justice| strong="H6664" \w*? 
\v 4 \w If thy children| strong="H1121" \w* [have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”} [against him, and he have cast them away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w for| strong="H3027" \w* \w their transgression| strong="H6588" \w*;\f + \fr 8:4 \ft for…: Heb. in the hand of their transgression \f* 
\v 5 \w If thou wouldest seek| strong="H7836" \w* \w unto God| strong="H410" \w* [betimes]{strong=“H7836” x-morph=“strongMorph: \sc Th\sc*8762”}, [and make thy supplication]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8691”} \w to the Almighty| strong="H7706" \w*; 
\v 6 If thou wert \w pure| strong="H2134" \w* \w and upright| strong="H3477" \w*; [surely now he would awake]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8686”} [for thee, and make the habitation]{strong=“H5116”} \w of thy righteousness| strong="H6664" \w* [prosperous]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8765”}. 
\v 7 \w Though thy beginning| strong="H7225" \w* \w was small| strong="H4705" \w*, \w yet thy latter end| strong="H319" \w* \w should greatly| strong="H3966" \w* [increase]{strong=“H7685” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 8 [For enquire]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8798”}, [I pray thee, of the former]{strong=“H7223 H7223” x-morph=“strongMorph: \sc Th\sc*8675”} \w age| strong="H1755" \w*, [and prepare]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8786”} \w thyself to the search| strong="H2714" \w* \w of their fathers| strong="H1" \w*: 
\v 9 (For we are but of \w yesterday| strong="H8543" \w*, [and know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} [nothing, because our days]{strong=“H3117”} \w upon earth| strong="H776" \w* are \w a shadow| strong="H6738" \w*:)\f + \fr 8:9 \ft nothing: Heb. not \f* 
\v 10 [Shall not they teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”} thee, and [tell]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [thee, and utter]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w words| strong="H4405" \w* \w out of their heart| strong="H3820" \w*? 
\v 11 \w Can the rush| strong="H1573" \w* [grow up]{strong=“H1342” x-morph=“strongMorph: \sc Th\sc*8799”} \w without mire| strong="H1207" \w*? \w can| strong="H7685" \w* \w the flag| strong="H260" \w* [grow]{strong=“H7685” x-morph=“strongMorph: \sc Th\sc*8799”} \w without| strong="H1097" \w* \w water| strong="H4325" \w*? 
\v 12 Whilst it is \w yet in his greenness| strong="H3" \w*, and [not cut down]{strong=“H6998” x-morph=“strongMorph: \sc Th\sc*8735”}, [it withereth]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* any other \w herb| strong="H2682" \w*. 
\v 13 So are \w the paths| strong="H734" \w* [of all that forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8802”} \w God| strong="H410" \w*; [and the hypocrite’s]{strong=“H2611”} \w hope| strong="H8615" \w* [shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”}: 
\v 14 \w Whose hope| strong="H3689" \w* [shall be cut off]{strong=“H6990” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and whose trust| strong="H4009" \w* shall be [a spider’s]{strong=“H5908”} \w web| strong="H1004" \w*.\f + \fr 8:14 \ft web: Heb. house \f* 
\v 15 [He shall lean]{strong=“H8172” x-morph=“strongMorph: \sc Th\sc*8735”} \w upon his house| strong="H1004" \w*, [but it shall not stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”}: [he shall hold]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8686”} [it fast, but it shall not endure]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 16 He is \w green| strong="H7373" \w* \w before| strong="H6440" \w* \w the sun| strong="H8121" \w*, \w and his branch| strong="H3127" \w* [shooteth forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his garden| strong="H1593" \w*. 
\v 17 \w His roots| strong="H8328" \w* [are wrapped about]{strong=“H5440” x-morph=“strongMorph: \sc Th\sc*8792”} \w the heap| strong="H1530" \w*, and [seeth]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8799”} \w the place| strong="H1004" \w* \w of stones| strong="H68" \w*. 
\v 18 [If he destroy]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8762”} \w him from his place| strong="H4725" \w*, then it [shall deny]{strong=“H3584” x-morph=“strongMorph: \sc Th\sc*8765”} him, saying, [I have not seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} thee. 
\v 19 Behold, this is \w the joy| strong="H4885" \w* \w of his way| strong="H1870" \w*, \w and out of the earth| strong="H6083" \w* \w shall others| strong="H312" \w* [grow]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 20 [Behold, God]{strong=“H410”} [will not cast away]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8799”} \w a perfect| strong="H8535" \w* man, [neither will he help]{strong=“H3027 H2388” x-morph=“strongMorph: \sc Th\sc*8686”} [the evil doers]{strong=“H7489” x-morph=“strongMorph: \sc Th\sc*8688”}:\f + \fr 8:20 \ft help…: Heb. take the ungodly by the hand \f* \f + \fr 8:20 \ft come: Heb. shall not be \f* 
\v 21 [Till he fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy mouth| strong="H6310" \w* \w with laughing| strong="H7814" \w*, \w and thy lips| strong="H8193" \w* \w with rejoicing| strong="H8643" \w*.\f + \fr 8:21 \ft rejoicing: Heb. shouting for joy \f* 
\v 22 [They that hate]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8802”} [thee shall be clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} \w with shame| strong="H1322" \w*; \w and the dwelling| strong="H168" \w* \w place of the wicked| strong="H7563" \w* \w shall come to nought| strong="H369" \w*.\f + \fr 8:22 \ft shall come…: Heb. shall not be \f*
\c 9
\p 
\v 1 \w Then Job| strong="H347" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 [I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} it is \w so of a truth| strong="H551" \w*: \w but how should man| strong="H582" \w* [be just]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8799”} \w with God| strong="H410" \w*?\f + \fr 9:2 \ft with God: or, before God? \f* 
\v 3 [If he will]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8799”} [contend]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8800”} [with him, he cannot answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w him one| strong="H259" \w* \w of a thousand| strong="H505" \w*. 
\v 4 He is \w wise| strong="H2450" \w* \w in heart| strong="H3824" \w*, \w and mighty| strong="H533" \w* \w in strength| strong="H3581" \w*: [who hath hardened]{strong=“H7185” x-morph=“strongMorph: \sc Th\sc*8689”} himself [against him, and hath prospered]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8799”}? 
\v 5 [Which removeth]{strong=“H6275” x-morph=“strongMorph: \sc Th\sc*8688”} \w the mountains| strong="H2022" \w*, [and they know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [not: which overturneth]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8804”} \w them in his anger| strong="H639" \w*. 
\v 6 [Which shaketh]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8688”} \w the earth| strong="H776" \w* \w out of her place| strong="H4725" \w*, \w and the pillars| strong="H5982" \w* [thereof tremble]{strong=“H6426” x-morph=“strongMorph: \sc Th\sc*8691”}. 
\v 7 [Which commandeth]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} \w the sun| strong="H2775" \w*, [and it riseth]{strong=“H2224” x-morph=“strongMorph: \sc Th\sc*8799”} [not; and sealeth up]{strong=“H2856” x-morph=“strongMorph: \sc Th\sc*8799”} \w the stars| strong="H3556" \w*. 
\v 8 [Which alone spreadeth out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8802”} \w the heavens| strong="H8064" \w*, [and treadeth]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon the waves| strong="H1116" \w* \w of the sea| strong="H3220" \w*.\f + \fr 9:8 \ft waves: Heb. heights \f* 
\v 9 [Which maketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w Arcturus| strong="H5906" \w*, \w Orion| strong="H3685" \w*, \w and Pleiades| strong="H3598" \w*, \w and the chambers| strong="H2315" \w* \w of the south| strong="H8486" \w*.\f + \fr 9:9 \ft Arcturus…: Heb. Ash, Cesil, and Cimah \f* 
\v 10 [Which doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w great things| strong="H1419" \w* \w past| strong="H369" \w* \w finding out| strong="H2714" \w*; [yea, and wonders]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8737”} \w without number| strong="H4557" \w*. 
\v 11 [Lo, he goeth]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} [by me, and I see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} him [not: he passeth on]{strong=“H2498” x-morph=“strongMorph: \sc Th\sc*8799”} [also, but I perceive]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} him not. 
\v 12 [Behold, he taketh away]{strong=“H2862” x-morph=“strongMorph: \sc Th\sc*8799”}, [who can hinder]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} [him? who will say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, What doest]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} thou?\f + \fr 9:12 \ft hinder…: Heb. turn him away? \f* 
\v 13 If \w God| strong="H433" \w* [will not withdraw]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w his anger| strong="H639" \w*, \w the proud| strong="H7293" \w* [helpers]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8802”} [do stoop]{strong=“H7817” x-morph=“strongMorph: \sc Th\sc*8804”} under him.\f + \fr 9:13 \ft proud…: Heb. helpers of pride, or, strength \f* 
\p
\v 14 [How much less shall I answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} him, and [choose out]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} \w my words| strong="H1697" \w* to reason with him? 
\v 15 [Whom, though I were righteous]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8804”}, yet [would I not answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”}, but [I would make supplication]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8691”} [to my judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8781”}. 
\v 16 [If I had called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”}, [and he had answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} me; yet [would I not believe]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”} [that he had hearkened]{strong=“H238” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto my voice| strong="H6963" \w*. 
\v 17 [For he breaketh]{strong=“H7779” x-morph=“strongMorph: \sc Th\sc*8799”} \w me with a tempest| strong="H8183" \w*, [and multiplieth]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8689”} \w my wounds| strong="H6482" \w* \w without cause| strong="H2600" \w*. 
\v 18 [He will not suffer]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [me to take]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8687”} \w my breath| strong="H7307" \w*, [but filleth]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8686”} \w me with bitterness| strong="H4472" \w*. 
\v 19 If I speak \w of strength| strong="H3581" \w*, lo, he is \w strong| strong="H533" \w*: \w and if of judgment| strong="H4941" \w*, [who shall set]{strong=“H3259” x-morph=“strongMorph: \sc Th\sc*8686”} me a time to plead? 
\v 20 [If I justify]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8799”} [myself, mine own mouth]{strong=“H6310”} [shall condemn]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8686”} me: if I say, I am \w perfect| strong="H8535" \w*, [it shall also prove me perverse]{strong=“H6140” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 21 Though I were \w perfect| strong="H8535" \w*, yet [would I not know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w my soul| strong="H5315" \w*: [I would despise]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8799”} \w my life| strong="H2416" \w*. 
\p
\v 22 This is \w one| strong="H259" \w* thing, [therefore I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} it, [He destroyeth]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8764”} \w the perfect| strong="H8535" \w* \w and the wicked| strong="H7563" \w*. 
\v 23 \w If the scourge| strong="H7752" \w* [slay]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8686”} \w suddenly| strong="H6597" \w*, [he will laugh]{strong=“H3932” x-morph=“strongMorph: \sc Th\sc*8799”} \w at the trial| strong="H4531" \w* \w of the innocent| strong="H5355" \w*. 
\v 24 \w The earth| strong="H776" \w* [is given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”} \w into the hand| strong="H3027" \w* \w of the wicked| strong="H7563" \w*: [he covereth]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w the faces| strong="H6440" \w* [of the judges]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} [thereof; if not, where]{strong=“H645”}, and who is he? 
\p
\v 25 \w Now my days| strong="H3117" \w* [are swifter]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8804”} [than a post]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8801”}: [they flee away]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8804”}, [they see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w no good| strong="H2896" \w*. 
\v 26 [They are passed away]{strong=“H2498” x-morph=“strongMorph: \sc Th\sc*8804”} \w as| strong="H5973" \w* \w the swift| strong="H16" \w* \w ships| strong="H591" \w*: \w as the eagle| strong="H5404" \w* that [hasteth]{strong=“H2907” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the prey| strong="H400" \w*.\f + \fr 9:26 \ft swift…: or, ships of Ebeh: Heb. ships of desire \f* 
\v 27 [If I say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [I will forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} \w my complaint| strong="H7879" \w*, [I will leave off]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w my heaviness| strong="H6440" \w*, [and comfort]{strong=“H1082” x-morph=“strongMorph: \sc Th\sc*8686”} myself: 
\v 28 [I am afraid]{strong=“H3025” x-morph=“strongMorph: \sc Th\sc*8804”} \w of all my sorrows| strong="H6094" \w*, [I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [that thou wilt not hold me innocent]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 29 If [I be wicked]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8799”}, [why then labour]{strong=“H3021” x-morph=“strongMorph: \sc Th\sc*8799”} \w I in vain| strong="H1892" \w*? 
\v 30 [If I wash]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8694”} \w myself with| strong="H7950" \w* [snow water]{strong=“H1119 H4325”}, \w and make my hands| strong="H3709" \w* [never]{strong=“H1253 H1252” x-morph=“strongMorph: \sc Th\sc*8676”} [so clean]{strong=“H2141” x-morph=“strongMorph: \sc Th\sc*8689”}; 
\v 31 \w Yet| strong="H227" \w* [shalt thou plunge]{strong=“H2881” x-morph=“strongMorph: \sc Th\sc*8799”} \w me in the ditch| strong="H7845" \w*, \w and mine own clothes| strong="H8008" \w* [shall abhor]{strong=“H8581” x-morph=“strongMorph: \sc Th\sc*8765”} me.\f + \fr 9:31 \ft abhor…: or, make me to be abhorred \f* 
\v 32 For he is \w not a man| strong="H376" \w*, as I am, that [I should answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} him, and [we should come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w together| strong="H3162" \w* \w in judgment| strong="H4941" \w*. 
\v 33 \w Neither is| strong="H3426" \w* [there any daysman]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8688”} betwixt us, that [might lay]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w his hand| strong="H3027" \w* \w upon us both| strong="H8147" \w*.\f + \fr 9:33 \ft any…: Heb. one that should argue \f* \f + \fr 9:33 \ft daysman: or, umpire \f* 
\v 34 \w Let him take| strong="H5493" \w* \w his rod| strong="H7626" \w* [away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8686”} [from me, and let not his fear]{strong=“H367”} [terrify ]{strong=“H1204” x-morph=“strongMorph: \sc Th\sc*8762”} me: 
\v 35 Then [would I speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}, [and not fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”} him; but it is not so with me.\f + \fr 9:35 \ft it is…: Heb. I am not so with myself \f*
\c 10
\p 
\v 1 \w My soul| strong="H5315" \w* [is weary]{strong=“H5354” x-morph=“strongMorph: \sc Th\sc*8804”} \w of my life| strong="H2416" \w*; [I will leave]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} \w my complaint| strong="H7879" \w* [upon myself; I will speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w in the bitterness| strong="H4751" \w* \w of my soul| strong="H5315" \w*.\f + \fr 10:1 \ft weary…: or, cut off while I live \f* 
\v 2 [I will say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto God| strong="H433" \w*, [Do not condemn]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8686”} [me; shew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8685”} [me wherefore thou contendest]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”} with me. 
\v 3 Is it [good]{strong=“H2895” x-morph=“strongMorph: \sc Th\sc*8804”} [unto thee that thou shouldest oppress]{strong=“H6231” x-morph=“strongMorph: \sc Th\sc*8799”}, [that thou shouldest despise]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8799”} \w the work| strong="H3018" \w* \w of thine hands| strong="H3709" \w*, [and shine]{strong=“H3313” x-morph=“strongMorph: \sc Th\sc*8689”} \w upon the counsel| strong="H6098" \w* \w of the wicked| strong="H7563" \w*?\f + \fr 10:3 \ft work: Heb. labour \f* 
\v 4 \w Hast thou eyes| strong="H5869" \w* \w of flesh| strong="H1320" \w*? [or seest]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w thou as man| strong="H582" \w* [seeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8800”}? 
\v 5 Are \w thy days| strong="H3117" \w* \w as the days| strong="H3117" \w* \w of man| strong="H582" \w*? are \w thy years| strong="H8141" \w* [as man’s]{strong=“H1397”} \w days| strong="H3117" \w*, 
\v 6 [That thou enquirest]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8762”} \w after mine iniquity| strong="H5771" \w*, [and searchest]{strong=“H1875” x-morph=“strongMorph: \sc Th\sc*8799”} \w after my sin| strong="H2403" \w*? 
\v 7 \w Thou knowest| strong="H1847" \w* [that I am not wicked]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8799”}; and there is [none that can deliver]{strong=“H5337” x-morph=“strongMorph: \sc Th\sc*8688”} \w out of thine hand| strong="H3027" \w*.\f + \fr 10:7 \ft Thou…: Heb. It is upon thy knowledge \f* 
\p
\v 8 \w Thine hands| strong="H3027" \w* [have made]{strong=“H6087” x-morph=“strongMorph: \sc Th\sc*8765”} [me and fashioned]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w me together| strong="H3162" \w* \w round about| strong="H5439" \w*; [yet thou dost destroy]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8762”} me.\f + \fr 10:8 \ft have…: Heb. took pains about me \f* 
\v 9 [Remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8798”}, [I beseech thee, that thou hast made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w me as the clay| strong="H2563" \w*; \w and wilt thou bring| strong="H7725" \w* \w me into dust| strong="H6083" \w* [again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”}? 
\v 10 [Hast thou not poured me out]{strong=“H5413” x-morph=“strongMorph: \sc Th\sc*8686”} \w as milk| strong="H2461" \w*, [and curdled]{strong=“H7087” x-morph=“strongMorph: \sc Th\sc*8686”} \w me like cheese| strong="H1385" \w*? 
\v 11 [Thou hast clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8686”} \w me with skin| strong="H5785" \w* \w and flesh| strong="H1320" \w*, [and hast fenced]{strong=“H7753” x-morph=“strongMorph: \sc Th\sc*8787”} \w me with bones| strong="H6106" \w* \w and sinews| strong="H1517" \w*.\f + \fr 10:11 \ft fenced: Heb. hedged \f* 
\v 12 [Thou hast granted]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w me life| strong="H2416" \w* \w and favour| strong="H2617" \w*, \w and thy visitation| strong="H6486" \w* [hath preserved]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w my spirit| strong="H7307" \w*. 
\v 13 And these things [hast thou hid]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8804”} \w in thine heart| strong="H3824" \w*: [I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that this is with thee. 
\p
\v 14 [If I sin]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}, [then thou markest]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and thou wilt not acquit]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8762”} \w me from mine iniquity| strong="H5771" \w*. 
\v 15 [If I be wicked]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8804”}, \w woe| strong="H480" \w* unto me; and if [I be righteous]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8804”}, yet [will I not lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w my head| strong="H7218" \w*. I am \w full| strong="H7649" \w* \w of confusion| strong="H7036" \w*; [therefore see]{strong=“H7200 H7202” x-morph=“strongMorph: \sc Th\sc*8798 strongMorph: \sc Th\sc*8676 strongMorph: \sc Th\sc*8798”} \w thou mine affliction| strong="H6040" \w*; 
\v 16 [For it increaseth]{strong=“H1342” x-morph=“strongMorph: \sc Th\sc*8799”}. [Thou huntest]{strong=“H6679” x-morph=“strongMorph: \sc Th\sc*8799”} \w me as a fierce lion| strong="H7826" \w*: [and again]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} [thou shewest thyself marvellous]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8691”} upon me. 
\v 17 [Thou renewest]{strong=“H2318” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy witnesses| strong="H5707" \w* [against me, and increasest]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} \w thine indignation| strong="H3708" \w* \w upon me| strong="H5978" \w*; \w changes| strong="H2487" \w* \w and war| strong="H6635" \w* are against me.\f + \fr 10:17 \ft witnesses: that is, plagues \f* 
\v 18 [Wherefore then hast thou brought me forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w out of the womb| strong="H7358" \w*? [Oh that I had given up the ghost]{strong=“H1478” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and no eye| strong="H5869" \w* [had seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} me! 
\v 19 [I should have been as though I had not been; I should have been carried]{strong=“H2986” x-morph=“strongMorph: \sc Th\sc*8714”} \w from the womb| strong="H990" \w* \w to the grave| strong="H6913" \w*. 
\v 20 Are \w not my days| strong="H3117" \w* \w few| strong="H4592" \w*? [cease]{strong=“H2308 H2308” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8798”} then, and [let me alone]{strong=“H7896 H7896” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8798”}, [that I may take comfort]{strong=“H1082” x-morph=“strongMorph: \sc Th\sc*8686”} \w a little| strong="H4592" \w*, 
\v 21 [Before I go]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} whence [I shall not return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, even \w to the land| strong="H776" \w* \w of darkness| strong="H2822" \w* \w and the shadow of death| strong="H6757" \w*; 
\v 22 \w A land| strong="H776" \w* \w of darkness| strong="H5890" \w*, \w as darkness| strong="H652" \w* itself; and \w of the shadow of death| strong="H6757" \w*, \w without any order| strong="H5468" \w*, and where [the light]{strong=“H3313” x-morph=“strongMorph: \sc Th\sc*8686”} is \w as darkness| strong="H652" \w*.
\c 11
\p 
\v 1 [Then answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w Zophar| strong="H6691" \w* \w the Naamathite| strong="H5284" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 \w Should not the multitude| strong="H7230" \w* \w of words| strong="H1697" \w* [be answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8735”}? \w and should a man| strong="H376" \w* \w full of talk| strong="H8193" \w* [be justified]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8799”}?\f + \fr 11:2 \ft full…: Heb. of lips \f* 
\v 3 \w Should thy lies| strong="H907" \w* \w make| strong="H2790" \w* \w men| strong="H4962" \w* [hold their peace]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8686”}? [and when thou mockest]{strong=“H3932” x-morph=“strongMorph: \sc Th\sc*8799”}, [shall no man make thee ashamed]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8688”}?\f + \fr 11:3 \ft lies: or, devices \f* 
\v 4 [For thou hast said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w My doctrine| strong="H3948" \w* is \w pure| strong="H2134" \w*, \w and I am clean| strong="H1249" \w* \w in thine eyes| strong="H5869" \w*. 
\v 5 \w But| strong="H199" \w* [oh that]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w God| strong="H433" \w* [would speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”}, [and open]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8799”} \w his lips| strong="H8193" \w* against thee; 
\v 6 [And that he would shew]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee the secrets| strong="H8587" \w* \w of wisdom| strong="H2451" \w*, that they are \w double| strong="H3718" \w* \w to that which is| strong="H8454" \w*! [Know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”} \w therefore that God| strong="H433" \w* [exacteth]{strong=“H5382” x-morph=“strongMorph: \sc Th\sc*8686”} of thee less \w than thine iniquity| strong="H5771" \w* deserveth. 
\p
\v 7 \w Canst thou by searching| strong="H2714" \w* [find out]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w God| strong="H433" \w*? [canst thou find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} \w out the Almighty| strong="H7706" \w* \w unto perfection| strong="H8503" \w*? 
\v 8 It is \w as high| strong="H1363" \w* \w as heaven| strong="H8064" \w*; [what canst thou do]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8799”}? \w deeper| strong="H6013" \w* \w than hell| strong="H7585" \w*; [what canst thou know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”}?\f + \fr 11:8 \ft as high…: Heb. the heights of heaven \f* 
\v 9 \w The measure| strong="H4055" \w* thereof is \w longer| strong="H752" \w* \w than the earth| strong="H776" \w*, \w and broader| strong="H7342" \w* \w than the sea| strong="H3220" \w*. 
\v 10 [If he cut off]{strong=“H2498” x-morph=“strongMorph: \sc Th\sc*8799”}, [and shut up]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8686”}, [or gather together]{strong=“H6950” x-morph=“strongMorph: \sc Th\sc*8686”}, [then who can hinder]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} him?\f + \fr 11:10 \ft cut…: or, make a change \f* \f + \fr 11:10 \ft hinder…: Heb. turn him away? \f* 
\v 11 [For he knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w vain| strong="H7723" \w* \w men| strong="H4962" \w*: [he seeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w wickedness| strong="H205" \w* [also; will he not then consider]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8709”} it? 
\v 12 [For vain]{strong=“H5014” x-morph=“strongMorph: \sc Th\sc*8803”} \w man| strong="H376" \w* [would be wise]{strong=“H3823” x-morph=“strongMorph: \sc Th\sc*8735”}, \w though man| strong="H120" \w* [be born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8735”} like [a wild ass’s]{strong=“H6501”} \w colt| strong="H5895" \w*.\f + \fr 11:12 \ft vain: Heb. empty \f* 
\p
\v 13 [If thou prepare]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8689”} \w thine heart| strong="H3820" \w*, [and stretch]{strong=“H6566” x-morph=“strongMorph: \sc Th\sc*8804”} \w out thine hands| strong="H3709" \w* toward him; 
\v 14 \w If iniquity| strong="H205" \w* be \w in thine hand| strong="H3027" \w*, [put it far away]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8685”}, \w and let not wickedness| strong="H5766" \w* [dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8686”} \w in thy tabernacles| strong="H168" \w*. 
\v 15 [For then shalt thou lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy face| strong="H6440" \w* \w without spot| strong="H3971" \w*; [yea, thou shalt be stedfast]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8716”}, [and shalt not fear]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8799”}: 
\v 16 [Because thou shalt forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} thy \w misery| strong="H5999" \w*, and [remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} it \w as waters| strong="H4325" \w* that [pass away]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”}: 
\v 17 And thine \w age| strong="H2465" \w* [shall be clearer]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w than the noonday| strong="H6672" \w*; [thou shalt shine forth]{strong=“H5774” x-morph=“strongMorph: \sc Th\sc*8799”}, \w thou shalt be as the morning| strong="H1242" \w*.\f + \fr 11:17 \ft be clearer…: Heb. arise above \f* 
\v 18 [And thou shalt be secure]{strong=“H982” x-morph=“strongMorph: \sc Th\sc*8804”}, \w because there is| strong="H3426" \w* \w hope| strong="H8615" \w*; [yea, thou shalt dig]{strong=“H2658” x-morph=“strongMorph: \sc Th\sc*8804”} about thee, and [thou shalt take thy rest]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w in safety| strong="H983" \w*. 
\v 19 [Also thou shalt lie down]{strong=“H7257” x-morph=“strongMorph: \sc Th\sc*8804”}, and none shall make thee [afraid]{strong=“H2729” x-morph=“strongMorph: \sc Th\sc*8688”}; [yea, many]{strong=“H7227”} [shall make suit]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto thee| strong="H6440" \w*.\f + \fr 11:19 \ft make suit…: Heb. intreat thy face \f* 
\v 20 \w But the eyes| strong="H5869" \w* \w of the wicked| strong="H7563" \w* [shall fail]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8799”}, [and they shall not escape]{strong=“H4498 H6” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and their hope| strong="H8615" \w* shall be as \w the giving up| strong="H4646" \w* \w of the ghost| strong="H5315" \w*.\f + \fr 11:20 \ft they shall…: Heb. flight shall perish from them \f* \f + \fr 11:20 \ft the giving…: or, a puff of breath \f*
\c 12
\p 
\v 1 \w And Job| strong="H347" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 \w No doubt| strong="H551" \w* but ye are \w the people| strong="H5971" \w*, \w and wisdom| strong="H2451" \w* [shall die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} with you. 
\v 3 \w But| strong="H1571" \w* \w I have understanding| strong="H3824" \w* as well as you; I am [not inferior]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8802”} [to you: yea, who knoweth not such things]{strong=“H3644”} as these?\f + \fr 12:3 \ft understanding: Heb. an heart \f* \f + \fr 12:3 \ft I am…: Heb. I fall not lower than you \f* \f + \fr 12:3 \ft who…: Heb. with whom are not such as these? \f* 
\v 4 I am as \w one mocked| strong="H7814" \w* \w of his neighbour| strong="H7453" \w*, [who calleth]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8802”} \w upon God| strong="H433" \w*, [and he answereth]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [him: the just]{strong=“H6662”} \w upright| strong="H8549" \w* man is \w laughed to scorn| strong="H7814" \w*. 
\v 5 [He that is ready]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8737”} [to slip]{strong=“H4571” x-morph=“strongMorph: \sc Th\sc*8802”} with his \w feet| strong="H7272" \w* is as \w a lamp| strong="H3940" \w* \w despised| strong="H937" \w* \w in the thought| strong="H6248" \w* \w of him that is at ease| strong="H7600" \w*. 
\p
\v 6 \w The tabernacles| strong="H168" \w* [of robbers]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8802”} [prosper]{strong=“H7951” x-morph=“strongMorph: \sc Th\sc*8799”}, [and they that provoke]{strong=“H7264” x-morph=“strongMorph: \sc Th\sc*8688”} \w God| strong="H410" \w* \w are secure| strong="H987" \w*; \w into whose hand| strong="H3027" \w* \w God| strong="H433" \w* [bringeth]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8689”} abundantly. 
\v 7 \w But| strong="H199" \w* [ask]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8798”} \w now the beasts| strong="H929" \w*, [and they shall teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”} [thee; and the fowls]{strong=“H5775”} \w of the air| strong="H8064" \w*, [and they shall tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} thee: 
\v 8 [Or speak]{strong=“H7878” x-morph=“strongMorph: \sc Th\sc*8798”} \w to the earth| strong="H776" \w*, [and it shall teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”} [thee: and the fishes]{strong=“H1709”} \w of the sea| strong="H3220" \w* [shall declare]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} unto thee. 
\v 9 [Who knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w not in all these that the hand| strong="H3027" \w* of the \sc Lord\sc* [hath wrought]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} this? 
\v 10 \w In whose hand| strong="H3027" \w* is \w the soul| strong="H5315" \w* \w of every living thing| strong="H2416" \w*, \w and the breath| strong="H7307" \w* [of all mankind]{strong=“H1320 H376”}.\f + \fr 12:10 \ft soul: or, life \f* \f + \fr 12:10 \ft all…: Heb. all flesh of man \f* 
\v 11 \w Doth not the ear| strong="H241" \w* [try]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8799”} \w words| strong="H4405" \w*? \w and the mouth| strong="H2441" \w* [taste]{strong=“H2938” x-morph=“strongMorph: \sc Th\sc*8799”} \w his meat| strong="H400" \w*?\f + \fr 12:11 \ft mouth: Heb. palate \f* 
\p
\v 12 \w With the ancient| strong="H3453" \w* is \w wisdom| strong="H2451" \w*; \w and in length| strong="H753" \w* \w of days| strong="H3117" \w* \w understanding| strong="H8394" \w*. 
\v 13 With him is \w wisdom| strong="H2451" \w* \w and strength| strong="H1369" \w*, \w he hath counsel| strong="H6098" \w* \w and understanding| strong="H8394" \w*.\f + \fr 12:13 \ft With…: that is, With God \f* 
\v 14 [Behold, he breaketh down]{strong=“H2040” x-morph=“strongMorph: \sc Th\sc*8799”}, [and it cannot be built again]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8735”}: [he shutteth up]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8799”} \w a man| strong="H376" \w*, [and there can be no opening]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8735”}.\f + \fr 12:14 \ft up: Heb. upon \f* 
\v 15 [Behold, he withholdeth]{strong=“H6113” x-morph=“strongMorph: \sc Th\sc*8799”} \w the waters| strong="H4325" \w*, [and they dry up]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8799”}: [also he sendeth them out]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”}, [and they overturn]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8799”} \w the earth| strong="H776" \w*. 
\v 16 With him is \w strength| strong="H5797" \w* \w and wisdom| strong="H8454" \w*: [the deceived]{strong=“H7683” x-morph=“strongMorph: \sc Th\sc*8802”} [and the deceiver]{strong=“H7686” x-morph=“strongMorph: \sc Th\sc*8688”} are his. 
\v 17 [He leadeth]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8688”} [counsellors]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8802”} \w away spoiled| strong="H7758" \w*, [and maketh the judges]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} [fools]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8779”}. 
\v 18 [He looseth]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8765”} \w the bond| strong="H4148" \w* \w of kings| strong="H4428" \w*, [and girdeth]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8799”} \w their loins| strong="H4975" \w* \w with a girdle| strong="H232" \w*. 
\v 19 [He leadeth]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8688”} \w princes| strong="H3548" \w* \w away spoiled| strong="H7758" \w*, [and overthroweth]{strong=“H5557” x-morph=“strongMorph: \sc Th\sc*8762”} \w the mighty| strong="H386" \w*. 
\v 20 [He removeth away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8688”} \w the speech| strong="H8193" \w* [of the trusty]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8737”}, [and taketh away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w the understanding| strong="H2940" \w* \w of the aged| strong="H2205" \w*.\f + \fr 12:20 \ft speech…: Heb. lip of the faithful \f* 
\v 21 [He poureth]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8802”} \w contempt| strong="H937" \w* \w upon princes| strong="H5081" \w*, [and weakeneth]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8765”} \w the strength| strong="H4206" \w* \w of the mighty| strong="H650" \w*.\f + \fr 12:21 \ft weakeneth…: or, looseth the girdle of the strong \f* 
\v 22 [He discovereth]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8764”} \w deep things| strong="H6013" \w* \w out of darkness| strong="H2822" \w*, [and bringeth out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w to light| strong="H216" \w* \w the shadow of death| strong="H6757" \w*. 
\v 23 [He increaseth]{strong=“H7679” x-morph=“strongMorph: \sc Th\sc*8688”} \w the nations| strong="H1471" \w*, [and destroyeth]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8762”} [them: he enlargeth]{strong=“H7849” x-morph=“strongMorph: \sc Th\sc*8802”} \w the nations| strong="H1471" \w*, [and straiteneth]{strong=“H5148” x-morph=“strongMorph: \sc Th\sc*8686”} them again.\f + \fr 12:23 \ft straiteneth: Heb. leadeth in \f* 
\v 24 [He taketh away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8688”} \w the heart| strong="H3820" \w* \w of the chief| strong="H7218" \w* \w of the people| strong="H5971" \w* \w of the earth| strong="H776" \w*, [and causeth them to wander]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8686”} \w in a wilderness| strong="H8414" \w* where there is \w no way| strong="H1870" \w*. 
\v 25 [They grope]{strong=“H4959” x-morph=“strongMorph: \sc Th\sc*8762”} \w in the dark| strong="H2822" \w* \w without light| strong="H216" \w*, [and he maketh them to stagger]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8686”} like a \w drunken| strong="H7910" \w* man.\f + \fr 12:25 \ft stagger: Heb. wander \f*
\c 13
\p 
\v 1 [Lo, mine eye]{strong=“H5869”} [hath seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} all this, \w mine ear| strong="H241" \w* [hath heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [and understood]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} it. 
\v 2 \w What ye know| strong="H1847" \w*, the same [do I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} also: I am [not inferior]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8802”} unto you. 
\v 3 \w Surely| strong="H199" \w* [I would speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w to the Almighty| strong="H7706" \w*, [and I desire]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8799”} [to reason]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8687”} \w with God| strong="H410" \w*. 
\v 4 \w But| strong="H199" \w* ye are [forgers]{strong=“H2950” x-morph=“strongMorph: \sc Th\sc*8802”} \w of lies| strong="H8267" \w*, ye are [all physicians]{strong=“H7495” x-morph=“strongMorph: \sc Th\sc*8802”} \w of no value| strong="H457" \w*. 
\v 5 [O that]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [ye would altogether]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8687”} [hold your peace]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8686”}! \w and it should be your wisdom| strong="H2451" \w*. 
\v 6 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} \w now my reasoning| strong="H8433" \w*, [and hearken]{strong=“H7181” x-morph=“strongMorph: \sc Th\sc*8685”} \w to the pleadings| strong="H7379" \w* \w of my lips| strong="H8193" \w*. 
\v 7 [Will ye speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w wickedly| strong="H5766" \w* \w for God| strong="H410" \w*? [and talk]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w deceitfully| strong="H7423" \w* for him? 
\v 8 [Will ye accept]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w his person| strong="H6440" \w*? [will ye contend]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”} \w for God| strong="H410" \w*? 
\v 9 [Is it good]{strong=“H2895” x-morph=“strongMorph: \sc Th\sc*8804”} [that he should search you out]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8799”}? \w or as one man| strong="H582" \w* [mocketh]{strong=“H2048” x-morph=“strongMorph: \sc Th\sc*8763”} another, do ye so [mock]{strong=“H2048” x-morph=“strongMorph: \sc Th\sc*8762”} him? 
\v 10 [He will surely]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8687”} [reprove]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”} [you, if ye do secretly]{strong=“H5643”} [accept]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w persons| strong="H6440" \w*. 
\v 11 \w Shall not his excellency| strong="H7613" \w* [make you afraid]{strong=“H1204” x-morph=“strongMorph: \sc Th\sc*8762”}? \w and his dread| strong="H6343" \w* [fall]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} upon you? 
\v 12 \w Your remembrances| strong="H2146" \w* are \w like| strong="H4912" \w* \w unto ashes| strong="H665" \w*, \w your bodies| strong="H1354" \w* \w to bodies| strong="H1354" \w* \w of clay| strong="H2563" \w*. 
\p
\v 13 [Hold your peace]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8685”}, [let me alone, that I may speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}, [and let come]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”} on me what will.\f + \fr 13:13 \ft Hold…: Heb. Be silent from me \f* 
\v 14 [Wherefore do I take]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w my flesh| strong="H1320" \w* \w in my teeth| strong="H8127" \w*, [and put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w my life| strong="H5315" \w* \w in mine hand| strong="H3709" \w*? 
\v 15 \w Though| strong="H2005" \w* [he slay]{strong=“H6991” x-morph=“strongMorph: \sc Th\sc*8799”} [me, yet will I trust]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8762”} [in him: but I will maintain]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”} \w mine own ways| strong="H1870" \w* \w before| strong="H6440" \w* him.\f + \fr 13:15 \ft maintain: Heb. prove, or, argue \f* 
\v 16 He also shall be \w my salvation| strong="H3444" \w*: \w for an hypocrite| strong="H2611" \w* [shall not come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w before| strong="H6440" \w* him. 
\v 17 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [diligently]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w my speech| strong="H4405" \w*, \w and my declaration| strong="H262" \w* \w with your ears| strong="H241" \w*. 
\v 18 [Behold now, I have ordered]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8804”} my \w cause| strong="H4941" \w*; [I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [that I shall be justified]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 19 Who is he that [will plead]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”} [with me? for now, if I hold my tongue]{strong=“H2790” x-morph=“strongMorph: \sc Th\sc*8686”}, [I shall give up the ghost]{strong=“H1478” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 20 [Only do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w not two| strong="H8147" \w* things [unto me: then will I not hide]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8735”} \w myself from thee| strong="H6440" \w*. 
\v 21 \w Withdraw| strong="H7368" \w* \w thine hand| strong="H3709" \w* [far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8685”} [from me: and let not thy dread]{strong=“H367”} [make me afraid]{strong=“H1204” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 22 [Then call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} [thou, and I will answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”}: [or let me speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}, [and answer]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8685”} thou me. 
\p
\v 23 How many are \w mine iniquities| strong="H5771" \w* \w and sins| strong="H2403" \w*? [make me to know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8685”} \w my transgression| strong="H6588" \w* \w and my sin| strong="H2403" \w*. 
\v 24 [Wherefore hidest]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8686”} \w thou thy face| strong="H6440" \w*, [and holdest]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8799”} [me for thine enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}? 
\v 25 [Wilt thou break]{strong=“H6206” x-morph=“strongMorph: \sc Th\sc*8799”} \w a leaf| strong="H5929" \w* [driven to and fro]{strong=“H5086” x-morph=“strongMorph: \sc Th\sc*8737”}? [and wilt thou pursue]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} \w the dry| strong="H3002" \w* \w stubble| strong="H7179" \w*? 
\v 26 [For thou writest]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8799”} \w bitter things| strong="H4846" \w* [against me, and makest me to possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8686”} \w the iniquities| strong="H5771" \w* \w of my youth| strong="H5271" \w*. 
\v 27 [Thou puttest]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w my feet| strong="H7272" \w* \w also in the stocks| strong="H5465" \w*, [and lookest narrowly]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto all my paths| strong="H734" \w*; [thou settest a print]{strong=“H2707” x-morph=“strongMorph: \sc Th\sc*8691”} \w upon the heels| strong="H8328" \w* \w of my feet| strong="H7272" \w*.\f + \fr 13:27 \ft lookest…: Heb. observest \f* \f + \fr 13:27 \ft heels: Heb. roots \f* 
\v 28 [And he, as a rotten thing]{strong=“H7538”}, [consumeth]{strong=“H1086” x-morph=“strongMorph: \sc Th\sc*8799”}, \w as a garment| strong="H899" \w* \w that is moth| strong="H6211" \w* [eaten]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”}.
\c 14
\p 
\v 1 \w Man| strong="H120" \w* that is [born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8803”} \w of a woman| strong="H802" \w* is \w of few| strong="H7116" \w* \w days| strong="H3117" \w*, \w and full| strong="H7649" \w* \w of trouble| strong="H7267" \w*.\f + \fr 14:1 \ft few…: Heb. short of days \f* 
\v 2 [He cometh forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w like a flower| strong="H6731" \w*, [and is cut down]{strong=“H5243” x-morph=“strongMorph: \sc Th\sc*8799”}: [he fleeth]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8799”} \w also as a shadow| strong="H6738" \w*, [and continueth]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8799”} not. 
\v 3 [And dost thou open]{strong=“H6491” x-morph=“strongMorph: \sc Th\sc*8804”} \w thine eyes| strong="H5869" \w* \w upon such an one| strong="H2088" \w*, [and bringest]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w me into judgment| strong="H4941" \w* with thee? 
\v 4 [Who can bring]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w a clean| strong="H2889" \w* thing \w out of an unclean| strong="H2931" \w*? \w not one| strong="H259" \w*.\f + \fr 14:4 \ft can…: Heb. will give \f* 
\v 5 \w Seeing| strong="H518" \w* \w his days| strong="H3117" \w* are [determined]{strong=“H2782” x-morph=“strongMorph: \sc Th\sc*8803”}, \w the number| strong="H4557" \w* \w of his months| strong="H2320" \w* are [with thee, thou hast appointed]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w his bounds| strong="H2706" \w* [that he cannot pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}; 
\v 6 [Turn]{strong=“H8159” x-morph=“strongMorph: \sc Th\sc*8798”} [from him, that he may rest]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8799”}, [till he shall accomplish]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8799”}, \w as an hireling| strong="H7916" \w*, \w his day| strong="H3117" \w*.\f + \fr 14:6 \ft rest: Heb. cease \f* 
\p
\v 7 \w For there is| strong="H3426" \w* \w hope| strong="H8615" \w* \w of a tree| strong="H6086" \w*, [if it be cut down]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8735”}, [that it will sprout again]{strong=“H2498” x-morph=“strongMorph: \sc Th\sc*8686”}, \w and that the tender branch| strong="H3127" \w* [thereof will not cease]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 8 \w Though the root| strong="H8328" \w* [thereof wax old]{strong=“H2204” x-morph=“strongMorph: \sc Th\sc*8686”} \w in the earth| strong="H776" \w*, \w and the stock| strong="H1503" \w* [thereof die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the ground| strong="H6083" \w*; 
\v 9 Yet \w through the scent| strong="H7381" \w* \w of water| strong="H4325" \w* [it will bud]{strong=“H6524” x-morph=“strongMorph: \sc Th\sc*8686”}, [and bring forth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w boughs| strong="H7105" \w* \w like a plant| strong="H5194" \w*. 
\v 10 \w But man| strong="H1397" \w* [dieth]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, [and wasteth away]{strong=“H2522” x-morph=“strongMorph: \sc Th\sc*8799”}: [yea, man]{strong=“H120”} [giveth up the ghost]{strong=“H1478” x-morph=“strongMorph: \sc Th\sc*8799”}, and where is he?\f + \fr 14:10 \ft wasteth…: Heb. is weakened, or, cut off \f* 
\v 11 As \w the waters| strong="H4325" \w* [fail]{strong=“H235” x-morph=“strongMorph: \sc Th\sc*8804”} \w from the sea| strong="H3220" \w*, \w and the flood| strong="H5104" \w* [decayeth]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8799”} [and drieth up]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8804”}: 
\v 12 \w So man| strong="H376" \w* [lieth down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8804”}, [and riseth]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} [not: till the heavens]{strong=“H8064”} be \w no more| strong="H1115" \w*, [they shall not awake]{strong=“H6974” x-morph=“strongMorph: \sc Th\sc*8686”}, [nor be raised out]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8735”} \w of their sleep| strong="H8142" \w*. 
\v 13 [O that]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [thou wouldest hide]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8686”} \w me in the grave| strong="H7585" \w*, [that thou wouldest keep me secret]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8686”}, \w until thy wrath| strong="H639" \w* [be past]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”}, [that thou wouldest appoint]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8799”} \w me a set time| strong="H2706" \w*, [and remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8799”} me! 
\v 14 \w If a man| strong="H1397" \w* [die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, [shall he live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”} again? \w all the days| strong="H3117" \w* \w of my appointed time| strong="H6635" \w* [will I wait]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8762”}, \w till my change| strong="H2487" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 15 [Thou shalt call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”}, [and I will answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [thee: thou wilt have a desire]{strong=“H3700” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the work| strong="H4639" \w* \w of thine hands| strong="H3027" \w*. 
\p
\v 16 [For now thou numberest]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8799”} \w my steps| strong="H6806" \w*: [dost thou not watch]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w over my sin| strong="H2403" \w*? 
\v 17 \w My transgression| strong="H6588" \w* is [sealed up]{strong=“H2856” x-morph=“strongMorph: \sc Th\sc*8803”} \w in a bag| strong="H6872" \w*, [and thou sewest up]{strong=“H2950” x-morph=“strongMorph: \sc Th\sc*8799”} \w mine iniquity| strong="H5771" \w*. 
\v 18 \w And surely| strong="H199" \w* \w the mountain| strong="H2022" \w* [falling]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8802”} [cometh to nought]{strong=“H5034” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the rock| strong="H6697" \w* [is removed]{strong=“H6275” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of his place| strong="H4725" \w*.\f + \fr 14:18 \ft cometh…: Heb. fadeth \f* 
\v 19 \w The waters| strong="H4325" \w* [wear]{strong=“H7833” x-morph=“strongMorph: \sc Th\sc*8804”} \w the stones| strong="H68" \w*: [thou washest away]{strong=“H7857” x-morph=“strongMorph: \sc Th\sc*8799”} \w the things which grow| strong="H5599" \w* out \w of the dust| strong="H6083" \w* \w of the earth| strong="H776" \w*; [and thou destroyest]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8689”} \w the hope| strong="H8615" \w* \w of man| strong="H582" \w*.\f + \fr 14:19 \ft washest…: Heb. overflowest \f* 
\v 20 [Thou prevailest]{strong=“H8630” x-morph=“strongMorph: \sc Th\sc*8799”} \w for ever| strong="H5331" \w* [against him, and he passeth]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8799”}: [thou changest]{strong=“H8138” x-morph=“strongMorph: \sc Th\sc*8764”} \w his countenance| strong="H6440" \w*, [and sendest him away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 21 \w His sons| strong="H1121" \w* [come to honour]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8799”}, [and he knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} it [not; and they are brought low]{strong=“H6819” x-morph=“strongMorph: \sc Th\sc*8799”}, [but he perceiveth]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} it not of them. 
\v 22 \w But his flesh| strong="H1320" \w* [upon him shall have pain]{strong=“H3510” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and his soul| strong="H5315" \w* [within him shall mourn]{strong=“H56” x-morph=“strongMorph: \sc Th\sc*8799”}.
\c 15
\p 
\v 1 [Then answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w Eliphaz| strong="H464" \w* \w the Temanite| strong="H8489" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 \w Should a wise man| strong="H2450" \w* [utter]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w vain| strong="H7307" \w* \w knowledge| strong="H1847" \w*, [and fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8762”} \w his belly| strong="H990" \w* \w with the east wind| strong="H6921" \w*?\f + \fr 15:2 \ft vain…: Heb. knowledge of wind \f* 
\v 3 [Should he reason]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8687”} [with unprofitable]{strong=“H5532” x-morph=“strongMorph: \sc Th\sc*8799”} \w talk| strong="H1697" \w*? \w or with speeches| strong="H4405" \w* [wherewith he can do no good]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8686”}? 
\v 4 [Yea, thou castest off]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8686”} \w fear| strong="H3374" \w*, [and restrainest]{strong=“H1639” x-morph=“strongMorph: \sc Th\sc*8799”} \w prayer| strong="H7881" \w* \w before| strong="H6440" \w* \w God| strong="H410" \w*.\f + \fr 15:4 \ft castest…: Heb. makest void \f* \f + \fr 15:4 \ft prayer: or, speech \f* 
\v 5 \w For thy mouth| strong="H6310" \w* [uttereth]{strong=“H502” x-morph=“strongMorph: \sc Th\sc*8762”} \w thine iniquity| strong="H5771" \w*, [and thou choosest]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} \w the tongue| strong="H3956" \w* \w of the crafty| strong="H6175" \w*.\f + \fr 15:5 \ft uttereth: Heb. teacheth \f* 
\v 6 \w Thine own mouth| strong="H6310" \w* [condemneth]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8686”} [thee, and not I: yea, thine own lips]{strong=“H8193”} [testify]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} against thee. 
\v 7 Art [thou the first]{strong=“H7223 H7223” x-morph=“strongMorph: \sc Th\sc*8675”} \w man| strong="H120" \w* that [was born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8735”}? [or wast thou made]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8797”} \w before| strong="H6440" \w* \w the hills| strong="H1389" \w*? 
\v 8 [Hast thou heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w the secret| strong="H5475" \w* \w of God| strong="H433" \w*? [and dost thou restrain]{strong=“H1639” x-morph=“strongMorph: \sc Th\sc*8799”} \w wisdom| strong="H2451" \w* to thyself? 
\v 9 [What knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [thou, that we know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} not? what [understandest]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} thou, which is not in us? 
\v 10 With us are [both the grayheaded]{strong=“H7867” x-morph=“strongMorph: \sc Th\sc*8802”} \w and very aged| strong="H3453" \w* [men, much]{strong=“H3524”} \w elder| strong="H3117" \w* \w than thy father| strong="H1" \w*. 
\v 11 Are \w the consolations| strong="H8575" \w* \w of God| strong="H410" \w* \w small| strong="H4592" \w* [with thee? is there any secret]{strong=“H328”} \w thing| strong="H1697" \w* with thee? 
\v 12 \w Why doth thine heart| strong="H3820" \w* [carry thee away]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”}? \w and what do thy eyes| strong="H5869" \w* [wink at]{strong=“H7335” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 13 [That thou turnest]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w thy spirit| strong="H7307" \w* \w against God| strong="H410" \w*, and lettest such \w words| strong="H4405" \w* [go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8689”} \w of thy mouth| strong="H6310" \w*? 
\v 14 What is \w man| strong="H582" \w*, [that he should be clean]{strong=“H2135” x-morph=“strongMorph: \sc Th\sc*8799”}? and he which is [born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8803”} \w of a woman| strong="H802" \w*, [that he should be righteous]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8799”}? 
\v 15 [Behold, he putteth no trust]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”} \w in his saints| strong="H6918" \w*; [yea, the heavens]{strong=“H8064”} [are not clean]{strong=“H2141” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his sight| strong="H5869" \w*. 
\v 16 [How much more abominable]{strong=“H8581” x-morph=“strongMorph: \sc Th\sc*8737”} [and filthy]{strong=“H444” x-morph=“strongMorph: \sc Th\sc*8737”} is \w man| strong="H376" \w*, [which drinketh]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8802”} [iniquity]{strong=“H5766 H5766” x-morph=“strongMorph: \sc Th\sc*8675”} \w like water| strong="H4325" \w*? 
\p
\v 17 [I will shew]{strong=“H2331” x-morph=“strongMorph: \sc Th\sc*8762”} [thee, hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} me; and that which [I have seen]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8804”} [I will declare]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”}; 
\v 18 \w Which wise| strong="H2450" \w* [men have told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w from their fathers| strong="H1" \w*, [and have not hid]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8765”} it: 
\v 19 \w Unto whom alone the earth| strong="H776" \w* [was given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8738”}, [and no stranger]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”} [passed]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w among| strong="H8432" \w* them. 
\v 20 \w The wicked| strong="H7563" \w* [man travaileth]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8711”} with pain all his \w days| strong="H3117" \w*, \w and the number| strong="H4557" \w* \w of years| strong="H8141" \w* [is hidden]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8738”} \w to the oppressor| strong="H6184" \w*. 
\v 21 \w A dreadful| strong="H6343" \w* \w sound| strong="H6963" \w* is \w in his ears| strong="H241" \w*: \w in prosperity| strong="H7965" \w* [the destroyer]{strong=“H7703” x-morph=“strongMorph: \sc Th\sc*8802”} [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} upon him.\f + \fr 15:21 \ft A dreadful…: Heb. A sound of fears \f* 
\v 22 [He believeth]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”} [not that he shall return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8800”} \w out of darkness| strong="H2822" \w*, [and he is waited]{strong=“H6822” x-morph=“strongMorph: \sc Th\sc*8803”} \w for of the sword| strong="H2719" \w*. 
\v 23 [He wandereth abroad]{strong=“H5074” x-morph=“strongMorph: \sc Th\sc*8802”} \w for bread| strong="H3899" \w*, saying, Where is it? [he knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w that the day| strong="H3117" \w* \w of darkness| strong="H2822" \w* [is ready]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8737”} \w at his hand| strong="H3027" \w*. 
\v 24 \w Trouble| strong="H6862" \w* \w and anguish| strong="H4691" \w* [shall make him afraid]{strong=“H1204” x-morph=“strongMorph: \sc Th\sc*8762”}; [they shall prevail]{strong=“H8630” x-morph=“strongMorph: \sc Th\sc*8799”} [against him, as a king]{strong=“H4428”} \w ready| strong="H6264" \w* \w to the battle| strong="H3593" \w*. 
\v 25 [For he stretcheth out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8804”} \w his hand| strong="H3027" \w* \w against God| strong="H410" \w*, [and strengtheneth]{strong=“H1396” x-morph=“strongMorph: \sc Th\sc*8691”} \w himself against the Almighty| strong="H7706" \w*. 
\v 26 [He runneth]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”} upon him, even on his \w neck| strong="H6677" \w*, \w upon the thick| strong="H5672" \w* \w bosses| strong="H1354" \w* \w of his bucklers| strong="H4043" \w*: 
\v 27 [Because he covereth]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”} \w his face| strong="H6440" \w* \w with his fatness| strong="H2459" \w*, [and maketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w collops of fat| strong="H6371" \w* on his \w flanks| strong="H3689" \w*. 
\v 28 [And he dwelleth]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} [in desolate]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8737”} \w cities| strong="H5892" \w*, and \w in houses| strong="H1004" \w* [which no man inhabiteth]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”}, [which are ready]{strong=“H6257” x-morph=“strongMorph: \sc Th\sc*8694”} \w to become heaps| strong="H1530" \w*. 
\v 29 [He shall not be rich]{strong=“H6238” x-morph=“strongMorph: \sc Th\sc*8799”}, \w neither shall his substance| strong="H2428" \w* [continue]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [neither shall he prolong]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8799”} \w the perfection| strong="H4512" \w* \w thereof upon the earth| strong="H776" \w*. 
\v 30 [He shall not depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of darkness| strong="H2822" \w*; \w the flame| strong="H7957" \w* [shall dry up]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8762”} \w his branches| strong="H3127" \w*, \w and by the breath| strong="H7307" \w* \w of his mouth| strong="H6310" \w* [shall he go away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 31 [Let not him that is deceived]{strong=“H8582” x-morph=“strongMorph: \sc Th\sc*8738”} [trust]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”} \w in vanity| strong="H7723" \w*: \w for vanity| strong="H7723" \w* \w shall be his recompence| strong="H8545" \w*. 
\v 32 [It shall be accomplished]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8735”} \w before| strong="H3808" \w* \w his time| strong="H3117" \w*, \w and his branch| strong="H3712" \w* \w shall not be green| strong="H7488" \w*.\f + \fr 15:32 \ft accomplished: or, cut off \f* 
\v 33 [He shall shake off]{strong=“H2554” x-morph=“strongMorph: \sc Th\sc*8799”} \w his unripe grape| strong="H1154" \w* \w as the vine| strong="H1612" \w*, [and shall cast off]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w his flower| strong="H5328" \w* \w as the olive| strong="H2132" \w*. 
\v 34 \w For the congregation| strong="H5712" \w* \w of hypocrites| strong="H2611" \w* shall be \w desolate| strong="H1565" \w*, \w and fire| strong="H784" \w* [shall consume]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w the tabernacles| strong="H168" \w* \w of bribery| strong="H7810" \w*. 
\v 35 [They conceive]{strong=“H2029” x-morph=“strongMorph: \sc Th\sc*8800”} \w mischief| strong="H5999" \w*, [and bring forth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8800”} \w vanity| strong="H205" \w*, \w and their belly| strong="H990" \w* [prepareth]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8686”} \w deceit| strong="H4820" \w*.\f + \fr 15:35 \ft vanity: or, iniquity \f*
\c 16
\p 
\v 1 \w Then Job| strong="H347" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 [I have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w many such things| strong="H7227" \w*: \w miserable| strong="H5999" \w* [comforters]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8764”} are ye all.\f + \fr 16:2 \ft miserable: or, troublesome \f* 
\v 3 \w Shall vain| strong="H7307" \w* \w words| strong="H1697" \w* \w have an end| strong="H7093" \w*? [or what emboldeneth]{strong=“H4834” x-morph=“strongMorph: \sc Th\sc*8686”} [thee that thou answerest]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”}?\f + \fr 16:3 \ft vain…: Heb. words of wind \f* 
\v 4 [I also could speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} as ye do: \w if| strong="H3863" \w* \w your soul| strong="H5315" \w* \w were| strong="H3426" \w* [in my soul’s]{strong=“H5315”} [stead, I could heap up]{strong=“H2266” x-morph=“strongMorph: \sc Th\sc*8686”} \w words| strong="H4405" \w* [against you, and shake]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8686”} \w mine head| strong="H7218" \w* \w at| strong="H1119" \w* you. 
\v 5 But [I would strengthen]{strong=“H553” x-morph=“strongMorph: \sc Th\sc*8762”} \w you with| strong="H1119" \w* \w my mouth| strong="H6310" \w*, \w and the moving| strong="H5205" \w* \w of my lips| strong="H8193" \w* [should asswage]{strong=“H2820” x-morph=“strongMorph: \sc Th\sc*8799”} your grief. 
\p
\v 6 [Though I speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}, \w my grief| strong="H3511" \w* [is not asswaged]{strong=“H2820” x-morph=“strongMorph: \sc Th\sc*8735”}: and though [I forbear]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8799”}, [what am I eased]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8799”}?\f + \fr 16:6 \ft what…: Heb. what goeth from me? \f* 
\v 7 [But now he hath made me weary]{strong=“H3811” x-morph=“strongMorph: \sc Th\sc*8689”}: [thou hast made desolate]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8689”} \w all my company| strong="H5712" \w*. 
\v 8 [And thou hast filled me with wrinkles]{strong=“H7059” x-morph=“strongMorph: \sc Th\sc*8799”}, which \w is a witness| strong="H5707" \w* against me: \w and my leanness| strong="H3585" \w* [rising up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} [in me beareth witness]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w to my face| strong="H6440" \w*. 
\v 9 [He teareth]{strong=“H2963” x-morph=“strongMorph: \sc Th\sc*8804”} me \w in his wrath| strong="H639" \w*, [who hateth]{strong=“H7852” x-morph=“strongMorph: \sc Th\sc*8799”} [me: he gnasheth]{strong=“H2786” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon me with his teeth| strong="H8127" \w*; \w mine enemy| strong="H6862" \w* [sharpeneth]{strong=“H3913” x-morph=“strongMorph: \sc Th\sc*8799”} \w his eyes| strong="H5869" \w* upon me. 
\v 10 [They have gaped]{strong=“H6473” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon me with their mouth| strong="H6310" \w*; [they have smitten]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8689”} \w me upon the cheek| strong="H3895" \w* \w reproachfully| strong="H2781" \w*; [they have gathered]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8691”} \w themselves together| strong="H3162" \w* against me. 
\v 11 \w God| strong="H410" \w* [hath delivered]{strong=“H5462” x-morph=“strongMorph: \sc Th\sc*8686”} \w me to the ungodly| strong="H5760" \w*, [and turned me over]{strong=“H3399” x-morph=“strongMorph: \sc Th\sc*8804”} \w into the hands| strong="H3027" \w* \w of the wicked| strong="H7563" \w*.\f + \fr 16:11 \ft hath…: Heb. hath shut me up \f* 
\v 12 \w I was at ease| strong="H7961" \w*, [but he hath broken me asunder]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8770”}: [he hath also taken]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8804”} me \w by my neck| strong="H6203" \w*, [and shaken me to pieces]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8770”}, [and set me up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8686”} \w for his mark| strong="H4307" \w*. 
\v 13 \w His archers| strong="H7228" \w* [compass me round about]{strong=“H5437” x-morph=“strongMorph: \sc Th\sc*8799”}, \w he cleaveth| strong="H6398" \w* \w my reins| strong="H3629" \w* [asunder]{strong=“H6398” x-morph=“strongMorph: \sc Th\sc*8762”}, [and doth not spare]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”}; [he poureth out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8799”} \w my gall| strong="H4845" \w* \w upon the ground| strong="H776" \w*. 
\v 14 [He breaketh]{strong=“H6555” x-morph=“strongMorph: \sc Th\sc*8799”} \w me with breach| strong="H6556" \w* \w upon| strong="H6440" \w* \w breach| strong="H6556" \w*, [he runneth]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon me like a giant| strong="H1368" \w*. 
\v 15 [I have sewed]{strong=“H8609” x-morph=“strongMorph: \sc Th\sc*8804”} \w sackcloth| strong="H8242" \w* \w upon my skin| strong="H1539" \w*, [and defiled]{strong=“H5953” x-morph=“strongMorph: \sc Th\sc*8782”} \w my horn| strong="H7161" \w* \w in the dust| strong="H6083" \w*. 
\v 16 \w My face| strong="H6440" \w* [is foul]{strong=“H2560” x-morph=“strongMorph: \sc Th\sc*8777”} \w with weeping| strong="H1065" \w*, \w and on my eyelids| strong="H6079" \w* is \w the shadow of death| strong="H6757" \w*; 
\p
\v 17 Not for any \w injustice| strong="H2555" \w* \w in mine hands| strong="H3709" \w*: \w also my prayer| strong="H8605" \w* is \w pure| strong="H2134" \w*. 
\v 18 \w O earth| strong="H776" \w*, [cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} \w not thou my blood| strong="H1818" \w*, \w and let my cry| strong="H2201" \w* \w have no place| strong="H4725" \w*. 
\v 19 [Also now, behold, my witness]{strong=“H5707”} is \w in heaven| strong="H8064" \w*, \w and my record| strong="H7717" \w* is \w on high| strong="H4791" \w*.\f + \fr 16:19 \ft on high: Heb. in the high places \f* 
\v 20 \w My friends| strong="H7453" \w* [scorn]{strong=“H3887” x-morph=“strongMorph: \sc Th\sc*8688”} me: but \w mine eye| strong="H5869" \w* [poureth out]{strong=“H1811” x-morph=“strongMorph: \sc Th\sc*8804”} tears \w unto God| strong="H433" \w*.\f + \fr 16:20 \ft scorn me: Heb. are my scorners \f* 
\v 21 [O that one might plead]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”} \w for a man| strong="H1397" \w* \w with God| strong="H433" \w*, \w as a man| strong="H120" \w* pleadeth [for his neighbour]{strong=“H7453 H1121”}!\f + \fr 16:21 \ft neighbour: or, friend \f* 
\v 22 \w When a few| strong="H4557" \w* \w years| strong="H8141" \w* [are come]{strong=“H857” x-morph=“strongMorph: \sc Th\sc*8799”}, [then I shall go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8799”} \w the way| strong="H734" \w* whence [I shall not return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}.\f + \fr 16:22 \ft a few…: Heb. years of number \f*
\c 17
\p 
\v 1 \w My breath| strong="H7307" \w* [is corrupt]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8795”}, \w my days| strong="H3117" \w* [are extinct]{strong=“H2193” x-morph=“strongMorph: \sc Th\sc*8738”}, \w the graves| strong="H6913" \w* are ready for me.\f + \fr 17:1 \ft breath…: or, spirit is spent \f* 
\v 2 Are there \w not mockers| strong="H2049" \w* [with me? and doth not mine eye]{strong=“H5869”} [continue]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} [in their provocation]{strong=“H4784” x-morph=“strongMorph: \sc Th\sc*8687”}?\f + \fr 17:2 \ft continue: Heb. lodge \f* 
\v 3 [Lay down]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} [now, put me in a surety]{strong=“H6148” x-morph=“strongMorph: \sc Th\sc*8798”} with thee; who is he that [will strike]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8735”} \w hands| strong="H3027" \w* with me? 
\v 4 [For thou hast hid]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8804”} \w their heart| strong="H3820" \w* \w from understanding| strong="H7922" \w*: [therefore shalt thou not exalt]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8787”} them. 
\v 5 [He that speaketh]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w flattery| strong="H2506" \w* to his \w friends| strong="H7453" \w*, \w even the eyes| strong="H5869" \w* \w of his children| strong="H1121" \w* [shall fail]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 6 [He hath made]{strong=“H3322” x-morph=“strongMorph: \sc Th\sc*8689”} \w me also a byword| strong="H4914" \w* \w of the people| strong="H5971" \w*; \w and aforetime| strong="H6440" \w* \w I was as a tabret| strong="H8611" \w*.\f + \fr 17:6 \ft aforetime: or, before them \f* 
\v 7 \w Mine eye| strong="H5869" \w* [also is dim]{strong=“H3543” x-morph=“strongMorph: \sc Th\sc*8799”} \w by reason of sorrow| strong="H3708" \w*, \w and all my members| strong="H3338" \w* are \w as a shadow| strong="H6738" \w*.\f + \fr 17:7 \ft my members: or, my thoughts \f* 
\v 8 \w Upright| strong="H3477" \w* men [shall be astonied]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8799”} [at this, and the innocent]{strong=“H5355”} [shall stir up]{strong=“H5782” x-morph=“strongMorph: \sc Th\sc*8709”} \w himself against the hypocrite| strong="H2611" \w*. 
\v 9 \w The righteous| strong="H6662" \w* [also shall hold]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8799”} \w on his way| strong="H1870" \w*, \w and he that hath clean| strong="H2890" \w* \w hands| strong="H3027" \w* [shall be]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w stronger and stronger| strong="H555" \w*.\f + \fr 17:9 \ft be…: Heb. add strength \f* 
\p
\v 10 \w But| strong="H199" \w* [as for you all, do ye return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [and come now]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8798”}: [for I cannot find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} one \w wise| strong="H2450" \w* man among you. 
\v 11 \w My days| strong="H3117" \w* [are past]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”}, \w my purposes| strong="H2154" \w* [are broken off]{strong=“H5423” x-morph=“strongMorph: \sc Th\sc*8738”}, even \w the thoughts| strong="H4180" \w* \w of my heart| strong="H3824" \w*.\f + \fr 17:11 \ft the thoughts: Heb. the possessions \f* 
\v 12 [They change]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w the night| strong="H3915" \w* \w into day| strong="H3117" \w*: \w the light| strong="H216" \w* is \w short| strong="H7138" \w* \w because| strong="H6440" \w* \w of darkness| strong="H2822" \w*.\f + \fr 17:12 \ft short: Heb. near \f* 
\v 13 [If I wait]{strong=“H6960” x-morph=“strongMorph: \sc Th\sc*8762”}, \w the grave| strong="H7585" \w* is \w mine house| strong="H1004" \w*: [I have made]{strong=“H7502” x-morph=“strongMorph: \sc Th\sc*8765”} \w my bed| strong="H3326" \w* \w in the darkness| strong="H2822" \w*. 
\v 14 [I have said]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w to corruption| strong="H7845" \w*, Thou art \w my father| strong="H1" \w*: \w to the worm| strong="H7415" \w*, Thou art \w my mother| strong="H517" \w*, \w and my sister| strong="H269" \w*.\f + \fr 17:14 \ft said: Heb. cried, or, called \f* 
\v 15 And where is \w now| strong="H645" \w* \w my hope| strong="H8615" \w*? \w as for my hope| strong="H8615" \w*, [who shall see]{strong=“H7789” x-morph=“strongMorph: \sc Th\sc*8799”} it? 
\v 16 [They shall go down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the bars| strong="H905" \w* \w of the pit| strong="H7585" \w*, when our \w rest| strong="H5183" \w* \w together| strong="H3162" \w* is \w in the dust| strong="H6083" \w*.
\c 18
\p 
\v 1 [Then answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w Bildad| strong="H1085" \w* \w the Shuhite| strong="H7747" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 \w How long| strong="H5704" \w* will it be ere [ye make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w an end| strong="H7078" \w* \w of words| strong="H4405" \w*? [mark]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and afterwards| strong="H310" \w* [we will speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 3 [Wherefore are we counted]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8738”} \w as beasts| strong="H929" \w*, and [reputed vile]{strong=“H2933” x-morph=“strongMorph: \sc Th\sc*8738”} \w in your sight| strong="H5869" \w*? 
\v 4 [He teareth]{strong=“H2963” x-morph=“strongMorph: \sc Th\sc*8802”} \w himself| strong="H5315" \w* \w in his anger| strong="H639" \w*: \w shall the earth| strong="H776" \w* [be forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8735”} [for thee? and shall the rock]{strong=“H6697”} [be removed]{strong=“H6275” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of his place| strong="H4725" \w*?\f + \fr 18:4 \ft himself: Heb. his soul \f* 
\p
\v 5 [Yea, the light]{strong=“H216”} \w of the wicked| strong="H7563" \w* [shall be put out]{strong=“H1846” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the spark| strong="H7632" \w* \w of his fire| strong="H784" \w* [shall not shine]{strong=“H5050” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 6 \w The light| strong="H216" \w* [shall be dark]{strong=“H2821” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his tabernacle| strong="H168" \w*, \w and his candle| strong="H5216" \w* [shall be put out]{strong=“H1846” x-morph=“strongMorph: \sc Th\sc*8799”} with him.\f + \fr 18:6 \ft candle: or, lamp \f* 
\v 7 \w The steps| strong="H6806" \w* \w of his strength| strong="H202" \w* [shall be straitened]{strong=“H3334” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and his own counsel| strong="H6098" \w* [shall cast him down]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 8 [For he is cast]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8795”} \w into a net| strong="H7568" \w* \w by his own feet| strong="H7272" \w*, [and he walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8691”} \w upon a snare| strong="H7639" \w*. 
\v 9 \w The gin| strong="H6341" \w* [shall take]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8799”} him \w by the heel| strong="H6119" \w*, and \w the robber| strong="H6782" \w* [shall prevail]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8686”} against him. 
\v 10 \w The snare| strong="H2256" \w* is [laid]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8803”} \w for him in the ground| strong="H776" \w*, \w and a trap| strong="H4434" \w* \w for him in the way| strong="H5410" \w*.\f + \fr 18:10 \ft laid: Heb. hidden \f* 
\p
\v 11 \w Terrors| strong="H1091" \w* [shall make him afraid]{strong=“H1204” x-morph=“strongMorph: \sc Th\sc*8765”} \w on every side| strong="H5439" \w*, [and shall drive]{strong=“H6327” x-morph=“strongMorph: \sc Th\sc*8689”} \w him to his feet| strong="H7272" \w*.\f + \fr 18:11 \ft drive: Heb. scatter \f* 
\v 12 \w His strength| strong="H202" \w* \w shall be hungerbitten| strong="H7457" \w*, \w and destruction| strong="H343" \w* shall be [ready]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8737”} \w at his side| strong="H6763" \w*. 
\v 13 [It shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w the strength| strong="H905" \w* \w of his skin| strong="H5785" \w*: even \w the firstborn| strong="H1060" \w* \w of death| strong="H4194" \w* [shall devour]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w his strength| strong="H905" \w*.\f + \fr 18:13 \ft strength: Heb. bars \f* 
\v 14 \w His confidence| strong="H4009" \w* [shall be rooted out]{strong=“H5423” x-morph=“strongMorph: \sc Th\sc*8735”} \w of his tabernacle| strong="H168" \w*, [and it shall bring]{strong=“H6805” x-morph=“strongMorph: \sc Th\sc*8686”} \w him to the king| strong="H4428" \w* \w of terrors| strong="H1091" \w*. 
\v 15 [It shall dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his tabernacle| strong="H168" \w*, because it is \w none| strong="H1097" \w* [of his: brimstone]{strong=“H1614”} [shall be scattered]{strong=“H2219” x-morph=“strongMorph: \sc Th\sc*8792”} \w upon his habitation| strong="H5116" \w*. 
\v 16 \w His roots| strong="H8328" \w* [shall be dried up]{strong=“H3001” x-morph=“strongMorph: \sc Th\sc*8799”} [beneath, and above]{strong=“H4605”} \w shall his branch| strong="H7105" \w* [be cut off]{strong=“H5243” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 17 \w His remembrance| strong="H2143" \w* [shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”} \w from the earth| strong="H776" \w*, \w and he shall have no name| strong="H8034" \w* [in the street]{strong=“H2351 H6440”}. 
\v 18 [He shall be driven]{strong=“H1920” x-morph=“strongMorph: \sc Th\sc*8799”} \w from light| strong="H216" \w* \w into darkness| strong="H2822" \w*, [and chased]{strong=“H5074” x-morph=“strongMorph: \sc Th\sc*8686”} \w out of the world| strong="H8398" \w*.\f + \fr 18:18 \ft He…: Heb. They shall drive him \f* 
\v 19 \w He shall neither have son| strong="H5209" \w* \w nor nephew| strong="H5220" \w* \w among his people| strong="H5971" \w*, \w nor any remaining| strong="H8300" \w* \w in his dwellings| strong="H4033" \w*. 
\v 20 \w They that come after| strong="H314" \w* him [shall be astonied]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8738”} \w at his day| strong="H3117" \w*, \w as they that went before| strong="H6931" \w* [were affrighted]{strong=“H8178 H270” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 18:20 \ft went…: or, lived with him \f* \f + \fr 18:20 \ft were…: Heb. laid hold on horror \f* 
\v 21 Surely such are \w the dwellings| strong="H4908" \w* \w of the wicked| strong="H5767" \w*, and this is \w the place| strong="H4725" \w* of him that [knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w not God| strong="H410" \w*.
\c 19
\p 
\v 1 \w Then Job| strong="H347" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 [How long will ye vex]{strong=“H3013” x-morph=“strongMorph: \sc Th\sc*8686”} \w my soul| strong="H5315" \w*, [and break]{strong=“H1792” x-morph=“strongMorph: \sc Th\sc*8762”} \w me in pieces with words| strong="H4405" \w*? 
\v 3 \w These ten| strong="H6235" \w* \w times| strong="H6471" \w* [have ye reproached]{strong=“H3637” x-morph=“strongMorph: \sc Th\sc*8686”} [me: ye are not ashamed]{strong=“H954” x-morph=“strongMorph: \sc Th\sc*8799”} that [ye make yourselves strange]{strong=“H1970” x-morph=“strongMorph: \sc Th\sc*8686”} to me.\f + \fr 19:3 \ft make…: or, harden yourselves against me \f* 
\v 4 \w And be it indeed| strong="H551" \w* that [I have erred]{strong=“H7686” x-morph=“strongMorph: \sc Th\sc*8804”}, \w mine error| strong="H4879" \w* [remaineth ]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} with myself. 
\v 5 \w If indeed| strong="H551" \w* [ye will magnify]{strong=“H1431” x-morph=“strongMorph: \sc Th\sc*8686”} yourselves [against me, and plead]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”} \w against me my reproach| strong="H2781" \w*: 
\v 6 [Know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8798”} \w now| strong="H645" \w* \w that God| strong="H433" \w* [hath overthrown]{strong=“H5791” x-morph=“strongMorph: \sc Th\sc*8765”} [me, and hath compassed]{strong=“H5362” x-morph=“strongMorph: \sc Th\sc*8689”} \w me with his net| strong="H4686" \w*. 
\v 7 [Behold, I cry out]{strong=“H6817” x-morph=“strongMorph: \sc Th\sc*8799”} \w of wrong| strong="H2555" \w*, [but I am not heard]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8735”}: [I cry aloud]{strong=“H7768” x-morph=“strongMorph: \sc Th\sc*8762”}, but there is \w no judgment| strong="H4941" \w*.\f + \fr 19:7 \ft wrong: or, violence \f* 
\p
\v 8 [He hath fenced up]{strong=“H1443” x-morph=“strongMorph: \sc Th\sc*8804”} \w my way| strong="H734" \w* [that I cannot pass]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8799”}, [and he hath set]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w darkness| strong="H2822" \w* \w in my paths| strong="H5410" \w*. 
\v 9 [He hath stripped]{strong=“H6584” x-morph=“strongMorph: \sc Th\sc*8689”} \w me of my glory| strong="H3519" \w*, [and taken]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8686”} \w the crown| strong="H5850" \w* from \w my head| strong="H7218" \w*. 
\v 10 [He hath destroyed]{strong=“H5422” x-morph=“strongMorph: \sc Th\sc*8799”} \w me on every side| strong="H5439" \w*, [and I am gone]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}: \w and mine hope| strong="H8615" \w* [hath he removed]{strong=“H5265” x-morph=“strongMorph: \sc Th\sc*8686”} \w like a tree| strong="H6086" \w*. 
\v 11 [He hath also kindled]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8686”} \w his wrath| strong="H639" \w* [against me, and he counteth]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8799”} me unto him as one of \w his enemies| strong="H6862" \w*. 
\v 12 \w His troops| strong="H1416" \w* [come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w together| strong="H3162" \w*, [and raise up]{strong=“H5549” x-morph=“strongMorph: \sc Th\sc*8799”} \w their way| strong="H1870" \w* [against me, and encamp]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8799”} \w round about| strong="H5439" \w* \w my tabernacle| strong="H168" \w*. 
\v 13 \w He hath put| strong="H7368" \w* \w my brethren| strong="H251" \w* [far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8689”} [from me, and mine acquaintance]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} [are verily estranged]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8804”} from me. 
\v 14 \w My kinsfolk| strong="H7138" \w* [have failed]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8804”}, [and my familiar friends]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8794”} [have forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8804”} me. 
\v 15 [They that dwell]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8802”} \w in mine house| strong="H1004" \w*, \w and my maids| strong="H519" \w*, [count]{strong=“H2803” x-morph=“strongMorph: \sc Th\sc*8799”} [me for a stranger]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”}: \w I am an alien| strong="H5237" \w* \w in their sight| strong="H5869" \w*. 
\v 16 [I called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8804”} \w my servant| strong="H5650" \w*, and he gave me [no answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”}; [I intreated]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8691”} \w him with| strong="H1119" \w* \w my mouth| strong="H6310" \w*. 
\v 17 \w My breath| strong="H7307" \w* [is strange]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8804”} \w to my wife| strong="H802" \w*, [though I intreated]{strong=“H2589” x-morph=“strongMorph: \sc Th\sc*8800”} [for the children’s]{strong=“H1121”} sake \w of mine own body| strong="H990" \w*.\f + \fr 19:17 \ft mine…: Heb. my belly \f* 
\v 18 [Yea, young children]{strong=“H5759”} [despised ]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} [me; I arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and they spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} against me.\f + \fr 19:18 \ft young…: or, the wicked \f* 
\v 19 \w All my inward| strong="H5475" \w* \w friends| strong="H4962" \w* [abhorred]{strong=“H8581” x-morph=“strongMorph: \sc Th\sc*8765”} [me: and they whom I loved]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} [are turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8738”} against me.\f + \fr 19:19 \ft my…: Heb. the men of my secret \f* 
\v 20 \w My bone| strong="H6106" \w* [cleaveth]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8804”} \w to my skin| strong="H5785" \w* \w and to my flesh| strong="H1320" \w*, [and I am escaped]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8691”} \w with the skin| strong="H5785" \w* \w of my teeth| strong="H8127" \w*.\f + \fr 19:20 \ft and to: or, as to \f* 
\v 21 [Have pity]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} [upon me, have pity]{strong=“H2603” x-morph=“strongMorph: \sc Th\sc*8798”} [upon me, O ye my friends]{strong=“H7453”}; \w for the hand| strong="H3027" \w* \w of God| strong="H433" \w* [hath touched]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8804”} me. 
\v 22 [Why do ye persecute]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} \w me as God| strong="H410" \w*, [and are not satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”} \w with my flesh| strong="H1320" \w*? 
\p
\v 23 [Oh that]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w my words| strong="H4405" \w* \w were now| strong="H645" \w* [written]{strong=“H3789” x-morph=“strongMorph: \sc Th\sc*8735”}! [oh that]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [they were printed]{strong=“H2710” x-morph=“strongMorph: \sc Th\sc*8714”} \w in a book| strong="H5612" \w*!\f + \fr 19:23 \ft Oh…: Heb. Who will give, etc \f* 
\v 24 [That they were graven]{strong=“H2672” x-morph=“strongMorph: \sc Th\sc*8735”} \w with an iron| strong="H1270" \w* \w pen| strong="H5842" \w* \w and lead| strong="H5777" \w* \w in the rock| strong="H6697" \w* \w for ever| strong="H5703" \w*! 
\v 25 [For I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that [my redeemer]{strong=“H1350” x-morph=“strongMorph: \sc Th\sc*8802”} \w liveth| strong="H2416" \w*, and that [he shall stand]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w at the latter| strong="H314" \w* day \w upon the earth| strong="H6083" \w*: 
\v 26 And though \w after| strong="H310" \w* \w my skin| strong="H5785" \w* worms [destroy]{strong=“H5362” x-morph=“strongMorph: \sc Th\sc*8765”} this body, \w yet in my flesh| strong="H1320" \w* [shall I see]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8799”} \w God| strong="H433" \w*:\f + \fr 19:26 \ft And…: or, After I shall awake, though this body be destroyed, yet out of my flesh \f* 
\v 27 [Whom I shall see]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8799”} [for myself, and mine eyes]{strong=“H5869”} [shall behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”}, [and not another]{strong=“H2114” x-morph=“strongMorph: \sc Th\sc*8801”}; though \w my reins| strong="H3629" \w* [be consumed]{strong=“H3615” x-morph=“strongMorph: \sc Th\sc*8804”} \w within| strong="H2436" \w* me.\f + \fr 19:27 \ft another: Heb. a stranger \f* \f + \fr 19:27 \ft though…: or, my reins within me are consumed with earnest desire (for that day) \f* \f + \fr 19:27 \ft within…: Heb. in my bosom \f* 
\v 28 [But ye should say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Why persecute]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} [we him, seeing the root]{strong=“H8328”} \w of the matter| strong="H1697" \w* [is found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8738”} in me?\f + \fr 19:28 \ft seeing…: or, and what root of matter is found in me? \f* 
\v 29 [Be ye afraid]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8798”} \w of the sword| strong="H2719" \w*: \w for wrath| strong="H2534" \w* bringeth \w the punishments| strong="H5771" \w* \w of| strong="H6440" \w* \w the sword| strong="H2719" \w*, [that ye may know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} there is [a judgment]{strong=“H1779 H1779” x-morph=“strongMorph: \sc Th\sc*8675”}.
\c 20
\p 
\v 1 [Then answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w Zophar| strong="H6691" \w* \w the Naamathite| strong="H5284" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 \w Therefore do my thoughts| strong="H5587" \w* [cause me to answer]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”}, and for this [I make haste]{strong=“H2363” x-morph=“strongMorph: \sc Th\sc*8800”}.\f + \fr 20:2 \ft I make…: Heb. my haste is in me \f* 
\v 3 [I have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w the check| strong="H4148" \w* \w of my reproach| strong="H3639" \w*, \w and the spirit| strong="H7307" \w* \w of my understanding| strong="H998" \w* [causeth me to answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 4 [Knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} thou not \w this of old| strong="H5703" \w*, \w since man| strong="H120" \w* [was placed]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8800”} \w upon earth| strong="H776" \w*, 
\v 5 \w That the triumphing| strong="H7445" \w* \w of the wicked| strong="H7563" \w* is \w short| strong="H7138" \w*, \w and the joy| strong="H8057" \w* \w of the hypocrite| strong="H2611" \w* but \w for a moment| strong="H7281" \w*?\f + \fr 20:5 \ft short: Heb. from near \f* 
\v 6 \w Though his excellency| strong="H7863" \w* [mount up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the heavens| strong="H8064" \w*, \w and his head| strong="H7218" \w* [reach]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8686”} \w unto the clouds| strong="H5645" \w*;\f + \fr 20:6 \ft clouds: Heb. cloud \f* 
\v 7 Yet [he shall perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8799”} \w for ever| strong="H5331" \w* \w like his own dung| strong="H1561" \w*: [they which have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} [him shall say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Where| strong="H335" \w* is he? 
\v 8 [He shall fly away]{strong=“H5774” x-morph=“strongMorph: \sc Th\sc*8799”} \w as a dream| strong="H2472" \w*, [and shall not be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”}: [yea, he shall be chased away]{strong=“H5074” x-morph=“strongMorph: \sc Th\sc*8714”} \w as a vision| strong="H2384" \w* \w of the night| strong="H3915" \w*. 
\v 9 \w The eye| strong="H5869" \w* also which [saw]{strong=“H7805” x-morph=“strongMorph: \sc Th\sc*8804”} him shall see him [no more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”}; \w neither shall his place| strong="H4725" \w* [any more behold]{strong=“H7789” x-morph=“strongMorph: \sc Th\sc*8799”} him. 
\p
\v 10 \w His children| strong="H1121" \w* [shall seek to please]{strong=“H7521” x-morph=“strongMorph: \sc Th\sc*8762”} \w the poor| strong="H1800" \w*, \w and his hands| strong="H3027" \w* [shall restore]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} \w their goods| strong="H202" \w*.\f + \fr 20:10 \ft His children…: or, The poor shall oppress his children \f* 
\v 11 \w His bones| strong="H6106" \w* [are full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} of the sin \w of his youth| strong="H5934" \w*, [which shall lie down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w with him in the dust| strong="H6083" \w*. 
\v 12 \w Though wickedness| strong="H7451" \w* [be sweet]{strong=“H4985” x-morph=“strongMorph: \sc Th\sc*8686”} \w in his mouth| strong="H6310" \w*, though [he hide]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8686”} \w it under his tongue| strong="H3956" \w*; 
\v 13 Though [he spare]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”} [it, and forsake]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} [it not; but keep it still]{strong=“H4513” x-morph=“strongMorph: \sc Th\sc*8799”} \w within| strong="H8432" \w* \w his mouth| strong="H2441" \w*:\f + \fr 20:13 \ft within…: Heb. in the midst of his palate \f* 
\v 14 Yet \w his meat| strong="H3899" \w* \w in his bowels| strong="H4578" \w* [is turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8738”}, it is \w the gall| strong="H4846" \w* \w of asps| strong="H6620" \w* \w within| strong="H7130" \w* him. 
\v 15 [He hath swallowed down]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8804”} \w riches| strong="H2428" \w*, [and he shall vomit them up again]{strong=“H6958” x-morph=“strongMorph: \sc Th\sc*8686”}: \w God| strong="H410" \w* [shall cast them out]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8686”} \w of his belly| strong="H990" \w*. 
\v 16 [He shall suck]{strong=“H3243” x-morph=“strongMorph: \sc Th\sc*8799”} \w the poison| strong="H7219" \w* \w of asps| strong="H6620" \w*: [the viper’s]{strong=“H660”} \w tongue| strong="H3956" \w* [shall slay]{strong=“H2026” x-morph=“strongMorph: \sc Th\sc*8799”} him. 
\v 17 [He shall not see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w the rivers| strong="H6390" \w*, \w the floods| strong="H5104" \w*, \w the brooks| strong="H5158" \w* \w of honey| strong="H1706" \w* \w and butter| strong="H2529" \w*.\f + \fr 20:17 \ft the floods…: or, streaming brooks \f* 
\v 18 \w That which he laboured| strong="H3022" \w* [for shall he restore]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8688”}, and shall not swallow it [down]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8799”}: according to his \w substance| strong="H2428" \w* shall \w the restitution| strong="H8545" \w* be, [and he shall not rejoice]{strong=“H5965” x-morph=“strongMorph: \sc Th\sc*8799”} therein.\f + \fr 20:18 \ft his…: Heb. the substance of his exchange \f* 
\v 19 [Because he hath oppressed]{strong=“H7533” x-morph=“strongMorph: \sc Th\sc*8765”} and [hath forsaken]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} \w the poor| strong="H1800" \w*; because [he hath violently taken away]{strong=“H1497” x-morph=“strongMorph: \sc Th\sc*8804”} \w an house| strong="H1004" \w* [which he builded]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8799”} not;\f + \fr 20:19 \ft oppressed: Heb. crushed \f* 
\v 20 [Surely he shall not feel]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w quietness| strong="H7961" \w* \w in his belly| strong="H990" \w*, [he shall not save]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8762”} [of that which he desired]{strong=“H2530” x-morph=“strongMorph: \sc Th\sc*8803”}.\f + \fr 20:20 \ft feel: Heb. know \f* 
\v 21 \w There shall none of his meat| strong="H400" \w* \w be left| strong="H8300" \w*; [therefore shall no man look]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8799”} \w for his goods| strong="H2898" \w*.\f + \fr 20:21 \ft none…: or, be none left for his meat \f* 
\v 22 [In the fulness]{strong=“H4390 H4390” x-morph=“strongMorph: \sc Th\sc*8763 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8800”} \w of his sufficiency| strong="H5607" \w* [he shall be in straits]{strong=“H3334” x-morph=“strongMorph: \sc Th\sc*8799”}: \w every hand| strong="H3027" \w* \w of the wicked| strong="H6001" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} upon him.\f + \fr 20:22 \ft wicked: or, troublesome \f* 
\p
\v 23 When [he is about to fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8763”} \w his belly| strong="H990" \w*, God [shall cast]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w the fury| strong="H2740" \w* \w of his wrath| strong="H639" \w* [upon him, and shall rain]{strong=“H4305” x-morph=“strongMorph: \sc Th\sc*8686”} it \w upon him while he is eating| strong="H3894" \w*. 
\v 24 [He shall flee]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8799”} \w from the iron| strong="H1270" \w* \w weapon| strong="H5402" \w*, and \w the bow| strong="H7198" \w* \w of steel| strong="H5154" \w* [shall strike him through]{strong=“H2498” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 25 [It is drawn]{strong=“H8025” x-morph=“strongMorph: \sc Th\sc*8804”}, [and cometh out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the body| strong="H1465" \w*; [yea, the glittering sword]{strong=“H1300”} [cometh out]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8799”} \w of his gall| strong="H4846" \w*: \w terrors| strong="H367" \w* are upon him. 
\v 26 \w All darkness| strong="H2822" \w* shall be [hid]{strong=“H2934” x-morph=“strongMorph: \sc Th\sc*8803”} [in his secret places]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8803”}: \w a fire| strong="H784" \w* [not blown]{strong=“H5301” x-morph=“strongMorph: \sc Th\sc*8795”} [shall consume]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8762”} [him; it shall go ill]{strong=“H3415” x-morph=“strongMorph: \sc Th\sc*8799”} \w with him that is left| strong="H8300" \w* \w in his tabernacle| strong="H168" \w*. 
\v 27 \w The heaven| strong="H8064" \w* [shall reveal]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8762”} \w his iniquity| strong="H5771" \w*; \w and the earth| strong="H776" \w* [shall rise up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8693”} against him. 
\v 28 \w The increase| strong="H2981" \w* \w of his house| strong="H1004" \w* [shall depart]{strong=“H1540” x-morph=“strongMorph: \sc Th\sc*8799”}, and his goods [shall flow away]{strong=“H5064” x-morph=“strongMorph: \sc Th\sc*8737”} \w in the day| strong="H3117" \w* \w of his wrath| strong="H639" \w*. 
\v 29 This is \w the portion| strong="H2506" \w* \w of a wicked| strong="H7563" \w* \w man| strong="H120" \w* \w from God| strong="H430" \w*, \w and the heritage| strong="H5159" \w* \w appointed| strong="H561" \w* \w unto him by God| strong="H410" \w*.\f + \fr 20:29 \ft appointed…: Heb. of his decree from God \f*
\c 21
\p 
\v 1 \w But Job| strong="H347" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 [Hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8798”} [diligently]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w my speech| strong="H4405" \w*, \w and let this be your consolations| strong="H8575" \w*. 
\v 3 [Suffer]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8798”} [me that I may speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”}; \w and after| strong="H310" \w* [that I have spoken]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”}, [mock on]{strong=“H3932” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 4 As for me, is \w my complaint| strong="H7879" \w* \w to man| strong="H120" \w*? and if it were so, \w why should not my spirit| strong="H7307" \w* [be troubled]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8799”}?\f + \fr 21:4 \ft troubled: Heb. shortened? \f* 
\v 5 [Mark]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8798”} [me, and be astonished]{strong=“H8074” x-morph=“strongMorph: \sc Th\sc*8713”}, [and lay]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} your \w hand| strong="H3027" \w* upon your \w mouth| strong="H6310" \w*.\f + \fr 21:5 \ft Mark…: Heb. Look unto me \f* 
\v 6 [Even when I remember]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8804”} [I am afraid]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8738”}, \w and trembling| strong="H6427" \w* [taketh hold on]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8804”} \w my flesh| strong="H1320" \w*. 
\p
\v 7 \w Wherefore do the wicked| strong="H7563" \w* [live]{strong=“H2421” x-morph=“strongMorph: \sc Th\sc*8799”}, [become old]{strong=“H6275” x-morph=“strongMorph: \sc Th\sc*8804”}, [yea, are mighty]{strong=“H1396” x-morph=“strongMorph: \sc Th\sc*8804”} \w in power| strong="H2428" \w*? 
\v 8 \w Their seed| strong="H2233" \w* [is established]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8737”} \w in their sight| strong="H6440" \w* [with them, and their offspring]{strong=“H6631”} \w before their eyes| strong="H5869" \w*. 
\v 9 \w Their houses| strong="H1004" \w* are \w safe| strong="H7965" \w* \w from fear| strong="H6343" \w*, neither is \w the rod| strong="H7626" \w* \w of God| strong="H433" \w* upon them.\f + \fr 21:9 \ft safe…: Heb. peace from \f* 
\v 10 \w Their bull| strong="H7794" \w* [gendereth]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8765”}, [and faileth]{strong=“H1602” x-morph=“strongMorph: \sc Th\sc*8686”} [not; their cow]{strong=“H6510”} [calveth]{strong=“H6403” x-morph=“strongMorph: \sc Th\sc*8762”}, [and casteth not her calf]{strong=“H7921” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 11 [They send forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w their little ones| strong="H5759" \w* \w like a flock| strong="H6629" \w*, \w and their children| strong="H3206" \w* [dance]{strong=“H7540” x-morph=“strongMorph: \sc Th\sc*8762”}. 
\v 12 [They take]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w the timbrel| strong="H8596" \w* \w and harp| strong="H3658" \w*, [and rejoice]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”} \w at the sound| strong="H6963" \w* \w of the organ| strong="H5748" \w*. 
\v 13 [They spend]{strong=“H1086 H3615” x-morph=“strongMorph: \sc Th\sc*8762 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8762”} \w their days| strong="H3117" \w* \w in wealth| strong="H2896" \w*, \w and in a moment| strong="H7281" \w* [go down]{strong=“H5181 H2865” x-morph=“strongMorph: \sc Th\sc*8799 strongMorph: \sc Th\sc*8676 strongMorph: \sc Th\sc*8735”} \w to the grave| strong="H7585" \w*.\f + \fr 21:13 \ft in wealth: or, in mirth \f* 
\v 14 [Therefore they say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto God| strong="H410" \w*, [Depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8798”} [from us; for we desire]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the knowledge| strong="H1847" \w* \w of thy ways| strong="H1870" \w*. 
\v 15 What is \w the Almighty| strong="H7706" \w*, [that we should serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} [him? and what profit]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8686”} [should we have, if we pray]{strong=“H6293” x-morph=“strongMorph: \sc Th\sc*8799”} unto him? 
\v 16 [Lo, their good]{strong=“H2898”} is \w not in their hand| strong="H3027" \w*: \w the counsel| strong="H6098" \w* \w of the wicked| strong="H7563" \w* [is far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8804”} from me. 
\p
\v 17 \w How oft is the candle| strong="H5216" \w* \w of the wicked| strong="H7563" \w* [put out]{strong=“H1846” x-morph=“strongMorph: \sc Th\sc*8799”}! and how oft [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w their destruction| strong="H343" \w* upon them! God [distributeth]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8762”} \w sorrows| strong="H2256" \w* \w in his anger| strong="H639" \w*.\f + \fr 21:17 \ft candle: or, lamp \f* 
\v 18 \w They are as stubble| strong="H8401" \w* \w before| strong="H6440" \w* \w the wind| strong="H7307" \w*, \w and as chaff| strong="H4671" \w* \w that the storm| strong="H5492" \w* [carrieth away]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 21:18 \ft carrieth: Heb. stealeth \f* 
\v 19 \w God| strong="H433" \w* [layeth up]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8799”} \w his iniquity| strong="H205" \w* \w for his children| strong="H1121" \w*: [he rewardeth]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} [him, and he shall know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} it.\f + \fr 21:19 \ft his iniquity: that is, the punishment of his iniquity \f* 
\v 20 \w His eyes| strong="H5869" \w* [shall see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w his destruction| strong="H3589" \w*, [and he shall drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the wrath| strong="H2534" \w* \w of the Almighty| strong="H7706" \w*. 
\v 21 \w For what pleasure| strong="H2656" \w* hath \w he in his house| strong="H1004" \w* \w after| strong="H310" \w* [him, when the number]{strong=“H4557”} \w of his months| strong="H2320" \w* [is cut off in the midst]{strong=“H2686” x-morph=“strongMorph: \sc Th\sc*8795”}? 
\v 22 Shall any [teach]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8762”} \w God| strong="H410" \w* \w knowledge| strong="H1847" \w*? [seeing he judgeth]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} [those that are high]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 23 [One dieth]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w in his full| strong="H8537" \w* \w strength| strong="H6106" \w*, \w being wholly at ease| strong="H7946" \w* \w and quiet| strong="H7961" \w*.\f + \fr 21:23 \ft his…: Heb. his very, or, the strength of, his perfection \f* 
\v 24 \w His breasts| strong="H5845" \w* [are full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of milk| strong="H2461" \w*, \w and his bones| strong="H6106" \w* [are moistened]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8792”} \w with marrow| strong="H4221" \w*.\f + \fr 21:24 \ft breasts: or, milk pails \f* 
\v 25 [And another dieth]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the bitterness| strong="H4751" \w* \w of his soul| strong="H5315" \w*, [and never eateth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”} \w with pleasure| strong="H2896" \w*. 
\v 26 [They shall lie down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”} \w alike| strong="H3162" \w* \w in the dust| strong="H6083" \w*, \w and the worms| strong="H7415" \w* [shall cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} them. 
\p
\v 27 [Behold, I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w your thoughts| strong="H4284" \w*, \w and the devices| strong="H4209" \w* which [ye wrongfully imagine]{strong=“H2554” x-morph=“strongMorph: \sc Th\sc*8799”} against me. 
\v 28 [For ye say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, Where is \w the house| strong="H1004" \w* \w of the prince| strong="H5081" \w*? and where are \w the dwelling| strong="H4908" \w* \w places| strong="H168" \w* \w of the wicked| strong="H7563" \w*?\f + \fr 21:28 \ft the dwelling…: Heb. the tent of the tabernacles \f* 
\v 29 [Have ye not asked]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8804”} [them that go]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8802”} \w by the way| strong="H1870" \w*? [and do ye not know]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8762”} \w their tokens| strong="H226" \w*, 
\v 30 \w That the wicked| strong="H7451" \w* [is reserved]{strong=“H2820” x-morph=“strongMorph: \sc Th\sc*8735”} \w to the day| strong="H3117" \w* \w of destruction| strong="H343" \w*? [they shall be brought forth]{strong=“H2986” x-morph=“strongMorph: \sc Th\sc*8714”} \w to the day| strong="H3117" \w* \w of wrath| strong="H5678" \w*.\f + \fr 21:30 \ft wrath: Heb. wraths \f* 
\v 31 [Who shall declare]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w his way| strong="H1870" \w* \w to his face| strong="H6440" \w*? [and who shall repay]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} him what [he hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}? 
\v 32 [Yet shall he be brought]{strong=“H2986” x-morph=“strongMorph: \sc Th\sc*8714”} \w to the grave| strong="H6913" \w*, [and shall remain]{strong=“H8245” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the tomb| strong="H1430" \w*.\f + \fr 21:32 \ft grave: Heb. graves \f* \f + \fr 21:32 \ft remain…: Heb. watch in the heap \f* 
\v 33 \w The clods| strong="H7263" \w* \w of the valley| strong="H5158" \w* [shall be sweet]{strong=“H4985” x-morph=“strongMorph: \sc Th\sc*8804”} [unto him, and every man]{strong=“H120”} [shall draw]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* him, as there are \w innumerable| strong="H4557" \w* \w before| strong="H6440" \w* him. 
\v 34 [How then comfort]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8762”} \w ye me in vain| strong="H1892" \w*, \w seeing in your answers| strong="H8666" \w* [there remaineth]{strong=“H7604” x-morph=“strongMorph: \sc Th\sc*8738”} \w falsehood| strong="H4604" \w*?\f + \fr 21:34 \ft falsehood: Heb. transgression? \f*
\c 22
\p 
\v 1 \w Then Eliphaz| strong="H464" \w* \w the Temanite| strong="H8489" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 \w Can a man| strong="H1397" \w* [be profitable]{strong=“H5532” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto God| strong="H410" \w*, \w as| strong="H3588" \w* [he that is wise]{strong=“H7919” x-morph=“strongMorph: \sc Th\sc*8688”} [may be profitable]{strong=“H5532” x-morph=“strongMorph: \sc Th\sc*8799”} unto himself?\f + \fr 22:2 \ft as he…: or, if he may be profitable, doth his good success depend thereon? \f* 
\v 3 Is it \w any pleasure| strong="H2656" \w* \w to the Almighty| strong="H7706" \w*, [that thou art righteous]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8799”}? or is it \w gain| strong="H1215" \w* to him, \w that thou makest thy ways| strong="H1870" \w* [perfect]{strong=“H8552” x-morph=“strongMorph: \sc Th\sc*8686”}? 
\v 4 [Will he reprove]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8686”} \w thee for fear| strong="H3374" \w* [of thee? will he enter]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w with thee into judgment| strong="H4941" \w*? 
\p
\v 5 Is \w not thy wickedness| strong="H7451" \w* \w great| strong="H7227" \w*? \w and thine iniquities| strong="H5771" \w* \w infinite| strong="H7093" \w*? 
\v 6 [For thou hast taken a pledge]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8799”} \w from thy brother| strong="H251" \w* \w for nought| strong="H2600" \w*, [and stripped]{strong=“H6584” x-morph=“strongMorph: \sc Th\sc*8686”} \w the naked| strong="H6174" \w* \w of their clothing| strong="H899" \w*.\f + \fr 22:6 \ft the naked…: Heb. the clothes of the naked \f* 
\v 7 \w Thou hast not given water| strong="H4325" \w* \w to the weary| strong="H5889" \w* [to drink]{strong=“H8248” x-morph=“strongMorph: \sc Th\sc*8686”}, [and thou hast withholden]{strong=“H4513” x-morph=“strongMorph: \sc Th\sc*8799”} \w bread| strong="H3899" \w* \w from the hungry| strong="H7457" \w*. 
\v 8 But as for \w the mighty| strong="H2220" \w* \w man| strong="H376" \w*, \w he had the earth| strong="H776" \w*; [and the honourable man]{strong=“H6440 H5375” x-morph=“strongMorph: \sc Th\sc*8803”} [dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} in it.\f + \fr 22:8 \ft mighty…: Heb. man of arm \f* \f + \fr 22:8 \ft honourable…: Heb. eminent, or, accepted for countenance \f* 
\v 9 [Thou hast sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w widows| strong="H490" \w* \w away empty| strong="H7387" \w*, \w and the arms| strong="H2220" \w* \w of the fatherless| strong="H3490" \w* [have been broken]{strong=“H1792” x-morph=“strongMorph: \sc Th\sc*8792”}. 
\v 10 \w Therefore snares| strong="H6341" \w* are \w round about| strong="H5439" \w* [thee, and sudden]{strong=“H6597”} \w fear| strong="H6343" \w* [troubleth]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8762”} thee; 
\v 11 \w Or darkness| strong="H2822" \w*, that [thou canst not see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”}; \w and abundance| strong="H8229" \w* \w of waters| strong="H4325" \w* [cover]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8762”} thee. 
\v 12 Is \w not God| strong="H433" \w* \w in the height| strong="H1363" \w* \w of heaven| strong="H8064" \w*? [and behold]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8798”} \w the height| strong="H7218" \w* \w of the stars| strong="H3556" \w*, [how high]{strong=“H7311” x-morph=“strongMorph: \sc Th\sc*8804”} they are!\f + \fr 22:12 \ft height of the stars: Heb. head of the stars \f* 
\v 13 [And thou sayest]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, \w How doth God| strong="H410" \w* [know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}? [can he judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8799”} \w through the dark cloud| strong="H6205" \w*?\f + \fr 22:13 \ft How: or, What \f* 
\v 14 \w Thick clouds| strong="H5645" \w* are \w a covering| strong="H5643" \w* [to him, that he seeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [not; and he walketh]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8691”} \w in the circuit| strong="H2329" \w* \w of heaven| strong="H8064" \w*. 
\p
\v 15 [Hast thou marked]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} \w the old| strong="H5769" \w* \w way| strong="H734" \w* \w which wicked| strong="H205" \w* \w men| strong="H4962" \w* [have trodden]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8804”}? 
\v 16 [Which were cut down]{strong=“H7059” x-morph=“strongMorph: \sc Th\sc*8795”} \w out of time| strong="H6256" \w*, \w whose foundation| strong="H3247" \w* [was overflown]{strong=“H3332” x-morph=“strongMorph: \sc Th\sc*8714”} \w with a flood| strong="H5104" \w*:\f + \fr 22:16 \ft whose…: Heb. a flood was poured upon their foundation \f* 
\v 17 [Which said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8802”} \w unto God| strong="H410" \w*, [Depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8798”} [from us: and what can the Almighty]{strong=“H7706”} [do]{strong=“H6466” x-morph=“strongMorph: \sc Th\sc*8799”} for them?\f + \fr 22:17 \ft for: or, to \f* 
\v 18 [Yet he filled]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8765”} \w their houses| strong="H1004" \w* \w with good| strong="H2896" \w* things: \w but the counsel| strong="H6098" \w* \w of the wicked| strong="H7563" \w* [is far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8804”} from me. 
\v 19 \w The righteous| strong="H6662" \w* [see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} it, [and are glad]{strong=“H8055” x-morph=“strongMorph: \sc Th\sc*8799”}: \w and the innocent| strong="H5355" \w* [laugh them to scorn]{strong=“H3932” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 20 \w Whereas| strong="H518" \w* \w our substance| strong="H7009" \w* [is not cut down]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8738”}, \w but the remnant| strong="H3499" \w* \w of them the fire| strong="H784" \w* [consumeth]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 22:20 \ft substance: or, estate \f* \f + \fr 22:20 \ft the remnant…: or, their excellency \f* 
\p
\v 21 [Acquaint]{strong=“H5532” x-morph=“strongMorph: \sc Th\sc*8685”} [now thyself with him, and be at peace]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8798”}: \w thereby good| strong="H2896" \w* [shall come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} unto thee.\f + \fr 22:21 \ft him: that is, God \f* 
\v 22 [Receive]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”}, [I pray thee, the law]{strong=“H8451”} \w from his mouth| strong="H6310" \w*, [and lay up]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8798”} \w his words| strong="H561" \w* \w in thine heart| strong="H3824" \w*. 
\v 23 [If thou return]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the Almighty| strong="H7706" \w*, [thou shalt be built up]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8735”}, \w thou shalt put away| strong="H7368" \w* \w iniquity| strong="H5766" \w* [far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8686”} \w from thy tabernacles| strong="H168" \w*. 
\v 24 [Then shalt thou lay up]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8800”} \w gold| strong="H1220" \w* \w as| strong="H5921" \w* \w dust| strong="H6083" \w*, and the gold \w of Ophir| strong="H211" \w* \w as the stones| strong="H6697" \w* \w of the brooks| strong="H5158" \w*.\f + \fr 22:24 \ft as dust: or, on the dust \f* 
\v 25 [Yea, the Almighty]{strong=“H7706”} \w shall be thy defence| strong="H1220" \w*, \w and thou shalt have plenty| strong="H8443" \w* \w of silver| strong="H3701" \w*.\f + \fr 22:25 \ft defence: or, gold \f* \f + \fr 22:25 \ft plenty…: Heb. silver of strength \f* 
\v 26 [For then shalt thou have thy delight]{strong=“H6026” x-morph=“strongMorph: \sc Th\sc*8691”} \w in the Almighty| strong="H7706" \w*, [and shalt lift up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w thy face| strong="H6440" \w* \w unto God| strong="H433" \w*. 
\v 27 [Thou shalt make thy prayer]{strong=“H6279” x-morph=“strongMorph: \sc Th\sc*8686”} [unto him, and he shall hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} [thee, and thou shalt pay]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8762”} \w thy vows| strong="H5088" \w*. 
\v 28 [Thou shalt also decree]{strong=“H1504” x-morph=“strongMorph: \sc Th\sc*8799”} \w a thing| strong="H562" \w*, [and it shall be established]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} [unto thee: and the light]{strong=“H216”} [shall shine]{strong=“H5050” x-morph=“strongMorph: \sc Th\sc*8804”} \w upon thy ways| strong="H1870" \w*. 
\v 29 When men [are cast down]{strong=“H8213” x-morph=“strongMorph: \sc Th\sc*8689”}, [then thou shalt say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, There is \w lifting up| strong="H1466" \w*; [and he shall save]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} \w the humble| strong="H7807" \w* \w person| strong="H5869" \w*.\f + \fr 22:29 \ft the humble…: Heb. him that hath low eyes \f* 
\v 30 [He shall deliver]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8762”} \w the island| strong="H336" \w* \w of the innocent| strong="H5355" \w*: [and it is delivered]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8738”} \w by the pureness| strong="H1252" \w* \w of thine hands| strong="H3709" \w*.\f + \fr 22:30 \ft He shall…: or, The innocent shall deliver the island \f*
\c 23
\p 
\v 1 \w Then Job| strong="H347" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 \w Even to day| strong="H3117" \w* is \w my complaint| strong="H7879" \w* \w bitter| strong="H4805" \w*: \w my stroke| strong="H3027" \w* [is heavier]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8804”} \w than my groaning| strong="H585" \w*.\f + \fr 23:2 \ft stroke: Heb. hand \f* 
\v 3 [Oh that]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} [I knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [where I might find]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8799”} him! that [I might come]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} even \w to his seat| strong="H8499" \w*! 
\v 4 [I would order]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8799”} my \w cause| strong="H4941" \w* \w before| strong="H6440" \w* [him, and fill]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8762”} \w my mouth| strong="H6310" \w* \w with arguments| strong="H8433" \w*. 
\v 5 [I would know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8799”} \w the words| strong="H4405" \w* which [he would answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [me, and understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} [what he would say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto me. 
\v 6 [Will he plead]{strong=“H7378” x-morph=“strongMorph: \sc Th\sc*8799”} \w against| strong="H5978" \w* me with his \w great| strong="H7230" \w* \w power| strong="H3581" \w*? [No; but he would put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} strength in me. 
\v 7 \w There the righteous| strong="H3477" \w* [might dispute]{strong=“H3198” x-morph=“strongMorph: \sc Th\sc*8737”} [with him; so should I be delivered]{strong=“H6403” x-morph=“strongMorph: \sc Th\sc*8762”} \w for ever| strong="H5331" \w* [from my judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\p
\v 8 [Behold, I go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8799”} \w forward| strong="H6924" \w*, but he is not there; \w and backward| strong="H268" \w*, [but I cannot perceive]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8799”} him: 
\v 9 \w On the left hand| strong="H8040" \w*, [where he doth work]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”}, [but I cannot behold]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8799”} him: [he hideth]{strong=“H5848” x-morph=“strongMorph: \sc Th\sc*8799”} \w himself on the right hand| strong="H3225" \w*, [that I cannot see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} him: 
\v 10 [But he knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w the way| strong="H1870" \w* \w that I take| strong="H5978" \w*: when [he hath tried]{strong=“H974” x-morph=“strongMorph: \sc Th\sc*8804”} [me, I shall come forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w as gold| strong="H2091" \w*.\f + \fr 23:10 \ft that…: Heb. that is with me \f* 
\v 11 \w My foot| strong="H7272" \w* [hath held]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8804”} \w his steps| strong="H838" \w*, \w his way| strong="H1870" \w* [have I kept]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”}, [and not declined]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 12 [Neither have I gone back]{strong=“H4185” x-morph=“strongMorph: \sc Th\sc*8686”} \w from the commandment| strong="H4687" \w* \w of his lips| strong="H8193" \w*; [I have esteemed]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8804”} \w the words| strong="H561" \w* \w of his mouth| strong="H6310" \w* \w more than my necessary| strong="H2706" \w* food.\f + \fr 23:12 \ft esteemed: Heb. hid, or, laid up \f* \f + \fr 23:12 \ft my…: or, my appointed portion \f* 
\p
\v 13 But he is \w in one| strong="H259" \w* mind, [and who can turn]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} him? and what \w his soul| strong="H5315" \w* [desireth]{strong=“H183” x-morph=“strongMorph: \sc Th\sc*8765”}, even that [he doeth]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 14 [For he performeth]{strong=“H7999” x-morph=“strongMorph: \sc Th\sc*8686”} the thing that is \w appointed| strong="H2706" \w* [for me: and many]{strong=“H7227”} \w such| strong="H2007" \w* things are with him. 
\v 15 [Therefore am I troubled]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8735”} \w at his presence| strong="H6440" \w*: [when I consider]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8709”}, [I am afraid]{strong=“H6342” x-morph=“strongMorph: \sc Th\sc*8799”} of him. 
\v 16 \w For God| strong="H410" \w* \w maketh my heart| strong="H3820" \w* [soft]{strong=“H7401” x-morph=“strongMorph: \sc Th\sc*8689”}, \w and the Almighty| strong="H7706" \w* [troubleth]{strong=“H926” x-morph=“strongMorph: \sc Th\sc*8689”} me: 
\v 17 [Because I was not cut off]{strong=“H6789” x-morph=“strongMorph: \sc Th\sc*8738”} \w before| strong="H6440" \w* \w the darkness| strong="H2822" \w*, neither [hath he covered]{strong=“H3680” x-morph=“strongMorph: \sc Th\sc*8765”} \w the darkness| strong="H652" \w* \w from my face| strong="H6440" \w*. 
\c 24
\p 
\v 1 [Why, seeing times]{strong=“H6256”} [are not hidden]{strong=“H6845” x-morph=“strongMorph: \sc Th\sc*8738”} \w from the Almighty| strong="H7706" \w*, [do they that know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8802”} [him not see]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8804”} \w his days| strong="H3117" \w*? 
\v 2 Some [remove]{strong=“H5381” x-morph=“strongMorph: \sc Th\sc*8686”} \w the landmarks| strong="H1367" \w*; [they violently take away]{strong=“H1497” x-morph=“strongMorph: \sc Th\sc*8804”} \w flocks| strong="H5739" \w*, [and feed]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8799”} thereof.\f + \fr 24:2 \ft feed…: or, feed them \f* 
\v 3 [They drive away]{strong=“H5090” x-morph=“strongMorph: \sc Th\sc*8799”} \w the ass| strong="H2543" \w* \w of the fatherless| strong="H3490" \w*, \w they take| strong="H2254" \w* [the widow’s]{strong=“H490”} \w ox| strong="H7794" \w* [for a pledge]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 4 [They turn]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8686”} \w the needy| strong="H34" \w* \w out of the way| strong="H1870" \w*: [the poor]{strong=“H6035 H6041” x-morph=“strongMorph: \sc Th\sc*8675”} \w of the earth| strong="H776" \w* [hide]{strong=“H2244” x-morph=“strongMorph: \sc Th\sc*8795”} \w themselves together| strong="H3162" \w*. 
\v 5 Behold, as \w wild asses| strong="H6501" \w* \w in the desert| strong="H4057" \w*, [go they forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} \w to their work| strong="H6467" \w*; [rising betimes]{strong=“H7836” x-morph=“strongMorph: \sc Th\sc*8764”} \w for a prey| strong="H2964" \w*: \w the wilderness| strong="H6160" \w* yieldeth \w food| strong="H3899" \w* for them and for their \w children| strong="H5288" \w*. 
\v 6 [They reap]{strong=“H7114 H7114” x-morph=“strongMorph: \sc Th\sc*8686 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8799”} every one \w his corn| strong="H1098" \w* \w in the field| strong="H7704" \w*: [and they gather]{strong=“H3953” x-morph=“strongMorph: \sc Th\sc*8762”} \w the vintage| strong="H3754" \w* \w of the wicked| strong="H7563" \w*.\f + \fr 24:6 \ft corn: Heb. mingled corn, or, dredge \f* \f + \fr 24:6 \ft they gather…: Heb. the wicked gather the vintage \f* 
\v 7 \w They cause the naked| strong="H6174" \w* [to lodge]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8686”} \w without clothing| strong="H3830" \w*, that they have \w no covering| strong="H3682" \w* \w in the cold| strong="H7135" \w*. 
\v 8 [They are wet]{strong=“H7372” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the showers| strong="H2230" \w* \w of the mountains| strong="H2022" \w*, [and embrace]{strong=“H2263” x-morph=“strongMorph: \sc Th\sc*8765”} \w the rock| strong="H6697" \w* \w for want of a shelter| strong="H4268" \w*. 
\v 9 [They pluck]{strong=“H1497” x-morph=“strongMorph: \sc Th\sc*8799”} \w the fatherless| strong="H3490" \w* \w from the breast| strong="H7699" \w*, [and take a pledge]{strong=“H2254” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the poor| strong="H6041" \w*. 
\v 10 They cause him [to go]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8765”} \w naked| strong="H6174" \w* \w without clothing| strong="H3830" \w*, [and they take away]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8804”} \w the sheaf| strong="H6016" \w* from \w the hungry| strong="H7457" \w*; 
\v 11 Which [make oil]{strong=“H6671” x-morph=“strongMorph: \sc Th\sc*8686”} \w within| strong="H996" \w* \w their walls| strong="H7791" \w*, and [tread]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8804”} their \w winepresses| strong="H3342" \w*, [and suffer thirst]{strong=“H6770” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 12 \w Men| strong="H4962" \w* [groan]{strong=“H5008” x-morph=“strongMorph: \sc Th\sc*8799”} \w from out of the city| strong="H5892" \w*, \w and the soul| strong="H5315" \w* \w of the wounded| strong="H2491" \w* [crieth out]{strong=“H7768” x-morph=“strongMorph: \sc Th\sc*8762”}: \w yet God| strong="H433" \w* [layeth]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w not folly| strong="H8604" \w* to them. 
\p
\v 13 [They are of those that rebel]{strong=“H4775” x-morph=“strongMorph: \sc Th\sc*8802”} \w against the light| strong="H216" \w*; [they know]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8689”} \w not the ways| strong="H1870" \w* [thereof, nor abide]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the paths| strong="H5410" \w* thereof. 
\v 14 [The murderer]{strong=“H7523” x-morph=“strongMorph: \sc Th\sc*8802”} [rising]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the light| strong="H216" \w* [killeth]{strong=“H6991” x-morph=“strongMorph: \sc Th\sc*8799”} \w the poor| strong="H6041" \w* \w and needy| strong="H34" \w*, \w and in the night| strong="H3915" \w* \w is as a thief| strong="H1590" \w*. 
\v 15 \w The eye| strong="H5869" \w* [also of the adulterer]{strong=“H5003” x-morph=“strongMorph: \sc Th\sc*8802”} [waiteth]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} \w for the twilight| strong="H5399" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w No eye| strong="H5869" \w* [shall see]{strong=“H7789” x-morph=“strongMorph: \sc Th\sc*8799”} [me: and disguiseth]{strong=“H7760 H5643” x-morph=“strongMorph: \sc Th\sc*8799”} his \w face| strong="H6440" \w*.\f + \fr 24:15 \ft disguiseth…: Heb. setteth his face in secret \f* 
\v 16 \w In the dark| strong="H2822" \w* [they dig through]{strong=“H2864” x-morph=“strongMorph: \sc Th\sc*8804”} \w houses| strong="H1004" \w*, which [they had marked]{strong=“H2856” x-morph=“strongMorph: \sc Th\sc*8765”} \w for themselves in the daytime| strong="H3119" \w*: [they know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the light| strong="H216" \w*. 
\v 17 \w For the morning| strong="H1242" \w* is \w to them even as| strong="H3162" \w* \w the shadow of death| strong="H6757" \w*: if one [know]{strong=“H5234” x-morph=“strongMorph: \sc Th\sc*8686”} them, they are in \w the terrors| strong="H1091" \w* \w of the shadow of death| strong="H6757" \w*. 
\p
\v 18 He is \w swift| strong="H7031" \w* [as the waters]{strong=“H4325 H6440”}; \w their portion| strong="H2513" \w* [is cursed]{strong=“H7043” x-morph=“strongMorph: \sc Th\sc*8792”} \w in the earth| strong="H776" \w*: [he beholdeth]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8799”} \w not the way| strong="H1870" \w* \w of the vineyards| strong="H3754" \w*. 
\v 19 \w Drought| strong="H6723" \w* \w and heat| strong="H2527" \w* [consume]{strong=“H1497” x-morph=“strongMorph: \sc Th\sc*8799”} \w the snow| strong="H7950" \w* \w waters| strong="H4325" \w*: so doth \w the grave| strong="H7585" \w* those which [have sinned]{strong=“H2398” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 24:19 \ft consume: Heb. violently take \f* 
\v 20 \w The womb| strong="H7358" \w* [shall forget]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} [him; the worm]{strong=“H7415”} [shall feed sweetly]{strong=“H4988” x-morph=“strongMorph: \sc Th\sc*8804”} [on him; he shall be no more remembered]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8735”}; \w and wickedness| strong="H5766" \w* [shall be broken]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8735”} \w as a tree| strong="H6086" \w*. 
\v 21 [He evil entreateth]{strong=“H7462” x-morph=“strongMorph: \sc Th\sc*8802”} \w the barren| strong="H6135" \w* that [beareth]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8799”} [not: and doeth not good]{strong=“H3190” x-morph=“strongMorph: \sc Th\sc*8686”} \w to the widow| strong="H490" \w*. 
\v 22 [He draweth]{strong=“H4900” x-morph=“strongMorph: \sc Th\sc*8804”} \w also the mighty| strong="H47" \w* \w with his power| strong="H3581" \w*: [he riseth up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, and no man [is sure]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”} \w of life| strong="H2416" \w*.\f + \fr 24:22 \ft no…: or, he trusteth not his own life \f* 
\v 23 Though [it be given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} him to be \w in safety| strong="H983" \w*, [whereon he resteth]{strong=“H8172” x-morph=“strongMorph: \sc Th\sc*8735”}; \w yet his eyes| strong="H5869" \w* are \w upon their ways| strong="H1870" \w*. 
\v 24 [They are exalted]{strong=“H7426” x-morph=“strongMorph: \sc Th\sc*8804”} \w for a little while| strong="H4592" \w*, [but are gone and brought low]{strong=“H4355” x-morph=“strongMorph: \sc Th\sc*8717”}; [they are taken out]{strong=“H7092” x-morph=“strongMorph: \sc Th\sc*8735”} \w of the way| strong="H1870" \w* as all other, [and cut off]{strong=“H5243” x-morph=“strongMorph: \sc Th\sc*8799”} \w as the tops| strong="H7218" \w* \w of the ears of corn| strong="H7641" \w*.\f + \fr 24:24 \ft are gone: Heb. are not \f* \f + \fr 24:24 \ft taken…: Heb. closed up \f* 
\v 25 And if it be not so \w now| strong="H645" \w*, [who will make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} [me a liar]{strong=“H3576” x-morph=“strongMorph: \sc Th\sc*8686”}, [and make]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w my speech| strong="H4405" \w* \w nothing worth| strong="H408" \w*?
\c 25
\p 
\v 1 [Then answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} \w Bildad| strong="H1085" \w* \w the Shuhite| strong="H7747" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 [Dominion]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8687”} \w and fear| strong="H6343" \w* are [with him, he maketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w peace| strong="H7965" \w* \w in his high places| strong="H4791" \w*. 
\v 3 \w Is there| strong="H3426" \w* \w any number| strong="H4557" \w* \w of his armies| strong="H1416" \w*? \w and upon whom doth not his light| strong="H216" \w* [arise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}? 
\v 4 \w How then can man| strong="H582" \w* [be justified]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8799”} \w with God| strong="H410" \w*? [or how can he be clean]{strong=“H2135” x-morph=“strongMorph: \sc Th\sc*8799”} that is [born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8803”} \w of a woman| strong="H802" \w*? 
\v 5 \w Behold even to the moon| strong="H3394" \w*, [and it shineth]{strong=“H166” x-morph=“strongMorph: \sc Th\sc*8686”} [not; yea, the stars]{strong=“H3556”} [are not pure]{strong=“H2141” x-morph=“strongMorph: \sc Th\sc*8804”} \w in his sight| strong="H5869" \w*. 
\v 6 \w How much less man| strong="H582" \w*, that is \w a worm| strong="H7415" \w*? \w and the son| strong="H1121" \w* \w of man| strong="H120" \w*, which is \w a worm| strong="H8438" \w*? 
\c 26
\p 
\v 1 \w But Job| strong="H347" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, 
\v 2 [How hast thou helped]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8804”} him that is \w without power| strong="H3581" \w*? how [savest]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8689”} \w thou the arm| strong="H2220" \w* that hath \w no| strong="H3808" \w* \w strength| strong="H5797" \w*? 
\v 3 [How hast thou counselled]{strong=“H3289” x-morph=“strongMorph: \sc Th\sc*8804”} him that hath \w no| strong="H3808" \w* \w wisdom| strong="H2451" \w*? and how \w hast thou plentifully| strong="H7230" \w* [declared]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8689”} \w the thing as it is| strong="H8454" \w*? 
\v 4 [To whom hast thou uttered]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} \w words| strong="H4405" \w*? \w and whose spirit| strong="H5397" \w* [came]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”} from thee? 
\p
\v 5 \w Dead| strong="H7496" \w* things [are formed]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8787”} \w from under the waters| strong="H4325" \w*, [and the inhabitants]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8802”} thereof.\f + \fr 26:5 \ft and the…: or, with the inhabitants \f* 
\v 6 \w Hell| strong="H7585" \w* is \w naked| strong="H6174" \w* [before him, and destruction]{strong=“H11”} \w hath no covering| strong="H3682" \w*. 
\v 7 [He stretcheth out]{strong=“H5186” x-morph=“strongMorph: \sc Th\sc*8802”} \w the north| strong="H6828" \w* \w over the empty place| strong="H8414" \w*, and [hangeth]{strong=“H8518” x-morph=“strongMorph: \sc Th\sc*8802”} \w the earth| strong="H776" \w* \w upon nothing| strong="H1099" \w*. 
\v 8 [He bindeth up]{strong=“H6887” x-morph=“strongMorph: \sc Th\sc*8802”} \w the waters| strong="H4325" \w* \w in his thick clouds| strong="H5645" \w*; \w and the cloud| strong="H6051" \w* [is not rent]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8738”} under them. 
\v 9 [He holdeth back]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8764”} \w the face| strong="H6440" \w* \w of his throne| strong="H3678" \w*, and [spreadeth]{strong=“H6576” x-morph=“strongMorph: \sc Th\sc*8768”} \w his cloud| strong="H6051" \w* upon it. 
\v 10 [He hath compassed]{strong=“H2328” x-morph=“strongMorph: \sc Th\sc*8804”} [the waters]{strong=“H4325 H6440”} \w with bounds| strong="H2706" \w*, \w until the day| strong="H216" \w* \w and night| strong="H2822" \w* \w come to an end| strong="H8503" \w*.\f + \fr 26:10 \ft until…: Heb. until the end of light with darkness \f* 
\v 11 \w The pillars| strong="H5982" \w* \w of heaven| strong="H8064" \w* [tremble]{strong=“H7322” x-morph=“strongMorph: \sc Th\sc*8787”} [and are astonished]{strong=“H8539” x-morph=“strongMorph: \sc Th\sc*8799”} \w at his reproof| strong="H1606" \w*. 
\v 12 [He divideth]{strong=“H7280” x-morph=“strongMorph: \sc Th\sc*8804”} \w the sea| strong="H3220" \w* \w with his power| strong="H3581" \w*, [and by his understanding]{strong=“H8394 H8394” x-morph=“strongMorph: \sc Th\sc*8675”} [he smiteth]{strong=“H4272” x-morph=“strongMorph: \sc Th\sc*8804”} \w through the proud| strong="H7293" \w*.\f + \fr 26:12 \ft the proud: Heb. pride \f* 
\v 13 \w By his spirit| strong="H7307" \w* [he hath garnished]{strong=“H8235” x-morph=“strongMorph: \sc Th\sc*8765”} \w the heavens| strong="H8064" \w*; \w his hand| strong="H3027" \w* [hath formed]{strong=“H2342” x-morph=“strongMorph: \sc Th\sc*8790”} \w the crooked| strong="H1281" \w* \w serpent| strong="H5175" \w*. 
\v 14 Lo, these are \w parts| strong="H7098" \w* \w of his ways| strong="H1870" \w*: \w but how little| strong="H8102" \w* \w a portion| strong="H1697" \w* [is heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8738”} [of him? but the thunder]{strong=“H7482”} \w of his power| strong="H1369" \w* [who can understand]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8709”}?
\c 27
\p 
\v 1 \w Moreover Job| strong="H347" \w* [continued]{strong=“H5375 H3254” x-morph=“strongMorph: \sc Th\sc*8800 strongMorph: \sc Th\sc*8686”} \w his parable| strong="H4912" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”},\f + \fr 27:1 \ft continued: Heb. added to take up \f* 
\v 2 As \w God| strong="H410" \w* \w liveth| strong="H2416" \w*, who [hath taken away]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8689”} \w my judgment| strong="H4941" \w*; \w and the Almighty| strong="H7706" \w*, who [hath vexed]{strong=“H4843” x-morph=“strongMorph: \sc Th\sc*8689”} \w my soul| strong="H5315" \w*;\f + \fr 27:2 \ft vexed…: Heb. made my soul bitter \f* 
\v 3 \w All the while| strong="H5750" \w* \w my breath| strong="H5397" \w* is [in me, and the spirit]{strong=“H7307”} \w of God| strong="H433" \w* is \w in my nostrils| strong="H639" \w*;\f + \fr 27:3 \ft the spirit…: that is, the breath which God gave him \f* 
\v 4 \w My lips| strong="H8193" \w* [shall not speak]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w wickedness| strong="H5766" \w*, \w nor my tongue| strong="H3956" \w* [utter]{strong=“H1897” x-morph=“strongMorph: \sc Th\sc*8799”} \w deceit| strong="H7423" \w*. 
\v 5 \w God forbid| strong="H2486" \w* [that I should justify]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8686”} [you: till I die]{strong=“H1478” x-morph=“strongMorph: \sc Th\sc*8799”} [I will not remove]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8686”} \w mine integrity| strong="H8538" \w* from me. 
\v 6 \w My righteousness| strong="H6666" \w* [I hold]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8689”} [fast, and will not let it go]{strong=“H7503” x-morph=“strongMorph: \sc Th\sc*8686”}: \w my heart| strong="H3824" \w* [shall not reproach]{strong=“H2778” x-morph=“strongMorph: \sc Th\sc*8799”} me \w so long as I live| strong="H3117" \w*.\f + \fr 27:6 \ft so long…: Heb. from my days \f* 
\p
\v 7 [Let mine enemy]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w be as the wicked| strong="H7563" \w*, [and he that riseth up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8693”} \w against me as the unrighteous| strong="H5767" \w*. 
\v 8 For what is \w the hope| strong="H8615" \w* \w of the hypocrite| strong="H2611" \w*, [though he hath gained]{strong=“H1214” x-morph=“strongMorph: \sc Th\sc*8799”}, \w when God| strong="H433" \w* [taketh away]{strong=“H7953” x-morph=“strongMorph: \sc Th\sc*8799”} \w his soul| strong="H5315" \w*? 
\v 9 \w Will God| strong="H410" \w* [hear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w his cry| strong="H6818" \w* \w when trouble| strong="H6869" \w* [cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} upon him? 
\v 10 [Will he delight]{strong=“H6026” x-morph=“strongMorph: \sc Th\sc*8691”} \w himself in the Almighty| strong="H7706" \w*? \w will he always| strong="H6256" \w* [call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon God| strong="H433" \w*? 
\p
\v 11 [I will teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”} \w you by the hand| strong="H3027" \w* \w of God| strong="H410" \w*: that which is \w with the Almighty| strong="H7706" \w* [will I not conceal]{strong=“H3582” x-morph=“strongMorph: \sc Th\sc*8762”}.\f + \fr 27:11 \ft by…: or, being in the hand, etc \f* 
\v 12 [Behold, all ye yourselves have seen]{strong=“H2372” x-morph=“strongMorph: \sc Th\sc*8804”} it; \w why then are ye thus altogether| strong="H1892" \w* [vain]{strong=“H1891” x-morph=“strongMorph: \sc Th\sc*8799”}? 
\v 13 This is \w the portion| strong="H2506" \w* \w of a wicked| strong="H7563" \w* \w man| strong="H120" \w* \w with God| strong="H410" \w*, \w and the heritage| strong="H5159" \w* \w of oppressors| strong="H6184" \w*, which [they shall receive]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the Almighty| strong="H7706" \w*. 
\v 14 \w If his children| strong="H1121" \w* [be multiplied]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8799”}, it is \w for| strong="H3926" \w* \w the sword| strong="H2719" \w*: \w and his offspring| strong="H6631" \w* [shall not be satisfied]{strong=“H7646” x-morph=“strongMorph: \sc Th\sc*8799”} \w with bread| strong="H3899" \w*. 
\v 15 \w Those that remain| strong="H8300" \w* [of him shall be buried]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8735”} \w in death| strong="H4194" \w*: \w and his widows| strong="H490" \w* [shall not weep]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 16 [Though he heap up]{strong=“H6651” x-morph=“strongMorph: \sc Th\sc*8799”} \w silver| strong="H3701" \w* \w as the dust| strong="H6083" \w*, [and prepare]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8686”} \w raiment| strong="H4403" \w* \w as the clay| strong="H2563" \w*; 
\v 17 [He may prepare]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8686”} it, \w but the just| strong="H6662" \w* shall put it [on]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and the innocent| strong="H5355" \w* [shall divide]{strong=“H2505” x-morph=“strongMorph: \sc Th\sc*8799”} \w the silver| strong="H3701" \w*. 
\v 18 [He buildeth]{strong=“H1129” x-morph=“strongMorph: \sc Th\sc*8804”} \w his house| strong="H1004" \w* \w as a moth| strong="H6211" \w*, \w and as a booth| strong="H5521" \w* that [the keeper]{strong=“H5341” x-morph=“strongMorph: \sc Th\sc*8802”} [maketh]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 19 \w The rich| strong="H6223" \w* [man shall lie down]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”}, [but he shall not be gathered]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8735”}: [he openeth]{strong=“H6491” x-morph=“strongMorph: \sc Th\sc*8804”} \w his eyes| strong="H5869" \w*, and he is not. 
\v 20 \w Terrors| strong="H1091" \w* [take hold]{strong=“H5381” x-morph=“strongMorph: \sc Th\sc*8686”} \w on him as waters| strong="H4325" \w*, \w a tempest| strong="H5492" \w* [stealeth him away]{strong=“H1589” x-morph=“strongMorph: \sc Th\sc*8804”} \w in the night| strong="H3915" \w*. 
\v 21 \w The east| strong="H6921" \w* [wind carrieth him away]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”}, [and he departeth]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”}: [and as a storm hurleth]{strong=“H8175” x-morph=“strongMorph: \sc Th\sc*8762”} \w him out of his place| strong="H4725" \w*. 
\v 22 For God [shall cast]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} [upon him, and not spare]{strong=“H2550” x-morph=“strongMorph: \sc Th\sc*8799”}: [he would fain]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8800”} [flee]{strong=“H1272” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of his hand| strong="H3027" \w*.\f + \fr 27:22 \ft he…: Heb. in fleeing he would flee \f* 
\v 23 Men [shall clap]{strong=“H5606” x-morph=“strongMorph: \sc Th\sc*8799”} \w their hands| strong="H3709" \w* [at him, and shall hiss]{strong=“H8319” x-morph=“strongMorph: \sc Th\sc*8799”} \w him out of his place| strong="H4725" \w*.
\c 28
\p 
\v 1 \w Surely| strong="H3426" \w* \w there is a vein| strong="H4161" \w* \w for the silver| strong="H3701" \w*, \w and a place| strong="H4725" \w* \w for gold| strong="H2091" \w* where [they fine]{strong=“H2212” x-morph=“strongMorph: \sc Th\sc*8799”} it.\f + \fr 28:1 \ft vein: or, mine \f* 
\v 2 \w Iron| strong="H1270" \w* [is taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8714”} \w out of the earth| strong="H6083" \w*, \w and brass| strong="H5154" \w* is [molten]{strong=“H6694” x-morph=“strongMorph: \sc Th\sc*8799”} out of \w the stone| strong="H68" \w*.\f + \fr 28:2 \ft earth: or, dust \f* 
\v 3 [He setteth]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w an end| strong="H7093" \w* \w to darkness| strong="H2822" \w*, [and searcheth out]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8802”} \w all perfection| strong="H8503" \w*: \w the stones| strong="H68" \w* \w of darkness| strong="H652" \w*, \w and the shadow of death| strong="H6757" \w*. 
\v 4 \w The flood| strong="H5158" \w* [breaketh out]{strong=“H6555” x-morph=“strongMorph: \sc Th\sc*8804”} [from the inhabitant]{strong=“H1481” x-morph=“strongMorph: \sc Th\sc*8802”}; even the waters [forgotten]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8737”} \w of the foot| strong="H7272" \w*: [they are dried up]{strong=“H1809” x-morph=“strongMorph: \sc Th\sc*8804”}, [they are gone away]{strong=“H5128” x-morph=“strongMorph: \sc Th\sc*8804”} \w from men| strong="H582" \w*. 
\v 5 As for \w the earth| strong="H776" \w*, [out of it cometh]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w bread| strong="H3899" \w*: [and under it is turned up]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8738”} \w as it were fire| strong="H784" \w*. 
\v 6 \w The stones| strong="H68" \w* of it are \w the place| strong="H4725" \w* \w of sapphires| strong="H5601" \w*: \w and it hath dust| strong="H6083" \w* \w of gold| strong="H2091" \w*.\f + \fr 28:6 \ft dust…: or, gold ore \f* 
\v 7 There is \w a path| strong="H5410" \w* \w which no fowl| strong="H5861" \w* [knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”}, [and which the vulture’s]{strong=“H344”} \w eye| strong="H5869" \w* [hath not seen]{strong=“H7805” x-morph=“strongMorph: \sc Th\sc*8804”}: 
\v 8 [The lion’s]{strong=“H7830”} \w whelps| strong="H1121" \w* [have not trodden]{strong=“H1869” x-morph=“strongMorph: \sc Th\sc*8689”} [it, nor the fierce lion]{strong=“H7826”} [passed]{strong=“H5710” x-morph=“strongMorph: \sc Th\sc*8804”} by it. 
\v 9 [He putteth forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} \w his hand| strong="H3027" \w* \w upon the rock| strong="H2496" \w*; [he overturneth]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8804”} \w the mountains| strong="H2022" \w* \w by the roots| strong="H8328" \w*.\f + \fr 28:9 \ft rock: or, flint \f* 
\v 10 [He cutteth out]{strong=“H1234” x-morph=“strongMorph: \sc Th\sc*8765”} \w rivers| strong="H2975" \w* \w among the rocks| strong="H6697" \w*; \w and his eye| strong="H5869" \w* [seeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w every precious thing| strong="H3366" \w*. 
\v 11 [He bindeth]{strong=“H2280” x-morph=“strongMorph: \sc Th\sc*8765”} \w the floods| strong="H5104" \w* \w from overflowing| strong="H1065" \w*; and the thing that is \w hid| strong="H8587" \w* [bringeth he forth]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8686”} \w to light| strong="H216" \w*.\f + \fr 28:11 \ft overflowing: Heb. weeping \f* 
\v 12 \w But where| strong="H370" \w* \w shall wisdom| strong="H2451" \w* [be found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”}? and where is \w the place| strong="H4725" \w* \w of understanding| strong="H998" \w*? 
\v 13 \w Man| strong="H582" \w* [knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w not the price| strong="H6187" \w* [thereof; neither is it found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8735”} \w in the land| strong="H776" \w* \w of the living| strong="H2416" \w*. 
\p
\v 14 \w The depth| strong="H8415" \w* [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, It is [not in me: and the sea]{strong=“H3220”} [saith]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, It is not with me. 
\v 15 [It cannot be gotten]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8714”} \w for gold| strong="H5458" \w*, \w neither shall silver| strong="H3701" \w* [be weighed]{strong=“H8254” x-morph=“strongMorph: \sc Th\sc*8735”} for \w the price| strong="H4242" \w* thereof.\f + \fr 28:15 \ft It…: Heb. Fine gold shall not be given for it \f* 
\v 16 [It cannot be valued]{strong=“H5541” x-morph=“strongMorph: \sc Th\sc*8792”} \w with the gold| strong="H3800" \w* \w of Ophir| strong="H211" \w*, \w with the precious| strong="H3368" \w* \w onyx| strong="H7718" \w*, \w or the sapphire| strong="H5601" \w*. 
\v 17 \w The gold| strong="H2091" \w* \w and the crystal| strong="H2137" \w* [cannot equal]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8799”} [it: and the exchange]{strong=“H8545”} of it shall not be for \w jewels| strong="H3627" \w* \w of fine gold| strong="H6337" \w*.\f + \fr 28:17 \ft jewels…: or, vessels of \f* 
\v 18 [No mention]{strong=“H2142” x-morph=“strongMorph: \sc Th\sc*8735”} \w shall be made of coral| strong="H7215" \w*, \w or of pearls| strong="H1378" \w*: \w for the price| strong="H4901" \w* \w of wisdom| strong="H2451" \w* is \w above rubies| strong="H6443" \w*.\f + \fr 28:18 \ft coral: or, Ramoth \f* 
\v 19 \w The topaz| strong="H6357" \w* \w of Ethiopia| strong="H3568" \w* [shall not equal]{strong=“H6186” x-morph=“strongMorph: \sc Th\sc*8799”} [it, neither shall it be valued]{strong=“H5541” x-morph=“strongMorph: \sc Th\sc*8792”} \w with pure| strong="H2889" \w* \w gold| strong="H3800" \w*. 
\p
\v 20 \w Whence| strong="H370" \w* [then cometh]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w wisdom| strong="H2451" \w*? and where is \w the place| strong="H4725" \w* \w of understanding| strong="H998" \w*? 
\v 21 [Seeing it is hid]{strong=“H5956” x-morph=“strongMorph: \sc Th\sc*8738”} \w from the eyes| strong="H5869" \w* \w of all living| strong="H2416" \w*, [and kept close]{strong=“H5641” x-morph=“strongMorph: \sc Th\sc*8738”} \w from the fowls| strong="H5775" \w* \w of the air| strong="H8064" \w*.\f + \fr 28:21 \ft air: or, heaven \f* 
\v 22 \w Destruction| strong="H11" \w* \w and death| strong="H4194" \w* [say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [We have heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w the fame| strong="H8088" \w* \w thereof with our ears| strong="H241" \w*. 
\v 23 \w God| strong="H430" \w* [understandeth]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8689”} \w the way| strong="H1870" \w* [thereof, and he knoweth]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w the place| strong="H4725" \w* thereof. 
\v 24 [For he looketh]{strong=“H5027” x-morph=“strongMorph: \sc Th\sc*8686”} \w to the ends| strong="H7098" \w* \w of the earth| strong="H776" \w*, and [seeth]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w under the whole heaven| strong="H8064" \w*; 
\v 25 [To make]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w the weight| strong="H4948" \w* \w for the winds| strong="H7307" \w*; [and he weigheth]{strong=“H8505” x-morph=“strongMorph: \sc Th\sc*8765”} \w the waters| strong="H4325" \w* \w by measure| strong="H4060" \w*. 
\v 26 [When he made]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w a decree| strong="H2706" \w* \w for the rain| strong="H4306" \w*, \w and a way| strong="H1870" \w* \w for the lightning| strong="H2385" \w* \w of the thunder| strong="H6963" \w*: 
\v 27 [Then did he see]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} [it, and declare]{strong=“H5608” x-morph=“strongMorph: \sc Th\sc*8762”} [it; he prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8689”} [it, yea, and searched it out]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 28:27 \ft declare…: or, number it \f* 
\v 28 \w And unto man| strong="H120" \w* [he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Behold, the fear]{strong=“H3374”} \w of the Lord| strong="H136" \w*, that is \w wisdom| strong="H2451" \w*; [and to depart]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8800”} \w from evil| strong="H7451" \w* is \w understanding| strong="H998" \w*.
\c 29
\p 
\v 1 \w Moreover Job| strong="H347" \w* [continued]{strong=“H5375 H3254” x-morph=“strongMorph: \sc Th\sc*8800 strongMorph: \sc Th\sc*8686”} \w his parable| strong="H4912" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”},\f + \fr 29:1 \ft continued: Heb. added to take up \f* 
\v 2 [Oh that]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} I were as in \w months| strong="H3391" \w* \w past| strong="H6924" \w*, as in \w the days| strong="H3117" \w* when \w God| strong="H433" \w* [preserved]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”} me; 
\v 3 \w When his candle| strong="H5216" \w* [shined]{strong=“H1984” x-morph=“strongMorph: \sc Th\sc*8800”} \w upon my head| strong="H7218" \w*, and when \w by his light| strong="H216" \w* [I walked]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} through \w darkness| strong="H2822" \w*;\f + \fr 29:3 \ft candle: or, lamp \f* 
\v 4 \w As I was in the days| strong="H3117" \w* \w of my youth| strong="H2779" \w*, \w when the secret| strong="H5475" \w* \w of God| strong="H433" \w* was \w upon my tabernacle| strong="H168" \w*; 
\v 5 \w When the Almighty| strong="H7706" \w* was yet with me, when \w my children| strong="H5288" \w* were \w about| strong="H5439" \w* me; 
\v 6 [When I washed]{strong=“H7364” x-morph=“strongMorph: \sc Th\sc*8800”} \w my steps| strong="H1978" \w* \w with butter| strong="H2529" \w*, \w and the rock| strong="H6697" \w* [poured me out]{strong=“H6694” x-morph=“strongMorph: \sc Th\sc*8799”} \w rivers| strong="H6388" \w* \w of oil| strong="H8081" \w*;\f + \fr 29:6 \ft me: Heb. with me \f* 
\p
\v 7 [When I went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8800”} \w to the gate| strong="H8179" \w* \w through the city| strong="H7176" \w*, when [I prepared]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8686”} \w my seat| strong="H4186" \w* \w in the street| strong="H7339" \w*! 
\v 8 \w The young men| strong="H5288" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} [me, and hid]{strong=“H2244” x-morph=“strongMorph: \sc Th\sc*8738”} [themselves: and the aged]{strong=“H3453”} [arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8804”}, and [stood up]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”}. 
\v 9 \w The princes| strong="H8269" \w* [refrained]{strong=“H6113” x-morph=“strongMorph: \sc Th\sc*8804”} \w talking| strong="H4405" \w*, [and laid]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} their \w hand| strong="H3709" \w* \w on their mouth| strong="H6310" \w*. 
\v 10 \w The nobles| strong="H5057" \w* [held]{strong=“H2244” x-morph=“strongMorph: \sc Th\sc*8738”} \w their peace| strong="H6963" \w*, \w and their tongue| strong="H3956" \w* [cleaved]{strong=“H1692” x-morph=“strongMorph: \sc Th\sc*8804”} \w to the roof of their mouth| strong="H2441" \w*.\f + \fr 29:10 \ft The nobles…: Heb. The voice of the nobles was hid \f* 
\v 11 \w When the ear| strong="H241" \w* [heard]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} me, [then it blessed]{strong=“H833” x-morph=“strongMorph: \sc Th\sc*8762”} [me; and when the eye]{strong=“H5869”} [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} me, [it gave witness]{strong=“H5749” x-morph=“strongMorph: \sc Th\sc*8686”} to me: 
\v 12 [Because I delivered]{strong=“H4422” x-morph=“strongMorph: \sc Th\sc*8762”} \w the poor| strong="H6041" \w* [that cried]{strong=“H7768” x-morph=“strongMorph: \sc Th\sc*8764”}, \w and the fatherless| strong="H3490" \w*, and him that had [none to help]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8802”} him. 
\v 13 \w The blessing| strong="H1293" \w* [of him that was ready to perish]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8802”} [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [upon me: and I caused the widow’s]{strong=“H490”} \w heart| strong="H3820" \w* [to sing for joy]{strong=“H7442” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 14 [I put]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8804”} \w on righteousness| strong="H6664" \w*, [and it clothed]{strong=“H3847” x-morph=“strongMorph: \sc Th\sc*8799”} [me: my judgment]{strong=“H4941”} was \w as a robe| strong="H4598" \w* \w and a diadem| strong="H6797" \w*. 
\v 15 \w I was eyes| strong="H5869" \w* \w to the blind| strong="H5787" \w*, \w and feet| strong="H7272" \w* was \w I to the lame| strong="H6455" \w*. 
\v 16 I was \w a father| strong="H1" \w* \w to the poor| strong="H34" \w*: \w and the cause| strong="H7379" \w* which [I knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} [not I searched out]{strong=“H2713” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 17 [And I brake]{strong=“H7665” x-morph=“strongMorph: \sc Th\sc*8762”} \w the jaws| strong="H4973" \w* \w of the wicked| strong="H5767" \w*, [and plucked]{strong=“H7993” x-morph=“strongMorph: \sc Th\sc*8686”} \w the spoil| strong="H2964" \w* \w out of his teeth| strong="H8127" \w*.\f + \fr 29:17 \ft the jaws: Heb. the jawteeth, or, the grinders \f* \f + \fr 29:17 \ft plucked: Heb. cast \f* 
\p
\v 18 [Then I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I shall die]{strong=“H1478” x-morph=“strongMorph: \sc Th\sc*8799”} \w in my nest| strong="H7064" \w*, [and I shall multiply]{strong=“H7235” x-morph=“strongMorph: \sc Th\sc*8686”} my \w days| strong="H3117" \w* \w as the sand| strong="H2344" \w*. 
\v 19 \w My root| strong="H8328" \w* was [spread out]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8803”} \w by the waters| strong="H4325" \w*, \w and the dew| strong="H2919" \w* [lay all night]{strong=“H3885” x-morph=“strongMorph: \sc Th\sc*8799”} \w upon my branch| strong="H7105" \w*.\f + \fr 29:19 \ft spread…: Heb. opened \f* 
\v 20 \w My glory| strong="H3519" \w* was \w fresh| strong="H2319" \w* \w in me| strong="H5978" \w*, \w and my bow| strong="H7198" \w* [was renewed]{strong=“H2498” x-morph=“strongMorph: \sc Th\sc*8686”} \w in my hand| strong="H3027" \w*.\f + \fr 29:20 \ft fresh: Heb. new \f* \f + \fr 29:20 \ft renewed: Heb. changed \f* 
\v 21 Unto me men [gave ear]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”}, [and waited]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8765”}, [and kept silence]{strong=“H1826” x-morph=“strongMorph: \sc Th\sc*8799”} \w at| strong="H3926" \w* \w my counsel| strong="H6098" \w*. 
\v 22 \w After| strong="H310" \w* \w my words| strong="H1697" \w* [they spake not again]{strong=“H8138” x-morph=“strongMorph: \sc Th\sc*8799”}; \w and my speech| strong="H4405" \w* [dropped ]{strong=“H5197” x-morph=“strongMorph: \sc Th\sc*8799”} upon them. 
\v 23 [And they waited]{strong=“H3176” x-morph=“strongMorph: \sc Th\sc*8765”} \w for me as for the rain| strong="H4306" \w*; [and they opened]{strong=“H6473” x-morph=“strongMorph: \sc Th\sc*8804”} \w their mouth| strong="H6310" \w* wide as \w for the latter rain| strong="H4456" \w*. 
\v 24 If [I laughed]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8799”} [on them, they believed]{strong=“H539” x-morph=“strongMorph: \sc Th\sc*8686”} it [not; and the light]{strong=“H216”} \w of my countenance| strong="H6440" \w* [they cast not down]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 25 [I chose]{strong=“H977” x-morph=“strongMorph: \sc Th\sc*8799”} \w out their way| strong="H1870" \w*, [and sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w chief| strong="H7218" \w*, [and dwelt]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8799”} \w as a king| strong="H4428" \w* \w in the army| strong="H1416" \w*, as one that [comforteth]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8762”} \w the mourners| strong="H57" \w*.
\c 30
\p 
\v 1 But now they that are [younger]{strong=“H3117 H6810”} [than I have me in derision]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8804”}, \w whose fathers| strong="H1" \w* [I would have disdained]{strong=“H3988” x-morph=“strongMorph: \sc Th\sc*8804”} [to have set]{strong=“H7896” x-morph=“strongMorph: \sc Th\sc*8800”} \w with the dogs| strong="H3611" \w* \w of my flock| strong="H6629" \w*.\f + \fr 30:1 \ft younger…: Heb. of fewer days than I \f* 
\v 2 [Yea, whereto]{strong=“H4100”} might \w the strength| strong="H3581" \w* \w of their hands| strong="H3027" \w* profit [me, in whom old age]{strong=“H3624”} [was perished]{strong=“H6” x-morph=“strongMorph: \sc Th\sc*8804”}? 
\v 3 \w For want| strong="H2639" \w* \w and famine| strong="H3720" \w* they were \w solitary| strong="H1565" \w*; [fleeing]{strong=“H6207” x-morph=“strongMorph: \sc Th\sc*8802”} \w into the wilderness| strong="H6723" \w* \w in former time| strong="H570" \w* \w desolate| strong="H7722" \w* \w and waste| strong="H4875" \w*.\f + \fr 30:3 \ft solitary: or, dark as the night \f* \f + \fr 30:3 \ft in…: Heb. yesternight \f* 
\v 4 [Who cut up]{strong=“H6998” x-morph=“strongMorph: \sc Th\sc*8801”} \w mallows| strong="H4408" \w* \w by the bushes| strong="H7880" \w*, \w and juniper| strong="H7574" \w* \w roots| strong="H8328" \w* for \w their meat| strong="H3899" \w*. 
\v 5 [They were driven forth]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8792”} \w from among| strong="H1460" \w* men, ([they cried]{strong=“H7321” x-morph=“strongMorph: \sc Th\sc*8686”} after them as after \w a thief| strong="H1590" \w*;) 
\v 6 [To dwell]{strong=“H7931” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the clifts| strong="H6178" \w* \w of the valleys| strong="H5158" \w*, in \w caves| strong="H2356" \w* \w of the earth| strong="H6083" \w*, and in \w the rocks| strong="H3710" \w*.\f + \fr 30:6 \ft caves: Heb. holes \f* 
\v 7 \w Among the bushes| strong="H7880" \w* [they brayed]{strong=“H5101” x-morph=“strongMorph: \sc Th\sc*8799”}; \w under the nettles| strong="H2738" \w* [they were gathered together]{strong=“H5596” x-morph=“strongMorph: \sc Th\sc*8792”}. 
\v 8 They were \w children| strong="H1121" \w* \w of fools| strong="H5036" \w*, [yea, children]{strong=“H1121”} \w of base men| strong="H8034" \w*: [they were viler]{strong=“H5217” x-morph=“strongMorph: \sc Th\sc*8738”} \w than the earth| strong="H776" \w*.\f + \fr 30:8 \ft base…: Heb. men of no name \f* 
\v 9 \w And now am I their song| strong="H5058" \w*, [yea, I am their byword]{strong=“H4405”}. 
\v 10 [They abhor]{strong=“H8581” x-morph=“strongMorph: \sc Th\sc*8765”} [me, they flee far]{strong=“H7368” x-morph=“strongMorph: \sc Th\sc*8804”} [from me, and spare]{strong=“H2820” x-morph=“strongMorph: \sc Th\sc*8804”} \w not to spit| strong="H7536" \w* \w in my face| strong="H6440" \w*.\f + \fr 30:10 \ft and…: Heb. and withhold not spittle from \f* 
\v 11 [Because he hath loosed]{strong=“H6605” x-morph=“strongMorph: \sc Th\sc*8765”} \w my cord| strong="H3499" \w*, [and afflicted]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8762”} [me, they have also let loose]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w the bridle| strong="H7448" \w* \w before| strong="H6440" \w* me. 
\v 12 Upon my \w right| strong="H3225" \w* hand [rise]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w the youth| strong="H6526" \w*; [they push away]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8765”} \w my feet| strong="H7272" \w*, [and they raise up]{strong=“H5549” x-morph=“strongMorph: \sc Th\sc*8799”} \w against me the ways| strong="H734" \w* \w of their destruction| strong="H343" \w*. 
\v 13 [They mar]{strong=“H5420” x-morph=“strongMorph: \sc Th\sc*8804”} \w my path| strong="H5410" \w*, [they set forward]{strong=“H3276” x-morph=“strongMorph: \sc Th\sc*8686”} [my calamity]{strong=“H1962 H1942” x-morph=“strongMorph: \sc Th\sc*8675”}, [they have no helper]{strong=“H5826” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 14 [They came]{strong=“H857” x-morph=“strongMorph: \sc Th\sc*8799”} upon me \w as a wide| strong="H7342" \w* \w breaking| strong="H6556" \w* in of waters: \w in| strong="H8478" \w* \w the desolation| strong="H7722" \w* [they rolled]{strong=“H1556” x-morph=“strongMorph: \sc Th\sc*8701”} themselves upon me. 
\p
\v 15 \w Terrors| strong="H1091" \w* [are turned]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8717”} [upon me: they pursue]{strong=“H7291” x-morph=“strongMorph: \sc Th\sc*8799”} \w my soul| strong="H5082" \w* \w as the wind| strong="H7307" \w*: \w and my welfare| strong="H3444" \w* [passeth away]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w as a cloud| strong="H5645" \w*.\f + \fr 30:15 \ft my soul: Heb. my principal one \f* 
\v 16 \w And now my soul| strong="H5315" \w* [is poured out]{strong=“H8210” x-morph=“strongMorph: \sc Th\sc*8691”} [upon me; the days]{strong=“H3117”} \w of affliction| strong="H6040" \w* [have taken hold]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8799”} upon me. 
\v 17 \w My bones| strong="H6106" \w* [are pierced]{strong=“H5365” x-morph=“strongMorph: \sc Th\sc*8765”} \w in me in the night season| strong="H3915" \w*: [and my sinews]{strong=“H6207” x-morph=“strongMorph: \sc Th\sc*8802”} [take no rest]{strong=“H7901” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 18 \w By the great| strong="H7230" \w* \w force| strong="H3581" \w* of my disease \w is my garment| strong="H3830" \w* [changed]{strong=“H2664” x-morph=“strongMorph: \sc Th\sc*8691”}: [it bindeth me about]{strong=“H247” x-morph=“strongMorph: \sc Th\sc*8799”} \w as the collar| strong="H6310" \w* \w of my coat| strong="H3801" \w*. 
\v 19 [He hath cast]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8689”} \w me into the mire| strong="H2563" \w*, [and I am become like]{strong=“H4911” x-morph=“strongMorph: \sc Th\sc*8691”} \w dust| strong="H6083" \w* \w and ashes| strong="H665" \w*. 
\v 20 [I cry]{strong=“H7768” x-morph=“strongMorph: \sc Th\sc*8762”} [unto thee, and thou dost not hear]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} [me: I stand up]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8804”}, [and thou regardest]{strong=“H995” x-morph=“strongMorph: \sc Th\sc*8709”} me not. 
\v 21 [Thou art become]{strong=“H2015” x-morph=“strongMorph: \sc Th\sc*8735”} \w cruel| strong="H393" \w* [to me: with thy strong]{strong=“H6108”} \w hand| strong="H3027" \w* [thou opposest]{strong=“H7852” x-morph=“strongMorph: \sc Th\sc*8799”} thyself against me.\f + \fr 30:21 \ft become…: Heb. turned to be cruel \f* \f + \fr 30:21 \ft thy…: Heb. the strength of thy hand \f* 
\v 22 [Thou liftest me up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the wind| strong="H7307" \w*; [thou causest me to ride]{strong=“H7392” x-morph=“strongMorph: \sc Th\sc*8686”} upon it, [and dissolvest]{strong=“H4127” x-morph=“strongMorph: \sc Th\sc*8787”} [my substance]{strong=“H7738 H8454” x-morph=“strongMorph: \sc Th\sc*8762 strongMorph: \sc Th\sc*8675”}.\f + \fr 30:22 \ft substance: or, wisdom \f* 
\v 23 [For I know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that [thou wilt bring]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8686”} me to \w death| strong="H4194" \w*, and to \w the house| strong="H1004" \w* \w appointed| strong="H4150" \w* \w for all living| strong="H2416" \w*. 
\v 24 [Howbeit he will not stretch out]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} his \w hand| strong="H3027" \w* \w to the grave| strong="H1164" \w*, \w though they cry| strong="H7769" \w* \w in his destruction| strong="H6365" \w*.\f + \fr 30:24 \ft grave: Heb. heap \f* 
\v 25 [Did not I weep]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8804”} [for him that was in trouble]{strong=“H3117 H7186”}? was not \w my soul| strong="H5315" \w* [grieved]{strong=“H5701” x-morph=“strongMorph: \sc Th\sc*8804”} \w for the poor| strong="H34" \w*?\f + \fr 30:25 \ft in trouble: Heb. hard of day? \f* 
