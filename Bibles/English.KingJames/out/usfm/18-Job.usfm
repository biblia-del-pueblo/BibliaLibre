\p
\v 9 [Then said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w his wife| strong="H802" \w* [unto him, Dost thou still retain]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8688”} \w thine integrity| strong="H8538" \w*? [curse]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8761”} \w God| strong="H430" \w*, [and die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8798”}. 
