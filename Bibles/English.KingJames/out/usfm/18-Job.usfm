\c 32
\p 
\v 1 \w So these three| strong="H7969" \w* \w men| strong="H582" \w* [ceased]{strong=“H7673” x-morph=“strongMorph: \sc Th\sc*8799”} [to answer]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8800”} \w Job| strong="H347" \w*, because he was \w righteous| strong="H6662" \w* \w in his own eyes| strong="H5869" \w*.\f + \fr 32:1 \ft to…: Heb. from answering \f* 
\v 2 [Then was kindled]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8799”} \w the wrath| strong="H639" \w* \w of Elihu| strong="H453" \w* \w the son| strong="H1121" \w* \w of Barachel| strong="H1292" \w* \w the Buzite| strong="H940" \w*, \w of the kindred| strong="H4940" \w* \w of Ram| strong="H7410" \w*: \w against Job| strong="H347" \w* \w was his wrath| strong="H639" \w* [kindled]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8804”}, [because he justified]{strong=“H6663” x-morph=“strongMorph: \sc Th\sc*8763”} \w himself| strong="H5315" \w* \w rather than God| strong="H430" \w*.\f + \fr 32:2 \ft himself: Heb. his soul \f* 
\v 3 \w Also against his three| strong="H7969" \w* \w friends| strong="H7453" \w* \w was his wrath| strong="H639" \w* [kindled]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8804”}, [because they had found]{strong=“H4672” x-morph=“strongMorph: \sc Th\sc*8804”} \w no answer| strong="H4617" \w*, and yet [had condemned]{strong=“H7561” x-morph=“strongMorph: \sc Th\sc*8686”} \w Job| strong="H347" \w*. 
\v 4 \w Now Elihu| strong="H453" \w* [had waited]{strong=“H2442” x-morph=“strongMorph: \sc Th\sc*8765”} \w till Job| strong="H347" \w* \w had spoken| strong="H1697" \w*, because they were [elder]{strong=“H3117 H2205”} than he.\f + \fr 32:4 \ft waited…: Heb. expected Job in words \f* \f + \fr 32:4 \ft elder: Heb. elder for days \f* 
\v 5 \w When Elihu| strong="H453" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} that there was \w no answer| strong="H4617" \w* \w in the mouth| strong="H6310" \w* of these \w three| strong="H7969" \w* \w men| strong="H582" \w*, \w then his wrath| strong="H639" \w* [was kindled]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
