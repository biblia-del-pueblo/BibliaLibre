\v 3 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Satan| strong="H7854" \w*, [Hast thou]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8804”} \w considered| strong="H3820" \w* \w my servant| strong="H5650" \w* \w Job| strong="H347" \w*, that there is \w none like him in the earth| strong="H776" \w*, \w a perfect| strong="H8535" \w* \w and an upright| strong="H3477" \w* \w man| strong="H376" \w*, \w one that feareth| strong="H3373" \w* \w God| strong="H430" \w*, [and escheweth]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8802”} \w evil| strong="H7451" \w*? [and still he holdeth fast]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8688”} \w his integrity| strong="H8538" \w*, [although thou movedst]{strong=“H5496” x-morph=“strongMorph: \sc Th\sc*8686”} [me against him, to destroy]{strong=“H1104” x-morph=“strongMorph: \sc Th\sc*8763”} \w him without cause| strong="H2600" \w*.\f + \fr 2:3 \ft to destroy…: Heb. to swallow him up \f* 
\v 4 \w And Satan| strong="H7854" \w* [answered]{strong=“H6030” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Skin| strong="H5785" \w* \w for skin| strong="H5785" \w*, [yea, all that a man]{strong=“H376”} [hath will he give]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w for his life| strong="H5315" \w*. 
\v 5 \w But| strong="H199" \w* [put forth]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8798”} \w thine hand| strong="H3027" \w* [now, and touch]{strong=“H5060” x-morph=“strongMorph: \sc Th\sc*8798”} \w his bone| strong="H6106" \w* \w and his flesh| strong="H1320" \w*, [and he will curse]{strong=“H1288” x-morph=“strongMorph: \sc Th\sc*8762”} \w thee to thy face| strong="H6440" \w*. 
\v 6 And the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Satan| strong="H7854" \w*, Behold, he is \w in thine hand| strong="H3027" \w*; [but save]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8798”} \w his life| strong="H5315" \w*.\f + \fr 2:6 \ft but: or, only \f* 
\p
