\v 15 \w And Abdon| strong="H5658" \w* \w the son| strong="H1121" \w* \w of Hillel| strong="H1985" \w* \w the Pirathonite| strong="H6553" \w* [died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, [and was buried]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8735”} \w in Pirathon| strong="H6552" \w* \w in the land| strong="H776" \w* \w of Ephraim| strong="H669" \w*, \w in the mount| strong="H2022" \w* \w of the Amalekites| strong="H6003" \w*.
\c 13
\p 
\v 1 \w And the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} \w evil| strong="H7451" \w* [again]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} \w in the sight| strong="H5869" \w* of the \sc Lord\sc*; and the \sc Lord\sc* [delivered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w them into the hand| strong="H3027" \w* \w of the Philistines| strong="H6430" \w* \w forty| strong="H705" \w* \w years| strong="H8141" \w*.\f + \fr 13:1 \ft did evil…: Heb. added to commit, etc \f* 
\p
\v 2 \w And there was a certain| strong="H259" \w* \w man| strong="H376" \w* \w of Zorah| strong="H6881" \w*, \w of the family| strong="H4940" \w* \w of the Danites| strong="H1839" \w*, \w whose name| strong="H8034" \w* was \w Manoah| strong="H4495" \w*; \w and his wife| strong="H802" \w* was \w barren| strong="H6135" \w*, [and bare]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} not. 
\v 3 \w And the angel| strong="H4397" \w* of the \sc Lord\sc* [appeared]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8735”} \w unto the woman| strong="H802" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto her, Behold now, thou art \w barren| strong="H6135" \w*, [and bearest]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} [not: but thou shalt conceive]{strong=“H2029” x-morph=“strongMorph: \sc Th\sc*8804”}, [and bear]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8804”} \w a son| strong="H1121" \w*. 
\v 4 [Now therefore beware]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8734”}, [I pray thee, and drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w not wine| strong="H3196" \w* \w nor strong drink| strong="H7941" \w*, [and eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w not any unclean| strong="H2931" \w* thing: 
\v 5 [For, lo, thou shalt conceive]{strong=“H2030”}, [and bear]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”} \w a son| strong="H1121" \w*; \w and no razor| strong="H4177" \w* [shall come]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w on his head| strong="H7218" \w*: \w for the child| strong="H5288" \w* \w shall be a Nazarite| strong="H5139" \w* \w unto God| strong="H430" \w* \w from the womb| strong="H990" \w*: [and he shall begin]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8686”} [to deliver]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8687”} \w Israel| strong="H3478" \w* \w out of the hand| strong="H3027" \w* \w of the Philistines| strong="H6430" \w*. 
\p
\v 6 \w Then the woman| strong="H802" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [and told]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w her husband| strong="H376" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, \w A man| strong="H376" \w* \w of God| strong="H430" \w* [came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me, and his countenance]{strong=“H4758”} was \w like the countenance| strong="H4758" \w* \w of an angel| strong="H4397" \w* \w of God| strong="H430" \w*, \w very| strong="H3966" \w* [terrible]{strong=“H3372” x-morph=“strongMorph: \sc Th\sc*8737”}: [but I asked]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8804”} him not whence he was, [neither told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} \w he me his name| strong="H8034" \w*: 
\v 7 [But he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto me, Behold, thou shalt conceive]{strong=“H2030”}, [and bear]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8802”} \w a son| strong="H1121" \w*; \w and now drink| strong="H7941" \w* \w no wine| strong="H3196" \w* [nor strong drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”}, [neither eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w any unclean| strong="H2932" \w* thing: \w for the child| strong="H5288" \w* \w shall be a Nazarite| strong="H5139" \w* \w to God| strong="H430" \w* \w from the womb| strong="H990" \w* \w to the day| strong="H3117" \w* \w of his death| strong="H4194" \w*. 
\p
\v 8 \w Then Manoah| strong="H4495" \w* [intreated]{strong=“H6279” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w O| strong="H994" \w* \w my Lord| strong="H136" \w*, \w let| strong="H4994" \w* \w the man| strong="H376" \w* \w of God| strong="H430" \w* [which thou didst send]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8804”} [come again]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [unto us, and teach]{strong=“H3384” x-morph=“strongMorph: \sc Th\sc*8686”} [us what we shall do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the child| strong="H5288" \w* [that shall be born]{strong=“H3205” x-morph=“strongMorph: \sc Th\sc*8795”}. 
\v 9 \w And God| strong="H430" \w* [hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the voice| strong="H6963" \w* \w of Manoah| strong="H4495" \w*; \w and the angel| strong="H4397" \w* \w of God| strong="H430" \w* [came again]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the woman| strong="H802" \w* [as she sat]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the field| strong="H7704" \w*: \w but Manoah| strong="H4495" \w* \w her husband| strong="H376" \w* was not with her. 
\v 10 \w And the woman| strong="H802" \w* [made haste]{strong=“H4116” x-morph=“strongMorph: \sc Th\sc*8762”}, [and ran]{strong=“H7323” x-morph=“strongMorph: \sc Th\sc*8799”}, [and shewed]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w her husband| strong="H376" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Behold, the man]{strong=“H376”} [hath appeared]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8738”} [unto me, that came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8804”} unto me the other \w day| strong="H3117" \w*. 
\v 11 \w And Manoah| strong="H4495" \w* [arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”}, [and went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w after| strong="H310" \w* \w his wife| strong="H802" \w*, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the man| strong="H376" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, Art \w thou the man| strong="H376" \w* [that spakest]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”} \w unto the woman| strong="H802" \w*? [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, I am. 
\v 12 \w And Manoah| strong="H4495" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Now let thy words| strong="H1697" \w* [come to pass]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”}. \w How shall we order| strong="H4941" \w* \w the child| strong="H5288" \w*, and how \w shall we do| strong="H4639" \w* unto him?\f + \fr 13:12 \ft How shall we order…: Heb. What shall be the manner of the, etc \f* \f + \fr 13:12 \ft how shall we do…: or, what shall he do?: Heb. what shall be his work? \f* 
\v 13 \w And the angel| strong="H4397" \w* of the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Manoah| strong="H4495" \w*, [Of all that I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto the woman| strong="H802" \w* [let her beware]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 14 [She may not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} of any thing [that cometh]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w of the vine| strong="H1612" \w*, [neither let her drink]{strong=“H8354” x-morph=“strongMorph: \sc Th\sc*8799”} \w wine| strong="H3196" \w* \w or strong drink| strong="H7941" \w*, [nor eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w any unclean| strong="H2932" \w* thing: [all that I commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} [her let her observe]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 15 \w And Manoah| strong="H4495" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the angel| strong="H4397" \w* of the \sc Lord\sc*, [I pray thee, let us detain]{strong=“H6113” x-morph=“strongMorph: \sc Th\sc*8799”} [thee, until we shall have made ready]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} [a kid]{strong=“H5795 H1423”} \w for| strong="H6440" \w* thee.\f + \fr 13:15 \ft for thee: Heb. before thee \f* 
\v 16 \w And the angel| strong="H4397" \w* of the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Manoah| strong="H4495" \w*, [Though thou detain]{strong=“H6113” x-morph=“strongMorph: \sc Th\sc*8799”} [me, I will not eat]{strong=“H398” x-morph=“strongMorph: \sc Th\sc*8799”} \w of thy bread| strong="H3899" \w*: \w and if| strong="H518" \w* [thou wilt offer]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w a burnt offering| strong="H5930" \w*, [thou must offer]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} it unto the \sc Lord\sc*. \w For Manoah| strong="H4495" \w* [knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} not that he was \w an angel| strong="H4397" \w* of the \sc Lord\sc*. 
\v 17 \w And Manoah| strong="H4495" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the angel| strong="H4397" \w* of the \sc Lord\sc*, What is \w thy name| strong="H8034" \w*, \w that when thy sayings| strong="H1697" \w* [come to pass]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} [we may do thee honour]{strong=“H3513” x-morph=“strongMorph: \sc Th\sc*8765”}? 
\v 18 \w And the angel| strong="H4397" \w* of the \sc Lord\sc* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, Why askest]{strong=“H7592” x-morph=“strongMorph: \sc Th\sc*8799”} \w thou thus after my name| strong="H8034" \w*, seeing it is [secret]{strong=“H6383 H6383” x-morph=“strongMorph: \sc Th\sc*8675”}?\f + \fr 13:18 \ft secret: or, wonderful \f* 
\v 19 \w So Manoah| strong="H4495" \w* [took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} [a kid]{strong=“H5795 H1423”} \w with a meat offering| strong="H4503" \w*, [and offered]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} it \w upon a rock| strong="H6697" \w* unto the \sc Lord\sc*: and the angel [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [wondrously]{strong=“H6381” x-morph=“strongMorph: \sc Th\sc*8688”}; \w and Manoah| strong="H4495" \w* \w and his wife| strong="H802" \w* [looked on]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 20 [For it came to pass, when the flame]{strong=“H3851”} [went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8800”} \w toward heaven| strong="H8064" \w* \w from off the altar| strong="H4196" \w*, \w that the angel| strong="H4397" \w* of the \sc Lord\sc* [ascended]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the flame| strong="H3851" \w* \w of the altar| strong="H4196" \w*. \w And Manoah| strong="H4495" \w* \w and his wife| strong="H802" \w* [looked on]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} it, [and fell on]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8799”} \w their faces| strong="H6440" \w* \w to the ground| strong="H776" \w*. 
\v 21 \w But the angel| strong="H4397" \w* of the \sc Lord\sc* [did no more]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8804”} [appear]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8736”} \w to Manoah| strong="H4495" \w* \w and to his wife| strong="H802" \w*. \w Then Manoah| strong="H4495" \w* [knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} that he was \w an angel| strong="H4397" \w* of the \sc Lord\sc*. 
\v 22 \w And Manoah| strong="H4495" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his wife| strong="H802" \w*, [We shall surely]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”} [die]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, [because we have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w God| strong="H430" \w*. 
\v 23 \w But his wife| strong="H802" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, If]{strong=“H3863”} the \sc Lord\sc* [were pleased]{strong=“H2654” x-morph=“strongMorph: \sc Th\sc*8804”} [to kill]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8687”} [us, he would not have received]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w a burnt offering| strong="H5930" \w* \w and a meat offering| strong="H4503" \w* \w at our hands| strong="H3027" \w*, [neither would he have shewed]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8689”} us all these things, \w nor would as at this time| strong="H6256" \w* [have told]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8689”} us such things \w as these| strong="H2063" \w*. 
\p
