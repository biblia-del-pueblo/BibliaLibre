\v 25 \w And the Spirit| strong="H7307" \w* of the \sc Lord\sc* [began]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8686”} [to move him at times]{strong=“H6470” x-morph=“strongMorph: \sc Th\sc*8800”} \w in the camp| strong="H4264" \w* \w of Dan| strong="H1835" \w* \w between Zorah| strong="H6881" \w* \w and Eshtaol| strong="H847" \w*.\f + \fr 13:25 \ft the camp…: Heb. Mahaneh-dan \f*
\c 14
\p 
\v 1 \w And Samson| strong="H8123" \w* [went down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Timnath| strong="H8553" \w*, [and saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} \w a woman| strong="H802" \w* \w in Timnath| strong="H8553" \w* \w of the daughters| strong="H1323" \w* \w of the Philistines| strong="H6430" \w*. 
\v 2 [And he came up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”}, [and told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w his father| strong="H1" \w* \w and his mother| strong="H517" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I have seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w a woman| strong="H802" \w* \w in Timnath| strong="H8553" \w* \w of the daughters| strong="H1323" \w* \w of the Philistines| strong="H6430" \w*: [now therefore get]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} \w her for me to wife| strong="H802" \w*. 
\v 3 \w Then his father| strong="H1" \w* \w and his mother| strong="H517" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} unto him, Is there \w never| strong="H369" \w* \w a woman| strong="H802" \w* \w among the daughters| strong="H1323" \w* \w of thy brethren| strong="H251" \w*, \w or among all my people| strong="H5971" \w*, [that thou goest]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8802”} [to take]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8800”} \w a wife| strong="H802" \w* \w of the uncircumcised| strong="H6189" \w* \w Philistines| strong="H6430" \w*? \w And Samson| strong="H8123" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto his father| strong="H1" \w*, [Get]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8798”} [her for me; for she pleaseth me well]{strong=“H5869 H3474” x-morph=“strongMorph: \sc Th\sc*8804”}.\f + \fr 14:3 \ft pleaseth…: Heb. is right in mine eyes \f* 
\v 4 \w But his father| strong="H1" \w* \w and his mother| strong="H517" \w* [knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} not that it was of the \sc Lord\sc*, [that he sought]{strong=“H1245” x-morph=“strongMorph: \sc Th\sc*8764”} \w an occasion| strong="H8385" \w* \w against the Philistines| strong="H6430" \w*: \w for at that time| strong="H6256" \w* \w the Philistines| strong="H6430" \w* [had dominion]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8802”} \w over Israel| strong="H3478" \w*. 
\p
\v 5 \w Then went| strong="H3381" \w* \w Samson| strong="H8123" \w* [down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”}, \w and his father| strong="H1" \w* \w and his mother| strong="H517" \w*, \w to Timnath| strong="H8553" \w*, [and came]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the vineyards| strong="H3754" \w* \w of Timnath| strong="H8553" \w*: [and, behold, a young]{strong=“H3715”} \w lion| strong="H738" \w* [roared]{strong=“H7580” x-morph=“strongMorph: \sc Th\sc*8802”} [against]{strong=“H7125” x-morph=“strongMorph: \sc Th\sc*8800”} him.\f + \fr 14:5 \ft against…: Heb. in meeting him \f* 
