\c 15
\p 
\v 1 \w But it came to pass within a while after| strong="H3117" \w*, \w in the time| strong="H3117" \w* \w of wheat| strong="H2406" \w* \w harvest| strong="H7105" \w*, \w that Samson| strong="H8123" \w* [visited]{strong=“H6485” x-morph=“strongMorph: \sc Th\sc*8799”} \w his wife| strong="H802" \w* [with a kid]{strong=“H5795 H1423”}; [and he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8799”} \w to my wife| strong="H802" \w* \w into the chamber| strong="H2315" \w*. \w But her father| strong="H1" \w* [would not suffer]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} [him to go in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”}. 
\v 2 \w And her father| strong="H1" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I verily]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”} [thought]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”} [that thou hadst utterly]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8800”} [hated]{strong=“H8130” x-morph=“strongMorph: \sc Th\sc*8804”} [her; therefore I gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w her to thy companion| strong="H4828" \w*: is \w not her younger| strong="H6996" \w* \w sister| strong="H269" \w* \w fairer| strong="H2896" \w* than she? take her, I pray thee, instead of her.\f + \fr 15:2 \ft take…: Heb. let her be thine \f* 
\p
\v 3 \w And Samson| strong="H8123" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [concerning them, Now]{strong=“H6471”} [shall I be more blameless]{strong=“H5352” x-morph=“strongMorph: \sc Th\sc*8738”} \w than the Philistines| strong="H6430" \w*, [though I do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8802”} \w them a displeasure| strong="H7451" \w*.\f + \fr 15:3 \ft more…: or, blameless from the Philistines though, etc \f* 
\v 4 \w And Samson| strong="H8123" \w* [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} [and caught]{strong=“H3920” x-morph=“strongMorph: \sc Th\sc*8799”} \w three| strong="H7969" \w* \w hundred| strong="H3967" \w* \w foxes| strong="H7776" \w*, [and took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w firebrands| strong="H3940" \w*, [and turned]{strong=“H6437” x-morph=“strongMorph: \sc Th\sc*8686”} \w tail| strong="H2180" \w* \w to tail| strong="H2180" \w*, [and put]{strong=“H7760” x-morph=“strongMorph: \sc Th\sc*8799”} \w a| strong="H259" \w* \w firebrand| strong="H3940" \w* \w in the midst| strong="H8432" \w* \w between two| strong="H8147" \w* \w tails| strong="H2180" \w*.\f + \fr 15:4 \ft firebrands: or, torches \f* 
\v 5 [And when he had set]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8686”} \w the brands| strong="H3940" \w* \w on fire| strong="H784" \w*, he let them [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”} \w into the standing corn| strong="H7054" \w* \w of the Philistines| strong="H6430" \w*, [and burnt up]{strong=“H1197” x-morph=“strongMorph: \sc Th\sc*8686”} \w both the shocks| strong="H1430" \w*, \w and also the standing corn| strong="H7054" \w*, \w with the vineyards| strong="H3754" \w* and \w olives| strong="H2132" \w*. 
\p
\v 6 \w Then the Philistines| strong="H6430" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Who hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [this? And they answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Samson| strong="H8123" \w*, \w the son in law| strong="H2860" \w* \w of the Timnite| strong="H8554" \w*, [because he had taken]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8804”} \w his wife| strong="H802" \w*, [and given]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w her to his companion| strong="H4828" \w*. \w And the Philistines| strong="H6430" \w* [came up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”}, [and burnt]{strong=“H8313” x-morph=“strongMorph: \sc Th\sc*8799”} \w her and her father| strong="H1" \w* \w with fire| strong="H784" \w*. 
\p
\v 7 \w And Samson| strong="H8123" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Though]{strong=“H518”} [ye have done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w this| strong="H2063" \w*, [yet will I be avenged]{strong=“H5358” x-morph=“strongMorph: \sc Th\sc*8738”} [of you, and after]{strong=“H310”} [that I will cease]{strong=“H2308” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 8 [And he smote]{strong=“H5221” x-morph=“strongMorph: \sc Th\sc*8686”} \w them hip| strong="H7785" \w* \w and| strong="H5921" \w* \w thigh| strong="H3409" \w* \w with a great| strong="H1419" \w* \w slaughter| strong="H4347" \w*: [and he went down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} [and dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8799”} \w in the top| strong="H5585" \w* \w of the rock| strong="H5553" \w* \w Etam| strong="H5862" \w*. 
\p
\v 9 \w Then the Philistines| strong="H6430" \w* [went up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”}, [and pitched]{strong=“H2583” x-morph=“strongMorph: \sc Th\sc*8799”} \w in Judah| strong="H3063" \w*, [and spread]{strong=“H5203” x-morph=“strongMorph: \sc Th\sc*8735”} \w themselves in Lehi| strong="H3896" \w*. 
\v 10 \w And the men| strong="H376" \w* \w of Judah| strong="H3063" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Why are ye come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} [against us? And they answered]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [To bind]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8800”} \w Samson| strong="H8123" \w* [are we come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”}, [to do]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8800”} [to him as he hath done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} to us. 
\v 11 \w Then three| strong="H7969" \w* \w thousand| strong="H505" \w* \w men| strong="H376" \w* \w of Judah| strong="H3063" \w* [went]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8799”} \w to the top| strong="H5585" \w* \w of the rock| strong="H5553" \w* \w Etam| strong="H5862" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w to Samson| strong="H8123" \w*, [Knowest]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w thou not that the Philistines| strong="H6430" \w* are [rulers]{strong=“H4910” x-morph=“strongMorph: \sc Th\sc*8802”} over us? what is this that [thou hast done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [unto us? And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, As they did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} [unto me, so have I done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} unto them.\f + \fr 15:11 \ft went: Heb. went down \f* 
\v 12 [And they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, We are come down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8804”} [to bind]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8800”} [thee, that we may deliver]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8800”} \w thee into the hand| strong="H3027" \w* \w of the Philistines| strong="H6430" \w*. \w And Samson| strong="H8123" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto them, Swear]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8734”} [unto me, that ye will not fall upon]{strong=“H6293” x-morph=“strongMorph: \sc Th\sc*8799”} me yourselves. 
