\v 8 \w Then the lords| strong="H5633" \w* \w of the Philistines| strong="H6430" \w* [brought up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w to her seven| strong="H7651" \w* \w green| strong="H3892" \w* \w withs| strong="H3499" \w* [which had not been dried]{strong=“H2717” x-morph=“strongMorph: \sc Th\sc*8795”}, [and she bound]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8799”} him with them.\f + \fr 16:8 \ft green…: or, new cords: Heb. moist \f* 
\v 9 Now there were [men lying in wait]{strong=“H693” x-morph=“strongMorph: \sc Th\sc*8802”}, [abiding]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w with her in the chamber| strong="H2315" \w*. [And she said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, The Philistines]{strong=“H6430”} be [upon thee, Samson]{strong=“H8123”}. [And he brake]{strong=“H5423” x-morph=“strongMorph: \sc Th\sc*8762”} \w the withs| strong="H3499" \w*, \w as a thread| strong="H6616" \w* \w of tow| strong="H5296" \w* [is broken]{strong=“H5423” x-morph=“strongMorph: \sc Th\sc*8735”} [when it toucheth]{strong=“H7306” x-morph=“strongMorph: \sc Th\sc*8687”} \w the fire| strong="H784" \w*. \w So his strength| strong="H3581" \w* [was not known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8738”}.\f + \fr 16:9 \ft toucheth: Heb. smelleth \f* 
\v 10 \w And Delilah| strong="H1807" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Samson| strong="H8123" \w*, [Behold, thou hast mocked]{strong=“H2048” x-morph=“strongMorph: \sc Th\sc*8765”} [me, and told]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w me lies| strong="H3577" \w*: [now tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”} [me, I pray thee, wherewith thou mightest be bound]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8735”}. 
\v 11 [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto her, If they bind]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8799”} [me fast]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8800”} \w with new| strong="H2319" \w* \w ropes| strong="H5688" \w* [that never were occupied]{strong=“H6213 H4399” x-morph=“strongMorph: \sc Th\sc*8738”}, [then shall I be weak]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8804”}, \w and be as another| strong="H259" \w* \w man| strong="H120" \w*.\f + \fr 16:11 \ft that never…: Heb. wherewith work hath not been done \f* 
\v 12 \w Delilah| strong="H1807" \w* [therefore took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w new| strong="H2319" \w* \w ropes| strong="H5688" \w*, [and bound]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8799”} [him therewith, and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, The Philistines]{strong=“H6430”} be [upon thee, Samson]{strong=“H8123”}. And there were [liers in wait]{strong=“H693” x-morph=“strongMorph: \sc Th\sc*8802”} [abiding]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in the chamber| strong="H2315" \w*. [And he brake]{strong=“H5423” x-morph=“strongMorph: \sc Th\sc*8762”} \w them from off his arms| strong="H2220" \w* \w like a thread| strong="H2339" \w*. 
\v 13 \w And Delilah| strong="H1807" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto Samson| strong="H8123" \w*, \w Hitherto| strong="H2008" \w* [thou hast mocked]{strong=“H2048” x-morph=“strongMorph: \sc Th\sc*8765”} [me, and told]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8762”} \w me lies| strong="H3577" \w*: [tell]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8685”} [me wherewith thou mightest be bound]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8735”}. [And he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto her, If thou weavest]{strong=“H707” x-morph=“strongMorph: \sc Th\sc*8799”} \w the seven| strong="H7651" \w* \w locks| strong="H4253" \w* \w of my head| strong="H7218" \w* \w with the web| strong="H4545" \w*. 
\v 14 [And she fastened]{strong=“H8628” x-morph=“strongMorph: \sc Th\sc*8799”} it \w with the pin| strong="H3489" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, The Philistines]{strong=“H6430”} be [upon thee, Samson]{strong=“H8123”}. [And he awaked]{strong=“H3364” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of his sleep| strong="H8142" \w*, [and went away]{strong=“H5265” x-morph=“strongMorph: \sc Th\sc*8799”} \w with the pin| strong="H3489" \w* \w of the beam| strong="H708" \w*, \w and with the web| strong="H4545" \w*. 
\p
\v 15 [And she said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto him, How]{strong=“H349”} [canst thou say]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I love]{strong=“H157” x-morph=“strongMorph: \sc Th\sc*8804”} [thee, when thine heart]{strong=“H3820”} is [not with me? thou hast mocked]{strong=“H2048” x-morph=“strongMorph: \sc Th\sc*8765”} \w me these three| strong="H7969" \w* \w times| strong="H6471" \w*, [and hast not told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} \w me wherein thy great| strong="H1419" \w* \w strength| strong="H3581" \w* lieth. 
\v 16 [And it came to pass, when she pressed]{strong=“H6693” x-morph=“strongMorph: \sc Th\sc*8689”} \w him daily| strong="H3117" \w* \w with her words| strong="H1697" \w*, [and urged]{strong=“H509” x-morph=“strongMorph: \sc Th\sc*8762”} him, so \w that his soul| strong="H5315" \w* [was vexed]{strong=“H7114” x-morph=“strongMorph: \sc Th\sc*8799”} [unto death]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8800”};\f + \fr 16:16 \ft vexed: Heb. shortened \f* 
\v 17 [That he told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8686”} \w her all his heart| strong="H3820" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} [unto her, There hath not come]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} \w a razor| strong="H4177" \w* \w upon mine head| strong="H7218" \w*; for I have been \w a Nazarite| strong="H5139" \w* \w unto God| strong="H430" \w* [from my mother’s]{strong=“H517”} \w womb| strong="H990" \w*: [if I be shaven]{strong=“H1548” x-morph=“strongMorph: \sc Th\sc*8795”}, \w then my strength| strong="H3581" \w* [will go]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8804”} [from me, and I shall become weak]{strong=“H2470” x-morph=“strongMorph: \sc Th\sc*8804”}, and be like any other \w man| strong="H120" \w*. 
\p
\v 18 \w And when Delilah| strong="H1807" \w* [saw]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8799”} [that he had told]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} \w her all his heart| strong="H3820" \w*, [she sent]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8799”} [and called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w for the lords| strong="H5633" \w* \w of the Philistines| strong="H6430" \w*, [saying]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8800”}, [Come up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8798”} \w this once| strong="H6471" \w*, [for he hath shewed]{strong=“H5046” x-morph=“strongMorph: \sc Th\sc*8689”} \w me all his heart| strong="H3820" \w*. \w Then the lords| strong="H5633" \w* \w of the Philistines| strong="H6430" \w* [came up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8804”} [unto her, and brought]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w money| strong="H3701" \w* \w in their hand| strong="H3027" \w*. 
\v 19 [And she made him sleep]{strong=“H3462” x-morph=“strongMorph: \sc Th\sc*8762”} \w upon her knees| strong="H1290" \w*; [and she called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w for a man| strong="H376" \w*, [and she caused him to shave off]{strong=“H1548” x-morph=“strongMorph: \sc Th\sc*8762”} \w the seven| strong="H7651" \w* \w locks| strong="H4253" \w* \w of his head| strong="H7218" \w*; [and she began]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8686”} [to afflict]{strong=“H6031” x-morph=“strongMorph: \sc Th\sc*8763”} [him, and his strength]{strong=“H3581”} [went]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8799”} from him. 
\v 20 [And she said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w The Philistines| strong="H6430" \w* be [upon thee, Samson]{strong=“H8123”}. [And he awoke]{strong=“H3364” x-morph=“strongMorph: \sc Th\sc*8799”} \w out of his sleep| strong="H8142" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I will go out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8799”} \w as at other times before| strong="H6471" \w*, [and shake]{strong=“H5287” x-morph=“strongMorph: \sc Th\sc*8735”} [myself. And he wist]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} not that the \sc Lord\sc* [was departed]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8804”} from him. 
\p
\v 21 \w But the Philistines| strong="H6430" \w* [took]{strong=“H270” x-morph=“strongMorph: \sc Th\sc*8799”} [him, and put out]{strong=“H5365” x-morph=“strongMorph: \sc Th\sc*8762”} \w his eyes| strong="H5869" \w*, [and brought him down]{strong=“H3381” x-morph=“strongMorph: \sc Th\sc*8686”} \w to Gaza| strong="H5804" \w*, [and bound]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8799”} \w him with fetters of brass| strong="H5178" \w*; [and he did grind]{strong=“H2912” x-morph=“strongMorph: \sc Th\sc*8802”} [in the prison]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8803”} \w house| strong="H1004" \w*.\f + \fr 16:21 \ft put out: Heb. bored out \f* 
\p
\v 22 \w Howbeit the hair| strong="H8181" \w* \w of his head| strong="H7218" \w* [began]{strong=“H2490” x-morph=“strongMorph: \sc Th\sc*8686”} [to grow again]{strong=“H6779” x-morph=“strongMorph: \sc Th\sc*8763”} \w after| strong="H834" \w* [he was shaven]{strong=“H1548” x-morph=“strongMorph: \sc Th\sc*8795”}.\f + \fr 16:22 \ft after…: or, as when he was shaven \f* 
