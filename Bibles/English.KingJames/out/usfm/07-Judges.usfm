\v 25 [And it came to pass, when their hearts]{strong=“H3820”} \w were merry| strong="H2896" \w*, [that they said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [Call]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8798”} \w for Samson| strong="H8123" \w*, [that he may make us sport]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8762”}. [And they called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w for Samson| strong="H8123" \w* [out of the prison]{strong=“H631” x-morph=“strongMorph: \sc Th\sc*8803”} \w house| strong="H1004" \w*; \w and he made them| strong="H6440" \w* [sport]{strong=“H6711” x-morph=“strongMorph: \sc Th\sc*8762”}: [and they set]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8686”} \w him between the pillars| strong="H5982" \w*.\f + \fr 16:25 \ft them: Heb. before them \f* 
\v 26 \w And Samson| strong="H8123" \w* [said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the lad| strong="H5288" \w* [that held]{strong=“H2388” x-morph=“strongMorph: \sc Th\sc*8688”} \w him by the hand| strong="H3027" \w*, [Suffer]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8685”} [me that I may feel]{strong=“H3237 H4184” x-morph=“strongMorph: \sc Th\sc*8685 strongMorph: \sc Th\sc*8675 strongMorph: \sc Th\sc*8685”} \w the pillars| strong="H5982" \w* \w whereupon the house| strong="H1004" \w* [standeth]{strong=“H3559” x-morph=“strongMorph: \sc Th\sc*8737”}, [that I may lean]{strong=“H8172” x-morph=“strongMorph: \sc Th\sc*8735”} upon them. 
\v 27 \w Now the house| strong="H1004" \w* [was full]{strong=“H4390” x-morph=“strongMorph: \sc Th\sc*8804”} \w of men| strong="H582" \w* \w and women| strong="H802" \w*; \w and all the lords| strong="H5633" \w* \w of the Philistines| strong="H6430" \w* were there; and there were \w upon the roof| strong="H1406" \w* \w about three| strong="H7969" \w* \w thousand| strong="H505" \w* \w men| strong="H376" \w* \w and women| strong="H802" \w*, [that beheld]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8802”} \w while Samson| strong="H8123" \w* [made sport]{strong=“H7832” x-morph=“strongMorph: \sc Th\sc*8800”}. 
