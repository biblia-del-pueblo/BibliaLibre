\v 36 \w And the coast| strong="H1366" \w* \w of the Amorites| strong="H567" \w* was \w from the going up| strong="H4608" \w* \w to Akrabbim| strong="H4610" \w*, \w from the rock| strong="H5553" \w*, \w and upward| strong="H4605" \w*.\f + \fr 1:36 \ft the going…: or, Maaleh-acrabbim \f*
\c 2
\p 
\v 1 \w And an angel| strong="H4397" \w* of the \sc Lord\sc* [came up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8799”} \w from Gilgal| strong="H1537" \w* \w to Bochim| strong="H1066" \w*, [and said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, [I made you to go up]{strong=“H5927” x-morph=“strongMorph: \sc Th\sc*8686”} \w out of Egypt| strong="H4714" \w*, [and have brought]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8686”} \w you unto the land| strong="H776" \w* [which I sware]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto your fathers| strong="H1" \w*; [and I said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w I will never| strong="H5769" \w* [break]{strong=“H6565” x-morph=“strongMorph: \sc Th\sc*8686”} \w my covenant| strong="H1285" \w* with you.\f + \fr 2:1 \ft angel: or, messenger \f* 
\v 2 [And ye shall make]{strong=“H3772” x-morph=“strongMorph: \sc Th\sc*8799”} \w no league| strong="H1285" \w* [with the inhabitants]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w of this land| strong="H776" \w*; [ye shall throw down]{strong=“H5422” x-morph=“strongMorph: \sc Th\sc*8799”} \w their altars| strong="H4196" \w*: [but ye have not obeyed]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w my voice| strong="H6963" \w*: [why have ye done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} this? 
\v 3 [Wherefore I also said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8804”}, [I will not drive them out]{strong=“H1644” x-morph=“strongMorph: \sc Th\sc*8762”} \w from before| strong="H6440" \w* you; but they shall be as thorns \w in your sides| strong="H6654" \w*, \w and their gods| strong="H430" \w* \w shall be a snare| strong="H4170" \w* unto you. 
\v 4 [And it came to pass, when the angel]{strong=“H4397”} of the \sc Lord\sc* [spake]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8763”} \w these words| strong="H1697" \w* \w unto all the children| strong="H1121" \w* \w of Israel| strong="H3478" \w*, \w that the people| strong="H5971" \w* [lifted up]{strong=“H5375” x-morph=“strongMorph: \sc Th\sc*8799”} \w their voice| strong="H6963" \w*, [and wept]{strong=“H1058” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\v 5 [And they called]{strong=“H7121” x-morph=“strongMorph: \sc Th\sc*8799”} \w the name| strong="H8034" \w* \w of that place| strong="H4725" \w* \w Bochim| strong="H1066" \w*: [and they sacrificed]{strong=“H2076” x-morph=“strongMorph: \sc Th\sc*8799”} there unto the \sc Lord\sc*.\f + \fr 2:5 \ft Bochim: that is, Weepers \f* 
\p
\v 6 \w And when Joshua| strong="H3091" \w* \w had let the people| strong="H5971" \w* [go]{strong=“H7971” x-morph=“strongMorph: \sc Th\sc*8762”}, \w the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [went]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w every man| strong="H376" \w* \w unto his inheritance| strong="H5159" \w* [to possess]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8800”} \w the land| strong="H776" \w*. 
\v 7 \w And the people| strong="H5971" \w* [served]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc* \w all the days| strong="H3117" \w* \w of Joshua| strong="H3091" \w*, \w and all the days| strong="H3117" \w* \w of the elders| strong="H2205" \w* [that outlived]{strong=“H310 H3117 H748” x-morph=“strongMorph: \sc Th\sc*8689”} \w Joshua| strong="H3091" \w*, [who had seen]{strong=“H7200” x-morph=“strongMorph: \sc Th\sc*8804”} \w all the great| strong="H1419" \w* \w works| strong="H4639" \w* of the \sc Lord\sc*, [that he did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w for Israel| strong="H3478" \w*.\f + \fr 2:7 \ft outlived: Heb. prolonged days after \f* 
\v 8 \w And Joshua| strong="H3091" \w* \w the son| strong="H1121" \w* \w of Nun| strong="H5126" \w*, \w the servant| strong="H5650" \w* of the \sc Lord\sc*, [died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}, being \w an hundred| strong="H3967" \w* \w and ten| strong="H6235" \w* \w years| strong="H8141" \w* \w old| strong="H1121" \w*. 
\v 9 [And they buried]{strong=“H6912” x-morph=“strongMorph: \sc Th\sc*8799”} \w him in the border| strong="H1366" \w* \w of his inheritance| strong="H5159" \w* [in Timnath-heres]{strong=“H8556”}, \w in the mount| strong="H2022" \w* \w of Ephraim| strong="H669" \w*, \w on the north side| strong="H6828" \w* \w of the hill| strong="H2022" \w* \w Gaash| strong="H1608" \w*.\f + \fr 2:9 \ft Timnath-heres: also called, Timnath-serah \f* 
\v 10 \w And also all that generation| strong="H1755" \w* [were gathered]{strong=“H622” x-morph=“strongMorph: \sc Th\sc*8738”} \w unto their fathers| strong="H1" \w*: [and there arose]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8799”} \w another| strong="H312" \w* \w generation| strong="H1755" \w* \w after| strong="H310" \w* [them, which knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} not the \sc Lord\sc*, \w nor yet the works| strong="H4639" \w* [which he had done]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} \w for Israel| strong="H3478" \w*. 
\p
\v 11 \w And the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w evil| strong="H7451" \w* \w in the sight| strong="H5869" \w* of the \sc Lord\sc*, [and served]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} \w Baalim| strong="H1168" \w*: 
\v 12 [And they forsook]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc* \w God| strong="H430" \w* \w of their fathers| strong="H1" \w*, [which brought them out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8688”} \w of the land| strong="H776" \w* \w of Egypt| strong="H4714" \w*, [and followed]{strong=“H310 H3212” x-morph=“strongMorph: \sc Th\sc*8799”} \w other| strong="H312" \w* \w gods| strong="H430" \w*, \w of the gods| strong="H430" \w* \w of the people| strong="H5971" \w* that were \w round about| strong="H5439" \w* [them, and bowed]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} themselves unto them, and provoked the \sc Lord\sc* [to anger]{strong=“H3707” x-morph=“strongMorph: \sc Th\sc*8686”}. 
\v 13 [And they forsook]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc*, [and served]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} \w Baal| strong="H1168" \w* \w and Ashtaroth| strong="H6252" \w*. 
\p
\v 14 \w And the anger| strong="H639" \w* of the \sc Lord\sc* [was hot]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8799”} \w against Israel| strong="H3478" \w*, [and he delivered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8799”} \w them into the hands| strong="H3027" \w* [of spoilers]{strong=“H8154” x-morph=“strongMorph: \sc Th\sc*8802”} [that spoiled]{strong=“H8155” x-morph=“strongMorph: \sc Th\sc*8799”} [them, and he sold]{strong=“H4376” x-morph=“strongMorph: \sc Th\sc*8799”} \w them into the hands| strong="H3027" \w* [of their enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w round about| strong="H5439" \w*, [so that they could]{strong=“H3201” x-morph=“strongMorph: \sc Th\sc*8804”} \w not any longer| strong="H5750" \w* [stand]{strong=“H5975” x-morph=“strongMorph: \sc Th\sc*8800”} \w before| strong="H6440" \w* [their enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”}. 
\v 15 [Whithersoever they went out]{strong=“H3318” x-morph=“strongMorph: \sc Th\sc*8804”}, \w the hand| strong="H3027" \w* of the \sc Lord\sc* \w was against them for evil| strong="H7451" \w*, as the \sc Lord\sc* [had said]{strong=“H1696” x-morph=“strongMorph: \sc Th\sc*8765”}, and as the \sc Lord\sc* [had sworn]{strong=“H7650” x-morph=“strongMorph: \sc Th\sc*8738”} [unto them: and they were greatly]{strong=“H3966”} [distressed]{strong=“H3334” x-morph=“strongMorph: \sc Th\sc*8799”}. 
\p
\v 16 Nevertheless the \sc Lord\sc* [raised up]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8686”} [judges]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”}, [which delivered]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8686”} \w them out of the hand| strong="H3027" \w* [of those that spoiled]{strong=“H8154” x-morph=“strongMorph: \sc Th\sc*8802”} them.\f + \fr 2:16 \ft delivered: Heb. saved \f* 
\v 17 [And yet they would not hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} [unto their judges]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”}, [but they went a whoring]{strong=“H2181” x-morph=“strongMorph: \sc Th\sc*8804”} \w after| strong="H310" \w* \w other| strong="H312" \w* \w gods| strong="H430" \w*, [and bowed]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8691”} [themselves unto them: they turned]{strong=“H5493” x-morph=“strongMorph: \sc Th\sc*8804”} \w quickly| strong="H4118" \w* \w out of the way| strong="H1870" \w* \w which their fathers| strong="H1" \w* [walked in]{strong=“H1980” x-morph=“strongMorph: \sc Th\sc*8804”}, [obeying]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8800”} \w the commandments| strong="H4687" \w* of the \sc Lord\sc*; but [they did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8804”} not so. 
\v 18 And when the \sc Lord\sc* [raised]{strong=“H6965” x-morph=“strongMorph: \sc Th\sc*8689”} [them up judges]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”}, then the \sc Lord\sc* [was with the judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”}, [and delivered]{strong=“H3467” x-morph=“strongMorph: \sc Th\sc*8689”} \w them out of the hand| strong="H3027" \w* [of their enemies]{strong=“H341” x-morph=“strongMorph: \sc Th\sc*8802”} \w all the days| strong="H3117" \w* [of the judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”}: [for it repented]{strong=“H5162” x-morph=“strongMorph: \sc Th\sc*8735”} the \sc Lord\sc* \w because| strong="H6440" \w* \w of their groanings| strong="H5009" \w* [by reason of them that oppressed]{strong=“H3905” x-morph=“strongMorph: \sc Th\sc*8801”} [them and vexed]{strong=“H1766” x-morph=“strongMorph: \sc Th\sc*8802”} them. 
\v 19 [And it came to pass, when the judge]{strong=“H8199” x-morph=“strongMorph: \sc Th\sc*8802”} \w was dead| strong="H4194" \w*, that [they returned]{strong=“H7725” x-morph=“strongMorph: \sc Th\sc*8799”}, [and corrupted]{strong=“H7843” x-morph=“strongMorph: \sc Th\sc*8689”} themselves \w more than their fathers| strong="H1" \w*, [in following]{strong=“H310 H3212” x-morph=“strongMorph: \sc Th\sc*8800”} \w other| strong="H312" \w* \w gods| strong="H430" \w* [to serve]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8800”} [them, and to bow down]{strong=“H7812” x-morph=“strongMorph: \sc Th\sc*8692”} [unto them; they ceased]{strong=“H5307” x-morph=“strongMorph: \sc Th\sc*8689”} \w not from their own doings| strong="H4611" \w*, \w nor from their stubborn| strong="H7186" \w* \w way| strong="H1870" \w*.\f + \fr 2:19 \ft corrupted…: or, were corrupt \f* \f + \fr 2:19 \ft ceased…: Heb. let nothing fall of their \f* 
\p
\v 20 \w And the anger| strong="H639" \w* of the \sc Lord\sc* [was hot]{strong=“H2734” x-morph=“strongMorph: \sc Th\sc*8799”} \w against Israel| strong="H3478" \w*; [and he said]{strong=“H559” x-morph=“strongMorph: \sc Th\sc*8799”}, \w Because that this people| strong="H1471" \w* [hath transgressed]{strong=“H5674” x-morph=“strongMorph: \sc Th\sc*8804”} \w my covenant| strong="H1285" \w* [which I commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w their fathers| strong="H1" \w*, [and have not hearkened]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8804”} \w unto my voice| strong="H6963" \w*; 
\v 21 [I also will not henceforth]{strong=“H3254” x-morph=“strongMorph: \sc Th\sc*8686”} [drive out]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8687”} \w any| strong="H376" \w* \w from before| strong="H6440" \w* \w them of the nations| strong="H1471" \w* \w which Joshua| strong="H3091" \w* [left]{strong=“H5800” x-morph=“strongMorph: \sc Th\sc*8804”} [when he died]{strong=“H4191” x-morph=“strongMorph: \sc Th\sc*8799”}: 
\v 22 [That through them I may prove]{strong=“H5254” x-morph=“strongMorph: \sc Th\sc*8763”} \w Israel| strong="H3478" \w*, [whether they will keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8802”} \w the way| strong="H1870" \w* of the \sc Lord\sc* [to walk]{strong=“H3212” x-morph=“strongMorph: \sc Th\sc*8800”} [therein, as their fathers]{strong=“H1”} [did keep]{strong=“H8104” x-morph=“strongMorph: \sc Th\sc*8804”} it, or not. 
\v 23 Therefore the \sc Lord\sc* [left]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8686”} \w those nations| strong="H1471" \w*, \w without| strong="H1115" \w* [driving them out]{strong=“H3423” x-morph=“strongMorph: \sc Th\sc*8687”} \w hastily| strong="H4118" \w*; [neither delivered]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w he them into the hand| strong="H3027" \w* \w of Joshua| strong="H3091" \w*.\f + \fr 2:23 \ft left: or, suffered \f*
\c 3
\p 
\v 1 Now these are \w the nations| strong="H1471" \w* which the \sc Lord\sc* [left]{strong=“H3240” x-morph=“strongMorph: \sc Th\sc*8689”}, [to prove]{strong=“H5254” x-morph=“strongMorph: \sc Th\sc*8763”} \w Israel| strong="H3478" \w* by them, even as many of Israel [as had not known]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} \w all the wars| strong="H4421" \w* \w of Canaan| strong="H3667" \w*; 
\v 2 \w Only that| strong="H7535" \w* \w the generations| strong="H1755" \w* \w of the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [might know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”}, [to teach]{strong=“H3925” x-morph=“strongMorph: \sc Th\sc*8763”} \w them war| strong="H4421" \w*, \w at the least such as before| strong="H6440" \w* [knew]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8804”} nothing thereof; 
\v 3 Namely, \w five| strong="H2568" \w* \w lords| strong="H5633" \w* \w of the Philistines| strong="H6430" \w*, \w and all the Canaanites| strong="H3669" \w*, \w and the Sidonians| strong="H6722" \w*, \w and the Hivites| strong="H2340" \w* [that dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8802”} \w in mount| strong="H2022" \w* \w Lebanon| strong="H3844" \w*, \w from mount| strong="H2022" \w* [Baal-hermon]{strong=“H1179”} [unto the entering in]{strong=“H935” x-morph=“strongMorph: \sc Th\sc*8800”} \w of Hamath| strong="H2574" \w*. 
\v 4 [And they were to prove]{strong=“H5254” x-morph=“strongMorph: \sc Th\sc*8763”} \w Israel| strong="H3478" \w* [by them, to know]{strong=“H3045” x-morph=“strongMorph: \sc Th\sc*8800”} [whether they would hearken]{strong=“H8085” x-morph=“strongMorph: \sc Th\sc*8799”} \w unto the commandments| strong="H4687" \w* of the \sc Lord\sc*, [which he commanded]{strong=“H6680” x-morph=“strongMorph: \sc Th\sc*8765”} \w their fathers| strong="H1" \w* \w by the hand| strong="H3027" \w* \w of Moses| strong="H4872" \w*. 
\p
\v 5 \w And the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [dwelt]{strong=“H3427” x-morph=“strongMorph: \sc Th\sc*8804”} \w among| strong="H7130" \w* \w the Canaanites| strong="H3669" \w*, \w Hittites| strong="H2850" \w*, \w and Amorites| strong="H567" \w*, \w and Perizzites| strong="H6522" \w*, \w and Hivites| strong="H2340" \w*, \w and Jebusites| strong="H2983" \w*: 
\v 6 [And they took]{strong=“H3947” x-morph=“strongMorph: \sc Th\sc*8799”} \w their daughters| strong="H1323" \w* \w to be their wives| strong="H802" \w*, [and gave]{strong=“H5414” x-morph=“strongMorph: \sc Th\sc*8804”} \w their daughters| strong="H1323" \w* \w to their sons| strong="H1121" \w*, [and served]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} \w their gods| strong="H430" \w*. 
\v 7 \w And the children| strong="H1121" \w* \w of Israel| strong="H3478" \w* [did]{strong=“H6213” x-morph=“strongMorph: \sc Th\sc*8799”} \w evil| strong="H7451" \w* \w in the sight| strong="H5869" \w* of the \sc Lord\sc*, [and forgat]{strong=“H7911” x-morph=“strongMorph: \sc Th\sc*8799”} the \sc Lord\sc* \w their God| strong="H430" \w*, [and served]{strong=“H5647” x-morph=“strongMorph: \sc Th\sc*8799”} \w Baalim| strong="H1168" \w* \w and the groves| strong="H842" \w*. 
\p
